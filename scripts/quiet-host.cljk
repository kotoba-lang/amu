#!/usr/bin/env nbb
;; scripts/quiet-host.cljk — choose a fleet node quiet enough to measure on,
;; or refuse to answer.
;;
;; Why this exists (measured 2026-09-06):
;;
;;   The three amu co-scientist bots (amu-bench, amu-falsify, amu-rank) run in
;;   `workdir orgs/kotoba-lang/amu` on the operator workstation and read that
;;   workstation's `uptime`. Their quiet rule -- "load1 > 7.5 なら測定せず" --
;;   is prose in the bot prompt, not code, and there is no ssh anywhere in
;;   amu's scripts. So the loop can only ever measure the one box that also
;;   runs every concurrent agent session.
;;
;;   On 2026-09-06 that workstation sat at load1 15.9-38.4 while ALL EIGHT
;;   reachable fleet nodes sat at load1 1.41-1.70 on 10 cores each. The ledger
;;   had recorded 10+ consecutive busy-refusals; `docs/jit-cosientist.md` tick
;;   12 recorded an 11th. Every one of those ticks could have measured.
;;
;;   A gate that reads the wrong host does not produce a wrong number -- it
;;   produces no number, forever, while looking like diligence. This script
;;   makes "which host" a measured answer instead of an implicit one.
;;
;; Contract:
;;   exit 0  -> one qualifying host, printed as EDN on stdout
;;   exit 1  -> probed successfully; NO host qualified (a real, usable answer)
;;   exit 2  -> could not probe (refused to answer; NOT the same as "none")
;;
;; Exit 2 is separate on purpose. This file exists because a refusal and a
;; measurement were indistinguishable in the loop it serves; reproducing that
;; shape here would be the same defect one layer down.
;;
;;   nbb scripts/quiet-host.cljk [--limit 0.10] [--hosts a,b,c] [--json]

(require '[kotoba.lang.text :as str])
(def cp (js/require "node:child_process"))
(def fs (js/require "node:fs"))

(defn arg [flag fallback]
  (let [v (js->clj (.-argv js/process))
        i (.lastIndexOf (to-array v) flag)]
    (if (neg? i) fallback (nth v (inc i) fallback))))

(def busy-limit (js/parseFloat (arg "--limit" "0.10")))
(def json? (some #(= "--json" %) (js->clj (.-argv js/process))))

;; Default roster comes from the probed inventory, never hardcoded here: a host
;; list baked into a script is exactly the "定数で持つな" failure CLAUDE.md
;; names for fleet egress. `:role :operator` is excluded because that host is
;; the one running the loop.
(def nodes-file "scripts/fleet-ci/nodes.edn")

(defn roster []
  (if-let [explicit (arg "--hosts" nil)]
    (remove str/blank? (str/split explicit #","))
    (let [;; The roster is superproject state (`scripts/fleet-ci/nodes.edn`,
          ;; itself generated by probe.cljs). amu is a child repo that is also
          ;; cloned standalone -- onto the fleet nodes themselves, by
          ;; remote-bench.cljs -- so it cannot assume the superproject is above
          ;; it, and must not carry its own copy of the host list. Resolution
          ;; order: AMU_FLEET_NODES, then a walk up, then refuse.
          candidates (concat (when-let [e (.. js/process -env -AMU_FLEET_NODES)] [e])
                             (map #(str % "/" nodes-file)
                                  ["." ".." "../.." "../../.." "../../../.."]))
          path (first (filter #(.existsSync fs %) candidates))]
      (when-not path
        (binding [*print-fn* *print-err-fn*]
          (println (str "cannot locate " nodes-file
                        " - set AMU_FLEET_NODES=<path to nodes.edn> or pass --hosts")))
        (.exit js/process 2))
      (let [txt (.readFileSync fs path "utf8")]
        ;; nodes.edn is generated EDN with set literals nbb's reader handles.
        (->> (:nodes (cljs.reader/read-string txt))
             (filter :reachable?)
             (remove #(= :operator (:role %)))
             (map :host))))))

(defn probe
  "Busy-CPU fraction over a 1s window on HOST, plus load1 as a diagnostic.

   Measures the same quantity as runtime-multidomain-suite.mjs `waitForQuiet`
   (ADR 0282: busy fraction, not the load1 proxy that ADR 0281 proved
   unsatisfiable on every fleet host). load1 is carried for the ledger only --
   it is never the criterion."
  [host]
  (let [script (str "S1=$(sysctl -n kern.cp_time 2>/dev/null || echo); "
                    "iostat -c2 -w1 2>/dev/null | tail -1; "
                    "sysctl -n vm.loadavg; sysctl -n hw.ncpu")
        r (try (.execSync cp (str "ssh -o BatchMode=yes -o ConnectTimeout=8 "
                                  host " " (pr-str script))
                          #js {:encoding "utf8" :timeout 25000
                               :stdio #js ["pipe" "pipe" "pipe"]})
               (catch :default _ nil))]
    (when r
      (let [lines (remove str/blank? (str/split-lines (str r)))
            ;; `iostat -c2 -w1` prints  KB/t tps MB/s us sy id 1m 5m 15m.
            ;; Idle is column index 5. It is NOT one of the last three -- those
            ;; are the load averages, and reading them as CPU state was this
            ;; script's own first bug (2026-09-06): every host came back
            ;; unparseable, which the contract correctly reported as exit 2
            ;; rather than as "no quiet host".
            cpu (some->> lines (filter #(re-matches #"\s*[\d.]+(\s+[\d.]+){8}\s*" %)) last
                         str/trim (#(str/split % #"\s+")) (mapv js/parseFloat))
            idle (when (= 9 (count cpu)) (nth cpu 5))
            load1 (some->> lines (some #(re-find #"\{\s*([\d.]+)" %)) second js/parseFloat)
            cores (some->> lines (filter #(re-matches #"\d+" (str/trim %))) last str/trim js/parseInt)]
        (when idle
          {:host host
           :busy-cpu-fraction (/ (- 100.0 idle) 100.0)
           :load1 load1
           :cores cores})))))

(let [hosts (roster)
      _ (when (empty? hosts)
          (binding [*print-fn* *print-err-fn*] (println "roster empty"))
          (.exit js/process 2))
      results (remove nil? (map probe hosts))]
  (if (empty? results)
    (do (binding [*print-fn* *print-err-fn*]
          (println (str "REFUSED: probed " (count hosts)
                        " host(s), none answered. This is not 'no quiet host'.")))
        (.exit js/process 2))
    (let [qualified (->> results
                         (filter #(<= (:busy-cpu-fraction %) busy-limit))
                         (sort-by :busy-cpu-fraction))
          answer {:format :amu.quiet-host/v1
                  :limit busy-limit
                  :probed (count results)
                  :of (count hosts)
                  :qualified (mapv :host qualified)
                  :chosen (:host (first qualified))
                  :samples (vec results)}]
      (println (if json? (js/JSON.stringify (clj->js answer) nil 2) (pr-str answer)))
      (.exit js/process (if (seq qualified) 0 1)))))
