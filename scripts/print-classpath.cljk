#!/usr/bin/env kbb
;; Print the dependency directories `bin/kotoba`'s nbb fast path needs, one
;; per line, resolved from `deps-lock.edn` with git alone.
;;
;; Separate from `kotoba.compiler.nbb.classpath` so that namespace stays
;; require-able (and therefore testable) without running anything on load.
;;
;;   kbb --backend sci --classpath src scripts/print-classpath.cljk [root]

(ns print-classpath
  (:require [kotoba.compiler.nbb.classpath :as classpath]
            [kotoba.compiler.nbb.host.entry :as entry]))

;; `-main` returns the exit status (superproject adr-2609242330 S5, section 1
;; (c)(2)); a non-zero one is handed to the OS here. Zero is left to the
;; process's natural end so a piped stdout is never cut short.
(let [status (apply classpath/-main *command-line-args*)]
  (when-not (zero? status)
    (entry/exit! status)))
