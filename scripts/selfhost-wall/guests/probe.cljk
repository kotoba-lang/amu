(defn- probe-case [c [:ref :form/r]] :string
  (let [src (form/string-value (form/nth-of c 1))]
    (string-concat (string-concat "1:" (stage-1 src)) (string-concat "|" (string-concat (string-concat "2:" (stage-2 src)) (string-concat "|" (string-concat (string-concat "3:" (stage-3 src)) (string-concat "|" (string-concat (string-concat "4:" (stage-4 src)) (string-concat "|" (string-concat (string-concat "5:" (stage-5 src)) (string-concat "|" (string-concat (string-concat "6:" (stage-6 src)) (string-concat "|" (string-concat (string-concat "7:" (stage-7 src)) (string-concat "|" (string-concat (string-concat "8:" (stage-8 src)) (string-concat "|" (string-concat (string-concat "9:" (stage-9 src)) (string-concat "|" (string-concat (string-concat "10:" (stage-10 src)) (string-concat "|" (string-concat (string-concat "11:" (stage-11 src)) (string-concat "|" ""))))))))))))))))))))))))

(defn- probe-lines [text :string i :i64 n :i64 out :string] :string
  (if (>= i n)
    out
    (let [j (string-find-byte text 10 i)
          end (if (< j 0) n j)
          line (string-substring text i end)
          answer (if (< (string-length line) 2) "" (probe-case (form/edn-form line)))]
      (probe-lines text (+ end 1) n (string-concat out (string-concat answer "\n"))))))

(defn probe-run [text :string] :string
  (probe-lines text 0 (string-length text) ""))
