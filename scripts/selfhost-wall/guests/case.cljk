;; The native-compilable exemplar: kotoba.string.case (lang/compat) over the whole input.
;; guest-run.sh case.cljk up < text  ==  JS String.prototype.toUpperCase (see case-diff.sh)
(ns probe.case-guest
  {:kotoba/export [up]}
  (:require [kotoba.string.case :as c]))
(defn up [s :string] :string (c/upper-case-root s))
