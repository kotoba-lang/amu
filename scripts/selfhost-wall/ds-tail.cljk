
;; ---- a best-effort printer for a failing case (the comparison itself is `form/eq`) ----
(defn- ds-join [kids [:list [:ref :form/r]] i :i64 acc :string] :string
  (if (>= i (vector-count kids))
    acc
    (ds-join kids (+ i 1)
             (string-concat acc (string-concat (if (> i 0) " " "") (ds-print (typed-list-nth [:list [:ref :form/r]] kids i)))))))

(defn- ds-print [f [:ref :form/r]] :string
  (cond
    (form/is-nil? f) "nil"
    (form/is-bool? f) (if (form/bool-value f) "true" "false")
    (form/is-int? f) (string-from-i64 (form/int-value f))
    (form/is-string? f) (string-concat "\"" (string-concat (form/string-value f) "\""))
    (form/is-keyword? f) (kw-text f)
    (form/is-symbol? f) (form/symbol-value f)
    (form/is-seq? f) (string-concat "(" (string-concat (ds-join (form/kids-of f) 0 "") ")"))
    (form/is-vec? f) (string-concat "[" (string-concat (ds-join (form/kids-of f) 0 "") "]"))
    (form/is-set? f) (string-concat "#{" (string-concat (ds-join (form/kids-of f) 0 "") "}"))
    (form/is-map? f) (string-concat "{" (string-concat (ds-join (form/kids-of f) 0 "") "}"))
    :else "?"))

(defn- ds-refusal [e [:ref :fe/err]] :string
  (if (string=? (record-get [:ref :fe/err] e :code) "kotoba.fe/unported")
    (string-concat "UNPORTED " (record-get [:ref :fe/err] e :msg))
    (string-concat "ERR " (record-get [:ref :fe/err] e :msg))))

;; a case is [functions none? form expected helpers shapes lambdas dispatchers uses-apply uses-lazy]; expected nil means the host refused. The rest is
;; what the host's side registries (`*pending-loop-helpers*`, `*loop-helper-shapes*`, `*pending-lambdas*`,
;; `*required-closure-dispatchers*`, `*uses-apply?*`, `*uses-lazy?*`) ended up holding: the port returns them in the env.
(defn- ds-same-side [e [:ref :fe/env] c [:ref :form/r]] :bool
  (and (form/eq (env-helpers e) (form/nth-of c 4))
       (form/eq (env-shapes e) (form/nth-of c 5))
       (form/eq (env-lambdas e) (form/nth-of c 6))
       (form/eq (env-dispatchers e) (form/nth-of c 7))
       (form/eq (form/bool-form (env-uses-apply? e)) (form/nth-of c 8))
       (form/eq (form/bool-form (env-uses-lazy? e)) (form/nth-of c 9))))

;; the harness spells a float literal `(__ds_f64 N)` (a printed form cannot carry the reader's metadata); the Kotoba route's reader yields a float Form
(defn- ds-revive-kids [f [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of f))
    acc
    (ds-revive-kids f (+ i 1) (form/append-form acc (ds-revive (form/nth-of f i))))))

(defn- ds-revive [f [:ref :form/r]] [:ref :form/r]
  (cond
    (and (form/is-seq? f) (= 2 (form/count-of f)) (form/is-symbol? (form/nth-of f 0))
         (string=? (form/symbol-value (form/nth-of f 0)) "__ds_f64"))
    (form/f64-form (form/int-value (form/nth-of f 1)))
    (form/is-seq? f) (form/form-seq (ds-revive-kids f 0 (form/no-forms)))
    (form/is-vec? f) (form/form-vec (ds-revive-kids f 0 (form/no-forms)))
    (form/is-set? f) (form/form-set (ds-revive-kids f 0 (form/no-forms)))
    (form/is-map? f) (form/form-map (ds-revive-kids f 0 (form/no-forms)))
    :else f))

(defn- ds-case [c [:ref :form/r] tbl [:ref :form/r]] :string
  (let [env0 (fe-env 0 (form/nil-form) (if (form/is-true? (form/nth-of c 1)) true false) (form/nth-of c 0) tbl)
        ;; the optional eleventh element: the callable contract tables {:lexical :results :params :expected}
        con (if (> (form/count-of c) 10) (form/nth-of c 10) (form/nil-form))
        binds (form/form-get con (form/keyword-form :binds))
        env (if (form/is-nil? con)
              env0
              (with-lexical (record-assoc [:ref :fe/env] env0 :contracts con) (form/form-set (form/kids-of binds))))]
    (try (let [r (desugar-expr env (ds-revive (form/nth-of c 2)))
               e (dr-env r)]
           (if (and (form/eq (dr-form r) (form/nth-of c 3)) (ds-same-side e c))
             "OK"
             (string-concat "DIFF " (string-concat (ds-print (dr-form r))
                                      (string-concat " || " (string-concat (ds-print (env-helpers e))
                                        (string-concat " || " (string-concat (ds-print (env-shapes e))
                                          (string-concat " || " (string-concat (ds-print (env-lambdas e))
                                            (string-concat " || " (ds-print (env-dispatchers e)))))))))))))
         (catch e (ds-refusal e)))))

(defn- ds-lines [text :string i :i64 n :i64 out :string tbl [:ref :form/r]] :string
  (if (>= i n)
    out
    (let [j (string-find-byte text 10 i)
          end (if (< j 0) n j)
          c (form/edn-form (string-substring text i end))]
      (ds-lines text (+ end 1) n (string-concat out (string-concat (ds-case c tbl) "\n")) tbl))))

(defn ds-run [text :string] :string
  (ds-lines text 0 (string-byte-length text) "" (fe-tables)))
