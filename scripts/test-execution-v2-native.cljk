(ns test-execution-v2-native
  (:require [kototama.execution-v2 :as v2] [kototama.execution-native :as adapter]
            [kototama.execution-ledger :as ledger] [kototama.native.executor :as native]
            [kotoba.artifact.execution :as blocks] [kotoba.artifact.runtime-identity :as runtime-id]
            [kotoba.core.execution :as core] [grant.execution-v2 :as issuer] [kotoba.value.codec :as value] [kotoba.verifier.signing :as signing]
            [kotoba.compiler.bounded-edn :as edn]
            ["node:fs" :as fs] ["node:path" :as path] ["node:os" :as os] ["node:child_process" :as process]))
(def root (.cwd js/process))
(def scratch (fs/mkdtempSync (path/join (os/tmpdir) "kotoba-native-v2-")))
(try
(fs/mkdirSync scratch #js {:recursive true :mode 448})
(fs/chmodSync scratch 448)
(defn file [n] (str scratch "/" n))
(fs/writeFileSync (file "answer.kotoba") "(defn main [] :i64 42)\n")
(let [r (process/spawnSync (.-execPath js/process)
          #js [(str root "/bin/amu") "--jvm-free" "compile" (file "answer.kotoba")
               "--target" (str (case (.-arch js/process) "arm64" "aarch64" "x64" "x86_64" (throw (ex-info "unsupported native architecture" {}))) "-" (case (.-platform js/process) "darwin" "macos" "linux" "linux" "win32" "windows" (throw (ex-info "unsupported native OS" {})))) "--fuel" "1024" "--output" (file "answer.kexe")]
          #js {:cwd root :encoding "utf8" :maxBuffer 67108864})]
  (when-not (= 0 (.-status r)) (throw (ex-info "compile failed" {:out (.-stdout r) :error (.-stderr r)}))))
(def authority (signing/generate-keypair))
(def executor (signing/generate-keypair))
(def measured (native/measure-runtime {:loader-source-dir (str root "/tools")}))
(fs/writeFileSync (file "loader") (:loader-bytes measured) #js {:mode 448})
(fs/chmodSync (file "loader") 448)
(def now (js/Date.now))
(def envelope (signing/sign (edn/read-file (file "answer.kexe")) authority
                            {:not-before 0 :expires 4102444800}))
(defn trust [key] {:format :kotoba.trust/v1 :trusted-signers #{(:signer key)}
                   :revoked-signers #{} :revoked-artifacts #{}})
(def artifact-trust (assoc (trust authority) :trusted-runtime-sha256
                          #{(runtime-id/identity-sha256 (:runtime measured))} :revoked-runtime-sha256 #{}))
(def mechanisms (adapter/mechanisms {:prepare native/prepare :execute native/execute :close! native/close!}
                                   artifact-trust {:allow #{}} (file "loader") #(js/Date.now)))
(let [r (process/spawnSync (.-execPath js/process)
          #js [(str root "/bin/amu") "--jvm-free" "compile" (file "answer.kotoba")
               "--target" (str (case (.-arch js/process) "arm64" "aarch64" "x64" "x86_64" (throw (ex-info "unsupported native architecture" {}))) "-" (case (.-platform js/process) "darwin" "macos" "linux" "linux" "win32" "windows" (throw (ex-info "unsupported native OS" {})))) "--output" (file "unmetered.kexe")]
          #js {:cwd root :encoding "utf8" :maxBuffer 67108864})]
  (when-not (= 0 (.-status r)) (throw (ex-info "unmetered control compilation failed" {:out (.-stdout r) :error (.-stderr r)}))))
(def unmetered (signing/sign (edn/read-file (file "unmetered.kexe")) authority
                            {:not-before 0 :expires 4102444800}))
(when-not (try ((:inspect! mechanisms) unmetered (:runtime measured)) false
              (catch :default error (= :explicit-native-fuel-required (:reason (ex-data error)))))
  (throw (ex-info "unmetered v2 admission was not refused" {})))
(def context ((:inspect! mechanisms) envelope (:runtime measured)))
(def binding (blocks/binding-block (:target context) :sync (:artifact-cid context)
                                  (:interface-cid context) (:runtime-identity context) (:layout context)))
(def input (blocks/block :input {:entry (symbol "main") :arguments []}))
(def ref (:cid (blocks/block :policy {:fixture :native-v2})))
(def invocation (issuer/issue-invocation (:signer (signing/generate-keypair))))
(def intent (blocks/intent-block binding context
              (assoc (zipmap core/execution-intent-keys (repeat ref))
                     :format :kotoba.execution-intent/v2 :profile-binding-cid (:cid binding)
                     :artifact-cid (:artifact-cid context) :runtime-identity (:runtime-identity context)
                     :input-cid (:cid input) :invocation-cid (:cid invocation) :grant-cids [] :approval-cids [])))
(def window {:audience "native-local-test" :not-before now :expires (+ now 300000) :epoch 1})
(def host (merge mechanisms {:providers {} :ledger! (ledger/open-ledger! (fs/mkdtempSync (str scratch "/ledger-"))) :epoch! (constantly 1)
                            :clock! #(js/Date.now) :audience "native-local-test"
                            :authority-trust (trust authority) :executor-trust (trust executor)
                            :executor-key executor :revoked-cids! (constantly #{})}))
(def packet {:artifact envelope :runtime (:runtime measured) :binding binding :intent intent :invocation invocation :input input
             :authorization (v2/attest :intent intent authority window) :leases []})
(def result (v2/run! host packet))
(def observed (blocks/verify-block :outcome (:outcome result)))
(when-not (and (= :ok (:status observed)) (let [r (get-in observed [:value :evidence :result])] (= (js/BigInt 42) (if (value/int64? r) (value/int64-value r) (js/BigInt r)))))
  (throw (ex-info "native outcome mismatch" {:outcome observed})))
(println {:target (:target context) :result 42 :intent (:cid intent) :identity (:cid (:identity result))
          :runtime (:runtime-identity context) :binding (:cid binding) :verified true :unmetered-denied true})

(finally (fs/rmSync scratch #js {:recursive true :force true})))
