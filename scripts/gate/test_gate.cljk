#!/usr/bin/env kbb
;; bootstrap-tooling: unit checks of the selfhost gate's pure halves (ratchet.cljk, boundary.cljk).
(ns scripts.gate.test-gate
  "node node_modules/nbb/cli.js scripts/gate/test_gate.cljk -- exit 0 when every check holds."
  (:require [scripts.gate.boundary :as b]
            [scripts.gate.ratchet :as r]))

(def failures (volatile! []))
(defn check [label ok] (when-not ok (vswap! failures conj label)) (println (if ok "ok  " "FAIL") label))

(defn side [g1 & {:keys [g0 s2 s5 s1 g2]}]
  {:requested [:g0 :g1 :g2 :s1 :s2 :s5]
   :gates {:g0 (or g0 {:status "MEASURED" :files {}})
           :g1 {:status "MEASURED" :modules g1}
           :g2 (or g2 {:status "MEASURED" :modules {}})
           :s1 (or s1 {:status "MEASURED" :modules {"lineage-r6n" {:verdict "PASS"}}})
           :s2 (or s2 {:status "MEASURED" :modules {}})
           :s5 (or s5 {:status "MEASURED" :metrics {:product-total 69 :sh-allowlist 1}})}})

(def base-g1 {"a" {:verdict "PASS"} "b" {:verdict "REFUSED" :code "x"} "c" {:verdict "REFUSED" :code "y"}})

;; ratchet
(check "same measurement passes" (= "PASS" (:verdict (r/judge (side base-g1) (side base-g1)))))
(check "a gain passes" (= "PASS" (:verdict (r/judge (side base-g1) (side (assoc base-g1 "b" {:verdict "PASS"}))))))
(check "a PASS -> REFUSED flip fails even when the count holds"
       (= "FAIL" (:verdict (r/judge (side base-g1)
                                    (side (assoc base-g1 "a" {:verdict "REFUSED" :code "z"} "b" {:verdict "PASS"}))))))
(check "a PASS count drop fails" (= "FAIL" (:verdict (r/judge (side base-g1) (side (assoc base-g1 "a" {:verdict "REFUSED"}))))))
(check "a PASS module missing on the head fails" (= "FAIL" (:verdict (r/judge (side base-g1) (side (dissoc base-g1 "a"))))))
(check "an UNMEASURED gate fails (fail closed)"
       (= "FAIL" (:verdict (r/judge (side base-g1) (assoc-in (side base-g1) [:gates :s2] {:status "UNMEASURED" :reason "no seed"})))))
(check "a gate missing from one side fails"
       (= "FAIL" (:verdict (r/judge (side base-g1) (update (side base-g1) :gates dissoc :g2)))))
(check "S2 OK count drop fails"
       (= "FAIL" (:verdict (r/judge (side base-g1 :s2 {:status "MEASURED" :modules {"m" {:verdict "PASS"}}})
                                    (side base-g1 :s2 {:status "MEASURED" :modules {"m" {:verdict "REFUSED"}}})))))
(check "S5 growth fails"
       (= "FAIL" (:verdict (r/judge (side base-g1) (side base-g1 :s5 {:status "MEASURED" :metrics {:product-total 70 :sh-allowlist 1}})))))
(check "S5 shrink passes"
       (= "PASS" (:verdict (r/judge (side base-g1) (side base-g1 :s5 {:status "MEASURED" :metrics {:product-total 60 :sh-allowlist 1}})))))
(check "S1 lineage flip fails"
       (= "FAIL" (:verdict (r/judge (side base-g1) (side base-g1 :s1 {:status "MEASURED" :modules {"lineage-r6n" {:verdict "REFUSED" :code "seed-hash"}}})))))
(check "G2 nondeterminism on the head fails"
       (= "FAIL" (:verdict (r/judge (side base-g1)
                                    (side base-g1 :g2 {:status "MEASURED" :modules {"b" {:verdict "REFUSED" :code "nondeterministic"}}})))))
(check "G0 new :rc-no-arm fails"
       (= "FAIL" (:verdict (r/judge (side base-g1 :g0 {:status "MEASURED" :files {"f.cljk" {:present true :rc-no-arm 1 :kotoba-nil 0 :host-literals 0}}})
                                    (side base-g1 :g0 {:status "MEASURED" :files {"f.cljk" {:present true :rc-no-arm 2 :kotoba-nil 0 :host-literals 0}}})))))
(check "G0 a new file with a #?(:kotoba nil fails"
       (= "FAIL" (:verdict (r/judge (side base-g1 :g0 {:status "MEASURED" :files {"f.cljk" {:present false}}})
                                    (side base-g1 :g0 {:status "MEASURED" :files {"f.cljk" {:present true :rc-no-arm 0 :kotoba-nil 1 :host-literals 0}}})))))
(check "G0 fewer findings passes"
       (= "PASS" (:verdict (r/judge (side base-g1 :g0 {:status "MEASURED" :files {"f.cljk" {:present true :rc-no-arm 3 :kotoba-nil 1 :host-literals 2}}})
                                    (side base-g1 :g0 {:status "MEASURED" :files {"f.cljk" {:present true :rc-no-arm 1 :kotoba-nil 0 :host-literals 2}}})))))
(check "no requested gate fails" (= "FAIL" (:verdict (r/judge {:requested []} {:requested []}))))

;; G0 host literals in :kotoba arms
(check "regex in a :kotoba arm" (= 1 (:count (b/kotoba-arm-host-literals "(def x #?(:clj #\"a\" :kotoba #\"b\"))"))))
(check "host interop only in the :cljs arm is not counted"
       (= 0 (:count (b/kotoba-arm-host-literals "(defn f [x] #?(:cljs (.foo js/window x) :kotoba (g x)))"))))
(check "js/, .method, char and #js in a :kotoba arm"
       (= 4 (:count (b/kotoba-arm-host-literals "#?(:kotoba (do (.log js/console \\a) #js {}) :default nil)"))))
(check "strings and comments are not tokens"
       (= 0 (:count (b/kotoba-arm-host-literals "#?(:kotoba \"js/x .y\" ;; js/z\n :clj 1)"))))
(check "a :clj arm nested in a :kotoba arm is not the Kotoba reading"
       (= 0 (:count (b/kotoba-arm-host-literals "#?(:kotoba [1 #?(:clj java.lang.Long :kotoba 2)])"))))

;; S5 scanner (bootstrap-boundary.sh semantics)
(let [s (b/scan-text "(ns a (:require #?(:cljs [\"node:fs\" :as fs]) [\"node:path\" :as p]))\n(def x #?(:kotoba nil :cljs 1))")]
  (check "unguarded / guarded host tokens" (and (= 1 (:unguarded s)) (= 1 (:guarded s))))
  (check "#?(:kotoba nil forms and arms" (and (= 1 (:kotoba-nil s)) (= 1 (:kotoba-arms s)) (= 2 (:host-arms s)))))
(check "a #?(:kotoba nil inside a string or comment is not a form"
       (= 0 (:kotoba-nil (b/scan-text "(def s \"#?(:kotoba nil :cljs 1)\") ; #?(:kotoba nil)\n"))))
(check "native-gates allowlist"
       (= ["scripts/seed/x.sh"] (b/native-gates-allowlist "native-gates #{(lib/join lib/root \"scripts/seed/x.sh\")}")))
(check "a missing allowlist is nil (the driver fails closed)" (nil? (b/native-gates-allowlist "nothing")))

(println (if (seq @failures) (str "test-gate: " (count @failures) " FAILED") "test-gate: all checks hold"))
(set! (.-exitCode js/process) (if (seq @failures) 1 0))
