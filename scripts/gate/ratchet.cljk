(ns scripts.gate.ratchet
  "The judging half of the selfhost acceptance gate (JUN-242 part 3): pure
  functions from two measurements (the PR's base and its head) to a verdict.
  No host interop and no I/O, so the same text has a Kotoba reading; the
  host driver is scripts/gate/selfhost_gate.cljk.

  The standard is the Linear document \"合格判定と品質基準 2026-10-21\" (P-JUN-5):
  five verdict values PASS / REFUSED / BLOCKED / UNMEASURED / NOT-CLAIMED,
  fail closed, numbers generated by script. Almost every module is REFUSED
  today, so the gate is a ratchet against the base, not an absolute 100%:

    G0  a changed file gains no :rc-no-arm, no `#?(:kotoba nil`, no host literal in a :kotoba arm
    G1  the PASS count does not drop and no module flips PASS -> not PASS
    G2  the same for definition-CID determinism (and no head PASS module is nondeterministic)
    S1  the seed lineage reproduces through the scan's rung with the recorded seed hash (no PASS -> not PASS)
    S2  the seed scan's OK count does not drop
    S5  no PRODUCT host-dependency count and no .sh count grows

  A gate that one side could not measure (missing tool, oracle, tracer or
  seed) is a FAIL, never a skip.")

(def verdict-values ["PASS" "REFUSED" "BLOCKED" "UNMEASURED" "NOT-CLAIMED"])

(defn tally
  "{verdict count} over a {name {:verdict v}} map, every value present."
  [modules]
  (reduce (fn [acc entry]
            (update acc (:verdict (val entry)) (fnil inc 0)))
          (zipmap verdict-values (repeat 0))
          modules))

(defn- pass? [entry] (= "PASS" (:verdict entry)))

(defn flips
  "Names whose base verdict is PASS and whose head verdict is not (a module
  missing on the head counts as a flip to NOT-CLAIMED)."
  [base-modules head-modules]
  (vec (sort (for [[k b] base-modules
                   :when (pass? b)
                   :let [h (get head-modules k)]
                   :when (not (pass? h))]
               k))))

(defn gains
  "Names whose head verdict is PASS and whose base verdict is not."
  [base-modules head-modules]
  (vec (sort (for [[k h] head-modules
                   :when (pass? h)
                   :when (not (pass? (get base-modules k)))]
               k))))

(defn- unmeasured-failures [gate base head]
  (vec (concat
        (when (= "UNMEASURED" (:status base))
          [(str (name gate) " base UNMEASURED: " (:reason base))])
        (when (= "UNMEASURED" (:status head))
          [(str (name gate) " head UNMEASURED: " (:reason head))]))))

(defn- claimed? [m] (not (contains? #{"UNMEASURED" "NOT-CLAIMED"} (:status m))))

(defn judge-modules
  "G1 / G2 / S2: the ratchet over per-module verdicts. `strict-flips?` makes a
  PASS -> not-PASS flip a failure even when the count holds."
  [gate base head strict-flips?]
  (let [bm (:modules base) hm (:modules head)
        bt (tally bm) ht (tally hm)
        fl (flips bm hm) gn (gains bm hm)
        measured (and (claimed? base) (claimed? head))
        failures (vec (concat
                       (unmeasured-failures gate base head)
                       (when (and measured (< (get ht "PASS") (get bt "PASS")))
                         [(str (name gate) " PASS count dropped " (get bt "PASS") " -> " (get ht "PASS"))])
                       (when (and measured strict-flips? (seq fl))
                         [(str (name gate) " PASS -> not PASS: " (apply str (interpose " " fl)))])))]
    {:gate gate
     :status (if (and (= "NOT-CLAIMED" (:status base)) (= "NOT-CLAIMED" (:status head)))
               "NOT-CLAIMED"
               (if (seq failures) "FAIL" "PASS"))
     :base (assoc bt :total (count bm))
     :head (assoc ht :total (count hm))
     :flips fl
     :gains gn
     :failures failures}))

(defn judge-g2
  "G2 adds an absolute rule: a head module whose CIDs differ between two runs."
  [base head]
  (let [r (judge-modules :g2 base head true)
        nondet (vec (sort (for [[k v] (:modules head)
                                :when (= "nondeterministic" (:code v))]
                            k)))
        failures (vec (concat (:failures r)
                              (when (seq nondet)
                                [(str "g2 nondeterministic definition CIDs on the head: "
                                      (apply str (interpose " " nondet)))])))]
    (assoc r :failures failures :status (if (seq failures) "FAIL" (:status r)))))

(def g0-counters [:rc-no-arm :kotoba-nil :host-literals])

(defn judge-g0
  "Per changed file: none of the three counters may grow from base to head
  (a file the base does not have starts from zero)."
  [base head]
  (let [paths (sort (distinct (concat (keys (:files base)) (keys (:files head)))))
        rows (vec (for [p paths
                        :let [b (get-in base [:files p])
                              h (get-in head [:files p])
                              grown (vec (for [c g0-counters
                                               :when (:present h)
                                               :when (> (or (get h c) 0)
                                                        (if (:present b) (or (get b c) 0) 0))]
                                           c))]]
                    {:path p :base b :head h :grown grown}))
        failures (vec (concat
                       (unmeasured-failures :g0 base head)
                       (for [r rows :when (seq (:grown r))]
                         (str "g0 " (:path r) " gained "
                              (apply str (interpose ", " (map name (:grown r))))))
                       (for [r rows
                             :let [h (:head r)]
                             :when (and (:present h) (= "UNMEASURED" (:verdict h)))]
                         (str "g0 " (:path r) " UNMEASURED: " (:reason h)))))]
    {:gate :g0
     :status (if (and (= "NOT-CLAIMED" (:status base)) (= "NOT-CLAIMED" (:status head)))
               "NOT-CLAIMED"
               (if (seq failures) "FAIL" "PASS"))
     :rows rows
     :failures failures}))

(defn judge-s2
  "S2: the OK (PASS) count of the seed scan may not drop; flips are reported."
  [base head]
  (judge-modules :s2 base head false))

(defn judge-s5
  "S5: no metric may grow."
  [base head]
  (let [bm (:metrics base) hm (:metrics head)
        ks (sort (distinct (concat (keys bm) (keys hm))))
        rows (vec (for [k ks] {:metric k :base (get bm k) :head (get hm k)}))
        failures (vec (concat
                       (unmeasured-failures :s5 base head)
                       (when (and (claimed? base) (claimed? head))
                         (for [r rows
                               :when (or (nil? (:base r)) (nil? (:head r))
                                         (> (:head r) (:base r)))]
                           (str "s5 " (name (:metric r)) " grew " (:base r) " -> " (:head r))))))]
    {:gate :s5
     :status (if (and (= "NOT-CLAIMED" (:status base)) (= "NOT-CLAIMED" (:status head)))
               "NOT-CLAIMED"
               (if (seq failures) "FAIL" "PASS"))
     :rows rows
     :failures failures}))

(defn judge
  "The whole verdict. A gate requested by either side but missing from the
  other side's measurement is UNMEASURED there, so it fails."
  [base head]
  (let [requested (sort (distinct (concat (:requested base) (:requested head))))
        gate-of (fn [m g] (or (get-in m [:gates g])
                              {:status "UNMEASURED" :reason "the measurement has no such gate"}))
        results (vec (for [g requested
                           :let [b (gate-of base g) h (gate-of head g)]]
                       (case g
                         :g0 (judge-g0 b h)
                         :g1 (judge-modules :g1 b h true)
                         :s1 (judge-modules :s1 b h true)
                         :g2 (judge-g2 b h)
                         :s2 (judge-s2 b h)
                         :s5 (judge-s5 b h)
                         {:gate g :status "FAIL" :failures [(str "unknown gate " g)]})))
        failures (vec (mapcat :failures results))]
    {:format :kotoba.selfhost-gate/v1
     :verdict (if (and (seq requested) (empty? failures)) "PASS" "FAIL")
     :failures (if (seq requested) failures ["no gate was requested"])
     :gates results}))
