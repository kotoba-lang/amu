#!/usr/bin/env kbb
;; bootstrap-tooling: posts a selfhost-gate verdict as a GitHub commit status (gh api); separate from the gate.
(ns scripts.gate.report-status
  "node node_modules/nbb/cli.js scripts/gate/report_status.cljk --verdict FILE.edn --repo OWNER/NAME
     [--sha SHA] [--context selfhost-gate] [--target-url URL] [--dry-run]

  Reads a verdict written by scripts/gate/run.cljk and posts one commit status
  on the head commit (or --sha): success for PASS, failure for FAIL. The
  description carries the G1 / S2 counts and the first failure. --dry-run
  prints the request instead of sending it. The runner node that measured
  supplies the gh credentials; the gate itself never talks to GitHub."
  (:require [clojure.edn :as edn]
            [kotoba.lang.text :as str]
            ["node:child_process" :as child]
            ["node:fs" :as fs]))

(defn- parse-args [args]
  (loop [m {} [a & more :as xs] args]
    (cond (empty? xs) m
          (= a "--dry-run") (recur (assoc m :dry-run true) more)
          (str/starts-with? a "--") (recur (assoc m (keyword (subs a 2)) (first more)) (rest more))
          :else (throw (js/Error. (str "unexpected argument " a))))))

(defn- counts [v gate]
  (when-let [g (first (filter #(= gate (:gate %)) (:gates v)))]
    (when (:head g)
      (str (name gate) " " (get-in g [:head "PASS"]) "/" (get-in g [:head :total])
           " (base " (get-in g [:base "PASS"]) ")"))))

(defn description [v]
  (let [d (str (:verdict v) ": "
               (str/join ", " (remove nil? [(counts v :g1) (counts v :s2)]))
               (when-let [f (first (:failures v))] (str "; " f)))]
    (if (> (count d) 140) (str (subs d 0 137) "...") d)))

(defn -main [& args]
  (let [o (parse-args args)
        _ (when-not (and (:verdict o) (:repo o)) (throw (js/Error. "--verdict and --repo are required")))
        v (edn/read-string (.readFileSync fs (:verdict o) "utf8"))
        sha (or (:sha o) (get-in v [:change :head]))
        fields (cond-> ["-f" (str "state=" (if (= "PASS" (:verdict v)) "success" "failure"))
                        "-f" (str "context=" (or (:context o) "selfhost-gate"))
                        "-f" (str "description=" (description v))]
                 (:target-url o) (into ["-f" (str "target_url=" (:target-url o))]))
        argv (into ["api" "--method" "POST" (str "repos/" (:repo o) "/statuses/" sha)] fields)]
    (if (:dry-run o)
      (println (str "gh " (str/join " " (map pr-str argv))))
      (let [r (.spawnSync child "gh" (clj->js argv) #js {:encoding "utf8"})]
        (when-not (= 0 (.-status r))
          (throw (js/Error. (str "gh api failed: " (.-stderr r)))))
        (println (str "posted " (:verdict v) " on " (:repo o) "@" sha))))))

(try (apply -main *command-line-args*)
     (catch :default e
       (.write (.-stderr js/process) (str "report-status: " (.-message e) "\n"))
       (set! (.-exitCode js/process) 2)))
