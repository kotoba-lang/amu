;; scripts/test-package-command.cljk — the packaged-command behaviours that
;; tools/kexe_loader.c promises and nothing else measured (2026-09-15).
;;
;; Three promises, each checked in BOTH directions where it has two:
;;
;;   1. Standard output is buffered, and a diagnostic never overtakes the
;;      output the guest wrote before it: `one` / `diag` / `two` arrives as
;;      stdout "one\ntwo\n" and stderr "diag\n".
;;   2. Bytes wire 37 has already answered a count for reach fd 1 even when
;;      the guest TRAPS afterwards -- the count would otherwise be a lie.
;;   3. `--cpu-seconds` is a budget: a guest that burns more CPU than it
;;      names dies of SIGXCPU (exit 120, reason on stderr), and the SAME
;;      guest under a larger budget completes. Load on the machine cannot
;;      turn the passing arm red, because RLIMIT_CPU counts CPU seconds and
;;      not wall seconds; the refusing arm is pinned to its reason literal.
;;
;; A fourth is the packager's own refusal of a non-decimal budget, so the
;; flag cannot be silently ignored.
;;
;;   node bin/kbb --backend sci scripts/test-package-command.cljk
;;
;; Exit 0 when every check passed, 1 on a failure, 2 when it could not run.
(ns scripts.test-package-command
  (:require [clojure.string :as str]
            ["node:child_process" :as child]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def root (.resolve path (.dirname path *file*) ".."))
(def tmp (.mkdtempSync fs (.join path (.tmpdir os) "amu-package-command-")))
(def amu (.join path root "bin" "amu"))
(def packager (.join path root "scripts" "package-command.cljk"))
(def kbb (.join path root "bin" "kbb"))
(defn file [name] (.join path tmp name))

(defn- refuse [message]
  (println (pr-str {:ok false :phase :setup :message message}))
  (.exit js/process 2))

(defn run
  ([command args] (run command args nil))
  ([command args input]
   (let [r (.spawnSync child command (clj->js args)
                       #js {:cwd root :encoding "utf8" :maxBuffer 16777216 :input input})]
     ;; EPIPE on `input` -- the child exited before reading what it was fed
     ;; -- is a RESULT with a status, not a harness failure: measured
     ;; 2026-09-16 with wire 41 unrouted, the stdin probe threw here instead
     ;; of printing FAIL, which is a control that cannot go red. Only a
     ;; process that did not run at all is thrown.
     (when (and (.-error r) (nil? (.-status r))) (throw (.-error r)))
     {:status (.-status r) :out (or (.-stdout r) "") :err (or (.-stderr r) "")})))

;; The guest: two lines around a diagnostic, then a loop that burns CPU for
;; as many iterations as argument 0 names, then -- when argument 1 is
;; "trap" -- a deliberate trap after one more line. Argument 0 is decimal
;; text, parsed here because wire 38 answers text.
(def guest
  "(ns probe.core (:export [main]))
(defn arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn emit [s :string] :string (typed-cap-call :io/write :string :string s))
(defn emit-error [s :string] :string (typed-cap-call :io/write-error :string :string s))
(defn stdin [s :string] :string (typed-cap-call :io/read :string :string s))
(defn clock [s :string] :string (typed-cap-call :clock/now :string :string s))
(defn sha [s :string] :string (typed-cap-call :hash/sha256 :string :string s))
(defn fsq [s :string] :string (typed-cap-call :fs/app-data :string :string s))
(defn chunks [n :i64] :i64
  (let [c (stdin \"4\")]
    (if (= 0 (string-byte-length c)) n (do (emit c) (emit \"|\") (chunks (+ n 1))))))
(defn nl [] :string (string-substring \"a
b\" 1 2))
(defn digit-value [s :string i :i64] :i64
  (let [c (string-code-point-at s i)] (if (< c 48) -1 (if (> c 57) -1 (- c 48)))))
(defn text->i64 [s :string i :i64 n :i64 acc :i64] :i64
  (if (>= i n) acc (text->i64 s (+ i 1) n (+ (* acc 10) (digit-value s i)))))
(defn spin [i :i64 stop :i64 acc :i64] :i64
  (if (>= i stop) acc (spin (+ i 1) stop (+ acc (quot i 7)))))
(defn grow [s :string k :i64] :string
  (if (<= k 0) s (grow (string-concat s s) (- k 1))))
(defn flood [s :string k :i64] :i64
  (if (<= k 0) 0 (do (emit s) (flood s (- k 1)))))
(defn main [] :i64
  (do
    (emit \"one\") (emit (nl))
    (emit-error \"diag\") (emit-error (nl))
    (emit \"two\") (emit (nl))
    (if (< (spin 0 (text->i64 (arg \"0\") 0 (string-byte-length (arg \"0\")) 0) 0) 0)
      7
      (if (string=? (arg \"1\") \"trap\")
        (do (emit \"three\") (emit (nl))
            (string-code-point-at (string-substring (arg \"1\") 0 0) 0))
        (if (string=? (arg \"1\") \"fd\")
          (do (emit \"[\") (emit (fsq (arg \"2\"))) (emit \"]\") 0)
        (if (string=? (arg \"1\") \"mtime\")
          (do (emit \"[\") (emit (fsq (string-concat (arg \"2\") \"MTIME_SEP\"))) (emit \"][\")
              (emit (fsq (string-concat (arg \"2\") \"-missingMTIME_SEP\"))) (emit \"]\") 0)
        (if (string=? (arg \"1\") \"sha\")
          (do (emit (sha \"abc\")) (emit \"|\") (emit (sha \"\")) (emit \"|\") (emit (sha (grow (string-concat \"flood\" (nl)) 12))) 0)
        (if (string=? (arg \"1\") \"clock\")
          (do (emit (clock \"wall\")) (emit \"|\") (emit (clock \"monotonic\")) (emit \"|\") (emit (clock \"monotonic\")) 0)
        (if (string=? (arg \"1\") \"clock-bad\")
          (do (emit (clock \"x\")) 0)
        (if (string=? (arg \"1\") \"slurp\")
          (do (emit (stdin \"\")) 0)
          (if (string=? (arg \"1\") \"chunk\")
            (chunks 0)
            (if (string=? (arg \"1\") \"flood\")
              (flood (grow (string-concat \"flood\" (nl)) 12) 16)
              0))))))))))))
")

(def failures (atom 0))
(defn check! [label ok? detail]
  (println (str (if ok? "PASS " "FAIL ") label (when-not ok? (str " -- " (pr-str detail)))))
  (when-not ok? (swap! failures inc)))

(def extract (atom nil))

(defn package!
  ([name cpu-seconds] (package! name cpu-seconds "37,38,39"))
  ([name cpu-seconds allow] (package! name cpu-seconds allow []))
  ([name cpu-seconds allow extra]
  (let [out (file name)
        r (run js/process.execPath
               (into
               [kbb "--backend" "sci" packager
                "--code" (file "probe.bin") "--offset" (str (:offset @extract))
                "--isa" (:isa @extract) "--allow" allow
                "--fuel" "100000000000" "--pairs" "100000" "--string-pool" "1000000"
                "--cpu-seconds" (str cpu-seconds) "--wall-seconds" "600"
                "--output" out]
               extra))]
    (when (not= 0 (:status r)) (refuse (str "package failed: " (:err r) (:out r))))
    out)))

(when-not (.existsSync fs amu) (refuse (str "no amu at " amu)))
;; The trap is a HOST refusal on purpose: `string-code-point-at` past the end
;; of a computed empty string reaches the loader's slot, which raises SIGILL.
;; It was `(string-code-point-at "" 0)` until 2026-09-16, when kotoba-native
;; started walking ASCII LITERALS in line (a bounded byte load whose window
;; check is `brk`, SIGTRAP -- the kernel family's trap, for objects with no
;; host); that is a different refusal from the one this probe measures, and
;; the supervisor reports both as :trap.
(.writeFileSync fs (file "probe.kotoba") guest "utf8")
(.writeFileSync fs (file "policy.edn")
                "{:allow #{[:cap/call 3] [:cap/call 7] [:cap/call 35] [:cap/call 37] [:cap/call 38] [:cap/call 39] [:cap/call 41]}}" "utf8")
(let [isa (if (contains? #{"arm64" "aarch64"} (.arch os)) "aarch64" "x86_64")
      target (if (= isa "aarch64") "aarch64-macos" "x86_64-linux")
      c (run js/process.execPath [amu "compile" (file "probe.kotoba") "--target" target
                                  "--jvm-free" "--policy" (file "policy.edn")
                                  "--output" (file "probe.kexe")])]
  (when (not= 0 (:status c)) (refuse (str "compile failed: " (:err c) (:out c))))
  (let [e (run js/process.execPath [amu "extract-native" (file "probe.kexe")
                                    "--symbol" "main" "--output" (file "probe.bin")])
        offset (second (re-find #":offset (\d+)" (:out e)))]
    (when (or (not= 0 (:status e)) (nil? offset))
      (refuse (str "extract failed: " (:err e) (:out e))))
    (reset! extract {:offset offset :isa isa})))

;; 1. Ordering across the buffer: stdout carries both lines, stderr the
;;    diagnostic, and the exit status is the guest's answer.
(let [exe (package! "probe-order" 60)
      r (run exe ["1" "-"])]
  (check! "stdout is buffered and complete" (= "one\ntwo\n" (:out r)) r)
  (check! "the diagnostic reaches stderr" (= "diag\n" (:err r)) r)
  (check! "the exit status is the guest's answer" (= 0 (:status r)) r))

;; 2. The buffer survives a trap: `three` was answered with a count of 6
;;    before the guest trapped, so it must be on fd 1 beside the trap report.
(let [exe (package! "probe-trap" 60)
      r (run exe ["1" "trap"])]
  (check! "bytes counted before a trap reach stdout"
          (= "one\ntwo\nthree\n" (:out r)) r)
  (check! "the trap is reported as SIGILL, exit 120"
          (and (= 120 (:status r))
               (str/includes? (:err r) "KEXE_TRAP {:kind :signal :signal :SIGILL}"))
          r))

;; 3. The CPU budget, both directions, on one guest and one iteration count.
;;    Three thousand million iterations is several CPU seconds on any
;;    machine this runs on; the refusing arm names one second.
(let [iterations "3000000000"
      tight (package! "probe-cpu-1" 1)
      r (run tight [iterations "-"])]
  (check! "over the CPU budget: SIGXCPU, exit 120, output so far kept"
          (and (= 120 (:status r))
               (str/includes? (:err r) "KEXE_TRAP {:kind :signal :signal :SIGXCPU}")
               (= "one\ntwo\n" (:out r)))
          r))
(let [wide (package! "probe-cpu-60" 60)
      r (run wide ["3000000000" "-"])]
  (check! "under the CPU budget: the same guest completes"
          (and (= 0 (:status r)) (= "one\ntwo\n" (:out r)))
          r))

;; 4. The packager refuses a budget that is not a positive decimal.
(let [r (run js/process.execPath
             [kbb "--backend" "sci" packager
              "--code" (file "probe.bin") "--offset" (str (:offset @extract))
              "--isa" (:isa @extract) "--allow" "37,38,39"
              "--cpu-seconds" "0" "--output" (file "probe-refused")])]
  (check! "--cpu-seconds 0 is refused by the packager"
          (and (= 2 (:status r))
               (str/includes? (:out r) "--cpu-seconds must be a positive decimal"))
          r))

;; 5. The vector budgets (2026-09-16) are flags of the same shape, refused
;;    the same way -- a probe that says "vectors" so a typo in the flag name
;;    is a named failure rather than a silent default.
(let [r (run js/process.execPath
             [kbb "--backend" "sci" packager
              "--code" (file "probe.bin") "--offset" (str (:offset @extract))
              "--isa" (:isa @extract) "--allow" "37,38,39"
              "--vector-items" "0" "--output" (file "probe-refused")])]
  (check! "--vector-items 0 is refused by the packager"
          (and (= 2 (:status r))
               (str/includes? (:out r) "--vector-items must be a positive decimal"))
          r))
(let [r (run js/process.execPath
             [kbb "--backend" "sci" packager
              "--code" (file "probe.bin") "--offset" (str (:offset @extract))
              "--isa" (:isa @extract) "--allow" "37,38,39"
              "--vectors" "x" "--output" (file "probe-refused")])]
  (check! "--vectors x is refused by the packager"
          (and (= 2 (:status r))
               (str/includes? (:out r) "--vectors must be a positive decimal"))
          r))

;; 6. Standard input, wire 41 (2026-09-16). One guest compiled with the
;;    grant admitted, packaged TWICE -- with 41 in the allow mask and
;;    without -- because the mask is the whole enforcement: Seatbelt does not
;;    mediate read(2) on an inherited descriptor, so the only thing standing
;;    between a guest and stdin is this bit, and a suite that only ran the
;;    granted binary would not know whether the bit does anything.
;;
;;    Both forms, both directions:
;;      slurp  -- "" answers everything to EOF, bytes exact; the same guest
;;                with input past the 1,000,000-byte string pool is refused
;;                (SIGILL, exit 120) rather than answered short.
;;      chunk  -- "4" answers at most four bytes at a time and the empty
;;                string at EOF, so 11 bytes arrive as abcd|efgh|ijk| and
;;                the walk ends; the exit status is the chunk COUNT so a walk
;;                that never saw EOF is a different number, not a hang.
;;      utf-8  -- "4" over three 3-byte code points: a chunk cut at byte
;;                four would split the second one, and the guest's next
;;                string operation would trap on the fragment. The loader
;;                holds an incomplete tail back for the next answer, so the
;;                chunks are the code points themselves, 日|本|語|, three
;;                of them -- byte-exact, since an answer of the wrong shape
;;                would still be nine bytes.
;;      no bit -- the ungranted binary traps at the first call, and its
;;                stdout still carries `one\ntwo\n` (the trap is the
;;                guest's third call, not a startup refusal). The signal is
;;                SIGTRAP, not SIGILL: kotoba-native EMITS the allow-mask
;;                check in line (`brk`, kotoba-native ADR 0084) before the
;;                host slot is ever called, so the loader's own SIGILL check
;;                in checked_typed_cap_call is the second line and is not
;;                reached. Measured 2026-09-16; pinned so that a loader that
;;                stopped checking would still be told apart from one whose
;;                caller stopped checking first.
(let [granted (package! "probe-stdin" 60 "37,38,39,41")
      denied (package! "probe-stdin-denied" 60 "37,38,39")
      slurp (run granted ["1" "slurp"] "abcdefghijk")
      chunk (run granted ["1" "chunk"] "abcdefghijk")
      utf8 (run granted ["1" "chunk"] "\u65e5\u672c\u8a9e")
      empty-in (run granted ["1" "slurp"] "")
      over (run granted ["1" "slurp"] (.repeat "x" 1000001))
      nobit (run denied ["1" "slurp"] "abc")]
  (check! "slurp: the empty request answers stdin to EOF, bytes exact"
          (and (= 0 (:status slurp)) (= "one\ntwo\nabcdefghijk" (:out slurp)))
          slurp)
  (check! "chunk: \"4\" answers at most four bytes, empty at EOF, three chunks"
          (and (= 3 (:status chunk)) (= "one\ntwo\nabcd|efgh|ijk|" (:out chunk)))
          chunk)
  (check! "chunk over UTF-8: an incomplete tail is held for the next answer, 日|本|語|"
          (and (= 3 (:status utf8)) (= "one\ntwo\n\u65e5|\u672c|\u8a9e|" (:out utf8)))
          utf8)
  (check! "empty stdin: the empty request answers the empty string, exit 0"
          (and (= 0 (:status empty-in)) (= "one\ntwo\n" (:out empty-in)))
          empty-in)
  (check! "input past the string pool is refused (SIGILL, 120), not answered short"
          (and (= 120 (:status over))
               (str/includes? (:err over) "KEXE_TRAP {:kind :signal :signal :SIGILL}"))
          over)
  (check! "without bit 41 in the allow mask the first read traps (emitted check: SIGTRAP, 120)"
          (and (= 120 (:status nobit))
               (= "one\ntwo\n" (:out nobit))
               (str/includes? (:err nobit) "KEXE_TRAP {:kind :signal :signal :SIGTRAP}"))
          nobit))

;; 7. A reader that goes away is not a trap (2026-09-16). `flood` writes
;;    6 * 4096 * 16 = 393,216 bytes -- past the 64 KiB stdout buffer AND the
;;    64 KiB pipe -- into `head -c 1`, so the child dies at write(2) of
;;    SIGPIPE whether head has already left or leaves while the child is
;;    blocked on a full pipe. The supervisor must then die the same death:
;;    bash spells that 141, and stderr carries NOTHING -- before this it
;;    carried "KEXE_TRAP {:kind :supervisor :reason :unhandled-child-signal}"
;;    and the exit was 123, for the most common pipeline shape agents use
;;    (`grep ... | head`). The other direction: the same flood into a reader
;;    that stays is exit 0 with every byte, so 141 is the reader's doing.
(let [exe (package! "probe-flood" 60)
      gone (run "bash" ["-c" (str "'" exe "' 1 flood | head -c 1 >/dev/null; echo \"${PIPESTATUS[0]}\"")])
      stays (run "bash" ["-c" (str "'" exe "' 1 flood | wc -c | tr -d ' '; echo \"${PIPESTATUS[0]}\"")])]
  (check! "reader gone: the supervisor exits 141 with nothing on stderr"
          (and (= 0 (:status gone))
               (= "141\n" (:out gone))
               (= "diag\n" (:err gone)))
          gone)
  (check! "reader stays: the same flood is exit 0 and 8 + 393216 bytes"
          (and (= 0 (:status stays))
               (= "393224\n0\n" (:out stays))
               (= "diag\n" (:err stays)))
          stays))

;; 8. The clock's TEXT form, wire 7 (2026-09-16). The clock-v1 record codec
;;    is not admitted on the JVM-free native route, so a packaged command
;;    could not read a clock: the fall-through echoed the request and a
;;    guest printed "wall". Now "wall" answers unix milliseconds and
;;    "monotonic" nanoseconds, as decimal text; an unknown request traps
;;    (SIGILL, the loader's own check) rather than echoing; and the grant
;;    is bit 7 -- the same guest packaged without it traps at the call
;;    (SIGTRAP, the emitted mask check). The wall answer is checked against
;;    the harness's own clock to within five seconds, and the two monotonic
;;    answers must not go backwards.
(let [granted (package! "probe-clock" 60 "7,37,38,39,41")
      denied (package! "probe-clock-denied" 60 "37,38,39,41")
      before (.now js/Date)
      r (run granted ["1" "clock"])
      after (.now js/Date)
      parts (str/split (subs (:out r) 8) #"\|")
      wall (js/parseInt (nth parts 0 "x") 10)
      mono1 (js/parseInt (nth parts 1 "x") 10)
      mono2 (js/parseInt (nth parts 2 "x") 10)
      bad (run granted ["1" "clock-bad"])
      nobit (run denied ["1" "clock"])]
  (check! "clock wall: decimal unix milliseconds within 5 s of the harness clock"
          (and (= 0 (:status r)) (str/starts-with? (:out r) "one\ntwo\n")
               (not (js/isNaN wall)) (<= (- before 5000) wall (+ after 5000)))
          {:out (:out r) :before before :after after})
  (check! "clock monotonic: two decimal answers, the second not before the first"
          (and (not (js/isNaN mono1)) (not (js/isNaN mono2)) (<= mono1 mono2) (< 0 mono1))
          {:out (:out r)})
  (check! "clock: an unknown request traps (SIGILL) rather than echoing it"
          (and (= 120 (:status bad)) (= "one\ntwo\n" (:out bad))
               (str/includes? (:err bad) "KEXE_TRAP {:kind :signal :signal :SIGILL}"))
          bad)
  (check! "clock: without bit 7 the call traps (emitted check: SIGTRAP)"
          (and (= 120 (:status nobit)) (= "one\ntwo\n" (:out nobit))
               (str/includes? (:err nobit) "KEXE_TRAP {:kind :signal :signal :SIGTRAP}"))
          nobit))

;; 9. :hash/sha256, wire 3 (2026-09-16). The switch fell through to identity
;;    for this id, so a guest asking for a digest got its input back. Now
;;    the FIPS 180-4 vectors: "abc" and the empty string, plus a 24,576-byte
;;    input (crosses many blocks and the two-block padding case), checked
;;    against node's own crypto -- and the ungranted binary traps at the
;;    call (SIGTRAP, the emitted mask check).
(let [granted (package! "probe-sha" 60 "3,37,38,39,41")
      denied (package! "probe-sha-denied" 60 "37,38,39,41")
      r (run granted ["1" "sha"])
      parts (str/split (subs (:out r) 8) #"\|")
      big (.repeat "flood\n" 4096)
      big-hex (.digest (.update (.createHash (js/require "node:crypto") "sha256") big) "hex")
      nobit (run denied ["1" "sha"])]
  (check! "sha256: the FIPS vectors, \"abc\" and the empty string"
          (and (= 0 (:status r))
               (= "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" (nth parts 0 ""))
               (= "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" (nth parts 1 "")))
          r)
  (check! "sha256: a 24,576-byte input matches node's crypto"
          (= big-hex (nth parts 2 ""))
          {:got (nth parts 2 "") :want big-hex})
  (check! "sha256: without bit 3 the call traps (emitted check: SIGTRAP)"
          (and (= 120 (:status nobit)) (= "one\ntwo\n" (:out nobit))
               (str/includes? (:err nobit) "KEXE_TRAP {:kind :signal :signal :SIGTRAP}"))
          nobit))

;; 10. The MTIME form of wire 35 (2026-09-16): "<path>MTIME_SEP" answers
;;     the modification time as seconds since 1970, "" for a path that
;;     cannot be stat'ed. Its own form rather than a fifth STAT field
;;     (org-ieee-du reads STAT's fourth field to the end of the string). The
;;     harness sets the file's mtime to 1700000000 first, so the answer is a
;;     known number and not "whatever the clock said"; the ungranted binary
;;     (no bit 35) traps at the call.
(let [dir (file "mtime-data")
      _ (.mkdirSync fs dir)
      f (.join path dir "f")
      _ (.writeFileSync fs f "x" "utf8")
      _ (.utimesSync fs f 1700000000 1700000000)
      scope (.realpathSync fs dir)
      granted (package! "probe-mtime" 60 "35,37,38,39" ["--fs-scope" scope])
      denied (package! "probe-mtime-denied" 60 "37,38,39" ["--fs-scope" scope])
      r (run granted ["1" "mtime" (.join path scope "f")])
      nobit (run denied ["1" "mtime" (.join path scope "f")])]
  (check! "mtime: a known modification time, and \"\" for a missing path"
          (and (= 0 (:status r)) (= "one\ntwo\n[1700000000][]" (:out r)))
          r)
  (check! "mtime: without bit 35 the call traps (emitted check: SIGTRAP)"
          (and (= 120 (:status nobit)) (= "one\ntwo\n[" (:out nobit))
               (str/includes? (:err nobit) "KEXE_TRAP {:kind :signal :signal :SIGTRAP}"))
          nobit))

;; 11. A /dev/fd scope entry (2026-09-16): "the descriptors the caller
;;     connected". `diff <(a) <(b)` hands /dev/fd/N operands over, and such
;;     a descriptor has no path under any grant (a pipe has none at all), so
;;     the containment check honours an entry that IS /dev/fd the way wire
;;     41 honours standard input. Both directions: packaged WITH /dev/fd the
;;     guest reads fd 3 (a pipe from bash process substitution, and a file
;;     outside every other grant); packaged WITHOUT it the same read traps
;;     (SIGILL: the loader's own containment, since lexical admission fails
;;     before any emitted check could).
(let [dir (file "fd-data")
      _ (.mkdirSync fs dir)
      scope (.realpathSync fs dir)
      granted (package! "probe-fd" 60 "35,37,38,39" ["--fs-scope" (str scope ":/dev/fd")])
      denied (package! "probe-fd-denied" 60 "35,37,38,39" ["--fs-scope" scope])
      outside (file "outside.txt")
      _ (.writeFileSync fs outside "from a file outside the grant" "utf8")
      pipe (run "bash" ["-c" (str "'" granted "' 1 fd /dev/fd/3 3< <(printf 'from a pipe')")])
      filefd (run "bash" ["-c" (str "'" granted "' 1 fd /dev/fd/3 3< '" outside "'")])
      nofd (run "bash" ["-c" (str "'" denied "' 1 fd /dev/fd/3 3< <(printf 'from a pipe')")])]
  (check! "/dev/fd scope: a process-substitution pipe is read to EOF"
          (and (= 0 (:status pipe)) (= "one\ntwo\n[from a pipe]" (:out pipe)))
          pipe)
  (check! "/dev/fd scope: an inherited file descriptor is read wherever its file lives"
          (and (= 0 (:status filefd)) (= "one\ntwo\n[from a file outside the grant]" (:out filefd)))
          filefd)
  (check! "without /dev/fd in the scope the same read traps (SIGILL, exit 120)"
          (and (= 120 (:status nofd)) (= "one\ntwo\n[" (:out nofd))
               (str/includes? (:err nofd) "KEXE_TRAP {:kind :signal :signal :SIGILL}"))
          nofd))

;; 12. A $PATH scope entry (2026-09-16): "the directories of the caller's
;;     PATH at start". `which` must look where the caller's shell looks,
;;     and a packaged scope cannot know that in advance. The environment is
;;     otherwise ignored by a packaged command; this is the one deliberate
;;     exception, and it is the CALLER's choice like stdin and /dev/fd.
;;     The PATH directory lives OUTSIDE the directly granted scope (the
;;     first cut put it inside, and two of these three passed for the wrong
;;     reason). Both directions: packaged WITH `$PATH` the guest reads a
;;     file under a directory that is on PATH only for this run; the same
;;     file with PATH not naming its directory traps (SIGILL, the loader's
;;     own admission) -- the entry grants PATH, not the world; and packaged
;;     WITHOUT the entry the read traps too.
(let [dir (file "path-data")
      _ (.mkdirSync fs dir)
      _ (.mkdirSync fs (file "path-outside"))
      pdir (.join path (.realpathSync fs (file "path-outside")) "bin")
      _ (.mkdirSync fs pdir)
      tool (.join path pdir "tool")
      _ (.writeFileSync fs tool "tool bytes" "utf8")
      scope (.realpathSync fs dir)
      granted (package! "probe-path" 60 "35,37,38,39" ["--fs-scope" (str scope ":$PATH")])
      denied (package! "probe-path-denied" 60 "35,37,38,39" ["--fs-scope" scope])
      with-path (fn [exe' p env-path]
                  (.spawnSync child exe' (clj->js ["1" "fd" p])
                              #js {:cwd root :encoding "utf8" :maxBuffer 16777216
                                   :env (js/Object.assign #js {} (.-env js/process) #js {:PATH env-path})}))
      as-result (fn [r] {:status (.-status r) :out (or (.-stdout r) "") :err (or (.-stderr r) "")})
      on-path (as-result (with-path granted tool (str pdir ":/usr/bin:/bin")))
      off-path (as-result (with-path granted tool "/usr/bin:/bin"))
      nobit (as-result (with-path denied tool (str pdir ":/usr/bin:/bin")))]
  (check! "$PATH scope: a file under a directory on the caller's PATH is read"
          (and (= 0 (:status on-path)) (= "one\ntwo\n[tool bytes]" (:out on-path)))
          on-path)
  (check! "$PATH scope: the same file with PATH not naming its directory traps (SIGILL)"
          (and (= 120 (:status off-path)) (= "one\ntwo\n[" (:out off-path))
               (str/includes? (:err off-path) "KEXE_TRAP {:kind :signal :signal :SIGILL}"))
          off-path)
  (check! "without $PATH in the scope the read traps (SIGILL)"
          (and (= 120 (:status nobit)) (= "one\ntwo\n[" (:out nobit))
               (str/includes? (:err nobit) "KEXE_TRAP {:kind :signal :signal :SIGILL}"))
          nobit))

(println (str "SCANNED\t" 33 "\tFAILED\t" @failures))
(.exit js/process (if (zero? @failures) 0 1))
