#!/usr/bin/env kbb
(ns test-linux-static-handlers
  "The capability handlers of the loader-less Linux static ELF, run on Linux
  and compared with kexe + loader (superproject adr-2609251400 C3).

  One guest (below) is compiled four ways -- aarch64-linux and x86_64-linux
  kexe (run by tools/kexe_loader.c built for that ISA) and
  aarch64-linux-static and x86_64-linux-static (run as the process itself) --
  with the same capabilities admitted, and every case runs through both
  paths on both ISAs. A case asserts literals (the answer, the trap line) and
  that the two paths agree: the same stdout, the same stderr, and the same
  exit status under the one documented mapping (a budget or slot trap is 120
  from the loader's supervisor and has its own code in the static profile,
  lang/limits.edn :static-elf :exit-codes). A case that is EXPECTED to differ
  names the difference and asserts each side's own literal.

  Linux is reached one of two ways:
    --vm podman   (default off Linux) through `podman machine ssh`; the work
                  directory must be one the machine mounts ($TMPDIR is, under
                  /var/folders). x86_64 runs under qemu-x86_64-static there.
    --vm none     (default on Linux) directly; the other ISA through
                  qemu-<isa>-static when it is present, else skipped BY NAME.
  The loaders are built with --gcc-image <image> (a container with gcc and
  gcc-x86-64-linux-gnu) under podman, or with cc / x86_64-linux-gnu-gcc when
  run directly.

    kbb --backend sci --classpath . scripts/test-linux-static-handlers.cljk [--vm podman] [--gcc-image localhost/c3-gcc]

  The kexe loader needs vm.overcommit_memory=1 for its shared-state mmap on a
  small VM (measured in C2); pass --overcommit to set it for the run and put
  the previous value back afterwards.

  A second guest (C3, second half: :entropy/draw, :process/spawn and the
  :fs/app-data forms append, range, chmod, fsync, make-temp-dir,
  stat-nofollow) is compiled the same four ways with its own policies: one
  whose :spawn grant names nine programs, one that also admits lookup by
  name, and one whose fs scope is spelled through a symlink. The kexe loader
  answers wire 20 and 23 with the qualification identity stub and does not
  know the three proposed forms, so those cases are documented differences
  that assert the loader's own literal. Two cases run the static image in a
  podman container whose seccomp profile answers getrandom and close_range
  with ENOSYS (the named refusals a kernel without them gets).

    --only-isa aarch64|x86_64   one ISA (builds and cases)
    --only <regex>              only the cases whose name matches
    --static-only               only the static images (no loader built or
                                run): the mode the break-it runs use

  Exit 0 all cases held, 1 a case failed, 2 could not run."
  (:require [kotoba.lang.text :as str]
            [scripts.lib :as lib]
            ["node:fs" :as fs]
            ["node:os" :as os]))

(def argv (vec *command-line-args*))
(defn opt [flag default]
  (let [i (.indexOf (to-array argv) flag)] (if (>= i 0) (nth argv (inc i) default) default)))
(defn flag? [flag] (some #{flag} argv))

(def vm (opt "--vm" (if (= "linux" (.platform os)) "none" "podman")))
(def gcc-image (opt "--gcc-image" "localhost/c3-gcc"))
(def amu (lib/join lib/root "bin" "amu"))
(def work (lib/temp-dir "c3-static-handlers-"))
;; Per run, so two runs on one VM (two agents, two ISAs) do not rebuild each
;; other's scope between a case's setup and its run -- which happened
;; (`ln: ... File exists`, 2026-09-25).
(def run-tag (str (.-pid js/process)))
(def scope (str "/var/tmp/c3scope-" run-tag))
(def outside-name (str "c3outside-" run-tag))
(def outside (str "/var/tmp/" outside-name))
(def link-name (str "c3link-" run-tag))
(def link (str "/var/tmp/" link-name))

;; What a run must undo however it ends: fail! exits the process, so the
;; `finally` below never runs on that path -- a setup failure left the VM at
;; vm.overcommit_memory=1 (measured 2026-09-25).
(def on-exit (atom nil))
(defn fail! [message]
  (.error js/console (str "test-linux-static-handlers: " message))
  (when-let [f @on-exit] (reset! on-exit nil) (f))
  (.exit js/process 2))

(defn quote-arg [s] (str "'" (str/replace (str s) "'" "'\\''") "'"))

(defn linux!
  "Run `command` (one shell command line) on Linux; {:status :stdout :stderr}."
  [command]
  (let [r (if (= vm "podman")
            (lib/run "podman" ["machine" "ssh" command] {:allow-failure? true :max-buffer (* 64 1024 1024)})
            (lib/run "sh" ["-c" command] {:allow-failure? true :max-buffer (* 64 1024 1024)}))]
    r))

(def host-isa
  (let [m (str/trim (:stdout (linux! "uname -m")))]
    (case m "aarch64" "aarch64" "arm64" "aarch64" "x86_64" "x86_64" (fail! (str "unknown Linux machine " m)))))

(defn runner [isa]
  (if (= isa host-isa) "" (str "qemu-" isa "-static ")))

;; ---------------------------------------------------------------------------
;; The guest
;; ---------------------------------------------------------------------------

(def guest
  "(ns probe.core (:export [main]))
(defn arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn emit [s :string] :string (typed-cap-call :io/write :string :string s))
(defn emit-error [s :string] :string (typed-cap-call :io/write-error :string :string s))
(defn stdin [s :string] :string (typed-cap-call :io/read :string :string s))
(defn env [s :string] :string (typed-cap-call :env/read :string :string s))
(defn clock [s :string] :string (typed-cap-call :clock/now :string :string s))
(defn fsq [s :string] :string (typed-cap-call :fs/app-data :string :string s))
(defn browse [s :string] :string (typed-cap-call :fs/browse :string :string s))
(defn nl [] :string (string-substring \"a
b\" 1 2))
(defn line [s :string] :i64 (do (emit s) (emit (nl)) 0))
(defn show [label :string s :string] :i64
  (do (emit label) (emit \"=[\") (emit s) (emit \"]\") (emit (nl)) 0))
(defn idx [n :i64] :string
  (cond (= n 0) \"0\" (= n 1) \"1\" (= n 2) \"2\" (= n 3) \"3\" (= n 4) \"4\"
        (= n 5) \"5\" (= n 6) \"6\" (= n 7) \"7\" (= n 8) \"8\" :else \"9\"))
(defn echo-args [n :i64] :i64
  (let [a (arg (idx n))]
    (if (string=? a \"\") n (do (show (string-concat \"arg\" (idx n)) a) (echo-args (+ n 1))))))
(defn chunks [n :i64] :i64
  (let [c (stdin \"4\")]
    (if (string=? c \"\") n (do (emit c) (emit \"|\") (chunks (+ n 1))))))
(defn monotonic [k :i64 last :string] :string
  (if (<= k 0) last (monotonic (- k 1) (clock \"monotonic\"))))
(defn main [] :i64
  (let [mode (arg \"0\") p (arg \"1\")]
    (cond
      (string=? mode \"echo\")
      (do (show \"argc\" (arg \"\")) (echo-args 0)
          (show \"C3_VAR\" (env \"C3_VAR\")) (show \"UNSET\" (env \"C3_SURELY_UNSET\")) 0)
      (string=? mode \"cat\") (do (emit (fsq p)) 0)
      (string=? mode \"exists\") (do (show \"exists\" (fsq (string-concat p \"EXISTS_SEP\"))) 0)
      (string=? mode \"stat\") (do (show \"stat\" (fsq (string-concat p \"STAT_SEP\"))) 0)
      (string=? mode \"missing\")
      (do (show \"exists\" (fsq (string-concat p \"EXISTS_SEP\")))
          (show \"stat\" (fsq (string-concat p \"STAT_SEP\")))
          (emit \"reading anyway\") (emit (nl))
          (show \"read\" (fsq p)) 0)
      (string=? mode \"wr\")
      (let [f (string-concat p \"/note.txt\") d (string-concat p \"/made\") g (string-concat p \"/moved.txt\")]
        (do (show \"write\" (fsq (string-concat f (string-concat \"WRITE_SEP\" \"hello static
second line
\"))))
            (show \"read\" (fsq f))
            (show \"stat\" (fsq (string-concat f \"STAT_SEP\")))
            (show \"exists\" (fsq (string-concat f \"EXISTS_SEP\")))
            (show \"mkdir\" (fsq (string-concat d \"MKDIR_SEP\")))
            (show \"mkdir-again\" (fsq (string-concat d \"MKDIR_SEP\")))
            (show \"rename\" (fsq (string-concat f (string-concat \"RENAME_SEP\" g))))
            (show \"old-exists\" (fsq (string-concat f \"EXISTS_SEP\")))
            (show \"moved\" (fsq g))
            (show \"unlink\" (fsq (string-concat g \"UNLINK_SEP\")))
            (show \"unlink-again\" (fsq (string-concat g \"UNLINK_SEP\")))
            (show \"rmdir\" (fsq (string-concat d \"RMDIR_SEP\")))
            (show \"gone\" (fsq (string-concat d \"EXISTS_SEP\"))) 0))
      (string=? mode \"mkdir\") (do (show \"mkdir\" (fsq (string-concat p \"MKDIR_SEP\"))) 0)
      (string=? mode \"ls\") (do (show \"ls\" (browse p)) 0)
      (string=? mode \"clock\")
      (let [a (clock \"monotonic\") w (clock \"wall\") b (monotonic 1000 a)]
        (do (show \"wall\" w) (show \"mono1\" a) (show \"mono2\" b) 0))
      (string=? mode \"clock-bad\") (do (show \"bad\" (clock \"hourly\")) 0)
      (string=? mode \"slurp\") (do (show \"stdin\" (stdin \"\")) 0)
      (string=? mode \"chunk\") (chunks 0)
      (string=? mode \"err\") (do (emit-error \"to stderr\") (emit-error (nl)) (line \"to stdout\"))
      (string=? mode \"append\") (do (show \"append\" (fsq (string-concat p \"APPEND_SEPx\"))) 0)
      (string=? mode \"mtime\") (do (show \"mtime\" (fsq (string-concat p \"MTIME_SEP\"))) 0)
      (string=? mode \"arg-bad\") (do (show \"arg\" (arg \"1x\")) 0)
      (string=? mode \"rename-out\") (do (show \"rename\" (fsq (string-concat p (string-concat \"RENAME_SEP\" (arg \"2\"))))) 0)
      (string=? mode \"write\") (do (show \"write\" (fsq (string-concat p \"WRITE_SEPbody\"))) 0)
      (string=? mode \"chmod\") (do (show \"chmod\" (fsq (string-concat p \"CHMOD_SEP600\"))) 0)
      :else (do (line \"unknown mode\") 1))))
")

;; The second guest (C3, second half). Every :fs/app-data token it sends
;; arrives through argv: a literal proposed token would make amu refuse the
;; kexe compile by name (kotoba.compiler.kexe-fs-forms) -- which the case
;; `kexe-compile-refuses-a-proposed-form` asserts separately.
(def guest2
  "(ns probe.core (:export [main]))
(defn arg [i :string] :string (typed-cap-call :cli/args :string :string i))
(defn emit [s :string] :string (typed-cap-call :io/write :string :string s))
(defn draw [s :string] :string (typed-cap-call :entropy/draw :string :string s))
(defn spawn [s :string] :string (typed-cap-call :process/spawn :string :string s))
(defn fsq [s :string] :string (typed-cap-call :fs/app-data :string :string s))
(defn nl [] :string (string-substring \"a
b\" 1 2))
(defn show [label :string s :string] :i64
  (do (emit label) (emit \"=[\") (emit s) (emit \"]\") (emit (nl)) 0))
(defn idx [n :i64] :string
  (cond (= n 1) \"1\" (= n 2) \"2\" (= n 3) \"3\" (= n 4) \"4\" (= n 5) \"5\" :else \"6\"))
;; two cells a draw (the answer and the write's count), so a thousand fit
;; the default 4,096; the harness cuts the output into 32-character draws
(defn draws [k :i64] :i64
  (if (<= k 0) (do (emit (nl)) 0) (do (emit (draw \"16\")) (draws (- k 1)))))
(defn fs-all [n :i64] :i64
  (let [r (arg (idx n))]
    (if (string=? r \"\") (- n 1) (do (show \"fs\" (fsq r)) (fs-all (+ n 1))))))
(defn main [] :i64
  (let [mode (arg \"0\") p (arg \"1\")]
    (cond
      (string=? mode \"draws\") (draws 1000)
      (string=? mode \"draw\") (show \"draw\" (draw p))
      (string=? mode \"sp\") (show \"spawn\" (spawn p))
      (string=? mode \"fs\") (fs-all 1)
      (string=? mode \"mkt\")
      (let [d (fsq p)] (do (show \"dir\" d) (show \"stat\" (fsq (string-concat d (arg \"2\"))))))
      (string=? mode \"chmod-ls\")
      (do (show \"chmod\" (fsq p)) (show \"ls\" (spawn (arg \"2\"))))
      :else (do (emit \"unknown mode\") 1))))
")

(def g2-ids [20 23 35 37 38])
(def g2-programs ["/bin/echo" "/usr/bin/false" "/bin/sh" "/usr/bin/seq" "/usr/bin/sleep"
                  "/usr/bin/ls" "/usr/bin/grep" "/bin/pwd" "/var/tmp/c3none/prog"])

(defn policy2-text [fs-scope lookup?]
  (str "{:allow #{" (str/join " " (map #(str "[:cap/call " % "]") g2-ids)) "}"
       " :linux-static {:fs-scope " (pr-str fs-scope)
       " :spawn {:programs [" (str/join " " (map pr-str g2-programs)) "]"
       (when lookup? " :path-lookup true")
       " :env [\"C3_VAR\"]}}}"))

(def all-ids [7 33 34 35 37 38 39 41])
(def denied-ids (vec (remove #{33} all-ids)))

(defn policy-text [grant]
  (str "{:allow #{" (str/join " " (map #(str "[:cap/call " % "]") all-ids)) "}"
       " :linux-static {:fs-scope " (pr-str scope)
       (when grant (str " :grant [" (str/join " " grant) "]")) "}}"))

;; --classpath-file names a file holding an nbb classpath to compile with
;; instead of bin/amu's locked one (a change to kotoba-native or
;; kotoba-verifier measured before it is pinned).
(def dev-classpath (some-> (opt "--classpath-file" nil) lib/read-text str/trim))

(defn amu-command [args]
  (if dev-classpath
    (let [driver (if (some #(str/starts-with? % "aarch64") args) "aarch64_cli.cljk" "x86_64_cli.cljk")]
      (into ["--stack-size=4096" (lib/join lib/root "node_modules" "nbb" "cli.js") "--classpath" dev-classpath
             (lib/join lib/root "src" "kotoba" "compiler" "nbb" driver)] args))
    (into [amu] args)))

(defn compile-result [source target output policy]
  (lib/run js/process.execPath (amu-command ["compile" source "--target" target
                                             "--policy" policy "--output" output])
           {:allow-failure? true}))

(defn compile!
  ([target output policy] (compile! (lib/join work "probe.kotoba") target output policy))
  ([source target output policy]
   (let [r (compile-result source target output policy)]
     (when-not (and (zero? (:status r)) (str/includes? (:stdout r) ":ok true"))
       (fail! (str "compile " target ": " (:stdout r) (:stderr r))))
     output)))

(defn extract! [kexe]
  (let [bin (str kexe ".bin")
        r (lib/run js/process.execPath (amu-command ["extract-native" kexe "--symbol" "main" "--output" bin])
                   {:allow-failure? true})
        offset (second (re-find #":offset (\d+)" (:stdout r)))]
    (when-not offset (fail! (str "extract-native " kexe ": " (:stdout r) (:stderr r))))
    {:bin bin :offset offset}))

(defn build-loaders! []
  (let [src (lib/join lib/root "tools" "kexe_loader.c")
        out (lib/join work "kexe_loader.c")]
    (fs/copyFileSync src out)
    ;; Two builds per ISA. The production loader (its Linux seccomp filter
    ;; in force) is what a user runs, and it runs only on the host ISA:
    ;; qemu-user cannot install a guest-arch seccomp filter (`seccomp:
    ;; Invalid argument`, measured). The other ISA runs the build that
    ;; compiles the filter out (-DKEXE_SANITIZER_TEST, the sanitizer
    ;; harness's switch: no seccomp, no RLIMIT_AS; every provider unchanged).
    (let [cmd (str "cd " (quote-arg work)
                   " && gcc -std=c11 -O2 -static kexe_loader.c -o loader-aarch64"
                   " && gcc -std=c11 -O2 -static -DKEXE_SANITIZER_TEST kexe_loader.c -o loader-aarch64-nosandbox"
                   " && x86_64-linux-gnu-gcc -std=c11 -O2 -static kexe_loader.c -o loader-x86_64"
                   " && x86_64-linux-gnu-gcc -std=c11 -O2 -static -DKEXE_SANITIZER_TEST kexe_loader.c -o loader-x86_64-nosandbox")
          r (if (= vm "podman")
              (linux! (str "podman run --rm -v " (quote-arg work) ":" (quote-arg work) " " gcc-image
                           " sh -c " (quote-arg cmd)))
              (linux! (str "cd " (quote-arg work) " && cc -std=c11 -O2 kexe_loader.c -o loader-" host-isa
                           " && cc -std=c11 -O2 -DKEXE_SANITIZER_TEST kexe_loader.c -o loader-" host-isa "-nosandbox")))]
      (when-not (zero? (:status r)) (fail! (str "building the loaders: " (:stdout r) (:stderr r)))))))

(def setup
  (str/join " && "
            [(str "rm -rf " scope " " outside)
             (str "mkdir -p " scope "/sub/dir2 " scope "/work " outside)
             (str "printf 'hello from the scope\\n' > " scope "/hello.txt")
             (str "printf A > " scope "/sub/b.txt && printf B > " scope "/sub/a.txt && printf Z > " scope "/sub/Z.txt")
             (str "printf dot > " scope "/sub/.hidden")
             (str "head -c 70000 /dev/zero | tr '\\0' x > " scope "/big.txt")
             (str "printf 'secret\\n' > " outside "/secret.txt")
             (str "ln -s " outside "/secret.txt " scope "/evil")
             (str "ln -s " outside " " scope "/d")
             (str "ln -s hello.txt " scope "/inner")
             (str "ln -s sub " scope "/sd")
             (str "ln -s " scope "/sub " scope "/sdabs")
             ;; C3, second half
             (str "rm -f " link " && ln -s " (last (str/split scope #"/")) " " link)
             (str "printf 'a\\n' > " scope "/work/log.txt")
             (str "printf 'hello range text' > " scope "/r.txt && chmod 644 " scope "/r.txt")
             (str "printf '\\346\\227\\245\\346\\234\\254' > " scope "/jp.txt")
             (str "ln -s r.txt " scope "/lnk")]))

;; ---------------------------------------------------------------------------
;; Running one case both ways
;; ---------------------------------------------------------------------------

(defn command-line [{:keys [args env cwd stdin redirect]} program]
  (str (when cwd (str "cd " (quote-arg cwd) " && "))
       (str/join " " (map (fn [[k v]] (str k "=" (quote-arg v))) env)) " "
       program " " (str/join " " (map quote-arg args))
       (when stdin (str " < " (quote-arg stdin)))
       (when redirect (str " " redirect))))

;; C3, second half: a seccomp profile that answers getrandom and close_range
;; with ENOSYS, what a kernel without them answers. The static image runs in
;; a container under it (x86_64 through the VM's qemu-x86_64-static, mounted).
(def enosys-profile
  "{\"defaultAction\":\"SCMP_ACT_ALLOW\",\"syscalls\":[{\"names\":[\"getrandom\",\"close_range\"],\"action\":\"SCMP_ACT_ERRNO\",\"errnoRet\":38}]}")

(defn in-container [isa program-line]
  (str "podman run --rm --security-opt seccomp=" (quote-arg (lib/join work "enosys.json"))
       " -v " (quote-arg work) ":" (quote-arg work)
       (when (not= isa host-isa) (str " -v /usr/bin/qemu-" isa "-static:/usr/bin/qemu-" isa "-static:ro"))
       " " gcc-image " " program-line))

(defn run-case
  "The case through the static image, the loader built without its seccomp
  filter, and -- on the host ISA, where the kernel can install it -- the
  production loader. Each run starts from a fresh scope."
  [c isa {:keys [static kexe ids scope-env]}]
  (let [input (when (:input c)
                (let [f (lib/join work (str "stdin-" (:name c)))]
                  (fs/writeFileSync f (:input c))
                  f))
        c (assoc c :stdin input)
        {:keys [bin offset]} kexe
        allow (str/join "," ids)
        loader (fn [build] (str (runner isa) (lib/join work (str "loader-" isa build)) " " bin " " offset
                                " 0 " isa " " allow " --"))
        loader-env (merge (:env c) {"KEXE_CAP_RESOURCES_35" scope-env "KEXE_CAP_RESOURCES_34" scope-env})
        fresh (fn [thunk]
                (let [r (linux! setup)]
                  (when-not (zero? (:status r)) (fail! (str "setup: " (:stderr r))))
                  (thunk)))]
    (if (:container? c)
      {:static (fresh #(linux! (in-container isa (command-line (dissoc c :cwd) (str (runner isa) static)))))}
      (cond-> {:static (fresh #(linux! (command-line c (str (runner isa) static))))}
        (not (:static-only? c))
        (assoc :kexe (fresh #(linux! (command-line (assoc c :env loader-env) (loader "-nosandbox")))))
        (and (= isa host-isa) (not (:static-only? c)) (not (:no-prod? c)))
        (assoc :prod (fresh #(linux! (command-line (assoc c :env loader-env) (loader "")))))))))

(def trap-exit
  {"KEXE_TRAP {:kind :budget :reason :budget/bytes" 124
   "KEXE_TRAP {:kind :budget :reason :budget/cells" 123
   "KEXE_TRAP {:kind :budget :reason :budget/fuel" 122
   "KEXE_TRAP {:kind :slot :reason :slot/unimplemented" 125})

;; The loader names a budget trap twice: the child's signal line, then the
;; supervisor's budget line. The static image, which has no supervisor, prints
;; the budget line alone (C2). Compared after taking that one leading line off.
(def signal-line "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")
(defn loader-stderr [r]
  (let [e (:stderr r)]
    (if (and (str/starts-with? e signal-line)
             (str/starts-with? (subs e (count signal-line)) "KEXE_TRAP {:kind :budget"))
      (subs e (count signal-line))
      e)))

(defn expected-static-exit [loader-result]
  (if (= 120 (:status loader-result))
    (or (some (fn [[prefix code]] (when (str/includes? (:stderr loader-result) prefix) code)) trap-exit) 120)
    (:status loader-result)))

(def results (atom []))

(defn check! [label ok? detail]
  (swap! results conj {:label label :ok ok?})
  (println (str (if ok? "PASS " "FAIL ") label (when-not ok? (str "\n     " (pr-str detail))))))

(defn mask [s] (str/replace s #"=\[[0-9]+\]" "=[N]"))

;; A case: :args, optional :env :cwd :input, :expect (a fn over one side's
;; result answering nil when it holds, else a description), and :same? (the
;; two paths must agree) -- false only for a documented divergence, which
;; then carries :static and :kexe expectations of its own.
(def cases
  [{:name "echo" :args ["echo" "alpha" "beta gamma" "δ"] :env {"C3_VAR" "value-1"}
    :expect #(when-not (= (:stdout %) (str "argc=[4]\narg0=[echo]\narg1=[alpha]\narg2=[beta gamma]\narg3=[δ]\n"
                                             "C3_VAR=[value-1]\nUNSET=[]\n0\n"))
               :stdout)}
   {:name "cat" :args ["cat" (str scope "/hello.txt")]
    :expect #(when-not (= (:stdout %) "hello from the scope\n0\n") :stdout)}
   {:name "cat-relative" :args ["cat" "hello.txt"] :cwd scope
    :expect #(when-not (= (:stdout %) "hello from the scope\n0\n") :stdout)}
   {:name "cat-dotdot-inside" :args ["cat" (str scope "/sub/../hello.txt")]
    :expect #(when-not (= (:stdout %) "hello from the scope\n0\n") :stdout)}
   ;; mkdir / rename / unlink / rmdir: the production loader's seccomp
   ;; filter admits mkdirat, unlinkat and renameat (x86_64) / renameat2
   ;; (aarch64) since 2026-09-25; before, it died with SIGSYS at the mkdir.
   {:name "write-read-back" :args ["wr" (str scope "/work")]
    :expect #(when-not (= (:stdout %)
                          (str "write=[hello static\nsecond line\n]\nread=[hello static\nsecond line\n]\n"
                               "stat=[420 25 8 0]\nexists=[1]\nmkdir=[1]\nmkdir-again=[0]\nrename=[1]\n"
                               "old-exists=[0]\nmoved=[hello static\nsecond line\n]\nunlink=[1]\n"
                               "unlink-again=[0]\nrmdir=[1]\ngone=[0]\n0\n"))
               :stdout)}
   {:name "list-dir" :args ["ls" (str scope "/sub")]
    :expect #(when-not (= (:stdout %) "ls=[.hidden\t0\nZ.txt\t0\na.txt\t0\nb.txt\t0\ndir2\t1]\n0\n") :stdout)}
   {:name "list-root" :args ["ls" scope]
    :expect #(when-not (= (:stdout %) "ls=[big.txt\t0\nd\t0\nevil\t0\nhello.txt\t0\ninner\t0\njp.txt\t0\nlnk\t0\nr.txt\t0\nsd\t0\nsdabs\t0\nsub\t1\nwork\t1]\n0\n") :stdout)}
   ;; A RELATIVE directory symlink that stays beneath the scope root is
   ;; followed by both paths (RESOLVE_BENEATH follows it; only the final
   ;; component is O_NOFOLLOW), for a read and for a mutation's parent.
   {:name "cat-through-inside-dir-symlink" :args ["cat" (str scope "/sd/a.txt")]
    :expect #(when-not (= (:stdout %) "B0\n") :stdout)}
   {:name "mkdir-through-inside-dir-symlink" :args ["mkdir" (str scope "/sd/made")]
    :expect #(when-not (= (:stdout %) "mkdir=[1]\n0\n") :stdout)}
   {:name "stat" :args ["stat" (str scope "/hello.txt")]
    :expect #(when-not (= (:stdout %) "stat=[420 21 8 0]\n0\n") :stdout)}
   {:name "clock" :args ["clock"] :masked? true
    :expect (fn [r] (let [[_ w] (re-find #"wall=\[(\d+)\]" (:stdout r))
                          [_ a] (re-find #"mono1=\[(\d+)\]" (:stdout r))
                          [_ b] (re-find #"mono2=\[(\d+)\]" (:stdout r))]
                      (cond (not (and w a b)) :shape
                            (< (js/BigInt b) (js/BigInt a)) :not-monotonic
                            (> (js/Math.abs (- (js/Number w) (js/Date.now))) 600000) :wall-far-from-now)))}
   {:name "stderr" :args ["err"]
    :expect #(when-not (and (= (:stdout %) "to stdout\n0\n") (= (:stderr %) "to stderr\n")) :streams)}
   {:name "stdin-whole" :args ["slurp"] :input "abcdefghijk"
    :expect #(when-not (= (:stdout %) "stdin=[abcdefghijk]\n0\n") :stdout)}
   {:name "stdin-chunks" :args ["chunk"] :input "abcdefghijk"
    :expect #(when-not (= (:stdout %) "abcd|efgh|ijk|3\n") :stdout)}
   {:name "stdin-chunks-utf8" :args ["chunk"] :input "日本語"
    :expect #(when-not (= (:stdout %) "日|本|語|3\n") :stdout)}
   {:name "mtime" :args ["mtime" (str scope "/hello.txt")] :masked? true
    :expect #(when-not (re-matches #"mtime=\[\d{10}\]\n0\n" (:stdout %)) :stdout)}
   {:name "stat-directory" :args ["stat" (str scope "/sub")]
    :expect #(when-not (re-matches #"stat=\[493 \d+ \d+ 1\]\n0\n" (:stdout %)) :stdout)}
   {:name "exists-directory" :args ["exists" (str scope "/sub")]
    :expect #(when-not (= (:stdout %) "exists=[1]\n0\n") :stdout)}
   {:name "stdin-empty" :args ["slurp"] :input ""
    :expect #(when-not (= (:stdout %) "stdin=[]\n0\n") :stdout)}
   ;; --- negatives: the reason literal is pinned --------------------------
   {:name "read-a-directory" :args ["cat" (str scope "/sub")]
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "write-parent-missing" :args ["write" (str scope "/no/such/file")]
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "rename-out-of-scope" :args ["rename-out" (str scope "/hello.txt") (str outside "/stolen.txt")]
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "malformed-arg-index" :args ["arg-bad"]
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "denied-capability" :args ["echo" "x"] :denied? true
    :expect #(when-not (and (= 120 (:status %)) (str/starts-with? (:stdout %) "argc=[2]\narg0=[echo]\narg1=[x]\n")
                            (re-find #"^KEXE_TRAP \{:kind :signal :signal :SIG(TRAP|ILL)\}\n$" (:stderr %)))
               :trap)}
   {:name "escape-dotdot" :args ["cat" (str scope "/../" outside-name "/secret.txt")]
    :expect #(when-not (and (= 120 (:status %)) (= "" (:stdout %))
                            (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "escape-dotdot-relative" :args ["cat" (str "../" outside-name "/secret.txt")] :cwd scope
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "escape-absolute" :args ["cat" (str outside "/secret.txt")]
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "escape-symlink-final" :args ["cat" (str scope "/evil")]
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "symlink-final-inside" :args ["cat" (str scope "/inner")]
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   ;; A DIRECTORY symlink out of the scope (d -> outside). Both paths open
   ;; beneath the scope root (openat2 RESOLVE_BENEATH), which refuses it
   ;; with EXDEV: a trap, for a read, a mkdir and a write alike. Until
   ;; 2026-09-25 the loader followed it -- its containment compared the fd
   ;; with a stat of the same path, which the same symlink satisfied -- and
   ;; the read returned the outside bytes (a documented difference here).
   {:name "escape-symlink-directory" :args ["cat" (str scope "/d/secret.txt")]
    :expect #(when-not (and (= 120 (:status %)) (= "" (:stdout %))
                            (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "escape-mkdir-through-symlink" :args ["mkdir" (str scope "/d/planted")]
    :expect #(when-not (and (= 120 (:status %)) (= "" (:stdout %))
                            (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "escape-write-through-symlink" :args ["write" (str scope "/d/planted.txt")]
    :expect #(when-not (and (= 120 (:status %)) (= "" (:stdout %))
                            (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   ;; An ABSOLUTE symlink is refused even when it points inside the scope:
   ;; RESOLVE_BENEATH does not restart resolution at "/".
   {:name "absolute-symlink-inside" :args ["cat" (str scope "/sdabs/a.txt")]
    :expect #(when-not (and (= 120 (:status %)) (= "" (:stdout %))
                            (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "missing-file" :args ["missing" (str scope "/nope.txt")]
    :expect #(when-not (and (= 120 (:status %))
                            (= (:stdout %) "exists=[0]\nstat=[]\nreading anyway\n")
                            (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :typed-then-trap)}
   {:name "bytes-budget" :args ["cat" (str scope "/big.txt")]
    :expect #(when-not (and (= "" (:stdout %))
                            (= (loader-stderr %) "KEXE_TRAP {:kind :budget :reason :budget/bytes :arena :string-pool}\n"))
               :budget)}
   {:name "stdin-past-pool" :args ["slurp"] :input (.repeat "y" 70000)
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   {:name "clock-unknown-form" :args ["clock-bad"]
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}
   ;; CHMOD: both paths answer it (the static image since C3's second half).
   ;; The production loader's seccomp filter does NOT admit fchmod -- the one
   ;; unlisted syscall kept as the negative: that loader is killed with
   ;; SIGSYS (a documented difference of the production build only).
   {:name "chmod-unlisted-syscall" :args ["chmod" (str scope "/hello.txt")]
    :expect #(when-not (= (:stdout %) "chmod=[1]\n0\n") :stdout)
    :prod #(when-not (and (= 120 (:status %)) (= "" (:stdout %))
                          (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGSYS}\n"))
             :seccomp-no-longer-kills)}
;; APPEND (C3, second half) answers on both paths now; appending to a file
   ;; that does not exist is refused on both (no O_CREAT).
   {:name "append-to-missing-file" :args ["append" (str scope "/work/none.txt")]
    :expect #(when-not (and (= 120 (:status %)) (= (:stderr %) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")) :trap)}])

;; ---------------------------------------------------------------------------
;; The second guest (C3, second half)
;; ---------------------------------------------------------------------------

(def sigill "KEXE_TRAP {:kind :signal :signal :SIGILL}\n")
(defn sigill? [r] (and (= 120 (:status r)) (= (:stderr r) sigill)))
(defn refused [cap reason]
  (str "KEXE_TRAP {:kind :capability :capability " cap " :reason " reason "}\n"))
(defn refused? [r cap reason] (and (= 126 (:status r)) (= (:stderr r) (refused cap reason))))
(defn sp [& parts] (str/join "ARG_SEP" parts))
(defn spawn-out [answer] (str "spawn=[" answer "]\n0\n"))
;; the kexe loader answers wire 20 and 23 with the qualification identity
;; stub: the request comes back as the answer
(defn identity-stub [label request] #(when-not (= (:stdout %) (str label "=[" request "]\n0\n")) :loader-no-longer-identity))
(def loader-sigill #(when-not (sigill? %) :loader-no-longer-sigill))

(def cases2
  [;; --- :entropy/draw ------------------------------------------------------
   {:name "entropy-1000-draws" :args ["draws"] :same? false
    :static (fn [r] (let [[_ body] (re-matches #"([0-9a-f]*)\n0\n" (:stdout r))
                          draws (when body (map #(subs body (* 32 %) (* 32 (inc %))) (range (quot (count body) 32))))]
                      (cond (not= 0 (:status r)) :status
                            (nil? body) :shape
                            (not= 32000 (count body)) [:length (count body)]
                            (not= 1000 (count (distinct draws))) [:distinct (count (distinct draws))])))
    :kexe #(when-not (= (:stdout %) (str (str/join "" (repeat 1000 "16")) "\n0\n")) :loader-no-longer-identity)}
   {:name "entropy-256-bytes" :args ["draw" "256"] :same? false
    :static #(when-not (re-matches #"draw=\[[0-9a-f]{512}\]\n0\n" (:stdout %)) :shape)
    :kexe (identity-stub "draw" "256")}
   {:name "entropy-257-refused" :args ["draw" "257"] :same? false
    :static #(when-not (sigill? %) :trap) :kexe (identity-stub "draw" "257")}
   {:name "entropy-0-refused" :args ["draw" "0"] :same? false
    :static #(when-not (sigill? %) :trap) :kexe (identity-stub "draw" "0")}
   {:name "entropy-enosys-named" :args ["draw" "16"] :container? true
    :static #(when-not (refused? % ":entropy/draw" ":entropy/unavailable") :named-trap)}
   ;; --- :process/spawn -------------------------------------------------------
   {:name "spawn-echo" :args ["sp" (sp "/bin/echo" "hello" "two words")] :same? false
    :static #(when-not (= (:stdout %) (spawn-out "0\nhello two words\n")) :stdout)
    :kexe (identity-stub "spawn" (sp "/bin/echo" "hello" "two words"))}
   {:name "spawn-exit-1" :args ["sp" "/usr/bin/false"] :same? false
    :static #(when-not (= (:stdout %) (spawn-out "1\n")) :stdout)
    :kexe (identity-stub "spawn" "/usr/bin/false")}
   {:name "spawn-exit-7" :args ["sp" (sp "/bin/sh" "-c" "exit 7")] :same? false
    :static #(when-not (= (:stdout %) (spawn-out "7\n")) :stdout)
    :kexe (identity-stub "spawn" (sp "/bin/sh" "-c" "exit 7"))}
   {:name "spawn-killed-by-signal" :args ["sp" (sp "/bin/sh" "-c" "kill -9 $$")] :same? false
    :static #(when-not (= (:stdout %) (spawn-out "-1\n")) :stdout)
    :kexe (identity-stub "spawn" (sp "/bin/sh" "-c" "kill -9 $$"))}
   {:name "spawn-env-granted-names-only" :args ["sp" (sp "/bin/sh" "-c" "echo \"[$C3_VAR][$C3_OTHER][$HOME]\"")]
    :env {"C3_VAR" "value-1" "C3_OTHER" "other" "HOME" "/home/nobody"} :same? false
    :static #(when-not (= (:stdout %) (spawn-out "0\n[value-1][][]\n")) :stdout)
    :kexe (identity-stub "spawn" (sp "/bin/sh" "-c" "echo \"[$C3_VAR][$C3_OTHER][$HOME]\""))}
   {:name "spawn-stdin-is-eof" :args ["sp" (sp "/bin/sh" "-c" "read x; echo \"[$x]$?\"")] :input "secret\n"
    :same? false
    :static #(when-not (= (:stdout %) (spawn-out "0\n[]1\n")) :stdout)
    :kexe (identity-stub "spawn" (sp "/bin/sh" "-c" "read x; echo \"[$x]$?\""))}
   {:name "spawn-no-inherited-descriptor" :args ["sp" (sp "/usr/bin/ls" "/proc/self/fd")] :redirect "5</etc/os-release"
    :same? false
    :static #(when-not (= (:stdout %) (spawn-out "0\n0\n1\n2\n3\n")) :stdout)
    :kexe (identity-stub "spawn" (sp "/usr/bin/ls" "/proc/self/fd"))}
   {:name "spawn-cwd-is-the-scope-root" :args ["sp" "/bin/pwd"] :cwd "/var/tmp" :same? false
    :static #(when-not (= (:stdout %) (spawn-out (str "0\n" scope "\n"))) :stdout)
    :kexe (identity-stub "spawn" "/bin/pwd")}
   {:name "spawn-no-new-privs" :args ["sp" (sp "/usr/bin/grep" "NoNewPrivs" "/proc/self/status")] :same? false
    :static #(when-not (= (:stdout %) (spawn-out "0\nNoNewPrivs:\t1\n")) :stdout)
    :kexe (identity-stub "spawn" (sp "/usr/bin/grep" "NoNewPrivs" "/proc/self/status"))}
   {:name "spawn-32-arguments" :args ["sp" (apply sp "/bin/echo" (repeat 32 "x"))] :same? false
    :static #(when-not (= (:stdout %) (spawn-out (str "0\n" (str/join " " (repeat 32 "x")) "\n"))) :stdout)
    :kexe (identity-stub "spawn" (apply sp "/bin/echo" (repeat 32 "x")))}
   {:name "spawn-output-at-budget" :args ["sp" (sp "/bin/sh" "-c" "printf '%16384s' ''")] :same? false
    :static #(when-not (= (:stdout %) (spawn-out (str "0\n" (.repeat " " 16384)))) :stdout)
    :kexe (identity-stub "spawn" (sp "/bin/sh" "-c" "printf '%16384s' ''"))}
   {:name "spawn-within-deadline" :args ["sp" (sp "/usr/bin/sleep" "2")] :same? false
    :static #(when-not (= (:stdout %) (spawn-out "0\n")) :stdout)
    :kexe (identity-stub "spawn" (sp "/usr/bin/sleep" "2"))}
   {:name "spawn-path-lookup-granted" :args ["sp" (sp "echo" "found")] :variant :lookup :same? false
    :static #(when-not (= (:stdout %) (spawn-out "0\nfound\n")) :stdout)
    :kexe (identity-stub "spawn" (sp "echo" "found"))}
   ;; negatives, the reason literal pinned
   {:name "spawn-program-not-granted" :args ["sp" "/usr/bin/id"] :same? false
    :static #(when-not (and (= "" (:stdout %)) (refused? % ":process/spawn" ":spawn/program-not-granted")) :named-trap)
    :kexe (identity-stub "spawn" "/usr/bin/id")}
   {:name "spawn-other-spelling-not-granted" :args ["sp" "/bin/../bin/echo"] :same? false
    :static #(when-not (refused? % ":process/spawn" ":spawn/program-not-granted") :named-trap)
    :kexe (identity-stub "spawn" "/bin/../bin/echo")}
   {:name "spawn-path-lookup-denied" :args ["sp" (sp "echo" "found")] :same? false
    :static #(when-not (refused? % ":process/spawn" ":spawn/path-lookup-denied") :named-trap)
    :kexe (identity-stub "spawn" (sp "echo" "found"))}
   {:name "spawn-lookup-finds-only-granted" :args ["sp" "id"] :variant :lookup :same? false
    :static #(when-not (refused? % ":process/spawn" ":spawn/program-not-granted") :named-trap)
    :kexe (identity-stub "spawn" "id")}
   {:name "spawn-33-arguments-over-budget" :args ["sp" (apply sp "/bin/echo" (repeat 33 "x"))] :same? false
    :static #(when-not (refused? % ":process/spawn" ":spawn/argv-budget") :named-trap)
    :kexe (identity-stub "spawn" (apply sp "/bin/echo" (repeat 33 "x")))}
   {:name "spawn-argv-bytes-over-budget" :args ["sp" (sp "/bin/echo" (.repeat "a" 4100))] :same? false
    :static #(when-not (refused? % ":process/spawn" ":spawn/argv-budget") :named-trap)
    :kexe (identity-stub "spawn" (sp "/bin/echo" (.repeat "a" 4100)))}
   {:name "spawn-output-over-budget" :args ["sp" (sp "/bin/sh" "-c" "printf '%16385s' ''")] :same? false
    :static #(when-not (and (= "" (:stdout %)) (refused? % ":process/spawn" ":spawn/output-budget")) :named-trap)
    :kexe (identity-stub "spawn" (sp "/bin/sh" "-c" "printf '%16385s' ''"))}
   {:name "spawn-deadline-kills" :args ["sp" (sp "/usr/bin/sleep" "30")] :same? false
    :static #(when-not (refused? % ":process/spawn" ":spawn/timeout") :named-trap)
    :kexe (identity-stub "spawn" (sp "/usr/bin/sleep" "30"))}
   {:name "spawn-granted-but-absent" :args ["sp" "/var/tmp/c3none/prog"] :same? false
    :static #(when-not (refused? % ":process/spawn" ":spawn/exec-failed") :named-trap)
    :kexe (identity-stub "spawn" "/var/tmp/c3none/prog")}
   {:name "spawn-empty-program" :args ["sp" (sp "" "x")] :same? false
    :static #(when-not (sigill? %) :trap) :kexe (identity-stub "spawn" (sp "" "x"))}
   {:name "spawn-isolation-unavailable-named" :args ["sp" "/bin/echo"] :container? true
    :static #(when-not (refused? % ":process/spawn" ":spawn/isolation-unavailable") :named-trap)}
   ;; --- :fs/app-data: the forms the loader answers too --------------------
   {:name "append-then-read" :args ["fs" (str scope "/work/log.txtAPPEND_SEPb-line") (str scope "/work/log.txt")]
    :expect #(when-not (= (:stdout %) "fs=[b-line]\nfs=[a\nb-line]\n2\n") :stdout)}
   {:name "append-needs-the-file" :args ["fs" (str scope "/work/none.txtAPPEND_SEPx")]
    :expect #(when-not (sigill? %) :trap)}
   {:name "range-window-and-boundary" :args ["fs" (str scope "/r.txtRANGE_SEP6:5") (str scope "/r.txtRANGE_SEP6:10")]
    :expect #(when-not (= (:stdout %) "fs=[range]\nfs=[range text]\n2\n") :stdout)}
   {:name "range-past-the-end" :args ["fs" (str scope "/r.txtRANGE_SEP6:11")]
    :expect #(when-not (sigill? %) :trap)}
   {:name "range-cuts-a-code-point" :args ["fs" (str scope "/jp.txtRANGE_SEP0:1")]
    :expect #(when-not (sigill? %) :trap)}
   {:name "range-malformed-is-the-bytes-trap" :args ["fs" (str scope "/r.txtRANGE_SEP6-5")]
    :expect #(when-not (= (loader-stderr %) "KEXE_TRAP {:kind :budget :reason :budget/bytes :arena :string-pool}\n") :budget)}
   {:name "range-over-the-pool" :args ["fs" (str scope "/big.txtRANGE_SEP0:70000")]
    :expect #(when-not (= (loader-stderr %) "KEXE_TRAP {:kind :budget :reason :budget/bytes :arena :string-pool}\n") :budget)}
   {:name "chmod-then-stat" :args ["fs" (str scope "/r.txtCHMOD_SEP600") (str scope "/r.txtSTAT_SEP")
                                   (str scope "/r.txtCHMOD_SEP4755") (str scope "/r.txtSTAT_SEP")
                                   (str scope "/nope.txtCHMOD_SEP644")]
    :expect #(when-not (= (:stdout %) "fs=[1]\nfs=[384 16 8 0]\nfs=[1]\nfs=[493 16 8 0]\nfs=[0]\n5\n") :stdout)}
   {:name "chmod-drops-setuid" :args ["chmod-ls" (str scope "/r.txtCHMOD_SEP4755") (sp "/usr/bin/ls" "-l" "r.txt")]
    :same? false
    :static #(when-not (re-matches #"chmod=\[1\]\nls=\[0\n-rwxr-xr-x[^\]]* r\.txt\n\]\n0\n" (:stdout %)) :stdout)
    :kexe #(when-not (= (:stdout %) (str "chmod=[1]\nls=[" (sp "/usr/bin/ls" "-l" "r.txt") "]\n0\n")) :loader)}
   {:name "chmod-not-octal" :args ["fs" (str scope "/r.txtCHMOD_SEP8")]
    :expect #(when-not (sigill? %) :trap)}
   {:name "chmod-seven-digits" :args ["fs" (str scope "/r.txtCHMOD_SEP1234567")]
    :expect #(when-not (sigill? %) :trap)}
   ;; --- :fs/app-data: the proposed forms (the loader reads them as a path) --
   {:name "fsync" :args ["fs" (str scope "/r.txtFSYNC_SEP") (str scope "/nope.txtFSYNC_SEP")] :same? false
    :static #(when-not (= (:stdout %) "fs=[1]\nfs=[0]\n2\n") :stdout) :kexe loader-sigill}
   {:name "make-temp-dir" :args ["mkt" (str scope "/workMKTEMP_SEPt.") "NOFOLLOW_SEP"] :same? false
    :static #(when-not (re-matches (re-pattern (str "dir=\\[" scope "/work/t\\.[0-9a-z]{6}\\]\nstat=\\[448 \\d+ \\d+ 1\\]\n0\n")) (:stdout %)) :stdout)
    :kexe loader-sigill}
   {:name "make-temp-dir-missing-parent" :args ["mkt" (str scope "/work/noneMKTEMP_SEPt.") "NOFOLLOW_SEP"] :same? false
    :static #(when-not (and (sigill? %) (= (:stdout %) "dir=[]\n")) :stdout) :kexe loader-sigill}
   {:name "make-temp-dir-outside-the-scope" :args ["mkt" (str outside "MKTEMP_SEPt.") "NOFOLLOW_SEP"]
    :expect #(when-not (and (sigill? %) (= "" (:stdout %))) :trap)}
   ;; refused before any directory is made: nothing was shown
   {:name "make-temp-dir-prefix-is-one-name" :args ["mkt" (str scope "/workMKTEMP_SEPa/b") "NOFOLLOW_SEP"] :same? false
    :static #(when-not (and (sigill? %) (= "" (:stdout %))) :trap) :kexe loader-sigill}
   {:name "stat-nofollow" :args ["fs" (str scope "/lnkNOFOLLOW_SEP") (str scope "/r.txtNOFOLLOW_SEP")
                                 (str scope "/evilNOFOLLOW_SEP") (str scope "/nopeNOFOLLOW_SEP") (str scope "/lnkSTAT_SEP")]
    :same? false
    ;; evil -> <outside>/secret.txt: the link's size is that spelling's length
    :static #(when-not (= (:stdout %) (str "fs=[511 5 0 2]\nfs=[420 16 8 0]\nfs=[511 " (count (str outside "/secret.txt"))
                                           " 0 2]\nfs=[]\nfs=[]\n5\n")) :stdout)
    :kexe loader-sigill}
   ;; --- the scope root in both spellings ------------------------------------
   {:name "scope-spelled-through-a-symlink" :variant :link
    :args ["fs" (str link "/hello.txt") (str scope "/hello.txt")]
    :expect #(when-not (= (:stdout %) "fs=[hello from the scope\n]\nfs=[hello from the scope\n]\n2\n") :stdout)}
   {:name "scope-spelled-through-a-symlink-still-contains" :variant :link
    :args ["fs" (str outside "/secret.txt")]
    :expect #(when-not (sigill? %) :trap)}
   {:name "scope-as-sealed-does-not-take-another-spelling" :args ["fs" (str link "/hello.txt")]
    :expect #(when-not (sigill? %) :trap)}])


(def isas (if-let [only (opt "--only-isa" nil)] [only] ["aarch64" "x86_64"]))
(def only-re (some-> (opt "--only" nil) re-pattern))
(defn selected? [c] (or (nil? only-re) (re-find only-re (:name c))))
(def static-only? (boolean (flag? "--static-only")))

;; A kexe-loader program whose literals carry a proposed form's token is not
;; compiled: amu names the form (kotoba.compiler.kexe-fs-forms).
(def literal-guest
  "(ns probe.core (:export [main]))
(defn fsq [s :string] :string (typed-cap-call :fs/app-data :string :string s))
(defn main [] :i64 (do (fsq (string-concat \"/var/tmp/c3scope/r.txt\" \"FSYNC_SEP\")) 0))
")

(defn -main []
  (fs/writeFileSync (lib/join work "probe.kotoba") guest)
  (fs/writeFileSync (lib/join work "probe2.kotoba") guest2)
  (fs/writeFileSync (lib/join work "literal.kotoba") literal-guest)
  (fs/writeFileSync (lib/join work "enosys.json") enosys-profile)
  (fs/writeFileSync (lib/join work "policy.edn") (policy-text nil))
  (fs/writeFileSync (lib/join work "policy-denied.edn") (policy-text denied-ids))
  (fs/writeFileSync (lib/join work "policy2.edn") (policy2-text scope false))
  (fs/writeFileSync (lib/join work "policy2-lookup.edn") (policy2-text scope true))
  (fs/writeFileSync (lib/join work "policy2-link.edn") (policy2-text link false))
  (fs/writeFileSync (lib/join work "policy-literal.edn") "{:allow #{[:cap/call 35]}}")
  (when-not static-only? (build-loaders!))
  (let [g1? (some selected? cases)
        g2? (some selected? cases2)
        p2 (lib/join work "probe2.kotoba")
        builds (into {}
                     (for [isa isas]
                       [isa (cond-> {}
                              g1? (assoc :static (compile! (str isa "-linux-static") (lib/join work (str "probe-" isa))
                                                           (lib/join work "policy.edn"))
                                         :static-denied (compile! (str isa "-linux-static") (lib/join work (str "probe-denied-" isa))
                                                                  (lib/join work "policy-denied.edn"))
                                         :kexe (when-not static-only?
                                                 (extract! (compile! (str isa "-linux") (lib/join work (str "probe-" isa ".kexe"))
                                                                     (lib/join work "policy.edn")))))
                              g2? (assoc :g2-static (compile! p2 (str isa "-linux-static") (lib/join work (str "probe2-" isa))
                                                              (lib/join work "policy2.edn"))
                                         :g2-lookup (compile! p2 (str isa "-linux-static") (lib/join work (str "probe2-lookup-" isa))
                                                              (lib/join work "policy2-lookup.edn"))
                                         :g2-link (compile! p2 (str isa "-linux-static") (lib/join work (str "probe2-link-" isa))
                                                            (lib/join work "policy2-link.edn"))
                                         :g2-kexe (when-not static-only?
                                                    (extract! (compile! p2 (str isa "-linux") (lib/join work (str "probe2-" isa ".kexe"))
                                                                        (lib/join work "policy2.edn"))))))]))
        overcommit (when (flag? "--overcommit")
                     (let [old (str/trim (:stdout (linux! "sysctl -n vm.overcommit_memory")))]
                       (linux! "sudo sysctl -q -w vm.overcommit_memory=1")
                       old))
        restore! (fn []
                   (when overcommit (linux! (str "sudo sysctl -q -w vm.overcommit_memory=" overcommit)))
                   (linux! (str "rm -rf " scope " " outside " " link)))]
    (reset! on-exit restore!)
    (try
      (when g1?
        (let [static-facts (linux! (str "for f in " (str/join " " (map #(quote-arg (lib/join work (str "probe-" %))) isas))
                                        "; do ldd \"$f\" 2>&1 | head -1; done"))]
          (check! "ldd: the static images are not dynamic executables"
                  (= (count isas) (count (re-seq #"not a dynamic executable" (:stdout static-facts)))) static-facts)))
      (when g2?
        ;; controls: the isolation cases pass because the image isolated the
        ;; child, not because the harness's shell already was
        (let [nnp (linux! "grep NoNewPrivs /proc/self/status")
              fds (linux! "ls /proc/self/fd 5</etc/os-release")
              lit (compile-result (lib/join work "literal.kotoba") "aarch64-linux" (lib/join work "literal.kexe")
                                  (lib/join work "policy-literal.edn"))]
          (check! "control: the harness's own shell is not no_new_privs" (= "NoNewPrivs:\t0\n" (:stdout nnp)) nnp)
          (check! "control: an ordinary child does inherit descriptor 5" (some #{"5"} (str/split-lines (:stdout fds))) fds)
          (check! "kexe compile refuses a literal proposed form by name"
                  (and (not (zero? (:status lit)))
                       (str/includes? (:stderr lit) ":code :kotoba/target-rejected")
                       (str/includes? (:stderr lit) "the kexe loader does not answer the :fs/app-data form :fsync")
                       (not (fs/existsSync (lib/join work "literal.kexe"))))
                  lit)))
      (doseq [isa isas
              c (filter selected? (concat (map #(assoc % :guest :g1) cases) (map #(assoc % :guest :g2) cases2)))]
        (let [b (get builds isa)
              spec (if (= :g1 (:guest c))
                     {:static (if (:denied? c) (:static-denied b) (:static b)) :kexe (:kexe b)
                      :ids (if (:denied? c) denied-ids all-ids) :scope-env scope}
                     {:static (case (:variant c) :lookup (:g2-lookup b) :link (:g2-link b) (:g2-static b))
                      :kexe (:g2-kexe b) :ids g2-ids :scope-env (if (= :link (:variant c)) link scope)})
              ;; the production (seccomp) loader is compared on the first
              ;; guest only; the second guest is compared with the loader
              ;; built without its filter
              {:keys [static kexe prod]} (run-case (cond-> c
                                                     (= :g2 (:guest c)) (assoc :no-prod? true)
                                                     static-only? (assoc :static-only? true))
                                                   isa spec)
              prod (when-not (= :g2 (:guest c)) prod)
              label (str isa (when (not= isa host-isa) " (emulated, qemu-user)") " " (:name c))
              shown (fn [x] (if (:masked? c) (update x :stdout mask) x))
              same? (fn [loader]
                      (and (= (:stdout (shown static)) (:stdout (shown loader)))
                           (= (:stderr static) (loader-stderr loader))
                           (= (:status static) (expected-static-exit loader))))]
          (cond
            (:container? c)
            (check! (str label ": static, seccomp ENOSYS container") (nil? ((:static c) static)) static)
            static-only?
            (check! (str label ": static") (nil? ((or (:static c) (:expect c)) static)) static)
            (false? (:same? c))
            (do (check! (str label ": static") (nil? ((:static c) static)) static)
                (check! (str label ": kexe+loader, no seccomp (documented difference)") (nil? ((:kexe c) kexe)) kexe))
            :else
            (do
              (check! (str label ": static answer") (nil? ((:expect c) static)) static)
              (check! (str label ": kexe+loader (no seccomp) answer") (nil? ((:expect c) kexe)) kexe)
              (check! (str label ": static = kexe+loader (no seccomp)") (same? kexe) {:static static :kexe kexe})))
          (when prod
            (if-let [p (:prod c)]
              (check! (str label ": production kexe+loader (documented difference)") (nil? (p prod)) prod)
              (if (false? (:same? c))
                (check! (str label ": production kexe+loader (documented difference)") (nil? ((:kexe c) prod)) prod)
                (check! (str label ": static = production kexe+loader") (same? prod) {:static static :prod prod}))))))
      (finally
        (reset! on-exit nil)
        (restore!)))
    (let [failed (remove :ok @results)]
      (println (str "CASES\t" (count @results) "\tFAILED\t" (count failed)))
      (lib/remove-tree! work)
      (.exit js/process (if (seq failed) 1 0)))))

(-main)
