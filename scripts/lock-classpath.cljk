#!/usr/bin/env kbb

;; Regenerate `deps-lock.edn`, the dependency closure `bin/kotoba`'s nbb fast
;; path resolves without a JVM.
;;
;; Every git dependency in `deps.edn` names ONE commit of the kotoba-lang/kotoba
;; monorepo with `:deps/root "lib/<id>"` (the per-library repositories were
;; folded into it; see the note at the top of `deps.edn`). That removes the
;; reason this script used to shell out to `kbb -Spath`: there are no
;; conflicting transitive git pins left to choose between. A library's
;; siblings are `:local/root "../<id>"` -- the same commit by construction --
;; so the closure is read straight from the lib/<id>/deps.edn files at the
;; pinned commit, with git alone and no JDK.
;;
;; A transitive `:deps/root` dependency on the monorepo at some other commit
;; is resolved at the pinned commit too: the monorepo is one tree, and mixing
;; two commits of it on one classpath is the disagreement this lock exists to
;; rule out.
;;
;; Run it whenever `deps.edn` changes -- the resolver fails closed until you
;; do, which is how the two records stay in agreement. `kotoba.lang.text`
;; comes from the closure itself, so point --classpath at a checkout of
;; lib/kotoba.text/src when the lock is stale:
;;
;;   kbb --backend sci [--classpath <kotoba>/lib/kotoba.text/src] scripts/lock-classpath.cljk [root]

(ns lock-classpath
  (:require ["node:child_process" :as child]
            ["node:crypto" :as crypto]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as node-path]
            [clojure.edn :as edn]
            [kotoba.lang.text :as str]))

(def lock-version 2)
(def monorepo-url "https://github.com/kotoba-lang/kotoba.git")
(def monorepo-coordinate "io.github.kotoba-lang/kotoba")

(defn- fail! [message]
  (.error js/console message)
  (.exit js/process 1))

(defn- gitlibs-root []
  (or (.-GITLIBS js/process.env)
      (.join node-path (.homedir os) ".gitlibs")))

(defn- sha256-hex [^js buffer]
  (-> (.createHash crypto "sha256") (.update buffer) (.digest "hex")))

(defn- git-out [args]
  (let [result (.spawnSync child "git" (clj->js args)
                           #js {:encoding "utf8" :maxBuffer 67108864})]
    (when (and (not (.-error result)) (zero? (or (.-status result) 1)))
      (str/trim (.-stdout result)))))

(defn- read-edn [text]
  (edn/read-string {:default (fn [_ value] value)} text))

(defn- kotoba-lib? [lib]
  (str/starts-with? (str lib) "io.github.kotoba-lang/"))

(defn- monorepo-checkout!
  "The shared checkout `kotoba.compiler.nbb.classpath` uses for the monorepo
  at SHA, fetched (full history) when absent."
  [sha]
  (let [dir (.join node-path (gitlibs-root) "libs" "io.github.kotoba-lang" "kotoba" sha)]
    (when-not (.existsSync fs dir)
      (.mkdirSync fs dir #js {:recursive true})
      ;; Sparse, like the resolver's: the closure is read with `git show`,
      ;; and a full monorepo worktree does not fit Windows MAX_PATH.
      (when-not (and (git-out ["clone" "--quiet" "--no-checkout" monorepo-url dir])
                     (git-out ["-C" dir "sparse-checkout" "set" "--cone"])
                     (git-out ["-C" dir "checkout" "--quiet" sha]))
        (.rmSync fs dir #js {:recursive true :force true})
        (fail! (str "cannot fetch " monorepo-url " at " sha))))
    (when-not (= sha (git-out ["-C" dir "rev-parse" "HEAD"]))
      (fail! (str dir " is not at " sha)))
    dir))

(defn- pinned-sha
  "The one monorepo commit every git dependency in DEPS-MAPS names."
  [deps-maps]
  (let [coords (for [deps deps-maps [lib coord] deps
                     :when (and (kotoba-lib? lib) (map? coord) (:git/sha coord))]
                 [lib coord])
        strays (remove (fn [[_ c]] (and (= monorepo-url (:git/url c)) (:deps/root c))) coords)
        shas (set (map (comp :git/sha second) coords))]
    (when (seq strays)
      (fail! (str "these dependencies do not name " monorepo-url " with :deps/root: "
                  (str/join ", " (map first strays)))))
    (when-not (= 1 (count shas))
      (fail! (str "deps.edn must pin the monorepo at one commit, found: "
                  (str/join ", " (sort shas)))))
    (first shas)))

(defn- normalize-subdir [subdir]
  (.normalize (.-posix node-path) subdir))

(defn- closure
  "Walk the library graph from DEPS (a deps map) at the checkout DIR. Returns
  {subdir lib}, the first library name reaching each directory winning, so
  libraries folded into one directory become one entry."
  [dir deps seen excluded]
  (reduce
   (fn [acc [lib coord]]
     (if (or (not (kotoba-lib? lib)) (contains? excluded lib)
             (not (map? coord)) (:mvn/version coord))
       acc
       (let [subdir (cond (:deps/root coord) (normalize-subdir (:deps/root coord))
                          (:local/root coord) (normalize-subdir (.join (.-posix node-path) (:from coord) (:local/root coord)))
                          :else (fail! (str lib " is neither a monorepo :deps/root nor a :local/root sibling")))]
         (if (contains? acc subdir)
           acc
           (let [text (git-out ["-C" dir "show" (str "HEAD:" subdir "/deps.edn")])
                 lib-deps (if text (read-edn text) {})
                 acc (assoc acc subdir {:coordinate (str lib)
                                        :paths (vec (or (:paths lib-deps) ["src"]))})]
             (closure dir
                      (for [[l c] (:deps lib-deps)] [l (if (map? c) (assoc c :from subdir) c)])
                      acc
                      (into excluded (:exclusions coord))))))))
   seen
   deps))

(defn- entries [dir sha subdir->lib]
  (vec (for [[subdir {:keys [coordinate paths]}] (sort-by first subdir->lib)]
         (let [tree (git-out ["-C" dir "rev-parse" (str "HEAD:" subdir)])]
           (when-not tree (fail! (str subdir " does not exist at " sha)))
           {:coordinate coordinate
            :git-repo monorepo-coordinate
            :git-url monorepo-url
            :git-sha sha
            :git-subdir subdir
            :git-tree tree
            :paths paths}))))

(def ^:private locked-aliases ["test" "native-run"])

(defn- print-entry [indent entry]
  (println (str indent "{:coordinate " (pr-str (:coordinate entry))))
  (doseq [k [:git-repo :git-url :git-sha :git-subdir :git-tree]]
    (println (str indent " " k " " (pr-str (get entry k)))))
  (println (str indent " :paths " (pr-str (:paths entry)) " }")))

(defn -main [& args]
  (let [root (.resolve node-path (or (first args) "."))
        deps-file (.join node-path root "deps.edn")
        _ (when-not (.existsSync fs deps-file) (fail! (str "no deps.edn at " root)))
        deps (read-edn (.readFileSync fs deps-file "utf8"))
        alias-deps (into {} (for [a locked-aliases]
                              [a (get-in deps [:aliases (keyword a) :extra-deps])]))
        sha (pinned-sha (cons (:deps deps) (vals alias-deps)))
        dir (monorepo-checkout! sha)
        root-closure (closure dir (:deps deps) {} #{})
        _ (when (empty? root-closure) (fail! "deps.edn names no git dependencies; nothing to lock"))
        alias-entries (into (sorted-map)
                            (for [a locked-aliases]
                              [(keyword a)
                               (entries dir sha (apply dissoc (closure dir (get alias-deps a) root-closure #{})
                                                       (keys root-closure)))]))
        lock-entries (entries dir sha root-closure)
        out (.join node-path root "deps-lock.edn")]
    (.writeFileSync fs out
                    (str ";; Generated by scripts/lock-classpath.cljk -- do not hand-edit.\n"
                         ";; The dependency closure `bin/kotoba`'s nbb fast path resolves with\n"
                         ";; git alone: lib/<id> trees of one kotoba-lang/kotoba commit. Bound to\n"
                         ";; deps.edn's digest: change a pin and the resolver fails closed until\n"
                         ";; this is regenerated.\n"
                         (with-out-str
                           (println "{:lock/version" lock-version)
                           (println " :lock/deps-digest" (pr-str (sha256-hex (.readFileSync fs deps-file))))
                           (println " :lock/resolver" (pr-str "monorepo lib/<id>/deps.edn at the pinned commit (git only)"))
                           (println " :lock/entries")
                           (println " [")
                           (doseq [entry lock-entries] (print-entry "  " entry))
                           (println " ]")
                           (println " :lock/alias-entries")
                           (println " {")
                           (doseq [[alias es] alias-entries]
                             (println (str "  " (pr-str alias)))
                             (println "  [")
                             (doseq [entry es] (print-entry "   " entry))
                             (println "  ]"))
                           (println " }}"))))
    (println (str "wrote " out " (" (count lock-entries) " libraries of "
                  monorepo-coordinate "@" (subs sha 0 12)
                  (str/join "" (for [[alias es] alias-entries]
                                 (str ", " (name alias) " +" (count es))))
                  ")"))))

(apply -main *command-line-args*)
