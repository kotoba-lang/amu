(ns scripts.test-nbb-http-provider
  "Launcher for `test/nbb/http-provider.cljk` (W5 family-2 first slice /
  ADR 0086), mirroring `scripts/test-nbb-log-provider.cljk`."
  (:require [scripts.lib :as lib]
            ["node:child_process" :as child]
            ["node:path" :as path]))

(let [resolved (lib/lock-classpath "test")
      nbb-cli (lib/join lib/root "node_modules" "nbb" "cli.js")
      classpath (str lib/root (.-delimiter path) resolved)
      result (.spawnSync child js/process.execPath
                         (clj->js [nbb-cli "--classpath" classpath
                                  (lib/join lib/root "test" "kbb" "--backend" "sci" "http-provider.cljk")])
                         #js {:cwd lib/root :stdio "inherit" :env js/process.env})]
  (when (.-error result) (throw (.-error result)))
  (.exit js/process (or (.-status result) 70)))
