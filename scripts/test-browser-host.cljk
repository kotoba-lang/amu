#!/usr/bin/env kbb
(ns test-browser-host
  (:require ["node:child_process" :as child]
            ["node:path" :as path]))

(defn- run! [root argv label]
  (let [result (.spawnSync child js/process.execPath (clj->js argv)
                           #js {:cwd root :encoding "utf8" :maxBuffer 16777216})]
    (when (seq (or (.-stdout result) ""))
      (.write js/process.stdout (.-stdout result)))
    (when (seq (or (.-stderr result) ""))
      (.write js/process.stderr (.-stderr result)))
    (when (.-error result) (throw (.-error result)))
    (when-not (zero? (or (.-status result) 70))
      (throw (js/Error. (str label " failed (exit " (.-status result) ")"))))))

;; NBB owns repository orchestration. The first child is intentionally a plain
;; ES module test because it exercises the exact dependency-free browser
;; artifact. The second compiles .kotoba through `bin/amu --jvm-free` (so it
;; needs the deps-lock.edn closure) and runs the result on the same host: the
;; typed operations kotoba-wasm lowers to their own `kotoba:typed` imports
;; must be admitted and answered here, or every module using them is refused
;; at instantiation as `forbidden-import`.
(let [root (.resolve path (.dirname path *file*) "..")]
  (run! root [(.join path root "scripts" "test-browser-host.mjs")]
        "browser host ES module test")
  (run! root [(.join path root "bin" "kbb") "--backend" "sci"
              (.join path root "scripts" "test-browser-host-typed-ops.cljk")]
        "browser host typed-ops test"))
