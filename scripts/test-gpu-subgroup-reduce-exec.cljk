#!/usr/bin/env kbb
;; EXECUTION PROBE for the :subgroup-reduce GLSL emission (JUN-59/60 variant,
;; parent JUN-55). The emission lives in kotoba.compiler.accelerator-subgroup-
;; reduce/emit-glsl (PR #1341, commit 53248c11) and its own tests pin the
;; TEXT it produces. Nothing in the repository has ever EXECUTED it. This
;; probe executes it -- or records, by name and verbatim, exactly why it did
;; not execute -- on the one host this bot can measure (Apple M1 Max via
;; MoltenVK, JUN-58), through the repo's only GPU execution path
;; (:gpu/compute, wire 42, tools/kexe_gpu_vulkan.c).
;;
;; PROVENANCE OF THE SHADER BYTES. The sources below are the EXACT bytes
;; emit-glsl produced at 53248c11 for the six (W, operator) shapes in the
;; matrix, generated by invoking that emitter (see the evidence README for
;; the invocation and the emitter file's own sha256). The emitter ns is not
;; on origin/main (it rides in open PR #1341), so the bytes ride here as
;; data, and a run-time self-check recomputes every sha256 against the
;; recorded one and refuses before the first dispatch if a literal was
;; transcribed wrong. Nothing here re-writes the emission: the two rung
;; patches below are the MINIMAL mechanical edits this host's glslang
;; demands, applied in memory, each recorded by name.
;;
;; THE LADDER. Three rungs over the same bytes, cumulative:
;;   :as-emitted      -- bytes unchanged from emit-glsl
;;   :categories      -- the umbrella "#extension GL_KHR_shader_subgroup :
;;                       require" replaced by the per-category extensions
;;                       this toolchain demands for the builtins the body
;;                       uses (basic + shuffle_relative; measured)
;;   :categories+id   -- :categories plus gl_SubgroupLocalInvocationId
;;                       renamed to the builtin spelling this toolchain
;;                       declares (gl_SubgroupInvocationID; measured --
;;                       glslang 11:16.6.0 rejects the lowercase-d spelling)
;; A rung the toolchain refuses is NOT-ADMITTED with the verbatim reason --
;; a measured negative, never a skipped rung. A rung that compiles runs the
;; full case matrix on the device.
;;
;; THE CASE MATRIX (per compiling rung). Reduce over x[i] = i+1 (f32, exactly
;; representable; every partial sum <= 2080*... < 2^24 so ANY summation order
;; is exact -- the check is bit-exact, not approximate):
;;   W=64:  :sum/:max/:min x n in {64, 50}   (n=50 exercises the i>=n
;;          identity padding in a partial second subgroup)
;;   W=256: :sum/:max/:min x n = 256         (W=256 is the :apple row's
;;          dispatch workgroup size) plus :sum x n=200 (padding at dispatch
;;          size). Expected: :sum = n(n+1)/2, :max = n, :min = 1, compared
;;          as f32 bit patterns against parts[0], the word the emission
;;          writes (parts[gl_WorkGroupID.x], one workgroup dispatched).
;;
;; One guest per case, compiled by bin/amu for the host ISA and run under the
;; loader with the gpu-compute cap grant -- the proven flow of
;; scripts/test-gpu-subgroup-probe.cljk. Verification is internal and
;; mechanical; there is no second source for the answer. The verifier's
;; synthetic self-tests (right bits pass, wrong bits refused by name, short
;; field refused) run before the first dispatch.
;;
;; Three outcomes, three exit codes:
;;   0  at least one rung executed on the device and every executed case
;;      verified bit-exactly; refusals recorded by name
;;   1  an executed case failed verification or trapped
;;   3  could not measure here: no Vulkan headers/loader, no
;;      glslangValidator, macOS without MoltenVK, the amu compile refused, or
;;      the toolchain admitted NO rung at all (nothing executed)
;;
;;   kbb --backend sci scripts/test-gpu-subgroup-reduce-exec.cljk
(ns test-gpu-subgroup-reduce-exec
  (:require [kotoba.lang.text :as str]
            ["node:child_process" :as child]
            ["node:crypto" :as crypto]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def root (.resolve path (.dirname path *file*) ".."))
(def tmp (.mkdtempSync fs (.join path (.tmpdir os) "amu-gpu-sgre-")))

(defn- sh [cmd args & [env]]
  (let [child-env (js/Object.assign #js {} (.-env js/process) (clj->js (or env {})))
        r (child/spawnSync cmd (clj->js args) #js {:encoding "utf8" :env child-env})]
    {:status (.-status r) :out (str (.-stdout r)) :err (str (.-stderr r))}))
(defn- refuse! [reason] (println (str "GPU-SGRE-EXEC\tCOULD-NOT-RUN\t" reason)) (js/process.exit 3))
(defn- fail! [reason] (println (str "GPU-SGRE-EXEC\tFAIL\t" reason)) (js/process.exit 1))

(defn- sha256-hex [s]
  (-> (crypto/createHash "sha256") (.update s "utf8") (.digest "hex")))

(defn- f32bits
  "The little-endian u32 bit pattern of a JS number as f32."
  [v]
  (let [b (js/Buffer.alloc 4)]
    (.writeFloatLE b v 0)
    (.readUInt32LE b 0)))

;; ---- the emitted bytes, as data (see PROVENANCE above) --------------------
(def emitted-sources
  {64 {:sum "#version 450\n#extension GL_KHR_shader_subgroup : require\nlayout(local_size_x = 64) in;\nlayout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\nlayout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };\nlayout(set = 0, binding = 2, std430) readonly buffer N { uint n; };\nshared float partials[64];\nfloat combine(float a, float b) { return a+b; }\nvoid main() {\n  uint i = gl_GlobalInvocationID.x;\n  float v = i < n ? x[i] : 0.0;\n  uint fold = min(gl_SubgroupSize, gl_WorkGroupSize.x);\n  for (uint d = fold / 2u; d > 0u; d >>= 1u) {\n    float s = subgroupShuffleDown(v, d);\n    if (gl_SubgroupLocalInvocationId + d < fold) { v = combine(v, s); }\n  }\n  if (gl_SubgroupLocalInvocationId == 0u) { partials[gl_SubgroupID] = v; }\n  barrier();\n  for (uint d = gl_NumSubgroups / 2u; d > 0u; d >>= 1u) {\n    if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId < d) {\n      uint lid = gl_SubgroupLocalInvocationId;\n      partials[lid] = combine(partials[lid], partials[lid + d]);\n    }\n    barrier();\n  }\n  if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId == 0u) { parts[gl_WorkGroupID.x] = partials[0]; }\n}\n" :max "#version 450\n#extension GL_KHR_shader_subgroup : require\nlayout(local_size_x = 64) in;\nlayout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\nlayout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };\nlayout(set = 0, binding = 2, std430) readonly buffer N { uint n; };\nshared float partials[64];\nfloat combine(float a, float b) { return max(a,b); }\nvoid main() {\n  uint i = gl_GlobalInvocationID.x;\n  float v = i < n ? x[i] : -3.402823466e+38;\n  uint fold = min(gl_SubgroupSize, gl_WorkGroupSize.x);\n  for (uint d = fold / 2u; d > 0u; d >>= 1u) {\n    float s = subgroupShuffleDown(v, d);\n    if (gl_SubgroupLocalInvocationId + d < fold) { v = combine(v, s); }\n  }\n  if (gl_SubgroupLocalInvocationId == 0u) { partials[gl_SubgroupID] = v; }\n  barrier();\n  for (uint d = gl_NumSubgroups / 2u; d > 0u; d >>= 1u) {\n    if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId < d) {\n      uint lid = gl_SubgroupLocalInvocationId;\n      partials[lid] = combine(partials[lid], partials[lid + d]);\n    }\n    barrier();\n  }\n  if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId == 0u) { parts[gl_WorkGroupID.x] = partials[0]; }\n}\n" :min "#version 450\n#extension GL_KHR_shader_subgroup : require\nlayout(local_size_x = 64) in;\nlayout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\nlayout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };\nlayout(set = 0, binding = 2, std430) readonly buffer N { uint n; };\nshared float partials[64];\nfloat combine(float a, float b) { return min(a,b); }\nvoid main() {\n  uint i = gl_GlobalInvocationID.x;\n  float v = i < n ? x[i] : 3.402823466e+38;\n  uint fold = min(gl_SubgroupSize, gl_WorkGroupSize.x);\n  for (uint d = fold / 2u; d > 0u; d >>= 1u) {\n    float s = subgroupShuffleDown(v, d);\n    if (gl_SubgroupLocalInvocationId + d < fold) { v = combine(v, s); }\n  }\n  if (gl_SubgroupLocalInvocationId == 0u) { partials[gl_SubgroupID] = v; }\n  barrier();\n  for (uint d = gl_NumSubgroups / 2u; d > 0u; d >>= 1u) {\n    if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId < d) {\n      uint lid = gl_SubgroupLocalInvocationId;\n      partials[lid] = combine(partials[lid], partials[lid + d]);\n    }\n    barrier();\n  }\n  if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId == 0u) { parts[gl_WorkGroupID.x] = partials[0]; }\n}\n"} 256 {:sum "#version 450\n#extension GL_KHR_shader_subgroup : require\nlayout(local_size_x = 256) in;\nlayout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\nlayout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };\nlayout(set = 0, binding = 2, std430) readonly buffer N { uint n; };\nshared float partials[256];\nfloat combine(float a, float b) { return a+b; }\nvoid main() {\n  uint i = gl_GlobalInvocationID.x;\n  float v = i < n ? x[i] : 0.0;\n  uint fold = min(gl_SubgroupSize, gl_WorkGroupSize.x);\n  for (uint d = fold / 2u; d > 0u; d >>= 1u) {\n    float s = subgroupShuffleDown(v, d);\n    if (gl_SubgroupLocalInvocationId + d < fold) { v = combine(v, s); }\n  }\n  if (gl_SubgroupLocalInvocationId == 0u) { partials[gl_SubgroupID] = v; }\n  barrier();\n  for (uint d = gl_NumSubgroups / 2u; d > 0u; d >>= 1u) {\n    if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId < d) {\n      uint lid = gl_SubgroupLocalInvocationId;\n      partials[lid] = combine(partials[lid], partials[lid + d]);\n    }\n    barrier();\n  }\n  if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId == 0u) { parts[gl_WorkGroupID.x] = partials[0]; }\n}\n" :max "#version 450\n#extension GL_KHR_shader_subgroup : require\nlayout(local_size_x = 256) in;\nlayout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\nlayout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };\nlayout(set = 0, binding = 2, std430) readonly buffer N { uint n; };\nshared float partials[256];\nfloat combine(float a, float b) { return max(a,b); }\nvoid main() {\n  uint i = gl_GlobalInvocationID.x;\n  float v = i < n ? x[i] : -3.402823466e+38;\n  uint fold = min(gl_SubgroupSize, gl_WorkGroupSize.x);\n  for (uint d = fold / 2u; d > 0u; d >>= 1u) {\n    float s = subgroupShuffleDown(v, d);\n    if (gl_SubgroupLocalInvocationId + d < fold) { v = combine(v, s); }\n  }\n  if (gl_SubgroupLocalInvocationId == 0u) { partials[gl_SubgroupID] = v; }\n  barrier();\n  for (uint d = gl_NumSubgroups / 2u; d > 0u; d >>= 1u) {\n    if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId < d) {\n      uint lid = gl_SubgroupLocalInvocationId;\n      partials[lid] = combine(partials[lid], partials[lid + d]);\n    }\n    barrier();\n  }\n  if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId == 0u) { parts[gl_WorkGroupID.x] = partials[0]; }\n}\n" :min "#version 450\n#extension GL_KHR_shader_subgroup : require\nlayout(local_size_x = 256) in;\nlayout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\nlayout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };\nlayout(set = 0, binding = 2, std430) readonly buffer N { uint n; };\nshared float partials[256];\nfloat combine(float a, float b) { return min(a,b); }\nvoid main() {\n  uint i = gl_GlobalInvocationID.x;\n  float v = i < n ? x[i] : 3.402823466e+38;\n  uint fold = min(gl_SubgroupSize, gl_WorkGroupSize.x);\n  for (uint d = fold / 2u; d > 0u; d >>= 1u) {\n    float s = subgroupShuffleDown(v, d);\n    if (gl_SubgroupLocalInvocationId + d < fold) { v = combine(v, s); }\n  }\n  if (gl_SubgroupLocalInvocationId == 0u) { partials[gl_SubgroupID] = v; }\n  barrier();\n  for (uint d = gl_NumSubgroups / 2u; d > 0u; d >>= 1u) {\n    if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId < d) {\n      uint lid = gl_SubgroupLocalInvocationId;\n      partials[lid] = combine(partials[lid], partials[lid + d]);\n    }\n    barrier();\n  }\n  if (gl_SubgroupID == 0u && gl_SubgroupLocalInvocationId == 0u) { parts[gl_WorkGroupID.x] = partials[0]; }\n}\n"}})
(def emitted-sha256
  {"64-sum" "a25a69317b5c5a956279ccc37a5089adb489104a28ed89460b8928889b096254" "64-max" "11e91e67a69d880b58eb91a91cf254b139d39bb4ea042182896a6da09cbd2650" "64-min" "2eb80009e239fee609a770539b3285bce15cc5af62fe61c243571df2283ffe2a" "256-sum" "087107f90a9ddf02f64f82a40dffeb0fec6567c5dd5a1dc21116b4612b20cfd1" "256-max" "4be66217ece179da6dd6976de21c7a55a9d5be9e883fa391099f317388bfb759" "256-min" "401d4313aa76d6aeacc2dea9cb7324655783a84f4915479421c2184b7b84879c"})

;; ---- provenance self-check: a transcribed literal refuses before dispatch --
(doseq [w [64 256] op [:sum :max :min]]
  (let [k (str w "-" (name op))
        src (get-in emitted-sources [w op])
        want (get emitted-sha256 k)]
    (when (nil? src) (fail! (str "embedded emission missing shape " k)))
    (when (not= (sha256-hex src) want)
      (fail! (str "embedded emission " k " does not match its recorded sha256 -- refusing to dispatch")))))

;; ---- the two rung patches (mechanical; cumulative) ------------------------
(def ^:private umbrella "#extension GL_KHR_shader_subgroup : require")
(def ^:private categories
  (str "#extension GL_KHR_shader_subgroup_basic : require\n"
       "#extension GL_KHR_shader_subgroup_shuffle_relative : require"))

(defn- rung-source [w op rung]
  (let [src (get-in emitted-sources [w op])
        s1 (if (= rung :as-emitted) src (str/replace src umbrella categories))]
    (if (= rung :categories+id)
      (str/replace s1 "gl_SubgroupLocalInvocationId" "gl_SubgroupInvocationID")
      s1)))

;; ---- expected answers (pure) ---------------------------------------------
(defn- f32-of-bits
  "The f32 value of a u32 bit pattern, for the log line only."
  [bits]
  (let [b (js/Buffer.alloc 4)]
    (.writeUInt32LE b bits 0)
    (.readFloatLE b 0)))

(defn- expected-bits
  "The f32 bit pattern the device must answer in parts[0] for one case. x[i]
  = i+1 over i in 0..n-1; every intermediate is an integer < 2^24, so the
  reduce is exact in f32 in ANY summation order and the comparison is
  bit-exact. :sum pads with 0.0, :max with -FLT_MAX, :min with FLT_MAX --
  the padding lanes (i >= n) cannot move the answer."
  [op n]
  (case op
    :sum (f32bits (quot (* n (inc n)) 2))
    :max (f32bits n)
    :min (f32bits 1)))

(defn- field->word0
  "Little-endian u32 word 0 from one 32-hex-digit read-back field. Refuses a
  field of the wrong shape instead of reading past it."
  [hex-field]
  (when-not (re-matches #"[0-9a-f]{32}" hex-field)
    (throw (js/Error. (str "read-back field is not 32 lowercase hex digits: " hex-field))))
  (let [b (fn [k] (js/parseInt (subs hex-field (* 2 k) (+ (* 2 k) 2)) 16))]
    (+ (b 0) (* 256 (b 1)) (* 65536 (b 2)) (* 16777216 (b 3)))))

(defn- check-readback
  "Verify one case's read-back word against the expected bit pattern.
  Answers {:ok true :bits :value} or {:ok false :reason}."
  [hex-field op n]
  (try
    (let [bits (field->word0 hex-field)
          want (expected-bits op n)]
      (if (= bits want)
        {:ok true :bits bits :value (f32-of-bits bits)}
        {:ok false :reason (str (name op) "(n=" n "): parts[0] bits=" bits " want=" want)}))
    (catch :default e {:ok false :reason (.-message e)})))

;; ---- self-tests: the verifier is the only thing between a device reading
;; and a claim, so it is tested against synthetic fields before dispatch ----
(when-not (= (expected-bits :sum 64) (f32bits 2080))
  (fail! "expected-bits self-test: sum(1..64) is not 2080"))
(when-not (= (expected-bits :sum 50) (f32bits 1275))
  (fail! "expected-bits self-test: sum(1..50) is not 1275"))
(when-not (= (expected-bits :max 256) (f32bits 256))
  (fail! "expected-bits self-test: max is not n"))
(when-not (= (expected-bits :min 200) (f32bits 1))
  (fail! "expected-bits self-test: min is not 1"))
(let [good (let [b (js/Buffer.alloc 4)] (.writeFloatLE b 2080 0) (.toString b "hex"))]
  (when-not (= good "00000245") (fail! (str "self-test: f32 2080 is not 00000245 LE, got " good)))
  (let [field (str good "000000000000000000000000")
        v (check-readback field :sum 64)]
    (when-not (:ok v) (fail! (str "verify self-test: correct bits refused: " (pr-str v)))))
  (let [field (str "45020000" "000000000000000000000000")
        v (check-readback field :sum 64)]
    (when-not (and (not (:ok v)) (str/includes? (:reason v) "want="))
      (fail! (str "verify self-test: wrong bits not caught: " (pr-str v)))))
  (let [v (check-readback "abcd" :sum 64)]
    (when-not (and (not (:ok v)) (str/includes? (:reason v) "32 lowercase hex"))
      (fail! (str "verify self-test: short field not refused by name: " (pr-str v))))))

;; ---- answer parsing (pure; self-tested) ----------------------------------
;; The guest answers "INFO|<hex>"; the wire-42 INFO answer is itself
;; "<device>|<api>|<maxWgX>|<unified>" and carries three '|'. The read field
;; is exactly 32 lowercase hex digits and must be the LAST field; everything
;; before it is INFO, re-joined verbatim.
(defn- parse-answer [answer]
  (let [fields (str/split answer #"\|")
        idxs (filterv #(boolean (re-matches #"[0-9a-f]{32}" (nth fields %))) (vec (range (count fields))))]
    (when-not (and (= 1 (count idxs)) (= (first idxs) (dec (count fields))))
      (throw (js/Error. (str "answer has " (count fields) " |-fields; 32-hex fields at " idxs
                             ", want exactly one, last"))))
    {:info (str/join "|" (subvec fields 0 (dec (count fields))))
     :hex (nth fields (dec (count fields)))}))
(let [hex "00000000000000000000000000000000"
      {:keys [info]} (parse-answer (str "Fake Device|1.3.296|1024|1|" hex))]
  (when-not (= info "Fake Device|1.3.296|1024|1")
    (fail! (str "parse self-test: INFO mangled: " info))))
(let [hex "00000000000000000000000000000000"]
  (doseq [bad [(str "Fake Device|1.3.296|1024|1|" (subs hex 2))
               (str "Fake Device|1.3.296|1024|1|" hex "|tail")
               (str "Fake Device|1.3.296|1024|1|nope")]]
    (when-not (try (parse-answer bad) false (catch :default _ true))
      (fail! "parse self-test: a broken answer was not refused"))))

;; ---- host preconditions ---------------------------------------------------
(def isa (case (.-arch js/process) "x64" "x86_64" "arm64" "aarch64" (refuse! (str "unsupported host arch " (.-arch js/process)))))
(def platform (.-platform js/process))
(def target (str isa (case platform "linux" "-linux" "darwin" "-macos" (refuse! (str "unsupported platform " platform)))))
(when-not (some #(.existsSync fs %) ["/usr/include/vulkan/vulkan.h" "/usr/local/include/vulkan/vulkan.h" "/opt/homebrew/include/vulkan/vulkan.h"])
  (refuse! "no vulkan/vulkan.h on this host (apt: libvulkan-dev; macOS: brew install molten-vk vulkan-headers)"))
(def glslang
  (let [{:keys [status out]} (sh "sh" ["-c" "command -v glslangValidator"])]
    (when-not (zero? status)
      (refuse! "no glslangValidator on this host (apt: glslang-tools; macOS: brew install glslang)"))
    (str/trimr out)))
(let [{:keys [out]} (sh glslang ["--version"])]
  (println (str "GPU-SGRE-EXEC\tTOOLCHAIN\t" (str/trim (first (str/split out #"\n"))))))

;; ---- loader ---------------------------------------------------------------
(def loader (.join path tmp "kexe-loader-gpu"))
(let [{:keys [status err]} (sh "cc" (concat ["-std=c11" "-O2" "-Wall" "-Wextra" "-Werror" "-DKEXE_GPU_VULKAN"
                                             (.join path root "tools" "kexe_loader.c") "-o" loader]
                                            (if (= platform "darwin") ["-I/opt/homebrew/include" "-L/opt/homebrew/lib" "-lvulkan"] ["-lvulkan"])))]
  (when-not (zero? status) (fail! (str "the GPU loader does not build: " (subs err 0 (min 600 (count err)))))))

;; ---- the generated .kotoba guest, as data ---------------------------------
(defn- prs [form]
  (cond
    (string? form) (str "\"" form "\"")
    (or (symbol? form) (keyword? form) (number? form)) (str form)
    (vector? form) (str "[" (str/join " " (map prs form)) "]")
    (seq? form) (str "(" (str/join " " (map prs form)) ")")
    :else (str form)))

(defn- guest-text
  "One case as a guest program: INFO -> ALLOC x/parts/n -> WRITEDEC input and
  n -> PIPELINE <spv> 3 -> BEGIN -> DISPATCH (1,1,1, x parts n) -> SUBMIT ->
  READ parts[0..3] -> FREE x3, answering \"INFO|<read>\". x[i] = i+1 as f32
  bits, written only for i < n (the kernel never reads x[i] for i >= n)."
  ;; x[i] = i+1 for i < n (or the REVERSED multiset when rev? -- same
  ;; expected sum/max/min, but the minimum lands in lane n-1 instead of lane
  ;; 0, so a no-op combine cannot pass). Every unwritten lane i >= n is
  ;; POISONED with a sentinel far outside 1..W (flipped sign per direction)
  ;; so a missing `i < n` guard cannot hide in commonly zero-filled device
  ;; memory: a leaked poison changes the sum, and its sign flips the min.
  ([spv w n] (guest-text spv w n false))
  ([spv w n rev?]
  (let [poison (f32bits (if rev? -1000000.0 1000000.0))
        written (map (fn [i] (str (f32bits (if rev? (- n i) (inc i))))) (vec (range n)))
        xwords (str/join "," (concat written (repeat (max 0 (- w n)) poison)))]
    (str/join "\n"
      [(prs '(ns gpu.sgrexec (:export [main])))
       (prs '(defn gpu [r :string] :string (typed-cap-call :gpu/compute :string :string r)))
       (str "(defn main [] :string\n"
            "  (let [i0 (gpu \"INFO\")\n"
            "        hx (gpu \"ALLOC " (* w 4) "\")\n"
            "        hp (gpu \"ALLOC 16\")\n"
            "        hn (gpu \"ALLOC 16\")\n"
            "        wx (gpu (string-concat \"WRITEDEC \" (string-concat hx \" 0 " xwords "\")))\n"
            "        wn (gpu (string-concat \"WRITEDEC \" (string-concat hn \" 0 " n "\")))\n"
            "        p (gpu \"PIPELINE " spv " 3\")\n"
            "        b (gpu \"BEGIN\")\n"
            "        d (gpu (string-concat \"DISPATCH \" (string-concat p (string-concat \" 1 1 1 \" (string-concat hx (string-concat \" \" (string-concat hp (string-concat \" \" hn))))))))\n"
            "        s (gpu \"SUBMIT\")\n"
            "        rd (gpu (string-concat \"READ \" (string-concat hp \" 0 16\")))\n"
            "        f1 (gpu (string-concat \"FREE \" hx))\n"
            "        f2 (gpu (string-concat \"FREE \" hp))\n"
            "        f3 (gpu (string-concat \"FREE \" hn))]\n"
            "    (string-concat i0 (string-concat \"|\" rd))))")]))))
(when-not (str/includes? (guest-text "/x.spv" 64 64) "WRITEDEC ")
  (fail! "guest self-test: no WRITEDEC in the guest"))

;; ---- one case: guest -> amu compile -> loader run -> parse -> verify ------
;; Answers {:verdict :ok :bits :value :info}   -- executed and verified
;;         {:verdict :verify-fail :detail}     -- executed, read-back wrong
;;         {:verdict :trapped :detail}         -- no answer: device refused
;;                                              the pipeline or the guest
;;                                              trapped (verbatim detail)
;;         {:verdict :refused :detail}         -- the amu compile refused the
;;                                              guest (verbatim detail)
(defn- run-case [spv c]
  (let [{:keys [w op n]} c
        stem (str "guest-" w "-" (name op) "-" n)
        gsrc (.join path tmp (str stem ".kotoba"))
        kexe (.join path tmp (str stem ".kexe"))
        code (.join path tmp (str stem ".bin"))]
    (.writeFileSync fs gsrc (guest-text spv w n (boolean (:rev c))) "utf8")
    (let [{:keys [status out err]} (sh "node" [(.join path root "bin" "amu") "compile" gsrc
                                                "--target" target "--jvm-free"
                                                "--policy" (.join path root "test" "fixtures" "gpu" "gpu-compute-policy.edn")
                                                "--output" kexe])]
      (if-not (and (zero? status) (str/includes? (str out) ":ok true"))
        {:verdict :refused :detail (str "amu compile refused the guest: " (subs (str out err) 0 (min 300 (count (str out err)))))}
        (let [r (sh "node" [(.join path root "bin" "amu") "extract-native" kexe "--symbol" "main" "--output" code])
              m (re-find #":offset (\d+)" (:out r))]
          (if-not m
            {:verdict :trapped :detail (str "extract-native gave no offset: " (subs (:out r) 0 (min 300 (count (:out r)))))}
            (let [offset (second m)
                  run (sh loader [code offset "0" isa "42"] {"KEXE_RESULT_TYPE" "string" "KEXE_STRUCTURED_REPORT" "1" "KEXE_WALL_SECONDS" "300"})
                  hex (second (re-find #":result-utf8-hex \"([0-9a-f]+)\"" (:out run)))]
              (cond
                (str/includes? (:err run) "no Vulkan physical device")
                (refuse! "Vulkan is installed but no physical device answers here")

                (nil? hex)
                {:verdict :trapped :detail (str "the case trapped (exit " (:status run) "): "
                                                (subs (str (:out run) (:err run)) 0 (min 400 (count (str (:out run) (:err run))))))}

                :else
                (let [answer (.toString (js/Buffer.from hex "hex") "utf8")
                      parsed (try (parse-answer answer) (catch :default e {:error (.-message e)}))]
                  (if (:error parsed)
                    {:verdict :verify-fail :detail (str (:error parsed) ": " (subs answer 0 (min 200 (count answer))))}
                    (let [v (check-readback (:hex parsed) op n)]
                      (if (:ok v)
                        {:verdict :ok :bits (:bits v) :value (:value v) :info (:info parsed)}
                        {:verdict :verify-fail :detail (:reason v)}))))))))))))

;; ---- the ladder -----------------------------------------------------------
;; Ran = the device answered a read-back (verified or not). The exit code
;; speaks only for executed cases: a rung the toolchain refused is a measured
;; negative recorded by name, and a trapped case is a device/toolchain
;; refusal recorded verbatim -- neither is silently skipped, neither is a
;; passing run, and neither is dressed up as a verified result.
(def cases
  (vec (concat (for [op [:sum :max :min] n [64 50]] {:w 64 :op op :n n})
               (for [op [:sum :max :min]] {:w 256 :op op :n 256})
               [{:w 256 :op :sum :n 200} {:w 64 :op :min :n 50 :rev true} {:w 256 :op :min :n 256 :rev true}])))
(def rungs [:as-emitted :categories :categories+id])

(defn- clean
  "Strip the run's random tmp path from a printed detail so three fresh
  processes answer byte-identical logs."
  [s] (str/replace (str s) tmp "<tmp>"))

(let [ran (atom 0)
      failed (atom 0)
      not-admitted (atom 0)]
  (doseq [rung rungs]
    (doseq [[w op] [[64 :sum] [64 :max] [64 :min] [256 :sum] [256 :max] [256 :min]]]
      (let [label (str (name rung) "/W" w "-" (name op))
            src (rung-source w op rung)
            cfile (.join path tmp (str "kernel-" (name rung) "-" w "-" (name op) ".comp"))
            spv (.join path tmp (str "kernel-" (name rung) "-" w "-" (name op) ".spv"))]
        (.writeFileSync fs cfile src "utf8")
        (let [{:keys [status err]} (sh glslang ["-V" "--target-env" "vulkan1.1" "-S" "comp" cfile "-o" spv])]
          (if-not (zero? status)
            (do (swap! not-admitted inc)
                (println (str "GPU-SGRE-EXEC\tSHAPE\t" label "\tNOT-ADMITTED\t"
                              (subs (clean (str/trim (str err))) 0 (min 400 (count (clean (str/trim (str err)))))))))
            (do
              (println (str "GPU-SGRE-EXEC\tSHAPE\t" label "\tCOMPILED"))
              (doseq [c (filterv #(and (= (:w %) w) (= (:op %) op)) cases)]
                (let [res (run-case spv c)]
                  (case (:verdict res)
                    :ok (do (swap! ran inc)
                            (println (str "GPU-SGRE-EXEC\tCASE\t" label "\tn=" (:n c) "\tOK\tparts[0]=" (:value res)
                                          "\tbits=" (:bits res)
                                          "\tINFO=" (:info res))))
                    :verify-fail (do (swap! ran inc) (swap! failed inc)
                                     (println (str "GPU-SGRE-EXEC\tCASE\t" label "\tn=" (:n c) "\tVERIFY-FAIL\t" (clean (:detail res)))))
                    (do (swap! failed inc)
                        (println (str "GPU-SGRE-EXEC\tCASE\t" label "\tn=" (:n c) "\tCANNOT-EXECUTE\t" (clean (:detail res))))))))))))))
  (println (str "GPU-SGRE-EXEC\tRESULT\tran=" @ran "\tfailed=" @failed "\tnot-admitted=" @not-admitted))
  (cond
    (pos? @failed) (do (println "GPU-SGRE-EXEC\tFAIL\tan executed case did not verify") (js/process.exit 1))
    (zero? @ran) (refuse! "no case produced a device read-back on this host -- nothing executed")
    :else (js/process.exit 0)))
