#!/usr/bin/env kbb
;; The release family (`sbom`, `attest-release`, `verify-release`),
;; Apple AOT packaging (`package-ios` and `package-macos`) and the
;; ClojureScript-source targets on the nbb route --
;; ported 2026-09-11 (ADR 0347 port ledger, after ADR 0348's trust plane,
;; which `test-nbb-trust.cljk` covers). Every command is driven through
;; `bin/amu` as a caller would use it, from a directory that is not the
;; repository, with RELATIVE paths -- which is how `.kexe` was found missing
;; from the launcher's path-extension table. The trust commands it needs
;; (`keygen`, `trust-key`, `sign`, `verify`) are exercised on the way, through
;; `bin/kotoba` for two of them so that launcher's routing is measured too.
;;
;; Each verdict is measured in BOTH directions: the positive case, and the
;; refusal a one-byte or one-parameter change must produce, with its reason
;; pinned. Exit 0 only when every case ran; a shorter run is not a pass.
(ns test-nbb-release-and-emitters
  (:require [kotoba.lang.text :as str]
            ["node:child_process" :as child]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def root (fs/realpathSync (.resolve path (.dirname path *file*) "..")))
(def tmp (.mkdtempSync fs (.join path (.tmpdir os) "kotoba-nbb-signing-")))
(def amu (.join path root "bin" "amu"))
(def kotoba (.join path root "bin" "kotoba"))
(def nbb-cli (.join path root "node_modules" "nbb" "cli.js"))
(defn file [name] (.join path tmp name))
(defn write! [name value] (.writeFileSync fs (file name) value))
(defn read! [name] (.readFileSync fs (file name) "utf8"))

(def ran (atom 0))
(def failed (atom []))
(defn record! [name ok? detail]
  (swap! ran inc)
  (println (str (if ok? "PASS " "FAIL ") name (when-not ok? (str "  " detail))))
  (when-not ok? (swap! failed conj name)))

(defn amu!
  "Run `amu` from the temp directory with RELATIVE file names, the way a
  caller types them. Returns {:status :stdout :stderr}."
  [& args]
  (let [result (.spawnSync child js/process.execPath (clj->js (into [amu] args))
                           #js {:cwd tmp :encoding "utf8" :maxBuffer 16777216})]
    (when (.-error result) (throw (.-error result)))
    {:status (or (.-status result) 70)
     :stdout (or (.-stdout result) "")
     :stderr (or (.-stderr result) "")}))

(defn kotoba!
  "The same, through `bin/kotoba -M`."
  [& args]
  (let [result (.spawnSync child js/process.execPath (clj->js (into [nbb-cli kotoba "-M"] args))
                           #js {:cwd tmp :encoding "utf8" :maxBuffer 16777216})]
    (when (.-error result) (throw (.-error result)))
    {:status (or (.-status result) 70)
     :stdout (or (.-stdout result) "")
     :stderr (or (.-stderr result) "")}))

(defn ok? [r] (and (zero? (:status r)) (str/includes? (:stdout r) ":ok true")))
(defn refused-with? [r message]
  (and (not (zero? (:status r))) (str/includes? (:stderr r) message)))
(defn macho-build-platform [bytes]
  (loop [index 0 offset 32 commands (.readUInt32LE bytes 16)]
    (when (< index commands)
      (let [command (.readUInt32LE bytes offset)
            size (.readUInt32LE bytes (+ offset 4))]
        (if (= 0x32 command) ; LC_BUILD_VERSION
          (.readUInt32LE bytes (+ offset 8))
          (recur (inc index) (+ offset size) commands))))))

(try
  ;; ── artifacts ─────────────────────────────────────────────────────────
  (let [r (amu! "compile" (.join path root "examples" "structured.kotoba")
                "--target" "x86_64" "--output" "program.kexe")]
    (record! "compile x86_64 artifact" (ok? r) (:stderr r)))
  (record! "verify admits the artifact (bin/amu)" (ok? (amu! "verify" "program.kexe")) "")
  (record! "verify admits the artifact (bin/kotoba -M)" (ok? (kotoba! "verify" "program.kexe")) "")
  (let [text (read! "program.kexe")]
    (write! "tampered.kexe" (str/replace-first text ":kotoba.kexe/v1" ":kotoba.kexe/v9"))
    (record! "verify refuses a tampered artifact"
             (not (zero? (:status (amu! "verify" "tampered.kexe")))) ""))

  ;; ── keys and trust ────────────────────────────────────────────────────
  (record! "keygen (bin/kotoba -M)" (ok? (kotoba! "keygen" "--output" "signing-key.edn")) "")
  (record! "keygen writes 0600"
           (= 384 (bit-and 511 (.-mode (.statSync fs (file "signing-key.edn"))))) "")
  (record! "public-key" (ok? (amu! "public-key" "signing-key.edn" "--output" "verification-key.edn")) "")
  (record! "public-key carries no private material"
           (not (str/includes? (read! "verification-key.edn") ":private-key")) "")
  (record! "trust-key" (ok? (amu! "trust-key" "verification-key.edn" "--output" "trust.edn")) "")
  (amu! "keygen" "--output" "other-key.edn")
  (amu! "public-key" "other-key.edn" "--output" "other-public.edn")
  (amu! "trust-key" "other-public.edn" "--output" "other-trust.edn")

  ;; ── sign (the trust plane itself is test-nbb-trust's) ─────────────────
  (record! "sign" (ok? (amu! "sign" "program.kexe" "--key" "signing-key.edn"
                             "--not-before" "1000" "--expires" "2000"
                             "--output" "program.signed.kexe")) "")

  ;; ── release ───────────────────────────────────────────────────────────
  (record! "sbom" (ok? (amu! "sbom" "program.kexe" "--output" "program.spdx")) "")
  (record! "sbom is deterministic"
           (do (amu! "sbom" "program.kexe" "--output" "program-again.spdx")
               (= (read! "program.spdx") (read! "program-again.spdx"))) "")
  (record! "attest-release"
           (ok? (amu! "attest-release" "program.kexe" "--sbom" "program.spdx" "--key" "signing-key.edn"
                      "--target" "x86_64" "--not-before" "1000" "--expires" "2000"
                      "--output" "release.edn")) "")
  (let [r (amu! "verify-release" "release.edn" "--artifact" "program.kexe" "--sbom" "program.spdx"
                "--trust" "trust.edn" "--now" "1500")]
    (record! "verify-release" (and (zero? (:status r)) (str/includes? (:stdout r) ":verified? true")) (:stderr r)))
  (write! "program-mutated.kexe" (str (read! "program.kexe") "x"))
  (record! "verify-release refuses a mutated artifact"
           (refused-with? (amu! "verify-release" "release.edn" "--artifact" "program-mutated.kexe"
                                "--sbom" "program.spdx" "--trust" "trust.edn" "--now" "1500")
                          "identity mismatch") "")

  ;; ── package-ios ───────────────────────────────────────────────────────
  (let [r (amu! "compile" (.join path root "examples" "structured.kotoba")
                "--target" "aarch64-ios" "--output" "ios.kexe")]
    (record! "compile aarch64-ios artifact" (ok? r) (:stderr r)))
  (let [r (amu! "package-ios" "ios.kexe" "--entry" "main" "--platform" "ios"
                "--output" "program.o" "--manifest-output" "program.o.edn")
        bytes (when (.existsSync fs (file "program.o")) (.readFileSync fs (file "program.o")))]
    ;; Mach-O 64-bit magic, little-endian: cf fa ed fe.
    (record! "package-ios writes a Mach-O 64-bit object"
             (and (ok? r) bytes (= [0xcf 0xfa 0xed 0xfe] (vec (.subarray bytes 0 4))))
             (:stderr r)))
  (record! "package-ios refuses a non-iOS artifact"
           (refused-with? (amu! "package-ios" "program.kexe" "--output" "wrong.o")
                          "matching arm64 target") "")

  ;; ── package-macos ────────────────────────────────────────────────────
  (let [r (amu! "compile" (.join path root "examples" "structured.kotoba")
                "--target" "aarch64-macos" "--fuel" "512" "--output" "macos.kexe")]
    (record! "compile aarch64-macos artifact" (ok? r) (:stderr r)))
  (let [r (amu! "package-macos" "macos.kexe" "--entry" "main"
                "--output" "macos.o" "--manifest-output" "macos.o.edn")
        bytes (when (.existsSync fs (file "macos.o")) (.readFileSync fs (file "macos.o")))
        manifest (when (.existsSync fs (file "macos.o.edn")) (read! "macos.o.edn"))]
    (record! "package-macos writes a Mach-O 64-bit object"
             (and (ok? r) bytes (= [0xcf 0xfa 0xed 0xfe] (vec (.subarray bytes 0 4))))
             (:stderr r))
    (record! "package-macos emits LC_BUILD_VERSION for macOS and a macOS manifest"
             (and bytes manifest (= 1 (macho-build-platform bytes))
                  (str/includes? manifest ":platform :macos")
                  (str/includes? manifest ":minimum-os [13 0 0]"))
             (str (:stderr r) manifest))
    (record! "package-macos stamps the bounded static-host profile"
             (and bytes manifest
                  (.includes bytes "aarch64-macos-static-kotoba-v1")
                  (str/includes? manifest ":host-profile :kotoba.macos.static-host/v1")
                  (str/includes? manifest ":host-target-profile :aarch64-macos-static-kotoba-v1"))
             (str (:stderr r) manifest)))
  (let [r (kotoba! "package-macos" "macos.kexe" "--entry" "main"
                   "--output" "macos-kotoba.o" "--manifest-output" "macos-kotoba.o.edn")
        bytes (when (.existsSync fs (file "macos-kotoba.o"))
                (.readFileSync fs (file "macos-kotoba.o")))]
    (record! "package-macos works through kotoba -M"
             (and (ok? r) bytes (= 1 (macho-build-platform bytes)))
             (:stderr r)))
  (record! "package-macos refuses an iOS artifact"
           (refused-with? (amu! "package-macos" "ios.kexe" "--output" "wrong-macos.o")
                          "matching arm64 target") "")
  (write! "vector-macos.kotoba"
          "(ns macos.vector (:export [main]))\n(defn main [] :i64 (vector-at (vector-alloc 1) 0))")
  (let [compiled (amu! "compile" "vector-macos.kotoba" "--target" "aarch64-macos"
                       "--fuel" "512" "--output" "vector-macos.kexe")
        packaged (amu! "package-macos" "vector-macos.kexe" "--entry" "main"
                       "--output" "vector-macos.o")]
    (record! "package-macos refuses vector operations before writing an object"
             (and (ok? compiled)
                  (refused-with? packaged "macOS static host cannot serve")
                  (not (.existsSync fs (file "vector-macos.o"))))
             (str (:stderr compiled) (:stderr packaged))))

  (write! "hash-macos.kotoba"
          "(ns macos.hash (:export [main]) (:capabilities #{:hash/sha256}))\n(defn main [] :string (hash/sha256 \"abc\"))")
  (write! "hash-macos.policy.edn" "{:allow #{[:cap/call 3]}}")
  (let [compiled (amu! "compile" "hash-macos.kotoba" "--target" "aarch64-macos"
                       "--fuel" "512" "--policy" "hash-macos.policy.edn"
                       "--output" "hash-macos.kexe")
        packaged (amu! "package-macos" "hash-macos.kexe" "--entry" "main"
                       "--output" "hash-macos.o")]
    (record! "package-macos refuses typed capabilities without a provider"
             (and (ok? compiled)
                  (refused-with? packaged "capability-calls")
                  (str/includes? (:stderr packaged) "typed-cap-call")
                  (not (.existsSync fs (file "hash-macos.o"))))
             (str (:stderr compiled) (:stderr packaged))))

  (write! "typed-map-macos.kotoba"
          "(defn main [] :i64 (typed-map-count [:map :i64 :i64] (typed-map-new [:map :i64 :i64] 1 2)))")
  (let [compiled (amu! "compile" "typed-map-macos.kotoba" "--target" "aarch64-macos"
                       "--fuel" "512" "--output" "typed-map-macos.kexe")
        packaged (amu! "package-macos" "typed-map-macos.kexe" "--entry" "main"
                       "--output" "typed-map-macos.o")]
    (record! "package-macos refuses typed-map operations before writing an object"
             (and (ok? compiled)
                  (refused-with? packaged "macOS static host cannot serve")
                  (str/includes? (:stderr packaged) "typed-map-")
                  (not (.existsSync fs (file "typed-map-macos.o"))))
             (str (:stderr compiled) (:stderr packaged))))

  (write! "document-macos.kotoba"
          "(defn main [] :i64 (document-count (document-vector (document-i64 1))))")
  (let [compiled (amu! "compile" "document-macos.kotoba" "--target" "aarch64-macos"
                       "--fuel" "512" "--output" "document-macos.kexe")
        packaged (amu! "package-macos" "document-macos.kexe" "--entry" "main"
                       "--output" "document-macos.o")]
    (record! "package-macos refuses native document operations before writing an object"
             (and (ok? compiled)
                  (refused-with? packaged "macOS static host cannot serve")
                  (str/includes? (:stderr packaged) "document-")
                  (not (.existsSync fs (file "document-macos.o"))))
             (str (:stderr compiled) (:stderr packaged))))

  (write! "abort-macos.kotoba"
          "(defn- maybe [x :i64] :i64 (if (< x 0) (throw :abort/negative) x))
           (defn main [] :i64 (try (maybe -1) (catch error 7)))")
  (let [compiled (amu! "compile" "abort-macos.kotoba" "--target" "aarch64-macos"
                       "--fuel" "512" "--output" "abort-macos.kexe")
        packaged (amu! "package-macos" "abort-macos.kexe" "--entry" "main"
                       "--output" "abort-macos.o")]
    (record! "package-macos accepts lowered abort control effects"
             (and (ok? compiled)
                  (ok? packaged)
                  (.existsSync fs (file "abort-macos.o")))
             (str (:stderr compiled) (:stderr packaged))))

  (let [r (amu! "package-macos" "macos.kexe" "--output" "collision.o"
                "--manifest-output" "./collision.o")]
    (record! "package-macos refuses colliding object and manifest paths before writing"
             (and (refused-with? r "must be distinct")
                  (not (.existsSync fs (file "collision.o"))))
             (:stderr r)))
  (let [original (.readFileSync fs (file "macos.kexe"))
        r (amu! "package-macos" "macos.kexe" "--output" "./macos.kexe"
                "--manifest-output" "macos-collision.edn")
        after (.readFileSync fs (file "macos.kexe"))]
    (record! "package-macos refuses to overwrite its input before writing"
             (and (refused-with? r "must be distinct")
                  (.equals original after)
                  (not (.existsSync fs (file "macos-collision.edn"))))
             (:stderr r)))
  ;; macOS volumes are often case-insensitive even though the names differ.
  ;; Exercise the alias on those volumes; every runner also covers lexical
  ;; aliases through the shared path check.
  (let [case-alias (.join path tmp "MACOS.KEXE")]
    (when (.existsSync fs case-alias)
      (let [original (.readFileSync fs (file "macos.kexe"))
            r (amu! "package-macos" "macos.kexe" "--output" "MACOS.KEXE"
                    "--manifest-output" "case-collision.edn")
            after (.readFileSync fs (file "macos.kexe"))]
        (record! "package-macos refuses a case-insensitive input alias before writing"
                 (and (refused-with? r "must be distinct")
                      (.equals original after)
                      (not (.existsSync fs (file "case-collision.edn"))))
                 (:stderr r)))))
  (let [nfc (file (str "unicode-\u00e9.kexe"))
        nfd (file (str "unicode-e\u0301.kexe"))]
    (.copyFileSync fs (file "macos.kexe") nfc)
    (when (.existsSync fs nfd)
      (let [original (.readFileSync fs nfc)
            r (amu! "package-macos" nfc "--output" nfd
                    "--manifest-output" "unicode-collision.edn")
            after (.readFileSync fs nfc)]
        (record! "package-macos refuses a Unicode-normalization input alias before writing"
                 (and (refused-with? r "must be distinct")
                      (.equals original after)
                      (not (.existsSync fs (file "unicode-collision.edn"))))
                 (:stderr r))))
    (.rmSync fs nfc #js {:force true}))
  (let [hardlink (file "macos-hardlink.kexe")]
    (try
      (.linkSync fs (file "macos.kexe") hardlink)
      (let [original (.readFileSync fs (file "macos.kexe"))
            r (amu! "package-macos" "macos.kexe" "--output" "macos-hardlink.kexe"
                    "--manifest-output" "hardlink-collision.edn")
            after (.readFileSync fs (file "macos.kexe"))]
        (record! "package-macos refuses a hard-linked input alias before writing"
                 (and (refused-with? r "must be distinct")
                      (.equals original after)
                      (not (.existsSync fs (file "hardlink-collision.edn"))))
                 (:stderr r)))
      (catch :default _ nil)
      (finally
        (.rmSync fs hardlink #js {:force true}))))

  ;; ── cljs emission, EXECUTED ───────────────────────────────────────────
  (let [r (amu! "compile" (.join path root "examples" "fuel.kotoba")
                "--target" "cljs-browser" "--output" "fuel.cljs")]
    (record! "compile cljs-browser emits source" (ok? r) (:stderr r)))
  (let [cp (.join path tmp "cp" "kotoba" "compiled")]
    (.mkdirSync fs cp #js {:recursive true})
    (.copyFileSync fs (file "fuel.cljs") (.join path cp "generated.cljs"))
    (let [result (.spawnSync child js/process.execPath
                             (clj->js [(.join path root "node_modules" "nbb" "cli.js")
                                       "--classpath" (.join path tmp "cp")
                                       "-e" (str "(require '[kotoba.compiled.generated :as g]) "
                                                 "(prn [(g/fact 5) (g/fact 10) "
                                                 "(try (g/forever 0) (catch :default e (ex-message e)))])")])
                             #js {:cwd tmp :encoding "utf8"})]
      ;; adr-2609242100 P4: `forever` recurses, and the cljs profile's frames
      ;; budget (256) now answers before its fuel (512) would -- the trap is
      ;; named budget/frames, not a host stack overflow.
      (record! "the emitted cljs runs: fact 5 = 120, fact 10 = 3628800, forever traps on its frames budget"
               (str/includes? (or (.-stdout result) "") "[120 3628800 \"budget/frames\"]")
               (str (.-stdout result) (.-stderr result)))))

  (finally
    (.rmSync fs tmp #js {:recursive true :force true})))

(println (str "SCANNED\t" @ran "\tcases, failed=" (count @failed)))
(when (or (seq @failed) (< @ran 33))
  (println (str "FAIL " (pr-str @failed)))
  (.exit js/process 1))
(println "nbb-release-and-emitters: release attestation, Apple AOT packaging and cljs emission on the nbb route, through both launchers")
