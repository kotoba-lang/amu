;; The x86_64-aiueos-user-plc-v1 target: raw cap-call against a declared set, in the PLC ELF layout (KOTOBA-175, ADR 0402).
;;
;; Compiles with a native Amu compiler and checks the bytes (Python stages sources and observes; it emits nothing):
;;
;; * the AIUEOS PLC program kotoba's compile-plc-st.py generates for plc/examples/motor.st (capabilities 16..19) compiles
;;   to the pinned ELF, and that ELF passes PLC_USER_ELF_VALID, a line-for-line replica of kotoba's
;;   os/aiueos/kotoba/plc-user-elf-valid.kotoba, and the trampoline/context checks of make-plc-native-receipt.py;
;; * every cap-call site is the ADR 0402 sequence (bitmap bt, ud2, trampoline call, r9 reload), one per source call;
;; * the context bitmap is exactly the declared set (also 0 and 63 at the word's two ends);
;; * refusals, each with no artifact: an undeclared capability (E7101), a capability that is not a literal on every path
;;   -- a parameter, a computed value, a value merged from branches, 64 -- (E7109), a wrong arity (E2103), a
;;   redefinition of cap-call (E2001), typed-cap-call (E7101), malformed --capabilities lists (E7109);
;; * negative controls of the validator replica: the motor ELF with a superset bitmap, a 0x220000 entry, the data
;;   segment moved, or fuel 256 is rejected;
;; * unchanged: user-v1's scalar ELF keeps its pinned SHA-256 and check-aiueos-user-elf-native.verify; the same source
;;   under the PLC target has the same code and differs only in the layout words.
;;
;; Not shown here: execution. kotoba's AIUEOS_PLC_RT_SMOKE runs the program at CPL3 under QEMU.
;; Ported from check-aiueos-user-plc-native.py (Basilisp, JUN-974). Apple Silicon macOS only. The motor program and
;; refusal literals below are generated from the Python original so they stay byte-exact.
;; Run: basilisp run -p scripts/seed scripts/seed/check-aiueos-user-plc-native.cljc -- --compiler C --output DIR
(ns check-aiueos-user-plc-native
  (:require [basilisp.string :as str]
            [aiueos-user-elf :as v1]
            [gate-util :as u]
            [macos-native-lib :as mac])
  (:import json operator re struct sys pathlib))

(def target "x86_64-aiueos-user-plc-v1")
(def caps "16,17,18,19")
(def motor "(ns aiueos.plc.motor (:export [main]))\n\n;; Generated by compile-plc-st.py. Do not interpret this source at runtime.\n(defn plc-dint [value]\n  (let [word (bit-and value 4294967295)]\n    (if (>= word 2147483648) (- word 4294967296) word)))\n\n(defn main []\n  (let [plc-v-enable (not (= (cap-call 16 0) 0))\n        plc-v-sensor (plc-dint (cap-call 16 1))\n        plc-v-command (plc-dint (+ plc-v-sensor 1))\n        plc-v-motoron (and plc-v-enable (< plc-v-command 100))\n        stage-0 (cap-call 17 (+ (if plc-v-motoron 1 0) (* 0 4294967296)))\n        stage-1 (cap-call 17 (+ (bit-and plc-v-command 4294967295) (* 1 4294967296)))\n        stages-ok (and (= stage-0 1) (= stage-1 1))\n        watchdog (if stages-ok (cap-call 19 1) 0)\n        commit (if (= watchdog 1) (cap-call 18 2) 0)]\n    (if (= commit 1) 1 0)))\n")
(def motor-sha256 "c64e408abea5c2af86c4df1838138937da2abc7ab885aa129343268404d87e7c")
(def scalar-v1-sha256 "a4c9232290f5c172de67411a20bd292ad703865ce69f2fdb66136140508376f8")
(def h "(ns t (:export [main]))\n")
(def refusals [
 ["undeclared" "16,17,18" "(ns aiueos.plc.motor (:export [main]))\n\n;; Generated by compile-plc-st.py. Do not interpret this source at runtime.\n(defn plc-dint [value]\n  (let [word (bit-and value 4294967295)]\n    (if (>= word 2147483648) (- word 4294967296) word)))\n\n(defn main []\n  (let [plc-v-enable (not (= (cap-call 16 0) 0))\n        plc-v-sensor (plc-dint (cap-call 16 1))\n        plc-v-command (plc-dint (+ plc-v-sensor 1))\n        plc-v-motoron (and plc-v-enable (< plc-v-command 100))\n        stage-0 (cap-call 17 (+ (if plc-v-motoron 1 0) (* 0 4294967296)))\n        stage-1 (cap-call 17 (+ (bit-and plc-v-command 4294967295) (* 1 4294967296)))\n        stages-ok (and (= stage-0 1) (= stage-1 1))\n        watchdog (if stages-ok (cap-call 19 1) 0)\n        commit (if (= watchdog 1) (cap-call 18 2) 0)]\n    (if (= commit 1) 1 0)))\n" "E7101 cap-call capability 19 is not declared"]
 ["parameter" "16" "(ns t (:export [main]))\n(defn- f [x] (cap-call x 0))\n(defn main [] (f 16))\n" "E7109"]
 ["computed" "16" "(ns t (:export [main]))\n(defn main [] (cap-call (+ 16 0) 0))\n" "E7109"]
 ["merged" "16,17" "(ns t (:export [main]))\n(defn main [] (let [c (= 1 1)] (cap-call (if c 16 17) 0)))\n" "E7109"]
 ["sixty-four" "16" "(ns t (:export [main]))\n(defn main [] (cap-call 64 0))\n" "E7109"]
 ["arity" "16" "(ns t (:export [main]))\n(defn main [] (cap-call 16))\n" "E2103"]
 ["redefined" "16" "(ns t (:export [main]))\n(defn- cap-call [a :i64 b :i64] :i64 7)\n(defn main [] (cap-call 16 0))\n" "E2001"]
 ["typed" "16" "(ns t (:export [main]))\n(defn main [] :i64 (let [x (typed-cap-call :io/write :string :string \"d\")] 42))\n" "E7101"]
])
(def bad-lists ["16,16" "17,16" "016" "64" "16," ",16" "a" "16 17" "1,,2"])

(defn cat [& parts] (reduce operator/add parts))
(defn qs [fmt b off] (vec (struct/unpack_from fmt b off)))
;; rsi <- [id]; mov rax,[r9+16]; bt rax,rsi; jc +2; ud2; rdx <- [arg]; mov rdi,r9; mov eax,0x1e1020; call rax; mov r9,[rbp-8]
(def site
  (re/compile (cat (u/hex->bytes "488bb5") (.encode "....") (u/hex->bytes "498b4110") (u/hex->bytes "480fa3f0")
                   (u/hex->bytes "7202") (u/hex->bytes "0f0b") (u/hex->bytes "488b95") (.encode "....")
                   (u/hex->bytes "4c89cf") (u/hex->bytes "b820101e00") (u/hex->bytes "ffd0") (u/hex->bytes "4c8b4df8"))
              re/S))

(defn plc-user-elf-valid
  "kotoba os/aiueos/kotoba/plc-user-elf-valid.kotoba (kotoba_aiueos_user_elf_valid), check for check."
  [image]
  (let [n (python/len image)
        u8 (fn [o] (when (and (<= 0 o) (< o n) (< o 16384)) (operator/getitem image o)))
        u16 (fn [o] (if (<= (+ o 2) n) (.from_bytes python/int (u/bslice image o (+ o 2)) "little") -1))
        u32 (fn [o] (if (<= (+ o 4) n) (.from_bytes python/int (u/bslice image o (+ o 4)) "little") -1))
        zero32 (fn [o] (= (u32 o) 0))
        segment (fn [base flags filesz]
                  (let [offset (if (= base 64) 4096 8192)
                        address (if (= base 64) 1970176 1974272)]
                    (and (= (u32 base) 1) (= (u32 (+ base 4)) flags) (= (u32 (+ base 8)) offset) (zero32 (+ base 12))
                         (= (u32 (+ base 16)) address) (zero32 (+ base 20)) (= (u32 (+ base 24)) address)
                         (zero32 (+ base 28)) (= (u32 (+ base 32)) filesz) (zero32 (+ base 36))
                         (= (u32 (+ base 40)) filesz) (zero32 (+ base 44)) (= (u32 (+ base 48)) 4096)
                         (zero32 (+ base 52)))))
        context-zero (fn [index end] (every? #(= (u8 %) 0) (range index end)))]
    (if (or (< n 8280) (> n 12288))
      false
      (let [text-size (u32 96)]
        (boolean
         (and (= (u32 0) 1179403647) (= (u8 4) 2) (= (u8 5) 1) (= (u8 6) 1) (= (u16 16) 2)
              (= (u16 18) 62) (= (u32 20) 1) (= (u32 24) 1970176) (zero32 28) (= (u32 32) 64)
              (zero32 36) (= (u16 52) 64) (= (u16 54) 56) (= (u16 56) 2) (> text-size 0)
              (<= text-size 4096) (<= text-size (- n 4096)) (segment 64 5 text-size)
              (segment 120 6 88) (zero32 8192) (zero32 8196) (= (u32 8200) 512)
              (zero32 8204) (= (u32 8208) 983040) (zero32 8212) (context-zero 8216 8240)
              (= (u32 8240) 1970208) (zero32 8244) (context-zero 8248 8272) (zero32 8272)
              (zero32 8276)))))))

(defn receipt-checks
  "make-plc-native-receipt.py validate_elf's trampoline and context words."
  [image]
  (let [w (qs "<11Q" image 8192)]
    (and (= (nth w 0) 0) (= (nth w 1) 512) (= (nth w 2) 0xF0000) (not-any? pos? (subvec w 3 6))
         (= (nth w 6) 0x1E1020) (not-any? pos? (subvec w 7))
         (u/deq (u/bslice image 0x1020 0x102c) (u/bytes-of 0xB8 5 0 0 0 0x48 0x8B 0x7F 0x50 0x0F 5 0xC3)))))

(defn main [compiler output]
  (mac/verify-macho compiler)
  (.mkdir output ** :parents false :mode 0700 :exist_ok false)
  (let [report (u/pydict "compiler" (mac/pin compiler))
        compile-case (fn compile-case
                       ([name source caps] (compile-case name source caps target 0))
                       ([name source caps tgt expected]
                        (.write_text (.joinpath output (str name ".kotoba")) source)
                        (let [args (concat ["compile" (str name ".kotoba") "--target" tgt]
                                           (when (some? caps) ["--capabilities" caps])
                                           ["--output" (str name ".elf")])
                              result (mac/native-run compiler output args :expected expected)]
                          [result (.joinpath output (str name ".elf"))])))
        [_ elf] (compile-case "motor" motor caps)
        image (.read_bytes elf)
        have (u/sha256-hex image)
        _ (when (or (not= have motor-sha256) (not (plc-user-elf-valid image)) (not (receipt-checks image)))
            (mac/fail (str "motor PLC ELF " have " is not the pinned image admitted by plc-user-elf-valid")))
        text (u/bslice image 4096 (+ 4096 (first (qs "<Q" image 96))))
        sites (python/len (re/findall site text))
        _ (when (or (not= sites (.count motor "(cap-call ")) (not= (.count text (u/hex->bytes "0f05")) 1))
            (mac/fail (str "motor: " sites " cap-call sites, " (.count text (u/hex->bytes "0f05")) " syscall bytes")))
        _ (.__setitem__ report "motor" (u/pydict "sha256" have "capCallSites" sites "plcUserElfValid" true))
        mutants (u/pydict)]
    (doseq [[name offset value width] [["superset-bitmap" 8208 0x1F0000 8] ["entry-0x220000" 24 0x220000 8]
                                       ["data-offset" 128 12288 8] ["fuel-256" 8200 256 8]]]
      (let [candidate (python/bytearray image)]
        (operator/setitem candidate (python/slice offset (+ offset width)) (.to_bytes value width "little"))
        (when (plc-user-elf-valid (python/bytes candidate))
          (mac/fail (str "plc-user-elf-valid replica admitted the mutant " name)))
        (.__setitem__ mutants name "rejected")))
    (let [[_ superset] (compile-case "superset" motor "16,17,18,19,20")
          sb (.read_bytes superset)]
      (when (or (plc-user-elf-valid sb) (not= (first (qs "<Q" sb 8208)) 0x1F0000))
        (mac/fail "a superset declaration did not give exactly its own bitmap"))
      (.__setitem__ mutants "compiled-superset" "bitmap 0x1f0000, rejected"))
    (.__setitem__ report "validatorNegativeControls" mutants)
    (let [bitmaps (u/pydict)]
      (doseq [[name cs mask] [["ends" "0,63" (bit-or (bit-shift-left 1 63) 1)] ["one" "5" 32]]]
        (let [[_ out] (compile-case name (str h "(defn main [] 1)\n") cs)
              word (first (qs "<Q" (.read_bytes out) 8208))]
          (when (not= word mask) (mac/fail (str "declared " cs ": bitmap " (python/hex word))))
          (.__setitem__ bitmaps cs (python/hex word))))
      (.__setitem__ report "bitmaps" bitmaps))
    (let [refused (u/pydict)]
      (doseq [[name cs source diagnostic] refusals]
        (let [[result out] (compile-case name source cs target 1)
              message (.decode (operator/add (.-stdout result) (.-stderr result)) "utf-8" "replace")]
          (when (or (not (.__contains__ message diagnostic)) (.exists out))
            (mac/fail (str name ": expected " diagnostic " and no output: " message)))
          (.__setitem__ refused name diagnostic)))
      (doseq [[index cs] (map-indexed vector bad-lists)]
        (let [[result out] (compile-case (str "list" index) (str h "(defn main [] 1)\n") cs target 2)]
          (when (or (not (u/has-bytes? (.encode "E7109 expected --capabilities") (.-stderr result))) (.exists out))
            (mac/fail (str "--capabilities " (pr-str cs) " was not refused")))
          (.__setitem__ refused (str "--capabilities " cs) "E7109")))
      (let [[_ out] (compile-case "nolist" (str h "(defn main [] 1)\n") nil target 1)]
        (when (.exists out) (mac/fail "the PLC target compiled without --capabilities"))
        (.__setitem__ refused "no --capabilities" "usage"))
      (.__setitem__ report "refusals" refused))
    (let [[_ scalar] (compile-case "scalar" v1/source nil "x86_64-aiueos-user-v1" 0)
          _ (v1/verify (.read_bytes scalar))
          _ (when (not= (u/sha256-hex (.read_bytes scalar)) scalar-v1-sha256) (mac/fail "user-v1 scalar ELF changed"))
          [_ scalar-plc] (compile-case "scalar-plc" v1/source "16,17,18,19")
          a (.read_bytes scalar)
          b (.read_bytes scalar-plc)
          ;; the same code: header words other than the addresses and the text size, the user-v1 text (the PLC text only
          ;; appends the unused cap-call stub after it), and the context other than fuel, bitmap and trampoline address
          size (first (qs "<Q" a 96))
          layout #{24 80 88 96 104 136 144}
          header (vec (for [o (range 0 176 8) :when (not (u/deq (u/bslice a o (+ o 8)) (u/bslice b o (+ o 8))))] o))
          context (vec (for [o (range 0 88 8)
                             :when (not (u/deq (u/bslice a (+ 8192 o) (+ 8200 o)) (u/bslice b (+ 8192 o) (+ 8200 o))))]
                         o))]
      (when (or (not= (python/len a) (python/len b)) (not (plc-user-elf-valid b))
                (seq (remove layout header)) (seq (remove #{8 16 48} context))
                (not (u/deq (u/bslice a 4096 (+ 4096 size)) (u/bslice b 4096 (+ 4096 size)))))
        (mac/fail (str "PLC scalar differs from user-v1 beyond the layout: " (vec (remove layout header)) " " context)))
      (.__setitem__ report "userV1" (u/pydict "sha256" scalar-v1-sha256 "plcHeaderWords" (python/list (sort header))
                                              "plcContextWords" (python/list (sort context)))))
    (.write_text (.joinpath output "report.json") (u/json-dump report))
    (println (str "PASS_AIUEOS_USER_PLC " (json/dumps report ** :sort_keys true)))
    (.flush sys/stdout)))

(defn -main [& args]
  (main (.resolve (pathlib/Path (or (u/opt args "--compiler") (sys/exit "--compiler is required"))) ** :strict true)
        (.resolve (pathlib/Path (or (u/opt args "--output") (sys/exit "--output is required"))))))

(when (some #(or (= % "check-aiueos-user-plc-native.cljc") (str/ends-with? % "/check-aiueos-user-plc-native.cljc")) sys/argv)
  (apply -main *command-line-args*))
