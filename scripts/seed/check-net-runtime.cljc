(def no-net-rules ["(if (kxrt-net-any?) (kxrt-allow-net p i3) i3)", "i3", 2])
(def other-socket [["(kxrt-syscall 198 2 526337 0 0 0 0)", "(kxrt-syscall 198 2 1 0 0 0 0)"], ["(kxrt-syscall 41 2 526337 0 0 0 0)", "(kxrt-syscall 41 2 1 0 0 0 0)"]])

(defn unity-text []
  (let [paths (vec (filter #(and (seq %) (not (.startswith % "#"))) (.splitlines (.read_text (rp selfhost)))))]
    [(apply str (map #(str (.read_text (rp %)) "\n") paths))
     (u/pydict-from (for [p (cons selfhost paths)] [p (pin (rp p))]))]))

(defn patched [text edits]
  (reduce (fn [text [old new n]]
            (let [n (or n 1)]
              (chk (= (.count text old) n) ["patch anchor" (subs old 0 (min 60 (count old))) (.count text old)])
              (.replace text old new)))
          text edits))

(defn fmt [source p q] (.replace (.replace source "{p}" (str p)) "{q}" (str q)))

(defn run-main [compiler output target seccomp?]
  (chk (= (platform/system) "Linux") "run on Linux")
  (.mkdir output ** :parents true :exist_ok false)
  (let [art (pathlib/Path output "artifacts") raw (pathlib/Path output "raw")
        _ (do (.mkdir art) (.mkdir raw))
        producer (pathlib/Path art "compiler.elf")
        _ (.write_bytes producer (.read_bytes compiler))
        _ (.chmod producer 0755)
        base-env (let [d (pyenv "PATH" "/usr/bin:/bin" "KEXE_STRUCTURED_REPORT" "1" "KEXE_FUEL" fuel)]
                   (when seccomp? (operator/setitem d "KEXE_SECCOMP" "if-available"))
                   d)
        compile- (fn [prod name source tgt & {:keys [success] :or {success true}}]
                   (let [src (pathlib/Path art (str name ".kotoba")) out (pathlib/Path art (str name ".elf"))
                         _ (.write_text src source)
                         r (subprocess/run (python/list [(str prod) "compile" (str src) "--target" tgt "--output" (str out) "--format" "static"])
                                           ** :cwd art :env (pyenv "PATH" "/usr/bin:/bin" "KEXE_CAP_RESOURCES_35" (str art) "KEXE_STACK_BYTES" "8388608")
                                           :capture_output true :timeout 1800)]
                     (.write_bytes (pathlib/Path raw (str name ".compile.stdout")) (.-stdout r))
                     (.write_bytes (pathlib/Path raw (str name ".compile.stderr")) (.-stderr r))
                     (when success
                       (chk (and (= (.-returncode r) 0) (zero? (python/len (.-stderr r))) (u/has-bytes? (b ":ok true") (.-stdout r))) [name (.-returncode r) (tailb (.-stderr r) 400)])
                       (.chmod out 0755))
                     [out r]))
        run (fn [name elf & {:keys [allow listen dial extra] :or {allow net}}]
              (let [env (let [d (python/dict base-env)] (operator/setitem d "KEXE_ALLOW" allow) d)]
                (when (some? listen) (operator/setitem env "KEXE_CAP_RESOURCES_43" listen))
                (when (some? dial) (operator/setitem env "KEXE_CAP_RESOURCES_45" dial))
                (when extra (.update env extra))
                (let [x (subprocess/run (python/list [(str elf)]) ** :env env :capture_output true :timeout 120)]
                  (.write_bytes (pathlib/Path raw (str name ".stdout")) (.-stdout x))
                  (.write_bytes (pathlib/Path raw (str name ".stderr")) (.-stderr x))
                  x)))
        ;; ---- part 1: the start-up check, with the compiler under test ----
        [plain _] (compile- producer "plain" src-plain target)
        admission-rows (python/list [])]
    (doseq [[wire name] wires]
      (let [op (str "net/" (.lower name))]
        (doseq [[spelling expression] [["numeric" (str "(typed-cap-call " wire " :string :string \"\")")]
                                       ["keyword" (str "(typed-cap-call :" op " :string :string \"\")")]
                                       ["friendly" (str "(" op " \"\")")]]]
          (let [body (str "(ns a (:export [main]))\n(defn main [] :i64 (let [x " expression "] 7))\n")
                [image _] (compile- producer (str "admit-" wire "-" spelling) body target)]
            (.append admission-rows (pyenv "wire" wire "spelling" spelling "image" (pin image)))))
        (doseq [ceiling ["#{}" "#{:state}"]]
          (let [body (str "(ns a (:export [main]))\n(defn main [] :i64 {:effects " ceiling "} (let [x (typed-cap-call " wire " :string :string \"\")] 7))\n")
                [image refused] (compile- producer (str "refuse-" wire "-" (if (= ceiling "#{}") "pure" "state")) body target :success false)
                mask (bit-shift-left 1 (if (= wire 47) 48 wire))]
            (chk (and (not= (.-returncode refused) 0) (not (.exists image)) (u/has-bytes? (b "E215") (.-stderr refused))) [wire ceiling (.-stderr refused)])
            ;; Static CLI prints the exact mask as detail; the full compiler formats the effect name. Neither may report state.
            (chk (or (u/has-bytes? (b op) (.-stderr refused)) (u/has-bytes? (b (str "detail " mask " ")) (.-stderr refused))) [wire ceiling (.-stderr refused)])
            (.append admission-rows (pyenv "wire" wire "ceiling" ceiling "refused" true))))
        (let [body (str "(ns a (:export [main]))\n(defn main [] :i64 {:effects #{:" op "}} (let [x (typed-cap-call " wire " :string :string \"\")] 7))\n")
              [image _] (compile- producer (str "own-ceiling-" wire) body target)]
          (.append admission-rows (pyenv "wire" wire "ceiling" op "image" (pin image))))))
    (doseq [wire [43 44 45 46 47]]
      (let [[image refused] (compile- producer (str "wrong-kind-" wire)
                                      (str "(ns a (:export [main]))\n(defn main [] :i64 (let [x (typed-cap-call " wire " :i64 :i64 0)] 7))\n") target :success false)]
        (chk (and (not= (.-returncode refused) 0) (not (.exists image)) (u/has-bytes? (b "E2115") (.-stderr refused))) [wire (.-stderr refused)])))
    (let [knob-rows (python/list [])
          knob (fn [name allow listen dial want-exit]
                 (let [x (run (str "knob-" name) plain :allow allow :listen listen :dial dial)]
                   (chk (= (.-returncode x) want-exit) [name (.-returncode x) (.-stdout x) (.-stderr x)])
                   (when (zero? want-exit) (chk (u/has-bytes? (b ":status :ok :result 42") (.-stdout x)) [name (.-stdout x)]))
                   (.append knob-rows (pyenv "name" name "allow" allow "listen" listen "dial" dial "exit" (.-returncode x)))))
          seventeen (str/join "," (map #(str "127.0.0.1:" (+ 7000 %)) (range 17)))]
      (knob "not-an-address" net "x" nil 2)
      (knob "no-port" net "127.0.0.1" nil 2)
      (knob "port-zero" net "127.0.0.1:0" nil 2)
      (knob "port-65536" net nil "127.0.0.1:65536" 2)
      (knob "octet-256" net "256.0.0.1:80" nil 2)
      (knob "three-octets" net nil "1.2.3:80" 2)
      (knob "trailing-comma" net "127.0.0.1:80," nil 2)
      (knob "seventeen-entries" net seventeen nil 2)
      (knob "sixteen-entries" net (str/join "," (map #(str "127.0.0.1:" (+ 7000 %)) (range 16))) nil 0)
      (knob "valid-both" net "127.0.0.1:7001,0.0.0.0:7002" "127.0.0.1:7001" 0)
      (knob "absent" net nil nil 0)
      (knob "empty" net "" "" 0)
      (knob "not-granted-ignored" "37" "x" "y" 0)
      ;; ---- part 2: the wires, through the unmodified product compiler ----
      (let [[text unity-pins] (unity-text)
            host (get {"aarch64" "aarch64-linux" "arm64" "aarch64-linux" "x86_64" "x86_64-linux" "AMD64" "x86_64-linux"} (platform/machine))
            [c-rules _] (compile- producer "control-compiler-no-net-rules" (patched text [no-net-rules]) host)
            [c-socket _] (compile- producer "control-compiler-other-socket" (patched text other-socket) host)
            rows (python/list [])
            port (atom 7100)
            e2e (fn [name source & {:keys [want-exit stdout-is stderr-has prod allow grant] :or {want-exit 0 stderr-has [] prod producer allow net grant true}}]
                  (let [p @port q (inc @port)
                        _ (swap! port + 2)
                        [elf _] (compile- prod (str "e2e-" name) (fmt source p q) target)
                        x (run (str "e2e-" name) elf :allow allow
                               :listen (when grant (str "127.0.0.1:" p))
                               :dial (when grant (str "127.0.0.1:" p ",127.0.0.1:" q)))]
                    (chk (= (.-returncode x) want-exit) [name (.-returncode x) (tailb (.-stdout x) 300) (tailb (.-stderr x) 300)])
                    (when (some? stdout-is) (chk (.startswith (.-stdout x) (operator/add stdout-is (b "{:status :ok :result 7 "))) [name (.-stdout x)]))
                    (doseq [s stderr-has] (chk (u/has-bytes? s (.-stderr x)) [name s (tailb (.-stderr x) 300)]))
                    (.append rows (pyenv "name" name "exit" (.-returncode x) "stdout" (dec- (.-stdout x)) "stderr" (dec- (.-stderr x)) "image" (pin elf)))))
            trap (b "KEXE_TRAP {:kind :capability :capability :net/")]
        (e2e "round-trip" src-round :stdout-is (b "1\n2\n3\n5\n68656c6c6f\nclosed\n\nclosed\n"))
        (e2e "accept-timeout" src-accept-timeout :stdout-is (b "timeout\n"))
        (e2e "read-timeout" src-read-timeout :stdout-is (b "timeout\n"))
        (e2e "dial-refused" src-dial-refused :stdout-is (b "refused\n"))
        (doseq [[name source wire reason] refusals]
          (e2e name source :want-exit 126 :stderr-has [(operator/add (operator/add (operator/add trap (b wire)) (b " :reason :net/")) (operator/add (b reason) (b "}\n")))]))
        (e2e "request-over-65536" src-over :want-exit 120 :stderr-has [(b ":signal :SIGILL")])
        (e2e "wire-not-granted" src-listen-one :want-exit 120 :allow "37,44,45,46,47" :stderr-has [(b ":signal :SIGILL")])
        (e2e "no-scope-granted" src-listen-one :want-exit 126 :grant false :stderr-has [(operator/add trap (b "listen :reason :net/address-not-granted}\n"))])
        (let [enforced (not seccomp?)]
          (when enforced
            (e2e "control-no-net-rules" src-round :want-exit 120 :prod c-rules :stderr-has [(b ":signal :SIGSYS")])
            (e2e "control-other-socket" src-round :want-exit 120 :prod c-socket :stderr-has [(b ":signal :SIGSYS")]))
          (let [machine (platform/machine)
                report (pyenv "status" "PASS_NET_RUNTIME" "target" target "compiler" (pin compiler)
                              "host" (python/list [(platform/system) machine (platform/release)])
                              "executionNative" (= (first (str/split target #"-")) (get {"arm64" "aarch64" "AMD64" "x86_64"} machine machine))
                              "imageSeccomp" (if seccomp? "if-available" "required")
                              "checkerAcceptsWires43to47" true "admission" admission-rows "knob" knob-rows "wires" rows
                              "productCompiler" (pin producer)
                              "testOnlyCompilers" (pyenv "admission" "none; product compiler used unchanged"
                                                         "controlNoNetRules" (pin c-rules) "controlOtherSocket" (pin c-socket))
                              "unity" unity-pins "cCompilerOrLoader" false
                              "notCovered" (python/list (if enforced [] ["the two seccomp controls: this kernel does not enforce seccomp (KEXE_SECCOMP=if-available)"])))]
            (.write_text (pathlib/Path output "net-runtime.json") (u/json-dump report))
            (println (g report "status") target (python/len knob-rows) "start-up cases" (python/len rows) "wire cases")
            (.flush sys/stdout)))))))

(defn -main [& args]
  (let [target (or (u/opt args "--target") "aarch64-linux")]
    (when-not (#{"aarch64-linux" "x86_64-linux"} target) (sys/exit "--target must be aarch64-linux or x86_64-linux"))
    (run-main (.resolve (pathlib/Path (or (u/opt args "--compiler") (sys/exit "--compiler is required"))))
              (.resolve (pathlib/Path (or (u/opt args "--output") (sys/exit "--output is required"))))
              target (boolean (some #{"--seccomp-if-available"} args)))))

(when (some #(or (= % "check-net-runtime.cljc") (str/ends-with? % "/check-net-runtime.cljc")) sys/argv)
  (apply -main *command-line-args*))
