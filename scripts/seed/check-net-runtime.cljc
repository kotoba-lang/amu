;; The static runtime's native TCP wires 43..47 (:net/listen :net/accept :net/dial :net/read :net/write), on the
;; loopback interface. Linear JUN-292. Ported from check-net-runtime.py (Basilisp, JUN-974); the Python docstring
;; has the full two-part contract (the start-up check, and the wires end to end with two seccomp control compilers).
;; Run (Linux): basilisp run -p scripts/seed scripts/seed/check-net-runtime.cljc -- --compiler F --output DIR
;;      [--target aarch64-linux|x86_64-linux] [--seccomp-if-available]
(ns check-net-runtime
  (:require [basilisp.string :as str]
            [gate-util :as u])
  (:import json operator pathlib platform subprocess sys))

(def root u/root)
(defn rp [rel] (pathlib/Path root rel))
(def selfhost "seed/X86_64-LINUX-SELFHOST-MANIFEST")
(def fuel "100000000")
(def net "37,43,44,45,46,47")
(def wires [[43 "LISTEN"] [44 "ACCEPT"] [45 "DIAL"] [46 "READ"] [47 "WRITE"]])
(defn g [m & ks] (reduce (fn [a k] (operator/getitem a k)) m ks))
(defn pin [p] (let [d (.read_bytes (pathlib/Path p))] (u/pydict "bytes" (python/len d) "sha256" (u/sha256-hex d))))
(defn chk [c m] (u/chk c (str m)))
(defn pyenv [& kvs] (apply u/pydict kvs))
(defn b [x] (.encode x "utf-8"))
(defn tailb [bs n] (.decode (u/bslice bs (max 0 (- (python/len bs) n)) (python/len bs)) "utf-8" "replace"))
(defn dec- [bs] (.decode bs "utf-8" "replace"))

