#!/usr/bin/env kbb
(ns gen-linux-static-handlers
  "Writes src/kotoba/compiler/linux_static_handlers.cljk: the decision code
  the capability handlers of a loader-less Linux static ELF call (superproject
  adr-2609251400 C3), as the SEALED artifacts this compiler produces from

    tools/kexe_loader_decisions.kotoba  the kexe loader's own decisions (C1):
                                        cap-admitted, and decide op 8, scope
                                        containment, among the rest
    tools/linux_static_handlers.kotoba  the handlers' decisions

  compiled for aarch64 and x86_64. `kotoba.compiler.nbb.native-package`
  hands them to kotoba-native `kotoba.native.linux-static`, which places their
  code beside the guest's, and to kotoba-verifier, which re-derives that code
  from each artifact's own program.

  The C1 module's code is ALSO embedded in tools/kexe_loader.c (the
  KEXE-DECISIONS-GENERATED region). This script refuses to write unless the
  bytes it compiled are byte-identical to the ones in that region, per ISA:
  the static image and the loader run one compiled predicate, not two.

    kbb --backend sci --classpath . scripts/gen-linux-static-handlers.cljk          rewrite
    kbb --backend sci --classpath . scripts/gen-linux-static-handlers.cljk --check  exit 1 when stale

  Exit codes: 0 written / up to date, 1 stale (--check), 2 could not generate."
  (:require [kotoba.lang.text :as str]
            [scripts.lib :as lib]))

(def out-path (lib/join lib/root "src" "kotoba" "compiler" "linux_static_handlers.cljk"))
(def loader-path (lib/join lib/root "tools" "kexe_loader.c"))
(def sources
  [[:decisions "tools/kexe_loader_decisions.kotoba"]
   [:handlers "tools/linux_static_handlers.kotoba"]])
(def amu (lib/join lib/root "bin" "amu"))

(defn fail! [message]
  (.error js/console (str "gen-linux-static-handlers: " message))
  (.exit js/process 2))

(defn compile! [tmp source isa]
  (let [output (lib/join tmp (str (last (str/split source #"/")) "." isa ".kexe"))
        result (lib/run amu ["compile" (lib/join lib/root source) "--target" isa "--output" output]
                        {:allow-failure? true})]
    (when-not (zero? (:status result))
      (fail! (str "amu compile " source " --target " isa ":\n" (:stdout result) (:stderr result))))
    (lib/read-text output)))

(defn code-bytes
  "The `:code` vector of an artifact's text, as numbers (the vector is the
  only `:code [` in a sealed kexe)."
  [text]
  (let [start (.indexOf text ":code [")
        end (.indexOf text "]" start)]
    (when (neg? start) (fail! "an artifact has no :code"))
    (mapv js/Number (remove str/blank? (str/split (subs text (+ start 7) end) #"[ ,]+")))))

(defn loader-region-bytes
  "The C1 decision code tools/kexe_loader.c embeds for the ISA guarded by
  GUARD, as numbers."
  [text guard]
  (let [start (.indexOf text (str "#if defined(" guard ")\n#define KEXE_DECISIONS_CAP_ADMITTED_OFFSET"))
        open (.indexOf text "{" (.indexOf text "kexe_decisions_code[" start))
        close (.indexOf text "};" open)]
    (when (neg? start) (fail! (str "tools/kexe_loader.c embeds no decision code for " guard)))
    (mapv #(js/parseInt % 16)
          (remove str/blank? (map str/trim (str/split (subs text (inc open) close) #","))))))

(defn literal [s]
  (pr-str s))

(defn render [texts shas]
  (str ";; GENERATED by scripts/gen-linux-static-handlers.cljk -- do not edit by hand.\n"
       ";; Regenerate after changing either source (sha256 of what was compiled):\n"
       (str/join "" (for [[k path] sources] (str ";;   " path " " (get shas k) "\n")))
       "(ns kotoba.compiler.linux-static-handlers\n"
       "  \"The decision code a loader-less Linux static ELF's capability handlers call\n"
       "  (superproject adr-2609251400 C3): the sealed artifacts amu compiles from\n"
       "  tools/kexe_loader_decisions.kotoba (:decisions, the kexe loader's own --\n"
       "  byte-identical to the code tools/kexe_loader.c embeds) and\n"
       "  tools/linux_static_handlers.kotoba (:handlers), per ISA, as EDN text read\n"
       "  exactly by `kotoba.compiler.nbb.cli-support/read-artifact-text!`.\"\n"
       "  {:kotoba/export [artifact-texts source-sha256]})\n\n"
       "(def source-sha256\n  " (pr-str shas) ")\n\n"
       "(def artifact-texts\n  {"
       (str/join "\n   "
                 (for [isa [:aarch64 :x86_64]]
                   (str isa " {"
                        (str/join "\n             "
                                  (for [[k _] sources]
                                    (str k " " (literal (get-in texts [isa k])))))
                        "}")))
       "})\n"))

(defn generate []
  (let [tmp (lib/temp-dir "gen-linux-static-handlers-")]
    (try
      (let [loader (lib/read-text loader-path)
            texts (into {}
                        (for [[isa target guard] [[:aarch64 "aarch64" "__aarch64__"]
                                                  [:x86_64 "x86_64" "__x86_64__"]]]
                          (let [t (into {} (for [[k path] sources] [k (compile! tmp path target)]))]
                            (when-not (= (code-bytes (:decisions t)) (loader-region-bytes loader guard))
                              (fail! (str "the " target " code compiled from tools/kexe_loader_decisions.kotoba "
                                          "is not the code tools/kexe_loader.c embeds -- regenerate that "
                                          "region first (scripts/gen-loader-decisions.cljk)")))
                            [isa t])))
            shas (into {} (for [[k path] sources] [k (lib/sha256 (lib/join lib/root path))]))]
        (render texts shas))
      (finally (lib/remove-tree! tmp)))))

(let [check? (some #{"--check"} *command-line-args*)
      current (try (lib/read-text out-path) (catch :default _ ""))
      updated (generate)]
  (cond
    (= current updated)
    (println "gen-linux-static-handlers: src/kotoba/compiler/linux_static_handlers.cljk is up to date")
    check?
    (do (.error js/console "gen-linux-static-handlers: src/kotoba/compiler/linux_static_handlers.cljk is STALE -- run scripts/gen-linux-static-handlers.cljk")
        (.exit js/process 1))
    :else
    (do (lib/write-text! out-path updated)
        (println "gen-linux-static-handlers: wrote src/kotoba/compiler/linux_static_handlers.cljk"))))
