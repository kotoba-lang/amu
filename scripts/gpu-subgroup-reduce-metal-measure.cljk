#!/usr/bin/env kbb
;; EMIT the two compared MSL arms for the JUN-58 hardware measurement,
;; straight from the emitters (never hand-written):
;;
;;   kbb --backend sci --classpath "src:test:$(kbb -Spath -M:test)" \
;;     scripts/gpu-subgroup-reduce-metal-measure.cljk [--width N] [--out DIR]
;;
;; Writes <out>/<arm>-reduce-<operator>.emitted.metal for arm in
;; {baseline, subgroup} and operator in {sum, max, min}, at workgroup
;; W = <width> -- `lower` with :baseline and :subgroup-reduce on the
;; :msl-v1 target, i.e. exactly what accelerator-pipeline/compile-spec
;; would emit for those two variant answers at that workgroup. The
;; measurement harness (scripts/gpu-subgroup-reduce-metal-measure.m)
;; dispatches these sources; the driver (.py) compiles and runs them.
;;
;; Defaults preserve the original single-cell run: --width 256 (the
;; measured Apple workgroup row, ADR-0358) and --out
;; docs/evidence/gpu-subgroup-reduce-m1max-20261023/shaders. The W-sweep
;; cells pass their own --width/--out so the historical cell is never
;; rewritten by a sweep run.
;;
;; Deterministic: same emitters, same bytes. If a run of this script
;; changes a file, an emitter changed.

(ns gpu-subgroup-reduce-metal-measure
  (:require [kotoba.compiler.accelerator :as accelerator]))

(defn- arg [flag fallback]
  (let [argv (vec *command-line-args*)
        i (.indexOf argv flag)]
    (if (neg? i) fallback (nth argv (inc i) fallback))))

(def widths (js/parseInt (arg "--width" "256")))
(def out-dir (arg "--out" "docs/evidence/gpu-subgroup-reduce-m1max-20261023/shaders"))
(def operators [:sum :max :min])
(def arms [[:baseline :baseline] [:subgroup :subgroup-reduce]])

;; The width is the KIR's workgroup size: a power of two in [32, 1024]
;; (accelerator-subgroup-reduce/applicable?'s admission). A width outside
;; it is REFUSED, not silently clamped -- a measurement taken at a width
;; other than the one named must not read like one taken at it.
(when-not (and (int? widths)
               (<= 32 widths 1024)
               (zero? (bit-and widths (dec widths))))
  (println "REFUSED --width" widths ": need a power of two in [32, 1024]")
  (js/process.exit 2))

(defn -main [& _]
  (doseq [[arm variant] arms
          operator operators]
    (let [kir (accelerator/kernel (str "reduce_" (name operator)) :reduce operator
                                  {:workgroup-size widths})
          code (accelerator/lower kir :msl-v1 variant)
          path (str out-dir "/" (name arm) "-reduce-" (name operator) ".emitted.metal")]
      (spit path code)
      (println "WROTE" path (count code) "bytes"))))

(-main)
