(ns scripts.test-nbb-package-lock
  "Run `test/nbb/package_lock.cljk` against the pinned dependency closure.

  Resolves that closure through `kotoba.compiler.nbb.classpath` and
  `deps-lock.edn` -- NOT through `clojure -Spath`, which is how the sibling
  `test-nbb-project` does it. The difference is the point: this suite exists
  to show that a package lock can be produced and consumed without a JDK, and
  a runner that shelled out to one to assemble its own classpath would be
  proving that claim on a machine that had just disproved it."
  (:require [scripts.lib :as lib]
            ["node:child_process" :as child]
            ["node:path" :as path]))

(let [nbb-cli (lib/join lib/root "node_modules" "nbb" "cli.js")
      resolved (.spawnSync child js/process.execPath
                           (clj->js [nbb-cli "--classpath"
                                     (lib/join lib/root "src")
                                     (lib/join lib/root "scripts" "print-classpath.cljk")
                                     lib/root])
                           #js {:cwd lib/root :encoding "utf8"})
      _ (when-not (zero? (or (.-status resolved) 1))
          (.error js/console
                  (str "could not resolve the dependency closure from "
                       "deps-lock.edn:\n" (.-stderr resolved)
                       "\nRegenerate it with: nbb scripts/lock-classpath.cljk"))
          (.exit js/process 70))
      entries (->> (.split (.trim (.-stdout resolved)) "\n")
                   (map #(.trim %))
                   (remove empty?))
      _ (when (empty? entries)
          ;; An empty classpath does not fail loudly -- it fails as "could not
          ;; find namespace", which reads as a missing dependency rather than
          ;; a resolver that answered nothing.
          (.error js/console "the classpath resolver returned no entries")
          (.exit js/process 70))
      classpath (.join (clj->js (concat [lib/root
                                         (lib/join lib/root "src")
                                         (lib/join lib/root "test")]
                                        entries))
                       (.-delimiter path))
      result (.spawnSync child js/process.execPath
                         (clj->js [nbb-cli "--classpath" classpath
                                   (lib/join lib/root "test" "nbb" "package_lock.cljk")])
                         #js {:cwd lib/root :stdio "inherit" :env js/process.env})]
  (when (.-error result) (throw (.-error result)))
  (.exit js/process (or (.-status result) 70)))
