#!/usr/bin/env kbb
;; Workgroup-size WITHIN-ROUND RATIOS for a COMPUTE-BOUND kernel, on THIS
;; host through the :gpu/compute (wire 42) path. The TIMING LOOP and the
;; ANALYSIS are identical to scripts/test-gpu-workgroup-ratios.cljk (one
;; kernel per local size W in {32, 64, 128, 256, 512, 1024}, 2^25 u32
;; elements per size, read-back words 0..3 checked against the same mixing
;; computed here). What changes against every earlier protocol is the KERNEL
;; BODY: the sweep kernels mix 2 rounds of xorshift per element before one
;; write and measured bandwidth-bound (no stable size effect across 11 runs
;; of three protocols); here each element runs n-mix (128) serial,
;; register-resident xorshift rounds before the same one u32 write -- 64x
;; the ALU per element, same memory traffic, so the kernel is
;; compute/latency-bound instead. The interleaved sweep README named exactly
;; this "compute-bound kernel variant" as the slice where a workgroup-size
;; effect could show up. The four evidence sets are comparable as protocols,
;; not as absolute times (the kernel body differs).
;;
;; 1. RATIOS, not raw times. The interleaved sweep (PR #1332 evidence) showed
;;    the run-to-run baseline shift (~1.0-1.23 ms for one kernel) leaves a
;;    residue in per-size medians that swamps the per-size differences
;;    (0.1-5%), so the raw fastest row flipped across runs. A within-round
;;    RATIO t(r,w) / median_w'(t(r,w')) divides out everything common to the
;;    round -- baseline, clock drift, thermal state -- and is what can carry
;;    a size effect at this noise level.
;; 2. MORE ROUNDS (24, vs 8) so each size's ratio median tightens ~3x.
;; 3. ALTERNATING WITHIN-ROUND ORDER. The interleaved sweep's documented
;;    residual bias was its fixed within-round order (32..1024): a monotonic
;;    drift within one round (~3.6 ms) would still favor one end. Here round
;;    r is emitted 32..1024 when r is even and 1024..32 when r is odd, so a
;;    monotonic within-round drift biases sizes symmetrically and cancels in
;;    the ratios. The sample j -> size mapping self-test below pins the
;;    parity rule every median depends on.
;;
;; What this measures is THIS kernel's per-size ratios on THIS device -- not
;; a universal optimum, and not a vendor dispatch row. Even a perfectly
;; stable ratio ranking here is evidence about THIS kernel shape only.
;;
;; Per run the script prints, per size: RATIOMED (median within-round ratio,
;; its IQR and range), then RATIOFASTEST (the lowest ratio median) and
;; RATIOSEPARATION (gap between best and runner-up ratio medians vs the
;; median per-size IQR, the run's noise scale). Cross-run aggregation is
;; done over the logs, not here: one process is one run.
;;
;; Kept command buffers: one per size, live simultaneously (slots 0..5), so
;; this needs KGPU_MAX_KEPT >= 6 (tools/kexe_gpu_vulkan.c, raised from 4 --
;; the same one-constant change the interleaved sweep made, so the two
;; branches merge cleanly).
;;
;; Flow (same as scripts/test-gpu-workgroup-sweep.cljk): build the loader
;; with -DKEXE_GPU_VULKAN, compile one generated .kotoba guest for the host
;; ISA, extract it, run it with the cap grant. The guest: per size ALLOC ->
;; PIPELINE -> BEGINK <k> -> DISPATCH -> SUBMIT (warm-up, discarded), then
;; 24 rounds of 6 REPLAYs in alternating order (the 144 timed samples), then
;; per size DROP -> READ words 0..3 -> FREE. Nested single-binding lets on
;; purpose: the floor fixture sequences side effects that way.
;;
;; Answer "INFO|T s1 .. s144|W hex|W hex|..." -- fields are CLASSIFIED by
;; shape, not position-guessed (the wire-42 INFO answer carries '|' itself).
;; Sample j belongs to round (quot j 6), emission position (mod j 6); the
;; size index is that position on even rounds and its mirror on odd rounds.
;;
;; Three outcomes, three exit codes:
;;   0  every size ran, every read-back verified; ratio table printed
;;   1  it ran but a size failed, a read-back was wrong, or the answer is short
;;   3  could not run here: no Vulkan headers/loader, no glslangValidator,
;;      macOS without MoltenVK, or the amu compile itself refused
;;
;;   kbb --backend sci scripts/test-gpu-workgroup-compute.cljk
(ns test-gpu-workgroup-compute
  (:require [kotoba.lang.text :as str]
            ["node:child_process" :as child]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def root (.resolve path (.dirname path *file*) ".."))
(def tmp (.mkdtempSync fs (.join path (.tmpdir os) "amu-gpu-wgcompute-")))
(def sweep-ws [32 64 128 256 512 1024])
;; 2^25 u32 = 128 MiB per buffer, same buffer and dispatch shape as the
;; sweep protocols (the kernel body differs: n-mix mixing rounds per
;; element). 6 buffers are live at once here (768 MiB total). 2D dispatch
;; (32768, 1024/W) keeps every workgroup count inside the guaranteed
;; Vulkan limit (65535 per dimension) for every W in the sweep.
(def n-elems 33554432)
(def n-mix 128)                        ;; serial xorshift rounds per element (the sweep kernels use 2)
(def groups-x 32768)
(def n-rounds 24)                      ;; even: rounds are emitted in (forward, reverse) pairs
(def n-sizes (count sweep-ws))
(def n-samples (* n-rounds n-sizes))
(assert (even? n-rounds) "n-rounds must be even (forward/reverse pairs)")

(defn- sh [cmd args & [env]]
  (let [child-env (js/Object.assign #js {} (.-env js/process) (clj->js (or env {})))
        r (child/spawnSync cmd (clj->js args) #js {:encoding "utf8" :env child-env})]
    {:status (.-status r) :out (str (.-stdout r)) :err (str (.-stderr r))}))
(defn- refuse! [reason] (println (str "GPU-WORKGROUP-COMPUTE\tCOULD-NOT-RUN\t" reason)) (js/process.exit 3))
(defn- fail! [reason] (println (str "GPU-WORKGROUP-COMPUTE\tFAIL\t" reason)) (js/process.exit 1))

(def isa (case (.-arch js/process) "x64" "x86_64" "arm64" "aarch64" (refuse! (str "unsupported host arch " (.-arch js/process)))))
(def platform (.-platform js/process))
(def target (str isa (case platform "linux" "-linux" "darwin" "-macos" (refuse! (str "unsupported platform " platform)))))

;; ---- preconditions --------------------------------------------------------
(when-not (some #(.existsSync fs %) ["/usr/include/vulkan/vulkan.h" "/usr/local/include/vulkan/vulkan.h" "/opt/homebrew/include/vulkan/vulkan.h"])
  (refuse! "no vulkan/vulkan.h on this host (apt: libvulkan-dev; macOS: brew install molten-vk vulkan-headers)"))
(def glslang
  (let [{:keys [status out]} (sh "sh" ["-c" "command -v glslangValidator"])]
    (when-not (zero? status)
      (refuse! "no glslangValidator on this host (apt: glslang-tools; macOS: brew install glslang)"))
    (str/trimr out)))

;; ---- loader ---------------------------------------------------------------
(def loader (.join path tmp "kexe-loader-gpu"))
(let [{:keys [status err]} (sh "cc" (concat ["-std=c11" "-O2" "-Wall" "-Wextra" "-Werror" "-DKEXE_GPU_VULKAN"
                                             (.join path root "tools" "kexe_loader.c") "-o" loader]
                                            (if (= platform "darwin") ["-I/opt/homebrew/include" "-L/opt/homebrew/lib" "-lvulkan"] ["-lvulkan"])))]
  (when-not (zero? status) (fail! (str "the GPU loader does not build: " (subs err 0 (min 600 (count err)))))))

;; ---- kernels: one GLSL source per W, compiled to SPIR-V --------------------
(defn- kernel-source [w]
  (str "#version 450\n"
       "layout(local_size_x = " w ") in;\n"
       "layout(set = 0, binding = 0, std430) buffer Out { uint dst[]; };\n"
       "void main() {\n"
       "  uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x);\n"
       "  uint v = i * 3u + " w "u;\n"
       "  for (int r = 0; r < " n-mix "; r++) { v ^= v << 13; v ^= v >> 17; v ^= v << 5; }\n"
       "  dst[i] = v;\n"
       "}\n"))

(doseq [w sweep-ws]
  (let [src (.join path tmp (str "kernel-" w ".comp"))
        spv (.join path tmp (str "kernel-" w ".spv"))]
    (.writeFileSync fs src (kernel-source w) "utf8")
    (let [{:keys [status err]} (sh glslang ["-V" "-S" "comp" src "-o" spv])]
      (when-not (zero? status)
        (fail! (str "glslangValidator refused W=" w ": " (subs err 0 (min 400 (count err)))))))))

;; ---- expected read-back: the same mixing, computed here --------------------
;; node prints the expected 16-byte hex for words 0..3 of a given W. Bit
;; semantics live in one place: `mix-js` mirrors the kernel source's mixing
;; loop, generated from the SAME n-mix the GLSL loop uses (pinned by the
;; self-tests below).
(def ^:private mix-js
  (str "function mix(v){for(var r=0;r<" n-mix ";r++){v=(v^(v<<13))>>>0;v=(v^(v>>>17))>>>0;v=(v^(v<<5))>>>0;}return v>>>0;}"))

(defn- expected-hex [w]
  (let [js (str mix-js
                "var s='';for(var i=0;i<4;i++){var v=mix((i*3+" w ")>>>0);for(var b=0;b<4;b++){var by=(v>>>(8*b))&255;s+=('0'+by.toString(16)).slice(-2);}}"
                "process.stdout.write(s);")
        {:keys [status out]} (sh "node" ["-e" js])]
    (when-not (zero? status) (fail! "node -e expected-hex failed"))
    (str/trimr out)))

;; ---- answer parsing (pure; self-tested below) ------------------------------
;; The answer is "INFO|T s1 .. s144|W hex|W hex|..." but the wire-42 INFO
;; answer is ITSELF "<device>|<api>|<maxWgX>|<unified>" and contains three
;; '|'. Fields are CLASSIFIED by shape, not position-guessed: a T field is
;; exactly "T" plus n-samples decimal timings; a read field is exactly
;; "<W> <32-hex>" with W in the sweep; everything before the first
;; classified field is INFO and is re-joined verbatim. The classified fields
;; must be the trailing 1 + (count sweep-ws) fields, the T field first and
;; the read fields in sweep order -- a wrong parse cannot silently pass.
(defn- toks [f] (filterv #(not (str/blank? %)) (str/split f #"\s+")))
(defn- ts-field? [f]
  (let [t (toks f)]
    (and (= (count t) (inc n-samples))
         (= (first t) "T")
         (every? #(re-matches #"\d+" %) (rest t)))))
(defn- read-field? [f]
  (let [t (toks f)]
    (and (= (count t) 2)
         (boolean (some #(= (first t) %) (map str sweep-ws)))
         (boolean (re-matches #"[0-9a-f]{32}" (second t))))))

(defn- parse-answer [answer]
  (let [fields (str/split answer #"\|")
        kind (fn [f] (cond (ts-field? f) :ts (read-field? f) :read :else nil))
        idxs (filterv #(some? (kind (nth fields %))) (vec (range (count fields))))
        n (+ 1 (count sweep-ws))]
    (when-not (and (= n (count idxs))
                   (= idxs (vec (range (- (count fields) n) (count fields)))))
      (throw (js/Error. (str "answer has " (count fields) " |-fields; classified fields at " idxs
                             ", want " n " trailing"))))
    (let [tsf (nth fields (first idxs))
          rfs (subvec fields (inc (first idxs)))]
      (when-not (= :ts (kind tsf))
        (throw (js/Error. "the first classified field is not the T field")))
      (when-not (every? #(= :read (kind %)) rfs)
        (throw (js/Error. "a trailing field is not a read field")))
      (let [samples (mapv #(js/parseInt % 10) (rest (toks tsf)))
            reads (mapv (fn [f] [(js/parseInt (first (toks f)) 10) (second (toks f))]) rfs)]
        (when-not (= (mapv first reads) sweep-ws)
          (throw (js/Error. (str "read fields answer W=" (mapv first reads) ", want " sweep-ws))))
        {:info (str/join "|" (subvec fields 0 (first idxs)))
         :samples samples
         :reads (into {} reads)}))))

;; ---- the sample -> size mapping and the ratio analysis (pure) --------------
;; Sample j belongs to round (quot j n-sizes) at emission position
;; (mod j n-sizes). Even rounds replay slots 0..5 (position = size index),
;; odd rounds replay slots 5..0 (position = 5 - size index).
(defn- size-idx [j]
  (let [r (quot j n-sizes)
        p (mod j n-sizes)]
    (if (even? r) p (- (dec n-sizes) p))))

(defn- median [xs]
  (let [s (vec (sort xs)) n (count s)]
    (when (zero? n) (fail! "median of empty sample set"))
    (if (odd? n)
      (nth s (quot n 2))
      (/ (+ (nth s (dec (quot n 2))) (nth s (quot n 2))) 2.0))))

(defn- quartile
  "Quartile of a sorted vector at fraction f, index round(f*(n-1))."
  [s f]
  (nth s (js/Math.round (* f (dec (count s))))))

(defn- analyze
  "Ratios and per-size stats for one run's flat sample vector.
  Ratio of sample j is t(j) / median of its own round. Answers
  {:per-size [{:w :ratio-med :iqr :rmin :rmax :n} ...] in sweep order,
   :fastest <row with lowest ratio-med>, :gap <runner-up minus best>,
   :noise <median per-size IQR>}."
  [samples]
  (when-not (= (count samples) n-samples)
    (fail! (str "analyze: " (count samples) " samples, want " n-samples)))
  (let [round-med (vec (map (fn [r] (median (subvec samples (* r n-sizes) (* (inc r) n-sizes))))
                            (vec (range n-rounds))))
        ratios (mapv (fn [j] (/ (* 1.0 (nth samples j)) (nth round-med (quot j n-sizes))))
                     (vec (range n-samples)))
        rows (mapv (fn [idx w]
                     (let [rs (vec (sort (filterv #(= (size-idx %) idx) (vec (range n-samples)))))
                           vals (mapv #(nth ratios %) rs)
                           sv (vec (sort vals))]
                       {:w w
                        :ratio-med (median vals)
                        :iqr (- (quartile sv 0.75) (quartile sv 0.25))
                        :rmin (first sv) :rmax (last sv)
                        :n (count vals)}))
                   (vec (range n-sizes)) sweep-ws)
        best (apply min-key :ratio-med rows)
        second-best (apply min-key :ratio-med (filterv #(not= (:w %) (:w best)) rows))]
    {:per-size rows
     :fastest best
     :gap (- (:ratio-med second-best) (:ratio-med best))
     :noise (median (mapv :iqr rows))}))

;; parser + mapping + analysis self-tests:
;; (1) the INFO answer carrying its own '|' survives verbatim and the 144
;;     samples distribute 24 per size under the PARITY mapping (the mapping
;;     every ratio median depends on);
;; (2) a short T field, a malformed read field, and read fields out of sweep
;;     order are all refused;
;; (3) median/quartile arithmetic;
;; (4) analyze on a synthetic stream whose round baselines differ by 2x and
;;     whose W=256 samples are 10% faster in every round: the ratio medians
;;     must cancel the baseline exactly and find W=256 fastest with gap 0.1
;;     against zero noise; a no-effect stream must give gap 0.
(let [hex32 (apply str (repeat 32 "a"))
      fake (str "Fake Device|1.3.296|1024|1|T"
                (str/join "" (map (fn [j] (str " " (+ 1000 j))) (range n-samples)))
                (str/join "" (map (fn [w] (str "|" w " " hex32)) sweep-ws)))
      {:keys [info samples reads]} (parse-answer fake)]
  (when-not (= info "Fake Device|1.3.296|1024|1")
    (fail! (str "parser self-test: INFO mangled: " info)))
  (when-not (= (count samples) n-samples)
    (fail! (str "parser self-test: " (count samples) " samples, want " n-samples)))
  ;; parity mapping: round 0 -> positions 0..5 = sizes 0..5, round 1 ->
  ;; positions 0..5 = sizes 5..0; 24 samples per size overall.
  (when-not (= (mapv size-idx (vec (range 12))) [0 1 2 3 4 5 5 4 3 2 1 0])
    (fail! (str "mapping self-test: parity map wrong: " (mapv size-idx (vec (range 12))))))
  (doseq [[idx w] (map-indexed vector sweep-ws)]
    (let [want (filterv #(= (size-idx %) idx) (vec (range n-samples)))]
      (when-not (= (count want) n-rounds)
        (fail! (str "mapping self-test: W=" w " got " (count want) " samples, want " n-rounds)))))
  (when-not (= (get reads 32) hex32)
    (fail! "parser self-test: read map wrong"))
  (doseq [bad [(str "Fake Device|1.3.296|1024|1|T 1 2 3" (str/join "" (map (fn [w] (str "|" w " " hex32)) sweep-ws)))
               (str "Fake Device|1.3.296|1024|1|T" (str/join "" (map (fn [j] (str " " (+ 1000 j))) (range n-samples)))
                    (str/join "" (map (fn [w] (str "|" w " " (subs hex32 0 30))) sweep-ws)))
               (str "Fake Device|1.3.296|1024|1|T" (str/join "" (map (fn [j] (str " " (+ 1000 j))) (range n-samples)))
                    (str/join "" (map (fn [w] (str "|" w " " hex32)) (reverse sweep-ws))))]]
    (when-not (try (parse-answer bad) false (catch :default _ true))
      (fail! "parser self-test: a broken answer was not refused"))))
(when-not (= (median [1 2 3 4]) 2.5) (fail! "median self-test: even"))
(when-not (= (median [3 1 2]) 2) (fail! "median self-test: odd"))
;; index round(f*(n-1)): n=8 -> q25 index 2 -> 3, q75 index 5 -> 6
(when-not (= (quartile [1 2 3 4 5 6 7 8] 0.25) 3) (fail! "quartile self-test: q25"))
(when-not (= (quartile [1 2 3 4 5 6 7 8] 0.75) 6) (fail! "quartile self-test: q75"))
;; n-mix pinning: the GLSL kernel loop and the JS read-back mirror must both
;; mix exactly n-mix rounds per element, or guest and verifier drift apart
;; silently and every read-back comparison becomes meaningless.
(when-not (str/includes? (kernel-source 32)
                         (str "for (int r = 0; r < " n-mix "; r++) { v ^= v << 13; v ^= v >> 17; v ^= v << 5; }"))
  (fail! (str "kernel self-test: GLSL mixing loop is not " n-mix " rounds")))
(when-not (str/includes? mix-js (str "for(var r=0;r<" n-mix ";r++)"))
  (fail! (str "kernel self-test: JS mirror mixing loop is not " n-mix " rounds")))
(let [;; baselines differ by up to 2x across rounds; W=256 (idx 3) is 10%
      ;; faster in EVERY round; a raw-time analysis would drown, ratios must
      ;; not.
      synth (mapv (fn [j]
                    (let [r (quot j n-sizes) idx (size-idx j)
                          base (* 1.0 (+ 1000 (* 97 (mod r 13))))]
                      (* base (if (= idx 3) 0.9 1.0))))
                  (vec (range n-samples)))
      a (analyze synth)]
  (when-not (= (get-in a [:fastest :w]) 256)
    (fail! (str "analysis self-test: fastest " (get-in a [:fastest :w]) ", want 256")))
  (when-not (< (js/Math.abs (- (:gap a) 0.1)) 1e-9)
    (fail! (str "analysis self-test: gap " (:gap a) ", want 0.1")))
  (when-not (< (:noise a) 1e-9)
    (fail! (str "analysis self-test: noise " (:noise a) ", want 0")))
  (let [flat (analyze (vec (repeat n-samples 1000)))]
    (when-not (and (< (:gap flat) 1e-9) (< (:noise flat) 1e-9))
      (fail! (str "analysis self-test: no-effect stream gave gap " (:gap flat) " noise " (:noise flat))))))

;; ---- the generated .kotoba guest, as data ---------------------------------
;; The guest is built as s-expressions and printed by `prs` -- paren balance
;; is by construction. Setup (all six sizes, in nested single-binding lets):
;; ALLOC -> PIPELINE -> BEGINK <k> -> DISPATCH (32768, 1024/W) -> SUBMIT
;; (warm-up per size, discarded). Timing: `steps` recursion steps, each
;; emitting TWO rounds -- forward REPLAY 0..5 then reverse REPLAY 5..0 --
;; appending every answer to one accumulator in emission order. Teardown per
;; size: DROP -> READ words 0..3 -> FREE. The guest answers
;; "INFO|T s1 .. s144|W hex|W hex|...".
(defn- prs [form]
  (cond
    (string? form) (str "\"" form "\"")
    (or (symbol? form) (keyword? form) (number? form)) (str form)
    (vector? form) (str "[" (str/join " " (map prs form)) "]")
    (seq? form) (str "(" (str/join " " (map prs form)) ")")
    :else (str form)))

(defn- g-let [bindings body]
  (reduce (fn [acc [sym expr]] (list 'let [sym expr] acc)) body (reverse bindings)))

(defn- chain [forms]
  (if (empty? (rest forms)) (first forms)
      (list 'string-concat (first forms) (chain (rest forms)))))

(defn- g-concat-all [forms]
  (chain (interleave forms (repeat "|"))))

;; One recursion step = two rounds. Emission order of the 12 REPLAYs:
;; slots 0..5 (forward round, even r) then slots 5..0 (reverse round, odd r).
(defn- round-pair-forms []
  (let [order (concat (vec (range n-sizes)) (vec (reverse (range n-sizes))))
        syms (mapv (fn [i] (symbol (str "a" i))) (vec (range (* 2 n-sizes))))]
    [(mapv (fn [i slot] [(nth syms i) (list 'gpu (str "REPLAY " slot))])
           (vec (range (* 2 n-sizes))) order)
     syms]))

(def rounds-form
  (let [[bindings syms] (round-pair-forms)]
    (list 'defn 'rounds '[n :i64 acc :string] :string
          (list 'if '(< n 1) 'acc
                (g-let bindings
                       (list 'rounds '(- n 1)
                             (chain (interleave (cons 'acc syms) (repeat " ")))))))))

(defn- setup-bindings* []
  (apply concat
    (map-indexed
      (fn [k w]
        (let [spv (.join path tmp (str "kernel-" w ".spv"))
              groups-y (quot n-elems (* w groups-x))
              o (symbol (str "o" k)) p (symbol (str "p" k)) req (symbol (str "req" k))]
          [[o (list 'gpu "ALLOC 134217728")]
           [p (list 'gpu (str "PIPELINE " spv " 1"))]
           [req (list 'string-concat "DISPATCH "
                      (list 'string-concat p
                            (list 'string-concat (str " " groups-x " " groups-y " 1 ") o)))]
           [(symbol (str "b" k)) (list 'gpu (str "BEGINK " k))]
           [(symbol (str "d" k)) (list 'gpu req)]
           [(symbol (str "s" k)) (list 'gpu "SUBMIT")]]))
      sweep-ws)))

(defn- teardown-bindings []
  (apply concat
    (map-indexed
      (fn [k w]
        (let [o (symbol (str "o" k))]
          [[(symbol (str "dr" k)) (list 'gpu (str "DROP " k))]
           [(symbol (str "rd" k)) (list 'gpu (list 'string-concat "READ " (list 'string-concat o " 0 16")))]
           [(symbol (str "fr" k)) (list 'gpu (list 'string-concat "FREE " o))]]))
      sweep-ws)))

(def guest-text
  (str/join "\n"
    [(prs '(ns gpu.wgcompute (:export [main])))
     (prs '(defn gpu [r :string] :string (typed-cap-call :gpu/compute :string :string r)))
     (prs rounds-form)
     (prs (list 'defn 'main [] :string
            (g-let (concat [['i0 (list 'gpu "INFO")]]
                           (setup-bindings*)
                           [['ts (list 'rounds (quot n-rounds 2) "")]]
                           (teardown-bindings))
                   (g-concat-all
                     (list* 'i0
                            (list 'string-concat "T" 'ts)
                            (map-indexed
                              (fn [k w]
                                (list 'string-concat (str w) (list 'string-concat " " (symbol (str "rd" k)))))
                              sweep-ws))))))]))

;; ---- compile + run the guest (same flow as test-gpu-compute.cljk) ----------
(let [src (.join path tmp "gpu-workgroup-compute.kotoba")
      _ (.writeFileSync fs src guest-text "utf8")
      kexe (.join path tmp "compute.kexe")
      code (.join path tmp "compute.bin")
      {:keys [status out err]} (sh "node" [(.join path root "bin" "amu") "compile" src
                                           "--target" target "--jvm-free"
                                           "--policy" (.join path root "test" "fixtures" "gpu" "gpu-compute-policy.edn")
                                           "--output" kexe])]
  (when-not (and (zero? status) (str/includes? out ":ok true"))
    (refuse! (str "amu compile refused the compute guest (source kept at " src "): "
                  (subs (str out err) 0 (min 400 (count (str out err)))))))
  (let [r (sh "node" [(.join path root "bin" "amu") "extract-native" kexe "--symbol" "main" "--output" code])
        m (re-find #":offset (\d+)" (:out r))]
    (when-not m (fail! (str "extract-native gave no offset: " (:out r))))
    (let [offset (second m)
          run (sh loader [code offset "0" isa "42"] {"KEXE_RESULT_TYPE" "string" "KEXE_STRUCTURED_REPORT" "1" "KEXE_WALL_SECONDS" "300"})
          hex (second (re-find #":result-utf8-hex \"([0-9a-f]+)\"" (:out run)))]
      (when (str/includes? (:err run) "no Vulkan physical device")
        (refuse! "Vulkan is installed but no physical device answers here"))
      (when-not hex
        (fail! (str "compute guest did not answer a string (exit " (:status run) "): "
                    (subs (str (:out run) (:err run)) 0 (min 400 (count (str (:out run) (:err run))))))))
      (let [answer (.toString (js/Buffer.from hex "hex") "utf8")
            {:keys [info samples reads]}
            (try (parse-answer answer)
                 (catch :default e
                   (fail! (str (.-message e) ": " answer))))]
        (when (str/blank? info) (fail! "the INFO stage answered empty"))
        (println (str "GPU-WORKGROUP-COMPUTE\tINFO\t" info "\t" target))
        (println (str "GPU-WORKGROUP-COMPUTE\tPROTOCOL\tcompute-ratios\t"
                      n-rounds " rounds x " n-sizes " sizes\torder=alternating(32..1024,1024..32)"
                      "\tsamples=" (count samples) "\tmix-rounds=" n-mix))
        (doseq [[idx w] (map-indexed vector sweep-ws)]
          (let [expected (expected-hex w)
                read-hex (get reads w)]
            (when-not (= read-hex expected)
              (fail! (str "W=" w " read-back " read-hex " != expected " expected " (kernel did not write what it claims)")))))
        (let [{:keys [per-size fastest gap noise]} (analyze samples)]
          (doseq [r per-size]
            (println (str "GPU-WORKGROUP-COMPUTE\tRATIOMED\t" (:w r)
                          "\tratio=" (.toFixed (:ratio-med r) 4)
                          "\tiqr=" (.toFixed (:iqr r) 4)
                          "\tmin=" (.toFixed (:rmin r) 4) "\tmax=" (.toFixed (:rmax r) 4)
                          "\tn=" (:n r) "\tverify=ok")))
          (println (str "GPU-WORKGROUP-COMPUTE\tRATIOFASTEST\t" (:w fastest)
                        "\tratio=" (.toFixed (:ratio-med fastest) 4)))
          (println (str "GPU-WORKGROUP-COMPUTE\tRATIOSEPARATION\tgap=" (.toFixed gap 4)
                        "\tnoise=" (.toFixed noise 4) "\tgap>noise=" (> gap noise))))
        (js/process.exit 0)))))