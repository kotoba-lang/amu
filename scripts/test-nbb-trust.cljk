#!/usr/bin/env kbb
(ns test-nbb-trust
  "The trust-plane commands through `bin/amu`, on the Node route, with the
  refusals that make the passes mean something.

  `keygen`, `public-key`, `trust-key`, `sign`, `verify-signed`, `verify` and
  `inspect` reached the user only through `kbb -M:run` until 2026-09-11,
  and after the `.cljk` rename that route could not load the compiler at all
  -- `amu keygen` had no working route anywhere, which is how
  `test-output-set-publisher-auth` went red. This script is the one that
  discriminates the port: every positive case has a negative twin that must
  be refused with its named reason and exit code, so a route that accepted
  everything, or a route that never ran, cannot pass it.

  Run from the repo root: `kbb --backend sci --classpath . scripts/test-nbb-trust.cljk`."
  (:require [cljs.reader :as reader]
            [kotoba.lang.text :as str]
            [scripts.lib :as lib]
            ["node:child_process" :as child]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def directory (.mkdtempSync fs (.join path (.tmpdir os) "amu-trust-")))

(defn- invoke [& args]
  (.spawnSync child js/process.execPath
              (clj->js (into [(lib/join lib/root "bin" "amu")] args))
              #js {:cwd lib/root :encoding "utf8" :timeout 180000
                   :maxBuffer (* 16 1024 1024)}))

(def ^:private checks (volatile! {:pass 0 :fail 0}))

(defn- report! [ok? label detail]
  (vswap! checks update (if ok? :pass :fail) inc)
  (println (str (if ok? "PASS " "FAIL ") label (when-not ok? (str " -- " detail)))))

(defn- ok! [label & args]
  (let [result (apply invoke args)]
    (report! (and (nil? (.-error result)) (zero? (.-status result)))
             label (str "exit " (.-status result) "\n" (.-stdout result) (.-stderr result)))
    result))

(defn- refused! [label status fragment & args]
  (let [result (apply invoke args)
        err (str (.-stderr result))]
    (report! (and (= status (.-status result)) (.includes err fragment))
             (str label " (exit " status ", " (pr-str fragment) ")")
             (str "exit " (.-status result) "\n" (.-stdout result) err))
    result))

(defn- stdout-edn [result]
  (reader/read-string (str (.-stdout result))))

(defn- mode [file]
  (bit-and (.-mode (.statSync fs file)) 511))

(try
  (let [source (lib/join directory "m.kotoba")
        artifact (lib/join directory "m.kexe")
        key (lib/join directory "key.edn")
        public (lib/join directory "pub.edn")
        trust (lib/join directory "trust.edn")
        other-key (lib/join directory "other.edn")
        other-public (lib/join directory "otherpub.edn")
        other-trust (lib/join directory "othertrust.edn")
        signed (lib/join directory "m.signed.kexe")
        tampered-artifact (lib/join directory "tampered-artifact.kexe")
        tampered-statement (lib/join directory "tampered-statement.kexe")]
    (lib/write-text! source "(defn main [] :i64 42)\n")
    (ok! "compile a native artifact to sign"
         "compile" source "--target" "aarch64-macos" "--output" artifact)

    ;; keys and trust
    (let [result (ok! "keygen" "keygen" "--output" key)
          signer (:signer (stdout-edn result))]
      (report! (= 384 (mode key)) "a private key is written 0600" (.toString (mode key) 8))
      (report! (and (string? signer) (= 64 (count signer))) "keygen reports the signer id" signer)
      (let [public-result (ok! "public-key" "public-key" key "--output" public)]
        (report! (= signer (:signer (stdout-edn public-result)))
                 "public-key names the same signer" (pr-str (stdout-edn public-result))))
      (report! (not (.includes (lib/read-text public) ":private-key"))
               "the verification key carries no private key" (lib/read-text public))
      (ok! "trust-key" "trust-key" public "--output" trust)
      (report! (= #{signer} (:trusted-signers (reader/read-string (lib/read-text trust))))
               "trust-key trusts exactly that signer" (lib/read-text trust)))
    (refused! "public-key of a file that is not a key" 77 "malformed Ed25519"
              "public-key" trust "--output" (lib/join directory "never.edn"))

    ;; sign + verify-signed
    (ok! "sign" "sign" artifact "--key" key "--not-before" "0"
         "--expires" "4102444800" "--output" signed)
    (let [result (ok! "verify-signed inside the validity window"
                      "verify-signed" signed "--trust" trust "--now" "1000")
          value (stdout-edn result)]
      (report! (true? (:verified? value)) "verify-signed answers :verified? true" (pr-str value))
      (report! (= {:not-before 0 :expires 4102444800} (:validity value))
               "validity bounds print as plain integers, not #object[BigInt]"
               (str (.-stdout result))))
    (refused! "verify-signed after expiry" 77 "signature is expired"
              "verify-signed" signed "--trust" trust "--now" "4102444801")
    (refused! "verify-signed before not-before" 77 "signature is not yet valid"
              "verify-signed" (do (ok! "sign with a future not-before"
                                       "sign" artifact "--key" key "--not-before" "2000"
                                       "--expires" "3000" "--output"
                                       (lib/join directory "future.kexe"))
                                  (lib/join directory "future.kexe"))
              "--trust" trust "--now" "1999")

    ;; a signer the trust set does not name
    (ok! "keygen (other)" "keygen" "--output" other-key)
    (ok! "public-key (other)" "public-key" other-key "--output" other-public)
    (ok! "trust-key (other)" "trust-key" other-public "--output" other-trust)
    (refused! "verify-signed against a trust set that does not name the signer" 77
              "signer is not trusted"
              "verify-signed" signed "--trust" other-trust "--now" "1000")

    ;; tampering: one code byte, and one statement field
    (let [text (lib/read-text signed)
          [_ byte-text] (re-find #":code \[(\d+)" text)
          code-index (.indexOf text (str ":code [" byte-text))
          bumped (str (mod (inc (js/parseInt byte-text 10)) 256))]
      (lib/write-text! tampered-artifact
                       (str (subs text 0 (+ code-index 7)) bumped
                            (subs text (+ code-index 7 (count byte-text)))))
      (lib/write-text! tampered-statement
                       (str/replace text ":expires 4102444800" ":expires 4102444801")))
    (refused! "a tampered code byte" 65 "artifact integrity mismatch"
              "verify-signed" tampered-artifact "--trust" trust "--now" "1000")
    (refused! "a tampered statement field" 77 "Ed25519 signature verification failed"
              "verify-signed" tampered-statement "--trust" trust "--now" "1000")

    ;; A closure program: compile verifies its oracle on the in-memory map,
    ;; where `:closure-param-indexes` are host numbers; sign / verify /
    ;; verify-signed re-run that oracle on the map read back from disk, where
    ;; every integer is a BigInt. Until 2026-10-09 the read-back was refused
    ;; as "native artifact oracle evaluation rejected" right after compile
    ;; reported `:oracle {:status :verified}` (kotoba.compiler.kexe-indexes).
    (let [closure-artifact (lib/join directory "closure.kexe")
          closure-signed (lib/join directory "closure.signed.kexe")
          compiled (ok! "compile a closure program to sign"
                        "compile" (lib/join lib/root "examples" "closure-node.kotoba")
                        "--target" "aarch64-macos" "--output" closure-artifact)]
      (report! (= {:status :verified} (:oracle (stdout-edn compiled)))
               "compile reports the closure program's oracle verified" (str (.-stdout compiled)))
      (ok! "verify a closure artifact compile verified" "verify" closure-artifact)
      (ok! "sign a closure artifact compile verified" "sign" closure-artifact "--key" key
           "--not-before" "0" "--expires" "4102444800" "--output" closure-signed)
      (ok! "verify-signed a signed closure artifact"
           "verify-signed" closure-signed "--trust" trust "--now" "1000"))

    ;; verify (unsigned artifact) and inspect
    (ok! "verify" "verify" artifact)
    (refused! "verify of a tampered artifact" 65 "artifact integrity mismatch"
              "verify" (do (lib/write-text! (lib/join directory "bad.kexe")
                                            (str/replace (lib/read-text artifact)
                                                         #":code \[\d+" ":code [7"))
                           (lib/join directory "bad.kexe")))
    (let [result (ok! "inspect" "inspect" source)
          value (stdout-edn result)]
      (report! (= :kotoba.interface/v1 (:format value)) "inspect answers an interface" (pr-str value))
      (report! (= 'main (:entry value)) "inspect names the entry" (pr-str value)))

    ;; usage: the integers are checked, not swallowed
    (refused! "sign with a non-integer --expires" 64 "--expires must be a decimal integer"
              "sign" artifact "--key" key "--expires" "abc")
    (refused! "verify-signed without --trust" 64 "missing --trust"
              "verify-signed" signed "--now" "1000")
    (refused! "keygen into a directory that does not exist" 74 "output parent must be a directory"
              "keygen" "--output" (lib/join directory "nope" "key.edn"))

    ;; coverage: the repository's own snapshot, then evidence signed here
    (let [manifest-path (lib/join lib/root "data" "coverage" "interactive-2026-06.edn")
          dataset (lib/join lib/root "data" "coverage" "statcounter-os-worldwide-2026-06.csv")
          result (ok! "coverage of the repository snapshot" "coverage" manifest-path "--dataset" dataset)
          report (stdout-edn result)]
      (report! (and (= :kotoba.coverage-report/v1 (:format report))
                    (= 10000 (+ (:unknown-bps report) (:identifiable-bps report)))
                    (false? (:goal-met? report)))
               "coverage report adds up and does not claim the goal" (pr-str report))
      (refused! "coverage against the wrong dataset" 65 "coverage dataset digest mismatch"
                "coverage" manifest-path "--dataset" source)
      ;; a claim signed here, a manifest that names it as release evidence
      (let [manifest (reader/read-string (lib/read-text manifest-path))
            platform (:platform (first (remove #(= :unknown (:platform %)) (:observations manifest))))
            claim {:platform platform :paths #{:wasm}
                   :target-profiles #{:wasm32-kotoba-v1}
                   :conformance-sha256 (apply str (repeat 64 "a"))
                   :runtime-sha256 (apply str (repeat 64 "b"))
                   :ci-run-url "https://example.invalid/run/1"
                   :tested-at 1000 :expires 4102444800}
            claim-path (lib/join directory "claim.edn")
            evidence (lib/join directory "evidence.edn")
            _ (lib/write-text! claim-path (pr-str claim))
            signed (ok! "sign-coverage-evidence" "sign-coverage-evidence" claim-path
                        "--key" key "--output" evidence)
            digest (:evidence-sha256 (stdout-edn signed))
            _ (report! (and (string? digest) (= 64 (count digest)))
                       "sign-coverage-evidence reports the evidence digest" (pr-str (stdout-edn signed)))
            release-manifest (assoc manifest :support
                                    [{:platform platform :status :release
                                      :paths #{:wasm} :evidence [digest]}])
            release-path (lib/join directory "release-manifest.edn")
            _ (lib/write-text! release-path (pr-str release-manifest))
            with-evidence (ok! "coverage with signed evidence"
                               "coverage" release-path "--dataset" dataset
                               "--evidence" evidence "--trust" trust "--now" "2000")
            counted (stdout-edn with-evidence)
            share (:share-bps (first (filter #(= platform (:platform %)) (:observations manifest))))]
        (report! (and (= share (:supported-bps counted))
                      (= #{platform} (:release-platforms counted)))
                 "signed evidence counts the platform's share as supported" (pr-str counted))
        (refused! "coverage with expired evidence" 77 "coverage evidence is expired"
                  "coverage" release-path "--dataset" dataset
                  "--evidence" evidence "--trust" trust "--now" "4102444801")
        (refused! "coverage with evidence from an untrusted signer" 77
                  "coverage evidence signer is not trusted"
                  "coverage" release-path "--dataset" dataset
                  "--evidence" evidence "--trust" other-trust "--now" "2000")
        (refused! "coverage whose manifest names evidence nobody provided" 65
                  "release coverage evidence is missing or mismatched"
                  "coverage" release-path "--dataset" dataset)))

    ;; package-aiueos-boot: a minimal ET_EXEC x86-64 kernel, and the refusals
    (let [le (fn [value width] (mapv (fn [i] (mod (quot value (reduce * (repeat i 256))) 256)) (range width)))
          page 4096 phoff 64 phentsize 56 body (+ phoff (* 2 phentsize))
          ph (fn [flags offset paddr size]
               (vec (concat (le 1 4) (le flags 4) (le offset 8) (le paddr 8) (le paddr 8)
                            (le size 8) (le size 8) (le page 8))))
          header (vec (concat [0x7f 0x45 0x4c 0x46 2 1 1 0] (repeat 8 0)
                              (le 2 2) (le 0x3e 2) (le 1 4) (le 0x100000 8) (le phoff 8)
                              (le 0 8) (le 0 4) (le 64 2) (le phentsize 2) (le 2 2)
                              (le 0 2) (le 0 2) (le 0 2)))
          kernel (vec (concat header (ph 5 body 0x100000 page)
                              (ph 6 (+ body page) 0x101000 page) (repeat (* 2 page) 0)))
          image (lib/join directory "kernel.img")
          efi (lib/join directory "BOOTX64.EFI")
          efi-again (lib/join directory "BOOTX64-again.EFI")
          ok-payload (lib/join directory "ok-payload.bin")
          big-payload (lib/join directory "payload.bin")]
      (.writeFileSync fs image (js/Buffer.from (clj->js kernel)))
      ;; The embedded payload bound is 512 KiB since boot-info v5 (the x86-64
      ;; kernel image rides the payload slot), so 16 KiB + 1 is admitted and
      ;; 512 KiB + 1 is the refusal boundary.
      (.writeFileSync fs ok-payload (js/Buffer.alloc 16385 1))
      (.writeFileSync fs big-payload (js/Buffer.alloc 524289 1))
      (let [result (ok! "package-aiueos-boot" "package-aiueos-boot" image "--output" efi "--k16-note" "test")
            value (stdout-edn result)
            bytes (.readFileSync fs efi)]
        (report! (and (= 77 (aget bytes 0)) (= 90 (aget bytes 1)))
                 "the packaged image is PE32+ (starts MZ)" (str (aget bytes 0) " " (aget bytes 1)))
        (report! (and (string? (:kernel-sha256 value)) (= :x86_64-aiueos-uefi-v1 (:target value)))
                 "package-aiueos-boot reports the embedded kernel digest" (pr-str value)))
      (ok! "package-aiueos-boot again" "package-aiueos-boot" image "--output" efi-again "--k16-note" "test")
      (report! (.equals (.readFileSync fs efi) (.readFileSync fs efi-again))
               "packaging the same input twice is byte-identical" "")
      (refused! "a kernel OBJECT is not an ET_EXEC image" 65 "embedded kernel must be x86-64 ET_EXEC"
                "package-aiueos-boot" artifact "--output" (lib/join directory "never.efi"))
      (let [payload-efi (lib/join directory "payload.efi")
            result (ok! "a payload over 16 KiB is admitted within the 512 KiB bound"
                        "package-aiueos-boot" image "--payload" ok-payload
                        "--output" payload-efi)
            value (stdout-edn result)]
        (report! (and (:ok value) (string? (:payload-sha256 value))
                      (= 64 (count (:payload-sha256 value))))
                 "the packaged image reports the embedded payload digest" (pr-str value)))
      (refused! "a payload over 512 KiB" 65 "embedded AIUEOS payload exceeds 512 KiB"
                "package-aiueos-boot" image "--payload" big-payload
                "--output" (lib/join directory "never.efi"))

      ;; package-aiueos-disk-image: the bootloader must be an x86-64 PE32+
      ;; EFI application (not merely MZ), disk and receipt destinations must
      ;; be distinct, and the receipt is JSON under a .json name.
      (let [disk (lib/join directory "desktop.img")
            result (ok! "package-aiueos-disk-image" "package-aiueos-disk-image" efi
                        "--output" disk)
            value (stdout-edn result)
            receipt-path (str disk ".receipt.json")
            receipt (js/JSON.parse (lib/read-text receipt-path))]
        (report! (and (:ok value) (= receipt-path (:receipt value)))
                 "the default receipt path is the output plus .receipt.json"
                 (pr-str value))
        (report! (and (some? (aget receipt "disk")) (string? (aget receipt "disk" "sha256")))
                 "the default receipt parses as JSON and binds the disk digest"
                 (lib/read-text receipt-path)))
      (refused! "an input colliding with the disk is refused" 64 "must be distinct"
                "package-aiueos-disk-image" efi "--output" efi)
      (let [dos (lib/join directory "dos.exe")]
        (.writeFileSync fs dos (js/Buffer.concat
                                #js [(js/Buffer.from #js [0x4d 0x5a])
                                     (js/Buffer.alloc 126 0)]))
        (refused! "a DOS MZ stub is not a bootloader" 65
                  "bootloader is not PE32+"
                  "package-aiueos-disk-image" dos
                  "--output" (lib/join directory "never.img")))
      (let [arm (js/Buffer.from (.readFileSync fs efi))
            arm-path (lib/join directory "bootaa64.EFI")]
        (.writeUInt16LE arm 0xaa64 (+ (.readUInt32LE arm 0x3c) 4))
        (.writeFileSync fs arm-path arm)
        (refused! "an ARM64 UEFI binary is not an x86-64 bootloader" 65
                  "bootloader is not x86-64"
                  "package-aiueos-disk-image" arm-path
                  "--output" (lib/join directory "never.img")))

    ;; --selfhost-desktop promises the desktop profile (no GDT/TSS, no ISR
    ;; runtime): it must select the desktop packager -- different bytes from
    ;; the base kernel image -- and refuse a source that exports interrupt
    ;; entries (kotoba-native's package-kernel-desktop is fail-closed there).
    (let [base-image (lib/join directory "kernel-base.elf")
          desktop-image (lib/join directory "kernel-desktop.elf")
          isr-source (lib/join directory "isr.kotoba")]
      ;; The entry body's SysV signature is four arguments (vector, error
      ;; code, rip, rsp -- `kernel.kotoba`'s `aiueos-isr-6 [vector rip cs
      ;; flags]` form): kotoba-sema admits an entry only at arity 4
      ;; (`:kotoba.error/interrupt-entry-signature` otherwise, measured), so a
      ;; 0-arg fixture would be refused before the packager ever sees it and
      ;; the desktop refusal below would go unmeasured.
      (lib/write-text! isr-source
                       (str "(ns kernel-isr (:export [main aiueos-isr-32]))\n"
                            "(defn main [] :i64 0)\n"
                            "(defn aiueos-isr-32 [vector error-code rip rsp] :i64 1)\n"))
      (ok! "compile the x86-64 kernel image" "compile"
           (lib/join lib/root "examples" "i64-semantics.kotoba")
           "--target" "x86_64-aiueos-kernel-v1" "--artifact" "image"
           "--output" base-image)
      (ok! "compile the x86-64 kernel image with --selfhost-desktop" "compile"
           (lib/join lib/root "examples" "i64-semantics.kotoba")
           "--target" "x86_64-aiueos-kernel-v1" "--artifact" "image"
           "--selfhost-desktop" "--output" desktop-image)
      (report! (and (.existsSync fs desktop-image)
                    (not (.equals (.readFileSync fs base-image)
                                  (.readFileSync fs desktop-image))))
               "--selfhost-desktop produces the desktop image, not the base image" "")
      (refused! "the desktop profile refuses kernel interrupt entries" 65
                "does not admit kernel interrupt entries"
                "compile" isr-source "--target" "x86_64-aiueos-kernel-v1"
                "--artifact" "image" "--selfhost-desktop"
                "--output" (lib/join directory "never.elf")))


      ;; --resident is not implemented and must not be acknowledged
      (refused! "package-aiueos-boot refuses --resident" 64
                "--resident is not implemented"
                "package-aiueos-boot" image "--resident"
                "--output" (lib/join directory "never-resident.efi"))

      ;; package-aiueos-disk-image: deterministic GPT/FAT32 disk + JSON receipt
      (let [disk (lib/join directory "aiueos.img")
            result (ok! "package-aiueos-disk-image builds the desktop disk"
                        "package-aiueos-disk-image" efi "--output" disk)
            value (stdout-edn result)
            receipt (lib/join directory "aiueos.img.receipt.json")
            receipt-text (.readFileSync fs receipt "utf8")
            disk-bytes (.readFileSync fs disk)]
        (report! (= receipt (:receipt value))
                 "the default disk receipt path ends in .json" (str (:receipt value)))
        (report! (number? (aget (js/JSON.parse receipt-text) "disk" "bytes"))
                 "the disk receipt is parseable JSON with a disk entry"
                 (subs receipt-text 0 80))
        (report! (and (= 85 (aget disk-bytes 510)) (= 170 (aget disk-bytes 511)))
                 "the disk image carries the MBR signature" ""))
      (refused! "package-aiueos-disk-image refuses a colliding receipt" 64
                "input, disk, and receipt paths must be distinct"
                "package-aiueos-disk-image" efi
                "--output" (lib/join directory "collide.img")
                "--receipt" (lib/join directory "collide.img"))
      (let [junk (lib/join directory "junk.efi")]
        (.writeFileSync fs junk
                        (js/Buffer.concat #js [(js/Buffer.from "MZ") (js/Buffer.alloc 62 0)]))
        (refused! "package-aiueos-disk-image refuses a non-PE bootloader" 65
                  "bootloader is not PE32+"
                  "package-aiueos-disk-image" junk
                  "--output" (lib/join directory "never.img")))
      (let [bad (js/Buffer.from (.readFileSync fs efi))
            pe (.readUInt32LE bad 0x3c)
            bad-path (lib/join directory "bad-subsystem.efi")]
        (.writeUInt16LE bad 3 (+ pe 92))
        (.writeFileSync fs bad-path bad)
        (refused! "package-aiueos-disk-image refuses a non-EFI-application bootloader" 65
                  "bootloader is not an EFI application"
                  "package-aiueos-disk-image" bad-path
                  "--output" (lib/join directory "never2.img"))))

    ;; the route: none of the above started a JVM
    (let [result (invoke "keygen" "--output" (lib/join directory "jvm-free.edn") "--jvm-free")]
      (report! (zero? (.-status result)) "keygen runs with --jvm-free" (str (.-stderr result)))))
  (finally
    (lib/remove-tree! directory)))

(let [{:keys [pass fail]} @checks]
  (println (str "SCANNED\t" (+ pass fail) "\tchecks; " pass " passed, " fail " failed"))
  (when (or (zero? pass) (pos? fail))
    (set! (.-exitCode js/process) 1)))
