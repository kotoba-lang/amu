(ns test-default-target
  "RETIRED (2026-10-31, KOTOBA-174, ADR 0396). This legacy nbb test asserted ADR 0355's
  Kototama default, which no current entry implements and which is superseded. It is not
  run in CI and refuses to run. The current rule (each public entry names its own host,
  roots refuse an omitted target with E2, no Kototama or Wasm default) is checked natively
  by scripts/seed/check-host-default-target.py.

  Historical description: the default application artifact was the canonical Kototama VM program.

  This runs the real Amu and Kotoba launchers on the same source. It checks
  that host OS does not leak into the default artifact, that the explicit
  Kototama spelling is byte-identical, and that Wasm remains an opt-in target.
  Worker startup is checked separately because it hosts the compiler service.

  Run from the repo root: `npm run test-default-target`."
  (:require [clojure.string :as str]
            [scripts.lib :as lib]
            ["node:child_process" :as child]
            ["node:fs" :as fs]))

(throw (js/Error. "test-default-target is retired (KOTOBA-174, ADR 0396); run scripts/seed/check-host-default-target.py"))

(def directory (lib/temp-dir "amu-default-target-"))
(def amu (lib/join lib/root "bin" "amu"))
(def kotoba (lib/join lib/root "bin" "kotoba"))
(def nbb-cli (or (aget js/process.env "KBB_ENGINE")
                 (lib/join lib/root "node_modules" "nbb" "cli.js")))

(def ^:private checks (volatile! {:pass 0 :fail 0}))
(defn- report! [ok? label detail]
  (vswap! checks update (if ok? :pass :fail) inc)
  (println (str (if ok? "PASS " "FAIL ") label (when-not ok? (str " -- " detail)))))

(defn- f [name] (lib/join directory name))
(defn- spawn [argv env-overrides]
  (let [env (js/Object.assign #js {} js/process.env)]
    (js-delete env "AMU_TARGET")
    (doseq [[k v] env-overrides] (aset env k v))
    (.spawnSync child (first argv) (clj->js (rest argv))
                #js {:cwd directory :encoding "utf8" :timeout 600000
                     :maxBuffer (* 64 1024 1024) :env env})))
(defn- amu! [args & [env]]
  (spawn (into [js/process.execPath amu] args) env))
(defn- kotoba! [args & [env]]
  (spawn (into [js/process.execPath nbb-cli kotoba "-M"] args) env))
(defn- ok? [r] (and (nil? (.-error r)) (= 0 (.-status r))))
(defn- out [r] (str (.-stdout r) (.-stderr r)))
(defn- bytes-of [file] (when (.existsSync fs file) (.readFileSync fs file)))
(defn- same-bytes? [a b]
  (and a b (zero? (.compare a b))))
(defn- wasm? [bytes]
  (and bytes
       (same-bytes? (.subarray bytes 0 4)
                    (js/Buffer.from #js [0 0x61 0x73 0x6d]))))

(let [source (lib/join lib/root "examples" "evm-answer.kotoba")
      default-out (f "default.dagcbor")
      repeat-out (f "repeat.dagcbor")
      explicit-out (f "explicit.dagcbor")
      wasm-out (f "explicit.wasm")
      env-out (f "env.wasm")
      explicit-over-env (f "explicit-over-env.dagcbor")]
  (let [exit-code
        (try
    (let [default (amu! ["compile" source "--output" default-out])
          default-bytes (bytes-of default-out)
          provenance (str default-out ".provenance.edn")]
      ;; ADR 0396: an omitted --target is never Kototama (was ADR 0355's default assertion)
      (report! (not (str/includes? (out default) ":target :kototama-core-v1"))
               "omitted --target never compiles the Kototama VM program (ADR 0396)" (out default))
      (report! (and default-bytes (.existsSync fs provenance) (not (wasm? default-bytes)))
               "default output is DAG-CBOR plus provenance, not Wasm" (pr-str {:bytes? (some? default-bytes)
                                                                                :provenance? (.existsSync fs provenance)}))
      (let [marker (str default-out ".publication.edn")
            repeat (amu! ["compile" source "--output" repeat-out])
            verified (amu! ["verify-output-set" default-out])]
        (report! (and (.existsSync fs marker)
                      (str/includes? (str (.readFileSync fs marker "utf8")) "kotoba.output-set/v1"))
                 "default output set has a publication commit marker" "publication marker missing")
        (report! (and (ok? verified) (str/includes? (out verified) ":committed true"))
                 "default Kototama output set verifies by CID and canonical DAG-CBOR"
                 (out verified))
        (report! (and (ok? repeat) (same-bytes? default-bytes (bytes-of repeat-out)))
                 "default Kototama artifact is deterministic" (out repeat)))

      (let [capability-source (lib/join lib/root "examples" "capability-named.kotoba")
            capability-policy (lib/join lib/root "examples" "capability-named.edn")
            capability-out (f "capability.dagcbor")
            capability (amu! ["compile" capability-source "--policy" capability-policy
                              "--output" capability-out])]
        (report! (and (ok? capability)
                      (str/includes? (out capability)
                                    "bafyreichkkexo5hivsx5covocb4hzp52ma2vmmfkbg6ge2vjxet2xnocoy")
                      (not (wasm? (bytes-of capability-out))))
                 "effect-bearing capability source emits the canonical Kototama artifact by default"
                 (out capability)))

      (let [explicit (amu! ["compile" source "--target" "kototama" "--output" explicit-out])
            explicit-bytes (bytes-of explicit-out)]
        (report! (and (ok? explicit) (same-bytes? default-bytes explicit-bytes))
                 "explicit Kototama target is byte-identical to the default" (out explicit)))

      (let [wasm (amu! ["compile" source "--target" "wasm32-browser" "--output" wasm-out])]
        (report! (and (ok? wasm) (wasm? (bytes-of wasm-out)))
                 "Wasm remains available when explicitly selected" (out wasm)))

      (let [env-wasm (amu! ["compile" source "--output" env-out]
                           {"AMU_TARGET" "wasm32-browser"})]
        (report! (and (ok? env-wasm) (wasm? (bytes-of env-out)))
                 "AMU_TARGET remains an explicit environment override" (out env-wasm)))

      (let [explicit-kototama (amu! ["compile" source "--target" "kototama"
                                     "--output" explicit-over-env]
                                    {"AMU_TARGET" "wasm32-browser"})]
        (report! (and (ok? explicit-kototama)
                      (same-bytes? default-bytes (bytes-of explicit-over-env)))
                 "explicit --target takes precedence over AMU_TARGET" (out explicit-kototama)))

      (let [kotoba-out (f "kotoba.dagcbor")
            via-kotoba (kotoba! ["compile" source "--output" kotoba-out])]
        (report! (and (ok? via-kotoba) (same-bytes? default-bytes (bytes-of kotoba-out)))
                 "bin/kotoba and bin/amu share the Kototama default" (out via-kotoba)))

      (let [check-a (amu! ["check" source])
            check-b (amu! ["check" source] {"AMU_TARGET" "wasm32-browser"})]
        (report! (and (ok? check-a) (ok? check-b)
                      (= (.-stdout check-a) (.-stdout check-b)))
                 "target-independent check ignores AMU_TARGET" (str (out check-a) (out check-b))))

      (let [worker-output-file (f "worker.dagcbor")
            request (str (js/JSON.stringify
                          #js {:id 1 :args #js ["compile" source "--output" worker-output-file]})
                         "\n")
            worker (.spawnSync child js/process.execPath (clj->js [amu "worker"])
                               #js {:cwd directory :encoding "utf8" :timeout 600000
                                    :maxBuffer (* 64 1024 1024) :input request
                                    :env js/process.env})
            worker-result (str (.-stdout worker) (.-stderr worker))]
        (report! (and (nil? (.-error worker)) (= 0 (.-status worker))
                      (str/includes? worker-result "\"type\":\"ready\"")
                      (str/includes? worker-result "\"target\":\"kototama-core-v1\"")
                      (str/includes? worker-result "\"type\":\"result\"")
                      (str/includes? worker-result "kototama-core-v1")
                      (same-bytes? default-bytes (bytes-of worker-output-file)))
                 "worker request defaults to the same Kototama artifact" worker-result))

      (let [{:keys [pass fail]} @checks]
        (println (str "SUMMARY pass=" pass " fail=" fail))
        (if (and (pos? pass) (zero? fail)) 0 1)))
    (catch :default e
      (println (str "FAIL uncaught: " (.-message e)))
      1)
    (finally (lib/remove-tree! directory)))]
    (.exit js/process exit-code)))
