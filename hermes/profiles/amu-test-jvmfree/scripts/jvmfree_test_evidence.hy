"amu-jvmfree-test evidence v2 — 測定経路修正版 (2026-09-18).\n\nv1 からの差分は §4 のみ: bare `nbb test/nbb/run.cljk` は classpath 未解決で\n環境赤になる既知アーチファクト (sema/kir/wasm は deps.edn の git 依存)。正本経路は\nsanctioned launcher `nbb --classpath scripts scripts/run-nbb-regression.cljk`\n(origin/main 903ac54f 以降に存在)。stale なローカル main checkout (551d7b8a) の\n影響を排除するため origin/main の detached worktree (/tmp) で実測し、node_modules は\nmain checkout から symlink する。測定後 worktree は削除。\n\nそれ以外は v1 と同一:\n  1. amu checkout の HEAD を報告\n  2. test_profile.cljk 内の JVM 依存を grep で数える\n  3. `bin/amu test <probe> --jvm-free` を実測\n  5. append-only ledger に追記\nstdout: MEASURE<TAB>key<TAB>value / REFUSED <reason> (exit 2)\n"
(import json os re subprocess sys datetime)
(setv ROOT ((. os.path expanduser) ((. os.environ get) "REFACTOR_ROOT" "~/github/com-junkawasaki")))
(setv AMU_DIR ((. os.path expanduser) ((. os.environ get) "AMU_DIR" ((. os.path join) ROOT "orgs/kotoba-lang/amu"))))
(setv HERMES_HOME ((. os.environ get) "HERMES_HOME" ((. os.path join) (get os.environ "HOME") ".hermes/profiles/amu-test-jvmfree")))
(setv LEDGER ((. os.path join) HERMES_HOME "workspace" "jvmfree-test-ledger.jsonl"))
(setv JVM_PATTERNS {"clojure.java.shell" "clojure\\.java\\.shell"  "java.util.Base64" "java\\.util\\.Base64"  "java.lang.Runtime" "Runtime/"  "java.lang.System" "System/"  "java.io" "java\\.io\\."})
(setv TEST_FILE ((. os.path join) AMU_DIR "src/kotoba/compiler/test_profile.cljk"))
(defn sh [cmd [cwd None] [timeout 300]] (try (setv r (subprocess.run cmd :cwd cwd :capture_output True :text True :timeout timeout)) (return #(r.returncode (+ (or r.stdout "") (or r.stderr "")))) (except [e Exception] (return #(1 (+ "ERR:" (str e)))))))
(defn measure [] (setv rows {}) (setv #(rc out) (sh ["git" "rev-parse" "--short" "HEAD"] :cwd AMU_DIR)) (when (!= rc 0) (return #(None (+ "amu HEAD unreadable: " (cut out 200))))) (setv (get rows "amu_head") (out.strip)) (try (with [fh (open TEST_FILE :encoding "utf-8")] (setv text (fh.read))) (except [e OSError] (return #(None f"test_profile.cljk unreadable: {e}")))) (for [#(key pat) (JVM_PATTERNS.items)] (setv hits (re.findall pat text)) (setv (get rows f"jvm_{(key.replace "." "_")}") (len hits))) (setv (get rows "jvm_total") (sum (gfor k rows :if (k.startswith "jvm_") (get rows k)))) (setv probe ((. os.path join) "/tmp" f"amu-test-probe-{(os.getpid)}.kotoba")) (try (with [fh (open probe "w" :encoding "utf-8")] (fh.write "(ns t (:export [test-always-passes]))\n(defn test-always-passes [] true)\n")) (setv #(rc out) (sh [((. os.path join) AMU_DIR "bin/amu") "test" probe "--jvm-free"] :cwd AMU_DIR)) (setv (get rows "amu_test_jvmfree_rc") rc) (setv (get rows "amu_test_jvmfree_head") (if (out.strip) (cut (get ((. (out.strip) splitlines)) 0) 120) "(no output)")) (finally (try (os.unlink probe) (except [OSError])))) (setv wt ((. os.path join) "/tmp" f"amu-nbb-eval-{(os.getpid)}")) (setv #(rc_add out_add) (sh ["git" "worktree" "add" "--detach" wt "origin/main"] :cwd AMU_DIR)) (if (!= rc_add 0) (do (setv (get rows "nbb_run_rc") None) (setv (get rows "nbb_run_tail") (+ "worktree add failed: " (cut (out_add.strip) 120))) (setv (get rows "amu_nbb_eval_head") "n/a")) (do (try (setv (get rows "amu_nbb_eval_head") ((. (get (sh ["git" "rev-parse" "--short" "HEAD"] :cwd wt) 1) strip))) (setv nm_main ((. os.path join) AMU_DIR "node_modules")) (setv nm_wt ((. os.path join) wt "node_modules")) (when (and (not ((. os.path exists) nm_wt)) ((. os.path exists) nm_main)) (os.symlink nm_main nm_wt)) (setv #(rc out) (sh ["nbb" "--classpath" "scripts" "scripts/run-nbb-regression.cljk"] :cwd wt :timeout 240)) (setv (get rows "nbb_run_rc") rc) (setv lines (lfor l (out.splitlines) :if (l.strip) l)) (setv (get rows "nbb_run_tail") (if lines (cut (get lines -1) 160) "(no output)")) (finally (sh ["git" "worktree" "remove" "--force" wt] :cwd AMU_DIR))))) (return #(rows None)))
(defn main [] (try (setv #(rows err) (measure)) (when (is-not err None) (print f"REFUSED {err}") (sys.exit 2)) (os.makedirs ((. os.path dirname) LEDGER) :exist_ok True) (setv rec {"as-of" ((. ((. datetime.datetime now) (. datetime.timezone utc)) isoformat))  #** rows}) (with [fh (open LEDGER "a" :encoding "utf-8")] (fh.write (+ (json.dumps rec) "\n"))) (for [#(k v) (rows.items)] (print f"MEASURE\t{k}\t{v}")) (sys.exit 0) (except [e Exception] (print f"REFUSED {(. (type e) __name__)}: {e}") (sys.exit 2))))
(when (= __name__ "__main__") (main))
