{
  "name": "@kotoba-lang/app-kotoba-cloud",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "render": "kbb -M:render",
    "build": "npm run render && mkdir -p build && amu compile kotoba/app_kotoba_cloud/security_index.kotoba --target wasm32-browser --jvm-free --output build/security-index.wasm && node scripts/sync-shadow-src.mjs && shadow-cljs release browser app research-providers research-authority",
    "test": "kbb -M:test && node test/aiueos-boot-manifest-cli.mjs",
    "test:worker": "node test/worker-smoke.mjs && node test/support-authority.mjs && node test/requests-list.mjs && node test/requests-ledger.mjs && node test/research-authority-local.mjs && node test/authority-routing.mjs && node test/contact-email.mjs",
    "audit:uiux": "kbb --backend sci scripts/uiux-audit.cljk --min 80",
    "test:account-browser": "kbb --backend sci test/account-browser.cljk",
    "preflight": "kbb --backend sci scripts/deploy-preflight.cljk",
    "dry-run": "npm run preflight && npm test && npm run build && npm run audit:uiux && npm run test:worker && npm run test:workerd && wrangler deploy --dry-run --outdir dist --env=\"\"",
    "deploy": "npm run preflight && npm test && npm run build && npm run audit:uiux && npm run test:worker && npm run test:workerd && wrangler deploy --env=\"\"",
    "test:contract": "forge test --root contracts",
    "build:contract": "forge build --root contracts",
    "deploy:registry": "kbb --backend sci scripts/deploy-registry.cljk",
    "test:providers": "node test/research-providers.mjs",
    "build:security-data": "node scripts/build-security-data.mjs",
    "test:security-data": "node test/security-data.mjs",
    "build:compliance-catalog": "node scripts/build-compliance-catalog.mjs",
    "test:compliance-catalog": "node test/compliance-catalog.mjs",
    "build:enforcement-catalog": "node scripts/build-enforcement-catalog.mjs",
    "test:enforcement-catalog": "node test/enforcement-catalog.mjs",
    "build:vc-catalog": "node scripts/build-vc-catalog.mjs",
    "test:vc-catalog": "node test/vc-catalog.mjs",
    "build:sanctions-catalog": "node scripts/build-sanctions-catalog.mjs",
    "test:sanctions-catalog": "node test/sanctions-catalog.mjs",
    "build:yabai-catalog": "node scripts/build-yabai-catalog.mjs",
    "test:yabai-catalog": "node test/yabai-catalog.mjs",
    "build:yabai-crypto": "node scripts/build-yabai-crypto.mjs",
    "test:yabai-crypto": "node test/yabai-crypto.mjs",
    "build:legal-catalog": "node scripts/build-legal-catalog.mjs",
    "test:legal-catalog": "node test/legal-catalog.mjs",
    "build:crypto-catalog": "node scripts/build-crypto-catalog.mjs",
    "test:crypto-catalog": "node test/crypto-catalog.mjs",
    "build:orgbrain-data": "node scripts/build-orgbrain-data.mjs",
    "test:orgbrain-catalog": "node test/orgbrain-catalog.mjs",
    "test:workerd": "kbb --backend sci test/workerd-contract.cljk",
    "publish:receipts": "kbb --backend sci scripts/publish-receipts.cljk"
  },
  "devDependencies": {
    "shadow-cljs": "3.5.1",
    "wrangler": "^4.132.0"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "stripe": "22.4.0",
    "svix": "1.92.2"
  }
}
4.135.0
