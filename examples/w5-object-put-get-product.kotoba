;; W5 fuller product app (ADR 0140)
;; Guest single-export put→get-stream product vertical.
;; Affine let binds put (bool) then get-stream (linear task), consumes via
;; bytes-task-byte-count. Closes ADR 0132 deferred guest put+get mixed body.
;;
;; Capabilities: :object/put-block (15), :object/get-stream (14)

(ns app.object-product
  (:export [put-then-count])
  (:capabilities #{:object/get-stream :object/put-block}))

(defn put-then-count
  [put-req [:record :kotoba.object/put-block-request
            [[:binding :keyword] [:digest :string] [:bytes :bytes]]]
   get-req [:record :kotoba.object/get-stream-request
            [[:binding :keyword] [:key :string]]]]
  :i64
  (let [ok (typed-cap-call :object/put-block
                           [:record :kotoba.object/put-block-request
                            [[:binding :keyword] [:digest :string] [:bytes :bytes]]]
                           :bool
                           put-req)
        task (typed-cap-call :object/get-stream
                             [:record :kotoba.object/get-stream-request
                              [[:binding :keyword] [:key :string]]]
                             [:task [:stream :bytes]]
                             get-req)]
    (bytes-task-byte-count task)))
