/postalloc-scheduling-baseline/
/bench/evidence/
/.cpcache/
/.clj-kondo/.cache/
/target/
/node_modules/
# ...and node_modules as a SYMLINK, which the trailing slash above does not
# match. That is how one got committed on 2026-09-06 (25591e0a): it pointed at
# its own absolute path, so `npx --no-install nbb` -- bin/kotoba's shebang --
# died with ELOOP in any checkout at that path and the CLI would not start.
/node_modules
/test-results/
/playwright-report/
/.tools/
*.kexe
*.kexe.provenance.edn
*.kexe.publication.edn
*.wasm
# Golden fixtures for test/nbb/run.cljs are checked in on purpose (the
# nbb-native wasm32 path's byte-identical cross-check against the JVM
# path needs them committed, not regenerated on every clone).
!test/nbb/golden/*.wasm
test/nbb/golden/*.wasm.provenance.edn

# Bench/falsify tick scratch under docs/. docs/ is a prose directory: it tracks
# 325 .md and 60 .edn and zero files of any extension below.
/docs/*.py
/docs/*.sh
/docs/*.txt
/docs/*.log
/docs/*.status
/docs/*.size
/docs/*.bak*
