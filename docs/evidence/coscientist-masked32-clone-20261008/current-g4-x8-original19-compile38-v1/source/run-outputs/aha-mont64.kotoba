(ns embench.mont64-full (:export [bench observe bounds-probe]))
;; Original complete mont64 body; verification once after repetition.
;; SPDX-License-Identifier: GPL-3.0-or-later; Embecosm/Bristol 2013-2019.
(defn- u-lt [a :i64 b :i64] :bool (< (bit-xor a -9223372036854775808) (bit-xor b -9223372036854775808)))
(defn- u-ge [a :i64 b :i64] :bool (not (u-lt a b)))
(defn- mulul64 [u :i64 v :i64] :vector-i64 (let [u0 (bit-and u 4294967295) u1 (u64-shift-right u 32) v0 (bit-and v 4294967295) v1 (u64-shift-right v 32) t0 (* u0 v0) w0 (bit-and t0 4294967295) k0 (u64-shift-right t0 32) t1 (+ (* u1 v0) k0) w1 (bit-and t1 4294967295) w2 (u64-shift-right t1 32) t2 (+ (* u0 v1) w1) k1 (u64-shift-right t2 32) lo (+ (i64-shift-left t2 32) w0) hi (+ (+ (* u1 v1) w2) k1)] [hi lo]))
(defn- modul64 [high :i64 low :i64 divisor :i64] :i64 (loop [i 0 x high y low] (if (= i 64) x (let [sign (i64-shift-right x 63) next-x (bit-or (i64-shift-left x 1) (u64-shift-right y 63)) next-y (i64-shift-left y 1)] (if (u-ge (bit-or next-x sign) divisor) (recur (+ i 1) (- next-x divisor) (+ next-y 1)) (recur (+ i 1) next-x next-y))))))
(defn- xbin-gcd [half-r :i64 m :i64] :vector-i64 (loop [a half-r u 1 v 0] (if (= a 0) [u v] (let [next-a (u64-shift-right a 1)] (if (= (bit-and u 1) 0) (recur next-a (u64-shift-right u 1) (u64-shift-right v 1)) (recur next-a (+ (u64-shift-right (bit-xor u m) 1) (bit-and u m)) (+ (u64-shift-right v 1) half-r)))))))
(defn- montmul [abar :i64 bbar :i64 m :i64 mprime :i64] :i64 (let [t (mulul64 abar bbar) thi (vector-at t 0) tlo (vector-at t 1) tm (* tlo mprime) tmm (mulul64 tm m) tmmhi (vector-at tmm 0) tmmlo (vector-at tmm 1) ulo (+ tlo tmmlo) carried (u-lt ulo tlo) uhi (if carried (+ (+ thi tmmhi) 1) (+ thi tmmhi)) overflow (or (u-lt uhi thi) (and (= uhi thi) carried))] (if (or overflow (u-ge uhi m)) (- uhi m) uhi)))
(defn- simple-result [a :i64 b :i64 m :i64] :i64 (let [p0 (mulul64 a b) q0 (modul64 (vector-at p0 0) (vector-at p0 1) m) p1 (mulul64 q0 q0) q1 (modul64 (vector-at p1 0) (vector-at p1 1) m) p2 (mulul64 q1 q1)] (modul64 (vector-at p2 0) (vector-at p2 1) m)))
(defn- montgomery-result [a :i64 b :i64 m :i64] :vector-i64 (let [hr -9223372036854775808 inverse (xbin-gcd hr m) rinv (vector-at inverse 0) mprime (vector-at inverse 1) inverse-check (= (- (* 2 (* hr rinv)) (* m mprime)) 1) abar (modul64 a 0 m) bbar (modul64 b 0 m) p0 (montmul abar bbar m mprime) p1 (montmul p0 p0 m mprime) p2 (montmul p1 p1 m mprime) product (mulul64 p2 rinv) p (modul64 (vector-at product 0) (vector-at product 1) m)] [p (if inverse-check 1 0)]))
(defn- body-state [] :vector-i64 (let [a 380896260630216687 b 1473642379452024179 m -366962936819156833 reference (simple-result a b m) result (montgomery-result a b m) actual (vector-at result 0) inverse-check (vector-at result 1) errors (if (and (= actual reference) (= inverse-check 1)) 0 1)] [reference actual inverse-check errors]))
(defn- repeated [n :i64] :vector-i64 (loop [i 0 last [0 0 0 0]] (if (= i n) last (recur (+ i 1) (body-state)))))
(defn bench [n :i64] :i64 (if (= n 0) 0 (if (= (vector-at (repeated n) 3) 0) 1 0)))
(defn observe [encoded :i64] :i64 (let [n (quot encoded 4) field (rem encoded 4)] (vector-at (repeated n) field)))
(defn bounds-probe [i :i64] :i64 (vector-at [0 0 0 0] i))
