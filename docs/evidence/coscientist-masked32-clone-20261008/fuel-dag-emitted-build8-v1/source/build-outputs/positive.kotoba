(ns fuel.dag.emitted.positive (:export [bench]))
(defn- mask [x :i64] :i64 (bit-and x 4294967295))
(defn- mix [a :i64 b :i64] :i64 (mask (bit-xor (i64-shift-left a 1) b)))
;; A second STATIC mask reference satisfies the unchanged original specializer;
;; this helper is never on the dynamic bench path.
(defn- extra [x :i64] :i64 (mask x))
(defn bench [n :i64] :i64 (+ (mix n 7) n))
