;; the class of name node n for the fuel analysis: 1 plain GMIR arithmetic / control (if do min max ..), 3 vector-count,
;; 4 vector-at, 5 vector-get, 6 vector-new, 7 string-code-point-at, 8 record-new, 9 record-get, 10 record-assoc,
;; 11 typed-cap-call / cap-call, 15 =, 16 let, 20 :record, 21 :ref, 22 :string, 23 :keyword; 0 anything else
(defn- kr-fop [M :vector-i64 S :string n :i64] :i64
  (let [k (kr-kind M n)
        t (kr-nf M n NF-TOK)
        a (kr-tf M t TF-START)
        b (kr-tf M t TF-END)]
    (if (= (* (kr-ne n 0) (kr-is-name k)) 1) (kr-fop2 (- b a) (mem-hash-str S a b)) 0)))

;; ==== BEGIN EXPORT (agent EXPORT, 2026-10-04) =======================================================================
;; Every KIR :exports entry is exported or the compile is refused by name (INT/INT2's F1 requests: compile-kir used to drop
;; KIR exports silently). An export the source route's rule admits (kr-exportable: all params :i64, result :i64/:bool, not a
;; KIR-generated __kotoba_* name) stays in the (:export ..) clause. Every other export that names a KIR function is a LATE
;; export (word kr-f-lx = 1, defn mark kr-mk-export; 30-lower sets FF-EXPORT after 21-check), whatever its types:
;; lambdas, invoke helpers, record constructors, :bool / :string / record / list parameters, string / keyword / option /
;; record results. A loop helper that is exported is emitted as its own defn and called (kr-call, kr-defs), not inlined, as
;; machine_ir compiles it (a function with a self tail call). Refused (E1203 'name' = the export): an export naming no KIR
;; function, and a signature whose values the seed represents differently from stage-0 (the boundary would see another
;; value): :document, :set, :map anywhere in a parameter or result type; :option, :result in a parameter type.
(defn- kr-xbad2 [len :i64 h :i64 par :i64] :i64
  (cond (= h 6703248742119087212) (kr-len-ok len 9 1)      ; :document
        (= h 3905574490823568763) (kr-len-ok len 4 1)      ; :set
        (= h 3562493875126441273) (kr-len-ok len 4 1)      ; :map
        (= h 3580979277550285308) (kr-len-ok len 7 par)    ; :option
        (= h 4952616781120422236) (kr-len-ok len 7 par)    ; :result
        :else 0))

;; 1 when type node n (a keyword or a vector of types) mentions a refused keyword (par = 1: parameter rules)
(defn- kr-xbad [M :vector-i64 S :string n :i64 par :i64] :i64
  (let [k (kr-kind M n)
        t (kr-nf M n NF-TOK)
        a (kr-tf M t TF-START)
        b (kr-tf M t TF-END)]
    (cond (= n 0) 0
          (= k ND-KW) (kr-xbad2 (- b a) (mem-hash-str S a b) par)
          (= k ND-VEC) (kr-xbad-items M S (kr-first M n) par)
          :else 0)))

(defn- kr-xbad-items [M :vector-i64 S :string c :i64 par :i64] :i64
  (cond (= c 0) 0
        (= (kr-xbad M S c par) 1) 1
        :else (kr-xbad-items M S (kr-next M c) par)))

(defn- kr-lx2 [M :vector-i64 S :string c :i64 r :i64] :vector-i64
  (let [rs (vector-at M (+ r kr-f-result))
        pt (vector-at M (+ r kr-f-ptypes))
        bad (bit-or (kr-xbad M S rs 0) (if (= pt 0) 0 (kr-xbad M S pt 1)))]
    (if (= bad 1) (kr-fail M kr-e-value c) (kr-put M (+ r kr-f-lx) 1))))

;; export name node c: refused, late (marked), or left to the (:export ..) clause
(defn- kr-lx [M :vector-i64 S :string c :i64] :vector-i64
  (let [r (kr-find M S c)]
    (cond (= r 0) (kr-fail M kr-e-value c)
          (= (kr-exportable2 M S r) 1) (kr-id M)
          :else (kr-lx2 M S c r))))
;; ==== END EXPORT ====================================================================================================

;; ---- arena-scope -------------------------------------------------------------------------------------------------
;; (arena-scope e) -> (let [__kr_a (__kr_arena_enter) __kr_b e] (let [__kr_a (__kr_arena_leave)] __kr_b)): enter, e, leave,
;; e's value (machine_ir: runtime arena-enter, the body in value position, runtime arena-leave)
(defn- kr-arena [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (let [h (kr-first M n)
        e (kr-next M h)]
    (if (= (kr-count M n) 2)
      (kr-arena2 (kr-alloc (kr-walk M S e cur) 13) n e)
      (kr-fail M kr-e-value h))))

(defn- kr-arena2 [M :vector-i64 n :i64 e :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [q (vector-at M MM-R0)
          pb (vector-at M kr-c-pb)
          te (kr-lib-tok M (+ kr-fixb 12))
          tl (kr-lib-tok M (+ kr-fixb 13))
          M1 (kr-sym-node M q (+ pb 15) (+ q 1))
          M2 (kr-nset (kr-nset (kr-node M1 (+ q 1) ND-VEC (+ pb 15) 4) (+ q 1) NF-FIRST (+ q 2)) (+ q 1) NF-NEXT (+ q 6))
          M3 (kr-sym-node M2 (+ q 2) (+ pb 19) (+ q 3))
          M4 (kr-nset (kr-nset (kr-node M3 (+ q 3) ND-LIST te 1) (+ q 3) NF-FIRST (+ q 4)) (+ q 3) NF-NEXT (+ q 5))
          M5 (kr-sym-node M4 (+ q 4) te 0)
          M6 (kr-nset (kr-sym-node M5 (+ q 5) (+ pb 20) e) e NF-NEXT 0)
          M7 (kr-nset (kr-node M6 (+ q 6) ND-LIST (+ pb 15) 3) (+ q 6) NF-FIRST (+ q 7))
          M8 (kr-sym-node M7 (+ q 7) (+ pb 15) (+ q 8))
          M9 (kr-nset (kr-nset (kr-node M8 (+ q 8) ND-VEC (+ pb 15) 2) (+ q 8) NF-FIRST (+ q 9)) (+ q 8) NF-NEXT (+ q 12))
          M10 (kr-sym-node M9 (+ q 9) (+ pb 19) (+ q 10))
          M11 (kr-nset (kr-node M10 (+ q 10) ND-LIST tl 1) (+ q 10) NF-FIRST (+ q 11))
          M12 (kr-sym-node M11 (+ q 11) tl 0)
          M13 (kr-sym-node M12 (+ q 12) (+ pb 20) 0)
          M14 (kr-nset (kr-nset M13 n NF-FIRST q) n NF-AUX 3)
          tab (vector-at M14 kr-c-tab)]
      (kr-put M14 (+ tab 3) (bit-or (vector-at M14 (+ tab 3)) (bit-or (kr-fix-bits 12) (kr-fix-bits 13)))))))

;; ---- the fuel analysis -------------------------------------------------------------------------------------------
(defn- kr-acc1 [M :vector-i64] :vector-i64 (kr-tset M kr-t-acc 1))
(defn- kr-rb? [M :vector-i64] :bool (= (kr-tw M kr-t-rb) 1))
(defn- kr-le [a :i64 b :i64] :i64 (if (<= a b) 1 0))

;; the environment stack: entry i = (name node, flags 1 region / 2 keyword-typed / 4 barrier for regions)
(defn- kr-env-push [M :vector-i64 sp :i64 name :i64 flags :i64] :vector-i64
  (if (< sp kr-envcap)
    (let [e (+ (kr-tw M kr-t-env) (* 2 sp))]
      (kr-put (kr-put M e name) (+ e 1) flags))
    (kr-id M)))

;; the flags of the innermost binding of symbol s below sp (0 none); reg = 1: a barrier ends the search (vector-region
;; rewrites an index / fallback / item with no region in scope)
(defn- kr-env-find [M :vector-i64 S :string sp :i64 s :i64 reg :i64] :i64
  (let [env (kr-tw M kr-t-env)]
    (loop [i (- (if (< sp kr-envcap) sp kr-envcap) 1)]
      (if (< i 0)
        0
        (let [nm (vector-at M (+ env (* 2 i)))
              fl (vector-at M (+ (+ env (* 2 i)) 1))]
          (cond (= nm 0) (if (= reg 1) 0 (recur (- i 1)))
                (= (kr-same M S nm s) 1) fl
                :else (recur (- i 1))))))))

(defn- kr-last [M :vector-i64 c :i64] :i64
  (loop [x c] (if (= (kr-next M x) 0) x (recur (kr-next M x)))))

;; keyword-typed by kotoba-native keyword_equality.cljk: a keyword literal; a name bound to one (params by :param-types,
;; let names in order); record-get of a field typed :keyword; an if both of whose arms are; a let's / do's value; a call of
;; a program function whose :result is :keyword. (A let operand's own bindings are seen only when its body is one of them.)
(defn- kr-kwt [M :vector-i64 S :string x :i64 sp :i64] :i64
  (let [k (kr-kind M x)]
    (cond (= x 0) 0
          (= k ND-KW) 1
          (= k ND-SYM) (if (= (bit-and (kr-env-find M S sp x 0) 2) 0) 0 1)
          (= k ND-LIST) (kr-kwt-list M S x sp)
          :else 0)))

(defn- kr-kwt-list [M :vector-i64 S :string x :i64 sp :i64] :i64
  (let [h (kr-first M x)
        a (kr-next M h)
        hc (kr-code M S h)
        fc (kr-fop M S h)
        r (if (= (kr-kind M h) ND-SYM) (kr-find M S h) 0)]
    (cond (= a 0) 0
          (= hc 101) (kr-rg-kw M S a)
          (= hc 22) (if (= (kr-kwt M S (kr-next M a) sp) 1) (kr-kwt M S (kr-next M (kr-next M a)) sp) 0)
          (= fc 16) (kr-kwt-let M S (kr-first M a) (kr-next M a) sp)
          (= (* (kr-eq fc 1) (kr-eq (kr-code M S h) 0)) 1) (if (= (kr-kwt-do M S h) 1) (kr-kwt M S (kr-last M a) sp) 0)
          (> r 0) (kr-is-kwtype M S (vector-at M (+ r kr-f-result)))
          :else 0)))

;; 1 when head h is spelled `do` (a class-1 head without a kr-code-of code; checked by its span)
(defn- kr-kwt-do [M :vector-i64 S :string h :i64] :i64
  (let [t (kr-nf M h NF-TOK)
        a (kr-tf M t TF-START)
        b (kr-tf M t TF-END)]
    (if (= (- b a) 2) (* (kr-eq (lx-ch S a) 100) (kr-eq (lx-ch S (+ a 1)) 111)) 0)))

;; a let operand: its body; a body that is one of the let's own names takes that binding's value
(defn- kr-kwt-let [M :vector-i64 S :string b :i64 body :i64 sp :i64] :i64
  (if (= (kr-kind M body) ND-SYM)
    (let [v (kr-kwt-bound M S b body 0)]
      (if (= v 0) (kr-kwt M S body sp) (kr-kwt M S v sp)))
    (kr-kwt M S body sp)))

;; the value node of the LAST binding of name s in binding chain b, 0 when none
(defn- kr-kwt-bound [M :vector-i64 S :string b :i64 s :i64 acc :i64] :i64
  (cond (= b 0) acc
        (= (* (kr-eq (kr-kind M b) ND-SYM) (kr-same M S b s)) 1) (kr-kwt-bound M S (kr-next M (kr-next M b)) s (kr-next M b))
        :else (kr-kwt-bound M S (kr-next M (kr-next M b)) s acc)))

;; ---- vector-region's analysis (kotoba-native vector_region.cljk, the JVM twin stage-0 runs) ------------------------
;; a constructor with at most 32 items
(defn- kr-ctor? [M :vector-i64 S :string v :i64] :i64
  (if (= (* (kr-ne v 0) (kr-eq (kr-kind M v) ND-LIST)) 1)
    (* (kr-eq (kr-fop M S (kr-first M v)) 6) (kr-le (- (kr-count M v) 1) 32))
    0))

;; safe-uses?: every use of name t in f is a count, or the subject of an at/get whose other operands are safe
(defn- kr-safe [M :vector-i64 S :string f :i64 t :i64] :i64
  (let [k (kr-kind M f)]
    (cond (= f 0) 1
          (= k ND-SYM) (if (= (kr-same M S f t) 1) 0 1)
          (= k ND-LIST) (kr-safe-seq M S f t)
          (= k ND-VEC) (kr-safe-all M S (kr-first M f) t)
          :else 1)))

(defn- kr-safe-all [M :vector-i64 S :string c :i64 t :i64] :i64
  (cond (= c 0) 1
        (= (kr-safe M S c t) 0) 0
        :else (kr-safe-all M S (kr-next M c) t)))

;; the values (odd positions) of binding chain b
(defn- kr-safe-vals [M :vector-i64 S :string b :i64 t :i64] :i64
  (cond (= b 0) 1
        (= (kr-safe M S (kr-next M b) t) 0) 0
        :else (kr-safe-vals M S (kr-next M (kr-next M b)) t)))

;; 1 when a binder of chain b is spelled like t
(defn- kr-bound? [M :vector-i64 S :string b :i64 t :i64] :i64
  (cond (= b 0) 0
        (= (* (kr-eq (kr-kind M b) ND-SYM) (kr-same M S b t)) 1) 1
        :else (kr-bound? M S (kr-next M (kr-next M b)) t)))

(defn- kr-safe-seq [M :vector-i64 S :string f :i64 t :i64] :i64
  (let [h (kr-first M f)
        a0 (kr-next M h)
        argc (- (kr-count M f) 1)
        fc (kr-fop M S h)
        s0 (if (= (kr-kind M a0) ND-SYM) (kr-same M S a0 t) 0)]
    (cond (= (* (kr-eq fc 3) (* (kr-eq argc 1) s0)) 1) 1
          (= (* (+ (kr-eq fc 4) (kr-eq fc 5)) (* s0 (* (kr-le 2 argc) (kr-le argc 3)))) 1) (kr-safe-all M S (kr-next M a0) t)
          (= fc 16) (if (= (kr-kind M a0) ND-VEC)
                      (* (kr-safe-vals M S (kr-first M a0) t)
                         (if (= (kr-bound? M S (kr-first M a0) t) 1) 1 (kr-safe-all M S (kr-next M a0) t)))
                      0)
          :else (kr-safe-all M S h t))))

;; the later bindings' values (from binder w on) and the body are safe uses of t
(defn- kr-rest-safe [M :vector-i64 S :string w :i64 body :i64 t :i64] :i64
  (cond (= w 0) (kr-safe M S body t)
        (= (kr-safe M S (kr-next M w) t) 0) 0
        :else (kr-rest-safe M S (kr-next M (kr-next M w)) body t)))

;; ---- the walk: table word 9 := 1 when node n (under the environment below sp) lowers to a call / runtime call ------
(defn- kr-fz [M :vector-i64 S :string n :i64 sp :i64] :vector-i64
  (let [k (kr-kind M n)]
    (cond (= n 0) (kr-id M)
          (= k ND-LIST) (kr-fz-list M S n sp)
          (= k ND-STR) (kr-acc1 M)
          (= k ND-KW) (kr-acc1 M)
          :else (kr-id M))))

(defn- kr-fz-items [M :vector-i64 S :string c :i64 sp :i64] :vector-i64
  (cond (= c 0) (kr-id M)
        :else (let [nx (kr-next M c)] (kr-fz-items (kr-fz M S c sp) S nx sp))))

;; (string-code-point-at "ascii" i): a literal walk, no runtime call
(defn- kr-lwalk? [M :vector-i64 n :i64 a :i64] :i64
  (if (= (* (kr-eq (kr-count M n) 3) (kr-eq (kr-kind M a) ND-STR)) 1)
    (let [lr (+ MM-LIT-BASE (* (kr-nf M a NF-AUX) MM-LIT-W))
          b (vector-at M (+ lr LF-B))
          len (vector-at M (+ lr LF-LEN))]
      (loop [i 0]
        (cond (>= i len) 1
              (> (vector-at M (+ (+ MM-LITB-BASE b) i)) 127) 0
              :else (recur (+ i 1)))))
    0))

(defn- kr-fz-list [M :vector-i64 S :string n :i64 sp :i64] :vector-i64
  (let [h (kr-first M n)
        a (kr-next M h)
        fc (kr-fop M S h)]
    (cond (= fc 16) (if (= (kr-kind M a) ND-VEC) (kr-fz-let M S (kr-first M a) (kr-next M a) sp) (kr-acc1 M))
          (= fc 1) (kr-fz-items M S a sp)
          ;; keyword_equality: the `=` becomes string=? (a runtime call); the mark tells kr-eqkw to respell it
          (= fc 15) (if (= (* (kr-eq (kr-count M n) 3) (bit-or (kr-kwt M S a sp) (kr-kwt M S (kr-next M a) sp))) 1)
                      (kr-fz-items (kr-mk-or (kr-acc1 M) n kr-mk-kweq) S a sp)
                      (kr-fz-items M S a sp))
          (= (* (kr-le 3 fc) (kr-le fc 5)) 1) (kr-fz-read M S a fc sp)
          (= (* (kr-eq fc 7) (kr-lwalk? M n a)) 1) (kr-fz M S (kr-next M a) sp)
          (= (* (kr-eq fc 8) (if (kr-rb? M) 0 1)) 1) (kr-fz-items M S (kr-next M a) sp)
          (= (* (kr-eq fc 9) (if (kr-rb? M) 0 1)) 1) (kr-fz M S (kr-next M a) sp)
          (= (* (kr-eq fc 10) (if (kr-rb? M) 0 1)) 1) (kr-fz (kr-fz M S (kr-next M a) sp) S (kr-next M (kr-next M (kr-next M a))) sp)
          ;; everything else is a call or a runtime / capability call; its operands are walked for the `=` marks
          :else (kr-fz-items (kr-acc1 M) S a sp))))

;; count / at / get: of a region name (count: a constant; at, get: the index and fallback, no region in scope), of a
;; literal constructor (its items, index and fallback, no region in scope), else the runtime operation
(defn- kr-fz-read [M :vector-i64 S :string a :i64 fc :i64 sp :i64] :vector-i64
  (cond (= (* (kr-eq (kr-kind M a) ND-SYM) (bit-and (kr-env-find M S sp a 1) 1)) 1)
        (if (= fc 3) (kr-id M) (kr-fz-items (kr-env-push M sp 0 4) S (kr-next M a) (+ sp 1)))
        (= (kr-ctor? M S a) 1)
        (let [M1 (kr-env-push M sp 0 4)]
          (kr-fz-items (kr-fz-items M1 S (kr-next M (kr-first M a)) (+ sp 1)) S (kr-next M a) (+ sp 1)))
        :else (kr-fz-items (kr-acc1 M) S a sp)))

;; a let's bindings from binder b, then its body: a region binding (a name bound to a constructor every later use of which
;; is safe) costs its items only and is pushed as a region; any other binding is walked and pushed with its keyword flag
(defn- kr-fz-let [M :vector-i64 S :string b :i64 body :i64 sp :i64] :vector-i64
  (cond (= b 0) (kr-fz M S body sp)
        :else
        (let [v (kr-next M b)
              w (if (= v 0) 0 (kr-next M v))
              reg (if (= (* (kr-eq (kr-kind M b) ND-SYM) (kr-ctor? M S v)) 1) (kr-rest-safe M S w body b) 0)
              kw (kr-kwt M S v sp)]
          (if (= reg 1)
            (kr-fz-let (kr-env-push (kr-fz-items M S (kr-next M (kr-first M v)) sp) sp b 1) S w body (+ sp 1))
            (kr-fz-let (kr-env-push (kr-fz M S v sp) sp b (* 2 kw)) S w body (+ sp 1))))))

;; the parameters (chain p) with their :param-types (chain t, 0 = all :i64) at the bottom of the environment
(defn- kr-env-params [M :vector-i64 S :string p :i64 t :i64 sp :i64] :vector-i64
  (if (= p 0)
    (kr-id M)
    (kr-env-params (kr-env-push M sp p (* 2 (kr-is-kwtype M S t))) S (kr-next M p) (if (= t 0) 0 (kr-next M t)) (+ sp 1))))

(defn- kr-fuel-fn [M :vector-i64 S :string r :i64] :vector-i64
  (let [ps (vector-at M (+ r kr-f-params))
        pt (vector-at M (+ r kr-f-ptypes))
        bd (vector-at M (+ r kr-f-body))
        np (kr-count M ps)
        M1 (kr-env-params (kr-tset M kr-t-acc 0) S (kr-first M ps) (if (= pt 0) 0 (kr-first M pt)) 0)
        M2 (kr-fz M1 S bd np)]
    (kr-put M2 (+ r kr-f-re) (kr-tw M2 kr-t-acc))))

(defn- kr-fuel-fns [M :vector-i64 S :string i :i64] :vector-i64
  (let [tab (vector-at M kr-c-tab)
        n (vector-at M tab)]
    (if (>= i n) (kr-id M) (kr-fuel-fns (kr-fuel-fn M S (+ (+ tab kr-th) (* i kr-w))) S (+ i 1)))))

;; machine_ir's record boundary: a parameter / result typed [:record ..] or [:ref ..], or a record type nested in a field
(defn- kr-rb-ty [M :vector-i64 S :string t :i64] :i64
  (if (= (kr-kind M t) ND-VEC)
    (let [c (kr-fop M S (kr-first M t))] (bit-or (kr-eq c 20) (kr-eq c 21)))
    0))

(defn- kr-rb-tys [M :vector-i64 S :string c :i64] :i64
  (cond (= c 0) 0 (= (kr-rb-ty M S c) 1) 1 :else (kr-rb-tys M S (kr-next M c))))

(defn- kr-rb-fns [M :vector-i64 S :string r :i64 end :i64] :i64
  (cond (>= r end) 0
        (= (kr-rb-ty M S (vector-at M (+ r kr-f-result))) 1) 1
        (= (kr-rb-tys M S (let [pt (vector-at M (+ r kr-f-ptypes))] (if (= pt 0) 0 (kr-first M pt)))) 1) 1
        :else (kr-rb-fns M S (+ r kr-w) end)))

;; [:record kw [[f T] ..]] with some T itself a [:record ..] vector
(defn- kr-rb-nested [M :vector-i64 S :string v :i64] :i64
  (let [h (kr-first M v)
        fs (kr-next M (kr-next M h))]
    (if (= (* (kr-eq (kr-fop M S h) 20) (kr-eq (kr-kind M fs) ND-VEC)) 1)
      (loop [c (kr-first M fs)]
        (cond (= c 0) 0
              (= (* (kr-eq (kr-kind M c) ND-VEC) (kr-rb-rec M S (kr-next M (kr-first M c)))) 1) 1
              :else (recur (kr-next M c))))
      0)))

(defn- kr-rb-rec [M :vector-i64 S :string t :i64] :i64
  (if (= (kr-kind M t) ND-VEC) (kr-eq (kr-fop M S (kr-first M t)) 20) 0))

;; every vector node of the KIR document (its nodes are the indices between the document node and the prelude's first)
(defn- kr-rb-scan [M :vector-i64 S :string] :i64
  (let [tab (vector-at M kr-c-tab)
        n (vector-at M tab)
        doc (kr-first M (vector-at M MM-ROOT))
        end (kr-next M doc)]
    (if (= (kr-rb-fns M S (+ tab kr-th) (+ (+ tab kr-th) (* n kr-w))) 1)
      1
      (loop [x (+ doc 1)]
        (cond (>= x end) 0
              (= (* (kr-eq (kr-kind M x) ND-VEC) (kr-rb-nested M S x)) 1) 1
              :else (recur (+ x 1)))))))

(defn- kr-fuel2 [M :vector-i64 S :string met :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [b (vector-at M MM-R0)
          M1 (kr-tset (kr-tset (kr-tset M kr-t-mk b) kr-t-env (+ b MM-NODE-CAP)) kr-t-met met)]
      (kr-fuel-fns (kr-tset M1 kr-t-rb (kr-rb-scan M1 S)) S 0))))

(defn- kr-fuel [M :vector-i64 S :string met :i64] :vector-i64
  (if (kr-failed M) (kr-id M) (kr-fuel2 (mem-alloc M (+ MM-NODE-CAP (* 2 kr-envcap))) S met)))

;; --metered (a build whose artifact declares fuel): what compile-kir cannot charge exactly as machine_ir is refused by name
;; (E1203) so the selector falls back to machine_ir: the document operations (the seed's doclib is not stage-0's helper code)
(defn- kr-met? [M :vector-i64] :bool (= (kr-tw M kr-t-met) 1))

;; seed/20-names.kotoba -- symbols, the FN table and the local scope stack of the seed compiler (prefix nm-).
;; Owner: 20-names. Contract: seed/MEMORY-MAP (SYM HASH FN SCOPE regions, NF-SYM), seed/HEADS (:spellings,
;; :keywords, E20nn). Design section 2.1, module 20.
;;
;; Interface (all defn-, M first; writers return M and leave their i64 result in M[MM-R0], rule L4):
;;   accessors (readers)  nm-nf M node field   nm-tf M tok field   nm-sf M sym field   nm-ff M fn field
;;                        nm-nth M node k (k-th child, 0-based, or 0)   nm-count M node (children)
;;                        nm-sym-of M node (NF-SYM)  nm-head-of M node (SF-HEAD of the node's symbol, 0 if none)
;;   setters (writers)    nm-set-nf M node field v   nm-set-ff M fn field v
;;   errors               nm-err M code tok n -> M (first error wins, rule L10; pos/{name} = the token's span)
;;                        nm-err-node M code node n
;;   interning            nm-hash S a b (FNV-1a 64)   nm-intern M S a b -> M, R0 = symbol id
;;   whole pass           nm-run M S -> M : interns every ND-SYM/ND-KW node (NF-SYM), builds FN from the
;;                        top-level def/defn/defn- forms, validates the ns form and its export list.
;;   scope API            nm-bind M sym slot type -> M   nm-unbind M height -> M   nm-scope-height M
;;                        nm-local-slot M sym (-1 when unbound)   nm-local-type M sym
;;                        nm-bound-since M sym height (1 when sym was bound at scope height >= height, else 0)
;;   SF-BIND encoding (private to this API): 0 = unbound, else (slot + 1) + type * RES-SCALE.

;; ---------------------------------------------------------------------------------------------------------
;; accessors
;; ---------------------------------------------------------------------------------------------------------
(defn- nm-na [n :i64 f :i64] :i64 (+ (+ MM-NODE-BASE (* n MM-NODE-W)) f))
(defn- nm-sa [s :i64 f :i64] :i64 (+ (+ MM-SYM-BASE (* s MM-SYM-W)) f))
(defn- nm-fa [fi :i64 f :i64] :i64 (+ (+ MM-FN-BASE (* fi MM-FN-W)) f))
(defn- nm-ta [t :i64 f :i64] :i64 (+ (+ MM-TOK-BASE (* t MM-TOK-W)) f))

(defn- nm-nf [M :vector-i64 n :i64 f :i64] :i64 (vector-at M (nm-na n f)))
(defn- nm-sf [M :vector-i64 s :i64 f :i64] :i64 (vector-at M (nm-sa s f)))
(defn- nm-ff [M :vector-i64 fi :i64 f :i64] :i64 (vector-at M (nm-fa fi f)))
(defn- nm-tf [M :vector-i64 t :i64 f :i64] :i64 (vector-at M (nm-ta t f)))

;; every write goes through a parameter handle (stage-0 refuses vector-assoc! on a handle returned by a call)
;; Stage-0 linearity shapes (probed 2026-10-02, seed/CONTRACT-REQUESTS.md): a function that vector-assoc!es its
;; handle reads it only with vector-at (never through a user function); a writer never returns its handle bare
;; (the result would alias the argument and the next writer in the chain is refused) -- it returns nm-touch
;; instead, a write of this module's MM-STAT slot; a handle appears once in the arguments of a writer call.
(defn- nm-put [M :vector-i64 i :i64 v :i64] :vector-i64 (vector-assoc! M i v))
(defn- nm-touch [M :vector-i64] :vector-i64 (vector-assoc! M (+ MM-STAT-BASE 20) 0))
(defn- nm-set-nf [M :vector-i64 n :i64 f :i64 v :i64] :vector-i64 (vector-assoc! M (nm-na n f) v))
(defn- nm-set-ff [M :vector-i64 fi :i64 f :i64 v :i64] :vector-i64 (vector-assoc! M (nm-fa fi f) v))
(defn- nm-set-sf [M :vector-i64 s :i64 f :i64 v :i64] :vector-i64 (vector-assoc! M (nm-sa s f) v))

(defn- nm-kind [M :vector-i64 n :i64] :i64 (nm-nf M n NF-KIND))
(defn- nm-first [M :vector-i64 n :i64] :i64 (nm-nf M n NF-FIRST))
(defn- nm-next [M :vector-i64 n :i64] :i64 (nm-nf M n NF-NEXT))

(defn- nm-nth [M :vector-i64 n :i64 k :i64] :i64
  (loop [c (nm-first M n) i 0]
    (cond (= c 0) 0
          (= i k) c
          :else (recur (nm-next M c) (+ i 1)))))

(defn- nm-count [M :vector-i64 n :i64] :i64
  (loop [c (nm-first M n) i 0]
    (if (= c 0) i (recur (nm-next M c) (+ i 1)))))

;; i64 flag 1/0 for a = b (R0 code multiplied such flags; R1 code uses and/or) and its :bool negation
(defn- nm-eqi [a :i64 b :i64] :i64 (if (= a b) 1 0))
(defn- nm-ne [a :i64 b :i64] :bool (not= a b))

(defn- nm-sym-of [M :vector-i64 n :i64] :i64 (nm-nf M n NF-SYM))

;; 1 when node kind k carries a symbol (ND-SYM or ND-KW)
(defn- nm-is-name [k :i64] :bool (case k (ND-SYM ND-KW) true false))

;; SF-HEAD of the node's symbol: a head code for ND-SYM, a KW-* code for ND-KW, 0 otherwise.
(defn- nm-head-of [M :vector-i64 n :i64] :i64
  (let [k (nm-kind M n)]
    (if (nm-is-name k)
      (nm-sf M (nm-sym-of M n) SF-HEAD)
      0)))

;; ---------------------------------------------------------------------------------------------------------
;; errors (rule L10)
;; ---------------------------------------------------------------------------------------------------------
(defn- nm-max0 [a :i64] :i64 (if (< a 0) 0 a))

;; record error code with position a (-1 = none), {name} span [a, b) and {n}
(defn- nm-err-span [M :vector-i64 code :i64 a :i64 b :i64 n :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [M1 (vector-assoc! M MM-ERR code)
          M2 (vector-assoc! M1 MM-ERR-POS a)
          M3 (vector-assoc! M2 MM-ERR-A (nm-max0 a))
          M4 (vector-assoc! M3 MM-ERR-B b)]
      (vector-assoc! M4 MM-ERR-N n))
    (vector-assoc! M (+ MM-STAT-BASE 20) 0)))

(defn- nm-tok-start [M :vector-i64 tok :i64] :i64 (if (> tok 0) (nm-tf M tok TF-START) -1))
(defn- nm-tok-end [M :vector-i64 tok :i64] :i64 (if (> tok 0) (nm-tf M tok TF-END) 0))

;; error naming token tok (0 = no position)
(defn- nm-err [M :vector-i64 code :i64 tok :i64 n :i64] :vector-i64
  (let [a (nm-tok-start M tok)
        b (nm-tok-end M tok)]
    (nm-err-span M code a b n)))

(defn- nm-node-tok [M :vector-i64 node :i64] :i64 (if (> node 0) (nm-nf M node NF-TOK) 0))

(defn- nm-err-node [M :vector-i64 code :i64 node :i64 n :i64] :vector-i64
  (let [tok (nm-node-tok M node)]
    (nm-err M code tok n)))

(defn- nm-failed [M :vector-i64] :bool (nm-ne (vector-at M MM-ERR) 0))

;; ---------------------------------------------------------------------------------------------------------
;; hashing and spelling recognition
;; ---------------------------------------------------------------------------------------------------------
;; FNV-1a 64 over the bytes S[a..b). Offset basis 14695981039346656037 written as its i64 value.
(defn- nm-hash [S :string a :i64 b :i64] :i64
  (loop [i a h -3750763034362895579]
    (if (< i b)
      (recur (+ i 1) (* (bit-xor h (string-code-point-at S i)) 1099511628211))
      h)))

;; word j of the span packed little-endian, 8 bytes per word, zero beyond b.
(defn- nm-pack-step [S :string i :i64 b :i64 w :i64] :i64
  (if (< i b)
    (bit-or (i64-shift-left w 8) (string-code-point-at S i))
    (i64-shift-left w 8)))

(defn- nm-pack [S :string a :i64 b :i64 j :i64] :i64
  (loop [k 7 w 0]
    (if (< k 0)
      w
      (recur (- k 1) (nm-pack-step S (+ a (+ (* 8 j) k)) b w)))))

