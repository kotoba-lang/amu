  (cond (ck-r6f-dctor? M n) (nm-next M (nm-first M n))
        (and (= (nm-kind M n) ND-LIST) (= (nm-kind M (nm-first M n)) ND-SYM) (= (nm-sf M (nm-sym-of M (nm-first M n)) SF-HASH) ck-r6b-h-ex-info)
             (>= (nm-count M n) 3) (= (nm-kind M (nm-nth M n 2)) ND-MAP))
        (nm-first M (nm-nth M n 2))
        :else 0))
(defn- ck-r6f-oref? [M :vector-i64 c :i64] :bool
  (and (= (nm-kind M c) ND-SYM) (ck-r6d-opaque-ref? M c)
       (let [v (nm-nth M (nm-ff M (nm-sf M (nm-sym-of M c) SF-FN) FF-NODE) 2)] (or (= (nm-kind M v) ND-MAP) (= (nm-kind M v) ND-VEC)))))
(defn- ck-r6f-dinl? [M :vector-i64 n :i64] :bool
  (loop [c (ck-r6f-dinl-at M n)] (cond (zero? c) false (ck-r6f-oref? M c) true :else (recur (nm-next M c)))))
(defn- ck-r6f-dinl [M :vector-i64 S :string n :i64] :vector-i64
  (if (zero? (ck-r6b-sym M S "document-map"))
    (ck-err M E-CHECK-DEF (nm-first M n) 0)
    (loop [M1 M c (ck-r6f-dinl-at M n)]
      (cond (zero? c) M1
            (nm-failed M1) M1
            (ck-r6f-oref? M1 c) (let [M2 (ck-r6d-inline-def M1 c)] (recur (if (nm-failed M2) M2 (ck-r6c-lit M2 S c)) (nm-next M2 c)))
            :else (recur M1 (nm-next M1 c))))))
;; R6F: homogeneous heterogeneous-vector heads (R6D's tuple type [:vector [T T ..]] = CT (list T n), one keyword T):
;;   (hetero-vector TV a ..)    -> (__r6-as TV (typed-list-new [:list T] a ..))
;;   (hetero-vector-at TV v i)  -> (typed-list-nth [:list T] (__r6-as [:list T] v) i)
;; A tuple whose item types differ stays E2101 (no representation of a mixed tuple type yet). 1 = hetero-vector, 2 = -at.
(defn- ck-r6f-hv? [M :vector-i64 S :string n :i64] :i64
  (let [h (nm-first M n)
        tv (nm-next M h)
        v (nm-nth M tv 1)
        k (if (and (= (nm-kind M n) ND-LIST) (= (nm-kind M h) ND-SYM) (zero? (nm-sf M (nm-sym-of M h) SF-HEAD))
                   (zero? (nm-sf M (nm-sym-of M h) SF-FN)) (>= (nm-count M n) 2))
            (cond (ck-r6b-is? S (nm-tf M (nm-nf M h NF-TOK) TF-START) (nm-tf M (nm-nf M h NF-TOK) TF-END) "hetero-vector") 1
                  (and (= (nm-count M n) 4) (ck-r6b-is? S (nm-tf M (nm-nf M h NF-TOK) TF-START) (nm-tf M (nm-nf M h NF-TOK) TF-END) "hetero-vector-at")) 2
                  :else 0)
            0)]
    (if (and (pos? k) (= (nm-kind M tv) ND-VEC) (= (nm-count M tv) 2) (= (nm-kind M (nm-first M tv)) ND-KW)
             (= (nm-kind M v) ND-VEC) (pos? (nm-count M v))
             (loop [c (nm-first M v)] (cond (zero? c) true (and (= (nm-kind M c) ND-KW) (= (nm-sym-of M c) (nm-sym-of M (nm-first M v)))) (recur (nm-next M c)) :else false)))
      k
      0)))
;; a new [:list T] node, T a clone of keyword node t; R0
(defn- ck-r6f-ltype [M :vector-i64 tok :i64 t :i64] :vector-i64
  (let [M1 (ck-r6b-nkw M tok KW-LIST 235)
        kl (ck-r M1)
        M2 (ck-r5b-clone M1 t)
        tc (ck-r M2)]
    (ck-n-vec (ck-chain2 M2 kl tc) tok kl)))
(defn- ck-r6f-hv [M :vector-i64 S :string n :i64] :vector-i64
  (let [k (ck-r6f-hv? M S n)
        h (nm-first M n)
        tok (nm-nf M h NF-TOK)
        tv (nm-next M h)
        t (nm-first M (nm-nth M tv 1))
        x (nm-next M tv)
        M1 (ck-r6f-ltype M tok t)
        lt (ck-r M1)]
    (if (= k 1)
      (let [M2 (ck-r6b-nhead M1 tok HD-LIST-NEW 234)
            nh (ck-r M2)
            M3 (ck-link (ck-link M2 nh lt) lt x)
            M4 (ck-n-list M3 tok nh)
            nl (ck-r M4)
            M5 (ck-chain2 M4 tv nl)]
        (ck-rehead-at M5 n HD-R6-AS 233 tv))
      (let [i (nm-next M1 x)
            M2 (ck-r6f-ltype M1 tok t)
            lt2 (ck-r M2)
            M3 (ck-r6b-nhead M2 tok HD-R6-AS 233)
            ah (ck-r M3)
            M4 (ck-link (ck-link M3 ah lt2) lt2 x)
            M5 (ck-n-list (ck-link M4 x 0) tok ah)
            al (ck-r M5)
            M6 (ck-chain3 M5 lt al i)]
        (ck-rehead-at M6 n HD-LIST-NTH 236 lt)))))
;; n's head becomes a fresh synthetic head (code, cache slot idx) followed by the chain from first
(defn- ck-rehead-at [M :vector-i64 n :i64 code :i64 idx :i64 first :i64] :vector-i64
  (let [M1 (ck-r6b-nhead M (ck-htok M n) code idx)
        h (ck-r M1)]
    (nm-set-nf (ck-link M1 h first) n NF-FIRST h)))
;; R6F: the library's some? / nil? are :document predicates; on an [:option T] (what (get d k) answers) they are the
;; option test, the reference's generic some?: option = 0 or pair(x, 0) (seed/SIR R3), so (some? o) -> (not (= (__r6-as :i64 o) 0))
;; and (nil? o) -> (= (__r6-as :i64 o) 0). Any other argument type is the library call as before.
(defn- ck-r6f-optp? [M :vector-i64 n :i64] :bool
  (let [h (nm-first M n)
        s (nm-sym-of M h)
        hh (if (= (nm-kind M h) ND-SYM) (nm-sf M s SF-HASH) 0)]
    (and (= (nm-count M n) 2) (or (= hh 3988478846623731818) (= hh 645364649377164233))
         (< (nm-local-slot M s) 0) (pos? (nm-sf M s SF-FN)))))
(defn- ck-r6f-optp [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        x (nm-next M h)
        M1 (ck-expr M x fx 0)
        ty (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (nm-ne (ck-tcon M1 ty) TC-OPTION) (ck-list M1 n fx ctx)
          :else
          (let [tok (nm-nf M1 h NF-TOK)
                some (= (nm-sf M1 (nm-sym-of M1 h) SF-HASH) 3988478846623731818)
                M2 (ck-r6b-nkw M1 tok KW-I64 237)
                ki (ck-r M2)
                M3 (ck-r6b-nhead M2 tok HD-R6-AS 233)
                ah (ck-r M3)
                M4 (ck-n-list (ck-link (ck-link M3 ah ki) ki x) tok ah)
                al (ck-r M4)
                M5 (ck-n-int M4 tok 0)
                z (ck-r M5)
                M6 (ck-r6b-nhead (ck-chain2 M5 al z) tok HD-EQ 238)
                eh (ck-r M6)
                M7 (ck-link M6 eh al)]
            (if some
              (let [M8 (ck-n-list M7 tok eh)
                    el (ck-r M8)
                    M9 (ck-r6b-nhead M8 tok HD-NOT 239)
                    nh (ck-r M9)
                    M10 (ck-chain2 M9 nh el)]
                (ck-expr (nm-set-nf M10 n NF-FIRST nh) n fx ctx))
              (ck-expr (nm-set-nf M7 n NF-FIRST eh) n fx ctx))))))
;; R6M (agent SEEDLANG, 2026-10-04): the reference's pair-list readers on an :i64 (a (cons ..) / (pair ..) chain, 0 = empty):
;; (first x) -> (pair-first x), (rest x) -> (pair-second x), (second x) -> (pair-first (pair-second x)), (empty? x) ->
;; (= x 0). first/second/rest only where the name is the library's :document reader (R6B; its parameter is :document),
;; empty? only where nothing defines it; any other argument type keeps the old meaning (the library call, or E2101).
;; Code: 1 first, 2 rest, 3 second, 4 empty?, 0 none.
(defn- ck-r6m-pl? [M :vector-i64 n :i64] :i64
  (let [h (nm-first M n)
        s (nm-sym-of M h)
        hh (if (= (nm-kind M h) ND-SYM) (nm-sf M s SF-HASH) 0)
        f (nm-sf M s SF-FN)
        lib (and (pos? f) (< f (vector-at M MM-FN-N)) (= (nm-ff M f (+ FF-PT0 0)) TY-DOC))]
    (cond (or (nm-ne (nm-count M n) 2) (zero? hh) (>= (nm-local-slot M s) 0)) 0
          (and lib (= hh -8514075438229807807)) 1
          (and lib (= hh 5527727774794834391)) 2
          (and lib (= hh -6586085717218287427)) 3
          (and (= hh 6090801332560817251) (zero? f) (zero? (nm-sf M s SF-HEAD))) 4
          :else 0)))
(defn- ck-r6m-pl [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [code (ck-r6m-pl? M n)
        h (nm-first M n)
        x (nm-next M h)
        tok (nm-nf M h NF-TOK)
        M1 (ck-expr M x fx 0)
        ty (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (nm-ne ty TY-I64) (ck-list M1 n fx ctx)
          (= code 4) (let [M2 (ck-n-int M1 tok 0)
                           z (ck-r M2)]
                       (ck-expr (ck-rehead (ck-chain2 M2 x z) n HD-EQ x) n fx ctx))
          (= code 3) (let [M2 (ck-mkh M1 tok HD-PAIR-SECOND x)
                           y (ck-r M2)]
                       (ck-expr (ck-rehead M2 n HD-PAIR-FIRST y) n fx ctx))
          :else (ck-expr (ck-rehead M1 n (if (= code 1) HD-PAIR-FIRST HD-PAIR-SECOND) x) n fx ctx))))
;; ---- R6M (agent SEEDLANG, 2026-10-04): variants and heterogeneous vectors (examples recursive-tree / recursive-generic /
;; held-operations, conformance type_directed_heterogeneous_nth). Types (CT records, ctor codes local to 21-check):
;;   [:variant :kw [[:tag T] ..]]  CT (40, the keyword symbol of :kw, 0); word 3 of the CT record = a HEAP block
;;                                 [n tag1 T1 tag2 T2 ..] (tags = keyword symbols, in declaration order). Identity is :kw: the CT
;;                                 record is interned BEFORE the payload types are read, so [:ref :kw] inside (and anywhere,
;;                                 ck-tf-ref) names the variant; a second form of the same :kw must spell the same tags.
;;                                 Registered by :schemas, by any inline form (ck-inline-scan) and where typed.
;;   [:vector [T1 T2 ..]] mixed   CT (41, the TC-PLIST chain of the item types, n) (R6D keeps the all-equal tuple a list).
;; Values: a variant is pair(tag index, payload); a heterogeneous vector is a vector of the items' words (a vector literal).
;; Operations (by the spelling's hash; no definition or local of the module may take the name):
;;   (variant-new T :tag x)                                  -> T            pair(i, x)
;;   (match-variant v T (:tag x body) ..) and (variant-match T v [[:tag x body] ..])  -> the bodies' type; x bound to the
;;                                 payload (`_` is an ordinary name); a value no clause names traps (brk)
;;   (hetero-vector T x1 .. xn)  (hetero-vector-at T v i)  (hetero-vector-assoc T v i x)  (nth v i): i an integer literal
;; Lowering (30-lower): variant-new and the match by the NF-RES codes ck-r6m-hd-vnew / ck-r6m-hd-vmatch; the rest as vector
;; literal / vector-at / vector-assoc. Any other use (a non-literal index, a missing tag) is refused by name.
(def ck-r6m-tc-var 40)
(def ck-r6m-tc-hvec 41)
(def ck-r6m-hd-vnew 3001)
(def ck-r6m-hd-vmatch 3002)
(def ck-r6m-h-arena 1121630809250370429)   ; arena-scope
(defn- ck-r6m-var-form? [M :vector-i64 n :i64] :bool
  (and (= (nm-kind M n) ND-VEC) (= (nm-count M n) 3) (= (nm-kind M (nm-first M n)) ND-KW)
       (= (nm-sf M (nm-sym-of M (nm-first M n)) SF-HASH) 1672476868814577086)
       (= (nm-kind M (nm-nth M n 1)) ND-KW) (= (nm-kind M (nm-nth M n 2)) ND-VEC)))
;; the address of word 3 of CT record ty
(defn- ck-r6m-w3 [M :vector-i64 ty :i64] :i64 (+ (vector-at M MM-CT) (* (- ty TY-COMP-BASE) CT-W) 3))
;; the payload block of variant type ty (0 while its payload types are being read)
(defn- ck-r6m-vblk [M :vector-i64 ty :i64] :i64
  (if (and (>= ty TY-COMP-BASE) (= (ck-tcon M ty) ck-r6m-tc-var)) (vector-at M (ck-r6m-w3 M ty)) 0))
;; the index of tag symbol tg in block b, -1 when absent
(defn- ck-r6m-tagi [M :vector-i64 b :i64 tg :i64] :i64
  (loop [i 0] (cond (or (zero? b) (>= i (vector-at M b))) -1 (= (vector-at M (+ b 1 (* 2 i))) tg) i :else (recur (inc i)))))
(defn- ck-r6m-payty [M :vector-i64 b :i64 i :i64] :i64 (vector-at M (+ b 2 (* 2 i))))
;; inline registration: a malformed form is left to the place that types it
(defn- ck-r6m-tvar-reg [M :vector-i64 n :i64] :vector-i64 (let [M1 (ck-tform M n)] (ck-touch M1)))
;; [:variant :kw [[:tag T] ..]] (throws t when malformed)
(defn- ck-r6m-tvar [M :vector-i64 t :i64] :vector-i64
  (let [kw (nm-nth M t 1)
        cl (nm-nth M t 2)
        ks (nm-sym-of M kw)
        nc (nm-count M cl)
        i0 (ck-ct-find M ck-r6m-tc-var ks 0)]
    (cond (not (ck-r6m-var-form? M t)) (throw t)
          (or (< nc 1) (> nc 64)) (throw t)
          (pos? i0) (let [ty (+ TY-COMP-BASE i0)
                          b (ck-r6m-vblk M ty)]
                      ;; registered (or being read: a recursive reference): the same tags in the same order, else malformed
                      (if (or (zero? b) (ck-r6m-same-tags? M b cl)) (nm-put M MM-R0 ty) (throw t)))
          :else
          (let [M1 (ck-ct-intern M ck-r6m-tc-var ks 0)
                ty (ck-r M1)
                M2 (mem-alloc M1 (+ 1 (* 2 nc)))
                b (ck-r M2)]
            (if (nm-failed M2)
              (nm-put M2 MM-R0 0)
              (let [M3 (ck-r6m-tags (nm-put M2 b 0) t b (nm-first M2 cl))]
                (nm-put (nm-put M3 (ck-r6m-w3 M3 ty) b) MM-R0 ty)))))))
;; the clauses from c into block b (its count grows as they are read; aborts with t when one is malformed or repeats a tag).
;; A recursion, not a loop: an abort inside a loop body before its recur is E2106.
(defn- ck-r6m-tags [M :vector-i64 t :i64 b :i64 c :i64] :vector-i64
  (cond (zero? c) M
        (or (nm-ne (nm-kind M c) ND-VEC) (nm-ne (nm-count M c) 2) (nm-ne (nm-kind M (nm-first M c)) ND-KW)) (throw t)
        (>= (ck-r6m-tagi M b (nm-sym-of M (nm-first M c))) 0) (throw t)
        :else (let [i (vector-at M b)
                    M1 (ck-tf M (nm-nth M c 1))
                    pt (ck-ty M1)
                    M2 (-> M1 (nm-put (+ b 1 (* 2 i)) (nm-sym-of M1 (nm-first M1 c))) (nm-put (+ b 2 (* 2 i)) pt) (nm-put b (inc i)))]
                (ck-r6m-tags M2 t b (nm-next M2 c)))))
(defn- ck-r6m-same-tags? [M :vector-i64 b :i64 cl :i64] :bool
  (and (= (vector-at M b) (nm-count M cl))
       (loop [c (nm-first M cl) i 0]
         (cond (zero? c) true
               (nm-ne (vector-at M (+ b 1 (* 2 i))) (nm-sym-of M (nm-first M c))) false
               :else (recur (nm-next M c) (inc i))))))
;; [:vector [T1 T2 ..]] with mixed item types: CT (41, plist, n)
(defn- ck-r6m-thvec [M :vector-i64 t :i64] :vector-i64
  (let [v (nm-nth M t 1)
        n (nm-count M v)
        M1 (ck-r6m-plist M v n 0)
        pl (ck-r M1)]
    (ck-ct-intern M1 ck-r6m-tc-hvec pl n)))
;; the TC-PLIST chain of the type forms of items 0..k-1 of vector v, consed onto acc (aborts on a malformed item)
(defn- ck-r6m-plist [M :vector-i64 v :i64 k :i64 acc :i64] :vector-i64
  (if (zero? k)
    (nm-put M MM-R0 acc)
    (let [M1 (ck-tf M (nm-nth M v (dec k)))
          M2 (ck-ct-intern M1 TC-PLIST (ck-ty M1) acc)]
      (ck-r6m-plist M2 v (dec k) (ck-r M2)))))
;; a vector type with per-index item types: the heterogeneous vector, or R6D's closed tuple (list T n), n > 0
(defn- ck-r6m-hv? [M :vector-i64 ty :i64] :bool
  (or (= (ck-tcon M ty) ck-r6m-tc-hvec) (and (= (ck-tcon M ty) TC-LIST) (pos? (ck-tb M ty)))))
;; item type i of heterogeneous vector type ty (0 out of range)
(defn- ck-r6m-hty [M :vector-i64 ty :i64 i :i64] :i64
  (cond (or (< i 0) (>= i (ck-tb M ty))) 0
        (= (ck-tcon M ty) TC-LIST) (ck-ta M ty)
        :else (loop [p (ck-ta M ty) k i] (if (zero? k) (ck-ta M p) (recur (ck-tb M p) (dec k))))))
;; the operation code of list n (0 none): 1 variant-new 2 match-variant 3 variant-match 4 hetero-vector 5 hetero-vector-at
;; 6 hetero-vector-assoc
(defn- ck-r6m-vx? [M :vector-i64 n :i64] :i64
  (let [h (nm-first M n)
        s (nm-sym-of M h)
        hh (if (= (nm-kind M h) ND-SYM) (nm-sf M s SF-HASH) 0)]
    (cond (or (zero? hh) (>= (nm-local-slot M s) 0) (pos? (nm-sf M s SF-FN)) (pos? (nm-sf M s SF-HEAD))) 0
          (= hh 1020304885394931549) 1
          (= hh 4114645261843507634) 2
          (= hh 3051134156447049386) 3
          (= hh 5031585864387836850) 4
          (= hh 4179465675549041136) 5
          (= hh -5614762944342869044) 6
          (= hh ck-r6m-h-arena) 7
          :else 0)))
;; the type form child tn of n must be a type of ctor c (c = the hvec ctor: also a closed tuple): R0 = the type (0 after an
;; error at tn)
(defn- ck-r6m-targ [M :vector-i64 tn :i64 c :i64] :vector-i64
  (let [M1 (ck-tform M tn)
        ty (ck-ty M1)]
    (cond (nm-failed M1) (nm-put M1 MM-R0 0)
          (zero? ty) (nm-put (ck-err M1 E-CHECK-TYPENAME tn 0) MM-R0 0)
          (if (= c ck-r6m-tc-hvec) (not (ck-r6m-hv? M1 ty)) (nm-ne (ck-tcon M1 ty) c)) (nm-put (ck-err M1 E-CHECK-TYPENAME tn 0) MM-R0 0)
          :else (nm-put (nm-set-nf M1 tn NF-TYPE ty) MM-R0 ty))))
;; the literal index node i against heterogeneous type ty: R0 = the item type (0 after an error)
(defn- ck-r6m-lidx [M :vector-i64 i :i64 ty :i64 h :i64] :vector-i64
  (let [it (if (= (nm-kind M i) ND-INT) (ck-r6m-hty M ty (nm-nf M i NF-AUX)) 0)]
    (if (zero? it) (nm-put (ck-err M E-CHECK-TYPE h ty) MM-R0 0) (nm-put (ck-mark M i TY-I64 0) MM-R0 it))))
(defn- ck-r6m-vx [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [code (ck-r6m-vx? M n)
        h (nm-first M n)
        na (dec (nm-count M n))]
    (case code
      1 (if (= na 3) (ck-r6m-vnew M n fx) (ck-err M E-CHECK-ARITY h 3))
      2 (if (>= na 3) (ck-r6m-vmatch M n (nm-nth M n 1) (nm-nth M n 2) (nm-nth M n 3) fx ctx) (ck-err M E-CHECK-ARITY h 3))
      3 (if (and (= na 3) (= (nm-kind M (nm-nth M n 3)) ND-VEC) (pos? (nm-count M (nm-nth M n 3))))
          ;; (variant-match T v [c ..]) -> (match-variant v T c ..)
          (let [tn (nm-nth M n 1)
                v (nm-nth M n 2)
                cv (nm-nth M n 3)
                M1 (-> M (ck-link h v) (ck-link v tn) (ck-link tn (nm-first M cv)))]
            (ck-r6m-vmatch M1 n v tn (nm-first M1 cv) fx ctx))
          (ck-err M E-CHECK-ARITY h 3))
      4 (ck-r6m-hnew M n fx)
      5 (if (= na 3) (ck-r6m-hat M n fx 0) (ck-err M E-CHECK-ARITY h 3))
      6 (if (= na 4) (ck-r6m-hat M n fx 1) (ck-err M E-CHECK-ARITY h 4))
      7 (if (= na 1) (ck-r6m-arena M n fx ctx) (ck-err M E-CHECK-ARITY h 1))
      (ck-err M E-CHECK-HEAD h 0))))
;; (arena-scope e) -> (do e): the reference's scope reclaims the arenas a scalar body used (loader ABI v6); the seed keeps the
;; value and does not reclaim (the result is the same; memory is not). The body must be :i64 :bool or :f64 as there.
(defn- ck-r6m-arena [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        M1 (ck-expr (ck-rehead M n HD-DO (nm-next M h)) n fx ctx)
        ty (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (or (= ty TY-I64) (= ty TY-BOOL) (= ty TY-F64) (zero? ty)) M1
          :else (ck-err M1 E-CHECK-TYPE h TY-I64))))
(defn- ck-r6m-vnew [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        tn (nm-nth M n 1)
        tg (nm-nth M n 2)
        x (nm-nth M n 3)
        M1 (ck-r6m-targ M tn ck-r6m-tc-var)
        ty (ck-ty M1)
        b (ck-r6m-vblk M1 ty)
        i (if (= (nm-kind M1 tg) ND-KW) (ck-r6m-tagi M1 b (nm-sym-of M1 tg)) -1)]
    (cond (nm-failed M1) (ck-touch M1)
          (< i 0) (ck-err M1 E-CHECK-FIELD tg 0)
          :else (let [M2 (ck-want M1 x fx (ck-r6m-payty M1 b i) h)]
                  (if (nm-failed M2)
                    (ck-touch M2)
                    (ck-mark (ck-fuel (nm-set-nf M2 tg NF-RES (inc i)) (ck-fx-f fx)) n ty ck-r6m-hd-vnew))))))
;; the clauses from c: (:tag x body) or [:tag x body]; the scrutinee is in the hidden slot (NF-TYPE of the head)
(defn- ck-r6m-vmatch [M :vector-i64 n :i64 v :i64 tn :i64 c0 :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        M0 (ck-hide M h NF-TYPE 1 fx)
        fx2 (ck-ty M0)
        M1 (ck-r6m-targ M0 tn ck-r6m-tc-var)
        ty (ck-ty M1)
        b (ck-r6m-vblk M1 ty)
        a0 (ck-aborts M1)
        M2 (if (nm-failed M1) M1 (ck-want M1 v fx2 ty h))
        ctx1 (ck-ctx-after M2 a0 ctx)]
    (loop [M3 M2 c c0 acc 0]
      (cond (nm-failed M3) (ck-touch M3)
            (zero? c) (ck-mark (ck-fuel M3 (ck-fx-f fx)) n acc ck-r6m-hd-vmatch)
            (or (and (nm-ne (nm-kind M3 c) ND-LIST) (nm-ne (nm-kind M3 c) ND-VEC)) (nm-ne (nm-count M3 c) 3)
                (nm-ne (nm-kind M3 (nm-first M3 c)) ND-KW) (nm-ne (nm-kind M3 (nm-nth M3 c 1)) ND-SYM))
            (ck-err M3 E-CHECK-BINDINGS c 0)
            :else
            (let [tg (nm-first M3 c)
                  i (ck-r6m-tagi M3 b (nm-sym-of M3 tg))]
              (if (< i 0)
                (ck-err M3 E-CHECK-FIELD tg 0)
                (let [M4 (ck-bind-body (nm-set-nf M3 tg NF-RES (inc i)) (nm-nth M3 c 1) (ck-r6m-payty M3 b i) (nm-nth M3 c 2) fx2 ctx1)
                      tb (ck-ty M4)
                      M5 (if (nm-failed M4) M4 (ck-unify M4 acc tb h))]
                  (recur M5 (nm-next M5 c) (ck-ty M5)))))))))
;; (hetero-vector T x ..): the node becomes the vector literal [x ..] of type T
(defn- ck-r6m-hnew [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        tn (nm-next M h)
        M1 (ck-r6m-targ M tn ck-r6m-tc-hvec)
        ty (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (nm-ne (dec (nm-count M1 n)) (inc (ck-tb M1 ty))) (ck-err M1 E-CHECK-ARITY h (inc (ck-tb M1 ty)))
          :else (loop [M2 M1 c (nm-next M1 tn) i 0]
                  (cond (nm-failed M2) (ck-touch M2)
                        (zero? c) (let [x0 (nm-next M2 tn)]
                                    (ck-mark (-> M2 (nm-set-nf n NF-KIND ND-VEC) (nm-set-nf n NF-FIRST x0)) n ty HD-VECLIT))
                        :else (let [M3 (ck-want M2 c fx (ck-r6m-hty M2 ty i) h)] (recur M3 (nm-next M3 c) (inc i))))))))
;; (hetero-vector-at T v i) -> (nth v i) (as = 0); (hetero-vector-assoc T v i x) -> (vector-assoc v i x) (as = 1)
(defn- ck-r6m-hat [M :vector-i64 n :i64 fx :i64 as :i64] :vector-i64
  (let [h (nm-first M n)
        tn (nm-nth M n 1)
        v (nm-nth M n 2)
        i (nm-nth M n 3)
        x (nm-nth M n 4)
        M1 (ck-r6m-targ M tn ck-r6m-tc-hvec)
        ty (ck-ty M1)
        M2 (if (nm-failed M1) M1 (ck-want M1 v fx ty h))
        M3 (if (nm-failed M2) M2 (ck-r6m-lidx M2 i ty h))
        it (ck-r M3)
        M4 (if (or (nm-failed M3) (zero? as)) M3 (ck-want M3 x fx it h))]
    (if (nm-failed M4)
      (ck-touch M4)
      (ck-mark (ck-fuel (ck-link M4 h v) (ck-fx-f fx)) n (if (zero? as) it ty) (if (zero? as) HD-NTH HD-VECTOR-ASSOC)))))
;; (nth v i) on a heterogeneous vector (v checked by ck-gen): i an integer literal
(defn- ck-r6m-hnth [M :vector-i64 n :i64 ty :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        M1 (ck-r6m-lidx M (nm-nth M n 2) ty h)
        it (ck-r M1)]
    (if (nm-failed M1) (ck-touch M1) (ck-mark (ck-fuel M1 (ck-fx-f fx)) n it HD-NTH))))

;; R6F: a keyword-keyed map literal in the TAIL of a defn whose declared result is an inline record schema
;; [:record :kw [[k T] ..]] with exactly those keys is that record: {k1 e1 ..} -> (record-new SCHEMA e.. in field order)
;; (the reference lowers a keyword-keyed literal with a non-i64 value to a closed record and admits it as the declared one:
;; kotoba.security.hardware evaluate). Tails: let/do/loop bodies, if/cond arms, as R6C's :document tails.
(defn- ck-r6f-rectail [M :vector-i64 c :i64] :vector-i64
  (let [r (nm-nth M c 3)]
    (if (and (not (nm-failed M)) (= (nm-kind M r) ND-VEC) (= (nm-count M r) 3) (= (nm-kind M (nm-first M r)) ND-KW)
             (= (nm-head-of M (nm-first M r)) KW-RECORD) (= (nm-kind M (nm-nth M r 2)) ND-VEC))
      (ck-r6f-rt M r (nm-nth M c 4))
      M)))
(defn- ck-r6f-rt [M :vector-i64 r :i64 b :i64] :vector-i64
  (let [hd (nm-form-head M b)]
    (cond (= (nm-kind M b) ND-MAP) (ck-r6f-reclit M r b)
          (or (= hd HD-LET) (= hd HD-DO) (= hd HD-LOOP)) (ck-r6f-rt M r (ck-r6c-last M b))
          (= hd HD-IF) (ck-r6f-rt (ck-r6f-rt M r (nm-nth M b 2)) r (nm-nth M b 3))
          (= hd HD-COND) (loop [M1 M t (nm-next M (nm-first M b))]
                           (if (or (zero? t) (zero? (nm-next M1 t))) M1 (recur (ck-r6f-rt M1 r (nm-next M1 t)) (nm-next M1 (nm-next M1 t)))))
          :else M)))
;; the value node of keyword key symbol ks in map literal m, 0 when absent
(defn- ck-r6f-mapval [M :vector-i64 m :i64 ks :i64] :i64
  (loop [k (nm-first M m)]
    (cond (or (zero? k) (zero? (nm-next M k))) 0
          (and (= (nm-kind M k) ND-KW) (= (nm-sym-of M k) ks)) (nm-next M k)
          :else (recur (nm-next M (nm-next M k))))))
(defn- ck-r6f-reclit [M :vector-i64 r :i64 m :i64] :vector-i64
  (let [fl (nm-nth M r 2)
        nf (nm-count M fl)
        ok (and (pos? nf) (= (nm-count M m) (* 2 nf))
                (loop [f (nm-first M fl)]
                  (cond (zero? f) true
                        (and (= (nm-kind M f) ND-VEC) (= (nm-kind M (nm-first M f)) ND-KW) (pos? (ck-r6f-mapval M m (nm-sym-of M (nm-first M f))))) (recur (nm-next M f))
                        :else false)))]
    (if (not ok)
      M
      (let [tok (nm-nf M m NF-TOK)
            M1 (ck-r5b-clone M r)
            sch (ck-r M1)
            vs (loop [f (nm-first M1 fl) acc (vector-i64)]   ; the values first: linking them rewrites m's chain
                 (if (zero? f) acc (recur (nm-next M1 f) (vector-conj acc (ck-r6f-mapval M1 m (nm-sym-of M1 (nm-first M1 f)))))))
            M2 (loop [M3 M1 i 0 prev sch]
                 (if (>= i (vector-count vs))
                   (ck-link M3 prev 0)
                   (recur (ck-link M3 prev (vector-at vs i)) (inc i) (vector-at vs i))))
            M4 (ck-mkh M2 tok HD-RECORD-NEW sch)
            l (ck-r M4)]
        (ck-become M4 m l)))))
;; R6F: computed defs. The reference admits a def whose value is an expression over the constants above it
;; (lang/guest-grammar.edn :order; `(def max-bytes (* 1024 1024))`, `(def msg (str "a" "b"))`, `(def f2 (conj f1 :k))`), the
;; seed only literals (E2124). A def whose value is a LIST becomes a private nullary defn with an inferred result,
;; `(def NAME e)` -> `(def NAME [] e)` with FN kind FK-PRIV (its head still spells def: ck-r6f-cdef-fn?), and every value
;; reference NAME (not a local) is the call (NAME). A def of a SYMBOL ((def windows? false), an alias) is the same: the value is recomputed per use, which no program can tell from a constant
;; (the expressions are pure: a def body runs no capability -- an effectful one is refused as in any defn without the
;; capability declared). A reference from a def ABOVE it is E2126 (the result is not inferred yet), the reference's order rule.
(defn- ck-r6f-cdef-form? [M :vector-i64 c :i64] :bool
  (and (= (nm-count M c) 3) (or (= (nm-kind M (nm-nth M c 2)) ND-LIST) (= (nm-kind M (nm-nth M c 2)) ND-SYM)) (= (nm-kind M (nm-nth M c 1)) ND-SYM)))
(defn- ck-r6f-cdef [M :vector-i64 c :i64] :vector-i64
  (let [h (nm-first M c)
        nmn (nm-next M h)
        v (nm-next M nmn)
        f (nm-sf M (nm-sym-of M nmn) SF-FN)
        tok (nm-nf M h NF-TOK)
        M1 (ck-n-coll M ND-VEC tok 0)
        pv (ck-r M1)
        M2 (ck-link (ck-link M1 nmn pv) pv v)]
    (if (and (pos? f) (= (nm-ff M2 f FF-KIND) FK-DEF) (= (nm-ff M2 f FF-NODE) c) (not (ck-r6f-loopy? M2 v)))
      (-> M2 (nm-set-ff f FF-KIND FK-PRIV) (nm-set-ff f FF-NPARAMS 0))
      (ck-err M2 E-CHECK-DEF nmn 0))))
;; 1 when tree v holds a loop, recur, dotimes, doseq or fn literal (the reference refuses a def value with a loop: its
;; compile-time evaluation has no fuel bound; a closure has no constant spelling) -> E2124 at the def's name. NOT refused
;; here (the reference does): a call of a function of this module (`def value of <name> calls <f>`); the seed evaluates it.
(defn- ck-r6f-loopy? [M :vector-i64 v :i64] :bool
  (let [k (nm-kind M v)
        hd (if (and (= k ND-LIST) (= (nm-kind M (nm-first M v)) ND-SYM)) (nm-head-of M (nm-first M v)) 0)]
    (cond (or (= hd HD-LOOP) (= hd HD-RECUR) (= hd HD-DOTIMES) (= hd HD-DOSEQ) (= hd HD-FN)) true
          (or (= k ND-LIST) (= k ND-VEC) (= k ND-MAP) (= k ND-SET))
          (loop [c (nm-first M v)] (cond (zero? c) false (ck-r6f-loopy? M c) true :else (recur (nm-next M c))))
          :else false)))
;; fn index fi is a computed def (a private defn whose form head spells def)
(defn- ck-r6f-cdef-fn? [M :vector-i64 fi :i64] :bool
  (and (pos? fi) (= (nm-ff M fi FF-KIND) FK-PRIV) (= (nm-head-of M (nm-first M (nm-ff M fi FF-NODE))) HD-DEF)))
(defn- ck-r6f-cdef-ref? [M :vector-i64 n :i64] :bool
  (let [s (nm-sym-of M n)] (and (< (nm-local-slot M s) 0) (ck-r6f-cdef-fn? M (nm-sf M s SF-FN)))))
;; symbol node n -> the list (n') calling it (n' a fresh reference to the same symbol)
(defn- ck-r6f-cdef-call [M :vector-i64 n :i64] :vector-i64
  (let [tok (nm-nf M n NF-TOK)
        M1 (ck-n-ref M tok (nm-sym-of M n))
        r (ck-r M1)
        M2 (ck-n-list M1 tok r)
        l (ck-r M2)]
    (ck-become M2 n l)))
;; ==== END R6F =======================================================================================================

;; seed/30-lower.kotoba -- lower the checked tree to SIR (prefix lw-). Owner: module 30-lower.
;; Contract: seed/SIR (opcodes, lowering table, fuel rule), seed/MEMORY-MAP (NODE/FN/SIR layouts, rules L1-L13),
;; seed/HEADS (head codes, RES-* encoding). Design: docs/selfhost-seed-design-20261002.md 2.1/2.2.
;;
;; API:
;;   lw-run M                 -> M, M[MM-R0] = number of SIR instructions written (MM-SIR-N - 1)
;;   lw-interp M H hsize f a0 -> H  (TEST-ONLY SIR interpreter; H is a separate (vector-alloc hsize) the caller
;;                                   owns; runs FN f with argument a0 (ignored when f takes none);
;;                                   H[0] = status (LW-IX status codes below), H[1] = result, H[4] = fuel used)
;;
;; What lowering reads (written by 11-read / 20-names / 21-check):
;;   NF-KIND NF-FIRST NF-NEXT NF-AUX NF-TOK of every node; NF-RES of every ND-LIST expression (head code);
;;   NF-RES of every ND-SYM expression (RES-LOCAL slot or RES-DEF fn) AND of every binder symbol (params, let
;;   and loop names: RES-LOCAL slot; seed/CONTRACT-REQUESTS.md 2026-10-02 30-lower); the head symbol of a user
;;   call: NF-RES = RES-FN fn, or else SF-FN of its NF-SYM; FF-NODE FF-KIND FF-NPARAMS FF-NSLOTS FF-FUEL.
;; Lowering is a pure function of the tree: labels are numbered in walk order, nothing depends on hashing.
;;
;; Deviation noted for the reader of seed/SIR: loop INITIALISERS are lowered sequentially, like let
;; ([e1 -> t] LSET s1 t [e2 -> t] LSET s2 t ...), so (loop [a 1 b a] ..) is right whichever way 21-check
;; resolves `a` in b's initialiser; recur stays a parallel assignment as the table says.
;;
;; Own scratch cells (MEMORY-MAP MM-STAT: 30-lower is MANIFEST position 7 -> M[92..95]):
;;   92 = FN index being lowered, 93 = its entry label, 94 = its deepest temp so far (-1 = none),
;;   95 = R3: the innermost try body being lowered: handler label * 256 + the catch binder's slot (0 = none).

;; ------------------------------------------------------------------------------------------------------------
;; readers
;; ------------------------------------------------------------------------------------------------------------
(defn- lw-nf [M :vector-i64 n :i64 fld :i64] :i64
  (vector-at M (+ MM-NODE-BASE (+ (* n MM-NODE-W) fld))))
(defn- lw-ff [M :vector-i64 f :i64 fld :i64] :i64
  (vector-at M (+ MM-FN-BASE (+ (* f MM-FN-W) fld))))
(defn- lw-next [M :vector-i64 n :i64] :i64 (lw-nf M n NF-NEXT))
(defn- lw-first [M :vector-i64 n :i64] :i64 (lw-nf M n NF-FIRST))
;; the i-th node of a sibling chain starting at c (0-based), 0 past the end
(defn- lw-nth [M :vector-i64 c :i64 i :i64] :i64
  (if (= c 0) 0 (if (= i 0) c (lw-nth M (lw-next M c) (- i 1)))))
(defn- lw-count [M :vector-i64 c :i64] :i64
  (loop [x c k 0] (if (= x 0) k (recur (lw-next M x) (+ k 1)))))
;; RES-* class and index of a resolution word
(defn- lw-rcls [res :i64] :i64 (quot res RES-SCALE))
(defn- lw-ridx [res :i64] :i64 (- res (* (quot res RES-SCALE) RES-SCALE)))
(defn- lw-slot [M :vector-i64 n :i64] :i64 (lw-ridx (lw-nf M n NF-RES)))
(defn- lw-pos [M :vector-i64 n :i64] :i64
  (vector-at M (+ MM-TOK-BASE (+ (* (lw-nf M n NF-TOK) MM-TOK-W) TF-START))))
;; SF-HEAD of the symbol of a keyword node
(defn- lw-kwcode [M :vector-i64 n :i64] :i64
  (vector-at M (+ MM-SYM-BASE (+ (* (lw-nf M n NF-SYM) MM-SYM-W) SF-HEAD))))

;; context word k = tail bit + 2 * loop node + 2^21 * loop header label (loop node 0 = no enclosing loop)
;; R6B (2026-10-03, FRONT's request): the node field is 20 bits (was 17), so a loop node index up to 1,048,575 survives
;; (MM-NODE-CAP is 196,608 since R6B; R6A's 2^17 mask truncated any node >= 131,072 silently).
(defn- lw-kt [k :i64] :i64 (bit-and k 1))
(defn- lw-kn [k :i64] :i64 (bit-and (u64-shift-right k 1) 1048575))
(defn- lw-kl [k :i64] :i64 (u64-shift-right k 21))
(defn- lw-kmk [tail :i64 node :i64 label :i64] :i64 (+ tail (* 2 node) (* 2097152 label)))

;; highest temp an instruction touches, -1 for none
(defn- lw-hi [op :i64 a :i64 b :i64 c :i64] :i64
  (case op
    (OP-CONST OP-LGET OP-STR OP-RET OP-BRZ OP-BRNZ OP-TAB OP-FADDR OP-VECP) a
    (OP-LSET OP-UN) b
    (OP-BIN OP-CMP) (inc b)
    (OP-CALL OP-RT) (if (pos? c) (+ b (dec c)) b)
    OP-CALLI (+ b c)
    OP-CAP c
    OP-VEC (if (pos? b) (+ a (dec b)) a)
    OP-RES2 a        ; R5B
    OP-RET2 (inc a)  ; R5B
    -1))

;; ------------------------------------------------------------------------------------------------------------
;; writers: errors, emit, labels
;; ------------------------------------------------------------------------------------------------------------
;; R1: this module is written in the R1 language (case, ->, cond->, when, and/or in any position, dotimes, a flat
;; record) and is compiled only by an R1 seed; the stage-0 workarounds of R0 (one-assoc! leaf writer only, no
;; if/cond in a value position, value helpers) are gone except lw-put, which the unit tests call.
(defn- lw-put [V :vector-i64 i :i64 x :i64] :vector-i64 (vector-assoc! V i x))
(defn- lw-max [a :i64 b :i64] :i64 (if (> a b) a b))
;; first error wins
(defn- lw-fail [M :vector-i64 code :i64 pos :i64 n :i64] :vector-i64
  (if (zero? (vector-at M MM-ERR))
    (-> M (lw-put MM-ERR code) (lw-put MM-ERR-POS pos) (lw-put MM-ERR-N n))
    M))

(defn- lw-depth [M :vector-i64 h :i64] :vector-i64
  (let [d0 (vector-at M 94)
        d1 (vector-at M MM-MAX-DEPTH)]
    (-> M (lw-put 94 (lw-max h d0)) (lw-put MM-MAX-DEPTH (lw-max h d1)))))

;; R4 rung proof: multi-arity -- (lw-emit M op a), (lw-emit M op a b): the missing operands are 0
(defn- lw-emit
  ([M :vector-i64 op :i64 a :i64] :vector-i64 (lw-emit M op a 0 0))
  ([M :vector-i64 op :i64 a :i64 b :i64] :vector-i64 (lw-emit M op a b 0))
  ([M :vector-i64 op :i64 a :i64 b :i64 c :i64] :vector-i64
  (let [i (vector-at M MM-SIR-N)
        p (+ MM-SIR-BASE (* i MM-SIR-W))]
    (if (>= i MM-SIR-CAP)
      (lw-fail M E-LOWER-FULL -1 0)
      (-> M
          (lw-put (+ p IF-OP) op)
          (lw-put (+ p IF-A) a)
          (lw-put (+ p IF-B) b)
          (lw-put (+ p IF-C) c)
          (lw-put MM-SIR-N (inc i))
          (lw-depth (lw-hi op a b c)))))))

;; reserve n consecutive labels; the first is M[MM-LABEL-N] read BEFORE the call
(defn- lw-labels [M :vector-i64 n :i64] :vector-i64
  (lw-put M MM-LABEL-N (+ (vector-at M MM-LABEL-N) n)))

;; ------------------------------------------------------------------------------------------------------------
;; head -> operator tables
;; ------------------------------------------------------------------------------------------------------------
(defn- lw-bop [hd :i64] :i64
  (case hd
    HD-ADD BOP-ADD HD-SUB BOP-SUB HD-MUL BOP-MUL HD-QUOT BOP-QUOT
    HD-BIT-AND BOP-AND HD-BIT-OR BOP-OR HD-BIT-XOR BOP-XOR
    HD-SHL BOP-SHL HD-USHR BOP-USHR HD-SSHR BOP-SSHR
    0))
(defn- lw-cc [hd :i64] :i64
  (case hd HD-EQ CC-EQ HD-LT CC-LT HD-GT CC-GT HD-LE CC-LE HD-GE CC-GE 0))
(defn- lw-rt [hd :i64] :i64
  (case hd
    HD-VECTOR-AT RT-VECTOR-AT
    HD-VECTOR-CONJ RT-VECTOR-CONJ
    HD-VECTOR-ASSOC RT-VECTOR-ASSOC
    HD-VECTOR-ASSOC-BANG RT-VECTOR-ASSOC-IN-PLACE
    HD-VECTOR-ALLOC RT-VECTOR-ALLOC
    HD-STRING-CODE-POINT-AT RT-STRING-CODE-POINT-AT
    HD-STRING-LENGTH RT-STRING-LENGTH-VIA
    HD-STRING-CONCAT RT-STRING-CONCAT
    (HD-BYTES-FROM-VECTOR-I64 HD-VECTOR-I64-FROM-BYTES) RT-BYTES-FROM-VECTOR
    HD-VECTOR-COUNT RT-VECTOR-COUNT
    ;; R3: strings and pairs (seed/HEADS 110-118)
    HD-STRING-EQ RT-STRING-EQUAL
    HD-STRING-SUBSTRING RT-STRING-SUBSTRING
    HD-STRING-COMPARE RT-STRING-COMPARE
    HD-STRING-INDEX-OF RT-STRING-INDEX-OF
    (HD-STRING-BYTE-LENGTH HD-PAIR-SECOND) RT-PAIR-SECOND
    HD-PAIR RT-PAIR-NEW
    HD-PAIR-FIRST RT-PAIR-FIRST
    ;; R4B: bytes (a bytes value is a vector handle of items 0..255: count and at are the vector operations)
    HD-BYTES-EMPTY RT-VECTOR-NEW-EMPTY
    HD-BYTES-COUNT RT-VECTOR-COUNT
    HD-BYTES-AT RT-VECTOR-AT
    HD-BYTES-CONCAT RT-BYTES-CONCAT
    HD-BYTES-SLICE RT-BYTES-SLICE
    HD-STRING-FROM-UTF8 RT-STRING-FROM-UTF8
    0))
(defn- lw-wire [kw :i64] :i64
  (case kw
    (KW-FS-APP-DATA KW-FS-APP-DATA-BYTES) WIRE-FS-APP-DATA
    KW-CLI-ARGS WIRE-CLI-ARGS
    KW-IO-WRITE-ERROR WIRE-IO-WRITE-ERROR
    KW-IO-WRITE WIRE-IO-WRITE
    ;; R4B
    KW-HASH-SHA256 WIRE-HASH-SHA256
    KW-ENV-READ WIRE-ENV-READ
    KW-FS-BROWSE WIRE-FS-BROWSE
    KW-IO-READ WIRE-IO-READ
    ;; R6B
    KW-PROCESS-SPAWN WIRE-PROCESS-SPAWN
    KW-ENTROPY-DRAW WIRE-ENTROPY-DRAW
    0))
(defn- lw-kind [kw :i64] :i64 (case kw KW-STRING CK-STRING KW-BYTES CK-BYTES 0))
;; R4B: the kind of a (request, result) keyword pair: :string :bytes is KEXE_TYPED_STRING_BYTES_V1
(defn- lw-kind2 [q :i64 r :i64] :i64 (if (and (= q KW-STRING) (= r KW-BYTES)) CK-STRING-BYTES (lw-kind q)))

;; ------------------------------------------------------------------------------------------------------------
;; expressions: [n -> t] under context k
;; ------------------------------------------------------------------------------------------------------------
;; lower the sibling chain a, a', ... into t, t+1, ...
(defn- lw-args [M :vector-i64 a :i64 t :i64] :vector-i64
  (if (zero? a)
    M
    (let [nx (lw-next M a)]
      (lw-args (lw-expr M a t 0) nx (inc t)))))

;; left fold of the remaining operands a, a', ... into t (t holds the accumulator)
(defn- lw-fold [M :vector-i64 a :i64 t :i64 bop :i64] :vector-i64
  (if (zero? a)
    M
    (let [nx (lw-next M a)]
      (lw-fold (-> M (lw-expr a (inc t) 0) (lw-emit OP-BIN bop t)) nx t bop))))

;; let/loop bindings b = first binder of the binding vector: [init -> t] LSET slot t, sequentially
(defn- lw-binds [M :vector-i64 b :i64 t :i64] :vector-i64
  (if (zero? b)
    M
    (let [init (lw-next M b)
          nb (lw-next M init)
          slot (lw-slot M b)]
      (if (and (= (lw-nf M init NF-KIND) ND-LIST) (zero? (lw-nf M init NF-RES)))
        (lw-binds M nb t)
        (lw-binds (-> M (lw-expr init t 0) (lw-emit OP-LSET slot t)) nb t)))))

;; recur into a loop: LSET binder_i (t+i) for the binders b, b'', ... (parallel assignment; values computed)
(defn- lw-loop-sets [M :vector-i64 b :i64 t :i64] :vector-i64
  (if (zero? b)
    M
    (let [nb (lw-next M (lw-next M b))]
      (lw-loop-sets (lw-emit M OP-LSET (lw-slot M b) t) nb (inc t)))))
;; recur into the function: LSET param slot i+1 from t+i, i = 0 .. n-1
(defn- lw-param-sets [M :vector-i64 i :i64 n :i64 t :i64] :vector-i64
  (if (>= i n)
    M
    ;; R5B: a specialization's parameters are slots 2.. (slot 1 holds the state)
    (lw-param-sets (lw-emit M OP-LSET (+ i 1 (if (lw-spec? M (vector-at M 92)) 1 0)) (+ t i)) (inc i) n t)))

;; (recur a ...) or a self tail call with arguments a ...: values, LSETs (into the params when there is no loop,
;; else into the loop's binders), FUEL, BR to the function entry (M[93]) or the loop header
(defn- lw-jump [M :vector-i64 a :i64 t :i64 k :i64] :vector-i64
  (let [loopn (lw-kn k)
        n (lw-count M a)
        b0 (if (zero? loopn) 0 (lw-first M (lw-next M (lw-first M loopn))))
        target (if (zero? loopn) (vector-at M 93) (lw-kl k))
        rf (lw-sx-recur? M)]   ; SEEDFIX: no charge in a fuel-free KIR library defn
    (-> M
        (lw-args a t)
        (cond-> (zero? loopn) (lw-param-sets 0 n t)
                (pos? loopn) (lw-loop-sets b0 t))
        (cond-> rf (lw-emit OP-FUEL 0))
        (lw-emit OP-BR target))))

(defn- lw-if [M :vector-i64 c :i64 t :i64 k :i64] :vector-i64
  (let [x (lw-next M c)
        y (lw-next M x)
        le (vector-at M MM-LABEL-N)]
    (-> M
        (lw-labels 2)
        (lw-expr c t 0)
        (lw-emit OP-BRZ t le)
        (lw-expr x t k)
        (lw-emit OP-BR (inc le))
        (lw-emit OP-LABEL le)
        (lw-expr y t k)
        (lw-emit OP-LABEL (inc le)))))

;; cond clauses from test node c; lx = the common exit label
(defn- lw-cond [M :vector-i64 c :i64 t :i64 k :i64 lx :i64] :vector-i64
  (let [e (lw-next M c)
        nc (lw-next M e)
        le (vector-at M MM-LABEL-N)]
    (if (= (lw-nf M c NF-KIND) ND-KW)
      (-> M (lw-expr e t k) (lw-emit OP-LABEL lx))
      (-> M
          (lw-labels 1)
          (lw-expr c t 0)
          (lw-emit OP-BRZ t le)
          (lw-expr e t k)
          (lw-emit OP-BR lx)
          (lw-emit OP-LABEL le)
          (lw-cond nc t k lx)))))

;; and/or operands from a; lxo = 2 * exit label + (1 for or)
(defn- lw-andor [M :vector-i64 a :i64 t :i64 k :i64 lxo :i64] :vector-i64
  (let [nx (lw-next M a)
        lx (quot lxo 2)]
    (if (zero? nx)
      (-> M (lw-expr a t k) (lw-emit OP-LABEL lx))
      (-> M
          (lw-expr a t 0)
          (lw-emit (if (= (bit-and lxo 1) 1) OP-BRNZ OP-BRZ) t lx)
          (lw-andor nx t k lxo)))))

(defn- lw-let [M :vector-i64 bv :i64 t :i64 k :i64] :vector-i64
  (let [body (lw-next M bv)
        b (lw-first M bv)]
    (-> M (lw-binds b t) (lw-expr body t k))))

(defn- lw-loop [M :vector-i64 n :i64 t :i64 k :i64] :vector-i64
  (let [bv (lw-next M (lw-first M n))
        body (lw-next M bv)
        b (lw-first M bv)
        lh (vector-at M MM-LABEL-N)]
    (-> M
        (lw-labels 1)
        (lw-binds b t)
        (cond-> (lw-sx-loop? M n) (lw-emit OP-FUEL 0))   ; SEEDFIX: a KIR loop helper's entry charge
        (lw-emit OP-LABEL lh)
        (lw-expr body t (lw-kmk (lw-kt k) n lh)))))

;; FN index of the callee named by head symbol node h
(defn- lw-callee [M :vector-i64 h :i64] :i64
  (let [res (lw-nf M h NF-RES)]
    (if (= (lw-rcls res) RES-FN)
      (lw-ridx res)
      (vector-at M (+ MM-SYM-BASE (* (lw-nf M h NF-SYM) MM-SYM-W) SF-FN)))))

;; a user call; a self call in tail position jumps to the function entry (so it sees no enclosing loop)
(defn- lw-call [M :vector-i64 h :i64 t :i64 k :i64] :vector-i64
  (let [f (lw-callee M h)
        a (lw-next M h)]
    (cond (pos? (lw-sx-slot M f)) (-> M (lw-args a t) (lw-emit OP-RT (lw-sx-slot M f) t (lw-count M a)))   ; SEEDFIX
          (lw-variadic? M f) (lw-call-var M f a t)
          (and (= f (vector-at M 92)) (= (lw-kt k) 1)) (lw-jump M a t 0)
          :else (let [n (lw-count M a)]
                  (-> M (lw-args a t) (lw-emit OP-CALL f t n) (cond-> (lw-aborts? M f) (lw-abort-check h t)))))))

(defn- lw-cap [M :vector-i64 w :i64 t :i64] :vector-i64
  (let [req (lw-next M w)
        x (lw-next M (lw-next M req))
        wire (lw-wire (lw-nf M w NF-TYPE))   ; R4B: 21-check's wire code (a wire keyword or an integer wire id)
        kind (lw-kind2 (lw-kwcode M req) (lw-kwcode M (lw-next M req)))]
    (-> M (lw-expr x t 0) (lw-emit OP-CAP wire kind t))))

;; entry points that reserve the exit label first
(defn- lw-cond0 [M :vector-i64 a :i64 t :i64 k :i64] :vector-i64
  (let [lx (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 1) (lw-cond a t k lx))))
(defn- lw-andor0 [M :vector-i64 a :i64 t :i64 k :i64 isor :i64] :vector-i64
  (let [lx (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 1) (lw-andor a t k (+ isor (* 2 lx))))))
(defn- lw-un [M :vector-i64 a :i64 t :i64 uop :i64] :vector-i64
  (-> M (lw-expr a t 0) (lw-emit OP-UN uop t)))

;; ---- constant tables: (vector-at V i) with V a vector literal of integer literals, or a def of one -> TAB ----
;; (seed/SIR OP-TAB). The table is a LIT record appended after 10-lex's string literals: LF-LEN = 8 * items, the items
;; little-endian in LITB, LF-TOK = the vector's token; 42-layout pools it like a string. No runtime allocation.
;; the vector-literal node behind v (v itself, or a def's literal: (def NAME literal), literal = 3rd child), if any.
;; R3 rung proof: [:option :i64] instead of the R0 "0 = none" convention.
(defn- lw-vlit [M :vector-i64 v :i64] [:option :i64]
  (let [res (lw-nf M v NF-RES)]
    (case (lw-nf M v NF-KIND)
      ND-VEC (option-some-of [:option :i64] v)
      ND-SYM (if (= (lw-rcls res) RES-DEF)
               (let [lit (lw-nth M (lw-first M (lw-ff M (lw-ridx res) FF-NODE)) 2)]
                 (if (= (lw-nf M lit NF-KIND) ND-VEC) (option-some-of [:option :i64] lit) (option-none-of [:option :i64])))
               (option-none-of [:option :i64]))
      (option-none-of [:option :i64]))))
;; true when the chain c has at least one item and every item is an ND-INT
(defn- lw-allint [M :vector-i64 c :i64] :bool
  (loop [x c k 0]
    (cond (zero? x) (pos? k)
          (= (lw-nf M x NF-KIND) ND-INT) (recur (lw-next M x) (inc k))
          :else false)))
;; the table node for the first operand v of a runtime head rt; none when the general RT path applies
(defn- lw-tabsel [M :vector-i64 v :i64 rt :i64] [:option :i64]
  (if (= rt RT-VECTOR-AT)
    (option-match [:option :i64] (lw-vlit M v)
      (option-none-of [:option :i64])
      w (if (lw-allint M (lw-first M w)) (option-some-of [:option :i64] w) (option-none-of [:option :i64])))
    (option-none-of [:option :i64])))
;; LITB[b .. b+8) = the 8 little-endian bytes of x (vector-assoc! writes M in place)
(defn- lw-bytes8 [M :vector-i64 b :i64 x :i64] :vector-i64
  (do (dotimes [k 8]
        (lw-put M (+ MM-LITB-BASE b k) (bit-and (u64-shift-right x (* 8 k)) 255)))
      M))
(defn- lw-tabitems [M :vector-i64 c :i64 b :i64] :vector-i64
  (if (zero? c)
    M
    (let [nx (lw-next M c)]
      (lw-tabitems (lw-bytes8 M b (lw-nf M c NF-AUX)) nx (+ b 8)))))
;; append the LIT record of table node w (m items); E101 region 2 (LIT) or 3 (LITB) when it does not fit
(defn- lw-tabdata [M :vector-i64 w :i64 m :i64] :vector-i64
  (let [lit (vector-at M MM-LIT-N)
        lb (vector-at M MM-LITB-N)
        p (+ MM-LIT-BASE (* lit MM-LIT-W))]
    (cond (>= lit MM-LIT-CAP) (lw-fail M E-HEAP-REGION -1 2)
          (> (+ lb (* 8 m)) MM-LITB-CAP) (lw-fail M E-HEAP-REGION -1 3)
          :else (-> M
                    (lw-put (+ p LF-B) lb)
                    (lw-put (+ p LF-LEN) (* 8 m))
                    (lw-put (+ p LF-TOK) (lw-nf M w NF-TOK))
                    (lw-put MM-LIT-N (inc lit))
                    (lw-put MM-LITB-N (+ lb (* 8 m)))
                    (lw-tabitems (lw-first M w) lb)))))
;; [i -> t] TAB t lit m
(defn- lw-tab [M :vector-i64 w :i64 i :i64 t :i64] :vector-i64
  (let [lit (vector-at M MM-LIT-N)
        m (lw-count M (lw-first M w))]
    (-> M (lw-tabdata w m) (lw-expr i t 0) (lw-emit OP-TAB t lit m))))
;; a runtime head over the operands from a
(defn- lw-rtcall [M :vector-i64 a :i64 t :i64 rt :i64] :vector-i64
  (option-match [:option :i64] (lw-tabsel M a rt)
    (-> M (lw-args a t) (lw-emit OP-RT rt t (lw-count M a)))
    w (lw-tab M w (lw-next M a) t)))

;; ---- R1: do, trap, records (seed/HEADS HD-DO HD-TRAP HD-RECORD-*: pair chains pair(f0, pair(f1, .. 0))) ----
;; (do e1 .. en): every ei into t, only en with the context k
(defn- lw-do [M :vector-i64 a :i64 t :i64 k :i64] :vector-i64
  (let [nx (lw-next M a)]
    (if (zero? nx)
      (lw-expr M a t k)
      (lw-do (lw-expr M a t 0) nx t k))))
;; RT PAIR-NEW at t+i .. t for i = j down to 0 (temp t+i+1 holds the rest of the chain)
(defn- lw-pairs [M :vector-i64 t :i64 j :i64] :vector-i64
  (if (neg? j)
    M
    (lw-pairs (lw-emit M OP-RT RT-PAIR-NEW (+ t j) 2) t (dec j))))
;; a record from the field values a, a', ..: [ai -> t+i] CONST t+n 0, pairs from the last field
(defn- lw-recnew [M :vector-i64 a :i64 t :i64] :vector-i64
  (let [n (lw-count M a)]
    (-> M (lw-args a t) (lw-emit OP-CONST (+ t n)) (lw-pairs t (dec n)))))
;; j times pair_second, then pair_first
(defn- lw-seconds [M :vector-i64 t :i64 j :i64] :vector-i64
  (if (pos? j)
    (lw-seconds (lw-emit M OP-RT RT-PAIR-SECOND t 1) t (dec j))
    (lw-emit M OP-RT RT-PAIR-FIRST t 1)))
;; field (NF-RES of keyword node kw) of the record expression r
(defn- lw-field [M :vector-i64 r :i64 kw :i64 t :i64] :vector-i64
  (let [j (lw-nf M kw NF-RES)]
    (-> M (lw-expr r t 0) (lw-seconds t j))))
;; (assoc r :f v): [r -> t] LSET s t, then field i into t+i (LGET + projections, or [v -> t+j]), CONST, pairs.
;; s = the hidden slot (NF-TYPE of the head node), j = NF-RES of the keyword, the field count from the record type.
;; The three numbers travel as one flat record (they were packed into one i64 in R0 style).
(defrecord lw-asf [s :i64 j :i64 v :i64])
(defn- lw-nfields [M :vector-i64 ty :i64] :i64
  (vector-at M (+ (vector-at M (+ MM-SYM-BASE (* (- ty TY-REC-BASE) MM-SYM-W) SF-REC)) RB-N)))
(defn- lw-assoc-fields [M :vector-i64 i :i64 n :i64 q [:ref :seed/lw-asf] t :i64]
  :vector-i64
  (cond (>= i n) M
        (= i (:j q)) (lw-assoc-fields (lw-expr M (:v q) (+ t i) 0) (inc i) n q t)
        :else (lw-assoc-fields (-> M (lw-emit OP-LGET (+ t i) (:s q)) (lw-seconds (+ t i) i)) (inc i) n q t)))
(defn- lw-assoc [M :vector-i64 n :i64 t :i64] :vector-i64
  (let [h (lw-first M n)
        r (lw-next M h)
        kw (lw-next M r)
        s (lw-nf M h NF-TYPE)
        nf (lw-nfields M (lw-nf M n NF-TYPE))]
    (-> M
        (lw-expr r t 0)
        (lw-emit OP-LSET s t)
        (lw-assoc-fields 0 nf (->lw-asf s (lw-nf M kw NF-RES) (lw-next M kw)) t)
        (lw-emit OP-CONST (+ t nf))
        (lw-pairs t (dec nf)))))

;; an ND-LIST expression with head code hd; h = head node, a = first argument
(defn- lw-list2 [M :vector-i64 n :i64 hd :i64 t :i64 k :i64] :vector-i64
  (let [h (lw-first M n)
        a (lw-next M h)]
    (case hd
      HD-LET (lw-let M a t k)
      HD-IF (lw-if M a t k)
      HD-LOOP (lw-loop M n t k)
      HD-RECUR (lw-jump M a t k)
      HD-CALL (lw-call M h t k)
      HD-COND (lw-cond0 M a t k)
      HD-AND (lw-andor0 M a t k 0)
      HD-OR (lw-andor0 M a t k 1)
      HD-NOT (lw-un M a t UOP-NOT)
      HD-BIT-NOT (lw-un M a t UOP-BITNOT)
      HD-TYPED-CAP-CALL (lw-cap M a t)
      HD-DO (lw-do M a t k)
      HD-TRAP (lw-emit M OP-TRAP 0)
      HD-RECORD-NEW (lw-recnew M (lw-next M a) t)
      HD-RECORD-CTOR (lw-recnew M a t)
      HD-RECORD-GET (lw-field M (lw-next M a) (lw-next M (lw-next M a)) t)
      HD-KWGET (lw-field M a h t)
      HD-ASSOC (if (= (lw-ct M (lw-nf M n NF-TYPE) CT-CTOR) TC-MAP) (lw-massoc M n a t) (lw-assoc M n t))
      HD-GET (if (= (lw-count M a) 3) (lw-gget M h a t) (lw-field M a (lw-next M a) t))
      HD-FN (lw-closure M n t)
      HD-FN-REF (-> M (lw-emit OP-FADDR t (lw-ridx (lw-nf M a NF-RES))) (lw-emit OP-CONST (inc t)) (lw-emit OP-RT RT-PAIR-NEW t 2))
      HD-CALLK (lw-callk M h t)
      HD-CALLV (lw-callv M n t)
      HD-INVOKE (lw-invoke M n t)
      HD-APPLY (lw-apply M n t)
      (HD-HOF-MAP HD-FILTER HD-REDUCE) (lw-hof M n hd t)
      HD-LIST (-> M (lw-args a t) (lw-emit OP-VEC t (lw-count M a)))
      ;; R5B: effects (seed/SIR :r5b-lowering)
      HD-ATOM (lw-expr M a t 0)
      HD-DEREF (lw-emit M OP-LGET t (lw-slot M a))
      HD-RESET (-> M (lw-expr (lw-next M a) t 0) (lw-emit OP-LSET (lw-slot M a) t))
      HD-PERFORM (lw-perform M n t)
      HD-HANDLE (let [w (lw-next M a)
                      sl (lw-nf M h NF-TYPE)]
                  (-> M (lw-expr (lw-nth M (lw-first M w) 2) t 0) (lw-emit OP-LSET sl t) (lw-expr a t 0)))
      HD-RESUME (-> M (lw-expr a t 0) (lw-expr (lw-next M a) (inc t) 0) (lw-emit OP-RET2 t))
      HD-SCALL (lw-scall M h t k)
      HD-R6-AS (lw-expr M (lw-next M a) t 0)   ; R6B: a retyping, no code
      HD-R6-IS (lw-expr M (lw-next M a) t 0)   ; R6B: a type assertion, no code
      (cond (and (>= hd HD-OPTION-SOME) (<= hd HD-POP)) (lw-r3 M n hd t k)
            (= hd lw-r6m-hd-vnew) (lw-r6m-vnew M n t)   ; R6M
            (= hd lw-r6m-hd-vmatch) (lw-r6m-vmatch M n t k)   ; R6M
            :else (lw-fail M E-LOWER-NODE (lw-pos M n) hd)))))

;; R6M (agent SEEDLANG, 2026-10-04): variants (21-check ck-r6m-*: NF-RES codes 3001 / 3002; a variant is pair(tag index,
;; payload); the tag node of a variant-new / of each clause carries NF-RES = index + 1).
(def lw-r6m-hd-vnew 3001)
(def lw-r6m-hd-vmatch 3002)
;; (variant-new T :tag x): [i -> t] [x -> t+1] RT pair_new t 2
(defn- lw-r6m-vnew [M :vector-i64 n :i64 t :i64] :vector-i64
  (let [tg (lw-next M (lw-next M (lw-first M n)))
        x (lw-next M tg)]
    (-> M (lw-emit OP-CONST t (dec (lw-nf M tg NF-RES))) (lw-expr x (inc t) 0) (lw-emit OP-RT RT-PAIR-NEW t 2))))
;; (match-variant v T c ..): v into the hidden slot s (NF-TYPE of the head); per clause (:tag x body): the tag compare, the
;; payload into x's slot, the body, a jump to the end; no clause matching = brk
(defn- lw-r6m-vmatch [M :vector-i64 n :i64 t :i64 k :i64] :vector-i64
  (let [h (lw-first M n)
        s (lw-nf M h NF-TYPE)
        v (lw-next M h)
        c0 (lw-next M (lw-next M v))
        nc (lw-count M c0)
        l (vector-at M MM-LABEL-N)
        M1 (-> M (lw-labels (inc nc)) (lw-expr v t 0) (lw-emit OP-LSET s t))]
    (loop [M2 M1 c c0 i 0]
      (if (zero? c)
        (-> M2 (lw-emit OP-TRAP 0) (lw-emit OP-LABEL (+ l nc)))
        (let [tg (lw-first M2 c)
              x (lw-next M2 tg)
              body (lw-next M2 x)]
          (recur (-> M2 (lw-emit OP-LGET t s) (lw-emit OP-RT RT-PAIR-FIRST t 1) (lw-emit OP-CONST (inc t) (dec (lw-nf M2 tg NF-RES)))
                     (lw-emit OP-CMP CC-EQ t) (lw-emit OP-BRZ t (+ l i))
                     (lw-emit OP-LGET t s) (lw-emit OP-RT RT-PAIR-SECOND t 1) (lw-emit OP-LSET (lw-slot M2 x) t)
                     (lw-expr body t k) (lw-emit OP-BR (+ l nc)) (lw-emit OP-LABEL (+ l i)))
                 (lw-next M2 c) (inc i)))))))

;; FLOAT (agent FLOAT, rung r6j): a float operation (21-check ck-fl-*: NF-RES = ck-fl-base + kind * 256 + code) is one
;; SIR instruction over its operands: kind 1 [a -> t] [b -> t+1] BIN code t, 2 the same with CMP, 3 [a -> t] UN code t.
(defn- lw-fl [M :vector-i64 a :i64 t :i64 hd :i64] :vector-i64
  (let [kind (quot (- hd ck-fl-base) 256)
        code (- (- hd ck-fl-base) (* kind 256))]
    (case kind
      1 (-> M (lw-args a t) (lw-emit OP-BIN code t))
      2 (-> M (lw-args a t) (lw-emit OP-CMP code t))
      4 (lw-rtcall M a t (* code 8))   ; R6L (FOLD): a loader runtime call (21-check kind 4: __r6-kgput 80, __r6-kgget 88)
      (-> M (lw-expr a t 0) (lw-emit OP-UN code t)))))

(defn- lw-list [M :vector-i64 n :i64 t :i64 k :i64] :vector-i64
  (let [hd (lw-nf M n NF-RES)
        a (lw-next M (lw-first M n))
        bop (lw-bop hd)
        cc (lw-cc hd)
        rt (lw-rt hd)]
    (cond
      (>= hd ck-fl-base) (lw-fl M a t hd)   ; FLOAT
      (pos? bop) (let [nx (lw-next M a)] (lw-fold (lw-expr M a t 0) nx t bop))
      (pos? cc) (-> M (lw-args a t) (lw-emit OP-CMP cc t))
      (pos? rt) (lw-rtcall M a t rt)
      :else (lw-list2 M n hd t k))))

(defn- lw-sym [M :vector-i64 n :i64 t :i64] :vector-i64
  (let [res (lw-nf M n NF-RES)]
    (case (lw-rcls res)
      RES-LOCAL (lw-emit M OP-LGET t (lw-ridx res))
      RES-CONST (lw-emit M OP-CONST t (lw-ridx res))
      ;; a def reference evaluates the def's literal again (seed/SIR); (def NAME literal): literal = 3rd child
      RES-DEF (lw-expr M (lw-nth M (lw-first M (lw-ff M (lw-ridx res) FF-NODE)) 2) t 0)
      (lw-fail M E-LOWER-NODE (lw-pos M n) ND-SYM))))

;; ==== R6A (agent R6A, rung R6 entry: keywords across modules) ======================================================
;; The run-time value of a keyword is the 64-bit FNV-1a hash of its spelling (SF-HASH of its symbol, 20-names), not its SYM
;; index: a SYM index is private to one module's compile, so a keyword passed across a module boundary (an interface typed
;; :keyword, a record field) would compare unequal to the same keyword spelled by the importer. The hash is a function of
;; the text alone, so every module (and the separate-mode objects) agree without a link-time table. A synthetic keyword
;; (a gensym, SF-HASH 0) keeps its SYM index; none is ever lowered as a value.
(defn- lw-kwval [M :vector-i64 s :i64] :i64
  (let [h (vector-at M (+ MM-SYM-BASE (* s MM-SYM-W) SF-HASH))] (if (= h 0) s h)))
;; ==== END R6A ======================================================================================================

(defn- lw-expr [M :vector-i64 n :i64 t :i64 k :i64] :vector-i64
  (let [aux (lw-nf M n NF-AUX)
        kind (lw-nf M n NF-KIND)]
    (case kind
      ND-LIST (lw-list M n t k)
      ND-SYM (lw-sym M n t)
      ND-INT (lw-emit M OP-CONST t aux)
      ND-STR (lw-emit M OP-STR t aux)
      ND-KW (lw-emit M OP-CONST t (lw-kwval M (lw-nf M n NF-SYM)))   ; R6A: a keyword's value is its spelling's hash
      ND-VEC (let [a (lw-first M n)
                   m (lw-count M a)]
               (if (> m 64)
                 ;; R4B: 65..128 integer literals (21-check): the items as a constant table, copied into a fresh vector
                 (let [lit (vector-at M MM-LIT-N)] (-> M (lw-tabdata n m) (lw-emit OP-VECP t lit m)))
                 (-> M (lw-args a t) (lw-emit OP-VEC t m))))
      (ND-SET ND-MAP) (lw-newcoll M (lw-first M n) (lw-nf M n NF-SYM) (lw-md M (lw-nf M n NF-TYPE)) t)
      (lw-fail M E-LOWER-NODE (if (zero? n) -1 (lw-pos M n)) kind))))

;; ------------------------------------------------------------------------------------------------------------
;; functions and the program
;; ------------------------------------------------------------------------------------------------------------
(defn- lw-set-ff [M :vector-i64 f :i64 fld :i64 v :i64] :vector-i64
  (lw-put M (+ MM-FN-BASE (* f MM-FN-W) fld) v))

;; (defn NAME [params] :R body): body = 5th child. Scratch cells 92 = f, 93 = its entry label, 94 = deepest temp.
(defn- lw-fn [M :vector-i64 f :i64] :vector-i64
  (case (lw-ff M f FF-KIND)
    FK-ADAPTER (lw-adapter M f)
    FK-LAMBDA (lw-fn2 M f (lw-nth M (lw-first M (lw-ff M f FF-NODE)) 2))
    (lw-fn2 M f (lw-nth M (lw-first M (lw-ff M f FF-NODE)) 4))))
(defn- lw-fn2 [M :vector-i64 f :i64 body :i64] :vector-i64
  (let [
        le (vector-at M MM-LABEL-N)
        sirn (vector-at M MM-SIR-N)
        np (lw-ff M f FF-NPARAMS)
        ns (lw-ff M f FF-NSLOTS)
        fuel (lw-sx-entry M f)   ; SEEDFIX: FF-FUEL, or machine_ir's rule on the KIR route
        M1 (-> M
               (lw-labels 1)
               (lw-put 92 f)
               (lw-put 93 le)
               (lw-put 94 -1)
               (lw-set-ff f FF-SIR sirn)
               (lw-emit OP-FN f np ns)
               (cond-> (= fuel 1) (lw-emit OP-FUEL 0))
               (lw-emit OP-LABEL le)
               (lw-put 95 0)
               (lw-expr body 0 (lw-kmk 1 0 0))
               (cond-> (lw-aborts? M f) (-> (lw-emit OP-CONST 1) (lw-emit OP-RT RT-PAIR-NEW 0 2)))
               ;; R5B: a specialization returns (value, state): x1 := slot 1
               (cond-> (lw-spec? M f) (-> (lw-emit OP-LGET 1 1) (lw-emit OP-RET2 0))
                       (not (lw-spec? M f)) (lw-emit OP-RET 0))
               (lw-emit OP-END f))]
    (lw-set-ff M1 f FF-DEPTH (inc (vector-at M1 94)))))

(defn- lw-fns [M :vector-i64 f :i64] :vector-i64
  (let [lim (if (zero? (vector-at M MM-ERR)) (vector-at M MM-FN-N) 0)]
    (cond (>= f lim) M
          (= (lw-ff M f FF-KIND) FK-DEF) (lw-fns M (inc f))
          (lw-tmpl? M f) (lw-fns M (inc f))   ; R5B: a stateful defn has no code of its own (its specializations do)
          :else (lw-fns (lw-fn M f) (inc f)))))

(defn- lw-run [M :vector-i64] :vector-i64
  (let [M1 (lw-fns (lw-sx-exports M 1) 1)   ; SEEDFIX: late exports of the KIR route
        nl (vector-at M1 MM-LABEL-N)
        ns (vector-at M1 MM-SIR-N)]
    (-> M1
        (lw-put MM-R0 (dec ns))
        (cond-> (>= nl MM-LABEL-CAP) (lw-fail E-LOWER-FULL -1 0)))))

;; ============================================================================================================
;; R3 (agent R3, 2026-10-03): values (seed/HEADS 76-130, seed/SIR :r3-lowering). No new SIR opcode: everything
;; lowers to CONST LGET LSET BIN CMP UN LABEL BR BRZ BRNZ CALL RT VEC TRAP RET. Representation (seed/HEADS TY-COMP-BASE):
;; option = 0 or pair(x, 0); result = pair(payload, tag) with tag 0 ok / 1 err; list = vector; set = vector of distinct
;; items sorted by key; map = vector k0 v0 k1 v1 .. of distinct keys sorted by key (the reference's canonical order).
;; Sets and maps are walked by inline loops (no FUEL inside them) over hidden frame slots
;; that 21-check reserved: s = NF-TYPE of the head symbol node (NF-SYM of an ND-SET / ND-MAP literal), then s+1, ..
;; Abort (lang/abort-ability.edn): an aborting function returns pair(value, 0) or pair(error, 1); M[95] = the
;; innermost try being lowered (handler label * 256 + the catch binder's slot), 0 outside every try body.
;; ============================================================================================================
;; field fld of the CT record of composite type ty (0 for any other type)
(defn- lw-ct [M :vector-i64 ty :i64 fld :i64] :i64
  (if (< ty TY-COMP-BASE) 0 (vector-at M (+ (vector-at M MM-CT) (* (- ty TY-COMP-BASE) CT-W) fld))))
;; true when FN f aborts (SF-ABORT of its symbol, 21-check)
(defn- lw-aborts? [M :vector-i64 f :i64] :bool
  (not (zero? (vector-at M (+ MM-SYM-BASE (* (lw-ff M f FF-SYM) MM-SYM-W) SF-ABORT)))))
;; the walk mode of a set or map type: stride (1 set, 2 map) + 4 when the items/keys are strings + 8 when map values are
(defn- lw-md [M :vector-i64 ty :i64] :i64
  (let [map? (= (lw-ct M ty CT-CTOR) TC-MAP)]
    (+ (if map? 2 1) (if (lw-strty? (lw-ct M ty CT-A)) 4 0) (if (and map? (lw-strty? (lw-ct M ty CT-B))) 8 0))))
;; R6B: types whose run-time value is a string (a :document is its canonical text, a :symbol its text): compared by content
(defn- lw-strty? [t :i64] :bool (or (= t TY-STR) (= t TY-DOC) (= t TY-SYM)))
(defn- lw-b0 [p :i64] :i64 (bit-and p 255))
(defn- lw-b1 [p :i64] :i64 (bit-and (u64-shift-right p 8) 255))
(defn- lw-b2 [p :i64] :i64 (bit-and (u64-shift-right p 16) 255))
(defn- lw-p3 [a :i64 b :i64 c :i64] :i64 (+ a (* 256 b) (* 65536 c)))

;; temp t := (temp t = temp t+1): by bytes for strings, else by value
(defn- lw-eq [M :vector-i64 str? :bool t :i64] :vector-i64
  (if str? (lw-emit M OP-RT RT-STRING-EQUAL t 2) (lw-emit M OP-CMP CC-EQ t)))
;; slot i += w (through temps t, t+1)
(defn- lw-step [M :vector-i64 i :i64 w :i64 t :i64] :vector-i64
  (-> M (lw-emit OP-LGET t i) (lw-emit OP-CONST (inc t) w) (lw-emit OP-BIN BOP-ADD t) (lw-emit OP-LSET i t)))
;; temp t := the count of the map in temp t (its vector holds two words per entry)
(defn- lw-halve [M :vector-i64 t :i64] :vector-i64
  (-> M (lw-emit OP-CONST (inc t) 1) (lw-emit OP-BIN BOP-USHR t)))
;; temp t := conj(temp t, item (slot i) + off of the vector in slot c)
(defn- lw-copy1 [M :vector-i64 c :i64 i :i64 off :i64 t :i64] :vector-i64
  (-> M (lw-emit OP-LGET (inc t) c) (lw-emit OP-LGET (+ t 2) i)
      (cond-> (pos? off) (-> (lw-emit OP-CONST (+ t 3) off) (lw-emit OP-BIN BOP-ADD (+ t 2))))
      (lw-emit OP-RT RT-VECTOR-AT (inc t) 2) (lw-emit OP-RT RT-VECTOR-CONJ t 2)))

;; temp t := the index of the value in slot x within the vector in slot c, stepping by the stride of md, or -1.
;; sp = lw-p3 c x w; afterwards slot w = the vector's count and slot w+1 = the index.
(defn- lw-scan [M :vector-i64 sp :i64 md :i64 t :i64] :vector-i64
  (let [c (lw-b0 sp) x (lw-b1 sp) n (lw-b2 sp) i (inc (lw-b2 sp))
        l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 3)
        (lw-emit OP-LGET t c) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (lw-emit OP-LSET n t)
        (lw-emit OP-CONST t) (lw-emit OP-LSET i t)
        (lw-emit OP-LABEL l)
        (lw-emit OP-LGET t i) (lw-emit OP-LGET (inc t) n) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t (+ l 1))
        (lw-emit OP-LGET t c) (lw-emit OP-LGET (inc t) i) (lw-emit OP-RT RT-VECTOR-AT t 2)
        (lw-emit OP-LGET (inc t) x) (lw-eq (= (bit-and md 4) 4) t) (lw-emit OP-BRNZ t (+ l 2))
        (lw-step i (bit-and md 3) t) (lw-emit OP-BR l)
        (lw-emit OP-LABEL (+ l 1)) (lw-emit OP-CONST t -1) (lw-emit OP-LSET i t)
        (lw-emit OP-LABEL (+ l 2)) (lw-emit OP-LGET t i))))

;; temp t := item (slot i) of the vector in slot s
(defn- lw-item [M :vector-i64 s :i64 i :i64 t :i64] :vector-i64
  (-> M (lw-emit OP-LGET t s) (lw-emit OP-LGET (inc t) i) (lw-emit OP-RT RT-VECTOR-AT t 2)))
;; temp t := (temp t < temp t+1): byte order for strings, else signed (bool: false < true; keyword: interning order)
(defn- lw-lt [M :vector-i64 str? :bool t :i64] :vector-i64
  (if str?
    (-> M (lw-emit OP-RT RT-STRING-COMPARE t 2) (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-LT t))
    (lw-emit M OP-CMP CC-LT t)))
;; insert the item/key in slot s+1 (a map: with the value in slot s+4) into the sorted set/map in slot s, at its place
;; in key order (the reference keeps typed sets and maps sorted: lang/guest-grammar.edn :map-literal :order). Present:
;; a set keeps it, a map replaces the value, a map constructor (md bit 32) traps (a duplicate key). A set holds at most
;; 32 items, a map 31 entries: one more traps. Slots s+2 n, s+3 i, s+5 the new vector, s+6 j.
(defn- lw-ins [M :vector-i64 s :i64 md :i64 t :i64] :vector-i64
  (let [x (+ s 1) n (+ s 2) i (+ s 3) v (+ s 4) nv (+ s 5) j (+ s 6) w (bit-and md 3) str? (= (bit-and md 4) 4)
        l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 8)
        (lw-emit OP-LGET t s) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (lw-emit OP-LSET n t)
        (lw-emit OP-CONST t) (lw-emit OP-LSET i t)
        ;; l: find the first item >= x
        (lw-emit OP-LABEL l)
        (lw-emit OP-LGET t i) (lw-emit OP-LGET (inc t) n) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t (+ l 2))
        (lw-item s i t) (lw-emit OP-LGET (inc t) x) (lw-eq str? t) (lw-emit OP-BRNZ t (+ l 1))
        (lw-item s i t) (lw-emit OP-LGET (inc t) x) (lw-lt str? t) (lw-emit OP-BRZ t (+ l 2))
        (lw-step i w t) (lw-emit OP-BR l)
        ;; l+1: present at i
        (lw-emit OP-LABEL (+ l 1))
        (cond-> (= (bit-and md 32) 32) (lw-emit OP-TRAP 0)
                (and (zero? (bit-and md 32)) (= w 2))
                (-> (lw-emit OP-LGET t s) (lw-emit OP-LGET (inc t) i) (lw-emit OP-CONST (+ t 2) 1)
                    (lw-emit OP-BIN BOP-ADD (inc t)) (lw-emit OP-LGET (+ t 2) v) (lw-emit OP-RT RT-VECTOR-ASSOC t 3)
                    (lw-emit OP-LSET s t)))
        (lw-emit OP-BR (+ l 6))
        ;; l+2: insert at i (room left, else trap), copying the items around it
        (lw-emit OP-LABEL (+ l 2))
        (lw-emit OP-LGET t n) (lw-emit OP-CONST (inc t) (if (= w 2) 62 32)) (lw-emit OP-CMP CC-LT t)
        (lw-emit OP-BRNZ t (+ l 5)) (lw-emit OP-TRAP 0)
        (lw-emit OP-LABEL (+ l 5))
        (lw-emit OP-VEC t) (lw-emit OP-LSET nv t) (lw-emit OP-CONST t) (lw-emit OP-LSET j t)
        (lw-emit OP-LABEL (+ l 3))
        (lw-emit OP-LGET t j) (lw-emit OP-LGET (inc t) i) (lw-emit OP-CMP CC-EQ t) (lw-emit OP-BRZ t (+ l 4))
        (lw-emit OP-LGET t nv) (lw-emit OP-LGET (inc t) x) (lw-emit OP-RT RT-VECTOR-CONJ t 2)
        (cond-> (= w 2) (-> (lw-emit OP-LGET (inc t) v) (lw-emit OP-RT RT-VECTOR-CONJ t 2)))
        (lw-emit OP-LSET nv t)
        (lw-emit OP-LABEL (+ l 4))
        (lw-emit OP-LGET t j) (lw-emit OP-LGET (inc t) n) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t (+ l 7))
        (lw-emit OP-LGET t nv) (lw-copy1 s j 0 t) (cond-> (= w 2) (lw-copy1 s j 1 t)) (lw-emit OP-LSET nv t)
        (lw-step j w t) (lw-emit OP-BR (+ l 3))
        (lw-emit OP-LABEL (+ l 7)) (lw-emit OP-LGET t nv) (lw-emit OP-LSET s t)
        (lw-emit OP-LABEL (+ l 6)))))
;; set/map: remove the item/key in slot x from the collection in slot c (sp = lw-p3 c x w; slots w, w+1, w+3): a copy
;; of the other items/entries, or the collection itself when absent
(defn- lw-sdel [M :vector-i64 sp :i64 md :i64 t :i64] :vector-i64
  (let [c (lw-b0 sp) x (lw-b1 sp) n (lw-b2 sp) i (inc n) nv (+ n 3) w (bit-and md 3)
        l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 4) (lw-scan sp md t)
        (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRNZ t (+ l 3))
        (lw-emit OP-LGET t i) (lw-emit OP-LSET x t)
        (lw-emit OP-VEC t) (lw-emit OP-LSET nv t) (lw-emit OP-CONST t) (lw-emit OP-LSET i t)
        (lw-emit OP-LABEL l)
        (lw-emit OP-LGET t i) (lw-emit OP-LGET (inc t) n) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t (+ l 2))
        (lw-emit OP-LGET t i) (lw-emit OP-LGET (inc t) x) (lw-emit OP-CMP CC-EQ t) (lw-emit OP-BRNZ t (+ l 1))
        (lw-emit OP-LGET t nv) (lw-copy1 c i 0 t) (cond-> (= w 2) (lw-copy1 c i 1 t)) (lw-emit OP-LSET nv t)
        (lw-emit OP-LABEL (+ l 1))
        (lw-step i w t) (lw-emit OP-BR l)
        (lw-emit OP-LABEL (+ l 2)) (lw-emit OP-LGET t nv) (lw-emit OP-LSET c t)
        (lw-emit OP-LABEL (+ l 3)))))

;; add the items (set) or key/value pairs (map) of chain c to the collection in slot s (slots s+1 .. s+6)
(defn- lw-adds [M :vector-i64 c :i64 s :i64 md :i64 t :i64] :vector-i64
  (cond (zero? c) M
        (= (bit-and md 3) 2)
        (let [v (lw-next M c)
              nx (lw-next M v)]
          (lw-adds (-> M (lw-expr c t 0) (lw-emit OP-LSET (+ s 1) t) (lw-expr v t 0) (lw-emit OP-LSET (+ s 4) t)
                       (lw-ins s md t))
                   nx s md t))
        :else
        (let [nx (lw-next M c)]
          (lw-adds (-> M (lw-expr c t 0) (lw-emit OP-LSET (+ s 1) t) (lw-ins s md t)) nx s md t))))
;; remove the items/keys of chain c from the collection in slot s (slots s+1 .. s+5)
(defn- lw-dels [M :vector-i64 c :i64 s :i64 md :i64 t :i64] :vector-i64
  (if (zero? c)
    M
    (let [nx (lw-next M c)]
      (lw-dels (-> M (lw-expr c t 0) (lw-emit OP-LSET (+ s 1) t) (lw-sdel (lw-p3 s (+ s 1) (+ s 2)) md t)) nx s md t))))
;; a new set/map from the items/pairs of chain c (#{..}, {..}, typed-set-new, typed-map-new): a duplicate map key traps
(defn- lw-newcoll [M :vector-i64 c :i64 s :i64 md :i64 t :i64] :vector-i64
  (-> M (lw-emit OP-VEC t) (lw-emit OP-LSET s t) (lw-adds c s (if (= (bit-and md 3) 2) (+ md 32) md) t)
      (lw-emit OP-LGET t s)))
;; [e -> slot s], then add (md < 16) or remove (md + 16) the items/pairs that follow e; temp t := the result
(defn- lw-upd [M :vector-i64 e :i64 s :i64 md :i64 t :i64] :vector-i64
  (-> M (lw-expr e t 0) (lw-emit OP-LSET s t)
      (cond-> (< md 16) (lw-adds (lw-next M e) s md t)
              (>= md 16) (lw-dels (lw-next M e) s (- md 16) t))
      (lw-emit OP-LGET t s)))
;; membership of the expression after e in the set/map e: bool
(defn- lw-has [M :vector-i64 e :i64 s :i64 md :i64 t :i64] :vector-i64
  (-> M (lw-expr e t 0) (lw-emit OP-LSET s t) (lw-expr (lw-next M e) t 0) (lw-emit OP-LSET (+ s 1) t)
      (lw-scan (lw-p3 s (+ s 1) (+ s 2)) md t) (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-GE t)))
;; temp t := the value at index (slot s+3) + 1 of the map in slot s
(defn- lw-mval [M :vector-i64 s :i64 t :i64] :vector-i64
  (-> M (lw-emit OP-LGET t s) (lw-emit OP-LGET (inc t) (+ s 3)) (lw-emit OP-CONST (+ t 2) 1)
      (lw-emit OP-BIN BOP-ADD (inc t)) (lw-emit OP-RT RT-VECTOR-AT t 2)))
;; (typed-map-get Mt m k) -> [:option V]
(defn- lw-mget [M :vector-i64 e :i64 s :i64 md :i64 t :i64] :vector-i64
  (let [l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 2)
        (lw-expr e t 0) (lw-emit OP-LSET s t) (lw-expr (lw-next M e) t 0) (lw-emit OP-LSET (+ s 1) t)
        (lw-scan (lw-p3 s (+ s 1) (+ s 2)) md t)
        (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t l)
        (lw-emit OP-CONST t) (lw-emit OP-BR (inc l))
        (lw-emit OP-LABEL l) (lw-mval s t) (lw-emit OP-CONST (inc t)) (lw-emit OP-RT RT-PAIR-NEW t 2)
        (lw-emit OP-LABEL (inc l)))))
;; (get m k d) on a map: the value of k, or d (slot s+4 holds d)
(defn- lw-gget [M :vector-i64 h :i64 a :i64 t :i64] :vector-i64
  (let [s (lw-nf M h NF-TYPE)
        kx (lw-next M a)
        md (lw-md M (lw-nf M a NF-TYPE))
        l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 2)
        (lw-expr a t 0) (lw-emit OP-LSET s t) (lw-expr kx t 0) (lw-emit OP-LSET (+ s 1) t)
        (lw-expr (lw-next M kx) t 0) (lw-emit OP-LSET (+ s 4) t)
        (lw-scan (lw-p3 s (+ s 1) (+ s 2)) md t)
        (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t l)
        (lw-emit OP-LGET t (+ s 4)) (lw-emit OP-BR (inc l))
        (lw-emit OP-LABEL l) (lw-mval s t)
        (lw-emit OP-LABEL (inc l)))))
;; (assoc m k v) on a map
(defn- lw-massoc [M :vector-i64 n :i64 a :i64 t :i64] :vector-i64
  (lw-upd M a (lw-nf M (lw-first M n) NF-TYPE) (lw-md M (lw-nf M n NF-TYPE)) t))

;; slot s+3 := a new vector of the items off, off + w, .. below (slot s+1) of the vector in slot s; temp t := it.
;; ow = 4 * off + w.
(defn- lw-proj [M :vector-i64 s :i64 ow :i64 t :i64] :vector-i64
  (let [off (quot ow 4) w (bit-and ow 3) n (+ s 1) i (+ s 2) nv (+ s 3) l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 2)
        (lw-emit OP-VEC t) (lw-emit OP-LSET nv t) (lw-emit OP-CONST t) (lw-emit OP-LSET i t)
        (lw-emit OP-LABEL l)
        (lw-emit OP-LGET t i) (lw-emit OP-LGET (inc t) n) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t (inc l))
        (lw-emit OP-LGET t nv) (lw-copy1 s i off t) (lw-emit OP-LSET nv t)
        (lw-step i w t) (lw-emit OP-BR l)
        (lw-emit OP-LABEL (inc l)) (lw-emit OP-LGET t nv))))
;; keys (off 0) or vals (off 1) of the map e
(defn- lw-kv [M :vector-i64 e :i64 s :i64 off :i64 t :i64] :vector-i64
  (-> M (lw-expr e t 0) (lw-emit OP-LSET s t) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (lw-emit OP-LSET (+ s 1) t)
      (lw-proj s (+ (* 4 off) 2) t)))
;; (pop v): all items but the last; an empty vector traps
(defn- lw-pop [M :vector-i64 e :i64 s :i64 t :i64] :vector-i64
  (let [l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 1)
        (lw-expr e t 0) (lw-emit OP-LSET s t) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (lw-emit OP-CONST (inc t) 1)
        (lw-emit OP-BIN BOP-SUB t) (lw-emit OP-LSET (+ s 1) t) (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-LT t)
        (lw-emit OP-BRZ t l) (lw-emit OP-TRAP 0)
        (lw-emit OP-LABEL l) (lw-proj s 1 t))))
;; (peek v): the last item (an empty vector traps in vector_at)
(defn- lw-peek [M :vector-i64 e :i64 s :i64 t :i64] :vector-i64
  (-> M (lw-expr e t 0) (lw-emit OP-LSET s t) (lw-emit OP-LGET (inc t) s) (lw-emit OP-RT RT-VECTOR-COUNT (inc t) 1)
      (lw-emit OP-CONST (+ t 2) 1) (lw-emit OP-BIN BOP-SUB (inc t)) (lw-emit OP-RT RT-VECTOR-AT t 2)))
;; (nth c i d): item i of the vector/list c when 0 <= i < count, else d (slots s, s+1, s+2)
(defn- lw-nthd [M :vector-i64 e :i64 s :i64 t :i64] :vector-i64
  (let [i (lw-next M e) l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 2)
        (lw-expr e t 0) (lw-emit OP-LSET s t) (lw-expr i t 0) (lw-emit OP-LSET (+ s 1) t)
        (lw-expr (lw-next M i) t 0) (lw-emit OP-LSET (+ s 2) t)
        (lw-emit OP-LGET t (+ s 1)) (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRNZ t l)
        (lw-emit OP-LGET t (+ s 1)) (lw-emit OP-LGET (inc t) s) (lw-emit OP-RT RT-VECTOR-COUNT (inc t) 1)
        (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t l)
        (lw-emit OP-LGET t s) (lw-emit OP-LGET (inc t) (+ s 1)) (lw-emit OP-RT RT-VECTOR-AT t 2) (lw-emit OP-BR (inc l))
        (lw-emit OP-LABEL l) (lw-emit OP-LGET t (+ s 2))
        (lw-emit OP-LABEL (inc l)))))
;; temp t := (value at index (slot s+3) + 1 of the map in slot s) = (value at index (slot s+6) + 1 of the map in slot s+1)
(defn- lw-eqval [M :vector-i64 s :i64 str? :bool t :i64] :vector-i64
  (-> M (lw-mval s t)
      (lw-emit OP-LGET (inc t) (+ s 1)) (lw-emit OP-LGET (+ t 2) (+ s 6)) (lw-emit OP-CONST (+ t 3) 1)
      (lw-emit OP-BIN BOP-ADD (+ t 2)) (lw-emit OP-RT RT-VECTOR-AT (inc t) 2)
      (lw-eq str? t)))
;; equality of the sets/maps in slots s and s+1 (slots s .. s+6): same count, every item/key of the first in the
;; second (maps: with an equal value). Order does not matter.
(defn- lw-equal [M :vector-i64 s :i64 md :i64 t :i64] :vector-i64
  (let [n (+ s 2) i (+ s 3) x (+ s 4) w (bit-and md 3) l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 4)
        (lw-emit OP-LGET t s) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (lw-emit OP-LSET n t)
        (lw-emit OP-LGET t (inc s)) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (lw-emit OP-LGET (inc t) n)
        (lw-emit OP-CMP CC-EQ t) (lw-emit OP-BRZ t (+ l 2))
        (lw-emit OP-CONST t) (lw-emit OP-LSET i t)
        (lw-emit OP-LABEL l)
        (lw-emit OP-LGET t i) (lw-emit OP-LGET (inc t) n) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t (+ l 1))
        (lw-emit OP-LGET t s) (lw-emit OP-LGET (inc t) i) (lw-emit OP-RT RT-VECTOR-AT t 2) (lw-emit OP-LSET x t)
        (lw-scan (lw-p3 (inc s) x (+ s 5)) (bit-and md 7) t)
        (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRNZ t (+ l 2))
        (cond-> (= w 2) (-> (lw-eqval s (> md 7) t) (lw-emit OP-BRZ t (+ l 2))))
        (lw-step i w t) (lw-emit OP-BR l)
        (lw-emit OP-LABEL (+ l 1)) (lw-emit OP-CONST t 1) (lw-emit OP-BR (+ l 3))
        (lw-emit OP-LABEL (+ l 2)) (lw-emit OP-CONST t)
        (lw-emit OP-LABEL (+ l 3)))))

;; ---- options, results ----
;; [e -> t] CONST t+1 tag RT PAIR-NEW: option-some (tag 0), result ok (0) / err (1)
(defn- lw-wrap [M :vector-i64 e :i64 tag :i64 t :i64] :vector-i64
  (-> M (lw-expr e t 0) (lw-emit OP-CONST (inc t) tag) (lw-emit OP-RT RT-PAIR-NEW t 2)))
;; the payload of the option/result e, or the default after e (slots s, s+1). mode 0 option (none -> default),
;; 1 result value (err -> default), 2 result error (ok -> default)
(defn- lw-pick [M :vector-i64 e :i64 s :i64 mode :i64 t :i64] :vector-i64
  (let [l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 2)
        (lw-expr e t 0) (lw-emit OP-LSET s t) (lw-expr (lw-next M e) t 0) (lw-emit OP-LSET (inc s) t)
        (lw-emit OP-LGET t s)
        (cond-> (pos? mode) (lw-emit OP-RT RT-PAIR-SECOND t 1))
        (lw-emit (if (= mode 1) OP-BRNZ OP-BRZ) t l)
        (lw-emit OP-LGET t s) (lw-emit OP-RT RT-PAIR-FIRST t 1) (lw-emit OP-BR (inc l))
        (lw-emit OP-LABEL l) (lw-emit OP-LGET t (inc s))
        (lw-emit OP-LABEL (inc l)))))
;; (option-match T o none-body x some-body); a = the type argument
(defn- lw-omatch [M :vector-i64 a :i64 t :i64 k :i64] :vector-i64
  (let [o (lw-next M a)
        nb (lw-next M o)
        x (lw-next M nb)
        sx (lw-slot M x)
        l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 2)
        (lw-expr o t 0) (lw-emit OP-LSET sx t) (lw-emit OP-BRZ t l)
        (lw-emit OP-LGET t sx) (lw-emit OP-RT RT-PAIR-FIRST t 1) (lw-emit OP-LSET sx t)
        (lw-expr (lw-next M x) t k) (lw-emit OP-BR (inc l))
        (lw-emit OP-LABEL l) (lw-expr nb t k)
        (lw-emit OP-LABEL (inc l)))))
;; (result-match-of R r v ok-body e err-body); a = the type argument
(defn- lw-rmatch [M :vector-i64 a :i64 t :i64 k :i64] :vector-i64
  (let [r (lw-next M a)
        v (lw-next M r)
        ob (lw-next M v)
        e (lw-next M ob)
        sv (lw-slot M v)
        l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 2)
        (lw-expr r t 0) (lw-emit OP-LSET sv t) (lw-emit OP-RT RT-PAIR-SECOND t 1) (lw-emit OP-BRNZ t l)
        (lw-emit OP-LGET t sv) (lw-emit OP-RT RT-PAIR-FIRST t 1) (lw-emit OP-LSET sv t)
        (lw-expr ob t k) (lw-emit OP-BR (inc l))
        (lw-emit OP-LABEL l) (lw-emit OP-LGET t sv) (lw-emit OP-RT RT-PAIR-FIRST t 1) (lw-emit OP-LSET (lw-slot M e) t)
        (lw-expr (lw-next M e) t k)
        (lw-emit OP-LABEL (inc l)))))

;; ---- abort ----
;; (throw e): outside a try body the function returns err(e); inside one: catch binder := e, jump to the handler
(defn- lw-throw [M :vector-i64 e :i64 t :i64] :vector-i64
  (let [c (vector-at M 95)]
    (if (zero? c)
      (-> M (lw-wrap e 1 t) (lw-emit OP-RET t))
      (-> M (lw-expr e t 0) (lw-emit OP-LSET (bit-and c 255) t) (lw-emit OP-BR (quot c 256))))))
;; after CALL of an aborting function into t (hidden slot = NF-TYPE of the head node h): an err result is re-raised as
;; it is (outside a try body) or goes to the handler; an ok result is unwrapped
(defn- lw-abort-check [M :vector-i64 h :i64 t :i64] :vector-i64
  (let [hs (lw-nf M h NF-TYPE)
        c (vector-at M 95)
        l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 1)
        (lw-emit OP-LSET hs t) (lw-emit OP-RT RT-PAIR-SECOND t 1) (lw-emit OP-BRZ t l)
        (lw-emit OP-LGET t hs)
        (cond-> (zero? c) (lw-emit OP-RET t)
                (pos? c) (-> (lw-emit OP-RT RT-PAIR-FIRST t 1) (lw-emit OP-LSET (bit-and c 255) t)
                             (lw-emit OP-BR (quot c 256))))
        (lw-emit OP-LABEL l) (lw-emit OP-LGET t hs) (lw-emit OP-RT RT-PAIR-FIRST t 1))))
;; (try body (catch [E] x handler)); b = the body
(defn- lw-try [M :vector-i64 b :i64 t :i64 k :i64] :vector-i64
  (let [c (lw-first M (lw-next M b))
        x (lw-nth M c (- (lw-count M c) 2))
        old (vector-at M 95)
        l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 2) (lw-put 95 (+ (* l 256) (lw-slot M x)))
        (lw-expr b t 0) (lw-put 95 old) (lw-emit OP-BR (inc l))
        (lw-emit OP-LABEL l) (lw-expr (lw-next M x) t k)
        (lw-emit OP-LABEL (inc l)))))

;; ---- strings ----
;; (string-from-i64 x), slots s .. s+4: x, m = -|x| (no overflow at MIN), reversed digits, output bytes, index
(defn- lw-sfrom [M :vector-i64 e :i64 s :i64 t :i64] :vector-i64
  (let [m (+ s 1) rv (+ s 2) out (+ s 3) i (+ s 4) l (vector-at M MM-LABEL-N)]
    (-> M (lw-labels 6)
        (lw-expr e t 0) (lw-emit OP-LSET s t)
        (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRNZ t l)
        (lw-emit OP-CONST t) (lw-emit OP-LGET (inc t) s) (lw-emit OP-BIN BOP-SUB t) (lw-emit OP-LSET m t)
        (lw-emit OP-BR (+ l 1))
        (lw-emit OP-LABEL l) (lw-emit OP-LGET t s) (lw-emit OP-LSET m t)
        (lw-emit OP-LABEL (+ l 1)) (lw-emit OP-VEC t) (lw-emit OP-LSET rv t)
        ;; do: rv += '0' + ((m quot 10) * 10 - m); m := m quot 10; while m != 0
        (lw-emit OP-LABEL (+ l 2))
        (lw-emit OP-LGET t rv) (lw-emit OP-LGET (inc t) m) (lw-emit OP-CONST (+ t 2) 10) (lw-emit OP-BIN BOP-QUOT (inc t))
        (lw-emit OP-CONST (+ t 2) 10) (lw-emit OP-BIN BOP-MUL (inc t)) (lw-emit OP-LGET (+ t 2) m)
        (lw-emit OP-BIN BOP-SUB (inc t)) (lw-emit OP-CONST (+ t 2) 48) (lw-emit OP-BIN BOP-ADD (inc t))
        (lw-emit OP-RT RT-VECTOR-CONJ t 2) (lw-emit OP-LSET rv t)
        (lw-emit OP-LGET t m) (lw-emit OP-CONST (inc t) 10) (lw-emit OP-BIN BOP-QUOT t) (lw-emit OP-LSET m t)
        (lw-emit OP-BRNZ t (+ l 2))
        (lw-emit OP-VEC t) (lw-emit OP-LSET out t)
        (lw-emit OP-LGET t s) (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t (+ l 3))
        (lw-emit OP-LGET t out) (lw-emit OP-CONST (inc t) 45) (lw-emit OP-RT RT-VECTOR-CONJ t 2) (lw-emit OP-LSET out t)
        (lw-emit OP-LABEL (+ l 3))
        (lw-emit OP-LGET t rv) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (lw-emit OP-LSET i t)
        (lw-emit OP-LABEL (+ l 4))
        (lw-emit OP-LGET t i) (lw-emit OP-BRZ t (+ l 5))
        (lw-emit OP-CONST (inc t) 1) (lw-emit OP-BIN BOP-SUB t) (lw-emit OP-LSET i t)
        (lw-emit OP-LGET t out) (lw-emit OP-LGET (inc t) rv) (lw-emit OP-LGET (+ t 2) i) (lw-emit OP-RT RT-VECTOR-AT (inc t) 2)
        (lw-emit OP-RT RT-VECTOR-CONJ t 2) (lw-emit OP-LSET out t) (lw-emit OP-BR (+ l 4))
        (lw-emit OP-LABEL (+ l 5))
        (lw-emit OP-LGET t out) (lw-emit OP-RT RT-STRING-FROM-UTF8 t 1))))

;; ---- dispatch ----
;; heads with a type argument a (the type form node; 21-check put its type in NF-TYPE); e = the first value argument
(defn- lw-typed [M :vector-i64 n :i64 hd :i64 t :i64] :vector-i64
  (let [h (lw-first M n)
        a (lw-next M h)
        e (lw-next M a)
        s (lw-nf M h NF-TYPE)
        md (lw-md M (lw-nf M a NF-TYPE))]
    (case hd
      (HD-OPTION-SOME HD-RESULT-OK) (lw-wrap M e 0 t)
      HD-RESULT-ERR (lw-wrap M e 1 t)
      HD-OPTION-NONE (lw-emit M OP-CONST t)
      HD-OPTION-IS-SOME (-> M (lw-expr e t 0) (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-EQ t) (lw-emit OP-UN UOP-NOT t))
      HD-RESULT-IS-OK (-> M (lw-expr e t 0) (lw-emit OP-RT RT-PAIR-SECOND t 1) (lw-emit OP-CONST (inc t)) (lw-emit OP-CMP CC-EQ t))
      HD-OPTION-VALUE (lw-pick M e s 0 t)
      HD-RESULT-VALUE (lw-pick M e s 1 t)
      HD-RESULT-ERROR (lw-pick M e s 2 t)
      HD-LIST-NEW (-> M (lw-args e t) (lw-emit OP-VEC t (lw-count M e)))
      (HD-LIST-NTH HD-SET-NTH) (-> M (lw-args e t) (lw-emit OP-RT RT-VECTOR-AT t 2))
      HD-LIST-CONJ (-> M (lw-args e t) (lw-emit OP-RT RT-VECTOR-CONJ t 2))
      HD-SET-COUNT (-> M (lw-expr e t 0) (lw-emit OP-RT RT-VECTOR-COUNT t 1))
      HD-MAP-COUNT (-> M (lw-expr e t 0) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (lw-halve t))
      (HD-SET-NEW HD-MAP-NEW) (lw-newcoll M e s md t)
      (HD-SET-CONTAINS HD-MAP-CONTAINS) (lw-has M e s md t)
      (HD-SET-CONJ HD-MAP-ASSOC) (lw-upd M e s md t)
      (HD-SET-DISJ HD-MAP-DISSOC) (lw-upd M e s (+ md 16) t)
      (HD-SET-EQUAL HD-MAP-EQUAL) (-> M (lw-expr e t 0) (lw-emit OP-LSET s t) (lw-expr (lw-next M e) t 0)
                                      (lw-emit OP-LSET (inc s) t) (lw-equal s md t))
      HD-MAP-GET (lw-mget M e s md t)
      HD-MAP-KEYS (lw-kv M e s 0 t)
      HD-MAP-VALS (lw-kv M e s 1 t)
      (lw-fail M E-LOWER-NODE (lw-pos M n) hd))))
;; the generic collection heads: the type of the first argument a decides
(defn- lw-gen [M :vector-i64 n :i64 hd :i64 t :i64] :vector-i64
  (let [h (lw-first M n)
        a (lw-next M h)
        s (lw-nf M h NF-TYPE)
        ty (lw-nf M a NF-TYPE)
        ctor (lw-ct M ty CT-CTOR)
        md (lw-md M ty)]
    (case hd
      HD-GCOUNT (-> M (lw-expr a t 0) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (cond-> (= ctor TC-MAP) (lw-halve t)))
      HD-NTH (if (= (lw-count M a) 3) (lw-nthd M a s t) (-> M (lw-args a t) (lw-emit OP-RT RT-VECTOR-AT t 2)))
      HD-CONTAINS (lw-has M a s md t)
      HD-CONJ (if (= ctor TC-SET) (lw-upd M a s md t) (-> M (lw-expr a t 0) (lw-vconj (lw-next M a) t)))
      (HD-DISJ HD-DISSOC) (lw-upd M a s (+ md 16) t)
      HD-KEYS (lw-kv M a s 0 t)
      HD-VALS (lw-kv M a s 1 t)
      HD-PEEK (lw-peek M a s t)
      HD-POP (lw-pop M a s t)
      (lw-fail M E-LOWER-NODE (lw-pos M n) hd))))
;; conj onto the vector/list in temp t: the items of chain c
(defn- lw-vconj [M :vector-i64 c :i64 t :i64] :vector-i64
  (if (zero? c)
    M
    (let [nx (lw-next M c)]
      (lw-vconj (-> M (lw-expr c (inc t) 0) (lw-emit OP-RT RT-VECTOR-CONJ t 2)) nx t))))
;; an R3 head (strings and pairs go through lw-rt instead)
(defn- lw-r3 [M :vector-i64 n :i64 hd :i64 t :i64 k :i64] :vector-i64
  (let [h (lw-first M n)
        a (lw-next M h)]
    (cond (= hd HD-OPTION-MATCH) (lw-omatch M a t k)
          (= hd HD-RESULT-MATCH) (lw-rmatch M a t k)
          (= hd HD-OPTION-OR) (lw-pick M a (lw-nf M h NF-TYPE) 0 t)
          (= hd HD-THROW) (lw-throw M a t)
          (= hd HD-TRY) (lw-try M a t k)
          (= hd HD-STRING-FROM-I64) (lw-sfrom M a (lw-nf M h NF-TYPE) t)
          (>= hd HD-GCOUNT) (lw-gen M n hd t)
          :else (lw-typed M n hd t))))

;; ------------------------------------------------------------------------------------------------------------
;; TEST-ONLY: the SIR interpreter. It reads M (SIR, FN, LIT, LITB) and writes only its own vector H.
;; H layout (words):
;;   0 status: 0 ok, 1 quot trap, 2 vector index/alloc trap, 3 string index trap, 4 fuel exhausted,
;;             5 interpreter stack full, 6 interpreter heap full, 7 unsupported in the interpreter (cap call,
;;             bytes), 8 bad SIR (END reached, unknown op, TRAP)
;;   1 result / runtime result register, 2 heap top, 3 stack top, 4 fuel used, 5 fuel budget (16777216),
;;   6 heap end (= hsize), 7 stack end, 8 the argument a0, 10 allocation result
;;   64 .. 64+MM-LABEL-CAP-1          label -> SIR index
;;   LWC = 64+MM-LABEL-CAP .. +MM-LIT-CAP   literal -> string handle cache (0 = not built yet)
;;   stack: LWC+MM-LIT-CAP .. +524288; heap: from there to hsize (bump, never freed; fresh words are 0)
;; lw-interp keeps the heap top of an H it ran before (so several runs can share one H), resets the rest.
;; Frame at fb: H[fb + slot] for slots 0..nslots, temps at tb = fb + 1 + nslots.
;; Vector handle v: H[v] = block, H[v+1] = count; block b: H[b] = capacity, H[b+1] = fill, items at b+2.
;;   vector-conj appends in place when the vector is the block's newest version (count = fill < capacity),
;;   else copies with doubled capacity; persistent semantics are kept either way.
;; String handle s: H[s] = byte length, bytes at s+1 .. (one per word).
;; ------------------------------------------------------------------------------------------------------------
(defn- lw-hlab [] :i64 64)
(defn- lw-hlit [] :i64 (+ 64 MM-LABEL-CAP))
(defn- lw-hstack [] :i64 (+ (+ 64 MM-LABEL-CAP) MM-LIT-CAP))
(defn- lw-hheap [] :i64 (+ (lw-hstack) 524288))

(defn- lw-sir [M :vector-i64 pc :i64 fld :i64] :i64
  (vector-at M (+ MM-SIR-BASE (+ (* pc MM-SIR-W) fld))))

(defn- lw-ix-trap [H0 :vector-i64 code :i64] :vector-i64 (lw-put H0 0 code))

;; bump allocation of n words -> H[10] = address (status 6 when full)
(defn- lw-ix-alloc [H0 :vector-i64 n :i64] :vector-i64
  (let [top (vector-at H0 2)
        end (+ top n)
        lim (vector-at H0 6)]
    (if (> end lim)
      (lw-ix-trap H0 6)
      (lw-put (lw-put H0 2 end) 10 top))))

(defn- lw-ix-copy [H0 :vector-i64 dst :i64 src :i64 n :i64] :vector-i64
  (if (<= n 0)
    (lw-put H0 11 0)
    (let [x (vector-at H0 src)]
      (lw-ix-copy (lw-put H0 dst x) (+ dst 1) (+ src 1) (- n 1)))))

(defn- lw-ix-copy-lit [M :vector-i64 H0 :vector-i64 dst :i64 src :i64 n :i64] :vector-i64
  (if (<= n 0)
    (lw-put H0 11 0)
    (lw-ix-copy-lit M (lw-put H0 dst (vector-at M src)) (+ dst 1) (+ src 1) (- n 1))))

;; a new vector of count cnt and capacity cap whose first ncopy items are copied from H[src..]; H[1] = handle
(defn- lw-ix-vnew [H0 :vector-i64 cnt :i64 cap :i64 src :i64 ncopy :i64] :vector-i64
  (let [H1 (lw-ix-alloc H0 (+ 4 cap))
          st1 (vector-at H1 0)]
    (if (> st1 0)
      H1
      (let [v (vector-at H1 10)
            H2 (lw-put H1 v (+ v 2))
            H3 (lw-put H2 (+ v 1) cnt)
            H4 (lw-put H3 (+ v 2) cap)
            H5 (lw-put H4 (+ v 3) cnt)
            H6 (lw-ix-copy H5 (+ v 4) src ncopy)]
        (lw-put H6 1 v)))))

(defn- lw-ix-can-append [cnt :i64 fill :i64 cap :i64] :i64 (if (= cnt fill) (if (< fill cap) 1 0) 0))
(defn- lw-ix-grow [cnt :i64] :i64 (if (< cnt 4) 8 (* 2 cnt)))

(defn- lw-ix-conj [H0 :vector-i64 v :i64 x :i64] :vector-i64
  (let [b (vector-at H0 v)
        cnt (vector-at H0 (+ v 1))
        cap (vector-at H0 b)
        fill (vector-at H0 (+ b 1))]
    (if (= (lw-ix-can-append cnt fill cap) 1)
      (let [H1 (lw-ix-alloc H0 2)
              st1 (vector-at H1 0)]
        (if (> st1 0)
          H1
          (let [h (vector-at H1 10)
                H2 (lw-put H1 (+ b (+ 2 cnt)) x)
                H3 (lw-put H2 (+ b 1) (+ cnt 1))
                H4 (lw-put H3 h b)
                H5 (lw-put H4 (+ h 1) (+ cnt 1))]
            (lw-put H5 1 h))))
      (let [H1 (lw-ix-vnew H0 (+ cnt 1) (lw-ix-grow cnt) (+ b 2) cnt)
              st1 (vector-at H1 0)]
        (if (> st1 0)
          H1
          (let [nv (vector-at H1 1)
                nb (vector-at H1 nv)]
            (lw-put H1 (+ nb (+ 2 cnt)) x)))))))

(defn- lw-ix-vat2 [H0 :vector-i64 v :i64 i :i64] :vector-i64
  (let [x (vector-at H0 (+ (vector-at H0 v) (+ 2 i)))] (lw-put H0 1 x)))
(defn- lw-ix-vat [H0 :vector-i64 v :i64 i :i64] :vector-i64
  (let [cnt (vector-at H0 (+ v 1))]
    (if (lw-oor i cnt) (lw-ix-trap H0 2) (lw-ix-vat2 H0 v i))))

(defn- lw-ix-vassoc [H0 :vector-i64 v :i64 i :i64 x :i64] :vector-i64
  (let [cnt (vector-at H0 (+ v 1))
        b (vector-at H0 v)]
    (if (lw-oor i cnt)
      (lw-ix-trap H0 2)
      (let [H1 (lw-ix-vnew H0 cnt cnt (+ b 2) cnt)
              st1 (vector-at H1 0)]
        (if (> st1 0)
          H1
          (let [nv (vector-at H1 1)
                nb (vector-at H1 nv)]
            (lw-put H1 (+ nb (+ 2 i)) x)))))))

(defn- lw-ix-vassoc! [H0 :vector-i64 v :i64 i :i64 x :i64] :vector-i64
  (let [cnt (vector-at H0 (+ v 1))
        b (vector-at H0 v)]
    (if (lw-oor i cnt)
      (lw-ix-trap H0 2)
      (lw-put (lw-put H0 (+ b (+ 2 i)) x) 1 v))))

(defn- lw-ix-valloc [H0 :vector-i64 n :i64] :vector-i64
  (if (< n 0) (lw-ix-trap H0 2) (lw-ix-vnew H0 n n 0 0)))

(defn- lw-ix-cpa2 [H0 :vector-i64 s :i64 i :i64] :vector-i64
  (let [x (vector-at H0 (+ s (+ 1 i)))] (lw-put H0 1 x)))
(defn- lw-ix-cpa [H0 :vector-i64 s :i64 i :i64] :vector-i64
  (let [len (vector-at H0 s)]
    (if (lw-oor i len) (lw-ix-trap H0 3) (lw-ix-cpa2 H0 s i))))

(defn- lw-ix-concat [H0 :vector-i64 a :i64 b :i64] :vector-i64
  (let [la (vector-at H0 a)
        lb (vector-at H0 b)
        H1 (lw-ix-alloc H0 (+ 1 (+ la lb)))
          st1 (vector-at H1 0)]
    (if (> st1 0)
      H1
      (let [s (vector-at H1 10)
            H2 (lw-put H1 s (+ la lb))
            H3 (lw-ix-copy H2 (+ s 1) (+ a 1) la)
            H4 (lw-ix-copy H3 (+ s (+ 1 la)) (+ b 1) lb)]
        (lw-put H4 1 s)))))

;; R1 pair: H[p] = second (so pair_second = RT-STRING-LENGTH-VIA reads it, as for a string), H[p+1] = first
(defn- lw-ix-pair [H0 :vector-i64 x :i64 y :i64] :vector-i64
  (let [H1 (lw-ix-alloc H0 2)
        st1 (vector-at H1 0)]
    (if (> st1 0)
      H1
      (let [p (vector-at H1 10)
            H2 (lw-put H1 p y)
            H3 (lw-put H2 (+ p 1) x)]
        (lw-put H3 1 p)))))

;; runtime helper rt over the operands at H[base..]; result in H[1]
(defn- lw-ix-rt [H :vector-i64 rt :i64 base :i64] :vector-i64
  (let [x (vector-at H base)
        y (vector-at H (inc base))
        z (vector-at H (+ base 2))]
    (case rt
      RT-VECTOR-AT (lw-ix-vat H x y)
      RT-VECTOR-ASSOC-IN-PLACE (lw-ix-vassoc! H x y z)
      RT-STRING-CODE-POINT-AT (lw-ix-cpa H x y)
      RT-VECTOR-CONJ (lw-ix-conj H x y)
      RT-VECTOR-ASSOC (lw-ix-vassoc H x y z)
      RT-VECTOR-ALLOC (lw-ix-valloc H x)
      RT-STRING-LENGTH-VIA (lw-put H 1 (vector-at H x))
      RT-STRING-CONCAT (lw-ix-concat H x y)
      RT-PAIR-NEW (lw-ix-pair H x y)
      RT-PAIR-FIRST (lw-put H 1 (vector-at H (inc x)))
      RT-VECTOR-COUNT (lw-put H 1 (vector-at H (inc x)))
      (lw-ix-trap H 7))))

;; string literal lit -> handle in H[1] (built once, cached)
(defn- lw-ix-str [M :vector-i64 H0 :vector-i64 lit :i64] :vector-i64
  (let [c (vector-at H0 (+ (lw-hlit) lit))]
    (if (> c 0)
      (lw-put H0 1 c)
      (let [lp (+ MM-LIT-BASE (* lit MM-LIT-W))
            len (vector-at M (+ lp LF-LEN))
            H1 (lw-ix-alloc H0 (+ len 1))
              st1 (vector-at H1 0)]
        (if (> st1 0)
          H1
          (let [s (vector-at H1 10)
                H2 (lw-put H1 s len)
                H3 (lw-ix-copy-lit M H2 (+ s 1) (+ MM-LITB-BASE (vector-at M (+ lp LF-B))) len)
                H4 (lw-put H3 (+ (lw-hlit) lit) s)]
            (lw-put H4 1 s)))))))

;; a fresh vector of the n temps at H[src..]; H[1] = handle
(defn- lw-ix-vec [H0 :vector-i64 src :i64 n :i64] :vector-i64 (lw-ix-vnew H0 n n src n))

(defn- lw-ix-bin [bop :i64 x :i64 y :i64] :i64
  (case bop
    BOP-ADD (+ x y) BOP-SUB (- x y) BOP-MUL (* x y) BOP-QUOT (quot x y)
    BOP-AND (bit-and x y) BOP-OR (bit-or x y) BOP-XOR (bit-xor x y)
    BOP-SHL (i64-shift-left x (bit-and y 63))
    BOP-USHR (u64-shift-right x (bit-and y 63))
    (i64-shift-right x (bit-and y 63))))

(defn- lw-ix-cmp [cc :i64 x :i64 y :i64] :i64
  (if (case cc CC-EQ (= x y) CC-LT (< x y) CC-GT (> x y) CC-LE (<= x y) (>= x y)) 1 0))

;; true when i is outside 0 .. n-1
(defn- lw-oor [i :i64 n :i64] :bool (or (neg? i) (>= i n)))
;; a quot that traps: divisor 0, or MIN / -1
(defn- lw-ix-bin-trap [bop :i64 x :i64 y :i64] :bool
  (or (>= bop BOP-F64-ADD)   ; FLOAT: lw-interp has no float arithmetic (a trap, never a wrong value)
      (and (= bop BOP-QUOT) (or (zero? y) (and (= y -1) (= x (i64-shift-left 1 63)))))))
(defn- lw-ix-un [uop :i64 x :i64] :i64 (if (= uop UOP-NOT) (bit-xor x 1) (bit-not x)))


;; TAB: the item x of table lit (8 little-endian bytes in LITB)
(defn- lw-ix-tabv [M :vector-i64 lit :i64 x :i64] :i64
  (let [b (+ MM-LITB-BASE (+ (vector-at M (+ MM-LIT-BASE (+ (* lit MM-LIT-W) LF-B))) (* 8 x)))]
    (loop [k 7 acc 0]
      (if (neg? k) acc (recur (dec k) (bit-or (i64-shift-left acc 8) (vector-at M (+ b k))))))))

;; the instruction loop of one frame: pc = SIR index, fb = frame base, tb = temp base
(defn- lw-ix [M :vector-i64 H :vector-i64 pc :i64 fb :i64 tb :i64] :vector-i64
  (let [p (+ MM-SIR-BASE (* pc MM-SIR-W))
        op (vector-at M p)
        a (vector-at M (+ p 1))
        b (vector-at M (+ p 2))
        pc1 (inc pc)]
    (case op
      OP-LGET (lw-ix M (lw-put H (+ tb a) (vector-at H (+ fb b))) pc1 fb tb)
      OP-CONST (lw-ix M (lw-put H (+ tb a) b) pc1 fb tb)
      OP-BIN (let [x (vector-at H (+ tb b))
                   y (vector-at H (+ tb b 1))]
               (if (lw-ix-bin-trap a x y)
                 (lw-ix-trap H 1)
                 (lw-ix M (lw-put H (+ tb b) (lw-ix-bin a x y)) pc1 fb tb)))
      OP-CMP (let [x (vector-at H (+ tb b))
                   y (vector-at H (+ tb b 1))]
               (if (>= a CC-F64-EQ) (lw-ix-trap H 8) (lw-ix M (lw-put H (+ tb b) (lw-ix-cmp a x y)) pc1 fb tb)))   ; FLOAT: trap
      OP-LSET (lw-ix M (lw-put H (+ fb a) (vector-at H (+ tb b))) pc1 fb tb)
      OP-BRZ (lw-ix M H (if (zero? (vector-at H (+ tb a))) (vector-at H (+ (lw-hlab) b)) pc1) fb tb)
      OP-BRNZ (lw-ix M H (if (zero? (vector-at H (+ tb a))) pc1 (vector-at H (+ (lw-hlab) b))) fb tb)
      OP-BR (lw-ix M H (vector-at H (+ (lw-hlab) a)) fb tb)
      OP-LABEL (lw-ix M H pc1 fb tb)
      OP-FADDR (lw-ix M (lw-put H (+ tb a) b) pc1 fb tb)
      (OP-RT OP-CALL OP-CALLI OP-STR OP-VEC)
      ;; a helper that leaves its result in H[1] (or a status in H[0]); the result goes to temp b (RT, CALL, CALLI) or a.
      ;; R4: a code address in the interpreter is the FN index (FADDR); CALLI enters it
      (let [H1 (case op
                 OP-RT (lw-ix-rt H a (+ tb b))
                 OP-CALL (lw-ix-enter M H a (+ tb b))
                 OP-CALLI (lw-ix-enter M H (vector-at H (+ tb b (vector-at M (+ p 3)))) (+ tb b))
                 OP-STR (lw-ix-str M H b)
                 (lw-ix-vec H (+ tb a) b))
            dst (if (or (= op OP-RT) (= op OP-CALL) (= op OP-CALLI)) b a)]
        (if (pos? (vector-at H1 0))
          H1
          (lw-ix M (lw-put H1 (+ tb dst) (vector-at H1 1)) pc1 fb tb)))
      OP-FUEL (let [used (inc (vector-at H 4))]
                (if (> used (vector-at H 5))
                  (lw-ix-trap H 4)
                  (lw-ix M (lw-put H 4 used) pc1 fb tb)))
      OP-UN (if (>= a UOP-F64-NEG) (lw-ix-trap H 8) (lw-ix M (lw-put H (+ tb b) (lw-ix-un a (vector-at H (+ tb b)))) pc1 fb tb))   ; FLOAT: trap
      OP-RET (lw-put H 1 (vector-at H (+ tb a)))
      OP-TAB (let [x (vector-at H (+ tb a))]
               (if (lw-oor x (vector-at M (+ p 3)))
                 (lw-ix-trap H 2)
                 (lw-ix M (lw-put H (+ tb a) (lw-ix-tabv M b x)) pc1 fb tb)))
      OP-CAP (lw-ix-trap H 7)
      (lw-ix-trap H 8))))

;; call FN f with its arguments at H[src..]: push a frame, run, pop. Status in H[0], result in H[1].
(defn- lw-ix-enter [M :vector-i64 H0 :vector-i64 f :i64 src :i64] :vector-i64
  (let [sir (lw-ff M f FF-SIR)
        np (lw-ff M f FF-NPARAMS)
        ns (lw-ff M f FF-NSLOTS)
        fb (vector-at H0 3)
        top (+ fb (+ 1 (+ ns (+ (lw-ff M f FF-DEPTH) 6))))
        lim (vector-at H0 7)]
    (if (> top lim)
      (lw-ix-trap H0 5)
      (let [H1 (lw-put H0 3 top)
            H2 (lw-ix-copy H1 (+ fb 1) src np)
            H3 (lw-ix M H2 (+ sir 1) fb (+ fb (+ 1 ns)))]
        (lw-put H3 3 fb)))))

;; label table: H[64 + l] = SIR index of LABEL l
(defn- lw-ix-labels [M :vector-i64 H0 :vector-i64 i :i64] :vector-i64
  (if (>= i (vector-at M MM-SIR-N))
    (lw-put H0 11 0)
    (if (= (lw-sir M i IF-OP) OP-LABEL)
      (lw-ix-labels M (lw-put H0 (+ (lw-hlab) (lw-sir M i IF-A)) i) (+ i 1))
      (lw-ix-labels M H0 (+ i 1)))))

(defn- lw-ix-heap-top [H :vector-i64] :i64 (if (= (vector-at H 2) 0) (lw-hheap) (vector-at H 2)))

(defn- lw-interp [M :vector-i64 H0 :vector-i64 hsize :i64 f :i64 a0 :i64] :vector-i64
  (let [top (lw-ix-heap-top H0)
        H1 (lw-put (lw-put (lw-put H0 0 0) 2 top) 3 (lw-hstack))
        H2 (lw-put (lw-put (lw-put H1 4 0) 5 16777216) 6 hsize)
        H3 (lw-put (lw-put H2 7 (lw-hheap)) 8 a0)
        H4 (lw-ix-labels M H3 1)]
    (lw-ix-enter M H4 f 8)))

;; ============================================================================================================
;; R4 (agent R4, 2026-10-03): functions (seed/SIR :r4-lowering). New opcodes FADDR and CALLI only. Written in the R3
;; language. Reads what 21-check wrote: NF-TYPE of a fn literal's head symbol = its lifted FN g, NF-TYPE of its parameter
;; vector = the capture block [k s1 .. sk] (outer slots), FK-LAMBDA / FK-ADAPTER FN records, NF-RES 0 on a fn literal
;; that is called directly (a known let binding or a map/filter/reduce callback), hidden slots on head symbol nodes.
;; ============================================================================================================
;; the capture block of lifted FN g
(defn- lw-capblk [M :vector-i64 g :i64] :i64 (lw-nf M (lw-nth M (lw-first M (lw-ff M g FF-NODE)) 1) NF-TYPE))
(defn- lw-ncap [M :vector-i64 g :i64] :i64 (vector-at M (lw-capblk M g)))
;; LGET t .. t+k-1 := the captured slots of g (in the enclosing function)
;; R4 rung proof: a higher-order defn; its callers pass fn literals typed by the [:fn ..] parameter slot
(defn- lw-times [M :vector-i64 n :i64 f [:fn [[:vector-i64 :i64] :vector-i64]]] :vector-i64
  (loop [M1 M i 0] (if (>= i n) M1 (recur (f M1 i) (inc i)))))
(defn- lw-caps [M :vector-i64 g :i64 t :i64] :vector-i64
  (let [blk (lw-capblk M g)]
    (lw-times M (vector-at M blk) (fn [M1 i] (lw-emit M1 OP-LGET (+ t i) (vector-at M1 (+ blk 1 i)))))))
;; true when FN f is a variadic clause (21-check: NF-TYPE 1 on its parameter vector)
(defn- lw-variadic? [M :vector-i64 f :i64] :bool
  (and (or (= (lw-ff M f FF-KIND) FK-DEFN) (= (lw-ff M f FF-KIND) FK-PRIV))
       (= (lw-nf M (lw-nth M (lw-first M (lw-ff M f FF-NODE)) 2) NF-TYPE) 1)))
;; a call of the variadic clause f: m fixed arguments, the surplus as one vector
(defn- lw-call-var [M :vector-i64 f :i64 a :i64 t :i64] :vector-i64
  (let [m (dec (lw-ff M f FF-NPARAMS))
        n (lw-count M a)]
    (loop [M1 M x a i 0]
      (if (zero? x)
        (-> M1 (lw-emit OP-VEC (+ t m) (- n m)) (lw-emit OP-CALL f t (inc m)))
        (recur (lw-expr M1 x (+ t i) 0) (lw-next M1 x) (inc i))))))

;; a fn literal as a value: pair(entry address, env)
(defn- lw-closure [M :vector-i64 n :i64 t :i64] :vector-i64
  (let [g (lw-nf M (lw-first M n) NF-TYPE)
        k (lw-ncap M g)]
    (-> M
        (lw-emit OP-FADDR t (if (>= k 2) (inc g) g))
        (cond-> (zero? k) (lw-emit OP-CONST (inc t))
                (pos? k) (lw-caps g (inc t)))
        (lw-env-pairs (inc t) (dec k))
        (lw-emit OP-RT RT-PAIR-NEW t 2))))
;; temps u .. u+j hold c1 .. c(j+1): fold them into u = pair(c1, pair(c2, .. c(j+1)))
(defn- lw-env-pairs [M :vector-i64 u :i64 j :i64] :vector-i64
  (if (<= j 0) M (lw-env-pairs (lw-emit M OP-RT RT-PAIR-NEW (+ u (dec j)) 2) u (dec j))))
;; (f a ..) with f a known function slot: CALL g with the arguments and the captured slots
(defn- lw-callk [M :vector-i64 h :i64 t :i64] :vector-i64
  (let [g (lw-ridx (lw-nf M h NF-RES))
        a (lw-next M h)
        n (lw-count M a)]
    (-> M (lw-args a t) (lw-caps g (+ t n)) (lw-emit OP-CALL g t (+ n (lw-ncap M g))))))
;; call the closure in slot s with the arguments a .. (into t ..): env and code after them, CALLI
(defn- lw-calli [M :vector-i64 s :i64 a :i64 t :i64] :vector-i64
  (let [n (lw-count M a)]
    (-> M (lw-args a t)
        (lw-emit OP-LGET (+ t n) s) (lw-emit OP-RT RT-PAIR-SECOND (+ t n) 1)
        (lw-emit OP-LGET (+ t n 1) s) (lw-emit OP-RT RT-PAIR-FIRST (+ t n 1) 1)
        (lw-emit OP-CALLI 0 t (inc n)))))
;; (g a ..) through a fn value: a local g, or a computed head (its value in the hidden slot NF-SYM of n)
(defn- lw-callv [M :vector-i64 n :i64 t :i64] :vector-i64
  (let [h (lw-first M n)]
    (if (= (lw-nf M h NF-KIND) ND-SYM)
      (lw-calli M (lw-slot M h) (lw-next M h) t)
      (let [hs (lw-nf M n NF-SYM)]
        (lw-calli (-> M (lw-expr h t 0) (lw-emit OP-LSET hs t)) hs (lw-next M h) t)))))
;; (invoke [R] c a ..): the closure into the hidden slot NF-TYPE of the head
(defn- lw-invoke [M :vector-i64 n :i64 t :i64] :vector-i64
  (let [h (lw-first M n)
        a1 (lw-next M h)
        typed (or (= (lw-nf M a1 NF-KIND) ND-KW) (= (lw-nf M a1 NF-KIND) ND-VEC))
        op (if typed (lw-next M a1) a1)
        hs (lw-nf M h NF-TYPE)]
    (lw-calli (-> M (lw-expr op t 0) (lw-emit OP-LSET hs t)) hs (lw-next M op) t)))
;; the arity of fn type ty (the TC-PLIST chain of CT-B)
(defn- lw-arity [M :vector-i64 ty :i64] :i64
  (loop [b (lw-ct M ty CT-B) k 0] (if (zero? b) k (recur (lw-ct M b CT-B) (inc k)))))
;; (apply c a .. l): hidden slots s (closure) and s+1 (list); count(l) must be ar - m (else TRAP)
(defn- lw-apply [M :vector-i64 n :i64 t :i64] :vector-i64
  (let [h (lw-first M n)
        s (lw-nf M h NF-TYPE)
        op (lw-next M h)
        na (dec (lw-count M h))
        m (- na 2)
        ar (lw-arity M (lw-nf M op NF-TYPE))
        l (lw-nth M h na)
        lok (vector-at M MM-LABEL-N)
        M1 (-> M (lw-labels 1) (lw-expr op t 0) (lw-emit OP-LSET s t))
        M2 (loop [M3 M1 x (lw-next M1 op) i 0] (if (>= i m) M3 (recur (lw-expr M3 x (+ t i) 0) (lw-next M3 x) (inc i))))
        u (+ t m)
        M4 (-> M2 (lw-expr l u 0) (lw-emit OP-LSET (inc s) u)
               (lw-emit OP-RT RT-VECTOR-COUNT u 1) (lw-emit OP-CONST (inc u) (- ar m)) (lw-emit OP-CMP CC-EQ u)
               (lw-emit OP-BRNZ u lok) (lw-emit OP-TRAP 0) (lw-emit OP-LABEL lok))
        M5 (lw-times M4 (- ar m)
                     (fn [M6 j] (-> M6 (lw-emit OP-LGET (+ u j) (inc s)) (lw-emit OP-CONST (+ u j 1) j) (lw-emit OP-RT RT-VECTOR-AT (+ u j) 2))))]
    (-> M5 (lw-emit OP-LGET (+ t ar) s) (lw-emit OP-RT RT-PAIR-SECOND (+ t ar) 1)
        (lw-emit OP-LGET (+ t ar 1) s) (lw-emit OP-RT RT-PAIR-FIRST (+ t ar 1) 1)
        (lw-emit OP-CALLI 0 t (inc ar)))))

;; ---- map / filter / reduce: hidden slots s0 coll, s1 count, s2 index, s3 accumulator, s4 the callback value ----
;; the callback kind of node cb: 1 a direct lifted fn (NF-RES 0), 2 a defn clause (RES-FN), 3 a value (slot s4)
(defn- lw-cbkind [M :vector-i64 cb :i64] :i64
  (cond (and (= (lw-nf M cb NF-KIND) ND-LIST) (zero? (lw-nf M cb NF-RES))) 1
        (and (= (lw-nf M cb NF-KIND) ND-SYM) (= (lw-rcls (lw-nf M cb NF-RES)) RES-FN)) 2
        :else 3))
;; call the callback cb on the ar arguments in temps u .. u+ar-1 (result in u); s4 = the value slot
(defn- lw-cbcall [M :vector-i64 cb :i64 ar :i64 u :i64 s4 :i64] :vector-i64
  (case (lw-cbkind M cb)
    1 (let [g (lw-nf M (lw-first M cb) NF-TYPE)] (-> M (lw-caps g (+ u ar)) (lw-emit OP-CALL g u (+ ar (lw-ncap M g)))))
    2 (lw-emit M OP-CALL (lw-ridx (lw-nf M cb NF-RES)) u ar)
    (-> M (lw-emit OP-LGET (+ u ar) s4) (lw-emit OP-RT RT-PAIR-SECOND (+ u ar) 1)
        (lw-emit OP-LGET (+ u ar 1) s4) (lw-emit OP-RT RT-PAIR-FIRST (+ u ar 1) 1)
        (lw-emit OP-CALLI 0 u (inc ar)))))
;; temp u := item (slot s2) of the vector in slot s0
(defn- lw-hitem [M :vector-i64 s :i64 u :i64] :vector-i64
  (-> M (lw-emit OP-LGET u s) (lw-emit OP-LGET (inc u) (+ s 2)) (lw-emit OP-RT RT-VECTOR-AT u 2)))
;; the 0-arity fixed clause of the defn whose clause is f, 0 when none
(defn- lw-clause0 [M :vector-i64 f :i64] :i64
  (let [sy (lw-ff M f FF-SYM)
        f0 (loop [g f] (if (and (> g 1) (= (lw-ff M (dec g) FF-SYM) sy)) (recur (dec g)) g))]
    (loop [g f0]
      (cond (or (>= g (vector-at M MM-FN-N)) (not= (lw-ff M g FF-SYM) sy)) 0
            (and (zero? (lw-ff M g FF-NPARAMS)) (not (lw-variadic? M g))) g
            :else (recur (inc g))))))
;; one step of the loop body for item index slot s2 (hd: map / filter / reduce)
(defn- lw-hstep [M :vector-i64 hd :i64 cb :i64 s :i64 t :i64] :vector-i64
  (let [lskip (vector-at M MM-LABEL-N)]
    (case hd
      HD-HOF-MAP (-> M (lw-emit OP-LGET t (+ s 3)) (lw-hitem s (inc t)) (lw-cbcall cb 1 (inc t) (+ s 4))
                     (lw-emit OP-RT RT-VECTOR-CONJ t 2) (lw-emit OP-LSET (+ s 3) t))
      HD-FILTER (-> M (lw-labels 1) (lw-hitem s t) (lw-cbcall cb 1 t (+ s 4)) (lw-emit OP-BRZ t lskip)
                    (lw-emit OP-LGET t (+ s 3)) (lw-hitem s (inc t)) (lw-emit OP-RT RT-VECTOR-CONJ t 2)
                    (lw-emit OP-LSET (+ s 3) t) (lw-emit OP-LABEL lskip))
      (-> M (lw-emit OP-LGET t (+ s 3)) (lw-hitem s (inc t)) (lw-cbcall cb 2 t (+ s 4)) (lw-emit OP-LSET (+ s 3) t)))))
(defn- lw-hof [M :vector-i64 n :i64 hd :i64 t :i64] :vector-i64
  (let [h (lw-first M n)
        s (lw-nf M h NF-TYPE)
        na (dec (lw-count M h))
        cb (lw-next M h)
        coll (lw-nth M h na)
        noinit (and (= hd HD-REDUCE) (= na 2))
        l (vector-at M MM-LABEL-N)
        M1 (-> M (lw-labels 4)
               (cond-> (= (lw-cbkind M cb) 3) (-> (lw-expr cb t 0) (lw-emit OP-LSET (+ s 4) t)))
               (lw-expr coll t 0) (lw-emit OP-LSET s t) (lw-emit OP-RT RT-VECTOR-COUNT t 1) (lw-emit OP-LSET (inc s) t)
               (lw-emit OP-CONST t) (lw-emit OP-LSET (+ s 2) t))
        M2 (cond (= na 3) (-> M1 (lw-expr (lw-next M1 cb) t 0) (lw-emit OP-LSET (+ s 3) t))
                 noinit (lw-hseed M1 cb s t (+ l 2))
                 :else (-> M1 (lw-emit OP-VEC t) (lw-emit OP-LSET (+ s 3) t)))]
    (-> M2
        (lw-emit OP-LABEL l)
        (lw-emit OP-LGET t (+ s 2)) (lw-emit OP-LGET (inc t) (inc s)) (lw-emit OP-CMP CC-LT t) (lw-emit OP-BRZ t (inc l))
        (lw-hstep hd cb s t)
        (lw-step (+ s 2) 1 t) (lw-emit OP-BR l)
        (lw-emit OP-LABEL (inc l)) (lw-emit OP-LGET t (+ s 3))
        (lw-emit OP-LABEL (+ l 2)))))
;; reduce without init: an empty collection answers (f) (the defn's 0-arity clause; TRAP when there is none) and jumps
;; to lend; else the first item seeds the accumulator and the loop starts at index 1
(defn- lw-hseed [M :vector-i64 cb :i64 s :i64 t :i64 lend :i64] :vector-i64
  (let [lne (vector-at M MM-LABEL-N)
        z (if (= (lw-cbkind M cb) 2) (lw-clause0 M (lw-ridx (lw-nf M cb NF-RES))) 0)]
    (-> M (lw-labels 1)
        (lw-emit OP-LGET t (inc s)) (lw-emit OP-BRNZ t lne)
        (cond-> (pos? z) (-> (lw-emit OP-CALL z t) (lw-emit OP-BR lend))
                (zero? z) (lw-emit OP-TRAP 0))
        (lw-emit OP-LABEL lne)
        (lw-hitem s t) (lw-emit OP-LSET (+ s 3) t) (lw-emit OP-CONST t 1) (lw-emit OP-LSET (+ s 2) t))))

;; the closure entry of a lambda with k >= 2 captures (FN g' = g + 1): unpack the env (slot np+1) and CALL g
(defn- lw-adapter [M :vector-i64 f :i64] :vector-i64
  (let [g (dec f)
        np (dec (lw-ff M f FF-NPARAMS))
        k (lw-ncap M g)
        e (inc np)
        le (vector-at M MM-LABEL-N)
        M1 (-> M (lw-labels 1) (lw-put 92 f) (lw-put 93 le) (lw-put 94 -1) (lw-set-ff f FF-SIR (vector-at M MM-SIR-N))
               (lw-emit OP-FN f (inc np) (inc np)) (lw-emit OP-FUEL 0) (lw-emit OP-LABEL le))
        M2 (lw-times M1 np (fn [M3 i] (lw-emit M3 OP-LGET i (inc i))))
        M4 (loop [M5 M2 i 0]
             (if (>= i (dec k))
               (lw-emit M5 OP-LGET (+ np i) e)
               (recur (-> M5 (lw-emit OP-LGET (+ np i) e) (lw-emit OP-RT RT-PAIR-FIRST (+ np i) 1)
                          (lw-emit OP-LGET (+ np i 1) e) (lw-emit OP-RT RT-PAIR-SECOND (+ np i 1) 1) (lw-emit OP-LSET e (+ np i 1)))
                      (inc i))))
        M6 (-> M4 (lw-emit OP-CALL g 0 (+ np k)) (lw-emit OP-RET 0) (lw-emit OP-END f))]
    (lw-set-ff M6 f FF-DEPTH (inc (vector-at M6 94)))))

;; ============================================================================================================
;; R5B (agent R5B, 2026-10-03): effects (seed/SIR :r5b-lowering, OP-RES2 OP-RET2 RT-CAP-CALL). Reads what 21-check wrote: FN2 at
;; M[MM-FN2] (templates, specializations), NF-TYPE of a perform head (the state slot) and of its keyword (the handler's get
;; clause FN; put = get + 1), of a stateful call's head (the state slot; its NF-RES = RES-FN of the specialization), of a handle
;; head (its state slot). Cells are frame slots (deref/reset! above).
;; ============================================================================================================
(defn- lw-f2 [M :vector-i64 f :i64 fld :i64] :i64 (vector-at M (+ (vector-at M MM-FN2) (* f FN2-W) fld)))
(defn- lw-tmpl? [M :vector-i64 f :i64] :bool (and (pos? f) (= (bit-and (lw-f2 M f FN2-FLAGS) 1) 1)))
(defn- lw-spec? [M :vector-i64 f :i64] :bool (and (pos? f) (= (bit-and (lw-f2 M f FN2-FLAGS) 2) 2)))

;; (perform :state/get) / (perform :state/put v) / (perform :clock/now x)
(defn- lw-perform [M :vector-i64 n :i64 t :i64] :vector-i64
  (let [h (lw-first M n)
        kw (lw-next M h)
        v (lw-next M kw)
        sl (lw-nf M h NF-TYPE)
        hf (lw-nf M kw NF-TYPE)
        code (lw-kwcode M kw)]
    (cond (= code KW-STATE-GET)
          (-> M (lw-emit OP-LGET t sl) (lw-emit OP-CALL hf t 1) (lw-emit OP-RES2 (inc t)) (lw-emit OP-LSET sl (inc t)))
          (= code KW-STATE-PUT)
          (-> M (lw-emit OP-LGET t sl) (lw-expr v (inc t) 0) (lw-emit OP-CALL (inc hf) t 2) (lw-emit OP-RES2 (inc t))
              (lw-emit OP-LSET sl (inc t)))
          :else (-> M (lw-emit OP-CONST t 7) (lw-expr v (inc t) 0) (lw-emit OP-RT RT-CAP-CALL t 2)))))

;; (g a ..) of a stateful defn: CALL its specialization with the state first; a self call in tail position of a specialization
;; jumps to the entry (its arguments into slots 2.., the state stays in slot 1)
(defn- lw-scall [M :vector-i64 h :i64 t :i64 k :i64] :vector-i64
  (let [g (lw-ridx (lw-nf M h NF-RES))
        sl (lw-nf M h NF-TYPE)
        a (lw-next M h)
        n (lw-count M a)]
    (if (and (= g (vector-at M 92)) (= (lw-kt k) 1))
      (lw-jump M a t 0)
      (-> M (lw-emit OP-LGET t sl) (lw-args a (inc t)) (lw-emit OP-CALL g t (inc n)) (lw-emit OP-RES2 (inc t))
          (lw-emit OP-LSET sl (inc t))))))

;; ==== BEGIN SEEDFIX (agent SEEDFIX, 2026-10-03; marks written by 12-kirread, see its SEEDFIX header) =================
;; Only on the KIR route (kr-mode?: compile-kir ran 12-kirread); every source-route program lowers exactly as before.
;;   entry FUEL of FN f: FF-FUEL off the KIR route or for a defn marked kr-mk-seed; else 1 iff its node is kr-mk-entry
;;   (machine_ir's entry-fuel-prefixes); recur / self tail call FUEL unless the current defn is kr-mk-nofuel; a loop
;;   node marked kr-mk-entry charges once before its header (the loop helper's entry); a call of a defn carrying a slot
;;   is RT slot (the loader's runtime operation); a defn marked kr-mk-export gets FF-EXPORT 1 after 21-check.
;; The layout is 12-kirread's (cell 127 = kr-c-tab, its table word 7 = kr-t-mk, the mark bits kr-mk-*), repeated here so that
;; 30-lower does not depend on 12-kirread (its unit and lw-gate builds do not include it).
(defn- lw-sx-mode? [M :vector-i64] :bool (> (vector-at M 127) 1))
(defn- lw-sx-mkof [M :vector-i64 n :i64] :i64
  (let [tab (vector-at M 127)
        b (if (> tab 1) (vector-at M (+ tab 7)) 0)]
    (if (and (pos? b) (< n MM-NODE-CAP)) (vector-at M (+ b n)) 0)))
(defn- lw-sx-mk [M :vector-i64 f :i64] :i64 (lw-sx-mkof M (lw-ff M f FF-NODE)))
(defn- lw-sx-entry [M :vector-i64 f :i64] :i64
  (let [m (lw-sx-mk M f)]
    (cond (not (lw-sx-mode? M)) (lw-ff M f FF-FUEL)
          (pos? (bit-and m 4)) (lw-ff M f FF-FUEL)   ; kr-mk-seed
          (pos? (bit-and m 1)) 1                     ; kr-mk-entry
          :else 0)))
(defn- lw-sx-recur? [M :vector-i64] :bool (zero? (bit-and (lw-sx-mk M (vector-at M 92)) 2)))   ; kr-mk-nofuel
(defn- lw-sx-loop? [M :vector-i64 n :i64] :bool (pos? (bit-and (lw-sx-mkof M n) 1)))
(defn- lw-sx-slot [M :vector-i64 f :i64] :i64 (if (pos? f) (quot (lw-sx-mk M f) 65536) 0))   ; kr-mk-slot
(defn- lw-sx-exports [M :vector-i64 f :i64] :vector-i64
  (cond (not (lw-sx-mode? M)) M
        (>= f (vector-at M MM-FN-N)) M
        (pos? (bit-and (lw-sx-mk M f) 8)) (lw-sx-exports (lw-set-ff M f FF-EXPORT 1) (inc f))   ; kr-mk-export
        :else (lw-sx-exports M (inc f))))
;; ==== END SEEDFIX ===================================================================================================

;; seed/40-a64enc.kotoba -- AArch64 instruction encoders of the seed compiler (R0). Prefix enc-. Owner: 40-a64enc.
;; Pure functions over i64: register numbers (0..30, 31 = sp or xzr by instruction), immediates in the units
;; named per function, result = the 32-bit instruction word (0..2^32-1). An operand out of range gives -1; the
;; caller (41-a64gen, 42-layout) turns -1 into E-ENC-IMM. All forms are 64-bit (sf = 1). Opcode bases are written
;; in decimal (R0 has no hex literals); the hex is in the comment. Bit patterns follow kotoba-native aarch64.cljk
;; and the Arm ARM; the oracle is clang + otool (scripts/seed/a64enc-oracle.py, seed/tests/unit/40-a64enc_t).
;; Condition codes are the A64 cond field values (enc-cond-*); enc-cond-of-cc maps SIR CC-* to them.

;; ---- helpers ------------------------------------------------------------------------------------------------
(defn- enc-r [r :i64] :i64 (bit-and r 31))
;; enc-in: 1 when lo <= x <= hi, else 0. enc-z: 1 when x = 0. (i64 flags, combined with *: the stable stage-0
;; native image answers "internal compiler error" on every and/or/not, seed/CONTRACT-REQUESTS.md 2026-10-02.)
(defn- enc-in [x :i64 lo :i64 hi :i64] :i64 (if (< x lo) 0 (if (> x hi) 0 1)))
(defn- enc-z [x :i64] :i64 (if (= x 0) 1 0))
(defn- enc-sh [x :i64 n :i64] :i64 (i64-shift-left x n))
(defn- enc-word-ok [w :i64] :bool (>= w 0))

;; ---- condition codes ------------------------------------------------------------------------------------------
(defn- enc-cond-eq [] :i64 0)
(defn- enc-cond-ne [] :i64 1)
(defn- enc-cond-hs [] :i64 2)
(defn- enc-cond-lo [] :i64 3)
(defn- enc-cond-vs [] :i64 6)
(defn- enc-cond-vc [] :i64 7)
(defn- enc-cond-ge [] :i64 10)
(defn- enc-cond-lt [] :i64 11)
(defn- enc-cond-gt [] :i64 12)
(defn- enc-cond-le [] :i64 13)
(defn- enc-cond-of-cc [cc :i64] :i64
  (cond (>= cc CC-F64-EQ) (enc-fcond (bit-and cc 7))   ; FLOAT (r6j): after fcmp
        (= cc CC-EQ) 0
        (= cc CC-LT) 11
        (= cc CC-GT) 12
        (= cc CC-LE) 13
        (= cc CC-GE) 10
        :else -1))

;; FLOAT (r6j): the A64 condition after `fcmp` for float compare k = CC-F*-* mod 8 (0 eq 1 lt 2 le 3 gt 4 ge 5 unordered):
;; eq, mi, ls, gt, ge, vs -- each is false on unordered operands except vs (the Arm ARM fcmp flag table: unordered = 0011)
(defn- enc-fcond [k :i64] :i64
  (cond (= k 0) 0 (= k 1) 4 (= k 2) 9 (= k 3) 12 (= k 4) 10 (= k 5) 6 :else -1))

;; ---- data processing, register forms: base + Rm<<16 + Rn<<5 + Rd ------------------------------------------------
(defn- enc-rrr [base :i64 d :i64 n :i64 m :i64] :i64
  (+ base (enc-sh (enc-r m) 16) (enc-sh (enc-r n) 5) (enc-r d)))
(defn- enc-add-r [d :i64 n :i64 m :i64] :i64 (enc-rrr 2332033024 d n m))   ; 8b000000 add xd, xn, xm
(defn- enc-sub-r [d :i64 n :i64 m :i64] :i64 (enc-rrr 3405774848 d n m))   ; cb000000 sub
(defn- enc-adds-r [d :i64 n :i64 m :i64] :i64 (enc-rrr 2868903936 d n m))  ; ab000000 adds
(defn- enc-subs-r [d :i64 n :i64 m :i64] :i64 (enc-rrr 3942645760 d n m))  ; eb000000 subs
(defn- enc-and-r [d :i64 n :i64 m :i64] :i64 (enc-rrr 2315255808 d n m))   ; 8a000000 and
(defn- enc-orr-r [d :i64 n :i64 m :i64] :i64 (enc-rrr 2852126720 d n m))   ; aa000000 orr
(defn- enc-eor-r [d :i64 n :i64 m :i64] :i64 (enc-rrr 3388997632 d n m))   ; ca000000 eor
(defn- enc-orn-r [d :i64 n :i64 m :i64] :i64 (enc-rrr 2854223872 d n m))   ; aa200000 orn
(defn- enc-sdiv [d :i64 n :i64 m :i64] :i64 (enc-rrr 2596277248 d n m))    ; 9ac00c00 sdiv
(defn- enc-lslv [d :i64 n :i64 m :i64] :i64 (enc-rrr 2596282368 d n m))    ; 9ac02000 lsl (register)
(defn- enc-lsrv [d :i64 n :i64 m :i64] :i64 (enc-rrr 2596283392 d n m))    ; 9ac02400 lsr (register)
(defn- enc-asrv [d :i64 n :i64 m :i64] :i64 (enc-rrr 2596284416 d n m))    ; 9ac02800 asr (register)
(defn- enc-madd [d :i64 n :i64 m :i64 a :i64] :i64                         ; 9b000000 madd xd, xn, xm, xa
  (+ (enc-rrr 2600468480 d n m) (enc-sh (enc-r a) 10)))
(defn- enc-mul [d :i64 n :i64 m :i64] :i64 (enc-madd d n m 31))
(defn- enc-mov-r [d :i64 m :i64] :i64 (enc-orr-r d 31 m))                  ; mov xd, xm (orr xd, xzr, xm)
(defn- enc-mvn [d :i64 m :i64] :i64 (enc-orn-r d 31 m))                    ; mvn xd, xm (orn xd, xzr, xm)
(defn- enc-cmp-r [n :i64 m :i64] :i64 (enc-subs-r 31 n m))                 ; cmp xn, xm
(defn- enc-cmn-r [n :i64 m :i64] :i64 (enc-adds-r 31 n m))                 ; cmn xn, xm
(defn- enc-csinc [d :i64 n :i64 m :i64 c :i64] :i64                       ; 9a800400 csinc xd, xn, xm, c
  (if (= 1 (enc-in c 0 15)) (+ (enc-rrr 2592080896 d n m) (enc-sh c 12)) -1))
(defn- enc-csel [d :i64 n :i64 m :i64 c :i64] :i64                        ; 9a800000 csel xd, xn, xm, c
  (if (= 1 (enc-in c 0 15)) (+ (enc-rrr 2592079872 d n m) (enc-sh c 12)) -1))
(defn- enc-cset [d :i64 c :i64] :i64                                       ; cset xd, c = csinc xd, xzr, xzr, !c
  (if (= 1 (enc-in c 0 13)) (enc-csinc d 31 31 (bit-xor c 1)) -1))
(defn- enc-eor-1 [d :i64 n :i64] :i64                                      ; d2400000 eor xd, xn, #1
  (+ 3527409664 (enc-sh (enc-r n) 5) (enc-r d)))

;; ---- add/sub immediate: imm 0..4095, or a multiple of 4096 below 2^24 (lsl #12). Register 31 = sp. ----------
(defn- enc-addsub-i [base :i64 d :i64 n :i64 imm :i64] :i64
  (cond (= 1 (enc-in imm 0 4095)) (+ base (enc-sh imm 10) (enc-sh (enc-r n) 5) (enc-r d))
        (= 1 (* (enc-in imm 4096 16777215) (enc-z (bit-and imm 4095))))
        (+ base 4194304 (enc-sh (u64-shift-right imm 12) 10) (enc-sh (enc-r n) 5) (enc-r d))
        :else -1))
(defn- enc-add-i [d :i64 n :i64 imm :i64] :i64 (enc-addsub-i 2432696320 d n imm))   ; 91000000
(defn- enc-adds-i [d :i64 n :i64 imm :i64] :i64 (enc-addsub-i 2969567232 d n imm))  ; b1000000
(defn- enc-sub-i [d :i64 n :i64 imm :i64] :i64 (enc-addsub-i 3506438144 d n imm))   ; d1000000
(defn- enc-subs-i [d :i64 n :i64 imm :i64] :i64 (enc-addsub-i 4043309056 d n imm))  ; f1000000
(defn- enc-cmp-i [n :i64 imm :i64] :i64 (enc-subs-i 31 n imm))
(defn- enc-cmn-i [n :i64 imm :i64] :i64 (enc-adds-i 31 n imm))
(defn- enc-mov-sp [d :i64 n :i64] :i64 (enc-add-i d n 0))                  ; mov to/from sp

;; ---- wide moves: imm16 0..65535 at halfword hw 0..3 --------------------------------------------------------------
(defn- enc-movw [base :i64 d :i64 imm :i64 hw :i64] :i64
  (if (= 1 (* (enc-in imm 0 65535) (enc-in hw 0 3)))
    (+ base (enc-sh hw 21) (enc-sh imm 5) (enc-r d))
    -1))
(defn- enc-movz [d :i64 imm :i64 hw :i64] :i64 (enc-movw 3531603968 d imm hw))  ; d2800000
(defn- enc-movk [d :i64 imm :i64 hw :i64] :i64 (enc-movw 4068474880 d imm hw))  ; f2800000
(defn- enc-movn [d :i64 imm :i64 hw :i64] :i64 (enc-movw 2457862144 d imm hw))  ; 92800000

;; ---- loads and stores (64-bit) -----------------------------------------------------------------------------------
;; ldr/str [xn, #off]: off in BYTES, a multiple of 8, 0..32760
(defn- enc-ldst-u [base :i64 t :i64 n :i64 off :i64] :i64
  (if (= 1 (* (enc-in off 0 32760) (enc-z (bit-and off 7))))
    (+ base (enc-sh (u64-shift-right off 3) 10) (enc-sh (enc-r n) 5) (enc-r t))
    -1))
(defn- enc-ldr [t :i64 n :i64 off :i64] :i64 (enc-ldst-u 4181721088 t n off))   ; f9400000
(defn- enc-str [t :i64 n :i64 off :i64] :i64 (enc-ldst-u 4177526784 t n off))   ; f9000000
;; ldur/stur [xn, #off]: off in bytes, -256..255
(defn- enc-ldst-s [base :i64 t :i64 n :i64 off :i64] :i64
  (if (= 1 (enc-in off -256 255))
    (+ base (enc-sh (bit-and off 511) 12) (enc-sh (enc-r n) 5) (enc-r t))
    -1))
(defn- enc-ldur [t :i64 n :i64 off :i64] :i64 (enc-ldst-s 4164943872 t n off))  ; f8400000
(defn- enc-stur [t :i64 n :i64 off :i64] :i64 (enc-ldst-s 4160749568 t n off))  ; f8000000
;; stp/ldp t1, t2, [xn, #off] (signed offset, pre-index !, post-index): off in bytes, multiple of 8, -512..504
(defn- enc-ldstp [base :i64 t1 :i64 t2 :i64 n :i64 off :i64] :i64
  (if (= 1 (* (enc-in off -512 504) (enc-z (bit-and off 7))))
    (+ base (enc-sh (bit-and (i64-shift-right off 3) 127) 15) (enc-sh (enc-r t2) 10) (enc-sh (enc-r n) 5) (enc-r t1))
    -1))
(defn- enc-stp-pre [t1 :i64 t2 :i64 n :i64 off :i64] :i64 (enc-ldstp 2843738112 t1 t2 n off))  ; a9800000
(defn- enc-ldp-post [t1 :i64 t2 :i64 n :i64 off :i64] :i64 (enc-ldstp 2831155200 t1 t2 n off)) ; a8c00000
(defn- enc-stp [t1 :i64 t2 :i64 n :i64 off :i64] :i64 (enc-ldstp 2835349504 t1 t2 n off))      ; a9000000
(defn- enc-ldp [t1 :i64 t2 :i64 n :i64 off :i64] :i64 (enc-ldstp 2839543808 t1 t2 n off))      ; a9400000

;; ---- branches: offsets in WORDS relative to the instruction (adr: in BYTES) ----------------------------------------
(defn- enc-b26 [base :i64 off :i64] :i64
  (if (= 1 (enc-in off -33554432 33554431)) (+ base (bit-and off 67108863)) -1))
(defn- enc-b [off :i64] :i64 (enc-b26 335544320 off))     ; 14000000
(defn- enc-bl [off :i64] :i64 (enc-b26 2483027968 off))   ; 94000000
(defn- enc-bcond [c :i64 off :i64] :i64                   ; 54000000 b.c
  (if (= 1 (* (enc-in c 0 15) (enc-in off -262144 262143)))
    (+ 1409286144 (enc-sh (bit-and off 524287) 5) c)
    -1))
(defn- enc-cb [base :i64 t :i64 off :i64] :i64
  (if (= 1 (enc-in off -262144 262143)) (+ base (enc-sh (bit-and off 524287) 5) (enc-r t)) -1))
(defn- enc-cbz [t :i64 off :i64] :i64 (enc-cb 3019898880 t off))    ; b4000000
(defn- enc-cbnz [t :i64 off :i64] :i64 (enc-cb 3036676096 t off))   ; b5000000
(defn- enc-adr [d :i64 off :i64] :i64                                 ; 10000000 adr xd, #off (bytes)
  (if (= 1 (enc-in off -1048576 1048575))
    (+ 268435456 (enc-sh (bit-and off 3) 29) (enc-sh (bit-and (i64-shift-right off 2) 524287) 5) (enc-r d))
    -1))
(defn- enc-br [n :i64] :i64 (+ 3592355840 (enc-sh (enc-r n) 5)))    ; d61f0000
(defn- enc-blr [n :i64] :i64 (+ 3594452992 (enc-sh (enc-r n) 5)))   ; d63f0000
(defn- enc-ret [] :i64 3596551104)                                   ; d65f03c0 ret (x30)
(defn- enc-brk [imm :i64] :i64                                        ; d4200000 brk #imm
  (if (= 1 (enc-in imm 0 65535)) (+ 3558866944 (enc-sh imm 5)) -1))
(defn- enc-nop [] :i64 3573751839)                                   ; d503201f

;; ---- patching (42-layout): replace the offset field of an already encoded word ------------------------------------
;; imm26 (b, bl), off in words
(defn- enc-patch-imm26 [w :i64 off :i64] :i64
  (if (= 1 (enc-in off -33554432 33554431)) (+ (bit-and w 4227858432) (bit-and off 67108863)) -1))   ; keep fc000000
;; imm19 at bits 5..23 (b.cond, cbz, cbnz), off in words
(defn- enc-patch-imm19 [w :i64 off :i64] :i64
  (if (= 1 (enc-in off -262144 262143)) (+ (bit-and w 4278190111) (enc-sh (bit-and off 524287) 5)) -1)) ; keep ff00001f
;; imm16 at bits 5..20 (movz, movk, movn)
(defn- enc-patch-imm16 [w :i64 imm :i64] :i64
  (if (= 1 (enc-in imm 0 65535)) (+ (bit-and w 4292870175) (enc-sh imm 5)) -1))                        ; keep ffe0001f

;; ---- FLOAT (agent FLOAT, rung r6j, 2026-10-04): scalar floating point. sz = 1 double (d registers), 0 single (s). ------
;; Words checked against clang -c + objdump (scripts/seed/a64enc-oracle.py style; seed/tests/float/enc.s).
(defn- enc-ftype [sz :i64] :i64 (if (= sz 1) 0x00400000 0))
;; fmov dN, xM / sN, wM (general -> fp) and xD, dN / wD, sN (fp -> general)
(defn- enc-fmov-to-fp [sz :i64 d :i64 n :i64] :i64 (+ (if (= sz 1) 0x9e670000 0x1e270000) (enc-sh (enc-r n) 5) (enc-r d)))
(defn- enc-fmov-from-fp [sz :i64 d :i64 n :i64] :i64 (+ (if (= sz 1) 0x9e660000 0x1e260000) (enc-sh (enc-r n) 5) (enc-r d)))
;; fadd/fsub/fmul/fdiv/fmin/fmax d|s: k = 0 add 1 sub 2 mul 3 div 4 min 5 max
(defn- enc-fop2-base [k :i64] :i64
  (cond (= k 0) 0x1e202800 (= k 1) 0x1e203800 (= k 2) 0x1e200800 (= k 3) 0x1e201800 (= k 4) 0x1e205800 (= k 5) 0x1e204800 :else -1))
(defn- enc-fop2 [k :i64 sz :i64 d :i64 n :i64 m :i64] :i64
  (if (< (enc-fop2-base k) 0) -1 (+ (enc-rrr (enc-fop2-base k) d n m) (enc-ftype sz))))
;; fneg/fabs/fsqrt d|s: k = 0 neg 1 abs 2 sqrt
(defn- enc-fop1-base [k :i64] :i64 (cond (= k 0) 0x1e214000 (= k 1) 0x1e20c000 (= k 2) 0x1e21c000 :else -1))
(defn- enc-fop1 [k :i64 sz :i64 d :i64 n :i64] :i64
  (if (< (enc-fop1-base k) 0) -1 (+ (enc-fop1-base k) (enc-ftype sz) (enc-sh (enc-r n) 5) (enc-r d))))
;; fcmp dN, dM / sN, sM
(defn- enc-fcmp [sz :i64 n :i64 m :i64] :i64 (+ 0x1e202000 (enc-ftype sz) (enc-sh (enc-r m) 16) (enc-sh (enc-r n) 5)))
;; fcvtzs xD, dN|sN (round toward zero, saturating, NaN -> 0); scvtf dD|sD, xN (round to nearest even)
(defn- enc-fcvtzs [sz :i64 d :i64 n :i64] :i64 (+ 0x9e380000 (enc-ftype sz) (enc-sh (enc-r n) 5) (enc-r d)))
(defn- enc-scvtf [sz :i64 d :i64 n :i64] :i64 (+ 0x9e220000 (enc-ftype sz) (enc-sh (enc-r n) 5) (enc-r d)))
;; fcvt sD, dN (sz = 1: narrow) / fcvt dD, sN (sz = 0: widen)
(defn- enc-fcvt [sz :i64 d :i64 n :i64] :i64 (+ (if (= sz 1) 0x1e624000 0x1e22c000) (enc-sh (enc-r n) 5) (enc-r d)))
;; sxtw xD, wN (sbfm xD, xN, #0, #31)
(defn- enc-sxtw [d :i64 n :i64] :i64 (+ 0x93407c00 (enc-sh (enc-r n) 5) (enc-r d)))

;; seed/41-a64gen.kotoba -- SIR -> AArch64 code words (prefix gn-). Owner: 41-a64gen.
;; Contracts: seed/SIR (:opcodes, :runtime, :a64, :fixups), seed/MEMORY-MAP (SIR FN LIT read; CODE FIX LABEL
;; MM-CODE-N MM-FIX-N FF-CODE written; one HEAP block via mem-alloc, its base in M[MM-STAT-BASE+36] = M[100]).
;; Encoders: 40-a64enc (an encoder's -1 becomes E-ENC-IMM) plus the few forms below (gn-e-*).
;;
;; gn-run [M] -> M. Translates every SIR instruction 1 .. MM-SIR-N-1 in order. MM-R0 = number of code words.
;; CODE word index 1 is the first instruction (index 0 is the null record; byte offset of word i = 4*(i-1),
;; 42-layout's ly-first). Branch, call and literal operands are emitted with a zero immediate plus a FIX record;
;; 42-layout patches them (displacement = target word index - XF-AT).
;;
;; R2 (rung 2, 2026-10-02, performance; no new language, SIR unchanged): the R0/R1 mapping (every local in a frame
;; slot, temp k in x(9+k), every runtime operation a C call) is replaced by
;; - a PRESCAN of each function (gn-pre): frame needs, leafness, label positions, slot use counts weighted x8 per
;;   enclosing back-edge (loop) region;
;; - REGISTER ALLOCATION of locals: in a LEAF function (no guest call, no cap call, no string/vector literal, only
;;   inlined runtime operations) slot k <= 7 lives in x(k-1) (the params stay where they arrive) and x7 (context)
;;   is never clobbered; the remaining slots, ranked by weighted use, get the callee-saved x19..x28 (saved in the
;;   prologue); the rest stay in frame slots. A leaf with every value in registers has no frame at all;
;; - DEFERRED TEMPORARIES: each temp carries a descriptor (REG = in its place, CONST k, LOCAL slot = equal to that
;;   local, HOME = spilled around a call). CONST and LOCAL cost nothing until used, so operands fold into
;;   immediate forms (add/sub #imm12, shifts by #n, and/orr/eor with a contiguous run of ones, mul/quot by a
;;   constant, cmp #imm12) and constants FOLD (bin, cmp, un, branches on a constant). At every label and jump the
;;   live temps are materialized (the label state is "all REG"); a result that is stored straight into a local
;;   (op; LSET s t; t dead) is computed into the local's register (the LSET is skipped);
;; - BRANCHES: cmp (+ not) + brz/brnz fuse into cmp + b.cond when the temp is dead on both paths; a branch to a
;;   label followed by `brz t` (same t, same sense) or by `br` jumps to the final target (threading); code after
;;   an unconditional jump, ret or trap is not emitted until the next label;
;; - INLINE RUNTIME OPERATIONS through the ABI v9 context pointers (offsets 288-328), the same handle check the C
;;   twin and stage-0 (kotoba-native machine_ir a64-inline-runtime) perform, trapping with udf #0 (SIGILL):
;;   vector-at, vector-assoc!, vector-count, pair-first, pair-second (= string-length); vector literals store their
;;   items straight into the fresh vector after vector_alloc;
;; - FUEL: in a leaf the counter is held in x8 (loaded at entry, `subs x8,x8,#1 ; b.hs ; brk` per charge, stored
;;   back at ret); in other functions the R0 sequence on [x7,#8]. Charges are unchanged in number (T5).
;;
;; Frame (when present): stp x29,x30,[sp,#-16]! ; mov x29,sp ; sub sp,sp,#F. Slot k (0 = saved x7 in a non-leaf,
;; 1..NS locals that have no register, NS+1+t = home of temp t) is at [sp,#F-8*(k+1)]; the callee-saved registers
;; are saved at [sp,#0..]. F = 16-rounded 8*(NS+DP+2) + 16-rounded 8*nsaved <= 32768 (E-GEN-FRAME).
;; Temps: t < 7 in x(9+t) (home used across calls), t >= 7 in its home. x16/x17 are scratch.

;; ---- errors and emission --------------------------------------------------------------------------------------
(defn- gn-put [M :vector-i64 a :i64 w :i64] :vector-i64 (vector-assoc! M a w))
;; first error wins (rule L10)
(defn- gn-err [M :vector-i64 code :i64 n :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (-> M (gn-put MM-ERR code) (gn-put MM-ERR-POS -1) (gn-put MM-ERR-N n))
    M))

;; append one instruction word; w = -1 (an encoder refused an operand) -> E-ENC-IMM {n} = the code word index
(defn- gn-emit [M :vector-i64 w :i64] :vector-i64
  (let [n (vector-at M MM-CODE-N)]
    (cond (< w 0) (gn-err M E-ENC-IMM n)
          (>= n MM-CODE-CAP) (gn-err M E-GEN-FULL n)
          :else (-> M (gn-put (+ MM-CODE-BASE n) w) (gn-put MM-CODE-N (+ n 1))))))

;; a FIX record for the NEXT word to be emitted
(defn- gn-fix [M :vector-i64 kind :i64 target :i64] :vector-i64
  (let [n (vector-at M MM-FIX-N)
        at (vector-at M MM-CODE-N)
        b (+ MM-FIX-BASE (* n MM-FIX-W))]
    (if (>= n MM-FIX-CAP)
      (gn-err M E-GEN-FULL n)
      (-> M
          (gn-put (+ b XF-AT) at)
          (gn-put (+ b XF-KIND) kind)
          (gn-put (+ b XF-TARGET) target)
          (gn-put (+ b XF-AUX) 0)
          (gn-put MM-FIX-N (+ n 1))))))

;; ---- readers ---------------------------------------------------------------------------------------------------
(defn- gn-sir [M :vector-i64 i :i64 f :i64] :i64 (vector-at M (+ MM-SIR-BASE (* i MM-SIR-W) f)))
(defn- gn-op [M :vector-i64 i :i64] :i64 (vector-at M (+ MM-SIR-BASE (* i MM-SIR-W))))
(defn- gn-fnf [M :vector-i64 f :i64 fld :i64] :i64 (vector-at M (+ MM-FN-BASE (* f MM-FN-W) fld)))
(defn- gn-litf [M :vector-i64 l :i64 fld :i64] :i64 (vector-at M (+ MM-LIT-BASE (* l MM-LIT-W) fld)))
(defn- gn-max [a :i64 b :i64] :i64 (if (> a b) a b))
(defn- gn-min [a :i64 b :i64] :i64 (if (< a b) a b))
(defn- gn-r16 [x :i64] :i64 (bit-and (+ x 15) -16))

;; ---- extra encoders (forms 40-a64enc does not have) ----------------------------------------------------------------
;; R4 rung proof: each encoder binds a field placer as a KNOWN let-bound fn literal (called directly, no closure built);
;; (fld x w s) = (x & w) << s, the register fields with w = 31, the 6-bit immediates with w = 63
;; R6B rung proof: the base words are hex literals (10-lex) and the forms carry docstrings (20-names reads them on the
;; single-module route); the values are the decimal words of R6A, so the code is unchanged.
(defn- gn-e-addsl
  "add xd, xn, xm, lsl #sh"
  [d :i64 n :i64 m :i64 sh :i64] :i64
  (let [fld (fn [x w s] (i64-shift-left (bit-and x w) s))]
    (+ 0x8b000000 (fld m 31 16) (fld sh 63 10) (fld n 31 5) (bit-and d 31))))
(defn- gn-e-ldrr
  "ldr xt, [xn, xm] (sc = 0) / [xn, xm, lsl #3] (sc = 1)"
  [t :i64 n :i64 m :i64 sc :i64] :i64
  (let [reg (fn [x s] (i64-shift-left (bit-and x 31) s))]
    (+ (if (= sc 1) 0xf8607800 0xf8606800) (reg m 16) (reg n 5) (bit-and t 31))))
(defn- gn-e-strr3
  "str xt, [xn, xm, lsl #3]"
  [t :i64 n :i64 m :i64] :i64
  (let [reg (fn [x s] (i64-shift-left (bit-and x 31) s))]
    (+ 0xf8207800 (reg m 16) (reg n 5) (bit-and t 31))))
(defn- gn-e-bf
  "bitfield and logical-immediate forms: base + immr<<16 + imms<<10 + n<<5 + d (N = 1, 64-bit element)"
  [base :i64 d :i64 n :i64 immr :i64 imms :i64] :i64
  (let [fld (fn [x w s] (i64-shift-left (bit-and x w) s))]
    (+ base (fld immr 63 16) (fld imms 63 10) (fld n 31 5) (bit-and d 31))))
;; lsl #s = ubfm d,n,#(-s mod 64),#(63-s) ; lsr #s = ubfm d,n,#s,#63 ; asr #s = sbfm d,n,#s,#63
(defn- gn-e-lsl [d :i64 n :i64 s :i64] :i64 (gn-e-bf 0xd3400000 d n (bit-and (- 64 s) 63) (- 63 s)))
(defn- gn-e-lsr [d :i64 n :i64 s :i64] :i64 (gn-e-bf 0xd3400000 d n s 63))
(defn- gn-e-asr [d :i64 n :i64 s :i64] :i64 (gn-e-bf 0x93400000 d n s 63))
(defn- gn-e-udf [] :i64 0)
(defn- gn-e-ldrb
  "ldrb wt, [xn, xm]"
  [t :i64 n :i64 m :i64] :i64
  (let [reg (fn [x s] (i64-shift-left (bit-and x 31) s))]
    (+ 0x38606800 (reg m 16) (reg n 5) (bit-and t 31))))
(defn- gn-e-adr
  "R4: adr xd, #0 (immhi/immlo patched by 42-layout, FX-ADR19)"
  [d :i64] :i64 (+ 0x10000000 (bit-and d 31)))

;; ---- the generator state G: a HEAP block, base in M[gn-cell] ------------------------------------------------------
(def gn-cell 100)
(def gn-f-leaf 0)     ; 1 = leaf function
(def gn-f-fuel 1)     ; 1 = the function has FUEL instructions
(def gn-f-nsv 2)      ; callee-saved registers used (x19 ..)
(def gn-f-fb 3)       ; frame bytes F (0 = no frame)
(def gn-f-ns 4)       ; NS: local slots
(def gn-f-dp 5)       ; DP: temps
(def gn-f-h 6)        ; stack height: temps 0 .. h-1 may be live
(def gn-f-ctx 7)      ; 1 = x7 holds the context
(def gn-f-vmode 8)    ; experimental descriptor cache mode; unused original state cell
(def gn-f-vslot 13) ; compile-time dominated stable-local descriptor witness
(def gn-f-dead 9)     ; 1 = the current point is unreachable (after br/ret/trap, until a label)
(def gn-f-skip 10)    ; SIR instructions after the current one that it consumed
(def gn-f-freg 11)    ; 1 = the fuel counter is in x8
(def gn-f-out 12)     ; R4B: bytes of the outgoing argument area at [sp,#0..] (calls with more than 7 arguments)
(def gn-cap 4096)     ; slots and temps per function (the frame limit F <= 32768 is lower)
(def gn-a-sreg 16)    ; slot -> register + 1 (0 = frame slot); gn-cap words
(def gn-a-use 4112)   ; slot -> weighted use count; gn-cap words
(def gn-a-dk 8208)    ; temp -> descriptor kind; gn-cap words
(def gn-a-dv 12304)   ; temp -> descriptor value; gn-cap words
(def gn-a-lp 16400)   ; label -> SIR index of its LABEL in the current function; MM-LABEL-CAP words
(def gn-g-open (+ gn-a-lp MM-LABEL-CAP)) ; module-wide first replaceable import FN (outside per-function reset)
(def gn-g-open-n (inc gn-g-open))       ; number of replaceable import FNs
(def gn-k-reg 1)
(def gn-k-const 2)
(def gn-k-local 3)
(def gn-k-home 4)
(def gn-k-lit 5)      ; a string literal whose only reader is string-length or string-code-point-at (no pair)

(defn- gn-g [M :vector-i64 f :i64] :i64 (vector-at M (+ (vector-at M gn-cell) f)))
(defn- gn-gs [M :vector-i64 f :i64 v :i64] :vector-i64 (gn-put M (+ (vector-at M gn-cell) f) v))
(defn- gn-gmax [M :vector-i64 f :i64 v :i64] :vector-i64 (if (> v (gn-g M f)) (gn-gs M f v) M))
(defn- gn-zero [M :vector-i64 i :i64 k :i64] :vector-i64 (if (>= i k) M (gn-zero (gn-gs M i 0) (inc i) k)))

(defn- gn-dk [M :vector-i64 t :i64] :i64 (gn-g M (+ gn-a-dk t)))
(defn- gn-dv [M :vector-i64 t :i64] :i64 (gn-g M (+ gn-a-dv t)))
(defn- gn-dset [M :vector-i64 t :i64 k :i64 v :i64] :vector-i64 (-> M (gn-gs (+ gn-a-dk t) k) (gn-gs (+ gn-a-dv t) v)))
;; temp t := (k, v) and the height becomes t+1
(defn- gn-def [M :vector-i64 t :i64 k :i64 v :i64] :vector-i64 (-> M (gn-dset t k v) (gn-gs gn-f-h (inc t))))
(defn- gn-isk [M :vector-i64 t :i64 k :i64] :bool (= (gn-dk M t) k))
;; register of local slot s, -1 = frame slot
(defn- gn-sreg [M :vector-i64 s :i64] :i64 (dec (gn-g M (+ gn-a-sreg s))))
(defn- gn-lpos [M :vector-i64 l :i64] :i64 (if (and (> l 0) (< l MM-LABEL-CAP)) (gn-g M (+ gn-a-lp l)) 0))

;; ---- frame slots ----------------------------------------------------------------------------------------------------
(defn- gn-soff [M :vector-i64 k :i64] :i64 (- (gn-g M gn-f-fb) (* 8 (inc k))))
(defn- gn-home [M :vector-i64 t :i64] :i64 (+ (gn-g M gn-f-ns) 1 t))
(defn- gn-ld [M :vector-i64 r :i64 k :i64] :vector-i64 (gn-emit M (enc-ldr r 31 (gn-soff M k))))
(defn- gn-st [M :vector-i64 r :i64 k :i64] :vector-i64 (gn-emit M (enc-str r 31 (gn-soff M k))))
(defn- gn-mov [M :vector-i64 d :i64 s :i64] :vector-i64 (if (= d s) M (gn-emit M (enc-mov-r d s))))

;; ---- constants --------------------------------------------------------------------------------------------------
(defn- gn-hw [k :i64 i :i64] :i64 (bit-and (u64-shift-right k (* 16 i)) 65535))
;; number of halfwords i..3 of k equal to v
(defn- gn-cnt [k :i64 v :i64 i :i64] :i64
  (if (> i 3) 0 (+ (if (= (gn-hw k i) v) 1 0) (gn-cnt k v (+ i 1)))))
(defn- gn-first-not [k :i64 v :i64 i :i64] :i64
  (cond (> i 3) 0
        (not= (gn-hw k i) v) i
        (= i 3) 0
        :else (gn-first-not k v (+ i 1))))
;; movk every halfword i..3 of k that differs from v
(defn- gn-movks [M :vector-i64 d :i64 k :i64 v :i64 i :i64] :vector-i64
  (cond (> i 3) M
        (= (gn-hw k i) v) (gn-movks M d k v (+ i 1))
        :else (gn-movks (gn-emit M (enc-movk d (gn-hw k i) i)) d k v (+ i 1))))
;; register d := k (movz + movk, or movn + movk when more halfwords are 0xffff than 0)
(defn- gn-mov-imm [M :vector-i64 d :i64 k :i64] :vector-i64
  (if (> (gn-cnt k 65535 0) (gn-cnt k 0 0))
    (let [i (gn-first-not k 65535 0)]
      (-> M (gn-emit (enc-movn d (bit-xor (gn-hw k i) 65535) i)) (gn-movks d k 65535 (+ i 1))))
    (let [i (gn-first-not k 0 0)]
      (-> M (gn-emit (enc-movz d (gn-hw k i) i)) (gn-movks d k 0 (+ i 1))))))

;; trailing zero bits of k (k != 0)
(defn- gn-tz [k :i64 n :i64] :i64 (if (or (>= n 63) (= (bit-and k 1) 1)) n (gn-tz (u64-shift-right k 1) (inc n))))
;; k is one contiguous run of ones (not 0, not -1): its length, else 0
(defn- gn-run-len [k :i64] :i64
  (if (or (= k 0) (= k -1))
    0
    (let [s (u64-shift-right k (gn-tz k 0))]
      (if (= (bit-and s (+ s 1)) 0) (gn-tz (bit-not s) 0) 0))))
;; k = 2^p, 1 <= p <= 62: p, else 0
(defn- gn-pow2 [k :i64] :i64
  (if (and (> k 1) (= (bit-and k (- k 1)) 0)) (gn-tz k 0) 0))

;; ---- temps: descriptors -> registers --------------------------------------------------------------------------------
;; the register that holds temp t now, or -1 when it must first be loaded into a scratch; z = 1: a CONST 0 may be
;; read as xzr (only for operand positions where register 31 means xzr)
(defn- gn-sr [M :vector-i64 t :i64 z :i64] :i64
  (let [k (gn-dk M t)
        v (gn-dv M t)]
    (cond (= k gn-k-const) (if (and (= z 1) (= v 0)) 31 -1)
          (= k gn-k-local) (gn-sreg M v)
          (= k gn-k-home) -1
          (< t 7) (+ 9 t)
          :else -1)))
(defn- gn-src [M :vector-i64 t :i64 s :i64 z :i64] :i64 (let [r (gn-sr M t z)] (if (< r 0) s r)))
;; load temp t into scratch s when gn-sr is -1
(defn- gn-ldt [M :vector-i64 t :i64 s :i64 z :i64] :vector-i64
  (if (>= (gn-sr M t z) 0)
    M
    (let [k (gn-dk M t)
          v (gn-dv M t)]
      (cond (= k gn-k-const) (gn-mov-imm M s v)
            (= k gn-k-local) (gn-ld M s v)
            (= k gn-k-lit) (gn-err M E-GEN-OP OP-STR)
            :else (gn-ld M s (gn-home M t))))))
;; register r := temp t
(defn- gn-into [M :vector-i64 r :i64 t :i64] :vector-i64
  (let [q (gn-sr M t 1)]
    (if (>= q 0) (gn-mov M r q) (gn-ldt M t r 1))))
;; put temp t in its canonical place (x(9+t), or its home for t >= 7) and mark it REG
(defn- gn-mat [M :vector-i64 t :i64] :vector-i64
  (let [k (gn-dk M t)]
    (cond (or (= k 0) (= k gn-k-reg)) M
          (< t 7) (-> M (gn-into (+ 9 t) t) (gn-dset t gn-k-reg 0))
          :else (let [q (gn-sr M t 1)
                      h (gn-home M t)]
                  (if (>= q 0)
                    (-> M (gn-st q h) (gn-dset t gn-k-reg 0))
                    (-> M (gn-ldt t 16 1) (gn-st 16 h) (gn-dset t gn-k-reg 0)))))))
(defn- gn-flush [M :vector-i64 i :i64 k :i64] :vector-i64 (if (>= i k) M (gn-flush (gn-mat M i) (inc i) k)))
(defn- gn-allreg [M :vector-i64 i :i64 k :i64] :vector-i64
  (if (>= i k) M (gn-allreg (gn-dset M i gn-k-reg 0) (inc i) k)))
;; materialize temps lo..hi-1 other than x whose value is "local s" (before s is written)
(defn- gn-prot [M :vector-i64 lo :i64 hi :i64 x :i64 s :i64] :vector-i64
  (cond (>= lo hi) M
        (and (not= lo x) (gn-isk M lo gn-k-local) (= (gn-dv M lo) s)) (gn-prot (gn-mat M lo) (inc lo) hi x s)
        :else (gn-prot M (inc lo) hi x s)))
;; save the register temps i..k-1 (k <= 7) to their homes before a call
(defn- gn-save [M :vector-i64 i :i64 k :i64] :vector-i64
  (cond (>= i (gn-min k 7)) M
        (or (= (gn-dk M i) 0) (gn-isk M i gn-k-reg)) (gn-save (-> M (gn-st (+ 9 i) (gn-home M i)) (gn-dset i gn-k-home 0)) (inc i) k)
        :else (gn-save M (inc i) k)))
;; temp t lives in a register that no inline sequence clobbers (x9.., a local's register), else -1
(defn- gn-pinned [M :vector-i64 t :i64] :i64
  (let [r (gn-sr M t 0)] (if (or (< r 0) (= r 16) (= r 17)) -1 r)))
(defn- gn-pin [M :vector-i64 t :i64] :vector-i64 (if (>= (gn-pinned M t) 0) M (gn-mat M t)))
;; x7 := the context (from slot 0) unless it is known to hold it
(defn- gn-ctx [M :vector-i64] :vector-i64
  (if (= (gn-g M gn-f-ctx) 1) M (-> M (gn-ld 7 0) (gn-gs gn-f-ctx 1))))

;; ---- liveness over straight-line SIR ----------------------------------------------------------------------------
(defn- gn-skiplab [M :vector-i64 j :i64] :i64 (if (= (gn-op M j) OP-LABEL) (gn-skiplab M (inc j)) j))
;; lowest / highest temp read by instruction j (lo > hi: none), and the temp it defines (-1: none)
(defn- gn-rlo [M :vector-i64 j :i64] :i64
  (let [op (gn-op M j)]
    (case op
      (OP-BIN OP-CMP OP-UN OP-LSET OP-CALL OP-RT OP-CALLI) (gn-sir M j IF-B)
      (OP-TAB OP-VEC OP-BRZ OP-BRNZ OP-RET OP-RET2) (gn-sir M j IF-A)
      OP-CAP (gn-sir M j IF-C)
      1)))
(defn- gn-rhi [M :vector-i64 j :i64] :i64
  (let [op (gn-op M j)
        a (gn-sir M j IF-A)
        b (gn-sir M j IF-B)
        c (gn-sir M j IF-C)]
    (case op
      (OP-BIN OP-CMP) (inc b)
      (OP-UN OP-LSET) b
      (OP-CALL OP-RT) (dec (+ b c))
      OP-CALLI (+ b c)
      OP-VEC (dec (+ a b))
      (OP-TAB OP-BRZ OP-BRNZ OP-RET) a
      OP-RET2 (inc a)   ; R5B
      OP-CAP c
      0)))
(defn- gn-defd [M :vector-i64 j :i64] :i64
  (let [op (gn-op M j)]
    (case op
      (OP-CONST OP-LGET OP-STR OP-TAB OP-VEC OP-FADDR OP-VECP OP-RES2) (gn-sir M j IF-A)
      (OP-BIN OP-CMP OP-UN OP-CALL OP-RT OP-CALLI) (gn-sir M j IF-B)
      OP-CAP (gn-sir M j IF-C)
      -1)))
;; true when the path from instruction j writes temp t (or a lower temp) before reading it, within n steps
(defn- gn-kills [M :vector-i64 j :i64 t :i64 n :i64] :bool
  (let [op (gn-op M j)
        d (gn-defd M j)]
    (cond (<= n 0) false
          (>= j (vector-at M MM-SIR-N)) false
          (or (= op OP-END) (= op OP-TRAP)) true
          (= op OP-RET) (not= (gn-sir M j IF-A) t)
          (= op OP-RET2) (and (not= (gn-sir M j IF-A) t) (not= (inc (gn-sir M j IF-A)) t))   ; R5B
          (= op OP-BR) (let [p (gn-lpos M (gn-sir M j IF-A))] (and (> p 0) (gn-kills M (inc p) t (dec n))))
          (or (= op OP-BRZ) (= op OP-BRNZ)) false
          (and (<= (gn-rlo M j) t) (<= t (gn-rhi M j))) false
          (and (>= d 0) (<= d t)) true
          :else (gn-kills M (inc j) t (dec n)))))
;; temp t is dead at label l (unknown label: live)
(defn- gn-dead-at [M :vector-i64 l :i64 t :i64] :bool
  (let [p (gn-lpos M l)] (and (> p 0) (gn-kills M (inc p) t 16))))
;; the first reader of temp t from instruction j on in straight-line code (n steps): its index, 0 = none or unknown
(defn- gn-reader [M :vector-i64 j :i64 t :i64 n :i64] :i64
  (let [op (gn-op M j)
        d (gn-defd M j)]
    (cond (or (<= n 0) (>= j (vector-at M MM-SIR-N))) 0
          (or (= op OP-LABEL) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ) (= op OP-RET) (= op OP-RET2) (= op OP-END) (= op OP-TRAP) (= op OP-FN)) 0
          (and (<= (gn-rlo M j) t) (<= t (gn-rhi M j))) j
          (and (>= d 0) (<= d t)) 0
          :else (gn-reader M (inc j) t (dec n)))))
(defn- gn-ascii [M :vector-i64 b :i64 k :i64 n :i64] :bool
  (cond (>= k n) true
        (> (vector-at M (+ MM-LITB-BASE b k)) 127) false
        :else (gn-ascii M b (inc k) n)))
;; STR at j needs no pair when its only reader k is string-length, or string-code-point-at over an ASCII literal: k, else 0
(defn- gn-str-fold [M :vector-i64 j :i64] :i64
  (let [t (gn-sir M j IF-A)
        lit (gn-sir M j IF-B)
        k (gn-reader M (inc j) t 64)
        slot (gn-sir M k IF-A)
        n (gn-sir M k IF-C)]
    (if (and (> k 0) (= (gn-op M k) OP-RT) (= (gn-sir M k IF-B) t)
             (or (and (= slot RT-PAIR-SECOND) (= n 1))
                 (and (= slot RT-STRING-CODE-POINT-AT) (= n 2) (<= t 5)
                      (gn-ascii M (gn-litf M lit LF-B) 0 (gn-litf M lit LF-LEN)))))
      k
      0)))
;; the folded STR whose reader is the RT at k (operand temp t), else 0
(defn- gn-back-str [M :vector-i64 k :i64 j :i64 t :i64] :i64
  (let [op (gn-op M j)
        d (gn-defd M j)]
    (cond (or (<= j 0) (< j (- k 64))) 0
          (or (= op OP-LABEL) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ) (= op OP-RET) (= op OP-RET2) (= op OP-END) (= op OP-TRAP) (= op OP-FN)) 0
          (= d t) (if (and (= op OP-STR) (= (gn-str-fold M j) k)) j 0)
          (and (>= d 0) (< d t)) 0
          :else (gn-back-str M k (dec j) t))))
;; final target of a jump to label l: through `br` chains, and through `brz t` (nz = 0) / `brnz t` (nz = 1) that the
;; same value of t takes again (nz = 2: br only)
(defn- gn-thread [M :vector-i64 l :i64 t :i64 nz :i64 n :i64] :i64
  (let [p (gn-lpos M l)]
    (if (or (<= n 0) (<= p 0))
      l
      (let [j (gn-skiplab M (inc p))
            op (gn-op M j)
            want (cond (= nz 0) OP-BRZ (= nz 1) OP-BRNZ :else -1)]
        (cond (= op OP-BR) (gn-thread M (gn-sir M j IF-A) t nz (dec n))
              (and (= op want) (= (gn-sir M j IF-A) t)) (gn-thread M (gn-sir M j IF-B) t nz (dec n))
              :else l)))))
;; the live height at label l: h lowered while the top temp is dead there
(defn- gn-live-at [M :vector-i64 h :i64 l :i64] :i64
  (if (and (> h 0) (gn-dead-at M l (dec h))) (gn-live-at M (dec h) l) h))
;; before a jump to l at height h: materialize the temps that are live at l
(defn- gn-jflush [M :vector-i64 h :i64 l :i64] :vector-i64 (gn-flush M 0 (gn-live-at M h l)))

;; ---- results: "op i computes temp t" -----------------------------------------------------------------------------
;; the local slot the result can be written to directly (op i; LSET s t; t dead afterwards; s in a register), else 0
(defn- gn-co [M :vector-i64 i :i64 t :i64] :i64
  (let [j (inc i)
        s (gn-sir M j IF-A)]
    (if (and (= (gn-op M j) OP-LSET) (= (gn-sir M j IF-B) t) (>= (gn-sreg M s) 0) (gn-kills M (inc j) t 16)) s 0)))
;; destination register: the local's (s > 0), x(9+t), or x16 for a temp in its home
(defn- gn-dreg [M :vector-i64 t :i64 s :i64] :i64 (cond (> s 0) (gn-sreg M s) (< t 7) (+ 9 t) :else 16))
(defn- gn-protect [M :vector-i64 t :i64 s :i64] :vector-i64 (if (> s 0) (gn-prot M 0 t t s) M))
;; the result is in register d: record it (and skip the LSET that was folded in)
(defn- gn-fin [M :vector-i64 t :i64 s :i64 d :i64] :vector-i64
 (gn-fin-quiet (gn-vdrop M s) t s d))
(defn- gn-fin-quiet [M :vector-i64 t :i64 s :i64 d :i64] :vector-i64
  (cond (> s 0) (-> M (gn-def t gn-k-local s) (gn-gs gn-f-skip 1))
        (>= t 7) (-> M (gn-st d (gn-home M t)) (gn-def t gn-k-reg 0))
        :else (gn-def M t gn-k-reg 0)))
;; the result of a call is in register r
(defn- gn-take [M :vector-i64 i :i64 t :i64 r :i64] :vector-i64
  (let [s (gn-co M i t)
        d (if (and (= s 0) (>= t 7)) r (gn-dreg M t s))]
    (-> M (gn-protect t s) (gn-mov d r) (gn-fin t s d))))

;; ---- prescan of one function ------------------------------------------------------------------------------------
;; temps needed by SIR instruction i (0 when it names none)
(defn- gn-need-t [M :vector-i64 i :i64] :i64
  (let [a (gn-sir M i IF-A)
        b (gn-sir M i IF-B)
        c (gn-sir M i IF-C)]
    (case (gn-op M i)
      (OP-CONST OP-LGET OP-STR OP-RET OP-BRZ OP-BRNZ OP-TAB OP-FADDR OP-VECP OP-RES2) (+ a 1)
      OP-RET2 (+ a 2)   ; R5B
      (OP-LSET OP-UN) (+ b 1)
      (OP-BIN OP-CMP) (+ b 2)
      OP-CAP (+ c 1)
      (OP-CALL OP-RT) (+ b (gn-max c 1))
      OP-CALLI (+ b c 1)
      OP-VEC (+ a (gn-max b 1))
      0)))
;; highest local slot named by SIR instruction i
(defn- gn-need-s [M :vector-i64 i :i64] :i64
  (case (gn-op M i)
    OP-LGET (gn-sir M i IF-B)
    OP-LSET (gn-sir M i IF-A)
    0))
;; runtime operations emitted in line (and the temps they need in x9..x15)
(defn- gn-inl [slot :i64 t :i64 n :i64] :bool
  (cond (= slot RT-VECTOR-AT) (and (= n 2) (<= t 5))
        (= slot RT-VECTOR-ASSOC-IN-PLACE) (and (= n 3) (<= t 4))
        (or (= slot RT-PAIR-FIRST) (= slot RT-PAIR-SECOND) (= slot RT-VECTOR-COUNT)) (= n 1)
        :else false))
;; Exact straight-line wrappers only: optional entry FUEL/LABEL, natural
;; parameter loads, one already-inlined runtime operation (or identity), RET.
;; No source names or benchmark-specific decisions. 256 encodes entry fuel.
(defn- gn-wparams [M :vector-i64 j :i64 k :i64 n :i64] :i64
  (cond (= k n) j
        (and (= (gn-op M j) OP-LGET) (= (gn-sir M j IF-A) k) (= (gn-sir M j IF-B) (inc k)))
        (gn-wparams M (inc j) (inc k) n)
        :else 0))
(defn- gn-wrapper [M :vector-i64 f :i64 t :i64 n :i64] :i64
  (let [p (gn-fnf M f FF-SIR)]
    (if (or (< p 1) (< n 1) (> n 3) (not= (gn-op M p) OP-FN) (not= (gn-sir M p IF-A) f) (not= (gn-sir M p IF-B) n))
      0
      (let [fuel (if (= (gn-op M (inc p)) OP-FUEL) 256 0)
            q (gn-skiplab M (+ p 1 (if (> fuel 0) 1 0)))
            j (gn-wparams M q 0 n)
            rt (= (gn-op M j) OP-RT)
            slot (if rt (gn-sir M j IF-A) 1)
            ret (if rt (inc j) j)]
        (if (and (> j 0) (= (gn-op M ret) OP-RET) (= (gn-sir M ret IF-A) 0) (= (gn-op M (inc ret)) OP-END)
                 (if rt (and (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) n) (gn-inl slot t n)) (= n 1)))
          (+ slot fuel)
          0)))))
;; Exact scalar sign-extension decision tree: mask, local, signed >= half,
;; subtract modulus on the high half, join and return. Width 1..32 only.
;; Token 1024 + width; bit 9 records the original optional entry fuel.
(defn- gn-sign-wrapper [M :vector-i64 f :i64 n :i64] :i64
  (let [p (gn-fnf M f FF-SIR)]
    (if (or (< p 1) (not= n 1) (not= (gn-op M p) OP-FN)
            (not= (gn-sir M p IF-A) f) (not= (gn-sir M p IF-B) 1)) 0
      (let [fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
            q (gn-skiplab M (+ p 1 fuel)) mask (gn-sir M (inc q) IF-B)
            half (quot (inc mask) 2) slot (gn-sir M (+ q 3) IF-A)
            le (gn-sir M (+ q 7) IF-B) lx (gn-sir M (+ q 11) IF-A)]
        (if (and (> mask 0) (<= mask 4294967295) (= (bit-and mask (inc mask)) 0)
                 (= (gn-op M q) OP-LGET) (= (gn-sir M q IF-A) 0) (= (gn-sir M q IF-B) 1)
                 (= (gn-op M (inc q)) OP-CONST) (= (gn-sir M (inc q) IF-A) 1)
                 (= (gn-op M (+ q 2)) OP-BIN) (= (gn-sir M (+ q 2) IF-A) BOP-AND) (= (gn-sir M (+ q 2) IF-B) 0)
                 (= (gn-op M (+ q 3)) OP-LSET) (> slot 1) (= (gn-sir M (+ q 3) IF-B) 0)
                 (= (gn-op M (+ q 4)) OP-LGET) (= (gn-sir M (+ q 4) IF-A) 0) (= (gn-sir M (+ q 4) IF-B) slot)
                 (= (gn-op M (+ q 5)) OP-CONST) (= (gn-sir M (+ q 5) IF-A) 1) (= (gn-sir M (+ q 5) IF-B) half)
                 (= (gn-op M (+ q 6)) OP-CMP) (= (gn-sir M (+ q 6) IF-A) CC-GE) (= (gn-sir M (+ q 6) IF-B) 0)
                 (= (gn-op M (+ q 7)) OP-BRZ) (= (gn-sir M (+ q 7) IF-A) 0) (> le 0)
                 (= (gn-op M (+ q 8)) OP-LGET) (= (gn-sir M (+ q 8) IF-A) 0) (= (gn-sir M (+ q 8) IF-B) slot)
                 (= (gn-op M (+ q 9)) OP-CONST) (= (gn-sir M (+ q 9) IF-A) 1) (= (gn-sir M (+ q 9) IF-B) (inc mask))
                 (= (gn-op M (+ q 10)) OP-BIN) (= (gn-sir M (+ q 10) IF-A) BOP-SUB) (= (gn-sir M (+ q 10) IF-B) 0)
                 (= (gn-op M (+ q 11)) OP-BR) (> lx 0) (not= le lx)
                 (= (gn-op M (+ q 12)) OP-LABEL) (= (gn-sir M (+ q 12) IF-A) le)
                 (= (gn-op M (+ q 13)) OP-LGET) (= (gn-sir M (+ q 13) IF-A) 0) (= (gn-sir M (+ q 13) IF-B) slot)
                 (= (gn-op M (+ q 14)) OP-LABEL) (= (gn-sir M (+ q 14) IF-A) lx)
                 (= (gn-op M (+ q 15)) OP-RET) (= (gn-sir M (+ q 15) IF-A) 0)
                 (= (gn-op M (+ q 16)) OP-END))
          (+ 1024 (gn-tz (inc mask) 0) (* fuel 512)) 0)))))
(defn- gn-call-wrapper [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
  (if (= (gn-op M (inc i)) OP-RES2) 0
      (let [w (gn-wrapper M f t n)] (if (> w 0) w (gn-sign-wrapper M f n)))))

;; Exact charged mask-and-write composition. Keep it outside gn-call-wrapper
;; so prescan retains the caller's original nonleaf frame and fuel publication.
;; Natural parameters, AND255, one charged inline writer dependency, RET/END.
(defn- gn-mask-writer [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :bool
  (let [p (gn-fnf M f FF-SIR)
        q (gn-skiplab M (+ p 2))
        target (gn-sir M (+ q 5) IF-A)]
    (and (> p 0) (= n 3) (<= t 4) (= (gn-g M gn-f-leaf) 0)
         (not= (gn-op M (inc i)) OP-RES2)
         (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 3)
         (= (gn-op M (inc p)) OP-FUEL)
         (= (gn-wparams M q 0 3) (+ q 3))
         (= (gn-op M (+ q 3)) OP-CONST) (= (gn-sir M (+ q 3) IF-A) 3) (= (gn-sir M (+ q 3) IF-B) 255)
         (= (gn-op M (+ q 4)) OP-BIN) (= (gn-sir M (+ q 4) IF-A) BOP-AND) (= (gn-sir M (+ q 4) IF-B) 2)
         (= (gn-op M (+ q 5)) OP-CALL) (= (gn-sir M (+ q 5) IF-B) 0) (= (gn-sir M (+ q 5) IF-C) 3)
         (= (gn-wrapper M target 0 3) (+ RT-VECTOR-ASSOC-IN-PLACE 256))
         (= (gn-op M (+ q 6)) OP-RET) (= (gn-sir M (+ q 6) IF-A) 0)
         (= (gn-op M (+ q 7)) OP-END))))

;; Exact signed-extension followed by an ordered signed clamp tree.
;; Keep the original caller nonleaf. Open link-time bodies cannot prove it.
(defn- gn-clamp-open [M :vector-i64 f :i64] :bool
  (and (>= f (gn-g M gn-g-open)) (< f (+ (gn-g M gn-g-open) (gn-g M gn-g-open-n)))))
(defn- gn-clamp [M :vector-i64 i :i64 f :i64 n :i64] :i64
  (let [p (gn-fnf M f FF-SIR) fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
        q (gn-skiplab M (+ p 1 fuel)) target (gn-sir M (inc q) IF-A)
        slot (gn-sir M (+ q 2) IF-A) low (gn-sir M (+ q 4) IF-B) high (gn-sir M (+ q 11) IF-B)
        le (gn-sir M (+ q 6) IF-B) lx (gn-sir M (+ q 8) IF-A)
        le2 (gn-sir M (+ q 13) IF-B) lx2 (gn-sir M (+ q 15) IF-A)]
    (if (and (> p 0) (= n 1) (= (gn-g M gn-f-leaf) 0)
             (not (gn-clamp-open M f)) (not (gn-clamp-open M target))
             (not= (gn-op M (inc i)) OP-RES2)
             (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 1)
             (= (gn-op M q) OP-LGET) (= (gn-sir M q IF-A) 0) (= (gn-sir M q IF-B) 1)
             (= (gn-op M (inc q)) OP-CALL) (= (gn-sir M (inc q) IF-B) 0) (= (gn-sir M (inc q) IF-C) 1)
             (> (gn-sign-wrapper M target 1) 0)
             (= (gn-op M (+ q 2)) OP-LSET) (> slot 1) (= (gn-sir M (+ q 2) IF-B) 0)
             (= (gn-op M (+ q 3)) OP-LGET) (= (gn-sir M (+ q 3) IF-A) 0) (= (gn-sir M (+ q 3) IF-B) slot)
             (= (gn-op M (+ q 4)) OP-CONST) (= (gn-sir M (+ q 4) IF-A) 1) (<= low high)
             (= (gn-op M (+ q 5)) OP-CMP) (= (gn-sir M (+ q 5) IF-A) CC-LT) (= (gn-sir M (+ q 5) IF-B) 0)
             (= (gn-op M (+ q 6)) OP-BRZ) (= (gn-sir M (+ q 6) IF-A) 0) (> le 0)
             (= (gn-op M (+ q 7)) OP-CONST) (= (gn-sir M (+ q 7) IF-A) 0) (= (gn-sir M (+ q 7) IF-B) low)
             (= (gn-op M (+ q 8)) OP-BR) (> lx 0)
             (= (gn-op M (+ q 9)) OP-LABEL) (= (gn-sir M (+ q 9) IF-A) le)
             (= (gn-op M (+ q 10)) OP-LGET) (= (gn-sir M (+ q 10) IF-A) 0) (= (gn-sir M (+ q 10) IF-B) slot)
             (= (gn-op M (+ q 11)) OP-CONST) (= (gn-sir M (+ q 11) IF-A) 1)
             (= (gn-op M (+ q 12)) OP-CMP) (= (gn-sir M (+ q 12) IF-A) CC-GT) (= (gn-sir M (+ q 12) IF-B) 0)
             (= (gn-op M (+ q 13)) OP-BRZ) (= (gn-sir M (+ q 13) IF-A) 0) (> le2 0)
             (= (gn-op M (+ q 14)) OP-CONST) (= (gn-sir M (+ q 14) IF-A) 0) (= (gn-sir M (+ q 14) IF-B) high)
             (= (gn-op M (+ q 15)) OP-BR) (> lx2 0)
             (= (gn-op M (+ q 16)) OP-LABEL) (= (gn-sir M (+ q 16) IF-A) le2)
             (= (gn-op M (+ q 17)) OP-LGET) (= (gn-sir M (+ q 17) IF-A) 0) (= (gn-sir M (+ q 17) IF-B) slot)
             (= (gn-op M (+ q 18)) OP-LABEL) (= (gn-sir M (+ q 18) IF-A) lx2)
             (= (gn-op M (+ q 19)) OP-LABEL) (= (gn-sir M (+ q 19) IF-A) lx)
             (not= le lx) (not= le le2) (not= le lx2) (not= lx le2) (not= lx lx2) (not= le2 lx2)
             (= (gn-op M (+ q 20)) OP-RET) (= (gn-sir M (+ q 20) IF-A) 0)
             (= (gn-op M (+ q 21)) OP-END) (= (gn-sir M (+ q 21) IF-A) f)) q 0)))

(defn- gn-use [M :vector-i64 s :i64 w :i64] :vector-i64
  (if (and (>= s 0) (< s gn-cap)) (gn-gs M (+ gn-a-use s) (+ w (gn-g M (+ gn-a-use s)))) M))
(defn- gn-use1 [M :vector-i64 j :i64 w :i64] :vector-i64
  (case (gn-op M j)
    OP-LGET (gn-use M (gn-sir M j IF-B) w)
    OP-LSET (gn-use M (gn-sir M j IF-A) w)
    M))
;; a back-edge from j to the LABEL at p: every use in p..j weighs 8 more
(defn- gn-weigh [M :vector-i64 p :i64 j :i64] :vector-i64 (if (> p j) M (gn-weigh (gn-use1 M p 8) (inc p) j)))
(defn- gn-pre-op [M :vector-i64 j :i64] :vector-i64
  (let [op (gn-op M j)
        a (gn-sir M j IF-A)]
    (case op
      (OP-LGET OP-LSET) (gn-use1 M j 1)
      OP-LABEL (if (and (> a 0) (< a MM-LABEL-CAP)) (gn-gs M (+ gn-a-lp a) j) M)
      (OP-CAP OP-VEC OP-CALLI OP-VECP) (gn-gs M gn-f-leaf 0)
      ;; R4B: a call with more than 7 arguments needs the outgoing area
      OP-CALL (let [w (gn-call-wrapper M j a (gn-sir M j IF-B) (gn-sir M j IF-C))]
                (if (> w 0) (if (if (>= w 1024) (>= w 1536) (>= w 256)) (gn-gs M gn-f-fuel 1) M)
                    (-> M (gn-gs gn-f-leaf 0) (gn-gmax gn-f-out (gn-r16 (* 8 (gn-max 0 (- (gn-sir M j IF-C) 7))))))))
      OP-STR (if (> (gn-str-fold M j) 0) M (gn-gs M gn-f-leaf 0))
      OP-RT (if (or (gn-inl a (gn-sir M j IF-B) (gn-sir M j IF-C))
                    (and (= a RT-STRING-CODE-POINT-AT) (> (gn-back-str M j (dec j) (gn-sir M j IF-B)) 0)))
              M
              (gn-gs M gn-f-leaf 0))
      OP-FUEL (gn-gs M gn-f-fuel 1)
      OP-BR (let [p (gn-lpos M a)] (if (> p 0) (gn-weigh M p j) M))
      M)))
;; scan i .. the END of the function: what = 1 -> max temps, 2 -> max slot
(defn- gn-scan [M :vector-i64 i :i64 what :i64 acc :i64] :i64
  (cond (>= i (vector-at M MM-SIR-N)) acc
        (= (gn-op M i) OP-END) acc
        :else (gn-scan M (+ i 1) what (gn-max acc (if (= what 1) (gn-need-t M i) (gn-need-s M i))))))
(defn- gn-pre [M :vector-i64 j :i64] :vector-i64
  (let [op (gn-op M j)]
    (if (or (>= j (vector-at M MM-SIR-N)) (= op OP-END))
      M
      (gn-pre (gn-pre-op M j) (inc j)))))

;; Experimental loop cache: x3=length, x4=data base, x5=positive key;0=invalid.
;; Dynamic handle checks cover joins/reassignment. Unknown returning calls clear.
;; Only nonleaf functions with actual same-function high-depth loop reads admit;
;; x3..5 are proven free; field8 is named, state14 remains the scalar-tree flag.
(defn- gn-vhot-scan [M :vector-i64 j :i64 work :i64] :bool
 (if (or (<= work 0) (>= j (vector-at M MM-SIR-N))) false
  (let [op (gn-op M j)]
   (cond (or (= op OP-END) (= op OP-FN)) false
         (and (= op OP-RT) (= (gn-sir M j IF-A) RT-VECTOR-AT)
              (= (gn-sir M j IF-C) 2) (>= (gn-sir M j IF-B) 6)
              (gn-high-loop M j)) true
         :else (gn-vhot-scan M (inc j) (dec work))))))
;; Private descriptor ABI: mode2 locals x0..2, temps x9..11, spare x3..5.
;; Target proof duplicates original classification facts without mutating G.
(defn- gn-chain-extra [M :vector-i64 j :i64 end :i64 ns :i64 dp :i64 found :i64] :i64
 (if (= j end) found
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
        valid (case op
          OP-CONST (and (>= a 0) (< a dp) (= c 0))
          OP-LGET (and (>= a 0) (< a dp) (> b 0) (<= b ns) (= c 0))
          OP-LSET (and (> a 0) (<= a ns) (>= b 0) (< b dp) (= c 0))
          OP-BIN (and (>= a 0) (< a BOP-F64-ADD) (>= b 0) (< (inc b) dp) (= c 0))
          OP-CMP (and (>= a 0) (< a CC-F64-EQ) (>= b 0) (< (inc b) dp) (= c 0))
          OP-UN (and (>= a 0) (< a UOP-F64-NEG) (>= b 0) (< b dp) (= c 0))
          OP-RET (and (>= a 0) (< a dp) (= b 0) (= c 0))
          (OP-CALL OP-RT) (and (>= b 0) (> c 0) (<= (+ b c) dp))
          (OP-BRZ OP-BRNZ) (and (>= a 0) (< a dp) (= c 0))
          (OP-FUEL OP-LABEL OP-BR) true
          false)
        genuine (and (= op OP-CALL) (= (gn-call-wrapper M j a b c) 0))]
   (if valid (gn-chain-extra M (inc j) end ns dp (if genuine 1 found)) -1))))
(defn- gn-chain-target [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR) ns (gn-fnf M f FF-NSLOTS) dp (gn-fnf M f FF-DEPTH)]
   (if (or (<= p 0) (>= p (vector-at M MM-SIR-N))
           (< ns 1) (> ns 3) (< dp 1) (> dp 3)) false
    (let [end (gn-small-end M (inc p) f 4096)]
     (and (> end p) (= (gn-op M p) OP-FN)
          (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 1) (= (gn-sir M p IF-C) ns)
          (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-PT0) TY-VEC)
          (= (gn-fnf M f FF-RTYPE) TY-VEC)
          (<= (gn-scan M (inc p) 2 0) ns) (<= (gn-scan M (inc p) 1 0) dp)
          (gn-small-scan M (inc p) p end TY-VEC)
          (= (gn-chain-extra M (inc p) end ns dp 0) 1)))))))
(defn- gn-chain-mode [M :vector-i64 i :i64] :bool
 (and (= (gn-g M gn-f-leaf) 2) (>= (gn-g M gn-f-ns) 1) (<= (gn-g M gn-f-ns) 3)
      (>= (gn-g M gn-f-dp) 1) (<= (gn-g M gn-f-dp) 3)
      (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-fb) 0)
      (= (gn-sreg M 1) 0) (gn-chain-target M (gn-sir M i IF-A))))
(defn- gn-chain-base [M :vector-i64 rv :i64 slot :i64] :vector-i64
 (let [known (gn-g M gn-f-vslot)
       hit (and (> slot 0) (= slot known))
       conditional (and (= known -1) (= slot 1))
       M1 (cond hit M
            conditional (gn-emit M (enc-cbnz 5 13))
            :else (-> M (gn-emit (enc-cbz 5 3)) (gn-emit (enc-cmp-r rv 5)) (gn-emit (enc-bcond (enc-cond-eq) 13))))
       M2 (if hit M1
          (-> M1 (gn-mov 5 rv) (gn-hchk 5 312 320)
           (gn-emit (enc-ldp 17 3 16 0)) (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))))]
  (gn-gs M2 gn-f-vslot slot)))
;; Excluded finite admission proof: whole-body no calls/allocation/write effects.
;; Single typed Vec parameter stays same local; exact linear reaching-copy
;; witnesses for every vector handle producer and assignment to that local.
;; Cached registers are newly reserved/saved callee registers, never x3..5.
(defn- sl-end [M :vector-i64 j :i64 f :i64 work :i64] :i64
 (cond (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) 0
       (= (gn-op M j) OP-FN) 0
       (= (gn-op M j) OP-END) (if (= (gn-sir M j IF-A) f) j 0)
       :else (sl-end M (inc j) f (dec work))))
(defn- sl-pick [M :vector-i64 f :i64 np :i64 k :i64 chosen :i64] :i64
 (if (= k np) chosen
  (let [ty (gn-fnf M f (+ FF-PT0 k))]
   (cond (= ty TY-VEC) (if (> chosen 0) 0 (sl-pick M f np (inc k) (inc k)))
         (or (= ty TY-I64) (= ty TY-BOOL)) (sl-pick M f np (inc k) chosen)
         :else 0))))
(defn- sl-label-valid [M :vector-i64 target :i64 start :i64 end :i64] :bool
 (let [p (if (and (> target 0) (< target MM-LABEL-CAP)) (gn-lpos M target) 0)]
  (and (> p start) (< p end) (= (gn-op M p) OP-LABEL) (= (gn-sir M p IF-A) target))))
(defn- sl-count-label [M :vector-i64 j :i64 end :i64 target :i64 n :i64] :i64
 (if (>= j end) n
  (sl-count-label M (inc j) end target (if (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) target)) (inc n) n))))
;; Bounded rooted must-origin proof. S is excluded compiler scratch, never M.
;; Header: remaining visits, okay, bodyN, start, end, chosenLocal, edgeN, epoch.
;; Four node arrays and two 2N edge arrays; size8+8*(N+1), zero allocated.
(defn- sc-l [S :vector-i64] :i64 (inc (vector-at S 2)))
(defn- sc-head [S :vector-i64 k :i64] :i64 (vector-at S (+ 8 k)))
(defn- sc-mark-at [S :vector-i64 k :i64] :i64 (+ 8 (+ (sc-l S) k)))
(defn- sc-node-at [S :vector-i64 d :i64] :i64 (+ 8 (+ (* 2 (sc-l S)) d)))
(defn- sc-cursor-at [S :vector-i64 d :i64] :i64 (+ 8 (+ (* 3 (sc-l S)) d)))
(defn- sc-from-at [S :vector-i64 e :i64] :i64 (+ 8 (+ (* 4 (sc-l S)) e)))
(defn- sc-next-at [S :vector-i64 e :i64] :i64 (+ 8 (+ (* 6 (sc-l S)) e)))
(defn- sc-fail [S :vector-i64] :vector-i64 (vector-assoc! S 1 0))
(defn- sc-edge [S :vector-i64 from :i64 to :i64] :vector-i64
 (let [n (vector-at S 2) e (inc (vector-at S 6))]
  (cond (= to (inc n)) S
        (or (< from 1) (> from n) (< to 1) (> to n) (> e (* 2 n))) (sc-fail S)
        :else (let [prev (sc-head S to)]
          (-> S (vector-assoc! (sc-from-at S e) from) (vector-assoc! (sc-next-at S e) prev)
                (vector-assoc! (+ 8 to) e) (vector-assoc! 6 e))))))
(defn- sc-build [M :vector-i64 start :i64 end :i64 slot :i64] :vector-i64
 (let [n (- end (inc start)) S (-> (vector-alloc (+ 8 (* 8 (inc n))))
         (vector-assoc! 0 131072) (vector-assoc! 1 1) (vector-assoc! 2 n)
         (vector-assoc! 3 start) (vector-assoc! 4 end) (vector-assoc! 5 slot))]
  (loop [j (inc start) reads 0 backs 0]
   (if (or (= (vector-at S 1) 0) (= j end))
    (if (and (>= reads 2) (> backs 0)) S (sc-fail S))
    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
          target (if (= op OP-BR) a b)
          branch (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ))
          valid (cond (or (= op OP-CONST) (= op OP-LGET) (= op OP-LSET) (= op OP-RET) (= op OP-FUEL)) true
                      (= op OP-BIN) (< a BOP-F64-ADD)
                      (= op OP-CMP) (< a CC-F64-EQ)
                      (= op OP-UN) (< a UOP-F64-NEG)
                      (= op OP-RT) (and (= a RT-VECTOR-AT) (= c 2) (>= b 0) (<= b 5))
                      (= op OP-LABEL) (and (> a 0) (< a MM-LABEL-CAP) (= (sl-count-label M (inc start) end a 0) 1))
                      branch (sl-label-valid M target start end)
                      :else false)
          k (- j start)
          S1 (cond (not valid) (sc-fail S)
                   (= op OP-RET) S
                   branch (sc-edge S k (- (gn-lpos M target) start))
                   :else (sc-edge S k (inc k)))
          S2 (if (and valid (or (= op OP-BRZ) (= op OP-BRNZ))) (sc-edge S1 k (inc k)) S1)]
      (recur (inc j) (if (= op OP-RT) (inc reads) reads)
                    (if (and branch valid (< (gn-lpos M target) j)) (inc backs) backs)))))))
;; Iterative DFS of every predecessor. Gray/black tags use bounded query epoch;
;; undefined, other definition, any uncut dependency cycle or budget exhaustion
;; fails closed. An accepted LGET definition cuts its incoming dependency edges.
(defn- sc-walk [M :vector-i64 S :vector-i64 t :i64 gray :i64 black :i64] :vector-i64
 (loop [depth 0]
  (let [node (vector-at S (sc-node-at S depth)) cursor (vector-at S (sc-cursor-at S depth))]
   (if (= cursor 0)
    (let [S1 (vector-assoc! S (sc-mark-at S node) black)]
     (if (= depth 0) S1 (recur (dec depth))))
    (let [child (vector-at S (sc-from-at S cursor))
          S1 (vector-assoc! S (sc-cursor-at S depth) (vector-at S (sc-next-at S cursor)))
          mark (vector-at S1 (sc-mark-at S1 child))]
     (cond (= mark gray) (sc-fail S1)
           (= mark black) (recur depth)
           (<= (vector-at S1 0) 0) (sc-fail S1)
           :else (let [S2 (vector-assoc! S1 0 (dec (vector-at S1 0)))
                       j (+ (vector-at S2 3) child) defined (= (gn-defd M j) t)]
             (cond defined (if (and (= (gn-op M j) OP-LGET) (= (gn-sir M j IF-B) (vector-at S2 5)))
                              (let [S3 (vector-assoc! S2 (sc-mark-at S2 child) black)] (recur depth)) (sc-fail S2))
                   (= (sc-head S2 child) 0) (sc-fail S2)
                   (>= (inc depth) (sc-l S2)) (sc-fail S2)
                   :else (let [S3 (-> S2 (vector-assoc! (sc-mark-at S2 child) gray)
                                         (vector-assoc! (sc-node-at S2 (inc depth)) child)
                                         (vector-assoc! (sc-cursor-at S2 (inc depth)) (sc-head S2 child)))]
                           (recur (inc depth)))))))))))
(defn- sc-query [M :vector-i64 S :vector-i64 site :i64 t :i64] :vector-i64
 (let [k (- site (vector-at S 3)) epoch (inc (vector-at S 7)) gray (inc (* 2 epoch)) black (+ 2 (* 2 epoch))]
  (if (or (= (sc-head S k) 0) (> epoch 8192)) (sc-fail S)
   (let [S1 (-> S (vector-assoc! 7 epoch) (vector-assoc! (sc-mark-at S k) gray)
                 (vector-assoc! (sc-node-at S 0) k) (vector-assoc! (sc-cursor-at S 0) (sc-head S k)))]
    (sc-walk M S1 t gray black)))))
(defn- sc-queries [M :vector-i64 S :vector-i64] :vector-i64
 (loop [j (inc (vector-at S 3))]
  (if (or (= (vector-at S 1) 0) (= j (vector-at S 4))) S
   (let [op (gn-op M j) chosen-write (and (= op OP-LSET) (= (gn-sir M j IF-A) (vector-at S 5)))
         S1 (if (or (= op OP-RT) chosen-write) (sc-query M S j (gn-sir M j IF-B)) S)]
    (recur (inc j))))))

(defn- sl-assign [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (let [end (sl-end M (inc i) f 8192)
       slot (if (and (> np 0) (<= np 5)) (sl-pick M f np 0 0) 0)
       nsv (gn-g M gn-f-nsv)
       nnew (+ nsv 3)
       frame (+ (gn-r16 (* 8 (+ (gn-g M gn-f-ns) (gn-g M gn-f-dp) 2))) (gn-r16 (* 8 nnew)) (gn-g M gn-f-out))]
  (if (and (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-out) 0)
           (> slot 0) (> end i) (<= nsv 7) (<= frame 32768)
           (> (gn-g M gn-f-fb) 0))
    (let [proof (sc-queries M (sc-build M i end slot))]
     (if (= (vector-at proof 1) 1)
      (-> M (gn-gs gn-f-nsv nnew) (gn-gs gn-f-fb frame) (gn-gs gn-f-vmode 3) (gn-gs 15 slot)) M)) M)))
(defn- sl-len [M :vector-i64] :i64 (+ 16 (gn-g M gn-f-nsv)))
(defn- sl-base [M :vector-i64] :i64 (+ 17 (gn-g M gn-f-nsv)))
(defn- sl-flag [M :vector-i64] :i64 (+ 18 (gn-g M gn-f-nsv)))
(defn- sl-clear [M :vector-i64] :vector-i64
 (if (= (gn-g M gn-f-vmode) 3) (gn-emit M (enc-movz (sl-flag M) 0 0)) (gn-vclear M)))
;; Runtime flag is a successful original-site validation witness across
;; closed stable-local body/backedges. Positive compile witness is retained
;; only through straight-line source; joins/branches retain the flag guard.
(defn- sl-read [M :vector-i64 rv :i64 ri :i64 d :i64 slot :i64] :vector-i64
 (if (not= slot (gn-g M 15)) (gn-err M E-GEN-OP OP-RT)
  (let [known false len (sl-len M) base (sl-base M) flag (sl-flag M)
        m0 (if known M (gn-emit M (enc-cbnz flag 13)))
        m1 (if known m0
             (-> m0 (gn-hchk rv 312 320) (gn-emit (enc-ldp 17 len 16 0))
                    (gn-emit (enc-ldr base 7 328)) (gn-emit (gn-e-addsl base base 17 3))
                    (gn-emit (enc-movz flag 1 0))))]
   (-> m1 (gn-emit (enc-cmp-r ri len)) (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))
           (gn-emit (gn-e-ldrr d base ri 1)) (gn-gs gn-f-vslot slot)))))

(defn- gn-chain-read [M :vector-i64 rv :i64 ri :i64 d :i64 slot :i64] :vector-i64
 (if (= (gn-g M gn-f-vmode) 3) (sl-read M rv ri d slot)
 (if (not= (gn-g M gn-f-vmode) 2) (gn-vread M rv ri d)
  (-> M (gn-chain-base rv slot)
   (gn-emit (enc-cmp-r ri 3)) (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))
   (gn-emit (gn-e-ldrr d 4 ri 1))))))
(defn- gn-chain-store [M :vector-i64 rv :i64 ri :i64 rx :i64 slot :i64] :vector-i64
 (if (not= (gn-g M gn-f-vmode) 2)
  (-> M (gn-hchk rv 312 320) (gn-vidx ri) (gn-emit (gn-e-strr3 rx 16 17)))
  (-> M (gn-chain-base rv slot)
      (gn-emit (enc-cmp-r ri 3)) (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))
      (gn-emit (gn-e-strr3 rx 4 ri)))))

(defn- gn-chain-fix [M :vector-i64 f :i64 t :i64 n :i64] :vector-i64
 (let [private (and (= (gn-g M gn-f-vmode) 2) (= n 1) (> (gn-g M gn-f-vslot) 0)
                    (gn-isk M t gn-k-local) (= (gn-dv M t) (gn-g M gn-f-vslot)) (gn-chain-target M f))
       M1 (gn-fix M FX-BL26 f) at (dec (vector-at M1 MM-FIX-N))]
  (if private (gn-put M1 (+ MM-FIX-BASE (* at MM-FIX-W) XF-AUX) 1) M1)))

(defn- gn-vmode [M :vector-i64 i :i64] :vector-i64
 (gn-gs M gn-f-vmode (if (gn-chain-mode M i) 2 (if (and (= (gn-g M gn-f-leaf) 0)
                            (gn-vhot-scan M (inc i) 8192)) 1 0))))
(defn- gn-vclear [M :vector-i64] :vector-i64
 (if (> (gn-g M gn-f-vmode) 0) (gn-mov-imm M 5 0) M))
;; Hit requires nonzero key from a prior original handle check. Miss captures
;; descriptor at the original access, before its index check. No trap/charge
;; speculation. RV/RI/D cannot collide with x3..5 under the register proof.
(defn- gn-vread [M :vector-i64 rv :i64 ri :i64 d :i64] :vector-i64
 (if (= (gn-g M gn-f-vmode) 0)
  (-> M (gn-hchk rv 312 320) (gn-vidx ri) (gn-emit (gn-e-ldrr d 16 17 1)))
  (-> M
   (gn-emit (enc-cbz 5 3)) (gn-emit (enc-cmp-r rv 5)) (gn-emit (enc-bcond (enc-cond-eq) 13))
   (gn-mov 5 rv) (gn-hchk 5 312 320)
   (gn-emit (enc-ldp 17 3 16 0)) (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))
   (gn-emit (enc-cmp-r ri 3)) (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))
   (gn-emit (gn-e-ldrr d 4 ri 1)))))


;; Compile-time witness only. No added runtime state/branch. First read keeps
;; the dynamic validated-key path; later same-local straight-line read omits it.
;; Labels/branches/calls/unknown effects reset; coalesced local writes reset too.
(defn- gn-vdrop [M :vector-i64 s :i64] :vector-i64
 (if (and (> s 0) (or (= s (gn-g M gn-f-vslot)) (and (= s 1) (= (gn-g M gn-f-vslot) -1)))) (gn-gs M gn-f-vslot 0) M))
(defn- gn-vstep [M :vector-i64 op :i64 a :i64] :vector-i64
 (cond (or (= op OP-CONST) (= op OP-LGET)) M
       (and (= op OP-BIN) (< a BOP-F64-ADD)) M
       (= op OP-LSET) (gn-vdrop M a)
       :else (gn-gs M gn-f-vslot 0)))
(defn- gn-vpair [M :vector-i64 slot :i64 d :i64] :vector-i64
 (let [active (= (gn-g M gn-f-vmode) 1)
       hit (and active (> slot 0) (= slot (gn-g M gn-f-vslot)))
       M1 (if hit
             (-> M (gn-emit (enc-cmp-r 1 3))
                   (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))
                   (gn-emit (gn-e-ldrr d 4 1 1)))
             (gn-vread M 0 1 d))]
  (gn-gs M1 gn-f-vslot (if active slot 0))))

;; ---- register assignment ----------------------------------------------------------------------------------------
(defn- gn-lowregs [M :vector-i64 k :i64 n :i64] :vector-i64
  (if (> k n) M (gn-lowregs (gn-gs M (+ gn-a-sreg k) k) (inc k) n)))
;; the unassigned slot in k..ns with the highest use (first on ties), 0 = none
(defn- gn-best [M :vector-i64 k :i64 ns :i64 bk :i64 bu :i64] :i64
  (if (> k ns)
    bk
    (let [u (gn-g M (+ gn-a-use k))]
      (if (and (> u bu) (= (gn-g M (+ gn-a-sreg k)) 0))
        (gn-best M (inc k) ns k u)
        (gn-best M (inc k) ns bk bu)))))
(defn- gn-rank [M :vector-i64 lo :i64 ns :i64 cnt :i64] :vector-i64
  (let [b (if (>= cnt 10) 0 (gn-best M lo ns 0 0))]
    (if (= b 0)
      (gn-gs M gn-f-nsv cnt)
      (gn-rank (gn-gs M (+ gn-a-sreg b) (+ 20 cnt)) lo ns (inc cnt)))))
;; a slot that is used but has no register
(defn- gn-memslot [M :vector-i64 k :i64 ns :i64] :bool
  (cond (> k ns) false
        (and (> (gn-g M (+ gn-a-use k)) 0) (= (gn-g M (+ gn-a-sreg k)) 0)) true
        :else (gn-memslot M (inc k) ns)))
(defn- gn-assign [M :vector-i64] :vector-i64
  (let [ns (gn-g M gn-f-ns)
        leaf (gn-g M gn-f-leaf)
        M1 (if (> leaf 0) (gn-lowregs M 1 (gn-min ns 7)) M)
        M2 (gn-rank M1 (if (> leaf 0) 8 1) ns 0)
        nsv (gn-g M2 gn-f-nsv)
        dp (gn-g M2 gn-f-dp)
        framed (or (= leaf 0) (> nsv 0) (> dp 7) (gn-memslot M2 1 ns))]
    (gn-gs M2 gn-f-fb (if framed (+ (gn-r16 (* 8 (+ ns dp 2))) (gn-r16 (* 8 nsv)) (gn-g M2 gn-f-out)) 0))))

;; ---- prologue and epilogue -----------------------------------------------------------------------------------------
(defn- gn-subsp [M :vector-i64 amt :i64] :vector-i64
  (if (> amt 0) (gn-emit M (enc-sub-i 31 31 amt)) M))
;; save (ld = 0) / restore (ld = 1) the callee-saved x19 .. x(19+n-1) at [sp, #O ..] (R4B: O = the outgoing area)
(defn- gn-csave [M :vector-i64 i :i64 n :i64 ld :i64] :vector-i64
  (let [o (+ (gn-g M gn-f-out) (* 8 i))]
    (cond (>= i n) M
          (< (inc i) n) (gn-csave (gn-emit M (if (= ld 1) (enc-ldp (+ 19 i) (+ 20 i) 31 o) (enc-stp (+ 19 i) (+ 20 i) 31 o)))
                                  (+ i 2) n ld)
          :else (gn-emit M (if (= ld 1) (enc-ldr (+ 19 i) 31 o) (enc-str (+ 19 i) 31 o))))))
;; params x0.. -> their slots (register or frame). R4B: parameter k-1 >= 7 arrives at [x29, #16+8*(k-8)] (the caller's
;; outgoing area; a function that uses such a parameter always has a frame); an unused one is not loaded
(defn- gn-params [M :vector-i64 k :i64 np :i64] :vector-i64
  (let [r (gn-sreg M k)
        off (+ 16 (* 8 (- k 8)))]
    (cond (> k np) M
          (<= k 7) (gn-params (if (>= r 0) (gn-mov M r (dec k)) (gn-st M (dec k) k)) (inc k) np)
          (>= r 0) (gn-params (gn-emit M (enc-ldr r 29 off)) (inc k) np)
          (zero? (gn-g M (+ gn-a-use k))) (gn-params M (inc k) np)
          :else (gn-params (-> M (gn-emit (enc-ldr 16 29 off)) (gn-st 16 k)) (inc k) np))))
(defn- gn-op-fn [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
  (let [ns0 (gn-max (gn-max (gn-sir M i IF-C) (gn-fnf M f FF-NSLOTS)) (gn-max np (gn-scan M (inc i) 2 0)))
        dp0 (gn-max (gn-fnf M f FF-DEPTH) (gn-scan M (inc i) 1 0))]
    (if (or (>= ns0 gn-cap) (>= dp0 gn-cap))
      (gn-err M E-GEN-FRAME (+ ns0 dp0))
      (gn-op-fn2 (-> M
                     (gn-zero gn-f-leaf gn-a-sreg)
                     (gn-zero gn-a-sreg (+ gn-a-sreg ns0 1))
                     (gn-zero gn-a-use (+ gn-a-use ns0 1))
                     (gn-zero gn-a-dk (+ gn-a-dk dp0 1))
                     (gn-gs gn-f-leaf 1)
                     (gn-gs gn-f-ns ns0)
                     (gn-gs gn-f-dp dp0)
                     (gn-pre (inc i)))
                 i f np))))
;; Terminal-only mode2: low local registers with original published fuel.
;; Mode1 remains private-fuel leaf; mode0 remains ordinary nonleaf.
(defn- gn-small-type [ty :i64] :bool
 (or (= ty TY-I64) (= ty TY-BOOL) (= ty TY-STR) (= ty TY-VEC)
     (= ty TY-BYTES) (= ty TY-KW) (= ty TY-DOC) (= ty TY-SYM)))
(defn- gn-small-end [M :vector-i64 j :i64 f :i64 work :i64] :i64
 (cond (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) 0
       (= (gn-op M j) OP-END) (if (and (= (gn-sir M j IF-A) f)
        (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) 0)) j 0)
       (= (gn-op M j) OP-FN) 0
       :else (gn-small-end M (inc j) f (dec work))))
(defn- gn-small-label [M :vector-i64 j :i64 l :i64 found :i64] :i64
 (cond (or (<= l 0) (>= l MM-LABEL-CAP)) 0
       (>= j (vector-at M MM-SIR-N)) found
       (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) l))
       (if (> found 0) 0 (gn-small-label M (inc j) l j))
       :else (gn-small-label M (inc j) l found)))
(defn- gn-small-owned [M :vector-i64 start :i64 end :i64 l :i64] :bool
 (let [p (gn-small-label M 1 l 0)] (and (> p start) (< p end))))
(defn- gn-small-callee [M :vector-i64 f :i64 n :i64] :bool
 (let [p (gn-fnf M f FF-SIR)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (> p 0) (< p (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) n)
       (= (gn-fnf M f FF-NPARAMS) n) (gn-small-type (gn-fnf M f FF-RTYPE)))))
(defn- gn-small-params [M :vector-i64 f :i64 k :i64 n :i64] :bool
 (or (= k n) (and (gn-small-type (gn-fnf M f (+ FF-PT0 k)))
                  (gn-small-params M f (inc k) n))))
(defn- gn-small-call [M :vector-i64 j :i64 ty :i64] :bool
 (let [f (gn-sir M j IF-A) t (gn-sir M j IF-B) n (gn-sir M j IF-C)
       w (gn-call-wrapper M j f t n)]
  (and (>= n 0) (<= n 3) (gn-small-callee M f n) (gn-small-params M f 0 n)
   (or (> w 0)
       (and (<= n 1) (= (gn-fnf M f FF-RTYPE) ty)
            (= (gn-op M (inc j)) OP-RET) (= (gn-sir M (inc j) IF-A) t)
            (= (gn-sir M (inc j) IF-B) 0) (= (gn-sir M (inc j) IF-C) 0))))))
(defn- gn-small-scan [M :vector-i64 j :i64 start :i64 end :i64 ty :i64] :bool
 (if (= j end) true
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
   (and (case op
      (OP-CONST OP-LGET OP-LSET OP-BIN OP-CMP OP-UN OP-RET) true
      OP-FUEL (and (= a 0) (= b 0) (= c 0))
      OP-LABEL (and (= b 0) (= c 0) (= (gn-small-label M 1 a 0) j))
      OP-BR (and (= b 0) (= c 0) (gn-small-owned M start end a))
      (OP-BRZ OP-BRNZ) (and (= c 0) (gn-small-owned M start end b))
      OP-RT (gn-inl a b c)
      OP-CALL (gn-small-call M j ty)
      false)
    (gn-small-scan M (inc j) start end ty)))))
(defn- gn-small-tail [M :vector-i64 i :i64 f :i64 np :i64] :bool
 (let [end (gn-small-end M (inc i) f 4096) ty (gn-fnf M f FF-RTYPE)]
  (and (= (gn-g M gn-f-leaf) 0) (>= np 0) (<= np 1)
       (>= (gn-g M gn-f-ns) np) (<= (gn-g M gn-f-ns) 7)
       (<= (gn-g M gn-f-dp) 7) (= (gn-g M gn-f-out) 0)
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) i) (= (gn-fnf M f FF-NPARAMS) np)
       (= (gn-fnf M f FF-NSLOTS) (gn-g M gn-f-ns))
       (= (gn-fnf M f FF-DEPTH) (gn-g M gn-f-dp))
       (gn-small-type ty) (gn-small-params M f 0 np)
       (> end i) (gn-small-scan M (inc i) i end ty))))
(defn- gn-op-fn2 [M1 :vector-i64 i :i64 f :i64 np :i64] :vector-i64
  (let [ns (gn-g M1 gn-f-ns)
        dp (gn-g M1 gn-f-dp)]
    (cond (> np 16) (gn-err M1 E-GEN-OP OP-FN)
          :else
          (let [MM (if (gn-small-tail M1 i f np) (gn-gs M1 gn-f-leaf 2) M1)
                M2 (sl-assign (gn-vmode (gn-assign MM) i) i f np)
                F (gn-g M2 gn-f-fb)
                leaf (gn-g M2 gn-f-leaf)]
            (if (> F 32768)
              (gn-err M2 E-GEN-FRAME (+ ns dp))
              (-> M2
                  (gn-put (+ MM-FN-BASE (* f MM-FN-W) FF-CODE) (vector-at M2 MM-CODE-N))
                  (cond-> (> F 0) (-> (gn-emit (enc-stp-pre 29 30 31 -16))
                                      (gn-emit (enc-mov-sp 29 31))
                                      (gn-subsp (bit-and F -4096))
                                      (gn-subsp (bit-and F 4095))
                                      (gn-csave 0 (gn-g M2 gn-f-nsv) 0)))
                  (cond-> (= leaf 0) (gn-st 7 0))
                  (gn-params 1 np)
                  (cond-> (and (= leaf 1) (= (gn-g M2 gn-f-fuel) 1)) (-> (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-gs gn-f-freg 1)))
                  (gn-gs gn-f-ctx 1)
                  (gn-gs gn-f-h 0) (sl-clear) (gn-gs gn-f-vslot (if (= (gn-g M2 gn-f-vmode) 2) -1 0)) (gn-tree-entry f)))))))

(defn- gn-op-ret [M :vector-i64 t :i64] :vector-i64 (gn-epilogue (gn-into M 0 t)))
;; R5B: RET2 t -- x0 := temp t, x1 := temp t+1 (through x16: either source may be x0 or x1 in a leaf), then the epilogue
(defn- gn-op-ret2 [M :vector-i64 t :i64] :vector-i64 (-> M (gn-into 16 (inc t)) (gn-into 0 t) (gn-mov 1 16) (gn-epilogue)))
;; R5B: RES2 t (right after a CALL): temp t := x1, the CALL's second result register
(defn- gn-op-res2 [M :vector-i64 i :i64 t :i64] :vector-i64 (gn-take M i t 1))
;; the fuel store of a leaf, the frame and callee-saved restore, ret
(defn- gn-epilogue [M :vector-i64] :vector-i64
  (let [F (gn-g M gn-f-fb)]
    (-> M
        (cond-> (= (gn-g M gn-f-freg) 1) (gn-emit (enc-str 8 7 CTX-FUEL)))
        (cond-> (> F 0) (-> (gn-csave 0 (gn-g M gn-f-nsv) 1)
                            (gn-emit (enc-mov-sp 31 29))
                            (gn-emit (enc-ldp-post 29 30 31 16))))
        (gn-emit (enc-ret))
        (gn-gs gn-f-dead 1))))

;; A whole pure scalar threshold tree; return the exclusive SIR end or0.
;; Exact operands and actual branch target positions are checked recursively.
(defn- gn-tree-end [M :vector-i64 p :i64 depth :i64] :i64
  (if (or (> depth 7) (>= p (vector-at M MM-SIR-N))) 0
    (if (and (= (gn-op M p) OP-CONST) (= (gn-sir M p IF-A) 0) (= (gn-sir M p IF-C) 0)) (inc p)
      (if (and (= (gn-op M p) OP-LGET) (= (gn-sir M p IF-A) 0) (= (gn-sir M p IF-B) 1) (= (gn-sir M p IF-C) 0)
               (= (gn-op M (+ p 1)) OP-CONST) (= (gn-sir M (+ p 1) IF-A) 1) (= (gn-sir M (+ p 1) IF-C) 0)
               (> (gn-sir M (+ p 1) IF-B) 0) (< (gn-sir M (+ p 1) IF-B) 64)
               (= (gn-op M (+ p 2)) OP-CMP) (= (gn-sir M (+ p 2) IF-A) CC-LT) (= (gn-sir M (+ p 2) IF-B) 0) (= (gn-sir M (+ p 2) IF-C) 0)
               (= (gn-op M (+ p 3)) OP-BRZ) (= (gn-sir M (+ p 3) IF-A) 0) (= (gn-sir M (+ p 3) IF-C) 0))
        (let [a (gn-tree-end M (+ p 4) (inc depth)) le (gn-sir M (+ p 3) IF-B)]
          (if (and (> a 0) (= (gn-op M a) OP-BR) (= (gn-sir M a IF-B) 0) (= (gn-sir M a IF-C) 0)
                   (= (gn-op M (inc a)) OP-LABEL) (= (gn-sir M (inc a) IF-A) le)
                   (= (gn-sir M (inc a) IF-B) 0) (= (gn-sir M (inc a) IF-C) 0) (= (gn-lpos M le) (inc a)))
            (let [b (gn-tree-end M (+ a 2) (inc depth)) lx (gn-sir M a IF-A)]
              (if (and (> b 0) (= (gn-op M b) OP-LABEL) (= (gn-sir M b IF-A) lx)
                       (= (gn-sir M b IF-B) 0) (= (gn-sir M b IF-C) 0) (= (gn-lpos M lx) b)) (inc b) 0)) 0)) 0))))
(defn- gn-tree-value [M :vector-i64 p :i64 x :i64] :i64
  (if (= (gn-op M p) OP-CONST) (gn-sir M p IF-B)
    (gn-tree-value M (if (< x (gn-sir M (inc p) IF-B)) (+ p 4) (inc (gn-lpos M (gn-sir M (+ p 3) IF-B)))) x)))
(defn- gn-tree-data [M :vector-i64 p :i64 x :i64] :vector-i64
  (if (= x 64) M (let [v (gn-tree-value M p x)]
    (gn-tree-data (-> M (gn-emit (bit-and v 0xffffffff)) (gn-emit (bit-and (i64-shift-right v 32) 0xffffffff))) p (inc x)))))
(defn- gn-tree-emit [M :vector-i64 p :i64 charge :i64] :vector-i64
  (let [M0 (cond-> M (= charge 1) (gn-op-fuel))
        M1 (-> M0 (cond-> (>= (gn-sreg M0 1) 0) (gn-mov 9 (gn-sreg M0 1))) (cond-> (< (gn-sreg M0 1) 0) (gn-ld 9 1)) (gn-emit (enc-cmp-i 9 0))) low (vector-at M1 MM-CODE-N)
        M2 (-> M1 (gn-emit (enc-bcond (enc-cond-lt) 0)) (gn-emit (enc-cmp-i 9 63))) high (vector-at M2 MM-CODE-N)
        M3 (gn-emit M2 (enc-bcond (enc-cond-gt) 0)) adr (vector-at M3 MM-CODE-N)
        M4 (-> M3 (gn-emit (gn-e-adr 10)) (gn-emit (gn-e-ldrr 0 10 9 1)) (gn-epilogue))
        l (vector-at M4 MM-CODE-N) M5 (-> M4 (gn-mov-imm 0 (gn-tree-value M p 0)) (gn-epilogue))
        h (vector-at M5 MM-CODE-N) M6 (-> M5 (gn-mov-imm 0 (gn-tree-value M p 63)) (gn-epilogue))
        table (vector-at M6 MM-CODE-N) delta (* (- table adr) 4)
        M7 (gn-tree-data M6 p 0)]
    (-> M7 (gn-put (+ MM-CODE-BASE low) (enc-bcond (enc-cond-lt) (- l low)))
           (gn-put (+ MM-CODE-BASE high) (enc-bcond (enc-cond-gt) (- h high)))
           (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 10) (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5)))
           (gn-gs 14 1))))
(defn- gn-tree-entry [M :vector-i64 f :i64] :vector-i64
  (let [a (gn-fnf M f FF-SIR) charge (if (= (gn-op M (inc a)) OP-FUEL) 1 0)
        label (+ a 1 charge) p (inc label)]
    (if (and (= (gn-sir M a IF-B) 1) (= (gn-g M gn-f-leaf) 1)
             (= (gn-op M label) OP-LABEL) (= (gn-sir M label IF-B) 0) (= (gn-sir M label IF-C) 0)
             (or (= charge 0) (and (= (gn-sir M (inc a) IF-A) 0) (= (gn-sir M (inc a) IF-B) 0) (= (gn-sir M (inc a) IF-C) 0))))
      (let [end (gn-tree-end M p 0)]
        (if (and (> (- end p) 128) (= (gn-op M end) OP-RET) (= (gn-sir M end IF-A) 0) (= (gn-sir M end IF-B) 0) (= (gn-sir M end IF-C) 0)
                 (= (gn-op M (inc end)) OP-END) (= (gn-sir M (inc end) IF-A) f) (= (gn-sir M (inc end) IF-B) 0) (= (gn-sir M (inc end) IF-C) 0))
          (gn-tree-emit M p charge) M)) M)))

;; ---- FLOAT (agent FLOAT, rung r6j, 2026-10-04): f64/f32 operations (seed/SIR BOP-F*, CC-F*, UOP-F*) -----------------
;; A float temp is its bit pattern in a general register (f32: 32 bits sign-extended). Each operation moves its operands
;; into d0/d1 (s0/s1) with fmov, applies one instruction and moves the result back (f32: fmov w + sxtw). d0, d1 are scratch
;; (nothing else in the seed's code uses the FP registers, and no value lives in one across an instruction group).
(defn- gn-fl-bop? [bop :i64] :bool (>= bop BOP-F64-ADD))
;; 1 = double, 0 = single
(defn- gn-fl-bsz [bop :i64] :i64 (if (< bop BOP-F32-ADD) 1 0))
(defn- gn-fl-csz [cc :i64] :i64 (if (< cc CC-F32-EQ) 1 0))
;; d := (bop) x y, x and y general registers
(defn- gn-fl-bin [M :vector-i64 bop :i64 d :i64 x :i64 y :i64] :vector-i64
  (let [sz (gn-fl-bsz bop)]
    (-> M
        (gn-emit (enc-fmov-to-fp sz 0 x))
        (gn-emit (enc-fmov-to-fp sz 1 y))
        (gn-emit (enc-fop2 (bit-and bop 7) sz 0 0 1))
        (gn-emit (enc-fmov-from-fp sz d 0))
        (cond-> (= sz 0) (gn-emit (enc-sxtw d d))))))
;; flags := fcmp temp t, temp t+1
(defn- gn-fl-cmp-emit [M :vector-i64 cc :i64 t :i64] :vector-i64
  (let [sz (gn-fl-csz cc)
        x (gn-src M t 16 1)
        y (gn-src M (inc t) 17 1)]
    (-> M
        (gn-ldt t 16 1)
        (gn-ldt (inc t) 17 1)
        (gn-emit (enc-fmov-to-fp sz 0 x))
        (gn-emit (enc-fmov-to-fp sz 1 y))
        (gn-emit (enc-fcmp sz 0 1)))))
;; the result of an f32 operation in s0 -> d (fmov w, sxtw); of an f64 one in d0 -> d
(defn- gn-fl-out [M :vector-i64 sz :i64 d :i64] :vector-i64
  (-> M (gn-emit (enc-fmov-from-fp sz d 0)) (cond-> (= sz 0) (gn-emit (enc-sxtw d d)))))
(defn- gn-fl-un-ok? [uop :i64] :bool
  (or (and (>= uop UOP-F64-NEG) (<= uop UOP-F64-SQRT)) (and (>= uop UOP-F32-NEG) (<= uop UOP-F32-SQRT))
      (and (>= uop UOP-F64-TO-I64) (<= uop UOP-F32-TO-I64))))
;; d := (uop) x
(defn- gn-fl-un [M :vector-i64 uop :i64 d :i64 x :i64] :vector-i64
  (cond (<= uop UOP-F64-SQRT) (-> M (gn-emit (enc-fmov-to-fp 1 0 x)) (gn-emit (enc-fop1 (- uop UOP-F64-NEG) 1 0 0)) (gn-fl-out 1 d))
        (<= uop UOP-F32-SQRT) (-> M (gn-emit (enc-fmov-to-fp 0 0 x)) (gn-emit (enc-fop1 (- uop UOP-F32-NEG) 0 0 0)) (gn-fl-out 0 d))
        (= uop UOP-F64-TO-I64) (-> M (gn-emit (enc-fmov-to-fp 1 0 x)) (gn-emit (enc-fcvtzs 1 d 0)))
        (= uop UOP-I64-TO-F64) (-> M (gn-emit (enc-scvtf 1 0 x)) (gn-fl-out 1 d))
        (= uop UOP-F64-TO-F32) (-> M (gn-emit (enc-fmov-to-fp 1 0 x)) (gn-emit (enc-fcvt 1 0 0)) (gn-fl-out 0 d))
        (= uop UOP-F32-TO-F64) (-> M (gn-emit (enc-fmov-to-fp 0 0 x)) (gn-emit (enc-fcvt 0 0 0)) (gn-fl-out 1 d))
        (= uop UOP-I64-TO-F32) (-> M (gn-emit (enc-scvtf 0 0 x)) (gn-fl-out 0 d))
        :else (-> M (gn-emit (enc-fmov-to-fp 0 0 x)) (gn-emit (enc-fcvtzs 0 d 0)))))
(defn- gn-fl-op-un [M :vector-i64 i :i64 uop :i64 t :i64] :vector-i64
  (if (gn-fl-un-ok? uop)
    (let [s (gn-co M i t)
          d (gn-dreg M t s)
          x (gn-src M t 16 1)]
      (-> M (gn-protect t s) (gn-ldt t 16 1) (gn-fl-un uop d x) (gn-fin t s d)))
    (gn-err M E-GEN-OP OP-UN)))
;; ---- END FLOAT ------------------------------------------------------------------------------------------------------

;; ---- data processing ------------------------------------------------------------------------------------------------
(defn- gn-foldable [bop :i64 x :i64 y :i64] :bool
  (cond (gn-fl-bop? bop) false   ; FLOAT: never folded
        (= bop BOP-QUOT) (and (not= y 0) (not (and (= y -1) (= x -9223372036854775808))))
        :else true))
(defn- gn-fold [bop :i64 x :i64 y :i64] :i64
  (case bop
    BOP-ADD (+ x y)
    BOP-SUB (- x y)
    BOP-MUL (* x y)
    BOP-QUOT (quot x y)
    BOP-AND (bit-and x y)
    BOP-OR (bit-or x y)
    BOP-XOR (bit-xor x y)
    BOP-SHL (i64-shift-left x (bit-and y 63))
    BOP-USHR (u64-shift-right x (bit-and y 63))
    BOP-SSHR (i64-shift-right x (bit-and y 63))
    0))

;; quot: x = dividend register, y = divisor register, d = destination
(defn- gn-quot [M :vector-i64 d :i64 x :i64 y :i64] :vector-i64
  (-> M
      (gn-emit (enc-cbnz y 2))
      (gn-emit (enc-brk 0))
      (gn-emit (enc-cmn-i y 1))
      (gn-emit (enc-bcond (enc-cond-ne) 4))
      (gn-emit (enc-cmp-i x 1))
      (gn-emit (enc-bcond (enc-cond-vc) 2))
      (gn-emit (enc-brk 0))
      (gn-emit (enc-sdiv d x y))))

(defn- gn-bin-word [bop :i64 d :i64 x :i64 y :i64] :i64
  (case bop
    BOP-ADD (enc-add-r d x y)
    BOP-SUB (enc-sub-r d x y)
    BOP-MUL (enc-mul d x y)
    BOP-AND (enc-and-r d x y)
    BOP-OR (enc-orr-r d x y)
    BOP-XOR (enc-eor-r d x y)
    BOP-SHL (enc-lslv d x y)
    BOP-USHR (enc-lsrv d x y)
    BOP-SSHR (enc-asrv d x y)
    -1))
;; logical immediate base (N = 1) of and/orr/eor
(defn- gn-logic-base [bop :i64] :i64 (cond (= bop BOP-AND) 0x92400000 (= bop BOP-OR) 0xb2400000 (= bop BOP-XOR) 0xd2400000 :else -1))   ; R6B: hex
;; the immediate form for (bop x k), k a constant second operand: 0 = none
(defn- gn-imm-kind [bop :i64 k :i64] :i64
  (cond (and (or (= bop BOP-ADD) (= bop BOP-SUB)) (> k -4096) (< k 4096)) 1
        (or (= bop BOP-SHL) (= bop BOP-USHR) (= bop BOP-SSHR)) 2
        (and (>= (gn-logic-base bop) 0) (> (gn-run-len k) 0)) 3
        (and (= bop BOP-MUL) (> (gn-pow2 k) 0)) 4
        (and (= bop BOP-QUOT) (not= k 0) (not= k -1)) 5
        :else 0))
;; d := x (bop) k in the immediate form ik; x = the operand register (never xzr)
(defn- gn-bin-imm [M :vector-i64 bop :i64 d :i64 x :i64 k :i64] :vector-i64
  (case (gn-imm-kind bop k)
    1 (let [add (if (= bop BOP-ADD) (>= k 0) (< k 0))
            m (if (< k 0) (- 0 k) k)]
        (if (= m 0) (gn-mov M d x) (gn-emit M (if add (enc-add-i d x m) (enc-sub-i d x m)))))
    2 (let [s (bit-and k 63)]
        (cond (= s 0) (gn-mov M d x)
              (= bop BOP-SHL) (gn-emit M (gn-e-lsl d x s))
              (= bop BOP-USHR) (gn-emit M (gn-e-lsr d x s))
              :else (gn-emit M (gn-e-asr d x s))))
    3 (let [tz (gn-tz k 0)
            n (gn-run-len k)]
        (gn-emit M (gn-e-bf (gn-logic-base bop) d x (bit-and (- 64 tz) 63) (dec n))))
    4 (gn-emit M (gn-e-lsl d x (gn-pow2 k)))
    ;; Identity division is total even at MIN: preserve the operand instead
    ;; of serializing it through SDIV. Zero and -1 still use guarded gn-quot.
    (if (and (= bop BOP-QUOT) (= k 1))
      (gn-mov M d x)
      (-> M (gn-mov-imm 17 k) (gn-emit (enc-sdiv d x 17))))))
(defn- gn-bin-emit [M :vector-i64 bop :i64 t :i64 d :i64] :vector-i64
  (let [ky (gn-dk M (inc t))
        vy (gn-dv M (inc t))
        kx (gn-dk M t)
        vx (gn-dv M t)
        iy (if (= ky gn-k-const) (gn-imm-kind bop vy) 0)
        ix (if (and (= kx gn-k-const) (not= ky gn-k-const) (or (= bop BOP-ADD) (= bop BOP-MUL) (= bop BOP-AND) (= bop BOP-OR) (= bop BOP-XOR)))
             (gn-imm-kind bop vx) 0)]
    (cond (gn-fl-bop? bop) (let [x (gn-src M t 16 1)   ; FLOAT
                                 y (gn-src M (inc t) 17 1)]
                             (-> M (gn-ldt t 16 1) (gn-ldt (inc t) 17 1) (gn-fl-bin bop d x y)))
          (> iy 0) (-> M (gn-ldt t 16 0) (gn-bin-imm bop d (gn-src M t 16 0) vy))
          (> ix 0) (-> M (gn-ldt (inc t) 17 0) (gn-bin-imm bop d (gn-src M (inc t) 17 0) vx))
          (= bop BOP-QUOT) (let [x (gn-src M t 16 0)
                                 y (gn-src M (inc t) 17 0)]
                             (-> M (gn-ldt t 16 0) (gn-ldt (inc t) 17 0) (gn-quot d x y)))
          :else (let [x (gn-src M t 16 1)
                      y (gn-src M (inc t) 17 1)]
                  (-> M (gn-ldt t 16 1) (gn-ldt (inc t) 17 1) (gn-emit (gn-bin-word bop d x y)))))))
(defn- gn-op-bin [M :vector-i64 i :i64 bop :i64 t :i64] :vector-i64
  (let [vx (gn-dv M t)
        vy (gn-dv M (inc t))]
    (if (and (gn-isk M t gn-k-const) (gn-isk M (inc t) gn-k-const) (gn-foldable bop vx vy))
      (gn-def M t gn-k-const (gn-fold bop vx vy))
      (let [s (gn-co M i t)
            d (gn-dreg M t s)]
        (-> M (gn-protect t s) (gn-bin-emit bop t d) (gn-fin t s d))))))

(defn- gn-op-un [M :vector-i64 i :i64 uop :i64 t :i64] :vector-i64
  (let [v (gn-dv M t)]
    (cond (>= uop UOP-F64-NEG) (gn-fl-op-un M i uop t)   ; FLOAT
          (not (or (= uop UOP-NOT) (= uop UOP-BITNOT))) (gn-err M E-GEN-OP OP-UN)
          (gn-isk M t gn-k-const) (gn-def M t gn-k-const (if (= uop UOP-NOT) (bit-xor v 1) (bit-not v)))
          :else (let [s (gn-co M i t)
                      d (gn-dreg M t s)
                      x (gn-src M t 16 1)]
                  (-> M
                      (gn-protect t s)
                      (gn-ldt t 16 1)
                      (gn-emit (if (= uop UOP-NOT) (enc-eor-1 d x) (enc-mvn d x)))
                      (gn-fin t s d))))))

;; ---- compares and branches ------------------------------------------------------------------------------------------
(defn- gn-cmp-fold [cc :i64 x :i64 y :i64] :i64
  (case cc
    CC-EQ (if (= x y) 1 0)
    CC-LT (if (< x y) 1 0)
    CC-GT (if (> x y) 1 0)
    CC-LE (if (<= x y) 1 0)
    CC-GE (if (>= x y) 1 0)
    0))
;; flags := temp t - temp t+1 (cmp / cmp #imm / cmn #imm)
(defn- gn-cmp-emit [M :vector-i64 cc :i64 t :i64] :vector-i64
  (if (>= cc CC-F64-EQ) (gn-fl-cmp-emit M cc t) (gn-cmp-emit-i M t)))   ; FLOAT
(defn- gn-cmp-emit-i [M :vector-i64 t :i64] :vector-i64
  (let [vy (gn-dv M (inc t))
        imm (and (gn-isk M (inc t) gn-k-const) (> vy -4096) (< vy 4096))]
    (if imm
      (let [x (gn-src M t 16 0)]
        (-> M (gn-ldt t 16 0) (gn-emit (if (>= vy 0) (enc-cmp-i x vy) (enc-cmn-i x (- 0 vy))))))
      (let [x (gn-src M t 16 1)
            y (gn-src M (inc t) 17 1)]
        (-> M (gn-ldt t 16 1) (gn-ldt (inc t) 17 1) (gn-emit (enc-cmp-r x y)))))))
(defn- gn-jump [M :vector-i64 l :i64] :vector-i64
  (-> M (gn-jflush (gn-g M gn-f-h) l) (gn-fix FX-B26 l) (gn-emit (enc-b 0)) (gn-gs gn-f-dead 1)))
;; cmp at i, an optional (not t) at i+1, then brz/brnz t at j: fused into cmp + b.cond when t is dead after both
(defn- gn-cmp-br [M :vector-i64 i :i64 cc :i64 t :i64 inv :i64] :vector-i64
  (let [j (+ i 1 inv)
        nz (if (= (gn-op M j) OP-BRNZ) 1 0)
        l (gn-thread M (gn-sir M j IF-B) t nz 8)
        c (enc-cond-of-cc cc)
        bc (if (= (bit-xor nz inv) 1) c (bit-xor c 1))]
    (-> M
        (gn-flush 0 t)
        (gn-cmp-emit cc t)
        (gn-fix FX-BC19 l)
        (gn-emit (enc-bcond bc 0))
        (gn-gs gn-f-h t)
        (gn-gs gn-f-skip (inc inv)))))
(defn- gn-fusable [M :vector-i64 i :i64 t :i64] :i64
  (let [inv (if (and (= (gn-op M (inc i)) OP-UN) (= (gn-sir M (inc i) IF-A) UOP-NOT) (= (gn-sir M (inc i) IF-B) t)) 1 0)
        j (+ i 1 inv)
        op (gn-op M j)
        nz (if (= op OP-BRNZ) 1 0)]
    (if (and (or (= op OP-BRZ) (= op OP-BRNZ))
             (= (gn-sir M j IF-A) t)
             (gn-kills M (inc j) t 16)
             (gn-dead-at M (gn-thread M (gn-sir M j IF-B) t nz 8) t))
      inv
      -1)))
(defn- gn-op-cmp [M :vector-i64 i :i64 cc :i64 t :i64] :vector-i64
  (let [vx (gn-dv M t)
        vy (gn-dv M (inc t))
        inv (gn-fusable M i t)]
    (cond (and (gn-isk M t gn-k-const) (gn-isk M (inc t) gn-k-const) (< cc CC-F64-EQ)) (gn-def M t gn-k-const (gn-cmp-fold cc vx vy))   ; FLOAT: no fold
          (>= inv 0) (gn-cmp-br M i cc t inv)
          :else (let [s (gn-co M i t)
                      d (gn-dreg M t s)]
                  (-> M (gn-protect t s) (gn-cmp-emit cc t) (gn-emit (enc-cset d (enc-cond-of-cc cc))) (gn-fin t s d))))))

;; BRZ / BRNZ: nz = 0 -> branch when temp t = 0, 1 -> when != 0
(defn- gn-op-brz [M :vector-i64 i :i64 t :i64 l0 :i64 nz :i64] :vector-i64
  (let [l (gn-thread M l0 t nz 8)
        v (gn-dv M t)]
    (if (gn-isk M t gn-k-const)
      (if (= (if (= v 0) 0 1) nz) (gn-jump M l) M)
      (let [M1 (if (and (gn-kills M (inc i) t 16) (gn-dead-at M l t)) (gn-flush M 0 t) (gn-flush M 0 (inc t)))
            r (gn-src M1 t 16 0)]
        (-> M1 (gn-ldt t 16 0) (gn-fix FX-CB19 l) (gn-emit (if (= nz 1) (enc-cbnz r 0) (enc-cbz r 0))))))))

(defn- gn-op-label [M :vector-i64 l :i64] :vector-i64
  (let [h (gn-g M gn-f-h)
        M1 (if (= (gn-g M gn-f-dead) 1) M (gn-jflush M h l))]
    (if (or (< l 1) (>= l MM-LABEL-CAP))
      (gn-err M1 E-GEN-OP OP-LABEL)
      (-> M1
          (gn-allreg 0 (gn-max h (gn-g M1 gn-f-dp)))
          (gn-put (+ MM-LABEL-BASE l) (vector-at M1 MM-CODE-N))
          (gn-gs gn-f-dead 0)
          (gn-gs gn-f-ctx (if (= (gn-g M1 gn-f-leaf) 0) 0 1))))))

(defn- gn-op-lset [M :vector-i64 s :i64 t :i64] :vector-i64
  (let [M1 (gn-prot M 0 (gn-g M gn-f-h) t s)
        r (gn-sreg M1 s)]
    (cond (and (gn-isk M1 t gn-k-local) (= (gn-dv M1 t) s)) M1
          (>= r 0) (gn-into M1 r t)
          :else (let [q (gn-src M1 t 16 1)] (-> M1 (gn-ldt t 16 1) (gn-st q s))))))

;; ---- calls ---------------------------------------------------------------------------------------------------------
;; registers r .. r+n-1 := temps t .. t+n-1
(defn- gn-args [M :vector-i64 t :i64 r :i64 n :i64] :vector-i64
  (if (<= n 0) M (gn-args (gn-into M r t) (inc t) (inc r) (dec n))))
;; x0 := ctx ; x16 := [x0, #slot] ; blr x16 (x7 is then unknown)
(defn- gn-rtcall [M :vector-i64 slot :i64] :vector-i64
  (-> M
      (cond-> (= (gn-g M gn-f-ctx) 1) (gn-mov 0 7)
              (= (gn-g M gn-f-ctx) 0) (gn-ld 0 0))
      (gn-emit (enc-ldr 16 0 slot))
      (gn-emit (enc-blr 16)) (gn-vclear)
      (gn-gs gn-f-ctx 0)))
;; R4B: arguments k >= 7 of a call go to the outgoing area [sp, #8*(k-7)]
(defn- gn-stack-args [M :vector-i64 t :i64 k :i64 n :i64] :vector-i64
  (if (>= k n)
    M
    (let [r (gn-src M (+ t k) 16 1)]
      (gn-stack-args (-> M (gn-ldt (+ t k) 16 1) (gn-emit (enc-str r 31 (* 8 (- k 7))))) t (inc k) n))))
(defn- gn-call-sign [M :vector-i64 i :i64 t :i64 w :i64] :vector-i64
  (let [width (bit-and w 511) modulus (i64-shift-left 1 width)
        M1 (if (>= w 1536) (gn-op-fuel M) M)]
    (if (gn-isk M1 t gn-k-const)
      (let [v (bit-and (gn-dv M1 t) (dec modulus))]
        (gn-def M1 t gn-k-const (if (>= v (quot modulus 2)) (- v modulus) v)))
      (let [s (gn-co M1 i t) d (gn-dreg M1 t s) x (gn-src M1 t 16 1)]
        (-> M1 (gn-protect t s) (gn-ldt t 16 1)
            (gn-emit (gn-e-bf 0x93400000 d x 0 (dec width))) (gn-fin t s d))))))
;; Emulate the callee leaf transaction in x8, not caller gn-op-fuel.
;; x0/x8 are free in the retained nonleaf caller; pinned argument/live temps
;; are x9..x15, callee-saved locals or homes. Traps keep the pre-call fuel,
;; except original exhaustion, which publishes zero. Return publishes x8.
(defn- gn-mask-charge [M :vector-i64] :vector-i64
  (-> M (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 3))
      (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))))
(defn- gn-call-mask-writer [M :vector-i64 t :i64] :vector-i64
  (let [M1 (-> M (gn-pin t) (gn-pin (inc t)))
        rv (gn-pinned M1 t) ri (gn-pinned M1 (inc t))]
    (-> M1 (gn-ctx) (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mask-charge)
        (gn-into 0 (+ t 2)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 7))
        (gn-mask-charge) (gn-hchk rv 312 320) (gn-vidx ri)
        (gn-emit (gn-e-strr3 0 16 17)) (gn-emit (enc-str 8 7 CTX-FUEL))
        (gn-gs gn-f-h (inc t)))))

;; x8 reproduces the original leaf's fuel transaction; CSEL comparisons
;; use signed flags and do not subtract bounds in language arithmetic.
(defn- gn-call-clamp [M :vector-i64 i :i64 f :i64 t :i64 q :i64] :vector-i64
  (let [p (gn-fnf M f FF-SIR) fuel (= (gn-op M (inc p)) OP-FUEL)
        w (gn-sign-wrapper M (gn-sir M (inc q) IF-A) 1)
        charged (or fuel (>= w 1536)) width (bit-and w 511)
        low (gn-sir M (+ q 4) IF-B) high (gn-sir M (+ q 11) IF-B)]
    (-> M (gn-into 0 t) (gn-ctx)
        (cond-> charged (gn-emit (enc-ldr 8 7 CTX-FUEL))
                fuel (gn-mask-charge)
                (>= w 1536) (gn-mask-charge))
        (gn-emit (gn-e-bf 0x93400000 0 0 0 (dec width)))
        (gn-mov-imm 16 low) (gn-emit (enc-cmp-r 0 16))
        (gn-emit (enc-csel 0 16 0 (enc-cond-lt)))
        (gn-mov-imm 17 high) (gn-emit (enc-cmp-r 0 17))
        (gn-emit (enc-csel 0 17 0 (enc-cond-gt)))
        (cond-> charged (gn-emit (enc-str 8 7 CTX-FUEL)))
        (gn-take i t 0))))

;; Bounded structural proof that a direct callee returns with input x7.
;; A shared remaining-work budget counts all transitive SIR instructions; it
;; prevents exponential rescanning. Unknown effects/operations fail closed.
;; Caller frame, real call and every fuel/trap/publication boundary remain.
(defn- gn-ctx-safe [M :vector-i64 f :i64 n :i64 depth :i64 work :i64] :i64
  (let [p (gn-fnf M f FF-SIR)]
    (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0) (> depth 0) (> work 0)
             (not (and (>= f (gn-g M gn-g-open)) (< f (+ (gn-g M gn-g-open) (gn-g M gn-g-open-n)))))
             (<= n 7) (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) n))
      (gn-ctx-scan M (inc p) f depth (dec work)) -1)))
(defn- gn-ctx-scan [M :vector-i64 j :i64 f :i64 depth :i64 work :i64] :i64
  (if (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) -1
    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
          left (dec work)]
      (case op
        OP-END (if (= a f) left -1)
        (OP-CONST OP-LGET OP-LSET OP-BIN OP-CMP OP-UN OP-LABEL OP-BR OP-BRZ OP-BRNZ OP-FUEL OP-RET OP-RET2 OP-RES2 OP-TRAP OP-TAB OP-FADDR)
        (gn-ctx-scan M (inc j) f depth left)
        OP-RT (if (gn-inl a b c) (gn-ctx-scan M (inc j) f depth left) -1)
        OP-CALL (let [remain (gn-ctx-safe M a c (dec depth) left)]
                  (if (< remain 0) -1 (gn-ctx-scan M (inc j) f depth remain)))
        -1))))

;; Exact closed frameless scalar low-bit mask. Optional one entry charge.
;; Keep separate from gn-call-wrapper: original caller nonleaf prescan remains.
;; Token width +256*charged; zero means refusal. No names or input guesses.
;; Repeated-call admission limits expansion to shared scalar helpers.
;; This is a static code-growth heuristic, not a proof of dynamic time share.
;; Work exhaustion refuses; finding two direct scalar call sites is enough.
(defn- gn-mask-reused [M :vector-i64 f :i64 j :i64 seen :i64 work :i64] :bool
 (cond (>= seen 2) true
       (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) false
       :else (gn-mask-reused M f (inc j)
          (+ seen (if (and (= (gn-op M j) OP-CALL) (= (gn-sir M j IF-A) f)
                           (= (gn-sir M j IF-C) 1) (not= (gn-op M (inc j)) OP-RES2)) 1 0)) (dec work))))
(defn- gn-scalar-mask [M :vector-i64 i :i64 f :i64 n :i64] :i64
 (let [p (gn-fnf M f FF-SIR)
       fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
       q (gn-skiplab M (+ p 1 fuel)) mask (gn-sir M (inc q) IF-B)]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0)
           (not (gn-clamp-open M f)) (= n 1)
           (not= (gn-op M (inc i)) OP-RES2)
           (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-PT0) TY-I64)
           (= (gn-fnf M f FF-RTYPE) TY-I64)
           (= (gn-fnf M f FF-NSLOTS) 1) (<= (gn-fnf M f FF-DEPTH) 2)
           (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 1)
           (= (gn-op M q) OP-LGET) (= (gn-sir M q IF-A) 0) (= (gn-sir M q IF-B) 1)
           (= (gn-op M (inc q)) OP-CONST) (= (gn-sir M (inc q) IF-A) 1)
           (> mask 0) (= (bit-and mask (inc mask)) 0)
           (= (gn-op M (+ q 2)) OP-BIN) (= (gn-sir M (+ q 2) IF-A) BOP-AND)
           (= (gn-sir M (+ q 2) IF-B) 0) (= (gn-sir M (+ q 2) IF-C) 0)
           (= (gn-op M (+ q 3)) OP-RET) (= (gn-sir M (+ q 3) IF-A) 0)
           (= (gn-op M (+ q 4)) OP-END) (= (gn-sir M (+ q 4) IF-A) f)
           (gn-mask-reused M f 1 0 16384))
      (+ (gn-tz (inc mask) 0) (* fuel 256)) 0)))
(defn- gn-call-scalar-mask [M :vector-i64 i :i64 t :i64 token :i64] :vector-i64
 (let [width (bit-and token 255) charged (>= token 256)]
  (-> M (gn-into 0 t) (gn-ctx)
      (cond-> charged (gn-emit (enc-ldr 8 7 CTX-FUEL)) charged (gn-mask-charge))
      (gn-emit (gn-e-bf 0xd3400000 0 0 0 (dec width)))
      (cond-> charged (gn-emit (enc-str 8 7 CTX-FUEL)))
      (gn-take i t 0))))
;; Exact closed frameless affine-index vector reader. Preserve caller frame.
;; The callee's entry fuel remains private in x8 until success or exhaustion;
;; invalid handle/index traps retain pre-call published fuel. No check hoisting.
(defn- gn-affine-reader [M :vector-i64 i :i64 f :i64 n :i64] :i64
 (let [p (gn-fnf M f FF-SIR) fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
       q (gn-skiplab M (+ p 1 fuel))]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0)
           (= (gn-g M gn-f-leaf) 0) (not (gn-clamp-open M f)) (= n 2)
           (not= (gn-op M (inc i)) OP-RES2)
           (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-PT0) TY-VEC)
           (= (gn-fnf M f (inc FF-PT0)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-I64)
           (= (gn-fnf M f FF-NSLOTS) 2) (<= (gn-fnf M f FF-DEPTH) 3)
           (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 2)
           (= (gn-sir M p IF-C) 2)
           (= (gn-op M q) OP-LGET) (= (gn-sir M q IF-A) 0) (= (gn-sir M q IF-B) 1)
           (= (gn-op M (+ q 1)) OP-LGET) (= (gn-sir M (+ q 1) IF-A) 1) (= (gn-sir M (+ q 1) IF-B) 2)
           (= (gn-op M (+ q 2)) OP-CONST) (= (gn-sir M (+ q 2) IF-A) 2)
           (= (gn-op M (+ q 3)) OP-BIN) (= (gn-sir M (+ q 3) IF-A) BOP-MUL)
           (= (gn-sir M (+ q 3) IF-B) 1) (= (gn-sir M (+ q 3) IF-C) 0)
           (= (gn-op M (+ q 4)) OP-RT) (= (gn-sir M (+ q 4) IF-A) RT-VECTOR-AT)
           (= (gn-sir M (+ q 4) IF-B) 0) (= (gn-sir M (+ q 4) IF-C) 2)
           (= (gn-op M (+ q 5)) OP-RET) (= (gn-sir M (+ q 5) IF-A) 0)
           (= (gn-op M (+ q 6)) OP-END) (= (gn-sir M (+ q 6) IF-A) f)) q 0)))
(defn- gn-call-affine-reader [M :vector-i64 i :i64 t :i64 f :i64 q :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) charged (= (gn-op M (inc p)) OP-FUEL)
       k (gn-sir M (+ q 2) IF-B) shift (gn-pow2 k)]
  (-> M (gn-into 0 t) (gn-into 1 (inc t)) (gn-ctx)
      (cond-> charged (gn-emit (enc-ldr 8 7 CTX-FUEL)) charged (gn-mask-charge))
      (cond-> (> shift 0) (gn-emit (gn-e-lsl 1 1 shift))
              (<= shift 0) (gn-mov-imm 2 k) (<= shift 0) (gn-emit (enc-mul 1 1 2)))
      (gn-vread 0 1 0)
      (cond-> charged (gn-emit (enc-str 8 7 CTX-FUEL))) (gn-take i t 0))))
;; Novel bounded pure scalar DAG call-edge expansion. No SIR/FN mutation.
;; All caller allocation/frame remains ordinary nonleaf. Generic callee remains.
(def di-used (+ gn-g-open-n 1))
(def di-sites (+ gn-g-open-n 2))
(def di-snap (+ gn-g-open-n 3))
(defn- di-type [ty :i64] :bool (or (= ty TY-I64) (= ty TY-BOOL)))
(defn- di-params [M :vector-i64 f :i64 k :i64 n :i64] :bool
 (or (= k n) (and (di-type (gn-fnf M f (+ FF-PT0 k))) (di-params M f (inc k) n))))
(defn- di-bit [k :i64] :i64 (i64-shift-left 1 k))
(defn- di-have [mask :i64 k :i64] :bool (not= (bit-and mask (di-bit k)) 0))
(defn- di-bin [a :i64] :bool
 (or (= a BOP-ADD) (= a BOP-SUB) (= a BOP-MUL) (= a BOP-AND) (= a BOP-OR) (= a BOP-XOR)
     (= a BOP-SHL) (= a BOP-USHR) (= a BOP-SSHR)))
;; Returns exact END index, or zero. Iterative finite32-instruction certificate.
(defn- di-body [M :vector-i64 p :i64 f :i64 ns :i64 dp :i64 n :i64] :i64
 (loop [j (inc p) h 0 locals (dec (di-bit (inc n))) work 32]
  (if (or (<= work 0) (>= (inc j) (vector-at M MM-SIR-N))) 0
   (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
         dst (if (or (= op OP-CONST) (= op OP-LGET)) a b)
         valid (case op
          OP-LABEL (and (= j (inc p)) (> a 0) (< a MM-LABEL-CAP) (= b 0) (= c 0))
          OP-CONST (and (>= a 0) (<= a h) (< a dp) (= c 0))
          OP-LGET (and (>= a 0) (<= a h) (< a dp) (> b 0) (<= b ns) (di-have locals b) (= c 0))
          OP-LSET (and (> a 0) (<= a ns) (>= b 0) (< b h) (= c 0))
          OP-BIN (and (di-bin a) (>= b 0) (< (inc b) h) (= c 0))
          OP-CMP (and (>= a CC-EQ) (<= a CC-GE) (>= b 0) (< (inc b) h) (= c 0))
          OP-UN (and (or (= a UOP-NOT) (= a UOP-BITNOT)) (>= b 0) (< b h) (= c 0))
          OP-RET (and (>= a 0) (< a h) (= b 0) (= c 0)
                      (= (gn-op M (inc j)) OP-END) (= (gn-sir M (inc j) IF-A) f)
                      (= (gn-sir M (inc j) IF-B) 0) (= (gn-sir M (inc j) IF-C) 0))
          false)]
    (cond (not valid) 0
          (= op OP-RET) (inc j)
          :else (recur (inc j) (if (or (= op OP-CONST) (= op OP-LGET) (= op OP-BIN) (= op OP-CMP) (= op OP-UN)) (inc dst) h)
                      (if (= op OP-LSET) (bit-or locals (di-bit a)) locals) (dec work)))))))
(defn- di-shape [M :vector-i64 f :i64 n :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (< n 1) (> n 5) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR) ns (gn-fnf M f FF-NSLOTS) dp (gn-fnf M f FF-DEPTH)]
   (if (and (> p 0) (< p (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) n) (= (gn-sir M p IF-C) ns)
       (= (gn-fnf M f FF-NPARAMS) n) (>= ns n) (<= ns 7) (> dp 0) (<= dp 7)
       (di-type (gn-fnf M f FF-RTYPE)) (di-params M f 0 n))
    (di-body M p f ns dp n) 0))))
;; Caller argument source banks are disjoint from x0..4 destinations.
(defn- di-args-safe [M :vector-i64 t :i64 n :i64] :bool
 (if (= n 0) true
  (let [k (gn-dk M t) v (gn-dv M t) r (if (= k gn-k-local) (gn-sreg M v) -1)]
   (and (or (= k gn-k-const) (= k gn-k-reg) (= k gn-k-home)
            (and (= k gn-k-local) (> v 0) (<= v (gn-g M gn-f-ns)) (or (< r 0) (and (>= r 19) (<= r 28)))))
        (di-args-safe M (inc t) (dec n))))))
(defn- di-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (and (= (gn-g M gn-f-leaf) 0) (> (gn-g M gn-f-fb) 0) (>= t 0) (> n 0) (<= n 5)
          (<= (+ t n) (gn-g M gn-f-h)) (<= (+ t n) (gn-g M gn-f-dp))
          (not= (gn-op M (inc i)) OP-RET) (not= (gn-op M (inc i)) OP-RES2)
          (< (gn-g M di-sites) 256) (< (gn-g M di-used) 4096) (di-args-safe M t n))
  (di-shape M f n) 0))
;; Snapshot38 cells: scalar0..15, sreg0..7, dk0..6, dv0..6.
(defn- di-field [k :i64] :i64
 (cond (< k 16) k (< k 24) (+ gn-a-sreg (- k 16)) (< k 31) (+ gn-a-dk (- k 24))
       :else (+ gn-a-dv (- k 31))))
(defn- di-save [M :vector-i64 bank :i64 k :i64] :vector-i64
 (if (= k 38) M (di-save (gn-gs M (+ di-snap (+ (* bank 38) k)) (gn-g M (di-field k))) bank (inc k))))
(defn- di-restore [M :vector-i64 bank :i64 k :i64] :vector-i64
 (if (= k 38) M (di-restore (gn-gs M (di-field k) (gn-g M (+ di-snap (+ (* bank 38) k)))) bank (inc k))))
(defn- di-init [M :vector-i64 f :i64] :vector-i64
 (-> M (gn-zero 0 16) (gn-zero gn-a-sreg (+ gn-a-sreg 8))
       (gn-zero gn-a-dk (+ gn-a-dk 7)) (gn-zero gn-a-dv (+ gn-a-dv 7))
       (gn-gs gn-f-leaf 1) (gn-gs gn-f-ns (gn-fnf M f FF-NSLOTS))
       (gn-gs gn-f-dp (gn-fnf M f FF-DEPTH)) (gn-lowregs 1 (gn-fnf M f FF-NSLOTS))))
;; No fn/ret/prologue/layout instruction is emitted; exact scalar emitters only.
(defn- di-emit-body [M :vector-i64 j :i64 end :i64] :vector-i64
 (if (or (>= j end) (not= (vector-at M MM-ERR) 0)) M
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
        m1 (case op
             OP-CONST (gn-def M a gn-k-const b)
             OP-LGET (gn-def M a gn-k-local b)
             OP-LSET (gn-op-lset M a b)
             OP-BIN (gn-op-bin M j a b)
             OP-CMP (gn-op-cmp M j a b)
             OP-UN (gn-op-un M j a b)
             OP-LABEL M
             OP-RET (gn-into M 0 a)
             (gn-err M E-GEN-OP op))
        skip (gn-g m1 gn-f-skip)]
   (di-emit-body (gn-gs m1 gn-f-skip 0) (+ j 1 skip) end))))
(defn- di-call [M :vector-i64 i :i64 f :i64 t :i64 n :i64 end :i64] :vector-i64
 (let [code (vector-at M MM-CODE-N) fix (vector-at M MM-FIX-N)
       m0 (di-save M 0 0)
       m1 (-> m0 (gn-save 0 t) (gn-args t 0 n) (gn-ctx) (di-save 1 0))
       m2 (di-emit-body (di-init m1 f) (inc (gn-fnf M f FF-SIR)) end)
       m3 (-> m2 (di-restore 1 0) (gn-vclear) (gn-gs gn-f-ctx 1) (gn-take i t 0))
       words (- (vector-at m3 MM-CODE-N) code)
       good (and (<= words 64) (<= (+ (gn-g m3 di-used) words) 4096) (= (vector-at m3 MM-FIX-N) fix))]
  (cond (not= (vector-at m3 MM-ERR) 0) m3
        good (-> m3 (gn-gs di-used (+ (gn-g m3 di-used) words))
                 (gn-gs di-sites (inc (gn-g m3 di-sites))))
        :else (-> m3 (di-restore 0 0) (gn-put MM-CODE-N code) (gn-put MM-FIX-N fix)
                  (gn-call-generic i f t n)))))

(defn- gn-op-call [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :vector-i64
  (let [w (gn-call-wrapper M i f t n) q (if (= (gn-g M gn-f-leaf) 2) 0 (gn-clamp M i f n)) mask (if (= (gn-g M gn-f-leaf) 2) 0 (gn-scalar-mask M i f n)) reader (if (= (gn-g M gn-f-leaf) 2) 0 (gn-affine-reader M i f n)) dag (di-admit M i f t n)]
   (cond (> reader 0) (gn-call-affine-reader M i t f reader) (> mask 0) (gn-call-scalar-mask M i t mask) (> q 0) (gn-call-clamp M i f t q) (gn-mask-writer M i f t n) (gn-call-mask-writer M t)
         (>= w 1024) (gn-call-sign M i t w)
         (> w 0) (let [M1 (if (>= w 256) (gn-op-fuel M) M)
                       slot (bit-and w 255)]
                   (if (= slot 1) (gn-gs M1 gn-f-h (inc t)) (gn-op-rt M1 i slot t n)))
         (> dag 0) (di-call M i f t n dag)
         :else (gn-call-generic M i f t n))))
(defn- gn-call-generic [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :vector-i64
 (cond
         (and (<= n 7) (= (gn-op M (inc i)) OP-RET) (= (gn-sir M (inc i) IF-A) t))
         (gn-op-tail-call M f t n)
         :else
    (-> M
      (gn-save 0 t)
      (gn-stack-args t 7 n)
      (gn-args t 0 (gn-min n 7))
      (gn-ctx)
      (gn-fix FX-BL26 f)
      (gn-emit (enc-bl 0))
      (gn-vclear)
      (gn-gs gn-f-ctx (if (>= (gn-ctx-safe M f n 8 512) 0) 1 0))
      (gn-take i t 0))))
;; A direct call whose only successor returns its scalar result can restore
;; this frame and branch to the callee. Stack arguments and RET2 are excluded.
;; Argument registers and x7 (context) survive the callee-saved restore.
;; FX-BL26 resolves a function target and patches imm26; the opcode remains B.
(defn- gn-op-tail-call [M :vector-i64 f :i64 t :i64 n :i64] :vector-i64
  (let [restored (-> M (gn-args t 0 n) (gn-ctx) (gn-epilogue))
        at (- (vector-at restored MM-CODE-N) 1)]
    (-> restored (gn-put MM-CODE-N at) (gn-chain-fix f t n) (gn-emit (enc-b 0)))))
;; R4: CALLI 0 t n -- blr to the code address in temp t+n, arguments t .. t+n-1 (a closure call)
(defn- gn-op-calli [M :vector-i64 i :i64 t :i64 n :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-args t 0 n)
      (gn-into 16 (+ t n))
      (gn-ctx)
      (gn-emit (enc-blr 16)) (gn-vclear)
      (gn-gs gn-f-ctx 0)
      (gn-take i t 0)))
;; R4: FADDR t f -- adr d, <entry of FN f> (FX-ADR19)
(defn- gn-op-faddr [M :vector-i64 i :i64 t :i64 f :i64] :vector-i64
  (let [s (gn-co M i t)
        d (gn-dreg M t s)]
    (-> M (gn-protect t s) (gn-fix FX-ADR19 f) (gn-emit (gn-e-adr d)) (gn-fin t s d))))
(defn- gn-op-cap [M :vector-i64 i :i64 wire :i64 kind :i64 t :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-into 4 t)
      (gn-mov-imm 1 wire)
      (gn-mov-imm 2 kind)
      (gn-mov-imm 3 kind)
      (gn-rtcall RT-TYPED-CAP-CALL)
      (gn-take i t 0)))
;; string literal: pair_new(ctx, code-relative pool offset (FX-LIT32 on movz x1 + movk x1), byte length);
;; no code when only string-length / string-code-point-at read it (gn-str-fold)
(defn- gn-op-str [M :vector-i64 i :i64 t :i64 lit :i64] :vector-i64
  (if (> (gn-str-fold M i) 0)
    (gn-def M t gn-k-lit lit)
    (gn-op-str-pair M i t lit)))
(defn- gn-op-str-pair [M :vector-i64 i :i64 t :i64 lit :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-fix FX-LIT32 lit)
      (gn-emit (enc-movz 1 0 0))
      (gn-emit (enc-movk 1 0 1))
      (gn-mov-imm 2 (gn-litf M lit LF-LEN))
      (gn-rtcall RT-PAIR-NEW)
      (gn-take i t 0)))

;; ---- inline runtime operations (ABI v9 pointers; the C twin's checks; udf #0 = SIGILL on failure) -------------------
;; x16 := &table[h - 1] after checking (h - 1) < *used (unsigned); h in register rv (x17 allowed)
(defn- gn-hchk [M :vector-i64 rv :i64 used :i64 base :i64] :vector-i64
  (-> M
      (gn-emit (enc-ldr 16 7 used))
      (gn-emit (enc-ldr 16 16 0))
      (gn-emit (enc-sub-i 17 rv 1))
      (gn-emit (enc-cmp-r 17 16))
      (gn-emit (enc-bcond (enc-cond-lo) 2))
      (gn-emit (gn-e-udf))
      (gn-emit (enc-ldr 16 7 base))
      (gn-emit (gn-e-addsl 16 16 17 4))))
;; after gn-hchk on the vector table: x17 := offset + index (checked index < length), x16 := items base
(defn- gn-vidx [M :vector-i64 ri :i64] :vector-i64
  (-> M
      (gn-emit (enc-ldp 17 16 16 0))
      (gn-emit (enc-cmp-r ri 16))
      (gn-emit (enc-bcond (enc-cond-lo) 2))
      (gn-emit (gn-e-udf))
      (gn-emit (enc-ldr 16 7 328))
      (gn-emit (enc-add-r 17 17 ri))))
;; (vector-at v i), v = temp t, i = temp t+1 (t <= 5)
(defn- gn-rt-at [M :vector-i64 i :i64 t :i64] :vector-i64
  (let [slot (if (= (gn-g M gn-f-vmode) 3) (gn-g M 15) (if (gn-isk M t gn-k-local) (gn-dv M t) 0))
        M1 (gn-pin M (inc t))
        ri (gn-pinned M1 (inc t))
        rv (gn-src M1 t 17 0)
        s (gn-co M1 i t)
        d (gn-dreg M1 t s)]
    (-> M1 (gn-protect t s) (gn-ctx) (gn-ldt t 17 0) (gn-chain-read rv ri d slot) (gn-fin t s d))))
;; (vector-assoc! v i x), temps t, t+1, t+2 (t <= 4); the result is v (its descriptor is kept)
(defn- gn-rt-set [M :vector-i64 t :i64] :vector-i64
  (let [slot (if (gn-isk M t gn-k-local) (gn-dv M t) 0)
        M1 (-> M (gn-pin t) (gn-pin (inc t)))
        M2 (if (and (gn-isk M1 (+ t 2) gn-k-const) (= (gn-dv M1 (+ t 2)) 0)) M1 (gn-pin M1 (+ t 2)))
        rv (gn-pinned M2 t)
        ri (gn-pinned M2 (inc t))
        rx (if (gn-isk M2 (+ t 2) gn-k-const) 31 (gn-pinned M2 (+ t 2)))]
    (-> M2 (gn-ctx) (gn-chain-store rv ri rx slot) (gn-gs gn-f-h (inc t)))))
;; one-handle reads: sel 0 = pair-first, 1 = pair-second, 2 = vector-count
(defn- gn-rt-get [M :vector-i64 i :i64 t :i64 sel :i64] :vector-i64
  (let [rv (gn-src M t 17 0)
        s (gn-co M i t)
        d (gn-dreg M t s)]
    (-> M
        (gn-protect t s)
        (gn-ctx)
        (gn-ldt t 17 0)
        (gn-hchk rv (if (= sel 2) 312 288) (if (= sel 2) 320 296))
        (gn-emit (enc-ldr d 16 (if (= sel 0) 0 8)))
        (gn-fin t s d))))
;; (string-code-point-at <ASCII literal> i): bounds check, then the byte from the pool
(defn- gn-rt-lit-at [M :vector-i64 i :i64 t :i64] :vector-i64
  (let [lit (gn-dv M t)
        len (gn-litf M lit LF-LEN)
        ri (gn-src M (inc t) 16 0)
        s (gn-co M i t)
        d (gn-dreg M t s)]
    (-> M
        (gn-protect t s)
        (gn-ctx)
        (gn-ldt (inc t) 16 0)
        (cond-> (< len 4096) (gn-emit (enc-cmp-i ri len))
                (>= len 4096) (-> (gn-mov-imm 17 len) (gn-emit (enc-cmp-r ri 17))))
        (gn-emit (enc-bcond (enc-cond-lo) 2))
        (gn-emit (gn-e-udf))
        (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))
        (gn-emit (enc-add-r 17 17 ri))
        (gn-fix FX-LIT32 lit)
        (gn-emit (enc-movz 16 0 0))
        (gn-emit (enc-movk 16 0 1))
        (gn-emit (gn-e-ldrb d 17 16))
        (gn-fin t s d))))
;; R4 (the UTF-8 rule, seed/HEADS :tokens): (string-code-point-at s i) on a string handle. A code-relative pair (a
;; string literal or a view of one: offset >= 0, offset + length <= code_length) is valid UTF-8, so its ASCII bytes are
;; read in line; any other case (a pool string, a non-ASCII byte, an index or handle out of range) calls the C helper,
;; which checks and validates as before. x1 = handle, x2 = index, result x0.
;;   0 ldr x16,[x7,#288] ; 1 ldr x16,[x16] ; 2 sub x17,x1,#1 ; 3 cmp x17,x16 ; 4 b.hs SLOW ; 5 ldr x16,[x7,#296] ;
;;   6 add x16,x16,x17,lsl #4 ; 7 ldp x17,x16,[x16] ; 8 cmp x17,#0 ; 9 b.lt SLOW ; 10 cmp x2,x16 ; 11 b.hs SLOW ;
;;   12 add x16,x17,x16 ; 13 ldr x0,[x7,#392] ; 14 cmp x16,x0 ; 15 b.hi SLOW ; 16 ldr x16,[x7,#384] ; 17 add x16,x16,x17 ;
;;   18 ldrb w0,[x16,x2] ; 19 cmp x0,#128 ; 20 b.lo DONE ; 21 SLOW: mov x0,x7 ; 22 ldr x16,[x0,#144] ; 23 blr x16 ; 24 DONE
(defn- gn-rt-cpa [M :vector-i64 i :i64 t :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-args t 1 2)
      (gn-ctx)
      (gn-emit (enc-ldr 16 7 288)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 1 1)) (gn-emit (enc-cmp-r 17 16))
      (gn-emit (enc-bcond (enc-cond-hs) 17))
      (gn-emit (enc-ldr 16 7 296)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
      (gn-emit (enc-cmp-i 17 0)) (gn-emit (enc-bcond (enc-cond-lt) 12))
      (gn-emit (enc-cmp-r 2 16)) (gn-emit (enc-bcond (enc-cond-hs) 10))
      (gn-emit (enc-add-r 16 17 16)) (gn-emit (enc-ldr 0 7 392)) (gn-emit (enc-cmp-r 16 0)) (gn-emit (enc-bcond 8 6))
      (gn-emit (enc-ldr 16 7 CTX-CODE-BASE)) (gn-emit (enc-add-r 16 16 17)) (gn-emit (gn-e-ldrb 0 16 2))
      (gn-emit (enc-cmp-i 0 128)) (gn-emit (enc-bcond (enc-cond-lo) 4))
      (gn-emit (enc-mov-r 0 7)) (gn-emit (enc-ldr 16 0 RT-STRING-CODE-POINT-AT)) (gn-emit (enc-blr 16)) (gn-vclear)
      (gn-gs gn-f-ctx 0)
      (gn-take i t 0)))
;; High-temp read composition. Original prescan stays nonleaf and keeps its
;; frame/register/fuel contract. Preserve live prefix registers and homes without call spills; x0/x1 are free
;; argument scratch under that contract. Every handle/index check stays ordered.
;; Profitability guard: only an access inside an actual backward branch region.
;; Bounded scans refuse without changing the original call path. Label ownership
;; is checked against the current function; no code or benchmark names.
(defn- gn-high-start [M :vector-i64 j :i64 work :i64] :i64
 (cond (or (<= work 0) (<= j 0)) 0
       (= (gn-op M j) OP-FN) j
       (= (gn-op M j) OP-END) 0
       :else (gn-high-start M (dec j) (dec work))))
(defn- gn-high-loop-scan [M :vector-i64 i :i64 j :i64 start :i64 work :i64] :bool
 (if (or (<= work 0) (>= j (vector-at M MM-SIR-N)) (= (gn-op M j) OP-END)) false
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
        l (if (= op OP-BR) a (if (or (= op OP-BRZ) (= op OP-BRNZ)) b 0))
        p (if (> l 0) (gn-lpos M l) 0)]
   (if (and (> p start) (<= p i) (< p j) (= (gn-op M p) OP-LABEL) (= (gn-sir M p IF-A) l)) true
    (gn-high-loop-scan M i (inc j) start (dec work))))))
(defn- gn-high-loop [M :vector-i64 i :i64] :bool
 (let [start (gn-high-start M i 8192)]
  (and (> start 0) (gn-high-loop-scan M i (inc i) start 8192))))
(defn- gn-rt-high-at [M :vector-i64 i :i64 t :i64] :vector-i64
 (-> M (gn-into 0 t) (gn-into 1 (inc t)) (gn-ctx)
     (gn-vread 0 1 0)
     (gn-take i t 0)))
(defn- gn-op-rt [M :vector-i64 i :i64 slot :i64 t :i64 n :i64] :vector-i64
  (cond (and (gn-isk M t gn-k-lit) (= slot RT-PAIR-SECOND)) (gn-def M t gn-k-const (gn-litf M (gn-dv M t) LF-LEN))
        (gn-isk M t gn-k-lit) (gn-rt-lit-at M i t)
        (and (= slot RT-STRING-CODE-POINT-AT) (= n 2)) (gn-rt-cpa M i t)
        (and (= slot RT-VECTOR-AT) (= n 2) (>= t 6) (= (gn-g M gn-f-leaf) 0) (gn-high-loop M i)) (gn-rt-high-at M i t)
        (not (gn-inl slot t n)) (-> M (gn-save 0 t) (gn-args t 1 n) (gn-rtcall slot) (gn-take i t 0))
        (= slot RT-VECTOR-AT) (gn-rt-at M i t)
        (= slot RT-VECTOR-ASSOC-IN-PLACE) (gn-rt-set M t)
        (= slot RT-PAIR-FIRST) (gn-rt-get M i t 0)
        (= slot RT-PAIR-SECOND) (gn-rt-get M i t 1)
        :else (gn-rt-get M i t 2)))

;; VEC t n: vector_alloc(ctx, n), then the items stored straight into the fresh vector's items
(defn- gn-vec-items [M :vector-i64 t :i64 k :i64 n :i64] :vector-i64
  (if (>= k n)
    M
    (let [r (gn-src M (+ t k) 17 1)]
      (gn-vec-items (-> M (gn-ldt (+ t k) 17 1) (gn-emit (enc-str r 16 (* 8 k)))) t (inc k) n))))
(defn- gn-op-vec [M :vector-i64 i :i64 t :i64 n :i64] :vector-i64
  (-> M
      (gn-save 0 (+ t n))
      (gn-mov-imm 1 n)
      (gn-rtcall RT-VECTOR-ALLOC)
      (cond-> (> n 0) (-> (gn-ctx)
                          (gn-emit (enc-sub-i 17 0 1))
                          (gn-emit (enc-ldr 16 7 320))
                          (gn-emit (gn-e-addsl 16 16 17 4))
                          (gn-emit (enc-ldr 17 16 0))
                          (gn-emit (enc-ldr 16 7 328))
                          (gn-emit (gn-e-addsl 16 16 17 3))
                          (gn-vec-items t 0 n)))
      (gn-take i t 0)))

;; R4B: VECP t lit n: vector_alloc(ctx, n), x16 := the items, x17 := code_base + LF-POOL(lit), then the copy loop
;;   ldr x3,[x17] ; add x17,x17,#8 ; str x3,[x16] ; add x16,x16,#8 ; subs x2,x2,#1 ; b.ne -5
(defn- gn-op-vecp [M :vector-i64 i :i64 t :i64 lit :i64 n :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-mov-imm 1 n)
      (gn-rtcall RT-VECTOR-ALLOC)
      (gn-ctx)
      (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldr 17 16 0))
      (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 16 16 17 3))
      (gn-fix FX-LIT32 lit) (gn-emit (enc-movz 1 0 0)) (gn-emit (enc-movk 1 0 1))
      (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-emit (enc-add-r 17 17 1))
      (gn-mov-imm 2 n)
      (gn-emit (enc-ldr 3 17 0)) (gn-emit (enc-add-i 17 17 8)) (gn-emit (enc-str 3 16 0)) (gn-emit (enc-add-i 16 16 8))
      (gn-emit (enc-subs-i 2 2 1)) (gn-emit (enc-bcond (enc-cond-ne) -5))
      (gn-take i t 0)))

;; TAB t lit n (constant table): cmp idx,#n ; b.lo +2 ; brk #0 ; x17 := code_base + 8*idx ; x16 := LF-POOL (FX-LIT32) ;
;; d := [x17, x16]
(defn- gn-op-tab [M :vector-i64 i :i64 t :i64 lit :i64 n :i64] :vector-i64
  (let [ri (gn-src M t 16 0)
        s (gn-co M i t)
        d (gn-dreg M t s)]
    (-> M
        (gn-protect t s)
        (gn-ctx)
        (gn-ldt t 16 0)
        (cond-> (< n 4096) (gn-emit (enc-cmp-i ri n))
                (>= n 4096) (-> (gn-mov-imm 17 n) (gn-emit (enc-cmp-r ri 17))))
        (gn-emit (enc-bcond (enc-cond-lo) 2))
        (gn-emit (enc-brk 0))
        (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))
        (gn-emit (gn-e-addsl 17 17 ri 3))
        (gn-fix FX-LIT32 lit)
        (gn-emit (enc-movz 16 0 0))
        (gn-emit (enc-movk 16 0 1))
        (gn-emit (gn-e-ldrr d 17 16 0))
        (gn-fin t s d))))

;; FUEL: leaf -> subs x8,x8,#1 ; b.hs +3 ; str xzr,[x7,#8] ; brk #0. Else ldr x16,[x7,#8] ; subs x16,x16,#1 ; b.hs +2 ; brk #0 ;
;; str x16,[x7,#8]. SEEDFIX (F4): the leaf's exhaustion path stores 0 to the context before brk, as the memory sequence
;; leaves it, so the loader reports :budget/fuel (not a bare SIGTRAP) when a leaf runs out (x8 was never written back)
(defn- gn-op-fuel [M :vector-i64] :vector-i64
  (if (= (gn-g M gn-f-freg) 1)
    (-> M (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 3)) (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0)))
    (-> M
        (gn-ctx)
        (gn-emit (enc-ldr 16 7 CTX-FUEL))
        (gn-emit (enc-subs-i 16 16 1))
        (gn-emit (enc-bcond (enc-cond-hs) 2))
        (gn-emit (enc-brk 0))
        (gn-emit (enc-str 16 7 CTX-FUEL)))))

;; Exact affine index consumed by immediately adjacent checked vector read.
;; Original nonleaf frame reserves x0/x1 scratch; every handle/index check stays.
;; Dead intermediates only; final result uses original alias/coalescing placement.
(defn- gn-affine-read? [M :vector-i64 i :i64 t :i64] :bool
 (let [a (gn-sir M i IF-B) b (gn-sir M (+ i 3) IF-B)
       factor (gn-sir M (inc i) IF-B) prefix (gn-dv M (dec t))]
  (and (= (gn-g M gn-f-leaf) 0) (>= t 7) (< (inc t) (gn-g M gn-f-dp)) (< (+ i 6) (vector-at M MM-SIR-N))
       (> a 0) (<= a (gn-g M gn-f-ns)) (> b 0) (<= b (gn-g M gn-f-ns))
       (>= (gn-sreg M a) 0) (>= (gn-sreg M b) 0)
       (gn-isk M (dec t) gn-k-const) (>= prefix -4095) (<= prefix 4095)
       (not= factor 0) (not= factor 1) (not= factor -1)
       (= (gn-sir M i IF-C) 0)
       (= (gn-op M (inc i)) OP-CONST) (= (gn-sir M (inc i) IF-A) (inc t)) (= (gn-sir M (inc i) IF-C) 0)
       (= (gn-op M (+ i 2)) OP-BIN) (= (gn-sir M (+ i 2) IF-A) BOP-MUL) (= (gn-sir M (+ i 2) IF-B) t) (= (gn-sir M (+ i 2) IF-C) 0)
       (= (gn-op M (+ i 3)) OP-LGET) (= (gn-sir M (+ i 3) IF-A) (inc t)) (= (gn-sir M (+ i 3) IF-C) 0)
       (= (gn-op M (+ i 4)) OP-BIN) (= (gn-sir M (+ i 4) IF-A) BOP-ADD) (= (gn-sir M (+ i 4) IF-B) t) (= (gn-sir M (+ i 4) IF-C) 0)
       (= (gn-op M (+ i 5)) OP-BIN) (= (gn-sir M (+ i 5) IF-A) BOP-ADD) (= (gn-sir M (+ i 5) IF-B) (dec t)) (= (gn-sir M (+ i 5) IF-C) 0)
       (= (gn-op M (+ i 6)) OP-RT) (= (gn-sir M (+ i 6) IF-A) RT-VECTOR-AT)
       (= (gn-sir M (+ i 6) IF-B) (- t 2)) (= (gn-sir M (+ i 6) IF-C) 2)
       (gn-kills M (+ i 7) (dec t) 16) (gn-high-loop M i) (gn-kills M (+ i 6) t 16) (gn-kills M (+ i 6) (inc t) 16))))
(defn- gn-affine-read [M :vector-i64 i :i64 t :i64] :vector-i64
 (let [out (- t 2) s (gn-co M (+ i 6) out) d (gn-dreg M out s)
       slot (if (gn-isk M out gn-k-local) (gn-dv M out) 0)
       a (gn-sreg M (gn-sir M i IF-B)) b (gn-sreg M (gn-sir M (+ i 3) IF-B))
       factor (gn-sir M (inc i) IF-B) prefix (gn-dv M (dec t))
       M1 (-> M (gn-protect out s) (gn-into 0 out) (gn-mov-imm 16 factor)
              (gn-emit (enc-madd 1 a 16 b)) (gn-bin-imm BOP-ADD 1 1 prefix)
              (gn-ctx) (gn-vpair slot d) (gn-fin out s d))]
  (gn-gs M1 gn-f-skip (+ 6 (gn-g M1 gn-f-skip)))))

;; Prototype whole closed dot loop: proof-guarded expansion, original fallback.
(defn- gn-dot-at? [M :vector-i64 i :i64 op :i64 a :i64 b :i64 c :i64] :bool
 (and (= (gn-op M i) op) (= (gn-sir M i IF-A) a)
      (= (gn-sir M i IF-B) b) (= (gn-sir M i IF-C) c)))
(defn- gn-dot-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B) exit (gn-sir M (+ p 8) IF-A)
       n (gn-sir M (+ p 4) IF-B) oa (gn-sir M (+ p 18) IF-B) sa (gn-sir M (+ p 20) IF-B)
       ob (gn-sir M (+ p 27) IF-B) sb (gn-sir M (+ p 29) IF-B)]
  (if (= k 47) true
   (and (case k
    0 (gn-dot-at? M (+ p 0) OP-FN f 5 5)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 5 0)
    8 (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
    13 (gn-dot-at? M (+ p 13) OP-LGET 3 4 0)
    14 (gn-dot-at? M (+ p 14) OP-CONST 4 1 0)
    15 (gn-dot-at? M (+ p 15) OP-BIN BOP-ADD 3 0)
    16 (gn-dot-at? M (+ p 16) OP-LGET 4 5 0)
    17 (gn-dot-at? M (+ p 17) OP-LGET 5 1 0)
    18 (gn-dot-at? M (+ p 18) OP-CONST 6 oa 0)
    19 (gn-dot-at? M (+ p 19) OP-LGET 7 2 0)
    20 (gn-dot-at? M (+ p 20) OP-CONST 8 sa 0)
    21 (gn-dot-at? M (+ p 21) OP-BIN BOP-MUL 7 0)
    22 (gn-dot-at? M (+ p 22) OP-LGET 8 4 0)
    23 (gn-dot-at? M (+ p 23) OP-BIN BOP-ADD 7 0)
    24 (gn-dot-at? M (+ p 24) OP-BIN BOP-ADD 6 0)
    25 (gn-dot-at? M (+ p 25) OP-RT RT-VECTOR-AT 5 2)
    26 (gn-dot-at? M (+ p 26) OP-LGET 6 1 0)
    27 (gn-dot-at? M (+ p 27) OP-CONST 7 ob 0)
    28 (gn-dot-at? M (+ p 28) OP-LGET 8 4 0)
    29 (gn-dot-at? M (+ p 29) OP-CONST 9 sb 0)
    30 (gn-dot-at? M (+ p 30) OP-BIN BOP-MUL 8 0)
    31 (gn-dot-at? M (+ p 31) OP-LGET 9 3 0)
    32 (gn-dot-at? M (+ p 32) OP-BIN BOP-ADD 8 0)
    33 (gn-dot-at? M (+ p 33) OP-BIN BOP-ADD 7 0)
    34 (gn-dot-at? M (+ p 34) OP-RT RT-VECTOR-AT 6 2)
    35 (gn-dot-at? M (+ p 35) OP-BIN BOP-MUL 5 0)
    36 (gn-dot-at? M (+ p 36) OP-BIN BOP-ADD 4 0)
    37 (gn-dot-at? M (+ p 37) OP-LSET 1 0 0)
    38 (gn-dot-at? M (+ p 38) OP-LSET 2 1 0)
    39 (gn-dot-at? M (+ p 39) OP-LSET 3 2 0)
    40 (gn-dot-at? M (+ p 40) OP-LSET 4 3 0)
    41 (gn-dot-at? M (+ p 41) OP-LSET 5 4 0)
    42 (gn-dot-at? M (+ p 42) OP-FUEL 0 0 0)
    43 (gn-dot-at? M (+ p 43) OP-BR head 0 0)
    44 (gn-dot-at? M (+ p 44) OP-LABEL exit 0 0)
    45 (gn-dot-at? M (+ p 45) OP-RET 0 0 0)
    46 (gn-dot-at? M (+ p 46) OP-END f 0 0)
    false)
        (gn-dot-shape M p f (inc k))))))
(defn- gn-dot? [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 46) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 5)
       (= (gn-fnf M f FF-NSLOTS) 5) (= (gn-fnf M f FF-DEPTH) 10)
       (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
       (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
       (= (gn-fnf M f (+ FF-PT0 4)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-I64)
       (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-h) 0)
       (>= (gn-sreg M 1) 19) (>= (gn-sreg M 2) 19) (>= (gn-sreg M 3) 19)
       (>= (gn-sreg M 4) 19) (>= (gn-sreg M 5) 19)
       (<= (gn-sreg M 1) 28) (<= (gn-sreg M 2) 28) (<= (gn-sreg M 3) 28)
       (<= (gn-sreg M 4) 28) (<= (gn-sreg M 5) 28)
       (>= (gn-sir M (+ p 4) IF-B) 1) (<= (gn-sir M (+ p 4) IF-B) 64)
       (>= (gn-sir M (+ p 18) IF-B) 0) (<= (gn-sir M (+ p 18) IF-B) 4095)
       (>= (gn-sir M (+ p 27) IF-B) 0) (<= (gn-sir M (+ p 27) IF-B) 4095)
       (>= (gn-sir M (+ p 20) IF-B) 1) (<= (gn-sir M (+ p 20) IF-B) 64)
       (>= (gn-sir M (+ p 29) IF-B) 1) (<= (gn-sir M (+ p 29) IF-B) 64)
       (> (gn-sir M (+ p 2) IF-A) 0) (> (gn-sir M (+ p 6) IF-B) 0) (> (gn-sir M (+ p 8) IF-A) 0)
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 6) IF-B))
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 8) IF-A))
       (not= (gn-sir M (+ p 6) IF-B) (gn-sir M (+ p 8) IF-A))
       (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))
       (= (gn-lpos M (gn-sir M (+ p 6) IF-B)) (+ p 9))
       (= (gn-lpos M (gn-sir M (+ p 8) IF-A)) (+ p 44))
       (gn-dot-shape M p f 0))))
(defn- gn-dot-expand [M :vector-i64 j :i64 n :i64 sb :i64] :vector-i64
 (if (= j n) M
  (gn-dot-expand (-> M (gn-emit (enc-ldr 9 0 (* 8 j)))
                      (gn-emit (enc-ldr 10 1 (* 8 j sb)))
                      (gn-emit (enc-madd 2 9 10 2))) (inc j) n sb)))
(defn- gn-dot-patch [M :vector-i64 at :i64 end :i64 cc :i64] :vector-i64
 (gn-put M (+ MM-CODE-BASE at) (enc-bcond cc (- end at))))
(defn- gn-dot-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (gn-dot? M i)) M
  (let [p (dec i) n (gn-sir M (+ p 4) IF-B) sa (gn-sir M (+ p 20) IF-B)
        sb (gn-sir M (+ p 29) IF-B) oa (gn-sir M (+ p 18) IF-B) ob (gn-sir M (+ p 27) IF-B)
        r1 (gn-sreg M 1) r2 (gn-sreg M 2) r3 (gn-sreg M 3) r4 (gn-sreg M 4) r5 (gn-sreg M 5)
        M0 (gn-emit M (enc-cmp-i r4 0)) b0 (vector-at M0 MM-CODE-N)
        M1 (-> M0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i r2 n))) b1 (vector-at M1 MM-CODE-N)
        M2 (-> M1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-i r3 n))) b2 (vector-at M2 MM-CODE-N)
        M3 (-> M2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 n))) b3 (vector-at M3 MM-CODE-N)
        M4 (-> M3 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
                  (gn-emit (enc-sub-i 17 r1 1)) (gn-emit (enc-cmp-r 17 16))) b4 (vector-at M4 MM-CODE-N)
        M5 (-> M4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
                  (gn-emit (enc-ldp 17 3 16 0)) (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))
                  (gn-mov-imm 16 sa) (gn-emit (enc-mul 0 r2 16)) (gn-emit (enc-add-i 0 0 oa))
                  (gn-emit (enc-add-i 1 r3 ob)) (gn-emit (enc-add-i 17 0 (dec n))) (gn-emit (enc-cmp-r 17 3))) b5 (vector-at M5 MM-CODE-N)
        M6 (-> M5 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-add-i 17 1 (* (dec n) sb)))
                  (gn-emit (enc-cmp-r 17 3))) b6 (vector-at M6 MM-CODE-N)
        M7 (-> M6 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (gn-e-addsl 0 4 0 3))
                  (gn-emit (gn-e-addsl 1 4 1 3)) (gn-mov 2 r5) (gn-dot-expand 0 n sb)
                  (gn-emit (enc-sub-i 8 8 n)) (gn-emit (enc-str 8 7 CTX-FUEL))
                  (gn-mov 0 2) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at M7 MM-CODE-N)]
   (-> M7 (gn-dot-patch b0 end (enc-cond-ne)) (gn-dot-patch b1 end (enc-cond-hs))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-lo))
          (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-hs))
          (gn-dot-patch b6 end (enc-cond-hs)) (gn-vclear)))))

;; Guarded exact closed forward-copy leaf; original fallback and fuel remain.
(defn- gn-copy-writer? [M :vector-i64 f :i64] :bool
 (let [p (gn-fnf M f FF-SIR)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0) (< (+ p 8) (vector-at M MM-SIR-N))
       (not (gn-clamp-open M f)) (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
       (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
       (= (gn-fnf M f FF-RTYPE) TY-VEC)
       (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
       (> (gn-sir M (+ p 2) IF-A) 0) (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))
       (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 5) OP-LGET 2 3 0) (gn-dot-at? M (+ p 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
       (gn-dot-at? M (+ p 7) OP-RET 0 0 0) (gn-dot-at? M (+ p 8) OP-END f 0 0))))
(defn- gn-copy-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 28) true
  (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
        exit (gn-sir M (+ p 8) IF-A) n (gn-sir M (+ p 4) IF-B)
        dest (gn-sir M (+ p 11) IF-B) writer (gn-sir M (+ p 17) IF-A)]
   (and (case k
    0 (gn-dot-at? M (+ p 0) OP-FN f 2 2)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 2 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-CONST 1 dest 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 2 2 0)
    13 (gn-dot-at? M (+ p 13) OP-BIN BOP-ADD 1 0)
    14 (gn-dot-at? M (+ p 14) OP-LGET 2 1 0)
    15 (gn-dot-at? M (+ p 15) OP-LGET 3 2 0)
    16 (gn-dot-at? M (+ p 16) OP-RT RT-VECTOR-AT 2 2)
    17 (gn-dot-at? M (+ p 17) OP-CALL writer 0 3)
    18 (gn-dot-at? M (+ p 18) OP-LGET 1 2 0)
    19 (gn-dot-at? M (+ p 19) OP-CONST 2 1 0)
    20 (gn-dot-at? M (+ p 20) OP-BIN BOP-ADD 1 0)
    21 (gn-dot-at? M (+ p 21) OP-LSET 1 0 0)
    22 (gn-dot-at? M (+ p 22) OP-LSET 2 1 0)
    23 (gn-dot-at? M (+ p 23) OP-FUEL 0 0 0)
    24 (gn-dot-at? M (+ p 24) OP-BR head 0 0)
    25 (gn-dot-at? M (+ p 25) OP-LABEL exit 0 0)
    26 (gn-dot-at? M (+ p 26) OP-RET 0 0 0)
    27 (gn-dot-at? M (+ p 27) OP-END f 0 0)
    false) (gn-copy-shape M p f (inc k))))))
(defn- gn-copy? [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 27) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
       (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
       (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-freg) 1)
       (= (gn-g M gn-f-h) 0) (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1)
       (>= (gn-sir M (+ p 4) IF-B) 1) (<= (gn-sir M (+ p 4) IF-B) 2047)
       (>= (gn-sir M (+ p 11) IF-B) 0) (<= (gn-sir M (+ p 11) IF-B) 2047)
       (> (gn-sir M (+ p 2) IF-A) 0) (> (gn-sir M (+ p 6) IF-B) 0) (> (gn-sir M (+ p 8) IF-A) 0)
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 6) IF-B))
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 8) IF-A))
       (not= (gn-sir M (+ p 6) IF-B) (gn-sir M (+ p 8) IF-A))
       (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))
       (= (gn-lpos M (gn-sir M (+ p 6) IF-B)) (+ p 9))
       (= (gn-lpos M (gn-sir M (+ p 8) IF-A)) (+ p 25))
       (gn-copy-writer? M (gn-sir M (+ p 17) IF-A)) (gn-copy-shape M p f 0))))
(defn- gn-copy-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (gn-copy? M i)) M
  (let [p (dec i) n (gn-sir M (+ p 4) IF-B) dest (gn-sir M (+ p 11) IF-B)
        M0 (gn-emit M (enc-cmp-i 1 0)) b0 (vector-at M0 MM-CODE-N)
        M1 (-> M0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 8 (* 2 n)))) b1 (vector-at M1 MM-CODE-N)
        M2 (-> M1 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312))
                  (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at M2 MM-CODE-N)
        M3 (-> M2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 4 16 0))
                  (gn-mov-imm 16 (+ dest (dec n))) (gn-emit (enc-cmp-r 16 4))) b3 (vector-at M3 MM-CODE-N)
        M4 (-> M3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-i 4 n))) b4 (vector-at M4 MM-CODE-N)
        M5 (-> M4 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 2 7 328))
                  (gn-emit (gn-e-addsl 2 2 17 3)) (gn-mov-imm 16 (* 8 dest))
                  (gn-emit (enc-add-r 3 2 16)) (gn-mov-imm 4 n)) loop (vector-at M5 MM-CODE-N)
        M6 (-> M5 (gn-emit (enc-ldr 9 2 0)) (gn-emit (enc-str 9 3 0))
                  (gn-emit (enc-add-i 2 2 8)) (gn-emit (enc-add-i 3 3 8))
                  (gn-emit (enc-subs-i 4 4 1))) branch (vector-at M6 MM-CODE-N)
        M7 (-> M6 (gn-emit (enc-bcond (enc-cond-ne) (- loop branch)))
                  (gn-emit (enc-sub-i 8 8 (* 2 n))) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at M7 MM-CODE-N)]
   (-> M7 (gn-dot-patch b0 end (enc-cond-ne)) (gn-dot-patch b1 end (enc-cond-lo))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
          (gn-dot-patch b4 end (enc-cond-lo))))))

;; one SIR instruction (unreachable ones are dropped until the next LABEL / FN / END)
;; -1 means key0 OR the unchanged entry-root handle; positive slot means
;; every reaching path completed that slot's original checked access. Entry
;; does no speculative validation. Only such a positive witness crosses a tail.
(defn- gn-chain-step [M :vector-i64 i :i64 op :i64 a :i64] :vector-i64
 (if (not= (gn-g M gn-f-vmode) 2) (gn-vstep M op a)
  (cond (or (= op OP-CONST) (= op OP-LGET) (= op OP-FUEL)) M
        (and (= op OP-BIN) (< a BOP-F64-ADD)) M
        (and (= op OP-CMP) (< a CC-F64-EQ)) M
        (and (= op OP-UN) (< a UOP-F64-NEG)) M
        (= op OP-LSET) (gn-vdrop M a)
        (= op OP-CALL) (let [w (gn-call-wrapper M i a (gn-sir M i IF-B) (gn-sir M i IF-C))]
          (if (or (> w 0) (and (= (gn-op M (inc i)) OP-RET) (= (gn-sir M (inc i) IF-A) (gn-sir M i IF-B)))) M (gn-gs M gn-f-vslot 0)))
        (= op OP-RT) (if (or (= a RT-VECTOR-AT) (= a RT-VECTOR-ASSOC-IN-PLACE)) M (gn-gs M gn-f-vslot 0))
        :else (gn-gs M gn-f-vslot 0))))
(defn- gn-ins [M :vector-i64 i :i64 op :i64] :vector-i64
 (gn-ins-quiet (gn-chain-step M i op (gn-sir M i IF-A)) i op))
(defn- gn-ins-quiet [M :vector-i64 i :i64 op :i64] :vector-i64
  (let [a (gn-sir M i IF-A)
        b (gn-sir M i IF-B)
        c (gn-sir M i IF-C)]
    (if (or (and (= (gn-g M 14) 1) (not (or (= op OP-FN) (= op OP-END))))
            (and (= (gn-g M gn-f-dead) 1) (not (or (= op OP-LABEL) (= op OP-FN) (= op OP-END)))))
      M
      (case op
        OP-CONST (gn-def M a gn-k-const b)
        OP-LGET (if (gn-affine-read? M i a) (gn-affine-read M i a) (gn-def M a gn-k-local b))
        OP-LSET (gn-op-lset M a b)
        OP-BIN (gn-op-bin M i a b)
        OP-CMP (gn-op-cmp M i a b)
        OP-UN (gn-op-un M i a b)
        OP-LABEL (gn-op-label M a)
        OP-BR (gn-jump M (gn-thread M a 0 2 8))
        OP-BRZ (gn-op-brz M i a b 0)
        OP-BRNZ (gn-op-brz M i a b 1)
        OP-CALL (gn-op-call M i a b c)
        OP-CALLI (gn-op-calli M i b c)
        OP-FADDR (gn-op-faddr M i a b)
        OP-RT (gn-op-rt M i a b c)
        OP-CAP (gn-op-cap M i a b c)
        OP-STR (gn-op-str M i a b)
        OP-VEC (gn-op-vec M i a b)
        OP-TAB (gn-op-tab M i a b c)
        OP-VECP (gn-op-vecp M i a b c)
        OP-FUEL (gn-copy-entry (gn-dot-entry (gn-op-fuel M) i) i)
        OP-RET (gn-op-ret M a)
        OP-RET2 (gn-op-ret2 M a)       ; R5B
        OP-RES2 (gn-op-res2 M i a)     ; R5B
        OP-TRAP (-> M (gn-emit (enc-brk a)) (gn-gs gn-f-dead 1))
        OP-FN (gn-op-fn M i a b)
        OP-END (-> M (gn-emit (enc-brk 1)) (gn-gs gn-f-dead 0))
        (gn-err M E-GEN-OP op)))))

;; every instruction from i (an instruction may consume the next ones: gn-f-skip)
(defn- gn-loop [M :vector-i64 i :i64] :vector-i64
  (if (and (< i (vector-at M MM-SIR-N)) (= (vector-at M MM-ERR) 0))
    (let [M1 (gn-ins M i (gn-op M i))
          k (gn-g M1 gn-f-skip)]
      (gn-loop (gn-gs M1 gn-f-skip 0) (+ i 1 k)))
    M))

;; the module entry: SIR -> CODE (+ FIX, LABEL, FF-CODE). MM-R0 = code words emitted in total.
(defn- gn-run-open [M :vector-i64 first :i64 count :i64] :vector-i64
  (let [top (vector-at M MM-HEAP-TOP)
        M0 (if (< top MM-HEAP-BASE) (gn-put M MM-HEAP-TOP MM-HEAP-BASE) M)
        M1 (mem-alloc M0 (+ gn-a-lp MM-LABEL-CAP 80))
        M2 (-> (gn-put M1 gn-cell (vector-at M1 MM-R0))
               (gn-gs gn-g-open first) (gn-gs gn-g-open-n count)
               (gn-gs di-used 0) (gn-gs di-sites 0))
        M3 (if (= (vector-at M2 MM-ERR) 0) (gn-loop M2 1) M2)
        n (vector-at M3 MM-CODE-N)]
    (gn-put M3 MM-R0 (- n 1))))

;; Unity compilation has no link-time replacement of function bodies.
(defn- gn-run [M :vector-i64] :vector-i64 (gn-run-open M 0 0))

;; seed/42-layout.kotoba -- layout: literal pool, fixups, export table (prefix ly-). Owner: 42-layout.
;; Design section 2.1 row 42; contracts: seed/MEMORY-MAP (CODE FIX LABEL LIT LITB EXP FN), seed/SIR (:fixups :pool).
;;
;; ly-run [M] -> M. Runs after 41-a64gen. On success: MM-R0 = MM-CODE-BYTES = total code length in bytes (code
;; words + padding + literal pool). On failure: MM-ERR set (rule L10) and M returned early.
;;
;; Indexing (CONTRACT-REQUESTS 2026-10-02 42-layout): CODE word index 0 is the NULL record (fills start at 1), so the
;; first instruction is word 1 and the BYTE offset of word index i from the code start is (i-1)*4. Branch
;; displacements are index differences, so they do not depend on this choice; entry offsets and the pool do.
;; ly-first is the only place that knows it.
;;
;; Steps: (1) pool: MM-POOL-OFF = align8((MM-CODE-N-1)*4); every LIT gets LF-POOL, 8-byte aligned, in LIT order, no
;; dedup, no terminator; MM-CODE-BYTES = end of the last literal (= code bytes when there is no literal).
;; (2) fixups in FIX order: FX-B26 / FX-BL26 (imm26 bits 25:0), FX-BC19 / FX-CB19 (imm19 bits 23:5), FX-LIT32
;; (movz at XF-AT, movk at XF-AT+1, imm16 bits 20:5 each; lo16 and hi16 of LF-POOL). Only the immediate bits are
;; replaced, so the encoder's opcode, condition and register bits are kept. (3) EXP: one record per FN with
;; FF-EXPORT = 1, in FN-table (source) order.

(defn- ly-first [] :i64 1)

;; R5A: the cell holding this module's byte offset in a linked image (60-proj sets it after mem reset; 0 = not linked)
(defn- ly-base-slot [] :i64 (+ MM-STAT-BASE 43))

;; local error codes still missing from seed/HEADS (see CONTRACT-REQUESTS): 4202 internal fixup, 4203 undefined
;; label / function target, 4204 export table full, 4205 pool or code too large for a 32-bit offset.
(defn- ly-e-fixup [] :i64 4202)
(defn- ly-e-target [] :i64 4203)
(defn- ly-e-exports [] :i64 4204)
(defn- ly-e-size [] :i64 4205)

;; first error wins (rule L10): records code, position (-1) and number n.
(defn- ly-err [M :vector-i64 code :i64 n :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [M1 (vector-assoc! M MM-ERR code)
          M2 (vector-assoc! M1 MM-ERR-POS -1)]
      (vector-assoc! M2 MM-ERR-N n))
    M))

(defn- ly-failed [M :vector-i64] :i64
  (if (= (vector-at M MM-ERR) 0) 0 1))

;; ---- pure helpers ---------------------------------------------------------------------------------------

(defn- ly-align8 [x :i64] :i64
  (bit-and (+ x 7) -8))

;; byte offset of CODE word index i from the code start
(defn- ly-byte-off [i :i64] :i64
  (* (- i (ly-first)) 4))

;; imm26 patch (b / bl): w keeps bits 31:26, d = displacement in words. -1 when d is outside [-2^25, 2^25).
(defn- ly-patch26 [w :i64 d :i64] :i64
  (if (>= d -33554432)
    (if (< d 33554432)
      (bit-or (bit-and w 4227858432) (bit-and d 67108863))
      -1)
    -1))

;; imm19 patch (b.cond / cbz / cbnz): imm19 in bits 23:5, d in [-2^18, 2^18). -1 when out of range.
(defn- ly-patch19 [w :i64 d :i64] :i64
  (if (>= d -262144)
    (if (< d 262144)
      (bit-or (bit-and w 4278190111) (i64-shift-left (bit-and d 524287) 5))
      -1)
    -1))

;; imm16 patch (movz / movk): imm16 in bits 20:5 (hw bits are left alone).
(defn- ly-patch16 [w :i64 v :i64] :i64
  (bit-or (bit-and w 4292870175) (i64-shift-left (bit-and v 65535) 5)))

;; keeps a read index inside a table: x if lo <= x <= hi, else lo (the status function then reports the error)
(defn- ly-clamp [x :i64 lo :i64 hi :i64] :i64
  (if (< x lo) lo (if (> x hi) lo x)))

;; movz (sf either) = 0x52800000 / movk = 0x72800000 under the mask 0x7F800000
(defn- ly-is-movz [w :i64] :bool
  (= (bit-and w 2139095040) 1384120320))
(defn- ly-is-movk [w :i64] :bool
  (= (bit-and w 2139095040) 1920991232))

;; ---- table readers ----------------------------------------------------------------------------------------

(defn- ly-fn-field [M :vector-i64 i :i64 f :i64] :i64
  (vector-at M (+ (+ MM-FN-BASE (* i MM-FN-W)) f)))
(defn- ly-lit-field [M :vector-i64 i :i64 f :i64] :i64
  (vector-at M (+ (+ MM-LIT-BASE (* i MM-LIT-W)) f)))

;; ---- (1) literal pool ---------------------------------------------------------------------------------------

(defn- ly-set-lit-pool [M :vector-i64 i :i64 pos :i64] :vector-i64
  (vector-assoc! M (+ (+ MM-LIT-BASE (* i MM-LIT-W)) LF-POOL) pos))

;; assign LF-POOL to literal i.. ; cur = next free pool byte (already aligned)
(defn- ly-pool-loop [M :vector-i64 i :i64 cur :i64] :vector-i64
  (if (>= i (vector-at M MM-LIT-N))
    M
    (let [len (ly-lit-field M i LF-LEN)
          M1 (ly-set-lit-pool M i cur)]
      (ly-pool-loop M1 (+ i 1) (ly-align8 (+ cur len))))))

(defn- ly-pool-total [M :vector-i64 cbytes :i64] :i64
  (let [lastl (vector-at M MM-LIT-N)]
    (if (= lastl 1)
      cbytes
      (+ (ly-lit-field M (- lastl 1) LF-POOL) (ly-lit-field M (- lastl 1) LF-LEN)))))

(defn- ly-pool-end [M :vector-i64 total :i64] :vector-i64
  (if (>= total 4294967296)
    (ly-err M (ly-e-size) total)
    (vector-assoc! M MM-CODE-BYTES total)))

(defn- ly-pool [M :vector-i64] :vector-i64
  (let [cbytes (ly-byte-off (vector-at M MM-CODE-N))
        poff (ly-align8 cbytes)
        M1 (vector-assoc! M MM-POOL-OFF poff)
        M2 (ly-pool-loop M1 1 poff)
        total (ly-pool-total M2 cbytes)]
    (ly-pool-end M2 total)))

;; ---- (2) fixups -----------------------------------------------------------------------------------------------


;; a branch whose target is a CODE word index t (>= 1, <= MM-CODE-N); width 26 or 19
;; Linearity idiom (measured, see CONTRACT-REQUESTS): when a function branches into different M writers, every read
;; it needs is a direct (vector-at M ..) bound in its own let (or the if test); a reader FUNCTION call on M bound before
;; the branch makes stage-0 refuse the writers ("M is used more than once on some path").
;; 0 = ok, else the error code, for a branch to code word index t from word at with displacement d and width wide
(defn- ly-branch-status [at :i64 t :i64 ncode :i64 nw :i64] :i64
  (if (< t (ly-first)) (ly-e-target)
    (if (< at (ly-first)) (ly-e-target)
      (if (< nw 0) E-LAYOUT-RANGE
        (if (> t ncode) (ly-e-target) 0)))))

;; number reported with the error: the displacement for a range error, else the target index t
(defn- ly-branch-n [st :i64 t :i64 at :i64] :i64
  (if (= st E-LAYOUT-RANGE) (- t at) t))

(defn- ly-branch-word [w :i64 at :i64 t :i64 wide :i64] :i64
  (if (= wide 26) (ly-patch26 w (- t at)) (ly-patch19 w (- t at))))

(defn- ly-branch [M :vector-i64 at :i64 t :i64 wide :i64] :vector-i64
  (let [w (vector-at M (+ MM-CODE-BASE (ly-clamp at 1 (- MM-CODE-CAP 1))))
        ncode (vector-at M MM-CODE-N)
        nw (ly-branch-word w at t wide)
        st (ly-branch-status at t ncode nw)]
    (if (= st 0)
      (vector-assoc! M (+ MM-CODE-BASE at) nw)
      (ly-err M st (ly-branch-n st t at)))))

;; 1 when w0 is a movz and w1 a movk
(defn- ly-words-ok [w0 :i64 w1 :i64] :i64
  (if (ly-is-movz w0) (if (ly-is-movk w1) 1 0) 0))

;; 0 = ok, else the error code: lit in 1..nlit-1, at in first..ncode-2, wok = ly-words-ok of the two words
;; (at most 5 parameters: MEMORY-MAP rule L7, so the seed admits its own source)
(defn- ly-lit32-status [at :i64 lit :i64 nlit :i64 ncode :i64 wok :i64] :i64
  (if (< lit 1) (ly-e-fixup)
    (if (>= lit nlit) (ly-e-fixup)
      (if (< at (ly-first)) (ly-e-fixup)
        (if (>= (+ at 1) ncode) (ly-e-fixup)
          (if (= wok 1) 0 (ly-e-fixup)))))))

(defn- ly-lit32 [M :vector-i64 at0 :i64 lit0 :i64] :vector-i64
  (let [at (ly-clamp at0 1 (- MM-CODE-CAP 2))
        lit (ly-clamp lit0 1 (- MM-LIT-CAP 1))
        nlit (vector-at M MM-LIT-N)
        ncode (vector-at M MM-CODE-N)
        w0 (vector-at M (+ MM-CODE-BASE at))
        w1 (vector-at M (+ (+ MM-CODE-BASE at) 1))
        ;; R5A (agent R5A, delimited): + the module's base in the linked image (M[MM-STAT-BASE+43], 0 for a single module):
        ;; the movz/movk value is relative to the start of the whole image (60-proj links module blobs at 8-aligned bases)
        pos (+ (vector-at M (+ (+ MM-LIT-BASE (* lit MM-LIT-W)) LF-POOL)) (vector-at M (ly-base-slot)))
        st (ly-lit32-status at0 lit0 nlit ncode (ly-words-ok w0 w1))]
    (if (= st 0)
      (let [M1 (vector-assoc! M (+ MM-CODE-BASE at) (ly-patch16 w0 pos))]
        (vector-assoc! M1 (+ (+ MM-CODE-BASE at) 1) (ly-patch16 w1 (u64-shift-right pos 16))))
      (ly-err M st at0))))

(defn- ly-label-ok [tgt :i64 lab :i64] :i64
  (if (< tgt 1) 0 (if (>= tgt MM-LABEL-CAP) 0 lab)))

(defn- ly-fn-ok [tgt :i64 fcode :i64 nfn :i64] :i64
  (if (< tgt 1) 0 (if (>= tgt nfn) 0 fcode)))

;; code word index of the target of a branch-kind fixup (0 = undefined), -1 for an unknown kind. lab = the LABEL cell of tgt,
;; fcode = FF-CODE of FN tgt, nfn = MM-FN-N, both read (clamped) by the caller.
(defn- ly-target [kind :i64 tgt :i64 lab :i64 fcode :i64 nfn :i64] :i64
  (if (= kind FX-B26) (ly-label-ok tgt lab)
    (if (= kind FX-BC19) (ly-label-ok tgt lab)
      (if (= kind FX-CB19) (ly-label-ok tgt lab)
        (if (= kind FX-BL26) (ly-fn-ok tgt fcode nfn)
          ;; R4 (agent R4, delimited): adr to the entry of FN tgt, patched like an imm19 (immhi = word displacement)
          (if (= kind FX-ADR19) (ly-fn-ok tgt fcode nfn) -1))))))

(defn- ly-width [kind :i64] :i64
  (if (= kind FX-B26) 26 (if (= kind FX-BL26) 26 19)))

(defn- ly-fix-one [M :vector-i64 i :i64] :vector-i64
  (let [fb (+ MM-FIX-BASE (* i MM-FIX-W))
        at (vector-at M (+ fb XF-AT))
        kind (vector-at M (+ fb XF-KIND))
        tgt (vector-at M (+ fb XF-TARGET))
        lab (vector-at M (+ MM-LABEL-BASE (ly-clamp tgt 1 (- MM-LABEL-CAP 1))))
        nfn (vector-at M MM-FN-N)
        fcode (vector-at M (+ (+ MM-FN-BASE (* (ly-clamp tgt 1 (- MM-FN-CAP 1)) MM-FN-W)) FF-CODE))
        t0 (ly-target kind tgt lab fcode nfn)
        aux (vector-at M (+ fb XF-AUX))
        t (if (= aux 0) t0
            (if (and (= aux 1) (= kind FX-BL26) (> t0 0)
                     (< (inc t0) (vector-at M MM-CODE-N))
                     (> at 0) (< at (vector-at M MM-CODE-N))
                     (= (bit-and (vector-at M (+ MM-CODE-BASE at)) 0xfc000000) 0x14000000)
                     (= (vector-at M (+ MM-CODE-BASE t0)) 0xd2800005))
                (inc t0) -1))]
    (if (= kind FX-LIT32)
      (ly-lit32 M at tgt)
      (if (< t 0)
        (ly-err M (ly-e-fixup) kind)
        (ly-branch M at t (ly-width kind))))))

(defn- ly-fix-loop [M :vector-i64 i :i64] :vector-i64
  (if (>= i (vector-at M MM-FIX-N))
    M
    (let [M1 (ly-fix-one M i)]
      (if (= (ly-failed M1) 0)
        (ly-fix-loop M1 (+ i 1))
        M1))))

;; ---- (3) export table -------------------------------------------------------------------------------------------

(defn- ly-exp-put [M :vector-i64 f :i64] :vector-i64
  (let [fb (+ MM-FN-BASE (* f MM-FN-W))
        k (vector-at M MM-EXP-N)
        off (ly-byte-off (vector-at M (+ fb FF-CODE)))
        ar (vector-at M (+ fb FF-NPARAMS))]
    (if (>= k MM-EXP-CAP)
      (ly-err M (ly-e-exports) k)
      (let [b (+ MM-EXP-BASE (* k MM-EXP-W))
            M1 (vector-assoc! M (+ b EF-FN) f)
            M2 (vector-assoc! M1 (+ b EF-OFFSET) off)
            M3 (vector-assoc! M2 (+ b EF-ARITY) ar)
            M4 (vector-assoc! M3 (+ b EF-SPARE) 0)]
        (vector-assoc! M4 MM-EXP-N (+ k 1))))))

;; export record for FN f, or an error when it has no code
(defn- ly-exp-one [M :vector-i64 f :i64 fc :i64] :vector-i64
  (if (< fc (ly-first)) (ly-err M (ly-e-target) f) (ly-exp-put M f)))

;; one export record for FN f when it is exported, then the rest
(defn- ly-exp-loop [M :vector-i64 f :i64] :vector-i64
  (let [fb (+ MM-FN-BASE (* f MM-FN-W))
        nfn (vector-at M MM-FN-N)
        isexp (vector-at M (+ fb FF-EXPORT))
        fc (vector-at M (+ fb FF-CODE))]
    (if (>= f nfn)
      M
      (if (= isexp 1)
        (let [M1 (ly-exp-one M f fc)]
          (if (= (vector-at M1 MM-ERR) 0)
            (ly-exp-loop M1 (+ f 1))
            M1))
        (ly-exp-loop M (+ f 1))))))

;; ---- entry ------------------------------------------------------------------------------------------------------------

(defn- ly-finish [M :vector-i64] :vector-i64
  (let [cb (vector-at M MM-CODE-BYTES)
        nf (- (vector-at M MM-FIX-N) 1)
        nl (- (vector-at M MM-LIT-N) 1)
        ne (- (vector-at M MM-EXP-N) 1)
        M1 (vector-assoc! M MM-R0 cb)
        M2 (vector-assoc! M1 (+ MM-STAT-BASE 40) nf)
        M3 (vector-assoc! M2 (+ MM-STAT-BASE 41) nl)]
    (vector-assoc! M3 (+ MM-STAT-BASE 42) ne)))

(defn- ly-run3 [M :vector-i64] :vector-i64
  (let [M1 (ly-exp-loop M 1)]
    (if (= (ly-failed M1) 0) (ly-finish M1) M1)))

(defn- ly-run2 [M :vector-i64] :vector-i64
  (let [M1 (ly-fix-loop M 1)]
    (if (= (ly-failed M1) 0) (ly-run3 M1) M1)))

(defn- ly-run [M :vector-i64] :vector-i64
  (let [M1 (ly-pool M)]
    (if (= (ly-failed M1) 0) (ly-run2 M1) M1)))

;; seed/50-out.kotoba -- the kseed/v1 container: writer, parser, extract (prefix out-). Owner: 50-out.
;; Contract: seed/SIR :kseed, seed/MEMORY-MAP (OUT CODE LITB LIT EXP FN SYM), design 3.1.
;;
;; Container (bytes): "KSEED1 <code-length> <n-exports>\n", then per export (EXP order) "<name> <offset> <arity>\n",
;; then "\n", then exactly <code-length> raw code bytes: the CODE words little-endian, zero padding up to MM-POOL-OFF,
;; then the literal pool (LITB bytes at each LF-POOL, zero padding between literals). <offset> = EF-OFFSET, the
;; byte offset of the entry from the code start. extract-native writes the code slice and reports that same offset,
;; so "extract offset = header offset" holds by construction (and is tested).
;;
;; OUT is one byte per word, MM-OUT-N = next free OUT index (starts at 1, rule "index 0 is null"), so the container
;; bytes are M[MM-OUT-BASE+1 .. MM-OUT-BASE+MM-OUT-N-1].
;;
;; API (all private):
;;   out-build M S      -> M    builds the container into OUT from CODE/LIT/LITB/EXP/FN/SYM (names are spans of the
;;                              source string S). Re-entrant: it restarts OUT. MM-R0 = container bytes. On failure MM-ERR.
;;   out-parse M base len symS a b -> M   parses a container held as one byte per word at M[base ..], looks the
;;                              symbol (bytes a..b-1 of symS) up. MM-R0 = offset, MM-R1 = index of the first code
;;                              byte from base, MM-R2 = code length, MM-R3 = arity. Failure: MM-ERR (not found 5002,
;;                              malformed E-OUT-FORMAT).
;;   out-write M S path -> M    out-build + write the container to path (file I/O: see the end of this file).
;;   out-extract M kseed symbol path -> M   read a container file, write its code slice to path. MM-R0 = offset,
;;                              MM-R2 = code length, MM-R3 = arity.
;;
;; Stage-0 idioms used (measured, see CONTRACT-REQUESTS): no and/or/not, no `if` as a let binding value, a function that
;; branches into different M writers reads M with direct (vector-at M ..) only, forward references are not allowed.

(defn- out-e-nosym [] :i64 5002)
(defn- out-first [] :i64 1)
;; M[MM-STAT-BASE + 44 + 1]: OUT index of the first code byte (50-out's own statistics slot); 44 + 0 = total bytes
(defn- out-cs-slot [] :i64 (+ MM-STAT-BASE 45))

;; the one leaf that does a direct vector-assoc! (stage-0 refuses a direct assoc! after a reader-function call in
;; the same scope when the handle came from a call; writers below go through this leaf)
(defn- out-w [M :vector-i64 i :i64 x :i64] :vector-i64
  (vector-assoc! M i x))

(defn- out-err [M :vector-i64 code :i64 n :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [M1 (out-w M MM-ERR code)
          M2 (out-w M1 MM-ERR-POS -1)]
      (out-w M2 MM-ERR-N n))
    M))

(defn- out-ok [M :vector-i64] :i64
  (if (= (vector-at M MM-ERR) 0) 1 0))

;; ---- byte sink ----------------------------------------------------------------------------------------------------

;; append one byte (0..255); a no-op once an error is recorded
(defn- out-put [M :vector-i64 b :i64] :vector-i64
  (let [n (vector-at M MM-OUT-N)
        e (vector-at M MM-ERR)]
    (if (> e 0)
      M
      (if (>= n MM-OUT-CAP)
        (out-err M E-OUT-FULL n)
        (let [M1 (out-w M (+ MM-OUT-BASE n) b)]
          (out-w M1 MM-OUT-N (+ n 1)))))))

;; little-endian 32-bit word
(defn- out-put-word [M :vector-i64 w :i64] :vector-i64
  (let [M1 (out-put M (bit-and w 255))
        M2 (out-put M1 (bit-and (u64-shift-right w 8) 255))
        M3 (out-put M2 (bit-and (u64-shift-right w 16) 255))]
    (out-put M3 (bit-and (u64-shift-right w 24) 255))))

;; decimal digits of n >= 0 (a negative n is an internal error)
(defn- out-put-dec [M :vector-i64 n :i64] :vector-i64
  (if (< n 0)
    (out-err M E-OUT-FORMAT n)
    (if (< n 10)
      (out-put M (+ 48 n))
      (let [q (quot n 10)
            M1 (out-put-dec M q)]
        (out-put M1 (+ 48 (- n (* q 10))))))))

;; bytes a..b-1 of the string S
(defn- out-put-span [M :vector-i64 S :string a :i64 b :i64] :vector-i64
  (if (>= a b)
    M
    (let [M1 (out-put M (string-code-point-at S a))]
      (out-put-span M1 S (+ a 1) b))))

;; LITB bytes a..b-1
(defn- out-put-litb [M :vector-i64 a :i64 b :i64] :vector-i64
  (if (>= a b)
    M
    (let [c (vector-at M (+ MM-LITB-BASE a))
          M1 (out-put M c)]
      (out-put-litb M1 (+ a 1) b))))

;; bytes written since the first code byte
(defn- out-rel [M :vector-i64] :i64
  (- (vector-at M MM-OUT-N) (vector-at M (out-cs-slot))))

;; zero bytes until out-rel = target
(defn- out-pad-to [M :vector-i64 target :i64] :vector-i64
  (let [rel (out-rel M)
        e (vector-at M MM-ERR)]
    (if (> e 0)
      M
      (if (>= rel target)
        M
        (let [M1 (out-put M 0)]
          (out-pad-to M1 target))))))

;; ---- builder ------------------------------------------------------------------------------------------------------------

;; "KSEED1 "
(defn- out-put-magic [M :vector-i64] :vector-i64
  (let [M1 (out-put M 75)
        M2 (out-put M1 83)
        M3 (out-put M2 69)
        M4 (out-put M3 69)
        M5 (out-put M4 68)
        M6 (out-put M5 49)]
    (out-put M6 32)))

;; "<name> <offset> <arity>\n" for EXP record k
(defn- out-exp-line [M :vector-i64 S :string k :i64 base :i64] :vector-i64
  (let [eb (+ MM-EXP-BASE (* k MM-EXP-W))
        f (vector-at M (+ eb EF-FN))
        off (+ base (vector-at M (+ eb EF-OFFSET)))
        ar (vector-at M (+ eb EF-ARITY))
        sym (vector-at M (+ (+ MM-FN-BASE (* f MM-FN-W)) FF-SYM))
        sb (+ MM-SYM-BASE (* sym MM-SYM-W))
        a (vector-at M (+ sb SF-START))
        b (vector-at M (+ sb SF-END))
        M1 (out-put-span M S a b)
        M2 (out-put M1 32)
        M3 (out-put-dec M2 off)
        M4 (out-put M3 32)
        M5 (out-put-dec M4 ar)]
    (out-put M5 10)))

(defn- out-exp-loop [M :vector-i64 S :string k :i64 base :i64] :vector-i64
  (let [n (vector-at M MM-EXP-N)]
    (if (>= k n)
      M
      (let [M1 (out-exp-line M S k base)]
        (out-exp-loop M1 S (+ k 1) base)))))

;; header: magic, code length, export count, export lines, blank line. R5A: clen = the whole code length and base = the
;; byte offset of this module's code in it (a linked image, 60-proj); a single module passes MM-CODE-BYTES and 0.
(defn- out-header [M :vector-i64 S :string clen :i64 base :i64] :vector-i64
  (let [ne (- (vector-at M MM-EXP-N) 1)
        M1 (out-put-magic M)
        M2 (out-put-dec M1 clen)
        M3 (out-put M2 32)
        M4 (out-put-dec M3 ne)
        M5 (out-put M4 10)
        M6 (out-exp-loop M5 S 1 base)]
    (out-put M6 10)))

;; CODE word i must be 0 .. 2^32-1
(defn- out-code-word [M :vector-i64 w :i64] :vector-i64
  (if (< w 0)
    (out-err M E-OUT-FORMAT w)
    (if (>= w 4294967296)
      (out-err M E-OUT-FORMAT w)
      (out-put-word M w))))

(defn- out-code-loop [M :vector-i64 i :i64] :vector-i64
  (let [n (vector-at M MM-CODE-N)
        w (vector-at M (+ MM-CODE-BASE i))]
    (if (>= i n)
      M
      (let [M1 (out-code-word M w)]
        (out-code-loop M1 (+ i 1))))))

;; literal i at LF-POOL
(defn- out-lit-one [M :vector-i64 i :i64] :vector-i64
  (let [lb (+ MM-LIT-BASE (* i MM-LIT-W))
        pos (vector-at M (+ lb LF-POOL))
        b (vector-at M (+ lb LF-B))
        len (vector-at M (+ lb LF-LEN))
        M1 (out-pad-to M pos)]
    (out-put-litb M1 b (+ b len))))

(defn- out-lit-loop [M :vector-i64 i :i64] :vector-i64
  (let [n (vector-at M MM-LIT-N)]
    (if (>= i n)
      M
      (let [M1 (out-lit-one M i)]
        (out-lit-loop M1 (+ i 1))))))

;; pool: padding up to MM-POOL-OFF, then the literals; only when there is a literal
(defn- out-pool [M :vector-i64] :vector-i64
  (let [nl (vector-at M MM-LIT-N)
        poff (vector-at M MM-POOL-OFF)]
    (if (<= nl 1)
      M
      (let [M1 (out-pad-to M poff)]
        (out-lit-loop M1 1)))))

;; the container must end exactly at MM-CODE-BYTES
(defn- out-verify [M :vector-i64] :vector-i64
  (let [rel (out-rel M)
        want (vector-at M MM-CODE-BYTES)
        tot (- (vector-at M MM-OUT-N) 1)]
    (if (= rel want)
      (let [M1 (out-w M MM-R0 tot)]
        (out-w M1 (+ MM-STAT-BASE 44) tot))
      (out-err M E-OUT-FORMAT rel))))

(defn- out-set-cs [M :vector-i64] :vector-i64
  (let [n (vector-at M MM-OUT-N)]
    (out-w M (out-cs-slot) n)))

(defn- out-build4 [M :vector-i64] :vector-i64
  (let [M1 (out-pool M)]
    (if (= (out-ok M1) 1) (out-verify M1) M1)))

(defn- out-build3 [M :vector-i64] :vector-i64
  (let [M1 (out-code-loop (out-set-cs M) 1)]
    (if (= (out-ok M1) 1) (out-build4 M1) M1)))

(defn- out-build2 [M :vector-i64 S :string] :vector-i64
  (let [M1 (out-header M S (vector-at M MM-CODE-BYTES) 0)]
    (if (= (out-ok M1) 1) (out-build3 M1) M1)))

(defn- out-build [M :vector-i64 S :string] :vector-i64
  (let [M1 (out-w M MM-OUT-N 1)]
    (out-build2 M1 S)))

;; ---- R5A (agent R5A): module blobs and the linked image (60-proj) ------------------------------------------------------
;; out-blob M -> M : this module's code words + pool alone into OUT (no header), the bytes 1 .. MM-OUT-N-1; MM-R0 = the length
;; (= MM-CODE-BYTES). 60-proj copies them into its image buffer.
(defn- out-blob [M :vector-i64] :vector-i64
  (let [M1 (out-w M MM-OUT-N 1)]
    (out-build3 M1)))

;; LINK (r6h): image bytes [i, n) of a PACKED image (8 bytes per word, little-endian in the word) that starts at word w0 of L,
;; appended to OUT (was one byte per item of L)
(defn- out-put-vec [M :vector-i64 L :vector-i64 w0 :i64 i :i64 n :i64] :vector-i64
  (if (>= i n)
    M
    (out-put-vec (out-put M (bit-and (u64-shift-right (vector-at L (+ w0 (u64-shift-right i 3))) (* 8 (bit-and i 7))) 255)) L w0 (+ i 1) n)))

;; out-image M S L a n -> M : the container of a linked image: the header with this (root) module's exports at
;; EF-OFFSET + base (base = the module's image offset, M[MM-STAT-BASE+43], 42-layout's ly-base-slot) and the code length n,
;; then the n image bytes of the packed image at word a of L (60-proj pj-img-base). MM-R0 = container bytes.
(defn- out-image [M :vector-i64 S :string L :vector-i64 a :i64 n :i64] :vector-i64
  (let [M1 (out-header (out-w M MM-OUT-N 1) S n (vector-at M (+ MM-STAT-BASE 43)))
        M2 (out-put-vec (out-set-cs M1) L a 0 n)]
    (if (= (out-ok M2) 1) (out-w M2 MM-R0 (- (vector-at M2 MM-OUT-N) 1)) M2)))

;; ---- parser (readers over a byte-per-word buffer at M[base ..]; base and len live in two statistics cells) ---------------

(defn- out-bslot [] :i64 (+ MM-STAT-BASE 46))
(defn- out-lslot [] :i64 (+ MM-STAT-BASE 47))
(defn- out-csslot [] :i64 (+ MM-STAT-BASE 48))
(defn- out-clslot [] :i64 (+ MM-STAT-BASE 49))
(defn- out-neslot [] :i64 (+ MM-STAT-BASE 50))

(defn- out-byte [M :vector-i64 i :i64] :i64
  (vector-at M (+ (vector-at M (out-bslot)) i)))
(defn- out-len [M :vector-i64] :i64
  (vector-at M (out-lslot)))

;; index of the first byte equal to ch at or after i, or -1
(defn- out-find [M :vector-i64 i :i64 ch :i64] :i64
  (if (>= i (out-len M))
    -1
    (if (= (out-byte M i) ch)
      i
      (out-find M (+ i 1) ch))))

;; index after the run of decimal digits starting at i (= i when there is none)
(defn- out-dec-end [M :vector-i64 i :i64] :i64
  (if (>= i (out-len M))
    i
    (let [c (out-byte M i)]
      (if (< c 48)
        i
        (if (> c 57) i (out-dec-end M (+ i 1)))))))

(defn- out-dec-val [M :vector-i64 i :i64 e :i64 acc :i64] :i64
  (if (>= i e)
    acc
    (out-dec-val M (+ i 1) e (+ (* acc 10) (- (out-byte M i) 48)))))

;; "KSEED1 " at the start: 1/0
(defn- out-magic [M :vector-i64] :i64
  (if (< (out-len M) 8) 0
    (if (= (out-byte M 0) 75)
      (if (= (out-byte M 1) 83)
        (if (= (out-byte M 2) 69)
          (if (= (out-byte M 3) 69)
            (if (= (out-byte M 4) 68)
              (if (= (out-byte M 5) 49)
                (if (= (out-byte M 6) 32) 1 0)
                0)
              0)
            0)
          0)
        0)
      0)))

;; position after the code length (followed by a space); -1 when malformed
(defn- out-e1 [M :vector-i64] :i64
  (let [e (out-dec-end M 7)]
    (if (<= e 7) -1
      (if (>= e (out-len M)) -1
        (if (= (out-byte M e) 32) e -1)))))

;; position after the export count (followed by a newline); -1 when malformed
(defn- out-e2 [M :vector-i64 e1 :i64] :i64
  (if (< e1 0) -1
    (let [s (+ e1 1)
          e (out-dec-end M s)]
      (if (<= e s) -1
        (if (>= e (out-len M)) -1
          (if (= (out-byte M e) 10) e -1))))))

;; position of the first code byte after k lines starting at p and the blank line; -1 when malformed
(defn- out-skip [M :vector-i64 p :i64 k :i64] :i64
  (if (<= k 0)
    (if (>= p (out-len M)) -1
      (if (= (out-byte M p) 10) (+ p 1) -1))
    (let [q (out-find M p 10)]
      (if (< q 0) -1 (out-skip M (+ q 1) (- k 1))))))

;; do n bytes at p equal the bytes k.. of sym? 1/0
(defn- out-name-eq [M :vector-i64 p :i64 sym :string k :i64 n :i64] :i64
  (if (<= n 0)
    1
    (if (= (out-byte M p) (string-code-point-at sym k))
      (out-name-eq M (+ p 1) sym (+ k 1) (- n 1))
      0)))

;; the export line at p names sym (the name ends at the first space)? 1/0
(defn- out-line-match [M :vector-i64 p :i64 sym :string] :i64
  (let [sp (out-find M p 32)
        n (string-length sym)]
    (if (< sp 0) 0
      (if (= (- sp p) n) (out-name-eq M p sym 0 n) 0))))

;; start of the matching export line among the k lines from p, -1 when absent
(defn- out-lookup [M :vector-i64 p :i64 k :i64 sym :string] :i64
  (if (<= k 0)
    -1
    (if (= (out-line-match M p sym) 1)
      p
      (let [q (out-find M p 10)]
        (if (< q 0) -1 (out-lookup M (+ q 1) (- k 1) sym))))))

;; offset * 2^32 + arity of the export line at p (name, space, offset, space, arity); -1 when malformed
(defn- out-line-vals [M :vector-i64 p :i64] :i64
  (let [sp (out-find M p 32)
        s1 (+ sp 1)
        e1 (out-dec-end M s1)
        s2 (+ e1 1)
        e2 (out-dec-end M s2)]
    (if (< sp 0) -1
      (if (<= e1 s1) -1
        (if (<= e2 s2) -1
          (+ (* (out-dec-val M s1 e1 0) 4294967296) (out-dec-val M s2 e2 0)))))))

(defn- out-pg [M :vector-i64 vals :i64] :vector-i64
  (let [off (quot vals 4294967296)
        ar (- vals (* off 4294967296))
        cs (vector-at M (out-csslot))
        cl (vector-at M (out-clslot))
        M1 (out-w M MM-R0 off)
        M2 (out-w M1 MM-R1 cs)
        M3 (out-w M2 MM-R2 cl)]
    (out-w M3 MM-R3 ar)))

;; results: MM-R0 offset, MM-R1 index of the first code byte from base, MM-R2 code length, MM-R3 arity
(defn- out-pf [M :vector-i64 line :i64] :vector-i64
  (let [vals (out-line-vals M line)]
    (if (< vals 0)
      (out-err M E-OUT-FORMAT line)
      (out-pg M vals))))

(defn- out-pe [M :vector-i64 e2 :i64 sym :string] :vector-i64
  (let [line (out-lookup M (+ e2 1) (vector-at M (out-neslot)) sym)]
    (if (< line 0)
      (out-err M (out-e-nosym) 0)
      (out-pf M line))))

(defn- out-pd2 [M :vector-i64 cs :i64 clen :i64 nexp :i64] :vector-i64
  (let [M1 (out-w M (out-csslot) cs)
        M2 (out-w M1 (out-clslot) clen)]
    (out-w M2 (out-neslot) nexp)))

(defn- out-pd [M :vector-i64 e1 :i64 e2 :i64 sym :string] :vector-i64
  (let [nexp (out-dec-val M (+ e1 1) e2 0)
        clen (out-dec-val M 7 e1 0)
        cs (out-skip M (+ e2 1) nexp)
        left (- (out-len M) cs)]
    (if (< cs 0)
      (out-err M E-OUT-FORMAT 3)
      (if (= left clen)
        (out-pe (out-pd2 M cs clen nexp) e2 sym)
        (out-err M E-OUT-FORMAT left)))))

(defn- out-pc [M :vector-i64 e1 :i64 sym :string] :vector-i64
  (let [e2 (out-e2 M e1)]
    (if (< e2 0)
      (out-err M E-OUT-FORMAT 2)
      (out-pd M e1 e2 sym))))

(defn- out-pb [M :vector-i64 sym :string] :vector-i64
  (let [e1 (out-e1 M)]
    (if (< e1 0)
      (out-err M E-OUT-FORMAT 1)
      (out-pc M e1 sym))))

(defn- out-pa [M :vector-i64 sym :string] :vector-i64
  (if (= (out-magic M) 1)
    (out-pb M sym)
    (out-err M E-OUT-FORMAT 0)))

;; parse the container at M[base .. base+len) and look up the export named sym
(defn- out-parse [M :vector-i64 base :i64 len :i64 sym :string] :vector-i64
  (let [M1 (out-w M (out-bslot) base)
        M2 (out-w M1 (out-lslot) len)]
    (out-pa M2 sym)))

;; ---- a container read from a file (extract-native) ------------------------------------------------------------------
;; V = the file as one item per byte (io-read-bytes). Seed-0 has no vector-count, so the container's length is taken
;; from its own header: the header ends at the first "\n\n" (export names hold no newline) and the code length follows
;; "KSEED1 ". A file that is not a container may run vector-at past its end, which traps (status != 0) instead of E5003.

;; index after the first two consecutive newlines at or after i
(defn- out-v-hdr [V :vector-i64 i :i64] :i64
  (if (= (vector-at V i) 10)
    (if (= (vector-at V (+ i 1)) 10) (+ i 2) (out-v-hdr V (+ i 1)))
    (out-v-hdr V (+ i 1))))

;; the decimal number at i (stops at the first non-digit)
(defn- out-v-dec [V :vector-i64 i :i64 acc :i64] :i64
  (let [c (vector-at V i)]
    (if (< c 48) acc
      (if (> c 57) acc (out-v-dec V (+ i 1) (+ (* acc 10) (- c 48)))))))

;; container bytes = header + code length
(defn- out-v-len [V :vector-i64] :i64
  (+ (out-v-hdr V 0) (out-v-dec V 7 0)))

;; M[base + i] = V[i] & 255 for i in [i, n) (a direct vector-assoc!: through out-w stage-0 refuses the module, measured)
(defn- out-copy-in [M :vector-i64 V :vector-i64 i :i64 n :i64 base :i64] :vector-i64
  (if (>= i n)
    (mem-keep M)
    (out-copy-in (vector-assoc! M (+ base i) (bit-and (vector-at V i) 255)) V (+ i 1) n base)))

;; out-load M V n sym -> M : the n container bytes V into OUT (M[MM-OUT-BASE+1 ..]), then out-parse (results as there;
;; MM-R1 counts from MM-OUT-BASE+1). The caller checks n < MM-OUT-CAP.
(defn- out-load [M :vector-i64 V :vector-i64 n :i64 sym :string] :vector-i64
  (out-parse (out-copy-in M V 0 n (+ MM-OUT-BASE 1)) (+ MM-OUT-BASE 1) n sym))

;; ==== LINK (agent LINK, rung r6h): extract without OUT holding the code ===================================================
;; out-load-hdr M V n sym -> M : only the HEADER of the n container bytes V (up to the blank line) into OUT, then out-parse
;; (results as there; MM-R1 = the index of the first code byte in V). The code stays in V: a container of any size the loader
;; reads (io-read-bytes, < 16 Mi items) extracts; a header that does not fit OUT is E-OUT-FULL by name.
(defn- out-load-hdr [M :vector-i64 V :vector-i64 n :i64 sym :string] :vector-i64
  (let [cs (out-v-hdr V 0)]
    (if (>= cs MM-OUT-CAP)
      (out-err M E-OUT-FULL cs)
      (out-parse (out-copy-in M V 0 cs (+ MM-OUT-BASE 1)) (+ MM-OUT-BASE 1) n sym))))

;; Requests of at most out-wchunk data bytes, built in ONE reused vector where possible: the loader never reclaims a vector
;; (KEXE_VECTOR_ITEMS), so a request vector per piece would cost as many items as the data. R = "<path><token tw>" + m slots.
(def out-wchunk 262144)
(defn- out-rq-new [path :string tw :i64 m :i64] :vector-i64
  (io-bput-tok (io-bput-str (vector-alloc (+ (string-length path) (+ (io-tokn tw) m))) path 0 (string-length path) 0) (string-length path) tw))
;; send R (its data R[d .. d+m), R exactly d+m long): one request, or, when the data spells a loader token, 02-io's cut pieces
(defn- out-rq-send [R :vector-i64 path :string tw :i64 d :i64 m :i64] :i64
  (if (= (io-cut R d (+ d m)) (+ d m)) (io-bsend R) (io-pieces R path d (+ d m) tw)))

;; out-write-v V path a n -> n : V[a .. a+n) (low 8 bits per item) to the file path as raw bytes: the first piece written
;; ("WRITE"), the rest appended; each request stays far below the loader's 8 MiB bytes value (io-write-bytes sends the whole
;; range as one request). Vector items: at most 3 x out-wchunk beyond V.
(defn- out-write-v [V :vector-i64 path :string a :i64 n :i64] :i64
  (let [RF (if (> n out-wchunk) (out-rq-new path 1 out-wchunk) (vector-alloc 1))]
    (loop [i a tw 0]
      (let [e (if (< (+ i out-wchunk) (+ a n)) (+ i out-wchunk) (+ a n))
            m (- e i)
            d (+ (string-length path) (io-tokn tw))
            R (if (and (= tw 1) (= m out-wchunk)) RF (out-rq-new path tw m))
            z (out-rq-send (io-bput-words R V i e (- d i)) path tw d m)]
        (if (>= e (+ a n)) n (recur e 1))))))
;; ==== END LINK ==============================================================================================================

;; ---- file output --------------------------------------------------------------------------------------------------------
;; out-write-hex M S -> M : out-build, then the container as lowercase hex on stdout (io-write-hex; `xxd -r -p` recovers the
;; bytes). This is the output path of the STABLE stage-0 image, which refuses :bytes capability calls (CONTRACT-REQUESTS
;; 2026-10-02 02-io). MM-R0 = container bytes. The :bytes path (out-write to a file) and out-extract, which must READ a
;; binary container, are added when 02-io has the byte primitives; out-parse above is their tested core.
(defn- out-write-hex2 [M :vector-i64 n :i64 ok :i64] :vector-i64
  (if (= ok 0)
    (let [w (io-write-hex M (+ MM-OUT-BASE 1) n)]
      M)
    M))

(defn- out-write-hex [M :vector-i64 S :string] :vector-i64
  (let [M1 (out-build M S)
        n (- (vector-at M1 MM-OUT-N) 1)
        ok (vector-at M1 MM-ERR)]
    (out-write-hex2 M1 n ok)))

;; seed/60-proj.kotoba -- multi-module projects: discovery, per-module compile against interfaces, machine-code link
;; (prefix pj-). Owner: agent R5A (rung R5 part A). Design: docs/selfhost-seed-r5-design-20261002.md sections 2.1-2.3 and 3
;; (option B: one process, M reset between modules, code appended to an image buffer, link = patch).
;;
;; The route (90-drv sends a compile here when --source-path is given or the entry's ns form has a clause 20-names does not
;; read: :require, an attr-map, a docstring):
;;   1. DISCOVER (pj-visit): the entry, then depth first every `:require` in clause order; each module is read into M
;;      (lex + read only), its ns header is parsed (pj-header: name, requires with :as/:refer, exports), its requires are
;;      resolved to files (namespace a.b-c -> a/b_c + .kotoba | .cljk | .cljc in each --source-path root) and visited;
;;      post-order gives the compile order (dependencies first, the entry last). Bounds: 256 modules, depth 64, 256 edges,
;;      8 MiB of source. Cycle, missing module, ns/path mismatch, duplicate alias, :use, two ns forms: refused by name.
;;   2. COMPILE each module alone (pj-module): its source S is followed by a generated TRAILER
;;        (ns <its name> (:export [..]))  -- the entry: its declared exports; a library: (:export []), i.e. nothing is a
;;                                          container export (a library's interface is the link table below, so an
;;                                          aborting or :string export is admitted, as in the reference)
;;        (defn- u/bump [p0 :i64] :i64 (u/bump p0))   -- one IMPORT STUB per interface entry of each required module,
;;                                          named as the importer spells it (alias/name, or the referred name), with the
;;                                          export's checked signature; an aborting export's stub body is (throw <zero of E>)
;;                                          so the importer infers :abort with E at every call (ADR 0363, as the reference's
;;                                          kotoba_import__i stubs)
;;      read as one source; the trailer's ns node replaces the module's own ns node (pj-splice), so 20-names .. 42-layout
;;      run unchanged on a single-namespace program. Qualified symbols a/f are ordinary symbols that resolve to the stubs;
;;      before that, pj-qscan refuses an alias that is not required (E6010) and a name that is not an export (E6004).
;;   3. LINK: 42-layout relocates the module's literal loads by its image base (M[MM-STAT-BASE+43]); 50-out's out-blob
;;      gives the code+pool bytes, copied into the image at an 8-aligned base; the FIRST instruction of every stub clause is
;;      overwritten with `b <entry of the export's clause>` (the stub is entered with the caller's arguments in x0..x4 and
;;      its link register, so the branch is a tail call; fuel is charged by the export). A library's interface (names,
;;      clause offsets in the image, stub templates) is recorded in L; then M is reset. The entry's container is the image
;;      with the entry module's exports (out-image).
;;
;; State that survives the reset lives in L (a second :vector-i64, layout below) and in P, a :string pool of the
;; strings (paths, names, aliases, stub templates); functions that add strings return P. Errors are recorded in M as by
;; the other modules (MM-ERR, MM-ERR-POS/A/B = a span of the source of module L[pj-k-errmod], which the driver prints).
;; Seed limits refused by name (E6017): interface types other than :i64 :bool :string :vector-i64 and option/result/list/
;; set/map of those, keyword or record types, variadic clauses, more than 8 clauses. Not here (part B / R6): effects,
;; :capabilities checks, --policy, templates (refused, E6023), closures dispatched across modules (a fn value of an import
;; is the stub's address, which branches on).

;; ---- L layout ------------------------------------------------------------------------------------------------------------
(def pj-l-cap 4194304)   ; LINK (r6h): 4 Mi words (was 2 Mi); see the LINK block below for the regions it moved
(def pj-k-nmod 0)     ; modules
(def pj-k-img 1)      ; image fill in bytes
(def pj-k-nif 2)      ; interface entries
(def pj-k-nreq 3)     ; require edges
(def pj-k-nref 4)     ; referred names
(def pj-k-nroot 5)    ; source-path roots (P indexes at pj-k-root0 ..)
(def pj-k-unpinned 6) ; --unpinned given
(def pj-k-errmod 7)   ; module whose source the error spans of M refer to
(def pj-k-bytes 8)    ; project source bytes so far
(def pj-k-nstub 9)    ; stub clauses of the module being compiled
(def pj-k-stub0 10)   ; FN index of its first stub clause
(def pj-k-nord 11)    ; modules in the compile order
(def pj-k-nexpn 12)   ; declared export names
(def pj-k-trail 13)   ; byte offset of the trailer in the module's source
(def pj-k-base 14)    ; image base of the module being compiled
(def pj-k-mode 15)    ; 0 = link in process (patch stubs now); 1 = emit an object (60-proj separate mode: record the patches)
(def pj-k-root0 16)   ; .. 31: up to 16 roots
(def pj-m-base 64) (def pj-m-w 24) (def pj-m-cap 256)   ; R6A: 20 words (was 16); R6D: 24 (pj-mf-tpl 20)
(def pj-mf-name 0) (def pj-mf-path 1) (def pj-mf-state 2) (def pj-mf-depth 3) (def pj-mf-req0 4) (def pj-mf-nreq 5)
(def pj-mf-if0 6) (def pj-mf-nif 7) (def pj-mf-base 8) (def pj-mf-expk 9) (def pj-mf-exp0 10) (def pj-mf-nexp 11)
(def pj-mf-entry 12)  ; 1 = the entry module (its exports are the container's; a library exports nothing to it)
(def pj-mf-obj 13)    ; separate mode: P index of the module's object text
(def pj-r-base 200704) (def pj-r-w 8) (def pj-r-cap 4096)   ; LINK (r6h): was 8192 / 256 (the image's link has ~600 edges)
(def pj-rf-mod 0) (def pj-rf-name 1) (def pj-rf-alias 2) (def pj-rf-ref0 3) (def pj-rf-nref 4) (def pj-rf-node 5)
(def pj-f-base 12288) (def pj-f-w 3) (def pj-f-cap 1024)   ; referred name: P index, span start, span end
(def pj-x-base 16384) (def pj-x-cap 8192)                  ; declared export names (P indexes)
(def pj-i-base 233472) (def pj-i-w 16) (def pj-i-cap 16384)   ; LINK (r6h): was 32768 / 4096
(def pj-if-name 0) (def pj-if-text 1) (def pj-if-ncl 2) (def pj-if-off0 3) (def pj-if-maxcl 8)
(def pj-o-base 98304)                                      ; compile order (module indexes)
(def pj-t-base 98816) (def pj-t-cap 16384)                 ; stub clause -> target image offset (module being compiled)
(def pj-u-base 115200)                                     ; stub clause -> (edge * 4096 + entry of the dependency) * 8 + clause
;; R6A: the string table of the arena P (start offsets) and the per-module / per-entry schema fields
(def pj-k-nstr 36)    ; strings in P
(def pj-s-base 135168) (def pj-s-cap 65536)
(def pj-mf-sch 16)    ; P index of the inner text of the module's own :schemas map (-1: none)
(def pj-mf-sche 17)   ; its byte offset in the module's source
(def pj-k-owncpy 34)  ; byte offset of that text's copy in the trailer of the module being compiled (-1: none)
(def pj-k-ownlen 35)  ; its length
(def pj-if-sch 15)    ; P index of the entry's record schemas ("\n:kw [:record :kw [..]]" pieces), "" when none
(def pj-img-base 495616)
(def pj-max-depth 64) (def pj-max-edges 4096) (def pj-max-bytes 8388608)
;; ==== LINK (agent LINK, rung r6h, 2026-10-04): link capacity ===============================================================
;; The image is PACKED, 8 bytes per word, little-endian within the word: image byte a is bits 8*(a mod 8) .. of
;; L[pj-img-base + a/8] (was one byte per word). With L at 4 Mi words the image holds pj-img-cap = (pj-l-cap - pj-img-base) * 8
;; = 29,589,504 bytes (was 1,896,448). Every write is checked BEFORE it happens: a blob that does not fit is E-PROJ-IMAGE by
;; name (the old check ran after the copy, which wrote past L and trapped). Regions moved past the old image base: require
;; edges (pj-r-base, 4096 edges, was 256 at word 8192) and interface entries (pj-i-base, 16384 entries, was 4096 at word
;; 32768); the old regions at 8192 and 32768 are unused. An interface entry or a P string that does not fit sets
;; pj-k-ifover / pj-k-strover; the link and the emit refuse by name (E-PROJ-EDGES / E-PROJ-IMAGE) instead of dropping it.
;; The link no longer keeps the object texts in P (one :string, at most 8 MiB in the loader; the image's objects are ~2.1x
;; its code bytes): pj-mf-obj = the object's path, read again where it is placed. The linked container is not built in OUT:
;; pj-lcontainer puts the header in OUT and pj-lwrite writes the header, then the image from L in 256 KiB appends.
(def pj-img-cap 29589504)
(def pj-k-ifover 38)
(def pj-k-strover 39)
;; image byte a, and image byte a := b
(defn- pj-ib [L :vector-i64 a :i64] :i64
  (bit-and (u64-shift-right (vector-at L (+ pj-img-base (u64-shift-right a 3))) (* 8 (bit-and a 7))) 255))
(defn- pj-ibset [L :vector-i64 a :i64 b :i64] :vector-i64
  (let [i (+ pj-img-base (u64-shift-right a 3))
        s (* 8 (bit-and a 7))
        w (vector-at L i)]
    (vector-assoc! L i (bit-or (bit-and w (bit-not (i64-shift-left 255 s))) (i64-shift-left (bit-and b 255) s)))))
;; ==== END LINK =============================================================================================================

(defn- pj-l [L :vector-i64 i :i64] :i64 (vector-at L i))
(defn- pj-max [a :i64 b :i64] :i64 (if (> a b) a b))
(defn- pj-min [a :i64 b :i64] :i64 (if (< a b) a b))
(defn- pj-ls [L :vector-i64 i :i64 v :i64] :vector-i64 (vector-assoc! L i v))
(defn- pj-mf [L :vector-i64 m :i64 f :i64] :i64 (vector-at L (+ pj-m-base (* m pj-m-w) f)))
(defn- pj-mset [L :vector-i64 m :i64 f :i64 v :i64] :vector-i64 (vector-assoc! L (+ pj-m-base (* m pj-m-w) f) v))
(defn- pj-rf [L :vector-i64 r :i64 f :i64] :i64 (vector-at L (+ pj-r-base (* r pj-r-w) f)))
(defn- pj-rset [L :vector-i64 r :i64 f :i64 v :i64] :vector-i64 (vector-assoc! L (+ pj-r-base (* r pj-r-w) f) v))
(defn- pj-if [L :vector-i64 e :i64 f :i64] :i64 (vector-at L (+ pj-i-base (* e pj-i-w) f)))
(defn- pj-iset [L :vector-i64 e :i64 f :i64 v :i64] :vector-i64 (vector-assoc! L (+ pj-i-base (* e pj-i-w) f) v))

(defn- pj-new-l [] :vector-i64 (vector-alloc pj-l-cap))

;; ---- the string pool P ----------------------------------------------------------------------------------------------------
;; R6A: P is a STRING ARENA, not a list: string k is P[L[pj-s-base + k], end) where end is the next string's start (or the
;; arena's length for the last one); L[pj-k-nstr] strings. Adding a string appends its bytes to the arena (string-concat on
;; the newest string: the loader appends in place into a string region, amortised O(1) per byte) and costs no loader vector
;; handle; the [:list :string] of R5A cost one handle per string (KEXE_VECTORS) and is gone. Reading copies the span
;; (pj-p); comparisons read the arena in place (pj-peq).
(defn- pj-n [L :vector-i64] :i64 (vector-at L pj-k-nstr))
(defn- pj-pa [L :vector-i64 i :i64] :i64 (vector-at L (+ pj-s-base i)))
(defn- pj-pb [L :vector-i64 P :string i :i64] :i64
  (if (< (+ i 1) (pj-n L)) (vector-at L (+ pj-s-base i 1)) (string-length P)))
(defn- pj-p [L :vector-i64 P :string i :i64] :string (string-substring P (pj-pa L i) (pj-pb L P i)))
(defn- pj-padd [L :vector-i64 P :string s :string] :string
  (let [k (pj-n L)
        w (if (>= k (- pj-s-cap 1)) L (-> L (vector-assoc! (+ pj-s-base k) (string-length P)) (vector-assoc! pj-k-nstr (+ k 1))))]
    (if (>= k (- pj-s-cap 1)) (let [x (vector-assoc! L pj-k-strover 1)] P) (string-concat P s))))   ; LINK: flagged, not silent
;; string i of P is s (no allocation)
(defn- pj-peq [L :vector-i64 P :string i :i64 s :string] :bool (pj-span= P (pj-pa L i) (pj-pb L P i) s))
;; a fresh pool (90-drv: the roots are added to it)
(defn- pj-new-p [L :vector-i64] :string (let [w (vector-assoc! L pj-k-nstr 0)] ""))

;; ---- M access ----------------------------------------------------------------------------------------------------------
(defn- pj-ok [M :vector-i64] :bool (= (vector-at M MM-ERR) 0))
(defn- pj-nf [M :vector-i64 n :i64 f :i64] :i64 (vector-at M (+ MM-NODE-BASE (* n MM-NODE-W) f)))
(defn- pj-nset [M :vector-i64 n :i64 f :i64 v :i64] :vector-i64 (vector-assoc! M (+ MM-NODE-BASE (* n MM-NODE-W) f) v))
(defn- pj-tf [M :vector-i64 t :i64 f :i64] :i64 (vector-at M (+ MM-TOK-BASE (* t MM-TOK-W) f)))
(defn- pj-kind [M :vector-i64 n :i64] :i64 (pj-nf M n NF-KIND))
(defn- pj-first [M :vector-i64 n :i64] :i64 (pj-nf M n NF-FIRST))
(defn- pj-next [M :vector-i64 n :i64] :i64 (pj-nf M n NF-NEXT))
(defn- pj-a [M :vector-i64 n :i64] :i64 (pj-tf M (pj-nf M n NF-TOK) TF-START))
(defn- pj-b [M :vector-i64 n :i64] :i64 (pj-tf M (pj-nf M n NF-TOK) TF-END))
;; the text of atom node n
(defn- pj-text [M :vector-i64 S :string n :i64] :string (string-substring S (pj-a M n) (pj-b M n)))
;; S[a,b) spells s (no allocation)
(defn- pj-span= [S :string a :i64 b :i64 s :string] :bool
  (and (= (- b a) (string-length s))
       (loop [i 0]
         (cond (>= i (string-length s)) true
               (not= (string-code-point-at S (+ a i)) (string-code-point-at s i)) false
               :else (recur (+ i 1))))))
(defn- pj-is [M :vector-i64 S :string n :i64 s :string] :bool (pj-span= S (pj-a M n) (pj-b M n) s))

;; first error wins; the span of node n (n = 0: no position)
(defn- pj-err-span [M :vector-i64 code :i64 pos :i64 a :i64 b :i64] :vector-i64
  (if (pj-ok M)
    (-> M (vector-assoc! MM-ERR code) (vector-assoc! MM-ERR-POS pos) (vector-assoc! MM-ERR-A (pj-max a 0)) (vector-assoc! MM-ERR-B (pj-max b 0)))
    M))
(defn- pj-err [M :vector-i64 code :i64 n :i64] :vector-i64
  (if (= n 0) (pj-err-span M code -1 0 0) (pj-err-span M code (pj-a M n) (pj-a M n) (pj-b M n))))

;; ---- reset of M between modules ------------------------------------------------------------------------------------------
(defn- pj-zero [M :vector-i64 a :i64 e :i64] :vector-i64
  (loop [i a]
    (if (>= i e) M (let [w (vector-assoc! M i 0)] (recur (+ i 1))))))

;; zero exactly what a compile filled (every region's prefix up to its fill, the whole HASH and SCOPE regions, the HEAP up to
;; its top, the header and statistics cells), then the state of mem-new: "fresh words are zero" holds for the next module
(defn- pj-reset [M :vector-i64] :vector-i64
  (let [ntok (vector-at M MM-TOK-N) nnode (vector-at M MM-NODE-N) nsym (vector-at M MM-SYM-N) nfn (vector-at M MM-FN-N)
        nsir (vector-at M MM-SIR-N) nlab (vector-at M MM-LABEL-N) ncode (vector-at M MM-CODE-N) nfix (vector-at M MM-FIX-N)
        nlit (vector-at M MM-LIT-N) nlitb (vector-at M MM-LITB-N) nexp (vector-at M MM-EXP-N) nout (vector-at M MM-OUT-N)
        top (vector-at M MM-HEAP-TOP)]
    (-> M
        (pj-zero MM-TOK-BASE (+ MM-TOK-BASE (* ntok MM-TOK-W)))
        (pj-zero MM-NODE-BASE (+ MM-NODE-BASE (* nnode MM-NODE-W)))
        (pj-zero MM-SYM-BASE (+ MM-SYM-BASE (* nsym MM-SYM-W)))
        (pj-zero MM-HASH-BASE (+ MM-HASH-BASE (* MM-HASH-CAP MM-HASH-W)))
        (pj-zero MM-FN-BASE (+ MM-FN-BASE (* nfn MM-FN-W)))
        (pj-zero MM-SCOPE-BASE (+ MM-SCOPE-BASE (* MM-SCOPE-CAP MM-SCOPE-W)))
        (pj-zero MM-SIR-BASE (+ MM-SIR-BASE (* nsir MM-SIR-W)))
        (pj-zero MM-LABEL-BASE (pj-min (+ MM-LABEL-BASE nlab 1) (+ MM-LABEL-BASE MM-LABEL-CAP)))
        (pj-zero MM-CODE-BASE (+ MM-CODE-BASE ncode))
        (pj-zero MM-FIX-BASE (+ MM-FIX-BASE (* nfix MM-FIX-W)))
        (pj-zero MM-LIT-BASE (+ MM-LIT-BASE (* nlit MM-LIT-W)))
        (pj-zero MM-LITB-BASE (+ MM-LITB-BASE nlitb))
        (pj-zero MM-EXP-BASE (+ MM-EXP-BASE (* nexp MM-EXP-W)))
        (pj-zero MM-OUT-BASE (+ MM-OUT-BASE nout))
        (pj-zero MM-HEAP-BASE (pj-max top MM-HEAP-BASE))
        (pj-zero 0 256)
        (vector-assoc! MM-VERSION MM-LAYOUT-VERSION)
        (mem-init-fills MM-TOK-N)
        (mem-set MM-HASH-N 0)
        (mem-set MM-HEAP-TOP MM-HEAP-BASE)
        (mem-set MM-ERR-POS -1))))

;; reset, then lex and read S (one module's source, with or without its trailer)
(defn- pj-read [M :vector-i64 S :string] :vector-i64
  (let [M1 (mem-set (pj-reset M) MM-SRC-LEN (string-length S))
        M2 (lx-run M1 S)]
    (if (pj-ok M2) (rd-run M2 S) M2)))

;; ---- names and paths -----------------------------------------------------------------------------------------------------
;; namespace a.b-c -> relative path a/b_c
(defn- pj-rel [nm :string] :string
  (loop [i 0 a 0 acc ""]
    (cond (>= i (string-length nm)) (string-concat acc (string-substring nm a i))
          (= (string-code-point-at nm i) 46) (recur (+ i 1) (+ i 1) (string-concat (string-concat acc (string-substring nm a i)) "/"))
          (= (string-code-point-at nm i) 45) (recur (+ i 1) (+ i 1) (string-concat (string-concat acc (string-substring nm a i)) "_"))
          :else (recur (+ i 1) a acc))))

(defn- pj-ext [k :i64] :string (case k 0 ".kotoba" 1 ".cljk" ".cljc"))

;; the file of rel in root: the first extension that exists, else ""
(defn- pj-in-root [root :string rel :string] :string
  (loop [k 0]
    (cond (> k 2) ""
          (= (io-exists (string-concat root (string-concat "/" (string-concat rel (pj-ext k))))) 1)
          (string-concat root (string-concat "/" (string-concat rel (pj-ext k))))
          :else (recur (+ k 1)))))

(defn- pj-kotoba? [path :string] :bool
  (and (>= (string-length path) 7) (string=? (string-substring path (- (string-length path) 7) (string-length path)) ".kotoba")))

;; the file of namespace nm over the roots: "" none; "\n" ambiguous (two roots, not exactly one .kotoba among them)
(defn- pj-locate [L :vector-i64 P :string nm :string] :string
  (let [rel (pj-rel nm)
        n (pj-l L pj-k-nroot)]
    (loop [k 0 found "" nfound 0 nkot 0 kot ""]
      (if (>= k n)
        (cond (= nfound 0) "" (= nfound 1) found (= nkot 1) kot :else "\n")
        (let [c (pj-in-root (pj-p L P (pj-l L (+ pj-k-root0 k))) rel)]
          (cond (= (string-length c) 0) (recur (+ k 1) found nfound nkot kot)
                (pj-kotoba? c) (recur (+ k 1) c (+ nfound 1) (+ nkot 1) c)
                :else (recur (+ k 1) c (+ nfound 1) nkot kot)))))))

;; the module named nm, -1 when none
(defn- pj-find-mod [L :vector-i64 P :string nm :string] :i64
  (loop [m 0]
    (cond (>= m (pj-l L pj-k-nmod)) -1
          (pj-peq L P (pj-mf L m pj-mf-name) nm) m
          :else (recur (+ m 1)))))

;; a new module record (state 0); its index is the old count
(defn- pj-add-mod [L :vector-i64 name :i64 path :i64] :vector-i64
  (let [m (pj-l L pj-k-nmod)]
    (-> L (pj-mset m pj-mf-name name) (pj-mset m pj-mf-path path) (pj-mset m pj-mf-state 0) (pj-mset m pj-mf-depth 0)
        (pj-mset m pj-mf-nreq 0) (pj-mset m pj-mf-nif 0) (pj-mset m pj-mf-expk 0) (pj-mset m pj-mf-nexp 0) (pj-mset m pj-mf-entry 0) (pj-mset m pj-mf-sch -1)
        (pj-mset m 15 0) (pj-mset m 18 0) (pj-mset m 19 0) (pj-mset m 20 0)   ; R6D: pj-mf-kwt kwu kwf tpl
        (pj-ls pj-k-nmod (+ m 1)))))

;; ---- the ns header ------------------------------------------------------------------------------------------------------
;; n is a list whose head symbol spells h
(defn- pj-head? [M :vector-i64 S :string n :i64 h :string] :bool
  (and (= (pj-kind M n) ND-LIST) (= (pj-kind M (pj-first M n)) ND-SYM) (pj-is M S (pj-first M n) h)))

(defn- pj-count-ns [M :vector-i64 S :string] :i64
  (loop [n (pj-first M (vector-at M MM-ROOT)) k 0]
    (cond (= n 0) k
          (pj-head? M S n "ns") (recur (pj-next M n) (+ k 1))
          :else (recur (pj-next M n) k))))

;; the name node of the top-level (defn|defn-|def NAME ..) n, else 0
(defn- pj-def-name [M :vector-i64 S :string n :i64] :i64
  (let [nm (pj-next M (pj-first M n))]
    (if (and (or (pj-head? M S n "defn") (pj-head? M S n "defn-") (pj-head? M S n "def")) (= (pj-kind M nm) ND-SYM)) nm 0)))

;; number of public defns
(defn- pj-count-pub [M :vector-i64 S :string] :i64
  (loop [n (pj-first M (vector-at M MM-ROOT)) k 0]
    (cond (= n 0) k
          (pj-head? M S n "defn") (recur (pj-next M n) (+ k 1))
          :else (recur (pj-next M n) k))))

;; a top-level definition is spelled s
(defn- pj-defined? [M :vector-i64 S :string s :string] :bool
  (loop [n (pj-first M (vector-at M MM-ROOT))]
    (cond (= n 0) false
          (and (> (pj-def-name M S n) 0) (pj-is M S (pj-def-name M S n) s)) true
          :else (recur (pj-next M n)))))

;; append the symbols of vector v as declared exports of module m
(defn- pj-exports [M :vector-i64 L :vector-i64 P :string S :string v :i64] :string
  (loop [c (pj-first M v) P P]
    (cond (not (pj-ok M)) P
          (= c 0) P
          (not= (pj-kind M c) ND-SYM) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          (>= (pj-l L pj-k-nexpn) pj-x-cap) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          :else (let [k (pj-l L pj-k-nexpn)
                      w (pj-ls (pj-ls L (+ pj-x-base k) (pj-n L)) pj-k-nexpn (+ k 1))]
                  (recur (pj-next M c) (pj-padd L P (pj-text M S c)))))))

;; module m declares its exports with the vector v (kind 1 clause, 2 attr-map)
(defn- pj-declare [M :vector-i64 L :vector-i64 P :string S :string v :i64] :string
  (let []
    (cond (> (pj-mf L (pj-l L pj-k-errmod) pj-mf-expk) 0) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          (not= (pj-kind M v) ND-VEC) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          :else (let [cur (pj-l L pj-k-errmod)
                      w (-> L (pj-mset cur pj-mf-expk 1) (pj-mset cur pj-mf-exp0 (pj-l L pj-k-nexpn)))
                      P2 (pj-exports M L P S v)]
                  (let [w2 (pj-mset L cur pj-mf-nexp (- (pj-l L pj-k-nexpn) (pj-mf L cur pj-mf-exp0)))] P2)))))

;; an alias already used by a require of module cur
(defn- pj-alias-dup? [L :vector-i64 P :string cur :i64 a :string] :bool
  (loop [r (pj-mf L cur pj-mf-req0)]
    (cond (>= r (pj-l L pj-k-nreq)) false
          (and (>= (pj-rf L r pj-rf-alias) 0) (pj-peq L P (pj-rf L r pj-rf-alias) a)) true
          :else (recur (+ r 1)))))

(defn- pj-ns-dup? [L :vector-i64 P :string cur :i64 a :string] :bool
  (loop [r (pj-mf L cur pj-mf-req0)]
    (cond (>= r (pj-l L pj-k-nreq)) false
          (pj-peq L P (pj-rf L r pj-rf-name) a) true
          :else (recur (+ r 1)))))

;; a name referred by an earlier require of module cur (or the one being read)
(defn- pj-refer-dup? [L :vector-i64 P :string cur :i64 a :string] :bool
  (loop [f (pj-rf L (pj-mf L cur pj-mf-req0) pj-rf-ref0)]
    (cond (>= f (pj-l L pj-k-nref)) false
          (pj-peq L P (pj-l L (+ pj-f-base (* f pj-f-w))) a) true
          :else (recur (+ f 1)))))

;; the referred names of vector v
(defn- pj-refers [M :vector-i64 L :vector-i64 P :string S :string v :i64] :string
  (let [cur (pj-l L pj-k-errmod)]
    (loop [c (pj-first M v) P P]
      (cond (not (pj-ok M)) P
            (= c 0) P
            (not= (pj-kind M c) ND-SYM) (let [w (pj-err M E-PROJ-SPEC c)] P)
            (>= (pj-l L pj-k-nref) pj-f-cap) (let [w (pj-err M E-PROJ-EDGES c)] P)
            (pj-refer-dup? L P cur (pj-text M S c)) (let [w (pj-err M E-PROJ-REFER c)] P)
            (pj-defined? M S (pj-text M S c)) (let [w (pj-err M E-PROJ-REFER c)] P)
            :else (let [f (pj-l L pj-k-nref)
                        b (+ pj-f-base (* f pj-f-w))
                        r (- (pj-l L pj-k-nreq) 1)
                        w (-> L (pj-ls b (pj-n L)) (pj-ls (+ b 1) (pj-a M c)) (pj-ls (+ b 2) (pj-b M c)) (pj-ls pj-k-nref (+ f 1))
                              (pj-rset r pj-rf-nref (+ (pj-rf L r pj-rf-nref) 1)))]
                    (recur (pj-next M c) (pj-padd L P (pj-text M S c))))))))

;; the options after the namespace symbol of a require spec, from node o (the edge r is the last one)
(defn- pj-spec-opts [M :vector-i64 L :vector-i64 P :string S :string o :i64] :string
  (let [cur (pj-l L pj-k-errmod)
        r (- (pj-l L pj-k-nreq) 1)
        v (pj-next M o)]
    (cond (not (pj-ok M)) P
          (= o 0) P
          (not= (pj-kind M o) ND-KW) (let [w (pj-err M E-PROJ-SPEC o)] P)
          (= v 0) (let [w (pj-err M E-PROJ-SPEC o)] P)
          (pj-is M S o ":as")
          (cond (not= (pj-kind M v) ND-SYM) (let [w (pj-err M E-PROJ-SPEC v)] P)
                (>= (pj-rf L r pj-rf-alias) 0) (let [w (pj-err M E-PROJ-SPEC o)] P)
                (pj-alias-dup? L P cur (pj-text M S v)) (let [w (pj-err M E-PROJ-DUP-ALIAS v)] P)
                :else (let [w (pj-rset L r pj-rf-alias (pj-n L))]
                        (pj-spec-opts M L (pj-padd L P (pj-text M S v)) S (pj-next M v))))
          (pj-is M S o ":refer")
          (if (= (pj-kind M v) ND-VEC)
            (pj-spec-opts M L (pj-refers M L P S v) S (pj-next M v))
            (let [w (pj-err M E-PROJ-SPEC v)] P))
          (pj-is M S o ":with") (let [w (pj-err M E-PROJ-TEMPLATE o)] P)
          :else (let [w (pj-err M E-PROJ-SPEC o)] P))))

;; one require spec [ns :as a :refer [..]]
(defn- pj-spec [M :vector-i64 L :vector-i64 P :string S :string sp :i64] :string
  (let [cur (pj-l L pj-k-errmod)
        nm (pj-first M sp)
        r (pj-l L pj-k-nreq)]
    (cond (not= (pj-kind M sp) ND-VEC) (let [w (pj-err M E-PROJ-SPEC sp)] P)
          (not= (pj-kind M nm) ND-SYM) (let [w (pj-err M E-PROJ-SPEC sp)] P)
          (pj-ns-dup? L P cur (pj-text M S nm)) (let [w (pj-err M E-PROJ-DUP-NS nm)] P)
          (>= r pj-r-cap) (let [w (pj-err M E-PROJ-EDGES nm)] P)
          :else (let [w (-> L (pj-rset r pj-rf-mod -1) (pj-rset r pj-rf-name (pj-n L)) (pj-rset r pj-rf-alias -1)
                            (pj-rset r pj-rf-ref0 (pj-l L pj-k-nref)) (pj-rset r pj-rf-nref 0) (pj-rset r pj-rf-node nm)
                            (pj-ls pj-k-nreq (+ r 1)) (pj-mset cur pj-mf-nreq (+ (pj-mf L cur pj-mf-nreq) 1)))]
                  (pj-spec-opts M L (pj-padd L P (pj-text M S nm)) S (pj-next M nm))))))

(defn- pj-specs [M :vector-i64 L :vector-i64 P :string S :string sp :i64] :string
  (if (or (= sp 0) (not (pj-ok M))) P (pj-specs M L (pj-spec M L P S sp) S (pj-next M sp))))

;; the attr-map {k v ..} of the ns form
(defn- pj-attrs [M :vector-i64 L :vector-i64 P :string S :string k :i64] :string
  (let [v (pj-next M k)]
    (cond (or (= k 0) (not (pj-ok M))) P
          (= v 0) (let [w (pj-err M E-PROJ-NSFORM k)] P)
          (pj-is M S k ":kotoba/export") (pj-attrs M L (pj-declare M L P S v) S (pj-next M v))
          (pj-is M S k ":kotoba/params") (pj-attrs M L (pj-tpl-params M L P S v k) S (pj-next M v))   ; R6D
          (pj-is M S k ":kotoba/schemas") (pj-attrs M L (pj-own-schemas M L P S v) S (pj-next M v))   ; R6A
          (pj-is M S k ":kotoba/capabilities") (let [w (pj-r5b-decl M L S v)] (pj-attrs M L P S (pj-next M v)))   ; R5B
          :else (pj-attrs M L P S (pj-next M v)))))

;; R6A: the module's own schema map v: its inner text (verbatim, re-read in the generated ns form) is string pj-mf-sch
(defn- pj-own-schemas [M :vector-i64 L :vector-i64 P :string S :string v :i64] :string
  (let [cur (pj-l L pj-k-errmod)
        a (pj-a M v)
        e (lx-sk-form S a)]
    (cond (not= (pj-kind M v) ND-MAP) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          (< e 0) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          :else (let [w (-> L (pj-mset cur pj-mf-sch (pj-n L)) (pj-mset cur pj-mf-sche (+ a 1)))] (pj-padd L P (string-substring S (+ a 1) (- e 1)))))))

;; one clause or attr-map of the ns form
(defn- pj-clause [M :vector-i64 L :vector-i64 P :string S :string c :i64] :string
  (let [k (pj-first M c)]
    (cond (= (pj-kind M c) ND-STR) P
          (= (pj-kind M c) ND-MAP) (pj-attrs M L P S (pj-first M c))
          (not= (pj-kind M c) ND-LIST) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          (not= (pj-kind M k) ND-KW) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          (pj-is M S k ":require") (pj-specs M L P S (pj-next M k))
          (pj-is M S k ":export") (if (= (pj-next M (pj-next M k)) 0) (pj-declare M L P S (pj-next M k)) (let [w (pj-err M E-PROJ-NSFORM c)] P))
          (pj-is M S k ":schemas") (pj-own-schemas M L P S (pj-next M k))   ; R6A
          (pj-is M S k ":capabilities") (let [w (pj-r5b-decl M L S (pj-next M k))] P)   ; R5B
          (pj-is M S k ":refer-clojure") P
          (pj-is M S k ":params") (pj-tpl-params M L P S (pj-next M k) k)   ; R6D: a template whose parameters all have defaults
          (pj-is M S k ":use") (let [w (pj-err M E-PROJ-USE k)] P)
          :else (let [w (pj-err M E-PROJ-CLAUSE k)] P))))

(defn- pj-clauses [M :vector-i64 L :vector-i64 P :string S :string c :i64] :string
  (if (or (= c 0) (not (pj-ok M))) P (pj-clauses M L (pj-clause M L P S c) S (pj-next M c))))

;; parse the header of module L[errmod] (its source S is read into M); expect = the required name ("" for the entry)
(defn- pj-header [M :vector-i64 L :vector-i64 P :string S :string expect :string] :string
  (let [cur (pj-l L pj-k-errmod)
        ns (pj-first M (vector-at M MM-ROOT))
        nmn (pj-next M (pj-first M ns))]
    (cond (not= (pj-count-ns M S) 1) (let [w (pj-err M E-PROJ-NS ns)] P)
          (not (pj-head? M S ns "ns")) (let [w (pj-err M E-PROJ-NS ns)] P)
          (not= (pj-kind M nmn) ND-SYM) (let [w (pj-err M E-PROJ-NSFORM ns)] P)
          (and (> (string-length expect) 0) (not (pj-is M S nmn expect))) (let [w (pj-err M E-PROJ-MISMATCH nmn)] P)
          :else (let [w (-> L (pj-mset cur pj-mf-req0 (pj-l L pj-k-nreq)) (pj-mset cur pj-mf-nreq 0))
                      P1 (if (= (string-length expect) 0) (let [w1 (pj-mset L cur pj-mf-name (pj-n L))] (pj-padd L P (pj-text M S nmn))) P)
                      P2 (pj-clauses M L P1 S (pj-next M nmn))]
                  (cond (not (pj-ok M)) P2
                        (and (= (pj-mf L cur pj-mf-entry) 0) (= (pj-mf L cur pj-mf-expk) 0) (= (pj-count-pub M S) 0)) (let [w2 (pj-err M E-PROJ-NOTHING nmn)] P2)
                        :else P2)))))

;; ---- discovery --------------------------------------------------------------------------------------------------------
;; resolve require edge r of module cur (depth d) to a module: an existing one, or a new one from the roots
(defn- pj-resolve [M :vector-i64 L :vector-i64 P :string r :i64 d :i64] :string
  (let [nm (pj-p L P (pj-rf L r pj-rf-name))
        node (pj-rf L r pj-rf-node)
        m (pj-find-mod L P nm)]
    (cond (> (+ d 1) pj-max-depth) (let [w (pj-err M E-PROJ-DEPTH node)] P)
          (and (>= m 0) (= (pj-mf L m pj-mf-state) 1)) (let [w (pj-err M E-PROJ-CYCLE node)] P)
          (>= m 0) (let [w (pj-rset L r pj-rf-mod m)] P)
          (>= (pj-l L pj-k-nmod) pj-m-cap) (let [w (pj-err M E-PROJ-MODULES node)] P)
          :else (let [path (pj-locate L P nm)]
                  (cond (= (string-length path) 0) (let [w (pj-err M E-PROJ-MISSING node)] P)
                        (string=? path "\n") (let [w (pj-err M E-PROJ-AMBIGUOUS node)] P)
                        :else (let [k (pj-l L pj-k-nmod)
                                    w (-> L (pj-add-mod (pj-rf L r pj-rf-name) (pj-n L)) (pj-rset r pj-rf-mod k) (pj-mset k pj-mf-depth (+ d 1)))]
                                (pj-padd L P path)))))))

(defn- pj-resolve-all [M :vector-i64 L :vector-i64 P :string cur :i64] :string
  (let [r0 (pj-mf L cur pj-mf-req0)
        n (pj-mf L cur pj-mf-nreq)
        d (pj-mf L cur pj-mf-depth)]
    (loop [k 0 P P]
      (if (or (>= k n) (not (pj-ok M))) P (recur (+ k 1) (pj-resolve M L P (+ r0 k) d))))))

;; visit module m: read, header, resolve, children, then append m to the compile order
(defn- pj-visit [M :vector-i64 L :vector-i64 P :string m :i64] :string
  (let [path (pj-p L P (pj-mf L m pj-mf-path))
        S (io-read-file M path)
        bytes (+ (pj-l L pj-k-bytes) (string-length S))
        w (-> L (pj-ls pj-k-bytes bytes) (pj-ls pj-k-errmod m) (pj-mset m pj-mf-state 1))
        M1 (pj-read M S)]
    (cond (not (pj-ok M1)) P
          (> bytes pj-max-bytes) (let [w2 (pj-err M1 E-PROJ-BYTES 0)] P)
          :else
          (let [P2 (pj-header M1 L P S (if (= (pj-mf L m pj-mf-entry) 1) "" (pj-p L P (pj-mf L m pj-mf-name))))
                P3 (if (pj-ok M1) (pj-resolve-all M1 L P2 m) P2)
                r0 (pj-mf L m pj-mf-req0)
                n (pj-mf L m pj-mf-nreq)
                P4 (loop [k 0 P P3]
                     (cond (or (>= k n) (not (pj-ok M1))) P
                           (= (pj-mf L (pj-rf L (+ r0 k) pj-rf-mod) pj-mf-state) 0) (recur (+ k 1) (pj-visit M1 L P (pj-rf L (+ r0 k) pj-rf-mod)))
                           :else (recur (+ k 1) P)))
                no (pj-l L pj-k-nord)]
            (if (pj-ok M1)
              (let [w3 (-> L (pj-mset m pj-mf-state 2) (pj-ls (+ pj-o-base no) m) (pj-ls pj-k-nord (+ no 1)))] P4)
              P4)))))

;; ---- interface types and stub templates -------------------------------------------------------------------------------
;; R6A: the interface of an export is SOURCE TEXT (a stub template) whose types are spelled canonically, so that the importer
;; re-interns them in its own compile: :i64 :bool :string :vector-i64 :bytes :keyword, records by reference [:ref :kw] (the
;; record travels with its schema: [:record :kw [[:f T] ..]] pieces in the entry's schema text, every record reachable from
;; the signature, so the importer's generated ns declares them and 21-check compares them structurally with any schema of the
;; same name the importer declares itself, E2128), fn types [:fn [[P ..] R]], and option/result/list/set/map of those.
;; A keyword value crosses as is (30-lower: a keyword's value is the hash of its spelling). Variadic clauses cross as
;; [p0 T0 .. & pn] (the caller packs the surplus into the list, the export's clause receives it). E6017 remains for an error
;; type no stub can throw a value of (a record or a collection), more than 8 clauses, and a record whose schema is unknown.
(defn- pj-ct [M :vector-i64 t :i64 f :i64] :i64 (vector-at M (+ (vector-at M MM-CT) (* (- t TY-COMP-BASE) CT-W) f)))
(defn- pj-sf [M :vector-i64 s :i64 k :i64] :i64 (vector-at M (+ MM-SYM-BASE (* s MM-SYM-W) k)))
(defn- pj-symtext [M :vector-i64 S :string s :i64] :string (string-substring S (pj-sf M s SF-START) (pj-sf M s SF-END)))

;; the schema block of record type t, 0 when none is registered
(defn- pj-blk [M :vector-i64 t :i64] :i64 (pj-sf M (- t TY-REC-BASE) SF-REC))

;; the keyword that names record type t across modules: its identity keyword, or :<ns>/Name for a defrecord whose module never
;; spells its keyword (the importer registers the schema under that keyword)
(defn- pj-reckw [M :vector-i64 S :string nsn :string t :i64] :string
  (let [tx (pj-symtext M S (- t TY-REC-BASE))]
    (if (and (> (string-length tx) 0) (= (string-code-point-at tx 0) 58))
      tx
      (string-concat ":" (string-concat nsn (string-concat "/" tx))))))

;; "[P1 P2 ..]" of the parameter-list type chain p (TC-PLIST: CT-A the type, CT-B the rest), "" when one does not cross
(defn- pj-typl [M :vector-i64 S :string nsn :string p :i64] :string
  (loop [q p acc ""]
    (cond (= q 0) (string-concat "[" (string-concat acc "]"))
          (= (string-length (pj-ty M S nsn (pj-ct M q CT-A))) 0) ""
          :else (recur (pj-ct M q CT-B) (string-concat acc (string-concat (if (= q p) "" " ") (pj-ty M S nsn (pj-ct M q CT-A))))))))

;; the source spelling of type t, "" when it does not cross a module boundary in the seed
(defn- pj-ty [M :vector-i64 S :string nsn :string t :i64] :string
  (cond (= t TY-I64) ":i64" (= t TY-BOOL) ":bool" (= t TY-STR) ":string" (= t TY-VEC) ":vector-i64"
        (= t TY-BYTES) ":bytes" (= t TY-KW) ":keyword"
        (= t TY-DOC) ":document"   ; R6B
        (= t TY-SYM) ":symbol"   ; R6B
        (= t TY-F64) ":f64"   ; R6C
        (= t 11) ":f32"   ; R6F (21-check ck-ty-f32)
        (< t TY-REC-BASE) ""
        (< t TY-COMP-BASE) (if (= (pj-blk M t) 0) "" (string-concat "[:ref " (string-concat (pj-reckw M S nsn t) "]")))
        (= (pj-ct M t CT-CTOR) TC-FN)
        (let [ps (pj-typl M S nsn (pj-ct M t CT-B))
              r (pj-ty M S nsn (pj-ct M t CT-A))]
          (if (or (= (string-length ps) 0) (= (string-length r) 0)) ""
            (string-concat "[:fn [" (string-concat ps (string-concat " " (string-concat r "]]"))))))
        :else (let [c (pj-ct M t CT-CTOR)
                    a (pj-ty M S nsn (pj-ct M t CT-A))
                    b (if (or (= c TC-RESULT) (= c TC-MAP)) (pj-ty M S nsn (pj-ct M t CT-B)) ":i64")]
                (cond (or (= (string-length a) 0) (= (string-length b) 0)) ""
                      (and (= c TC-OPTION) (= (pj-ct M t CT-B) 1)) ":option-i64"   ; R6D: the legacy option
                      (= c TC-OPTION) (string-concat "[:option " (string-concat a "]"))
                      (and (= c TC-LIST) (> (pj-ct M t CT-B) 0)) (pj-tuple a (pj-ct M t CT-B))   ; R6D: [:vector [T ..]]
                      (= c TC-LIST) (string-concat "[:list " (string-concat a "]"))
                      (= c TC-SET) (string-concat "[:set " (string-concat a "]"))
                      (= c TC-RESULT) (string-concat "[:result " (string-concat a (string-concat " " (string-concat b "]"))))
                      (= c TC-MAP) (string-concat "[:map " (string-concat a (string-concat " " (string-concat b "]"))))
                      :else ""))))

;; R6D: "[:vector [a a ..]]" (n items)
(defn- pj-tuple [a :string n :i64] :string
  (loop [k 0 acc "[:vector ["] (if (>= k n) (string-concat acc "]]") (recur (+ k 1) (string-concat acc (string-concat (if (= k 0) "" " ") a))))))

;; the record types reachable from type t, added to ids (" t " tokens, each record once: recursive schemas terminate)
(defn- pj-recs [M :vector-i64 t :i64 ids :string] :string
  (cond (< t TY-REC-BASE) ids
        (< t TY-COMP-BASE)
        (let [tok (string-concat " " (string-concat (mem-u2dec t) " "))
              blk (pj-blk M t)]
          (if (or (= blk 0) (>= (string-index-of ids tok) 0))
            ids
            (loop [i 0 acc (string-concat ids tok)]
              (if (>= i (vector-at M (+ blk RB-N))) acc
                (recur (+ i 1) (pj-recs M (vector-at M (+ blk RB-F0 (* i RB-FW) 1)) acc))))))
        :else (pj-recs M (pj-ct M t CT-B) (pj-recs M (pj-ct M t CT-A) ids))))

;; the schema piece of record type t: "\t:kw [:record :kw [[:f T] ..]]", "" when a field type does not cross
(defn- pj-schema [M :vector-i64 S :string nsn :string t :i64] :string
  (let [blk (pj-blk M t)
        kw (pj-reckw M S nsn t)
        fs (loop [i 0 acc ""]
             (if (>= i (vector-at M (+ blk RB-N)))
               acc
               (let [ft (pj-ty M S nsn (vector-at M (+ blk RB-F0 (* i RB-FW) 1)))]
                 (if (= (string-length ft) 0)
                   "\n"
                   (recur (+ i 1) (string-concat acc (string-concat (if (= i 0) "[" " [") (string-concat (pj-symtext M S (vector-at M (+ blk RB-F0 (* i RB-FW))))
                                                         (string-concat " " (string-concat ft "]"))))))))))]
    (if (or (= blk 0) (string=? fs "\n")) ""
      (string-concat "\t" (string-concat kw (string-concat " [:record " (string-concat kw (string-concat " [" (string-concat fs "]]")))))))))

;; the schema pieces of the records in ids; "\n" when one does not cross
(defn- pj-schemas [M :vector-i64 S :string nsn :string ids :string] :string
  (loop [i 0 v 0 acc ""]
    (cond (>= i (string-length ids)) acc
          (and (>= (string-code-point-at ids i) 48) (<= (string-code-point-at ids i) 57)) (recur (+ i 1) (+ (* v 10) (- (string-code-point-at ids i) 48)) acc)
          (= v 0) (recur (+ i 1) 0 acc)
          (= (string-length (pj-schema M S nsn v)) 0) "\n"
          :else (recur (+ i 1) 0 (string-concat acc (pj-schema M S nsn v))))))

;; a value of the error type e for a stub's throw, "" when none is spelled here
(defn- pj-zero-of [e :i64] :string
  (cond (= e TY-I64) "0" (= e TY-STR) "\"\"" (= e TY-BOOL) "false" (= e TY-KW) ":seed/stub"
        (= e TY-DOC) "(__r6-as :document \"nil\")"   ; R6B: the null document, no library needed (__r6-as is a head)
        :else ""))
;; LET (r6i): any other error type that crosses (a record [:ref :kw], a collection, :f64 ..) gets a retyped 0. The stub body
;; is never run (its first instruction is patched to the export's entry); the throw only types the importer's call as :abort
;; with E (ADR 0363: frontend passes export functions whose error type is a record). "" when the type does not cross.
(defn- pj-zero-ty [M :vector-i64 S :string nsn :string e :i64] :string
  (let [z (pj-zero-of e)
        t (pj-ty M S nsn e)]
    (cond (> (string-length z) 0) z
          (= (string-length t) 0) ""
          :else (string-concat "(__r6-as " (string-concat t " 0)")))))

(defn- pj-ff [M :vector-i64 f :i64 k :i64] :i64 (vector-at M (+ MM-FN-BASE (* f MM-FN-W) k)))

;; the parameter vector of clause f (21-check gives every clause a (defn NAME [..] R body) node)
(defn- pj-pvec [M :vector-i64 f :i64] :i64 (pj-next M (pj-next M (pj-first M (pj-ff M f FF-NODE)))))

;; the type of parameter k of clause f (R4B: FF-PT0+k for k < 5, else NF-TYPE of the k-th type form of its parameter vector)
(defn- pj-pt [M :vector-i64 f :i64 k :i64] :i64
  (if (< k 5)
    (pj-ff M f (+ FF-PT0 k))
    (let [pv (pj-pvec M f)]
      (pj-nf M (loop [c (pj-first M pv) j 0] (if (or (= c 0) (>= j (+ (* 2 k) 1))) c (recur (pj-next M c) (+ j 1)))) NF-TYPE))))

;; the variadic flag of clause f (21-check marks NF-TYPE 1 on a variadic clause's parameter vector)
(defn- pj-variadic? [M :vector-i64 f :i64] :bool
  (let [pv (pj-pvec M f)]
    (and (= (pj-kind M pv) ND-VEC) (= (pj-nf M pv NF-TYPE) 1))))

;; "[p0 T0 p1 T1 ..]" of clause f ("& pn" for the rest parameter of a variadic clause), "" when a type does not cross
(defn- pj-params [M :vector-i64 S :string nsn :string f :i64] :string
  (let [n (pj-ff M f FF-NPARAMS)
        va (pj-variadic? M f)]
    (loop [i 0 acc "["]
      (cond (>= i n) (string-concat acc "]")
            (and va (= i (- n 1))) (recur (+ i 1) (string-concat acc (string-concat (if (= i 0) "& p" " & p") (mem-u2dec i))))
            (= (string-length (pj-ty M S nsn (pj-pt M f i))) 0) ""
            :else (recur (+ i 1) (string-concat acc (string-concat (if (= i 0) "p" " p") (string-concat (mem-u2dec i)
                                   (string-concat " " (pj-ty M S nsn (pj-pt M f i)))))))))))

;; "(SEEDSELF p0 p1 ..)": the self call that types a stub body
(defn- pj-selfcall [n :i64] :string
  (loop [i 0 acc "(SEEDSELF"]
    (if (>= i n) (string-concat acc ")") (recur (+ i 1) (string-concat acc (string-concat " p" (mem-u2dec i)))))))

;; "[params] R body" of clause f, "" when it does not cross
(defn- pj-clause-text [M :vector-i64 S :string nsn :string f :i64] :string
  (let [ps (pj-params M S nsn f)
        r (pj-ty M S nsn (pj-ff M f FF-RTYPE))
        ab (pj-sf M (pj-ff M f FF-SYM) SF-ABORT)
        np (if (pj-variadic? M f) (- (pj-ff M f FF-NPARAMS) 1) (pj-ff M f FF-NPARAMS))
        body (if (= ab 0) (pj-selfcall np) (string-concat "(throw " (string-concat (pj-zero-ty M S nsn ab) ")")))]
    (cond (or (= (string-length ps) 0) (= (string-length r) 0)) ""
          (and (not= ab 0) (= (string-length (pj-zero-ty M S nsn ab)) 0)) ""
          :else (string-concat ps (string-concat " " (string-concat r (string-concat " " body)))))))

;; the record types of the signature of clause f, added to ids
(defn- pj-clause-recs [M :vector-i64 f :i64 ids :string] :string
  (loop [i 0 acc (pj-recs M (pj-sf M (pj-ff M f FF-SYM) SF-ABORT) (pj-recs M (pj-ff M f FF-RTYPE) ids))]   ; LET: + the error type
    (if (>= i (pj-ff M f FF-NPARAMS)) acc (recur (+ i 1) (pj-recs M (pj-pt M f i) acc)))))

;; replace every SEEDSELF in t by q
(defn- pj-subst [t :string q :string] :string
  (let [i (string-index-of t "SEEDSELF")]
    (if (< i 0) t (string-concat (string-substring t 0 i) (string-concat q (pj-subst (string-substring t (+ i 8) (string-length t)) q))))))

;; the first FN clause of the function spelled s in the module in M (S its source), 0 when none
(defn- pj-fn-named [M :vector-i64 S :string s :string] :i64
  (loop [f 1]
    (cond (>= f (vector-at M MM-FN-N)) 0
          (and (or (= (pj-ff M f FF-KIND) FK-DEFN) (= (pj-ff M f FF-KIND) FK-PRIV) (= (pj-ff M f FF-KIND) FK-DEF))
               (= (pj-sf M (pj-ff M f FF-SYM) SF-FN) f)
               (string=? (string-substring S (pj-sf M (pj-ff M f FF-SYM) SF-START) (pj-sf M (pj-ff M f FF-SYM) SF-END)) s)) f
          :else (recur (+ f 1)))))

;; record the interface entry of export s (first clause f0) of module m; base = the module's image offset
(defn- pj-iface-one [M :vector-i64 L :vector-i64 P :string S :string s :string f0 :i64] :string
  (let [e (pj-l L pj-k-nif)
        sym (pj-ff M f0 FF-SYM)
        base (pj-l L pj-k-base)
        nsn (pj-p L P (pj-mf L (pj-l L pj-k-errmod) pj-mf-name))
        ncl (loop [f f0 k 0] (if (and (< f (vector-at M MM-FN-N)) (= (pj-ff M f FF-SYM) sym) (not= (pj-ff M f FF-KIND) FK-DEF)) (recur (+ f 1) (+ k 1)) k))
        txt (loop [k 0 acc ""]
              (cond (>= k ncl) acc
                    (= (string-length (pj-clause-text M S nsn (+ f0 k))) 0) ""
                    (= ncl 1) (pj-clause-text M S nsn f0)
                    :else (recur (+ k 1) (string-concat acc (string-concat " (" (string-concat (pj-clause-text M S nsn (+ f0 k)) ")"))))))
        sch (pj-schemas M S nsn (loop [k 0 ids ""] (if (>= k ncl) ids (recur (+ k 1) (pj-clause-recs M (+ f0 k) ids)))))]
    (cond (or (= ncl 0) (= (pj-ff M f0 FF-KIND) FK-DEF)) (let [w (pj-err-span M E-PROJ-EXPORT-FN (pj-sf M sym SF-START) (pj-sf M sym SF-START) (pj-sf M sym SF-END))] P)
          (or (> ncl pj-if-maxcl) (= (string-length txt) 0) (string=? sch "\n")) (let [w (pj-err-span M E-PROJ-IFACE (pj-sf M sym SF-START) (pj-sf M sym SF-START) (pj-sf M sym SF-END))] P)
          (>= e pj-i-cap) (let [w (pj-err M E-PROJ-EDGES 0)] P)
          (>= (- e (pj-mf L (pj-l L pj-k-errmod) pj-mf-if0)) 4095) (let [w (pj-err M E-PROJ-EDGES 0)] P)   ; LINK: S lines code entry < 4096
          :else (let [w (-> L (pj-iset e pj-if-name (pj-n L)) (pj-iset e pj-if-text (+ (pj-n L) 1)) (pj-iset e pj-if-sch (+ (pj-n L) 2))
                            (pj-iset e pj-if-ncl ncl) (pj-ls pj-k-nif (+ e 1)))
                      w2 (loop [k 0] (if (>= k ncl) 0 (let [x (pj-iset L e (+ pj-if-off0 k) (+ base (* (- (pj-ff M (+ f0 k) FF-CODE) 1) 4)))] (recur (+ k 1)))))]
                  (pj-padd L (pj-padd L (pj-padd L P s) txt) sch)))))

;; the interface of library module m (compiled, still in M; S = its source with the trailer)
(defn- pj-iface [M :vector-i64 L :vector-i64 P :string S :string m :i64] :string
  (let [w (-> L (pj-mset m pj-mf-if0 (pj-l L pj-k-nif)))
        P2 (if (> (pj-mf L m pj-mf-expk) 0)
             (loop [k 0 P P]
               (cond (or (>= k (pj-mf L m pj-mf-nexp)) (not (pj-ok M))) P
                     :else (let [s (pj-p L P (pj-l L (+ pj-x-base (pj-mf L m pj-mf-exp0) k)))
                                 f (pj-fn-named M S s)]
                             (if (= f 0)
                               (let [w2 (pj-err-span M E-PROJ-EXPORT-FN -1 0 0)] P)
                               (recur (+ k 1) (pj-iface-one M L P S s f))))))
             (loop [f 1 P P]
               (cond (or (>= f (vector-at M MM-FN-N)) (not (pj-ok M))) P
                     (and (= (pj-ff M f FF-KIND) FK-DEFN) (= (pj-sf M (pj-ff M f FF-SYM) SF-FN) f))
                     (recur (+ f 1) (pj-iface-one M L P S (string-substring S (pj-sf M (pj-ff M f FF-SYM) SF-START) (pj-sf M (pj-ff M f FF-SYM) SF-END)) f))
                     :else (recur (+ f 1) P))))]
    (let [w3 (pj-mset L m pj-mf-nif (- (pj-l L pj-k-nif) (pj-mf L m pj-mf-if0)))] P2)))

;; the interface entry of module t named s, -1 when none
(defn- pj-if-find [L :vector-i64 P :string t :i64 s :string] :i64
  (let [e0 (pj-mf L t pj-mf-if0) n (pj-mf L t pj-mf-nif)]
    (loop [k 0]
      (cond (>= k n) -1
            (pj-peq L P (pj-if L (+ e0 k) pj-if-name) s) (+ e0 k)
            :else (recur (+ k 1))))))

;; ---- the trailer ---------------------------------------------------------------------------------------------------------
;; the stub of interface entry e named q; its clause targets are appended to the T table
(defn- pj-stub [L :vector-i64 P :string e :i64 q :string r :i64] :string
  (let [ncl (pj-if L e pj-if-ncl)
        k0 (pj-min (pj-l L pj-k-nstub) (- pj-t-cap pj-if-maxcl))
        el (- e (pj-mf L (pj-rf L r pj-rf-mod) pj-mf-if0))
        w (loop [k 0]
            (if (>= k ncl) 0
              (let [x (pj-ls L (+ pj-t-base k0 k) (pj-if L e (+ pj-if-off0 k)))
                    y (pj-ls L (+ pj-u-base k0 k) (+ (* (+ (* (- r (pj-mf L (pj-l L pj-k-errmod) pj-mf-req0)) 4096) el) 8) k))]
                (recur (+ k 1)))))
        w2 (pj-ls L pj-k-nstub (+ k0 ncl))]
    (string-concat "(defn- " (string-concat q (string-concat " " (string-concat (pj-subst (pj-p L P (pj-if L e pj-if-text)) q) ")\n"))))))

;; Long texts are built with two accumulators (big, small): a piece is appended to small, and small (at most about 4 KiB) to
;; big, so a byte is copied a few times, not once per later piece (strings are never freed: KEXE_STRING_POOL), and no list
;; is built (every typed-list-conj is a new loader vector: KEXE_VECTORS).
(defn- pj-small [small :string p :string] :string (string-concat small p))

;; the stubs of require edge r
(defn- pj-stubs-req [L :vector-i64 P :string r :i64] :string
  (let [t (pj-rf L r pj-rf-mod)
        al (pj-rf L r pj-rf-alias)
        e0 (pj-mf L t pj-mf-if0)
        na (if (< al 0) 0 (pj-mf L t pj-mf-nif))
        f0 (pj-rf L r pj-rf-ref0)
        n (+ na (pj-rf L r pj-rf-nref))]
    (loop [k 0 big "" small ""]
      (if (>= k n)
        (string-concat big small)
        (let [p (if (< k na)
                  (pj-stub L P (+ e0 k) (string-concat (pj-p L P al) (string-concat "/" (pj-p L P (pj-if L (+ e0 k) pj-if-name)))) r)
                  (let [s (pj-p L P (pj-l L (+ pj-f-base (* (+ f0 (- k na)) pj-f-w))))
                        e (pj-if-find L P t s)]
                    (if (< e 0) "" (pj-stub L P e s r))))
              s2 (pj-small small p)]
          (if (> (string-length s2) 4096) (recur (+ k 1) (string-concat big s2) "") (recur (+ k 1) big s2)))))))

;; R6A: acc with the schema pieces of text t ("\t:kw [..]" pieces) that acc does not hold yet
(defn- pj-sch-merge [acc :string t :string] :string
  (loop [i 0 acc acc]
    (if (>= i (string-length t))
      acc
      (let [j (loop [j (+ i 1)] (cond (>= j (string-length t)) j (= (string-code-point-at t j) 9) j :else (recur (+ j 1))))
            pc (string-substring t i j)]
        (recur j (if (>= (string-index-of acc pc) 0) acc (string-concat acc pc)))))))

;; R6A: acc with the schemas of the interface entries require edge r stubs (as pj-stubs-req chooses them)
(defn- pj-sch-req [L :vector-i64 P :string r :i64 acc :string] :string
  (let [t (pj-rf L r pj-rf-mod)
        al (pj-rf L r pj-rf-alias)
        e0 (pj-mf L t pj-mf-if0)
        na (if (< al 0) 0 (pj-mf L t pj-mf-nif))
        f0 (pj-rf L r pj-rf-ref0)
        n (+ na (pj-rf L r pj-rf-nref))]
    (loop [k 0 acc acc]
      (if (>= k n)
        acc
        (let [e (if (< k na) (+ e0 k) (pj-if-find L P t (pj-p L P (pj-l L (+ pj-f-base (* (+ f0 (- k na)) pj-f-w))))))]
          (recur (+ k 1) (if (< e 0) acc (pj-sch-merge acc (pj-p L P (pj-if L e pj-if-sch))))))))))

;; the trailer of module m: the replacement ns form, then its import stubs. R6A: the ns form carries (:schemas {..}) with the
;; module's own schema entries (its :schemas clause or :kotoba/schemas attribute, verbatim) and the schemas of the records its
;; imports' signatures reach; 21-check registers both and refuses one name with two different definitions (E2128)
(defn- pj-trailer [L :vector-i64 P :string m :i64] :string
  (let [w (pj-ls L pj-k-nstub 0)
        r0 (pj-mf L m pj-mf-req0)
        body (loop [k 0 big ""]
               (if (>= k (pj-mf L m pj-mf-nreq)) big (recur (+ k 1) (string-concat big (pj-stubs-req L P (+ r0 k))))))
        imp (loop [k 0 acc ""]
              (if (>= k (pj-mf L m pj-mf-nreq)) acc (recur (+ k 1) (pj-sch-req L P (+ r0 k) acc))))
        own (if (< (pj-mf L m pj-mf-sch) 0) "" (pj-p L P (pj-mf L m pj-mf-sch)))
        ;; the imported schemas first: a conflict is then reported at the module's own declaration (pj-module maps the
        ;; position of the copy back to the module's source)
        sc (if (= (+ (string-length own) (string-length imp)) 0) ""
             (string-concat " (:schemas {" (string-concat imp (string-concat " " (string-concat own "})")))))
        ;; the module's own name: a record's identity keyword is :<ns>/<Name> (21-check)
        hn (string-concat "\n(ns " (pj-p L P (pj-mf L m pj-mf-name)))
        hd (cond (= (pj-mf L m pj-mf-entry) 0) (string-concat hn " (:export [])")
                 (= (pj-mf L m pj-mf-expk) 0) hn
                 :else (loop [k 0 acc (string-concat hn " (:export [")]
                         (if (>= k (pj-mf L m pj-mf-nexp)) (string-concat acc "])")
                           (recur (+ k 1) (string-concat acc (string-concat " " (pj-p L P (pj-l L (+ pj-x-base (pj-mf L m pj-mf-exp0) k)))))))))
        w2 (-> L (pj-ls pj-k-owncpy (if (= (string-length own) 0) -1 (+ (string-length hd) 13 (string-length imp))))
               (pj-ls pj-k-ownlen (string-length own)))]
    (string-concat hd (string-concat sc (string-concat ")\n" body)))))

;; ---- per-module checks on the read source (before 20-names) --------------------------------------------------------------
;; the require edge of module m whose alias is a, -1 when none
(defn- pj-req-alias [L :vector-i64 P :string m :i64 a :string] :i64
  (let [r0 (pj-mf L m pj-mf-req0)]
    (loop [k 0]
      (cond (>= k (pj-mf L m pj-mf-nreq)) -1
            (and (>= (pj-rf L (+ r0 k) pj-rf-alias) 0) (pj-peq L P (pj-rf L (+ r0 k) pj-rf-alias) a)) (+ r0 k)
            :else (recur (+ k 1))))))

;; byte offset of the first '/' in S[a,b) after its first byte, -1 when none
(defn- pj-slash [S :string a :i64 b :i64] :i64
  (loop [i (+ a 1)]
    (cond (>= i (- b 1)) -1
          (= (string-code-point-at S i) 47) i
          :else (recur (+ i 1)))))

;; every symbol token alias/name of the module's own text: alias required, name an export of it
(defn- pj-qscan [M :vector-i64 L :vector-i64 P :string S :string m :i64] :vector-i64
  (let [trail (pj-l L pj-k-trail)]
    (loop [t 1]
      (if (or (>= t (vector-at M MM-TOK-N)) (not (pj-ok M)) (>= (pj-tf M t TF-START) trail))
        M
        (let [a (pj-tf M t TF-START) b (pj-tf M t TF-END)
              sl (if (= (pj-tf M t TF-KIND) TK-SYM) (pj-slash S a b) -1)]
          (if (< sl 0)
            (recur (+ t 1))
            (let [r (pj-req-alias L P m (string-substring S a sl))]
              (cond (pj-r5b-with? M S t) (recur (+ t 1))   ; R5B: (with l/h ..) is refused by 21-check (handle shape)
                    ;; R6A: clojure.core/f is the core name f (the token is narrowed to it)
                    (pj-span= S a sl "clojure.core") (let [w (vector-assoc! M (+ MM-TOK-BASE (* t MM-TOK-W) TF-START) (+ sl 1))] (recur (+ t 1)))
                    ;; R6B: a friendly capability name of the catalogue (hash/sha256 ..) is 21-check's (ck-r6b-cap)
                    (and (< r 0) (pos? (ck-r6b-capwire (nm-hash S a b)))) (recur (+ t 1))
                    (< r 0) (pj-err-span M E-PROJ-UNKNOWN-OP a a b)
                    (< (pj-if-find L P (pj-rf L r pj-rf-mod) (string-substring S (+ sl 1) b)) 0) (pj-err-span M E-PROJ-NOT-EXPORT a a b)
                    :else (recur (+ t 1))))))))))

;; ==== R6A: project-route normalization of a module's own forms (before 20-names) ==========================================
;; The reference's top-level shapes that the seed's front end does not read yet, rewritten in the tree (no text change):
;;   (defn NAME "doc" ..) / (defn- ..) / (def NAME "doc" value): the docstring is unlinked (a def keeps a string VALUE: only
;;   a string followed by another child is a docstring), then a defn's attr-map {..} likewise;
;;   a top-level `nil` (what #?(:kotoba nil :default ..) reads as) is unlinked.
;; The single-module route still refuses these (20-names/21-check owners: CONTRACT-REQUESTS 2026-10-03 R6A).
(defn- pj-unlink-after [M :vector-i64 n :i64 prev :i64] :vector-i64
  (let [x (pj-next M prev)]
    (-> M (pj-nset prev NF-NEXT (pj-next M x)) (pj-nset n NF-AUX (- (pj-nf M n NF-AUX) 1)))))
(defn- pj-strip-doc [M :vector-i64 S :string n :i64] :vector-i64
  (let [nm (pj-next M (pj-first M n))
        d (pj-next M nm)
        dn (pj-next M d)
        defn? (or (pj-head? M S n "defn") (pj-head? M S n "defn-"))
        M1 (if (and (or defn? (pj-head? M S n "def")) (= (pj-kind M d) ND-STR) (not= dn 0)) (pj-unlink-after M n nm) M)
        a (pj-next M1 nm)]
    (if (and defn? (= (pj-kind M1 a) ND-MAP) (not= (pj-next M1 a) 0)) (pj-unlink-after M1 n nm) M1)))
(defn- pj-norm [M :vector-i64 L :vector-i64 S :string] :vector-i64
  (let [root (vector-at M MM-ROOT)
        trail (pj-l L pj-k-trail)]
    (loop [n (pj-first M root) prev 0]
      (cond (or (= n 0) (>= (pj-a M n) trail)) M
            (and (= (pj-kind M n) ND-SYM) (pj-is M S n "nil"))
            (let [w (if (= prev 0) (pj-nset M root NF-FIRST (pj-next M n)) (pj-nset M prev NF-NEXT (pj-next M n)))
                  w2 (pj-nset M root NF-AUX (- (pj-nf M root NF-AUX) 1))]
              (recur (pj-next M n) prev))
            (= (pj-kind M n) ND-LIST) (let [w (pj-strip-doc M S n)] (recur (pj-next M n) n))
            :else (recur (pj-next M n) n)))))
;; ==== END R6A normalization ================================================================================================

;; every referred name of module m is an export of its module
(defn- pj-refcheck [M :vector-i64 L :vector-i64 P :string m :i64] :vector-i64
  (let [r0 (pj-mf L m pj-mf-req0)]
    (loop [k 0]
      (if (or (>= k (pj-mf L m pj-mf-nreq)) (not (pj-ok M)))
        M
        (let [r (+ r0 k)
              bad (loop [j 0]
                    (cond (>= j (pj-rf L r pj-rf-nref)) -1
                          (< (pj-if-find L P (pj-rf L r pj-rf-mod) (pj-p L P (pj-l L (+ pj-f-base (* (+ (pj-rf L r pj-rf-ref0) j) pj-f-w))))) 0)
                          (+ pj-f-base (* (+ (pj-rf L r pj-rf-ref0) j) pj-f-w))
                          :else (recur (+ j 1))))]
          (if (< bad 0)
            (recur (+ k 1))
            (pj-err-span M E-PROJ-NOT-EXPORT (pj-l L (+ bad 1)) (pj-l L (+ bad 1)) (pj-l L (+ bad 2)))))))))

;; the trailer's ns form replaces the module's own (the first top-level form)
(defn- pj-splice [M :vector-i64 L :vector-i64] :vector-i64
  (let [root (vector-at M MM-ROOT)
        orig (pj-first M root)
        trail (pj-l L pj-k-trail)
        synth (loop [n orig] (cond (= n 0) 0 (>= (pj-a M n) trail) n :else (recur (pj-next M n))))
        pred (loop [n orig] (cond (= n 0) 0 (= (pj-next M n) synth) n :else (recur (pj-next M n))))
        u1 (pj-next M orig)]
    (cond (= synth 0) (pj-err M E-PROJ-NS 0)
          (= u1 synth) (-> M (pj-nset root NF-FIRST synth) (pj-nset root NF-AUX (- (pj-nf M root NF-AUX) 1)))
          :else (-> M (pj-nset pred NF-NEXT (pj-next M synth)) (pj-nset synth NF-NEXT u1) (pj-nset root NF-FIRST synth)
                    (pj-nset root NF-AUX (- (pj-nf M root NF-AUX) 1))))))

;; ==== R6D (agent R6D, 2026-10-03): one keyword text table per link (21-check ck-r6b-lib-t) =================================
;; The entry module's library gets the union of the spellings of every module of the link (in process: the modules in compile
;; order, read again; separate mode: the cumulative "K <flag> <union>" lines of its requires' objects) when any module of the
;; link has a keyword table; after the link the first instruction of each library's __r6-kwtab is patched into `b` to the
;; entry's (separate mode: the objects' "W <offset>" lines). Both routes build the same table and image.
(def pj-mf-kwt 15)   ; address + 1 of the module's __r6-kwtab (in process: in the image; separate mode: in its blob), 0 = none
(def pj-mf-kwu 18)   ; separate mode, a loaded dependency: P index + 1 of its object's K union (0 = none)
(def pj-mf-kwf 19)   ; separate mode, a loaded dependency: 1 when a module of its closure has a keyword table
(def pj-k-kwk 37)    ; separate mode: P index of module 0's "K .." line
(defn- pj-kw-h [] :i64 (nm-hash "__r6-kwtab" 0 10))
;; the cumulative union of module m (source S0): the modules compiled before it (in process) or its requires' K unions
;; (separate mode), then its own spellings
(defn- pj-kw-union [M :vector-i64 L :vector-i64 P :string m :i64 S0 :string] :string
  (let [U (if (= (pj-l L pj-k-mode) 1)
            (let [r0 (pj-mf L m pj-mf-req0)]
              (loop [k 0 U (ck-r6b-kwtab "")]
                (if (>= k (pj-mf L m pj-mf-nreq))
                  U
                  (let [u (pj-mf L (pj-rf L (+ r0 k) pj-rf-mod) pj-mf-kwu)]
                    (recur (+ k 1) (if (> u 0) (ck-r6b-kwmerge U (pj-p L P (- u 1))) U))))))
            (loop [k 0 U (ck-r6b-kwtab "")]
              (if (>= k (pj-l L pj-k-nord))
                U
                (let [d (pj-l L (+ pj-o-base k))]
                  (if (= d m) U (recur (+ k 1) (ck-r6b-kwmerge U (ck-r6b-kwtab (pj-src M L P d)))))))))]
    (ck-r6b-kwmerge U (ck-r6b-kwtab S0))))
;; a module of m's link closure (m itself: its text S0) has a keyword table
(defn- pj-kw-any? [L :vector-i64 m :i64 S0 :string] :bool
  (or (ck-r6b-needs-kw? S0)
      (if (= (pj-l L pj-k-mode) 1)
        (let [r0 (pj-mf L m pj-mf-req0)]
          (loop [k 0] (cond (>= k (pj-mf L m pj-mf-nreq)) false (= (pj-mf L (pj-rf L (+ r0 k) pj-rf-mod) pj-mf-kwf) 1) true :else (recur (+ k 1)))))
        (loop [k 0]
          (if (>= k (pj-l L pj-k-nord))
            false
            (let [d (pj-l L (+ pj-o-base k))]
              (cond (= d m) false (> (pj-mf L d pj-mf-kwt) 0) true :else (recur (+ k 1)))))))))
;; the keyword table text for module m's library: "" (its own) unless m is the entry of a link with a keyword table
(defn- pj-kw-table [M :vector-i64 L :vector-i64 P :string m :i64 S0 :string] :string
  (if (and (= (pj-mf L m pj-mf-entry) 1) (pj-kw-any? L m S0)) (pj-kw-union M L P m S0) ""))
;; after module m compiled (M holds it, base = its image base): record its __r6-kwtab
(defn- pj-kw-note [M :vector-i64 L :vector-i64 m :i64] :vector-i64
  (let [f (ck-r6b-fn M (pj-kw-h))
        fc (if (> f 0) (pj-ff M f FF-CODE) 0)]
    (pj-mset L m pj-mf-kwt (if (> fc 0) (+ (pj-l L pj-k-base) (* (- fc 1) 4) 1) 0))))
;; after the link: every library's __r6-kwtab -> `b` the entry's (module 0)
(defn- pj-kw-patch [L :vector-i64] :vector-i64
  (let [t (pj-mf L 0 pj-mf-kwt)]
    (if (= t 0)
      L
      (loop [m 1]
        (if (>= m (pj-l L pj-k-nmod))
          L
          (let [a (pj-mf L m pj-mf-kwt)
                x (if (> a 0) (pj-put32 L (- a 1) (bit-or 335544320 (bit-and (quot (- t a) 4) 67108863))) L)]
            (recur (+ m 1))))))))
;; separate mode: dependency d's K line in object text T
(defn- pj-kw-load [L :vector-i64 P :string T :string d :i64] :string
  (loop [i 0]
    (cond (>= i (string-length T)) P
          (and (= (string-code-point-at T i) 75) (< (+ i 3) (string-length T)) (= (string-code-point-at T (+ i 1)) 32))   ; not KSEEDO1
          (let [w (-> L (pj-mset d pj-mf-kwf (- (string-code-point-at T (+ i 2)) 48)) (pj-mset d pj-mf-kwu (+ (pj-n L) 1)))]
            (pj-padd L P (string-substring T (+ i 4) (pj-eol T i))))
          :else (recur (+ (pj-eol T i) 1)))))
;; separate mode: the K and W lines of module 0 (compiled, still in M; S0 = its source text)
(defn- pj-kw-lines [M :vector-i64 L :vector-i64 P :string S0 :string] :string
  (let [k (string-concat "K " (string-concat (if (pj-kw-any? L 0 S0) "1 " "0 ") (string-concat (pj-kw-union M L P 0 S0) "\n")))
        t (pj-mf L 0 pj-mf-kwt)]
    (if (> t 0) (string-concat k (pj-line "W" (mem-u2dec (- t 1)))) k)))
;; ==== END R6D ================================================================================================================

;; ---- R6D: namespace templates with default instantiation ------------------------------------------------------------------
;; (:params [p1 T1 p2 T2 ..]) / {:kotoba/params [..]}: every parameter must carry its default type form (clojure.set's
;; [elem :keyword]); an importer's plain require is the default instantiation (the reference's reading: a :require without
;; :with). The module is compiled from its text with every symbol token spelled like a parameter (outside strings, comments
;; and keywords) replaced by the default's text. `:with` (another instantiation) stays E6023, as does a parameter without a
;; default. Positions in a refusal refer to the instantiated text.
(def pj-mf-tpl 20)   ; P index + 1 of the module's " name type\n" substitution lines (0 = not a template)
(defn- pj-tpl-params [M :vector-i64 L :vector-i64 P :string S :string v :i64 k :i64] :string
  (let [cur (pj-l L pj-k-errmod)
        n (if (= (pj-kind M v) ND-VEC) (nm-count M v) -1)]
    (if (or (< n 2) (not= (bit-and n 1) 0))
      (let [w (pj-err M E-PROJ-TEMPLATE k)] P)
      (let [t (loop [c (pj-first M v) acc ""]
                (cond (= c 0) acc
                      (not= (pj-kind M c) ND-SYM) ""
                      :else (let [d (pj-next M c) e (lx-sk-form S (pj-a M d))]
                              (if (< e 0) "" (recur (pj-next M d) (string-concat acc (string-concat " " (string-concat (pj-text M S c) (string-concat " " (string-concat (string-substring S (pj-a M d) e) "\n"))))))))))]
        (if (= (string-length t) 0)
          (let [w (pj-err M E-PROJ-TEMPLATE k)] P)
          (let [w (pj-mset L cur pj-mf-tpl (+ (pj-n L) 1))] (pj-padd L P t)))))))
;; the replacement of symbol S[a, b) in substitution lines T, "" when it is not a parameter
(defn- pj-tpl-find [T :string S :string a :i64 b :i64] :string
  (let [i (string-index-of T (string-concat " " (string-concat (string-substring S a b) " ")))]
    (if (< i 0) "" (let [c (+ i (- b a) 2)] (string-substring T c (pj-eol T c))))))
;; S with the parameters of T replaced
(defn- pj-tpl-subst [S :string T :string] :string
  (let [n (string-length S)]
    (loop [i 0 from 0 acc ""]
      (if (>= i n)
        (string-concat acc (string-substring S from n))
        (let [c (string-code-point-at S i)]
          (cond (= c 59) (recur (lx-eol S i) from acc)
                (= c 34) (recur (ck-r6b-strend S i) from acc)
                (= c 92) (recur (ck-r6b-charend S i) from acc)
                (= c 58) (recur (ck-r6b-symend S (+ i 1)) from acc)
                (lx-symch? c) (let [b (ck-r6b-symend S i) r (pj-tpl-find T S i b)]
                                (if (= (string-length r) 0) (recur b from acc) (recur b b (string-concat acc (string-concat (string-substring S from i) r)))))
                :else (recur (+ i (lx-cpw c)) from acc)))))))
;; the source text of module m (read from its path; a template instantiated)
(defn- pj-src [M :vector-i64 L :vector-i64 P :string m :i64] :string
  (let [S (io-read-file M (pj-p L P (pj-mf L m pj-mf-path)))
        t (pj-mf L m pj-mf-tpl)]
    (if (> t 0) (pj-tpl-subst S (pj-p L P (- t 1))) S)))

;; ---- compile one module and link it ---------------------------------------------------------------------------------------
;; LINK: at = an image byte offset (was a word index of L)
(defn- pj-put32 [L :vector-i64 at :i64 w :i64] :vector-i64
  (-> L (pj-ibset at (bit-and w 255)) (pj-ibset (+ at 1) (bit-and (u64-shift-right w 8) 255))
      (pj-ibset (+ at 2) (bit-and (u64-shift-right w 16) 255)) (pj-ibset (+ at 3) (bit-and (u64-shift-right w 24) 255))))

;; copy the blob OUT[1 .. n] to the image at base, then patch every stub clause into `b <target>`
(defn- pj-link [M :vector-i64 L :vector-i64] :vector-i64
  (let [n (- (vector-at M MM-OUT-N) 1)
        base (pj-l L pj-k-base)
        w (loop [i 0] (if (>= i n) 0 (let [x (pj-ibset L (+ base i) (vector-at M (+ MM-OUT-BASE 1 i)))] (recur (+ i 1)))))   ; LINK
        s0 (pj-l L pj-k-stub0)
        w2 (loop [k 0]
             (if (or (>= k (pj-l L pj-k-nstub)) (= (pj-l L pj-k-mode) 1)) 0
               (let [fc (pj-ff M (+ s0 k) FF-CODE)
                     at (+ base (* (- fc 1) 4))
                     d (quot (- (pj-l L (+ pj-t-base k)) at) 4)
                     x (if (> fc 0) (pj-put32 L at (bit-or 335544320 (bit-and d 67108863))) L)]
                 (recur (+ k 1)))))]
    (let [w3 (pj-ls L pj-k-img (+ base n))] M)))

;; LINK: the blob must fit the image before it is copied (E-PROJ-IMAGE by name)
(defn- pj-c5 [M :vector-i64 L :vector-i64] :vector-i64
  (let [M1 (ly-run (mem-set M (ly-base-slot) (pj-l L pj-k-base)))]
    (if (pj-ok M1)
      (let [M2 (out-blob M1)]
        (cond (not (pj-ok M2)) M2
              (> (+ (pj-l L pj-k-base) (- (vector-at M2 MM-OUT-N) 1)) pj-img-cap) (pj-err M2 E-PROJ-IMAGE 0)
              :else (pj-link M2 L)))
      M1)))
(defn- pj-c4 [M :vector-i64 L :vector-i64 S :string H :vector-i64] :vector-i64
  (let [M1 (ck-run-h M S H)]   ; R6C: with the parameter refinements so far
    (if (pj-ok M1)
      (let [M2 (lw-run M1)] (if (pj-ok M2) (let [M3 (gn-run-open M2 (pj-l L pj-k-stub0) (pj-l L pj-k-nstub))] (if (pj-ok M3) (pj-c5 M3 L) M3)) M2))
      M1)))
(defn- pj-c3 [M :vector-i64 L :vector-i64 S :string H :vector-i64] :vector-i64
  (let [M1 (nm-run M S)]
    (if (pj-ok M1)
      (let [w (pj-ls L pj-k-stub0 (- (vector-at M1 MM-FN-N) (pj-l L pj-k-nstub)))] (pj-c4 M1 L S H))
      M1)))

;; R6A: an error inside the trailer's copy of the module's own schema text is moved to the original text
(defn- pj-back1 [M :vector-i64 i :i64 c0 :i64 c1 :i64 d :i64] :vector-i64
  (let [v (vector-at M i)] (if (and (>= v c0) (<= v c1) (> d 0)) (vector-assoc! M i (- v d)) M)))
(defn- pj-err-back [M :vector-i64 L :vector-i64 m :i64 n0 :i64] :vector-i64
  (let [cp (pj-l L pj-k-owncpy)
        c0 (+ n0 cp)
        c1 (+ c0 (pj-l L pj-k-ownlen))
        d (- c0 (pj-mf L m pj-mf-sche))]
    (if (or (< cp 0) (< (vector-at M MM-ERR-POS) c0) (> (vector-at M MM-ERR-POS) c1))
      M
      (-> M (pj-back1 MM-ERR-POS c0 c1 d) (pj-back1 MM-ERR-A c0 c1 d) (pj-back1 MM-ERR-B c0 c1 d)))))

;; compile module m (its source text read from its path) and link it into the image. Returns P (a library adds its
;; interface strings). On return M still holds module m (the entry: its EXP table for the container).
(defn- pj-module [M :vector-i64 L :vector-i64 P :string m :i64] :string (pj-module-h M L P m (ck-hint-new)))
;; R6C: H = the parameter refinements so far (21-check ck-hint-*); a check that asks for a new one compiles the module again
(defn- pj-module-h [M :vector-i64 L :vector-i64 P :string m :i64 H :vector-i64] :string
  (let [S0 (pj-src M L P m)   ; R6D: a template's text with its parameters instantiated
        T (pj-trailer L P m)
        ;; R6B: the source library the module spells. R6C: BEFORE the trailer (was after it): the stub clauses of the trailer
        ;; must be the LAST FN records (pj-c3 takes stub0 = FN-N - nstub), else an importer that also gets a library group
        ;; patched its library functions as stubs (measured: r6-diff driver of kotoba.compiler.decimal-text looped)
        S1 (string-concat S0 (ck-r6b-lib-t S0 (pj-kw-table M L P m S0)))   ; R6D: the entry of a link gets the link's keyword table
        S (string-concat S1 T)
        base (bit-and (+ (pj-l L pj-k-img) 7) -8)
        w (-> L (pj-ls pj-k-errmod m) (pj-ls pj-k-trail (string-length S1)) (pj-ls pj-k-base base) (pj-mset m pj-mf-base base))
        M1 (pj-read M S)
        M2 (if (pj-ok M1) (pj-refcheck (pj-qscan (pj-norm M1 L S) L P S m) L P m) M1)
        M3 (if (pj-ok M2) (pj-splice M2 L) M2)
        M4 (if (pj-ok M3) (pj-c3 M3 L S H) M3)
        w9 (if (pj-ok M4) (pj-kw-note M4 L m) L)]   ; R6D
    (cond (ck-hint-again? H M4) (pj-module-h M4 L P m H)   ; R6C
          (not (pj-ok M4)) (let [w2 (pj-err-back M4 L m (string-length S1))] P)   ; R6C: the trailer starts after the library
          (>= (pj-n L) (- pj-s-cap 1)) (let [w2 (pj-err M4 E-PROJ-IMAGE 0)] P)
          (not (pj-ok (pj-r5b-after M4 L P S m))) P   ; R5B: namespace :capabilities, stateful library exports
          (> (pj-l L pj-k-img) pj-img-cap) (let [w2 (pj-err M4 E-PROJ-IMAGE 0)] P)   ; LINK
          (= (pj-mf L m pj-mf-entry) 0) (pj-iface M4 L P S m)
          :else P)))

;; ---- the whole project ---------------------------------------------------------------------------------------------------
;; pj-discover M L P root -> P : the module table and the compile order from the entry (module 0, path P[root])
(defn- pj-discover [M :vector-i64 L :vector-i64 P :string root :i64] :string
  (let [w (-> L (pj-add-mod (pj-n L) root) (pj-mset 0 pj-mf-depth 1) (pj-mset 0 pj-mf-entry 1))
        P1 (pj-visit M L (pj-padd L P "") 0)]
    (if (and (pj-ok M) (> (pj-l L pj-k-nmod) 1) (= (pj-l L pj-k-unpinned) 0))
      (let [w2 (pj-err M E-PROJ-UNPINNED 0)] P1)
      P1)))

;; pj-project M L P root -> P : discover, then compile every module in order. On success M holds the entry module; the image
;; is the packed L[pj-img-base ..], L[pj-k-img] bytes (LINK). A multi-module project needs --unpinned.
(defn- pj-project [M :vector-i64 L :vector-i64 P :string root :i64] :string
  (let [P1 (pj-discover M L P root)]
    (loop [k 0 P P1]
      (if (or (>= k (pj-l L pj-k-nord)) (not (pj-ok M)))
        (let [w (if (pj-ok M) (pj-kw-patch L) L)] P)   ; R6D
        (recur (+ k 1) (pj-module M L P (pj-l L (+ pj-o-base k))))))))

;; the source path of the module the error of M refers to
(defn- pj-err-path [L :vector-i64 P :string] :string (pj-p L P (pj-mf L (pj-l L pj-k-errmod) pj-mf-path)))

;; 1 when a symbol token of S is spelled alias/name
(defn- pj-qualified? [M :vector-i64 S :string] :bool
  (loop [t 1]
    (cond (>= t (vector-at M MM-TOK-N)) false
          (and (= (pj-tf M t TF-KIND) TK-SYM) (>= (pj-slash S (pj-tf M t TF-START) (pj-tf M t TF-END)) 0)) true
          :else (recur (+ t 1)))))

;; 1 when the entry (read into M from S) needs the project route: its ns form has a clause 20-names does not read, or it
;; spells a qualified symbol (refused there by name: E6010 / E6004)
(defn- pj-needed [M :vector-i64 S :string] :i64
  (let [ns (pj-first M (vector-at M MM-ROOT))]
    (cond
      (not (pj-head? M S ns "ns")) 0
      (pj-qualified? M S) 1
      :else
      (loop [c (pj-next M (pj-next M (pj-first M ns)))]
        (cond (= c 0) 0
              (and (= (pj-kind M c) ND-LIST) (= (pj-kind M (pj-first M c)) ND-KW) (pj-is M S (pj-first M c) ":export")) (recur (pj-next M c))
              ;; R4B (agent R4B, coordinated in CONTRACT-REQUESTS): 20-names reads one (:schemas {..}) clause too
              (and (= (pj-kind M c) ND-LIST) (= (pj-kind M (pj-first M c)) ND-KW) (pj-is M S (pj-first M c) ":schemas")) (recur (pj-next M c))
              :else 1)))))

;; ==== separate mode (design 3.3, option C): module objects and `seed link` ================================================
;;   seed compile <file> --emit-module [--entry] --object-dir O --output <x.kso>
;;       compiles ONE module against the interfaces in O/<dep>.kso of its requires (they must exist: emit dependencies
;;       first, `seed modules` prints the order) and writes its object. --entry: it is the project's entry (its exports are
;;       the container's, the root rules apply); otherwise a library.
;;   seed link <root.kso> --object-dir O --output <x>
;;       loads the root object and, depth first, every required object from O (cycle, depth and module bounds as in
;;       discovery), lays the blobs out in post-order at 8-aligned bases, relocates the literal loads (L lines), patches the
;;       stub clauses (S lines) and writes the KSEED1 container with the root's exports (X lines). The image is the one the
;;       in-process route builds (same order, bases and patches).
;; Object (KSEEDO1, ASCII text, one record per line; offsets are relative to the module's blob):
;;   KSEEDO1 / N <ns> / R <required ns> (edge order) / E <clauses> <off>.. <name> <stub template> (interface, libraries) /
;;   S <stub clause offset> <(edge * 4096 + dependency entry) * 8 + clause> / L <movz offset> / X <name> <offset> <arity>
;;   (the entry) / C <hex of up to 64 blob bytes> ..
(defn- pj-eol [T :string i :i64] :i64
  (loop [j i] (cond (>= j (string-length T)) j (= (string-code-point-at T j) 10) j :else (recur (+ j 1)))))
(defn- pj-sp [T :string i :i64] :i64
  (loop [j i] (cond (>= j (string-length T)) j (= (string-code-point-at T j) 10) j (= (string-code-point-at T j) 32) j :else (recur (+ j 1)))))
(defn- pj-dec [T :string a :i64 b :i64] :i64
  (loop [j a v 0] (if (>= j b) v (recur (+ j 1) (+ (* v 10) (- (string-code-point-at T j) 48))))))
(defn- pj-hexv [c :i64] :i64 (if (< c 58) (- c 48) (- c 87)))

(defn- pj-line [k :string a :string] :string (string-concat k (string-concat " " (string-concat a "\n"))))

;; the E line of interface entry e
(defn- pj-eline [L :vector-i64 P :string e :i64] :string
  (let [offs (loop [j 0 acc ""]
               (if (>= j (pj-if L e pj-if-ncl)) acc (recur (+ j 1) (string-concat acc (string-concat (mem-u2dec (pj-if L e (+ pj-if-off0 j))) " ")))))]
    (pj-line "E" (string-concat (mem-u2dec (pj-if L e pj-if-ncl))
                   (string-concat " " (string-concat offs (string-concat (pj-p L P (pj-if L e pj-if-name)) (string-concat " " (string-concat (pj-p L P (pj-if L e pj-if-text)) (pj-p L P (pj-if L e pj-if-sch)))))))))))

;; the hex text of OUT bytes [a, b) (balanced: no list, each byte copied log2(b-a) times)
(defn- pj-hexr [M :vector-i64 a :i64 b :i64] :string
  (cond (>= a b) ""
        (= (+ a 1) b) (io-hex2 (vector-at M (+ MM-OUT-BASE 1 a)))
        :else (let [m (quot (+ a b) 2)] (string-concat (pj-hexr M a m) (pj-hexr M m b)))))

;; the k-th line of section c of module 0's object ("" past the end of the section): 0 R, 1 E, 2 S, 3 L, 4 X, 5 C
(defn- pj-oline [M :vector-i64 L :vector-i64 P :string S :string ck :i64] :string
  (let [c (quot ck 1048576)
        k (bit-and ck 1048575)
        s0 (pj-l L pj-k-stub0)
        fb (+ MM-FIX-BASE (* (+ k 1) MM-FIX-W))
        eb (+ MM-EXP-BASE (* (+ k 1) MM-EXP-W))
        n (- (vector-at M MM-OUT-N) 1)]
    (case c
      0 (pj-line "R" (pj-p L P (pj-rf L (+ (pj-mf L 0 pj-mf-req0) k) pj-rf-name)))
      1 (pj-eline L P (+ (pj-mf L 0 pj-mf-if0) k))
      2 (if (< (pj-ff M (+ s0 k) FF-CODE) 1) ""
          (pj-line "S" (string-concat (mem-u2dec (* (- (pj-ff M (+ s0 k) FF-CODE) 1) 4)) (string-concat " " (mem-u2dec (pj-l L (+ pj-u-base k)))))))
      3 (if (= (vector-at M (+ fb XF-KIND)) FX-LIT32) (pj-line "L" (mem-u2dec (* (- (vector-at M (+ fb XF-AT)) 1) 4))) "")
      4 (let [sym (pj-ff M (vector-at M (+ eb EF-FN)) FF-SYM)]
          (pj-line "X" (string-concat (string-substring S (pj-sf M sym SF-START) (pj-sf M sym SF-END))
                         (string-concat " " (string-concat (mem-u2dec (vector-at M (+ eb EF-OFFSET))) (string-concat " " (mem-u2dec (vector-at M (+ eb EF-ARITY)))))))))
      (pj-line "C" (pj-hexr M (* k 64) (pj-min n (* (+ k 1) 64)))))))

;; the number of lines of section c
(defn- pj-ocount [M :vector-i64 L :vector-i64 c :i64] :i64
  (case c
    0 (pj-mf L 0 pj-mf-nreq)
    1 (pj-mf L 0 pj-mf-nif)
    2 (pj-l L pj-k-nstub)
    3 (- (vector-at M MM-FIX-N) 1)
    4 (- (vector-at M MM-EXP-N) 1)
    (quot (+ (- (vector-at M MM-OUT-N) 1) 63) 64)))

;; the object text of module 0 (compiled with base 0 and recorded patches, still in M; S = its source with the trailer)
(defn- pj-object [M :vector-i64 L :vector-i64 P :string S :string] :string
  (loop [c 0 k 0 big (string-concat "KSEEDO1\n" (string-concat (pj-line "N" (pj-p L P (pj-mf L 0 pj-mf-name))) (pj-p L P (pj-l L pj-k-kwk)))) small ""]   ; R6D: K/W lines
    (cond (> c 5) (string-concat big small)
          (>= k (pj-ocount M L c)) (recur (+ c 1) 0 big small)
          :else (let [s2 (pj-small small (pj-oline M L P S (+ (* c 1048576) k)))]
                  (if (> (string-length s2) 4096) (recur c (+ k 1) (string-concat big s2) "") (recur c (+ k 1) big s2))))))

;; the E lines of object text T (module d) as interface entries, offsets + base
(defn- pj-load-iface [L :vector-i64 P :string T :string d :i64 base :i64] :string
  (let [w (-> L (pj-mset d pj-mf-if0 (pj-l L pj-k-nif)) (pj-mset d pj-mf-nif 0))]
    (loop [i 0 P P]
      (if (>= i (string-length T)) P
        (let [e (pj-eol T i)]
          (if (and (= (string-code-point-at T i) 69) (or (>= (pj-l L pj-k-nif) pj-i-cap) (>= (pj-mf L d pj-mf-nif) 4095)))
            (let [x (pj-ls L pj-k-ifover 1)] (recur (+ e 1) P))   ; LINK: an entry that does not fit is flagged, not dropped silently
          (if (= (string-code-point-at T i) 69)
            (let [x (pj-l L pj-k-nif)
                  a1 (+ i 2) b1 (pj-sp T a1)
                  ncl (pj-min (pj-dec T a1 b1) pj-if-maxcl)
                  nb (loop [j 0 p (+ b1 1)] (if (>= j ncl) p (let [q (pj-sp T p) y (pj-iset L x (+ pj-if-off0 j) (+ base (pj-dec T p q)))] (recur (+ j 1) (+ q 1)))))
                  ne (pj-sp T nb)
                  tb (loop [j (pj-min (+ ne 1) e)] (cond (>= j e) e (= (string-code-point-at T j) 9) j :else (recur (+ j 1))))
                  w2 (-> L (pj-iset x pj-if-name (pj-n L)) (pj-iset x pj-if-text (+ (pj-n L) 1)) (pj-iset x pj-if-sch (+ (pj-n L) 2)) (pj-iset x pj-if-ncl ncl)
                         (pj-ls pj-k-nif (+ x 1)) (pj-mset d pj-mf-nif (+ (pj-mf L d pj-mf-nif) 1)))]
              ;; R6A: the template ends at the first TAB; the schema pieces follow it
              (recur (+ e 1) (pj-padd L (pj-padd L (pj-padd L P (string-substring T nb ne)) (string-substring T (pj-min (+ ne 1) e) tb)) (string-substring T tb e))))
            (recur (+ e 1) P))))))))

;; T starts "KSEEDO1\nN " and its N line is nm ("" = any); the N name
(defn- pj-obj-ok [T :string nm :string] :bool
  (and (> (string-length T) 10) (string=? (string-substring T 0 10) "KSEEDO1\nN ")
       (or (= (string-length nm) 0) (string=? (string-substring T 10 (pj-eol T 10)) nm))))

(defn- pj-objpath [L :vector-i64 P :string nm :string] :string
  (string-concat (pj-p L P (pj-l L pj-k-root0)) (string-concat "/" (string-concat nm ".kso"))))

;; emit: module 0 (the file at P[path]) against the objects of its requires; returns P, the object text is the last string
(defn- pj-emit [M :vector-i64 L :vector-i64 P :string path :i64 entry :i64] :string
  (let [w (-> L (pj-add-mod (pj-n L) path) (pj-mset 0 pj-mf-depth 1) (pj-mset 0 pj-mf-entry entry) (pj-ls pj-k-mode 1) (pj-ls pj-k-errmod 0))
        S (io-read-file M (pj-p L P path))
        M1 (pj-read M S)
        P1 (if (pj-ok M1) (pj-header M1 L (pj-padd L P "") S "") (pj-padd L P ""))
        S2 (if (> (pj-mf L 0 pj-mf-tpl) 0) (pj-tpl-subst S (pj-p L P1 (- (pj-mf L 0 pj-mf-tpl) 1))) S)   ; R6D: a template instantiated
        r0 (pj-mf L 0 pj-mf-req0)
        P2 (loop [k 0 P P1]
             (if (or (>= k (pj-mf L 0 pj-mf-nreq)) (not (pj-ok M1))) P
               (let [r (+ r0 k)
                     nm (pj-p L P (pj-rf L r pj-rf-name))
                     op (pj-objpath L P nm)]
                 (if (= (io-exists op) 0)
                   (let [x (pj-err M1 E-PROJ-NOOBJ (pj-rf L r pj-rf-node))] P)
                   (let [T (io-read-file M1 op)
                         d (pj-l L pj-k-nmod)]
                     (if (not (pj-obj-ok T nm))
                       (let [x (pj-err M1 E-PROJ-OBJ (pj-rf L r pj-rf-node))] P)
                       (let [y (-> L (pj-add-mod (pj-n L) (pj-n L)) (pj-mset d pj-mf-state 3) (pj-rset r pj-rf-mod d))]
                         (recur (+ k 1) (pj-kw-load L (pj-load-iface L (pj-padd L P nm) T d 0) T d)))))))))]   ; R6D: + its K line
    (if (and (pj-ok M1) (= (pj-l L pj-k-ifover) 0))   ; LINK: an interface entry that did not fit is refused below
      (let [P3 (pj-module M1 L P2 0)]
        (if (pj-ok M1)
          (let [w (pj-ls L pj-k-kwk (pj-n L))
                P4 (pj-padd L P3 (pj-kw-lines M1 L P3 S2))]   ; R6D
            (pj-padd L P4 (pj-object M1 L P4 (string-concat S2 (string-concat (ck-r6b-lib-t S2 (pj-kw-table M1 L P4 0 S2)) (pj-trailer L P4 0))))))
          P3))   ; R6B, R6C: library before the trailer (pj-module)
      (let [x (if (pj-ok M1) (pj-err M1 E-PROJ-EDGES 0) M1)] P2))))

;; link: visit object module m (its text read from its path) at depth d
(defn- pj-lvisit [M :vector-i64 L :vector-i64 P :string m :i64] :string
  (let [T (io-read-file M (pj-p L P (pj-mf L m pj-mf-path)))
        nm (string-substring T 10 (pj-eol T 10))
        w (-> L (pj-mset m pj-mf-state 1) (pj-mset m pj-mf-obj (pj-mf L m pj-mf-path)) (pj-mset m pj-mf-req0 (pj-l L pj-k-nreq)) (pj-mset m pj-mf-nreq 0) (pj-ls pj-k-errmod m))
        P1 P   ; LINK: the object text is not kept in P (8 MiB per string); pj-mf-obj = its path, read again by pj-lplace
        P2 (if (= (pj-mf L m pj-mf-entry) 1) (let [x (pj-mset L m pj-mf-name (pj-n L))] (pj-padd L P1 nm)) P1)
        d (pj-mf L m pj-mf-depth)
        P3 (loop [i (+ 11 (string-length nm)) P P2]
             (cond (or (>= i (string-length T)) (not (pj-ok M))) P
                   (not= (string-code-point-at T i) 82) (recur (+ (pj-eol T i) 1) P)
                   :else
                   (let [rn (string-substring T (+ i 2) (pj-eol T i))
                         r (pj-l L pj-k-nreq)
                         t (pj-find-mod L P rn)
                         op (pj-objpath L P rn)
                         x (-> L (pj-rset r pj-rf-name (pj-n L)) (pj-ls pj-k-nreq (+ r 1)) (pj-mset m pj-mf-nreq (+ (pj-mf L m pj-mf-nreq) 1)))
                         P4 (pj-padd L P rn)]
                     (cond (>= r pj-r-cap) (let [y (pj-err M E-PROJ-EDGES 0)] P4)
                           (> (+ d 1) pj-max-depth) (let [y (pj-err M E-PROJ-DEPTH 0)] P4)
                           (and (>= t 0) (= (pj-mf L t pj-mf-state) 1)) (let [y (pj-err M E-PROJ-CYCLE 0)] P4)
                           (>= t 0) (let [y (pj-rset L r pj-rf-mod t)] (recur (+ (pj-eol T i) 1) P4))
                           (>= (pj-l L pj-k-nmod) pj-m-cap) (let [y (pj-err M E-PROJ-MODULES 0)] P4)
                           (= (io-exists op) 0) (let [y (pj-err M E-PROJ-NOOBJ 0)] P4)
                           :else (let [k (pj-l L pj-k-nmod)
                                       y (-> L (pj-add-mod (pj-n L) (+ (pj-n L) 1)) (pj-rset r pj-rf-mod k) (pj-mset k pj-mf-depth (+ d 1)))]
                                   (recur (+ (pj-eol T i) 1) (pj-padd L (pj-padd L P4 rn) op)))))))
        r0 (pj-mf L m pj-mf-req0)
        P5 (loop [k 0 P P3]
             (cond (or (>= k (pj-mf L m pj-mf-nreq)) (not (pj-ok M))) P
                   (= (pj-mf L (pj-rf L (+ r0 k) pj-rf-mod) pj-mf-state) 0) (recur (+ k 1) (pj-lvisit M L P (pj-rf L (+ r0 k) pj-rf-mod)))
                   :else (recur (+ k 1) P)))
        no (pj-l L pj-k-nord)]
    (cond (not (pj-ok M)) P5
          (not (pj-obj-ok T (if (= (pj-mf L m pj-mf-entry) 1) "" (pj-p L P (pj-mf L m pj-mf-name))))) (let [y (pj-err M E-PROJ-OBJ 0)] P5)
          :else (let [y (-> L (pj-mset m pj-mf-state 2) (pj-ls (+ pj-o-base no) m) (pj-ls pj-k-nord (+ no 1)))] P5))))

;; the 32-bit word of the image at byte offset at
;; LINK: at = an image byte offset
(defn- pj-get32 [L :vector-i64 at :i64] :i64
  (+ (pj-ib L at) (* 256 (pj-ib L (+ at 1))) (* 65536 (pj-ib L (+ at 2))) (* 16777216 (pj-ib L (+ at 3)))))

;; LINK: the blob bytes of object text T (its C lines)
(defn- pj-tblob [T :string] :i64
  (loop [i 0 n 0]
    (if (>= i (string-length T)) n
      (let [e (pj-eol T i)] (recur (+ e 1) (if (= (string-code-point-at T i) 67) (+ n (quot (- e (+ i 2)) 2)) n))))))

;; lay out object module m: blob at the next 8-aligned base, interface entries, literal relocations, stub patches
(defn- pj-lplace [M :vector-i64 L :vector-i64 P :string m :i64] :string
  (let [T (io-read-file M (pj-p L P (pj-mf L m pj-mf-obj)))   ; LINK: read again (not kept in P)
        base (bit-and (+ (pj-l L pj-k-img) 7) -8)]
    (if (> (+ base (pj-tblob T)) pj-img-cap)
      (let [x (pj-err M E-PROJ-IMAGE 0)] P)   ; LINK: refused before anything is written
      (pj-lplace2 M L P m T base))))
(defn- pj-lplace2 [M :vector-i64 L :vector-i64 P :string m :i64 T :string base :i64] :string
  (let [w (pj-mset L m pj-mf-base base)
        n (loop [i 0 at base]
            (if (>= i (string-length T)) (- at base)
              (let [e (pj-eol T i)]
                (if (= (string-code-point-at T i) 67)
                  (recur (+ e 1) (loop [j (+ i 2) at at]
                                   (if (>= (+ j 1) e) at
                                     (let [x (pj-ibset L at (+ (* 16 (pj-hexv (string-code-point-at T j))) (pj-hexv (string-code-point-at T (+ j 1)))))]
                                       (recur (+ j 2) (+ at 1))))))
                  (recur (+ e 1) at)))))
        w1 (pj-ls L pj-k-img (+ base n))
        P1 (pj-load-iface L P T m base)
        r0 (pj-mf L m pj-mf-req0)
        w2 (loop [i 0]
             (if (>= i (string-length T)) 0
               (let [e (pj-eol T i) c (string-code-point-at T i)]
                 (cond (= c 76)
                       (let [at (+ base (pj-dec T (+ i 2) e))
                             w0 (pj-get32 L at) w1 (pj-get32 L (+ at 4))
                             v (+ base (bit-and (u64-shift-right w0 5) 65535) (* 65536 (bit-and (u64-shift-right w1 5) 65535)))
                             x (-> L (pj-put32 at (ly-patch16 w0 v)) (pj-put32 (+ at 4) (ly-patch16 w1 (u64-shift-right v 16))))]
                         (recur (+ e 1)))
                       (= c 87) (let [x (pj-mset L m pj-mf-kwt (+ base (pj-dec T (+ i 2) e) 1))] (recur (+ e 1)))   ; R6D
                       (= c 83)
                       (let [sp (pj-sp T (+ i 2))
                             at (+ base (pj-dec T (+ i 2) sp))
                             code (pj-dec T (+ sp 1) e)
                             dep (pj-rf L (+ r0 (quot code 32768)) pj-rf-mod)
                             ent (+ (pj-mf L dep pj-mf-if0) (bit-and (quot code 8) 4095))
                             d (quot (- (pj-if L ent (+ pj-if-off0 (bit-and code 7))) at) 4)
                             x (pj-put32 L at (bit-or 335544320 (bit-and d 67108863)))]
                         (recur (+ e 1)))
                       :else (recur (+ e 1))))))]
    P1))

;; the KSEED1 container of the linked image (M fresh): the X lines of the entry object m at its base. LINK: only the HEADER
;; goes to OUT (MM-R0 = header bytes + image bytes); pj-lwrite writes it and then the image from L
(defn- pj-lcontainer [M :vector-i64 L :vector-i64 P :string m :i64] :vector-i64
  (let [T (io-read-file M (pj-p L P (pj-mf L m pj-mf-obj)))
        base (pj-mf L m pj-mf-base)
        nx (loop [i 0 k 0] (if (>= i (string-length T)) k (recur (+ (pj-eol T i) 1) (if (= (string-code-point-at T i) 88) (+ k 1) k))))
        M1 (-> (vector-assoc! M MM-OUT-N 1) (out-put-magic) (out-put-dec (pj-l L pj-k-img)) (out-put 32) (out-put-dec nx) (out-put 10))
        M2 (loop [i 0]
             (if (>= i (string-length T)) M1
               (let [e (pj-eol T i)]
                 (if (= (string-code-point-at T i) 88)
                   (let [s1 (pj-sp T (+ i 2)) s2 (pj-sp T (+ s1 1))
                         x (-> M1 (out-put-span T (+ i 2) s1) (out-put 32) (out-put-dec (+ base (pj-dec T (+ s1 1) s2))) (out-put 32)
                               (out-put-span T (+ s2 1) e) (out-put 10))]
                     (recur (+ e 1)))
                   (recur (+ e 1))))))
        M3 (out-set-cs (out-put M2 10))]
    (if (pj-ok M3) (vector-assoc! M3 MM-R0 (+ (- (vector-at M3 MM-OUT-N) 1) (pj-l L pj-k-img))) M3)))

;; LINK: T[d + (i - a)] = image byte i for i in [a, e)
(defn- pj-unpack [L :vector-i64 T :vector-i64 d :i64 a :i64 e :i64] :vector-i64
  (loop [i a] (if (>= i e) T (let [x (vector-assoc! T (+ d (- i a)) (pj-ib L i))] (recur (+ i 1))))))
;; LINK: write the linked container: the header (OUT, after pj-lcontainer), then the image straight from L in out-wchunk
;; appends (50-out out-rq-*: one reused request vector, cut at the loader's tokens like io-write-bytes); out = "" -> both as
;; hex on stdout. Returns the bytes. Vector items beyond M and L: at most 2 x out-wchunk.
(defn- pj-lwrite [M :vector-i64 L :vector-i64 out :string] :i64
  (let [hb (- (vector-at M MM-OUT-N) 1)
        n (pj-l L pj-k-img)]
    (if (= (string-length out) 0)
      (let [T (vector-alloc (pj-max 1 (pj-min n out-wchunk)))
            w (io-write-hex M (+ MM-OUT-BASE 1) hb)
            w2 (loop [a 0] (if (>= a n) 0 (let [e (pj-min n (+ a out-wchunk)) x (io-write-hex (pj-unpack L T 0 a e) 0 (- e a))] (recur e))))]
        (+ hb n))
      (let [w (io-write-bytes M out (+ MM-OUT-BASE 1) hb)
            d (+ (string-length out) (io-tokn 1))
            RF (if (> n out-wchunk) (out-rq-new out 1 out-wchunk) (vector-alloc 1))
            w2 (loop [a 0]
                 (if (>= a n) 0
                   (let [e (pj-min n (+ a out-wchunk))
                         m (- e a)
                         R (if (and (> n out-wchunk) (= m out-wchunk)) RF (out-rq-new out 1 m))
                         y (out-rq-send (pj-unpack L R d a e) out 1 d m)]
                     (recur e))))]
        (+ hb n)))))

;; link the root object at P[path]: returns P; on success the container is in OUT
(defn- pj-link-objects [M :vector-i64 L :vector-i64 P :string path :i64] :string
  (let [w (-> L (pj-add-mod (pj-n L) path) (pj-mset 0 pj-mf-depth 1) (pj-mset 0 pj-mf-entry 1) (pj-ls pj-k-errmod 0))
        T (io-read-file M (pj-p L P path))
        P1 (pj-padd L P "")]
    (if (not (pj-obj-ok T ""))
      (let [x (pj-err M E-PROJ-OBJ 0)] P1)
      (let [P2 (pj-lvisit M L P1 0)
            P3 (loop [k 0 P P2] (if (or (>= k (pj-l L pj-k-nord)) (not (pj-ok M))) P (recur (+ k 1) (pj-lplace M L P (pj-l L (+ pj-o-base k))))))]
        (cond (not (pj-ok M)) P3
              (> (pj-l L pj-k-ifover) 0) (let [x (pj-err M E-PROJ-EDGES 0)] P3)   ; LINK
              (> (pj-l L pj-k-strover) 0) (let [x (pj-err M E-PROJ-IMAGE 0)] P3)   ; LINK
              (> (pj-l L pj-k-img) pj-img-cap) (let [x (pj-err M E-PROJ-IMAGE 0)] P3)
              :else (let [y (pj-kw-patch L) x (pj-lcontainer M L P3 0)] P3))))))   ; R6D: pj-kw-patch

;; ==== R5B (agent R5B, 2026-10-03): capability declarations and stateful exports =============================================
;; A module's (:capabilities #{..}) clause / {:kotoba/capabilities #{..}} entry is a capability mask (bit w = wire w) kept in
;; its module record (pj-mf-caps, mask + 1; 0 = no declaration: no check, as the reference distinguishes nil from #{}); after the
;; module compiles, every capability its code calls (M[MM-CAPS], 21-check) must be declared (E2176), and the union over the
;; modules (L[pj-k-caps]) is what 90-drv checks against --policy. A library's exported defn must not be stateful (E2150): the
;; trailer exports nothing from a library, so 21-check cannot see it.
(def pj-k-caps 32)
(def pj-mf-caps 14)

(defn- pj-r5b-wire [s :string] :i64
  (cond (string=? s ":hash/sha256") 3 (string=? s ":clock/now") 7 (string=? s ":env/read") 33 (string=? s ":fs/browse") 34
        (string=? s ":fs/app-data") 35 (string=? s ":fs/app-data-bytes") 35 (string=? s ":io/write") 37 (string=? s ":cli/args") 38
        (string=? s ":io/write-error") 39 (string=? s ":io/read") 41 :else -1))
;; the declared set node v of the module being read (L[pj-k-errmod])
(defn- pj-r5b-decl [M :vector-i64 L :vector-i64 S :string v :i64] :vector-i64
  (let [m (pj-l L pj-k-errmod)
        mask (loop [c (pj-first M v) acc 0]
               (if (= c 0)
                 acc
                 (let [w (if (= (pj-kind M c) ND-KW) (pj-r5b-wire (pj-text M S c)) -1)]
                   (recur (pj-next M c) (if (and (>= w 0) (< w 47)) (bit-or acc (i64-shift-left 1 w)) acc)))))]
    (if (or (= (pj-kind M v) ND-SET) (= (pj-kind M v) ND-VEC))
      (let [w (pj-mset L m pj-mf-caps (+ mask 1))] M)
      (pj-err M E-PROJ-NSFORM v))))

;; token t is the symbol right after `(with`
(defn- pj-r5b-with? [M :vector-i64 S :string t :i64] :bool
  (and (> t 2) (= (pj-tf M (- t 1) TF-KIND) TK-SYM) (= (pj-tf M (- t 2) TF-KIND) TK-LPAREN)
       (string=? (string-substring S (pj-tf M (- t 1) TF-START) (pj-tf M (- t 1) TF-END)) "with")))

(defn- pj-r5b-tmpl? [M :vector-i64 f :i64] :bool
  (= (bit-and (vector-at M (+ (vector-at M MM-FN2) (* f FN2-W) FN2-FLAGS)) 1) 1))
(defn- pj-r5b-err-sym [M :vector-i64 code :i64 f :i64] :vector-i64
  (let [sy (pj-ff M f FF-SYM)] (pj-err-span M code (pj-sf M sy SF-START) (pj-sf M sy SF-START) (pj-sf M sy SF-END))))

;; after module m compiled (M holds it): the checks above; M (with MM-ERR set on a refusal)
(defn- pj-r5b-after [M :vector-i64 L :vector-i64 P :string S :string m :i64] :vector-i64
  (let [used (vector-at M MM-CAPS)
        d (pj-mf L m pj-mf-caps)
        extra (if (> d 0) (bit-and used (bit-not (- d 1))) 0)
        w (pj-ls L pj-k-caps (bit-or (pj-l L pj-k-caps) used))
        bad (cond (= (pj-mf L m pj-mf-entry) 1) 0
                  (> (pj-mf L m pj-mf-expk) 0)
                  (loop [k 0]
                    (if (>= k (pj-mf L m pj-mf-nexp)) 0
                      (let [f (pj-fn-named M S (pj-p L P (pj-l L (+ pj-x-base (pj-mf L m pj-mf-exp0) k))))]
                        (if (and (> f 0) (pj-r5b-tmpl? M f)) f (recur (+ k 1))))))
                  :else (loop [f 1]
                          (cond (>= f (vector-at M MM-FN-N)) 0
                                (and (= (pj-ff M f FF-KIND) FK-DEFN) (pj-r5b-tmpl? M f)) f
                                :else (recur (+ f 1)))))]
    (cond (> bad 0) (pj-r5b-err-sym M E-STATE-EXPORT bad)
          (not= extra 0) (-> (pj-err-span M E-CAP-UNDECLARED -1 0 0) (vector-assoc! MM-ERR-N extra))
          :else M)))

;; seed/90-drv.kotoba -- the seed's command-line driver (prefix drv-). Owner: contracts/integration.
;;
;; Commands (guest argv through wire 38; paths are absolute and inside KEXE_CAP_RESOURCES_35):
;;   compile <src> <out> [hex]       also: compile <src> [--target aarch64-macos] --output <out> [hex]
;;       lex -> read -> names -> check -> lower -> a64gen -> layout -> out (kseed/v1 container).
;;       <out> = "-" or the word `hex`: the container is written as lowercase hex on stdout (64 bytes per line,
;;       `xxd -r -p` recovers it; scripts/seed/build.sh uses this). Any other <out>: the container is written to
;;       that file as raw bytes (io-write-bytes, :fs/app-data-bytes) and stdout gets one line
;;       {:ok true, :target :aarch64-macos, :output "<out>", :bytes N}.
;;   extract-native <kseed> --symbol <name> --output <raw>
;;       reads the container (io-read-bytes), writes its code slice to <raw> and prints
;;       {:ok true, :output "<raw>", :offset N, :length L, :arity A} (the qualification runner reads :offset).
;;   check <src>                     lex .. check only; prints "ok\n".
;; Flags the qualification runner passes and the seed ignores: --jvm-free (the seed never has a JVM).
;; Exit status: 0 ok, 1 compile error (one line "seed: E<code> <text> (byte <pos>)" on stderr), 2 usage.
;; Strings are compared by length + FNV-1a 64 (mem-hash-str): HEADS has no string equality and stage-0 must not
;; index a string literal (MEMORY-MAP L13). M is threaded as a nested call argument; each phase's continuation reads
;; MM-ERR through its own parameter (rules L14/L15 of seed/CONTRACT-REQUESTS.md).

;; ---- argv --------------------------------------------------------------------------------------------------------
(defn- drv-is2 [s :string h :i64] :i64 (if (= (mem-hash-str s 0 (string-length s)) h) 1 0))
(defn- drv-is [s :string len :i64 h :i64] :i64 (if (= (string-length s) len) (drv-is2 s h) 0))
(defn- drv-flagv1 [s :string] :i64 (if (= (drv-is s 8 -5168643622338417694) 1) 1 (drv-is s 8 -5041807559351932249)))
;; 1 when s is a flag that takes a value: --target --output --symbol
(defn- drv-flagv [s :string] :i64
  (cond (= (drv-is s 8 4838156518066596434) 1) 1
        ;; R5A: --source-path D (repeatable) and --policy P also take a value
        (string=? s "--source-path") 1
        (string=? s "--policy") 1
        (string=? s "--object-dir") 1
        (string=? s "--ns") 1   ; EMIT: compile-kir --emit-module --ns NAME
        :else (drv-flagv1 s)))
(defn- drv-hexw [s :string] :i64 (drv-is s 3 3695806134807131338))
(defn- drv-dash [s :string] :i64 (drv-is s 1 -5808622843851602280))

;; argv index of the k-th positional argument after the command (flags and their values skipped), -1 when absent
(defn- drv-pos [i :i64 n :i64 k :i64] :i64
  (cond (>= i n) -1
        (= (drv-flagv (io-arg i)) 1) (drv-pos (+ i 2) n k)
        (= (drv-hexw (io-arg i)) 1) (drv-pos (+ i 1) n k)
        (= k 0) i
        :else (drv-pos (+ i 1) n (- k 1))))

;; argv index of the value after the flag with hash h (length 8), -1 when absent
(defn- drv-flag [i :i64 n :i64 h :i64] :i64
  (cond (>= (+ i 1) n) -1
        (= (drv-is (io-arg i) 8 h) 1) (+ i 1)
        :else (drv-flag (+ i 1) n h)))

;; 1 when the word `hex` is one of the arguments (not as a flag value)
(defn- drv-hexflag [i :i64 n :i64] :i64
  (cond (>= i n) 0
        (= (drv-flagv (io-arg i)) 1) (drv-hexflag (+ i 2) n)
        (= (drv-hexw (io-arg i)) 1) 1
        :else (drv-hexflag (+ i 1) n)))

(defn- drv-arg [i :i64] :string (if (< i 0) "" (io-arg i)))

;; ---- error texts (generated from seed/HEADS :errors + the local 4202-4205/5002 of 42-layout/50-out) ----
;; error text piece 0
(defn- drv-et0 [c :i64] :string
  (cond
    (= c 1) "usage: seed check <file> | seed compile <file> --target aarch64-macos --output <out> | seed extract-native <kseed> --symbol <name> --output <raw>"
    (= c 2) "unsupported target (only aarch64-macos)"
    (= c 3) "cannot read input file"
    (= c 4) "cannot write output file"
    (= c 5) "symbol is not exported by the container"
    (= c 101) "compiler table full: region "
    (= c 102) "compiler heap exhausted"
    (= c 201) "read failed"
    (= c 202) "write failed"
    (= c 1001) "unterminated string literal"
    (= c 1002) "non-ASCII byte "
    (= c 1003) "unsupported string escape '"
    (= c 1004) "integer literal out of range '"
    (= c 1005) "unsupported reader syntax '"
    (= c 1101) "unexpected '"
    (= c 1102) "unclosed '"
    (= c 1103) "mismatched bracket '"
    (= c 1105) "maps are not supported"
    (= c 2001) "duplicate definition '"
    (= c 2003) "unsupported top-level form '"
    (= c 2004) "the file must start with (ns NAME (:export [...]))"
    (= c 2005) "export of undefined function '"
    (= c 2101) "unknown or unsupported form '"
    (= c 2102) "unknown symbol '"
    (= c 2103) "wrong number of arguments to '"
    (= c 2104) "type mismatch in '"
    (= c 2105) "unsupported type '"
    (= c 2106) "recur is not in tail position"
    (= c 2107) "recur expects "
    (= c 2108) "more than 5 parameters in '"
    (= c 2109) "cond needs a final :else clause"
    (= c 2110) "if needs exactly a test, a then and an else"
    (= c 2111) "malformed binding vector in '"
    (= c 2112) "duplicate local '"
    (= c 2114) "keyword '"
    (= c 2115) "unsupported capability call '"
    (= c 2116) "vector literal items must be i64 (at most 64)"
    (= c 2118) "'"
    (= c 2119) "malformed signature of '"
    (= c 2120) "too many locals in one function ("
    (= c 2121) "result of '"
    (= c 2123) "= compares only i64 or bool values"
    (= c 2124) "def value must be an integer, string, keyword or vector literal: '"
    (= c 2125) "case constants must be unique: '"
    (= c 2126) "cannot infer the result type of '"
    (= c 2127) "unknown record field '"
    (= c 2128) "malformed or conflicting record schema '"
    (= c 2129) "two different error types meet at '"
    (= c 2130) "unhandled abort at export boundary; catch it with try: "
    (= c 2131) "try body cannot abort; there is nothing to catch"
    (= c 2132) "malformed try or catch '"
    (= c 2133) "cannot infer the error type here: '"
    (= c 2134) "function value not admitted: '"
    (= c 2135) "abort inside a fn literal is not admitted: '"
    (= c 2136) "no clause of '"
    (= c 2137) "too many parameters and captures in a fn literal ("
    (= c 2138) "a multi-arity or variadic function cannot be exported: '"
    (= c 2139) "a fn literal parameter takes its type from the context, not from an annotation: '"
    (= c 2178) "more than 16 parameters in '"
    (= c 2179) "type references an undeclared record schema '"
    (= c 3001) "SIR table full"
    (= c 3003) "internal: cannot lower node kind "
    (= c 4001) "immediate out of range: "
    (= c 4101) "code buffer full"
    (= c 4102) "internal: unsupported SIR op "
    (= c 4103) "frame too large ("
    (= c 4201) "branch out of range ("
    (= c 5001) "output buffer full"
    (= c 5003) "malformed kseed container"
    (= c 4202) "internal: bad fixup "
    (= c 4203) "branch target undefined ("
    (= c 4204) "export table full"
    (= c 4205) "code and pool exceed 32-bit offsets"
    (= c 5002) "symbol '"
    (= c 1006) "malformed reader conditional '"
    (= c 6001) "cyclic module dependency rejected"
    (= c 6002) "required module "
    (= c 6003) "duplicate import alias"
    (= c 6004) "qualified call is not an admitted exported import: "
    (= c 6005) "project module requires exactly one namespace"
    (= c 6006) "namespace clause "
    (= c 6007) "namespace clause "
    (= c 6008) "resolved path namespace does not match requirement"
    (= c 6009) "project module "
    (= c 6010) "named operation "
    (= c 6011) "project dependency depth exceeds limit"
    (= c 6012) "project module count exceeds limit"
    (= c 6013) "project dependency edge count exceeds limit"
    (= c 6014) "project source bytes exceed limit"
    (= c 6015) "a multi-module compile needs pinned inputs"
    (= c 6016) "export does not name a declared function: "
    (= c 6017) "the interface of "
    (= c 6018) "malformed require spec '"
    (= c 6019) "referred name is defined locally or referred twice: "
    (= c 6020) "linked image exceeds the link buffer"
    (= c 6021) "malformed namespace form '"
    (= c 6022) "duplicate required namespace "
    (= c 6023) "namespace templates are not admitted in R5: "
    (= c 6024) "namespace resolves from multiple explicit source paths: "
    (= c 6025) "required module "
    (= c 6026) "malformed or mismatched module object "
    :else ""))
;; error text piece 1
(defn- drv-et1 [c :i64] :string
  (cond
    (= c 1002) " (R0 accepts ASCII source only)"
    (= c 1003) "'"
    (= c 1004) "'"
    (= c 1005) "'"
    (= c 1101) "'"
    (= c 1102) "' at end of file"
    (= c 1103) "'"
    (= c 2001) "'"
    (= c 2003) "'"
    (= c 2005) "'"
    (= c 2101) "'"
    (= c 2102) "'"
    (= c 2103) "': expected "
    (= c 2104) "': expected "
    (= c 2105) "'"
    (= c 2107) " arguments"
    (= c 2108) "'"
    (= c 2111) "'"
    (= c 2112) "'"
    (= c 2114) "' is not a value"
    (= c 2115) "'"
    (= c 2118) "' takes exactly one body expression"
    (= c 2119) "'"
    (= c 2120) ")"
    (= c 2121) "' does not match its declared type "
    (= c 2124) "'"
    (= c 2125) "'"
    (= c 2126) "' here: declare it"
    (= c 2127) "'"
    (= c 2128) "'"
    (= c 2129) "'"
    (= c 2132) "'"
    (= c 2133) "'"
    (= c 2134) "'"
    (= c 2135) "'"
    (= c 2136) "' takes "
    (= c 2137) ", at most 5)"
    (= c 2138) "'"
    (= c 2139) "'"
    (= c 2178) "'"
    (= c 2179) "'"
    (= c 4103) " slots)"
    (= c 4201) " words)"
    (= c 4203) ")"
    (= c 5002) "' not exported by the container"
    (= c 1006) "'"
    (= c 6002) " is missing from the explicit source paths"
    (= c 6006) " is not admitted: an unqualified ambient namespace is outside the language; the admitted clauses are :export, :capabilities, :schemas, :params and :require"
    (= c 6007) " is not admitted: the admitted clauses are :export, :capabilities, :schemas, :params and :require"
    (= c 6009) " exports nothing: every top-level defn is private; declare one with defn, or add an explicit :export vector"
    (= c 6010) " is not a registered capability"
    (= c 6017) " uses a type the seed does not carry across modules (records, keywords, functions, variadic clauses)"
    (= c 6018) "'"
    (= c 6021) "'"
    (= c 6025) " has no object in the object directory"
    :else ""))
;; error text piece 2
(defn- drv-et2 [c :i64] :string
  (cond
    (= c 2136) " arguments"
    :else ""))
;; placeholder 0: 0 none, 1 {name}, 2 {n}, 3 {t}
(defn- drv-ek0 [c :i64] :i64
  (cond
    (= c 101) 2
    (= c 1002) 2
    (= c 1003) 1
    (= c 1004) 1
    (= c 1005) 1
    (= c 1101) 1
    (= c 1102) 1
    (= c 1103) 1
    (= c 2001) 1
    (= c 2003) 1
    (= c 2005) 1
    (= c 2101) 1
    (= c 2102) 1
    (= c 2103) 1
    (= c 2104) 1
    (= c 2105) 1
    (= c 2107) 2
    (= c 2108) 1
    (= c 2111) 1
    (= c 2112) 1
    (= c 2114) 1
    (= c 2115) 1
    (= c 2118) 1
    (= c 2119) 1
    (= c 2120) 2
    (= c 2121) 1
    (= c 2124) 1
    (= c 2125) 1
    (= c 2126) 1
    (= c 2127) 1
    (= c 2128) 1
    (= c 2129) 1
    (= c 2130) 1
    (= c 2132) 1
    (= c 2133) 1
    (= c 2134) 1
    (= c 2135) 1
    (= c 2136) 1
    (= c 2137) 2
    (= c 2138) 1
    (= c 2139) 1
