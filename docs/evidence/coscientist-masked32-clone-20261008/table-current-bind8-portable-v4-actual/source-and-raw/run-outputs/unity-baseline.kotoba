;; seed/01-mem.kotoba -- memory model of the seed compiler (prefix mem-). Owner: module 01-mem.
;; Contract: seed/MEMORY-MAP (heap M, header slots, return registers, rules L1-L13), seed/HEADS (the 41 heads: this
;; file uses nothing else, so the seed can compile it). Design: docs/selfhost-seed-design-20261002.md 2.1/2.3.
;;
;; Conventions (MEMORY-MAP rules):
;;   * Writers take M0 first and RETURN the new handle (L1). A writer that also yields an i64 stores it in
;;     M[MM-R0] and the caller reads it right after the call (L4). Readers take M and return :i64 (L2).
;;   * Every function is defn- (L3), at most 5 parameters (L7), no `do`, no shadowing (L6).
;;   * Failures: mem-fail stores the code in MM-ERR only while it is 0 (first writer wins), MM-ERR-POS = -1,
;;     returns M; the caller of a failed writer must look at MM-ERR (L10). A failed mem-alloc returns R0 = 240
;;     (scratch words M[240..255], reserved here), R1 = 0 and the other 01-mem writers then write only into the scratch
;;     area (no trap): the error is reported by the driver after the phase, like every other module's.
;;   * Heap words: mem-alloc hands out blocks of MM-HEAP-BASE..MM-HEAP-END-1 by bumping MM-HEAP-TOP. Nothing is
;;     ever freed (no collector, design 2.1). Fresh words are zero (vector-alloc zero fills; blocks are never reused).
;;
;; API (all names top-level, all private):
;;   mem-set M i x                -> M            vector-assoc! for handles returned by calls (see the note above it)
;;   mem-new                      -> M            the heap: version, fill counters, heap top
;;   mem-fail M code              -> M            record an error (first wins)
;;   mem-alloc M words            -> M, R0=addr R1=ok   bump allocation, E-HEAP-FULL when out of words (R0=240, R1=0)
;;   mem-fill M dst n v           -> M            M[dst..dst+n) = v
;;   mem-copy M dst src n         -> M            memmove inside M (overlap safe)
;;   mem-put-bytes M S a b dst    -> M            M[dst+k] = byte (a+k) of S for a <= a+k < b (one byte per word)
;;   mem-sel f a b                -> i64          a when f /= 0 else b (value selection: the only branching on handle paths)
;;   mem-keep M                   -> M            identity that is a write (loop base case)
;;   mem-vec-new M cap            -> M, R0=h      growable i64 array (header of 3 words in the heap)
;;   mem-vec-push M h x           -> M            append, doubling the data block when full (old block is wasted)
;;   mem-vec-len M h / mem-vec-at M h i / mem-vec-set M h i x   (at/set are unchecked beyond len)
;;   mem-hash-str S a b           -> i64          FNV-1a 64 over bytes a..b-1 of S (signed i64, wraps)
;;   mem-hash-words M addr n      -> i64          the same over n words holding one byte each
;;   mem-span-eq S a b n          -> 1/0          bytes a..a+n-1 of S equal bytes b..b+n-1
;;   mem-words-eq M a b n         -> 1/0          the same over words of M
;;   mem-slot h cap               -> i64          hash to table slot: (bit-and h (- cap 1)); cap a power of two
;;   mem-u2dec n                  -> :string      signed decimal text (also MIN); named u2dec in the design
;;   mem-parse-dec S a b          -> i64          decimal of bytes a..b-1, or -1 when empty/non-digit
;;   mem-ceil-pow2 n              -> i64          least power of two >= n (n >= 1)

;; ------------------------------------------------------------------------------------------------------------
;; STAGE-0 LINEARITY DISCIPLINE (measured 2026-10-02 against build/native-image/amu-native; every rule below was
;; found by a one-line probe, see seed/CONTRACT-REQUESTS.md). The handle M is linear and the checker is far stricter
;; than "use once":
;;   H1  vector-assoc! directly on a handle that came out of a user-function call is refused; write it with mem-set.
;;   H2  `if`/`cond` ONLY in tail position, and never and/or/not: both answer 'internal compiler error'.
;;   H3  Do not branch on the handle. Arms of one if/cond that carry the handle are accepted only when they are the
;;       same kind of thing (measured: (if c (mem-set M ..) (mem-set M ..)) is refused, mixing calls with direct
;;       vector-assoc! is refused). Handle code is therefore STRAIGHT-LINE: decisions are taken on i64 values with
;;       the helper mem-sel (value selection), and the handle is written unconditionally.
;;   H4  A loop (self-recursive writer) ends in (mem-keep M0), a call that writes, never in a bare M0: a bare
;;       return makes its result an alias of its argument and the next call on that result is refused.
;;   H5  Read M BEFORE handing it on (a let initializer `(vector-at M ..)`), never inside the argument list of the
;;       call that consumes M.
;;   Consequence for failures: mem-alloc cannot return early. On failure it records E-HEAP-FULL (first error wins),
;;   returns the handle unchanged, sets R0 = 240 (a 16-word scratch area M[240..255], reserved for this) and
;;   R1 = 0. R1 = 1 on success. Callers look at MM-ERR (rule L10) before they use what they allocated.
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-sel [f :i64 a :i64 b :i64] :i64 (if (= f 0) b a))

;; mem-set: write for a handle that came out of a call (H1)
(defn- mem-set [M0 :vector-i64 i :i64 x :i64] :vector-i64
  (vector-assoc! M0 i x))

;; identity that is a WRITE (stores M[0] back; works for any vector, also a scratch vector): the base case of loops (H4)
(defn- mem-keep [M0 :vector-i64] :vector-i64
  (let [v (vector-at M0 MM-VERSION)]
    (vector-assoc! M0 MM-VERSION v)))

;; ------------------------------------------------------------------------------------------------------------
;; errors. R0 = 0 afterwards.
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-fail [M0 :vector-i64 code :i64] :vector-i64
  (let [e (vector-at M0 MM-ERR)
        p (vector-at M0 MM-ERR-POS)]
    (vector-assoc! (vector-assoc! (vector-assoc! M0 MM-R0 0) MM-ERR (mem-sel e e code)) MM-ERR-POS (mem-sel e p -1))))

;; ------------------------------------------------------------------------------------------------------------
;; the heap
;; ------------------------------------------------------------------------------------------------------------
;; every fill counter M[MM-TOK-N .. MM-OUT-N] starts at 1 (index 0 of each table is the null record)
(defn- mem-init-fills [M0 :vector-i64 i :i64] :vector-i64
  (if (> i MM-OUT-N)
    (mem-keep M0)
    (mem-init-fills (vector-assoc! M0 i 1) (+ i 1))))

(defn- mem-new [] :vector-i64
  (let [M0 (vector-alloc MM-WORDS)
        M1 (vector-assoc! M0 MM-VERSION MM-LAYOUT-VERSION)
        M2 (mem-init-fills M1 MM-TOK-N)
        M3 (mem-set M2 MM-HASH-N 0)
        M4 (mem-set M3 MM-HEAP-TOP MM-HEAP-BASE)]
    (mem-set M4 MM-ERR-POS -1)))

;; 1 when a block of `words` words fits at top (end = top + words), else 0
(defn- mem-fits [top :i64 end :i64 words :i64] :i64
  (cond (< words 0) 0
        (< end top) 0
        (> end MM-HEAP-END) 0
        :else 1))

;; the error words after an allocation: ok = 1 leaves them, ok = 0 sets E-HEAP-FULL / pos -1 if no error is recorded
(defn- mem-alloc-fin [M0 :vector-i64 ok :i64 newtop :i64 r0 :i64] :vector-i64
  (let [e (vector-at M0 MM-ERR)
        p (vector-at M0 MM-ERR-POS)
        e1 (mem-sel e e E-HEAP-FULL)
        p1 (mem-sel e p -1)]
    (vector-assoc! (vector-assoc! (vector-assoc! (vector-assoc! (vector-assoc! M0 MM-HEAP-TOP newtop) MM-R0 r0) MM-R1 ok)
                                  MM-ERR (mem-sel ok e e1))
                   MM-ERR-POS (mem-sel ok p p1))))

;; R0 = first word of the block (240 on failure), R1 = 1 / 0
(defn- mem-alloc [M0 :vector-i64 words :i64] :vector-i64
  (let [top (vector-at M0 MM-HEAP-TOP)
        end (+ top words)
        ok (mem-fits top end words)]
    (mem-alloc-fin M0 ok (mem-sel ok end top) (mem-sel ok top 240))))

;; ------------------------------------------------------------------------------------------------------------
;; word and byte helpers
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-fill [M0 :vector-i64 dst :i64 n :i64 v :i64] :vector-i64
  (if (<= n 0)
    (mem-keep M0)
    (mem-fill (vector-assoc! M0 dst v) (+ dst 1) (- n 1) v)))

;; one loop for both directions: a = current source index, step = +1 or -1, delta = dst - src
(defn- mem-copy-run [M0 :vector-i64 a :i64 last :i64 step :i64 delta :i64] :vector-i64
  (if (= a last)
    (mem-keep M0)
    (let [x (vector-at M0 a)
          M1 (vector-assoc! M0 (+ a delta) x)]
      (mem-copy-run M1 (+ a step) last step delta))))

;; direction 1 = ascending (dst < src or equal), 0 = descending
(defn- mem-pos [n :i64] :i64 (if (< n 0) 0 n))

(defn- mem-up [dst :i64 src :i64] :i64 (if (> dst src) 0 1))

;; memmove inside M, overlap safe
(defn- mem-copy [M0 :vector-i64 dst :i64 src :i64 n :i64] :vector-i64
  (let [m (mem-pos n)
        up (mem-up dst src)]
    (mem-copy-run M0 (mem-sel up src (+ src (- m 1))) (mem-sel up (+ src m) (- src 1)) (mem-sel up 1 -1) (- dst src))))

;; bytes a .. b-1 of S into M[dst ...], one byte per word. delta = dst - a.
(defn- mem-put-run [M0 :vector-i64 S :string i :i64 end :i64 delta :i64] :vector-i64
  (if (>= i end)
    (mem-keep M0)
    (let [c (string-code-point-at S i)
          M1 (vector-assoc! M0 (+ i delta) c)]
      (mem-put-run M1 S (+ i 1) end delta))))

(defn- mem-put-bytes [M0 :vector-i64 S :string a :i64 b :i64 dst :i64] :vector-i64
  (mem-put-run M0 S a b (- dst a)))

;; ------------------------------------------------------------------------------------------------------------
;; growable arrays in the heap. Handle h = heap address of a 3-word header: [len, cap, data address].
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-vec-len [M :vector-i64 h :i64] :i64 (vector-at M h))
(defn- mem-vec-cap [M :vector-i64 h :i64] :i64 (vector-at M (+ h 1)))
(defn- mem-vec-at [M :vector-i64 h :i64 i :i64] :i64 (vector-at M (+ (vector-at M (+ h 2)) i)))

(defn- mem-vec-set [M0 :vector-i64 h :i64 i :i64 x :i64] :vector-i64
  (let [d (vector-at M0 (+ h 2))]
    (vector-assoc! M0 (+ d i) x)))

(defn- mem-max1 [n :i64] :i64 (if (< n 1) 1 n))

(defn- mem-vec-new2 [M2 :vector-i64 h :i64 cap :i64] :vector-i64
  (let [d (vector-at M2 MM-R0)]
    (vector-assoc! (vector-assoc! (vector-assoc! (vector-assoc! M2 h 0) (+ h 1) cap) (+ h 2) d) MM-R0 h)))

;; R0 = header address (240 after an allocation failure: look at MM-ERR)
(defn- mem-vec-new [M0 :vector-i64 cap :i64] :vector-i64
  (let [c (mem-max1 cap)
        M1 (mem-alloc M0 3)
        h (vector-at M1 MM-R0)]
    (mem-vec-new2 (mem-alloc M1 c) h c)))

;; make room for one more item: when len = cap, move the data to a block of twice the capacity (the old block is
;; left behind). Straight-line: need = 1/0 scales the allocation, the copy count and the header update.
(defn- mem-need [len :i64 cap :i64] :i64 (if (< len cap) 0 1))

(defn- mem-vec-grow2 [M1 :vector-i64 h :i64 n :i64 old :i64 newcap :i64] :vector-i64
  (let [d (vector-at M1 MM-R0)
        ok (vector-at M1 MM-R1)
        take (* n ok)
        len (vector-at M1 h)
        cap (vector-at M1 (+ h 1))]
    (mem-vec-grow3 (mem-copy M1 d old (* take len)) h (mem-sel (* n ok) newcap cap) (mem-sel (* n ok) d old))))

(defn- mem-vec-grow3 [M2 :vector-i64 h :i64 cap :i64 d :i64] :vector-i64
  (mem-set (mem-set M2 (+ h 1) cap) (+ h 2) d))

(defn- mem-vec-grow [M0 :vector-i64 h :i64] :vector-i64
  (let [len (vector-at M0 h)
        cap (vector-at M0 (+ h 1))
        old (vector-at M0 (+ h 2))
        need (mem-need len cap)]
    (mem-vec-grow2 (mem-alloc M0 (* need (* cap 2))) h need old (* cap 2))))

;; store x at the end; while an error is recorded the store goes to the scratch area instead
(defn- mem-vec-store [M0 :vector-i64 h :i64 x :i64] :vector-i64
  (let [len (vector-at M0 h)
        d (vector-at M0 (+ h 2))
        e (vector-at M0 MM-ERR)
        at (mem-sel e 245 (+ d len))
        M1 (vector-assoc! M0 at x)]
    (vector-assoc! M1 h (+ len (mem-sel e 0 1)))))

(defn- mem-vec-push [M0 :vector-i64 h :i64 x :i64] :vector-i64
  (mem-vec-store (mem-vec-grow M0 h) h x))

;; ------------------------------------------------------------------------------------------------------------
;; hashing and comparison. FNV-1a 64: h = 14695981039346656037 (as signed -3750763034362895579); for each
;; byte h = (h xor byte) * 1099511628211, wrapping. Deterministic, no tables (rule L11).
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-hash-run [S :string i :i64 end :i64 h :i64] :i64
  (if (>= i end)
    h
    (mem-hash-run S (+ i 1) end (* (bit-xor h (string-code-point-at S i)) 1099511628211))))

(defn- mem-hash-str [S :string a :i64 b :i64] :i64
  (mem-hash-run S a b -3750763034362895579))

(defn- mem-hash-wrun [M :vector-i64 i :i64 end :i64 h :i64] :i64
  (if (>= i end)
    h
    (mem-hash-wrun M (+ i 1) end (* (bit-xor h (bit-and (vector-at M i) 255)) 1099511628211))))

(defn- mem-hash-words [M :vector-i64 addr :i64 n :i64] :i64
  (mem-hash-wrun M addr (+ addr n) -3750763034362895579))

(defn- mem-slot [h :i64 cap :i64] :i64 (bit-and h (- cap 1)))

(defn- mem-span-eq-run [S :string a :i64 b :i64 n :i64] :i64
  (cond
    (<= n 0) 1
    (= (string-code-point-at S a) (string-code-point-at S b)) (mem-span-eq-run S (+ a 1) (+ b 1) (- n 1))
    :else 0))

(defn- mem-span-eq [S :string a :i64 b :i64 n :i64] :i64 (mem-span-eq-run S a b n))

(defn- mem-words-eq-run [M :vector-i64 a :i64 b :i64 n :i64] :i64
  (cond
    (<= n 0) 1
    (= (vector-at M a) (vector-at M b)) (mem-words-eq-run M (+ a 1) (+ b 1) (- n 1))
    :else 0))

(defn- mem-words-eq [M :vector-i64 a :i64 b :i64 n :i64] :i64 (mem-words-eq-run M a b n))

(defn- mem-ceil-pow2-run [p :i64 n :i64] :i64
  (if (>= p n) p (mem-ceil-pow2-run (* p 2) n)))

(defn- mem-ceil-pow2 [n :i64] :i64 (mem-ceil-pow2-run 1 n))

;; ------------------------------------------------------------------------------------------------------------
;; decimal
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-digit [d :i64] :string
  (cond (= d 0) "0" (= d 1) "1" (= d 2) "2" (= d 3) "3" (= d 4) "4"
        (= d 5) "5" (= d 6) "6" (= d 7) "7" (= d 8) "8" :else "9"))

;; prints |n| for n <= 0 (so that MIN needs no negation of itself): quot truncates toward 0, the remainder
;; n - 10*q is in -9..0
(defn- mem-dec-neg [n :i64] :string
  (let [q (quot n 10)
        d (- 0 (- n (* q 10)))]
    (if (= q 0)
      (mem-digit d)
      (string-concat (mem-dec-neg q) (mem-digit d)))))

(defn- mem-u2dec [n :i64] :string
  (if (< n 0)
    (string-concat "-" (mem-dec-neg n))
    (mem-dec-neg (- 0 n))))

(defn- mem-parse-run [S :string i :i64 end :i64 acc :i64] :i64
  (if (>= i end)
    acc
    (let [c (string-code-point-at S i)]
      (cond
        (< c 48) -1
        (> c 57) -1
        :else (mem-parse-run S (+ i 1) end (+ (* acc 10) (- c 48)))))))

(defn- mem-parse-dec [S :string a :i64 b :i64] :i64
  (if (>= a b) -1 (mem-parse-run S a b 0)))

;; seed/02-io.kotoba -- the seed's file, argv and stream access (prefix io-). Owner: module 02-io.
;; Capabilities used (HEADS :caps), nothing else: wire 35 :fs/app-data (:string -> :string forms: read the whole file at
;; an absolute path, "<path>EXISTS_SEP", "<path>RANGE_SEP<off>:<len>", "<path>WRITE_SEP<text>"), wire 38 :cli/args,
;; wire 39 :io/write-error, wire 37 :io/write. The path must lie inside KEXE_CAP_RESOURCES_35, otherwise the loader
;; traps (SIGILL): that is not an error value, so callers print their usage line first and check io-exists.
;;
;; API (readers return :i64/:string and never touch M; writers return M and follow MEMORY-MAP rules L1/L4/L10):
;;   io-out s               -> 0       write s to stdout (wire 37)
;;   io-err s               -> 0       write s to stderr (wire 39); no "seed: " prefix, no newline added
;;   io-argc                -> i64     number of guest arguments (wire 38, "")
;;   io-arg i               -> string  argument i (0-based), "" past the end
;;   io-exists path         -> 1/0     "<path>EXISTS_SEP"
;;   io-read-file M path    -> string  the whole file (M is only there for the call shape of the design; unused)
;;   io-slice path off len  -> string  bytes off..off+len-1 of the file ("RANGE_SEP"): the substring primitive the seed
;;                                     has, because HEADS has no substring: diagnostics print {name} with it
;;   io-write-text path s   -> i64     "<path>WRITE_SEP<s>" (text, ASCII); the file content length is returned
;;   io-check-read M path   -> M       E-IO-READ (201) into MM-ERR (first error wins) unless the file exists; R0 = 1/0
;;   io-check-write M path  -> M       E-IO-WRITE (202) unless the file exists afterwards; R0 = 1/0
;;   io-write-hex M base len-> i64     M[base..base+len) (one byte per word, low 8 bits) as lowercase hex on stdout,
;;                                     64 bytes per line, each line ends in "\n"; `xxd -r -p` recovers the bytes. THE
;;                                     OUTPUT PATH OF THE STABLE STAGE-0 (the :bytes write below is refused by it)
;;   io-write-bytes M path base len -> i64  M[base..base+len) (one byte per word, low 8 bits) to the file `path` as raw
;;                                     bytes, "<path>WRITE_SEP<bytes>" over :fs/app-data-bytes (wire 35, kind 8). Returns len.
;;                                     At most 8 MiB - path - 9 bytes (loader KEXE_BYTES_VALUE_LIMIT); the loader budgets
;;                                     must hold string pool >= 6x and vector items >= 8x len. Check with io-exists.
;;   io-read-bytes path     -> vector  the whole file as one item (0..255) per byte (:fs/app-data-bytes request = the
;;                                     path's bytes, then vector-i64-from-bytes). Byte-safe, unlike io-read-file.
;; The :bytes functions were seed/02-io-bytes.snippet.kotoba until the rebuilt stage-0 (sha d2cb84f6, 2026-10-02)
;; admitted a computed :bytes argument (T3); merged by the R0 integration with io-read-bytes added.
;;
;; Stage-0 rules respected here (01-mem header H1-H5): if/cond only in tail position, no and/or/not, the handle only in
;; straight-line chains.

(defn- io-out [s :string] :i64
  (let [r (typed-cap-call :io/write :string :string s)] 0))

(defn- io-err [s :string] :i64
  (let [r (typed-cap-call :io/write-error :string :string s)] 0))

(defn- io-argc [] :i64
  (let [s (typed-cap-call :cli/args :string :string "")]
    (mem-parse-dec s 0 (string-length s))))

(defn- io-arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (mem-u2dec i)))

;; first byte of the answer is '1' (49)
(defn- io-first-is-one [s :string] :i64
  (cond (= (string-length s) 0) 0
        (= (string-code-point-at s 0) 49) 1
        :else 0))

;; "<word>_SEP", built at run time: the loader's wire 35 looks for its tokens (WRITE_SEP, RANGE_SEP, EXISTS_SEP ..)
;; ANYWHERE in a request, content included, and refuses a write whose content holds its own token (SIGILL, measured
;; 2026-10-02 when seed-0 wrote seed-1's container). A whole token must therefore never be a literal of the seed: its
;; literal pool is part of every container and code slice the seed writes. The pool pads literals to 8 bytes.
(defn- io-sep [w :string] :string (string-concat w "_SEP"))

(defn- io-exists [path :string] :i64
  (io-first-is-one (typed-cap-call :fs/app-data :string :string (string-concat path (io-sep "EXISTS")))))

(defn- io-read-file [M :vector-i64 path :string] :string
  (typed-cap-call :fs/app-data :string :string path))

(defn- io-slice [path :string off :i64 len :i64] :string
  (typed-cap-call :fs/app-data :string :string
    (string-concat path (string-concat (io-sep "RANGE") (string-concat (mem-u2dec off) (string-concat ":" (mem-u2dec len)))))))

(defn- io-write-text [path :string s :string] :i64
  (let [r (typed-cap-call :fs/app-data :string :string (string-concat path (string-concat (io-sep "WRITE") s)))]
    (string-length r)))

;; error word after a check: ok = 1 keeps the recorded error; ok = 0 records `code` unless an error is already there
(defn- io-check-fin [M0 :vector-i64 ok :i64 code :i64] :vector-i64
  (let [e (vector-at M0 MM-ERR)
        p (vector-at M0 MM-ERR-POS)
        e1 (mem-sel e e code)
        p1 (mem-sel e p -1)]
    (vector-assoc! (vector-assoc! (vector-assoc! M0 MM-R0 ok) MM-ERR (mem-sel ok e e1)) MM-ERR-POS (mem-sel ok p p1))))

(defn- io-check-read [M0 :vector-i64 path :string] :vector-i64
  (io-check-fin M0 (io-exists path) E-IO-READ))

(defn- io-check-write [M0 :vector-i64 path :string] :vector-i64
  (io-check-fin M0 (io-exists path) E-IO-WRITE))

;; ---- hex on stdout ---------------------------------------------------------------------------------------
(defn- io-hexd [d :i64] :string
  (cond (= d 0) "0" (= d 1) "1" (= d 2) "2" (= d 3) "3" (= d 4) "4" (= d 5) "5" (= d 6) "6" (= d 7) "7"
        (= d 8) "8" (= d 9) "9" (= d 10) "a" (= d 11) "b" (= d 12) "c" (= d 13) "d" (= d 14) "e" :else "f"))

(defn- io-hex2 [b :i64] :string
  (string-concat (io-hexd (u64-shift-right b 4)) (io-hexd (bit-and b 15))))

;; hex of M[i..end) appended to acc
(defn- io-hex-line [M :vector-i64 i :i64 end :i64 acc :string] :string
  (cond (>= i end) acc
        :else (io-hex-line M (+ i 1) end (string-concat acc (io-hex2 (bit-and (vector-at M i) 255))))))

(defn- io-min [a :i64 b :i64] :i64 (if (< a b) a b))

(defn- io-hex-run [M :vector-i64 i :i64 end :i64] :i64
  (cond (>= i end) 0
        :else (io-hex-step M i end (io-min end (+ i 64)))))

(defn- io-hex-step [M :vector-i64 i :i64 end :i64 e :i64] :i64
  (let [w (typed-cap-call :io/write :string :string (string-concat (io-hex-line M i e "") "\n"))]
    (io-hex-run M e end)))

(defn- io-write-hex [M :vector-i64 base :i64 len :i64] :i64
  (io-hex-run M base (+ base len)))

;; ---- binary files (:fs/app-data-bytes, wire 35 kind 8) ------------------------------------------------
;; T[i + delta] = byte i of S for i in [i, end)
(defn- io-bput-str [T :vector-i64 S :string i :i64 end :i64 delta :i64] :vector-i64
  (if (>= i end)
    (mem-keep T)
    (io-bput-str (vector-assoc! T (+ i delta) (string-code-point-at S i)) S (+ i 1) end delta)))

;; T[i + delta] = M[i] & 255 for i in [i, end)
(defn- io-bput-words [T :vector-i64 M :vector-i64 i :i64 end :i64 delta :i64] :vector-i64
  (if (>= i end)
    (mem-keep T)
    (io-bput-words (vector-assoc! T (+ i delta) (bit-and (vector-at M i) 255)) M (+ i 1) end delta)))

(defn- io-bsend [T :vector-i64] :i64
  (let [r (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 T))] 0))

;; ==== BEGIN KIR5 write pieces (agent KIR5, 2026-10-03; CONTRACT-REQUESTS R4B line "the compile SIGILL") ==========
;; The loader's WRITE form refuses (SIGILL) a request whose content holds "WRITE_SEP", the APPEND form one whose content
;; holds "APPEND_SEP" (tools/kexe_loader.c fs_app_data_write_provider, single-occurrence rule). A compiled program whose
;; string pool spells either token put it into the container (and into an extracted code slice): the compile trapped.
;; io-write-bytes therefore cuts the content one byte into every occurrence of either token; the first piece is written
;; ("<path>WRITE_SEP<piece>"), the others appended ("<path>APPEND_SEP<piece>", the loader's buffered sink for the same
;; file; the next wire-35 request, io-exists in the callers, closes it). No piece holds a whole token, and none forms
;; across "<TOKEN>" + piece (neither token has a proper suffix that is a prefix of a token). Content without a token is
;; ONE write, as before. Both token texts are built at run time (byte tables / io-sep): never a literal of the seed.
;; byte k of token tw (0 WRITE_SEP, 9 bytes; 1 APPEND_SEP, 10 bytes)
(defn- io-tokb [tw :i64 k :i64] :i64
  (if (= tw 0) (vector-at [87 82 73 84 69 95 83 69 80] k) (vector-at [65 80 80 69 78 68 95 83 69 80] k)))

(defn- io-tokn [tw :i64] :i64 (if (= tw 0) 9 10))

;; 1 when M[i ..] (low 8 bits per word, below end) spells token tw
(defn- io-tok-at [M :vector-i64 i :i64 end :i64 tw :i64] :i64
  (if (> (+ i (io-tokn tw)) end)
    0
    (loop [k 0]
      (cond (>= k (io-tokn tw)) 1
            (= (bit-and (vector-at M (+ i k)) 255) (io-tokb tw k)) (recur (+ k 1))
            :else 0))))

;; the end of the piece that starts at i: one past the first byte of the first token occurrence at or after i, else end
(defn- io-cut [M :vector-i64 i :i64 end :i64] :i64
  (loop [p i]
    (cond (>= p end) end
          (= (io-tok-at M p end 0) 1) (+ p 1)
          (= (io-tok-at M p end 1) 1) (+ p 1)
          :else (recur (+ p 1)))))

;; token tw at T[at ..]
(defn- io-bput-tok [T :vector-i64 at :i64 tw :i64] :vector-i64
  (loop [k 0 V T]
    (if (>= k (io-tokn tw)) V (recur (+ k 1) (vector-assoc! V (+ at k) (io-tokb tw k))))))

;; one request "<path><token tw><M[i..j)>"
(defn- io-piece [M :vector-i64 path :string i :i64 j :i64 tw :i64] :i64
  (let [plen (string-length path)
        n (io-tokn tw)
        T0 (vector-alloc (+ plen (+ n (- j i))))
        T1 (io-bput-str T0 path 0 plen 0)
        T2 (io-bput-tok T1 plen tw)
        T3 (io-bput-words T2 M i j (- (+ plen n) i))]
    (io-bsend T3)))

(defn- io-pieces [M :vector-i64 path :string i :i64 end :i64 tw :i64] :i64
  (let [j (io-cut M i end)
        z (io-piece M path i j tw)]
    (if (< j end) (io-pieces M path j end 1) 0)))

(defn- io-write-bytes [M :vector-i64 path :string base :i64 len :i64] :i64
  (let [z (io-pieces M path base (+ base len) 0)]
    len))
;; ==== END KIR5 write pieces ============================================================================================

;; the bytes of path as a fresh vector (one item per byte)
(defn- io-path-vec [path :string] :vector-i64
  (io-bput-str (vector-alloc (string-length path)) path 0 (string-length path) 0))

(defn- io-read-bytes [path :string] :vector-i64
  (vector-i64-from-bytes (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 (io-path-vec path)))))

;; seed/10-lex.kotoba -- the lexer of the seed compiler R0 (module 10, prefix lx-). Owner: 10-lex.
;; Contract: seed/HEADS :tokens and :errors (E10nn), seed/MEMORY-MAP TOK/LIT/LITB regions and rules L1-L13.
;;
;;   (lx-run M S) -> M     writer. Fills TOK (kind start end val) for the whole of S, LIT/LITB for every string
;;                         token. Result in MM-R0: the token count (tokens are 1..count). On failure MM-ERR is set
;;                         (E1001-E1005, E101 table full), MM-ERR-POS/A/B/N as listed in seed/HEADS, tokens after
;;                         the error are not produced. Nothing is printed.
;;
;; R0/R1: the source had to be ASCII. R3 (agent R3, 2026-10-03, minimal delimited change marked R3 below; seed/HEADS
;; :tokens): a string literal or a comment may hold any UTF-8 text; a byte >= 128 anywhere else is E1002 at that byte. Whitespace: space tab LF CR ','. Comment: ';'
;; to end of line. TK-INT is -?[0-9]+ that fits i64 (-9223372036854775808 legal, 9223372036854775808 not).
;; TK-SYM is a maximal run of [A-Za-z0-9*+!_?<>=/.-] that is not an integer. TK-KW is ':' + such a run (the
;; span includes ':'; a lone ':' is E1005). Every other byte (# ^ ` ~ @ \ ' | % & $ ...) is E1005 with the
;; one-byte span. TK-STR spans both quotes and decodes \n \t \\ \" into LITB (other escapes: E1003, span = the
;; backslash and the next byte); a raw newline inside a string is kept as a byte.
;; E101 (table full) carries MM-ERR-N = region: 1 TOK, 2 LIT, 3 LITB.

;; Stage-0 linearity (the affine analysis in kotoba/compiler/affine.cljc, `check-affine-writes-module!`), which decides
;; every `vector-assoc!` of this module together. Style rules that follow from it, all measured:
;;   1. a handle returned by a writer is passed on as a NESTED call argument, `(g (f M x) y)`; it is never bound to a let
;;      name that is then passed or written (a let-bound handle must come from vector-alloc/vector-assoc!/...);
;;   2. a result that must be READ (positions, counts) is read in a callee through the callee's parameter:
;;      `(k (f M x))` with `(defn- k [M] (let [j (vector-at M R)] (g M j)))`;
;;   3. every path of a writer consumes the handle (a branch that returns M unchanged returns `(lx-id M)` instead);
;;   4. in an argument list, M is not mentioned again after it was passed (bind reads before the call).
;; lx-set wraps vector-assoc! so that a writer's result can be written without a let name (rule 1).
(defn- lx-set [M :vector-i64 i :i64 v :i64] :vector-i64 (vector-assoc! M i v))

;; Second probed rule: a writer that returns its handle UNCHANGED on some path is refused as soon as a caller reads
;; the result and passes it on ("M is used more than once"). So every path consumes the handle; the identity writer
;; rewrites M[MM-VERSION] with the value it always has.
(defn- lx-id [M :vector-i64] :vector-i64 (vector-assoc! M MM-VERSION MM-LAYOUT-VERSION))

(defn- lx-ch [S :string i :i64] :i64 (string-code-point-at S i))

(defn- lx-digit? [c :i64] :bool (lx-range? c 48 57))

(defn- lx-ws? [c :i64] :bool (or (= c 32) (= c 10) (= c 9) (= c 13) (= c 44)))

;; stage-0 (native image of 2026-10-02) answers "internal compiler error" for and/or/not anywhere but as the TAIL VALUE of a
;; function whose operands are plain comparisons or calls: not in an if/cond test, not nested in each other. So every
;; boolean combination lives in a small :bool function and tests are comparisons or calls (CONTRACT-REQUESTS 2026-10-02).
(defn- lx-range? [c :i64 lo :i64 hi :i64] :bool (and (>= c lo) (<= c hi)))

(defn- lx-symch? [c :i64] :bool
  (or (lx-range? c 97 122) (lx-range? c 65 90) (lx-range? c 48 57)
      (= c 42) (= c 43) (= c 33) (= c 95) (= c 63) (= c 60) (= c 62) (= c 61) (= c 47) (= c 46) (= c 45)
      ;; R4 (agent R4, minimal delimited change): `&` is a symbol byte (the rest marker of [p & rest], seed/HEADS HD-AMP)
      (= c 38)))

;; a byte that starts a string, keyword, integer or symbol
(defn- lx-multi? [c :i64] :bool (or (= c 34) (= c 58) (lx-symch? c)))

;; bracket byte -> token kind, 0 when the byte is not a bracket
(defn- lx-punct [c :i64] :i64
  (cond (= c 40) TK-LPAREN (= c 41) TK-RPAREN (= c 91) TK-LBRACK (= c 93) TK-RBRACK
        (= c 123) TK-LBRACE (= c 125) TK-RBRACE :else 0))

;; ---------------------------------------------------------------------------------------------------------
;; errors (first writer wins)
;; ---------------------------------------------------------------------------------------------------------
(defn- lx-fail [M :vector-i64 code :i64 pos :i64 a :i64 b :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [M1 (vector-assoc! M MM-ERR code)
          M2 (vector-assoc! M1 MM-ERR-POS pos)
          M3 (vector-assoc! M2 MM-ERR-A a)]
      (vector-assoc! M3 MM-ERR-B b))
    (lx-id M)))

;; stage-0 rule found by probing: a let-bound handle must not be returned bare in one branch while another branch
;; consumes it. So every "if ERR is clear" decision is taken in a function whose parameter M is the handle.
(defn- lx-fail-n [M :vector-i64 code :i64 pos :i64 n :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (lx-fail (vector-assoc! M MM-ERR-N n) code pos pos (+ pos 1))
    (lx-id M)))

(defn- lx-full [M :vector-i64 region :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (lx-fail (vector-assoc! M MM-ERR-N region) E-HEAP-REGION -1 0 0)
    (lx-id M)))

;; the lead byte of the UTF-8 sequence whose code point is cp (for the E1002 text)
(defn- lx-lead [cp :i64] :i64
  (cond (< cp 2048) (bit-or 192 (u64-shift-right cp 6))
        (< cp 65536) (bit-or 224 (u64-shift-right cp 12))
        :else (bit-or 240 (u64-shift-right cp 18))))

;; ---------------------------------------------------------------------------------------------------------
;; pushing tokens and bytes
;; ---------------------------------------------------------------------------------------------------------
(defn- lx-push [M :vector-i64 kind :i64 s :i64 e :i64 v :i64] :vector-i64
  (let [n (vector-at M MM-TOK-N)]
    (if (>= n MM-TOK-CAP)
      (lx-full M 1)
      (let [b (+ MM-TOK-BASE (* n MM-TOK-W))
            M1 (vector-assoc! M (+ b TF-KIND) kind)
            M2 (vector-assoc! M1 (+ b TF-START) s)
            M3 (vector-assoc! M2 (+ b TF-END) e)
            M4 (vector-assoc! M3 (+ b TF-VAL) v)]
        (vector-assoc! M4 MM-TOK-N (+ n 1))))))

(defn- lx-litb-push [M :vector-i64 byte :i64] :vector-i64
  (let [n (vector-at M MM-LITB-N)]
    (if (>= n MM-LITB-CAP)
      (lx-full M 3)
      (let [M1 (vector-assoc! M (+ MM-LITB-BASE n) byte)]
        (vector-assoc! M1 MM-LITB-N (+ n 1))))))

;; ---------------------------------------------------------------------------------------------------------
;; scanners over S (read-only)
;; ---------------------------------------------------------------------------------------------------------
;; R3: a comment may hold UTF-8: step over whole code points (string-code-point-at traps inside one)
(defn- lx-eol [S :string i :i64] :i64
  (loop [j i]
    (if (>= j (string-length S)) j (if (= (lx-ch S j) 10) j (recur (+ j (lx-cpw (lx-ch S j))))))))

(defn- lx-word-end [S :string i :i64] :i64
  (loop [j i]
    (if (< j (string-length S)) (if (lx-symch? (lx-ch S j)) (recur (+ j 1)) j) j)))

;; Seed-0 has no boolean literals (seed/HEADS): true/false are comparisons of constants
(defn- lx-true [] :bool (= 0 0))
(defn- lx-false [] :bool (= 0 1))

(defn- lx-all-digits [S :string a :i64 b :i64] :bool
  (loop [j a]
    (if (>= j b) (lx-true) (if (lx-digit? (lx-ch S j)) (recur (+ j 1)) (lx-false)))))

;; the span [a,b) (non-empty, symbol characters) is an integer literal
(defn- lx-int? [S :string a :i64 b :i64] :bool
  (if (= (lx-ch S a) 45)
    (if (> b (+ a 1)) (lx-all-digits S (+ a 1) b) (lx-false))
    (lx-all-digits S a b)))

;; first digit of the integer token at a (after the sign)
(defn- lx-int-start [S :string a :i64] :i64
  (if (= (lx-ch S a) 45) (+ a 1) a))

;; digits accumulate as a NEGATIVE magnitude so that -2^63 is representable
(defn- lx-int-ovf [S :string a :i64 b :i64] :bool
  (let [neg (= (lx-ch S a) 45)]
    (loop [j (lx-int-start S a) acc 0]
      (if (>= j b)
        (if neg (lx-false) (= acc -9223372036854775808))
        (let [d (- (lx-ch S j) 48)]
          (if (< acc -922337203685477580)
            (lx-true)
            (if (= acc -922337203685477580)
              (if (> d 8) (lx-true) (recur (+ j 1) (- (* acc 10) d)))
              (recur (+ j 1) (- (* acc 10) d)))))))))

(defn- lx-int-val [S :string a :i64 b :i64] :i64
  (let [neg (= (lx-ch S a) 45)
        m (loop [j (lx-int-start S a) acc 0]
            (if (>= j b) acc (recur (+ j 1) (- (* acc 10) (- (lx-ch S j) 48)))))]
    (if neg m (- 0 m))))

;; ---------------------------------------------------------------------------------------------------------
;; strings: reserve the LIT record, decode into LITB byte by byte, close at the quote
;; ---------------------------------------------------------------------------------------------------------
;; ---------------------------------------------------------------------------------------------------------
;; strings. Third probed rule: the result of a branching writer must not be read by the caller that goes on to pass
;; it (read it in a callee, through the parameter, or do not read it). Here nothing is read after a writer: the end of
;; a token is found first by read-only scans of S, then the writers run and the loop continues at that end.
;; ---------------------------------------------------------------------------------------------------------
;; ---- R3 (agent R3): UTF-8 in strings and comments, escapes \r \b \f \uXXXX ----
;; byte width of the UTF-8 sequence of code point cp
(defn- lx-cpw [cp :i64] :i64 (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))
;; value of hex digit c, -1 when c is not one
(defn- lx-hex [c :i64] :i64
  (cond (lx-range? c 48 57) (- c 48) (lx-range? c 97 102) (- c 87) (lx-range? c 65 70) (- c 55) :else -1))
;; the code point of \uXXXX whose 'u' is at j, -1 when malformed (fewer than 4 hex digits) or a surrogate; the digits
;; are read one by one and the scan stops at the first non-digit (so it never indexes inside a UTF-8 sequence)
(defn- lx-u4 [S :string j :i64] :i64
  (if (> (+ j 5) (string-length S))
    -1
    (loop [k 1 v 0]
      (if (> k 4)
        (if (and (>= v 55296) (<= v 57343)) -1 v)
        (let [h (lx-hex (lx-ch S (+ j k)))]
          (if (neg? h) -1 (recur (inc k) (+ (* v 16) h))))))))
;; push the UTF-8 bytes of code point cp
(defn- lx-utf8-push [M :vector-i64 cp :i64] :vector-i64
  (cond (< cp 128) (lx-litb-push M cp)
        (< cp 2048) (-> M (lx-litb-push (bit-or 192 (u64-shift-right cp 6))) (lx-litb-push (bit-or 128 (bit-and cp 63))))
        (< cp 65536) (-> M (lx-litb-push (bit-or 224 (u64-shift-right cp 12)))
                         (lx-litb-push (bit-or 128 (bit-and (u64-shift-right cp 6) 63)))
                         (lx-litb-push (bit-or 128 (bit-and cp 63))))
        :else (-> M (lx-litb-push (bit-or 240 (u64-shift-right cp 18)))
                  (lx-litb-push (bit-or 128 (bit-and (u64-shift-right cp 12) 63)))
                  (lx-litb-push (bit-or 128 (bit-and (u64-shift-right cp 6) 63)))
                  (lx-litb-push (bit-or 128 (bit-and cp 63))))))

(defn- lx-esc-code [e :i64] :i64
  (cond (= e 110) 10 (= e 116) 9 (= e 92) 92 (= e 34) 34 (= e 114) 13 (= e 98) 8 (= e 102) 12 :else -1))
;; R3: the source width of the escape whose backslash is at j (2, or 6 for \uXXXX), 0 when it is not a valid escape
(defn- lx-esc-w [S :string j :i64] :i64
  (let [e (lx-ch S (+ j 1))]
    (cond (= e 117) (if (neg? (lx-u4 S (+ j 1))) 0 6)
          (neg? (lx-esc-code e)) 0
          :else 2)))

;; index of the closing quote of the string that opens at i; -1 = unterminated; -(2+j) = bad escape at the backslash j
(defn- lx-str-find [S :string i :i64] :i64
  (loop [j (+ i 1)]
    (if (>= j (string-length S))
      -1
      (let [c (lx-ch S j)]
        (cond
          (= c 34) j
          (= c 92) (if (>= (+ j 1) (string-length S))
                     -1
                     (if (zero? (lx-esc-w S j)) (- -2 j) (recur (+ j (lx-esc-w S j)))))
          :else (recur (+ j (lx-cpw c))))))))

;; decode S[j, e) into LITB (e = the closing quote, escapes already validated)
(defn- lx-str-loop [M :vector-i64 S :string j :i64 e :i64] :vector-i64
  (if (>= j e)
    (lx-id M)
    (let [c (lx-ch S j)]
      (cond (and (= c 92) (= (lx-ch S (+ j 1)) 117)) (lx-str-loop (lx-utf8-push M (lx-u4 S (+ j 1))) S (+ j 6) e)
            (= c 92) (lx-str-loop (lx-litb-push M (lx-esc-code (lx-ch S (+ j 1)))) S (+ j 2) e)
            :else (lx-str-loop (lx-utf8-push M c) S (+ j (lx-cpw c)) e)))))

;; close the string token spanning S[i, e]: LF-LEN of the reserved LIT record, then the token
(defn- lx-str-end [M :vector-i64 i :i64 e :i64] :vector-i64
  (let [lit (- (vector-at M MM-LIT-N) 1)
        b (+ MM-LIT-BASE (* lit MM-LIT-W))
        len (- (vector-at M MM-LITB-N) (vector-at M (+ b LF-B)))]
    (lx-push (lx-set M (+ b LF-LEN) len) TK-STR i (+ e 1) lit)))

;; reserve the LIT record (first byte, token index), then decode, then close
(defn- lx-string [M :vector-i64 S :string i :i64 e :i64] :vector-i64
  (let [lit (vector-at M MM-LIT-N)]
    (if (>= lit MM-LIT-CAP)
      (lx-full M 2)
      (let [b (+ MM-LIT-BASE (* lit MM-LIT-W))
            litb (vector-at M MM-LITB-N)
            tok (vector-at M MM-TOK-N)
            M1 (vector-assoc! M (+ b LF-B) litb)
            M2 (vector-assoc! M1 (+ b LF-TOK) tok)
            M3 (vector-assoc! M2 MM-LIT-N (+ lit 1))]
        (lx-str-end (lx-str-loop M3 S (+ i 1) e) i e)))))

;; ---------------------------------------------------------------------------------------------------------
;; the scan loop (one self tail call per token or skipped byte)
;; ---------------------------------------------------------------------------------------------------------
;; integer or symbol token spanning S[i, j)
;; ==== R6B (agent R6B, 2026-10-03, delimited): hex integer literals -?0x.. / -?0X.. (digits 0-9 a-f A-F), as the reference
;; reader reads them; the value must fit i64 (E1004 otherwise, like a decimal literal): 0x7fffffffffffffff and
;; -0x8000000000000000 are the extremes. The magnitude accumulates NEGATIVE so that -2^63 is representable.
(defn- lx-hx? [S :string a :i64 b :i64] :bool
  (let [s (lx-int-start S a)]
    (and (> b (+ s 2)) (= (lx-ch S s) 48) (or (= (lx-ch S (+ s 1)) 120) (= (lx-ch S (+ s 1)) 88))
         (loop [j (+ s 2)] (cond (>= j b) true (< (lx-hex (lx-ch S j)) 0) false :else (recur (+ j 1)))))))
;; the negated magnitude, or 1 when it does not fit in 64 bits
(defn- lx-hx-neg [S :string a :i64 b :i64] :i64
  (loop [j (+ (lx-int-start S a) 2) acc 0]
    (cond (>= j b) acc
          (< acc -576460752303423488) 1
          :else (let [n (- (* acc 16) (lx-hex (lx-ch S j)))] (if (> n 0) 1 (recur (+ j 1) n))))))
(defn- lx-hx-word [M :vector-i64 S :string i :i64 j :i64] :vector-i64
  (let [m (lx-hx-neg S i j)
        neg (= (lx-ch S i) 45)]
    (cond (> m 0) (lx-fail M E-LEX-INT i i j)
          neg (lx-push M TK-INT i j m)
          (= m -9223372036854775808) (lx-fail M E-LEX-INT i i j)
          :else (lx-push M TK-INT i j (- 0 m)))))
;; ==== END R6B hex ====

(defn- lx-word [M :vector-i64 S :string i :i64 j :i64] :vector-i64
  (if (lx-hx? S i j) (lx-hx-word M S i j)   ; R6B
  (if (lx-int? S i j)
    (if (lx-int-ovf S i j)
      (lx-fail M E-LEX-INT i i j)
      (lx-push M TK-INT i j (lx-int-val S i j)))
    (lx-push M TK-SYM i j 0))))

;; the string token that opens at i, given e = lx-str-find
(defn- lx-str-token [M :vector-i64 S :string i :i64 e :i64] :vector-i64
  (cond (>= e 0) (lx-string M S i e)
        (= e -1) (lx-fail M E-LEX-STRING i i (+ i 1))
        :else (lx-fail M E-LEX-ESCAPE (- -2 e) (- -2 e) (- 0 e))))

;; one multi-byte token at i (string, keyword, integer, symbol): the writer for it. Its end is lx-tok-end.
(defn- lx-token [M :vector-i64 S :string i :i64 j :i64] :vector-i64
  (let [c (lx-ch S i)]
    (cond (= c 34) (lx-str-token M S i j)
          (= c 58) (if (= j (+ i 1)) (lx-fail M E-LEX-SYNTAX i i (+ i 1)) (lx-push M TK-KW i j 0))
          :else (lx-word M S i j))))

;; where the multi-byte token at i ends: after the closing quote, or at the end of the symbol-character run.
;; For an erroneous string the "end" is only used as an error carrier (a negative code), see lx-token.
(defn- lx-tok-end [S :string i :i64] :i64
  (let [c (lx-ch S i)]
    (cond (= c 34) (lx-str-find S i)
          (= c 58) (lx-word-end S (+ i 1))
          :else (lx-word-end S i))))

;; the position the scan continues at after the token whose lx-tok-end is j (a string: after the quote)
(defn- lx-after [S :string i :i64 j :i64] :i64
  (if (= (lx-ch S i) 34) (+ j 1) j))

(defn- lx-scan [M :vector-i64 S :string i :i64 end :i64] :vector-i64
  (if (>= i end)
    (lx-id M)
    (if (= (vector-at M MM-ERR) 0)
      (let [c (lx-ch S i)
            pk (lx-punct c)]
        (cond
          (lx-ws? c) (lx-scan M S (+ i 1) end)
          (= c 59) (lx-scan M S (lx-eol S i) end)
          (> pk 0) (lx-scan (lx-push M pk i (+ i 1) 0) S (+ i 1) end)
          (lx-hash-brace? S i c) (lx-scan (lx-push M TK-HASH-BRACE i (+ i 2) 0) S (+ i 2) end)
          ;; R5A (agent R5A, minimal delimited change): #?( and #?@( select at read time (lx-rc below)
          (> (lx-rc-w S i c) 0) (lx-rc M S i end (lx-rc-w S i c))
          ;; R5B (agent R5B, delimited): '@' is a token of its own; 11-read reads @x as (deref x)
          (= c 64) (lx-scan (lx-push M TK-AT i (+ i 1) 0) S (+ i 1) end)
          ;; R6A (agent R6A, minimal delimited change): ^meta before a form reads as nothing (the reference keeps metadata off
          ;; the value; 932 of the 940 uses in the R6 modules are (def ^:private ..), and a def is never an export)
          (= c 94) (let [q (lx-sk-next S (+ i 1))] (if (< q 0) (lx-fail M E-LEX-SYNTAX i i (+ i 1)) (lx-scan M S q end)))
          (> c 127) (lx-fail-n M E-LEX-ASCII i (lx-lead c))
          (lx-multi? c)
          (let [j (lx-tok-end S i)]
            (lx-scan (lx-token M S i j) S (lx-after S i j) end))
          :else (lx-fail M E-LEX-SYNTAX i i (+ i 1))))
      (lx-id M))))

;; ---- R5A (agent R5A, 2026-10-03; docs/selfhost-seed-r5-design-20261002.md 2.4): reader conditionals ----------------
;; #?(f1 x1 f2 x2 ..) reads as the FIRST xk whose feature fk is :kotoba or :default, and as nothing when none matches;
;; #?@(..) splices the items of the selected vector or list. Unselected arms are host code, so they are passed over by
;; a lenient skipper (balanced brackets, strings, char literals, comments, #"..", tagged literals, prefixes, metadata)
;; that never classifies tokens; only the selected arm is lexed. Malformed (a feature that is not a keyword, a feature
;; without a form, an unclosed conditional, a splice of a non-sequence): E1006 at the '#'.
;; 3 for "#?(", 4 for "#?@(", else 0
(defn- lx-rc-w [S :string i :i64 c :i64] :i64
  (cond (not= c 35) 0
        (>= (+ i 2) (string-length S)) 0
        (not= (lx-ch S (+ i 1)) 63) 0
        (= (lx-ch S (+ i 2)) 40) 3
        (>= (+ i 3) (string-length S)) 0
        (and (= (lx-ch S (+ i 2)) 64) (= (lx-ch S (+ i 3)) 40)) 4
        :else 0))
;; past whitespace and comments
(defn- lx-sk-ws [S :string p :i64] :i64
  (cond (>= p (string-length S)) p
        (lx-ws? (lx-ch S p)) (lx-sk-ws S (+ p 1))
        (= (lx-ch S p) 59) (lx-sk-ws S (lx-eol S p))
        :else p))
(defn- lx-closer? [c :i64] :bool (or (= c 41) (= c 93) (= c 125)))
(defn- lx-delim? [c :i64] :bool (or (lx-ws? c) (= c 40) (lx-closer? c) (= c 91) (= c 123) (= c 34) (= c 59)))
;; end of an atom run from p (stepping whole code points)
(defn- lx-sk-atom [S :string p :i64] :i64
  (cond (>= p (string-length S)) p
        (lx-delim? (lx-ch S p)) p
        :else (lx-sk-atom S (+ p (lx-cpw (lx-ch S p))))))
;; after the closing quote of the string whose first content byte is p, -1 at end of input
(defn- lx-sk-str [S :string p :i64] :i64
  (cond (>= p (string-length S)) -1
        (= (lx-ch S p) 34) (+ p 1)
        (= (lx-ch S p) 92) (if (>= (+ p 1) (string-length S)) -1 (lx-sk-str S (+ p 1 (lx-cpw (lx-ch S (+ p 1))))))
        :else (lx-sk-str S (+ p (lx-cpw (lx-ch S p))))))
;; after the closer of the sequence whose first item may start at p, -1 when unclosed
(defn- lx-sk-seq [S :string p :i64] :i64
  (let [q (lx-sk-ws S p)]
    (cond (>= q (string-length S)) -1
          (lx-closer? (lx-ch S q)) (+ q 1)
          :else (let [r (lx-sk-form S q)] (if (< r 0) -1 (lx-sk-seq S r))))))
;; the form after p (whitespace first), -1 when there is none
(defn- lx-sk-next [S :string p :i64] :i64
  (let [q (lx-sk-ws S p)]
    (if (>= q (string-length S)) -1 (lx-sk-form S q))))
;; '#' at p: dispatch forms
(defn- lx-sk-hash [S :string p :i64] :i64
  (if (>= (+ p 1) (string-length S))
    -1
    (let [d (lx-ch S (+ p 1))]
      (cond (= d 40) (lx-sk-seq S (+ p 2))
            (= d 123) (lx-sk-seq S (+ p 2))
            (= d 34) (lx-sk-str S (+ p 2))
            (= d 63) (lx-sk-form S (if (and (< (+ p 2) (string-length S)) (= (lx-ch S (+ p 2)) 64)) (+ p 3) (+ p 2)))
            (= d 95) (lx-sk-next S (+ p 2))
            (= d 39) (lx-sk-next S (+ p 2))
            (lx-delim? d) -1
            :else (lx-sk-next S (lx-sk-atom S (+ p 1)))))))
;; after the form that starts at p (p is not whitespace), -1 when malformed or unclosed
(defn- lx-sk-form [S :string p :i64] :i64
  (let [c (lx-ch S p)]
    (cond (or (= c 40) (= c 91) (= c 123)) (lx-sk-seq S (+ p 1))
          (lx-closer? c) -1
          (= c 34) (lx-sk-str S (+ p 1))
          (= c 92) (if (>= (+ p 1) (string-length S)) -1 (lx-sk-atom S (+ p 1 (lx-cpw (lx-ch S (+ p 1))))))
          (= c 35) (lx-sk-hash S p)
          (= c 94) (let [m (lx-sk-next S (+ p 1))] (if (< m 0) -1 (lx-sk-next S m)))
          (and (= c 126) (< (+ p 1) (string-length S)) (= (lx-ch S (+ p 1)) 64)) (lx-sk-next S (+ p 2))
          (or (= c 39) (= c 96) (= c 126) (= c 64)) (lx-sk-next S (+ p 1))
          :else (lx-sk-atom S p))))
;; 1 when S[a,b) spells :kotoba or :default
(defn- lx-rc-feature? [S :string a :i64 b :i64] :bool
  (let [f (string-substring S a b)]
    (or (string=? f ":kotoba") (string=? f ":default"))))
;; start of the selected form of the clauses from p; -1 = none matches; -2 = malformed
(defn- lx-rc-sel [S :string p :i64 found :i64] :i64
  (let [q (lx-sk-ws S p)]
    (cond (>= q (string-length S)) -2
          (= (lx-ch S q) 41) found
          (not= (lx-ch S q) 58) -2
          :else (let [ke (lx-sk-atom S q)
                      f (lx-sk-ws S ke)]
                  (cond (= ke (+ q 1)) -2
                        (>= f (string-length S)) -2
                        (lx-closer? (lx-ch S f)) -2
                        :else (let [fe (lx-sk-form S f)]
                                (cond (< fe 0) -2
                                      (and (< found 0) (lx-rc-feature? S q ke)) (lx-rc-sel S fe f)
                                      :else (lx-rc-sel S fe found))))))))
;; the conditional at i (w = 3 or 4): lex the selected arm (a splice: its items), then go on after the conditional
(defn- lx-rc [M :vector-i64 S :string i :i64 end :i64 w :i64] :vector-i64
  (let [whole (lx-sk-seq S (+ i w))
        sel (lx-rc-sel S (+ i w) -1)
        se (if (< sel 0) -1 (lx-sk-form S sel))
        sc (if (< sel 0) 0 (lx-ch S sel))]
    (cond (or (< whole 0) (> whole end) (= sel -2)) (lx-fail M E-LEX-RC i i (+ i w))
          (= sel -1) (lx-scan M S whole end)
          (= w 3) (lx-scan (lx-scan M S sel se) S whole end)
          (or (= sc 91) (= sc 40)) (lx-scan (lx-scan M S (+ sel 1) (- se 1)) S whole end)
          :else (lx-fail M E-LEX-RC i i (+ i w)))))
;; ---- end R5A ----

;; whole-input ASCII check; stops at the first non-ASCII lead byte, so it never indexes a continuation byte. R3: no longer
;; part of lx-run (strings and comments may hold UTF-8); kept for 12-kirread's KIR lexer (kr-lex), which still uses it.
(defn- lx-ascii [M :vector-i64 S :string i :i64] :vector-i64
  (if (>= i (string-length S))
    (lx-id M)
    (let [c (lx-ch S i)]
      (if (> c 127)
        (lx-fail-n M E-LEX-ASCII i (lx-lead c))
        (lx-ascii M S (+ i 1))))))

;; R3: '#{' opens a set literal (any other '#' stays E1005)
(defn- lx-hash-brace? [S :string i :i64 c :i64] :bool
  (and (= c 35) (< (+ i 1) (string-length S)) (= (lx-ch S (+ i 1)) 123)))

;; scan after a clean ASCII check; the count of tokens is left in MM-R0
(defn- lx-count [M :vector-i64] :vector-i64
  (let [n (- (vector-at M MM-TOK-N) 1)]
    (lx-set M MM-R0 n)))

(defn- lx-run2 [M :vector-i64 S :string] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (lx-count (lx-scan M S 0 (string-length S)))
    (lx-id M)))

(defn- lx-run [M :vector-i64 S :string] :vector-i64
  (lx-run2 M S))

;; seed/11-read.kotoba -- the reader of the seed compiler R0 (module 11, prefix rd-). Owner: 11-read.
;; Contract: seed/HEADS :nodes and :errors (E11nn), seed/MEMORY-MAP NODE region (fields NF-KIND NF-FIRST NF-NEXT
;; NF-TOK NF-AUX) and rules L1-L13. Reads the tokens that 10-lex produced.
;;
;;   (rd-run M S) -> M    writer. Builds the node tree and stores the ND-ROOT node in MM-ROOT and in MM-R0. The
;;                        children of the root are the top-level forms in source order. On failure MM-ERR is set
;;                        (E1101 unexpected closer, E1102 unclosed at end of file, E1103 mismatched closer,
;;                        E1105 map, E101 node table full with MM-ERR-N = 4) and MM-ERR-POS is the start byte of
;;                        the token, MM-ERR-A/B its span (for E1102 the span of the OPENING bracket). Does nothing
;;                        when MM-ERR is already set.
;;
;; Nodes: ND-LIST ( ... ) and ND-VEC [ ... ] have a child list (NF-FIRST, NF-NEXT, 0 ends) and NF-AUX = child
;; count; NF-TOK = the index of the opening bracket token. ND-INT: NF-AUX = the i64 value; ND-STR: NF-AUX = the LIT
;; index; ND-SYM and ND-KW: NF-AUX = 0 (the name is the span of the token NF-TOK, in S). The root has NF-TOK 0.
;; R1 (2026-10-02, agent R1; seed/CONTRACT-REQUESTS.md): a '{' opens an ND-MAP node like a list (children = keys and
;; values in source order); 21-check admits it only as the argument of (map->Name {..}) and refuses it elsewhere (E1105).
;; R3 (2026-10-03, agent R3; minimal delimited change): '#{' (TK-HASH-BRACE) opens an ND-SET node (children = the items),
;; closed by '}'; 21-check types {..} and #{..} as typed map and set literals.
;; Recursion: rd-form <-> rd-items (nesting depth = native stack depth); a list's items are a self tail loop.

;; Linearity style of this module (stage-0 affine analysis, see the notes at lx-set in 10-lex): the handle returned by a
;; writer is passed on as a NESTED call argument, never bound to a let name; a result that must be read is read in a callee
;; through its parameter (rd-atom2, rd-items2, rd-open2, rd-run2).
(defn- rd-set [M :vector-i64 i :i64 v :i64] :vector-i64 (vector-assoc! M i v))

;; see the second rule at lx-id in 10-lex: every path of a writer consumes the handle
(defn- rd-id [M :vector-i64] :vector-i64 (vector-assoc! M MM-VERSION MM-LAYOUT-VERSION))

;; NOTE: no reader helper takes M. A call `(helper M ..)` makes M "consumed" or "escaped" for the stage-0 affine analysis, so every
;; read of the heap is an inline `(vector-at M (+ BASE (* i W) FIELD))`: token fields at MM-TOK-BASE/MM-TOK-W, node fields at
;; MM-NODE-BASE/MM-NODE-W.

(defn- rd-nset [M :vector-i64 n :i64 f :i64 v :i64] :vector-i64
  (vector-assoc! M (+ MM-NODE-BASE (* n MM-NODE-W) f) v))

(defn- rd-fail [M :vector-i64 code :i64 pos :i64 a :i64 b :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [M1 (vector-assoc! M MM-ERR code)
          M2 (vector-assoc! M1 MM-ERR-POS pos)
          M3 (vector-assoc! M2 MM-ERR-A a)]
      (vector-assoc! M3 MM-ERR-B b))
    (rd-id M)))

;; an error that names token t: position and span are the token's
(defn- rd-fail-tok [M :vector-i64 code :i64 t :i64] :vector-i64
  (let [s (vector-at M (+ MM-TOK-BASE (* t MM-TOK-W) TF-START))
        e (vector-at M (+ MM-TOK-BASE (* t MM-TOK-W) TF-END))]
    (rd-fail M code s s e)))

(defn- rd-full [M :vector-i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (rd-fail (vector-assoc! M MM-ERR-N 4) E-HEAP-REGION -1 0 0)
    (rd-id M)))

;; new node; its index is left in MM-R0
(defn- rd-new [M :vector-i64 kind :i64 tok :i64 aux :i64] :vector-i64
  (let [n (vector-at M MM-NODE-N)]
    (if (>= n MM-NODE-CAP)
      (rd-full M)
      (let [b (+ MM-NODE-BASE (* n MM-NODE-W))
            M1 (vector-assoc! M (+ b NF-KIND) kind)
            M2 (vector-assoc! M1 (+ b NF-TOK) tok)
            M3 (vector-assoc! M2 (+ b NF-AUX) aux)
            M4 (vector-assoc! M3 (+ b NF-FIRST) 0)
            M5 (vector-assoc! M4 (+ b NF-NEXT) 0)
            M6 (vector-assoc! M5 MM-NODE-N (+ n 1))]
        (vector-assoc! M6 MM-R0 n)))))

;; append child to parent after `last` (0 = first child) and count it in NF-AUX
(defn- rd-link2 [M :vector-i64 parent :i64] :vector-i64
  (let [cnt (vector-at M (+ MM-NODE-BASE (* parent MM-NODE-W) NF-AUX))]
    (rd-nset M parent NF-AUX (+ cnt 1))))

(defn- rd-link [M :vector-i64 parent :i64 last :i64 child :i64] :vector-i64
  (if (= last 0)
    (rd-link2 (rd-nset M parent NF-FIRST child) parent)
    (rd-link2 (rd-nset M last NF-NEXT child) parent)))

(defn- rd-closer? [k :i64] :bool (or (= k TK-RPAREN) (= k TK-RBRACK) (= k TK-RBRACE)))

;; atom node for token t; reading continues at t+1: MM-R0 = t+1, MM-R1 = the node. (The writer's result is read in
;; rd-atom2 through its parameter, see the third rule at lx-str-find in 10-lex.)
(defn- rd-atom2 [M :vector-i64 t :i64] :vector-i64
  (let [n (vector-at M MM-R0)]
    (rd-set (rd-set M MM-R1 n) MM-R0 (+ t 1))))

(defn- rd-atom [M :vector-i64 t :i64 kind :i64 aux :i64] :vector-i64
  (rd-atom2 (rd-new M kind t aux) t))

;; the closing token kind of a list or vector node kind
(defn- rd-want [pk :i64] :i64
  (cond (= pk ND-LIST) TK-RPAREN (= pk ND-MAP) TK-RBRACE (= pk ND-SET) TK-RBRACE :else TK-RBRACK))

;; closing bracket token t (kind k) met inside `parent`: success leaves MM-R0 = t+1
(defn- rd-close [M :vector-i64 t :i64 k :i64 parent :i64] :vector-i64
  (let [pk (vector-at M (+ MM-NODE-BASE (* parent MM-NODE-W) NF-KIND))
        want (rd-want pk)]
    (cond
      (= pk ND-ROOT) (rd-fail-tok M E-READ-CLOSE t)
      (= k want) (rd-set M MM-R0 (+ t 1))
      :else (rd-fail-tok M E-READ-MISMATCH t))))

;; end of tokens inside `parent`: fine for the root, E1102 naming the opening bracket otherwise
(defn- rd-eof [M :vector-i64 t :i64 parent :i64] :vector-i64
  (if (= (vector-at M (+ MM-NODE-BASE (* parent MM-NODE-W) NF-KIND)) ND-ROOT)
    (rd-set M MM-R0 t)
    (let [open (vector-at M (+ MM-NODE-BASE (* parent MM-NODE-W) NF-TOK))]
      (rd-fail-tok M E-READ-EOF open))))

;; after one form was read (M1 is the result of rd-form): link it and go on, unless an error stopped it
(defn- rd-items2 [M :vector-i64 parent :i64 last :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [t2 (vector-at M MM-R0)
          n (vector-at M MM-R1)]
      (rd-items (rd-link M parent last n) t2 parent n))
    (rd-id M)))

(defn- rd-items [M :vector-i64 t :i64 parent :i64 last :i64] :vector-i64
  (if (>= t (vector-at M MM-TOK-N))
    (rd-eof M t parent)
    (let [k (vector-at M (+ MM-TOK-BASE (* t MM-TOK-W) TF-KIND))]
      (if (rd-closer? k)
        (rd-close M t k parent)
        (rd-items2 (rd-form M t) parent last)))))

;; opening bracket at token t: node of kind nk, then its items; MM-R0 = token after the closer, MM-R1 = node
(defn- rd-open2 [M :vector-i64 t :i64 nk :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [n (vector-at M MM-R0)]
      (rd-set (rd-items M (+ t 1) n 0) MM-R1 n))
    (rd-id M)))

(defn- rd-open [M :vector-i64 t :i64 nk :i64] :vector-i64
  (rd-open2 (rd-new M nk t 0) t nk))

;; one form starting at token t; MM-R0 = next token, MM-R1 = the node
(defn- rd-form [M :vector-i64 t :i64] :vector-i64
  (let [k (vector-at M (+ MM-TOK-BASE (* t MM-TOK-W) TF-KIND))
        v (vector-at M (+ MM-TOK-BASE (* t MM-TOK-W) TF-VAL))]
    (cond
      (= k TK-LPAREN) (rd-open M t ND-LIST)
      (= k TK-LBRACK) (rd-open M t ND-VEC)
      (= k TK-LBRACE) (rd-open M t ND-MAP)
      (= k TK-HASH-BRACE) (rd-open M t ND-SET)
      (= k TK-AT) (rd-deref M t)   ; R5B
      (rd-closer? k) (rd-fail-tok M E-READ-CLOSE t)
      (= k TK-INT) (rd-atom M t ND-INT v)
      (= k TK-STR) (rd-atom M t ND-STR v)
      (= k TK-SYM) (rd-atom M t ND-SYM 0)
      :else (rd-atom M t ND-KW 0))))

;; R5B (agent R5B, delimited): @x at token t reads as the list (@ x) -- a list node and a head symbol node on the '@' token
;; (20-names interns the spelling "@" as HD-DEREF), then the next form; MM-R0 = the token after it, MM-R1 = the list. A '@'
;; with no form after it is E1005.
(defn- rd-deref [M :vector-i64 t :i64] :vector-i64
  (if (or (>= (+ t 1) (vector-at M MM-TOK-N)) (rd-closer? (vector-at M (+ MM-TOK-BASE (* (+ t 1) MM-TOK-W) TF-KIND))))
    (rd-fail-tok M E-LEX-SYNTAX t)
    (rd-deref2 (rd-new M ND-LIST t 2) t)))
(defn- rd-deref2 [M :vector-i64 t :i64] :vector-i64
  (let [l (vector-at M MM-R0)] (rd-deref3 (rd-new M ND-SYM t 0) t l)))
(defn- rd-deref3 [M :vector-i64 t :i64 l :i64] :vector-i64
  (let [h (vector-at M MM-R0)] (rd-deref4 (rd-form M (+ t 1)) l h)))
(defn- rd-deref4 [M :vector-i64 l :i64 h :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [x (vector-at M MM-R1)
          nx (vector-at M MM-R0)]
      (rd-set (rd-set (rd-nset (rd-nset M l NF-FIRST h) h NF-NEXT x) MM-R0 nx) MM-R1 l))
    (rd-id M)))

(defn- rd-run2 [M :vector-i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [root (vector-at M MM-R0)]
      (rd-set (rd-items (vector-assoc! M MM-ROOT root) 1 root 0) MM-R0 root))
    (rd-id M)))

(defn- rd-run [M :vector-i64 S :string] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (rd-run2 (rd-new M ND-ROOT 0 0))
    (rd-id M)))

;; seed/12-kirread.kotoba -- the KIR text reader of the seed compiler (module 12, prefix kr-). Owner: agent KIR.
;; Design: docs/selfhost-seed-design-20261002.md section 5.2 (the seed backend as a KIR consumer); report and measurements:
;; docs/selfhost-seed-kirread-20261002.md.
;;
;; Input: the KIR text stage-0 writes as the :program of a :kotoba.kexe/v1 artifact (`amu compile --target aarch64-macos
;; --output x.kexe`), i.e. one EDN map {:format :kotoba.kir/v3|v4 :entry nil :exports [..] :signature nil :effects #{}
;; :functions [{:name f :params [p ..] :result :T :effects #{} :body EXPR [:param-types [:T ..]]} ..]}, or a whole
;; kexe/v1 (then only its :program is lexed, kr-prog). Output: the seed's own read tree of an equivalent Seed-0
;; program, so that 20-names, 21-check (the soundness gate: everything outside Seed-0 is still refused by name),
;; 30-lower, 41-a64gen, 42-layout and 50-out run unchanged:
;;     (ns kir (:export [..]))  (defn f [p :T ..] :R EXPR') ...
;; The rewrites EXPR -> EXPR' (all in place on the read tree, new nodes only where a form needs more children):
;;   (vector-new e ..)              -> [e ..]                     (KIR spelling of a vector literal)
;;   (string-byte-length s)         -> (string-length s)          (both are the byte length, pair_second)
;;   true / false                   -> (= 0 0) / (= 0 1)          (Seed-0 has no boolean literals)
;;   (let [__kotoba_and_N x] (if __kotoba_and_N y __kotoba_and_N)) -> (and x y)   KIR's expansion of and/or, recovered
;;   (let [__kotoba_or_N x] (if __kotoba_or_N __kotoba_or_N y))    -> (or x y)    so that the seed lowers them as from
;;   (if x false true)              -> (not x)                    source (BRZ/BRNZ chains, UN NOT; no let slot)
;;   (__kotoba_loop_N a1 .. an)     -> (loop [p1 a1 .. pn an] BODY')   where __kotoba_loop_N is the KIR loop helper with
;;                                     params [p1 .. pn] and body BODY; inside BODY' the helper's own calls become
;;                                     (recur ..). KIR lifts every `loop` into such a helper (loop vars first, then the
;;                                     captured locals, passed unchanged); inlining it back keeps the seed's loop code and
;;                                     fuel rule (one unit per back edge) and avoids helpers with more than 5 parameters
;;                                     (md5sum has one with 9). A helper must be called exactly once, with its arity
;;                                     (E1204 otherwise); helper definitions are not emitted as functions. Captured
;;                                     locals that are provably invariant are dropped from the loop (kr-drop).
;;   v3 functions have no :param-types: every parameter is declared :i64 (21-check refuses the program if that is wrong).
;;   :effects must be empty, :entry and :signature nil (E1203); an unknown field is E1202; anything else is E1201.
;;
;; Lexing: kr-lex is 10-lex's scan with two changes: `{` `}` are read as `[` `]` (a map is read as the vector of its
;; alternating keys and values; 11-read is unchanged) and a `#` directly before `{` is skipped (the empty set #{} of
;; :effects). Names in the generated forms (ns, defn, loop, recur, =, 0, 1, string-length, :export, :i64, and, or, not,
;; the namespace name kir) need tokens whose span spells them: the driver appends kr-prelude to the KIR text (string-concat) and the
;; reader uses its tokens. The prelude forms are the last kr-np top-level atoms of the read tree and are dropped.
;;
;;   (kr-lex M S) -> M   tokens of S (MM-R0 = count), like lx-run
;;   (kr-run M S) -> M   after rd-run: rewrites the tree, MM-ROOT = the new root (ns form first). MM-ERR on failure:
;;                       E1201 not a KIR program, E1202 unsupported field, E1203 unsupported value, E1204 loop helper not
;;                       called exactly once with its arity, E101/E102 table full; {name} = the span of the node named.
;;
;; M cells (MEMORY-MAP: M[MM-STAT-BASE+60..63], free after the MANIFEST grew to 15 files; see CONTRACT-REQUESTS):
;;   124 first prelude token, 125 the :exports vector node, 126 the :functions vector node, 127 the function table
;;   (heap address; 1 = ":format seen" before the table exists). Function table: word 0 = function count, word 1 = the
;;   address of the new string-literal records, word 2 = the next new literal index, (KIR3) word 3 = library use bits, word
;;   4 = the first library defn, (KIR4) word 5 = the record of the function being emitted, (KIR5) word 6 = the first doc
;;   library defn (its original sibling chain survives kr-lib-emit), then (from word kr-th) one record
;;   of kr-w words per function (kr-f-*), then the new literal records (4 words, LF-* layout).
;;
;; String literals: KIR repeats a def's string at every use (it has no defs), so the LIT table of 10-lex is rebuilt
;; from the strings the emitted program contains, in walk order, equal bytes sharing one record (kr-str, kr-lits): the
;; pool then holds each distinct string once, as on the source route.

(def kr-np 41)
(def kr-c-pb 124)
(def kr-c-exp 125)
(def kr-c-fns 126)
(def kr-c-tab 127)
(def kr-w 10)
(def kr-th 12)
(def kr-f-name 0)
(def kr-f-params 1)
(def kr-f-result 2)
(def kr-f-body 3)
(def kr-f-ptypes 4)
(def kr-f-used 5)
(def kr-f-map 6)
(def kr-f-drop 7)
;; SEEDFIX: word 8 = 1 when machine_ir's lowering of the function would contain a call, runtime call or capability call
;; (its fuel rule: such a function is charged on entry), word 9 = 1 for a late (string-result) export; table words 7..10:
;; the mark array, the analysis environment stack, the analysis accumulator, the module's record-boundary flag
(def kr-f-re 8)
(def kr-f-lx 9)
(def kr-t-mk 7)
(def kr-t-env 8)
(def kr-t-acc 9)
(def kr-t-rb 10)
(def kr-t-met 11)
(def kr-e-doc 1201)
(def kr-e-field 1202)
(def kr-e-value 1203)
(def kr-e-helper 1204)

;; prelude token k (0-based): 0 ns, 1 kir, 2 :export, 3 defn, 4 loop, 5 recur, 6 =, 7 0, 8 1, 9 string-length, 10 :i64,
;; 11 and, 12 or, 13 not, 14 assoc, 15 let, 16 if, 17 <, 18 >, 19 __kr_a, 20 __kr_b,
;; (KIR3) 21 :fs/app-data 22 :io/write 23 :cli/args 24 :io/write-error 25 :fs/app-data-bytes 26 nth 27 :option 28 :result
;; 29 option-some-of 30 option-none-of 31 option-some?-of 32 option-value-of 33 result-ok-of 34 result-err-of
;; 35 result-ok?-of 36 result-value-of 37 result-error-of (KIR4) 38 :string (KIR5) 39 string=? 40 :string (the type a
;; :keyword becomes: a token of its own, so kr-is-kwtype still sees that the KIR said :keyword)
(defn- kr-prelude [] :string
  (string-concat
    "\n ns kir :export defn loop recur = 0 1 string-length :i64 and or not assoc let if < > __kr_a __kr_b :fs/app-data :io/write :cli/args :io/write-error :fs/app-data-bytes nth :option :result option-some-of option-none-of option-some?-of option-value-of result-ok-of result-err-of result-ok?-of result-value-of result-error-of :string string=? :string\n"
    (kr-lib-text)))

;; KIR3: the KIR library -- KIR builtins the seed has no head for, written in the seed language with the meaning (and the
;; traps) of the loader's runtime operation that stage-0 calls or of stage-0's own lowering (kotoba-native
;; string_search.cljk). They follow the prelude atoms as kr-nlib top-level defns; a KIR call of such a builtin is respelled
;; as a call of its library function (kr-lib-use) and only the functions a program uses are emitted (kr-lib-emit), so a
;; program that uses none compiles to the same bytes as before. Library function j (bit j of the table's word 3):
;;   0 (string-find-byte s b from)     ABI v10 string_find_byte: b in 0..127 and from a boundary in [0, len] (traps
;;                                     otherwise, as the runtime's checks); the first offset >= from holding b, or -1. An
;;                                     ASCII byte only occurs at a boundary, so stepping by code points visits every match
;;   1 (string-contains? h n)          stage-0: (if (< (string-index-of h n) 0) false true) (empty needle traps in both)
;;   2 (string-replace-all s n r)      stage-0: kotoba$string-replace-from over string-index-of (uses 3)
;;   3 kotoba$string-replace-from
;;   4 (string-append-range acc s i j) ABI v10 string_append_range = acc ++ (string-substring s i j)
;;   5 (string-index-of-from s n from) ABI v8 string_index_of_from: from a boundary in [0, len], n not empty
;;   6 (vector-take v n)               stage-0 (machine_ir): the first n items, n in [0, count] (a vector read out of
;;                                     range otherwise); stage-0 answers a view of v, the seed a copy: v is consumed by
;;   7 (vector-drop v n)               the take/drop under stage-0's affine check (kotoba-native affine.cljk), so no program
;;                                     stage-0 admits can observe the difference. vector-drop: the items after the first n.
;;                                     The copy is ONE vector (vector-alloc + vector-assoc!, linear): a vector-conj
;;                                     loop minted one table entry per item and trapped :vector-table-exhausted on the
;;                                     posix-path merge input at 20x (merge.sh, 2026-10-03)
(def kr-nlib 8)
(defn- kr-lib-text [] :string
  (string-concat
   (string-concat
    (string-concat
      "(defn __kr_find_byte [s :string b :i64 i :i64] :i64 (cond (< b 0) (vector-at [0] 1) (> b 127) (vector-at [0] 1) (< i 0) (vector-at [0] 1) (> i (string-length s)) (vector-at [0] 1) :else (loop [j i] (if (>= j (string-length s)) -1 (let [c (string-code-point-at s j)] (if (= c b) j (recur (+ j (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4)))))))))\n"
      "(defn __kr_contains [h :string n :string] :bool (if (< (string-index-of h n) 0) (= 0 1) (= 0 0)))\n")
    (string-concat
      "(defn __kr_replace_all [s :string n :string r :string] :string (__kr_replace_from (string-substring s 0 0) s n r (string-index-of s n)))\n(defn __kr_replace_from [acc :string s :string n :string r :string k :i64] :string (if (< k 0) (string-concat acc s) (__kr_replace_from (string-concat acc (string-concat (string-substring s 0 k) r)) (string-substring s (+ k (string-length n)) (string-length s)) n r (string-index-of (string-substring s (+ k (string-length n)) (string-length s)) n))))\n"
      "(defn __kr_append_range [acc :string s :string i :i64 j :i64] :string (string-concat acc (string-substring s i j)))\n(defn __kr_index_of_from [s :string n :string i :i64] :i64 (let [r (string-index-of (string-substring s i (string-length s)) n)] (if (< r 0) -1 (+ r i))))\n"))
  (string-concat (kr-lib-text2) (string-concat (kr-doc-text) (string-concat (kr-flt-text) (string-concat (kr-fix-text) (kr-dec-text)))))))   ; F64: + the dec group

;; ---------------------------------------------------------------------------------------------------------
;; KIR5 (agent KIR5, 2026-10-03): :f64 / :f32 in compile-kir. The seed has no float register class; a KIR float is its
;; IEEE-754 BIT PATTERN in an i64: an f64 its 64 bits, an f32 its 32 bits sign-extended (exactly what stage-0's
;; f64-to-bits / f32-to-bits answer, measured: (f32-to-bits -1.0f) = -1082130432). So the type keywords :f64 / :f32 in a
;; TYPE position (a vector item: param types, [:option :f64], record fields; a function's :result) become :i64, and
;; f64-to-bits / f64-from-bits / f32-to-bits are the identity. KIR spells float equality and order as f64-eq/f64-lt ..
;; (stage-0 respells `=`/`<` on floats, measured), never `=`, so no generic i64 operation ever meets a float. The
;; conversions are a third library group (use bit 10), integer code with the result of AArch64 fcvt under the default
;; FPCR (round to nearest even, no flush to zero, NaN payload kept and quieted), measured against stage-0's native code:
;;   (f64-to-f32-rounded x) -> (__kr_f64_to_f32 x)     (f32-to-f64-exact x) -> (__kr_f32_to_f64 x)
;; Every other float operation (arithmetic, comparisons, f64 vectors, parse/print, f32-from-bits) is left for 21-check to
;; refuse by name. A keyword VALUE :f64 (e.g. (= kind :f64) of a document kind) is not in a type position and stays.
(def kr-nflt 7)
(defn- kr-flt-text [] :string
  (string-concat
   (string-concat
    "(defn __kr_fbits [x :i64] :i64 x)\n"
    "(defn __kr_rne [x :i64 sh :i64] :i64 (if (> sh 54) 0 (let [r (u64-shift-right x sh) rem (bit-and x (- (i64-shift-left 1 sh) 1)) half (i64-shift-left 1 (- sh 1))] (cond (> rem half) (+ r 1) (= rem half) (+ r (bit-and r 1)) :else r))))\n")
   (string-concat
    (string-concat
     "(defn __kr_f32_round [e :i64 m :i64] :i64 (let [sig (if (= e 0) m (bit-or m 4503599627370496)) x (if (= e 0) -1022 (- e 1023))] (cond (> x 127) 2139095040 (>= x -126) (+ (i64-shift-left (+ x 126) 23) (__kr_rne sig 29)) :else (__kr_rne sig (- -97 x)))))\n"
     "(defn __kr_f64_to_f32 [b :i64] :i64 (let [e (bit-and (u64-shift-right b 52) 2047) m (bit-and b 4503599627370495) mag (cond (< e 2047) (__kr_f32_round e m) (= m 0) 2139095040 :else (bit-or 2143289344 (u64-shift-right m 29)))] (if (< b 0) (- mag 2147483648) mag)))\n")
    (string-concat
     "(defn __kr_hibit [m :i64 p :i64] :i64 (if (= (bit-and (u64-shift-right m p) 1) 1) p (__kr_hibit m (- p 1))))\n(defn __kr_f32_sub [m :i64] :i64 (let [p (__kr_hibit m 22)] (bit-or (i64-shift-left (+ p 874) 52) (bit-and (i64-shift-left m (- 52 p)) 4503599627370495))))\n"
     "(defn __kr_f32_to_f64 [x :i64] :i64 (let [mag (bit-and x 2147483647) e (u64-shift-right mag 23) m (bit-and mag 8388607) r (cond (= e 0) (if (= m 0) 0 (__kr_f32_sub m)) (< e 255) (bit-or (i64-shift-left (+ e 896) 52) (i64-shift-left m 29)) (= m 0) 9218868437227405312 :else (bit-or 9221120237041090560 (i64-shift-left m 29)))] (if (< x 0) (bit-or r (i64-shift-left 1 63)) r)))\n"))))

;; the float library entry of head code hc (95 f64-to-bits, 96 f64-from-bits, 97 f32-to-bits, 98 f64-to-f32-rounded,
;; 99 f32-to-f64-exact): defn 0 __kr_fbits, 3 __kr_f64_to_f32, 6 __kr_f32_to_f64 of the group
(defn- kr-flt-of [hc :i64] :i64
  (+ (+ kr-nlib kr-ndoc) (cond (= hc 98) 3 (= hc 99) 6 :else 0)))

(defn- kr-lib-text2 [] :string
  (string-concat
    "(defn __kr_vector_take [v :vector-i64 n :i64] :vector-i64 (if (if (< n 0) (= 0 0) (> n (vector-count v))) [(vector-at v n)] (loop [i 0 w (vector-alloc n)] (if (>= i n) w (recur (+ i 1) (vector-assoc! w i (vector-at v i)))))))\n"
    "(defn __kr_vector_drop [v :vector-i64 n :i64] :vector-i64 (if (if (< n 0) (= 0 0) (> n (vector-count v))) [(vector-at v n)] (loop [i n w (vector-alloc (- (vector-count v) n))] (if (>= i (vector-count v)) w (recur (+ i 1) (vector-assoc! w (- i n) (vector-at v i)))))))\n"))

