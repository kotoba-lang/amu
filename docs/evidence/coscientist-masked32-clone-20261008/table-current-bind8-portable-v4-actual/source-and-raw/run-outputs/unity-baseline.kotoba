    (= c 3003) 2
    (= c 4001) 2
    (= c 4102) 2
    (= c 4103) 2
    (= c 4201) 2
    (= c 4202) 2
    (= c 4203) 2
    (= c 5002) 1
    (= c 1006) 1
    (= c 6002) 1
