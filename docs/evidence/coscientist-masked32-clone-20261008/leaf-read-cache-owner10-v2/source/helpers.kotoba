;; Readonly observer. No M/G writes, no borrowed bank, no persistent counter.
;; io-out and decimal formatting allocate host-managed strings; not free fuel/resources.
(defn- lo-prefix [phase :i64 tag :string i :i64] :string
 (string-concat (string-concat (string-concat (string-concat "LO " (mem-u2dec phase)) " ") tag) (string-concat " " (mem-u2dec i))))
(defn- lo-fields [M :vector-i64 base :i64 width :i64 k :i64 s :string] :string
 (if (>= k width) s
  (lo-fields M base width (inc k) (string-concat s (string-concat " " (mem-u2dec (vector-at M (+ base k))))))))
(defn- lo-table [M :vector-i64 phase :i64 tag :string base :i64 stride :i64 width :i64 count :i64 i :i64] :i64
 (if (>= i count) 0
  (let [p (io-out (string-concat (lo-fields M (+ base (* i stride)) width 0 (lo-prefix phase tag i)) "\n"))]
   (lo-table M phase tag base stride width count (inc i)))))
(defn- lo-header-index [k :i64] :i64
 (case k 0 MM-ERR 1 MM-FN-N 2 MM-SIR-N 3 MM-LABEL-N 4 MM-CODE-N 5 MM-FIX-N 6 MM-LIT-N 7 MM-LITB-N 8 MM-CODE-BYTES 9 MM-OUT-N 10 MM-EXP-N  MM-ERR))
(defn- lo-header-fields [M :vector-i64 k :i64 s :string] :string
 (if (>= k 11) s
  (lo-header-fields M (inc k) (string-concat s (string-concat " " (mem-u2dec (vector-at M (lo-header-index k))))))))
(defn- lo-domains [M :vector-i64] :bool
 (and (= (vector-count M) MM-WORDS)
      (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) 128)
      (> (vector-at M MM-SIR-N) 0) (<= (vector-at M MM-SIR-N) 66016)
      (> (vector-at M MM-LABEL-N) 0) (<= (vector-at M MM-LABEL-N) 65536)
      (> (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) MM-CODE-CAP)
      (> (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
      (> (vector-at M MM-LIT-N) 0) (<= (vector-at M MM-LIT-N) MM-LIT-CAP)
      (> (vector-at M MM-EXP-N) 0) (<= (vector-at M MM-EXP-N) MM-EXP-CAP)
      (>= (vector-at M MM-LITB-N) 0) (<= (vector-at M MM-LITB-N) MM-LITB-CAP)))
(defn- lo-code-tables [M :vector-i64 phase :i64] :i64
 (let [a (lo-table M phase "CODE" MM-CODE-BASE MM-CODE-W MM-CODE-W (vector-at M MM-CODE-N) 1)
       b (lo-table M phase "FIX" MM-FIX-BASE MM-FIX-W MM-FIX-W (vector-at M MM-FIX-N) 1)
       c (lo-table M phase "LIT" MM-LIT-BASE MM-LIT-W MM-LIT-W (vector-at M MM-LIT-N) 1)
       d (lo-table M phase "LITB" MM-LITB-BASE MM-LITB-W MM-LITB-W (vector-at M MM-LITB-N) 0)]
  (let [e (lo-table M phase "EXP" MM-EXP-BASE MM-EXP-W MM-EXP-W (vector-at M MM-EXP-N) 1)]
   (lo-table M phase "LABEL" MM-LABEL-BASE MM-LABEL-W MM-LABEL-W (vector-at M MM-LABEL-N) 1))))
(defn- lo-snapshot [M :vector-i64 phase :i64] :vector-i64
 (if (not (lo-domains M))
  (let [p (io-out (string-concat (lo-prefix phase "HOLD" 0) "\n"))] M)
  (let [p (io-out (string-concat (lo-header-fields M 0 (lo-prefix phase "HEADER" 0)) "\n"))
        a (lo-table M phase "SIR" MM-SIR-BASE MM-SIR-W MM-SIR-W (vector-at M MM-SIR-N) 1)
        b (lo-table M phase "FREC" MM-FN-BASE MM-FN-W MM-FN-W (vector-at M MM-FN-N) 1)
        c (if (>= phase 3) (lo-code-tables M phase) 0)
        z (io-out (string-concat (lo-prefix phase "END" 0) "\n"))] M)))

(defn- lo-print [tag :string xs :vector-i64] :i64
 (let [a (io-out tag) b (loop [k 0] (if (>= k (vector-count xs)) 0 (let [p (io-out (string-concat " " (string-from-i64 (vector-at xs k))))] (recur (inc k)))))] (io-out "\n")))
(defn- lo-assign-record [M :vector-i64 phase :i64 i :i64 f :i64 np :i64] :i64
 (let [a (lo-print "LA" [phase i f np (vector-at M MM-ERR) (vector-at M MM-SIR-N) (vector-at M MM-FN-N) (vector-at M MM-CODE-N) (vector-at M MM-FIX-N)])
       b (loop [k 0] (if (= k 16) 0 (let [p (lo-print "LG" [phase i f k (gn-g M k)])] (recur (inc k)))))
       c (loop [k 0] (if (= k 16) 0 (let [p (lo-print "LF" [phase i f k (gn-fnf M f k)])] (recur (inc k)))))
       d (loop [k 1] (if (> k 7) 0 (let [p (lo-print "LS" [phase i f k (gn-sreg M k)])] (recur (inc k)))))] 0))
