+;; Bounded dominance proof of an unchanged integer temporary across labels.
+;; Find its nearest textual CONST while every intervening writer starts above t.
+;; Then reject ALL edges entering that span from outside, including backedges.
+;; The CONST dominates every admitted path; operations still execute unchanged.
+;; No CFG edge assumptions based on names, emitted fallthrough or profiling.
+(defn- gn-const-origin [M :vector-i64 j :i64 t :i64 work :i64] :i64
+  (if (or (<= j 0) (<= work 0)) 0
+    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
+      (cond (and (= op OP-CONST) (= a t)) j
+            (or (= op OP-FN) (= op OP-END) (= op OP-RET) (= op OP-RET2) (= op OP-TRAP) (= op OP-RES2)) 0
+            (or (and (or (= op OP-CONST) (= op OP-LGET) (= op OP-STR) (= op OP-VEC) (= op OP-TAB) (= op OP-FADDR) (= op OP-VECP)) (<= a t))
+                (and (or (= op OP-BIN) (= op OP-CMP) (= op OP-UN) (= op OP-CALL) (= op OP-CALLI) (= op OP-RT)) (<= b t))
+                (and (= op OP-CAP) (<= c t))) 0
+            (or (= op OP-CONST) (= op OP-LGET) (= op OP-STR) (= op OP-VEC) (= op OP-TAB) (= op OP-FADDR) (= op OP-VECP)
+                (= op OP-BIN) (= op OP-CMP) (= op OP-UN) (= op OP-CALL) (= op OP-CALLI) (= op OP-RT) (= op OP-CAP)
+                (= op OP-LSET) (= op OP-LABEL) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ) (= op OP-FUEL))
+            (gn-const-origin M (dec j) t (dec work))
+            :else 0))))
+(defn- gn-const-fn [M :vector-i64 j :i64 work :i64] :i64
+  (cond (or (<= j 0) (<= work 0)) 0
+        (= (gn-op M j) OP-FN) j
+        (= (gn-op M j) OP-END) 0
+        :else (gn-const-fn M (dec j) (dec work))))
+(defn- gn-const-edges [M :vector-i64 j :i64 lo :i64 hi :i64 f :i64 work :i64] :bool
+  (if (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) false
+    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
+          l (cond (= op OP-BR) a (or (= op OP-BRZ) (= op OP-BRNZ)) b :else 0)
+          dest (if (> l 0) (gn-lpos M l) 0)]
+      (cond (= op OP-END) (= a f)
+            (= op OP-FN) false
+            (and (> l 0) (= dest 0)) false
+            (and (> dest lo) (<= dest hi) (or (< j lo) (> j hi))) false
+            :else (gn-const-edges M (inc j) lo hi f (dec work))))))
