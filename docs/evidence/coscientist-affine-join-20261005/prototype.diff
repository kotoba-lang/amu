+;; Proven already-evaluated immutable descriptors only. Shifted-register ADD
+;; wraps exactly like multiply/add; no flags or resource observations are lost.
+;; Modes: base only, stride+k with one operand1, shifted ADD, generic MADD.
+(defn- gn-affine-index-kind [M :vector-i64 t :i64] :i64
+  (let [ks (gn-isk M (+ t 2) gn-k-const) kk (gn-isk M (+ t 3) gn-k-const)
+        vs (gn-dv M (+ t 2)) vk (gn-dv M (+ t 3))]
+    (cond (or (and ks (= vs 0)) (and kk (= vk 0))) 1
+          (and kk (= vk 1)) 2
+          (and ks (= vs 1)) 3
+          (and kk (> (gn-pow2 vk) 0)) 4
+          (and ks (> (gn-pow2 vs) 0)) 5
+          :else 0)))
+(defn- gn-affine-index [M :vector-i64 t :i64 kind :i64] :vector-i64
+  (let [rb (gn-src M (inc t) 0 1) rs (gn-src M (+ t 2) 16 1)
+        rk (gn-src M (+ t 3) 17 1) B (gn-ldt M (inc t) 0 1)]
+    (case kind
+      1 (gn-mov B 1 rb)
+      2 (-> B (gn-ldt (+ t 2) 16 1) (gn-emit (enc-add-r 1 rb rs)))
+      3 (-> B (gn-ldt (+ t 3) 17 1) (gn-emit (enc-add-r 1 rb rk)))
+      4 (-> B (gn-ldt (+ t 2) 16 1) (gn-emit (gn-e-addsl 1 rb rs (gn-pow2 (gn-dv M (+ t 3))))))
+      5 (-> B (gn-ldt (+ t 3) 17 1) (gn-emit (gn-e-addsl 1 rb rk (gn-pow2 (gn-dv M (+ t 2))))))
+      (-> B (gn-ldt (+ t 2) 16 1) (gn-ldt (+ t 3) 17 1) (gn-emit (enc-madd 1 rs rk rb))))))
