+      (if (and (> origin 0) (> start 0) (or (= v 0) (= v 1) (> (gn-pow2 v) 0))
+               (gn-const-edges M (inc start) origin (dec i) (gn-sir M start IF-A) 4096))
+        (gn-dset M t gn-k-const v) M))))
