 false) (ip-shape M p f a b (inc k)))))

(defn- rls-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i)]
  (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 106)) (not= (gn-op M p) OP-FN)) 0
   (let [f (gn-sir M p IF-A)]
    (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
     (let [n (gn-sir M (+ p 4) IF-B) base (gn-sir M (+ p 49) IF-B)
      end0 (gn-sir M (+ p 8) IF-B) end1 (gn-sir M (+ p 11) IF-B) reader (gn-sir M (+ p 23) IF-A)]
      (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 7)
       (= (gn-fnf M f FF-NSLOTS) 11) (= (gn-fnf M f FF-DEPTH) 9)
       (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (ck-pt M f 0) TY-VEC)
       (loop [k 1] (or (= k 7) (and (= (ck-pt M f k) TY-I64) (recur (inc k)))))
       (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
       (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
       (= (gn-g M gn-f-ns) 11) (= (gn-g M gn-f-dp) 9)
       (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (> (gn-g M gn-f-fb) 0)
       (>= n 1) (<= n 64) (>= base 0) (<= base 4095)
       (>= end0 0) (<= end0 4095) (>= end1 0) (<= end1 4095)
       (rls-shape M p f 0)
       (loop [k 0] (or (= k 13) (let [at (+ p (case k 0 2 1 15 2 25 3 30 4 38 5 42 6 56 7 58 8 86 9 88 10 90 11 92 103)) label (gn-sir M at IF-A)]
        (and (> label 0) (< label MM-LABEL-CAP) (= (gn-lpos M label) at) (recur (inc k))))))
       (loop [k 1] (or (= k 8) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
        (loop [j 1] (or (= j k) (and (not= (gn-sreg M k) (gn-sreg M j)) (recur (inc j))))) (recur (inc k)))))
       (> (qi-shape M reader) 0) (> (rls-writer M (gn-sir M (+ p 65) IF-A)) 0)
       (sw-writer M (gn-sir M (+ p 10) IF-A))) (qi-shape M reader) 0)))))))
