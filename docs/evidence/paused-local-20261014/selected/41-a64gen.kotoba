(defn- srloop-sigma [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N))) false
  (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1)]
   (and (> end 0) (= (gn-fnf M f FF-DEPTH) 3)
