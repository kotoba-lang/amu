   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 11)) (ri-cold G 3)
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
   (gn-emit (enc-cmp-r 17 16)) (ri-cold G 2) (gn-emit (enc-ldr 16 7 320))
   (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
   (gn-emit (enc-sub-i 12 4 1)) (gn-mov-imm 5 stride) (gn-emit (enc-mul 10 1 5))
   (gn-emit (enc-add-r 13 10 12)) (gn-emit (enc-cmp-r 13 16)) (ri-cold G 2)
   (gn-emit (enc-add-i 13 12 base)) (gn-emit (enc-cmp-r 13 16)) (ri-cold G 2)
   (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 15 15 17 3))
   (gn-emit (enc-sub-r 8 8 11)) (gn-emit (enc-str 8 7 CTX-FUEL))
   (gn-emit (enc-add-r 10 10 2)) (gn-emit (gn-e-addsl 10 15 10 3))
   (gn-emit (enc-add-i 11 2 base)) (gn-emit (gn-e-addsl 11 15 11 3))) loop (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-ldr 13 10 0)) (gn-emit (enc-ldr 14 11 0))
