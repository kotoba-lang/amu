   (gn-emit (enc-cmp-r 19 22))) negative (vector-at m13 MM-CODE-N)
  m14 (-> m13 (gn-emit 0) (gn-emit (enc-add-i 0 19 1))) retjump (vector-at m14 MM-CODE-N)
  m15 (gn-emit m14 0) negative-at (vector-at m15 MM-CODE-N)
