   sig0 (gn-sir M (+ p 43) IF-A) mask (gn-sir M (+ p 53) IF-A) writer (gn-sir M (+ p 61) IF-A)]
   (and (case k
    0 (gn-dot-at? M (+ p 0) OP-FN f 2 3)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
