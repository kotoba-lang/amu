  m4 (-> m3 (gn-emit (enc-bcond 1 (- loop b))) (gn-mov 0 9) (gn-vclear) (gn-epilogue) (gn-gs gn-f-dead 0)) end (vector-at m4 MM-CODE-N)]
  (ri-patch m4 G 0 end))))

(defn- srloop-admit [M :vector-i64 i :i64] :i64
 (if (or (<= i 2) (>= (+ i 69) (vector-at M MM-SIR-N))
         (not= (gn-op M (- i 2)) OP-FN)) 0
  (let [p (- i 2) f (gn-sir M p IF-A)]
   (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
    (let [n (gn-sir M (+ p 4) IF-B) threshold (gn-sir M (+ p 11) IF-B)
     base (gn-sir M (+ p 21) IF-B) head (gn-sir M (+ p 2) IF-A)]
     (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2)
      (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 6)
      (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (ck-pt M f 0) TY-VEC) (= (ck-pt M f 1) TY-I64)
      (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
      (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 6)
      (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
      (>= n 1) (<= n 4096) (>= threshold 1) (<= threshold n) (>= base 0) (<= base 4095)
      (loop [k 0] (or (= k 4) (let [delta (gn-sir M (+ p (case k 0 23 1 31 2 39 47)) IF-B)]
       (and (>= delta 0) (<= delta threshold) (recur (inc k))))))
      (loop [k 1] (or (= k 4) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
       (loop [j 1] (or (= j k) (and (not= (gn-sreg M j) (gn-sreg M k)) (recur (inc j)))))
       (recur (inc k)))))
      (srloop-shape M p f 0) (srloop-labels M p 0)
      (srloop-sigma M (gn-sir M (+ p 27) IF-A)) (srloop-sigma M (gn-sir M (+ p 43) IF-A))
      (= (gn-scalar-mask M (+ p 53) (gn-sir M (+ p 53) IF-A) 1) 32)
      (sw-writer M (gn-sir M (+ p 61) IF-A))
      (> head 0) (< head MM-LABEL-CAP) (srloop-edges M p head 1)) n 0))))))
(defn- srloop-body [M :vector-i64 p :i64] :vector-i64
 (let [ri (gn-sreg M 2) base (gn-sir M (+ p 21) IF-B)]
  (-> M (srloop-read p (gn-sir M (+ p 23) IF-B) 0)
   (srloop-scalar (gn-sir M (+ p 27) IF-A)) (srloop-read p (gn-sir M (+ p 31) IF-B) 1)
   (gn-emit (enc-add-r 6 0 1))
   (srloop-read p (gn-sir M (+ p 39) IF-B) 0)
   (srloop-scalar (gn-sir M (+ p 43) IF-A)) (srloop-read p (gn-sir M (+ p 47) IF-B) 1)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (enc-add-r 0 0 6))
   (gn-emit (gn-e-bf 0xd3400000 0 0 0 31))
   (gn-emit (enc-add-i 16 ri base)) (gn-emit (gn-e-strr3 0 5 16))
   (gn-emit (enc-add-i ri ri 1)))))
(defn- srloop-edges [M :vector-i64 p :i64 head :i64 j :i64] :bool
 (if (= j (vector-at M MM-SIR-N)) true
  (let [op (gn-op M j)]
   (and (not= op OP-TAB)
    (not (and (= op OP-LABEL) (= (gn-sir M j IF-A) head) (not= j (+ p 2))))
    (not (and (= op OP-BR) (= (gn-sir M j IF-A) head) (not= j (+ p 68))))
    (not (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= (gn-sir M j IF-B) head)))
