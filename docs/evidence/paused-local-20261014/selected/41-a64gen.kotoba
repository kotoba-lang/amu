(defn- qrow-pattern-copy [V :vector-i64 part :vector-i64 offset :i64 j :i64] :vector-i64
 (if (= j (vector-count part)) V
  (qrow-pattern-copy (vector-assoc! V (+ offset j) (vector-at part j)) part offset (inc j))))
(defn- qrow-pattern [kind :i64 count :i64] :vector-i64
 (loop [V (vector-alloc count) part 0 offset 0]
  (if (= offset count) V
   (let [P (qrow-pattern-chunk kind part)]
    (recur (qrow-pattern-copy V P offset 0) (inc part) (+ offset (vector-count P)))))))
(defn- qrow-predicate-pattern [] :vector-i64 (qrow-pattern 0 620))
(defn- qrow-row-pattern [] :vector-i64 (qrow-pattern 1 252))
(defn- qrow-rem-pattern [] :vector-i64 (qrow-pattern 2 44))
(defn- qrow-rem-calls [M :vector-i64 p :i64 rf :i64 k :i64] :bool
 (if (= k 155) true
  (and (or (not= (gn-op M (+ p k)) OP-CALL)
    (and (= (gn-sir M (+ p k) IF-A) rf) (= (gn-sir M (+ p k) IF-C) 2)))
   (qrow-rem-calls M p rf (inc k)))))
(defn- qrow-rem3 [M :vector-i64 d :i64 x :i64] :vector-i64
 (-> M (gn-mov-imm 16 3) (gn-emit (enc-sdiv 17 x 16))
  (gn-emit (enc-mul 17 17 16)) (gn-emit (enc-sub-r d x 17))))
(defn- qrow-parity-zero [M :vector-i64 x :i64] :vector-i64
 (-> M (gn-mov-imm 16 1) (gn-emit (enc-and-r 9 x 16))
  (gn-emit (enc-cmp-i 9 0)) (gn-emit (enc-cset 0 (enc-cond-eq)))))
(defn- qrow-common [M :vector-i64] :vector-i64
 (-> M (qrow-rem3 3 1) (qrow-rem3 4 2) (gn-emit (enc-and-r 5 1 2))
  (gn-mov-imm 16 1) (gn-emit (enc-and-r 5 5 16))))
(defn- qrow-same [M :vector-i64] :vector-i64
 (-> M (gn-emit (enc-cmp-i 3 0)) (gn-emit (enc-cset 6 (enc-cond-ne)))
  (gn-emit (enc-cmp-r 3 4)) (gn-emit (enc-cset 9 (enc-cond-eq)))
  (gn-emit (enc-and-r 6 6 9))))
(defn- qrow-case [M :vector-i64 k :i64] :vector-i64
 (case k
  0 (-> M (gn-emit (enc-add-r 9 1 2)) (qrow-parity-zero 9))
  1 (qrow-parity-zero M 2)
  2 (-> M (qrow-rem3 9 1) (gn-emit (enc-cmp-i 9 0)) (gn-emit (enc-cset 0 (enc-cond-eq))))
  3 (-> M (gn-emit (enc-add-r 9 1 2)) (qrow-rem3 9 9)
      (gn-emit (enc-cmp-i 9 0)) (gn-emit (enc-cset 0 (enc-cond-eq))))
  4 (-> M (gn-mov-imm 16 3) (gn-emit (enc-sdiv 9 1 16))
      (gn-mov-imm 16 2) (gn-emit (enc-sdiv 10 2 16))
      (gn-emit (enc-add-r 9 9 10)) (qrow-parity-zero 9))
  5 (-> M (qrow-common) (gn-emit (enc-cmp-i 3 0)) (gn-emit (enc-cset 9 (enc-cond-ne)))
      (gn-emit (enc-cmp-i 4 0)) (gn-emit (enc-cset 10 (enc-cond-ne)))
      (gn-emit (enc-and-r 9 9 10)) (gn-emit (enc-add-r 9 5 9))
      (gn-emit (enc-cmp-i 9 0)) (gn-emit (enc-cset 0 (enc-cond-eq))))
  6 (-> M (qrow-common) (qrow-same) (gn-emit (enc-add-r 9 5 6)) (qrow-parity-zero 9))
