    (gn-dot-at? M (+ p 178) 9 (gn-sir M (+ p 178) IF-A) 0 0)
    (gn-dot-at? M (+ p 179) 4 2 5 0)
    (gn-dot-at? M (+ p 180) 9 (gn-sir M (+ p 180) IF-A) 0 0)
    (gn-dot-at? M (+ p 181) 4 3 4 0)
    (gn-dot-at? M (+ p 182) 4 4 2 0)
    (gn-dot-at? M (+ p 183) 3 5 0 0)
    (gn-dot-at? M (+ p 184) 7 1 4 0)
    (gn-dot-at? M (+ p 185) 11 4 (gn-sir M (+ p 188) IF-A) 0)
    (gn-dot-at? M (+ p 186) 4 4 5 0)
    (gn-dot-at? M (+ p 187) 10 (gn-sir M (+ p 190) IF-A) 0 0)
    (gn-dot-at? M (+ p 188) 9 (gn-sir M (+ p 188) IF-A) 0 0)
    (gn-dot-at? M (+ p 189) 4 4 7 0)
    (gn-dot-at? M (+ p 190) 9 (gn-sir M (+ p 190) IF-A) 0 0)
    (gn-dot-at? M (+ p 191) 4 5 1 0)
    (gn-dot-at? M (+ p 192) 4 6 8 0)
    (gn-dot-at? M (+ p 193) 3 7 2 0)
    (gn-dot-at? M (+ p 194) 6 1 6 0)
    (gn-dot-at? M (+ p 195) 14 176 5 2)
    (gn-dot-at? M (+ p 196) 13 tf 0 6)
    (gn-dot-at? M (+ p 197) 9 (gn-sir M (+ p 197) IF-A) 0 0)
    (gn-dot-at? M (+ p 198) 5 11 0 0)
    (gn-dot-at? M (+ p 199) 4 0 3 0)
    (gn-dot-at? M (+ p 200) 3 1 limit 0)
    (gn-dot-at? M (+ p 201) 7 1 0 0)
    (gn-dot-at? M (+ p 202) 11 0 (gn-sir M (+ p 231) IF-A) 0)
    (gn-dot-at? M (+ p 231) 9 (gn-sir M (+ p 231) IF-A) 0 0)
    (gn-dot-at? M (+ p 232) 4 0 2 0)
    (gn-dot-at? M (+ p 233) 4 1 7 0)
    (gn-dot-at? M (+ p 234) 4 2 2 0)
    (gn-dot-at? M (+ p 235) 3 3 0 0)
    (gn-dot-at? M (+ p 236) 7 1 2 0)
    (gn-dot-at? M (+ p 237) 11 2 (gn-sir M (+ p 240) IF-A) 0)))
(defn- ar-part4 [M :vector-i64 p :i64 f :i64 tf :i64 limit :i64 base :i64] :bool
 (and
    (gn-dot-at? M (+ p 238) 4 2 4 0)
    (gn-dot-at? M (+ p 239) 10 (gn-sir M (+ p 242) IF-A) 0 0)
    (gn-dot-at? M (+ p 240) 9 (gn-sir M (+ p 240) IF-A) 0 0)
    (gn-dot-at? M (+ p 241) 4 2 6 0)
    (gn-dot-at? M (+ p 242) 9 (gn-sir M (+ p 242) IF-A) 0 0)
    (gn-dot-at? M (+ p 243) 4 3 5 0)
    (gn-dot-at? M (+ p 244) 4 4 2 0)
    (gn-dot-at? M (+ p 245) 3 5 0 0)
    (gn-dot-at? M (+ p 246) 7 1 4 0)
    (gn-dot-at? M (+ p 247) 11 4 (gn-sir M (+ p 250) IF-A) 0)
    (gn-dot-at? M (+ p 248) 4 4 6 0)
    (gn-dot-at? M (+ p 249) 10 (gn-sir M (+ p 252) IF-A) 0 0)
    (gn-dot-at? M (+ p 250) 9 (gn-sir M (+ p 250) IF-A) 0 0)
    (gn-dot-at? M (+ p 251) 4 4 4 0)
    (gn-dot-at? M (+ p 252) 9 (gn-sir M (+ p 252) IF-A) 0 0)
    (gn-dot-at? M (+ p 253) 4 5 1 0)
    (gn-dot-at? M (+ p 254) 4 6 8 0)
    (gn-dot-at? M (+ p 255) 3 7 3 0)
    (gn-dot-at? M (+ p 256) 6 1 6 0)
    (gn-dot-at? M (+ p 257) 14 176 5 2)
    (gn-dot-at? M (+ p 258) 13 tf 0 6)
    (gn-dot-at? M (+ p 259) 9 (gn-sir M (+ p 259) IF-A) 0 0)
    (gn-dot-at? M (+ p 260) 5 12 0 0)
    (gn-dot-at? M (+ p 261) 4 0 3 0)
    (gn-dot-at? M (+ p 262) 3 1 limit 0)
    (gn-dot-at? M (+ p 263) 7 1 0 0)
    (gn-dot-at? M (+ p 264) 11 0 (gn-sir M (+ p 305) IF-A) 0)
    (gn-dot-at? M (+ p 265) 4 0 2 0)
    (gn-dot-at? M (+ p 305) 9 (gn-sir M (+ p 305) IF-A) 0 0)
    (gn-dot-at? M (+ p 306) 4 0 1 0)
    (gn-dot-at? M (+ p 307) 4 1 2 0)
    (gn-dot-at? M (+ p 308) 4 2 3 0)))
(defn- ar-part5 [M :vector-i64 p :i64 f :i64 tf :i64 limit :i64 base :i64] :bool
 (and
    (gn-dot-at? M (+ p 309) 3 3 1 0)
    (gn-dot-at? M (+ p 310) 6 1 2 0)
    (gn-dot-at? M (+ p 311) 4 3 9 0)
    (gn-dot-at? M (+ p 312) 4 4 10 0)
    (gn-dot-at? M (+ p 313) 4 5 11 0)
    (gn-dot-at? M (+ p 314) 4 6 12 0)
    (gn-dot-at? M (+ p 315) 5 1 0 0)
    (gn-dot-at? M (+ p 316) 5 2 1 0)
    (gn-dot-at? M (+ p 317) 5 3 2 0)
    (gn-dot-at? M (+ p 318) 5 4 3 0)
    (gn-dot-at? M (+ p 319) 5 5 4 0)
    (gn-dot-at? M (+ p 320) 5 6 5 0)
    (gn-dot-at? M (+ p 321) 5 7 6 0)
    (gn-dot-at? M (+ p 322) 18 0 0 0)
    (gn-dot-at? M (+ p 323) 10 (gn-sir M (+ p 2) IF-A) 0 0)
    (gn-dot-at? M (+ p 324) 9 (gn-sir M (+ p 324) IF-A) 0 0)
    (gn-dot-at? M (+ p 325) 19 0 0 0)
    (gn-dot-at? M (+ p 326) 2 f 0 0)))
(defn- ar-regs [M :vector-i64 j :i64 k :i64] :bool
 (cond (= j 8) true (= k j) (and (>= (gn-sreg M j) 19) (<= (gn-sreg M j) 28) (ar-regs M (inc j) 1))
  (= (gn-sreg M j) (gn-sreg M k)) false :else (ar-regs M j (inc k))))
(defn- ar-tables [M :vector-i64 tp :i64 branch :i64 j :i64] :vector-i64
 (if (= j 4) M
  (let [q (+ tp 4 (* j 15)) f (gn-sir M (+ q (if (= branch 0) 7 13)) IF-A) lit (tb-shape M f)]
   (ar-tables (-> M (gn-emit (enc-ldr j 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
    (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
    (gn-emit (enc-add-r j j 16))) tp branch (inc j)))))
(defn- ar-word [M :vector-i64 tp :i64 branch :i64 row :i64 col :i64] :vector-i64
 (if (= col 4) M
  (let [slot (inc (rem (+ row (if (= branch 0) col (- 4 col))) 4))
   q (+ tp 4 (* col 15)) sh (gn-sir M (+ q 5) IF-B)]
   (ar-word (-> M (gn-emit (gn-e-bf 0xd3400000 9 (gn-sreg M (+ slot 3)) sh (+ sh 7)))
    (gn-emit (gn-e-ldrr 16 col 9 1)) (gn-emit (enc-eor-r (+ 10 row) (+ 10 row) 16))) tp branch row (inc col)))))
(defn- ar-words [M :vector-i64 tp :i64 branch :i64 row :i64] :vector-i64
 (if (= row 4) M
  (ar-words (ar-word (gn-emit M (enc-ldr (+ 10 row) 4 (* row 8))) tp branch row 0) tp branch (inc row))))

(defn- ss-admit [M :vector-i64 i :i64] :i64
 (if (or (<= i 1) (not= (gn-op M (dec i)) OP-FN)
  (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
  (not (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1)))
  (not= (gn-g M gn-f-ns) 4) (not= (gn-g M gn-f-dp) 5)
  (not= (gn-g M gn-f-nsv) 4) (not= (gn-g M gn-f-h) 0)
  (not= (gn-g M gn-f-skip) 0) (<= (gn-g M gn-f-fb) 0)) 0
  (let [p (dec i) f (gn-sir M (dec i) IF-A)]
   (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP)
           (> p (- (vector-at M MM-SIR-N) 68))) 0
    (let [a (gn-sir M (+ p 4) IF-B) b (gn-sir M (+ p 19) IF-B) c (gn-sir M (+ p 63) IF-B)
       mask (gn-sir M (+ p 6) IF-B) delta (gn-sir M (+ p 51) IF-B)
       scale (gn-sir M (+ p 58) IF-B) small (gn-sir M (+ p 53) IF-A)
       wide (gn-sir M (+ p 60) IF-A) put (gn-sir M (+ p 65) IF-A)
       unknown (gn-sir M (+ p 26) IF-A)]
     (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 1)
      (= (gn-fnf M f FF-NSLOTS) 4) (= (gn-fnf M f FF-DEPTH) 5)
      (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
      (>= (gn-sreg M 1) 19) (<= (gn-sreg M 1) 28)
      (>= a 0) (<= a 4095) (>= b 0) (<= b 4095) (>= c 0) (<= c 4095)
      (not= a b) (not= a c) (not= b c) (not= mask 0)
      (> delta 0) (<= delta 4095) (> scale 0) (<= scale 4095)
      (ss-put M put) (> (ss-mask M small put) 0) (> (ss-mask M wide put) 0)
      (ss-labels M p 0 0) (ss-shape M p f a b c mask delta scale small wide put unknown)) p 0))))))
(defn- ss-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (ss-admit M i)]
  (if (= p 0) M
   (let [a (gn-sir M (+ p 4) IF-B) b (gn-sir M (+ p 19) IF-B) c (gn-sir M (+ p 63) IF-B)
       mask (gn-sir M (+ p 6) IF-B) delta (gn-sir M (+ p 51) IF-B)
       scale (gn-sir M (+ p 58) IF-B) put (gn-sir M (+ p 65) IF-A)
       sw (ss-mask M (gn-sir M (+ p 53) IF-A) put)
       ww (ss-mask M (gn-sir M (+ p 60) IF-A) put)
       rv (gn-sreg M 1) G (vector-alloc 17)
       m (-> M (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 5)) (ri-cold G (enc-cond-lo))
         (gn-emit (enc-sub-i 16 rv 1)) (gn-emit (enc-ldr 17 7 312)) (gn-emit (enc-ldr 17 17 0))
         (gn-emit (enc-cmp-r 16 17)) (ri-cold G (enc-cond-hs))
         (gn-emit (enc-ldr 17 7 320)) (gn-emit (gn-e-lsl 16 16 4))
         (gn-emit (enc-add-r 17 17 16)) (gn-emit (enc-ldp 16 17 17 0))
         (gn-mov-imm 9 (inc (gn-max a (gn-max b c))))
         (gn-emit (enc-cmp-r 9 17)) (ri-cold G 8)
         (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 16 3))
         (gn-emit (enc-ldr 9 4 (* a 8))) (gn-emit (enc-ldr 10 4 (* b 8)))
         (gn-emit (enc-cmp-i 10 0)) (ri-cold G (enc-cond-eq))
         (gn-mov-imm 16 mask) (gn-emit (enc-and-r 11 9 16))
         (gn-emit (enc-cmp-i 11 0)) (gn-emit (enc-cset 11 (enc-cond-ne)))
         (gn-mask-charge) (gn-emit (enc-sub-i 10 10 delta))
         (gn-emit (gn-e-bf 0xd3400000 10 10 0 (dec sw)))
         (gn-mask-charge) (gn-emit (enc-str 10 4 (* b 8))) (gn-emit (enc-str 8 7 CTX-FUEL))
         (gn-mov-imm 16 scale) (gn-emit (enc-mul 9 9 16))
         (gn-mask-charge) (gn-emit (gn-e-bf 0xd3400000 9 9 0 (dec ww)))
         (gn-mask-charge) (gn-emit (enc-str 9 4 (* a 8))) (gn-emit (enc-str 8 7 CTX-FUEL))
         (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 3))
         (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))
         (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-str 11 4 (* c 8)))
         (gn-mov 0 rv) (gn-epilogue)) cold (vector-at m MM-CODE-N)]
    (ri-patch m G 0 cold)))))
(defn- ss-labels [M :vector-i64 p :i64 j :i64 k :i64] :bool
 (cond (= j 68) true (= k j) (ss-labels M p (inc j) 0)
  (and (= (gn-op M (+ p j)) OP-LABEL)
    (or (<= (gn-sir M (+ p j) IF-A) 0) (>= (gn-sir M (+ p j) IF-A) MM-LABEL-CAP)
      (not= (gn-lpos M (gn-sir M (+ p j) IF-A)) (+ p j)))) false
  (and (= (gn-op M (+ p j)) OP-LABEL) (= (gn-op M (+ p k)) OP-LABEL)
     (= (gn-sir M (+ p j) IF-A) (gn-sir M (+ p k) IF-A))) false
  :else (ss-labels M p j (inc k))))
(defn- ss-mask [M :vector-i64 f :i64 child :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR)]
   (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 11))) 0
    (let [mask (gn-sir M (+ p 6) IF-B) width (gn-pow2 (inc mask))]
     (if (and (> width 0) (<= width 32) (= mask (dec (i64-shift-left 1 width)))
      (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 4)
      (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
      (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
      (> (gn-sir M (+ p 2) IF-A) 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
      (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
      (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
      (gn-dot-at? M (+ p 5) OP-LGET 2 3 0) (gn-dot-at? M (+ p 6) OP-CONST 3 mask 0)
      (gn-dot-at? M (+ p 7) OP-BIN BOP-AND 2 0) (gn-dot-at? M (+ p 8) OP-CALL child 0 3)
      (gn-dot-at? M (+ p 9) OP-RET 0 0 0) (gn-dot-at? M (+ p 10) OP-END f 0 0)) width 0))))))
(defn- ss-put [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 9))
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 3)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
    (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
    (> (gn-sir M (+ p 2) IF-A) 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
    (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 5) OP-LGET 2 3 0)
    (gn-dot-at? M (+ p 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
    (gn-dot-at? M (+ p 7) OP-RET 0 0 0) (gn-dot-at? M (+ p 8) OP-END f 0 0)))))
(defn- ss-shape [M :vector-i64 p :i64 f :i64 a :i64 b :i64 c :i64 mask :i64 delta :i64 scale :i64 small :i64 wide :i64 put :i64 unknown :i64] :bool
 (and
  (gn-dot-at? M (+ p 0) 1 f 1 4)
  (gn-dot-at? M (+ p 1) 18 0 0 0)
  (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  (gn-dot-at? M (+ p 3) 4 0 1 0)
  (gn-dot-at? M (+ p 4) 3 1 a 0)
  (gn-dot-at? M (+ p 5) 14 176 0 2)
  (gn-dot-at? M (+ p 6) 3 1 mask 0)
  (gn-dot-at? M (+ p 7) 6 5 0 0)
  (gn-dot-at? M (+ p 8) 3 1 0 0)
  (gn-dot-at? M (+ p 9) 7 1 0 0)
  (gn-dot-at? M (+ p 10) 8 1 0 0)
  (gn-dot-at? M (+ p 11) 11 0 (gn-sir M (+ p 14) IF-A) 0)
  (gn-dot-at? M (+ p 12) 3 0 1 0)
  (gn-dot-at? M (+ p 13) 10 (gn-sir M (+ p 16) IF-A) 0 0)
  (gn-dot-at? M (+ p 14) 9 (gn-sir M (+ p 14) IF-A) 0 0)
  (gn-dot-at? M (+ p 15) 3 0 0 0)
  (gn-dot-at? M (+ p 16) 9 (gn-sir M (+ p 16) IF-A) 0 0)
  (gn-dot-at? M (+ p 17) 5 2 0 0)
  (gn-dot-at? M (+ p 18) 4 0 1 0)
  (gn-dot-at? M (+ p 19) 3 1 b 0)
  (gn-dot-at? M (+ p 20) 14 176 0 2)
  (gn-dot-at? M (+ p 21) 3 1 0 0)
  (gn-dot-at? M (+ p 22) 7 1 0 0)
  (gn-dot-at? M (+ p 23) 11 0 (gn-sir M (+ p 42) IF-A) 0)
  (gn-dot-at? M (+ p 24) 4 0 1 0)
  (gn-dot-at? M (+ p 25) 3 1 1 0)
  (gn-dot-at? M (+ p 26) 13 unknown 0 2)
  (gn-dot-at? M (+ p 27) 5 3 0 0)
  (gn-dot-at? M (+ p 28) 4 0 3 0)
  (gn-dot-at? M (+ p 29) 3 1 a 0)
  (gn-dot-at? M (+ p 30) 4 2 3 0)
  (gn-dot-at? M (+ p 31) 3 3 a 0)
  (gn-dot-at? M (+ p 32) 14 176 2 2)
  (gn-dot-at? M (+ p 33) 4 3 3 0)
  (gn-dot-at? M (+ p 34) 3 4 c 0)
  (gn-dot-at? M (+ p 35) 14 176 3 2)
  (gn-dot-at? M (+ p 36) 6 6 2 0)
  (gn-dot-at? M (+ p 37) 13 wide 0 3)
  (gn-dot-at? M (+ p 38) 3 1 b 0)
  (gn-dot-at? M (+ p 39) 3 2 8 0)
  (gn-dot-at? M (+ p 40) 13 small 0 3)
  (gn-dot-at? M (+ p 41) 10 (gn-sir M (+ p 44) IF-A) 0 0)
  (gn-dot-at? M (+ p 42) 9 (gn-sir M (+ p 42) IF-A) 0 0)
  (gn-dot-at? M (+ p 43) 4 0 1 0)
  (gn-dot-at? M (+ p 44) 9 (gn-sir M (+ p 44) IF-A) 0 0)
  (gn-dot-at? M (+ p 45) 5 3 0 0)
  (gn-dot-at? M (+ p 46) 4 0 3 0)
  (gn-dot-at? M (+ p 47) 3 1 b 0)
  (gn-dot-at? M (+ p 48) 4 2 3 0)
  (gn-dot-at? M (+ p 49) 3 3 b 0)
  (gn-dot-at? M (+ p 50) 14 176 2 2)
  (gn-dot-at? M (+ p 51) 3 3 delta 0)
  (gn-dot-at? M (+ p 52) 6 2 2 0)
  (gn-dot-at? M (+ p 53) 13 small 0 3)
  (gn-dot-at? M (+ p 54) 3 1 a 0)
  (gn-dot-at? M (+ p 55) 4 2 3 0)
  (gn-dot-at? M (+ p 56) 3 3 a 0)
  (gn-dot-at? M (+ p 57) 14 176 2 2)
  (gn-dot-at? M (+ p 58) 3 3 scale 0)
  (gn-dot-at? M (+ p 59) 6 3 2 0)
  (gn-dot-at? M (+ p 60) 13 wide 0 3)
  (gn-dot-at? M (+ p 61) 5 4 0 0)
  (gn-dot-at? M (+ p 62) 4 0 4 0)
  (gn-dot-at? M (+ p 63) 3 1 c 0)
  (gn-dot-at? M (+ p 64) 4 2 2 0)
  (gn-dot-at? M (+ p 65) 13 put 0 3)
  (gn-dot-at? M (+ p 66) 19 0 0 0)
  (gn-dot-at? M (+ p 67) 2 f 0 0)
 ))

(defn- ir-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)]
 (if (or (<= p 0) (>= (+ p 95) (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN)) false
 (let [f (gn-sir M p IF-A)]
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N))) false
 (let [limit (gn-sir M (+ p 4) IF-B) out (gn-sir M (+ p 8) IF-B)
  cs (gn-sir M (+ p 14) IF-B) base (gn-sir M (+ p 17) IF-B)
  ss (gn-sir M (+ p 19) IF-B) sh (gn-sir M (+ p 49) IF-B)]
 (and (= (gn-fnf M f FF-SIR) p) (not (gn-clamp-open M f))
  (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 11) (= (gn-fnf M f FF-DEPTH) 5)
  (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
  (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
  (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-vmode) 3)
  (= (gn-g M gn-f-ns) 11) (= (gn-g M gn-f-dp) 5) (= (gn-g M gn-f-nsv) 7)
  (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (> (gn-g M gn-f-fb) 0)
  (>= limit 1) (<= limit 64) (>= out 0) (<= out 4095)
  (>= cs 1) (<= cs 16) (>= ss 1) (<= ss 16) (>= base 0) (<= base 2048)
  (<= (+ (* (dec limit) cs) 3) 4095) (<= (+ base (* (dec limit) ss) 1) 4095)
  (>= sh 0) (<= sh 63)
  (ir-part0 M p f limit out cs base ss sh) (ir-part1 M p f limit out cs base ss sh)
  (ir-part2 M p f limit out cs base ss sh) (ir-part3 M p f limit out cs base ss sh)
  (ir-labels M p 0))))))))
(defn- ir-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (ir-admit M i)) M
 (let [p (dec i) limit (gn-sir M (+ p 4) IF-B) cs (gn-sir M (+ p 14) IF-B)
  base (gn-sir M (+ p 17) IF-B) ss (gn-sir M (+ p 19) IF-B) sh (gn-sir M (+ p 49) IF-B)
  head (gn-sir M (+ p 2) IF-A) G (vector-alloc 13)
  m0 (-> M (gn-emit (enc-cmp-i 1 limit)) (ri-cold G 2)
