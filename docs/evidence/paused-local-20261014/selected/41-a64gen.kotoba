(defn- ru-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (>= (+ p 43) (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN)) false
 (let [f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 26) IF-B)
  reader (gn-sir M (+ p 19) IF-A) dot (gn-sir M (+ p 20) IF-A) writer (gn-sir M (+ p 31) IF-A)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 4) (= (gn-fnf M f FF-DEPTH) 7)
  (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
  (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
  (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
  (= (gn-g M gn-f-ns) 4) (= (gn-g M gn-f-dp) 7) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
  (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 4)
  (>= n 1) (<= n 64) (>= stride 1) (<= stride 4095)
  (ru-shape M p f 0) (ru-labels M p 0) (pz-writer M writer)
