   (recur (gn-put cur (+ dst k) (vector-at cur (+ src k))) (inc k))))]
  (-> out (gn-put (+ dst FF-CODE) start) (gn-put (+ dst FF-SIR) 0)
   (gn-put (+ dst FF-NODE) 0) (gn-put (+ dst FF-SYM) 0) (gn-put (+ dst FF-EXPORT) 0)
   (gn-put (+ dst FF-KIND) FK-PRIV) (gn-put MM-FN-N (inc new)) (gn-put MM-R2 new))))
(defn- cpp-copy [M :vector-i64 P :vector-i64 base :i64] :vector-i64
 (loop [cur M at (vector-at P 0)]
  (if (= at (vector-at P 1)) cur
   (let [w (sf-word cur at) target (cpp-to w at)]
    (if (< target 0) (recur (gn-emit cur w) (inc at))
     (let [mapped (if (<= target (vector-at P 1)) (+ base (- target (vector-at P 0))) target)
      marked (cpp-label cur mapped) label (vector-at marked MM-R1)]
      (recur (-> marked (gn-fix FX-BC19 label) (gn-emit (bit-and w 0xff00001f))) (inc at))))))))
(defn- cpp-variant [M :vector-i64 P :vector-i64] :vector-i64
 (let [base (vector-at M MM-CODE-N) next (cpp-fn M (vector-at P 13) base) f (vector-at next MM-R2)
  out (cpp-copy next P base)
  end (-> out (gn-emit (enc-mov-r (vector-at P 4) 31))
   (gn-emit (enc-mov-r (vector-at P 7) (vector-at P 6)))
   (gn-emit (enc-mov-r (vector-at P 9) (vector-at P 8)))
   (gn-emit (enc-mov-r (vector-at P 5) (vector-at P 3)))
   (gn-emit (enc-mov-r (vector-at P 10) (vector-at P 5))))
  tail (cpp-label end (vector-at P 2)) label (vector-at tail MM-R1)]
  (-> tail (gn-fix FX-B26 label) (gn-emit (enc-b 0)) (gn-put MM-R2 f))))
(defn- cpp-prior [M :vector-i64 p :i64 stop :i64 f :i64] :i64
 (loop [j 0] (if (= j stop) 0
  (let [b (+ p 4 (* j 8))]
   (if (and (= (vector-at M (+ b 1)) f) (> (vector-at M (+ b 6)) 0))
    (vector-at M (+ b 6)) (recur (inc j)))))))
(defn- cpp-final [M :vector-i64 p :i64 j :i64] :vector-i64
 (let [b (+ p 4 (* j 8)) i (vector-at M b) f (vector-at M (+ b 1)) k (vector-at M (+ b 2))
  at (vector-at M (+ b 3)) start (vector-at M (+ b 4)) end (vector-at M (+ b 5))
  width (vector-at M (+ b 7)) arg (if (and (> start 0) (> at start) (< at end) (<= end (vector-at M MM-CODE-N))) (cpp-arg M at start 1) -1)]
  (if (or (<= i 2) (>= i (vector-at M MM-SIR-N))
   (<= f 0) (>= f (vector-at M MM-FN-N)) (< width 0) (> width 8)
   (not= (gn-op M i) OP-CALL) (not= (gn-sir M i IF-A) f)
   (not= (gn-sir M i IF-C) 3)
   (not (cpp-literal M i f (gn-sir M i IF-B) 3))
   (not= (gn-sir M (- i 2) IF-B) width)
   (<= start 0) (<= k 0) (>= k (vector-at M MM-FIX-N)) (< arg 0)
   (not= (sf-word M arg) (+ 0xd2800001 (i64-shift-left width 5)))
   (not= (sf-x M k XF-KIND) FX-BL26) (not= (sf-x M k XF-TARGET) f)
   (not= (sf-x M k XF-AT) at) (not= (sf-x M k XF-AUX) 0) (not= (sf-word M at) (enc-bl 0))) M
   (let [prior (cpp-prior M p j f) P (if (> prior 0) (vector-alloc 16) (cpp-pattern M f))]
    (if (and (= prior 0) (not (cpp-reserve M P))) M
     (let [out (if (> prior 0) M (cpp-variant M P)) target (if (> prior 0) prior (vector-at out MM-R2))]
      (-> out (gn-put (+ MM-FIX-BASE (* k MM-FIX-W) XF-TARGET) target)
       (gn-put (+ b 6) target))))))))
(defn- cpp-run [M :vector-i64] :vector-i64
 (let [p (cpp-plan M)]
  (if (= p 0) M
   (let [out (loop [cur M j 0] (if (= j (vector-at cur p)) cur
     (recur (cpp-final cur p j) (inc j))))]
    (gn-put out MM-R0 (dec (vector-at out MM-CODE-N)))))))

;; ADR0357: bounded pure scalar byte-result table; native endpoint certificate.
;; No input names, FN identifiers or native offsets participate in admission.
(defn- blt-counts [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS) (= (vector-at M MM-ERR) 0)
  (> (vector-at M MM-NODE-N) 0) (<= (vector-at M MM-NODE-N) MM-NODE-CAP)
  (> (vector-at M MM-SIR-N) 1) (<= (vector-at M MM-SIR-N) 20000)
  (> (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) 512)
  (> (vector-at M MM-CODE-N) 1) (<= (vector-at M MM-CODE-N) MM-CODE-CAP)
  (> (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (> (vector-at M MM-LABEL-N) 0) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)))
(defn- blt-end [M :vector-i64 f :i64 p :i64 left :i64] :i64
 (if (or (<= p 0) (>= p (vector-at M MM-SIR-N)) (<= left 0)) 0
  (cond (aw-ins M p OP-END f 0 0) p
   (= (gn-op M p) OP-FN) 0
   :else (blt-end M f (inc p) (dec left)))))
;; Source LABEL ownership is independent of the last function's gn-lpos cache.
(defn- blt-label [M :vector-i64 l :i64 p :i64 end :i64 at :i64] :bool
 (if (or (<= l 0) (>= l (vector-at M MM-LABEL-N))) false
  (loop [j 1 seen 0]
   (if (= j (vector-at M MM-SIR-N)) (= seen 1)
    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
     (if (or (and (= op OP-LABEL) (= a l) (not= j at))
          (and (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ))
           (= (if (= op OP-BR) a b) l) (or (< j p) (>= j end)))) false
      (recur (inc j) (+ seen (if (and (= op OP-LABEL) (= a l)) 1 0)))))))))
(defn- blt-tree [M :vector-i64 p :i64 end :i64 first :i64 depth :i64] :i64
 (if (or (<= p 0) (>= p end) (> depth 12)) 0
  (if (and (aw-ins M p OP-CONST 0 (gn-sir M p IF-B) 0)
       (>= (gn-sir M p IF-B) 0) (<= (gn-sir M p IF-B) 255)) (inc p)
   (if (>= (+ p 4) end) 0
    (let [k (gn-sir M (inc p) IF-B) le (gn-sir M (+ p 3) IF-B)]
     (if (and (aw-ins M p OP-LGET 0 1 0) (aw-ins M (inc p) OP-CONST 1 k 0)
          (>= k 0) (<= k 1023)
          (or (aw-ins M (+ p 2) OP-CMP CC-LT 0 0) (aw-ins M (+ p 2) OP-CMP CC-EQ 0 0))
          (aw-ins M (+ p 3) OP-BRZ 0 le 0))
      (let [a (blt-tree M (+ p 4) end first (inc depth))]
       (if (or (<= a 0) (>= (inc a) end)) 0
        (let [lx (gn-sir M a IF-A)]
         (if (and (aw-ins M a OP-BR lx 0 0) (aw-ins M (inc a) OP-LABEL le 0 0)
              (blt-label M le first end (inc a)))
          (let [b (blt-tree M (+ a 2) end first (inc depth))]
           (if (and (> b 0) (< b end) (aw-ins M b OP-LABEL lx 0 0)
                (blt-label M lx first end b)) (inc b) 0)) 0)))) 0))))))
(defn- blt-source [M :vector-i64 f :i64] :i64
 (let [p (gn-fnf M f FF-SIR) node (gn-fnf M f FF-NODE)]
  (if (or (<= p 0) (>= (+ p 3) (vector-at M MM-SIR-N))) 0
   (if (and (> node 0) (< node (vector-at M MM-NODE-N)) (= (nm-kind M node) ND-LIST)
        (or (= (gn-fnf M f FF-KIND) FK-PRIV) (= (gn-fnf M f FF-KIND) FK-DEFN))
        (= (gn-fnf M f FF-EXPORT) 0) (= (gn-fnf M f FF-NPARAMS) 1)
        (= (gn-fnf M f FF-NSLOTS) 1) (= (gn-fnf M f FF-DEPTH) 2)
        (= (gn-fnf M f FF-PT0) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-I64)
        (= (gn-fnf M f FF-FUEL) 0) (aw-ins M p OP-FN f 1 1))
    (let [end (blt-end M f (inc p) 8192) l (gn-sir M (inc p) IF-A)]
     (if (and (> end (+ p 3)) (aw-ins M (inc p) OP-LABEL l 0 0)
          (blt-label M l p end (inc p))
          (= (blt-tree M (+ p 2) end p 0) (dec end))
          (aw-ins M (dec end) OP-RET 0 0 0)) end 0)) 0))))
(defn- blt-high [M :vector-i64 p :i64 end :i64] :i64
 (loop [j p high 0]
  (if (= j end) high
   (recur (inc j) (if (and (= (gn-op M j) OP-CONST) (= (gn-sir M j IF-A) 1))
    (gn-max high (gn-sir M j IF-B)) high)))))
(defn- blt-hi [M :vector-i64 f :i64 lo :i64 limit :i64] :i64
 (loop [j 1 hi limit]
  (if (= j (vector-at M MM-FN-N)) hi
   (let [a (gn-fnf M j FF-CODE)]
    (recur (inc j) (if (and (> a lo) (< a hi)) a hi))))))
(defn- blt-word [M :vector-i64 at :i64] :i64 (vector-at M (+ MM-CODE-BASE at)))
(defn- blt-cmp [w :i64] :bool (= (bit-and w 0xffc003ff) 0xf100001f))
(defn- blt-bc [w :i64] :bool (= (bit-and w 0xff000010) 0x54000000))
(defn- blt-b [w :i64] :bool (= (bit-and w 0xfc000000) 0x14000000))
(defn- blt-cond [c :i64 x :i64 k :i64] :bool
 (cond (= c 0) (= x k) (= c 1) (not= x k) (= c 10) (>= x k) (= c 11) (< x k) :else false))
(defn- blt-cc [c :i64] :bool (or (= c 0) (= c 1) (= c 10) (= c 11)))
;; A typed fixup map; every in-body fix must be an owned forward branch.
(defn- blt-fixes [M :vector-i64 J :vector-i64 lo :i64 hi :i64] :bool
 (loop [j 1]
  (if (= j (vector-at M MM-FIX-N)) true
   (let [b (+ MM-FIX-BASE (* j MM-FIX-W)) at (vector-at M (+ b XF-AT))
     kind (vector-at M (+ b XF-KIND)) t (vector-at M (+ b XF-TARGET)) aux (vector-at M (+ b XF-AUX))]
    (if (or (<= at 0) (>= at (vector-at M MM-CODE-N))) false
     (if (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19) (= kind FX-ADRL19))
      (if (or (<= t 0) (>= t (vector-at M MM-LABEL-N))) false
       (let [dest (vector-at M (+ MM-LABEL-BASE t)) inside (and (>= at lo) (< at hi))]
        (if (or (and (not inside) (> dest lo) (< dest hi))
             (and inside (or (= at lo) (not= aux 0) (not (or (= kind FX-B26) (= kind FX-BC19)))
              (<= dest at) (>= dest (dec hi)) (not= (vector-at J (- at lo)) 0)
              (not (if (= kind FX-B26) (blt-b (blt-word M at)) (blt-bc (blt-word M at))))))) false
         (do (if inside (vector-assoc! J (- at lo) dest) J) (recur (inc j))))))
      (if (and (>= at lo) (< at hi)) false
       (if (or (= kind FX-BL26) (= kind FX-ADR19) (= kind FX-FADDR))
        (if (or (<= t 0) (>= t (vector-at M MM-FN-N))) false
         (let [dest (gn-fnf M t FF-CODE)]
          (if (and (> dest lo) (< dest hi)) false (recur (inc j)))))
        (recur (inc j))))))))))
(defn- blt-target [M :vector-i64 J :vector-i64 lo :i64 at :i64] :i64
 (let [t (vector-at J (- at lo)) w (blt-word M at)]
  (if (> t 0) t
   (if (blt-b w) (+ at (i64-shift-right (i64-shift-left (bit-and w 0x3ffffff) 38) 38))
    (+ at (i64-shift-right (i64-shift-left (bit-and (i64-shift-right w 5) 0x7ffff) 45) 45))))))
;; Exact closed register effects: x0 stays input until the MOV/RET pair; x9
;; is the only temporary. No memory, calls, frame, charges or other registers.
(defn- blt-code [M :vector-i64 J :vector-i64 lo :i64 hi :i64 high :i64] :bool
 (and (blt-cmp (blt-word M lo)) (= (blt-word M (dec hi)) 0xd4200020)
  (loop [j lo]
   (if (= j (dec hi)) true
    (let [w (blt-word M j)]
     (if (cond (blt-cmp w) (<= (bit-and (i64-shift-right w 10) 4095) high)
          (or (blt-b w) (blt-bc w))
           (and (or (blt-b w) (blt-cc (bit-and w 15)))
            (> (blt-target M J lo j) j) (< (blt-target M J lo j) (dec hi))
            (not= (blt-word M (blt-target M J lo j)) 0xd65f03c0))
          (= w 0xaa1f03e9) true
          (= (bit-and w 0xffe0001f) 0xd2800009) (<= (bit-and (i64-shift-right w 5) 65535) 255)
          (= (bit-and w 0xffff0fff) 0x9a9f07e9) (blt-cc (bit-and (i64-shift-right w 12) 15))
          (= w 0xaa0903e0) (and (< (inc j) (dec hi)) (= (blt-word M (inc j)) 0xd65f03c0))
          (= w 0xd65f03c0) (and (> j lo) (= (blt-word M (dec j)) 0xaa0903e0))
          :else false) (recur (inc j)) false))))))
;; Reject raw postpass incoming branches into the old body's interior.
;; Unresolved typed branches have zero displacement and are checked above.
(defn- blt-incoming [M :vector-i64 lo :i64 hi :i64 limit :i64] :bool
 (loop [j 1]
  (if (= j limit) true
   (let [w (blt-word M j) t (of-dest w j)]
    (if (and (or (< j lo) (>= j hi))
         (or (and (> t lo) (< t hi)) (not (of-external-address w j (inc lo) hi)))) false (recur (inc j)))))))
;; Packed result: byte|tag<<8|last-threshold<<10|dynamic-word-count<<20.
(defn- blt-eval [M :vector-i64 J :vector-i64 lo :i64 hi :i64 x :i64] :i64
 (loop [pc lo k -1 v -1 steps 0]
  (if (or (< pc lo) (>= pc (dec hi)) (>= steps 4096)) -1
   (let [w (blt-word M pc) n (inc steps)]
    (cond (blt-cmp w) (recur (inc pc) (bit-and (i64-shift-right w 10) 4095) v n)
     (or (blt-b w) (blt-bc w))
      (if (< k 0) -1
       (recur (if (or (blt-b w) (blt-cond (bit-and w 15) x k)) (blt-target M J lo pc) (inc pc)) k v n))
     (= w 0xaa1f03e9) (recur (inc pc) k 0 n)
     (= (bit-and w 0xffe0001f) 0xd2800009) (recur (inc pc) k (bit-and (i64-shift-right w 5) 65535) n)
     (= (bit-and w 0xffff0fff) 0x9a9f07e9)
      (if (< k 0) -1 (recur (inc pc) k (if (blt-cond (bit-and (i64-shift-right w 12) 15) x k) 0 1) n))
     (= w 0xaa0903e0) (recur (inc pc) k v n)
     (= w 0xd65f03c0)
      (if (and (>= k 0) (>= v 0) (<= v 255))
       (+ v (i64-shift-left (if (< x k) 0 (if (= x k) 1 2)) 8) (i64-shift-left k 10) (i64-shift-left n 20)) -1)
     :else -1)))))
(defn- blt-table [M :vector-i64 J :vector-i64 T :vector-i64 lo :i64 hi :i64 high :i64] :bool
 (loop [x 0]
  (if (> x high) true
   (let [v (blt-eval M J lo hi x)]
    (if (or (< v 0) (<= (i64-shift-right v 20) 12)) false
     (do (vector-assoc! T x (bit-and v 1023)) (recur (inc x))))))))
(defn- blt-data [M :vector-i64 T :vector-i64 x :i64] :vector-i64
 (if (= x (vector-count T)) M (blt-data (-> M (gn-emit (vector-at T x)) (gn-emit 0)) T (inc x))))
(defn- blt-apply [M :vector-i64 T :vector-i64 lo :i64 high :i64 low :i64 upper :i64] :vector-i64
 (let [start (vector-at M MM-CODE-N)
   M1 (-> M (gn-emit (enc-cmp-i 0 0)) (gn-emit (enc-bcond 11 10))
    (gn-emit (enc-cmp-i 0 high)) (gn-emit (enc-bcond 12 12))
    (gn-emit (gn-e-adr 9)) (gn-emit (gn-e-ldrr 9 9 0 1))
    (gn-emit (gn-e-lsr 0 9 8)) (gn-emit (enc-cmp-i 0 1))
    (gn-emit (gn-e-bf 0xd3400000 9 9 0 7)) (gn-mov 0 9) (gn-emit (enc-ret))
    (gn-emit (enc-cmp-i 0 (bit-and (i64-shift-right low 10) 1023)))
    (gn-mov-imm 9 (bit-and low 255)) (gn-mov 0 9) (gn-emit (enc-ret))
    (gn-emit (enc-cmp-i 0 (bit-and (i64-shift-right upper 10) 1023)))
    (gn-mov-imm 9 (bit-and upper 255)) (gn-mov 0 9) (gn-emit (enc-ret)))
   M2 (if (= (bit-and (dec (vector-at M1 MM-CODE-N)) 1) 0) M1 (gn-emit M1 0xd503201f))
   table (vector-at M2 MM-CODE-N) delta (* (- table (+ start 4)) 4)
   M3 (blt-data M2 T 0)]
  (-> M3 (gn-put (+ MM-CODE-BASE (+ start 4))
    (+ (gn-e-adr 9) (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5)))
   (gn-put (+ MM-CODE-BASE lo) (enc-b (- start lo))))))
(defn- blt-one [M :vector-i64 f :i64 limit :i64] :vector-i64
 (let [end (blt-source M f)]
  (if (= end 0) M
   (let [p (gn-fnf M f FF-SIR) high (blt-high M p end) lo (gn-fnf M f FF-CODE)
     hi (blt-hi M f lo limit)]
    (if (or (< high 64) (> high 1023) (<= lo 0) (>= lo hi) (> hi limit)
         (> (- hi lo) 4096) (<= (- hi lo) (+ (* 2 (inc high)) 20))
         (> (vector-at M MM-CODE-N) (- MM-CODE-CAP (+ (* 2 (inc high)) 20)))) M
     (let [J (vector-alloc (- hi lo)) T (vector-alloc (inc high))]
      (if (and (blt-fixes M J lo hi) (blt-code M J lo hi high) (blt-incoming M lo hi limit))
       (let [low (blt-eval M J lo hi -9223372036854775808) upper (blt-eval M J lo hi 9223372036854775807)]
        (if (and (>= low 0) (>= upper 0) (> (i64-shift-right low 20) 7)
             (> (i64-shift-right upper 20) 9) (blt-table M J T lo hi high))
         (blt-apply M T lo high low upper) M)) M)))))))
(defn- blt-run [M :vector-i64] :vector-i64
 (if (not (blt-counts M)) M
  (let [limit (vector-at M MM-CODE-N)]
   (loop [f 1 out M]
    (if (= f (vector-at M MM-FN-N)) out (recur (inc f) (blt-one out f limit)))))))

;; Bounded unsigned interval proof over final physical code. Only a complete
;; low-mask/constant/move/MUL chain can prove the dividend nonnegative; an
;; overflow, incoming edge or unknown operation keeps the signed bias.
(defn- uqd-counts [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS) (= (vector-at M MM-ERR) 0)
  (> (vector-at M MM-CODE-N) 3) (<= (vector-at M MM-CODE-N) 65536)
  (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) 512)
  (> (vector-at M MM-LABEL-N) 0) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)
  (> (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (> (vector-at M MM-SIR-N) 0) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (mp-sirclosed M 1)))
(defn- uqd-mark [R :vector-i64 to :i64] :vector-i64
 (if (and (> to 0) (< to (vector-count R))) (vector-assoc! R to 1)
  (vector-assoc! R 0 1)))
(defn- uqd-roots [M :vector-i64 omit-unemitted :bool] :vector-i64
 (let [cn (vector-at M MM-CODE-N)
       R (vector-alloc (inc cn))
       funcs (loop [V R f 1] (if (= f (vector-at M MM-FN-N)) V
         (let [to (gn-fnf M f FF-CODE)] (recur (if (and omit-unemitted (= to 0)) V (uqd-mark V to)) (inc f)))))
       labels (loop [V funcs k 1] (if (= k (vector-at M MM-LABEL-N)) V
         (let [to (vector-at M (+ MM-LABEL-BASE k))]
          (recur (if (= to 0) V (uqd-mark V to)) (inc k)))))
       fixes (loop [V labels k 1] (if (= k (vector-at M MM-FIX-N)) V
         (let [at (sf-x M k XF-AT) kind (sf-x M k XF-KIND)
               t (sf-x M k XF-TARGET) aux (sf-x M k XF-AUX)
               to (cond
                 (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19) (= kind FX-ADRL19))
                  (if (and (= aux 0) (> t 0) (< t (vector-at M MM-LABEL-N)))
                    (vector-at M (+ MM-LABEL-BASE t)) -1)
                 (or (= kind FX-BL26) (= kind FX-ADR19))
                  (if (and (>= aux 0) (<= aux 2) (> t 0) (< t (vector-at M MM-FN-N)))
                    (+ (gn-fnf M t FF-CODE) aux) -1)
                 (= kind FX-LIT32) 0 :else -1)
               marked (if (= to 0) V (uqd-mark V to))]
          (recur (if (and (> at 0) (< at cn))
            (cond (= kind FX-LIT32) (uqd-mark (uqd-mark marked at) (inc at))
                  (= kind FX-BL26) (uqd-mark marked (inc at))
                  :else marked) (vector-assoc! marked 0 1)) (inc k))))) ]
  (loop [V fixes at 1] (if (= at cn) V
   (let [w (sf-word M at) branch (of-branch w)
         adr (= (bit-and w 0x9f000000) 0x10000000)
         literal (= (bit-and w 0x3b000000) 0x18000000)
         bytes (cond adr (+ (* at 4) (mp-sign (bit-or
                    (i64-shift-left (bit-and (i64-shift-right w 5) 0x7ffff) 2)
                    (bit-and (i64-shift-right w 29) 3)) 21))
                literal (* 4 (+ at (mp-sign (bit-and (i64-shift-right w 5) 0x7ffff) 19))) :else -1)
         next (cond (> branch 0) (uqd-mark V (of-dest w at))
                (or adr literal) (if (= (bit-and bytes 3) 0) (uqd-mark V (quot bytes 4))
                                  (vector-assoc! V 0 1))
                :else V)
         call (= (bit-and w 0xfc000000) 0x94000000)]
    (recur (if (or call (= (bit-and w 0xffe0001f) 0xd4200000))
             (uqd-mark next (inc at)) next) (inc at)))))))
(defn- uqd-bound [M :vector-i64 R :vector-i64 reg :i64 at :i64 work :i64] :i64
 (if (or (<= at 0) (<= work 0) (< reg 0) (>= reg 31)) -1
  (let [w (sf-word M at) kind (hld-kind w) writes (hld-write w)
        d (bit-and w 31) n (bit-and (i64-shift-right w 5) 31)
        r (bit-and (i64-shift-right w 16) 31) imms (bit-and (i64-shift-right w 10) 63)]
   (if (or (< kind 13) (> kind 16) (< writes 0)) -1
    (if (= (bit-and writes (hld-bit reg)) 0)
     (if (= (vector-at R at) 0) (uqd-bound M R reg (dec at) (dec work)) -1)
     (cond
      (= (bit-and w 0xffe00000) 0xd2800000) (bit-and (i64-shift-right w 5) 65535)
      (and (= (bit-and w 0xffff0000) 0x92400000) (<= imms 30))
       (dec (i64-shift-left 1 (inc imms)))
      (> (vector-at R at) 0) -1
      (= (bit-and w (bit-not (bit-or (i64-shift-left 31 16) 31))) 0xaa0003e0)
       (uqd-bound M R r (dec at) (dec work))
      (= (bit-and w 0xffe0fc00) 0x9b007c00)
       (let [budget (quot (dec work) 2)
             a (uqd-bound M R n (dec at) budget) b (uqd-bound M R r (dec at) budget)]
        (if (or (< a 0) (< b 0)) -1
         (if (or (= a 0) (= b 0)) 0
          (if (<= a (quot 9223372036854775807 b)) (* a b) -1))))
      :else -1))))))
(defn- uqd-dead17 [M :vector-i64 R :vector-i64 at :i64 work :i64] :bool
 (if (or (<= work 0) (>= at (vector-at M MM-CODE-N))) false
  (let [w (sf-word M at) kind (hld-kind w) reads (hld-read w) writes (hld-write w)]
   (and (>= kind 7) (<= kind 16) (>= reads 0) (>= writes 0)
    (= (bit-and reads (hld-bit 17)) 0)
    (or (> (bit-and writes (hld-bit 17)) 0)
      (and (= (vector-at R at) 0) (uqd-dead17 M R (inc at) (dec work))))))))
(defn- uqd-site [M :vector-i64 R :vector-i64 at :i64] :bool
 (let [cn (vector-at M MM-CODE-N)]
  (if (or (< at 1) (> at (- cn 3))) false
   (let [a (sf-word M at) b (sf-word M (inc at)) c (sf-word M (+ at 2))
         x (bit-and (i64-shift-right a 5) 31) p (bit-and (i64-shift-right c 16) 63)]
    (and (>= x 9) (<= x 15) (>= p 2) (<= p 62)
     (= a (gn-e-asr 17 x 63))
     (= b (+ (gn-e-addsl x x 17 (- 64 p)) 0x400000))
     (= c (gn-e-asr x x p))
     (= (vector-at R at) 0) (= (vector-at R (inc at)) 0) (= (vector-at R (+ at 2)) 0)
     (>= (uqd-bound M R x (dec at) 64) 0)
     (uqd-dead17 M R (+ at 3) 64))))))
(defn- uqd-run [M :vector-i64] :vector-i64
 (if (not (uqd-counts M)) M
  (let [R (uqd-roots M false) cn (vector-at M MM-CODE-N)]
   (if (not= (vector-at R 0) 0) M
    (let [P (loop [V (vector-alloc cn) at 1 used 0]
       (if (or (> at (- cn 3)) (>= used 128)) V
        (let [yes (uqd-site M R at)]
         (recur (if yes (vector-assoc! V at 1) V) (+ at (if yes 3 1)) (+ used (if yes 1 0))))))]
     ;; All proofs use the complete unchanged code before any B2 is installed.
     (loop [V M at 1] (if (= at cn) V
      (recur (if (= (vector-at P at) 1) (gn-put V (+ MM-CODE-BASE at) (enc-b 2)) V) (inc at)))))))))

;; Same-layout scalar selection shortcut. Keep both original arm MOVs so
;; other predecessors retain their old assignments. Never skip an effect.
(defn- csp-entry-free [M :vector-i64 at :i64] :bool
 (and
  (loop [f 1] (or (= f (vector-at M MM-FN-N))
   (and (not= (gn-fnf M f FF-CODE) at) (recur (inc f)))))
  ;; A LABEL identity is not an incoming edge. Prior collapse may retain an
  ;; unused LABEL at this position. Keep its mapping; require every live FIX,
  ;; address/function entry and physical branch to avoid this instruction.
  (loop [k 1] (or (= k (vector-at M MM-FIX-N))
   (let [kind (sf-x M k XF-KIND) target (sf-x M k XF-TARGET)
    aux (sf-x M k XF-AUX) pos (sf-x M k XF-AT)
    to (cond (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19) (= kind FX-ADRL19))
      (vector-at M (+ MM-LABEL-BASE target))
     (or (= kind FX-BL26) (= kind FX-ADR19)) (+ (gn-fnf M target FF-CODE) aux)
     :else 0)]
    (and (not= to at) (or (not= kind FX-BL26) (not= (inc pos) at))
     (or (not= kind FX-LIT32) (and (not= pos at) (not= (inc pos) at)))
     (recur (inc k))))))
  (loop [j 1] (or (= j (vector-at M MM-CODE-N))
   (let [word (sf-word M j)]
    ;; The candidate CBZ's own unresolved imm0 is not an incoming edge.
    ;; Every other raw branch/address, including callbacks' return sites,
    ;; must not enter this replaced predicate-consumption instruction.
    (and (or (= j at) (not= (of-dest word j) at))
     (of-external-address word j at (inc at))
     (recur (inc j))))))))
(defn- csp-code-only [M :vector-i64 start :i64 end :i64] :bool
 (loop [j start] (or (= j end)
  (let [word (sf-word M j)]
   ;; Owned functions with embedded/PC-relative tables are ineligible. This
   ;; avoids treating literal payloads as a coincidental instruction pattern.
   (and (not= (bit-and word 0x9f000000) 0x10000000)
    (not= (bit-and word 0x9f000000) 0x90000000)
    (not= (bit-and word 0x3b000000) 0x18000000)
    (or (> (hld-kind word) 0) (> (of-branch word) 0))
    (recur (inc j)))))))
(defn- csp-scn-safe [M :vector-i64 start :i64 end :i64] :bool
 ;; Layout's SCN may clone code after this pass. Refuse any owner that can
 ;; meet SCN's minimum four scalar-zero test pairs, before or after shortcut.
 (loop [r 19] (or (> r 28)
  (and (< (loop [j start n 0]
     (if (>= j end) n (recur (inc j) (+ n (if (scn-test M j end r) 1 0))))) 4)
   (recur (inc r))))))
(defn- csp-site [M :vector-i64 f :i64 at :i64 end :i64] :bool
 (if (or (<= at (gn-fnf M f FF-CODE)) (>= (+ at 5) end)) false
  (let [cmp (sf-word M (dec at)) set (sf-word M at) pred (bit-and set 31)
   left (sf-word M (+ at 2)) right (sf-word M (+ at 4))
   lr (bit-and (i64-shift-right left 16) 31) rr (bit-and (i64-shift-right right 16) 31)
   cc (bit-xor (bit-and (i64-shift-right set 12) 15) 1)
   cb (hld-fix M (inc at)) jump (hld-fix M (+ at 3))]
   (and (or (= (bit-and cmp 0xffe0fc1f) 0xeb00001f)
     (= (bit-and cmp 0xffc0001f) 0xf100001f))
    (= (bit-and set 0xffff0fe0) 0x9a9f07e0) (< cc 14)
    (>= pred 0) (< pred 29) (not= pred 7) (not= pred 8)
    (cpp-move left) (cpp-move right) (= (bit-and left 31) pred) (= (bit-and right 31) pred)
    (not= lr pred) (not= rr pred)
    (= (hld-fix M at) 0) (= (hld-fix M (+ at 2)) 0) (= (hld-fix M (+ at 4)) 0)
    (> cb 0) (> jump 0) (not= cb jump)
    (= (sf-word M (inc at)) (enc-cbz pred 0)) (= (sf-word M (+ at 3)) (enc-b 0))
    (= (sf-x M cb XF-KIND) FX-CB19) (= (sf-x M cb XF-AT) (inc at)) (= (sf-x M cb XF-AUX) 0)
    (= (sf-x M jump XF-KIND) FX-B26) (= (sf-x M jump XF-AT) (+ at 3)) (= (sf-x M jump XF-AUX) 0)
    (> (alen-source-label M (gn-fnf M f FF-SIR) (cpp-owned M f) (sf-x M cb XF-TARGET)) 0)
    (> (alen-source-label M (gn-fnf M f FF-SIR) (cpp-owned M f) (sf-x M jump XF-TARGET)) 0)
    (= (vector-at M (+ MM-LABEL-BASE (sf-x M cb XF-TARGET))) (+ at 4))
    (= (vector-at M (+ MM-LABEL-BASE (sf-x M jump XF-TARGET))) (+ at 5))
    (csp-entry-free M (inc at))))))
(defn- csp-apply [M :vector-i64 at :i64] :vector-i64
 (let [pred (bit-and (sf-word M at) 31)
  cc (bit-xor (bit-and (i64-shift-right (sf-word M at) 12) 15) 1)
  lr (bit-and (i64-shift-right (sf-word M (+ at 2)) 16) 31)
  rr (bit-and (i64-shift-right (sf-word M (+ at 4)) 16) 31)
  cb (hld-fix M (inc at)) jump (hld-fix M (+ at 3)) b (+ MM-FIX-BASE (* cb MM-FIX-W))]
  (-> M (gn-put (+ MM-CODE-BASE at) (enc-csel pred lr rr cc))
   (gn-put (+ MM-CODE-BASE (inc at)) (enc-b 0))
   (gn-put (+ b XF-KIND) FX-B26) (gn-put (+ b XF-TARGET) (sf-x M jump XF-TARGET)))))
(defn- csp-run [M :vector-i64] :vector-i64
 (if (not (uqd-counts M)) M
  (let [R (uqd-roots M false) cn (vector-at M MM-CODE-N)]
   (if (not= (vector-at R 0) 0) M
    (let [P (loop [V (vector-alloc cn) f 1]
     (if (= f (vector-at M MM-FN-N)) V
      (let [start (gn-fnf M f FF-CODE) end (sf-codeend M f 1 cn)
       next (if (or (= (cpp-owned M f) 0) (not (csp-code-only M start end)) (not (csp-scn-safe M start end))) V
        (loop [out V at (inc start)]
         (if (>= (+ at 5) end) out
          (let [yes (csp-site M f at end)]
           (recur (if yes (vector-assoc! out at 1) out) (+ at (if yes 5 1)))))))]
       (recur next (inc f)))))]
     ;; Admission reads the complete unmodified source/code/FIX/LABEL state.
     (loop [out M at 1] (if (= at cn) out
      (recur (if (= (vector-at P at) 1) (csp-apply out at) out) (inc at)))))))))

;; Exact adjacent store-to-load forwarding in final code. All original
;; charges, publications, NZCV, exhaustion targets and physical positions
;; remain. A complete root inventory forbids entering the redundant load.
(defn- afr-site [M :vector-i64 R :vector-i64 at :i64] :bool
 (let [cn (vector-at M MM-CODE-N)]
  (and (> at 1) (< (+ at 3) cn) (= (vector-at R at) 0)
   (= (sf-word M (dec at)) (enc-str 16 7 CTX-FUEL))
   (= (sf-word M at) (enc-ldr 16 7 CTX-FUEL))
   (= (sf-word M (inc at)) (enc-subs-i 16 16 1))
   (or (and (= (sf-word M (+ at 2)) (enc-bcond (enc-cond-hs) 2))
            (= (sf-word M (+ at 3)) (enc-brk 0)))
       (= (bit-and (sf-word M (+ at 2)) 0xff00001f) 0x54000003)))))
(defn- afr-run [M :vector-i64] :vector-i64
 (if (not (uqd-counts M)) M
  (let [R (uqd-roots M true) cn (vector-at M MM-CODE-N)]
   (if (not= (vector-at R 0) 0) M
    (let [P (loop [V (vector-alloc cn) at 1]
             (if (= at cn) V
              (recur (if (afr-site M R at) (vector-assoc! V at 1) V) (inc at))))]
     ;; Frozen plan: changing one load cannot establish another proof.
     (loop [V M at 1] (if (= at cn) V
      (recur (if (= (vector-at P at) 1)
               (gn-put V (+ MM-CODE-BASE at) 0xd503201f) V) (inc at)))))))))
;; A direct B+2 skips one unreachable word. Complete unchanged roots must
;; exclude entry into that word before both become NOP; layout and NZCV stay.
(defn- owj-run [M :vector-i64] :vector-i64
 (if (not (uqd-counts M)) M
  (let [R (uqd-roots M true) cn (vector-at M MM-CODE-N)]
   (if (not= (vector-at R 0) 0) M
    (let [P (loop [V (vector-alloc cn) at 1]
             (if (>= (+ at 2) cn) V
              (recur (if (and (= (sf-word M at) (enc-b 2))
                        (= (vector-at R (inc at)) 0)) (vector-assoc! V at 1) V) (inc at))))]
     (loop [V M at 1] (if (= at cn) V
      (recur (if (= (vector-at P at) 1)
       (-> V (gn-put (+ MM-CODE-BASE at) 0xd503201f)
        (gn-put (+ MM-CODE-BASE (inc at)) 0xd503201f)) V) (inc at)))))))))
(defn- gn-run [M :vector-i64] :vector-i64 (owj-run (afr-run (csp-run (blt-run (uqd-run (blt-old-run M)))))))
