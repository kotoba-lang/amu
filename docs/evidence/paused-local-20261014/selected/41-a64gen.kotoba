  41 (gn-dot-at? M (+ p 41) 5 3 2 0)
  42 (gn-dot-at? M (+ p 42) 18 0 0 0)
  43 (gn-dot-at? M (+ p 43) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  44 (gn-dot-at? M (+ p 44) 9 (gn-sir M (+ p 44) IF-A) 0 0)
  45 (gn-dot-at? M (+ p 45) 19 0 0 0)
  46 (gn-dot-at? M (+ p 46) 2 f 0 0)
 false) (rl-shape M p f (inc k))))))
(defn- rl-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 3) true (let [o (case k 0 2 1 9 2 44 0) l (gn-sir M (+ p o) IF-A)]
  (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p o)) (rl-labels M p (inc k))))))
(defn- rl-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (>= (+ p 46) (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN)) false
 (let [f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 29) IF-B)
  reader (gn-sir M (+ p 17) IF-A) dot (gn-sir M (+ p 18) IF-A) writer (gn-sir M (+ p 34) IF-A)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 5) (= (gn-fnf M f FF-DEPTH) 7)
  (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
  (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
  (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
  (= (gn-g M gn-f-ns) 5) (= (gn-g M gn-f-dp) 7) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
  (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 5)
  (>= n 1) (<= n 64) (>= stride 1) (<= stride 4095)
  (rl-shape M p f 0) (rl-labels M p 0) (pz-writer M writer)
  (> reader 0) (< reader (vector-at M MM-FN-N))
  (> dot 0) (< dot (vector-at M MM-FN-N))
  (> (gn-fnf M reader FF-SIR) 0) (< (+ (gn-fnf M reader FF-SIR) 11) (vector-at M MM-SIR-N))
  (> (gn-fnf M dot FF-SIR) 0) (< (+ (gn-fnf M dot FF-SIR) 36) (vector-at M MM-SIR-N))
  (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 5) IF-A) CC-EQ)
  (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 20) IF-A) reader)
  (> (mr-reader M (+ p 17) reader 3) 0)
