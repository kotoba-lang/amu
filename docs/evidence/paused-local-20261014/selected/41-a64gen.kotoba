(defn- ri-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (>= (+ p 75) (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN)) false
  (let [f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 53) IF-B) out (gn-sir M (+ p 15) IF-B)]
