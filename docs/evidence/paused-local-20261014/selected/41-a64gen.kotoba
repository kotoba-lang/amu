       oa (gn-sir M (+ p 8) IF-B) sh (gn-sir M (+ p 12) IF-B)
       helper (gn-sir M (+ p 43) IF-A)]
  (if (= k 85) true
   (and (case k
    0 (gn-dot-at? M (+ p 0) OP-FN f 6 10)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 3 0)
