  (-> M (qrow-common) (qrow-same) (gn-emit (enc-add-r 9 1 2))
      (gn-mov-imm 16 1) (gn-emit (enc-and-r 9 9 16))
      (gn-emit (enc-add-r 9 6 9)) (qrow-parity-zero 9))))
(defn- qrow-guard [M :vector-i64 P :vector-i64 k :i64 c :i64] :vector-i64
 (let [ignored (vector-assoc! P k (vector-at M MM-CODE-N))] (gn-emit M (enc-bcond c 0))))
(defn- qrow-disjoint [M :vector-i64 P :vector-i64 k :i64] :vector-i64
 ;; backing [3,4), other [5,6); source args0..2 and authoritative fuel8 unchanged.
 (-> M (gn-emit (enc-cmp-r 3 6)) (gn-emit (enc-bcond (enc-cond-hs) 3))
  (gn-emit (enc-cmp-r 5 4)) (qrow-guard P k (enc-cond-lo))))
