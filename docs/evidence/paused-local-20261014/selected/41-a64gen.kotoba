(defn- qrow-counts [M :vector-i64] :bool
 (and (> (vector-at M MM-SIR-N) 1) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) MM-FN-CAP)))
(defn- qrow-fn [M :vector-i64 f :i64 n :i64 slots :i64 depth :i64 count :i64 rt :i64 pt0 :i64] :i64
 (if (or (not (qrow-counts M)) (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP)) 0
  (let [p (gn-fnf M f FF-SIR)]
   (if (and (> p 0) (<= p (- (vector-at M MM-SIR-N) count))
     (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) slots)
     (= (gn-fnf M f FF-DEPTH) depth) (= (gn-fnf M f FF-RTYPE) rt)
     (not (gn-clamp-open M f)) (aw-ins M p OP-FN f n slots)
     (aw-ins M (+ p (dec count)) OP-END f 0 0)
     (loop [k 0] (or (= k n) (and (= (ck-pt M f k) (if (= k 0) pt0 TY-I64)) (recur (inc k)))))) p 0))))
(defn- qrow-want [M :vector-i64 p :i64 f :i64 marker :i64] :i64
 (cond (= marker -1) f (<= marker -3000) (gn-sir M (+ p (- 0 marker 3000)) IF-B) (<= marker -2000) (gn-sir M (+ p (- 0 marker 2000)) IF-A)
  :else (gn-sir M (+ p (- 0 marker 1000)) IF-A)))
(defn- qrow-match [M :vector-i64 p :i64 f :i64 V :vector-i64 k :i64] :bool
 (if (= k (vector-count V)) true
  (let [a (vector-at V k) v (if (< a 0) (qrow-want M p f a) a)]
   (and (= (gn-sir M (+ p (quot k 4)) (rem k 4)) v) (qrow-match M p f V (inc k))))))
(defn- qrow-labels [M :vector-i64 p :i64 count :i64 k :i64] :bool
 (if (= k count) true
  (let [j (+ p k)]
   (and (if (= (gn-op M j) OP-LABEL)
    (let [l (gn-sir M j IF-A)]
     (and (> l 0) (< l MM-LABEL-CAP)
      (loop [q 1] (or (= q (vector-at M MM-SIR-N))
       (and (not= (gn-op M q) OP-TAB)
        (or (not= (gn-op M q) OP-LABEL) (not= (gn-sir M q IF-A) l) (= q j))
        (not (and (or (= (gn-op M q) OP-BR) (= (gn-op M q) OP-BRZ) (= (gn-op M q) OP-BRNZ))
         (= (gn-sir M q (if (= (gn-op M q) OP-BR) IF-A IF-B)) l)
         (or (< q p) (>= q (+ p count))))) (recur (inc q))))))) true)
    (qrow-labels M p count (inc k))))))
