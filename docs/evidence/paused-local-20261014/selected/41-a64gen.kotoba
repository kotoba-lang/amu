    45 (gn-dot-at? M (+ p 45) OP-LGET 0 3 0)
    46 (gn-dot-at? M (+ p 46) OP-CONST 1 1 0)
    47 (gn-dot-at? M (+ p 47) OP-BIN 1 0 0)
