    25 (gn-dot-at? M (+ p 25) OP-LABEL e 0 0)
    26 (gn-dot-at? M (+ p 26) OP-RET 0 0 0)
    27 (gn-dot-at? M (+ p 27) OP-END f 0 0) false)
