    175 (and (ac-label M p 175) (gn-dot-at? M (+ p 175) 9 (gn-sir M (+ p 175) IF-A) 0 0))
    176 (gn-dot-at? M (+ p 176) 19 0 0 0)
    177 (gn-dot-at? M (+ p 177) 2 f 0 0)
    false) (ac-shape M p f A L O H (inc k)))))
(defn- ac-meta [M :vector-i64 f :i64 n :i64 ns :i64 dp :i64 count :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (<= p (- (vector-at M MM-SIR-N) count))
    (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) ns)
    (= (gn-fnf M f FF-DEPTH) dp) (= (gn-fnf M f FF-RTYPE) TY-I64)
    (or (= (gn-fnf M f FF-KIND) FK-DEFN) (= (gn-fnf M f FF-KIND) FK-PRIV))))))
(defn- ac-types [M :vector-i64 f :i64 k :i64] :bool
 (if (= k 8) true
  (and (= (td-pt M f k) (case k (0 3) TY-STR 5 TY-VEC TY-I64))
   (ac-types M f (inc k)))))
(defn- ac-ascii [M :vector-i64 b :i64 k :i64 n :i64] :bool
 (if (= k n) true (let [v (vector-at M (+ MM-LITB-BASE b k))]
  (and (>= v 0) (< v 128) (ac-ascii M b (inc k) n)))))
(defn- ac-literals [M :vector-i64 k :i64 V :vector-i64] :vector-i64
 (if (= k (vector-at M MM-LIT-N)) V
  (let [b (gn-litf M k LF-B) n (gn-litf M k LF-LEN) count (vector-at V 0)]
   (if (or (< b 0) (< n 0) (> n 65535) (> b (- (vector-at M MM-LITB-N) n)))
    (vector-assoc! V 0 -1)
    (if (and (> n 0) (ac-ascii M b 0 n))
     (if (>= count 8) (vector-assoc! V 0 -1)
      (ac-literals M (inc k) (-> V (vector-assoc! (inc count) k) (vector-assoc! 0 (inc count)))))
     (ac-literals M (inc k) V))))))
(defn- ac-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (>= i (vector-at M MM-SIR-N)) (> (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (dec i) (- (vector-at M MM-SIR-N) 178))
  (not= (gn-op M (dec i)) OP-FN) (not= (gn-g M gn-f-leaf) 0)
  (not= (gn-g M gn-f-freg) 0) (not= (gn-g M gn-f-vmode) 0)
  (not= (gn-g M gn-f-h) 0) (not= (gn-g M gn-f-skip) 0)
  (not= (gn-g M gn-f-ns) 12) (not= (gn-g M gn-f-dp) 12)
  (not= (gn-g M gn-f-nsv) 10) (not= (gn-g M gn-f-fb) 288)
  (not= (gn-g M gn-f-out) 0)
  (< (vector-at M MM-LIT-N) 1) (> (vector-at M MM-LIT-N) MM-LIT-CAP)
  (< (vector-at M MM-LITB-N) 0) (> (vector-at M MM-LITB-N) MM-LITB-CAP)) false
  (let [p (dec i) f (gn-sir M p IF-A)]
   (if (not (and (ac-meta M f 8 12 12 178) (= (gn-fnf M f FF-SIR) p))) false
    (let [A (gn-sir M (+ p 11) IF-A) O (gn-sir M (+ p 151) IF-A) H (gn-sir M (+ p 160) IF-A)]
     (if (not (and (ac-meta M A 2 2 2 17) (ac-meta M O 2 2 3 28)
                   (ac-meta M H 5 8 3 155))) false
      (let [hp (gn-fnf M H FF-SIR) L (gn-sir M (+ hp 127) IF-A)]
       (and (= (gn-fnf M f FF-SIR) p) (ac-types M f 0)
        (= (gn-fnf M A FF-PT0) TY-STR) (= (gn-fnf M A (+ FF-PT0 1)) TY-I64)
        (= (gn-fnf M O FF-PT0) TY-STR) (= (gn-fnf M O (+ FF-PT0 1)) TY-I64)
        (= (gn-fnf M H FF-PT0) TY-STR) (= (gn-fnf M H (+ FF-PT0 1)) TY-I64)
        (= (gn-fnf M H (+ FF-PT0 2)) TY-STR) (= (gn-fnf M H (+ FF-PT0 3)) TY-I64)
        (= (gn-fnf M H (+ FF-PT0 4)) TY-VEC)
        (ac-meta M L 1 1 2 20) (= (gn-fnf M L FF-PT0) TY-I64)
        (ac-reader-shape M (gn-fnf M A FF-SIR) A A L O H 0)
        (ac-lower-shape M (gn-fnf M L FF-SIR) L A L O H 0)
        (ac-length-shape M (gn-fnf M O FF-SIR) O A L O H 0)
        (ac-match-shape M hp H A L O H 0) (ac-shape M p f A L O H 0)
        (loop [k 1] (if (> k 12) true
         (and (= (gn-sreg M k) (case k 1 20 2 21 3 26 4 23 5 24 6 25 7 19 8 -1 9 22 10 27 11 28 -1))
          (recur (inc k)))))))))))))
;; Compare metadata only: actual pool offset AND length, never containment.
;; x8 offset/x9 length, result saved byte base dst. Q collects success edges.
(defn- ac-pool [M :vector-i64 V :vector-i64 Q :vector-i64 k :i64] :vector-i64
 (if (> k (vector-at V 0)) M
  (let [lit (vector-at V k) n (gn-litf M lit LF-LEN)
        m0 (-> M (gn-mov-imm 17 n) (gn-emit (enc-cmp-r 9 17))) skip (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-fix FX-LIT32 lit)
          (gn-emit (enc-movz 17 0 0)) (gn-emit (enc-movk 17 0 1)) (gn-emit (enc-cmp-r 8 17)))
        m2 (nr-guard m1 Q (dec k) (enc-cond-eq)) end (vector-at m2 MM-CODE-N)]
   (ac-pool (gn-dot-patch m2 skip end (enc-cond-ne)) V Q (inc k)))))
(defn- ac-string [M :vector-i64 V :vector-i64 G :vector-i64 g :i64 r :i64 dst :i64] :vector-i64
 (let [m0 (-> M (gn-emit (enc-ldr 16 7 288)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 r 1)) (gn-emit (enc-cmp-r 17 16)) (nr-guard G g (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 296)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 8 9 16 0)))
   Q (vector-alloc 8) m1 (ac-pool m0 V Q 1) fail (vector-at m1 MM-CODE-N)
   m2 (gn-emit m1 (enc-b 0)) success (vector-at m2 MM-CODE-N)
   m3 (loop [current m2 k 0] (if (= k (vector-at V 0)) current
    (recur (gn-dot-patch current (vector-at Q k) success (enc-cond-eq)) (inc k))))
   m4 (-> m3 (gn-emit (enc-ldr dst 7 CTX-CODE-BASE)) (gn-emit (enc-add-r dst dst 8))
     (gn-emit (enc-add-r 17 8 9)) (gn-emit (enc-ldr 16 7 392))
     (gn-emit (enc-cmp-r 17 16)) (nr-guard G (if (= g 3) 16 17) 8))
   save (vector-assoc! G (inc g) fail)] m4))
(defn- ac-charge [M :vector-i64] :vector-i64
 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-subs-i 16 16 1))
   (gn-emit (enc-bcond (enc-cond-hs) 2)) (gn-emit (enc-brk 0)) (gn-emit (enc-str 16 7 CTX-FUEL))))
(defn- ac-lower [M :vector-i64 r :i64] :vector-i64
 (-> M (gn-emit (enc-cmp-i r 65)) (gn-emit (enc-bcond (enc-cond-lt) 4))
   (gn-emit (enc-cmp-i r 90)) (gn-emit (enc-bcond (enc-cond-gt) 2)) (gn-emit (enc-add-i r r 32))))
(defn- ac-cold [M :vector-i64 p :i64 k :i64 C :vector-i64] :vector-i64
 (if (= k 178) M
  (let [z (if (= k 2) (vector-assoc! C 0 (vector-at M MM-CODE-N))
           (if (= k 12) (vector-assoc! C 1 (vector-at M MM-CODE-N))
            (if (= k 37) (vector-assoc! C 2 (vector-at M MM-CODE-N)) C)))
        m1 (gn-ins M (+ p k) (gn-op M (+ p k))) skip (gn-g m1 gn-f-skip)]
   (ac-cold (gn-gs m1 gn-f-skip 0) p (+ k 1 skip) C))))
(defn- ac-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (ac-admit M i)) M
  (let [V (ac-literals M 0 (vector-alloc 9))]
   (if (<= (vector-at V 0) 0) M
    (let [B (gp-save-state M) G (vector-alloc 20) C (vector-alloc 3) p (dec i)
     head (vector-at M MM-CODE-N)
     m0 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 9)) (nr-guard G 0 (enc-cond-lo))
      (gn-emit (enc-cmp-r 19 26)) (nr-guard G 1 (enc-cond-gt))
      (gn-ld 16 8) (gn-emit (enc-cmp-i 16 0)) (nr-guard G 2 (enc-cond-gt))
      (gn-emit (enc-add-r 2 21 19)))
     m1 (ac-string m0 V G 3 20 0)
     m2 (-> m1 (gn-emit (enc-sub-i 9 9 1)) (gn-emit (enc-cmp-r 2 9)) (nr-guard G 5 (enc-cond-hs)))
     m3 (ac-string m2 V G 6 23 1)
     m4 (-> m3 (gn-emit (enc-cmp-r 24 9)) (nr-guard G 8 (enc-cond-hs))
      (gn-emit (enc-sub-i 17 25 1)) (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
      (gn-emit (enc-cmp-r 17 16)) (nr-guard G 9 (enc-cond-hs))
      (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 8 9 16 0))
      (gn-emit (enc-cmp-i 9 3)) (nr-guard G 10 9)
      (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 8 3))
      ;; First distinct payload read follows exactly its original at entry charge.
      (ac-charge) (gn-emit (gn-e-ldrb 5 0 2)))
     m5 (loop [current m4 k 0] (if (= k 5) current
      (recur (-> current (gn-emit (enc-cmp-i 5 (case k 0 93 1 92 2 124 3 36 46)))
        (nr-guard G (+ 11 k) (enc-cond-eq))) (inc k))))
     m6 (-> m5 (ac-charge) (gn-emit (enc-cmp-i 5 45))) minus (vector-at m6 MM-CODE-N)
     m7 (-> m6 (gn-emit (enc-bcond (enc-cond-eq) 0)) (ac-charge)
      (gn-emit (enc-add-i 16 2 1)) (gn-emit (gn-e-ldrb 6 0 16))
      (gn-emit (enc-cmp-i 6 45))) range (vector-at m7 MM-CODE-N)
     m8 (gn-emit m7 (enc-bcond (enc-cond-eq) 0)) ordinary (vector-at m8 MM-CODE-N)
     m9 (-> (gn-dot-patch m8 minus ordinary (enc-cond-eq))
      ;; op-len entry, its reused reader, match-op entry, its reused reader,
      ;; then original subject reader entry before the second distinct byte.
      (ac-charge) (ac-charge) (ac-charge) (ac-charge) (ac-charge)
      (gn-emit (gn-e-ldrb 10 1 24)) (gn-emit (enc-ldr 16 4 24)) (gn-mov-imm 17 1)
      (gn-emit (enc-and-r 16 16 17)) (gn-emit (enc-cmp-i 16 1))) raw (vector-at m9 MM-CODE-N)
     m10 (-> m9 (gn-emit (enc-bcond (enc-cond-ne) 0)) (ac-lower 5) (ac-lower 10)) cmp (vector-at m10 MM-CODE-N)
     m11 (-> (gn-dot-patch m10 raw cmp (enc-cond-ne)) (gn-emit (enc-cmp-r 5 10))
      (gn-emit (enc-cset 9 (enc-cond-eq))) (gn-emit (gn-e-lsl 9 9 1)) (gn-emit (enc-sub-i 9 9 1))
      (gn-emit (enc-str 2 31 112)) (gn-emit (enc-str 9 31 120))
      (gn-emit (enc-add-i 19 19 1)) (gn-emit (enc-str 19 31 128)) (gn-st 9 8)
      (ac-charge)) back (vector-at m11 MM-CODE-N)
     m12 (gn-emit m11 (enc-b (- head back)))
     first (vector-at m12 MM-CODE-N) m13 (-> m12 (gn-mov 0 5) (gn-mov 1 2) (gn-mov 9 5)) firstb (vector-at m13 MM-CODE-N)
     m14 (gn-emit m13 (enc-b 0)) second (vector-at m14 MM-CODE-N)
     m15 (-> m14 (gn-mov 0 6) (gn-emit (enc-add-i 1 2 1)) (gn-mov 9 6)) secondb (vector-at m15 MM-CODE-N)
     m16 (gn-emit m15 (enc-b 0)) cold (vector-at m16 MM-CODE-N)
     m17 (ac-cold (gp-restore m16 B) p 2 C)
     m18 (loop [current m17 k 0] (if (= k 18) current
       (let [at (vector-at G k)]
        (recur (if (and (>= k 11) (<= k 15)) current (if (or (= k 4) (= k 7)) (gn-put current (+ MM-CODE-BASE at) (enc-b (- cold at)))
          (gn-dot-patch current at cold (case k (3 5 6 8 9) (enc-cond-hs) (1 2) (enc-cond-gt) 10 9 (16 17) 8 (enc-cond-lo))))) (inc k)))))
     m19 (loop [current m18 k 11] (if (= k 16) current
      (recur (gn-dot-patch current (vector-at G k) first (enc-cond-eq)) (inc k))))]
     (-> m19 (gn-dot-patch range second (enc-cond-eq))
       (gn-put (+ MM-CODE-BASE firstb) (enc-b (- (vector-at C 1) firstb)))
       (gn-put (+ MM-CODE-BASE secondb) (enc-b (- (vector-at C 2) secondb)))
       (gn-put (+ MM-LABEL-BASE (gn-sir M (+ p 2) IF-A)) head)
       (gn-gs gn-f-dead 0) (gn-gs gn-f-skip 176)))))))


;; ADR0357 one-off new closed readonly carry-loop algorithm; no existing
;; mechanical AST rule supplies this semantic certificate. No name dispatch.
(defn- mdc-pattern [kind :i64] :vector-i64
