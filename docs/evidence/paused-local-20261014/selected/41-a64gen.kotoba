    8 (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 2 0)
    11 (gn-dot-at? M (+ p 11) OP-CONST 1 threshold 0)
    12 (gn-dot-at? M (+ p 12) OP-CMP 2 0 0)
    13 (gn-dot-at? M (+ p 13) OP-BRZ 0 right 0)
    14 (gn-dot-at? M (+ p 14) OP-LGET 0 1 0)
    15 (gn-dot-at? M (+ p 15) OP-CONST 1 0 0)
    16 (gn-dot-at? M (+ p 16) OP-LGET 2 2 0)
    17 (gn-dot-at? M (+ p 17) OP-CALL initial 0 3)
    18 (gn-dot-at? M (+ p 18) OP-BR join 0 0)
    19 (gn-dot-at? M (+ p 19) OP-LABEL right 0 0)
    20 (gn-dot-at? M (+ p 20) OP-LGET 0 1 0)
    21 (gn-dot-at? M (+ p 21) OP-CONST 1 base 0)
    22 (gn-dot-at? M (+ p 22) OP-LGET 2 2 0)
    23 (gn-dot-at? M (+ p 23) OP-CONST 3 d0 0)
    24 (gn-dot-at? M (+ p 24) OP-BIN 2 2 0)
    25 (gn-dot-at? M (+ p 25) OP-BIN 1 1 0)
    26 (gn-dot-at? M (+ p 26) OP-RT 176 0 2)
    27 (gn-dot-at? M (+ p 27) OP-CALL sig1 0 1)
