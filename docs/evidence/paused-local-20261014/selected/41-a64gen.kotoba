(defn- rls-writer [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
 (let [p (gn-fnf M f FF-SIR)] (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 11))) 0
 (let [mask (gn-sir M (+ p 6) IF-B) label (gn-sir M (+ p 2) IF-A)]
  (if (and (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
   (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (= (ck-pt M f 0) TY-VEC) (= (ck-pt M f 1) TY-I64) (= (ck-pt M f 2) TY-I64)
   (>= mask 0) (<= mask 4294967295) (> label 0) (< label MM-LABEL-CAP) (= (gn-lpos M label) (+ p 2))
   (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
   (gn-dot-at? M (+ p 2) OP-LABEL label 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
   (gn-dot-at? M (+ p 4) OP-LGET 1 2 0) (gn-dot-at? M (+ p 5) OP-LGET 2 3 0)
   (gn-dot-at? M (+ p 6) OP-CONST 3 mask 0) (gn-dot-at? M (+ p 7) OP-BIN BOP-AND 2 0)
   (gn-dot-at? M (+ p 8) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
   (gn-dot-at? M (+ p 9) OP-RET 0 0 0) (gn-dot-at? M (+ p 10) OP-END f 0 0)) (inc mask) 0))))))

(defn- fourprobe-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i)] (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 68)) (not= (gn-op M p) OP-FN)) 0
 (let [f (gn-sir M p IF-A)] (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
 (let [n (gn-sir M (+ p 4) IF-B) reader (gn-sir M (+ p 13) IF-A)]
 (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-NSLOTS) 6)
 (= (gn-fnf M f FF-DEPTH) 5) (= (gn-fnf M f FF-RTYPE) TY-I64) (= (ck-pt M f 0) TY-VEC)
 (= (ck-pt M f 1) TY-I64) (= (ck-pt M f 2) TY-I64) (= (ck-pt M f 3) TY-I64)
 (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
 (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
 (= (gn-g M gn-f-ns) 6) (= (gn-g M gn-f-dp) 5) (= (gn-g M gn-f-h) 0)
 (= (gn-g M gn-f-skip) 0) (> (gn-g M gn-f-fb) 0) (>= n 1) (<= n 64)
 (fourprobe-shape M p f 0)
 (loop [k 0] (or (= k 6) (let [at (+ p (case k 0 2 1 9 2 43 3 55 4 57 65)) label (gn-sir M at IF-A)]
 (and (> label 0) (< label MM-LABEL-CAP) (= (gn-lpos M label) at) (recur (inc k))))))
 (loop [k 1] (or (= k 5) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
 (loop [j 1] (or (= j k) (and (not= (gn-sreg M k) (gn-sreg M j)) (recur (inc j))))) (recur (inc k)))))
 (> (qi-shape M reader) 0)) (qi-shape M reader) 0)))))))
(defn- fourprobe-entry [M :vector-i64 i :i64] :vector-i64
 (let [tree (fourprobe-admit M i)] (if (= tree 0) M
 (let [p (dec i) n (gn-sir M (+ p 4) IF-B) award (gn-sir M (+ p 53) IF-B)
 reader (gn-sir M (+ p 13) IF-A) rp (gn-fnf M reader FF-SIR)
 divisor (gn-sir M (+ rp 6) IF-B) stride (gn-sir M (+ rp 10) IF-B) offset (gn-sir M (+ rp 4) IF-B)
 index (gn-sreg M 2) row (gn-sreg M 3) score (gn-sreg M 4)
 G (vector-alloc 33) ctx (gn-g M gn-f-ctx)
 m0 (-> M (gn-emit (enc-cmp-i index n)) (ri-cold G 8)
