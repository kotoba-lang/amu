(defn- shloop-sigma [M :vector-i64 f :i64] :bool
 (let [end (sc-admit M (gn-fnf M f FF-SIR) f 1) p (gn-fnf M f FF-SIR)]
  (and (> end 0) (= (gn-fnf M f FF-DEPTH) 3)
       (= (rr-calls M (+ p 2) end 0) 3)
       (= (sc-charge-count M (+ p 2) end 1) 4))))
(defn- shloop-unique [M :vector-i64 s :i64 k :i64] :bool
 (or (= k s) (and (not= (gn-sreg M k) (gn-sreg M s)) (shloop-unique M s (inc k)))))
(defn- shloop-regs [M :vector-i64 s :i64] :bool
 (if (= s 11) (and (= (gn-sreg M 11) -1) (= (gn-sreg M 12) -1)
  (= (gn-sreg M 13) -1) (= (gn-sreg M 14) -1) (= (gn-sreg M 15) -1))
  (and (>= (gn-sreg M s) 19) (<= (gn-sreg M s) 28)
   (shloop-unique M s 1) (shloop-regs M (inc s)))))
(defn- shloop-admit [M :vector-i64 i :i64] :i64
 (if (or (<= i 1) (>= (+ i 97) (vector-at M MM-SIR-N))
         (not= (gn-op M (dec i)) OP-FN)) 0
  (let [p (dec i) f (gn-sir M p IF-A)]
   (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
    (let [n (gn-sir M (+ p 4) IF-B) off (gn-sir M (+ p 49) IF-B)
          s0 (gn-sir M (+ p 59) IF-A) s1 (gn-sir M (+ p 42) IF-A)]
     (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 11)
       (= (gn-fnf M f FF-NSLOTS) 15) (= (gn-fnf M f FF-DEPTH) 11)
       (= (gn-fnf M f FF-RTYPE) TY-VEC)
       (loop [k 0] (or (= k 11) (and (= (ck-pt M f k) (if (< k 2) TY-VEC TY-I64)) (recur (inc k)))))
       (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (<= (gn-g M gn-f-vmode) 0)
       (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-ctx) 1)
       (>= n 1) (<= n 4096) (>= off 0) (<= off 4095)
       (> s0 0) (< s0 (vector-at M MM-FN-N)) (> s1 0) (< s1 (vector-at M MM-FN-N))
       (shloop-shape M p f 0) (shloop-regs M 1) (shloop-sigma M s0) (shloop-sigma M s1)
       (= (gn-scalar-mask M (+ p 56) (gn-sir M (+ p 56) IF-A) 1) 32)) n 0))))))
(defn- shloop-get [M :vector-i64 d :i64 s :i64] :vector-i64
 (if (>= (gn-sreg M s) 0) (gn-mov M d (gn-sreg M s)) (gn-ld M d s)))
(defn- shloop-put [M :vector-i64 d :i64 s :i64] :vector-i64
 (if (>= (gn-sreg M s) 0) (gn-mov M (gn-sreg M s) d) (gn-st M d s)))
(defn- shloop-scalar [M :vector-i64 f :i64 s :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1)]
  (-> M (shloop-get 9 s) (gn-emit (+ (enc-orr-r 10 9 9) 32768))
       (rr-emit (+ p 2) (dec end)))))
(defn- shloop-body [M :vector-i64 p :i64] :vector-i64
 (let [i (gn-sreg M 3) off (gn-sir M (+ p 49) IF-B)]
  (-> M
   (shloop-get 9 8) (shloop-get 10 9) (gn-emit (enc-and-r 9 9 10))
   (shloop-get 10 8) (gn-emit (enc-mvn 10 10)) (shloop-get 11 10)
   (gn-emit (enc-and-r 10 10 11)) (gn-emit (enc-eor-r 9 9 10)) (gn-st 9 12)
   (shloop-get 9 4) (shloop-get 10 5) (gn-emit (enc-and-r 9 9 10))
   (shloop-get 10 4) (shloop-get 11 6) (gn-emit (enc-and-r 10 10 11))
   (gn-emit (enc-eor-r 9 9 10)) (shloop-get 10 5) (shloop-get 11 6)
   (gn-emit (enc-and-r 10 10 11)) (gn-emit (enc-eor-r 9 9 10)) (gn-st 9 13)
   (shloop-scalar (gn-sir M (+ p 42) IF-A) 8)
   (shloop-get 9 11) (gn-emit (enc-add-r 0 0 9))
   (gn-emit (gn-e-ldrr 1 3 i 1)) (gn-emit (enc-add-i 9 i off))
   (gn-emit (gn-e-ldrr 2 4 9 1)) (gn-emit (enc-add-r 1 1 2))
   (gn-ld 2 12) (gn-emit (enc-add-r 1 1 2)) (gn-emit (enc-add-r 0 0 1))
   (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (gn-st 0 14)
   (shloop-scalar (gn-sir M (+ p 59) IF-A) 4) (gn-ld 1 13)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (gn-st 0 15)
   ;; Capture t1/t2 before updates; descending carry order preserves all inputs.
   (shloop-get 0 10) (shloop-put 0 11) (shloop-get 0 9) (shloop-put 0 10)
   (shloop-get 0 8) (shloop-put 0 9) (shloop-get 0 7) (gn-ld 1 14)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (shloop-put 0 8)
   (shloop-get 0 6) (shloop-put 0 7) (shloop-get 0 5) (shloop-put 0 6)
   (shloop-get 0 4) (shloop-put 0 5) (gn-ld 0 14) (gn-ld 1 15)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (shloop-put 0 4)
   (gn-emit (enc-add-i i i 1)))))
(defn- shloop-entry [M :vector-i64 i :i64] :vector-i64
 (let [n (shloop-admit M i)]
  (if (= n 0) M
   (let [p (dec i) ri (gn-sreg M 3) off (gn-sir M (+ p 49) IF-B)
         rv (gn-sreg M 1) rk (gn-sreg M 2) top (+ n off)
         m0 (-> M (gn-mov-imm 9 n) (gn-emit (enc-cmp-r ri 9))) b0 (vector-at m0 MM-CODE-N)
         m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-emit (enc-sub-r 9 9 ri)) (gn-mov-imm 10 9) (gn-emit (enc-mul 9 9 10))
          (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9))) b1 (vector-at m1 MM-CODE-N)
         m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
          (gn-emit (enc-sub-i 17 rk 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
         m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
          (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
          (gn-emit (enc-cmp-r 0 16))) b3 (vector-at m3 MM-CODE-N)
         m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-mov-imm 16 n) (gn-emit (enc-cmp-r 0 16))) b4 (vector-at m4 MM-CODE-N)
         m5 (-> m4 (gn-emit (enc-bcond (enc-cond-lo) 0))
          (gn-emit (enc-ldr 3 7 328)) (gn-emit (gn-e-addsl 3 3 17 3))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
          (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b5 (vector-at m5 MM-CODE-N)
         m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
          (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
          (gn-emit (enc-cmp-r 0 16))) b6 (vector-at m6 MM-CODE-N)
         m7 (-> m6 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-mov-imm 16 top) (gn-emit (enc-cmp-r 0 16))) b7 (vector-at m7 MM-CODE-N)
         m8 (-> m7 (gn-emit (enc-bcond (enc-cond-lo) 0))
          (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))
          (gn-emit (enc-sub-r 8 8 9)) (gn-emit (enc-str 8 7 CTX-FUEL))
          (shloop32-path p n ri)) loop-at (vector-at m8 MM-CODE-N)
         m9 (-> m8 (shloop-body p) (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16))) back (vector-at m9 MM-CODE-N)
         m10 (-> m9 (gn-emit (enc-bcond (enc-cond-ne) (- loop-at back)))
          (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0))) end (vector-at m10 MM-CODE-N)]
    (-> m10 (gn-dot-patch b0 end (enc-cond-hs)) (gn-dot-patch b1 end (enc-cond-lo))
      (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
      (gn-dot-patch b4 end (enc-cond-lo)) (gn-dot-patch b5 end (enc-cond-hs))
      (gn-dot-patch b6 end (enc-cond-hs)) (gn-dot-patch b7 end (enc-cond-lo)))))))

(defn- shloop32-emit [M :vector-i64 j :i64 end :i64] :vector-i64
 (if (= j end) M
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
   (shloop32-emit
    (case op
     OP-LABEL M
     OP-LGET (gn-mov M a (+ 8 b))
     OP-CONST (gn-mov-imm M a b)
     OP-BIN (gn-emit M (gn-bin-word a b b (inc b)))
     OP-UN (gn-emit M (enc-mvn b b))
     OP-CALL (gn-emit M (+ (enc-rrr 0x13800000 b 9 9)
                         (* (bit-and (gn-sir M (dec j) IF-B) 31) 1024)))
     OP-RET (gn-emit M (enc-ret))
     (gn-err M E-GEN-OP op)) (inc j) end))))
(defn- shloop32-scalar [M :vector-i64 f :i64 s :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1)]
  (shloop32-emit (shloop-get M 9 s) (+ p 2) (dec end))))
(defn- shloop32-body [M :vector-i64 p :i64] :vector-i64
 (let [i (gn-sreg M 3) off (gn-sir M (+ p 49) IF-B)]
  (-> M
   (shloop-get 9 8) (shloop-get 10 9) (gn-emit (enc-and-r 9 9 10))
   (shloop-get 10 8) (gn-emit (enc-mvn 10 10)) (shloop-get 11 10)
   (gn-emit (enc-and-r 10 10 11)) (gn-emit (enc-eor-r 9 9 10)) (gn-st 9 12)
   (shloop-get 9 4) (shloop-get 10 5) (gn-emit (enc-and-r 9 9 10))
   (shloop-get 10 4) (shloop-get 11 6) (gn-emit (enc-and-r 10 10 11))
   (gn-emit (enc-eor-r 9 9 10)) (shloop-get 10 5) (shloop-get 11 6)
   (gn-emit (enc-and-r 10 10 11)) (gn-emit (enc-eor-r 9 9 10)) (gn-st 9 13)
   (shloop32-scalar (gn-sir M (+ p 42) IF-A) 8)
   (shloop-get 9 11) (gn-emit (enc-add-r 0 0 9))
   (gn-emit (gn-e-ldrr 1 3 i 1)) (gn-emit (enc-add-i 9 i off))
   (gn-emit (gn-e-ldrr 2 4 9 1)) (gn-emit (enc-add-r 1 1 2))
   (gn-ld 2 12) (gn-emit (enc-add-r 1 1 2)) (gn-emit (enc-add-r 0 0 1))
   (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (gn-st 0 14)
   (shloop32-scalar (gn-sir M (+ p 59) IF-A) 4) (gn-ld 1 13)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (gn-st 0 15)
   ;; Capture t1/t2 before updates; descending carry order preserves all inputs.
   (shloop-get 0 10) (shloop-put 0 11) (shloop-get 0 9) (shloop-put 0 10)
   (shloop-get 0 8) (shloop-put 0 9) (shloop-get 0 7) (gn-ld 1 14)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (shloop-put 0 8)
   (shloop-get 0 6) (shloop-put 0 7) (shloop-get 0 5) (shloop-put 0 6)
   (shloop-get 0 4) (shloop-put 0 5) (gn-ld 0 14) (gn-ld 1 15)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (shloop-put 0 4)
   (gn-emit (enc-add-i i i 1)))))
(defn- sphase-counts [M :vector-i64] :bool
 (and (> (vector-at M MM-SIR-N) 0) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
      (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)
      (> (vector-at M MM-LABEL-N) 0) (< (vector-at M MM-LABEL-N) MM-LABEL-CAP)))
(defn- sphase-end [M :vector-i64 j :i64 f :i64 work :i64] :i64
 (if (or (<= work 0) (< j 0) (>= j (vector-at M MM-SIR-N))) 0
  (let [op (gn-op M j)]
   (cond (= op OP-END) (if (gn-dot-at? M j OP-END f 0 0) j 0)
         (= op OP-FN) 0
         :else (sphase-end M (inc j) f (dec work))))))
(defn- sphase-fn [M :vector-i64 f :i64] :i64
 (if (or (not (sphase-counts M)) (<= f 0) (>= f MM-FN-CAP)
         (>= f (vector-at M MM-FN-N))) 0
  (let [p (gn-fnf M f FF-SIR) np (gn-fnf M f FF-NPARAMS)]
   (if (or (<= p 0) (>= p (vector-at M MM-SIR-N))
           (>= (+ p 64) (vector-at M MM-SIR-N))
           (< np 1) (> np 2) (not= (gn-fnf M f FF-NSLOTS) np)
           (< (gn-fnf M f FF-DEPTH) 1) (> (gn-fnf M f FF-DEPTH) 5)
           (not= (gn-fnf M f FF-RTYPE) TY-I64)
           (not (gn-dot-at? M p OP-FN f np np))) 0
    (let [end (sphase-end M (inc p) f 64)]
     (if (and (> end p) (sr-types M f np) (not (gn-clamp-open M f))) end 0))))))
(defn- sphase-tree [M :vector-i64 f :i64 depth :i64] :bool
 (if (<= depth 0) false
  (let [end (sphase-fn M f)]
   (if (= end 0) false
    (let [p (gn-fnf M f FF-SIR) dp (gn-fnf M f FF-DEPTH)]
     (loop [j (inc p)]
      (if (= j end) true
       (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
        (and (case op
         OP-FUEL (and (= j (inc p)) (= a 0) (= b 0) (= c 0))
         OP-LABEL (and (= j (+ p (if (= (gn-op M (inc p)) OP-FUEL) 2 1)))
                       (> a 0) (< a (vector-at M MM-LABEL-N)) (= b 0) (= c 0))
         OP-LGET (and (>= a 0) (< a dp) (> b 0) (<= b (gn-fnf M f FF-NPARAMS)) (= c 0))
         OP-CONST (and (>= a 0) (< a dp) (= c 0))
         OP-BIN (and (di-bin a) (not= a BOP-QUOT) (>= b 0) (< (inc b) dp) (= c 0))
         OP-UN (and (= a UOP-BITNOT) (>= b 0) (< b dp) (= c 0))
         OP-CALL (and (>= b 0) (> c 0) (<= c 2) (<= (+ b c) dp)
                      (> (sphase-fn M a) 0) (= (gn-fnf M a FF-NPARAMS) c)
                      (sphase-tree M a (dec depth)))
         OP-RET (and (= j (dec end)) (= a 0) (= b 0) (= c 0))
         false) (recur (inc j)))))))))))
(defn- sphase-admit [M :vector-i64 p :i64 n :i64 ri :i64] :bool
 (if (or (not (sphase-counts M)) (<= p 0) (>= (+ p 98) (vector-at M MM-SIR-N))
         (not= (gn-op M p) OP-FN) (< n 4) (> n 4096)
         (< (vector-at M MM-CODE-N) 0) (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 4096))
         (< (vector-at M MM-FIX-N) 0) (> (vector-at M MM-FIX-N) (- MM-FIX-CAP 2))) false
  (let [f (gn-sir M p IF-A)]
   (if (or (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))) false
    (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 11)
     (= (gn-fnf M f FF-NSLOTS) 15) (= (gn-fnf M f FF-DEPTH) 11)
     (= (gn-fnf M f FF-RTYPE) TY-VEC)
     (loop [k 0] (or (= k 11) (and (= (ck-pt M f k) (if (< k 2) TY-VEC TY-I64)) (recur (inc k)))))
     (= n (gn-sir M (+ p 4) IF-B)) (= ri (gn-sreg M 3))
     (shloop-regs M 1)
     (sphase-tree M (gn-sir M (+ p 42) IF-A) 4)
     (sphase-tree M (gn-sir M (+ p 59) IF-A) 4)
     (sphase-tree M (gn-sir M (+ p 56) IF-A) 4)
     (sphase-tree M (gn-sir M (+ p 72) IF-A) 4)
     (sphase-tree M (gn-sir M (+ p 79) IF-A) 4)
     (let [h (gn-sir M (+ p 2) IF-A) b (gn-sir M (+ p 18) IF-A) e (gn-sir M (+ p 96) IF-A)]
      (and (> h 0) (< h (vector-at M MM-LABEL-N))
           (> b 0) (< b (vector-at M MM-LABEL-N))
           (> e 0) (< e (vector-at M MM-LABEL-N))
           (not= h b) (not= h e) (not= b e)))
     (shloop-shape M p f 0)
     (shloop-sigma M (gn-sir M (+ p 42) IF-A))
     (shloop-sigma M (gn-sir M (+ p 59) IF-A)))))))
(defn- sphase-reg [M :vector-i64 s :i64 phase :i64] :i64
 (let [base (if (< s 8) 4 8) slot (+ base (bit-and (- (- s base) phase) 3))]
  (if (= slot 11) 5 (gn-sreg M slot))))
(defn- foldror-mask [M :vector-i64 f :i64] :bool
 (let [end (sphase-fn M f)]
  (if (= end 0) false
   (let [p (gn-fnf M f FF-SIR) label (gn-sir M (inc p) IF-A)]
    (and (= end (+ p 6)) (= (gn-fnf M f FF-NPARAMS) 1)
     (= (gn-fnf M f FF-DEPTH) 2) (> label 0) (< label (vector-at M MM-LABEL-N))
     (gn-dot-at? M p OP-FN f 1 1) (gn-dot-at? M (inc p) OP-LABEL label 0 0)
     (gn-dot-at? M (+ p 2) OP-LGET 0 1 0)
     (gn-dot-at? M (+ p 3) OP-CONST 1 4294967295 0)
     (gn-dot-at? M (+ p 4) OP-BIN BOP-AND 0 0)
     (gn-dot-at? M (+ p 5) OP-RET 0 0 0))))))
(defn- foldror-leaf [M :vector-i64 f :i64] :bool
 (let [end (sphase-fn M f)]
  (if (= end 0) false
   (let [p (gn-fnf M f FF-SIR)]
    (if (not= end (+ p 14)) false
     (let [label (gn-sir M (+ p 2) IF-A) mask (gn-sir M (+ p 12) IF-A)]
      (and (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-DEPTH) 4)
       (> label 0) (< label (vector-at M MM-LABEL-N)) (foldror-mask M mask)
       (gn-dot-at? M p OP-FN f 2 2) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL label 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 5) OP-BIN BOP-USHR 0 0)
       (gn-dot-at? M (+ p 6) OP-LGET 1 1 0) (gn-dot-at? M (+ p 7) OP-CONST 2 32 0)
       (gn-dot-at? M (+ p 8) OP-LGET 3 2 0) (gn-dot-at? M (+ p 9) OP-BIN BOP-SUB 2 0)
       (gn-dot-at? M (+ p 10) OP-BIN BOP-SHL 1 0) (gn-dot-at? M (+ p 11) OP-BIN BOP-OR 0 0)
       (gn-dot-at? M (+ p 12) OP-CALL mask 0 1) (gn-dot-at? M (+ p 13) OP-RET 0 0 0))))))))
(defn- foldror-tree [M :vector-i64 f :i64] :bool
 (let [end (sphase-fn M f)]
  (if (= end 0) false
   (let [p (gn-fnf M f FF-SIR)]
    (if (not= end (+ p 15)) false
     (let [label (gn-sir M (+ p 2) IF-A)
           n0 (gn-sir M (+ p 4) IF-B) n1 (gn-sir M (+ p 7) IF-B) n2 (gn-sir M (+ p 11) IF-B)
           r0 (gn-sir M (+ p 5) IF-A) r1 (gn-sir M (+ p 8) IF-A) r2 (gn-sir M (+ p 12) IF-A)]
      (and (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-DEPTH) 3)
       (> label 0) (< label (vector-at M MM-LABEL-N))
       (>= n0 0) (<= n0 32) (>= n1 0) (<= n1 32) (>= n2 0) (<= n2 32)
       (foldror-leaf M r0) (foldror-leaf M r1) (foldror-leaf M r2)
       (gn-dot-at? M p OP-FN f 1 1) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL label 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-CONST 1 n0 0)
       (gn-dot-at? M (+ p 5) OP-CALL r0 0 2)
       (gn-dot-at? M (+ p 6) OP-LGET 1 1 0) (gn-dot-at? M (+ p 7) OP-CONST 2 n1 0)
       (gn-dot-at? M (+ p 8) OP-CALL r1 1 2) (gn-dot-at? M (+ p 9) OP-BIN BOP-XOR 0 0)
       (gn-dot-at? M (+ p 10) OP-LGET 1 1 0) (gn-dot-at? M (+ p 11) OP-CONST 2 n2 0)
       (gn-dot-at? M (+ p 12) OP-CALL r2 1 2) (gn-dot-at? M (+ p 13) OP-BIN BOP-XOR 0 0)
       (gn-dot-at? M (+ p 14) OP-RET 0 0 0))))))))
(defn- foldror-emit [M :vector-i64 f :i64 r :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) n0 (bit-and (gn-sir M (+ p 4) IF-B) 31)
       n1 (bit-and (gn-sir M (+ p 7) IF-B) 31) n2 (bit-and (gn-sir M (+ p 11) IF-B) 31)]
  (-> M (gn-emit (+ (enc-rrr 0x13800000 0 r r) (* n0 1024)))
   (gn-emit (+ (enc-rrr 0x4ac00000 0 0 r) (* n1 1024)))
   (gn-emit (+ (enc-rrr 0x4ac00000 0 0 r) (* n2 1024))))))
(defn- sphase-scalar [M :vector-i64 f :i64 r :i64] :vector-i64
 (if (and (or (= r 5) (and (>= r 19) (<= r 28))) (foldror-tree M f))
  (foldror-emit M f r)
  (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1)]
   (shloop32-emit (gn-mov M 9 r) (+ p 2) (dec end)))))
(defn- sphase-body [M :vector-i64 p :i64 phase :i64] :vector-i64
 (let [a (sphase-reg M 4 phase) b (sphase-reg M 5 phase)
       c (sphase-reg M 6 phase) d (sphase-reg M 7 phase)
       e (sphase-reg M 8 phase) f (sphase-reg M 9 phase)
       g (sphase-reg M 10 phase) h (sphase-reg M 11 phase)
       i (gn-sreg M 3) off (gn-sir M (+ p 49) IF-B)]
  (-> M
   (gn-emit (enc-and-r 6 e f)) (gn-emit (enc-rrr 0x8a200000 9 g e))
   (gn-emit (enc-eor-r 6 6 9))
   (gn-emit (enc-and-r 12 a b)) (gn-emit (enc-eor-r 9 a b))
   (gn-emit (enc-and-r 9 9 c))
   (gn-emit (enc-eor-r 12 12 9))
   (sphase-scalar (gn-sir M (+ p 42) IF-A) e)
   (gn-emit (enc-add-r 0 0 h))
   (gn-emit (gn-e-ldrr 1 3 i 1)) (gn-emit (enc-add-i 9 i off))
   (gn-emit (gn-e-ldrr 2 4 9 1)) (gn-emit (enc-add-r 1 1 2))
   (gn-emit (enc-add-r 1 1 6)) (gn-emit (enc-add-r 0 0 1))
   (gn-emit (gn-e-bf 0xd3400000 13 0 0 31))
   ;; Old h dies after t1; old d dies only after computing new e.
   (gn-emit (enc-add-r 0 d 13)) (gn-emit (gn-e-bf 0xd3400000 h 0 0 31))
   (sphase-scalar (gn-sir M (+ p 59) IF-A) a)
   (gn-emit (enc-rrr 0x0b000000 0 0 12))
   (gn-emit (enc-add-r 0 0 13)) (gn-emit (gn-e-bf 0xd3400000 d 0 0 31))
   (gn-emit (enc-add-i i i 1)))))
(defn- sphase-away [M :vector-i64 base :i64 key :bool G :vector-i64 k :i64] :vector-i64
 (let [m0 (-> M (gn-mov 9 base) (gn-emit (enc-cmp-r 9 base)))
       g0 (vector-assoc! G k (vector-at m0 MM-CODE-N))
       limit (gn-emit m0 (enc-bcond (enc-cond-lo) 0))
       ;; Full issued key backing <=128Mi i64 items. This address-only
       ;; envelope excludes spill aliases outside the current read interval.
       m1 (-> (if key (gn-mov-imm limit 16 134217728) (gn-mov limit 16 0))
          (gn-emit (gn-e-addsl 10 base 16 3)) (gn-emit (enc-cmp-r 10 9)))
       g1 (vector-assoc! g0 (inc k) (vector-at m1 MM-CODE-N))
       m2 (-> m1 (gn-emit (enc-bcond 9 0)) (gn-emit (enc-add-i 16 31 0))
          (gn-emit (enc-cmp-r 10 16)) (gn-emit (enc-bcond 9 4))
          (gn-emit (enc-add-i 11 29 48)) (gn-emit (enc-cmp-r 9 11)))
       g2 (vector-assoc! g1 (+ k 2) (vector-at m2 MM-CODE-N))]
  (gn-emit m2 (enc-bcond (enc-cond-lo) 0))))
(defn- sphase-away-patch [M :vector-i64 G :vector-i64 k :i64 end :i64] :vector-i64
 (if (= k 6) M
  (sphase-away-patch (gn-dot-patch M (vector-at G k) end (if (= (rem k 3) 1) 9 (enc-cond-lo))) G (inc k) end)))
(defn- sphase-path [M :vector-i64 p :i64 n :i64 ri :i64] :vector-i64
 (let [m0 (shloop-get M 9 4)
       m1 (loop [v m0 s 5] (if (= s 12) v
            (recur (-> v (shloop-get 10 s) (gn-emit (enc-orr-r 9 9 10))) (inc s))))
       m2 (-> m1 (gn-emit (gn-e-bf 0xd3400000 9 9 32 63)) (gn-emit (enc-cmp-i 9 0)))
       no32 (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-bcond (enc-cond-ne) 0))
       ;; x0 still holds the v descriptor length from original m7 preflight.
       ;; Exclude its whole backing: terminal finish may read beyond schedule.
       G (vector-alloc 6) ranges (-> m3 (sphase-away 3 true G 0)
                         (sphase-away 4 false G 3))
       m4 (gn-ld ranges 5 11) chunk (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-mov-imm 16 n) (gn-emit (enc-sub-r 16 16 ri)) (gn-emit (enc-cmp-i 16 4)))
       tail (vector-at m5 MM-CODE-N) m6 (gn-emit m5 (enc-bcond (enc-cond-lo) 0))
       m7 (-> m6 (sphase-body p 0) (sphase-body p 1) (sphase-body p 2) (sphase-body p 3))
       back (vector-at m7 MM-CODE-N) m8 (gn-emit m7 (enc-b (- chunk back)))
       tail-at (vector-at m8 MM-CODE-N)
       sync (gn-st m8 5 11) original-at (vector-at sync MM-CODE-N)
       m9 (-> sync (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16)))
       done (vector-at m9 MM-CODE-N) m10 (gn-emit m9 (enc-bcond (enc-cond-eq) 0))
       rest (vector-at m10 MM-CODE-N)
       m11 (-> m10 (shloop32-body p) (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16)))
       again (vector-at m11 MM-CODE-N)
       m12 (gn-emit m11 (enc-bcond (enc-cond-ne) (- rest again)))
       done-at (vector-at m12 MM-CODE-N)
       m13 (-> m12 (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)))
       end (vector-at m13 MM-CODE-N)]
  (-> m13 (sphase-away-patch G 0 original-at) (gn-dot-patch no32 end (enc-cond-ne))
      (gn-dot-patch tail tail-at (enc-cond-lo)) (gn-dot-patch done done-at (enc-cond-eq)))))
(defn- shloop32-path [M :vector-i64 p :i64 n :i64 ri :i64] :vector-i64
 (if (sphase-admit M p n ri) (sphase-path M p n ri)
 (let [m0 (shloop-get M 9 4)
       m1 (loop [v m0 s 5] (if (= s 12) v
            (recur (-> v (shloop-get 10 s) (gn-emit (enc-orr-r 9 9 10))) (inc s))))
       m2 (-> m1 (gn-emit (gn-e-bf 0xd3400000 9 9 32 63)) (gn-emit (enc-cmp-i 9 0)))
       no32 (vector-at m2 MM-CODE-N)
       m3 (gn-emit m2 (enc-bcond (enc-cond-ne) 0))
       start (vector-at m3 MM-CODE-N)
       m4 (-> m3 (shloop32-body p) (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16)))
       back (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-emit (enc-bcond (enc-cond-ne) (- start back)))
             (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)))
       end (vector-at m5 MM-CODE-N)]
  (gn-dot-patch m5 no32 end (enc-cond-ne)))))

(defn- rv-shape [M :vector-i64 p :i64 f :i64 fixed :i64 k :i64] :bool
 (if (= k 36) true (let [limit (gn-sir M (+ p 4) IF-B) base (gn-sir M (+ p 21) IF-B)
  reader (gn-sir M (+ p 19) IF-A)]
 (and (case k
  0 (gn-dot-at? M (+ p 0) 1 f 4 4)
  1 (gn-dot-at? M (+ p 1) 18 0 0 0)
  2 (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (gn-dot-at? M (+ p 3) 4 0 3 0)
  4 (if (= fixed 1) (gn-dot-at? M (+ p 4) OP-CONST 1 limit 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0))
  5 (gn-dot-at? M (+ p 5) 7 1 0 0)
  6 (gn-dot-at? M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
  7 (gn-dot-at? M (+ p 7) 4 0 4 0)
  8 (gn-dot-at? M (+ p 8) 10 (gn-sir M (+ p 33) IF-A) 0 0)
  9 (gn-dot-at? M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (gn-dot-at? M (+ p 10) 4 0 1 0)
  11 (gn-dot-at? M (+ p 11) 4 1 2 0)
  12 (gn-dot-at? M (+ p 12) 4 2 3 0)
  13 (gn-dot-at? M (+ p 13) 3 3 1 0)
  14 (gn-dot-at? M (+ p 14) 6 1 2 0)
  15 (gn-dot-at? M (+ p 15) 4 3 4 0)
  16 (gn-dot-at? M (+ p 16) 4 4 1 0)
  17 (gn-dot-at? M (+ p 17) 4 5 2 0)
  18 (gn-dot-at? M (+ p 18) 4 6 3 0)
  19 (gn-dot-at? M (+ p 19) 13 reader 4 3)
  20 (gn-dot-at? M (+ p 20) 4 5 1 0)
  21 (gn-dot-at? M (+ p 21) 3 6 base 0)
  22 (gn-dot-at? M (+ p 22) 4 7 3 0)
  23 (gn-dot-at? M (+ p 23) 6 1 6 0)
  24 (gn-dot-at? M (+ p 24) 14 176 5 2)
  25 (gn-dot-at? M (+ p 25) 6 3 4 0)
  26 (gn-dot-at? M (+ p 26) 6 2 3 0)
  27 (gn-dot-at? M (+ p 27) 5 1 0 0)
  28 (gn-dot-at? M (+ p 28) 5 2 1 0)
  29 (gn-dot-at? M (+ p 29) 5 3 2 0)
  30 (gn-dot-at? M (+ p 30) 5 4 3 0)
  31 (gn-dot-at? M (+ p 31) 18 0 0 0)
  32 (gn-dot-at? M (+ p 32) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  33 (gn-dot-at? M (+ p 33) 9 (gn-sir M (+ p 33) IF-A) 0 0)
  34 (gn-dot-at? M (+ p 34) 19 0 0 0)
  35 (gn-dot-at? M (+ p 35) 2 f 0 0)
 false) (rv-shape M p f fixed (inc k))))))
(defn- rv-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 3) true (let [o (case k 0 2 1 9 2 33 0) l (gn-sir M (+ p o) IF-A)]
  (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p o)) (rv-labels M p (inc k))))))
(defn- rv-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 36)) (not= (gn-op M p) OP-FN)) false
 (let [f (gn-sir M p IF-A) base (gn-sir M (+ p 21) IF-B) reader (gn-sir M (+ p 19) IF-A)
  fixed (if (= (gn-op M (+ p 4)) OP-CONST) 1 0) limit (gn-sir M (+ p 4) IF-B)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-NSLOTS) 4) (= (gn-fnf M f FF-DEPTH) 8)
  (= (gn-fnf M f FF-RTYPE) TY-I64) (= (gn-fnf M f FF-PT0) TY-VEC)
  (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
  (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
  (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
  (= (gn-g M gn-f-ns) 4) (= (gn-g M gn-f-dp) 8) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
  (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 4)
  (>= base 0) (<= base 4095) (or (= fixed 0) (and (>= limit 1) (<= limit 64)))
  (rv-shape M p f fixed 0) (rv-labels M p 0)
  (> reader 0) (< reader (vector-at M MM-FN-N))
  (> (gn-fnf M reader FF-SIR) 0) (<= (gn-fnf M reader FF-SIR) (- (vector-at M MM-SIR-N) 12))
  (> (mr-reader M (+ p 19) reader 3) 0)
  (= (gn-op M (inc (gn-fnf M reader FF-SIR))) OP-FUEL)
  (>= (gn-sir M (+ (mr-reader M (+ p 19) reader 3) 2) IF-B) 1)
  (<= (gn-sir M (+ (mr-reader M (+ p 19) reader 3) 2) IF-B) 4095)
  (let [a (gn-sreg M 1) b (gn-sreg M 2) c (gn-sreg M 3) d (gn-sreg M 4)]
   (and (>= a 19) (<= a 28) (>= b 19) (<= b 28) (>= c 19) (<= c 28) (>= d 19) (<= d 28)
    (not= a b) (not= a c) (not= a d) (not= b c) (not= b d) (not= c d))))))))
(defn- rv-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (rv-admit M i)) M
 (let [p (dec i) fixed (= (gn-op M (+ p 4)) OP-CONST) limit (gn-sir M (+ p 4) IF-B)
  base (gn-sir M (+ p 21) IF-B) reader (gn-sir M (+ p 19) IF-A)
  q (mr-reader M (+ p 19) reader 3) stride (gn-sir M (+ q 2) IF-B) G (vector-alloc 19)
