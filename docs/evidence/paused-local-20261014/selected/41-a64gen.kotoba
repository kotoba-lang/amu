  m17 (-> (gn-dot-patch m16 negative negative-at 8)
   (gn-put (+ MM-CODE-BASE retjump) (enc-b (- ret-at retjump))) (gn-epilogue) (gn-gs gn-f-dead 0) (gn-gs gn-f-ctx 0))
  cold-at (vector-at m17 MM-CODE-N)]
