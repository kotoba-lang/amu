;; seed/41-a64gen.kotoba -- SIR -> AArch64 code words (prefix gn-). Owner: 41-a64gen.
;; Contracts: seed/SIR (:opcodes, :runtime, :a64, :fixups), seed/MEMORY-MAP (SIR FN LIT read; CODE FIX LABEL
;; MM-CODE-N MM-FIX-N FF-CODE written; one HEAP block via mem-alloc, its base in M[MM-STAT-BASE+36] = M[100]).
;; Encoders: 40-a64enc (an encoder's -1 becomes E-ENC-IMM) plus the few forms below (gn-e-*).
;;
;; gn-run [M] -> M. Translates every SIR instruction 1 .. MM-SIR-N-1 in order. MM-R0 = number of code words.
;; CODE word index 1 is the first instruction (index 0 is the null record; byte offset of word i = 4*(i-1),
;; 42-layout's ly-first). Branch, call and literal operands are emitted with a zero immediate plus a FIX record;
;; 42-layout patches them (displacement = target word index - XF-AT).
;;
;; R2 (rung 2, 2026-10-02, performance; no new language, SIR unchanged): the R0/R1 mapping (every local in a frame
;; slot, temp k in x(9+k), every runtime operation a C call) is replaced by
;; - a PRESCAN of each function (gn-pre): frame needs, leafness, label positions, slot use counts weighted x8 per
;;   enclosing back-edge (loop) region;
;; - REGISTER ALLOCATION of locals: in a LEAF function (no guest call, no cap call, no string/vector literal, only
;;   inlined runtime operations) slot k <= 7 lives in x(k-1) (the params stay where they arrive) and x7 (context)
;;   is never clobbered; the remaining slots, ranked by weighted use, get the callee-saved x19..x28 (saved in the
;;   prologue); the rest stay in frame slots. A leaf with every value in registers has no frame at all;
;; - DEFERRED TEMPORARIES: each temp carries a descriptor (REG = in its place, CONST k, LOCAL slot = equal to that
;;   local, HOME = spilled around a call). CONST and LOCAL cost nothing until used, so operands fold into
;;   immediate forms (add/sub #imm12, shifts by #n, and/orr/eor with a contiguous run of ones, mul/quot by a
;;   constant, cmp #imm12) and constants FOLD (bin, cmp, un, branches on a constant). At every label and jump the
;;   live temps are materialized (the label state is "all REG"); a result that is stored straight into a local
;;   (op; LSET s t; t dead) is computed into the local's register (the LSET is skipped);
;; - BRANCHES: cmp (+ not) + brz/brnz fuse into cmp + b.cond when the temp is dead on both paths; a branch to a
;;   label followed by `brz t` (same t, same sense) or by `br` jumps to the final target (threading); code after
;;   an unconditional jump, ret or trap is not emitted until the next label;
;; - INLINE RUNTIME OPERATIONS through the ABI v9 context pointers (offsets 288-328), the same handle check the C
;;   twin and stage-0 (kotoba-native machine_ir a64-inline-runtime) perform, trapping with udf #0 (SIGILL):
;;   vector-at, vector-assoc!, vector-count, pair-first, pair-second (= string-length); vector literals store their
;;   items straight into the fresh vector after vector_alloc;
;; - FUEL: in a leaf the counter is held in x8 (loaded at entry, `subs x8,x8,#1 ; b.hs ; brk` per charge, stored
;;   back at ret); in other functions the R0 sequence on [x7,#8]. Charges are unchanged in number (T5).
;;
;; Frame (when present): stp x29,x30,[sp,#-16]! ; mov x29,sp ; sub sp,sp,#F. Slot k (0 = saved x7 in a non-leaf,
;; 1..NS locals that have no register, NS+1+t = home of temp t) is at [sp,#F-8*(k+1)]; the callee-saved registers
;; are saved at [sp,#0..]. F = 16-rounded 8*(NS+DP+2) + 16-rounded 8*nsaved <= 32768 (E-GEN-FRAME).
;; Temps: t < 7 in x(9+t) (home used across calls), t >= 7 in its home. x16/x17 are scratch.

;; ---- errors and emission --------------------------------------------------------------------------------------
(defn- gn-put [M :vector-i64 a :i64 w :i64] :vector-i64 (vector-assoc! M a w))
;; first error wins (rule L10)
(defn- gn-err [M :vector-i64 code :i64 n :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (-> M (gn-put MM-ERR code) (gn-put MM-ERR-POS -1) (gn-put MM-ERR-N n))
    M))

;; append one instruction word; w = -1 (an encoder refused an operand) -> E-ENC-IMM {n} = the code word index
(defn- gn-emit [M :vector-i64 w :i64] :vector-i64
  (let [n (vector-at M MM-CODE-N)]
    (cond (< w 0) (gn-err M E-ENC-IMM n)
          (>= n MM-CODE-CAP) (gn-err M E-GEN-FULL n)
          :else (-> M (gn-put (+ MM-CODE-BASE n) w) (gn-put MM-CODE-N (+ n 1))))))

;; a FIX record for the NEXT word to be emitted
(defn- gn-fix [M :vector-i64 kind :i64 target :i64] :vector-i64
  (let [n (vector-at M MM-FIX-N)
        at (vector-at M MM-CODE-N)
        b (+ MM-FIX-BASE (* n MM-FIX-W))]
    (if (>= n MM-FIX-CAP)
      (gn-err M E-GEN-FULL n)
      (-> M
          (gn-put (+ b XF-AT) at)
          (gn-put (+ b XF-KIND) kind)
          (gn-put (+ b XF-TARGET) target)
          (gn-put (+ b XF-AUX) 0)
          (gn-put MM-FIX-N (+ n 1))))))

;; ---- readers ---------------------------------------------------------------------------------------------------
(defn- gn-sir [M :vector-i64 i :i64 f :i64] :i64 (vector-at M (+ MM-SIR-BASE (* i MM-SIR-W) f)))
(defn- gn-op [M :vector-i64 i :i64] :i64 (vector-at M (+ MM-SIR-BASE (* i MM-SIR-W))))
(defn- gn-fnf [M :vector-i64 f :i64 fld :i64] :i64 (vector-at M (+ MM-FN-BASE (* f MM-FN-W) fld)))
(defn- gn-litf [M :vector-i64 l :i64 fld :i64] :i64 (vector-at M (+ MM-LIT-BASE (* l MM-LIT-W) fld)))
(defn- gn-max [a :i64 b :i64] :i64 (if (> a b) a b))
(defn- gn-min [a :i64 b :i64] :i64 (if (< a b) a b))
(defn- gn-r16 [x :i64] :i64 (bit-and (+ x 15) -16))

;; ---- extra encoders (forms 40-a64enc does not have) ----------------------------------------------------------------
;; R4 rung proof: each encoder binds a field placer as a KNOWN let-bound fn literal (called directly, no closure built);
;; (fld x w s) = (x & w) << s, the register fields with w = 31, the 6-bit immediates with w = 63
;; R6B rung proof: the base words are hex literals (10-lex) and the forms carry docstrings (20-names reads them on the
;; single-module route); the values are the decimal words of R6A, so the code is unchanged.
(defn- gn-e-addsl
  "add xd, xn, xm, lsl #sh"
  [d :i64 n :i64 m :i64 sh :i64] :i64
  (let [fld (fn [x w s] (i64-shift-left (bit-and x w) s))]
    (+ 0x8b000000 (fld m 31 16) (fld sh 63 10) (fld n 31 5) (bit-and d 31))))
(defn- gn-e-ldrr
  "ldr xt, [xn, xm] (sc = 0) / [xn, xm, lsl #3] (sc = 1)"
  [t :i64 n :i64 m :i64 sc :i64] :i64
  (let [reg (fn [x s] (i64-shift-left (bit-and x 31) s))]
    (+ (if (= sc 1) 0xf8607800 0xf8606800) (reg m 16) (reg n 5) (bit-and t 31))))
(defn- gn-e-strr3
  "str xt, [xn, xm, lsl #3]"
  [t :i64 n :i64 m :i64] :i64
  (let [reg (fn [x s] (i64-shift-left (bit-and x 31) s))]
    (+ 0xf8207800 (reg m 16) (reg n 5) (bit-and t 31))))
(defn- gn-e-bf
  "bitfield and logical-immediate forms: base + immr<<16 + imms<<10 + n<<5 + d (N = 1, 64-bit element)"
  [base :i64 d :i64 n :i64 immr :i64 imms :i64] :i64
  (let [fld (fn [x w s] (i64-shift-left (bit-and x w) s))]
    (+ base (fld immr 63 16) (fld imms 63 10) (fld n 31 5) (bit-and d 31))))
;; lsl #s = ubfm d,n,#(-s mod 64),#(63-s) ; lsr #s = ubfm d,n,#s,#63 ; asr #s = sbfm d,n,#s,#63
(defn- gn-e-lsl [d :i64 n :i64 s :i64] :i64 (gn-e-bf 0xd3400000 d n (bit-and (- 64 s) 63) (- 63 s)))
(defn- gn-e-lsr [d :i64 n :i64 s :i64] :i64 (gn-e-bf 0xd3400000 d n s 63))
(defn- gn-e-asr [d :i64 n :i64 s :i64] :i64 (gn-e-bf 0x93400000 d n s 63))
(defn- gn-e-udf [] :i64 0)
(defn- gn-e-ldrb
  "ldrb wt, [xn, xm]"
  [t :i64 n :i64 m :i64] :i64
  (let [reg (fn [x s] (i64-shift-left (bit-and x 31) s))]
    (+ 0x38606800 (reg m 16) (reg n 5) (bit-and t 31))))
(defn- gn-e-adr
  "R4: adr xd, #0 (immhi/immlo patched by 42-layout, FX-ADR19)"
  [d :i64] :i64 (+ 0x10000000 (bit-and d 31)))

;; ---- the generator state G: a HEAP block, base in M[gn-cell] ------------------------------------------------------
(def gn-cell 100)
(def gn-f-leaf 0)     ; 1 = leaf function
(def gn-f-fuel 1)     ; 1 = the function has FUEL instructions
(def gn-f-nsv 2)      ; callee-saved registers used (x19 ..)
(def gn-f-fb 3)       ; frame bytes F (0 = no frame)
(def gn-f-ns 4)       ; NS: local slots
(def gn-f-dp 5)       ; DP: temps
(def gn-f-h 6)        ; stack height: temps 0 .. h-1 may be live
(def gn-f-ctx 7)      ; 1 = x7 holds the context
(def gn-f-vmode 8)    ; experimental descriptor cache mode; unused original state cell
(def gn-f-vslot 13) ; compile-time dominated stable-local descriptor witness
(def gn-f-dead 9)     ; 1 = the current point is unreachable (after br/ret/trap, until a label)
(def gn-f-skip 10)    ; SIR instructions after the current one that it consumed
(def gn-f-freg 11)    ; 1 = the fuel counter is in x8
(def gn-f-out 12)     ; R4B: bytes of the outgoing argument area at [sp,#0..] (calls with more than 7 arguments)
(def gn-cap 4096)     ; slots and temps per function (the frame limit F <= 32768 is lower)
(def gn-a-sreg 16)    ; slot -> register + 1 (0 = frame slot); gn-cap words
(def gn-a-use 4112)   ; slot -> weighted use count; gn-cap words
(def gn-a-dk 8208)    ; temp -> descriptor kind; gn-cap words
(def gn-a-dv 12304)   ; temp -> descriptor value; gn-cap words
(def gn-a-lp 16400)   ; label -> SIR index of its LABEL in the current function; MM-LABEL-CAP words
(def gn-g-open (+ gn-a-lp MM-LABEL-CAP)) ; module-wide first replaceable import FN (outside per-function reset)
(def gn-g-open-n (inc gn-g-open))       ; number of replaceable import FNs
(def cc-proof (+ gn-g-open 82)) ; after DAG banks and both index-witness cells
(def di-const-mask (+ gn-g-open 83)) ; compiler-private, outside both snapshot banks
(def di-const-base (+ gn-g-open 84)) ; five call-edge scalar values, slots1..5
(def gn-k-reg 1)
(def gn-k-const 2)
(def gn-k-local 3)
(def gn-k-home 4)
(def gn-k-lit 5)      ; a string literal whose only reader is string-length or string-code-point-at (no pair)

(defn- gn-g [M :vector-i64 f :i64] :i64 (vector-at M (+ (vector-at M gn-cell) f)))
(defn- gn-gs [M :vector-i64 f :i64 v :i64] :vector-i64 (gn-put M (+ (vector-at M gn-cell) f) v))
(defn- gn-gmax [M :vector-i64 f :i64 v :i64] :vector-i64 (if (> v (gn-g M f)) (gn-gs M f v) M))
(defn- gn-zero [M :vector-i64 i :i64 k :i64] :vector-i64 (if (>= i k) M (gn-zero (gn-gs M i 0) (inc i) k)))

(defn- gn-dk [M :vector-i64 t :i64] :i64 (gn-g M (+ gn-a-dk t)))
(defn- gn-dv [M :vector-i64 t :i64] :i64 (gn-g M (+ gn-a-dv t)))
(defn- gn-dset [M :vector-i64 t :i64 k :i64 v :i64] :vector-i64 (-> M (gn-gs (+ gn-a-dk t) k) (gn-gs (+ gn-a-dv t) v)))
;; temp t := (k, v) and the height becomes t+1
(defn- gn-def [M :vector-i64 t :i64 k :i64 v :i64] :vector-i64 (-> M (gn-dset t k v) (gn-gs gn-f-h (inc t))))
(defn- gn-isk [M :vector-i64 t :i64 k :i64] :bool (= (gn-dk M t) k))
;; register of local slot s, -1 = frame slot
(defn- gn-sreg [M :vector-i64 s :i64] :i64 (dec (gn-g M (+ gn-a-sreg s))))
(defn- gn-lpos [M :vector-i64 l :i64] :i64 (if (and (> l 0) (< l MM-LABEL-CAP)) (gn-g M (+ gn-a-lp l)) 0))

;; ---- frame slots ----------------------------------------------------------------------------------------------------
(defn- gn-soff [M :vector-i64 k :i64] :i64 (- (gn-g M gn-f-fb) (* 8 (inc k))))
(defn- gn-home [M :vector-i64 t :i64] :i64 (+ (gn-g M gn-f-ns) 1 t))
(defn- gn-ld [M :vector-i64 r :i64 k :i64] :vector-i64 (gn-emit M (enc-ldr r 31 (gn-soff M k))))
(defn- gn-st [M :vector-i64 r :i64 k :i64] :vector-i64 (gn-emit M (enc-str r 31 (gn-soff M k))))
(defn- gn-mov [M :vector-i64 d :i64 s :i64] :vector-i64 (if (= d s) M (gn-emit M (enc-mov-r d s))))

;; ---- constants --------------------------------------------------------------------------------------------------
(defn- gn-hw [k :i64 i :i64] :i64 (bit-and (u64-shift-right k (* 16 i)) 65535))
;; number of halfwords i..3 of k equal to v
(defn- gn-cnt [k :i64 v :i64 i :i64] :i64
  (if (> i 3) 0 (+ (if (= (gn-hw k i) v) 1 0) (gn-cnt k v (+ i 1)))))
(defn- gn-first-not [k :i64 v :i64 i :i64] :i64
  (cond (> i 3) 0
        (not= (gn-hw k i) v) i
        (= i 3) 0
        :else (gn-first-not k v (+ i 1))))
;; movk every halfword i..3 of k that differs from v
(defn- gn-movks [M :vector-i64 d :i64 k :i64 v :i64 i :i64] :vector-i64
  (cond (> i 3) M
        (= (gn-hw k i) v) (gn-movks M d k v (+ i 1))
        :else (gn-movks (gn-emit M (enc-movk d (gn-hw k i) i)) d k v (+ i 1))))
;; register d := k (movz + movk, or movn + movk when more halfwords are 0xffff than 0)
(defn- gn-mov-imm [M :vector-i64 d :i64 k :i64] :vector-i64
  (if (> (gn-cnt k 65535 0) (gn-cnt k 0 0))
    (let [i (gn-first-not k 65535 0)]
      (-> M (gn-emit (enc-movn d (bit-xor (gn-hw k i) 65535) i)) (gn-movks d k 65535 (+ i 1))))
    (let [i (gn-first-not k 0 0)]
      (-> M (gn-emit (enc-movz d (gn-hw k i) i)) (gn-movks d k 0 (+ i 1))))))

;; trailing zero bits of k (k != 0)
(defn- gn-tz [k :i64 n :i64] :i64 (if (or (>= n 63) (= (bit-and k 1) 1)) n (gn-tz (u64-shift-right k 1) (inc n))))
;; k is one contiguous run of ones (not 0, not -1): its length, else 0
(defn- gn-run-len [k :i64] :i64
  (if (or (= k 0) (= k -1))
    0
    (let [s (u64-shift-right k (gn-tz k 0))]
      (if (= (bit-and s (+ s 1)) 0) (gn-tz (bit-not s) 0) 0))))
;; k = 2^p, 1 <= p <= 62: p, else 0
(defn- gn-pow2 [k :i64] :i64
  (if (and (> k 1) (= (bit-and k (- k 1)) 0)) (gn-tz k 0) 0))

;; ---- temps: descriptors -> registers --------------------------------------------------------------------------------
;; the register that holds temp t now, or -1 when it must first be loaded into a scratch; z = 1: a CONST 0 may be
;; read as xzr (only for operand positions where register 31 means xzr)
(defn- gn-sr [M :vector-i64 t :i64 z :i64] :i64
  (let [k (gn-dk M t)
        v (gn-dv M t)]
    (cond (= k gn-k-const) (if (and (= z 1) (= v 0)) 31 -1)
          (= k gn-k-local) (gn-sreg M v)
          (= k gn-k-home) -1
          (< t 7) (+ 9 t)
          :else -1)))
(defn- gn-src [M :vector-i64 t :i64 s :i64 z :i64] :i64 (let [r (gn-sr M t z)] (if (< r 0) s r)))
;; load temp t into scratch s when gn-sr is -1
(defn- gn-ldt [M :vector-i64 t :i64 s :i64 z :i64] :vector-i64
  (if (>= (gn-sr M t z) 0)
    M
    (let [k (gn-dk M t)
          v (gn-dv M t)]
      (cond (= k gn-k-const) (gn-mov-imm M s v)
            (= k gn-k-local) (gn-ld M s v)
            (= k gn-k-lit) (gn-err M E-GEN-OP OP-STR)
            :else (gn-ld M s (gn-home M t))))))
;; register r := temp t
(defn- gn-into [M :vector-i64 r :i64 t :i64] :vector-i64
  (let [q (gn-sr M t 1)]
    (if (>= q 0) (gn-mov M r q) (gn-ldt M t r 1))))
;; put temp t in its canonical place (x(9+t), or its home for t >= 7) and mark it REG
(defn- gn-mat [M :vector-i64 t :i64] :vector-i64
  (let [k (gn-dk M t)]
    (cond (or (= k 0) (= k gn-k-reg)) M
          (< t 7) (-> M (gn-into (+ 9 t) t) (gn-dset t gn-k-reg 0))
          :else (let [q (gn-sr M t 1)
                      h (gn-home M t)]
                  (if (>= q 0)
                    (-> M (gn-st q h) (gn-dset t gn-k-reg 0))
                    (-> M (gn-ldt t 16 1) (gn-st 16 h) (gn-dset t gn-k-reg 0)))))))
(defn- gn-flush [M :vector-i64 i :i64 k :i64] :vector-i64 (if (>= i k) M (gn-flush (gn-mat M i) (inc i) k)))
(defn- gn-allreg [M :vector-i64 i :i64 k :i64] :vector-i64
  (if (>= i k) M (gn-allreg (gn-dset M i gn-k-reg 0) (inc i) k)))
;; materialize temps lo..hi-1 other than x whose value is "local s" (before s is written)
(defn- gn-prot [M :vector-i64 lo :i64 hi :i64 x :i64 s :i64] :vector-i64
  (cond (>= lo hi) M
        (and (not= lo x) (gn-isk M lo gn-k-local) (= (gn-dv M lo) s)) (gn-prot (gn-mat M lo) (inc lo) hi x s)
        :else (gn-prot M (inc lo) hi x s)))
;; save the register temps i..k-1 (k <= 7) to their homes before a call
(defn- gn-save [M :vector-i64 i :i64 k :i64] :vector-i64
  (cond (>= i (gn-min k 7)) M
        (or (= (gn-dk M i) 0) (gn-isk M i gn-k-reg)) (gn-save (-> M (gn-st (+ 9 i) (gn-home M i)) (gn-dset i gn-k-home 0)) (inc i) k)
        :else (gn-save M (inc i) k)))
;; Save only canonical low temp registers that a certified inline emitter clobbers.
;; Like gn-save, LOCAL/CONST/HOME descriptors remain in their original places.
;; Callers must separately prove callee-saved locals and higher home temps survive.
(defn- gn-save-clobbered [M :vector-i64 i :i64 k :i64 clobbered :i64] :vector-i64
 (cond (>= i (gn-min k 7)) M
       (and (not= (bit-and clobbered (i64-shift-left 1 (+ 9 i))) 0)
            (or (= (gn-dk M i) 0) (gn-isk M i gn-k-reg)))
        (gn-save-clobbered (-> M (gn-st (+ 9 i) (gn-home M i)) (gn-dset i gn-k-home 0)) (inc i) k clobbered)
       :else (gn-save-clobbered M (inc i) k clobbered)))
;; temp t lives in a register that no inline sequence clobbers (x9.., a local's register), else -1
(defn- gn-pinned [M :vector-i64 t :i64] :i64
  (let [r (gn-sr M t 0)] (if (or (< r 0) (= r 16) (= r 17)) -1 r)))
(defn- gn-pin [M :vector-i64 t :i64] :vector-i64 (if (>= (gn-pinned M t) 0) M (gn-mat M t)))
;; x7 := the context (from slot 0) unless it is known to hold it
(defn- gn-ctx [M :vector-i64] :vector-i64
  (if (= (gn-g M gn-f-ctx) 1) M (-> M (gn-ld 7 0) (gn-gs gn-f-ctx 1))))

;; ---- liveness over straight-line SIR ----------------------------------------------------------------------------
(defn- gn-skiplab [M :vector-i64 j :i64] :i64 (if (= (gn-op M j) OP-LABEL) (gn-skiplab M (inc j)) j))
;; lowest / highest temp read by instruction j (lo > hi: none), and the temp it defines (-1: none)
(defn- gn-rlo [M :vector-i64 j :i64] :i64
  (let [op (gn-op M j)]
    (case op
      (OP-BIN OP-CMP OP-UN OP-LSET OP-CALL OP-RT OP-CALLI) (gn-sir M j IF-B)
      (OP-TAB OP-VEC OP-BRZ OP-BRNZ OP-RET OP-RET2) (gn-sir M j IF-A)
      OP-CAP (gn-sir M j IF-C)
      1)))
(defn- gn-rhi [M :vector-i64 j :i64] :i64
  (let [op (gn-op M j)
        a (gn-sir M j IF-A)
        b (gn-sir M j IF-B)
        c (gn-sir M j IF-C)]
    (case op
      (OP-BIN OP-CMP) (inc b)
      (OP-UN OP-LSET) b
      (OP-CALL OP-RT) (dec (+ b c))
      OP-CALLI (+ b c)
      OP-VEC (dec (+ a b))
      (OP-TAB OP-BRZ OP-BRNZ OP-RET) a
      OP-RET2 (inc a)   ; R5B
      OP-CAP c
      0)))
(defn- gn-defd [M :vector-i64 j :i64] :i64
  (let [op (gn-op M j)]
    (case op
      (OP-CONST OP-LGET OP-STR OP-TAB OP-VEC OP-FADDR OP-VECP OP-RES2) (gn-sir M j IF-A)
      (OP-BIN OP-CMP OP-UN OP-CALL OP-RT OP-CALLI) (gn-sir M j IF-B)
      OP-CAP (gn-sir M j IF-C)
      -1)))
;; true when the path from instruction j writes temp t (or a lower temp) before reading it, within n steps
(defn- gn-kills [M :vector-i64 j :i64 t :i64 n :i64] :bool
  (let [op (gn-op M j)
        d (gn-defd M j)]
    (cond (<= n 0) false
          (>= j (vector-at M MM-SIR-N)) false
          (or (= op OP-END) (= op OP-TRAP)) true
          (= op OP-RET) (not= (gn-sir M j IF-A) t)
          (= op OP-RET2) (and (not= (gn-sir M j IF-A) t) (not= (inc (gn-sir M j IF-A)) t))   ; R5B
          (= op OP-BR) (let [p (gn-lpos M (gn-sir M j IF-A))] (and (> p 0) (gn-kills M (inc p) t (dec n))))
          (or (= op OP-BRZ) (= op OP-BRNZ)) false
          (and (<= (gn-rlo M j) t) (<= t (gn-rhi M j))) false
          (and (>= d 0) (<= d t)) true
          :else (gn-kills M (inc j) t (dec n)))))
;; temp t is dead at label l (unknown label: live)
(defn- gn-dead-at [M :vector-i64 l :i64 t :i64] :bool
  (let [p (gn-lpos M l)] (and (> p 0) (gn-kills M (inc p) t 16))))
;; the first reader of temp t from instruction j on in straight-line code (n steps): its index, 0 = none or unknown
(defn- gn-reader [M :vector-i64 j :i64 t :i64 n :i64] :i64
  (let [op (gn-op M j)
        d (gn-defd M j)]
    (cond (or (<= n 0) (>= j (vector-at M MM-SIR-N))) 0
          (or (= op OP-LABEL) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ) (= op OP-RET) (= op OP-RET2) (= op OP-END) (= op OP-TRAP) (= op OP-FN)) 0
          (and (<= (gn-rlo M j) t) (<= t (gn-rhi M j))) j
          (and (>= d 0) (<= d t)) 0
          :else (gn-reader M (inc j) t (dec n)))))
(defn- gn-ascii [M :vector-i64 b :i64 k :i64 n :i64] :bool
  (cond (>= k n) true
        (> (vector-at M (+ MM-LITB-BASE b k)) 127) false
        :else (gn-ascii M b (inc k) n)))
;; STR at j needs no pair when its only reader k is string-length, or string-code-point-at over an ASCII literal: k, else 0
(defn- gn-str-fold [M :vector-i64 j :i64] :i64
  (let [t (gn-sir M j IF-A)
        lit (gn-sir M j IF-B)
        k (gn-reader M (inc j) t 64)
        slot (gn-sir M k IF-A)
        n (gn-sir M k IF-C)]
    (if (and (> k 0) (= (gn-op M k) OP-RT) (= (gn-sir M k IF-B) t)
             (or (and (= slot RT-PAIR-SECOND) (= n 1))
                 (and (= slot RT-STRING-CODE-POINT-AT) (= n 2) (<= t 5)
                      (gn-ascii M (gn-litf M lit LF-B) 0 (gn-litf M lit LF-LEN)))))
      k
      0)))
;; the folded STR whose reader is the RT at k (operand temp t), else 0
(defn- gn-back-str [M :vector-i64 k :i64 j :i64 t :i64] :i64
  (let [op (gn-op M j)
        d (gn-defd M j)]
    (cond (or (<= j 0) (< j (- k 64))) 0
          (or (= op OP-LABEL) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ) (= op OP-RET) (= op OP-RET2) (= op OP-END) (= op OP-TRAP) (= op OP-FN)) 0
          (= d t) (if (and (= op OP-STR) (= (gn-str-fold M j) k)) j 0)
          (and (>= d 0) (< d t)) 0
          :else (gn-back-str M k (dec j) t))))
;; final target of a jump to label l: through `br` chains, and through `brz t` (nz = 0) / `brnz t` (nz = 1) that the
;; same value of t takes again (nz = 2: br only)
(defn- gn-thread [M :vector-i64 l :i64 t :i64 nz :i64 n :i64] :i64
  (let [p (gn-lpos M l)]
    (if (or (<= n 0) (<= p 0))
      l
      (let [j (gn-skiplab M (inc p))
            op (gn-op M j)
            want (cond (= nz 0) OP-BRZ (= nz 1) OP-BRNZ :else -1)]
        (cond (= op OP-BR) (gn-thread M (gn-sir M j IF-A) t nz (dec n))
              (and (= op want) (= (gn-sir M j IF-A) t)) (gn-thread M (gn-sir M j IF-B) t nz (dec n))
              :else l)))))
;; the live height at label l: h lowered while the top temp is dead there
(defn- gn-live-at [M :vector-i64 h :i64 l :i64] :i64
  (if (and (> h 0) (gn-dead-at M l (dec h))) (gn-live-at M (dec h) l) h))
;; before a jump to l at height h: materialize the temps that are live at l
(defn- gn-jflush [M :vector-i64 h :i64 l :i64] :vector-i64 (gn-flush M 0 (gn-live-at M h l)))

;; ---- results: "op i computes temp t" -----------------------------------------------------------------------------
;; the local slot the result can be written to directly (op i; LSET s t; t dead afterwards; s in a register), else 0
(defn- gn-co [M :vector-i64 i :i64 t :i64] :i64
  (let [j (inc i)
        s (gn-sir M j IF-A)]
    (if (and (= (gn-op M j) OP-LSET) (= (gn-sir M j IF-B) t) (>= (gn-sreg M s) 0) (gn-kills M (inc j) t 16)) s 0)))
;; destination register: the local's (s > 0), x(9+t), or x16 for a temp in its home
(defn- gn-dreg [M :vector-i64 t :i64 s :i64] :i64 (cond (> s 0) (gn-sreg M s) (< t 7) (+ 9 t) :else 16))
(defn- gn-protect [M :vector-i64 t :i64 s :i64] :vector-i64 (if (> s 0) (gn-prot M 0 t t s) M))
;; the result is in register d: record it (and skip the LSET that was folded in)
(defn- gn-fin [M :vector-i64 t :i64 s :i64 d :i64] :vector-i64
 (gn-fin-quiet (gn-vdrop M s) t s d))
(defn- gn-fin-quiet [M :vector-i64 t :i64 s :i64 d :i64] :vector-i64
  (cond (> s 0) (-> M (gn-def t gn-k-local s) (gn-gs gn-f-skip 1))
        (>= t 7) (-> M (gn-st d (gn-home M t)) (gn-def t gn-k-reg 0))
        :else (gn-def M t gn-k-reg 0)))
;; the result of a call is in register r
(defn- gn-take [M :vector-i64 i :i64 t :i64 r :i64] :vector-i64
  (let [s (gn-co M i t)
        d (if (and (= s 0) (>= t 7)) r (gn-dreg M t s))]
    (-> M (gn-protect t s) (gn-mov d r) (gn-fin t s d))))

;; ---- prescan of one function ------------------------------------------------------------------------------------
;; temps needed by SIR instruction i (0 when it names none)
(defn- gn-need-t [M :vector-i64 i :i64] :i64
  (let [a (gn-sir M i IF-A)
        b (gn-sir M i IF-B)
        c (gn-sir M i IF-C)]
    (case (gn-op M i)
      (OP-CONST OP-LGET OP-STR OP-RET OP-BRZ OP-BRNZ OP-TAB OP-FADDR OP-VECP OP-RES2) (+ a 1)
      OP-RET2 (+ a 2)   ; R5B
      (OP-LSET OP-UN) (+ b 1)
      (OP-BIN OP-CMP) (+ b 2)
      OP-CAP (+ c 1)
      (OP-CALL OP-RT) (+ b (gn-max c 1))
      OP-CALLI (+ b c 1)
      OP-VEC (+ a (gn-max b 1))
      0)))
;; highest local slot named by SIR instruction i
(defn- gn-need-s [M :vector-i64 i :i64] :i64
  (case (gn-op M i)
    OP-LGET (gn-sir M i IF-B)
    OP-LSET (gn-sir M i IF-A)
    0))
;; runtime operations emitted in line (and the temps they need in x9..x15)
(defn- gn-inl [slot :i64 t :i64 n :i64] :bool
  (cond (= slot RT-VECTOR-AT) (and (= n 2) (<= t 5))
        (= slot RT-VECTOR-ASSOC-IN-PLACE) (and (= n 3) (<= t 4))
        (or (= slot RT-PAIR-FIRST) (= slot RT-PAIR-SECOND) (= slot RT-VECTOR-COUNT)) (= n 1)
        :else false))
;; Exact straight-line wrappers only: optional entry FUEL/LABEL, natural
;; parameter loads, one already-inlined runtime operation (or identity), RET.
;; No source names or benchmark-specific decisions. 256 encodes entry fuel.
(defn- gn-wparams [M :vector-i64 j :i64 k :i64 n :i64] :i64
  (cond (= k n) j
        (and (= (gn-op M j) OP-LGET) (= (gn-sir M j IF-A) k) (= (gn-sir M j IF-B) (inc k)))
        (gn-wparams M (inc j) (inc k) n)
        :else 0))
(defn- gn-wrapper [M :vector-i64 f :i64 t :i64 n :i64] :i64
  (let [p (gn-fnf M f FF-SIR)]
    (if (or (< p 1) (< n 1) (> n 3) (not= (gn-op M p) OP-FN) (not= (gn-sir M p IF-A) f) (not= (gn-sir M p IF-B) n))
      0
      (let [fuel (if (= (gn-op M (inc p)) OP-FUEL) 256 0)
            q (gn-skiplab M (+ p 1 (if (> fuel 0) 1 0)))
            j (gn-wparams M q 0 n)
            rt (= (gn-op M j) OP-RT)
            slot (if rt (gn-sir M j IF-A) 1)
            ret (if rt (inc j) j)]
        (if (and (> j 0) (= (gn-op M ret) OP-RET) (= (gn-sir M ret IF-A) 0) (= (gn-op M (inc ret)) OP-END)
                 (if rt (and (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) n) (gn-inl slot t n)) (= n 1)))
          (+ slot fuel)
          0)))))
;; Exact scalar sign-extension decision tree: mask, local, signed >= half,
;; subtract modulus on the high half, join and return. Width 1..32 only.
;; Token 1024 + width; bit 9 records the original optional entry fuel.
(defn- gn-sign-wrapper [M :vector-i64 f :i64 n :i64] :i64
  (let [p (gn-fnf M f FF-SIR)]
    (if (or (< p 1) (not= n 1) (not= (gn-op M p) OP-FN)
            (not= (gn-sir M p IF-A) f) (not= (gn-sir M p IF-B) 1)) 0
      (let [fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
            q (gn-skiplab M (+ p 1 fuel)) mask (gn-sir M (inc q) IF-B)
            half (quot (inc mask) 2) slot (gn-sir M (+ q 3) IF-A)
            le (gn-sir M (+ q 7) IF-B) lx (gn-sir M (+ q 11) IF-A)]
        (if (and (> mask 0) (<= mask 4294967295) (= (bit-and mask (inc mask)) 0)
                 (= (gn-op M q) OP-LGET) (= (gn-sir M q IF-A) 0) (= (gn-sir M q IF-B) 1)
                 (= (gn-op M (inc q)) OP-CONST) (= (gn-sir M (inc q) IF-A) 1)
                 (= (gn-op M (+ q 2)) OP-BIN) (= (gn-sir M (+ q 2) IF-A) BOP-AND) (= (gn-sir M (+ q 2) IF-B) 0)
                 (= (gn-op M (+ q 3)) OP-LSET) (> slot 1) (= (gn-sir M (+ q 3) IF-B) 0)
                 (= (gn-op M (+ q 4)) OP-LGET) (= (gn-sir M (+ q 4) IF-A) 0) (= (gn-sir M (+ q 4) IF-B) slot)
                 (= (gn-op M (+ q 5)) OP-CONST) (= (gn-sir M (+ q 5) IF-A) 1) (= (gn-sir M (+ q 5) IF-B) half)
                 (= (gn-op M (+ q 6)) OP-CMP) (= (gn-sir M (+ q 6) IF-A) CC-GE) (= (gn-sir M (+ q 6) IF-B) 0)
                 (= (gn-op M (+ q 7)) OP-BRZ) (= (gn-sir M (+ q 7) IF-A) 0) (> le 0)
                 (= (gn-op M (+ q 8)) OP-LGET) (= (gn-sir M (+ q 8) IF-A) 0) (= (gn-sir M (+ q 8) IF-B) slot)
                 (= (gn-op M (+ q 9)) OP-CONST) (= (gn-sir M (+ q 9) IF-A) 1) (= (gn-sir M (+ q 9) IF-B) (inc mask))
                 (= (gn-op M (+ q 10)) OP-BIN) (= (gn-sir M (+ q 10) IF-A) BOP-SUB) (= (gn-sir M (+ q 10) IF-B) 0)
                 (= (gn-op M (+ q 11)) OP-BR) (> lx 0) (not= le lx)
                 (= (gn-op M (+ q 12)) OP-LABEL) (= (gn-sir M (+ q 12) IF-A) le)
                 (= (gn-op M (+ q 13)) OP-LGET) (= (gn-sir M (+ q 13) IF-A) 0) (= (gn-sir M (+ q 13) IF-B) slot)
                 (= (gn-op M (+ q 14)) OP-LABEL) (= (gn-sir M (+ q 14) IF-A) lx)
                 (= (gn-op M (+ q 15)) OP-RET) (= (gn-sir M (+ q 15) IF-A) 0)
                 (= (gn-op M (+ q 16)) OP-END))
          (+ 1024 (gn-tz (inc mask) 0) (* fuel 512)) 0)))))
(defn- gn-call-wrapper [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
  (if (= (gn-op M (inc i)) OP-RES2) 0
      (let [w (gn-wrapper M f t n)] (if (> w 0) w (gn-sign-wrapper M f n)))))

;; Exact charged mask-and-write composition. Keep it outside gn-call-wrapper
;; so prescan retains the caller's original nonleaf frame and fuel publication.
;; Natural parameters, AND255, one charged inline writer dependency, RET/END.
(defn- gn-mask-writer [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :bool
  (let [p (gn-fnf M f FF-SIR)
        q (gn-skiplab M (+ p 2))
        target (gn-sir M (+ q 5) IF-A)]
    (and (> p 0) (= n 3) (<= t 4) (= (gn-g M gn-f-leaf) 0)
         (not= (gn-op M (inc i)) OP-RES2)
         (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 3)
         (= (gn-op M (inc p)) OP-FUEL)
         (= (gn-wparams M q 0 3) (+ q 3))
         (= (gn-op M (+ q 3)) OP-CONST) (= (gn-sir M (+ q 3) IF-A) 3) (= (gn-sir M (+ q 3) IF-B) 255)
         (= (gn-op M (+ q 4)) OP-BIN) (= (gn-sir M (+ q 4) IF-A) BOP-AND) (= (gn-sir M (+ q 4) IF-B) 2)
         (= (gn-op M (+ q 5)) OP-CALL) (= (gn-sir M (+ q 5) IF-B) 0) (= (gn-sir M (+ q 5) IF-C) 3)
         (= (gn-wrapper M target 0 3) (+ RT-VECTOR-ASSOC-IN-PLACE 256))
         (= (gn-op M (+ q 6)) OP-RET) (= (gn-sir M (+ q 6) IF-A) 0)
         (= (gn-op M (+ q 7)) OP-END))))

;; Exact signed-extension followed by an ordered signed clamp tree.
;; Keep the original caller nonleaf. Open link-time bodies cannot prove it.
(defn- gn-clamp-open [M :vector-i64 f :i64] :bool
  (and (>= f (gn-g M gn-g-open)) (< f (+ (gn-g M gn-g-open) (gn-g M gn-g-open-n)))))
(defn- gn-clamp [M :vector-i64 i :i64 f :i64 n :i64] :i64
  (let [p (gn-fnf M f FF-SIR) fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
        q (gn-skiplab M (+ p 1 fuel)) target (gn-sir M (inc q) IF-A)
        slot (gn-sir M (+ q 2) IF-A) low (gn-sir M (+ q 4) IF-B) high (gn-sir M (+ q 11) IF-B)
        le (gn-sir M (+ q 6) IF-B) lx (gn-sir M (+ q 8) IF-A)
        le2 (gn-sir M (+ q 13) IF-B) lx2 (gn-sir M (+ q 15) IF-A)]
    (if (and (> p 0) (= n 1) (= (gn-g M gn-f-leaf) 0)
             (not (gn-clamp-open M f)) (not (gn-clamp-open M target))
             (not= (gn-op M (inc i)) OP-RES2)
             (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 1)
             (= (gn-op M q) OP-LGET) (= (gn-sir M q IF-A) 0) (= (gn-sir M q IF-B) 1)
             (= (gn-op M (inc q)) OP-CALL) (= (gn-sir M (inc q) IF-B) 0) (= (gn-sir M (inc q) IF-C) 1)
             (> (gn-sign-wrapper M target 1) 0)
             (= (gn-op M (+ q 2)) OP-LSET) (> slot 1) (= (gn-sir M (+ q 2) IF-B) 0)
             (= (gn-op M (+ q 3)) OP-LGET) (= (gn-sir M (+ q 3) IF-A) 0) (= (gn-sir M (+ q 3) IF-B) slot)
             (= (gn-op M (+ q 4)) OP-CONST) (= (gn-sir M (+ q 4) IF-A) 1) (<= low high)
             (= (gn-op M (+ q 5)) OP-CMP) (= (gn-sir M (+ q 5) IF-A) CC-LT) (= (gn-sir M (+ q 5) IF-B) 0)
             (= (gn-op M (+ q 6)) OP-BRZ) (= (gn-sir M (+ q 6) IF-A) 0) (> le 0)
             (= (gn-op M (+ q 7)) OP-CONST) (= (gn-sir M (+ q 7) IF-A) 0) (= (gn-sir M (+ q 7) IF-B) low)
             (= (gn-op M (+ q 8)) OP-BR) (> lx 0)
             (= (gn-op M (+ q 9)) OP-LABEL) (= (gn-sir M (+ q 9) IF-A) le)
             (= (gn-op M (+ q 10)) OP-LGET) (= (gn-sir M (+ q 10) IF-A) 0) (= (gn-sir M (+ q 10) IF-B) slot)
             (= (gn-op M (+ q 11)) OP-CONST) (= (gn-sir M (+ q 11) IF-A) 1)
             (= (gn-op M (+ q 12)) OP-CMP) (= (gn-sir M (+ q 12) IF-A) CC-GT) (= (gn-sir M (+ q 12) IF-B) 0)
             (= (gn-op M (+ q 13)) OP-BRZ) (= (gn-sir M (+ q 13) IF-A) 0) (> le2 0)
             (= (gn-op M (+ q 14)) OP-CONST) (= (gn-sir M (+ q 14) IF-A) 0) (= (gn-sir M (+ q 14) IF-B) high)
             (= (gn-op M (+ q 15)) OP-BR) (> lx2 0)
             (= (gn-op M (+ q 16)) OP-LABEL) (= (gn-sir M (+ q 16) IF-A) le2)
             (= (gn-op M (+ q 17)) OP-LGET) (= (gn-sir M (+ q 17) IF-A) 0) (= (gn-sir M (+ q 17) IF-B) slot)
             (= (gn-op M (+ q 18)) OP-LABEL) (= (gn-sir M (+ q 18) IF-A) lx2)
             (= (gn-op M (+ q 19)) OP-LABEL) (= (gn-sir M (+ q 19) IF-A) lx)
             (not= le lx) (not= le le2) (not= le lx2) (not= lx le2) (not= lx lx2) (not= le2 lx2)
             (= (gn-op M (+ q 20)) OP-RET) (= (gn-sir M (+ q 20) IF-A) 0)
             (= (gn-op M (+ q 21)) OP-END) (= (gn-sir M (+ q 21) IF-A) f)) q 0)))

(defn- gn-use [M :vector-i64 s :i64 w :i64] :vector-i64
  (if (and (>= s 0) (< s gn-cap)) (gn-gs M (+ gn-a-use s) (+ w (gn-g M (+ gn-a-use s)))) M))
(defn- gn-use1 [M :vector-i64 j :i64 w :i64] :vector-i64
  (case (gn-op M j)
    OP-LGET (gn-use M (gn-sir M j IF-B) w)
    OP-LSET (gn-use M (gn-sir M j IF-A) w)
    M))
;; a back-edge from j to the LABEL at p: every use in p..j weighs 8 more
(defn- gn-weigh [M :vector-i64 p :i64 j :i64] :vector-i64 (if (> p j) M (gn-weigh (gn-use1 M p 8) (inc p) j)))
(defn- gn-pre-op [M :vector-i64 j :i64] :vector-i64
  (let [op (gn-op M j)
        a (gn-sir M j IF-A)]
    (case op
      (OP-LGET OP-LSET) (gn-use1 M j 1)
      OP-LABEL (if (and (> a 0) (< a MM-LABEL-CAP)) (gn-gs M (+ gn-a-lp a) j) M)
      (OP-CAP OP-VEC OP-CALLI OP-VECP) (gn-gs M gn-f-leaf 0)
      ;; R4B: a call with more than 7 arguments needs the outgoing area
      OP-CALL (let [w (gn-call-wrapper M j a (gn-sir M j IF-B) (gn-sir M j IF-C))]
                (if (> w 0) (if (if (>= w 1024) (>= w 1536) (>= w 256)) (gn-gs M gn-f-fuel 1) M)
                    (-> M (gn-gs gn-f-leaf 0) (gn-gmax gn-f-out (gn-r16 (* 8 (gn-max 0 (- (gn-sir M j IF-C) 7))))))))
      OP-STR (if (> (gn-str-fold M j) 0) M (gn-gs M gn-f-leaf 0))
      OP-RT (if (or (gn-inl a (gn-sir M j IF-B) (gn-sir M j IF-C))
                    (and (= a RT-STRING-CODE-POINT-AT) (> (gn-back-str M j (dec j) (gn-sir M j IF-B)) 0)))
              M
              (gn-gs M gn-f-leaf 0))
      OP-FUEL (gn-gs M gn-f-fuel 1)
      OP-BR (let [p (gn-lpos M a)] (if (> p 0) (gn-weigh M p j) M))
      M)))
;; scan i .. the END of the function: what = 1 -> max temps, 2 -> max slot
(defn- gn-scan [M :vector-i64 i :i64 what :i64 acc :i64] :i64
  (cond (>= i (vector-at M MM-SIR-N)) acc
        (= (gn-op M i) OP-END) acc
        :else (gn-scan M (+ i 1) what (gn-max acc (if (= what 1) (gn-need-t M i) (gn-need-s M i))))))
(defn- gn-pre [M :vector-i64 j :i64] :vector-i64
  (let [op (gn-op M j)]
    (if (or (>= j (vector-at M MM-SIR-N)) (= op OP-END))
      M
      (gn-pre (gn-pre-op M j) (inc j)))))

;; Experimental loop cache: x3=length, x4=data base, x5=positive key;0=invalid.
;; Dynamic handle checks cover joins/reassignment. Unknown returning calls clear.
;; Only nonleaf functions with actual same-function high-depth loop reads admit;
;; x3..5 are proven free; field8 is named, state14 remains the scalar-tree flag.
(defn- gn-vhot-scan [M :vector-i64 j :i64 work :i64] :bool
 (if (or (<= work 0) (>= j (vector-at M MM-SIR-N))) false
  (let [op (gn-op M j)]
   (cond (or (= op OP-END) (= op OP-FN)) false
         (and (= op OP-RT) (= (gn-sir M j IF-A) RT-VECTOR-AT)
              (= (gn-sir M j IF-C) 2) (>= (gn-sir M j IF-B) 6)
              (gn-high-loop M j)) true
         :else (gn-vhot-scan M (inc j) (dec work))))))
;; Private descriptor ABI: mode2 locals x0..2, temps x9..11, spare x3..5.
;; Target proof duplicates original classification facts without mutating G.
(defn- gn-chain-extra [M :vector-i64 j :i64 end :i64 ns :i64 dp :i64 found :i64] :i64
 (if (= j end) found
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
        valid (case op
          OP-CONST (and (>= a 0) (< a dp) (= c 0))
          OP-LGET (and (>= a 0) (< a dp) (> b 0) (<= b ns) (= c 0))
          OP-LSET (and (> a 0) (<= a ns) (>= b 0) (< b dp) (= c 0))
          OP-BIN (and (>= a 0) (< a BOP-F64-ADD) (>= b 0) (< (inc b) dp) (= c 0))
          OP-CMP (and (>= a 0) (< a CC-F64-EQ) (>= b 0) (< (inc b) dp) (= c 0))
          OP-UN (and (>= a 0) (< a UOP-F64-NEG) (>= b 0) (< b dp) (= c 0))
          OP-RET (and (>= a 0) (< a dp) (= b 0) (= c 0))
          (OP-CALL OP-RT) (and (>= b 0) (> c 0) (<= (+ b c) dp))
          (OP-BRZ OP-BRNZ) (and (>= a 0) (< a dp) (= c 0))
          (OP-FUEL OP-LABEL OP-BR) true
          false)
        genuine (and (= op OP-CALL) (= (gn-call-wrapper M j a b c) 0))]
   (if valid (gn-chain-extra M (inc j) end ns dp (if genuine 1 found)) -1))))
(defn- gn-chain-target [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR) ns (gn-fnf M f FF-NSLOTS) dp (gn-fnf M f FF-DEPTH)]
   (if (or (<= p 0) (>= p (vector-at M MM-SIR-N))
           (< ns 1) (> ns 3) (< dp 1) (> dp 3)) false
    (let [end (gn-small-end M (inc p) f 4096)]
     (and (> end p) (= (gn-op M p) OP-FN)
          (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 1) (= (gn-sir M p IF-C) ns)
          (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-PT0) TY-VEC)
          (= (gn-fnf M f FF-RTYPE) TY-VEC)
          (<= (gn-scan M (inc p) 2 0) ns) (<= (gn-scan M (inc p) 1 0) dp)
          (gn-small-scan M (inc p) p end TY-VEC)
          (= (gn-chain-extra M (inc p) end ns dp 0) 1)))))))
(defn- gn-chain-mode [M :vector-i64 i :i64] :bool
 (and (= (gn-g M gn-f-leaf) 2) (>= (gn-g M gn-f-ns) 1) (<= (gn-g M gn-f-ns) 3)
      (>= (gn-g M gn-f-dp) 1) (<= (gn-g M gn-f-dp) 3)
      (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-fb) 0)
      (= (gn-sreg M 1) 0) (gn-chain-target M (gn-sir M i IF-A))))
(defn- gn-chain-base [M :vector-i64 rv :i64 slot :i64] :vector-i64
 (let [known (gn-g M gn-f-vslot)
       hit (and (> slot 0) (= slot known))
       conditional (and (= known -1) (= slot 1))
       M1 (cond hit M
            conditional (gn-emit M (enc-cbnz 5 13))
            :else (-> M (gn-emit (enc-cbz 5 3)) (gn-emit (enc-cmp-r rv 5)) (gn-emit (enc-bcond (enc-cond-eq) 13))))
       M2 (if hit M1
          (-> M1 (gn-mov 5 rv) (gn-hchk 5 312 320)
           (gn-emit (enc-ldp 17 3 16 0)) (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))))]
  (gn-gs M2 gn-f-vslot slot)))
;; Excluded finite admission proof: no allocation/foreign/unknown effects.
;; Only closed scalar/table calls and exact in-place handle-preserving writes
;; are admitted; their payload changes never alter cached descriptor fields.
;; Single typed Vec parameter stays same local; exact linear reaching-copy
;; witnesses for every vector handle producer and assignment to that local.
;; Cached registers are newly reserved/saved callee registers, never x3..5.
(defn- sl-end [M :vector-i64 j :i64 f :i64 work :i64] :i64
 (cond (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) 0
       (= (gn-op M j) OP-FN) 0
       (= (gn-op M j) OP-END) (if (= (gn-sir M j IF-A) f) j 0)
       :else (sl-end M (inc j) f (dec work))))
(defn- sl-pick [M :vector-i64 f :i64 np :i64 k :i64 chosen :i64] :i64
 (if (= k np) chosen
  (let [ty (gn-fnf M f (+ FF-PT0 k))]
   (cond (= ty TY-VEC) (if (> chosen 0) 0 (sl-pick M f np (inc k) (inc k)))
         (or (= ty TY-I64) (= ty TY-BOOL)) (sl-pick M f np (inc k) chosen)
         :else 0))))
(defn- sl-label-valid [M :vector-i64 target :i64 start :i64 end :i64] :bool
 (let [p (if (and (> target 0) (< target MM-LABEL-CAP)) (gn-lpos M target) 0)]
  (and (> p start) (< p end) (= (gn-op M p) OP-LABEL) (= (gn-sir M p IF-A) target))))
(defn- sl-count-label [M :vector-i64 j :i64 end :i64 target :i64 n :i64] :i64
 (if (>= j end) n
  (sl-count-label M (inc j) end target (if (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) target)) (inc n) n))))
;; Bounded transitive closed scalar/table call certificate. No runtime calls,
;; allocation, handle-valued inputs/results, writes, foreign imports or unknown
;; operations. Recursive cycles exhaust depth/work and refuse. A call result
;; remains a scalar definition, never a rooted vector-origin witness.
(defn- sc-scalar-params [M :vector-i64 f :i64 k :i64 n :i64] :bool
 (or (= k n) (and (or (= (gn-fnf M f (+ FF-PT0 k)) TY-I64)
                       (= (gn-fnf M f (+ FF-PT0 k)) TY-BOOL))
                  (sc-scalar-params M f (inc k) n))))
(defn- sc-scalar-call [M :vector-i64 f :i64 n :i64 depth :i64 work :i64] :i64
 (if (or (<= depth 0) (<= work 0) (<= f 0) (>= f (vector-at M MM-FN-N))
         (< n 0) (> n 7) (gn-clamp-open M f)) -1
  (let [p (gn-fnf M f FF-SIR) ty (gn-fnf M f FF-RTYPE)]
   (if (and (> p 0) (< p (vector-at M MM-SIR-N))
            (or (= ty TY-I64) (= ty TY-BOOL)) (sc-scalar-params M f 0 n)
            (= (gn-fnf M f FF-NPARAMS) n)
            (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) n))
     (sc-scalar-scan M (inc p) f depth (dec work)) -1))))
(defn- sc-scalar-scan [M :vector-i64 j :i64 f :i64 depth :i64 work :i64] :i64
 (if (or (<= work 0) (>= j (vector-at M MM-SIR-N))) -1
  (let [op (gn-op M j) a (gn-sir M j IF-A) left (dec work)]
   (case op
    OP-END (if (= a f) left -1)
    (OP-CONST OP-LGET OP-LSET OP-LABEL OP-BR OP-BRZ OP-BRNZ OP-FUEL OP-RET OP-TRAP OP-TAB)
      (sc-scalar-scan M (inc j) f depth left)
    OP-BIN (if (< a BOP-F64-ADD) (sc-scalar-scan M (inc j) f depth left) -1)
    OP-CMP (if (< a CC-F64-EQ) (sc-scalar-scan M (inc j) f depth left) -1)
    OP-UN (if (< a UOP-F64-NEG) (sc-scalar-scan M (inc j) f depth left) -1)
    OP-CALL (let [remain (sc-scalar-call M a (gn-sir M j IF-C) (dec depth) left)]
      (if (< remain 0) -1 (sc-scalar-scan M (inc j) f depth remain)))
    -1))))
;; Exact existing in-place element writer returns its input handle, without
;; allocation or descriptor-table/items relocation. Only the closed existing
;; wrapper grammar or original inline RT opcode can establish this witness.
(defn- sc-inplace [M :vector-i64 j :i64] :bool
 (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
  (and (= c 3) (>= b 0) (<= b 4)
   (or (and (= op OP-RT) (= a RT-VECTOR-ASSOC-IN-PLACE))
       (and (= op OP-CALL) (not (gn-clamp-open M a))
            (not= (gn-op M (inc j)) OP-RES2)
            (= (bit-and (gn-call-wrapper M j a b c) 255) RT-VECTOR-ASSOC-IN-PLACE))))))
;; Local reload is an identity only after an exact same-temp store, with
;; no intervening temp definition or control-flow boundary. This linear
;; certificate follows original temp-origin CFG edges, never guesses aliases.
(defn- sc-alias-same [M :vector-i64 j :i64 t :i64 slot :i64 work :i64] :bool
 (if (or (<= work 0) (<= j 0)) false
  (let [op (gn-op M j)]
   (cond (or (= op OP-FN) (= op OP-END) (= op OP-LABEL) (= op OP-BR)
             (= op OP-BRZ) (= op OP-BRNZ) (= op OP-RET)) false
         (and (= op OP-LSET) (= (gn-sir M j IF-A) slot)) (= (gn-sir M j IF-B) t)
         (= (gn-defd M j) t) false
         :else (sc-alias-same M (dec j) t slot (dec work))))))
;; Bounded rooted must-origin proof. S is excluded compiler scratch, never M.
;; Header: remaining visits, okay, bodyN, start, end, chosenLocal, edgeN, epoch.
;; Four node arrays and two 2N edge arrays; size8+8*(N+1), zero allocated.
(defn- sc-l [S :vector-i64] :i64 (inc (vector-at S 2)))
(defn- sc-head [S :vector-i64 k :i64] :i64 (vector-at S (+ 8 k)))
(defn- sc-mark-at [S :vector-i64 k :i64] :i64 (+ 8 (+ (sc-l S) k)))
(defn- sc-node-at [S :vector-i64 d :i64] :i64 (+ 8 (+ (* 2 (sc-l S)) d)))
(defn- sc-cursor-at [S :vector-i64 d :i64] :i64 (+ 8 (+ (* 3 (sc-l S)) d)))
(defn- sc-from-at [S :vector-i64 e :i64] :i64 (+ 8 (+ (* 4 (sc-l S)) e)))
(defn- sc-next-at [S :vector-i64 e :i64] :i64 (+ 8 (+ (* 6 (sc-l S)) e)))
(defn- sc-fail [S :vector-i64] :vector-i64 (vector-assoc! S 1 0))
(defn- sc-edge [S :vector-i64 from :i64 to :i64] :vector-i64
 (let [n (vector-at S 2) e (inc (vector-at S 6))]
  (cond (= to (inc n)) S
        (or (< from 1) (> from n) (< to 1) (> to n) (> e (* 2 n))) (sc-fail S)
        :else (let [prev (sc-head S to)]
          (-> S (vector-assoc! (sc-from-at S e) from) (vector-assoc! (sc-next-at S e) prev)
                (vector-assoc! (+ 8 to) e) (vector-assoc! 6 e))))))
(defn- sc-build [M :vector-i64 start :i64 end :i64 slot :i64] :vector-i64
 (let [n (- end (inc start)) S (-> (vector-alloc (+ 8 (* 8 (inc n))))
         (vector-assoc! 0 131072) (vector-assoc! 1 1) (vector-assoc! 2 n)
         (vector-assoc! 3 start) (vector-assoc! 4 end) (vector-assoc! 5 slot))]
  (loop [j (inc start) reads 0 backs 0]
   (if (or (= (vector-at S 1) 0) (= j end))
    ;; One static read can execute repeatedly on a proved backward edge.
    ;; The same rooted must-origin certificate guards descriptor reuse.
    (if (and (>= reads 1) (> backs 0)) S (sc-fail S))
    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
          target (if (= op OP-BR) a b)
          branch (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ))
          valid (cond (or (= op OP-CONST) (= op OP-LGET) (= op OP-LSET) (= op OP-RET) (= op OP-FUEL)) true
                      (= op OP-BIN) (< a BOP-F64-ADD)
                      (= op OP-CMP) (< a CC-F64-EQ)
                      (= op OP-UN) (< a UOP-F64-NEG)
                      (= op OP-RT) (or (and (= a RT-VECTOR-AT) (= c 2) (>= b 0) (<= b 5))
                                       (sc-inplace M j))
                      (= op OP-CALL) (or (sc-inplace M j) (>= (sc-scalar-call M a c 8 1024) 0))
                      (= op OP-LABEL) (and (> a 0) (< a MM-LABEL-CAP) (= (sl-count-label M (inc start) end a 0) 1))
                      branch (sl-label-valid M target start end)
                      :else false)
          k (- j start)
          S1 (cond (not valid) (sc-fail S)
                   (= op OP-RET) S
                   branch (sc-edge S k (- (gn-lpos M target) start))
                   :else (sc-edge S k (inc k)))
          S2 (if (and valid (or (= op OP-BRZ) (= op OP-BRNZ))) (sc-edge S1 k (inc k)) S1)]
      (recur (inc j) (if (and (= op OP-RT) (= a RT-VECTOR-AT)) (inc reads) reads)
                    (if (and branch valid (< (gn-lpos M target) j)) (inc backs) backs)))))))
;; Iterative DFS of every predecessor. Gray/black tags use bounded query epoch;
;; undefined, other definition, any uncut dependency cycle or budget exhaustion
;; fails closed. An accepted LGET definition cuts its incoming dependency edges.
(defn- sc-walk [M :vector-i64 S :vector-i64 t :i64 gray :i64 black :i64] :vector-i64
 (loop [depth 0]
  (let [node (vector-at S (sc-node-at S depth)) cursor (vector-at S (sc-cursor-at S depth))]
   (if (= cursor 0)
    (let [S1 (vector-assoc! S (sc-mark-at S node) black)]
     (if (= depth 0) S1 (recur (dec depth))))
    (let [child (vector-at S (sc-from-at S cursor))
          S1 (vector-assoc! S (sc-cursor-at S depth) (vector-at S (sc-next-at S cursor)))
          mark (vector-at S1 (sc-mark-at S1 child))]
     (cond (= mark gray) (sc-fail S1)
           (= mark black) (recur depth)
           (<= (vector-at S1 0) 0) (sc-fail S1)
           :else (let [S2 (vector-assoc! S1 0 (dec (vector-at S1 0)))
                       j (+ (vector-at S2 3) child)
                       ;; Writer temp b is the same handle before and after.
                       ;; Follow its incoming origin edges instead of treating
                       ;; the returned handle as a newly produced vector.
                       alias (and (= (gn-op M j) OP-LGET) (= (gn-sir M j IF-A) t)
                                  (sc-alias-same M (dec j) t (gn-sir M j IF-B) 64))
                       defined (and (= (gn-defd M j) t) (not (sc-inplace M j)) (not alias))]
             (cond defined (if (and (= (gn-op M j) OP-LGET) (= (gn-sir M j IF-B) (vector-at S2 5)))
                              (let [S3 (vector-assoc! S2 (sc-mark-at S2 child) black)] (recur depth)) (sc-fail S2))
                   (= (sc-head S2 child) 0) (sc-fail S2)
                   (>= (inc depth) (sc-l S2)) (sc-fail S2)
                   :else (let [S3 (-> S2 (vector-assoc! (sc-mark-at S2 child) gray)
                                         (vector-assoc! (sc-node-at S2 (inc depth)) child)
                                         (vector-assoc! (sc-cursor-at S2 (inc depth)) (sc-head S2 child)))]
                           (recur (inc depth)))))))))))
(defn- sc-query [M :vector-i64 S :vector-i64 site :i64 t :i64] :vector-i64
 (let [k (- site (vector-at S 3)) epoch (inc (vector-at S 7)) gray (inc (* 2 epoch)) black (+ 2 (* 2 epoch))]
  (if (or (= (sc-head S k) 0) (> epoch 8192)) (sc-fail S)
   (let [S1 (-> S (vector-assoc! 7 epoch) (vector-assoc! (sc-mark-at S k) gray)
                 (vector-assoc! (sc-node-at S 0) k) (vector-assoc! (sc-cursor-at S 0) (sc-head S k)))]
    (sc-walk M S1 t gray black)))))
(defn- sc-queries [M :vector-i64 S :vector-i64] :vector-i64
 (loop [j (inc (vector-at S 3))]
  (if (or (= (vector-at S 1) 0) (= j (vector-at S 4))) S
   (let [op (gn-op M j) chosen-write (and (= op OP-LSET) (= (gn-sir M j IF-A) (vector-at S 5)))
         S1 (if (or (= op OP-RT) (sc-inplace M j) chosen-write) (sc-query M S j (gn-sir M j IF-B)) S)]
    (recur (inc j))))))

(defn- sl-assign [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (let [end (sl-end M (inc i) f 8192)
       slot (if (and (> np 0) (<= np 5)) (sl-pick M f np 0 0) 0)
       nsv (gn-g M gn-f-nsv)
       nnew (+ nsv 3)
       frame (+ (gn-r16 (* 8 (+ (gn-g M gn-f-ns) (gn-g M gn-f-dp) 2))) (gn-r16 (* 8 nnew)) (gn-g M gn-f-out))]
  (if (and (or (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-leaf) 0))
           (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-out) 0)
           (> slot 0) (> end i) (<= nsv 7) (<= frame 32768)
           ;; Keep the already-certified frame-free guarded copy kernel.
           (not (gn-copy-ready? M (inc i) true)))
    (let [proof (sc-queries M (sc-build M i end slot))]
     (if (= (vector-at proof 1) 1)
      (-> M (gn-gs gn-f-nsv nnew) (gn-gs gn-f-fb frame) (gn-gs gn-f-vmode 3) (gn-gs 15 slot)) M)) M)))
(defn- sl-len [M :vector-i64] :i64 (+ 16 (gn-g M gn-f-nsv)))
(defn- sl-base [M :vector-i64] :i64 (+ 17 (gn-g M gn-f-nsv)))
(defn- sl-flag [M :vector-i64] :i64 (+ 18 (gn-g M gn-f-nsv)))
(defn- sl-clear [M :vector-i64] :vector-i64
 (if (= (gn-g M gn-f-vmode) 3) (gn-emit M (enc-movz (sl-flag M) 0 0)) (gn-vclear M)))
;; Runtime flag is a successful original-site validation witness across
;; closed stable-local body/backedges. Positive compile witness is retained
;; only through straight-line source; joins/branches retain the flag guard.
(defn- sl-read [M :vector-i64 rv :i64 ri :i64 d :i64 slot :i64] :vector-i64
 (if (not= slot (gn-g M 15)) (gn-err M E-GEN-OP OP-RT)
  (let [known false len (sl-len M) base (sl-base M) flag (sl-flag M)
        m0 (if known M (gn-emit M (enc-cbnz flag 13)))
        m1 (if known m0
             (-> m0 (gn-hchk rv 312 320) (gn-emit (enc-ldp 17 len 16 0))
                    (gn-emit (enc-ldr base 7 328)) (gn-emit (gn-e-addsl base base 17 3))
                    (gn-emit (enc-movz flag 1 0))))]
   (-> m1 (gn-emit (enc-cmp-r ri len)) (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))
           (gn-emit (gn-e-ldrr d base ri 1)) (gn-gs gn-f-vslot slot)))))

;; One-off semantic compiler algorithm; no existing mechanical rewrite rule.
(def vi-slot (+ gn-g-open 80))
(def vi-max (inc vi-slot))
(defn- vi-clear [M :vector-i64] :vector-i64
 (-> M (gn-gs vi-slot 0) (gn-gs vi-max -1)))
;; Invoke once from gn-ins after original gn-chain-step. All joins and calls refuse propagation.
(defn- vi-step [M :vector-i64 op :i64 a :i64] :vector-i64
 (cond (or (= op OP-CONST) (= op OP-LGET) (= op OP-FUEL)) M
       (and (= op OP-BIN) (< a BOP-F64-ADD)) M
       (and (= op OP-CMP) (< a CC-F64-EQ)) M
       (and (= op OP-UN) (< a UOP-F64-NEG)) M
       (and (= op OP-RT) (or (= a RT-VECTOR-AT) (= a RT-VECTOR-ASSOC-IN-PLACE))) M
       :else (vi-clear M)))
;; k must be exact nonnegative gn-k-const index from original RT descriptor, else -1.
;; Only call in mode2 after gn-chain-base, whose successful normal continuation establishes slot.
;; Keep original CMP always, including flags visible at later original traps.
(defn- vi-check [M :vector-i64 ri :i64 slot :i64 k :i64] :vector-i64
 (let [active (and (= (gn-g M gn-f-vmode) 2) (> slot 0) (>= k 0))
       same (and active (= (gn-g M vi-slot) slot))
       hit (and same (<= k (gn-g M vi-max)))
       m0 (gn-emit M (enc-cmp-r ri 3))
       m1 (if hit m0 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))))]
  (if active
   (-> m1 (gn-gs vi-slot slot) (gn-gs vi-max (if (and same (> (gn-g M vi-max) k)) (gn-g M vi-max) k)))
   (vi-clear m1))))

;; Consumed SIR can hide a folded LSET/fused branch; clear after any skip.
(defn- vi-post [M :vector-i64] :vector-i64 (if (> (gn-g M gn-f-skip) 0) (vi-clear M) M))

(defn- gn-chain-read [M :vector-i64 rv :i64 ri :i64 d :i64 slot :i64 k :i64] :vector-i64
 (if (= (gn-g M gn-f-vmode) 3) (sl-read M rv ri d slot)
 (if (not= (gn-g M gn-f-vmode) 2) (ve-read M rv ri d slot k)
  (-> M (gn-chain-base rv slot)
   (vi-check ri slot k)
   (gn-emit (gn-e-ldrr d 4 ri 1))))))
(defn- gn-chain-store [M :vector-i64 rv :i64 ri :i64 rx :i64 slot :i64 k :i64] :vector-i64
 (if (not= (gn-g M gn-f-vmode) 2)
  (-> M (gn-hchk rv 312 320) (gn-vidx ri) (gn-emit (gn-e-strr3 rx 16 17)))
  (-> M (gn-chain-base rv slot)
      (vi-check ri slot k)
      (gn-emit (gn-e-strr3 rx 4 ri)))))

;; Published mode2 fuel counter, exact generated target transaction.
;; Move its key-clear to caller and skip only its redundant fuel reload.
;; Forward/unavailable/mismatched target code retains unchanged entry.
(defn- fc-target [M :vector-i64 f :i64] :bool
 (if (not (gn-chain-target M f)) false
  (let [a (gn-fnf M f FF-CODE) p (gn-fnf M f FF-SIR)]
   (and (> a 0) (< (+ a 5) (vector-at M MM-CODE-N))
    (= (gn-op M (inc p)) OP-FUEL)
    (= (vector-at M (+ MM-CODE-BASE a)) (enc-movz 5 0 0))
    (= (vector-at M (+ MM-CODE-BASE a 1)) (enc-ldr 8 7 CTX-FUEL))
    (= (vector-at M (+ MM-CODE-BASE a 2)) (enc-subs-i 8 8 1))
    (= (vector-at M (+ MM-CODE-BASE a 3)) (enc-bcond (enc-cond-hs) 2))
    (= (vector-at M (+ MM-CODE-BASE a 4)) (enc-brk 0))
    (= (vector-at M (+ MM-CODE-BASE a 5)) (enc-str 8 7 CTX-FUEL))))))
(defn- gn-chain-fix [M :vector-i64 f :i64 t :i64 n :i64] :vector-i64
 (let [private (and (= (gn-g M gn-f-vmode) 2) (= n 1) (> (gn-g M gn-f-vslot) 0)
                    (gn-isk M t gn-k-local) (= (gn-dv M t) (gn-g M gn-f-vslot)) (gn-chain-target M f))
       fuel-only (and (not private) (= n 1) (= (gn-g M gn-f-vmode) 2)
                     (= (gn-g M gn-f-leaf) 2) (= (gn-g M gn-f-freg) 2)
                     (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-out) 0)
                     (= (gn-g M gn-f-nsv) 0) (fc-target M f))
       cleared (if fuel-only (gn-emit M (enc-movz 5 0 0)) M)
       M1 (gn-fix cleared FX-BL26 f) at (dec (vector-at M1 MM-FIX-N))]
  (if (or private fuel-only) (gn-put M1 (+ MM-FIX-BASE (* at MM-FIX-W) XF-AUX)
       (if (or fuel-only (= (gn-g M gn-f-freg) 2)) 2 1)) M1)))

;; Cost filter for direct repeated vector loads; ordinary locals use19+,
;; canonical temps9..15 leave the descriptor registers3..5 independent.
(defn- ve-sites [M :vector-i64 j :i64 seen :i64 work :i64] :bool
 (cond (>= seen 2) true
       (or (<= work 0) (>= j (vector-at M MM-SIR-N))) false
       (or (= (gn-op M j) OP-END) (= (gn-op M j) OP-FN)) false
       :else (ve-sites M (inc j)
         (+ seen (if (and (= (gn-op M j) OP-RT)
                          (= (gn-sir M j IF-A) RT-VECTOR-AT)
                          (>= (gn-sir M j IF-B) 0)
                          (gn-inl RT-VECTOR-AT (gn-sir M j IF-B) (gn-sir M j IF-C))) 1 0))
         (dec work))))
(defn- ve-call [M :vector-i64] :vector-i64
 (if (and (= (gn-g M gn-f-vmode) 1) (= (gn-g M gn-f-dead) 0))
  (gn-vclear M) M))
(defn- gn-vmode [M :vector-i64 i :i64] :vector-i64
 (gn-gs M gn-f-vmode (if (gn-chain-mode M i) 2 (if (and (= (gn-g M gn-f-leaf) 0)
                            (gn-vhot-scan M (inc i) 8192)) 1 0))))
;; Preserve earlier stable-local and affine-loop specializations. Only admit
;; ordinary fallback bodies afterward; initialize the physical validated key.
(defn- ve-entry [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (if (and (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-leaf) 0)
          (= (gn-g M gn-f-skip) 0) (= (vl-admit M i f np) 0)
          (ve-sites M (inc i) 0 8192))
  (-> M (gn-gs gn-f-vmode -1) (gn-gs gn-f-vslot 0)) M))
(defn- gn-vclear [M :vector-i64] :vector-i64
 (if (> (gn-g M gn-f-vmode) 0) (gn-mov-imm M 5 0) M))
;; Hit requires nonzero key from a prior original handle check. Miss captures
;; descriptor at the original access, before its index check. No trap/charge
;; speculation. RV/RI/D cannot collide with x3..5 under the register proof.
(defn- gn-vread [M :vector-i64 rv :i64 ri :i64 d :i64] :vector-i64
 (if (and (= (gn-g M gn-f-vmode) 4) (= (gn-g M gn-f-freg) 3))
  (gn-emit M (gn-e-ldrr d 4 ri 1))
 (if (<= (gn-g M gn-f-vmode) 0)
  (-> M (gn-hchk rv 312 320) (gn-vidx ri) (gn-emit (gn-e-ldrr d 16 17 1)))
  (-> M
   (gn-emit (enc-cbz 5 3)) (gn-emit (enc-cmp-r rv 5)) (gn-emit (enc-bcond (enc-cond-eq) 13))
   (gn-mov 5 rv) (gn-hchk 5 312 320)
   (gn-emit (enc-ldp 17 3 16 0)) (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))
   (gn-emit (enc-cmp-r ri 3)) (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))
   (gn-emit (gn-e-ldrr d 4 ri 1))))))


;; Compile-time witness only. No added runtime state/branch. First read keeps
;; the dynamic validated-key path; later same-local straight-line read omits it.
;; Labels/branches/calls/unknown effects reset; coalesced local writes reset too.
(defn- gn-vdrop [M :vector-i64 s :i64] :vector-i64
 (let [raw (gn-g M gn-f-vslot)
       real (if (= (gn-g M gn-f-vmode) -1)
        (cond (and (< raw -1) (> raw (- -1 gn-cap))) (- -1 raw)
              (and (< raw (- -1 gn-cap)) (> raw (- -1 (* 2 gn-cap)))) (- (- -1 gn-cap) raw)
              :else 0) 0)
       valid (and (> real 0) (< real gn-cap) (<= real (gn-g M gn-f-ns))
        (> (gn-g M gn-f-ns) 0) (< (gn-g M gn-f-ns) gn-cap))]
  (if (and (> s 0)
       (or (and (< raw -1) (or (not valid) (= s real)))
           (= s raw) (and (= s 1) (= raw -1))))
   (gn-gs M gn-f-vslot 0) M)))

(defn- gn-vstep [M :vector-i64 op :i64 a :i64] :vector-i64
 (cond (or (= op OP-CONST) (= op OP-LGET)) M
       (and (= op OP-BIN) (< a BOP-F64-ADD)) M
       (= op OP-LSET) (gn-vdrop M a)
       :else (gn-gs M gn-f-vslot 0)))
;; Novel bounded available-descriptor effect certificate, inspired by LLVM
;; EarlyCSE separate memory generations. Fuel stores and vector data writes
;; do not mutate descriptors; only direct inline effects preserve the witness.
(defn- ve-step [M :vector-i64 i :i64 op :i64 a :i64] :vector-i64
 (if (and (or (= (gn-g M gn-f-vmode) 1) (= (gn-g M gn-f-vmode) -1)) (= (gn-g M gn-f-leaf) 0)
  (or (= op OP-FUEL)
      (and (= op OP-CMP) (>= a 0) (< a CC-F64-EQ))
      (and (= op OP-UN) (>= a 0) (< a UOP-F64-NEG))
      (and (= op OP-RT) (gn-inl a (gn-sir M i IF-B) (gn-sir M i IF-C))
       (or (= a RT-VECTOR-AT) (= a RT-VECTOR-ASSOC-IN-PLACE))))) M
  (gn-vstep M op a)))
;; ADR0357 novel semantic success-edge fact. Ordinary cached reads only.
;; Reuse existing vi cells; every noncanonical tail clears them. Keep CMP.
(defn- ocb-storage [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS)
  (let [g (vector-at M gn-cell) top (vector-at M MM-HEAP-TOP) size (inc vi-max)]
   (and (>= g MM-HEAP-BASE) (<= g (- MM-HEAP-END size))
    (>= top (+ g size)) (<= top MM-HEAP-END)))))
(defn- ocb-counts [M :vector-i64 n :i64] :bool
 (and (ocb-storage M)
  (= (vector-at M MM-ERR) 0)
  (> (vector-at M MM-CODE-N) n) (<= (vector-at M MM-CODE-N) MM-CODE-CAP)
  (or (= (gn-g M gn-f-vmode) 1) (= (gn-g M gn-f-vmode) -1))
  (= (gn-g M gn-f-leaf) 0)))
(defn- ocb-prior [M :vector-i64 slot :i64 k :i64 ri :i64] :bool
 (and (ocb-counts M 5) (> slot 0) (< slot gn-cap) (>= k 0) (<= k 65535) (= ri 10)
  (= (gn-g M gn-f-vslot) slot) (= (gn-g M vi-slot) slot) (<= k (gn-g M vi-max))
  (let [p (- (vector-at M MM-CODE-N) 5) load (vector-at M (+ MM-CODE-BASE p 3)) d (bit-and load 31)]
   (and (= (vector-at M (+ MM-CODE-BASE p)) (enc-cmp-r 10 3))
    (= (vector-at M (+ MM-CODE-BASE p 1)) (enc-bcond (enc-cond-lo) 2))
    (= (vector-at M (+ MM-CODE-BASE p 2)) (gn-e-udf))
    (not= d 3) (not= d 4) (not= d 5) (< d 31)
    (= load (gn-e-ldrr d 4 10 1))
    (= (vector-at M (+ MM-CODE-BASE p 4)) (enc-movz 10 k 0))))))
(defn- ocb-check [M :vector-i64 ri :i64 slot :i64 k :i64] :vector-i64
 (let [hit (ocb-prior M slot k ri) m0 (gn-emit M (enc-cmp-r ri 3))]
  (if hit m0 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))))))
(defn- ocb-record [M :vector-i64 slot :i64 k :i64 ri :i64 d :i64] :vector-i64
 (if (and (ocb-counts M 4) (> slot 0) (< slot gn-cap) (>= k 0) (<= k 65535) (= ri 10)
          (not= d 3) (not= d 4) (not= d 5) (>= d 0) (< d 31)
  (let [p (- (vector-at M MM-CODE-N) 4)]
   (and (= (vector-at M (+ MM-CODE-BASE p)) (enc-cmp-r 10 3))
    (= (vector-at M (+ MM-CODE-BASE p 1)) (enc-bcond (enc-cond-lo) 2))
    (= (vector-at M (+ MM-CODE-BASE p 2)) (gn-e-udf))
    (= (vector-at M (+ MM-CODE-BASE p 3)) (gn-e-ldrr d 4 10 1)))))
  (-> M (gn-gs vi-slot slot) (gn-gs vi-max k)) (if (ocb-storage M) (vi-clear M) M)))

;; Preserve only the exact single scalar LSET consumed by this checked read.
;; Its destination differs from the cached handle and the fourword tail has
;; no memory write. Every other skip retains the original vi-post clear.
(defn- ocb-post [M :vector-i64 i :i64 op :i64] :vector-i64
 (if (and (ocb-counts M 4) (= op OP-RT) (= (gn-g M gn-f-skip) 1)
  (> (gn-g M vi-slot) 0) (= (gn-g M vi-slot) (gn-g M gn-f-vslot))
  (> (gn-g M gn-f-ns) 0) (< (gn-g M gn-f-ns) gn-cap)
  (> (gn-g M gn-f-dp) 1) (< (gn-g M gn-f-dp) gn-cap)
  (> i 0) (< (inc i) (vector-at M MM-SIR-N)) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (= (gn-op M i) OP-RT) (= (gn-sir M i IF-A) RT-VECTOR-AT) (= (gn-sir M i IF-C) 2)
  (>= (gn-sir M i IF-B) 0) (< (inc (gn-sir M i IF-B)) (gn-g M gn-f-dp))
  (= (gn-op M (inc i)) OP-LSET) (= (gn-sir M (inc i) IF-B) (gn-sir M i IF-B))
  (= (gn-sir M (inc i) IF-C) 0)
  (> (gn-sir M (inc i) IF-A) 0) (<= (gn-sir M (inc i) IF-A) (gn-g M gn-f-ns))
  (not= (gn-sir M (inc i) IF-A) (gn-g M vi-slot))
  (let [p (- (vector-at M MM-CODE-N) 4) load (vector-at M (+ MM-CODE-BASE p 3)) d (bit-and load 31)]
   (and (not= d 3) (not= d 4) (not= d 5) (< d 31)
    (= (vector-at M (+ MM-CODE-BASE p)) (enc-cmp-r 10 3))
    (= (vector-at M (+ MM-CODE-BASE p 1)) (enc-bcond (enc-cond-lo) 2))
    (= (vector-at M (+ MM-CODE-BASE p 2)) (gn-e-udf))
    (= load (gn-e-ldrr d 4 10 1))))) M (vi-post M)))

(defn- ve-read [M :vector-i64 rv :i64 ri :i64 d :i64 slot :i64 k :i64] :vector-i64
 (let [active (and (or (= (gn-g M gn-f-vmode) 1) (= (gn-g M gn-f-vmode) -1)) (= (gn-g M gn-f-leaf) 0) (> slot 0))
       bypass (and active (= (gn-g M gn-f-vmode) -1)
        (< slot gn-cap) (<= slot (gn-g M gn-f-ns))
        (or (= (gn-g M gn-f-vslot) (- -1 slot))
           (= (gn-g M gn-f-vslot) (- (- -1 gn-cap) slot)))
        (> (gn-g M gn-f-ns) 0) (< (gn-g M gn-f-ns) gn-cap)
        (>= rv 19) (<= rv 28) (= (gn-sreg M slot) rv))
       start (vector-at M MM-CODE-N)
       hit (and active (= slot (gn-g M gn-f-vslot)))
       m1 (if hit
        (-> M (ocb-check ri slot k) (gn-emit (gn-e-ldrr d 4 ri 1)))
        (if (= (gn-g M gn-f-vmode) -1)
         ;; Static-only mode: first access costs the original fifteen words.
         ;; No runtime key lookup or hit/miss branch. Checks stay at this site.
         (-> M (gn-hchk rv 312 320)
          (gn-emit (enc-ldp 17 3 16 0)) (gn-emit (enc-ldr 4 7 328))
          (gn-emit (gn-e-addsl 4 4 17 3))
          (gn-emit (enc-cmp-r ri 3)) (gn-emit (enc-bcond (enc-cond-lo) 2))
          (gn-emit (gn-e-udf)) (gn-emit (gn-e-ldrr d 4 ri 1)))
         (gn-vread M rv ri d)))]
  (let [m2 (if (and bypass (= (vector-at m1 MM-ERR) 0)
   (>= start 0) (<= (+ start 15) MM-CODE-CAP)
   (= (vector-at m1 MM-CODE-N) (+ start 15))
   (loop [j 0] (or (= j 15)
    (and (= (vector-at m1 (+ MM-CODE-BASE start j)) (cond (= j 0) (enc-ldr 16 7 312)
(= j 1) (enc-ldr 16 16 0)
(= j 2) (enc-sub-i 17 rv 1)
(= j 3) (enc-cmp-r 17 16)
(= j 4) (enc-bcond (enc-cond-lo) 2)
(= j 5) (gn-e-udf)
(= j 6) (enc-ldr 16 7 320)
(= j 7) (gn-e-addsl 16 16 17 4)
(= j 8) (enc-ldp 17 3 16 0)
(= j 9) (enc-ldr 4 7 328)
(= j 10) (gn-e-addsl 4 4 17 3)
(= j 11) (enc-cmp-r ri 3)
(= j 12) (enc-bcond (enc-cond-lo) 2)
(= j 13) (gn-e-udf)
:else (gn-e-ldrr d 4 ri 1)))
     (recur (inc j))))))
  (vector-assoc! m1 (+ MM-CODE-BASE start) (enc-b 11)) m1)]
 (ocb-record (gn-gs m2 gn-f-vslot (if active slot 0)) slot k ri d))))

(defn- gn-vpair [M :vector-i64 slot :i64 d :i64] :vector-i64
 (if (= (gn-g M gn-f-vmode) -1) (ve-read M 0 1 d slot -1)
 (let [active (= (gn-g M gn-f-vmode) 1)
       hit (and active (> slot 0) (= slot (gn-g M gn-f-vslot)))
       M1 (if hit
             (-> M (gn-emit (enc-cmp-r 1 3))
                   (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))
                   (gn-emit (gn-e-ldrr d 4 1 1)))
             (gn-vread M 0 1 d))]
  (gn-gs M1 gn-f-vslot (if active slot 0)))))

;; ---- register assignment ----------------------------------------------------------------------------------------
(defn- gn-lowregs [M :vector-i64 k :i64 n :i64] :vector-i64
  (if (> k n) M (gn-lowregs (gn-gs M (+ gn-a-sreg k) k) (inc k) n)))
;; the unassigned slot in k..ns with the highest use (first on ties), 0 = none
(defn- gn-best [M :vector-i64 k :i64 ns :i64 bk :i64 bu :i64] :i64
  (if (> k ns)
    bk
    (let [u (gn-g M (+ gn-a-use k))]
      (if (and (> u bu) (= (gn-g M (+ gn-a-sreg k)) 0))
        (gn-best M (inc k) ns k u)
        (gn-best M (inc k) ns bk bu)))))
(defn- gn-rank [M :vector-i64 lo :i64 ns :i64 cnt :i64] :vector-i64
  (let [b (if (>= cnt 10) 0 (gn-best M lo ns 0 0))]
    (if (= b 0)
      (gn-gs M gn-f-nsv cnt)
      (gn-rank (gn-gs M (+ gn-a-sreg b) (+ 20 cnt)) lo ns (inc cnt)))))
;; a slot that is used but has no register
(defn- gn-memslot [M :vector-i64 k :i64 ns :i64] :bool
  (cond (> k ns) false
        (and (> (gn-g M (+ gn-a-use k)) 0) (= (gn-g M (+ gn-a-sreg k)) 0)) true
        :else (gn-memslot M (inc k) ns)))
(defn- gn-assign [M :vector-i64] :vector-i64
  (let [ns (gn-g M gn-f-ns)
        leaf (gn-g M gn-f-leaf)
        M1 (if (> leaf 0) (gn-lowregs M 1 (gn-min ns 7)) M)
        M2 (gn-rank M1 (if (> leaf 0) 8 1) ns 0)
        nsv (gn-g M2 gn-f-nsv)
        dp (gn-g M2 gn-f-dp)
        framed (or (= leaf 0) (> nsv 0) (> dp 7) (gn-memslot M2 1 ns))]
    (gn-gs M2 gn-f-fb (if framed (+ (gn-r16 (* 8 (+ ns dp 2))) (gn-r16 (* 8 nsv)) (gn-g M2 gn-f-out)) 0))))

;; ---- prologue and epilogue -----------------------------------------------------------------------------------------
(defn- gn-subsp [M :vector-i64 amt :i64] :vector-i64
  (if (> amt 0) (gn-emit M (enc-sub-i 31 31 amt)) M))
;; save (ld = 0) / restore (ld = 1) the callee-saved x19 .. x(19+n-1) at [sp, #O ..] (R4B: O = the outgoing area)
(defn- gn-csave [M :vector-i64 i :i64 n :i64 ld :i64] :vector-i64
  (let [o (+ (gn-g M gn-f-out) (* 8 i))]
    (cond (>= i n) M
          (< (inc i) n) (gn-csave (gn-emit M (if (= ld 1) (enc-ldp (+ 19 i) (+ 20 i) 31 o) (enc-stp (+ 19 i) (+ 20 i) 31 o)))
                                  (+ i 2) n ld)
          :else (gn-emit M (if (= ld 1) (enc-ldr (+ 19 i) 31 o) (enc-str (+ 19 i) 31 o))))))
;; params x0.. -> their slots (register or frame). R4B: parameter k-1 >= 7 arrives at [x29, #16+8*(k-8)] (the caller's
;; outgoing area; a function that uses such a parameter always has a frame); an unused one is not loaded
(defn- gn-params [M :vector-i64 k :i64 np :i64] :vector-i64
  (let [r (gn-sreg M k)
        off (+ 16 (* 8 (- k 8)))]
    (cond (> k np) M
          (<= k 7) (gn-params (if (>= r 0) (gn-mov M r (dec k)) (gn-st M (dec k) k)) (inc k) np)
          (>= r 0) (gn-params (gn-emit M (enc-ldr r 29 off)) (inc k) np)
          (zero? (gn-g M (+ gn-a-use k))) (gn-params M (inc k) np)
          :else (gn-params (-> M (gn-emit (enc-ldr 16 29 off)) (gn-st 16 k)) (inc k) np))))
;; Fold a certified associative scalar composition without its otherwise retained frame.
;; The sole original nonleaf entry charge is still published before any arithmetic.
(defn- sr-op [op :i64] :bool
 (or (= op BOP-ADD) (= op BOP-MUL) (= op BOP-AND) (= op BOP-OR) (= op BOP-XOR)))
(defn- sr-types [M :vector-i64 f :i64 n :i64] :bool
 (and (= (gn-fnf M f FF-RTYPE) TY-I64)
  (loop [k 0] (or (= k n) (and (= (gn-fnf M f (+ FF-PT0 k)) TY-I64) (recur (inc k)))))))
(defn- sr-inner [M :vector-i64 f :i64 n :i64 op :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (< (+ p 2) (vector-at M MM-SIR-N))
        (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) n)
        (> (gn-fnf M f FF-DEPTH) 0) (<= (gn-fnf M f FF-DEPTH) 7)
        (sr-types M f n) (gn-dot-at? M p OP-FN f n n)
        (= (gn-op M (inc p)) OP-LABEL) (> (gn-sir M (inc p) IF-A) 0)
        (< (gn-sir M (inc p) IF-A) MM-LABEL-CAP)
        (= (gn-sir M (inc p) IF-B) 0) (= (gn-sir M (inc p) IF-C) 0)
        (loop [j (+ p 2) h 0 packed 0 work 32]
         (if (or (<= work 0) (>= (inc j) (vector-at M MM-SIR-N))) false
          (let [tag (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
           (cond
            (= tag OP-LGET)
             (and (= a h) (< h 7) (> b 0) (<= b n) (= c 0)
                  (recur (inc j) (inc h) (bit-or packed (i64-shift-left (di-bit (dec b)) (* 7 h))) (dec work)))
            (= tag OP-BIN)
             (and (= a op) (>= h 2) (= b (- h 2)) (= c 0)
              (let [x (bit-and (u64-shift-right packed (* 7 b)) 127)
                    y (bit-and (u64-shift-right packed (* 7 (inc b))) 127)]
               (and (= (bit-and x y) 0)
                (recur (inc j) (dec h)
                 (bit-or (bit-and packed (dec (di-bit (* 7 b)))) (i64-shift-left (bit-or x y) (* 7 b)))
                 (dec work)))))
            (= tag OP-RET)
             (and (= h 1) (= packed (dec (di-bit n))) (= a 0) (= b 0) (= c 0)
                  (gn-dot-at? M (inc j) OP-END f 0 0))
            :else false))))))))
(defn- sr-admit [M :vector-i64 i :i64 f :i64 np :i64] :i64
 (if (or (< np 3) (> np 7) (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)
         (<= i 0) (>= (+ i np 6) (vector-at M MM-SIR-N))) 0
  (let [q (+ i 3) call (+ q np) inner (gn-sir M call IF-A)
        op (gn-sir M (inc call) IF-A) label (gn-sir M (+ i 2) IF-A)]
   (if (and (sr-op op) (sr-types M f np)
       (= (gn-fnf M f FF-SIR) i) (= (gn-fnf M f FF-NPARAMS) np)
       (= (gn-fnf M f FF-NSLOTS) np) (= (gn-fnf M f FF-DEPTH) np)
       (gn-dot-at? M i OP-FN f np np) (gn-dot-at? M (inc i) OP-FUEL 0 0 0)
       (> label 0) (< label MM-LABEL-CAP) (gn-dot-at? M (+ i 2) OP-LABEL label 0 0)
       (loop [k 0] (or (= k np) (and (gn-dot-at? M (+ q k) OP-LGET k (inc k) 0) (recur (inc k)))))
       (gn-dot-at? M call OP-CALL inner 1 (dec np))
       (sr-inner M inner (dec np) op)
       (= (gn-call-wrapper M call inner 1 (dec np)) 0)
       (gn-dot-at? M (inc call) OP-BIN op 0 0)
       (gn-dot-at? M (+ call 2) OP-RET 0 0 0)
       (gn-dot-at? M (+ call 3) OP-END f 0 0)) op 0))))
(defn- sr-fold [M :vector-i64 op :i64 k :i64 np :i64] :vector-i64
 (if (= k np) M
  (sr-fold (gn-emit M (case op
    BOP-ADD (enc-add-r 0 0 k) BOP-MUL (enc-mul 0 0 k)
    BOP-AND (enc-and-r 0 0 k) BOP-OR (enc-orr-r 0 0 k) BOP-XOR (enc-eor-r 0 0 k)
    (enc-brk 0))) op (inc k) np)))
(defn- sr-entry [M :vector-i64 i :i64 f :i64 np :i64 op :i64] :vector-i64
 (-> M (gn-put (+ MM-FN-BASE (* f MM-FN-W) FF-CODE) (vector-at M MM-CODE-N))
       (gn-gs gn-f-ctx 1) (gn-gs gn-f-freg 0) (gn-op-fuel)
       (sr-fold op 1 np) (gn-emit (enc-ret)) (gn-gs gn-f-dead 0)
       ;; Leave END for the original unreachable BRK delimiter.
       (gn-gs gn-f-skip (+ np 5))))

;; Two disjoint caller-saved scalar banks permit bounded charged composition.
;; Original memory fuel transactions precede their original pure bodies.
(defn- sc-helper [M :vector-i64 f :i64 n :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (< n 1) (> n 2) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR) ns (gn-fnf M f FF-NSLOTS) dp (gn-fnf M f FF-DEPTH)]
   (if (or (<= p 0) (>= (+ p 2) (vector-at M MM-SIR-N)) (not= (gn-fnf M f FF-NPARAMS) n) (not= ns n) (> dp 5) (<= dp 0)
           (not (sr-types M f n)) (not (gn-dot-at? M p OP-FN f n n))
           (not (gn-dot-at? M (inc p) OP-FUEL 0 0 0))) 0
    (let [end (dc-body M p f ns dp n)]
     (if (and (> end 0)
          (loop [j (+ p 2)]
           (or (= j end)
            (and (not= (gn-op M j) OP-LSET)
                 (or (not= (gn-op M j) OP-BIN) (not= (gn-sir M j IF-A) BOP-QUOT))
                 (or (not= (gn-op M j) OP-CALL) (< (gn-scalar-mask M j (gn-sir M j IF-A) (gn-sir M j IF-C)) 256))
                 (recur (inc j)))))) end 0))))))
(defn- sc-body [M :vector-i64 p :i64 f :i64 n :i64 dp :i64] :i64
 (loop [j (+ p 2) h 0 calls 0 work 64]
  (if (or (<= work 0) (>= (inc j) (vector-at M MM-SIR-N))) 0
   (let [tag (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
         valid (case tag
          OP-LABEL (and (= j (+ p 2)) (> a 0) (< a MM-LABEL-CAP) (= b 0) (= c 0))
          OP-LGET (and (= a h) (< a dp) (> b 0) (<= b n) (= c 0))
          OP-CONST (and (= a h) (< a dp) (= c 0))
          OP-BIN (and (di-bin a) (not= a BOP-QUOT) (>= b 0) (= (+ b 2) h) (= c 0))
          OP-UN (and (= a UOP-BITNOT) (>= b 0) (= (inc b) h) (= c 0))
          OP-CALL (and (> c 0) (<= c 2) (>= b 0) (= (+ b c) h) (> (sc-helper M a c) 0)
                       (= (gn-call-wrapper M j a b c) 0))
          OP-RET (and (> calls 0) (= h 1) (= a 0) (= b 0) (= c 0)
                      (gn-dot-at? M (inc j) OP-END f 0 0))
          false)]
    (cond (not valid) 0 (= tag OP-RET) (inc j)
     :else (recur (inc j)
       (cond (or (= tag OP-LGET) (= tag OP-CONST)) (inc h)
             (or (= tag OP-BIN) (= tag OP-CALL)) (inc b) :else h)
       (+ calls (if (= tag OP-CALL) 1 0)) (dec work)))))))
(defn- sc-admit [M :vector-i64 i :i64 f :i64 n :i64] :i64
 (if (or (< n 1) (> n 2) (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)
         (<= i 0) (>= (+ i 2) (vector-at M MM-SIR-N))) 0
  (let [dp (gn-fnf M f FF-DEPTH)]
   (if (and (= (gn-fnf M f FF-SIR) i) (= (gn-fnf M f FF-NPARAMS) n)
       (= (gn-fnf M f FF-NSLOTS) n) (> dp 0) (<= dp 7) (sr-types M f n)
       (gn-dot-at? M i OP-FN f n n) (gn-dot-at? M (inc i) OP-FUEL 0 0 0))
    (sc-body M i f n dp) 0))))
(defn- sc-copy-params [M :vector-i64 k :i64 n :i64] :vector-i64
 (if (= k n) M (sc-copy-params (gn-mov M (+ 9 k) k) (inc k) n)))
(defn- sc-helper-emit [M :vector-i64 j :i64 end :i64 args :i64 dst :i64] :vector-i64
 (if (= j end) M
  (let [tag (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
   (sc-helper-emit
    (case tag
     OP-LABEL M
     OP-LGET (gn-mov M (+ 11 a) (+ args (dec b)))
     OP-CONST (gn-mov-imm M (+ 11 a) b)
     OP-BIN (gn-emit M (gn-bin-word a (+ 11 b) (+ 11 b) (+ 12 b)))
     OP-UN (gn-emit M (enc-mvn (+ 11 b) (+ 11 b)))
     OP-CALL (gn-emit M (gn-e-bf 0xd3400000 (+ 11 b) (+ 11 b) 0
                   (dec (bit-and (gn-scalar-mask M j a (gn-sir M j IF-C)) 255))))
     OP-RET (gn-mov M dst (+ 11 a))
     (gn-err M E-GEN-OP tag)) (inc j) end args dst))))
;; sc-admit bounds the complete straightline body to64 instructions.
;; Every admitted helper has exactly one public entry charge; its terminal
;; low-bit mask is uncharged. No branch, foreign effect or QUOT is admitted.
(defn- sc-charge-count [M :vector-i64 j :i64 end :i64 charges :i64] :i64
 (if (= j end) charges
  (sc-charge-count M (inc j) end (+ charges (if (= (gn-op M j) OP-CALL) 1 0)))))
;; enough=true means the complete entry/helper budget is already paid.
;; Only sc-entry sufficient-budget path selects it; no charge is emitted.
(defn- sc-charge [M :vector-i64 enough :bool] :vector-i64
 (if enough M (gn-op-fuel M)))
(defn- sc-emit-body [M :vector-i64 j :i64 end :i64 enough :bool] :vector-i64
 (if (= j end) M
  (let [tag (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
   (sc-emit-body
    (case tag
     OP-LABEL M
     OP-LGET (gn-mov M a (+ 8 b))
     OP-CONST (gn-mov-imm M a b)
     OP-BIN (gn-emit M (gn-bin-word a b b (inc b)))
     OP-UN (gn-emit M (enc-mvn b b))
     OP-CALL (sc-helper-emit (sc-charge M enough) (+ (gn-fnf M a FF-SIR) 2)
                      (sc-helper M a (gn-sir M j IF-C)) b b)
     OP-RET (gn-emit M (enc-ret))
     (gn-err M E-GEN-OP tag)) (inc j) end enough))))
;; Complete-budget pure straightline preflight. The sufficient path
;; prepays its exact entry/helper charges once; no observer or possible
;; language trap remains. Insufficient fuel keeps original mode2 charges.
;; CPU/wall emergency interruption is outside language semantics.
;; Full-i64 identity, 0<=n<=32: low32((x>>n)|(x<<(32-n)))
;; equals low32(ROR64(x|(x<<32),n)). No masked-input assumption.
(defn- rr-helper [M :vector-i64 f :i64] :bool
 (let [end (sc-helper M f 2) p (gn-fnf M f FF-SIR) q (gn-skiplab M (+ p 2))]
  (and (> end 0) (= end (+ q 11))
   (gn-dot-at? M q OP-LGET 0 1 0)
   (gn-dot-at? M (+ q 1) OP-LGET 1 2 0)
   (gn-dot-at? M (+ q 2) OP-BIN BOP-USHR 0 0)
   (gn-dot-at? M (+ q 3) OP-LGET 1 1 0)
   (gn-dot-at? M (+ q 4) OP-CONST 2 32 0)
   (gn-dot-at? M (+ q 5) OP-LGET 3 2 0)
   (gn-dot-at? M (+ q 6) OP-BIN BOP-SUB 2 0)
   (gn-dot-at? M (+ q 7) OP-BIN BOP-SHL 1 0)
   (gn-dot-at? M (+ q 8) OP-BIN BOP-OR 0 0)
   (= (gn-op M (+ q 9)) OP-CALL)
   (= (gn-sir M (+ q 9) IF-B) 0) (= (gn-sir M (+ q 9) IF-C) 1)
   (= (gn-scalar-mask M (+ q 9) (gn-sir M (+ q 9) IF-A) 1) 32)
   (gn-dot-at? M (+ q 10) OP-RET 0 0 0)
   (gn-dot-at? M (+ q 11) OP-END f 0 0))))
(defn- rr-call [M :vector-i64 j :i64] :bool
 (let [b (gn-sir M j IF-B) shift (gn-sir M (dec j) IF-B)]
  (and (> j 2) (= (gn-op M j) OP-CALL) (= (gn-sir M j IF-C) 2)
   (>= shift 0) (<= shift 32)
   (gn-dot-at? M (- j 2) OP-LGET b 1 0)
   (gn-dot-at? M (dec j) OP-CONST (inc b) shift 0)
   (rr-helper M (gn-sir M j IF-A)))))
(defn- rr-calls [M :vector-i64 j :i64 end :i64 count :i64] :i64
 (if (= j end) count
  (if (= (gn-op M j) OP-CALL)
   (if (rr-call M j) (rr-calls M (inc j) end (inc count)) 0)
   (rr-calls M (inc j) end count))))
;; Owned rr bodies have at most64 pure SIR nodes. This is physical low-bank
;; dead-write elimination, not an assumption about caller-scratch trap state.
(defn- rr-overwritten [M :vector-i64 j :i64 end :i64 r :i64] :bool
 (loop [p j work 64]
  (if (or (<= work 0) (>= p end) (<= p 0)
          (>= p (vector-at M MM-SIR-N)) (< r 0) (> r 6)) false
   (let [op (gn-op M p) a (gn-sir M p IF-A) b (gn-sir M p IF-B)]
    (case op
     OP-LGET (if (= a r) true (recur (inc p) (dec work)))
     OP-CONST (if (= a r) true (recur (inc p) (dec work)))
     OP-BIN (if (or (= b r) (= (inc b) r)) false (recur (inc p) (dec work)))
     OP-UN (if (= b r) false (recur (inc p) (dec work)))
     OP-CALL (if (not (rr-call M p)) false
               (if (= b r) true (recur (inc p) (dec work))))
     false)))))
(defn- rr-setup-dead [M :vector-i64 j :i64 end :i64] :bool
 (if (or (<= j 0) (>= end (vector-at M MM-SIR-N)) (>= j end)) false
  (let [op (gn-op M j) a (gn-sir M j IF-A)]
   (and (>= a 0) (<= a 6)
    (case op
     OP-LGET (and (< (+ j 2) end) (rr-call M (+ j 2)))
     OP-CONST (and (< (inc j) end) (rr-call M (inc j))
                    (rr-overwritten M (+ j 2) end a))
     false)))))
;; Semantic low32 facts belong only to the already certified, prepaid RR body.
;; No fact assumes that the original I64 argument has clear high bits.
(defn- rr-low-domain [M :vector-i64 begin :i64 end :i64] :bool
 (and (>= (vector-count M) MM-WORDS) (> begin 2) (> end begin) (<= (- end begin) 64)
  (> (vector-at M MM-SIR-N) end) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)))
(defn- rr-low-facts [M :vector-i64 begin :i64 at :i64 end :i64] :i64
 (if (or (not (rr-low-domain M begin end)) (< at begin) (>= at end)) -1
  (loop [j begin facts 0]
   (if (= j at) facts
    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
     (case op
      OP-LABEL (if (= j begin) (recur (inc j) facts) -1)
      OP-LGET (if (and (>= a 0) (<= a 6))
                (recur (inc j) (bit-and facts (bit-not (i64-shift-left 1 a)))) -1)
      OP-CONST (if (and (>= a 0) (<= a 6))
                 (recur (inc j) (bit-and facts (bit-not (i64-shift-left 1 a)))) -1)
      OP-BIN (if (and (>= b 0) (< b 6))
       (let [bits (i64-shift-left 3 b) clean (bit-and facts (bit-not bits))]
        (recur (inc j) (if (and (= a BOP-XOR) (= (bit-and facts bits) bits))
                         (bit-or clean (i64-shift-left 1 b)) clean))) -1)
      OP-UN (if (and (>= b 0) (<= b 6))
               (recur (inc j) (bit-and facts (bit-not (i64-shift-left 1 b)))) -1)
      OP-CALL (if (and (>= b 0) (< b 6) (rr-call M j))
                (recur (inc j) (bit-or (bit-and facts (bit-not (i64-shift-left 3 b)))
                                     (i64-shift-left 1 b))) -1)
      -1))))))
(defn- rr-xor32 [M :vector-i64 begin :i64 j :i64 end :i64] :bool
 (if (or (not (rr-low-domain M begin end)) (< j begin) (>= j end)) false
  (let [b (gn-sir M j IF-B) facts (rr-low-facts M begin j end)]
   (and (= (gn-op M j) OP-BIN) (= (gn-sir M j IF-A) BOP-XOR)
        (>= b 0) (< b 6) (>= facts 0)
        (= (bit-and facts (i64-shift-left 3 b)) (i64-shift-left 3 b))))))
;; First use must be the narrow XOR. Its lhs is restored by EORW itself;
;; its popped rhs must reach a retained physical kill before any observer.
;; Forward-only dead setup chains terminate at retained EXTR or setup.
;; A future EXTR can defer its own mask only under the same finite proof.
(defn- rr-mask-dead [M :vector-i64 begin :i64 j :i64 end :i64] :bool
 (if (or (not (rr-low-domain M begin end)) (< j begin) (>= j end)) false
  (let [r (gn-sir M j IF-B)]
   (if (or (< r 0) (> r 6) (not (rr-call M j))) false
    (loop [p (inc j)]
     (if (>= p end) false
      (let [op (gn-op M p) a (gn-sir M p IF-A) b (gn-sir M p IF-B)]
       (case op
        OP-LGET (if (= a r) false (recur (inc p)))
        OP-CONST (if (= a r) false (recur (inc p)))
        OP-BIN (if (or (= b r) (= (inc b) r))
                 (and (rr-xor32 M begin p end)
                      (or (= b r) (rr-overwritten M (inc p) end r)))
                 (recur (inc p)))
        OP-UN (if (= b r) false (recur (inc p)))
        OP-CALL (if (or (not (rr-call M p)) (= b r)) false (recur (inc p)))
        false))))))))
(defn- rr-emit-low [M :vector-i64 j :i64 end :i64 begin :i64] :vector-i64
 (if (= j end) M
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
   (rr-emit-low
    (case op
     OP-LABEL M
     OP-LGET (if (rr-setup-dead M j end) M (gn-mov M a (+ 8 b)))
     OP-CONST (if (rr-setup-dead M j end) M (gn-mov-imm M a b))
     OP-BIN (gn-emit M (if (rr-xor32 M begin j end)
                         (bit-and (enc-eor-r b b (inc b)) 0x7fffffff)
                         (gn-bin-word a b b (inc b))))
     OP-UN (gn-emit M (enc-mvn b b))
     OP-CALL (let [m (gn-emit M (+ (enc-rrr 0x93c00000 b 10 10)
                                 (* (gn-sir M (dec j) IF-B) 1024)))]
                (if (rr-mask-dead M begin j end) m
                 (gn-emit m (gn-e-bf 0xd3400000 b b 0 31))))
     OP-RET (gn-emit M (enc-ret))
     (gn-err M E-GEN-OP op)) (inc j) end begin))))
(defn- rr-emit [M :vector-i64 j :i64 end :i64] :vector-i64
 (rr-emit-low M j end j))

(defn- sc-entry [M :vector-i64 i :i64 f :i64 n :i64 end :i64] :vector-i64
 (let [charges (sc-charge-count M (+ i 2) end 1)
       base (-> M (gn-put (+ MM-FN-BASE (* f MM-FN-W) FF-CODE) (vector-at M MM-CODE-N))
        (gn-gs gn-f-ctx 1) (gn-gs gn-f-freg 2) (gn-emit (enc-ldr 8 7 CTX-FUEL)))
       out (if (< charges 3)
        (-> base (gn-op-fuel) (sc-copy-params 0 n) (sc-emit-body (+ i 2) end false))
        (let [cmp (gn-emit base (enc-cmp-i 8 charges)) at (vector-at cmp MM-CODE-N)
              start (gn-emit cmp (enc-bcond (enc-cond-lo) 0))
              fast-base (-> start (gn-emit (enc-sub-i 8 8 charges))
                   (gn-emit (enc-str 8 7 CTX-FUEL)) (sc-copy-params 0 n))
              fast (if (and (= n 1) (>= (rr-calls M (+ i 2) end 0) 2))
                (rr-emit (gn-emit fast-base (+ (enc-orr-r 10 9 9) 32768)) (+ i 2) end)
                (sc-emit-body fast-base (+ i 2) end true))
              fallback (vector-at fast MM-CODE-N)
              patched (gn-put fast (+ MM-CODE-BASE at) (enc-bcond (enc-cond-lo) (- fallback at)))]
         (-> patched (gn-op-fuel) (sc-copy-params 0 n) (sc-emit-body (+ i 2) end false))))]
  (-> out (gn-gs gn-f-dead 0) (gn-gs gn-f-skip (- end i 1)))))

(defn- gn-op-fn [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
  (let [reduction (sr-admit M i f np)]
    (if (> reduction 0) (sr-entry M i f np reduction)
    (let [composition (sc-admit M i f np)]
     (if (> composition 0) (sc-entry M i f np composition)
  (let [ns0 (gn-max (gn-max (gn-sir M i IF-C) (gn-fnf M f FF-NSLOTS)) (gn-max np (gn-scan M (inc i) 2 0)))
        dp0 (gn-max (gn-fnf M f FF-DEPTH) (gn-scan M (inc i) 1 0))]
    (if (or (>= ns0 gn-cap) (>= dp0 gn-cap))
      (gn-err M E-GEN-FRAME (+ ns0 dp0))
      (gn-op-fn2 (-> M
                     (gn-zero gn-f-leaf gn-a-sreg)
                     (gn-zero gn-a-sreg (+ gn-a-sreg ns0 1))
                     (gn-zero gn-a-use (+ gn-a-use ns0 1))
                     (gn-zero gn-a-dk (+ gn-a-dk dp0 1))
                     (gn-gs gn-f-leaf 1)
                     (gn-gs gn-f-ns ns0)
                     (gn-gs gn-f-dp dp0)
                     (gn-pre (inc i)))
                 i f np))))))))
;; Terminal-only mode2: low local registers with original published fuel.
;; Mode1 remains private-fuel leaf; mode0 remains ordinary nonleaf.
(defn- gn-small-type [ty :i64] :bool
 (or (= ty TY-I64) (= ty TY-BOOL) (= ty TY-STR) (= ty TY-VEC)
     (= ty TY-BYTES) (= ty TY-KW) (= ty TY-DOC) (= ty TY-SYM)))
(defn- gn-small-end [M :vector-i64 j :i64 f :i64 work :i64] :i64
 (cond (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) 0
       (= (gn-op M j) OP-END) (if (and (= (gn-sir M j IF-A) f)
        (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) 0)) j 0)
       (= (gn-op M j) OP-FN) 0
       :else (gn-small-end M (inc j) f (dec work))))
(defn- gn-small-label [M :vector-i64 j :i64 l :i64 found :i64] :i64
 (cond (or (<= l 0) (>= l MM-LABEL-CAP)) 0
       (>= j (vector-at M MM-SIR-N)) found
       (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) l))
       (if (> found 0) 0 (gn-small-label M (inc j) l j))
       :else (gn-small-label M (inc j) l found)))
(defn- gn-small-owned [M :vector-i64 start :i64 end :i64 l :i64] :bool
 (let [p (gn-small-label M 1 l 0)] (and (> p start) (< p end))))
(defn- gn-small-callee [M :vector-i64 f :i64 n :i64] :bool
 (let [p (gn-fnf M f FF-SIR)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (> p 0) (< p (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) n)
       (= (gn-fnf M f FF-NPARAMS) n) (gn-small-type (gn-fnf M f FF-RTYPE)))))
(defn- gn-small-params [M :vector-i64 f :i64 k :i64 n :i64] :bool
 (or (= k n) (and (gn-small-type (gn-fnf M f (+ FF-PT0 k)))
                  (gn-small-params M f (inc k) n))))
;; Exact forward join returns this call's single result without an effect.
;; Locate the owning FN within256 instructions; the join is unique, local,
;; within16 instructions, and immediately followed by RET result / END owner.
;; Other branch bodies remain original source and are not consumed.
(defn- jt-owner [M :vector-i64 j :i64 work :i64] :i64
 (cond (or (< j 0) (<= work 0)) -1
       (= (gn-op M j) OP-FN) j
       (= (gn-op M j) OP-END) -1
       :else (jt-owner M (dec j) (dec work))))
;; The fallthrough LABEL/RET/END alternative has no emitted effect. Its
;; unique label is owned by this same FN; other predecessor paths still use
;; their original shared LABEL/RET. Every original FUEL remains unchanged.
(defn- jt-return [M :vector-i64 i :i64 t :i64] :bool
 (let [sn (vector-at M MM-SIR-N)]
  (if (or (< i 1) (>= i (- sn 4)) (> sn MM-SIR-CAP)) false
   (let [f (gn-sir M i IF-A) n (gn-sir M i IF-C)]
  (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP)
          (< t 0) (>= t gn-cap) (not= (gn-sir M i IF-B) t)
          (< n 0) (> n 1) (not (gn-small-callee M f n))
          (not= (gn-op M i) OP-CALL) (not (or (= (gn-op M (inc i)) OP-BR) (= (gn-op M (inc i)) OP-LABEL)))
          (not= (gn-sir M (inc i) IF-B) 0) (not= (gn-sir M (inc i) IF-C) 0)) false
   (let [p (jt-owner M (dec i) 256) l (gn-sir M (inc i) IF-A)
         j (if (and (> l 0) (< l MM-LABEL-CAP)) (gn-small-label M 1 l 0) 0)]
    (and (>= p 0) (>= j (inc i)) (<= j (+ i 16)) (< (+ j 2) sn)
         (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) l)
         (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) 0)
         (= (gn-op M (inc j)) OP-RET) (= (gn-sir M (inc j) IF-A) t)
         (= (gn-sir M (inc j) IF-B) 0) (= (gn-sir M (inc j) IF-C) 0)
         (= (gn-op M (+ j 2)) OP-END)
         (= (gn-sir M (+ j 2) IF-A) (gn-sir M p IF-A))
         (= (gn-small-end M (inc p) (gn-sir M p IF-A) 256) (+ j 2)))))))))
(defn- gn-small-call [M :vector-i64 j :i64 ty :i64] :bool
 (let [f (gn-sir M j IF-A) t (gn-sir M j IF-B) n (gn-sir M j IF-C)
       w (gn-call-wrapper M j f t n)]
  (and (>= n 0) (<= n 3) (gn-small-callee M f n) (gn-small-params M f 0 n)
   (or (> w 0)
       (and (<= n 1) (= (gn-fnf M f FF-RTYPE) ty)
            (or (and (= (gn-op M (inc j)) OP-RET) (= (gn-sir M (inc j) IF-A) t)
                     (= (gn-sir M (inc j) IF-B) 0) (= (gn-sir M (inc j) IF-C) 0))
                (jt-return M j t)))))))
(defn- gn-small-scan [M :vector-i64 j :i64 start :i64 end :i64 ty :i64] :bool
 (if (= j end) true
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
   (and (case op
      (OP-CONST OP-LGET OP-LSET OP-BIN OP-CMP OP-UN OP-RET) true
      OP-FUEL (and (= a 0) (= b 0) (= c 0))
      OP-LABEL (and (= b 0) (= c 0) (= (gn-small-label M 1 a 0) j))
      OP-BR (and (= b 0) (= c 0) (gn-small-owned M start end a))
      (OP-BRZ OP-BRNZ) (and (= c 0) (gn-small-owned M start end b))
      OP-RT (gn-inl a b c)
      OP-CALL (gn-small-call M j ty)
      false)
    (gn-small-scan M (inc j) start end ty)))))
(defn- gn-small-tail [M :vector-i64 i :i64 f :i64 np :i64] :bool
 (let [end (gn-small-end M (inc i) f 4096) ty (gn-fnf M f FF-RTYPE)]
  (and (= (gn-g M gn-f-leaf) 0) (>= np 0) (<= np 1)
       (>= (gn-g M gn-f-ns) np) (<= (gn-g M gn-f-ns) 7)
       (<= (gn-g M gn-f-dp) 7) (= (gn-g M gn-f-out) 0)
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) i) (= (gn-fnf M f FF-NPARAMS) np)
       (= (gn-fnf M f FF-NSLOTS) (gn-g M gn-f-ns))
       (= (gn-fnf M f FF-DEPTH) (gn-g M gn-f-dp))
       (gn-small-type ty) (gn-small-params M f 0 np)
       (> end i) (gn-small-scan M (inc i) i end ty))))
;; Frame-free first guarded read, with exact identity-return rejection.
;; Only incoming parameters and x10/x11/x16/x17 are used. The original entry
;; charge publishes before the read; success skips exactly that SIR FUEL.
(defn- gp-shape [M :vector-i64 i :i64 f :i64 np :i64] :bool
 (let [v (gn-sir M (+ i 3) IF-B) rhs (gn-sir M (+ i 6) IF-B)
       cc (gn-sir M (+ i 7) IF-A) l (gn-sir M (+ i 8) IF-B)
       target (if (and (> l 0) (< l MM-LABEL-CAP)) (gn-thread M l 0 0 8) 0)
       p (if (> target 0) (gn-skiplab M (inc (gn-lpos M target))) 0)
       q (if (> p 0) (gn-skiplab M (inc p)) 0)]
  (and (> np 0) (<= np 7) (< (+ i 8) (vector-at M MM-SIR-N))
       (= (gn-g M gn-f-leaf) 0) (> (gn-g M gn-f-fb) 0)
       (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-freg) 0)
       (= (gn-fnf M f FF-RTYPE) TY-VEC) (> v 0) (<= v np)
       (= (gn-fnf M f (+ FF-PT0 (dec v))) TY-VEC)
       (= (gn-op M (inc i)) OP-FUEL)
       (= (gn-op M (+ i 2)) OP-LABEL)
       (= (gn-op M (+ i 3)) OP-LGET) (= (gn-sir M (+ i 3) IF-A) 0)
       (= (gn-sir M (+ i 3) IF-C) 0)
       (= (gn-op M (+ i 4)) OP-CONST) (= (gn-sir M (+ i 4) IF-A) 1)
       (= (gn-sir M (+ i 4) IF-C) 0)
       (= (gn-op M (+ i 5)) OP-RT) (= (gn-sir M (+ i 5) IF-A) RT-VECTOR-AT)
       (= (gn-sir M (+ i 5) IF-B) 0) (= (gn-sir M (+ i 5) IF-C) 2)
       (= (gn-op M (+ i 6)) OP-LGET) (= (gn-sir M (+ i 6) IF-A) 1)
       (= (gn-sir M (+ i 6) IF-C) 0) (> rhs 0) (<= rhs np) (not= v rhs)
       ;; Integer CMP in the original checked SIR establishes bitwise ABI use;
       ;; FF-PT0..4 does not describe private parameters six and seven.
       (= (gn-op M (+ i 7)) OP-CMP) (= (gn-sir M (+ i 7) IF-B) 0)
       (= (gn-sir M (+ i 7) IF-C) 0) (>= cc CC-EQ) (<= cc CC-GE)
       (= (gn-op M (+ i 8)) OP-BRZ) (= (gn-sir M (+ i 8) IF-A) 0)
       (= (gn-sir M (+ i 8) IF-C) 0) (> p (+ i 8)) (> q p)
       (= (gn-op M p) OP-LGET) (= (gn-sir M p IF-A) 0)
       (= (gn-sir M p IF-B) v) (= (gn-sir M p IF-C) 0)
       (= (gn-op M q) OP-RET) (= (gn-sir M q IF-A) 0)
       (= (gn-sir M q IF-B) 0) (= (gn-sir M q IF-C) 0))))
(defn- gp-retpath [M :vector-i64 p :i64 work :i64] :bool
 (if (or (<= p 0) (<= work 0) (>= p (vector-at M MM-SIR-N))) false
 (let [j (gn-skiplab M p)]
  (if (= (gn-op M j) OP-BR)
   (gp-retpath M (gn-lpos M (gn-sir M j IF-A)) (dec work))
   (and (= (gn-op M j) OP-RET) (= (gn-sir M j IF-A) 0)
        (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) 0))))))
(defn- gp-identity [M :vector-i64 p :i64 slot :i64 work :i64] :bool
 (if (or (<= p 0) (<= work 0) (>= p (vector-at M MM-SIR-N))) false
 (let [j (gn-skiplab M p) q (gn-skiplab M (inc j))]
  (cond (= (gn-op M j) OP-BR) (gp-identity M (gn-lpos M (gn-sir M j IF-A)) slot (dec work))
        :else (and (= (gn-op M j) OP-LGET) (= (gn-sir M j IF-A) 0)
                   (= (gn-sir M j IF-B) slot) (= (gn-sir M j IF-C) 0)
                   (gp-retpath M q 16))))))
(defn- gp-readslot [M :vector-i64 j :i64 t :i64 work :i64] :i64
 (if (or (<= j 0) (<= work 0)) 0
 (let [op (gn-op M j) d (gn-defd M j)]
  (cond (or (= op OP-FN) (= op OP-LABEL) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ)) 0
        (and (>= d 0) (<= d t)) (if (and (= d t) (= op OP-LGET)) (gn-sir M j IF-B) 0)
        :else (gp-readslot M (dec j) t (dec work))))))
(defn- gp-findcall [M :vector-i64 j :i64 f :i64 found :i64 work :i64] :i64
 (if (or (<= work 0) (>= j (vector-at M MM-SIR-N))) 0
 (case (gn-op M j)
  OP-END (if (= (gn-sir M j IF-A) f) found 0)
  OP-FN 0
  OP-CALL (if (> found 0) 0 (gp-findcall M (inc j) f j (dec work)))
  (gp-findcall M (inc j) f found (dec work)))))
(defn- gp-pure [M :vector-i64 j :i64 i :i64 call :i64 f :i64 np :i64 slot :i64 work :i64] :bool
 (if (or (<= work 0) (>= j (vector-at M MM-SIR-N))) false
 (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
       branch (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ))
       target (if (= op OP-BR) a b) pos (if branch (gn-lpos M target) 0)
       valid (cond (= op OP-END) (= a f)
        (= j call) (and (= op OP-CALL) (<= c 4) (> a 0))
        (> j call) (or (= op OP-LABEL) (= op OP-BR) (= op OP-RET)
                      (and (= op OP-LGET) (= a 0) (= b slot) (= c 0)))
        (= op OP-LGET) (and (>= a 0) (< a 4) (> b 0) (<= b (gn-g M gn-f-ns)))
        (= op OP-LSET) (and (> a np) (<= a (gn-g M gn-f-ns)) (>= b 0) (< b 4))
        (= op OP-CONST) (and (>= a 0) (< a 4))
        (= op OP-BIN) (and (or (= a BOP-ADD) (= a BOP-SUB) (= a BOP-MUL)
                               (= a BOP-AND) (= a BOP-OR) (= a BOP-XOR)) (>= b 0) (< b 3))
        (= op OP-CMP) (and (>= a CC-EQ) (<= a CC-GE) (>= b 0) (< b 3))
        (= op OP-RT) (and (= a RT-VECTOR-AT) (= c 2) (>= b 0) (< b 3)
                          (= (gp-readslot M (dec j) b 64) slot))
        (or (= op OP-LABEL) branch) true
        :else false)]
  (and valid
       (or (not branch) (and (> pos j) (sl-label-valid M target i (sl-end M (inc i) f 256))
        (or (<= pos call) (> j call) (gp-identity M pos slot 16))))
       (if (= op OP-END) true (gp-pure M (inc j) i call f np slot (dec work)))))))
(defn- gp-prefix? [M :vector-i64 i :i64 f :i64 np :i64] :i64
 (let [call (gp-findcall M (inc i) f 0 256) ns (gn-g M gn-f-ns)]
  (if (and (gp-shape M i f np) (> call (+ i 8)) (<= (gn-g M gn-f-dp) 4)
           (<= ns (+ np 2)) (<= (gn-sir M (+ i 3) IF-B) 5)
           (gp-pure M (+ i 3) i call f np (gn-sir M (+ i 3) IF-B) 256)) call 0)))
(defn- gp-save-state [M :vector-i64] :vector-i64
 (let [ns (gn-g M gn-f-ns) dp (gn-g M gn-f-dp)
       b0 (vector-alloc (+ 18 ns (* 2 dp)))
       b1 (loop [B b0 k 0] (if (= k 16) B (recur (vector-assoc! B k (gn-g M k)) (inc k))))
       b2 (loop [B b1 k 1] (if (> k ns) B (recur (vector-assoc! B (+ 15 k) (gn-g M (+ gn-a-sreg k))) (inc k))))
       b3 (loop [B b2 k 0] (if (= k dp) B (recur (-> B
           (vector-assoc! (+ 16 ns k) (gn-g M (+ gn-a-dk k)))
           (vector-assoc! (+ 16 ns dp k) (gn-g M (+ gn-a-dv k)))) (inc k))))]
  (vector-assoc! b3 (+ 16 ns (* 2 dp)) (gn-g M cc-proof))))
(defn- gp-restore [M :vector-i64 B :vector-i64] :vector-i64
 (let [ns (vector-at B gn-f-ns) dp (vector-at B gn-f-dp)
       m0 (loop [current M k 0] (if (= k 16) current (recur (gn-gs current k (vector-at B k)) (inc k))))
       m1 (loop [current m0 k 1] (if (> k ns) current (recur (gn-gs current (+ gn-a-sreg k) (vector-at B (+ 15 k))) (inc k))))
       m2 (loop [current m1 k 0] (if (= k dp) current (recur (-> current
           (gn-gs (+ gn-a-dk k) (vector-at B (+ 16 ns k)))
           (gn-gs (+ gn-a-dv k) (vector-at B (+ 16 ns dp k)))) (inc k))))]
  (gn-gs m2 cc-proof (vector-at B (+ 16 ns (* 2 dp))))))
;; The exact prefix certificate has no writes, calls or allocation, and every
;; read is rooted in the unchanged incoming vector. Its first original access
;; captures descriptor/base into unused x8/x15; later index guards still execute.
(defn- gp-read [M :vector-i64 i :i64 t :i64 first :bool] :vector-i64
 (let [m0 (gn-pin M (inc t)) ri (gn-pinned m0 (inc t))
       rv (gn-src m0 t 17 0) s (gn-co m0 i t) d (gn-dreg m0 t s)
       m1 (gn-protect m0 t s)
       m2 (if first (-> m1 (gn-ldt t 17 0) (gn-hchk rv 312 320)
            (gn-emit (enc-ldp 17 8 16 0)) (gn-emit (enc-ldr 15 7 328))
            (gn-emit (gn-e-addsl 15 15 17 3))) m1)]
  (-> m2 (gn-emit (enc-cmp-r ri 8)) (gn-emit (enc-bcond (enc-cond-lo) 2))
         (gn-emit (gn-e-udf)) (gn-emit (gn-e-ldrr d 15 ri 1)) (gn-fin t s d))))
(defn- gp-emit [M :vector-i64 j :i64 call :i64 success :i64 B :vector-i64 first :i64] :vector-i64
 (cond (= (gn-op M j) OP-END) (let [v (vector-assoc! B (dec (vector-count B)) success)] M)
       (= j call) (let [at (vector-at M MM-CODE-N)] (gp-emit (-> M (gn-emit (enc-b 0)) (gn-gs gn-f-dead 1)) (inc j) call at B first))
       :else (let [m1 (if (= (gn-op M j) OP-RT) (gp-read M j (gn-sir M j IF-B) (= j first)) (gn-ins M j (gn-op M j))) skip (gn-g m1 gn-f-skip)]
               (gp-emit (gn-gs m1 gn-f-skip 0) (+ j 1 skip) call success B first))))
(defn- nr-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 73) true (let [one (gn-sir M (+ p 4) IF-B) two (gn-sir M (+ p 10) IF-B)
  add (gn-sir M (+ p 12) IF-B) limit (gn-sir M (+ p 14) IF-B)
  base (gn-sir M (+ p 18) IF-B) callee (gn-sir M (+ p 62) IF-A)]
  (and (case k
    0 (gn-dot-at? M (+ p 0) 1 f 7 9)
    1 (gn-dot-at? M (+ p 1) 18 0 0 0)
    2 (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
    3 (gn-dot-at? M (+ p 3) 4 0 1 0)
    4 (gn-dot-at? M (+ p 4) 3 1 one 0)
    5 (gn-dot-at? M (+ p 5) 14 176 0 2)
    6 (gn-dot-at? M (+ p 6) 4 1 6 0)
    7 (gn-dot-at? M (+ p 7) 7 5 0 0)
    8 (gn-dot-at? M (+ p 8) 11 0 (gn-sir M (+ p 40) IF-A) 0)
    9 (gn-dot-at? M (+ p 9) 4 0 1 0)
    10 (gn-dot-at? M (+ p 10) 3 1 two 0)
    11 (gn-dot-at? M (+ p 11) 14 176 0 2)
    12 (gn-dot-at? M (+ p 12) 3 1 add 0)
    13 (gn-dot-at? M (+ p 13) 6 1 0 0)
    14 (gn-dot-at? M (+ p 14) 3 1 limit 0)
    15 (gn-dot-at? M (+ p 15) 7 4 0 0)
    16 (gn-dot-at? M (+ p 16) 11 0 (gn-sir M (+ p 40) IF-A) 0)
    17 (gn-dot-at? M (+ p 17) 4 0 1 0)
    18 (gn-dot-at? M (+ p 18) 3 1 base 0)
    19 (gn-dot-at? M (+ p 19) 4 2 3 0)
    20 (gn-dot-at? M (+ p 20) 6 1 1 0)
    21 (gn-dot-at? M (+ p 21) 14 176 0 2)
    22 (gn-dot-at? M (+ p 22) 4 1 1 0)
    23 (gn-dot-at? M (+ p 23) 3 2 base 0)
    24 (gn-dot-at? M (+ p 24) 4 3 4 0)
    25 (gn-dot-at? M (+ p 25) 6 1 2 0)
    26 (gn-dot-at? M (+ p 26) 14 176 1 2)
    27 (gn-dot-at? M (+ p 27) 7 1 0 0)
    28 (gn-dot-at? M (+ p 28) 11 0 (gn-sir M (+ p 40) IF-A) 0)
    29 (gn-dot-at? M (+ p 29) 4 0 1 0)
    30 (gn-dot-at? M (+ p 30) 3 1 base 0)
    31 (gn-dot-at? M (+ p 31) 4 2 3 0)
    32 (gn-dot-at? M (+ p 32) 6 1 1 0)
    33 (gn-dot-at? M (+ p 33) 14 176 0 2)
    34 (gn-dot-at? M (+ p 34) 4 1 1 0)
    35 (gn-dot-at? M (+ p 35) 3 2 base 0)
    36 (gn-dot-at? M (+ p 36) 4 3 5 0)
    37 (gn-dot-at? M (+ p 37) 6 1 2 0)
    38 (gn-dot-at? M (+ p 38) 14 176 1 2)
    39 (gn-dot-at? M (+ p 39) 7 1 0 0)
    40 (gn-dot-at? M (+ p 40) 9 (gn-sir M (+ p 40) IF-A) 0 0)
    41 (gn-dot-at? M (+ p 41) 11 0 (gn-sir M (+ p 68) IF-A) 0)
    42 (gn-dot-at? M (+ p 42) 4 0 1 0)
    43 (gn-dot-at? M (+ p 43) 3 1 base 0)
    44 (gn-dot-at? M (+ p 44) 4 2 2 0)
    45 (gn-dot-at? M (+ p 45) 6 1 1 0)
    46 (gn-dot-at? M (+ p 46) 14 176 0 2)
    47 (gn-dot-at? M (+ p 47) 5 8 0 0)
    48 (gn-dot-at? M (+ p 48) 4 0 1 0)
    49 (gn-dot-at? M (+ p 49) 3 1 base 0)
    50 (gn-dot-at? M (+ p 50) 4 2 3 0)
    51 (gn-dot-at? M (+ p 51) 6 1 1 0)
    52 (gn-dot-at? M (+ p 52) 14 176 0 2)
    53 (gn-dot-at? M (+ p 53) 5 9 0 0)
    54 (gn-dot-at? M (+ p 54) 4 0 9 0)
    55 (gn-dot-at? M (+ p 55) 4 1 8 0)
    56 (gn-dot-at? M (+ p 56) 7 3 0 0)
    57 (gn-dot-at? M (+ p 57) 11 0 (gn-sir M (+ p 64) IF-A) 0)
    58 (gn-dot-at? M (+ p 58) 4 0 1 0)
    59 (gn-dot-at? M (+ p 59) 4 1 8 0)
    60 (gn-dot-at? M (+ p 60) 4 2 9 0)
    61 (gn-dot-at? M (+ p 61) 4 3 7 0)
    62 (gn-dot-at? M (+ p 62) 13 callee 0 4)
    63 (gn-dot-at? M (+ p 63) 10 (gn-sir M (+ p 66) IF-A) 0 0)
    64 (gn-dot-at? M (+ p 64) 9 (gn-sir M (+ p 64) IF-A) 0 0)
    65 (gn-dot-at? M (+ p 65) 4 0 1 0)
    66 (gn-dot-at? M (+ p 66) 9 (gn-sir M (+ p 66) IF-A) 0 0)
    67 (gn-dot-at? M (+ p 67) 10 (gn-sir M (+ p 70) IF-A) 0 0)
    68 (gn-dot-at? M (+ p 68) 9 (gn-sir M (+ p 68) IF-A) 0 0)
    69 (gn-dot-at? M (+ p 69) 4 0 1 0)
    70 (gn-dot-at? M (+ p 70) 9 (gn-sir M (+ p 70) IF-A) 0 0)
    71 (gn-dot-at? M (+ p 71) 19 0 0 0)
    72 (gn-dot-at? M (+ p 72) 2 f 0 0)
    false) (nr-shape M p f (inc k))))))
(defn- nr-admit [M :vector-i64 i :i64 np :i64] :bool
 (let [f (gn-sir M i IF-A)]
  (and (= np 7) (= (gn-g M gn-f-ns) 9) (= (gn-g M gn-f-dp) 4)
   (< (+ i 72) (vector-at M MM-SIR-N))
   (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (>= (gn-sir M (+ i 4) IF-B) 0) (<= (gn-sir M (+ i 4) IF-B) 4095)
   (>= (gn-sir M (+ i 10) IF-B) 0) (<= (gn-sir M (+ i 10) IF-B) 4095)
   (>= (gn-sir M (+ i 18) IF-B) 0) (<= (gn-sir M (+ i 18) IF-B) 4095)
   (nr-shape M i f 0))))
(defn- nr-guard [M :vector-i64 P :vector-i64 k :i64 cc :i64] :vector-i64
 (let [p (vector-assoc! P k (vector-at M MM-CODE-N))] (gn-emit M (enc-bcond cc 0))))
(defn- nr-entry [M :vector-i64 i :i64 np :i64 P :vector-i64] :vector-i64
 (if (not (nr-admit M i np)) M
 (let [one (gn-sir M (+ i 4) IF-B) two (gn-sir M (+ i 10) IF-B)
   add (gn-sir M (+ i 12) IF-B) limit (gn-sir M (+ i 14) IF-B) base (gn-sir M (+ i 18) IF-B)
   m0 (-> M (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
    (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)) (nr-guard P 0 (enc-cond-hs))
    (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
    (gn-emit (enc-ldp 17 8 16 0)) (gn-emit (enc-ldr 15 7 328))
    (gn-emit (gn-e-addsl 15 15 17 3))
    (gn-mov-imm 9 (max one two)) (gn-emit (enc-cmp-r 9 8)) (nr-guard P 1 (enc-cond-hs)))
   m1 (loop [cur m0 k 1] (if (> k 4) cur
     (recur (-> cur (gn-mov-imm 9 base) (gn-emit (enc-add-r 9 k 9))
        (gn-emit (enc-cmp-r 9 8)) (nr-guard P (+ k 1) (enc-cond-hs))) (inc k))))
   m2 (-> m1 (gn-mov-imm 9 one) (gn-emit (gn-e-ldrr 9 15 9 1))
    (gn-emit (enc-cmp-r 9 5)) (nr-guard P 6 (enc-cond-lt))
    (gn-mov-imm 9 two) (gn-emit (gn-e-ldrr 9 15 9 1)) (gn-mov-imm 10 add)
    (gn-emit (enc-add-r 9 9 10)) (gn-mov-imm 10 limit) (gn-emit (enc-cmp-r 9 10)) (nr-guard P 7 (enc-cond-gt))
    (gn-mov-imm 11 base) (gn-emit (enc-add-r 11 2 11)) (gn-emit (gn-e-ldrr 10 15 11 1))
    (gn-mov-imm 11 base) (gn-emit (enc-add-r 11 3 11)) (gn-emit (gn-e-ldrr 11 15 11 1))
    (gn-emit (enc-cmp-r 10 11)) (nr-guard P 8 (enc-cond-ne))
    (gn-mov-imm 11 base) (gn-emit (enc-add-r 11 4 11)) (gn-emit (gn-e-ldrr 11 15 11 1))
    (gn-emit (enc-cmp-r 10 11)) (nr-guard P 9 (enc-cond-ne))
    (gn-mov-imm 11 base) (gn-emit (enc-add-r 11 1 11)) (gn-emit (gn-e-ldrr 11 15 11 1))
    (gn-emit (enc-cmp-r 10 11)) (nr-guard P 10 (enc-cond-le)))
   success (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-b 0)) fail (vector-at m3 MM-CODE-N)
   m4 (gn-emit m3 (enc-ret)) cold (vector-at m4 MM-CODE-N)
   marker (-> P (vector-assoc! 12 success) (vector-assoc! 13 1))]
  (loop [cur m4 k 0] (if (= k 11) cur
   (recur (gn-dot-patch cur (vector-at P k) (if (< k 6) cold fail)
      (case k 6 (enc-cond-lt) 7 (enc-cond-gt) 8 (enc-cond-ne) 9 (enc-cond-ne) 10 (enc-cond-le) (enc-cond-hs))) (inc k)))))))

(defn- gp-entry [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (let [call (gp-prefix? M i f np)]
  (if (= call 0) M
  (let [B (gp-save-state M) xf (vector-at M MM-FIX-N) ns (gn-g M gn-f-ns)
        m0 (-> M (gn-gs gn-f-leaf 1) (gn-gs gn-f-fb 0) (gn-gs gn-f-nsv 0)
             (gn-gs gn-f-freg 0) (gn-gs gn-f-ctx 1) (gn-gs cc-proof 1)
             (gn-gs gn-f-vslot 0) (gn-op-fuel))
        P (vector-alloc 14)
        m1 (loop [current m0 k 1] (if (> k ns) current
          (recur (gn-gs current (+ gn-a-sreg k) (if (<= k np) k (+ 13 (- k np)))) (inc k))))
        m2 (gp-emit (nr-entry m1 i np P) (+ i 3) call 0 B (+ i 5)) end (vector-at m2 MM-CODE-N) success (vector-at B (dec (vector-count B)))
        m3 (loop [current m2 k xf]
         (if (>= k (vector-at m2 MM-FIX-N)) current
          (let [at (sf-x current k XF-AT) target (sf-x current k XF-TARGET)
                to (vector-at current (+ MM-LABEL-BASE target))]
           (recur (gn-put current (+ MM-CODE-BASE at) (of-patch-word (sf-word current at) (- to at))) (inc k)))))
        m4 (-> m3 (gn-put (+ MM-CODE-BASE success) (enc-b (- end success))) (gn-put MM-FIX-N xf))
        m5 (if (= (vector-at P 13) 1) (gn-put m4 (+ MM-CODE-BASE (vector-at P 12)) (enc-b (- end (vector-at P 12)))) m4)]
   (-> (gp-restore m5 B) (gn-gs gn-f-skip 1))))))

(defn- se-admit [M :vector-i64 i :i64 f :i64 np :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP)
  (<= i 0) (> i (- (vector-at M MM-SIR-N) 17)) (gn-clamp-open M f)
  (not= np 2) (not= (gn-g M gn-f-ns) 2) (not= (gn-g M gn-f-dp) 2)
  (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
  (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-nsv) 2)
  (<= (gn-g M gn-f-fb) 0) (> (gn-g M gn-f-fb) 32768)
  (not (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1)))) false
  (let [l (gn-sir M (+ i 2) IF-A) le (gn-sir M (+ i 10) IF-A) lx (gn-sir M (+ i 14) IF-A)]
   (and (= (gn-fnf M f FF-SIR) i) (= (gn-fnf M f FF-NPARAMS) 2)
    (= (gn-fnf M f FF-NSLOTS) 2) (= (gn-fnf M f FF-DEPTH) 2)
    (= (gn-fnf M f FF-RTYPE) TY-I64) (= (gn-fnf M f FF-PT0) TY-STR)
    (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (>= (gn-sreg M 1) 19) (<= (gn-sreg M 1) 28)
    (>= (gn-sreg M 2) 19) (<= (gn-sreg M 2) 28) (not= (gn-sreg M 1) (gn-sreg M 2))
    (> l 0) (< l MM-LABEL-CAP) (> le 0) (< le MM-LABEL-CAP) (> lx 0) (< lx MM-LABEL-CAP)
    (not= l le) (not= l lx) (not= le lx)
    (= (gn-lpos M l) (+ i 2)) (= (gn-lpos M le) (+ i 10)) (= (gn-lpos M lx) (+ i 14))
    (gn-dot-at? M i OP-FN f 2 2) (gn-dot-at? M (+ i 1) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ i 2) OP-LABEL l 0 0) (gn-dot-at? M (+ i 3) OP-LGET 0 2 0)
    (gn-dot-at? M (+ i 4) OP-LGET 1 1 0) (gn-dot-at? M (+ i 5) OP-RT RT-STRING-LENGTH-VIA 1 1)
    (gn-dot-at? M (+ i 6) OP-CMP CC-EQ 0 0) (gn-dot-at? M (+ i 7) OP-BRZ 0 le 0)
    (gn-dot-at? M (+ i 8) OP-CONST 0 0 0) (gn-dot-at? M (+ i 9) OP-BR lx 0 0)
    (gn-dot-at? M (+ i 10) OP-LABEL le 0 0) (gn-dot-at? M (+ i 11) OP-LGET 0 1 0)
    (gn-dot-at? M (+ i 12) OP-LGET 1 2 0) (gn-dot-at? M (+ i 13) OP-RT RT-STRING-CODE-POINT-AT 0 2)
    (gn-dot-at? M (+ i 14) OP-LABEL lx 0 0) (gn-dot-at? M (+ i 15) OP-RET 0 0 0)
    (gn-dot-at? M (+ i 16) OP-END f 0 0)))))
(defn- se-entry [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (if (not (se-admit M i f np)) M
  (let [B (gp-save-state M) F (gn-g M gn-f-fb) G (vector-alloc 6)
    m0 (gn-emit M (enc-ldr 16 7 CTX-FUEL))
    z (vector-at m0 MM-CODE-N) m1 (gn-emit m0 (enc-cbnz 16 0))
    ;; Fuelzero reaches the identical savedframe/params/FUEL trap state.
    m2 (-> m1 (gn-emit (enc-stp-pre 29 30 31 -16)) (gn-emit (enc-mov-sp 29 31))
      (gn-subsp (bit-and F -4096)) (gn-subsp (bit-and F 4095))
      (gn-csave 0 (gn-g M gn-f-nsv) 0) (gn-st 7 0) (gn-params 1 np)
      (gn-gs gn-f-ctx 1) (gn-op-fuel))
    fast (vector-at m2 MM-CODE-N)
    m3 (-> (gp-restore m2 B) (gn-put (+ MM-CODE-BASE z) (enc-cbnz 16 (- fast z)))
      ;; x16 retains original nonzero fuel on this edge; every original check/store remains.
      (gn-emit (enc-subs-i 16 16 1)) (gn-emit (enc-str 16 7 CTX-FUEL))
      (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-ldr 9 7 288)) (gn-emit (enc-ldr 9 9 0))
      (gn-emit (enc-cmp-r 17 9)) (nr-guard G 0 (enc-cond-hs))
      (gn-emit (enc-ldr 9 7 296)) (gn-emit (gn-e-addsl 9 9 17 4)) (gn-emit (enc-ldp 8 9 9 0))
      (gn-emit (enc-cmp-r 1 9)) (nr-guard G 5 (enc-cond-eq))
      ;; TBNZsign preserves the index/length CMP flags through this guard.
      (nr-guard G 1 (enc-cond-lt)) (nr-guard G 2 (enc-cond-hs))
      (gn-emit (enc-add-r 9 8 9)) (gn-emit (enc-ldr 10 7 392))
      (gn-emit (enc-cmp-r 9 10)) (nr-guard G 3 8)
      (gn-emit (enc-ldr 10 7 CTX-CODE-BASE)) (gn-emit (enc-add-r 10 10 8))
      (gn-emit (gn-e-ldrb 11 10 1)) (gn-emit (enc-cmp-i 11 128)) (nr-guard G 4 (enc-cond-hs))
      (gn-emit (enc-mov-r 0 11)) (gn-emit (enc-ret)))
    endpoint (vector-at m3 MM-CODE-N)
    m4 (-> m3 (gn-emit (enc-mov-r 0 31)) (gn-emit (enc-ret)))
    cold (vector-at m4 MM-CODE-N)
    m5 (loop [cur m4 k 0] (if (= k 6) cur
      (recur (if (= k 1)
       ;; Owned short bank: TBNZ x8,#63, cold; signed imm14 words.
       (gn-put cur (+ MM-CODE-BASE (vector-at G k))
        (+ 3086483464 (i64-shift-left (bit-and (- cold (vector-at G k)) 16383) 5)))
       (gn-dot-patch cur (vector-at G k) (if (= k 5) endpoint cold)
        (case k 3 8 5 (enc-cond-eq) (enc-cond-hs)))) (inc k))))]
   (gn-gs m5 gn-f-skip 1))))

(defn- gn-op-fn2 [M1 :vector-i64 i :i64 f :i64 np :i64] :vector-i64
  (let [ns (gn-g M1 gn-f-ns)
        dp (gn-g M1 gn-f-dp)]
    (cond (> np 16) (gn-err M1 E-GEN-OP OP-FN)
          :else
          (let [MM (if (gn-small-tail M1 i f np) (gn-gs M1 gn-f-leaf 2) M1)
                M2 (sl-assign (gn-vmode (gn-assign MM) i) i f np)
                F (gn-g M2 gn-f-fb)
                leaf (gn-g M2 gn-f-leaf)]
            (if (> F 32768)
              (gn-err M2 E-GEN-FRAME (+ ns dp))
              (-> M2
                  (gn-put (+ MM-FN-BASE (* f MM-FN-W) FF-CODE) (vector-at M2 MM-CODE-N))
                  (trg-se-dispatch i f np)
                  (trg-gp-dispatch i f np)
                  (cond-> (> F 0) (-> (gn-emit (enc-stp-pre 29 30 31 -16))
                                      (gn-emit (enc-mov-sp 29 31))
                                      (gn-subsp (bit-and F -4096))
                                      (gn-subsp (bit-and F 4095))
                                      (gn-csave 0 (gn-g M2 gn-f-nsv) 0)))
                  (cond-> (= leaf 0) (gn-st 7 0))
                  (gn-params 1 np)
                  (cond-> (and (= leaf 1) (= (gn-g M2 gn-f-fuel) 1)) (-> (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-gs gn-f-freg 1)))
                  (gn-gs gn-f-ctx 1)
                  (gn-gs cc-proof (if (and (= leaf 0) (>= (cc-safe M2 f np 8 4096) 0)) 1 0))
                  (gn-gs gn-f-h 0) (sl-clear) (vi-clear)
                  ;; Publish every original charge; retain x8 within the certified
                  ;; frame-free small-tail body and across checked private tails.
                  (cond-> (and (= leaf 2) (= F 0) (= (gn-g M2 gn-f-fuel) 1))
                    (-> (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-gs gn-f-freg 2)))
                  (gn-gs gn-f-vslot (if (= (gn-g M2 gn-f-vmode) 2) -1 0)) (gn-tree-entry f) (eq-chain-entry f) (vl-entry i f np) (pf-entry i f np) (ve-entry i f np)))))))

(defn- gn-op-ret [M :vector-i64 t :i64] :vector-i64 (gn-epilogue (gn-into M 0 t)))
;; R5B: RET2 t -- x0 := temp t, x1 := temp t+1 (through x16: either source may be x0 or x1 in a leaf), then the epilogue
(defn- gn-op-ret2 [M :vector-i64 t :i64] :vector-i64 (-> M (gn-into 16 (inc t)) (gn-into 0 t) (gn-mov 1 16) (gn-epilogue)))
;; R5B: RES2 t (right after a CALL): temp t := x1, the CALL's second result register
(defn- gn-op-res2 [M :vector-i64 i :i64 t :i64] :vector-i64 (gn-take M i t 1))
;; the fuel store of a leaf, the frame and callee-saved restore, ret
(defn- gn-epilogue [M :vector-i64] :vector-i64
  (let [F (gn-g M gn-f-fb)]
    (-> M
        (cond-> (= (gn-g M gn-f-freg) 1) (gn-emit (enc-str 8 7 CTX-FUEL)))
        (cond-> (> F 0) (-> (gn-csave 0 (gn-g M gn-f-nsv) 1)
                            (gn-emit (enc-mov-sp 31 29))
                            (gn-emit (enc-ldp-post 29 30 31 16))))
        (gn-emit (enc-ret))
        (gn-gs gn-f-dead 1))))

;; A whole pure scalar threshold tree; return the exclusive SIR end or0.
;; Exact operands and actual branch target positions are checked recursively.
(defn- gn-tree-end [M :vector-i64 p :i64 depth :i64] :i64
  (if (or (> depth 7) (>= p (vector-at M MM-SIR-N))) 0
    (if (and (= (gn-op M p) OP-CONST) (= (gn-sir M p IF-A) 0) (= (gn-sir M p IF-C) 0)) (inc p)
      (if (and (= (gn-op M p) OP-LGET) (= (gn-sir M p IF-A) 0) (= (gn-sir M p IF-B) 1) (= (gn-sir M p IF-C) 0)
               (= (gn-op M (+ p 1)) OP-CONST) (= (gn-sir M (+ p 1) IF-A) 1) (= (gn-sir M (+ p 1) IF-C) 0)
               (>= (gn-sir M (+ p 1) IF-B) 0) (< (gn-sir M (+ p 1) IF-B) 64)
               (= (gn-op M (+ p 2)) OP-CMP) (or (= (gn-sir M (+ p 2) IF-A) CC-LT) (= (gn-sir M (+ p 2) IF-A) CC-EQ)) (= (gn-sir M (+ p 2) IF-B) 0) (= (gn-sir M (+ p 2) IF-C) 0)
               (= (gn-op M (+ p 3)) OP-BRZ) (= (gn-sir M (+ p 3) IF-A) 0) (= (gn-sir M (+ p 3) IF-C) 0))
        (let [a (gn-tree-end M (+ p 4) (inc depth)) le (gn-sir M (+ p 3) IF-B)]
          (if (and (> a 0) (= (gn-op M a) OP-BR) (= (gn-sir M a IF-B) 0) (= (gn-sir M a IF-C) 0)
                   (= (gn-op M (inc a)) OP-LABEL) (= (gn-sir M (inc a) IF-A) le)
                   (= (gn-sir M (inc a) IF-B) 0) (= (gn-sir M (inc a) IF-C) 0) (= (gn-lpos M le) (inc a)))
            (let [b (gn-tree-end M (+ a 2) (inc depth)) lx (gn-sir M a IF-A)]
              (if (and (> b 0) (= (gn-op M b) OP-LABEL) (= (gn-sir M b IF-A) lx)
                       (= (gn-sir M b IF-B) 0) (= (gn-sir M b IF-C) 0) (= (gn-lpos M lx) b)) (inc b) 0)) 0)) 0))))
(defn- gn-tree-value [M :vector-i64 p :i64 x :i64] :i64
  (if (= (gn-op M p) OP-CONST) (gn-sir M p IF-B)
    (gn-tree-value M (if (if (= (gn-sir M (+ p 2) IF-A) CC-EQ) (= x (gn-sir M (inc p) IF-B)) (< x (gn-sir M (inc p) IF-B))) (+ p 4) (inc (gn-lpos M (gn-sir M (+ p 3) IF-B)))) x)))
(defn- gn-tree-high [M :vector-i64 p :i64] :i64
 (if (= (gn-op M p) OP-CONST) 0
  (gn-max (gn-sir M (inc p) IF-B)
   (gn-max (gn-tree-high M (+ p 4))
           (gn-tree-high M (inc (gn-lpos M (gn-sir M (+ p 3) IF-B))))))))
(defn- gn-tree-data [M :vector-i64 p :i64 x :i64 count :i64] :vector-i64
  (if (= x count) M (let [v (gn-tree-value M p x)]
    (gn-tree-data (-> M (gn-emit (bit-and v 0xffffffff)) (gn-emit (bit-and (i64-shift-right v 32) 0xffffffff))) p (inc x) count))))
(defn- cmap-original [M :vector-i64 p :i64 charge :i64] :vector-i64
  (let [high-bound (gn-tree-high M p) M0 (cond-> M (= charge 1) (gn-op-fuel))
        M1 (-> M0 (cond-> (>= (gn-sreg M0 1) 0) (gn-mov 9 (gn-sreg M0 1))) (cond-> (< (gn-sreg M0 1) 0) (gn-ld 9 1)) (gn-emit (enc-cmp-i 9 0))) low (vector-at M1 MM-CODE-N)
        M2 (-> M1 (gn-emit (enc-bcond (enc-cond-lt) 0)) (gn-emit (enc-cmp-i 9 high-bound))) high (vector-at M2 MM-CODE-N)
        M3 (gn-emit M2 (enc-bcond (enc-cond-gt) 0)) adr (vector-at M3 MM-CODE-N)
        M4 (-> M3 (gn-emit (gn-e-adr 10)) (gn-emit (gn-e-ldrr 0 10 9 1)) (gn-epilogue))
        l (vector-at M4 MM-CODE-N) M5 (-> M4 (gn-mov-imm 0 (gn-tree-value M p -9223372036854775808)) (gn-epilogue))
        h (vector-at M5 MM-CODE-N) M6 (-> M5 (gn-mov-imm 0 (gn-tree-value M p 9223372036854775807)) (gn-epilogue))
        table (vector-at M6 MM-CODE-N) delta (* (- table adr) 4)
        M7 (gn-tree-data M6 p 0 (inc high-bound))]
    (-> M7 (gn-put (+ MM-CODE-BASE low) (enc-bcond (enc-cond-lt) (- l low)))
           (gn-put (+ MM-CODE-BASE high) (enc-bcond (enc-cond-gt) (- h high)))
           (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 10) (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5)))
           (gn-gs 14 1))))
;; Bounded pure flat equality switch. Existing short/mixed tree hooks stay intact.
(defn- eq-chain-end [M :vector-i64 p :i64 depth :i64] :i64
 (if (or (> depth 256) (>= p (vector-at M MM-SIR-N))) 0
  (if (gn-dot-at? M p OP-CONST 0 (gn-sir M p IF-B) 0) (inc p)
   (if (or (>= depth 256) (>= (+ p 6) (vector-at M MM-SIR-N))) 0
    (let [le (gn-sir M (+ p 3) IF-B) lx (gn-sir M (+ p 5) IF-A)
          key (gn-sir M (inc p) IF-B)]
     (if (and (gn-dot-at? M p OP-LGET 0 1 0)
          (gn-dot-at? M (inc p) OP-CONST 1 key 0) (>= key 0) (<= key 255)
          (gn-dot-at? M (+ p 2) OP-CMP CC-EQ 0 0)
          (gn-dot-at? M (+ p 3) OP-BRZ 0 le 0)
          (gn-dot-at? M (+ p 4) OP-CONST 0 (gn-sir M (+ p 4) IF-B) 0)
          (gn-dot-at? M (+ p 5) OP-BR lx 0 0)
          (> le 0) (< le MM-LABEL-CAP) (> lx 0) (< lx MM-LABEL-CAP) (not= le lx)
          (gn-dot-at? M (+ p 6) OP-LABEL le 0 0) (= (gn-lpos M le) (+ p 6)))
      (let [end (eq-chain-end M (+ p 7) (inc depth))]
       (if (and (> end 0) (gn-dot-at? M end OP-LABEL lx 0 0)
                (= (gn-lpos M lx) end)) (inc end) 0)) 0))))))
(defn- eq-chain-entry [M :vector-i64 f :i64] :vector-i64
 (if (or (= (gn-g M 14) 1) (<= f 0) (>= f (vector-at M MM-FN-N))
         (gn-clamp-open M f) (not= (gn-g M gn-f-leaf) 1)) M
  (let [a (gn-fnf M f FF-SIR) charge (if (= (gn-op M (inc a)) OP-FUEL) 1 0)
        label (+ a 1 charge) p (inc label)]
   (if (and (> a 0) (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-NSLOTS) 1)
        (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-PT0) TY-I64)
        (= (gn-fnf M f FF-RTYPE) TY-I64) (gn-dot-at? M a OP-FN f 1 1)
        (= (gn-op M label) OP-LABEL) (= (gn-sir M label IF-B) 0) (= (gn-sir M label IF-C) 0)
        (> (gn-sir M label IF-A) 0) (< (gn-sir M label IF-A) MM-LABEL-CAP)
        (= (gn-lpos M (gn-sir M label IF-A)) label)
        (or (= charge 0) (gn-dot-at? M (inc a) OP-FUEL 0 0 0)))
    (let [end (eq-chain-end M p 0)]
     (if (and (>= (- end p) 48) (gn-dot-at? M end OP-RET 0 0 0)
              (gn-dot-at? M (inc end) OP-END f 0 0))
      (gn-tree-emit M p charge) M)) M))))

(defn- gn-tree-entry [M :vector-i64 f :i64] :vector-i64
  (let [a (gn-fnf M f FF-SIR) charge (if (= (gn-op M (inc a)) OP-FUEL) 1 0)
        label (+ a 1 charge) p (inc label)]
    (if (and (= (gn-sir M a IF-B) 1) (= (gn-g M gn-f-leaf) 1)
             (= (gn-op M label) OP-LABEL) (= (gn-sir M label IF-B) 0) (= (gn-sir M label IF-C) 0)
             (or (= charge 0) (and (= (gn-sir M (inc a) IF-A) 0) (= (gn-sir M (inc a) IF-B) 0) (= (gn-sir M (inc a) IF-C) 0))))
      (let [end (gn-tree-end M p 0)]
        (if (and (>= (- end p) 48) (= (gn-op M end) OP-RET) (= (gn-sir M end IF-A) 0) (= (gn-sir M end IF-B) 0) (= (gn-sir M end IF-C) 0)
                 (= (gn-op M (inc end)) OP-END) (= (gn-sir M (inc end) IF-A) f) (= (gn-sir M (inc end) IF-B) 0) (= (gn-sir M (inc end) IF-C) 0))
          (gn-tree-emit M p charge) M)) M)))

;; ---- FLOAT (agent FLOAT, rung r6j, 2026-10-04): f64/f32 operations (seed/SIR BOP-F*, CC-F*, UOP-F*) -----------------
;; A float temp is its bit pattern in a general register (f32: 32 bits sign-extended). Each operation moves its operands
;; into d0/d1 (s0/s1) with fmov, applies one instruction and moves the result back (f32: fmov w + sxtw). d0, d1 are scratch
;; (nothing else in the seed's code uses the FP registers, and no value lives in one across an instruction group).
(defn- gn-fl-bop? [bop :i64] :bool (>= bop BOP-F64-ADD))
;; 1 = double, 0 = single
(defn- gn-fl-bsz [bop :i64] :i64 (if (< bop BOP-F32-ADD) 1 0))
(defn- gn-fl-csz [cc :i64] :i64 (if (< cc CC-F32-EQ) 1 0))
;; d := (bop) x y, x and y general registers
(defn- gn-fl-bin [M :vector-i64 bop :i64 d :i64 x :i64 y :i64] :vector-i64
  (let [sz (gn-fl-bsz bop)]
    (-> M
        (gn-emit (enc-fmov-to-fp sz 0 x))
        (gn-emit (enc-fmov-to-fp sz 1 y))
        (gn-emit (enc-fop2 (bit-and bop 7) sz 0 0 1))
        (gn-emit (enc-fmov-from-fp sz d 0))
        (cond-> (= sz 0) (gn-emit (enc-sxtw d d))))))
;; flags := fcmp temp t, temp t+1
(defn- gn-fl-cmp-emit [M :vector-i64 cc :i64 t :i64] :vector-i64
  (let [sz (gn-fl-csz cc)
        x (gn-src M t 16 1)
        y (gn-src M (inc t) 17 1)]
    (-> M
        (gn-ldt t 16 1)
        (gn-ldt (inc t) 17 1)
        (gn-emit (enc-fmov-to-fp sz 0 x))
        (gn-emit (enc-fmov-to-fp sz 1 y))
        (gn-emit (enc-fcmp sz 0 1)))))
;; the result of an f32 operation in s0 -> d (fmov w, sxtw); of an f64 one in d0 -> d
(defn- gn-fl-out [M :vector-i64 sz :i64 d :i64] :vector-i64
  (-> M (gn-emit (enc-fmov-from-fp sz d 0)) (cond-> (= sz 0) (gn-emit (enc-sxtw d d)))))
(defn- gn-fl-un-ok? [uop :i64] :bool
  (or (and (>= uop UOP-F64-NEG) (<= uop UOP-F64-SQRT)) (and (>= uop UOP-F32-NEG) (<= uop UOP-F32-SQRT))
      (and (>= uop UOP-F64-TO-I64) (<= uop UOP-F32-TO-I64))))
;; d := (uop) x
(defn- gn-fl-un [M :vector-i64 uop :i64 d :i64 x :i64] :vector-i64
  (cond (<= uop UOP-F64-SQRT) (-> M (gn-emit (enc-fmov-to-fp 1 0 x)) (gn-emit (enc-fop1 (- uop UOP-F64-NEG) 1 0 0)) (gn-fl-out 1 d))
        (<= uop UOP-F32-SQRT) (-> M (gn-emit (enc-fmov-to-fp 0 0 x)) (gn-emit (enc-fop1 (- uop UOP-F32-NEG) 0 0 0)) (gn-fl-out 0 d))
        (= uop UOP-F64-TO-I64) (-> M (gn-emit (enc-fmov-to-fp 1 0 x)) (gn-emit (enc-fcvtzs 1 d 0)))
        (= uop UOP-I64-TO-F64) (-> M (gn-emit (enc-scvtf 1 0 x)) (gn-fl-out 1 d))
        (= uop UOP-F64-TO-F32) (-> M (gn-emit (enc-fmov-to-fp 1 0 x)) (gn-emit (enc-fcvt 1 0 0)) (gn-fl-out 0 d))
        (= uop UOP-F32-TO-F64) (-> M (gn-emit (enc-fmov-to-fp 0 0 x)) (gn-emit (enc-fcvt 0 0 0)) (gn-fl-out 1 d))
        (= uop UOP-I64-TO-F32) (-> M (gn-emit (enc-scvtf 0 0 x)) (gn-fl-out 0 d))
        :else (-> M (gn-emit (enc-fmov-to-fp 0 0 x)) (gn-emit (enc-fcvtzs 0 d 0)))))
(defn- gn-fl-op-un [M :vector-i64 i :i64 uop :i64 t :i64] :vector-i64
  (if (gn-fl-un-ok? uop)
    (let [s (gn-co M i t)
          d (gn-dreg M t s)
          x (gn-src M t 16 1)]
      (-> M (gn-protect t s) (gn-ldt t 16 1) (gn-fl-un uop d x) (gn-fin t s d)))
    (gn-err M E-GEN-OP OP-UN)))
;; ---- END FLOAT ------------------------------------------------------------------------------------------------------

;; ---- data processing ------------------------------------------------------------------------------------------------
(defn- gn-foldable [bop :i64 x :i64 y :i64] :bool
  (cond (gn-fl-bop? bop) false   ; FLOAT: never folded
        (= bop BOP-QUOT) (and (not= y 0) (not (and (= y -1) (= x -9223372036854775808))))
        :else true))
(defn- gn-fold [bop :i64 x :i64 y :i64] :i64
  (case bop
    BOP-ADD (+ x y)
    BOP-SUB (- x y)
    BOP-MUL (* x y)
    BOP-QUOT (quot x y)
    BOP-AND (bit-and x y)
    BOP-OR (bit-or x y)
    BOP-XOR (bit-xor x y)
    BOP-SHL (i64-shift-left x (bit-and y 63))
    BOP-USHR (u64-shift-right x (bit-and y 63))
    BOP-SSHR (i64-shift-right x (bit-and y 63))
    0))

;; quot: x = dividend register, y = divisor register, d = destination
(defn- gn-quot [M :vector-i64 d :i64 x :i64 y :i64] :vector-i64
  (-> M
      (gn-emit (enc-cbnz y 2))
      (gn-emit (enc-brk 0))
      (gn-emit (enc-cmn-i y 1))
      (gn-emit (enc-bcond (enc-cond-ne) 4))
      (gn-emit (enc-cmp-i x 1))
      (gn-emit (enc-bcond (enc-cond-vc) 2))
      (gn-emit (enc-brk 0))
      (gn-emit (enc-sdiv d x y))))

(defn- gn-bin-word [bop :i64 d :i64 x :i64 y :i64] :i64
  (case bop
    BOP-ADD (enc-add-r d x y)
    BOP-SUB (enc-sub-r d x y)
    BOP-MUL (enc-mul d x y)
    BOP-AND (enc-and-r d x y)
    BOP-OR (enc-orr-r d x y)
    BOP-XOR (enc-eor-r d x y)
    BOP-SHL (enc-lslv d x y)
    BOP-USHR (enc-lsrv d x y)
    BOP-SSHR (enc-asrv d x y)
    -1))
;; logical immediate base (N = 1) of and/orr/eor
(defn- gn-logic-base [bop :i64] :i64 (cond (= bop BOP-AND) 0x92400000 (= bop BOP-OR) 0xb2400000 (= bop BOP-XOR) 0xd2400000 :else -1))   ; R6B: hex
;; the immediate form for (bop x k), k a constant second operand: 0 = none
(defn- gn-imm-kind [bop :i64 k :i64] :i64
  (cond (and (or (= bop BOP-ADD) (= bop BOP-SUB)) (> k -4096) (< k 4096)) 1
        (or (= bop BOP-SHL) (= bop BOP-USHR) (= bop BOP-SSHR)) 2
        (and (>= (gn-logic-base bop) 0) (> (gn-run-len k) 0)) 3
        (and (= bop BOP-MUL) (> (gn-pow2 k) 0)) 4
        ;; Full64 modular strength reduction: k = 2^p + 1, 1 <= p <= 62.
        (and (= bop BOP-MUL) (> k 2) (> (gn-pow2 (dec k)) 0)) 6
        (and (= bop BOP-QUOT) (not= k 0) (not= k -1)) 5
        :else 0))
;; d := x (bop) k in the immediate form ik; x = the operand register (never xzr)
(defn- gn-bin-imm [M :vector-i64 bop :i64 d :i64 x :i64 k :i64] :vector-i64
  (case (gn-imm-kind bop k)
    1 (let [add (if (= bop BOP-ADD) (>= k 0) (< k 0))
            m (if (< k 0) (- 0 k) k)]
        (if (= m 0) (gn-mov M d x) (gn-emit M (if add (enc-add-i d x m) (enc-sub-i d x m)))))
    2 (let [s (bit-and k 63)]
        (cond (= s 0) (gn-mov M d x)
              (= bop BOP-SHL) (gn-emit M (gn-e-lsl d x s))
              (= bop BOP-USHR) (gn-emit M (gn-e-lsr d x s))
              :else (gn-emit M (gn-e-asr d x s))))
    3 (let [tz (gn-tz k 0)
            n (gn-run-len k)]
        (gn-emit M (gn-e-bf (gn-logic-base bop) d x (bit-and (- 64 tz) 63) (dec n))))
    4 (gn-emit M (gn-e-lsl d x (gn-pow2 k)))
    6 (gn-emit M (gn-e-addsl d x x (gn-pow2 (dec k))))
    ;; Positive power-of-two division truncates toward zero. Bias negative
    ;; dividends by 2^p-1 before ASR; MIN is safe because the bias is positive.
    ;; x17 is the existing immediate-divisor scratch and x/d never alias it.
    ;; No fuel, checks or trap boundaries change; zero/-1 retain gn-quot.
    (cond (and (= bop BOP-QUOT) (= k 1)) (gn-mov M d x)
          ;; Signed /2: the rounding bias is the dividend's logical sign bit.
          ;; x16/x17 are source-declared scratch; no value spans SIR instructions.
          (and (= bop BOP-QUOT) (= k 2))
          (-> M (gn-emit (+ (gn-e-addsl d x x 63) 0x400000))
                (gn-emit (gn-e-asr d d 1)))
          (and (= bop BOP-QUOT) (> (gn-pow2 k) 0))
          (let [p (gn-pow2 k)]
            (-> M (gn-emit (gn-e-asr 17 x 63))
                (gn-emit (+ (gn-e-addsl d x 17 (- 64 p)) 0x400000))
                (gn-emit (gn-e-asr d d p))))
          :else (-> M (gn-mov-imm 17 k) (gn-emit (enc-sdiv d x 17))))))
(defn- gn-bin-emit [M :vector-i64 bop :i64 t :i64 d :i64] :vector-i64
  (let [ky (gn-dk M (inc t))
        vy (gn-dv M (inc t))
        kx (gn-dk M t)
        vx (gn-dv M t)
        iy (if (= ky gn-k-const) (gn-imm-kind bop vy) 0)
        ix (if (and (= kx gn-k-const) (not= ky gn-k-const) (or (= bop BOP-ADD) (= bop BOP-MUL) (= bop BOP-AND) (= bop BOP-OR) (= bop BOP-XOR)))
             (gn-imm-kind bop vx) 0)]
    (cond (gn-fl-bop? bop) (let [x (gn-src M t 16 1)   ; FLOAT
                                 y (gn-src M (inc t) 17 1)]
                             (-> M (gn-ldt t 16 1) (gn-ldt (inc t) 17 1) (gn-fl-bin bop d x y)))
          (> iy 0) (-> M (gn-ldt t 16 0) (gn-bin-imm bop d (gn-src M t 16 0) vy))
          (> ix 0) (-> M (gn-ldt (inc t) 17 0) (gn-bin-imm bop d (gn-src M (inc t) 17 0) vx))
          (= bop BOP-QUOT) (let [x (gn-src M t 16 0)
                                 y (gn-src M (inc t) 17 0)]
                             (-> M (gn-ldt t 16 0) (gn-ldt (inc t) 17 0) (gn-quot d x y)))
          :else (let [x (gn-src M t 16 1)
                      y (gn-src M (inc t) 17 1)]
                  (-> M (gn-ldt t 16 1) (gn-ldt (inc t) 17 1) (gn-emit (gn-bin-word bop d x y)))))))
;; Novel source certificate: adjacent integer MUL/ADD consumes the product
;; into the preceding stack accumulator. All three operands are captured
;; before the single wrapping MADD write; no charge/check/branch is crossed.
(defn- ma-shape [M :vector-i64 i :i64 bop :i64 t :i64] :bool
 (and (= bop BOP-MUL) (= (gn-g M gn-f-leaf) 0) (> t 0) (<= t 5)
      (< (inc t) (gn-g M gn-f-dp)) (<= (+ t 2) (gn-g M gn-f-h))
      (= (gn-sir M i IF-C) 0) (< (+ i 1) (vector-at M MM-SIR-N))
      (gn-dot-at? M (inc i) OP-BIN BOP-ADD (dec t) 0)
      (not (gn-isk M t gn-k-const)) (not (gn-isk M (inc t) gn-k-const))
      (gn-kills M (+ i 2) t 16)))
(defn- ma-emit [M :vector-i64 i :i64 t :i64] :vector-i64
 (let [s (gn-co M (inc i) (dec t))
       m0 (-> M (gn-pin (dec t)) (gn-pin t) (gn-pin (inc t))
                (gn-protect (dec t) s))
       d (gn-dreg m0 (dec t) s) n (gn-pinned m0 t)
       r (gn-pinned m0 (inc t)) a (gn-pinned m0 (dec t))
       m1 (-> m0 (gn-emit (enc-madd d n r a)) (gn-fin (dec t) s d))]
  (gn-gs m1 gn-f-skip (inc (gn-g m1 gn-f-skip)))))
;; Generic adjacent full64 SHL/low-mask fold; ADR0357 one-off algorithm.
;; Keep memory/fuel/frame operations and the final canonical destination.
(defn- smf-owner [M :vector-i64 j :i64 left :i64] :i64
 (if (or (= left 0) (<= j 0)) 0
  (cond (= (gn-op M j) OP-END) 0
   (= (gn-op M j) OP-FN)
    (let [f (gn-sir M j IF-A)]
     (if (or (<= f 0) (>= f (vector-at M MM-FN-N))) 0
      (let [node (gn-fnf M f FF-NODE)]
       (if (and (or (= (gn-fnf M f FF-KIND) FK-DEFN) (= (gn-fnf M f FF-KIND) FK-PRIV))
           (= (gn-fnf M f FF-SIR) j)
           (= (gn-sir M j IF-B) (gn-fnf M f FF-NPARAMS))
           (= (gn-sir M j IF-C) (gn-fnf M f FF-NSLOTS))
           (>= (gn-fnf M f FF-NPARAMS) 0)
           (<= (gn-fnf M f FF-NPARAMS) (gn-fnf M f FF-NSLOTS))
           (>= (gn-fnf M f FF-NSLOTS) 0) (< (gn-fnf M f FF-NSLOTS) gn-cap)
           (> (gn-fnf M f FF-DEPTH) 0) (< (gn-fnf M f FF-DEPTH) gn-cap)
           (> node 0) (< node (vector-at M MM-NODE-N))
           (= (vector-at M (+ MM-NODE-BASE (* node MM-NODE-W) NF-KIND)) ND-LIST)) f 0))))
   :else (smf-owner M (dec j) (dec left)))))
(defn- smf-no-target [M :vector-i64 j :i64 i :i64] :bool
 (if (>= j (vector-at M MM-LABEL-N)) true
  (and (not= (gn-lpos M j) (inc i)) (not= (gn-lpos M j) (+ i 2))
       (smf-no-target M (inc j) i))))
(defn- smf-width [mask :i64] :i64
 (if (and (> mask 1) (= (bit-and mask (inc mask)) 0)) (gn-run-len mask) 0))
;; ADR0357: one-off source-aware demanded-lowbits algorithm, not a mechanical refactor.
;; Positive power2 MUL has exactly the full64 wrapping SHL endpoint; no runtime guard.
(defn- smf-shift [bop :i64 k :i64] :i64
 (cond (= bop BOP-SHL) k
       (and (= bop BOP-MUL) (> k 1)) (gn-pow2 k)
       :else 0))
(defn- smf-shape [M :vector-i64 i :i64 bop :i64 t :i64] :i64
 (if (or (not (or (= bop BOP-SHL) (= bop BOP-MUL))) (< (vector-count M) MM-WORDS)
   (not= (vector-at M MM-ERR) 0)
   (<= (vector-at M MM-CODE-N) 0) (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 1))
   (<= (vector-at M MM-SIR-N) 1) (> (vector-at M MM-SIR-N) MM-SIR-CAP)
   (<= (vector-at M MM-FN-N) 1) (> (vector-at M MM-FN-N) MM-FN-CAP)
   (<= (vector-at M MM-LABEL-N) 0) (> (vector-at M MM-LABEL-N) MM-LABEL-CAP)
   (<= (vector-at M MM-NODE-N) 1) (> (vector-at M MM-NODE-N) MM-NODE-CAP)
   ;; Stage the whole allocated G block before any gn-g/descriptor/label read.
   (or (< (vector-at M MM-HEAP-TOP) MM-HEAP-BASE)
       (> (vector-at M MM-HEAP-TOP) MM-HEAP-END)
       (< (vector-at M gn-cell) MM-HEAP-BASE)
       (> (vector-at M gn-cell) (- (vector-at M MM-HEAP-TOP) (+ gn-a-lp MM-LABEL-CAP 90))))
   (<= i 1) (>= (+ i 3) (vector-at M MM-SIR-N))
   (< t 0) (> t 6) (>= (inc t) (gn-g M gn-f-dp))
   (not= (gn-g M gn-f-h) (+ t 2))
   (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-dead) 0)
   (not (or (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-leaf) 1))) (not= (gn-g M vi-slot) 0)
   (not= (gn-g M vi-max) -1)
   (not (gn-isk M (inc t) gn-k-const)) (gn-isk M t gn-k-const)) 0
  (let [f (smf-owner M i 1024) s (smf-shift bop (gn-dv M (inc t)))
        mask (gn-sir M (inc i) IF-B) w (smf-width mask)]
   (if (or (= f 0) (<= s 0) (>= s w) (> w 63)
       (not= (gn-fnf M f FF-DEPTH) (gn-g M gn-f-dp))
       (not= (gn-fnf M f FF-NSLOTS) (gn-g M gn-f-ns))
       (< (gn-fnf M f FF-DEPTH) (+ t 2))
       (not (smf-no-target M 1 i))
       (not (gn-dot-at? M i OP-BIN bop t 0))
       (not (gn-dot-at? M (inc i) OP-CONST (inc t) mask 0))
       (not (gn-dot-at? M (+ i 2) OP-BIN BOP-AND t 0))
       ;; A following LSET coalesces destinations; this initial recipe refuses it.
       (= (gn-op M (+ i 3)) OP-LSET)
       ;; Kind and LOCAL slot ownership precede the legacy cache lookup.
       (not (or (gn-isk M t gn-k-reg)
          (and (gn-isk M t gn-k-local) (> (gn-dv M t) 0)
               (< (gn-dv M t) gn-cap)
               (<= (gn-dv M t) (gn-fnf M f FF-NSLOTS)))))
       ;; LOCAL cache stores register+1; accept exactly 1..31 (x0..x30).
       ;; REG uses canonical x9+t, with the already staged t in 0..6.
       (< (gn-sr M t 0) 0) (> (gn-sr M t 0) 30)) 0 w))))
(defn- smf-emit [M :vector-i64 i :i64 t :i64 w :i64] :vector-i64
 (let [s (smf-shift (gn-sir M i IF-A) (gn-dv M (inc t))) mask (gn-sir M (inc i) IF-B)
       x (gn-src M t 16 0) d (+ 9 t)
       m (-> M (gn-emit (gn-e-bf 0xd3400000 d x (- 64 s) (dec (- w s))))
          ;; Preserve the dead upper descriptor exactly as the skipped CONST did.
          (gn-dset (inc t) gn-k-const mask) (gn-fin t 0 d))]
  (gn-gs m gn-f-skip 2)))

;; SOURCE-ONLY v2 proposal: full64 adjacent MUL/SUB, ADR0357 novel algorithm.
(defn- ms-ready [M :vector-i64 t :i64] :bool
 (and (>= t 0) (< t 7)
  (or (gn-isk M t gn-k-reg)
      (and (gn-isk M t gn-k-local) (> (gn-dv M t) 0)
           (< (gn-dv M t) gn-cap) (<= (gn-dv M t) (gn-g M gn-f-ns))
           ;; Ordinary/DI local banks avoid every canonical temp write.
           (let [r (gn-sreg M (gn-dv M t))]
            (or (and (>= r 0) (<= r 6)) (and (>= r 19) (<= r 28))))))
  (>= (gn-pinned M t) 0) (<= (gn-pinned M t) 30)))
(defn- ms-shape [M :vector-i64 i :i64 bop :i64 t :i64] :bool
 (and (= bop BOP-MUL) (or (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-leaf) 1)) (> t 0) (<= t 5)
      (< (inc t) (gn-g M gn-f-dp)) (<= (+ t 2) (gn-g M gn-f-h))
      (> i 0) (< (+ i 2) (vector-at M MM-SIR-N))
      (= (gn-sir M i IF-C) 0)
      (gn-dot-at? M (inc i) OP-BIN BOP-SUB (dec t) 0)
      (ms-ready M (dec t))
      (or (gn-isk M t gn-k-const) (ms-ready M t))
      (or (gn-isk M (inc t) gn-k-const) (ms-ready M (inc t)))
      (not (and (gn-isk M t gn-k-const) (gn-isk M (inc t) gn-k-const)))
      ;; Preserve existing immediate MUL winners instead of deoptimizing them.
      (or (not (gn-isk M t gn-k-const)) (= (gn-imm-kind BOP-MUL (gn-dv M t)) 0))
      (or (not (gn-isk M (inc t) gn-k-const)) (= (gn-imm-kind BOP-MUL (gn-dv M (inc t))) 0))
      (gn-kills M (+ i 2) t 16) (gn-kills M (+ i 2) (inc t) 16)))
(defn- ms-emit [M :vector-i64 i :i64 t :i64] :vector-i64
 (let [s (gn-co M (inc i) (dec t))
       ;; CONST descriptors remain unchanged; their original scratch loads
       ;; follow all captures, so x16/x17 cannot destroy an uncaptured input.
       m0 (gn-pin M (dec t))
       m1 (if (gn-isk m0 t gn-k-const) m0 (gn-pin m0 t))
       m2 (if (gn-isk m1 (inc t) gn-k-const) m1 (gn-pin m1 (inc t)))
       m3 (gn-protect m2 (dec t) s)
       d (gn-dreg m3 (dec t) s) n (gn-src m3 t 16 1)
       r (gn-src m3 (inc t) 17 1) a (gn-pinned m3 (dec t))
       m4 (-> m3 (gn-ldt t 16 1) (gn-ldt (inc t) 17 1)
                (gn-emit (+ (enc-madd d n r a) 32768)) (gn-fin (dec t) s d))]
  (gn-gs m4 gn-f-skip (inc (gn-g m4 gn-f-skip)))))

(defn- srf-original-op-bin [M :vector-i64 i :i64 bop :i64 t :i64] :vector-i64
  (let [vx (gn-dv M t)
        vy (gn-dv M (inc t))]
    (if (ms-shape M i bop t) (ms-emit M i t)
    (if (ma-shape M i bop t) (ma-emit M i t)
    (let [w (smf-shape M i bop t)]
    (if (> w 0) (smf-emit M i t w)
    (if (and (gn-isk M t gn-k-const) (gn-isk M (inc t) gn-k-const) (gn-foldable bop vx vy))
      (gn-def M t gn-k-const (gn-fold bop vx vy))
      (let [s (gn-co M i t)
            d (gn-dreg M t s)]
        (-> M (gn-protect t s) (gn-bin-emit bop t d) (gn-fin t s d))))))))))

(defn- gn-op-un [M :vector-i64 i :i64 uop :i64 t :i64] :vector-i64
  (let [v (gn-dv M t)]
    (cond (>= uop UOP-F64-NEG) (gn-fl-op-un M i uop t)   ; FLOAT
          (not (or (= uop UOP-NOT) (= uop UOP-BITNOT))) (gn-err M E-GEN-OP OP-UN)
          (gn-isk M t gn-k-const) (gn-def M t gn-k-const (if (= uop UOP-NOT) (bit-xor v 1) (bit-not v)))
          :else (let [s (gn-co M i t)
                      d (gn-dreg M t s)
                      x (gn-src M t 16 1)]
                  (-> M
                      (gn-protect t s)
                      (gn-ldt t 16 1)
                      (gn-emit (if (= uop UOP-NOT) (enc-eor-1 d x) (enc-mvn d x)))
                      (gn-fin t s d))))))

;; ---- compares and branches ------------------------------------------------------------------------------------------
(defn- gn-cmp-fold [cc :i64 x :i64 y :i64] :i64
  (case cc
    CC-EQ (if (= x y) 1 0)
    CC-LT (if (< x y) 1 0)
    CC-GT (if (> x y) 1 0)
    CC-LE (if (<= x y) 1 0)
    CC-GE (if (>= x y) 1 0)
    0))
;; flags := temp t - temp t+1 (cmp / cmp #imm / cmn #imm)
(defn- gn-cmp-emit [M :vector-i64 cc :i64 t :i64] :vector-i64
  (if (>= cc CC-F64-EQ) (gn-fl-cmp-emit M cc t) (gn-cmp-emit-i M t)))   ; FLOAT
(defn- gn-cmp-emit-i [M :vector-i64 t :i64] :vector-i64
  (let [vy (gn-dv M (inc t))
        imm (and (gn-isk M (inc t) gn-k-const) (> vy -4096) (< vy 4096))]
    (if imm
      (let [x (gn-src M t 16 0)]
        (-> M (gn-ldt t 16 0) (gn-emit (if (>= vy 0) (enc-cmp-i x vy) (enc-cmn-i x (- 0 vy))))))
      (let [x (gn-src M t 16 1)
            y (gn-src M (inc t) 17 1)]
        (-> M (gn-ldt t 16 1) (gn-ldt (inc t) 17 1) (gn-emit (enc-cmp-r x y)))))))
(defn- gn-jump [M :vector-i64 l :i64] :vector-i64
  (-> M (gn-jflush (gn-g M gn-f-h) l) (gn-fix FX-B26 l) (gn-emit (enc-b 0)) (gn-gs gn-f-dead 1)))
;; cmp at i, an optional (not t) at i+1, then brz/brnz t at j: fused into cmp + b.cond when t is dead after both
(defn- gn-cmp-br [M :vector-i64 i :i64 cc :i64 t :i64 inv :i64] :vector-i64
  (let [j (+ i 1 inv)
        nz (if (= (gn-op M j) OP-BRNZ) 1 0)
        l (gn-thread M (gn-sir M j IF-B) t nz 8)
        c (enc-cond-of-cc cc)
        bc (if (= (bit-xor nz inv) 1) c (bit-xor c 1))]
    (-> M
        (gn-flush 0 t)
        (gn-cmp-emit cc t)
        (gn-fix FX-BC19 l)
        (gn-emit (enc-bcond bc 0))
        (gn-gs gn-f-h t)
        (gn-gs gn-f-skip (inc inv)))))
(defn- gn-fusable [M :vector-i64 i :i64 t :i64] :i64
  (let [inv (if (and (= (gn-op M (inc i)) OP-UN) (= (gn-sir M (inc i) IF-A) UOP-NOT) (= (gn-sir M (inc i) IF-B) t)) 1 0)
        j (+ i 1 inv)
        op (gn-op M j)
        nz (if (= op OP-BRNZ) 1 0)]
    (if (and (or (= op OP-BRZ) (= op OP-BRNZ))
             (= (gn-sir M j IF-A) t)
             (gn-kills M (inc j) t 16)
             (gn-dead-at M (gn-thread M (gn-sir M j IF-B) t nz 8) t))
      inv
      -1)))
;; Exact 0/1 compare diamond. Whole-SIR bounded scan certifies unique definitions
;; and sole incoming references; omitted labels therefore have no external entry.
(defn- bd-edges [M :vector-i64 j :i64 a :i64 b :i64 ra :i64 rb :i64 da :i64 db :i64] :bool
 (cond (or (> ra 1) (> rb 1) (> da 1) (> db 1)) false
       (>= j (vector-at M MM-SIR-N)) (and (= ra 1) (= rb 1) (= da 1) (= db 1))
       (or (< (gn-op M j) OP-FN) (> (gn-op M j) OP-COUNT) (= (gn-op M j) OP-CALLI)) false
       :else (let [op (gn-op M j) x (gn-sir M j IF-A) y (gn-sir M j IF-B)
                   ref (if (= op OP-BR) x (if (or (= op OP-BRZ) (= op OP-BRNZ)) y 0))]
          (bd-edges M (inc j) a b (+ ra (if (= ref a) 1 0)) (+ rb (if (= ref b) 1 0))
             (+ da (if (and (= op OP-LABEL) (= x a)) 1 0))
             (+ db (if (and (= op OP-LABEL) (= x b)) 1 0))))))
(defn- bd-shape [M :vector-i64 i :i64 t :i64] :i64
 (let [inv (if (gn-dot-at? M (inc i) OP-UN UOP-NOT t 0) 1 0) j (+ i 1 inv)
       op (gn-op M j) a (gn-sir M j IF-B) b (gn-sir M (+ j 2) IF-A)
       fv (gn-sir M (inc j) IF-B) tv (gn-sir M (+ j 4) IF-B)]
  (if (and (<= (vector-at M MM-SIR-N) 16384) (< (+ j 5) (vector-at M MM-SIR-N))
       (> a 0) (< a MM-LABEL-CAP) (> b 0) (< b MM-LABEL-CAP) (not= a b)
       (or (= op OP-BRZ) (= op OP-BRNZ)) (gn-dot-at? M j op t a 0)
       (or (= fv 0) (= fv 1)) (= tv (- 1 fv))
       (gn-dot-at? M (inc j) OP-CONST t fv 0) (gn-dot-at? M (+ j 2) OP-BR b 0 0)
       (gn-dot-at? M (+ j 3) OP-LABEL a 0 0) (gn-dot-at? M (+ j 4) OP-CONST t tv 0)
       (gn-dot-at? M (+ j 5) OP-LABEL b 0 0)
       (= (gn-lpos M a) (+ j 3)) (= (gn-lpos M b) (+ j 5))
       (bd-edges M 1 a b 0 0 0 0)) inv -1)))
(defn- bd-emit [M :vector-i64 i :i64 cc :i64 t :i64 inv :i64] :vector-i64
 (let [j (+ i 1 inv) fv (gn-sir M (inc j) IF-B)
       flip (bit-xor inv (bit-xor (if (= (gn-op M j) OP-BRNZ) 1 0) (if (= fv 0) 1 0)))
       d (if (< t 7) (+ 9 t) 16)
       m0 (-> M (gn-flush 0 t) (gn-cmp-emit cc t) (gn-emit (enc-cset d (bit-xor (enc-cond-of-cc cc) flip))))
       m1 (if (< t 7) m0 (gn-st m0 d (gn-home m0 t)))]
   (-> m1 (gn-allreg 0 (gn-max (inc t) (gn-g m1 gn-f-dp)))
       (gn-gs gn-f-h (inc t)) (gn-gs gn-f-dead 0)
       (gn-gs gn-f-ctx (if (and (= (gn-g m1 gn-f-leaf) 0) (= (gn-g m1 cc-proof) 0)) 0 1))
       (gn-gs gn-f-vslot 0) (sl-clear) (vi-clear) (gn-gs gn-f-skip (+ 6 inv)))))
;; ADR0357: one-off typed CALL-result copy forwarding into ordinary CMP/CSET.
;; Read-only admission first; preserve BL/CSET/gn-fin and all observable effects.
(defn- ccf-counts [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS) (= (vector-at M MM-ERR) 0)
  (let [g (vector-at M gn-cell) top (vector-at M MM-HEAP-TOP)
        size (+ gn-a-lp MM-LABEL-CAP 91)]
   (and (>= g MM-HEAP-BASE) (<= g (- MM-HEAP-END size))
        (>= top (+ g size)) (<= top MM-HEAP-END)))
  (> (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (> (vector-at M MM-SIR-N) 3) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (vector-at M MM-NODE-N) 1) (<= (vector-at M MM-NODE-N) MM-NODE-CAP)
  (>= (vector-at M MM-CODE-N) 3) (< (vector-at M MM-CODE-N) MM-CODE-CAP)
  (> (vector-at M MM-FIX-N) 1) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (>= (vector-at M MM-LABEL-N) 1) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)
  (>= (vector-at M MM-LIT-N) 1) (<= (vector-at M MM-LIT-N) MM-LIT-CAP)))
(defn- ccf-owner [M :vector-i64 j :i64 left :i64] :i64
 (if (or (<= j 0) (= left 0)) 0
  (cond (= (gn-op M j) OP-END) 0
   (= (gn-op M j) OP-FN)
    (let [f (gn-sir M j IF-A)]
     (if (or (<= f 0) (>= f (vector-at M MM-FN-N))) 0
      (let [node (gn-fnf M f FF-NODE) np (gn-fnf M f FF-NPARAMS)
            ns (gn-fnf M f FF-NSLOTS) dp (gn-fnf M f FF-DEPTH)]
       (if (and (or (= (gn-fnf M f FF-KIND) FK-DEFN) (= (gn-fnf M f FF-KIND) FK-PRIV))
          (= (gn-fnf M f FF-SIR) j) (= (gn-sir M j IF-B) np) (= (gn-sir M j IF-C) ns)
          (>= np 0) (<= np ns) (< ns gn-cap) (>= dp 2) (< dp gn-cap)
          (> node 0) (< node (vector-at M MM-NODE-N))
          (= (vector-at M (+ MM-NODE-BASE (* node MM-NODE-W) NF-KIND)) ND-LIST)) f 0))))
   :else (ccf-owner M (dec j) (dec left)))))
(defn- ccf-end [M :vector-i64 j :i64 f :i64 left :i64] :i64
 (if (or (>= j (vector-at M MM-SIR-N)) (= left 0)) 0
  (cond (= (gn-op M j) OP-FN) 0
   (= (gn-op M j) OP-END) (if (gn-dot-at? M j OP-END f 0 0) j 0)
   :else (ccf-end M (inc j) f (dec left)))))
(defn- ccf-label-source [M :vector-i64 j :i64 l :i64 i :i64 found :i64] :bool
 (if (= j (vector-at M MM-SIR-N)) (= found 1)
  (let [hit (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) l))]
   (and (or (not hit) (and (or (< j (- i 2)) (> j i))
                               (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) 0)))
    (<= (+ found (if hit 1 0)) 1)
    (ccf-label-source M (inc j) l i (+ found (if hit 1 0)))))))
(defn- ccf-labels [M :vector-i64 j :i64 at :i64] :bool
 (if (= j (vector-at M MM-LABEL-N)) true
  (let [v (vector-at M (+ MM-LABEL-BASE j))]
   (and (>= v 0) (< v at) (ccf-labels M (inc j) at)))))
(defn- ccf-functions [M :vector-i64 j :i64 at :i64] :bool
 (if (= j (vector-at M MM-FN-N)) true
  (let [v (gn-fnf M j FF-CODE)]
   (and (>= v 0) (< v at) (or (= v 0) (< (+ v 2) at))
        (ccf-functions M (inc j) at)))))
(defn- ccf-fixes [M :vector-i64 j :i64 at :i64 f :i64 i :i64 found :i64] :bool
 (if (= j (vector-at M MM-FIX-N)) (= found 1)
  (let [b (+ MM-FIX-BASE (* j MM-FIX-W))
        site (vector-at M (+ b XF-AT)) kind (vector-at M (+ b XF-KIND))
        target (vector-at M (+ b XF-TARGET)) aux (vector-at M (+ b XF-AUX))
        call (= site (dec at))]
   (if (or (<= site 0) (>= site at) (< kind FX-B26) (> kind FX-FADDR)) false
    (let [ok (cond call (and (= kind FX-BL26) (= target f) (= aux 0))
               (= kind FX-LIT32) (and (= aux 0) (> target 0) (< target (vector-at M MM-LIT-N)) (< (inc site) (dec at)))
               (or (= kind FX-BL26) (= kind FX-ADR19) (= kind FX-FADDR))
                (and (> target 0) (< target (vector-at M MM-FN-N))
                 (if (= kind FX-FADDR) (and (= aux 0) (< (+ site 2) (dec at)))
                  (or (= aux 0) (and (= kind FX-BL26) (or (= aux 1) (= aux 2)))))
                 (let [entry (gn-fnf M target FF-CODE)]
                  (and (>= entry 0) (< entry at) (or (= entry 0) (< (+ entry aux) at)))))
               :else (and (= aux 0) (> target 0) (< target (vector-at M MM-LABEL-N))
                 (let [entry (vector-at M (+ MM-LABEL-BASE target))]
                  (and (>= entry 0) (< entry at)
                   (or (> entry 0) (ccf-label-source M 1 target i 0))))))]
     (and ok (<= (+ found (if call 1 0)) 1)
      (ccf-fixes M (inc j) at f i (+ found (if call 1 0)))))))))
(defn- ccf-code [M :vector-i64 j :i64 at :i64] :bool
 (if (= j at) true
  (let [w (vector-at M (+ MM-CODE-BASE j))]
   (if (or (< w 0) (> w 4294967295)) false
    (let [b26 (= (bit-and w 2080374784) 335544320)
          b19 (or (= (bit-and w 4278190096) 1409286144) (= (bit-and w 2113929216) 872415232))
          b14 (= (bit-and w 2113929216) 905969664)
          lit (= (bit-and w 989855744) 402653184)
          adr (= (bit-and w 2667577344) 268435456)
          adrp (= (bit-and w 2667577344) 2415919104)
          delta (cond b26 (cfr-signed (bit-and w 67108863) 33554432 67108864)
                   (or b19 lit) (cfr-signed (bit-and (u64-shift-right w 5) 524287) 262144 524288)
                   b14 (cfr-signed (bit-and (u64-shift-right w 5) 16383) 8192 16384)
                   :else 0)
          adelta (if adr (cfr-signed (+ (* 4 (bit-and (u64-shift-right w 5) 524287))
                       (bit-and (u64-shift-right w 29) 3)) 1048576 2097152) 0)]
     (and (not adrp)
      (not (and (or b26 b19 b14 lit) (>= (+ j delta) at)))
      (not (and adr (>= (+ (* 4 (dec j)) adelta) (* 4 (dec at)))))
      (ccf-code M (inc j) at)))))))
;; Preserve direct returned-value comparison across the exact fuel reload.
;; The existing whole-prefix label/fix/reference checks cover both suffix
;; words. LDR x8 does not read/write x0 or flags; x9 is overwritten by CSET.
(defn- ccf-copy-at [M :vector-i64] :i64
 (let [last (dec (vector-at M MM-CODE-N))]
  (if (and (= (gn-g M gn-f-freg) 2)
           (= (vector-at M (+ MM-CODE-BASE last)) (enc-ldr 8 7 CTX-FUEL)))
   (dec last) last)))
(defn- ccf-admit [M :vector-i64 i :i64 cc :i64 t :i64 d :i64] :bool
 (if (or (not (ccf-counts M)) (<= i 2) (>= i (vector-at M MM-SIR-N))
         (not= t 0) (not= d 9)
         (not (or (= cc CC-EQ) (= cc CC-LT) (= cc CC-GT) (= cc CC-LE) (= cc CC-GE)))) false
  (let [owner (ccf-owner M i 1024) f (gn-sir M (- i 2) IF-A)
        k (gn-sir M (dec i) IF-B) at (ccf-copy-at M)]
   (if (or (= owner 0) (<= f 0) (>= f (vector-at M MM-FN-N))) false
    (and (> (ccf-end M (inc i) owner 1024) i)
     (= (gn-fnf M owner FF-NSLOTS) (gn-g M gn-f-ns))
     (= (gn-fnf M owner FF-DEPTH) (gn-g M gn-f-dp))
     (= (gn-g M gn-f-h) 2) (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
     (= (gn-dk M 0) gn-k-reg) (= (gn-dk M 1) gn-k-const) (= (gn-dv M 1) k)
     (> k -4096) (< k 4096)
     (gn-dot-at? M i OP-CMP cc 0 0) (gn-dot-at? M (dec i) OP-CONST 1 k 0)
     (= (gn-op M (- i 2)) OP-CALL) (= (gn-sir M (- i 2) IF-B) 0)
     (>= (gn-fnf M f FF-NPARAMS) 0) (<= (gn-fnf M f FF-NPARAMS) 7)
     (= (gn-sir M (- i 2) IF-C) (gn-fnf M f FF-NPARAMS))
     (or (= (gn-fnf M f FF-RTYPE) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-BOOL))
     (= (vector-at M (+ MM-CODE-BASE at)) (enc-orr-r 9 31 0))
     (= (bit-and (vector-at M (+ MM-CODE-BASE (dec at))) 4227858432) 2483027968)
     (ccf-labels M 1 at) (ccf-functions M 1 at)
     (ccf-fixes M 1 at f i 0) (ccf-code M 1 at))))))
(defn- ccf-compare [M :vector-i64 i :i64 cc :i64 t :i64 d :i64] :vector-i64
 (if (not (ccf-admit M i cc t d)) (gn-cmp-emit M cc t)
  (let [k (gn-dv M 1) at (ccf-copy-at M)
        copied (if (< at (dec (vector-at M MM-CODE-N)))
                 (gn-put M (+ MM-CODE-BASE at) (enc-ldr 8 7 CTX-FUEL)) M)
        m0 (gn-put copied MM-CODE-N (dec (vector-at M MM-CODE-N)))]
   (gn-emit m0 (if (>= k 0) (enc-cmp-i 0 k) (enc-cmn-i 0 (- 0 k)))))))

(defn- gn-op-cmp [M :vector-i64 i :i64 cc :i64 t :i64] :vector-i64
  (let [vx (gn-dv M t)
        vy (gn-dv M (inc t))
        inv (gn-fusable M i t)
        diamond (if (< cc CC-F64-EQ) (bd-shape M i t) -1)]
    (cond (and (gn-isk M t gn-k-const) (gn-isk M (inc t) gn-k-const) (< cc CC-F64-EQ)) (gn-def M t gn-k-const (gn-cmp-fold cc vx vy))   ; FLOAT: no fold
          (>= diamond 0) (bd-emit M i cc t diamond)
          (>= inv 0) (gn-cmp-br M i cc t inv)
          :else (let [s (gn-co M i t)
                      d (gn-dreg M t s)]
                  (-> M (gn-protect t s) (ccf-compare i cc t d) (gn-emit (enc-cset d (enc-cond-of-cc cc))) (gn-fin t s d))))))

;; BRZ / BRNZ: nz = 0 -> branch when temp t = 0, 1 -> when != 0
(defn- gn-op-brz [M :vector-i64 i :i64 t :i64 l0 :i64 nz :i64] :vector-i64
  (let [l (gn-thread M l0 t nz 8)
        v (gn-dv M t)]
    (if (gn-isk M t gn-k-const)
      (if (= (if (= v 0) 0 1) nz) (gn-jump M l) M)
      (let [M1 (if (and (gn-kills M (inc i) t 16) (gn-dead-at M l t)) (gn-flush M 0 t) (gn-flush M 0 (inc t)))
            r (gn-src M1 t 16 0)]
        (-> M1 (gn-ldt t 16 0) (gn-fix FX-CB19 l) (gn-emit (if (= nz 1) (enc-cbnz r 0) (enc-cbz r 0))))))))

(defn- gn-op-label [M :vector-i64 l :i64] :vector-i64
  (let [h (gn-g M gn-f-h)
        M1 (if (= (gn-g M gn-f-dead) 1) M (gn-jflush M h l))]
    (if (or (< l 1) (>= l MM-LABEL-CAP))
      (gn-err M1 E-GEN-OP OP-LABEL)
      (-> M1
          (gn-allreg 0 (gn-max h (gn-g M1 gn-f-dp)))
          (gn-put (+ MM-LABEL-BASE l) (vector-at M1 MM-CODE-N))
          (gn-gs gn-f-dead 0)
          (gn-gs gn-f-ctx (if (and (= (gn-g M1 gn-f-leaf) 0) (= (gn-g M1 cc-proof) 0)) 0 1))))))

(defn- gn-op-lset [M :vector-i64 s :i64 t :i64] :vector-i64
  (let [M1 (gn-prot M 0 (gn-g M gn-f-h) t s)
        r (gn-sreg M1 s)]
    (cond (and (gn-isk M1 t gn-k-local) (= (gn-dv M1 t) s)) M1
          (>= r 0) (gn-into M1 r t)
          :else (let [q (gn-src M1 t 16 1)] (-> M1 (gn-ldt t 16 1) (gn-st q s))))))

;; ---- calls ---------------------------------------------------------------------------------------------------------
;; registers r .. r+n-1 := temps t .. t+n-1
(defn- gn-args [M :vector-i64 t :i64 r :i64 n :i64] :vector-i64
  (if (<= n 0) M (gn-args (gn-into M r t) (inc t) (inc r) (dec n))))
;; x0 := ctx ; x16 := [x0, #slot] ; blr x16 (x7 is then unknown)
(defn- gn-rtcall [M :vector-i64 slot :i64] :vector-i64
  (-> M
      (cond-> (= (gn-g M gn-f-ctx) 1) (gn-mov 0 7)
              (= (gn-g M gn-f-ctx) 0) (gn-ld 0 0))
      (gn-emit (enc-ldr 16 0 slot))
      (gn-emit (enc-blr 16)) (gn-vclear)
      (gn-gs gn-f-ctx 0)))
;; R4B: arguments k >= 7 of a call go to the outgoing area [sp, #8*(k-7)]
(defn- gn-stack-args [M :vector-i64 t :i64 k :i64 n :i64] :vector-i64
  (if (>= k n)
    M
    (let [r (gn-src M (+ t k) 16 1)]
      (gn-stack-args (-> M (gn-ldt (+ t k) 16 1) (gn-emit (enc-str r 31 (* 8 (- k 7))))) t (inc k) n))))
(defn- gn-call-sign [M :vector-i64 i :i64 t :i64 w :i64] :vector-i64
  (let [width (bit-and w 511) modulus (i64-shift-left 1 width)
        M1 (if (>= w 1536) (gn-op-fuel M) M)]
    (if (gn-isk M1 t gn-k-const)
      (let [v (bit-and (gn-dv M1 t) (dec modulus))]
        (gn-def M1 t gn-k-const (if (>= v (quot modulus 2)) (- v modulus) v)))
      (let [s (gn-co M1 i t) d (gn-dreg M1 t s) x (gn-src M1 t 16 1)]
        (-> M1 (gn-protect t s) (gn-ldt t 16 1)
            (gn-emit (gn-e-bf 0x93400000 d x 0 (dec width))) (gn-fin t s d))))))
;; Emulate the callee leaf transaction in x8, not caller gn-op-fuel.
;; x0/x8 are free in the retained nonleaf caller; pinned argument/live temps
;; are x9..x15, callee-saved locals or homes. Traps keep the pre-call fuel,
;; except original exhaustion, which publishes zero. Return publishes x8.
(defn- gn-mask-charge [M :vector-i64] :vector-i64
  (if (= (gn-g M gn-f-freg) 3) M
  (-> M (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 3))
      (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0)))))
(defn- pf-load [M :vector-i64] :vector-i64
 (if (and (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 2)) M
  (gn-emit M (enc-ldr 8 7 CTX-FUEL))))
;; Fuse a pure register copy and unsigned low-bit extraction. For values
;; requiring materialization, retain the exact old load/mask sequence.
(defn- gn-mask-into [M :vector-i64 r :i64 t :i64 width :i64] :vector-i64
 (let [q (gn-sr M t 1)]
  (if (and (>= q 0) (< q 31))
   (gn-emit M (gn-e-bf 0xd3400000 r q 0 (dec width)))
   (-> M (gn-into r t) (gn-emit (gn-e-bf 0xd3400000 r r 0 (dec width)))))))
;; Three adjacent source-owned checked byte writers: share the affine
;; payload pointer and masked value, then restore the exact final index.
;; This hook is reachable only from vmode4/freg3; cold paths are unchanged.
(defn- mw3-clear [M :vector-i64 first :i64 last :i64] :bool
 (and
  (loop [k 1] (if (= k (vector-at M MM-LABEL-N)) true
   (let [at (vector-at M (+ MM-LABEL-BASE k))]
    (and (<= at first) (recur (inc k))))))
  (loop [k 1] (if (= k (vector-at M MM-FIX-N)) true
   (let [at (sf-x M k XF-AT) kind (sf-x M k XF-KIND)
         span (if (= kind FX-FADDR) 3 (if (= kind FX-LIT32) 2 1))]
    (and (> at 0) (<= at last) (<= (+ at span -1) last) (>= kind FX-B26) (<= kind FX-FADDR)
     (or (< (+ at span -1) first) (> at last)) (recur (inc k))))))))
(defn- mw3-fold [M :vector-i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) ln (vector-at M MM-LABEL-N) xn (vector-at M MM-FIX-N)]
  (if (or (< cn 10) (> cn MM-CODE-CAP) (<= ln 0) (> ln MM-LABEL-CAP)
          (<= xn 0) (> xn MM-FIX-CAP)) M
   (let [at (- cn 9) a (sf-word M at) b (sf-word M (inc at))
         index (bit-and (i64-shift-right a 5) 31)
         value (bit-and (i64-shift-right b 5) 31)
         k0 (bit-and (i64-shift-right a 10) 4095)
         a1 (sf-word M (+ at 3)) k1 (bit-and (i64-shift-right a1 10) 4095)
         a2 (sf-word M (+ at 6)) k2 (bit-and (i64-shift-right a2 10) 4095)]
    (if (not (and (>= index 19) (<= index 28) (>= value 19) (<= value 28)
         (= a (enc-add-i 10 index k0)) (= a1 (enc-add-i 10 index k1))
         (= a2 (enc-add-i 10 index k2))
         (= b (gn-e-bf 0xd3400000 0 value 0 7))
         (= (sf-word M (+ at 4)) b) (= (sf-word M (+ at 7)) b)
         (= (sf-word M (+ at 2)) (gn-e-strr3 0 4 10))
         (= (sf-word M (+ at 5)) (gn-e-strr3 0 4 10))
         (= (sf-word M (+ at 8)) (gn-e-strr3 0 4 10))
         (mw3-clear M at (dec cn)))) M
     (-> M (gn-put MM-CODE-N at)
      (gn-emit (gn-e-addsl 10 4 index 3)) (gn-emit b)
      (gn-emit (enc-str 0 10 (* k0 8)))
      (gn-emit (enc-str 0 10 (* k1 8)))
      (gn-emit (enc-str 0 10 (* k2 8)))
      (gn-emit a2)))))))

(defn- gn-call-mask-writer [M :vector-i64 t :i64] :vector-i64
 (if (and (= (gn-g M gn-f-vmode) 4) (= (gn-g M gn-f-freg) 3))
  (let [m1 (gn-pin M (inc t)) ri (gn-pinned m1 (inc t))]
   (-> m1 (gn-mask-into 0 (+ t 2) 8)
       (gn-emit (gn-e-strr3 0 4 ri)) (gn-gs gn-f-h (inc t)) (mw3-fold)))
  (let [M1 (-> M (gn-pin t) (gn-pin (inc t)))
        rv (gn-pinned M1 t) ri (gn-pinned M1 (inc t))]
    (-> M1 (gn-ctx) (pf-load) (gn-mask-charge)
        (gn-mask-into 0 (+ t 2) 8)
        (gn-mask-charge) (gn-hchk rv 312 320) (gn-vidx ri)
        (gn-emit (gn-e-strr3 0 16 17)) (gn-emit (enc-str 8 7 CTX-FUEL))
        (gn-gs gn-f-h (inc t))))))

;; In fully prepaid freg3 regions, the header initializes x8=CTX-FUEL.
;; All admitted body operations preserve this relation. Reuse that register
;; only here; ordinary helper fuel transactions retain their load/store.
;; x8 reproduces the original leaf's fuel transaction; CSEL comparisons
;; use signed flags and do not subtract bounds in language arithmetic.
(defn- gn-call-clamp [M :vector-i64 i :i64 f :i64 t :i64 q :i64] :vector-i64
  (let [p (gn-fnf M f FF-SIR) fuel (= (gn-op M (inc p)) OP-FUEL)
        w (gn-sign-wrapper M (gn-sir M (inc q) IF-A) 1)
        charged (or fuel (>= w 1536)) width (bit-and w 511)
        low (gn-sir M (+ q 4) IF-B) high (gn-sir M (+ q 11) IF-B)]
    (-> M (gn-into 0 t) (gn-ctx)
        (cond-> (and charged (not= (gn-g M gn-f-freg) 3)) (pf-load)
                fuel (gn-mask-charge)
                (>= w 1536) (gn-mask-charge))
        (gn-emit (gn-e-bf 0x93400000 0 0 0 (dec width)))
        (gn-mov-imm 16 low) (gn-emit (enc-cmp-r 0 16))
        (gn-emit (enc-csel 0 16 0 (enc-cond-lt)))
        (gn-mov-imm 17 high) (gn-emit (enc-cmp-r 0 17))
        (gn-emit (enc-csel 0 17 0 (enc-cond-gt)))
        (cond-> (and charged (not= (gn-g M gn-f-freg) 3))
          (gn-emit (enc-str 8 7 CTX-FUEL)))
        (gn-take i t 0))))

;; Bounded structural proof that a direct callee returns with input x7.
;; A shared remaining-work budget counts all transitive SIR instructions; it
;; prevents exponential rescanning. Unknown effects/operations fail closed.
;; Caller frame, real call and every fuel/trap/publication boundary remain.
(defn- gn-ctx-safe [M :vector-i64 f :i64 n :i64 depth :i64 work :i64] :i64
  (let [p (gn-fnf M f FF-SIR)]
    (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0) (> depth 0) (> work 0)
             (not (and (>= f (gn-g M gn-g-open)) (< f (+ (gn-g M gn-g-open) (gn-g M gn-g-open-n)))))
             (<= n 7) (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) n))
      (gn-ctx-scan M (inc p) f depth (dec work)) -1)))
(defn- gn-ctx-scan [M :vector-i64 j :i64 f :i64 depth :i64 work :i64] :i64
  (if (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) -1
    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
          left (dec work)]
      (case op
        OP-END (if (= a f) left -1)
        (OP-CONST OP-LGET OP-LSET OP-BIN OP-CMP OP-UN OP-LABEL OP-BR OP-BRZ OP-BRNZ OP-FUEL OP-RET OP-RET2 OP-RES2 OP-TRAP OP-TAB OP-FADDR)
        (gn-ctx-scan M (inc j) f depth left)
        OP-RT (if (gn-inl a b c) (gn-ctx-scan M (inc j) f depth left) -1)
        OP-CALL (let [remain (gn-ctx-safe M a c (dec depth) left)]
                  (if (< remain 0) -1 (gn-ctx-scan M (inc j) f depth remain)))
        -1))))

;; Exact closed frameless scalar low-bit mask. Optional one entry charge.
;; Keep separate from gn-call-wrapper: original caller nonleaf prescan remains.
;; Token width +256*charged; zero means refusal. No names or input guesses.
;; Repeated-call admission limits expansion to shared scalar helpers.
;; This is a static code-growth heuristic, not a proof of dynamic time share.
;; Work exhaustion refuses; finding two direct scalar call sites is enough.
(defn- gn-mask-reused [M :vector-i64 f :i64 j :i64 seen :i64 work :i64] :bool
 (cond (>= seen 2) true
       (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) false
       :else (gn-mask-reused M f (inc j)
          (+ seen (if (and (= (gn-op M j) OP-CALL) (= (gn-sir M j IF-A) f)
                           (= (gn-sir M j IF-C) 1) (not= (gn-op M (inc j)) OP-RES2)) 1 0)) (dec work))))
(defn- gn-scalar-mask [M :vector-i64 i :i64 f :i64 n :i64] :i64
 (let [p (gn-fnf M f FF-SIR)
       fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
       q (gn-skiplab M (+ p 1 fuel)) mask (gn-sir M (inc q) IF-B)]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0)
           (not (gn-clamp-open M f)) (= n 1)
           (not= (gn-op M (inc i)) OP-RES2)
           (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-PT0) TY-I64)
           (= (gn-fnf M f FF-RTYPE) TY-I64)
           (= (gn-fnf M f FF-NSLOTS) 1) (<= (gn-fnf M f FF-DEPTH) 2)
           (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 1)
           (= (gn-op M q) OP-LGET) (= (gn-sir M q IF-A) 0) (= (gn-sir M q IF-B) 1)
           (= (gn-op M (inc q)) OP-CONST) (= (gn-sir M (inc q) IF-A) 1)
           (> mask 0) (= (bit-and mask (inc mask)) 0)
           (= (gn-op M (+ q 2)) OP-BIN) (= (gn-sir M (+ q 2) IF-A) BOP-AND)
           (= (gn-sir M (+ q 2) IF-B) 0) (= (gn-sir M (+ q 2) IF-C) 0)
           (= (gn-op M (+ q 3)) OP-RET) (= (gn-sir M (+ q 3) IF-A) 0)
           (= (gn-op M (+ q 4)) OP-END) (= (gn-sir M (+ q 4) IF-A) f)
           (gn-mask-reused M f 1 0 16384))
      (+ (gn-tz (inc mask) 0) (* fuel 256)) 0)))
(defn- gn-call-scalar-mask [M :vector-i64 i :i64 t :i64 token :i64] :vector-i64
 (let [width (bit-and token 255) charged (>= token 256)]
  (-> M (gn-into 0 t) (gn-ctx)
      (cond-> (and charged (not= (gn-g M gn-f-freg) 3))
       (gn-emit (enc-ldr 8 7 CTX-FUEL)) charged (gn-mask-charge))
      (gn-emit (gn-e-bf 0xd3400000 0 0 0 (dec width)))
      (cond-> (and charged (not= (gn-g M gn-f-freg) 3))
          (gn-emit (enc-str 8 7 CTX-FUEL)))
      (gn-take i t 0))))
;; Exact closed frameless affine-index vector reader. Preserve caller frame.
;; The callee's entry fuel remains private in x8 until success or exhaustion;
;; invalid handle/index traps retain pre-call published fuel. No check hoisting.
(defn- gn-affine-reader [M :vector-i64 i :i64 f :i64 n :i64] :i64
 (let [p (gn-fnf M f FF-SIR) fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
       q (gn-skiplab M (+ p 1 fuel))]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0)
           (= (gn-g M gn-f-leaf) 0) (not (gn-clamp-open M f)) (= n 2)
           (not= (gn-op M (inc i)) OP-RES2)
           (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-PT0) TY-VEC)
           (= (gn-fnf M f (inc FF-PT0)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-I64)
           (= (gn-fnf M f FF-NSLOTS) 2) (<= (gn-fnf M f FF-DEPTH) 3)
           (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 2)
           (= (gn-sir M p IF-C) 2)
           (= (gn-op M q) OP-LGET) (= (gn-sir M q IF-A) 0) (= (gn-sir M q IF-B) 1)
           (= (gn-op M (+ q 1)) OP-LGET) (= (gn-sir M (+ q 1) IF-A) 1) (= (gn-sir M (+ q 1) IF-B) 2)
           (= (gn-op M (+ q 2)) OP-CONST) (= (gn-sir M (+ q 2) IF-A) 2)
           (= (gn-op M (+ q 3)) OP-BIN) (= (gn-sir M (+ q 3) IF-A) BOP-MUL)
           (= (gn-sir M (+ q 3) IF-B) 1) (= (gn-sir M (+ q 3) IF-C) 0)
           (= (gn-op M (+ q 4)) OP-RT) (= (gn-sir M (+ q 4) IF-A) RT-VECTOR-AT)
           (= (gn-sir M (+ q 4) IF-B) 0) (= (gn-sir M (+ q 4) IF-C) 2)
           (= (gn-op M (+ q 5)) OP-RET) (= (gn-sir M (+ q 5) IF-A) 0)
           (= (gn-op M (+ q 6)) OP-END) (= (gn-sir M (+ q 6) IF-A) f)) q 0)))
(defn- gn-call-affine-reader [M :vector-i64 i :i64 t :i64 f :i64 q :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) charged (= (gn-op M (inc p)) OP-FUEL)
       k (gn-sir M (+ q 2) IF-B) shift (gn-pow2 k)]
  (-> M (gn-into 0 t) (gn-into 1 (inc t)) (gn-ctx)
      (cond-> charged (gn-emit (enc-ldr 8 7 CTX-FUEL)) charged (gn-mask-charge))
      (cond-> (> shift 0) (gn-emit (gn-e-lsl 1 1 shift))
              (<= shift 0) (gn-mov-imm 2 k) (<= shift 0) (gn-emit (enc-mul 1 1 2)))
      (gn-vread 0 1 0)
      (cond-> charged (gn-emit (enc-str 8 7 CTX-FUEL))) (gn-take i t 0))))
;; Exact closed vector/row/column reader, with original wrapped i64 indexing.
;; No check moves before the original private entry charge or arithmetic.
(defn- mr-reader [M :vector-i64 i :i64 f :i64 n :i64] :i64
 (let [p (gn-fnf M f FF-SIR) fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
       q (gn-skiplab M (+ p 1 fuel))]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0)
       (< (+ q 8) (vector-at M MM-SIR-N)) (= n 3)
       (= (gn-g M gn-f-leaf) 0) (< (gn-g M gn-f-vmode) 2) (not (gn-clamp-open M f))
       (not= (gn-op M (inc i)) OP-RES2)
       (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
       (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-RTYPE) TY-I64)
       (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
       (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
       (gn-dot-at? M p OP-FN f 3 3)
       (or (= fuel 0) (gn-dot-at? M (inc p) OP-FUEL 0 0 0))
       (gn-dot-at? M q OP-LGET 0 1 0)
       (gn-dot-at? M (+ q 1) OP-LGET 1 2 0)
       (= (gn-op M (+ q 2)) OP-CONST) (= (gn-sir M (+ q 2) IF-A) 2)
       (= (gn-sir M (+ q 2) IF-C) 0)
       (gn-dot-at? M (+ q 3) OP-BIN BOP-MUL 1 0)
       (gn-dot-at? M (+ q 4) OP-LGET 2 3 0)
       (gn-dot-at? M (+ q 5) OP-BIN BOP-ADD 1 0)
       (gn-dot-at? M (+ q 6) OP-RT RT-VECTOR-AT 0 2)
       (gn-dot-at? M (+ q 7) OP-RET 0 0 0)
       (gn-dot-at? M (+ q 8) OP-END f 0 0)) q 0)))
(defn- mr-call [M :vector-i64 i :i64 t :i64 f :i64 q :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) charged (= (gn-op M (inc p)) OP-FUEL)
       k (gn-sir M (+ q 2) IF-B)]
  (-> M (gn-into 0 t) (gn-into 1 (inc t)) (gn-into 2 (+ t 2)) (gn-ctx)
       (cond-> charged (gn-emit (enc-ldr 8 7 CTX-FUEL)) charged (gn-mask-charge))
       (gn-mov-imm 16 k) (gn-emit (enc-mul 1 1 16)) (gn-emit (enc-add-r 1 1 2))
       (gn-vread 0 1 0)
       (cond-> charged (gn-emit (enc-str 8 7 CTX-FUEL))) (gn-take i t 0))))
;; Novel bounded pure scalar DAG call-edge expansion. No SIR/FN mutation.
;; All caller allocation/frame remains ordinary nonleaf. Generic callee remains.
(def di-used (+ gn-g-open-n 1))
(def di-sites (+ gn-g-open-n 2))
(def di-snap (+ gn-g-open-n 3))
;; One cell after existing DAG banks and two index-witness cells. Whole-function
;; x7 preservation witness; all fuel publication and checked accesses remain.
(defn- cc-safe [M :vector-i64 f :i64 n :i64 depth :i64 work :i64] :i64
 (let [p (gn-fnf M f FF-SIR)]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0)
           (> depth 0) (> work 0) (not (gn-clamp-open M f))
           (>= n 0) (<= n 7) (= (gn-fnf M f FF-NPARAMS) n)
           (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) n))
    (cc-scan M (inc p) f n depth (dec work)) -1)))
(defn- cc-scan [M :vector-i64 j :i64 f :i64 n :i64 depth :i64 work :i64] :i64
 (if (or (>= j (vector-at M MM-SIR-N)) (<= work 0)) -1
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
        left (dec work)]
   (case op
    OP-END (if (= a f) left -1)
    (OP-CONST OP-LGET OP-LSET OP-LABEL OP-BR OP-BRZ OP-BRNZ OP-FUEL OP-RET OP-RET2 OP-RES2 OP-TRAP OP-TAB)
      (cc-scan M (inc j) f n depth left)
    OP-BIN (if (< a BOP-F64-ADD) (cc-scan M (inc j) f n depth left) -1)
    OP-CMP (if (< a CC-F64-EQ) (cc-scan M (inc j) f n depth left) -1)
    OP-UN (if (< a UOP-F64-NEG) (cc-scan M (inc j) f n depth left) -1)
    OP-RT (if (or (gn-inl a b c)
                  (and (= a RT-VECTOR-AT) (= c 2) (>= b 6)
                       (>= (gn-fnf M f FF-DEPTH) (+ b 2)) (gn-high-loop M j)))
              (cc-scan M (inc j) f n depth left) -1)
    OP-CALL (let [remain (if (and (= a f) (= c n)) left (cc-safe M a c (dec depth) left))]
      (if (< remain 0) -1 (cc-scan M (inc j) f n depth remain)))
    -1))))

(defn- di-type [ty :i64] :bool (or (= ty TY-I64) (= ty TY-BOOL)))
(defn- di-params [M :vector-i64 f :i64 k :i64 n :i64] :bool
 (or (= k n) (and (di-type (gn-fnf M f (+ FF-PT0 k))) (di-params M f (inc k) n))))
(defn- di-bit [k :i64] :i64 (i64-shift-left 1 k))
(defn- di-have [mask :i64 k :i64] :bool (not= (bit-and mask (di-bit k)) 0))
(defn- di-bin [a :i64] :bool
 (or (= a BOP-QUOT) (= a BOP-ADD) (= a BOP-SUB) (= a BOP-MUL) (= a BOP-AND) (= a BOP-OR) (= a BOP-XOR)
     (= a BOP-SHL) (= a BOP-USHR) (= a BOP-SSHR)))
;; Returns exact END index, or zero. Iterative finite32-instruction certificate.
(defn- di-body [M :vector-i64 p :i64 f :i64 ns :i64 dp :i64 n :i64] :i64
 (loop [j (inc p) h 0 locals (dec (di-bit (inc n))) work 32]
  (if (or (<= work 0) (>= (inc j) (vector-at M MM-SIR-N))) 0
   (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
         dst (if (or (= op OP-CONST) (= op OP-LGET)) a b)
         valid (case op
          OP-LABEL (and (= j (inc p)) (> a 0) (< a MM-LABEL-CAP) (= b 0) (= c 0))
          OP-CONST (and (>= a 0) (<= a h) (< a dp) (= c 0))
          OP-LGET (and (>= a 0) (<= a h) (< a dp) (> b 0) (<= b ns) (di-have locals b) (= c 0))
          OP-LSET (and (> a 0) (<= a ns) (>= b 0) (< b h) (= c 0))
          OP-BIN (and (di-bin a) (>= b 0) (< (inc b) h) (= c 0))
          OP-CMP (and (>= a CC-EQ) (<= a CC-GE) (>= b 0) (< (inc b) h) (= c 0))
          OP-UN (and (or (= a UOP-NOT) (= a UOP-BITNOT)) (>= b 0) (< b h) (= c 0))
          OP-RET (and (>= a 0) (< a h) (= b 0) (= c 0)
                      (= (gn-op M (inc j)) OP-END) (= (gn-sir M (inc j) IF-A) f)
                      (= (gn-sir M (inc j) IF-B) 0) (= (gn-sir M (inc j) IF-C) 0))
          false)]
    (cond (not valid) 0
          (= op OP-RET) (inc j)
          :else (recur (inc j) (if (or (= op OP-CONST) (= op OP-LGET) (= op OP-BIN) (= op OP-CMP) (= op OP-UN)) (inc dst) h)
                      (if (= op OP-LSET) (bit-or locals (di-bit a)) locals) (dec work)))))))
(defn- dc-body [M :vector-i64 p :i64 f :i64 ns :i64 dp :i64 n :i64] :i64
 (loop [j (+ p 2) h 0 locals (dec (di-bit (inc n))) work 32]
  (if (or (<= work 0) (>= (+ j 3) (vector-at M MM-SIR-N))) 0
   (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
         dst (if (or (= op OP-CONST) (= op OP-LGET)) a b)
         mask (if (= op OP-CALL) (gn-scalar-mask M j a c) 0)
         valid (case op
          OP-LABEL (and (= j (+ p 2)) (> a 0) (< a MM-LABEL-CAP) (= b 0) (= c 0))
          OP-CONST (and (>= a 0) (<= a h) (< a dp) (= c 0))
          OP-LGET (and (>= a 0) (<= a h) (< a dp) (> b 0) (<= b ns) (di-have locals b) (= c 0))
          OP-LSET (and (> a 0) (<= a ns) (>= b 0) (< b h) (= c 0))
          OP-BIN (and (di-bin a) (>= b 0) (< (inc b) h) (= c 0))
          OP-UN (and (= a UOP-BITNOT) (>= b 0) (< b h) (= c 0))
          OP-CALL (and (> mask 0) (< mask 256) (= c 1) (>= b 0) (< b h)
             (= (gn-op M (inc j)) OP-RET) (= (gn-sir M (inc j) IF-A) b)
             (= (gn-sir M (inc j) IF-B) 0) (= (gn-sir M (inc j) IF-C) 0)
             (= (gn-op M (+ j 2)) OP-END) (= (gn-sir M (+ j 2) IF-A) f)
             (= (gn-sir M (+ j 2) IF-B) 0) (= (gn-sir M (+ j 2) IF-C) 0))
          false)]
    (cond (not valid) 0
          (= op OP-CALL) (+ j 2)
          :else (recur (inc j) (if (or (= op OP-CONST) (= op OP-LGET) (= op OP-BIN) (= op OP-UN)) (inc dst) h)
                      (if (= op OP-LSET) (bit-or locals (di-bit a)) locals) (dec work)))))))
(defn- di-shape [M :vector-i64 f :i64 n :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (< n 1) (> n 5) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR) ns (gn-fnf M f FF-NSLOTS) dp (gn-fnf M f FF-DEPTH)]
   (if (and (> p 0) (< p (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) n) (= (gn-sir M p IF-C) ns)
       (= (gn-fnf M f FF-NPARAMS) n) (>= ns n) (<= ns 7) (> dp 0) (<= dp 7)
       (di-type (gn-fnf M f FF-RTYPE)) (di-params M f 0 n))
    (if (= (gn-op M (inc p)) OP-FUEL)
      (if (and (<= ns 6) (= (gn-sir M (inc p) IF-A) 0)
               (= (gn-sir M (inc p) IF-B) 0) (= (gn-sir M (inc p) IF-C) 0))
        (dc-body M p f ns dp n) 0)
      (di-body M p f ns dp n)) 0))))
;; Caller argument source banks are disjoint from x0..4 destinations.
(defn- di-args-safe [M :vector-i64 t :i64 n :i64] :bool
 (if (= n 0) true
  (let [k (gn-dk M t) v (gn-dv M t) r (if (= k gn-k-local) (gn-sreg M v) -1)]
   (and (or (= k gn-k-const) (= k gn-k-reg) (= k gn-k-home)
            (and (= k gn-k-local) (> v 0) (<= v (gn-g M gn-f-ns)) (or (< r 0) (and (>= r 19) (<= r 28)))))
        (di-args-safe M (inc t) (dec n))))))
(defn- di-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (and (= (gn-g M gn-f-leaf) 0) (> (gn-g M gn-f-fb) 0) (>= t 0) (> n 0) (<= n 5)
          (<= (+ t n) (gn-g M gn-f-h)) (<= (+ t n) (gn-g M gn-f-dp))
          (not= (gn-op M (inc i)) OP-RET) (not= (gn-op M (inc i)) OP-RES2)
          (< (gn-g M di-sites) 256) (< (gn-g M di-used) 4096) (di-args-safe M t n))
  (di-shape M f n) 0))
;; Snapshot38 cells: scalar0..15, sreg0..7, dk0..6, dv0..6.
(defn- di-field [k :i64] :i64
 (cond (< k 16) k (< k 24) (+ gn-a-sreg (- k 16)) (< k 31) (+ gn-a-dk (- k 24))
       :else (+ gn-a-dv (- k 31))))
(defn- di-save [M :vector-i64 bank :i64 k :i64] :vector-i64
 (if (= k 38) M (di-save (gn-gs M (+ di-snap (+ (* bank 38) k)) (gn-g M (di-field k))) bank (inc k))))
(defn- di-restore [M :vector-i64 bank :i64 k :i64] :vector-i64
 (if (= k 38) M (di-restore (gn-gs M (di-field k) (gn-g M (+ di-snap (+ (* bank 38) k)))) bank (inc k))))
(defn- di-init [M :vector-i64 f :i64] :vector-i64
 (-> M (gn-zero 0 16) (gn-zero gn-a-sreg (+ gn-a-sreg 8))
       (gn-zero gn-a-dk (+ gn-a-dk 7)) (gn-zero gn-a-dv (+ gn-a-dv 7))
       (gn-gs gn-f-leaf 1) (gn-gs gn-f-ns (gn-fnf M f FF-NSLOTS))
       (gn-gs gn-f-dp (gn-fnf M f FF-DEPTH)) (gn-lowregs 1 (gn-fnf M f FF-NSLOTS))))
;; No fn/ret/prologue/layout instruction is emitted; exact scalar emitters only.
(defn- di-constants [M :vector-i64 t :i64 k :i64 n :i64] :vector-i64
 (if (= k n) M
  (let [constant (= (gn-dk M (+ t k)) gn-k-const)
        m1 (gn-gs M (+ di-const-base k) (if constant (gn-dv M (+ t k)) 0))
        m2 (if constant (gn-gs m1 di-const-mask (bit-or (gn-g m1 di-const-mask) (di-bit (inc k)))) m1)]
   (di-constants m2 t (inc k) n))))
;; ADR0357 bounded source-owned DI reassociation. No native-word patching.
;; Only the existing closed DI straight-line emitter invokes these helpers.
(defn- dia-constant? [M :vector-i64 j :i64 t :i64] :bool
 (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
  (and (= a (inc t)) (= (gn-sir M j IF-C) 0)
   (or (= op OP-CONST)
    (and (= op OP-LGET) (> b 0) (<= b 5)
         (di-have (gn-g M di-const-mask) b))))))
(defn- dia-constant [M :vector-i64 j :i64] :i64
 (let [b (gn-sir M j IF-B)]
  (if (= (gn-op M j) OP-CONST) b
   (gn-g M (+ di-const-base (dec b))))))
(defn- dia-shape [M :vector-i64 j :i64 end :i64 bop :i64 t :i64] :i64
 (if (or (not= bop BOP-ADD) (< t 0) (> t 5) (>= (+ j 3) (inc end))
          (< (gn-g M gn-f-h) (+ t 2)) (>= (inc t) (gn-g M gn-f-dp))) 0
  (if (and (dia-constant? M (inc j) t)
           (gn-dot-at? M (+ j 2) OP-BIN BOP-ADD t 0)
           (= (gn-co M (+ j 2) t) 0))
   (let [lower (gn-isk M t gn-k-const) upper (gn-isk M (inc t) gn-k-const)
         slot (if lower t (inc t)) c1 (gn-dv M slot) c2 (dia-constant M (inc j))]
    (if (and (not= lower upper) (>= c1 0) (<= c1 4095)
             (>= c2 0) (<= c2 (- 4095 c1))) (if lower 1 2) 0)) 0)))
(defn- dia-emit [M :vector-i64 j :i64 t :i64 mode :i64] :vector-i64
 (let [slot (if (= mode 1) t (inc t)) c1 (gn-dv M slot)
       c2 (dia-constant M (inc j))
       out (gn-op-bin (gn-dset M slot gn-k-const (+ c1 c2)) (+ j 2) BOP-ADD t)]
  ;; The skipped CONST/constant LGET leaves this dead upper descriptor behind.
  (-> out (gn-dset (inc t) gn-k-const c2) (gn-gs gn-f-skip 2))))

(defn- di-emit-body [M :vector-i64 j :i64 end :i64] :vector-i64
 (if (or (>= j end) (not= (vector-at M MM-ERR) 0)) M
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
        m1 (case op
             OP-CONST (gn-def M a gn-k-const b)
             OP-LGET (if (and (<= b 5) (di-have (gn-g M di-const-mask) b))
                        (gn-def M a gn-k-const (gn-g M (+ di-const-base (dec b))))
                        (gn-def M a gn-k-local b))
             OP-LSET (-> (gn-op-lset M a b)
                         (gn-gs di-const-mask (bit-and (gn-g M di-const-mask) (bit-not (di-bit a)))))
             OP-BIN (let [mode (dia-shape M j end a b)]
                      (if (> mode 0) (dia-emit M j b mode) (gn-op-bin M j a b)))
             OP-CMP (gn-op-cmp M j a b)
             OP-UN (gn-op-un M j a b)
             OP-CALL (gn-call-scalar-mask M j b (gn-scalar-mask M j a (gn-sir M j IF-C)))
             OP-LABEL M
             OP-RET (gn-into M 0 a)
             (gn-err M E-GEN-OP op))
        skip (gn-g m1 gn-f-skip)]
   (di-emit-body (gn-gs m1 gn-f-skip 0) (+ j 1 skip) end))))
(defn- di-call [M :vector-i64 i :i64 f :i64 t :i64 n :i64 end :i64] :vector-i64
 (let [code (vector-at M MM-CODE-N) fix (vector-at M MM-FIX-N)
       m0 (-> M (di-save 0 0) (gn-zero di-const-mask (+ di-const-base 5)) (di-constants t 0 n))
       ;; Certified body temps write x9..x(8+DP); low locals are x0..x6.
       ;; Argument capture, context/fuel and arithmetic scratch avoid x9..15.
       ;; Preserve higher live temps while retaining every genuinely clobbered save.
       m1 (-> m0 (gn-save-clobbered 0 t (i64-shift-left (dec (di-bit (gn-fnf M f FF-DEPTH))) 9)) (gn-args t 0 n) (gn-ctx) (di-save 1 0))
       p (gn-fnf M f FF-SIR) charged (= (gn-op M (inc p)) OP-FUEL)
       ;; A terminal mask makes the original callee nonleaf in gn-pre-op.
       ;; Emit that exact memory transaction before entering the scalar bank;
       ;; never substitute a leaf x8 transaction or defer publication to RET.
       entry (if charged (gn-op-fuel (gn-gs m1 gn-f-freg 0)) m1)
       bank (cond-> (di-init entry f) charged (gn-gs gn-f-ctx 1))
       m2 (di-emit-body bank (+ p 1 (if charged 1 0)) end)
       m3 (-> m2 (di-restore 1 0) (gn-vclear) (gn-gs gn-f-ctx 1) (gn-take i t 0))
       words (- (vector-at m3 MM-CODE-N) code)
       good (and (<= words 64) (<= (+ (gn-g m3 di-used) words) 4096) (= (vector-at m3 MM-FIX-N) fix))]
  (cond (not= (vector-at m3 MM-ERR) 0) m3
        good (-> m3 (gn-gs di-used (+ (gn-g m3 di-used) words))
                 (gn-gs di-sites (inc (gn-g m3 di-sites))))
        :else (-> m3 (di-restore 0 0) (gn-put MM-CODE-N code) (gn-put MM-FIX-N fix)
                  (gn-call-generic i f t n)))))

;; SOURCE ONLY, not compiled. Novel algorithm; one-off authoring exception.
;; Bounded ordered split immutable table reader call-edge collapse.
;; No names, benchmark edits, new literal/heap cells, or CPU feature assumptions.
;; Reuses existing di snapshot and shared site/word budgets.

(defn- tc-end [M :vector-i64 p :i64 f :i64] :i64
 (loop [j (+ p 2) work 256]
  (cond (or (<= work 0) (>= j MM-SIR-CAP) (>= j (vector-at M MM-SIR-N))) 0
        (= (gn-op M j) OP-END) (if (gn-dot-at? M j OP-END f 0 0) j 0)
        (= (gn-op M j) OP-FN) 0
        :else (recur (inc j) (dec work)))))

;; Label identity is unique inside the certified whole body.
(defn- tc-label [M :vector-i64 p :i64 end :i64 lab :i64] :i64
 (loop [j (+ p 2) found 0]
  (if (>= j end) found
   (if (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) lab))
    (if (> found 0) 0 (recur (inc j) j))
    (recur (inc j) found)))))

(defn- tc-lit [M :vector-i64 lit :i64] :bool
 (and (> lit 0) (< lit (vector-at M MM-LIT-N)) (< lit MM-LIT-CAP)
      (= (gn-litf M lit LF-LEN) 128)
      (>= (vector-at M MM-LITB-N) 128)
      (<= (vector-at M MM-LITB-N) MM-LITB-CAP)
      (>= (gn-litf M lit LF-B) 0)
      (<= (gn-litf M lit LF-B) (- (vector-at M MM-LITB-N) 128))
      (<= (gn-litf M lit LF-B) (- MM-LITB-CAP 128))))

;; Every data/selector group has exact defined-before-read stack structure.
(defn- tc-test [M :vector-i64 j :i64] :bool
 (and (gn-dot-at? M j OP-LGET 0 1 0)
      (= (gn-op M (inc j)) OP-CONST) (= (gn-sir M (inc j) IF-A) 1)
      (= (gn-sir M (inc j) IF-C) 0)
      (gn-dot-at? M (+ j 2) OP-CMP CC-LT 0 0)
      (= (gn-op M (+ j 3)) OP-BRZ) (= (gn-sir M (+ j 3) IF-A) 0)
      (= (gn-sir M (+ j 3) IF-C) 0)))
(defn- tc-leaf [M :vector-i64 j :i64] :bool
 (and (gn-dot-at? M j OP-LGET 0 1 0)
      (= (gn-op M (inc j)) OP-CONST) (= (gn-sir M (inc j) IF-A) 1)
      (= (gn-sir M (inc j) IF-C) 0)
      (gn-dot-at? M (+ j 2) OP-BIN BOP-SUB 0 0)
      (= (gn-op M (+ j 3)) OP-TAB) (= (gn-sir M (+ j 3) IF-A) 0)
      (= (gn-sir M (+ j 3) IF-C) 16)
      (tc-lit M (gn-sir M (+ j 3) IF-B))))

;; Validate all source nodes, including nodes not selected by one path.
;; Only forward edges are accepted; entry FUEL is outside this grammar.
;; Return exact number of 16-item leaves, or -1.
(defn- tc-scan [M :vector-i64 p :i64 end :i64 base :i64] :i64
 (loop [j (+ p 2) leaves 0]
  (cond (>= j end) leaves
        (= (gn-op M j) OP-LABEL)
         (if (and (gn-dot-at? M j OP-LABEL (gn-sir M j IF-A) 0 0)
                  (> (gn-sir M j IF-A) 0) (< (gn-sir M j IF-A) MM-LABEL-CAP)
                  (= (tc-label M p end (gn-sir M j IF-A)) j))
          (recur (inc j) leaves) -1)
        (= (gn-op M j) OP-BR)
         (if (and (gn-dot-at? M j OP-BR (gn-sir M j IF-A) 0 0)
                  (> (tc-label M p end (gn-sir M j IF-A)) j))
          (recur (inc j) leaves) -1)
        (= j (dec end)) (if (gn-dot-at? M j OP-RET 0 0 0) leaves -1)
        (>= (+ j 3) end) -1
        (tc-test M j)
         (if (> (tc-label M p end (gn-sir M (+ j 3) IF-B)) (+ j 3))
          (recur (+ j 4) leaves) -1)
        (tc-leaf M j)
         (if (and (= (gn-sir M (+ j 3) IF-B) (+ base leaves))
                  (= (gn-sir M (inc j) IF-B) (* leaves 16)))
          (recur (+ j 4) (inc leaves)) -1)
        :else -1)))

;; After the one table value read, only pure forward joins and final RET.
(defn- tc-return [M :vector-i64 p :i64 end :i64 pc :i64] :bool
 (loop [j pc work 256]
  (cond (or (<= work 0) (>= j end)) false
        (= (gn-op M j) OP-LABEL) (recur (inc j) (dec work))
        (= (gn-op M j) OP-BR)
         (let [to (tc-label M p end (gn-sir M j IF-A))]
          (if (> to j) (recur to (dec work)) false))
        :else (and (= j (dec end)) (gn-dot-at? M j OP-RET 0 0 0)))))

;; Finite path certificate gives lit*256+local index; zero means refusal.
;; Called only after complete tc-scan admission; no data values are computed.
(defn- tc-path [M :vector-i64 p :i64 end :i64 x :i64] :i64
 (loop [j (+ p 2) work 256]
  (cond (or (<= work 0) (>= (+ j 3) end)) 0
        (= (gn-op M j) OP-LABEL) (recur (inc j) (dec work))
        (= (gn-op M j) OP-BR)
         (let [to (tc-label M p end (gn-sir M j IF-A))]
          (if (> to j) (recur to (dec work)) 0))
        (tc-test M j)
         (let [to (if (< x (gn-sir M (inc j) IF-B)) (+ j 4)
                      (tc-label M p end (gn-sir M (+ j 3) IF-B)))]
          (if (> to j) (recur to (dec work)) 0))
        (tc-leaf M j)
         (let [idx (- x (gn-sir M (inc j) IF-B))]
          (if (and (>= idx 0) (< idx 16) (tc-return M p end (+ j 4)))
           (+ (* (gn-sir M (+ j 3) IF-B) 256) idx) 0))
        :else 0)))
(defn- tc-cover [M :vector-i64 p :i64 end :i64 base :i64 n :i64] :bool
 (loop [x 0]
  (or (= x n)
      (and (= (tc-path M p end x) (+ (* (+ base (quot x 16)) 256) (bit-and x 15)))
           (recur (inc x))))))

;; The immediate AND/LSET/LGET suffix proves the sole captured argument.
;; No name, earlier local search, or speculative/unknown range premise.
(defn- tc-mask [M :vector-i64 i :i64 t :i64] :i64
 (if (< i 5) 0
  (let [mask (gn-sir M (- i 4) IF-B) slot (gn-sir M (- i 1) IF-B)]
   (if (and (>= mask 31) (<= mask 255) (= (bit-and mask (inc mask)) 0)
            (> slot 0) (< slot gn-cap) (<= slot (gn-g M gn-f-ns))
            (gn-dot-at? M (- i 4) OP-CONST (inc t) mask 0)
            (gn-dot-at? M (- i 3) OP-BIN BOP-AND t 0)
            (gn-dot-at? M (- i 2) OP-LSET slot t 0)
            (gn-dot-at? M (- i 1) OP-LGET t slot 0)) (inc mask) 0))))

;; Range check LOCAL descriptor before existing di-args-safe reads sreg.
(defn- tc-arg-safe [M :vector-i64 t :i64] :bool
 (and (or (not= (gn-dk M t) gn-k-local)
          (and (> (gn-dv M t) 0) (< (gn-dv M t) gn-cap)
               (<= (gn-dv M t) (gn-g M gn-f-ns))))
      (di-args-safe M t 1)))

;; Return first literal ID. Original FN, literal records and all SIR retained.
(defn- tc-admit [M :vector-i64 i :i64 f :i64 t :i64 narg :i64] :i64
 (if (or (< i 5) (>= i (- MM-SIR-CAP 1))
         (<= (vector-at M MM-SIR-N) 2) (> (vector-at M MM-SIR-N) MM-SIR-CAP)
         (>= i (dec (vector-at M MM-SIR-N)))
         (not= narg 1) (not= (gn-g M gn-f-leaf) 0) (< t 0) (> t 6)
         (< (gn-g M gn-f-ns) 1) (>= (gn-g M gn-f-ns) gn-cap)
         (< (gn-g M gn-f-dp) 1) (> (gn-g M gn-f-dp) gn-cap)
         (> (gn-g M gn-f-h) (gn-g M gn-f-dp))
         (<= (gn-g M gn-f-fb) 0) (> (inc t) (gn-g M gn-f-h))
         (> (inc t) (gn-g M gn-f-dp)) (not (tc-arg-safe M t))
         (< f 1) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)
         (= (gn-op M (inc i)) OP-RET) (= (gn-op M (inc i)) OP-RES2)
         (>= (gn-g M di-sites) 256) (>= (gn-g M di-used) 4096)) 0
  (let [p (gn-fnf M f FF-SIR) n (tc-mask M i t)]
   (if (or (= n 0) (<= p 0) (>= p (- (vector-at M MM-SIR-N) 2))
           (not= (gn-fnf M f FF-RTYPE) TY-I64) (not= (gn-fnf M f FF-PT0) TY-I64)
           (not= (gn-fnf M f FF-NPARAMS) 1) (not= (gn-fnf M f FF-NSLOTS) 1)
           (not= (gn-fnf M f FF-DEPTH) 2)
           (not (gn-dot-at? M p OP-FN f 1 1))
           (not (gn-dot-at? M (inc p) OP-FUEL 0 0 0))) 0
    (let [end (tc-end M p f)
          base (loop [j (+ p 2)]
                 (cond (or (= end 0) (>= j end)) 0
                       (= (gn-op M j) OP-TAB) (gn-sir M j IF-B)
                       :else (recur (inc j))))]
     (if (and (> base 0) (= (tc-scan M p end base) (quot n 16))
              (tc-cover M p end base n)) base 0))))))

;; Same original nonleaf caller, no host/runtime call or arena allocation.
;; Preserve live x9..15 temps: this emitter only clobbers x0/5/7/8/16/17.
;; The clobber mask excludes all low-temp and callee-saved local registers.
;; Capture input before x16/17 use; x0 and x8 are free in this caller mode.
;; Clear descriptor runtime key and conservatively restore original ctx analysis.
;; The original reader has exactly one private entry charge and no path charge.
;; LIT IDs base..base+n/16-1 are each128B, and layout42 aligns each to8
;; in LIT order with no dedup, so their original physical bytes are contiguous.
(defn- tc-call [M :vector-i64 i :i64 f :i64 t :i64 base :i64] :vector-i64
 (let [code (vector-at M MM-CODE-N) fix (vector-at M MM-FIX-N)
       m0 (di-save M 0 0)
       m1 (-> m0 (gn-save-clobbered 0 t 197025) (gn-into 0 t) (gn-ctx)
                 (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mask-charge)
                 (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))
                 (gn-emit (gn-e-addsl 17 17 0 3))
                 (gn-fix FX-LIT32 base)
                 (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
                 (gn-emit (gn-e-ldrr 0 17 16 0))
                 (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-vclear)
                 (gn-gs gn-f-ctx (if (>= (gn-ctx-safe M f 1 8 512) 0) 1 0))
                 (gn-take i t 0))
       words (- (vector-at m1 MM-CODE-N) code)]
  (cond (not= (vector-at m1 MM-ERR) 0) m1
        (and (<= words 64) (<= (+ (gn-g m1 di-used) words) 4096)
             (= (vector-at m1 MM-FIX-N) (inc fix)))
         (-> m1 (gn-gs di-used (+ (gn-g m1 di-used) words))
                (gn-gs di-sites (inc (gn-g m1 di-sites))))
        :else (-> m1 (di-restore 0 0) (gn-put MM-CODE-N code) (gn-put MM-FIX-N fix)
                    (gn-call-generic i f t 1)))))

;; Exact two-way constant table reader; both guarded source paths remain certified.
;; The original leaf charges once, privately, and publishes only on success.
;; Out-of-range full i64 inputs trap with the pre-call fuel publication intact.
(defn- tb-lit [M :vector-i64 lit :i64 n :i64] :bool
 (and (> lit 0) (< lit (vector-at M MM-LIT-N)) (< lit MM-LIT-CAP)
      (> n 0) (< n 4095) (= (gn-litf M lit LF-LEN) (* n 8))
      (>= (vector-at M MM-LITB-N) (* n 8))
      (<= (vector-at M MM-LITB-N) MM-LITB-CAP)
      (>= (gn-litf M lit LF-B) 0)
      (<= (gn-litf M lit LF-B) (- (vector-at M MM-LITB-N) (* n 8)))
      (<= (gn-litf M lit LF-B) (- MM-LITB-CAP (* n 8)))))
(defn- tb-shape [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR) q (+ p 3)
        entry (gn-sir M (+ p 2) IF-A)
        le (gn-sir M (+ q 3) IF-B) lx (gn-sir M (+ q 6) IF-A)
        k (gn-sir M (+ q 1) IF-B) m (gn-sir M (+ q 11) IF-C)
        lit (gn-sir M (+ q 5) IF-B)]
   (if (and (> p 0) (< (+ q 14) (vector-at M MM-SIR-N))
       (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-NSLOTS) 1)
       (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-PT0) TY-I64)
       (= (gn-fnf M f FF-RTYPE) TY-I64)
       (> entry 0) (< entry MM-LABEL-CAP) (> le 0) (< le MM-LABEL-CAP)
       (> lx 0) (< lx MM-LABEL-CAP) (not= entry le) (not= entry lx) (not= le lx)
       (> k 0) (> m 0) (< (+ k m) 4096)
       (tb-lit M lit k) (tb-lit M (inc lit) m)
       (gn-dot-at? M p OP-FN f 1 1)
       (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL entry 0 0)
       (gn-dot-at? M q OP-LGET 0 1 0)
       (gn-dot-at? M (+ q 1) OP-CONST 1 k 0)
       (gn-dot-at? M (+ q 2) OP-CMP CC-LT 0 0)
       (gn-dot-at? M (+ q 3) OP-BRZ 0 le 0)
       (gn-dot-at? M (+ q 4) OP-LGET 0 1 0)
       (gn-dot-at? M (+ q 5) OP-TAB 0 lit k)
       (gn-dot-at? M (+ q 6) OP-BR lx 0 0)
       (gn-dot-at? M (+ q 7) OP-LABEL le 0 0)
       (gn-dot-at? M (+ q 8) OP-LGET 0 1 0)
       (gn-dot-at? M (+ q 9) OP-CONST 1 k 0)
       (gn-dot-at? M (+ q 10) OP-BIN BOP-SUB 0 0)
       (gn-dot-at? M (+ q 11) OP-TAB 0 (inc lit) m)
       (gn-dot-at? M (+ q 12) OP-LABEL lx 0 0)
       (gn-dot-at? M (+ q 13) OP-RET 0 0 0)
       (gn-dot-at? M (+ q 14) OP-END f 0 0)) lit 0))))
(defn- tb-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (and (= n 1) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
          (> (gn-g M gn-f-fb) 0) (>= t 0) (<= t 6)
          (<= (inc t) (gn-g M gn-f-h)) (<= (inc t) (gn-g M gn-f-dp))
          (not= (gn-op M (inc i)) OP-RET) (not= (gn-op M (inc i)) OP-RES2)
          (< (gn-g M di-sites) 256) (< (gn-g M di-used) 4096)
          (tc-arg-safe M t)) (tb-shape M f) 0))
(defn- tb-call [M :vector-i64 i :i64 f :i64 t :i64 base :i64] :vector-i64
 (let [code (vector-at M MM-CODE-N) fix (vector-at M MM-FIX-N)
       count (quot (+ (gn-litf M base LF-LEN) (gn-litf M (inc base) LF-LEN)) 8)
       m0 (di-save M 0 0)
       m1 (-> m0 (gn-save-clobbered 0 t 197025) (gn-into 0 t) (gn-ctx)
                 (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mask-charge)
                 (gn-emit (enc-cmp-i 0 count))
                 (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (enc-brk 0))
                 (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))
                 (gn-emit (gn-e-addsl 17 17 0 3))
                 (gn-fix FX-LIT32 base)
                 (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
                 (gn-emit (gn-e-ldrr 0 17 16 0))
                 (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-vclear)
                 (gn-gs gn-f-ctx 1) (gn-take i t 0))
       words (- (vector-at m1 MM-CODE-N) code)]
  (cond (not= (vector-at m1 MM-ERR) 0) m1
        (and (<= words 64) (<= (+ (gn-g m1 di-used) words) 4096)
             (= (vector-at m1 MM-FIX-N) (inc fix)))
         (-> m1 (gn-gs di-used (+ (gn-g m1 di-used) words))
                (gn-gs di-sites (inc (gn-g m1 di-sites))))
        :else (-> m1 (di-restore 0 0) (gn-put MM-CODE-N code) (gn-put MM-FIX-N fix)
                    (gn-call-generic i f t 1)))))

(defn- aw-call [M :vector-i64 i :i64 f :i64 t :i64 q :i64] :vector-i64
 (let [M1 (gn-pin M t) rv (gn-pinned M1 t)
       sign (gn-sign-wrapper M (gn-sir M (+ q 7) IF-A) 1) width (bit-and sign 511)]
  (-> M1 (gn-ctx) (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mask-charge)
      (gn-into 2 (+ t 2)) (gn-into 3 (+ t 3)) (gn-emit (enc-mul 1 2 3))
      (gn-into 2 (inc t)) (gn-emit (enc-add-r 1 1 2))
      (gn-into 0 (+ t 4)) (cond-> (>= sign 1536) (gn-mask-charge))
      (gn-emit (gn-e-bf 0x93400000 0 0 0 (dec width))) (gn-mask-charge)
      (gn-hchk rv 312 320) (gn-vidx 1) (gn-emit (gn-e-strr3 0 16 17))
      (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-gs gn-f-h (inc t)))))

;; Closed five-parameter affine-index writer with exact sign wrapper and
;; in-place dependency. Original caller classification and publication remain.
(defn- aw-ins [M :vector-i64 j :i64 op :i64 a :i64 b :i64 c :i64] :bool
 (and (= (gn-op M j) op) (= (gn-sir M j IF-A) a)
      (= (gn-sir M j IF-B) b) (= (gn-sir M j IF-C) c)))
(defn- aw-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (let [p (gn-fnf M f FF-SIR) q (gn-skiplab M (+ p 2))
       sign (gn-sir M (+ q 7) IF-A) writer (gn-sir M (+ q 8) IF-A)]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0)
           (= n 5) (>= t 0) (<= t 2) (= (gn-g M gn-f-leaf) 0)
           (not (gn-clamp-open M f)) (not (gn-clamp-open M sign))
           (not (gn-clamp-open M writer)) (not= (gn-op M (inc i)) OP-RES2)
           (= (gn-fnf M f FF-NPARAMS) 5) (= (gn-fnf M f FF-NSLOTS) 5)
           (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
           (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
           (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
           (<= (gn-fnf M f FF-DEPTH) 4)
           (aw-ins M p OP-FN f 5 5) (aw-ins M (inc p) OP-FUEL 0 0 0)
           (aw-ins M q OP-LGET 0 1 0) (aw-ins M (+ q 1) OP-LGET 1 2 0)
           (aw-ins M (+ q 2) OP-LGET 2 3 0) (aw-ins M (+ q 3) OP-LGET 3 4 0)
           (aw-ins M (+ q 4) OP-BIN BOP-MUL 2 0) (aw-ins M (+ q 5) OP-BIN BOP-ADD 1 0)
           (aw-ins M (+ q 6) OP-LGET 2 5 0) (aw-ins M (+ q 7) OP-CALL sign 2 1)
           (> (gn-sign-wrapper M sign 1) 0)
           (aw-ins M (+ q 8) OP-CALL writer 0 3)
           (= (gn-wrapper M writer 0 3) (+ RT-VECTOR-ASSOC-IN-PLACE 256))
           (aw-ins M (+ q 9) OP-RET 0 0 0) (aw-ins M (+ q 10) OP-END f 0 0)) q 0)))


;; A bounded affine in-place loop. Its complete range and fuel are proven
;; before the first original charge; all rejected inputs use the original SIR.
(defn- vl-admit [M :vector-i64 i :i64 f :i64 np :i64] :i64
 (if (or (not= np 5) (not= (gn-g M gn-f-leaf) 0)
         (not= (gn-g M gn-f-freg) 0) (not= (gn-g M gn-f-fuel) 1)
         (>= (+ i 31) (vector-at M MM-SIR-N))) 0
  (let [limit (gn-sir M (+ i 4) IF-B) writer (gn-sir M (+ i 15) IF-A)
        head (gn-sir M (+ i 2) IF-A) body (gn-sir M (+ i 9) IF-A)
        done (gn-sir M (+ i 29) IF-A)]
   (if (and (> limit 0) (<= limit 8) (> writer 0)
    (< writer (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-SIR) i) (= (gn-fnf M f FF-NSLOTS) 5)
    (= (gn-fnf M f FF-DEPTH) 5) (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (= (gn-fnf M f FF-PT0) TY-VEC)
    (loop [k 1] (or (= k 5) (and (= (gn-fnf M f (+ FF-PT0 k)) TY-I64) (recur (inc k)))))
    (loop [k 1] (or (= k 6) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
     (loop [j 1] (or (= j k) (and (not= (gn-sreg M j) (gn-sreg M k)) (recur (inc j)))))
     (recur (inc k)))))
    (aw-ins M i OP-FN f 5 5) (aw-ins M (+ i 1) OP-FUEL 0 0 0)
    (aw-ins M (+ i 2) OP-LABEL head 0 0)
    (= (gn-small-label M 1 head 0) (+ i 2))
    (= (gn-small-label M 1 body 0) (+ i 9))
    (= (gn-small-label M 1 done 0) (+ i 29))
    (aw-ins M (+ i 3) OP-LGET 0 4 0) (aw-ins M (+ i 4) OP-CONST 1 limit 0)
    (aw-ins M (+ i 5) OP-CMP CC-EQ 0 0) (aw-ins M (+ i 6) OP-BRZ 0 body 0)
    (aw-ins M (+ i 7) OP-LGET 0 1 0) (aw-ins M (+ i 8) OP-BR done 0 0)
    (aw-ins M (+ i 9) OP-LABEL body 0 0)
    (loop [k 0] (or (= k 5) (and (aw-ins M (+ i 10 k) OP-LGET k (inc k) 0) (recur (inc k)))))
    (aw-ins M (+ i 15) OP-CALL writer 0 5)
    (> (aw-admit M (+ i 15) writer 0 5) 0)
    (loop [k 1] (or (= k 4) (and (aw-ins M (+ i 15 k) OP-LGET k (inc k) 0) (recur (inc k)))))
    (aw-ins M (+ i 19) OP-CONST 4 1 0) (aw-ins M (+ i 20) OP-BIN BOP-ADD 3 0)
    (aw-ins M (+ i 21) OP-LGET 4 5 0)
    (loop [k 0] (or (= k 5) (and (aw-ins M (+ i 22 k) OP-LSET (inc k) k 0) (recur (inc k)))))
    (aw-ins M (+ i 27) OP-FUEL 0 0 0) (aw-ins M (+ i 28) OP-BR head 0 0)
    (aw-ins M (+ i 29) OP-LABEL done 0 0) (aw-ins M (+ i 30) OP-RET 0 0 0)
    (aw-ins M (+ i 31) OP-END f 0 0)) limit 0))))
(defn- vl-guard [M :vector-i64 P :vector-i64 slot :i64 cc :i64] :vector-i64
 (let [ignored (vector-assoc! P slot (vector-at M MM-CODE-N))]
  (gn-emit M (enc-bcond cc 0))))
(defn- vl-patch [M :vector-i64 P :vector-i64 end :i64] :vector-i64
 (loop [out M k 0]
  (if (= k 9) out
   (let [at (vector-at P k) cc (bit-and (vector-at out (+ MM-CODE-BASE at)) 15)]
    (recur (gn-put out (+ MM-CODE-BASE at) (enc-bcond cc (- end at))) (inc k))))))
(defn- vl-entry [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (let [limit (vl-admit M i f np)]
  (if (= limit 0) M
   (let [P (vector-alloc 9) writer (gn-sir M (+ i 15) IF-A)
         q (aw-admit M (+ i 15) writer 0 5)
         sign (gn-sign-wrapper M (gn-sir M (+ q 7) IF-A) 1)
         width (bit-and sign 511)
         m1 (-> M
          (gn-mov 0 (gn-sreg M 1)) (gn-mov 1 (gn-sreg M 2))
          (gn-mov 2 (gn-sreg M 3)) (gn-mov 3 (gn-sreg M 4)) (gn-mov 13 (gn-sreg M 5))
          ;; Unsigned k < limit, complete original charge budget, then handle.
          (gn-emit (enc-cmp-i 3 limit)) (vl-guard P 0 (enc-cond-hs))
          (gn-mov-imm 11 limit) (gn-emit (enc-sub-r 11 11 3))
          (gn-mov-imm 12 (if (>= sign 1536) 4 3)) (gn-emit (enc-mul 11 11 12))
          (gn-emit (enc-add-i 11 11 1)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
          (gn-emit (enc-cmp-r 8 11)) (vl-guard P 1 (enc-cond-lo))
          (cond-> (< sign 1536) (gn-mov 12 11))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
          (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)) (vl-guard P 2 (enc-cond-hs))
          (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
          (gn-emit (enc-ldp 5 6 16 0))
          ;; len < 2^60 and |stride| <= len ensure all affine products
          ;; and sums for k=0..7 are representable signed i64.
          (gn-mov-imm 17 1152921504606846975) (gn-emit (enc-cmp-r 6 17)) (vl-guard P 3 8)
          (gn-emit (enc-cmp-r 1 6)) (vl-guard P 4 (enc-cond-hs))
          (gn-emit (enc-cmp-r 2 6)) (vl-guard P 5 (enc-cond-gt))
          (gn-emit (enc-sub-r 17 31 6)) (gn-emit (enc-cmp-r 2 17)) (vl-guard P 6 (enc-cond-lt))
          (gn-emit (enc-mul 9 2 3)) (gn-emit (enc-add-r 9 9 1))
          (gn-emit (enc-cmp-r 9 6)) (vl-guard P 7 (enc-cond-hs))
          (gn-mov-imm 11 (dec limit)) (gn-emit (enc-mul 11 2 11)) (gn-emit (enc-add-r 11 11 1))
          (gn-emit (enc-cmp-r 11 6)) (vl-guard P 8 (enc-cond-hs))
          (gn-emit (enc-ldr 10 7 328)) (gn-emit (enc-add-r 9 9 5))
          ;; Uncharged sign wrapper only: all charges (limit-k)*3+1 <=25.
          ;; Only after every complete fuel/handle/range guard succeeds,
          ;; precharge exactly that cost. No hot-region language trap or
          ;; guest observer remains; payload stores retain their order.
          ;; CPU/wall interruption is outside language semantics: its
          ;; partial remaining-fuel report need not equal per-edge charging.
          (cond-> (< sign 1536)
            (gn-emit (enc-sub-r 8 8 12))
            (< sign 1536) (gn-emit (enc-str 8 7 CTX-FUEL))))
         loop-at (vector-at m1 MM-CODE-N)
         m2 (-> m1
          ;; Optional charged sign wrappers retain the previous VL path.
          (cond-> (>= sign 1536)
            (gn-op-fuel) (>= sign 1536) (gn-emit (enc-ldr 8 7 CTX-FUEL))
            (>= sign 1536) (gn-mask-charge))
          (gn-mov 14 13) (cond-> (>= sign 1536) (gn-mask-charge))
          (gn-emit (gn-e-bf 0x93400000 14 14 0 (dec width)))
          (cond-> (>= sign 1536) (gn-mask-charge))
          (gn-emit (gn-e-strr3 14 10 9))
          (cond-> (>= sign 1536) (gn-emit (enc-str 8 7 CTX-FUEL)))
          (gn-emit (enc-add-r 9 9 2)) (gn-emit (enc-add-i 3 3 1)) (gn-emit (enc-cmp-i 3 limit)))
         at (vector-at m2 MM-CODE-N)
         m3 (-> m2 (gn-emit (enc-bcond (enc-cond-lo) (- loop-at at)))
          (cond-> (>= sign 1536) (gn-op-fuel))
          (gn-mov 0 (gn-sreg M 1)) (gn-epilogue) (gn-gs gn-f-dead 0))]
    (vl-patch m3 P (vector-at m3 MM-CODE-N))))))


;; Framed ordinary bodies can retain x8 while publishing every original
;; charge. Only closed bounded scalar/vector SIR is admitted. Calls whose
;; emitted effect cannot prove synchronization reload the actual context.
(defn- pf-scan [M :vector-i64 j :i64 start :i64 end :i64] :bool
 (if (= j end) true
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
        okay (case op
         (OP-CONST OP-LGET OP-LSET OP-RET) true
         OP-BIN (< a BOP-F64-ADD) OP-CMP (< a CC-F64-EQ) OP-UN (< a UOP-F64-NEG)
         OP-FUEL (and (= a 0) (= b 0) (= c 0))
         OP-LABEL (and (= b 0) (= c 0) (= (gn-small-label M 1 a 0) j))
         OP-BR (and (= b 0) (= c 0) (gn-small-owned M start end a))
         (OP-BRZ OP-BRNZ) (and (= c 0) (gn-small-owned M start end b))
         OP-RT (and (>= b 0) (<= b (gn-g M gn-f-dp))
                    (<= c (- (gn-g M gn-f-dp) b)) (gn-inl a b c)
                    (or (and (= a RT-VECTOR-AT) (= c 2))
                        (and (= a RT-VECTOR-ASSOC-IN-PLACE) (= c 3))))
         OP-CALL (and (> a 0) (< a (vector-at M MM-FN-N))
                      (not (gn-clamp-open M a)) (<= c 5) (>= c 0))
         false)]
   (and okay (pf-scan M (inc j) start end)))))
;; A generic fuel-cache entry must not suppress an existing constant-table
;; call expansion. Inspect the complete closed body after pf-scan validates
;; all callee indices; the original three-argument admission stays unchanged.
(defn- pf-priority-scan [M :vector-i64 j :i64 end :i64] :bool
 (or (= j end)
  (and (or (not= (gn-op M j) OP-CALL)
           (= (tb-shape M (gn-sir M j IF-A)) 0))
       (pf-priority-scan M (inc j) end))))
(defn- pf-entry [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (let [end (gn-small-end M (inc i) f 4096) ns (gn-g M gn-f-ns) dp (gn-g M gn-f-dp)]
  (if (and (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
   (= (gn-g M gn-f-fuel) 1) (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-out) 0)
   (or (= np 2) (= np 3))
   ;; Preserve the existing structurally certified phase-loop fast path.
   (or (= np 3) (not (pwphase-admit M (inc i)))) (>= ns np) (<= ns 7) (> dp 0) (<= dp 7)
   (= (gn-fnf M f FF-SIR) i) (= (gn-fnf M f FF-NPARAMS) np)
   (= (gn-fnf M f FF-NSLOTS) ns) (= (gn-fnf M f FF-DEPTH) dp)
   (not (gn-clamp-open M f)) (gn-small-type (gn-fnf M f FF-RTYPE))
   (= (gn-fnf M f FF-PT0) TY-VEC)
   (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (or (= np 2) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64))
   (loop [k 1] (or (> k ns) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28) (recur (inc k)))))
   (>= (- end i) 64) (<= (- end i) 512) (pf-scan M (inc i) i end)
   (or (= np 3) (pf-priority-scan M (inc i) end)))
   (-> M (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-gs gn-f-freg 2)) M)))
;; Physical suffix proof: pure integer instructions cannot change x7/x8
;; or published memory. Any branch/call/load/store outside the exact anchor
;; is conservatively unknown. This list does not infer callee behavior.
(defn- pf-quiet [w :i64] :bool
 (and (>= w 0) (<= w 4294967295) (not= (bit-and w 31) 7) (not= (bit-and w 31) 8)
  (or (= (bit-and w 0xffe0ffe0) 0xaa0003e0)
      (= (bit-and w 0xffc00000) 0xd2800000) (= (bit-and w 0xffc00000) 0xf2800000)
      (= (bit-and w 0xff000000) 0x91000000) (= (bit-and w 0xff000000) 0xd1000000)
      (= (bit-and w 0xff200000) 0x8b000000) (= (bit-and w 0xff200000) 0xcb000000)
      (= (bit-and w 0xff200000) 0x8a000000) (= (bit-and w 0xff200000) 0xaa000000)
      (= (bit-and w 0xff200000) 0xca000000)
      (= (bit-and w 0xffc00000) 0xd3400000) (= (bit-and w 0xffc00000) 0x93400000)
      (= (bit-and w 0xffe0fc00) 0x9b007c00)
      (= (bit-and w 0xffe00c00) 0x9a800000))))
(defn- pf-sync [M :vector-i64 at :i64 begin :i64 left :i64] :bool
 (cond (< at begin) true (<= left 0) false
  (= (vector-at M (+ MM-CODE-BASE at)) (enc-str 8 7 CTX-FUEL)) true
  (pf-quiet (vector-at M (+ MM-CODE-BASE at))) (pf-sync M (dec at) begin (dec left))
  :else false))
(defn- pf-after-call [M :vector-i64 begin :i64] :vector-i64
 (if (and (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 2)
          (= (gn-g M gn-f-dead) 0)
          (not (pf-sync M (dec (vector-at M MM-CODE-N)) begin 64)))
  (-> M (gn-ctx) (gn-emit (enc-ldr 8 7 CTX-FUEL))) M))

(defn- rq-shape [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR) total (vector-at M MM-SIR-N)]
   (if (or (<= p 0) (> total 16384) (< total 25) (> p (- total 25))) false
    (let [a (gn-sir M (+ p 5) IF-B) b (gn-sir M (+ p 17) IF-A)]
   (and
    (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
    (<= (vector-at M MM-SIR-N) 16384) (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-PT0) TY-I64)
    (= (gn-fnf M f (inc FF-PT0)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-I64)
    (gn-dot-at? M p OP-FN f 2 2)
    (gn-dot-at? M (inc p) OP-LABEL (gn-sir M (inc p) IF-A) 0 0)
    (> (gn-sir M (inc p) IF-A) 0) (< (gn-sir M (inc p) IF-A) MM-LABEL-CAP)
    (> a 0) (< a MM-LABEL-CAP) (> b 0) (< b MM-LABEL-CAP) (not= a b)
    (not= a (gn-sir M (inc p) IF-A)) (not= b (gn-sir M (inc p) IF-A))
    (bd-edges M 1 a b 0 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LGET 0 1 0) (gn-dot-at? M (+ p 3) OP-CONST 1 0 0)
    (gn-dot-at? M (+ p 4) OP-CMP CC-LT 0 0) (gn-dot-at? M (+ p 5) OP-BRZ 0 a 0)
    (gn-dot-at? M (+ p 6) OP-CONST 0 0 0) (gn-dot-at? M (+ p 7) OP-CONST 1 0 0)
    (gn-dot-at? M (+ p 8) OP-LGET 2 1 0) (gn-dot-at? M (+ p 9) OP-BIN BOP-SUB 1 0)
    (gn-dot-at? M (+ p 10) OP-LGET 2 2 0) (gn-dot-at? M (+ p 11) OP-CONST 3 1 0)
    (gn-dot-at? M (+ p 12) OP-BIN BOP-SUB 2 0) (gn-dot-at? M (+ p 13) OP-BIN BOP-ADD 1 0)
    (gn-dot-at? M (+ p 14) OP-LGET 2 2 0) (gn-dot-at? M (+ p 15) OP-BIN BOP-QUOT 1 0)
    (gn-dot-at? M (+ p 16) OP-BIN BOP-SUB 0 0) (gn-dot-at? M (+ p 17) OP-BR b 0 0)
    (gn-dot-at? M (+ p 18) OP-LABEL a 0 0) (gn-dot-at? M (+ p 19) OP-LGET 0 1 0)
    (gn-dot-at? M (+ p 20) OP-LGET 1 2 0) (gn-dot-at? M (+ p 21) OP-BIN BOP-QUOT 0 0)
    (gn-dot-at? M (+ p 22) OP-LABEL b 0 0) (gn-dot-at? M (+ p 23) OP-RET 0 0 0)
    (gn-dot-at? M (+ p 24) OP-END f 0 0)))))))
(defn- rq-core [M :vector-i64 k :i64] :vector-i64
 (let [m0 (gn-emit M (enc-cmp-i 0 0))
       bc (vector-at m0 MM-CODE-N) m1 (gn-emit m0 (enc-bcond (enc-cond-ge) 0))
       m2 (-> m1 (gn-emit (enc-sub-r 0 31 0)) (gn-emit (enc-add-i 0 0 (dec k)))
              (gn-bin-imm BOP-QUOT 0 0 k) (gn-emit (enc-sub-r 0 31 0)))
       br (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-b 0))
       pos (vector-at m3 MM-CODE-N) m4 (gn-bin-imm m3 BOP-QUOT 0 0 k)
       end (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-put (+ MM-CODE-BASE bc) (enc-bcond (enc-cond-ge) (- pos bc)))
                 (gn-put (+ MM-CODE-BASE br) (enc-b (- end br))))]
  m5))

;; Finite pure arithmetic composition with one original ordinary entry charge.
;; No benchmark names, frame registers, deferred publication or live-temp writes.
(defn- rc-sign [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0 (gn-sign-wrapper M f 1)))
(defn- rc-shape [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR) total (vector-at M MM-SIR-N)]
   (if (or (<= p 0) (< total 14) (> p (- total 14))) 0
    (let [w (rc-sign M (gn-sir M (+ p 4) IF-A))
          z (rc-sign M (gn-sir M (+ p 11) IF-A))
          bias (gn-sir M (+ p 7) IF-B) divisor (gn-sir M (+ p 9) IF-B)]
     (if (and (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
       (= (gn-fnf M f FF-DEPTH) 2) (sr-types M f 2)
       (gn-dot-at? M p OP-FN f 2 2) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
       (> (gn-sir M (+ p 2) IF-A) 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
       (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
       (gn-dot-at? M (+ p 4) OP-CALL (gn-sir M (+ p 4) IF-A) 0 1)
       (>= w 1024) (< w 1536) (>= z 1024) (< z 1536)
       (gn-dot-at? M (+ p 5) OP-LGET 1 2 0) (gn-dot-at? M (+ p 6) OP-BIN BOP-MUL 0 0)
       (gn-dot-at? M (+ p 7) OP-CONST 1 bias 0) (>= bias 0) (<= bias 4095)
       (gn-dot-at? M (+ p 8) OP-BIN BOP-ADD 0 0)
       (gn-dot-at? M (+ p 9) OP-CONST 1 divisor 0) (> divisor 1) (<= divisor 4096) (> (gn-pow2 divisor) 0)
       (gn-dot-at? M (+ p 10) OP-CALL (gn-sir M (+ p 10) IF-A) 0 2)
       (rq-shape M (gn-sir M (+ p 10) IF-A))
       (gn-dot-at? M (+ p 11) OP-CALL (gn-sir M (+ p 11) IF-A) 0 1)
       (gn-dot-at? M (+ p 12) OP-RET 0 0 0) (gn-dot-at? M (+ p 13) OP-END f 0 0)) p 0))))))
(defn- rc-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (or (not= (gn-g M gn-f-leaf) 0) (< t 0) (not= n 2)
       (> t (gn-g M gn-f-h)) (> t (gn-g M gn-f-dp))
       (> 2 (- (gn-g M gn-f-h) t)) (> 2 (- (gn-g M gn-f-dp) t))) 0
  (if (and (not= (gn-op M (inc i)) OP-RES2) (di-args-safe M t 2)) (rc-shape M f) 0)))
;; A sign-narrowed scalar times a bounded constant cannot overflow either
;; the biased product or the negative rounding numerator. The original
;; wrapping floor-quot tree is therefore exactly arithmetic right shift.
(defn- rc-round-bounded [M :vector-i64 t :i64 w :i64] :bool
 (and (> w 0) (<= w 32) (= (gn-dk M (inc t)) gn-k-const)
      (>= (gn-dv M (inc t)) -1073741824) (<= (gn-dv M (inc t)) 1073741824)))
(defn- rc-round-emit [M :vector-i64 bounded :bool k :i64] :vector-i64
 (if bounded (gn-emit M (gn-e-asr 0 0 (gn-pow2 k))) (rq-core M k)))
(defn- rc-call [M :vector-i64 i :i64 t :i64 p :i64] :vector-i64
 (let [w (bit-and (rc-sign M (gn-sir M (+ p 4) IF-A)) 511)
       z (bit-and (rc-sign M (gn-sir M (+ p 11) IF-A)) 511)
       bias (gn-sir M (+ p 7) IF-B) divisor (gn-sir M (+ p 9) IF-B)
       bounded (rc-round-bounded M t w)
       freg (gn-g M gn-f-freg)
       m0 (-> M (gn-args t 0 2) (gn-ctx) (gn-gs gn-f-freg 0) (gn-op-fuel) (gn-gs gn-f-freg freg))
       m1 (-> m0 (gn-emit (gn-e-bf 0x93400000 0 0 0 (dec w)))
           (gn-emit (enc-mul 0 0 1)) (gn-emit (enc-add-i 0 0 bias)) (rc-round-emit bounded divisor)
           (gn-emit (gn-e-bf 0x93400000 0 0 0 (dec z))))]
  (gn-take m1 i t 0)))

;; One charged scalar bias/round/bias composition ending in certified clamp.
(defn- rp-shape [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR) total (vector-at M MM-SIR-N)]
   (if (or (<= p 0) (< total 13) (> p (- total 13))) 0
    (let [before (gn-sir M (+ p 4) IF-B) divisor (gn-sir M (+ p 6) IF-B)
          after (gn-sir M (+ p 8) IF-B) cf (gn-sir M (+ p 10) IF-A)]
     (if (and (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-NSLOTS) 1)
       (= (gn-fnf M f FF-DEPTH) 2) (sr-types M f 1)
       (gn-dot-at? M p OP-FN f 1 1) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
       (> (gn-sir M (+ p 2) IF-A) 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
       (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
       (gn-dot-at? M (+ p 4) OP-CONST 1 before 0) (>= before 0) (<= before 4095)
       (gn-dot-at? M (+ p 5) OP-BIN BOP-ADD 0 0)
       (gn-dot-at? M (+ p 6) OP-CONST 1 divisor 0) (> divisor 1) (<= divisor 4096) (> (gn-pow2 divisor) 0)
       (gn-dot-at? M (+ p 7) OP-CALL (gn-sir M (+ p 7) IF-A) 0 2)
       (rq-shape M (gn-sir M (+ p 7) IF-A))
       (gn-dot-at? M (+ p 8) OP-CONST 1 after 0) (>= after 0) (<= after 4095)
       (gn-dot-at? M (+ p 9) OP-BIN BOP-ADD 0 0)
       (gn-dot-at? M (+ p 10) OP-CALL cf 0 1) (> cf 0) (< cf (vector-at M MM-FN-N))
       (> (gn-clamp M (+ p 10) cf 1) 0)
       (gn-dot-at? M (+ p 11) OP-RET 0 0 0) (gn-dot-at? M (+ p 12) OP-END f 0 0)) p 0))))))
(defn- rp-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (or (not= (gn-g M gn-f-leaf) 0) (< t 0) (not= n 1)
       (>= t (gn-g M gn-f-h)) (>= t (gn-g M gn-f-dp))) 0
  (if (and (not= (gn-op M (inc i)) OP-RES2) (di-args-safe M t 1)) (rp-shape M f) 0)))
(defn- rp-call [M :vector-i64 i :i64 t :i64 p :i64] :vector-i64
 (let [before (gn-sir M (+ p 4) IF-B) divisor (gn-sir M (+ p 6) IF-B)
       after (gn-sir M (+ p 8) IF-B) cf (gn-sir M (+ p 10) IF-A)
       q (gn-clamp M (+ p 10) cf 1) cp (gn-fnf M cf FF-SIR)
       fuel (= (gn-op M (inc cp)) OP-FUEL) w (gn-sign-wrapper M (gn-sir M (inc q) IF-A) 1)
       charged (or fuel (>= w 1536)) width (bit-and w 511)
       low (gn-sir M (+ q 4) IF-B) high (gn-sir M (+ q 11) IF-B)
       freg (gn-g M gn-f-freg)
       m0 (-> M (gn-into 0 t) (gn-ctx) (gn-gs gn-f-freg 0) (gn-op-fuel) (gn-gs gn-f-freg freg))
       m1 (-> m0 (gn-emit (enc-add-i 0 0 before)) (rq-core divisor) (gn-emit (enc-add-i 0 0 after))
         ;; The retained ordinary charge changed context fuel; load it for the
         ;; original private clamp transaction even when caller x8 was cached.
         (cond-> charged (gn-emit (enc-ldr 8 7 CTX-FUEL))
                 fuel (gn-mask-charge) (>= w 1536) (gn-mask-charge))
         (gn-emit (gn-e-bf 0x93400000 0 0 0 (dec width)))
         (gn-mov-imm 16 low) (gn-emit (enc-cmp-r 0 16)) (gn-emit (enc-csel 0 16 0 (enc-cond-lt)))
         (gn-mov-imm 17 high) (gn-emit (enc-cmp-r 0 17)) (gn-emit (enc-csel 0 17 0 (enc-cond-gt)))
         (cond-> charged (gn-emit (enc-str 8 7 CTX-FUEL))))]
  (gn-take m1 i t 0)))

;; Closed call-edge table DAG: source labels certified independently of the
;; currently emitted caller's label table. Caller argument bank is unchanged.
(defn- ti-labels [M :vector-i64 p :i64 j :i64 k :i64] :bool
 (cond (= j 67) true (= k j) (ti-labels M p (inc j) 0)
  (and (= (gn-op M (+ p j)) OP-LABEL) (= (gn-op M (+ p k)) OP-LABEL)
       (= (gn-sir M (+ p j) IF-A) (gn-sir M (+ p k) IF-A))) false
  :else (ti-labels M p j (inc k))))
(defn- ti-groups [M :vector-i64 p :i64 j :i64] :bool
 (if (= j 5) true
  (let [q (+ p 4 (* (dec j) 15)) le (gn-sir M (+ q 9) IF-A)
       lx (gn-sir M (+ q 14) IF-A) sh (gn-sir M (+ q 5) IF-B)
       bf (gn-sir M (+ q 6) IF-A) tf (gn-sir M (+ q 7) IF-A)
       ff (gn-sir M (+ q 13) IF-A)]
   (and (> le 0) (< le MM-LABEL-CAP) (> lx 0) (< lx MM-LABEL-CAP) (not= le lx)
    (>= sh 0) (<= sh 56) (td-byte M bf) (td-table M tf) (td-table M ff)
    (gn-dot-at? M q OP-LGET j 1 0)
    (gn-dot-at? M (+ q 1) OP-CONST (inc j) (gn-sir M (+ p 5) IF-B) 0)
    (gn-dot-at? M (+ q 2) OP-CMP CC-EQ j 0) (gn-dot-at? M (+ q 3) OP-BRZ j le 0)
    (gn-dot-at? M (+ q 4) OP-LGET j (inc j) 0)
    (gn-dot-at? M (+ q 5) OP-CONST (inc j) sh 0)
    (gn-dot-at? M (+ q 6) OP-CALL bf j 2) (gn-dot-at? M (+ q 7) OP-CALL tf j 1)
    (gn-dot-at? M (+ q 8) OP-BR lx 0 0) (gn-dot-at? M (+ q 9) OP-LABEL le 0 0)
    (gn-dot-at? M (+ q 10) OP-LGET j (inc j) 0)
    (gn-dot-at? M (+ q 11) OP-CONST (inc j) sh 0)
    (gn-dot-at? M (+ q 12) OP-CALL bf j 2) (gn-dot-at? M (+ q 13) OP-CALL ff j 1)
    (gn-dot-at? M (+ q 14) OP-LABEL lx 0 0) (ti-groups M p (inc j))))))
(defn- ti-shape [M :vector-i64 f :i64] :i64
 (if (not (td-type M f 6)) 0
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (+ p 2) IF-A)]
   (if (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 67)) (> l 0) (< l MM-LABEL-CAP)
    (gn-dot-at? M p OP-FN f 6 6) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL l 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 6 0)
    (ti-labels M p 0 0) (ti-groups M p 1)
    (gn-dot-at? M (+ p 64) OP-CALL (gn-sir M (+ p 64) IF-A) 0 5)
    (td-xor5 M (gn-sir M (+ p 64) IF-A))
    (gn-dot-at? M (+ p 65) OP-RET 0 0 0) (gn-dot-at? M (+ p 66) OP-END f 0 0)) p 0))))
(defn- ti-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (and (= n 6) (>= t 0) (= (gn-g M gn-f-leaf) 0)
   (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-freg) 0)
   (>= (gn-g M gn-f-vmode) -1) (<= (gn-g M gn-f-vmode) 1)
   (<= (+ t n) (gn-g M gn-f-h)) (<= (+ t n) (gn-g M gn-f-dp))
   (not= (gn-op M (inc i)) OP-RET) (not= (gn-op M (inc i)) OP-RES2)
   (not (jt-return M i t)) (di-args-safe M t n)) (ti-shape M f) 0))
(defn- ti-emit [M :vector-i64 p :i64 j :i64 branch :i64] :vector-i64
 (if (= j 5) M
  (let [q (+ p 4 (* (dec j) 15)) sh (gn-sir M (+ q 5) IF-B)
        f (gn-sir M (+ q (if (= branch 0) 7 13)) IF-A) lit (tb-shape M f)]
   (ti-emit (-> M (gn-emit (gn-e-bf 0xd3400000 9 j sh (+ sh 7)))
     (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
     (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
     (gn-emit (enc-add-r 17 17 16)) (gn-emit (gn-e-ldrr 9 17 9 1))
     (gn-emit (enc-eor-r 5 5 9))) p (inc j) branch))))
(defn- ti-call [M :vector-i64 i :i64 f :i64 t :i64 p :i64] :vector-i64
 (let [m0 (-> M (gn-save 0 t) (gn-args t 0 6) (gn-ctx)
       (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 6))) bf (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0))
        (gn-emit (enc-sub-i 8 8 6)) (gn-emit (enc-str 8 7 CTX-FUEL))
        (gn-mov-imm 16 (gn-sir M (+ p 5) IF-B)) (gn-emit (enc-cmp-r 0 16))) bc (vector-at m1 MM-CODE-N)
       m2 (ti-emit (gn-emit m1 (enc-bcond (enc-cond-ne) 0)) p 1 0) ba (vector-at m2 MM-CODE-N)
       m3 (gn-emit m2 (enc-b 0)) alt (vector-at m3 MM-CODE-N)
       m4 (ti-emit m3 p 1 1) done (vector-at m4 MM-CODE-N)
       m5 (gn-mov m4 0 5) bj (vector-at m5 MM-CODE-N)
       m6 (gn-emit m5 (enc-b 0)) cold (vector-at m6 MM-CODE-N)
       m7 (-> m6 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))) join (vector-at m7 MM-CODE-N)]
  (-> m7 (gn-dot-patch bf cold (enc-cond-lo)) (gn-dot-patch bc alt (enc-cond-ne))
    (gn-put (+ MM-CODE-BASE ba) (enc-b (- done ba)))
    (gn-put (+ MM-CODE-BASE bj) (enc-b (- join bj)))
    (gn-vclear) (gn-gs gn-f-vslot 0) (vi-clear) (sl-clear)
    (gn-gs gn-f-ctx 1) (gn-take i t 0))))

;; Call-edge expansion of a closed two-word record copy. All guards precede
;; changed effects and retain the original staged three-argument cold call.
(defn- pi-reader [M :vector-i64 p :i64 f :i64] :bool
  (and
    (gn-dot-at? M p OP-FN f 2 2)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (and (> (gn-sir M (+ p 2) IF-A) 0) (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP))
    (gn-dot-at? M (+ p 3) 4 0 1 0)
    (gn-dot-at? M (+ p 4) 4 1 2 0)
    (gn-dot-at? M (+ p 5) 3 2 2 0)
    (gn-dot-at? M (+ p 6) 6 3 1 0)
    (gn-dot-at? M (+ p 7) 14 176 0 2)
    (gn-dot-at? M (+ p 8) 19 0 0 0)
    (gn-dot-at? M (+ p 9) OP-END f 0 0)))
(defn- pi-writer [M :vector-i64 p :i64 f :i64] :bool
  (and
    (gn-dot-at? M p OP-FN f 3 3)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (and (> (gn-sir M (+ p 2) IF-A) 0) (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP))
    (gn-dot-at? M (+ p 3) 4 0 1 0)
    (gn-dot-at? M (+ p 4) 4 1 2 0)
    (gn-dot-at? M (+ p 5) 4 2 3 0)
    (gn-dot-at? M (+ p 6) 14 208 0 3)
    (gn-dot-at? M (+ p 7) 19 0 0 0)
    (gn-dot-at? M (+ p 8) OP-END f 0 0)))
(defn- pi-body [M :vector-i64 p :i64 f :i64 reader :i64 writer :i64] :bool
  (and
    (gn-dot-at? M p OP-FN f 3 5)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (and (> (gn-sir M (+ p 2) IF-A) 0) (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP))
    (gn-dot-at? M (+ p 3) 4 0 1 0)
    (gn-dot-at? M (+ p 4) 4 1 3 0)
    (gn-dot-at? M (+ p 5) OP-CALL reader 0 2)
    (gn-dot-at? M (+ p 6) 5 4 0 0)
    (gn-dot-at? M (+ p 7) 4 0 1 0)
    (gn-dot-at? M (+ p 8) 4 1 3 0)
    (gn-dot-at? M (+ p 9) 3 2 2 0)
    (gn-dot-at? M (+ p 10) 6 3 1 0)
    (gn-dot-at? M (+ p 11) 3 2 1 0)
    (gn-dot-at? M (+ p 12) 6 1 1 0)
    (gn-dot-at? M (+ p 13) 14 176 0 2)
    (gn-dot-at? M (+ p 14) 5 5 0 0)
    (gn-dot-at? M (+ p 15) 4 0 1 0)
    (gn-dot-at? M (+ p 16) 4 1 2 0)
    (gn-dot-at? M (+ p 17) 3 2 2 0)
    (gn-dot-at? M (+ p 18) 6 3 1 0)
    (gn-dot-at? M (+ p 19) 4 2 4 0)
    (gn-dot-at? M (+ p 20) OP-CALL writer 0 3)
    (gn-dot-at? M (+ p 21) 4 1 2 0)
    (gn-dot-at? M (+ p 22) 3 2 2 0)
    (gn-dot-at? M (+ p 23) 6 3 1 0)
    (gn-dot-at? M (+ p 24) 3 2 1 0)
    (gn-dot-at? M (+ p 25) 6 1 1 0)
    (gn-dot-at? M (+ p 26) 4 2 5 0)
    (gn-dot-at? M (+ p 27) OP-CALL writer 0 3)
    (gn-dot-at? M (+ p 28) 19 0 0 0)
    (gn-dot-at? M (+ p 29) OP-END f 0 0)))
(defn- pi-shape [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR)]
   (if (or (<= p 0) (>= (+ p 29) (vector-at M MM-SIR-N))) 0
    (let [r (gn-sir M (+ p 5) IF-A) w (gn-sir M (+ p 20) IF-A)
          rp (if (and (> r 0) (< r (vector-at M MM-FN-N))) (gn-fnf M r FF-SIR) 0)
          wp (if (and (> w 0) (< w (vector-at M MM-FN-N))) (gn-fnf M w FF-SIR) 0)]
     (if (and (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 5)
      (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-RTYPE) TY-VEC)
      (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
      (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
      (pc3-helper-type M r 2 TY-I64) (pc3-helper-type M w 3 TY-VEC)
      (> rp 0) (< (+ rp 9) (vector-at M MM-SIR-N))
      (> wp 0) (< (+ wp 8) (vector-at M MM-SIR-N))
      (pi-reader M rp r) (pi-writer M wp w) (pi-body M p f r w)) p 0))))))
(defn- pi-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (and (= n 3) (>= t 0) (= (gn-g M gn-f-leaf) 0)
   (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-freg) 0)
   (>= (gn-g M gn-f-vmode) -1) (<= (gn-g M gn-f-vmode) 1)
   (<= (+ t n) (gn-g M gn-f-h)) (<= (+ t n) (gn-g M gn-f-dp))
   (not= (gn-op M (inc i)) OP-RET) (not= (gn-op M (inc i)) OP-RES2)
   (not (jt-return M i t)) (di-args-safe M t n)) (pi-shape M f) 0))
(defn- pi-call [M :vector-i64 i :i64 f :i64 t :i64] :vector-i64
 (let [m0 (-> M (gn-save 0 t) (gn-args t 0 3) (gn-ctx)
        (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 4))) b0 (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-mov-imm 16 4611686018427387904)
        (gn-emit (enc-cmp-r 2 16))) b1 (vector-at m1 MM-CODE-N)
       m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 1 16))) b2 (vector-at m2 MM-CODE-N)
       m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 312))
        (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
       m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
        (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 3 4 16 0))
        (gn-emit (gn-e-lsl 9 2 1)) (gn-emit (gn-e-lsl 10 1 1))
        (gn-emit (enc-add-i 17 9 1)) (gn-emit (enc-cmp-r 17 4))) b4 (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0))
        (gn-emit (enc-add-i 17 10 1)) (gn-emit (enc-cmp-r 17 4))) b5 (vector-at m5 MM-CODE-N)
       m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0))
        (gn-emit (enc-sub-i 8 8 4)) (gn-emit (enc-str 8 7 CTX-FUEL))
        (gn-emit (enc-ldr 16 7 328)) (gn-emit (enc-add-r 17 3 9))
        (gn-emit (enc-add-r 10 3 10)) (gn-emit (gn-e-addsl 17 16 17 3))
        (gn-emit (gn-e-addsl 10 16 10 3)) (gn-emit (enc-ldp 9 16 17 0))
        (gn-emit (enc-stp 9 16 10 0))) bj (vector-at m6 MM-CODE-N)
       m7 (gn-emit m6 (enc-b 0)) cold (vector-at m7 MM-CODE-N)
       m8 (-> m7 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))) join (vector-at m8 MM-CODE-N)]
  (-> m8 (gn-dot-patch b0 cold (enc-cond-lo)) (gn-dot-patch b1 cold (enc-cond-hs))
   (gn-dot-patch b2 cold (enc-cond-hs)) (gn-dot-patch b3 cold (enc-cond-hs))
   (gn-dot-patch b4 cold (enc-cond-hs)) (gn-dot-patch b5 cold (enc-cond-hs))
   (gn-put (+ MM-CODE-BASE bj) (enc-b (- join bj)))
   (gn-vclear) (gn-gs gn-f-vslot 0) (vi-clear) (sl-clear)
   (gn-gs gn-f-ctx 1) (gn-take i t 0))))

(defn- gn-op-call [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :vector-i64
  (let [packed-inline (qi-admit M i f t n) pair-inline (pi-admit M i f t n) table-inline (ti-admit M i f t n) clipped (rp-admit M i f t n) composition (rc-admit M i f t n) begin (vector-at M MM-CODE-N) w (gn-call-wrapper M i f t n) q (if (= (gn-g M gn-f-leaf) 2) 0 (gn-clamp M i f n)) mask (if (= (gn-g M gn-f-leaf) 2) 0 (gn-scalar-mask M i f n)) reader (if (= (gn-g M gn-f-leaf) 2) 0 (gn-affine-reader M i f n)) matrix (mr-reader M i f n) dag (di-admit M i f t n) collapsed (tc-admit M i f t n) twin (tb-admit M i f t n) affine-write (aw-admit M i f t n) out
   (cond (> packed-inline 0) (qi-call M i f t packed-inline) (> pair-inline 0) (pi-call M i f t) (> table-inline 0) (ti-call M i f t table-inline) (> clipped 0) (rp-call M i t clipped) (> composition 0) (rc-call M i t composition) (> matrix 0) (mr-call M i t f matrix) (> affine-write 0) (aw-call M i f t affine-write) (> reader 0) (gn-call-affine-reader M i t f reader) (> mask 0) (gn-call-scalar-mask M i t mask) (> q 0) (gn-call-clamp M i f t q) (gn-mask-writer M i f t n) (gn-call-mask-writer M t)
         (>= w 1024) (gn-call-sign M i t w)
         (> w 0) (let [M1 (if (>= w 256) (gn-op-fuel M) M)
                       slot (bit-and w 255)]
                   (if (= slot 1) (gn-gs M1 gn-f-h (inc t)) (gn-op-rt M1 i slot t n)))
         (> twin 0) (tb-call M i f t twin)
         (> collapsed 0) (tc-call M i f t collapsed)
         (> dag 0) (di-call M i f t n dag)
         :else (gn-call-generic M i f t n))]
   (ve-call (pf-after-call out begin))))
(defn- gn-call-generic [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :vector-i64
 (cond
         (and (<= n 7) (or (and (= (gn-op M (inc i)) OP-RET) (= (gn-sir M (inc i) IF-A) t))
                          (jt-return M i t)))
         (gn-op-tail-call M f t n)
         :else
    (-> M
      (gn-save 0 t)
      (gn-stack-args t 7 n)
      (gn-args t 0 (gn-min n 7))
      (gn-ctx)
      (gn-fix FX-BL26 f)
      (gn-emit (enc-bl 0))
      (gn-vclear)
      (gn-gs gn-f-ctx (if (or (= (gn-g M cc-proof) 1) (scr-ready M f n) (>= (gn-ctx-safe M f n 8 512) 0)) 1 0))
      (gn-take i t 0))))
;; A direct call whose only successor returns its scalar result can restore
;; this frame and branch to the callee. Stack arguments and RET2 are excluded.
;; Argument registers and x7 (context) survive the callee-saved restore.
;; FX-BL26 resolves a function target and patches imm26; the opcode remains B.
(defn- gn-op-tail-call [M :vector-i64 f :i64 t :i64 n :i64] :vector-i64
  (let [restored (-> M (gn-args t 0 n) (gn-ctx) (gn-epilogue))
        at (- (vector-at restored MM-CODE-N) 1)]
    (-> restored (gn-put MM-CODE-N at) (gn-chain-fix f t n) (gn-emit (enc-b 0)))))
;; R4: CALLI 0 t n -- blr to the code address in temp t+n, arguments t .. t+n-1 (a closure call)
(defn- gn-op-calli [M :vector-i64 i :i64 t :i64 n :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-args t 0 n)
      (gn-into 16 (+ t n))
      (gn-ctx)
      (gn-emit (enc-blr 16)) (gn-vclear)
      (gn-gs gn-f-ctx 0)
      (gn-take i t 0)))
;; R4: FADDR t f -- adr d, <entry of FN f> (FX-ADR19)
(defn- gn-op-faddr [M :vector-i64 i :i64 t :i64 f :i64] :vector-i64
  (let [s (gn-co M i t)
        d (gn-dreg M t s)]
    (-> M (gn-protect t s) (gn-fix FX-FADDR f) (gn-emit (gn-e-adr d))
        (gn-emit (+ 0x91000000 (* d 32) d)) (gn-emit (+ 0x91000000 (* d 32) d)) (gn-fin t s d))))
(defn- gn-op-cap [M :vector-i64 i :i64 wire :i64 kind :i64 t :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-into 4 t)
      (gn-mov-imm 1 wire)
      (gn-mov-imm 2 kind)
      (gn-mov-imm 3 kind)
      (gn-rtcall RT-TYPED-CAP-CALL)
      (gn-take i t 0)))
;; string literal: pair_new(ctx, code-relative pool offset (FX-LIT32 on movz x1 + movk x1), byte length);
;; no code when only string-length / string-code-point-at read it (gn-str-fold)
(defn- gn-op-str [M :vector-i64 i :i64 t :i64 lit :i64] :vector-i64
  (if (> (gn-str-fold M i) 0)
    (gn-def M t gn-k-lit lit)
    (gn-op-str-pair M i t lit)))
(defn- gn-op-str-pair [M :vector-i64 i :i64 t :i64 lit :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-fix FX-LIT32 lit)
      (gn-emit (enc-movz 1 0 0))
      (gn-emit (enc-movk 1 0 1))
      (gn-mov-imm 2 (gn-litf M lit LF-LEN))
      (gn-rtcall RT-PAIR-NEW)
      (gn-take i t 0)))

;; ---- inline runtime operations (ABI v9 pointers; the C twin's checks; udf #0 = SIGILL on failure) -------------------
;; x16 := &table[h - 1] after checking (h - 1) < *used (unsigned); h in register rv (x17 allowed)
(defn- gn-hchk [M :vector-i64 rv :i64 used :i64 base :i64] :vector-i64
  (-> M
      (gn-emit (enc-ldr 16 7 used))
      (gn-emit (enc-ldr 16 16 0))
      (gn-emit (enc-sub-i 17 rv 1))
      (gn-emit (enc-cmp-r 17 16))
      (gn-emit (enc-bcond (enc-cond-lo) 2))
      (gn-emit (gn-e-udf))
      (gn-emit (enc-ldr 16 7 base))
      (gn-emit (gn-e-addsl 16 16 17 4))))
;; after gn-hchk on the vector table: x17 := offset + index (checked index < length), x16 := items base
(defn- gn-vidx [M :vector-i64 ri :i64] :vector-i64
  (-> M
      (gn-emit (enc-ldp 17 16 16 0))
      (gn-emit (enc-cmp-r ri 16))
      (gn-emit (enc-bcond (enc-cond-lo) 2))
      (gn-emit (gn-e-udf))
      (gn-emit (enc-ldr 16 7 328))
      (gn-emit (enc-add-r 17 17 ri))))
;; (vector-at v i), v = temp t, i = temp t+1 (t <= 5)
(defn- gn-rt-at [M :vector-i64 i :i64 t :i64] :vector-i64
  (let [slot (if (= (gn-g M gn-f-vmode) 3) (gn-g M 15) (if (gn-isk M t gn-k-local) (gn-dv M t) 0))
        k (if (gn-isk M (inc t) gn-k-const) (gn-dv M (inc t)) -1)
        M1 (gn-pin M (inc t))
        ri (gn-pinned M1 (inc t))
        rv (gn-src M1 t 17 0)
        s (gn-co M1 i t)
        d (gn-dreg M1 t s)]
    (-> M1 (gn-protect t s) (gn-ctx) (gn-ldt t 17 0) (alen-read i rv ri d slot k) (gn-fin t s d))))
;; (vector-assoc! v i x), temps t, t+1, t+2 (t <= 4); the result is v (its descriptor is kept)
;; Novel exact same-block read/constant-local/writer certificate; no cache relaxation.
;; Requires original valid typed SIR: branches target LABELs, private mode2 ABI unchanged.
;; Pure analysis only. All original emitted instructions except redundant writer BLO/UDF remain.
(defn- vi-writer-bound [M :vector-i64 i :i64 slot :i64 islot :i64] :i64
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N)]
  (if (or (< i 10) (>= i (dec sn)) (> sn MM-SIR-CAP) (> fnn MM-FN-CAP)
          (<= slot 0) (>= slot gn-cap) (<= islot 0) (>= islot gn-cap) (= slot islot)) -1
   (let [p (- i 9) K (gn-sir M (+ p 1) IF-B) L (gn-sir M (+ p 4) IF-B)
         r (gn-sir M (+ p 3) IF-A) f (gn-sir M i IF-A)]
    (if (and (>= K 0) (>= L 0) (<= L K) (> r 0) (< r gn-cap) (not= r slot) (not= r islot)
             (> f 0) (< f fnn) (= (gn-op M i) OP-CALL) (= (gn-sir M i IF-B) 0)
             (= (gn-sir M i IF-C) 3) (not= (gn-op M (inc i)) OP-RES2)
             (= (gn-op M p) OP-LGET)
             (= (gn-sir M p IF-A) 0)
             (= (gn-sir M p IF-B) slot)
             (= (gn-sir M p IF-C) 0)
             (= (gn-op M (+ p 1)) OP-CONST)
             (= (gn-sir M (+ p 1) IF-A) 1)
             (= (gn-sir M (+ p 1) IF-B) K)
             (= (gn-sir M (+ p 1) IF-C) 0)
             (= (gn-op M (+ p 2)) OP-RT)
             (= (gn-sir M (+ p 2) IF-A) RT-VECTOR-AT)
             (= (gn-sir M (+ p 2) IF-B) 0)
             (= (gn-sir M (+ p 2) IF-C) 2)
             (= (gn-op M (+ p 3)) OP-LSET)
             (= (gn-sir M (+ p 3) IF-A) r)
             (= (gn-sir M (+ p 3) IF-B) 0)
             (= (gn-sir M (+ p 3) IF-C) 0)
             (= (gn-op M (+ p 4)) OP-CONST)
             (= (gn-sir M (+ p 4) IF-A) 0)
             (= (gn-sir M (+ p 4) IF-B) L)
             (= (gn-sir M (+ p 4) IF-C) 0)
             (= (gn-op M (+ p 5)) OP-LSET)
             (= (gn-sir M (+ p 5) IF-A) islot)
             (= (gn-sir M (+ p 5) IF-B) 0)
             (= (gn-sir M (+ p 5) IF-C) 0)
             (= (gn-op M (+ p 6)) OP-LGET)
             (= (gn-sir M (+ p 6) IF-A) 0)
             (= (gn-sir M (+ p 6) IF-B) slot)
             (= (gn-sir M (+ p 6) IF-C) 0)
             (= (gn-op M (+ p 7)) OP-LGET)
             (= (gn-sir M (+ p 7) IF-A) 1)
             (= (gn-sir M (+ p 7) IF-B) islot)
             (= (gn-sir M (+ p 7) IF-C) 0)
             (= (gn-op M (+ p 8)) OP-LGET)
             (= (gn-sir M (+ p 8) IF-A) 2)
             (= (gn-sir M (+ p 8) IF-B) r)
             (= (gn-sir M (+ p 8) IF-C) 0))
      (let [w (gn-wrapper M f 0 3)] (if (= (bit-and w 255) RT-VECTOR-ASSOC-IN-PLACE) K -1)) -1)))))

(defn- gn-rt-set [M :vector-i64 i :i64 t :i64] :vector-i64
  (let [slot (if (gn-isk M t gn-k-local) (gn-dv M t) 0)
        proof (if (and (= t 0) (= (gn-g M gn-f-vmode) 2) (gn-isk M t gn-k-local)
                       (gn-isk M (inc t) gn-k-local)) (vi-writer-bound M i slot (gn-dv M (inc t))) -1)
        k (if (>= proof 0) (gn-sir M (- i 5) IF-B)
              (if (gn-isk M (inc t) gn-k-const) (gn-dv M (inc t)) -1))
        M0 (if (>= proof 0) (-> M (gn-gs vi-slot slot) (gn-gs vi-max proof)) M)
        M1 (-> M0 (gn-pin t) (gn-pin (inc t)))
        M2 (if (and (gn-isk M1 (+ t 2) gn-k-const) (= (gn-dv M1 (+ t 2)) 0)) M1 (gn-pin M1 (+ t 2)))
        rv (gn-pinned M2 t)
        ri (gn-pinned M2 (inc t))
        rx (if (gn-isk M2 (+ t 2) gn-k-const) 31 (gn-pinned M2 (+ t 2)))]
    (-> M2 (gn-ctx) (alen-write i rv ri rx slot k) (gn-gs gn-f-h (inc t)))))
;; one-handle reads: sel 0 = pair-first, 1 = pair-second, 2 = vector-count
(defn- gn-rt-get [M :vector-i64 i :i64 t :i64 sel :i64] :vector-i64
  (let [rv (gn-src M t 17 0)
        s (gn-co M i t)
        d (gn-dreg M t s)]
    (-> M
        (gn-protect t s)
        (gn-ctx)
        (gn-ldt t 17 0)
        (gn-hchk rv (if (= sel 2) 312 288) (if (= sel 2) 320 296))
        (gn-emit (enc-ldr d 16 (if (= sel 0) 0 8)))
        (gn-fin t s d))))
;; (string-code-point-at <ASCII literal> i): bounds check, then the byte from the pool
(defn- gn-rt-lit-at [M :vector-i64 i :i64 t :i64] :vector-i64
  (let [lit (gn-dv M t)
        len (gn-litf M lit LF-LEN)
        ri (gn-src M (inc t) 16 0)
        s (gn-co M i t)
        d (gn-dreg M t s)]
    (-> M
        (gn-protect t s)
        (gn-ctx)
        (gn-ldt (inc t) 16 0)
        (cond-> (< len 4096) (gn-emit (enc-cmp-i ri len))
                (>= len 4096) (-> (gn-mov-imm 17 len) (gn-emit (enc-cmp-r ri 17))))
        (gn-emit (enc-bcond (enc-cond-lo) 2))
        (gn-emit (gn-e-udf))
        (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))
        (gn-emit (enc-add-r 17 17 ri))
        (gn-fix FX-LIT32 lit)
        (gn-emit (enc-movz 16 0 0))
        (gn-emit (enc-movk 16 0 1))
        (gn-emit (gn-e-ldrb d 17 16))
        (gn-fin t s d))))
;; R4 (the UTF-8 rule, seed/HEADS :tokens): (string-code-point-at s i) on a string handle. A code-relative pair (a
;; string literal or a view of one: offset >= 0, offset + length <= code_length) is valid UTF-8, so its ASCII bytes are
;; read in line; any other case (a pool string, a non-ASCII byte, an index or handle out of range) calls the C helper,
;; which checks and validates as before. x1 = handle, x2 = index, result x0.
;;   0 ldr x16,[x7,#288] ; 1 ldr x16,[x16] ; 2 sub x17,x1,#1 ; 3 cmp x17,x16 ; 4 b.hs SLOW ; 5 ldr x16,[x7,#296] ;
;;   6 add x16,x16,x17,lsl #4 ; 7 ldp x17,x16,[x16] ; 8 cmp x17,#0 ; 9 b.lt SLOW ; 10 cmp x2,x16 ; 11 b.hs SLOW ;
;;   12 add x16,x17,x16 ; 13 ldr x0,[x7,#392] ; 14 cmp x16,x0 ; 15 b.hi SLOW ; 16 ldr x16,[x7,#384] ; 17 add x16,x16,x17 ;
;;   18 ldrb w0,[x16,x2] ; 19 cmp x0,#128 ; 20 b.lo DONE ; 21 SLOW: mov x0,x7 ; 22 ldr x16,[x0,#144] ; 23 blr x16 ; 24 DONE
(defn- gn-rt-cpa [M :vector-i64 i :i64 t :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-args t 1 2)
      (gn-ctx)
      (gn-emit (enc-ldr 16 7 288)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 1 1)) (gn-emit (enc-cmp-r 17 16))
      (gn-emit (enc-bcond (enc-cond-hs) 17))
      (gn-emit (enc-ldr 16 7 296)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
      (gn-emit (enc-cmp-i 17 0)) (gn-emit (enc-bcond (enc-cond-lt) 12))
      (gn-emit (enc-cmp-r 2 16)) (gn-emit (enc-bcond (enc-cond-hs) 10))
      (gn-emit (enc-add-r 16 17 16)) (gn-emit (enc-ldr 0 7 392)) (gn-emit (enc-cmp-r 16 0)) (gn-emit (enc-bcond 8 6))
      (gn-emit (enc-ldr 16 7 CTX-CODE-BASE)) (gn-emit (enc-add-r 16 16 17)) (gn-emit (gn-e-ldrb 0 16 2))
      (gn-emit (enc-cmp-i 0 128)) (gn-emit (enc-bcond (enc-cond-lo) 4))
      (gn-emit (enc-mov-r 0 7)) (gn-emit (enc-ldr 16 0 RT-STRING-CODE-POINT-AT)) (gn-emit (enc-blr 16)) (gn-vclear)
      (gn-gs gn-f-ctx 0)
      (gn-take i t 0)))
;; High-temp read composition. Original prescan stays nonleaf and keeps its
;; frame/register/fuel contract. Preserve live prefix registers and homes without call spills; x0/x1 are free
;; argument scratch under that contract. Every handle/index check stays ordered.
;; Profitability guard: only an access inside an actual backward branch region.
;; Bounded scans refuse without changing the original call path. Label ownership
;; is checked against the current function; no code or benchmark names.
(defn- gn-high-start [M :vector-i64 j :i64 work :i64] :i64
 (cond (or (<= work 0) (<= j 0)) 0
       (= (gn-op M j) OP-FN) j
       (= (gn-op M j) OP-END) 0
       :else (gn-high-start M (dec j) (dec work))))
(defn- gn-high-loop-scan [M :vector-i64 i :i64 j :i64 start :i64 work :i64] :bool
 (if (or (<= work 0) (>= j (vector-at M MM-SIR-N)) (= (gn-op M j) OP-END)) false
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
        l (if (= op OP-BR) a (if (or (= op OP-BRZ) (= op OP-BRNZ)) b 0))
        p (if (> l 0) (gn-lpos M l) 0)]
   (if (and (> p start) (<= p i) (< p j) (= (gn-op M p) OP-LABEL) (= (gn-sir M p IF-A) l)) true
    (gn-high-loop-scan M i (inc j) start (dec work))))))
(defn- gn-high-loop [M :vector-i64 i :i64] :bool
 (let [start (gn-high-start M i 8192)]
  (and (> start 0) (gn-high-loop-scan M i (inc i) start 8192))))
(defn- gn-rt-high-at [M :vector-i64 i :i64 t :i64] :vector-i64
 (-> M (gn-into 0 t) (gn-into 1 (inc t)) (gn-ctx)
     (gn-vread 0 1 0)
     (gn-take i t 0)))
(defn- gn-op-rt [M :vector-i64 i :i64 slot :i64 t :i64 n :i64] :vector-i64
  (cond (and (gn-isk M t gn-k-lit) (= slot RT-PAIR-SECOND)) (gn-def M t gn-k-const (gn-litf M (gn-dv M t) LF-LEN))
        (gn-isk M t gn-k-lit) (gn-rt-lit-at M i t)
        (and (= slot RT-STRING-CODE-POINT-AT) (= n 2)) (gn-rt-cpa M i t)
        (and (= slot RT-VECTOR-AT) (= n 2) (>= t 6) (= (gn-g M gn-f-leaf) 0) (gn-high-loop M i)) (gn-rt-high-at M i t)
        (not (gn-inl slot t n)) (-> M (gn-save 0 t) (gn-args t 1 n) (gn-rtcall slot) (gn-take i t 0))
        (= slot RT-VECTOR-AT) (gn-rt-at M i t)
        (= slot RT-VECTOR-ASSOC-IN-PLACE) (gn-rt-set M i t)
        (= slot RT-PAIR-FIRST) (gn-rt-get M i t 0)
        (= slot RT-PAIR-SECOND) (gn-rt-get M i t 1)
        :else (gn-rt-get M i t 2)))

;; VEC t n: vector_alloc(ctx, n), then the items stored straight into the fresh vector's items
(defn- gn-vec-items [M :vector-i64 t :i64 k :i64 n :i64] :vector-i64
  (if (>= k n)
    M
    (let [r (gn-src M (+ t k) 17 1)]
      (gn-vec-items (-> M (gn-ldt (+ t k) 17 1) (gn-emit (enc-str r 16 (* 8 k)))) t (inc k) n))))
(defn- gn-op-vec [M :vector-i64 i :i64 t :i64 n :i64] :vector-i64
  (-> M
      (gn-save 0 (+ t n))
      (gn-mov-imm 1 n)
      (gn-rtcall RT-VECTOR-ALLOC)
      (cond-> (> n 0) (-> (gn-ctx)
                          (gn-emit (enc-sub-i 17 0 1))
                          (gn-emit (enc-ldr 16 7 320))
                          (gn-emit (gn-e-addsl 16 16 17 4))
                          (gn-emit (enc-ldr 17 16 0))
                          (gn-emit (enc-ldr 16 7 328))
                          (gn-emit (gn-e-addsl 16 16 17 3))
                          (gn-vec-items t 0 n)))
      (gn-take i t 0)))

;; R4B: VECP t lit n: vector_alloc(ctx, n), x16 := the items, x17 := code_base + LF-POOL(lit), then the copy loop
;;   ldr x3,[x17] ; add x17,x17,#8 ; str x3,[x16] ; add x16,x16,#8 ; subs x2,x2,#1 ; b.ne -5
(defn- gn-op-vecp [M :vector-i64 i :i64 t :i64 lit :i64 n :i64] :vector-i64
  (-> M
      (gn-save 0 t)
      (gn-mov-imm 1 n)
      (gn-rtcall RT-VECTOR-ALLOC)
      (gn-ctx)
      (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldr 17 16 0))
      (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 16 16 17 3))
      (gn-fix FX-LIT32 lit) (gn-emit (enc-movz 1 0 0)) (gn-emit (enc-movk 1 0 1))
      (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-emit (enc-add-r 17 17 1))
      (gn-mov-imm 2 n)
      (gn-emit (enc-ldr 3 17 0)) (gn-emit (enc-add-i 17 17 8)) (gn-emit (enc-str 3 16 0)) (gn-emit (enc-add-i 16 16 8))
      (gn-emit (enc-subs-i 2 2 1)) (gn-emit (enc-bcond (enc-cond-ne) -5))
      (gn-take i t 0)))

;; TAB t lit n (constant table): cmp idx,#n ; b.lo +2 ; brk #0 ; x17 := code_base + 8*idx ; x16 := LF-POOL (FX-LIT32) ;
;; d := [x17, x16]
(defn- gn-op-tab [M :vector-i64 i :i64 t :i64 lit :i64 n :i64] :vector-i64
  (let [ri (gn-src M t 16 0)
        s (gn-co M i t)
        d (gn-dreg M t s)]
    (-> M
        (gn-protect t s)
        (gn-ctx)
        (gn-ldt t 16 0)
        (cond-> (< n 4096) (gn-emit (enc-cmp-i ri n))
                (>= n 4096) (-> (gn-mov-imm 17 n) (gn-emit (enc-cmp-r ri 17))))
        (gn-emit (enc-bcond (enc-cond-lo) 2))
        (gn-emit (enc-brk 0))
        (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))
        (gn-emit (gn-e-addsl 17 17 ri 3))
        (gn-fix FX-LIT32 lit)
        (gn-emit (enc-movz 16 0 0))
        (gn-emit (enc-movk 16 0 1))
        (gn-emit (gn-e-ldrr d 17 16 0))
        (gn-fin t s d))))

;; FUEL: leaf -> subs x8,x8,#1 ; b.hs +3 ; str xzr,[x7,#8] ; brk #0. Else ldr x16,[x7,#8] ; subs x16,x16,#1 ; b.hs +2 ; brk #0 ;
;; str x16,[x7,#8]. SEEDFIX (F4): the leaf's exhaustion path stores 0 to the context before brk, as the memory sequence
;; leaves it, so the loader reports :budget/fuel (not a bare SIGTRAP) when a leaf runs out (x8 was never written back)
(defn- gn-op-fuel [M :vector-i64] :vector-i64
  (cond (= (gn-g M gn-f-freg) 3) M
    (= (gn-g M gn-f-freg) 1)
    (-> M (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 3)) (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0)))
    (= (gn-g M gn-f-freg) 2)
    (-> M (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 2))
          (gn-emit (enc-brk 0)) (gn-emit (enc-str 8 7 CTX-FUEL)))
    :else (-> M
        (gn-ctx)
        (gn-emit (enc-ldr 16 7 CTX-FUEL))
        (gn-emit (enc-subs-i 16 16 1))
        (gn-emit (enc-bcond (enc-cond-hs) 2))
        (gn-emit (enc-brk 0))
        (gn-emit (enc-str 16 7 CTX-FUEL)))))

;; Exact affine index consumed by immediately adjacent checked vector read.
;; Original nonleaf frame reserves x0/x1 scratch; every handle/index check stays.
;; Dead intermediates only; final result uses original alias/coalescing placement.
(defn- gn-affine-read? [M :vector-i64 i :i64 t :i64] :bool
 (let [a (gn-sir M i IF-B) b (gn-sir M (+ i 3) IF-B)
       factor (gn-sir M (inc i) IF-B) prefix (gn-dv M (dec t))]
  (and (= (gn-g M gn-f-leaf) 0) (>= t 7) (< (inc t) (gn-g M gn-f-dp)) (< (+ i 6) (vector-at M MM-SIR-N))
       (> a 0) (<= a (gn-g M gn-f-ns)) (> b 0) (<= b (gn-g M gn-f-ns))
       (>= (gn-sreg M a) 0) (>= (gn-sreg M b) 0)
       (gn-isk M (dec t) gn-k-const) (>= prefix -4095) (<= prefix 4095)
       (not= factor 0) (not= factor 1) (not= factor -1)
       (= (gn-sir M i IF-C) 0)
       (= (gn-op M (inc i)) OP-CONST) (= (gn-sir M (inc i) IF-A) (inc t)) (= (gn-sir M (inc i) IF-C) 0)
       (= (gn-op M (+ i 2)) OP-BIN) (= (gn-sir M (+ i 2) IF-A) BOP-MUL) (= (gn-sir M (+ i 2) IF-B) t) (= (gn-sir M (+ i 2) IF-C) 0)
       (= (gn-op M (+ i 3)) OP-LGET) (= (gn-sir M (+ i 3) IF-A) (inc t)) (= (gn-sir M (+ i 3) IF-C) 0)
       (= (gn-op M (+ i 4)) OP-BIN) (= (gn-sir M (+ i 4) IF-A) BOP-ADD) (= (gn-sir M (+ i 4) IF-B) t) (= (gn-sir M (+ i 4) IF-C) 0)
       (= (gn-op M (+ i 5)) OP-BIN) (= (gn-sir M (+ i 5) IF-A) BOP-ADD) (= (gn-sir M (+ i 5) IF-B) (dec t)) (= (gn-sir M (+ i 5) IF-C) 0)
       (= (gn-op M (+ i 6)) OP-RT) (= (gn-sir M (+ i 6) IF-A) RT-VECTOR-AT)
       (= (gn-sir M (+ i 6) IF-B) (- t 2)) (= (gn-sir M (+ i 6) IF-C) 2)
       (gn-kills M (+ i 7) (dec t) 16) (gn-high-loop M i) (gn-kills M (+ i 6) t 16) (gn-kills M (+ i 6) (inc t) 16))))
(defn- gn-affine-read [M :vector-i64 i :i64 t :i64] :vector-i64
 (let [out (- t 2) s (gn-co M (+ i 6) out) d (gn-dreg M out s)
       slot (if (gn-isk M out gn-k-local) (gn-dv M out) 0)
       a (gn-sreg M (gn-sir M i IF-B)) b (gn-sreg M (gn-sir M (+ i 3) IF-B))
       factor (gn-sir M (inc i) IF-B) prefix (gn-dv M (dec t))
       M1 (-> M (gn-protect out s) (gn-into 0 out) (gn-mov-imm 16 factor)
              (gn-emit (enc-madd 1 a 16 b)) (gn-bin-imm BOP-ADD 1 1 prefix)
              (gn-ctx) (gn-vpair slot d) (gn-fin out s d))]
  (gn-gs M1 gn-f-skip (+ 6 (gn-g M1 gn-f-skip)))))

;; Prototype whole closed dot loop: proof-guarded expansion, original fallback.
(defn- gn-dot-at? [M :vector-i64 i :i64 op :i64 a :i64 b :i64 c :i64] :bool
 (and (= (gn-op M i) op) (= (gn-sir M i IF-A) a)
      (= (gn-sir M i IF-B) b) (= (gn-sir M i IF-C) c)))
(defn- gn-dot-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B) exit (gn-sir M (+ p 8) IF-A)
       n (gn-sir M (+ p 4) IF-B) oa (gn-sir M (+ p 18) IF-B) sa (gn-sir M (+ p 20) IF-B)
       ob (gn-sir M (+ p 27) IF-B) sb (gn-sir M (+ p 29) IF-B)]
  (if (= k 47) true
   (and (case k
    0 (gn-dot-at? M (+ p 0) OP-FN f 5 5)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 5 0)
    8 (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
    13 (gn-dot-at? M (+ p 13) OP-LGET 3 4 0)
    14 (gn-dot-at? M (+ p 14) OP-CONST 4 1 0)
    15 (gn-dot-at? M (+ p 15) OP-BIN BOP-ADD 3 0)
    16 (gn-dot-at? M (+ p 16) OP-LGET 4 5 0)
    17 (gn-dot-at? M (+ p 17) OP-LGET 5 1 0)
    18 (gn-dot-at? M (+ p 18) OP-CONST 6 oa 0)
    19 (gn-dot-at? M (+ p 19) OP-LGET 7 2 0)
    20 (gn-dot-at? M (+ p 20) OP-CONST 8 sa 0)
    21 (gn-dot-at? M (+ p 21) OP-BIN BOP-MUL 7 0)
    22 (gn-dot-at? M (+ p 22) OP-LGET 8 4 0)
    23 (gn-dot-at? M (+ p 23) OP-BIN BOP-ADD 7 0)
    24 (gn-dot-at? M (+ p 24) OP-BIN BOP-ADD 6 0)
    25 (gn-dot-at? M (+ p 25) OP-RT RT-VECTOR-AT 5 2)
    26 (gn-dot-at? M (+ p 26) OP-LGET 6 1 0)
    27 (gn-dot-at? M (+ p 27) OP-CONST 7 ob 0)
    28 (gn-dot-at? M (+ p 28) OP-LGET 8 4 0)
    29 (gn-dot-at? M (+ p 29) OP-CONST 9 sb 0)
    30 (gn-dot-at? M (+ p 30) OP-BIN BOP-MUL 8 0)
    31 (gn-dot-at? M (+ p 31) OP-LGET 9 3 0)
    32 (gn-dot-at? M (+ p 32) OP-BIN BOP-ADD 8 0)
    33 (gn-dot-at? M (+ p 33) OP-BIN BOP-ADD 7 0)
    34 (gn-dot-at? M (+ p 34) OP-RT RT-VECTOR-AT 6 2)
    35 (gn-dot-at? M (+ p 35) OP-BIN BOP-MUL 5 0)
    36 (gn-dot-at? M (+ p 36) OP-BIN BOP-ADD 4 0)
    37 (gn-dot-at? M (+ p 37) OP-LSET 1 0 0)
    38 (gn-dot-at? M (+ p 38) OP-LSET 2 1 0)
    39 (gn-dot-at? M (+ p 39) OP-LSET 3 2 0)
    40 (gn-dot-at? M (+ p 40) OP-LSET 4 3 0)
    41 (gn-dot-at? M (+ p 41) OP-LSET 5 4 0)
    42 (gn-dot-at? M (+ p 42) OP-FUEL 0 0 0)
    43 (gn-dot-at? M (+ p 43) OP-BR head 0 0)
    44 (gn-dot-at? M (+ p 44) OP-LABEL exit 0 0)
    45 (gn-dot-at? M (+ p 45) OP-RET 0 0 0)
    46 (gn-dot-at? M (+ p 46) OP-END f 0 0)
    false)
        (gn-dot-shape M p f (inc k))))))
(defn- gn-dot? [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 46) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 5)
       (= (gn-fnf M f FF-NSLOTS) 5) (= (gn-fnf M f FF-DEPTH) 10)
       (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
       (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
       (= (gn-fnf M f (+ FF-PT0 4)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-I64)
       (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-h) 0)
       (>= (gn-sreg M 1) 19) (>= (gn-sreg M 2) 19) (>= (gn-sreg M 3) 19)
       (>= (gn-sreg M 4) 19) (>= (gn-sreg M 5) 19)
       (<= (gn-sreg M 1) 28) (<= (gn-sreg M 2) 28) (<= (gn-sreg M 3) 28)
       (<= (gn-sreg M 4) 28) (<= (gn-sreg M 5) 28)
       (>= (gn-sir M (+ p 4) IF-B) 1) (<= (gn-sir M (+ p 4) IF-B) 64)
       (>= (gn-sir M (+ p 18) IF-B) 0) (<= (gn-sir M (+ p 18) IF-B) 4095)
       (>= (gn-sir M (+ p 27) IF-B) 0) (<= (gn-sir M (+ p 27) IF-B) 4095)
       (>= (gn-sir M (+ p 20) IF-B) 1) (<= (gn-sir M (+ p 20) IF-B) 64)
       (>= (gn-sir M (+ p 29) IF-B) 1) (<= (gn-sir M (+ p 29) IF-B) 64)
       (> (gn-sir M (+ p 2) IF-A) 0) (> (gn-sir M (+ p 6) IF-B) 0) (> (gn-sir M (+ p 8) IF-A) 0)
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 6) IF-B))
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 8) IF-A))
       (not= (gn-sir M (+ p 6) IF-B) (gn-sir M (+ p 8) IF-A))
       (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))
       (= (gn-lpos M (gn-sir M (+ p 6) IF-B)) (+ p 9))
       (= (gn-lpos M (gn-sir M (+ p 8) IF-A)) (+ p 44))
       (gn-dot-shape M p f 0))))
(defn- gn-dot-expand [M :vector-i64 j :i64 n :i64 sb :i64] :vector-i64
 (if (= j n) M
  (gn-dot-expand (-> M (gn-emit (enc-ldr 9 0 (* 8 j)))
                      (gn-emit (enc-ldr 10 1 (* 8 j sb)))
                      (gn-emit (enc-madd 2 9 10 2))) (inc j) n sb)))
(defn- gn-dot-patch [M :vector-i64 at :i64 end :i64 cc :i64] :vector-i64
 (gn-put M (+ MM-CODE-BASE at) (enc-bcond cc (- end at))))
(defn- gn-dot-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (gn-dot? M i)) M
  (let [p (dec i) n (gn-sir M (+ p 4) IF-B) sa (gn-sir M (+ p 20) IF-B)
        sb (gn-sir M (+ p 29) IF-B) oa (gn-sir M (+ p 18) IF-B) ob (gn-sir M (+ p 27) IF-B)
        r1 (gn-sreg M 1) r2 (gn-sreg M 2) r3 (gn-sreg M 3) r4 (gn-sreg M 4) r5 (gn-sreg M 5)
        M0 (gn-emit M (enc-cmp-i r4 0)) b0 (vector-at M0 MM-CODE-N)
        M1 (-> M0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i r2 n))) b1 (vector-at M1 MM-CODE-N)
        M2 (-> M1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-i r3 n))) b2 (vector-at M2 MM-CODE-N)
        M3 (-> M2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 n))) b3 (vector-at M3 MM-CODE-N)
        M4 (-> M3 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
                  (gn-emit (enc-sub-i 17 r1 1)) (gn-emit (enc-cmp-r 17 16))) b4 (vector-at M4 MM-CODE-N)
        M5 (-> M4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
                  (gn-emit (enc-ldp 17 3 16 0)) (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))
                  (gn-mov-imm 16 sa) (gn-emit (enc-mul 0 r2 16)) (gn-emit (enc-add-i 0 0 oa))
                  (gn-emit (enc-add-i 1 r3 ob)) (gn-emit (enc-add-i 17 0 (dec n))) (gn-emit (enc-cmp-r 17 3))) b5 (vector-at M5 MM-CODE-N)
        M6 (-> M5 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-add-i 17 1 (* (dec n) sb)))
                  (gn-emit (enc-cmp-r 17 3))) b6 (vector-at M6 MM-CODE-N)
        M7 (-> M6 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (gn-e-addsl 0 4 0 3))
                  (gn-emit (gn-e-addsl 1 4 1 3)) (gn-mov 2 r5) (gn-dot-expand 0 n sb)
                  (gn-emit (enc-sub-i 8 8 n)) (gn-emit (enc-str 8 7 CTX-FUEL))
                  (gn-mov 0 2) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at M7 MM-CODE-N)]
   (-> M7 (gn-dot-patch b0 end (enc-cond-ne)) (gn-dot-patch b1 end (enc-cond-hs))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-lo))
          (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-hs))
          (gn-dot-patch b6 end (enc-cond-hs)) (gn-vclear)))))

(defn- btg-owner [M :vector-i64 p :i64 left :i64] :i64
 (if (or (<= p 0) (<= left 0)) 0
  (if (= (gn-op M p) OP-FN) (gn-sir M p IF-A)
   (btg-owner M (dec p) (dec left)))))
;; Exact closed bounded table dot interval. Guards never trap; failure keeps SIR.
(defn- btg-edges [M :vector-i64 j :i64 f :i64 l :i64 count :i64] :bool
 (if (>= j (vector-at M MM-SIR-N)) false
  (let [op (gn-op M j)]
   (if (= op OP-END) (and (= (gn-sir M j IF-A) f) (= count 1))
    (btg-edges M (inc j) f l
     (+ count (if (or (and (= op OP-BR) (= (gn-sir M j IF-A) l))
                     (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= (gn-sir M j IF-B) l))) 1 0)))))))
(defn- btg-shape [M :vector-i64 p :i64 k :i64] :bool
 (let [h (gn-sir M p IF-A) body (gn-sir M (+ p 4) IF-B)
       exit (gn-sir M (+ p 8) IF-A) n (gn-sir M (+ p 2) IF-B)
       sh (gn-sir M (+ p 6) IF-B) f (gn-sir M (+ p 20) IF-A)]
  (if (= k 28) true
   (and (case k
    0 (gn-dot-at? M p OP-LABEL h 0 0)
    1 (gn-dot-at? M (+ p 1) OP-LGET 0 3 0)
    2 (gn-dot-at? M (+ p 2) OP-CONST 1 n 0)
    3 (gn-dot-at? M (+ p 3) OP-CMP CC-EQ 0 0)
    4 (gn-dot-at? M (+ p 4) OP-BRZ 0 body 0)
    5 (gn-dot-at? M (+ p 5) OP-LGET 0 4 0)
    6 (gn-dot-at? M (+ p 6) OP-CONST 1 sh 0)
    7 (gn-dot-at? M (+ p 7) OP-BIN BOP-SSHR 0 0)
    8 (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 3 0)
    11 (gn-dot-at? M (+ p 11) OP-CONST 1 1 0)
    12 (gn-dot-at? M (+ p 12) OP-BIN BOP-ADD 0 0)
    13 (gn-dot-at? M (+ p 13) OP-LGET 1 4 0)
    14 (gn-dot-at? M (+ p 14) OP-LGET 2 1 0)
    15 (gn-dot-at? M (+ p 15) OP-LGET 3 2 0)
    16 (gn-dot-at? M (+ p 16) OP-LGET 4 3 0)
    17 (gn-dot-at? M (+ p 17) OP-BIN BOP-ADD 3 0)
    18 (gn-dot-at? M (+ p 18) OP-RT RT-VECTOR-AT 2 2)
    19 (gn-dot-at? M (+ p 19) OP-LGET 3 3 0)
    20 (gn-dot-at? M (+ p 20) OP-CALL f 3 1)
    21 (gn-dot-at? M (+ p 21) OP-BIN BOP-MUL 2 0)
    22 (gn-dot-at? M (+ p 22) OP-BIN BOP-ADD 1 0)
    23 (gn-dot-at? M (+ p 23) OP-LSET 3 0 0)
    24 (gn-dot-at? M (+ p 24) OP-LSET 4 1 0)
    25 (gn-dot-at? M (+ p 25) OP-FUEL 0 0 0)
    26 (gn-dot-at? M (+ p 26) OP-BR h 0 0)
    27 (gn-dot-at? M (+ p 27) OP-LABEL exit 0 0)
    false) (btg-shape M p (inc k))))))
(defn- btg-admit [M :vector-i64 p :i64] :i64
 (if (or (< p 5) (>= (+ p 27) (vector-at M MM-SIR-N))
         (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
         (> (gn-g M gn-f-h) 1) (not (gn-dead-at M (gn-sir M p IF-A) 0)) (not= (gn-g M gn-f-skip) 0)
         (not= (gn-g M gn-f-ns) 4) (not= (gn-g M gn-f-dp) 5)) 0
  (let [f (btg-owner M p 4096) fp (gn-fnf M f FF-SIR)
        n (gn-sir M (+ p 2) IF-B) sh (gn-sir M (+ p 6) IF-B)
        helper (gn-sir M (+ p 20) IF-A) lit (tb-shape M helper)
        h (gn-sir M p IF-A) body (gn-sir M (+ p 4) IF-B)
        exit (gn-sir M (+ p 8) IF-A)]
   (if (and (> f 0) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
       (> lit 0) (> n 0) (<= n 64) (<= (* n 8) (gn-litf M lit LF-LEN))
       (>= sh 0) (<= sh 63)
       (>= (gn-sreg M 1) 19) (<= (gn-sreg M 1) 28)
       (>= (gn-sreg M 2) 19) (<= (gn-sreg M 2) 28)
       (>= (gn-sreg M 3) 19) (<= (gn-sreg M 3) 28)
       (>= (gn-sreg M 4) 19) (<= (gn-sreg M 4) 28)
       (gn-dot-at? M (- p 4) OP-CONST 0 0 0)
       (gn-dot-at? M (- p 3) OP-LSET 3 0 0)
       (gn-dot-at? M (- p 2) OP-CONST 0 0 0)
       (gn-dot-at? M (dec p) OP-LSET 4 0 0)
       (> h 0) (< h MM-LABEL-CAP) (> body 0) (< body MM-LABEL-CAP) (> exit 0) (< exit MM-LABEL-CAP) (not= h body) (not= h exit) (not= body exit)
       (= (gn-lpos M h) p) (= (gn-lpos M body) (+ p 9))
       (= (gn-lpos M exit) (+ p 27))
       (btg-edges M fp f h 0) (btg-edges M fp f body 0) (btg-edges M fp f exit 0)
       (btg-shape M p 0)) lit 0))))
(defn- btg-expand [M :vector-i64 j :i64 n :i64] :vector-i64
 (if (= j n) M
  (btg-expand (-> M (gn-emit (enc-ldr 0 4 (* 8 j)))
                    (gn-emit (enc-ldr 1 5 (* 8 j)))
                    (gn-emit (enc-madd 2 0 1 2))) (inc j) n)))
(defn- btg-entry [M :vector-i64 p :i64] :vector-i64
 (let [lit (btg-admit M p)]
  (if (= lit 0) M
   (let [n (gn-sir M (+ p 2) IF-B) sh (gn-sir M (+ p 6) IF-B)
         rvec (gn-sreg M 1) ri (gn-sreg M 2) rj (gn-sreg M 3) rs (gn-sreg M 4)
         m0 (-> M (gn-ctx) (gn-emit (enc-cmp-i rj 0))) b0 (vector-at m0 MM-CODE-N)
         m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i rs 0))) b1 (vector-at m1 MM-CODE-N)
         m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
                    (gn-emit (enc-cmp-i 8 (* n 2)))) b2 (vector-at m2 MM-CODE-N)
         m3 (-> m2 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312))
                    (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rvec 1))
                    (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
         m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                    (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 3 16 0))
                    (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 3 16))) b6 (vector-at m4 MM-CODE-N)
         mx (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-i 3 n))) b4 (vector-at mx MM-CODE-N)
         m5 (-> mx (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-sub-i 16 3 n))
                    (gn-emit (enc-cmp-r ri 16))) b5 (vector-at m5 MM-CODE-N)
         m6 (-> m5 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-ldr 4 7 328))
                    (gn-emit (gn-e-addsl 4 4 17 3)) (gn-emit (gn-e-addsl 4 4 ri 3))
                    (gn-emit (enc-ldr 5 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
                    (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
                    (gn-emit (enc-add-r 5 5 16)) (gn-mov-imm 2 0) (btg-expand 0 n)
                    (gn-mov rs 2) (gn-mov-imm rj n) (gn-mov-imm 16 sh)
                    (gn-emit (enc-asrv 9 2 16)) (gn-emit (enc-sub-i 8 8 (* n 2)))
                    (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-vclear)
                    (gn-fix FX-B26 (gn-sir M (+ p 8) IF-A)) (gn-emit (enc-b 0)))
         end (vector-at m6 MM-CODE-N)]
    (-> m6 (gn-dot-patch b0 end (enc-cond-ne)) (gn-dot-patch b1 end (enc-cond-ne))
           (gn-dot-patch b2 end (enc-cond-lo)) (gn-dot-patch b3 end (enc-cond-hs))
           (gn-dot-patch b4 end (enc-cond-lo)) (gn-dot-patch b5 end 8)
           (gn-dot-patch b6 end (enc-cond-hs))
           (gn-vclear))))))

;; Exact pure short-circuit affine zero scan, guarded original fallback.
;; Certified bounded affine payload update CFG.
(defn- bu-def [M :vector-i64 j :i64 first :i64 t :i64 work :i64] :i64
 (cond (or (< j first) (<= work 0) (= (gn-op M j) OP-LABEL)) 0
       (= (gn-defd M j) t) j
       :else (bu-def M (dec j) first t (dec work))))
(defn- bu-index [M :vector-i64 j :i64 first :i64 t :i64] :i64
 (let [d (bu-def M (dec j) first t 32)]
  (if (and (>= d (+ first 2)) (gn-dot-at? M d OP-BIN BOP-ADD t 0)
    (gn-dot-at? M (- d 2) OP-CONST t (gn-sir M (- d 2) IF-B) 0)
    (gn-dot-at? M (dec d) OP-LGET (inc t) 3 0)
    (>= (gn-sir M (- d 2) IF-B) 0) (<= (gn-sir M (- d 2) IF-B) 4095))
   (inc (gn-sir M (- d 2) IF-B)) 0)))
;; Return original charge count+1; unsupported effect is0.
(defn- bu-charge [M :vector-i64 j :i64] :i64
 (let [f (gn-sir M j IF-A) t (gn-sir M j IF-B) n (gn-sir M j IF-C)]
  (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)
          (= (gn-op M (inc j)) OP-RES2)) 0
   (cond (and (= t 0) (= n 3) (gn-mask-writer M j f t n)
          (not (gn-clamp-open M (gn-sir M (+ (gn-skiplab M (+ (gn-fnf M f FF-SIR) 2)) 5) IF-A)))) 3
         (and (= n 1) (>= t 0) (<= t 5))
          (let [w (gn-call-wrapper M j f t n) q (gn-clamp M j f n)]
           (cond (and (>= w 1024) (< w 1536)) 1
                 (> q 0) (let [p (gn-fnf M f FF-SIR)
                               z (gn-sign-wrapper M (gn-sir M (inc q) IF-A) 1)]
                           (if (and (>= z 1024) (< z 1536))
                            (if (= (gn-op M (inc p)) OP-FUEL) 2 1) 0))
                 :else 0))
         :else 0))))
(defn- bu-range [M :vector-i64 j :i64 first :i64 tail :i64 max :i64] :i64
 (if (= j tail) (inc max)
  (let [op (gn-op M j) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
   (cond
    (= op OP-RT)
     (let [offset (bu-index M j first (inc b)) d (bu-def M (dec j) first (inc b) 32)]
      (if (and (= (gn-sir M j IF-A) RT-VECTOR-AT) (>= b 0) (<= b 5) (= c 2)
       (> offset 0) (= d (dec j)) (gn-dot-at? M (- j 4) OP-LGET b 1 0))
       (bu-range M (inc j) first tail (gn-max max (dec offset))) 0))
    (and (= op OP-CALL) (= (bu-charge M j) 3))
     (let [offset (bu-index M j first 1)]
      (if (> offset 0) (bu-range M (inc j) first tail (gn-max max (dec offset))) 0))
    :else (bu-range M (inc j) first tail max)))))
 ;; Every admitted operation stays in the ordinary integer/low-temp banks.
(defn- bu-operands [M :vector-i64 j :i64] :bool
 (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
  (case op
   OP-CONST (and (>= a 0) (<= a 6) (< a (gn-g M gn-f-dp)) (= c 0))
   OP-LGET (and (>= a 0) (<= a 6) (< a (gn-g M gn-f-dp)) (> b 0) (<= b (gn-g M gn-f-ns)) (= c 0))
   OP-LSET (and (> a 3) (<= a (gn-g M gn-f-ns)) (>= b 0) (<= b 6) (< b (gn-g M gn-f-dp)) (= c 0))
   OP-BIN (and (>= b 0) (<= b 5) (< (inc b) (gn-g M gn-f-dp)) (= c 0))
   OP-CMP (and (>= a CC-EQ) (<= a CC-GE) (>= b 0) (<= b 5) (< (inc b) (gn-g M gn-f-dp)) (= c 0))
   OP-CALL (and (> a 0) (< a (vector-at M MM-FN-N)) (>= b 0) (<= b 5) (> c 0) (<= c 3) (<= (+ b c) (gn-g M gn-f-dp)))
   OP-RT (and (= a RT-VECTOR-AT) (>= b 0) (<= b 5) (= c 2) (< (inc b) (gn-g M gn-f-dp)))
   OP-LABEL (and (> a 0) (< a MM-LABEL-CAP) (= b 0) (= c 0) (= (gn-lpos M a) j))
   OP-BR (and (> a 0) (< a MM-LABEL-CAP) (= b 0) (= c 0))
   OP-BRZ (and (= a 0) (> b 0) (< b MM-LABEL-CAP) (= c 0))
   false)))
;; Forward-only body CFG; every path must have equal charge count and return
;; the original vector handle. No entry names or arithmetic constants assumed.
(defn- bu-cost [M :vector-i64 j :i64 tail :i64 origin :bool work :i64] :i64
 (cond (= j tail) (if origin 1 0)
       (or (> j tail) (<= work 0) (not (bu-operands M j))) 0
       :else
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
        o (if (= (gn-defd M j) 0) (and (= op OP-LGET) (= b 1)) origin)]
   (cond
    (= op OP-BRZ)
     (let [to (inc (gn-lpos M b)) yes (bu-cost M (inc j) tail origin (dec work))]
      (if (and (= a 0) (= c 0) (> to j) (<= to tail)
       (gn-dot-at? M (- j 3) OP-LGET 0 2 0)
       (gn-dot-at? M (- j 2) OP-CONST 1 (gn-sir M (- j 2) IF-B) 0)
       (gn-dot-at? M (dec j) OP-CMP CC-EQ 0 0))
       (let [no (bu-cost M to tail origin (dec work))]
        (if (and (> yes 0) (= yes no)) yes 0)) 0))
    (= op OP-BR)
     (let [to (inc (gn-lpos M a))]
      (if (and (= b 0) (= c 0) (> to j) (<= to tail))
       (bu-cost M to tail origin (dec work)) 0))
    (= op OP-CALL)
     (let [charge (bu-charge M j) writer (= charge 3)
           after (if writer origin o)
           rest (if (and (> charge 0) (or (not writer) origin))
                  (bu-cost M (inc j) tail after (dec work)) 0)]
      (if (> rest 0) (+ rest (dec charge)) 0))
    (= op OP-BIN)
     (if (or (= a BOP-ADD) (= a BOP-SUB) (= a BOP-MUL) (= a BOP-AND)
             (and (= a BOP-QUOT) (= (gn-op M (dec j)) OP-CONST)
               (= (gn-sir M (dec j) IF-A) (inc b)) (> (gn-sir M (dec j) IF-B) 0)
               (> (gn-pow2 (gn-sir M (dec j) IF-B)) 0)))
      (bu-cost M (inc j) tail o (dec work)) 0)
    (= op OP-LSET)
     (if (and (> a 3) (<= a (gn-g M gn-f-ns)) (= c 0))
      (bu-cost M (inc j) tail origin (dec work)) 0)
    (or (= op OP-CONST) (= op OP-LGET) (= op OP-CMP) (= op OP-LABEL) (= op OP-RT))
     (bu-cost M (inc j) tail o (dec work))
    :else 0))))
(defn- bu-admit [M :vector-i64 i :i64] :i64
 (if (not= (gn-op M (dec i)) OP-FN) 0
 (let [p (dec i) f (gn-sir M p IF-A) end (gn-small-end M (inc p) f 256)
       tail (- end 13) n (gn-sir M (+ p 4) IF-B)
       head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
       exit (gn-sir M (+ p 8) IF-A) carry (gn-sir M tail IF-A)]
  (if (and (> p 0) (> f 0) (< f (vector-at M MM-FN-N)) (> end (+ p 40))
    (not (gn-clamp-open M f)) (= (gn-g M gn-f-leaf) 0)
    (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (>= (gn-g M gn-f-ns) 4) (<= (gn-g M gn-f-ns) 7) (>= (gn-g M gn-f-dp) 4) (<= (gn-g M gn-f-dp) 7)
    (loop [k 1] (or (> k (gn-g M gn-f-ns))
      (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
           (loop [other 1] (or (= other k)
             (and (not= (gn-sreg M k) (gn-sreg M other)) (recur (inc other)))))
           (recur (inc k)))))
    (> n 0) (<= n 64) (> carry 3) (<= carry (gn-g M gn-f-ns))
    (gn-dot-at? M p OP-FN f 3 (gn-g M gn-f-ns))
    (gn-dot-at? M i OP-FUEL 0 0 0) (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    (gn-dot-at? M (+ p 3) OP-LGET 0 3 0) (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0) (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    (gn-dot-at? M (+ p 7) OP-LGET 0 1 0) (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    (gn-dot-at? M tail OP-LSET carry 0 0)
    (gn-dot-at? M (+ tail 1) OP-LGET 0 carry 0) (gn-dot-at? M (+ tail 2) OP-LGET 1 2 0)
    (gn-dot-at? M (+ tail 3) OP-LGET 2 3 0) (gn-dot-at? M (+ tail 4) OP-CONST 3 1 0)
    (gn-dot-at? M (+ tail 5) OP-BIN BOP-ADD 2 0)
    (gn-dot-at? M (+ tail 6) OP-LSET 1 0 0) (gn-dot-at? M (+ tail 7) OP-LSET 2 1 0)
    (gn-dot-at? M (+ tail 8) OP-LSET 3 2 0) (gn-dot-at? M (+ tail 9) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ tail 10) OP-BR head 0 0) (gn-dot-at? M (+ tail 11) OP-LABEL exit 0 0)
    (gn-dot-at? M (+ tail 12) OP-RET 0 0 0)
    (= (gn-lpos M head) (+ p 2)) (= (gn-lpos M body) (+ p 9))
    (= (gn-lpos M exit) (+ tail 11)))
   (let [cost (bu-cost M (+ p 10) tail false 256)
         range (bu-range M (+ p 10) (+ p 10) tail 0)]
    (if (and (> cost 1) (<= cost 256) (> range 0))
     (+ range (* cost 65536)) 0)) 0))))
;; Snapshot all extra VI/DI facts as well as the original per-function banks.
(defn- bu-extra [M :vector-i64] :vector-i64
 (loop [B (vector-alloc 89) k 0]
  (if (= k 89) B (recur (vector-assoc! B k (gn-g M (+ gn-g-open k))) (inc k)))))
(defn- bu-restore-extra [M :vector-i64 B :vector-i64] :vector-i64
 (loop [current M k 0]
  (if (= k 89) current (recur (gn-gs current (+ gn-g-open k) (vector-at B k)) (inc k)))))
(defn- bu-expand [M :vector-i64 j :i64 end :i64] :vector-i64
 (if (= j end) M
  (let [current (gn-ins M j (gn-op M j)) skip (gn-g current gn-f-skip)]
   (bu-expand (gn-gs current gn-f-skip 0) (+ j 1 skip) end))))
;; ADR0357 bounded selector specialization and serial two-iteration loop lowering.
;; All structural authority before the inherited BU recognizer.
(defn- bsu-staged [M :vector-i64 i :i64] :bool
 (let [sn (vector-at M MM-SIR-N) fn (vector-at M MM-FN-N) ln (vector-at M MM-LABEL-N)
       cn (vector-at M MM-CODE-N) xn (vector-at M MM-FIX-N)]
  (and (> i 1) (> sn i) (<= sn MM-SIR-CAP) (> fn 1) (<= fn MM-FN-CAP)
    (> ln 0) (< ln (- MM-LABEL-CAP 16)) (> cn 0) (<= cn (- MM-CODE-CAP 196608))
    (> xn 0) (<= xn (- MM-FIX-CAP 1024)) (= (gn-op M (dec i)) OP-FN)
    (let [f (gn-sir M (dec i) IF-A)]
     (and (> f 0) (< f fn) (= (gn-fnf M f FF-SIR) (dec i))
       (> (gn-fnf M f FF-NSLOTS) 3) (<= (gn-fnf M f FF-NSLOTS) 7)
       (>= (gn-fnf M f FF-DEPTH) 4) (<= (gn-fnf M f FF-DEPTH) 7)
       (= (gn-g M gn-f-ns) (gn-fnf M f FF-NSLOTS))
       (= (gn-g M gn-f-dp) (gn-fnf M f FF-DEPTH))
       (loop [j (dec i) count 0]
        (and (< j sn) (< count 256)
         (if (= (gn-op M j) OP-END) (= (gn-sir M j IF-A) f)
          (and (or (= j (dec i)) (not= (gn-op M j) OP-FN))
           (if (= (gn-op M j) OP-LABEL)
            (let [l (gn-sir M j IF-A)] (and (> l 0) (< l ln) (= (gn-lpos M l) j))) true)
           (if (or (= (gn-op M j) OP-BR) (= (gn-op M j) OP-BRZ))
            (let [l (gn-sir M j (if (= (gn-op M j) OP-BR) IF-A IF-B))]
             (and (> l 0) (< l ln) (> (gn-lpos M l) (dec i)) (< (gn-lpos M l) sn))) true)
           (if (= (gn-op M j) OP-CALL)
            (let [callee (gn-sir M j IF-A)]
             (and (> callee 0) (< callee fn) (> (gn-fnf M callee FF-SIR) 0)
              (> (gn-small-end M (inc (gn-fnf M callee FF-SIR)) callee 128) 0))) true)
           (recur (inc j) (inc count)))))))))))
(defn- bsu-test [M :vector-i64 j :i64 tail :i64] :bool
 (and (< (+ j 3) tail) (gn-dot-at? M j OP-LGET 0 2 0)
  (= (gn-op M (inc j)) OP-CONST) (= (gn-sir M (inc j) IF-A) 1)
  (= (gn-sir M (inc j) IF-C) 0) (gn-dot-at? M (+ j 2) OP-CMP CC-EQ 0 0)
  (= (gn-op M (+ j 3)) OP-BRZ) (= (gn-sir M (+ j 3) IF-A) 0)
  (= (gn-sir M (+ j 3) IF-C) 0)))
(defn- bsu-shape [M :vector-i64 i :i64] :bool
 (let [p (dec i) end (gn-small-end M i (gn-sir M p IF-A) 256) tail (- end 13)]
  (and (> tail (+ p 10))
   (loop [j (+ p 10) tests 0 first 0]
    (if (= j tail) (= tests 2)
     (if (bsu-test M j tail)
      (and (< tests 2) (or (= tests 0) (not= first (gn-sir M (inc j) IF-B)))
       (recur (+ j 4) (inc tests) (if (= tests 0) (gn-sir M (inc j) IF-B) first)))
      (and (not= (gn-op M j) OP-BRZ) (recur (inc j) tests first))))))))
(defn- bsu-constant [M :vector-i64 j :i64 tail :i64 ordinal :i64] :i64
 (if (>= j tail) 0
  (if (bsu-test M j tail)
   (if (= ordinal 0) (gn-sir M (inc j) IF-B) (bsu-constant M (+ j 4) tail (dec ordinal)))
   (bsu-constant M (inc j) tail ordinal))))
;; Preserve exact resulting temporary values even if a future valid source uses them.
;; Branches/labels retain the original flush and context-cache invalidation policy.
(defn- bsu-path [M :vector-i64 j :i64 tail :i64 value :i64 other :bool work :i64] :vector-i64
 (if (= j tail) M
  (if (or (> j tail) (<= work 0)) (gn-err M E-GEN-OP OP-BR)
   (cond (bsu-test M j tail)
     (let [constant (gn-sir M (inc j) IF-B) equal (and (not other) (= value constant))
           target (gn-sir M (+ j 3) IF-B)
           m (-> M (gn-def 0 gn-k-const (if equal 1 0)) (gn-def 1 gn-k-const constant))]
      (if equal (bsu-path m (+ j 4) tail value other (dec work))
       (bsu-path (gn-jflush m (gn-g m gn-f-h) target) (inc (gn-lpos m target)) tail value other (dec work))))
    (= (gn-op M j) OP-BR)
     (let [target (gn-sir M j IF-A)]
      (bsu-path (gn-jflush M (gn-g M gn-f-h) target) (inc (gn-lpos M target)) tail value other (dec work)))
    :else (let [m (gn-ins M j (gn-op M j)) skip (gn-g m gn-f-skip)]
      (bsu-path (gn-gs m gn-f-skip 0) (+ j 1 skip) tail value other (dec work)))))))
(defn- bsu-iteration [M :vector-i64 p :i64 tail :i64 value :i64 other :bool] :vector-i64
 (let [m (bsu-path M (+ p 10) tail value other 256)
       next (bu-expand m tail (+ tail 10)) head (gn-sir M (+ p 2) IF-A)]
  (-> next (gn-jflush (gn-g next gn-f-h) head) (gn-allreg 0 (gn-g next gn-f-dp)))))
;; Four-lane low16 affine color arithmetic. Complete IR/helper shape,
;; inherited BU range/equal-cost/effect proof and scalar cold/remainder path.
(defn- ncv-word [kind :i64 k :i64] :i64
 (vector-at (case kind 0 (case (quot k 64) 0 [1688867040067585 18 4229300233 12884901892 281466386841603 65543 277141354709003 4294967300 4219666442 4228841481 4294967300 6597069832195 12885032964 4295032838 562949964955662 1095216726019 327686 262149 8589934596 65539 65543 277012505690123 4294967300 8796093087747 12885032964 4295032838 17180000260 844429085179917 9895604715523 12885032964 4295032838 17180000260 844429085179917 10995116343299 12885032964 4295032838 17180000260 844429085179917 4220452874 4226875401 8589934596 4295032835 65543 276793462358027 17179869188 377957187587 196614 1099511693315 262150 188978626563 131078 281479133462541 327685 17179869188 17179934724 850403655683 4295163910 1099511758851 4295229446 65542 974957641731 131078 281479133462541 393221] 1 [4294967300 9895604715523 12885032964 4295032838 4295098372 9895604846595 12885164036 12884967430 562958554890254 21475033092 8590065670 281487721758733 844429085179917 10995116343299 12885032964 4295032838 4295098372 10995116474371 12885164036 12884967430 562958554890254 25770000388 8590000134 281487721758733 844429085179917 4220518410 4223533065 17179869188 17179934724 442381762563 4295163910 1099511758851 4295229446 65542 768799211523 131078 281479133462541 327685 17179869188 785979080707 196614 1099511693315 262150 390842089475 131078 281479133462541 393221 4294967300 8796093087747 12885032964 4295032838 4295098372 8796093218819 12885164036 12884967430 562958554890254 21475033092 8590000134 281487721758733 844429085179917 9895604715523 12885032964 4295032838 4295098372] 2 [9895604846595 12885164036 12884967430 562958554890254 25770000388 8590065670 281487721758733 844429085179917 4220518409 4220452873 327685 21474836484 8590000132 12885032964 4295163907 8590000134 65541 4295098373 8590131205 18 4229300234 4219666441 19 4294901762] []) 1 [844442109935617 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294901762] 2 [844442109935617 18 4229300233 4294967300 8590000132 12885032964 1095216857091 8590262278 844429093502989 19 4294901762] 3 [562958543290369 4229365769 4294967300 281457796907011 327686 131077 8589934596 281453501939715 327687 277119879872523 8589934596 281462091874307 131078 4228382730 4228513801 8589934596 4228382729 19 4294901762] 4 [562958543290369 18 4229300233 4294967300 281479140343821 131077 8589934596 65539 131079 277128469807115 3 4227989514 4228644873 8589934596 1095216726019 196615 277098405036043 1095216660483 4228055050 4228186121 8589934596 4228055049 4227989513 19 4294901762] []) (bit-and k 63)))
(defn- ncv-val [M :vector-i64 p :i64 f :i64 x :i64] :i64
 (cond (<= x -2000) (gn-sir M (+ p (- (- 0 x) 2000)) IF-A)
       (<= x -1000) (gn-sir M (+ p (- (- 0 x) 1000)) IF-A)
       (= x -1) f (= x -2) (gn-sir M (+ p 4) IF-B) (= x -3) 65536 (= x -4) 65535 (= x -5) 32768 :else x))
(defn- ncv-match [M :vector-i64 p :i64 f :i64 kind :i64 k :i64] :bool
 (let [n (case kind 0 152 1 9 2 11 3 19 25)]
  (if (= k n) true
   (let [w (ncv-word kind k) a (mp-sign (bit-and (u64-shift-right w 16) 65535) 16)
         b (mp-sign (bit-and (u64-shift-right w 32) 65535) 16)
         c (bit-and (u64-shift-right w 48) 65535) op (bit-and w 65535)
         label (gn-sir M (+ p k) IF-A)]
    (and (gn-dot-at? M (+ p k) op (ncv-val M p f a) (ncv-val M p f b) c)
     (or (not= op OP-LABEL) (and (> label 0) (< label (vector-at M MM-LABEL-N)) (= (gn-lpos M label) (+ p k))))
     (ncv-match M p f kind (inc k)))))))
(defn- ncv-helper [M :vector-i64 f :i64 kind :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (= (gn-fnf M f FF-NPARAMS) (if (< kind 3) 3 1))
  (= (gn-fnf M f FF-NSLOTS) (if (< kind 3) 3 2))
  (= (gn-fnf M f FF-DEPTH) (case kind 1 3 2 4 2))
  (= (gn-fnf M f FF-RTYPE) (if (< kind 3) TY-VEC TY-I64))
  (= (ck-pt M f 0) (if (< kind 3) TY-VEC TY-I64))
  (or (>= kind 3) (and (= (ck-pt M f 1) TY-I64) (= (ck-pt M f 2) TY-I64)))
  (let [p (gn-fnf M f FF-SIR) n (case kind 1 9 2 11 3 19 25)]
   (and (> p 0) (<= (+ p n) (vector-at M MM-SIR-N)) (ncv-match M p f kind 0)))))
(defn- ncv-admit [M :vector-i64 p :i64 end :i64 n :i64] :bool
 (and (>= n 4) (<= n 64) (= (- end p) 151)
  (let [f (gn-sir M p IF-A) writer (gn-sir M (+ p 27) IF-A)
        sign (gn-sir M (+ p 51) IF-A) clamp (gn-sir M (+ p 75) IF-A)]
   (and (> f 0) (< f (vector-at M MM-FN-N)) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-NSLOTS) 6) (= (gn-fnf M f FF-DEPTH) 5)
    (= (gn-g M gn-f-freg) 3) (= (gn-g M gn-f-vmode) 4)
    (= (gn-sir M (+ p 19) IF-B) 0) (= (gn-sir M (+ p 41) IF-B) 1)
    (ncv-match M p f 0 0) (ncv-helper M writer 2)
    (ncv-helper M (gn-sir M (+ (gn-fnf M writer FF-SIR) 8) IF-A) 1)
    (ncv-helper M sign 3) (ncv-helper M clamp 4)
    (= (gn-sir M (+ (gn-fnf M clamp FF-SIR) 4) IF-A) sign)))))
(defn- ncv-body-words [kind :i64] :vector-i64
 (case kind 0 [1036779808 1036780833 1317083136 241248256 789034976 789619712 790668289 1032847649 1864410112 1032848672 1032978721 1032979744 1033109793 1033110816] 1 [1036779808 1036780833 1317083136 241248256 789034976 251823873 241277953 790103073 252085442 241343490 1037173027 1037174052 1317279843 241248355 778142817 251757955 241402913 1862329347 241394721 788719268 241462305 789619745 790668325 1032978725 1864410145 1032979745 1037304097 1037305125 1317345313 241248289 790107200 789021762 241337377 241271808 241394688 241462272 789619712 790668289 1033109793 1864410112 1033110816] 2 [1036779808 1036780833 1317083136 241248256 789034976 251888865 241277953 252020450 241343490 790103106 1037041955 1037042980 1317279843 241248355 790107168 788891201 241271905 241271808 1862329345 241263616 788719267 241396736 789619712 790668292 1032847652 1864410112 1032848672 1037173024 1037174052 1317279744 241248256 778208256 251823970 241337344 241263616 241396736 789619712 790668289 1032978721 1864410112 1032979744] []))
(defn- ncv-body [M :vector-i64 kind :i64 ri :i64] :vector-i64
 (let [V (ncv-body-words kind) m (gn-emit M (gn-e-addsl 9 4 ri 3))
       emitted (loop [cur m k 0] (if (= k (vector-count V)) cur
        (recur (gn-emit cur (vector-at V k)) (inc k))))]
  (gn-emit emitted (enc-add-i ri ri 4))))
(defn- ncv-loop [M :vector-i64 p :i64 end :i64 n :i64 value :i64 other :bool] :vector-i64
 (let [tail (- end 13) ri (gn-sreg M 3) head (gn-sir M (+ p 2) IF-A)
       kind (if other 2 (if (= value 0) 0 1))
       m0 (gn-op-label M head) loop-at (vector-at m0 MM-CODE-N)
       m1 (gn-emit m0 (enc-cmp-i ri (- n 3))) b0 (vector-at m1 MM-CODE-N)
       m2 (gn-emit m1 (enc-bcond (enc-cond-hs) 0))
       m3 (ncv-body m2 kind ri) back (vector-at m3 MM-CODE-N)
       m4 (gn-emit m3 (enc-b (- loop-at back))) remainder (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-allreg 0 (gn-g m4 gn-f-dp)) (gn-dot-patch b0 remainder (enc-cond-hs)) (gn-emit (enc-cmp-i ri n)))
       b1 (vector-at m5 MM-CODE-N) m6 (gn-emit m5 (enc-bcond (enc-cond-hs) 0))
       m7 (bsu-iteration m6 p tail value other) last (vector-at m7 MM-CODE-N)
       m8 (gn-emit m7 (enc-b (- remainder last))) finish (vector-at m8 MM-CODE-N)
       m9 (-> m8 (gn-dot-patch b1 finish (enc-cond-hs)) (gn-def 0 gn-k-local 1))]
  (bu-expand m9 (+ tail 11) end)))

;; Repeat loop test only after TWO ordered iterations, with one final iteration remainder.
(defn- bsu-loop [M :vector-i64 p :i64 end :i64 n :i64 value :i64 other :bool] :vector-i64
 (if (ncv-admit M p end n) (ncv-loop M p end n value other)
 (let [tail (- end 13) ri (gn-sreg M 3) head (gn-sir M (+ p 2) IF-A)
       m0 (gn-op-label M head) loop-at (vector-at m0 MM-CODE-N)
       m1 (gn-emit m0 (enc-cmp-i ri (dec n))) b0 (vector-at m1 MM-CODE-N)
       m2 (gn-emit m1 (enc-bcond (enc-cond-hs) 0))
       m3 (bsu-iteration m2 p tail value other)
       m4 (bsu-iteration m3 p tail value other) at (vector-at m4 MM-CODE-N)
       m5 (gn-emit m4 (enc-b (- loop-at at))) remainder (vector-at m5 MM-CODE-N)
       m6 (-> m5 (gn-dot-patch b0 remainder (enc-cond-hs)) (gn-emit (enc-cmp-i ri n)))
       b1 (vector-at m6 MM-CODE-N) m7 (gn-emit m6 (enc-bcond (enc-cond-hs) 0))
       m8 (bsu-iteration m7 p tail value other) finish (vector-at m8 MM-CODE-N)
       m9 (-> m8 (gn-dot-patch b1 finish (enc-cond-hs)) (gn-def 0 gn-k-local 1))]
  (bu-expand m9 (+ tail 11) end))))
(defn- bsu-variants [M :vector-i64 p :i64 end :i64 n :i64] :vector-i64
 (let [tail (- end 13) selector (gn-sreg M 2)
       k0 (bsu-constant M (+ p 10) tail 0) k1 (bsu-constant M (+ p 10) tail 1)
       B (gp-save-state M) E (bu-extra M)
       m0 (-> M (gn-mov-imm 16 k0) (gn-emit (enc-cmp-r selector 16))) b0 (vector-at m0 MM-CODE-N)
       m1 (gn-emit m0 (enc-bcond (enc-cond-ne) 0))
       m2 (bsu-loop m1 p end n k0 false) next (vector-at m2 MM-CODE-N)
       m3 (-> (bu-restore-extra (gp-restore m2 B) E) (gn-dot-patch b0 next (enc-cond-ne))
              (gn-mov-imm 16 k1) (gn-emit (enc-cmp-r selector 16))) b1 (vector-at m3 MM-CODE-N)
       m4 (gn-emit m3 (enc-bcond (enc-cond-ne) 0))
       m5 (bsu-loop m4 p end n k1 false) last (vector-at m5 MM-CODE-N)
       m6 (-> (bu-restore-extra (gp-restore m5 B) E) (gn-dot-patch b1 last (enc-cond-ne)))]
  (bsu-loop m6 p end n 0 true)))
(defn- bsu-entry [M :vector-i64 i :i64] :vector-i64
 (let [basic (bsu-staged M i) proof (if basic (bu-admit M i) 0)]
  (if (or (= proof 0) (not (bsu-shape M i))) M
  (let [p (dec i) f (gn-sir M p IF-A) end-sir (gn-small-end M (inc p) f 256)
        n (gn-sir M (+ p 4) IF-B) bound (+ n (dec (bit-and proof 65535)))
        cost (u64-shift-right proof 16) rv (gn-sreg M 1) ri (gn-sreg M 3)
        B (gp-save-state M) E (bu-extra M) xf (vector-at M MM-FIX-N)
        m0 (gn-emit M (enc-cmp-i ri n)) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 n)
              (gn-emit (enc-sub-r 6 16 ri)) (gn-mov-imm 16 cost)
              (gn-emit (enc-mul 9 6 16)) (gn-emit (enc-ldr 16 7 CTX-FUEL))
              (gn-emit (enc-cmp-r 16 9))) b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
              (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
              (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
              (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 3 16 0))
              (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 3 16))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 17 16))) b4 (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 bound)
              (gn-emit (enc-cmp-r 3 16))) b5 (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 4 7 328))
              (gn-emit (gn-e-addsl 4 4 17 3)) (gn-emit (enc-ldr 16 7 CTX-FUEL))
              (gn-emit (enc-sub-r 8 16 9)) (gn-emit (enc-str 8 7 CTX-FUEL))
              (gn-gs gn-f-freg 3) (gn-gs gn-f-vmode 4) (gn-gs gn-f-vslot 0))
        m7 (bsu-variants m6 p end-sir n) end (vector-at m7 MM-CODE-N)
        m8 (loop [current m7 k xf]
          (if (>= k (vector-at m7 MM-FIX-N)) current
           (let [at (sf-x current k XF-AT) target (sf-x current k XF-TARGET)
                 to (vector-at current (+ MM-LABEL-BASE target))]
            (recur (gn-put current (+ MM-CODE-BASE at)
               (of-patch-word (sf-word current at) (- to at))) (inc k)))))
        m9 (-> m8 (gn-dot-patch b0 end (enc-cond-hs)) (gn-dot-patch b1 end (enc-cond-lo))
              (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
              (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-lo))
              (gn-put MM-FIX-N xf))]
   (bu-restore-extra (gp-restore m9 B) E)))))
(defn- bu-entry [M :vector-i64 i :i64] :vector-i64
 (if (and (bsu-staged M i) (> (bu-admit M i) 0) (bsu-shape M i)) (bsu-entry M i)
 (let [proof (bu-admit M i)]
  (if (= proof 0) M
  (let [p (dec i) f (gn-sir M p IF-A) end-sir (gn-small-end M (inc p) f 256)
        n (gn-sir M (+ p 4) IF-B) bound (+ n (dec (bit-and proof 65535)))
        cost (u64-shift-right proof 16) rv (gn-sreg M 1) ri (gn-sreg M 3)
        B (gp-save-state M) E (bu-extra M) xf (vector-at M MM-FIX-N)
        m0 (gn-emit M (enc-cmp-i ri n)) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 n)
              (gn-emit (enc-sub-r 6 16 ri)) (gn-mov-imm 16 cost)
              (gn-emit (enc-mul 9 6 16)) (gn-emit (enc-ldr 16 7 CTX-FUEL))
              (gn-emit (enc-cmp-r 16 9))) b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
              (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
              (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
              (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 3 16 0))
              (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 3 16))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 17 16))) b4 (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 bound)
              (gn-emit (enc-cmp-r 3 16))) b5 (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 4 7 328))
              (gn-emit (gn-e-addsl 4 4 17 3)) (gn-emit (enc-ldr 16 7 CTX-FUEL))
              (gn-emit (enc-sub-r 8 16 9)) (gn-emit (enc-str 8 7 CTX-FUEL))
              (gn-gs gn-f-freg 3) (gn-gs gn-f-vmode 4) (gn-gs gn-f-vslot 0))
        m7 (bu-expand m6 (+ p 2) end-sir) end (vector-at m7 MM-CODE-N)
        m8 (loop [current m7 k xf]
          (if (>= k (vector-at m7 MM-FIX-N)) current
           (let [at (sf-x current k XF-AT) target (sf-x current k XF-TARGET)
                 to (vector-at current (+ MM-LABEL-BASE target))]
            (recur (gn-put current (+ MM-CODE-BASE at)
               (of-patch-word (sf-word current at) (- to at))) (inc k)))))
        m9 (-> m8 (gn-dot-patch b0 end (enc-cond-hs)) (gn-dot-patch b1 end (enc-cond-lo))
              (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
              (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-lo))
              (gn-put MM-FIX-N xf))]
   (bu-restore-extra (gp-restore m9 B) E))))))
;; Exact pure local threshold scan; bounded speculative reads commit only on success.
(defn- ts-shape [M :vector-i64 p :i64 k :i64] :bool
 (let [h (gn-sir M p IF-A) v (gn-sir M (+ p 1) IF-B)
       n (gn-sir M (+ p 2) IF-B) s (gn-sir M (+ p 3) IF-B)
       t (gn-sir M (+ p 6) IF-B) e (gn-sir M (+ p 8) IF-B)]
  (if (= k 23) true
   (and (case k
    0 (gn-dot-at? M p OP-LABEL h 0 0)
    1 (gn-dot-at? M (+ p 1) OP-LGET 0 v 0)
    2 (gn-dot-at? M (+ p 2) OP-CONST 1 n 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 2 s 0)
    4 (gn-dot-at? M (+ p 4) OP-BIN BOP-ADD 1 0)
    5 (gn-dot-at? M (+ p 5) OP-RT RT-VECTOR-AT 0 2)
    6 (gn-dot-at? M (+ p 6) OP-LGET 1 t 0)
    7 (gn-dot-at? M (+ p 7) OP-CMP CC-LT 0 0)
    8 (gn-dot-at? M (+ p 8) OP-BRZ 0 e 0)
    9 (gn-dot-at? M (+ p 9) OP-LGET 0 s 0)
    10 (gn-dot-at? M (+ p 10) OP-CONST 1 1 0)
    11 (gn-dot-at? M (+ p 11) OP-BIN BOP-ADD 0 0)
    12 (gn-dot-at? M (+ p 12) OP-LSET s 0 0)
    13 (gn-dot-at? M (+ p 13) OP-FUEL 0 0 0)
    14 (gn-dot-at? M (+ p 14) OP-BR h 0 0)
    15 (gn-dot-at? M (+ p 15) OP-BR (gn-sir M (+ p 18) IF-A) 0 0)
    16 (gn-dot-at? M (+ p 16) OP-LABEL e 0 0)
    17 (gn-dot-at? M (+ p 17) OP-LGET 0 s 0)
    18 (gn-dot-at? M (+ p 18) OP-LABEL (gn-sir M (+ p 15) IF-A) 0 0)
    19 (gn-dot-at? M (+ p 19) OP-LSET s 0 0)
    20 (gn-dot-at? M (+ p 20) OP-LGET 0 v 0)
    21 (gn-dot-at? M (+ p 21) OP-CONST 1 (gn-sir M (+ p 21) IF-B) 0)
    22 (gn-dot-at? M (+ p 22) OP-LGET 2 s 0)
    false) (ts-shape M p (inc k))))))
(defn- ts-closed [M :vector-i64 j :i64 f :i64] :bool
 (if (>= j (vector-at M MM-SIR-N)) false
  (cond (= (gn-op M j) OP-END) (= (gn-sir M j IF-A) f)
        (= (gn-op M j) OP-TAB) false
        :else (ts-closed M (inc j) f))))
(defn- ts-admit [M :vector-i64 p :i64] :bool
 (let [o (jt-owner M p 4096) f (if (> o 0) (gn-sir M o IF-A) 0)
       s (gn-sir M (+ p 3) IF-B) t (gn-sir M (+ p 6) IF-B)
       h (gn-sir M p IF-A) e (gn-sir M (+ p 8) IF-B) z (gn-sir M (+ p 18) IF-A)]
  (and (> p 0) (< (+ p 22) (vector-at M MM-SIR-N)) (> f 0) (< f (vector-at M MM-FN-N))
    (not (gn-clamp-open M f)) (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
    (= (gn-g M gn-f-vmode) 0) (<= (gn-g M gn-f-h) 3) (= (gn-g M gn-f-skip) 0)
    (>= (gn-g M gn-f-dp) 3) (= (gn-sir M (+ p 1) IF-B) 1) (= (gn-sreg M 1) 0)
    (= (gn-fnf M f FF-PT0) TY-VEC) (> s 1) (<= s (gn-g M gn-f-ns))
    (> t 1) (<= t (gn-g M gn-f-ns)) (not= s t)
    (>= (gn-sir M (+ p 2) IF-B) 0) (<= (gn-sir M (+ p 2) IF-B) 4095)
    (> h 0) (< h MM-LABEL-CAP) (> e 0) (< e MM-LABEL-CAP) (> z 0) (< z MM-LABEL-CAP)
    (not= h e) (not= h z) (not= e z)
    (= (gn-lpos M h) p) (= (gn-lpos M e) (+ p 16)) (= (gn-lpos M z) (+ p 18))
    (ts-closed M (inc o) f) (btg-edges M o f h 0) (btg-edges M o f e 0)
    (btg-edges M o f z 0) (ts-shape M p 0)
    (let [sr (gn-sreg M s) tr (gn-sreg M t)]
      (and (>= sr 19) (<= sr 28) (>= tr 19) (<= tr 28) (not= sr tr))))))
(defn- ts-entry [M :vector-i64 p :i64] :vector-i64
 (if (not (ts-admit M p)) M
  (let [sr (gn-sreg M (gn-sir M (+ p 3) IF-B)) tr (gn-sreg M (gn-sir M (+ p 6) IF-B))
        n (gn-sir M (+ p 2) IF-B) e (gn-sir M (+ p 8) IF-B)
        m0 (-> M (gn-ctx) (gn-emit (enc-cmp-i 8 64))) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0))
         (gn-mov-imm 11 1152921504606846976) (gn-emit (enc-cmp-r sr 11))) b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0))
         (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
         (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
         (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
         (gn-emit (enc-ldp 17 11 16 0)) (gn-mov-imm 10 (+ n 63))
         (gn-emit (enc-add-r 10 sr 10)) (gn-emit (enc-cmp-r 10 11))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
         (gn-emit (enc-add-i 9 sr n)) (gn-emit (enc-add-r 17 17 9))
         (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 16 16 17 3))
         (gn-mov 9 sr) (gn-mov-imm 10 64)) head (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (enc-ldr 11 16 0)) (gn-emit (enc-cmp-r 11 tr))) found (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-bcond (enc-cond-of-cc CC-GE) 0))
         (gn-emit (enc-add-i 9 9 1)) (gn-emit (enc-add-i 16 16 8))
         (gn-emit (enc-subs-i 10 10 1))) back (vector-at m6 MM-CODE-N)
        m7 (gn-emit m6 (enc-bcond (enc-cond-ne) (- head back))) failed (vector-at m7 MM-CODE-N)
        m8 (gn-emit m7 (enc-b 0)) success (vector-at m8 MM-CODE-N)
        m9 (-> m8 (gn-emit (enc-sub-r 11 9 sr)) (gn-emit (enc-sub-r 8 8 11))
         (gn-mov sr 9) (gn-fix FX-B26 e) (gn-emit (enc-b 0))) end (vector-at m9 MM-CODE-N)]
   (-> m9 (gn-dot-patch b0 end (enc-cond-lo)) (gn-dot-patch b1 end (enc-cond-hs))
    (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
    (gn-dot-patch found success (enc-cond-of-cc CC-GE))
    (gn-put (+ MM-CODE-BASE failed) (enc-b (- end failed)))))))

(defn- bs-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [h (gn-sir M (+ p 2) IF-A) b (gn-sir M (+ p 6) IF-B)
       x (gn-sir M (+ p 8) IF-A) z (gn-sir M (+ p 19) IF-B)
       n (gn-sir M (+ p 4) IF-B)]
  (if (= k 36) true
   (and (case k
    0 (gn-dot-at? M p OP-FN f 4 4)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL h 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 b 0)
    7 (gn-dot-at? M (+ p 7) OP-CONST 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-BR x 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL b 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
    13 (gn-dot-at? M (+ p 13) OP-LGET 3 4 0)
    14 (gn-dot-at? M (+ p 14) OP-BIN BOP-MUL 2 0)
    15 (gn-dot-at? M (+ p 15) OP-BIN BOP-ADD 1 0)
    16 (gn-dot-at? M (+ p 16) OP-RT RT-VECTOR-AT 0 2)
    17 (gn-dot-at? M (+ p 17) OP-CONST 1 0 0)
    18 (gn-dot-at? M (+ p 18) OP-CMP CC-EQ 0 0)
    19 (gn-dot-at? M (+ p 19) OP-BRZ 0 z 0)
    20 (gn-dot-at? M (+ p 20) OP-LGET 0 1 0)
    21 (gn-dot-at? M (+ p 21) OP-LGET 1 2 0)
    22 (gn-dot-at? M (+ p 22) OP-LGET 2 3 0)
    23 (gn-dot-at? M (+ p 23) OP-LGET 3 4 0)
    24 (gn-dot-at? M (+ p 24) OP-CONST 4 1 0)
    25 (gn-dot-at? M (+ p 25) OP-BIN BOP-ADD 3 0)
    26 (gn-dot-at? M (+ p 26) OP-LSET 1 0 0)
    27 (gn-dot-at? M (+ p 27) OP-LSET 2 1 0)
    28 (gn-dot-at? M (+ p 28) OP-LSET 3 2 0)
    29 (gn-dot-at? M (+ p 29) OP-LSET 4 3 0)
    30 (gn-dot-at? M (+ p 30) OP-FUEL 0 0 0)
    31 (gn-dot-at? M (+ p 31) OP-BR h 0 0)
    32 (gn-dot-at? M (+ p 32) OP-LABEL z 0 0)
    33 (gn-dot-at? M (+ p 33) OP-LABEL x 0 0)
    34 (gn-dot-at? M (+ p 34) OP-RET 0 0 0)
    35 (gn-dot-at? M (+ p 35) OP-END f 0 0)
    false) (bs-shape M p f (inc k))))))
(defn- bs-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 35) (vector-at M MM-SIR-N))
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 4)
       (= (gn-fnf M f FF-NSLOTS) 4) (= (gn-fnf M f FF-DEPTH) 5)
       (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
       (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
       (= (gn-fnf M f FF-RTYPE) TY-BOOL)
       (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
       (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
       (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2) (= (gn-sreg M 4) 3)
       (> (gn-sir M (+ p 4) IF-B) 0) (<= (gn-sir M (+ p 4) IF-B) 64)
       (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))
       (= (gn-lpos M (gn-sir M (+ p 6) IF-B)) (+ p 9))
       (= (gn-lpos M (gn-sir M (+ p 19) IF-B)) (+ p 32))
       (= (gn-lpos M (gn-sir M (+ p 8) IF-A)) (+ p 33))
       (btg-edges M p f (gn-sir M (+ p 2) IF-A) 0)
       (btg-edges M p f (gn-sir M (+ p 6) IF-B) 0)
       (btg-edges M p f (gn-sir M (+ p 19) IF-B) 0)
       (btg-edges M p f (gn-sir M (+ p 8) IF-A) 0)
       (bs-shape M p f 0))))
(defn- bs-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (bs-admit M i)) M
  (let [n (gn-sir M (+ (dec i) 4) IF-B)
        m0 (gn-emit M (enc-cmp-i 3 n)) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 n)
