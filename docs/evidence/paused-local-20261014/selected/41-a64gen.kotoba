                   (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 4 16))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 1 16))) b4 (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 18014398509481984)
                   (gn-emit (enc-cmp-r 2 16))) b5 (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 (dec n))
                   (gn-emit (enc-madd 9 2 16 1)) (gn-emit (enc-cmp-r 9 4))) b6 (vector-at m6 MM-CODE-N)
        m7 (-> m6 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 4 7 328))
                   (gn-emit (gn-e-addsl 4 4 17 3)) (gn-emit (enc-madd 16 2 3 1))
                   (gn-emit (gn-e-addsl 4 4 16 3)) (gn-emit (gn-e-addsl 5 31 2 3))
                   (gn-mov 10 6)) head (vector-at m7 MM-CODE-N)
        m8 (gn-emit m7 (enc-ldr 9 4 0)) bf (vector-at m8 MM-CODE-N)
        m9 (-> m8 (gn-emit (enc-cbnz 9 0)) (gn-emit (enc-add-r 4 4 5))
                   (gn-emit (enc-subs-i 6 6 1))) back (vector-at m9 MM-CODE-N)
        m10 (-> m9 (gn-emit (enc-bcond (enc-cond-ne) (- head back))) (gn-mov-imm 9 1)) bd (vector-at m10 MM-CODE-N)
        m11 (gn-emit m10 (enc-b 0)) failed (vector-at m11 MM-CODE-N)
        m12 (gn-mov-imm m11 9 0) done (vector-at m12 MM-CODE-N)
        m13 (-> m12 (gn-emit (enc-sub-r 10 10 6)) (gn-emit (enc-sub-r 8 8 10))
                    (gn-mov 0 9) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at m13 MM-CODE-N)]
   (-> m13 (gn-dot-patch b0 end (enc-cond-hs)) (gn-dot-patch b1 end (enc-cond-lo))
           (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
           (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-hs))
           (gn-dot-patch b6 end (enc-cond-hs))
           (gn-put (+ MM-CODE-BASE bf) (enc-cbnz 9 (- failed bf)))
           (gn-put (+ MM-CODE-BASE bd) (enc-b (- done bd)))))))

;; Guarded exact closed forward-copy leaf; original fallback and fuel remain.
;; General closed two-accumulator stride-two literal/vector dot recurrence.
;; Original entry paid before this hook. All guards preserve original fallback;
;; successful prepayment covers two closed table entries and one backedge per step.
(defn- d2-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
