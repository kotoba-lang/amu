  m2 (gn-emit m1 (enc-bcond 0 0)) inner (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-ldr 13 10 0)) (gn-emit (enc-ldr 14 11 0))
   (gn-emit (enc-mul 16 13 14)) (gn-emit (enc-sub-r 9 9 16))
