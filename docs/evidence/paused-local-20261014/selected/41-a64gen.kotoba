  2 (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (gn-dot-at? M (+ p 3) 4 0 3 0)
  4 (gn-dot-at? M (+ p 4) 3 1 n 0)
  5 (gn-dot-at? M (+ p 5) 7 1 0 0)
  6 (gn-dot-at? M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
  7 (gn-dot-at? M (+ p 7) 4 0 1 0)
  8 (gn-dot-at? M (+ p 8) 10 (gn-sir M (+ p 44) IF-A) 0 0)
  9 (gn-dot-at? M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (gn-dot-at? M (+ p 10) 4 0 1 0)
