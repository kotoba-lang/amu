  (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 104)) (not= (gn-op M p) OP-FN)
   (not= (gn-g M gn-f-ns) 8) (not= (gn-g M gn-f-dp) 6) (not= (gn-g M gn-f-nsv) 8)
   (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
   (not (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1)))
   (not= (gn-g M gn-f-h) 0) (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-dead) 0)
   (<= (gn-g M gn-f-fb) 0) (> (gn-g M gn-f-fb) 32768)) 0
