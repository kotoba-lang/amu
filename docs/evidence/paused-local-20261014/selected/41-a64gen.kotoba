(defn- qrow-closed [M :vector-i64 f :i64 np :i64 ns :i64 dp :i64 count :i64 rt :i64 first :i64 kind :i64] :i64
 (let [p (qrow-fn M f np ns dp count rt first)]
  (if (and (> p 0) (qrow-labels M p count 0)
    (qrow-match M p f (qrow-helper-pattern kind (* count 4)) 0)) p 0)))
(defn- qrow-admit [M :vector-i64 i :i64] :i64
 (if (or (not (qrow-counts M)) (<= i 1) (>= i (vector-at M MM-SIR-N))
  (not= (gn-g M gn-f-dead) 0) (not= (gn-g M gn-f-skip) 0)
  (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
  (not= (gn-g M gn-f-h) 0) (not= (gn-g M gn-f-ns) 5) (not= (gn-g M gn-f-dp) 5)
  (not= (gn-g M gn-f-out) 0) (not= (gn-g M gn-f-fb) 144) (not= (gn-g M gn-f-nsv) 5)
  (not (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1)))
  (<= (vector-at M MM-CODE-N) 0) (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 4096))) 0
  (let [p (dec i)] (if (or (not= (gn-op M p) OP-FN) (> p (- (vector-at M MM-SIR-N) 63))) 0
   (let [f (gn-sir M p IF-A) pf (gn-sir M (+ p 13) IF-A) rf (gn-sir M (+ p 18) IF-A)
    wf (gn-sir M (+ p 40) IF-A) sf (gn-sir M (+ p 39) IF-A) put (gn-sir M (+ p 42) IF-A)]
    (if (or (not= (qrow-fn M f 4 5 5 63 TY-VEC TY-VEC) p)
      (not (qrow-match M p f (qrow-row-pattern) 0)) (not (qrow-labels M p 63 0))) 0
     (let [pp (qrow-fn M pf 3 7 3 155 TY-BOOL TY-I64)
      rp (qrow-closed M rf 3 6 4 50 TY-BOOL TY-VEC 3)
      wp (qrow-closed M wf 1 1 2 61 TY-I64 TY-I64 4)
      up (qrow-closed M put 3 3 4 11 TY-VEC TY-VEC 5)
      sp (qrow-fn M sf 2 2 4 11 TY-I64 TY-I64)]
      (if (and (> pp 0) (> rp 0) (> wp 0) (> up 0) (> sp 0)
       (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M pf FF-FUEL) 1)
       (= (gn-fnf M rf FF-FUEL) 1) (= (gn-fnf M put FF-FUEL) 1)
       (= (gn-fnf M sf FF-FUEL) 0) (= (gn-fnf M wf FF-FUEL) 0)
       (qrow-rem-calls M pp sf 0) (qrow-match M pp pf (qrow-predicate-pattern) 0)
       (qrow-labels M pp 155 0) (qrow-match M sp sf (qrow-rem-pattern) 0)
       (qrow-labels M sp 11 0)
       (= (gn-sir M (+ rp 42) IF-A) sf) (= (gn-sir M (+ rp 43) IF-A) wf)
       (>= (gn-sir M (+ p 4) IF-B) 1) (<= (gn-sir M (+ p 4) IF-B) 4096)
       (>= (gn-sir M (+ p 22) IF-B) 0) (<= (gn-sir M (+ p 22) IF-B) 65535)
       (= (gn-sir M (+ p 24) IF-B) 8)
       (>= (gn-sir M (+ p 28) IF-B) 0) (<= (gn-sir M (+ p 28) IF-B) 4096)
       (= (gn-sir M (+ p 38) IF-B) 8) (= (gn-sir M (+ p 51) IF-B) 1)
       (>= (gn-sir M (+ rp 34) IF-B) 0) (<= (gn-sir M (+ rp 34) IF-B) 65535)
       (loop [j 1] (or (= j 6) (and (>= (gn-sreg M j) 19) (<= (gn-sreg M j) 23)
        (loop [k 1] (or (= k j) (and (not= (gn-sreg M j) (gn-sreg M k)) (recur (inc k))))) (recur (inc j)))))) p 0))))))))

;; Guard comparison-only. Host-issued x7 pointers are the authority for readability.
(defn- qrow-preflight [M :vector-i64 P :vector-i64 p :i64] :vector-i64
 (let [l (gn-sir M (+ p 4) IF-B) ro (gn-sir M (+ (gn-fnf M (gn-sir M (+ p 18) IF-A) FF-SIR) 34) IF-B)
  io (gn-sir M (+ p 22) IF-B) stride (gn-sir M (+ p 28) IF-B)
  xmax (gn-sreg M 3) y (gn-sreg M 4) vmax (gn-sreg M 1)
  ri (+ ro (quot (+ (quot (+ (* l l) l) 2) l) 8))
  ii (+ io (quot (dec l) 8) (* l stride)) maxidx (if (> ri ii) ri ii)]
  (-> M (gn-mov-imm 17 l) (gn-emit (enc-cmp-r xmax 17)) (qrow-guard P 0 (enc-cond-hs))
   (gn-emit (enc-cmp-r y 17)) (qrow-guard P 1 8)
   (gn-emit (enc-sub-r 9 17 xmax)) (gn-emit (gn-e-addsl 9 31 9 2))
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9)) (qrow-guard P 2 (enc-cond-lo))
   (gn-mov 5 7) (gn-mov-imm 17 -400) (gn-emit (enc-cmp-r 5 17)) (qrow-guard P 3 (enc-cond-hs))
   (gn-emit (enc-add-i 6 5 400)) (gn-emit (enc-ldr 9 7 0)) (gn-emit (enc-cmp-i 9 11)) (qrow-guard P 4 (enc-cond-ne))
   (gn-emit (enc-ldr 3 7 328)) (gn-mov-imm 17 -1073741824) (gn-emit (enc-cmp-r 3 17)) (qrow-guard P 5 (enc-cond-hs))
   (gn-mov-imm 17 1073741824) (gn-emit (enc-add-r 4 3 17)) (qrow-disjoint P 6)
   (gn-emit (enc-ldr 5 7 312)) (gn-mov-imm 17 -8) (gn-emit (enc-cmp-r 5 17)) (qrow-guard P 7 (enc-cond-hs))
   (gn-emit (enc-add-i 6 5 8)) (qrow-disjoint P 8)
   (gn-emit (enc-ldr 9 5 0)) (gn-mov-imm 17 4194305) (gn-emit (enc-cmp-r 9 17)) (qrow-guard P 9 (enc-cond-hs))
   (gn-emit (enc-sub-i 10 vmax 1)) (gn-emit (enc-cmp-r 10 9)) (qrow-guard P 10 (enc-cond-hs))
   (gn-emit (enc-ldr 5 7 320)) (gn-emit (gn-e-addsl 16 31 9 4)) (gn-emit (enc-sub-r 17 31 16))
   (gn-emit (enc-cmp-r 5 17)) (qrow-guard P 11 (enc-cond-hs))
   (gn-emit (enc-add-r 6 5 16)) (qrow-disjoint P 12)
   (gn-emit (gn-e-addsl 16 5 10 4)) (gn-emit (enc-ldp 9 10 16 0))
   (gn-mov-imm 17 maxidx) (gn-emit (enc-cmp-r 10 17)) (qrow-guard P 13 9)
   (gn-mov-imm 17 134217729) (gn-emit (enc-cmp-r 10 17)) (qrow-guard P 14 (enc-cond-hs))
   (gn-emit (enc-cmp-r 9 17)) (qrow-guard P 15 (enc-cond-hs))
   (gn-emit (enc-add-r 16 9 10)) (gn-mov-imm 17 134217728)
   (gn-emit (enc-cmp-r 16 17)) (qrow-guard P 16 8)
   (gn-emit (enc-mov-sp 5 31)) (gn-emit (enc-cmp-i 5 176)) (qrow-guard P 17 (enc-cond-lo))
   (gn-mov-imm 17 -160) (gn-emit (enc-cmp-r 5 17)) (qrow-guard P 18 (enc-cond-hs))
   (gn-emit (enc-add-i 6 5 160)) (gn-emit (enc-sub-i 5 5 176)) (qrow-disjoint P 19))))
(defn- qrow-public-charge [M :vector-i64] :vector-i64
 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-sub-i 16 16 1)) (gn-emit (enc-str 16 7 CTX-FUEL))))
(defn- qrow-load [M :vector-i64 index :i64 dest :i64] :vector-i64
 (-> M (gn-emit (enc-ldr 16 7 320))
  (gn-emit (enc-sub-i 17 (gn-sreg M 1) 1)) (gn-emit (gn-e-addsl 16 16 17 4))
  (gn-emit (enc-ldr 17 16 0)) (gn-emit (enc-add-r 17 17 index))
  (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 17 16 17 3)) (gn-emit (enc-ldr dest 17 0))))
(defn- qrow-weight [M :vector-i64 d :i64 n :i64] :vector-i64
 (-> M (gn-mov-imm 17 7) (gn-emit (enc-and-r 17 n 17)) (gn-mov-imm d 128) (gn-emit (enc-lsrv d d 17))))
(defn- qrow-loop [M :vector-i64 p :i64 kind :i64] :vector-i64
 (let [x (gn-sreg M 3) y (gn-sreg M 4) l (gn-sir M (+ p 4) IF-B)
  rp (gn-fnf M (gn-sir M (+ p 18) IF-A) FF-SIR) ro (gn-sir M (+ rp 34) IF-B)
  io (gn-sir M (+ p 22) IF-B) stride (gn-sir M (+ p 28) IF-B)
  head (vector-at M MM-CODE-N)
  m0 (-> M (gn-mov-imm 17 l) (gn-emit (enc-cmp-r x 17))) terminal (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-eq) 0)) (qrow-public-charge)
   (gn-mov 1 x) (gn-mov 2 y) (qrow-case kind)) skipmask (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-cmp-i 0 0)) (gn-emit (enc-bcond (enc-cond-eq) 0)) (qrow-public-charge)
   (gn-emit (enc-cmp-r x y)) (gn-emit (enc-csel 3 x y (enc-cond-le)))
   (gn-emit (enc-csel 4 x y (enc-cond-ge))) (gn-emit (enc-mul 6 4 4)) (gn-emit (enc-add-r 6 6 4))
   (gn-mov-imm 17 1) (gn-emit (enc-lsrv 6 6 17)) (gn-emit (enc-add-r 6 6 3))
   (gn-mov-imm 17 3) (gn-emit (enc-lsrv 9 6 17)) (gn-mov-imm 17 ro) (gn-emit (enc-add-r 9 9 17))
   (qrow-load 9 10) (qrow-weight 3 6) (gn-emit (enc-and-r 10 10 3))
   (gn-emit (enc-cmp-i 10 0))) skipreserved (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ne) 0))
   (gn-mov-imm 17 3) (gn-emit (enc-lsrv 6 x 17)) (gn-mov-imm 17 io) (gn-emit (enc-add-r 6 6 17))
   (gn-mov-imm 17 stride) (gn-emit (enc-mul 9 y 17)) (gn-emit (enc-add-r 6 6 9))
   (qrow-load 6 10) (gn-mov 4 17) (qrow-weight 3 x) (gn-emit (enc-eor-r 10 10 3))
   ;; Writer's original private charge is NOT published until after payload store.
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-sub-i 8 8 1))
   (gn-mov-imm 17 255) (gn-emit (enc-and-r 10 10 17)) (gn-emit (enc-str 10 4 0))
   (gn-emit (enc-str 8 7 CTX-FUEL))) next (vector-at m3 MM-CODE-N)
  m4a (-> m3 (gn-emit (enc-add-i x x 1)) (qrow-public-charge)) back (vector-at m4a MM-CODE-N)
  m4 (gn-emit m4a (enc-b (- head back))) end (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-mov 0 (gn-sreg M 1)) (gn-epilogue) (gn-gs gn-f-dead 0))]
  (-> m5 (gn-dot-patch terminal end (enc-cond-eq))
   (gn-dot-patch (inc skipmask) next (enc-cond-eq)) (gn-dot-patch skipreserved next (enc-cond-ne)))))
(defn- qrow-variants [M :vector-i64 p :i64 kind :i64] :vector-i64
 (if (= kind 7) (qrow-loop M p 7)
  (let [m0 (-> M (gn-emit (enc-cmp-i (gn-sreg M 2) kind))) next (vector-at m0 MM-CODE-N)
   m1 (qrow-loop (gn-emit m0 (enc-bcond (enc-cond-ne) 0)) p kind) end (vector-at m1 MM-CODE-N)]
   (qrow-variants (gn-dot-patch m1 next end (enc-cond-ne)) p (inc kind)))))
(defn- qrow-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (qrow-admit M i)] (if (= p 0) M
  (let [P (vector-alloc 20) m0 (qrow-preflight M P p)
   m1 (qrow-variants m0 p 0) cold (vector-at m1 MM-CODE-N)
   m2 (loop [out m1 k 0] (if (= k 20) out
    (let [at (vector-at P k)] (recur (gn-dot-patch out at cold (bit-and (sf-word out at) 15)) (inc k)))))]
   ;; Original row entry charge is already paid. Cold body remains unchanged.
   (-> m2 (gn-mov-imm 5 0) (gn-gs gn-f-vslot 0) (vi-clear) (sl-clear) (gn-gs gn-f-ctx 1))))))

;; General bounded read-only token-step recurrence, not workload/FN-name dispatch.
;; One-off new semantic algorithm under ADR0357; not a mechanical global rewrite.
(defn- sls-pattern [kind :i64] :vector-i64
 (case kind 0 [1125921316143105 18 4288282633 17179869188 12884967428 131079 280981055471627 4294967300 8590000132 17180000260 4295032838 562954182787085 399432024067 65543 65544 4287430665 280899451093003 4294967300 8590000132 12885032964 17180065796 4295229444 8590262276 17180262404 21474902022 562971362590733 12884967430 65541 4295098373 8590131205 12885164037 18 4288282634 4285399050 4286185481 17179869188 12884967428 262151 280860796387339 17179869188 4295032835 65542 4285464586 4285595657 281470681743363 4285464585 4285399049 19 4229431298] 1 [562962772787201 18 4288282633 8589934596 4295032836 281479276396558 65543 281002530308107 3 4287496202 4287758345 4294967300 8590000132 562949962858510 4287496201 19 4229431298] 2 [562962772787201 18 4288282633 4294967300 8590000132 562954182787085 395137056771 65543 280946695733259 4294967300 8590000132 4295098371 4295032838 562954182787085 515396141059 65543 280963875602443 17179869187 4287037450 4287168521 8589934595 4287037449 4286775306 4286906377 4294967299 4286775305 19 4229431298] []))
(defn- sls-value [M :vector-i64 p :i64 T :vector-i64 v :i64] :i64
 (cond (= v -1000) (vector-at T 0) (= v -1001) (vector-at T 1) (= v -1002) (vector-at T 2)
  (and (<= v -100) (>= v -148)) (gn-sir M (+ p (- -100 v)) IF-A) :else v))
(defn- sls-meta [M :vector-i64 f :i64 kind :i64] :bool
 (let [n (case kind 0 4 1 2 2 2 0) count (case kind 0 49 1 17 2 28 0)]
 (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
    (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) n)
    (= (gn-fnf M f FF-DEPTH) (case kind 0 7 1 2 2 3 0))
    (= (gn-fnf M f FF-RTYPE) TY-I64) (not (gn-clamp-open M f))
    (loop [k 0] (or (= k n) (and (= (ck-pt M f k) (if (= k 0) TY-STR TY-I64)) (recur (inc k)))))
    (gn-dot-at? M p OP-FN f n n) (gn-dot-at? M (+ p (dec count)) OP-END f 0 0))))))
(defn- sls-match [M :vector-i64 f :i64 T :vector-i64 kind :i64] :bool
 (and (sls-meta M f kind)
 (let [p (gn-fnf M f FF-SIR) V (sls-pattern kind) U (vector-assoc T 0 f)]
  (loop [k 0] (or (= k (vector-count V))
   (let [w (vector-at V k) op (bit-and w 65535) a (i64-shift-right (i64-shift-left w 32) 48)
    b (i64-shift-right (i64-shift-left w 16) 48) c (i64-shift-right w 48)]
    (and (gn-dot-at? M (+ p k) op (sls-value M p U a) (sls-value M p U b) c) (recur (inc k)))))))))
(defn- sls-admit [M :vector-i64 i :i64] :bool
 (and (mdc-counts M) (> i 2) (<= 49 (- (vector-at M MM-SIR-N) (- i 2)))
  (= (gn-op M (- i 2)) OP-FN) (= (gn-op M (dec i)) OP-FUEL) (= (gn-op M i) OP-LABEL)
  (let [p (- i 2) f (gn-sir M p IF-A)]
   (and (sls-meta M f 0)
    (let [R (gn-sir M (+ p 11) IF-A) O (gn-sir M (+ p 25) IF-A) T [f R O]]
     (and (not= f R) (not= f O) (not= R O) (sls-match M f T 0) (sls-match M R T 1) (sls-match M O T 2)
      (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-ns) 4)
      (= (gn-g M gn-f-dp) 7) (= (gn-g M gn-f-nsv) 4) (= (gn-g M gn-f-fb) 144)
      (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
      (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ctx) 0)
      (= (gn-sreg M 1) 20) (= (gn-sreg M 2) 21) (= (gn-sreg M 3) 22) (= (gn-sreg M 4) 19)
      (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 384))))))))
(defn- sls-disjoint [M :vector-i64 G :vector-i64] :vector-i64
 ;; Full code backing [14,15) excludes [16,17); guard-only scratch9..17.
 (-> M (gn-emit (enc-cmp-r 14 17)) (gn-emit (enc-bcond (enc-cond-hs) 3))
  (gn-emit (enc-cmp-r 16 15)) (ri-cold G (enc-cond-lo))))
(defn- sls-metadata-disjoint [M :vector-i64 G :vector-i64] :vector-i64
 ;; Metadata interval [16,17) excludes all context and every removed helper frame.
 (-> M (gn-mov-imm 12 -400) (gn-emit (enc-cmp-r 7 12)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-add-i 12 7 400)) (gn-emit (enc-cmp-r 16 12)) (gn-emit (enc-bcond (enc-cond-hs) 3))
  (gn-emit (enc-cmp-r 7 17)) (ri-cold G (enc-cond-lo))
  (gn-emit (enc-mov-sp 11 31)) (gn-emit (enc-cmp-i 11 160)) (ri-cold G (enc-cond-lo))
  (gn-emit (enc-sub-i 11 11 160)) (gn-mov-imm 12 -16) (gn-emit (enc-cmp-r 29 12)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-add-i 12 29 16)) (gn-emit (enc-cmp-r 16 12)) (gn-emit (enc-bcond (enc-cond-hs) 3))
  (gn-emit (enc-cmp-r 11 17)) (ri-cold G (enc-cond-lo))))
(defn- sls-charge [M :vector-i64] :vector-i64
 ;; Existing uncached original success publication; preflight prevents traps.
 (gn-op-fuel M))
(defn- sls-emit [M :vector-i64] :vector-i64
 (let [G (vector-alloc 73)
  m0 (-> M
   (gn-mov 16 7) (gn-mov-imm 17 -400) (gn-emit (enc-cmp-r 16 17)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-add-i 17 16 400)) (gn-emit (enc-mov-sp 11 31))
   (gn-emit (enc-cmp-i 11 160)) (ri-cold G (enc-cond-lo)) (gn-emit (enc-sub-i 11 11 160))
   (gn-mov-imm 12 -16) (gn-emit (enc-cmp-r 29 12)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-add-i 12 29 16)) (gn-emit (enc-cmp-r 16 12)) (gn-emit (enc-bcond (enc-cond-hs) 3))
   (gn-emit (enc-cmp-r 11 17)) (ri-cold G (enc-cond-lo))
   (gn-ld 7 0) (gn-emit (enc-cmp-i 22 1)) (ri-cold G (enc-cond-lo))
   (gn-emit (enc-cmp-i 22 64)) (ri-cold G 8) (gn-emit (enc-cmp-r 19 22)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-sub-r 17 22 19)) (gn-emit (gn-e-lsl 16 17 2)) (gn-emit (enc-add-r 17 16 17))
   (gn-emit (enc-ldr 13 7 CTX-FUEL)) (gn-emit (enc-cmp-r 13 17)) (ri-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 16 7 288)) (gn-emit (enc-ldr 13 16 0))
   (gn-mov-imm 17 16777217) (gn-emit (enc-cmp-r 13 17)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-sub-i 17 20 1)) (gn-emit (enc-cmp-r 17 13)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 296)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 11 10 16 0))
   (gn-emit (enc-cmp-i 10 64)) (ri-cold G 8) (gn-emit (enc-cmp-r 21 10)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-add-r 17 21 22)) (gn-emit (enc-cmp-r 17 10)) (ri-cold G 8)
   (gn-emit (enc-ldr 9 7 CTX-CODE-BASE)) (gn-emit (enc-ldr 12 7 392))
   (gn-emit (enc-cmp-r 11 12)) (ri-cold G 8) (gn-emit (enc-sub-r 17 12 11))
   (gn-emit (enc-cmp-r 10 17)) (ri-cold G 8)
   (gn-mov 14 9) (gn-emit (enc-add-r 15 9 12)) (gn-emit (enc-cmp-r 15 9)) (ri-cold G (enc-cond-lo))
   (gn-emit (enc-add-r 9 9 11))
   (gn-mov 16 7) (gn-mov-imm 17 -400) (gn-emit (enc-cmp-r 16 17)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-add-i 17 16 400)) (sls-disjoint G)
   (gn-emit (enc-ldr 16 7 288)) (gn-mov-imm 17 -8) (gn-emit (enc-cmp-r 16 17)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-add-i 17 16 8)) (sls-disjoint G) (sls-metadata-disjoint G)
   (gn-emit (enc-ldr 16 7 296)) (gn-emit (gn-e-addsl 17 16 13 4))
   (gn-emit (enc-cmp-r 17 16)) (ri-cold G (enc-cond-lo)) (sls-disjoint G) (sls-metadata-disjoint G)
   (gn-emit (enc-mov-sp 16 31)) (gn-emit (enc-cmp-i 16 160)) (ri-cold G (enc-cond-lo))
   (gn-emit (enc-sub-i 16 16 160)) (gn-mov-imm 17 -16) (gn-emit (enc-cmp-r 29 17)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-add-i 17 29 16)) (sls-disjoint G) (gn-mov-imm 11 0))
  ascii-at (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (gn-e-ldrb 12 9 11)) (gn-emit (enc-cmp-i 12 128)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-add-i 11 11 1)) (gn-emit (enc-cmp-r 11 10))) ascii-back (vector-at m1 MM-CODE-N)
  m2 (gn-emit m1 (enc-bcond (enc-cond-lo) (- ascii-at ascii-back))) head (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-cmp-r 19 22))) done1 (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit 0) (sls-charge) (gn-emit (enc-add-r 11 21 19)) (gn-emit (gn-e-ldrb 12 9 11))
   (gn-emit (enc-cmp-i 12 93))) done2 (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit 0) (sls-charge) (sls-charge) (gn-emit (enc-cmp-i 12 92))) ordinary (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit 0) (sls-charge) (gn-emit (enc-add-i 11 11 1)) (gn-mov-imm 12 0)
   (gn-emit (enc-cmp-r 11 10))) endpoint (vector-at m6 MM-CODE-N)
  m7 (-> m6 (gn-emit 0) (gn-emit (gn-e-ldrb 12 9 11))) endpoint-at (vector-at m7 MM-CODE-N)
  m8 (-> (gn-dot-patch m7 endpoint endpoint-at (enc-cond-eq))
   (gn-emit (enc-cmp-i 12 120)) (gn-emit (enc-cset 11 (enc-cond-eq))) (gn-emit (gn-e-lsl 11 11 1))
   (gn-emit (enc-add-i 11 11 2))) join (vector-at m8 MM-CODE-N)
  m9 (gn-emit m8 0) ordinary-at (vector-at m9 MM-CODE-N)
  m10 (gn-mov-imm m9 11 1) join-at (vector-at m10 MM-CODE-N)
