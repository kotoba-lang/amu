(defn- srloop-entry [M :vector-i64 i :i64] :vector-i64
 (let [n (srloop-admit M i)]
  (if (= n 0) M
   (let [p (- i 2) ri (gn-sreg M 2) rv (gn-sreg M 1)
    threshold (gn-sir M (+ p 11) IF-B) base (gn-sir M (+ p 21) IF-B)
    ctx (gn-g M gn-f-ctx) m0 (gn-emit M (enc-cmp-i ri threshold)) b0 (vector-at m0 MM-CODE-N)
    m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-mov-imm 9 n) (gn-emit (enc-cmp-r ri 9))) b1 (vector-at m1 MM-CODE-N)
    m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-ctx)
