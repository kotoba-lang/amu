     (and (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
      (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-RTYPE) TY-VEC)
