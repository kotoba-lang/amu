  m6 (-> m5 (gn-emit (enc-bcond 1 (- outer ob))) (gn-vclear) (gn-epilogue) (gn-gs gn-f-dead 0)) end (vector-at m6 MM-CODE-N)]
 (ri-patch (gn-dot-patch m6 zero write 0) G 0 end))))

