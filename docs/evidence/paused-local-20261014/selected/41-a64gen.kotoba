  (-> M (gn-mov 9 0) (gn-emit (+ (enc-orr-r 10 9 9) 32768)) (rr-emit (+ p 2) (dec end)))))
(defn- srloop-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 72) true
  (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
   exit (gn-sir M (+ p 8) IF-A) right (gn-sir M (+ p 13) IF-B) join (gn-sir M (+ p 18) IF-A)
   n (gn-sir M (+ p 4) IF-B) threshold (gn-sir M (+ p 11) IF-B) base (gn-sir M (+ p 21) IF-B)
   d0 (gn-sir M (+ p 23) IF-B) d1 (gn-sir M (+ p 31) IF-B)
   d2 (gn-sir M (+ p 39) IF-B) d3 (gn-sir M (+ p 47) IF-B)
