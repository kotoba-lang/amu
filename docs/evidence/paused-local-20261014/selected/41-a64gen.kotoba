  (> dot 0) (< dot (vector-at M MM-FN-N))
  (> (gn-fnf M reader FF-SIR) 0) (< (+ (gn-fnf M reader FF-SIR) 11) (vector-at M MM-SIR-N))
  (> (gn-fnf M dot FF-SIR) 0) (< (+ (gn-fnf M dot FF-SIR) 38) (vector-at M MM-SIR-N))
  (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 5) IF-A) CC-GT)
  (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 22) IF-A) reader)
  (> (mr-reader M (+ p 19) reader 3) 0)
