;; Compiler-only pending AUX=-sourceCALL; resolved before layout by scfill-call.
;; Word-aligned ADR uses exactly imm19 at bits5..23, immlo0 and destination30.
(defn- scfill-lr-fix [M :vector-i64 label :i64 call :i64] :vector-i64
 (let [k (vector-at M MM-FIX-N) m (gn-fix M FX-ADRL19 label)]
  (-> m (gn-put (+ MM-FIX-BASE (* k MM-FIX-W) XF-AUX) (- call)) (gn-emit (gn-e-adr 30)))))
(defn- scfill-lr-pending [M :vector-i64 k :i64 end :i64 i :i64] :bool
 (if (>= k end) false
  (if (= (sf-x M k XF-AUX) (- i)) true (scfill-lr-pending M (inc k) end i))))
(defn- scfill-lr-bl [M :vector-i64 k :i64 end :i64 f :i64 begin :i64 stop :i64 found :i64] :i64
 (if (>= k end) found
  (let [at (sf-x M k XF-AT)]
   (if (= (sf-x M k XF-KIND) FX-BL26)
    (if (or (> found 0) (not= (sf-x M k XF-TARGET) f) (< at begin) (>= at stop)
            (not= (bit-and (sf-word M at) 0xfc000000) 0x94000000)) -1
     (scfill-lr-bl M (inc k) end f begin stop (inc at)))
    (scfill-lr-bl M (inc k) end f begin stop found)))))
(defn- scfill-lr-bind [M :vector-i64 k :i64 end :i64 i :i64 ret :i64] :vector-i64
 (if (>= k end) M
  (if (not= (sf-x M k XF-AUX) (- i)) (scfill-lr-bind M (inc k) end i ret)
   (let [at (sf-x M k XF-AT) label (sf-x M k XF-TARGET) cn (vector-at M MM-CODE-N)]
    (if (or (not= (sf-x M k XF-KIND) FX-ADRL19) (<= at 0) (>= at cn)
      (<= label 0) (>= label (vector-at M MM-LABEL-N)) (>= label MM-LABEL-CAP)
      (<= ret 0) (>= ret cn) (< (- ret at) -262144) (> (- ret at) 262143)
      (not= (sf-word M at) (gn-e-adr 30))) (gn-err M E-GEN-OP i)
     (scfill-lr-bind (-> M (gn-put (+ MM-LABEL-BASE label) ret)
       (gn-put (+ MM-FIX-BASE (* k MM-FIX-W) XF-AUX) 0)) (inc k) end i ret))))))
(defn- scfill-call [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :vector-i64
 (let [m (scfill-entry M i) xf (vector-at m MM-FIX-N) begin (vector-at m MM-CODE-N)
       pending (scfill-lr-pending m 1 xf i) out (gn-op-call m i f t n)]
  (if (not pending) out
   (let [ret (scfill-lr-bl out xf (vector-at out MM-FIX-N) f begin (vector-at out MM-CODE-N) 0)]
    (if (<= ret 0) (gn-err out E-GEN-OP i) (scfill-lr-bind out 1 xf i ret))))))

(defn- tbat-owner [M :vector-i64 j :i64 left :i64] :i64
 (cond (or (<= j 0) (<= left 0)) 0
  (= (gn-op M j) OP-FN) j
  (= (gn-op M j) OP-END) 0
  :else (tbat-owner M (dec j) (dec left))))
(defn- tbat-labels [M :vector-i64 p :i64 n :i64 j :i64] :bool
 (if (= j n) true
  (if (not= (gn-op M (+ p j)) OP-LABEL) (tbat-labels M p n (inc j))
   (let [l (gn-sir M (+ p j) IF-A) sn (vector-at M MM-SIR-N)]
    (and (> l 0) (< l (vector-at M MM-LABEL-N)) (< l MM-LABEL-CAP)
     (loop [q 1] (or (= q sn)
      (let [op (gn-op M q)] (and (not= op OP-TAB)
       (or (not= op OP-LABEL) (not= (gn-sir M q IF-A) l) (= q (+ p j)))
       (or (not (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ)))
           (not= (gn-sir M q (if (= op OP-BR) IF-A IF-B)) l)
           (and (>= q p) (< q (+ p n)))) (recur (inc q))))))
     (tbat-labels M p n (inc j)))))))
(defn- tbat-fsafe [M :vector-i64 f :i64 n :i64] :i64
