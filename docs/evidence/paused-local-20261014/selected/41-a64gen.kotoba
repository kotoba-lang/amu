    (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-lo)) (gn-gs gn-f-ctx ctx))))))
(defn- srloop-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 5) true
  (let [at (+ p (case k 0 2 1 9 2 19 3 54 69)) l (gn-sir M at IF-A)]
   (and (> l 0) (< l MM-LABEL-CAP)
    (loop [j 0] (or (= j k)
     (and (not= l (gn-sir M (+ p (case j 0 2 1 9 2 19 3 54 69)) IF-A)) (recur (inc j)))))
    (srloop-labels M p (inc k))))))
(defn- srloop-read [M :vector-i64 p :i64 delta :i64 dst :i64] :vector-i64
 (let [ri (gn-sreg M 2) base (gn-sir M (+ p 21) IF-B)]
  (-> M (gn-emit (enc-add-i 16 ri base)) (gn-emit (enc-sub-i 16 16 delta))
   (gn-emit (gn-e-ldrr dst 5 16 1)))))
(defn- srloop-scalar [M :vector-i64 f :i64] :vector-i64
