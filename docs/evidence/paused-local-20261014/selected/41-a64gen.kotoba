;; ADR0357: finite readonly ASCII reader/classifier region. No fuel batching.
;; Exact literal offset/length authority excludes interior slices and padding.
(defn- ac-label [M :vector-i64 p :i64 k :i64] :bool
 (let [l (gn-sir M (+ p k) IF-A)]
  (and (> l 0) (< l MM-LABEL-CAP) (= (gn-small-label M 1 l 0) (+ p k)))))
(defn- ac-reader-shape [M :vector-i64 p :i64 f :i64 A :i64 L :i64 O :i64 H :i64 k :i64] :bool
 (if (= k 17) true
  (and (case k
    0 (gn-dot-at? M (+ p 0) 1 f 2 2)
    1 (gn-dot-at? M (+ p 1) 18 0 0 0)
    2 (and (ac-label M p 2) (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0))
    3 (gn-dot-at? M (+ p 3) 4 0 2 0)
    4 (gn-dot-at? M (+ p 4) 4 1 1 0)
    5 (gn-dot-at? M (+ p 5) 14 72 1 1)
    6 (gn-dot-at? M (+ p 6) 7 1 0 0)
    7 (gn-dot-at? M (+ p 7) 11 0 (gn-sir M (+ p 10) IF-A) 0)
    8 (gn-dot-at? M (+ p 8) 3 0 0 0)
    9 (gn-dot-at? M (+ p 9) 10 (gn-sir M (+ p 14) IF-A) 0 0)
