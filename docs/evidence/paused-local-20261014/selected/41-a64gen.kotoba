   m3 (gp-restore m2 B)]
   (loop [cur m3 k 0] (if (= k (vector-at G 40)) cur
     (recur (gn-dot-patch cur (vector-at G (* k 2)) cold (vector-at G (inc (* k 2)))) (inc k)))))))


;; ADR0357 one-off bounded initial packed-word phase: a new semantic
;; certificate not supplied by existing mechanical AST refactor rules.
;; No workload names, narrowing, extra frame, prepayment or reordered reads.
(defn- pwphase-pattern [kind :i64] :vector-i64
 (if (= kind 0) [1125917086646273 18 4229300233 8589934596 17179934723 12885032964 4295163910 65542 262149 4294967300 17179934724 562949964955662 103079280643 524294 4295032836 17180000260 4295163907 8590000134 562954259922958 68719607811 4295491590 65542 4295032836 17180000260 8590131203 8590000134 562954259922958 34359869443 4295491590 65542 4295032836 17180000260 12885098499 8590000134 562954259922958 65542 19 4294901762] [844442109935617 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294901762]))
(defn- pwphase-match [M :vector-i64 p :i64 f :i64 kind :i64] :bool
 (let [V (pwphase-pattern kind) count (vector-count V)]
  (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
   (loop [k 0] (or (= k count)
    (let [w (vector-at V k) op (bit-and w 65535)
          x (i64-shift-right (i64-shift-left w 32) 48)
          y (i64-shift-right (i64-shift-left w 16) 48) z (i64-shift-right w 48)
          a (if (= x -1) f (if (<= x -1000) (gn-sir M (+ p (- (- 0 x) 1000)) IF-A) x))]
     (and (gn-dot-at? M (+ p k) op a y z) (recur (inc k)))))))))
(defn- pwphase-helper [M :vector-i64 f :i64 kind :i64] :bool
 (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (not (gn-clamp-open M f))
  (let [p (gn-fnf M f FF-SIR) count (if (= kind 0) 38 9)]
   (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) (if (= kind 0) 4 3))
    (= (gn-fnf M f FF-DEPTH) (if (= kind 0) 4 3))
    (= (gn-fnf M f FF-RTYPE) (if (= kind 0) TY-I64 TY-VEC))
    (= (ck-pt M f 0) TY-VEC) (= (ck-pt M f 1) TY-I64) (= (ck-pt M f 2) TY-I64)
    (> (gn-sir M (+ p 2) IF-A) 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
    (pwphase-match M p f kind)))))
(defn- pwphase-admit [M :vector-i64 i :i64] :bool
 (and (mdc-counts M) (> i 1) (< i (vector-at M MM-SIR-N))
  (<= 72 (- (vector-at M MM-SIR-N) (dec i))) (= (gn-op M (dec i)) OP-FN)
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2)
    (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 6) (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (= (ck-pt M f 0) TY-VEC) (= (ck-pt M f 1) TY-I64)
    (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 6)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
    (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-fb) 128) (= (gn-g M gn-f-nsv) 3)
    (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-sreg M 1) 20) (= (gn-sreg M 2) 19) (= (gn-sreg M 3) 21)
    (let [n (gn-sir M (+ p 4) IF-B) t (gn-sir M (+ p 11) IF-B) base (gn-sir M (+ p 21) IF-B)]
     (and (> n 0) (<= n 4096) (> t 0) (<= t n) (>= base 0) (<= base 4095)
      (srloop-shape M p f 0) (srloop-labels M p 0)
      (pwphase-helper M (gn-sir M (+ p 17) IF-A) 0)
      (pwphase-helper M (gn-sir M (+ p 61) IF-A) 1)))))))
(defn- pwphase-cold [M :vector-i64 G :vector-i64 cond :i64] :vector-i64
 (let [n (vector-at G 16) a (vector-assoc! G (* n 2) (vector-at M MM-CODE-N))
       b (vector-assoc! a (inc (* n 2)) cond) c (vector-assoc! b 16 (inc n))]
  (gn-emit M (enc-bcond cond 0))))
(defn- pwphase-emit [M :vector-i64 V :vector-i64] :vector-i64
 (loop [cur M k 0] (if (= k (vector-count V)) cur
  (recur (gn-emit cur (vector-at V k)) (inc k)))))
(defn- pwphase-body [M :vector-i64 base :i64] :vector-i64
 ;; Fixed physical homes are certified by admit; static ASM witnesses pinned.
 (-> M (pwphase-emit [4181722344 4043310344 1409286242 4177528063 3558866944 3548313184 4167071913 3546848553 2432697345 4167137450 3547381066 2332688681 2432698369 4167137450 3547913546 2332688681 2432699393 4167137450 2332688681 4177528040 2852717557 4181722352 4043310608 1409286210 3558866944 4177528048]) (gn-emit (enc-add-i 0 19 base)) (pwphase-emit [4162877621 2432697971 4181722352 4043310608 1409286210 3558866944 4177528048])))
(defn- pwphase-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (pwphase-admit M i)) M
  (let [p (dec i) t (gn-sir M (+ p 11) IF-B) base (gn-sir M (+ p 21) IF-B)
        G (vector-alloc 17) B (gp-save-state M)
        m0 (-> M (gn-mov-imm 9 t) (gn-emit (enc-cmp-r 19 9)) (pwphase-cold G (enc-cond-hs))
          (gn-emit (enc-sub-r 9 9 19)) (gn-mov-imm 10 3) (gn-emit (enc-mul 9 9 10))
          (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9)) (pwphase-cold G (enc-cond-lo))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
          (gn-emit (enc-sub-i 17 20 1)) (gn-emit (enc-cmp-r 17 16)) (pwphase-cold G (enc-cond-hs))
          (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
          (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
          (gn-emit (enc-cmp-r 0 16)) (pwphase-cold G (enc-cond-hs))
          (gn-mov-imm 16 (* t 4)) (gn-emit (enc-cmp-r 0 16)) (pwphase-cold G (enc-cond-lo))
          (gn-mov-imm 16 (+ base t)) (gn-emit (enc-cmp-r 0 16)) (pwphase-cold G (enc-cond-lo))
          (gn-emit (enc-ldr 5 7 328)) (gn-emit (gn-e-addsl 5 5 17 3))) head (vector-at m0 MM-CODE-N)
        m1 (-> m0 (pwphase-body base) (gn-mov-imm 16 t) (gn-emit (enc-cmp-r 19 16))) back (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) (- head back)))
          (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0))) cold (vector-at m2 MM-CODE-N)
        m3 (gp-restore m2 B)]
   (loop [cur m3 k 0] (if (= k (vector-at G 16)) cur
    (recur (gn-dot-patch cur (vector-at G (* k 2)) cold (vector-at G (inc (* k 2)))) (inc k)))))))

;; ADR0357 one-off general two-run closed pair merge loop. New semantic
;; versioning algorithm, not an existing mechanical AST rule; original PI
;; fourcharge-before-pairread and comparator-after-read publications retained.
(defn- wm-pattern [key :i64] :vector-i64 (case key 0 [1688879924969473 18 4229300233 8589934596 12884967428 65543 277137059741708 17179869188 21474902020 65543 4228775945 277089815101451 4294967300 25769869316 8590065668 12885098500 8590196740 12885032966 262147 1407379178192909 4224516106 4228055049 4294967300 17179934724 562954248257549 4295032836 8590065668 562958543224845 327687 276956671115275 4294967300 25769869316 8590065668 844429224837133 8590000132 4295098371 4295032838 12885032964 17180065796 21475098628 25770131460 4295360515 21474902022 65541 4295098373 8590131205 12885164037 17180196869] 1 [21475229701 18 4229300234 4224581642 4226023433 4294967300 25769869316 17180000260 844429224837133 8590000132 12885032964 17180065796 4295229443 12884967430 21475098628 25770131460 4295360515 21474902022 65541 4295098373 8590131205 12885164037 17180196869 21475229701 18 4229300234 4224581641 4224516105 19 4294901762] 2 [1407392063356929 18 4229300233 4294967300 12884967428 562954248257549 262149 4294967300 12884967428 8590065667 4295163910 4295098371 4295032838 562949964955662 327685 4294967300 8590000132 8590065667 4295163910 17180000260 844429224902669 8590000132 8590065667 4295163910 4295098371 4295032838 21474967556 844429224902669 19 4294901762] 4 [562962838257665 18 4229300233 4294967300 8590000132 8590065667 4295163910 562949964955662 19 4294901762] 6 [844442109935617 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294901762] 8 [1407400653291521 18 4229300233 21474836484 17179934724 65543 277141354709003 4294967300 4227399690 4228841481 4294967300 8590000132 21474967556 4295032838 12885032964 21475033092 8590000134 844429224837133 8590000132 12885032964 17180065796 21475098628 4295294979 17179934726 65541 4295098373 8590131205 12885164037 17180196869 18 4229300234 4227399689 19 4294901762] []))
(defn- wm-field [M :vector-i64 p :i64 f :i64 x :i64 vr :i64 it :i64 wr :i64 cp :i64] :i64
 (if (<= x -1000) (gn-sir M (+ p (- (- 0 x) 1000)) IF-A)
  (case x -1 f -2 vr -3 wr -4 it -5 cp x)))
(defn- wm-match [M :vector-i64 p :i64 f :i64 kind :i64 vr :i64 it :i64 wr :i64 cp :i64] :bool
 (let [n (case kind 0 78 1 30 2 10 3 9 34)]
  (loop [k 0] (or (= k n)
   (let [V (wm-pattern (+ (* kind 2) (quot k 48))) w (vector-at V (rem k 48))
         op (bit-and w 65535) x (i64-shift-right (i64-shift-left w 32) 48)
         y (i64-shift-right (i64-shift-left w 16) 48) z (i64-shift-right w 48)]
    (and (gn-dot-at? M (+ p k) op (wm-field M p f x vr it wr cp) (wm-field M p f y vr it wr cp) z)
     (recur (inc k))))))))
(defn- wm-meta [M :vector-i64 f :i64 kind :i64] :bool
 (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (let [p (gn-fnf M f FF-SIR) count (case kind 0 78 1 30 2 10 3 9 34)
        np (case kind 0 6 1 3 2 2 3 3 5)]
   (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
    (not (gn-clamp-open M f)) (= (gn-fnf M f FF-NPARAMS) np)
    (= (gn-fnf M f FF-NSLOTS) (case kind 0 6 1 5 2 2 3 3 5))
    (= (gn-fnf M f FF-DEPTH) (case kind 0 7 1 3 2 3 3 3 6))
    (= (gn-fnf M f FF-RTYPE) (if (= kind 2) TY-I64 TY-VEC))
    (= (ck-pt M f 0) TY-VEC)
    (loop [k 1] (or (= k np) (and (= (ck-pt M f k) TY-I64) (recur (inc k)))))))))
(defn- wm-labels [M :vector-i64 p :i64 kind :i64] :bool
 (let [n (case kind 0 78 1 30 2 10 3 9 34)]
  (loop [k 0] (or (= k n)
   (and (if (= (gn-op M (+ p k)) OP-LABEL)
    (let [label (gn-sir M (+ p k) IF-A)]
     (and (> label 0) (< label MM-LABEL-CAP) (= (gn-lpos M label) (+ p k)))) true)
    (recur (inc k)))))))
(defn- wm-helper [M :vector-i64 f :i64 kind :i64 vr :i64 it :i64 wr :i64 cp :i64] :bool
 (and (wm-meta M f kind) (let [p (gn-fnf M f FF-SIR)]
  (and (wm-match M p f kind vr it wr cp) (wm-labels M p kind)))))
(defn- wm-admit [M :vector-i64 i :i64] :bool
 (and (mdc-counts M) (> i 1) (< i (vector-at M MM-SIR-N))
  (<= 78 (- (vector-at M MM-SIR-N) (dec i))) (= (gn-op M (dec i)) OP-FN)
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (wm-meta M f 0) (= (gn-fnf M f FF-SIR) p)
    (= (gn-g M gn-f-ns) 6) (= (gn-g M gn-f-dp) 7) (= (gn-g M gn-f-nsv) 6)
    (= (gn-g M gn-f-fb) 176) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
    (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
    (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-sreg M 1) 20) (= (gn-sreg M 2) 19) (= (gn-sreg M 3) 23)
    (= (gn-sreg M 4) 21) (= (gn-sreg M 5) 24) (= (gn-sreg M 6) 22)
    (let [vr (gn-sir M (+ p 24) IF-A) it (gn-sir M (+ p 33) IF-A) cp (gn-sir M (+ p 19) IF-A)]
     (and (wm-meta M it 1)
      (let [wr (gn-sir M (+ (gn-fnf M it FF-SIR) 20) IF-A)]
       (and (wm-helper M vr 2 vr it wr cp) (wm-helper M wr 3 vr it wr cp)
        (wm-helper M it 1 vr it wr cp) (wm-helper M cp 4 vr it wr cp)
        (wm-match M p f 0 vr it wr cp) (wm-labels M p 0)))))))))
(defn- wm-emit [M :vector-i64 V :vector-i64] :vector-i64
 (loop [cur M k 0] (if (= k (vector-count V)) cur
  (recur (gn-emit cur (vector-at V k)) (inc k)))))
