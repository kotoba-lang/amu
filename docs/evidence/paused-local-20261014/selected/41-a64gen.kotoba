    11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
    13 (gn-dot-at? M (+ p 13) OP-BIN BOP-ADD 1 0)
    14 (gn-dot-at? M (+ p 14) OP-CONST 2 0 0)
    15 (gn-dot-at? M (+ p 15) OP-CALL w 0 3)
    16 (gn-dot-at? M (+ p 16) OP-LGET 1 2 0)
    17 (gn-dot-at? M (+ p 17) OP-LGET 2 3 0)
    18 (gn-dot-at? M (+ p 18) OP-CONST 3 1 0)
    19 (gn-dot-at? M (+ p 19) OP-BIN BOP-ADD 2 0)
