 (let [p (dec i) n (gn-sir M (+ p 4) IF-B) out (gn-sir M (+ p 15) IF-B)
  bias (gn-sir M (+ p 36) IF-B) factor (gn-sir M (+ p 44) IF-B) stride (gn-sir M (+ p 53) IF-B) G (vector-alloc 33)
