  (td-distinct M j 1) (ga-regs M (inc j)))))
(defn- ga-shape [M :vector-i64 p :i64 f :i64 writer :i64 coord :i64 ca :i64 cb :i64] :bool
 (loop [k 0] (if (= k 104) true
  (let [packed (if (< k 52) (vector-at [2251829581185025 18 3932291081 8589934596 65539 65543 65544 257749577367563 12884901892 65539 65543 65544 3932946441 258024455274507 4294967300 8590000132 131075 562958246215693 562949964955662 4295032836 12885032964 196611 562962541182989 562954259922958 131079 257912786124811 4294967300 17179934724 8590065668 844428927893517 4295032836 8590065668 4295163907 562962541182989 562954259922958 12885032964 8590131204 4295229443 562966836150285 21475098628 25770131460 65541 4295098373 8590131205 12885164037 17180196869 21475229701 18 3932291082 3937009674 3935436809 4294967300] k) (vector-at [17179934724 12885032964 844428927893517 8590000132 4295098372 12885098500 4295229443 562966836150285 562958554890254 12885098500 4295229443 562966836150285 21475098628 25770131460 65541 4295098373 8590131205 12885164037 17180196869 21475229701 18 3932291082 3937009673 3938779146 3937140745 4294967300 17179934724 8590065668 196611 8590000135 8590000136 258067405078539 8590065668 3937927178 3937796105 12885032964 3937927177 844428927893517 458757 30064771076 17179934724 562953951313933 524293 30064771076 21474902020 34359869444 25770000388 4295229443 1407378881511437 3938779145 19 3997696002] (- k 52)))
   op (bit-and packed 65535) av (bit-and (i64-shift-right packed 16) 65535)
