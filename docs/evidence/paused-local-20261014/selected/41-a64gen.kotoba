       (= (inc k) n) (gn-emit M (enc-str 31 16 (* 8 k)))
       :else (gz-stores (gn-emit M (enc-stp 31 31 16 (* 8 k))) n (+ k 2))))
(defn- gz-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (gz-admit M i)) M
  (let [n (gn-sir M (+ (dec i) 4) IF-B)
        m0 (gn-emit M (enc-cmp-i 1 0)) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 8 (* 2 n)))) b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312))
                  (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 4 16 0))
                  (gn-emit (enc-cmp-i 4 n))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 328))
                  (gn-emit (gn-e-addsl 16 16 17 3)) (gz-stores n 0)
                  (gn-emit (enc-sub-i 8 8 (* 2 n))) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at m4 MM-CODE-N)]
   (-> m4 (gn-dot-patch b0 end (enc-cond-ne)) (gn-dot-patch b1 end (enc-cond-lo))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-lo))))))

(defn- gn-copy-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (gn-copy? M i)) M
  (let [p (dec i) n (gn-sir M (+ p 4) IF-B) dest (gn-sir M (+ p 11) IF-B)
        M0 (gn-emit M (enc-cmp-i 1 0)) b0 (vector-at M0 MM-CODE-N)
        M1 (-> M0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 8 (* 2 n)))) b1 (vector-at M1 MM-CODE-N)
        M2 (-> M1 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312))
                  (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at M2 MM-CODE-N)
        M3 (-> M2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 4 16 0))
                  (gn-mov-imm 16 (+ dest (dec n))) (gn-emit (enc-cmp-r 16 4))) b3 (vector-at M3 MM-CODE-N)
        M4 (-> M3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-i 4 n))) b4 (vector-at M4 MM-CODE-N)
        M5 (-> M4 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 2 7 328))
                  (gn-emit (gn-e-addsl 2 2 17 3)) (gn-mov-imm 16 (* 8 dest))
                  (gn-emit (enc-add-r 3 2 16)) (gn-mov-imm 4 n)) loop (vector-at M5 MM-CODE-N)
        M6 (-> M5 (gn-emit (enc-ldr 9 2 0)) (gn-emit (enc-str 9 3 0))
                  (gn-emit (enc-add-i 2 2 8)) (gn-emit (enc-add-i 3 3 8))
                  (gn-emit (enc-subs-i 4 4 1))) branch (vector-at M6 MM-CODE-N)
        M7 (-> M6 (gn-emit (enc-bcond (enc-cond-ne) (- loop branch)))
                  (gn-emit (enc-sub-i 8 8 (* 2 n))) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at M7 MM-CODE-N)]
   (-> M7 (gn-dot-patch b0 end (enc-cond-ne)) (gn-dot-patch b1 end (enc-cond-lo))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
          (gn-dot-patch b4 end (enc-cond-lo))))))

;; one SIR instruction (unreachable ones are dropped until the next LABEL / FN / END)
;; -1 means key0 OR the unchanged entry-root handle; positive slot means
;; every reaching path completed that slot's original checked access. Entry
;; does no speculative validation. Only such a positive witness crosses a tail.
(defn- gn-chain-step [M :vector-i64 i :i64 op :i64 a :i64] :vector-i64
 (if (not= (gn-g M gn-f-vmode) 2) (ve-step M i op a)
  (cond (or (= op OP-CONST) (= op OP-LGET) (= op OP-FUEL)) M
        (and (= op OP-BIN) (< a BOP-F64-ADD)) M
        (and (= op OP-CMP) (< a CC-F64-EQ)) M
        (and (= op OP-UN) (< a UOP-F64-NEG)) M
        (= op OP-LSET) (gn-vdrop M a)
        (= op OP-CALL) (let [w (gn-call-wrapper M i a (gn-sir M i IF-B) (gn-sir M i IF-C))]
          (if (or (> w 0) (and (= (gn-op M (inc i)) OP-RET) (= (gn-sir M (inc i) IF-A) (gn-sir M i IF-B)))
                  (jt-return M i (gn-sir M i IF-B))) M (gn-gs M gn-f-vslot 0)))
        (= op OP-RT) (if (or (= a RT-VECTOR-AT) (= a RT-VECTOR-ASSOC-IN-PLACE)) M (gn-gs M gn-f-vslot 0))
        :else (gn-gs M gn-f-vslot 0))))
;; Compile-time descriptor availability across a source-owned scalar call.
;; No runtime check or state. Every emitted effect must certify preservation.
(defn- dve-type [M :vector-i64 f :i64 n :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (<= (vector-at M MM-FN-N) MM-FN-CAP) (< f (vector-at M MM-FN-N)) (>= n 0) (<= n 3)
      (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-RTYPE) TY-I64)
      (loop [k 0] (or (= k n) (and (= (gn-fnf M f (+ FF-PT0 k)) TY-I64) (recur (inc k)))))))
(defn- dve-quiet [w :i64 r :i64] :bool
 (let [d (bit-and w 31)]
  (and (>= w 0) (<= w 4294967295) (not= d 3) (not= d 4) (not= d 7) (not= d r)
   (or (and (not= d 31)
        (or (= (bit-and w 0xffe0ffe0) 0xaa0003e0)
            (= (bit-and w 0xffc00000) 0xd2800000) (= (bit-and w 0xffc00000) 0xf2800000)
            (= (bit-and w 0xff000000) 0x91000000) (= (bit-and w 0xff000000) 0xd1000000) (= (bit-and w 0xffc00000) 0xf1000000)
            (= (bit-and w 0xff200000) 0x8b000000) (= (bit-and w 0xff200000) 0xcb000000)
            (= (bit-and w 0xff200000) 0x8a000000) (= (bit-and w 0xff200000) 0xaa000000)
            (= (bit-and w 0xff200000) 0xca000000)
            (= (bit-and w 0xffc00000) 0xd3400000) (= (bit-and w 0xffc00000) 0x93400000)
            (= (bit-and w 0xffe0fc00) 0x9b007c00)
            (= (bit-and w 0xffe00c00) 0x9a800000)
            (= (bit-and w 0xffc00000) 0xf9400000)
            (= (bit-and w 0xffe00c00) 0xf8600800)
            (= (bit-and w 0xffe0fc00) 0x9ac00c00)
            (= (bit-and w 0xffe0fc00) 0x9ac02000)
            (= (bit-and w 0xffe0fc00) 0x9ac02400)
            (= (bit-and w 0xffe0fc00) 0x9ac02800)
            (= (bit-and w 0xffe08000) 0x9b008000)
            (= (bit-and w 0xffe00000) 0x93c00000)
            (= (bit-and w 0x9f000000) 0x10000000)))
       (= (bit-and w 0xffe0fc1f) 0xeb00001f)
       (= (bit-and w 0xffc0001f) 0xf100001f)))))
(defn- dve-target [w :i64 at :i64] :i64
 (cond (= (bit-and w 0xfc000000) 0x14000000)
        (let [u (bit-and w 0x03ffffff)] (+ at (if (>= u 0x02000000) (- u 0x04000000) u)))
       (or (= (bit-and w 0xff000010) 0x54000000)
           (= (bit-and w 0x7e000000) 0x34000000))
        (let [u (bit-and (i64-shift-right w 5) 0x7ffff)] (+ at (if (>= u 0x40000) (- u 0x80000) u)))
       (= (bit-and w 0x7e000000) 0x36000000)
        (let [u (bit-and (i64-shift-right w 5) 0x3fff)] (+ at (if (>= u 0x2000) (- u 0x4000) u)))
       :else -1))
(defn- dve-effects [M :vector-i64 at :i64 begin :i64 end :i64 r :i64 left :i64] :bool
 (cond (= at end) true (or (<= left 0) (> at end)) false
  :else (let [w (vector-at M (+ MM-CODE-BASE at)) target (dve-target w at)
              okay (or (dve-quiet w r)
               (= w (enc-ldr 7 31 0))
               (= w (enc-str 8 7 CTX-FUEL)) (= w (enc-str 16 7 CTX-FUEL)) (= w (enc-str 31 7 CTX-FUEL))
               (= w (enc-brk 0)) (= w (enc-brk 1))
               (and (>= target begin) (<= target end)))]
   (and okay (dve-effects M (inc at) begin end r (dec left))))))
(defn- dve-fixes [M :vector-i64 j :i64 n :i64 begin :i64 end :i64 left :i64] :bool
 (cond (= j n) true (or (<= left 0) (> j n)) false
  :else (let [b (+ MM-FIX-BASE (* j MM-FIX-W)) at (vector-at M (+ b XF-AT))
              lit (vector-at M (+ b XF-TARGET))]
   (and (= (vector-at M (+ b XF-KIND)) FX-LIT32) (= (vector-at M (+ b XF-AUX)) 0)
        (> lit 0) (< lit (vector-at M MM-LIT-N))
        (>= at begin) (< (inc at) end)
        (= (bit-and (vector-at M (+ MM-CODE-BASE at)) 0xffe00000) 0xd2800000)
        (= (bit-and (vector-at M (+ MM-CODE-BASE at 1)) 0xffe00000) 0xf2a00000)
        (= (bit-and (vector-at M (+ MM-CODE-BASE at)) 31)
           (bit-and (vector-at M (+ MM-CODE-BASE at 1)) 31))
        (dve-fixes M (inc j) n begin end (dec left))))))
(defn- dve-original-ins [M :vector-i64 i :i64 op :i64] :vector-i64
 (ocb-post (gn-ins-quiet (vi-step (gn-chain-step M i op (gn-sir M i IF-A)) op (gn-sir M i IF-A)) i op) i op))
(defn- dve-domain [M :vector-i64 i :i64] :bool
 (if (< (vector-count M) MM-WORDS) false
  (let [g (vector-at M gn-cell) sn (vector-at M MM-SIR-N)]
   (and (>= g MM-HEAP-BASE) (<= (vector-at M MM-HEAP-TOP) MM-HEAP-END)
        (<= g (- (vector-at M MM-HEAP-TOP) (+ gn-a-sreg gn-cap)))
        (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)
        (> sn 0) (<= sn MM-SIR-CAP) (> i 0) (< i sn)))))
(defn- dve-owner [M :vector-i64 j :i64 left :i64] :i64
 (cond (or (<= j 0) (<= left 0)) 0
       (= (gn-op M j) OP-END) 0
       (= (gn-op M j) OP-FN)
        (let [f (gn-sir M j IF-A)]
         (if (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
                  (= (gn-fnf M f FF-SIR) j)
                  (= (gn-fnf M f FF-NPARAMS) (gn-sir M j IF-B))
                  (= (gn-fnf M f FF-NSLOTS) (gn-g M gn-f-ns))
                  (= (gn-fnf M f FF-DEPTH) (gn-g M gn-f-dp))) f 0))
       :else (dve-owner M (dec j) (dec left))))
(defn- dve-ins [M :vector-i64 i :i64 op :i64] :vector-i64
 (if (not (dve-domain M i)) (dve-original-ins M i op)
 (let [raw (gn-g M gn-f-vslot)
       slot (if (= (gn-g M gn-f-vmode) -1)
        (cond (and (< raw -1) (> raw (- -1 gn-cap))) (- -1 raw)
              (and (< raw (- -1 gn-cap)) (> raw (- -1 (* 2 gn-cap)))) (- (- -1 gn-cap) raw)
              :else raw) raw)
       ns (gn-g M gn-f-ns)
       r (if (and (> ns 0) (< ns gn-cap) (> slot 0) (<= slot ns) (< slot gn-cap)) (gn-sreg M slot) -1)
       begin (vector-at M MM-CODE-N) fix (vector-at M MM-FIX-N) labels (vector-at M MM-LABEL-N)
       eligible (and (= op OP-CALL) (= (gn-g M gn-f-vmode) -1)
        (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
        (>= r 19) (<= r 28) (> (gn-g M gn-f-fb) 0) (> (dve-owner M i 4096) 0) (dve-type M (gn-sir M i IF-A) (gn-sir M i IF-C)))
       out (dve-original-ins M i op)
       end (vector-at out MM-CODE-N)]
  (if (and eligible (= (vector-at out MM-ERR) 0)
       (= (gn-g out gn-f-vmode) -1) (= (gn-g out gn-f-leaf) 0) (= (gn-g out gn-f-dead) 0)
       (= (vector-at out MM-LABEL-N) labels) (>= fix 0) (>= (vector-at out MM-FIX-N) fix) (<= (vector-at out MM-FIX-N) MM-FIX-CAP)
       (> (vector-at out MM-LIT-N) 0) (<= (vector-at out MM-LIT-N) MM-LIT-CAP) (= (gn-g out gn-f-ns) ns) (= (gn-sreg out slot) r) (>= begin 0) (> end begin)
       (<= end MM-CODE-CAP) (<= (- end begin) 64)
       (dve-fixes out fix (vector-at out MM-FIX-N) begin end 16)
       (dve-effects out begin begin end r 64))
   (gn-gs out gn-f-vslot
    (if (and (< raw -1) (> slot 0) (<= slot ns) (< slot gn-cap))
     (- (- -1 gn-cap) slot) (- -1 slot))) out))))
(defn- gn-ins [M :vector-i64 i :i64 op :i64] :vector-i64
 (dve-ins M i op))
;; Generic exact typed two-i64 record copy. Success-only nonleaf fast path;
;; original entry charge/frame/body/invalid and insufficient-fuel fallback retained.
(defn- pc3-helper-type [M :vector-i64 f :i64 np :i64 rt :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
      (= (gn-fnf M f FF-NPARAMS) np) (= (gn-fnf M f FF-NSLOTS) np)
      (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-RTYPE) rt)
      (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
      (or (= np 2) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64))))
(defn- pc3-writer-shape [M :vector-i64 p :i64 f :i64] :bool
  (and
    (gn-dot-at? M p OP-FN f 3 3)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (and (> (gn-sir M (+ p 2) IF-A) 0) (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0) (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2)))
    (gn-dot-at? M (+ p 3) 4 0 1 0)
    (gn-dot-at? M (+ p 4) 4 1 2 0)
    (gn-dot-at? M (+ p 5) 4 2 3 0)
    (gn-dot-at? M (+ p 6) 14 208 0 3)
    (gn-dot-at? M (+ p 7) 19 0 0 0)
    (gn-dot-at? M (+ p 8) OP-END f 0 0)))
(defn- pc3-reader-shape [M :vector-i64 p :i64 f :i64] :bool
  (and
    (gn-dot-at? M p OP-FN f 2 2)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (and (> (gn-sir M (+ p 2) IF-A) 0) (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0) (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2)))
    (gn-dot-at? M (+ p 3) 4 0 1 0)
    (gn-dot-at? M (+ p 4) 4 1 2 0)
    (gn-dot-at? M (+ p 5) 3 2 2 0)
    (gn-dot-at? M (+ p 6) 6 3 1 0)
    (gn-dot-at? M (+ p 7) 14 176 0 2)
    (gn-dot-at? M (+ p 8) 19 0 0 0)
    (gn-dot-at? M (+ p 9) OP-END f 0 0)))
(defn- pc3-shape [M :vector-i64 p :i64 f :i64 reader :i64 writer :i64] :bool
  (and
    (gn-dot-at? M p OP-FN f 3 5)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (and (> (gn-sir M (+ p 2) IF-A) 0) (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0) (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2)))
    (gn-dot-at? M (+ p 3) 4 0 1 0)
    (gn-dot-at? M (+ p 4) 4 1 3 0)
    (gn-dot-at? M (+ p 5) OP-CALL reader 0 2)
    (gn-dot-at? M (+ p 6) 5 4 0 0)
    (gn-dot-at? M (+ p 7) 4 0 1 0)
    (gn-dot-at? M (+ p 8) 4 1 3 0)
    (gn-dot-at? M (+ p 9) 3 2 2 0)
    (gn-dot-at? M (+ p 10) 6 3 1 0)
    (gn-dot-at? M (+ p 11) 3 2 1 0)
    (gn-dot-at? M (+ p 12) 6 1 1 0)
    (gn-dot-at? M (+ p 13) 14 176 0 2)
    (gn-dot-at? M (+ p 14) 5 5 0 0)
    (gn-dot-at? M (+ p 15) 4 0 1 0)
    (gn-dot-at? M (+ p 16) 4 1 2 0)
    (gn-dot-at? M (+ p 17) 3 2 2 0)
    (gn-dot-at? M (+ p 18) 6 3 1 0)
    (gn-dot-at? M (+ p 19) 4 2 4 0)
    (gn-dot-at? M (+ p 20) OP-CALL writer 0 3)
    (gn-dot-at? M (+ p 21) 4 1 2 0)
    (gn-dot-at? M (+ p 22) 3 2 2 0)
    (gn-dot-at? M (+ p 23) 6 3 1 0)
    (gn-dot-at? M (+ p 24) 3 2 1 0)
    (gn-dot-at? M (+ p 25) 6 1 1 0)
    (gn-dot-at? M (+ p 26) 4 2 5 0)
    (gn-dot-at? M (+ p 27) OP-CALL writer 0 3)
    (gn-dot-at? M (+ p 28) 19 0 0 0)
    (gn-dot-at? M (+ p 29) OP-END f 0 0)))
(defn- pc3-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (>= (+ i 28) (vector-at M MM-SIR-N)) (not= (gn-op M (dec i)) OP-FN)) false
 (let [p (dec i) f (gn-sir M p IF-A) reader (gn-sir M (+ p 5) IF-A)
       writer (gn-sir M (+ p 20) IF-A) rv (gn-sreg M 1) rd (gn-sreg M 2) rs (gn-sreg M 3)]
  (and (> p 0) (< (+ p 29) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 3)
       (= (gn-fnf M f FF-NSLOTS) 5) (= (gn-fnf M f FF-DEPTH) 3)
       (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
       (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-ctx) 1)
       (>= rv 19) (<= rv 28) (>= rd 19) (<= rd 28) (>= rs 19) (<= rs 28)
       (not= rv rd) (not= rv rs) (not= rd rs)
       (pc3-helper-type M reader 2 TY-I64) (pc3-helper-type M writer 3 TY-VEC)
       (> (gn-fnf M reader FF-SIR) 0) (< (+ (gn-fnf M reader FF-SIR) 9) (vector-at M MM-SIR-N))
       (> (gn-fnf M writer FF-SIR) 0) (< (+ (gn-fnf M writer FF-SIR) 8) (vector-at M MM-SIR-N))
       (pc3-reader-shape M (gn-fnf M reader FF-SIR) reader)
       (pc3-writer-shape M (gn-fnf M writer FF-SIR) writer)
       (pc3-shape M p f reader writer)))))
(defn- pc3-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (pc3-admit M i)) M
  (let [rv (gn-sreg M 1) rd (gn-sreg M 2) rs (gn-sreg M 3)
        m0 (-> M (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 3))) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-mov-imm 16 4611686018427387904) (gn-emit (enc-cmp-r rs 16))) b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r rd 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 312))
                  (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 3 4 16 0))
                  (gn-emit (gn-e-lsl 1 rs 1)) (gn-emit (gn-e-lsl 2 rd 1))
                  (gn-emit (enc-add-i 17 1 1)) (gn-emit (enc-cmp-r 17 4))) b4 (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-add-i 17 2 1)) (gn-emit (enc-cmp-r 17 4))) b5 (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 6 7 328))
                  (gn-emit (enc-add-r 5 3 1)) (gn-emit (enc-add-r 17 3 2))
                  (gn-emit (gn-e-addsl 5 6 5 3)) (gn-emit (gn-e-addsl 6 6 17 3))
                  (gn-emit (enc-ldp 1 2 5 0)) (gn-emit (enc-sub-i 8 8 3))
                  (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-stp 1 2 6 0))
                  (gn-mov 0 rv) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at m6 MM-CODE-N)]
   (-> m6 (gn-dot-patch b0 end (enc-cond-lo)) (gn-dot-patch b1 end (enc-cond-hs))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
          (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-hs))))))

;; Bounded closed constant-index copy/write tail intervals. All original
;; charges and partial writes remain in the fallback; complete safe budget
;; and descriptor range permit exact successful aggregate charging.
(defn- cw-type [M :vector-i64 f :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
      (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f FF-RTYPE) TY-VEC)))
(defn- cw-value-end [M :vector-i64 q :i64] :i64
 (let [read (gn-dot-at? M q OP-LGET 0 1 0)
       b (if read (+ q 3) (inc q))]
  (if (and (if read
    (and (gn-dot-at? M (inc q) OP-CONST 1 (gn-sir M (inc q) IF-B) 0)
         (>= (gn-sir M (inc q) IF-B) 0) (<= (gn-sir M (inc q) IF-B) 4095)
         (gn-dot-at? M (+ q 2) OP-RT RT-VECTOR-AT 0 2))
    (gn-dot-at? M q OP-CONST 0 (gn-sir M q IF-B) 0))
   (or (= (gn-op M b) OP-LSET)
       (and (gn-dot-at? M b OP-CALL (gn-sir M b IF-A) 0 1)
            (> (gn-sign-wrapper M (gn-sir M b IF-A) 1) 0)
            (< (gn-sign-wrapper M (gn-sir M b IF-A) 1) 1536)
            (not (gn-clamp-open M (gn-sir M b IF-A))))))
   (if (= (gn-op M b) OP-CALL) (inc b) b) 0)))
(defn- cw-stage [M :vector-i64 f :i64] :i64
 (if (not (cw-type M f)) 0
  (let [p (gn-fnf M f FF-SIR) q (+ p 3)]
   (if (or (<= p 0) (>= (+ p 16) (vector-at M MM-SIR-N))
           (not= (gn-fnf M f FF-NSLOTS) 3) (not= (gn-fnf M f FF-DEPTH) 3)
           (not (gn-dot-at? M p OP-FN f 1 3))
           (not (gn-dot-at? M (inc p) OP-FUEL 0 0 0))
           (not (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0))
           (<= (gn-sir M (+ p 2) IF-A) 0) (>= (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
           (not= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))) 0
    (let [v (cw-value-end M q) put (gn-sir M (+ v 6) IF-A)
          next (gn-sir M (+ v 7) IF-A) index (gn-sir M (inc v) IF-B)]
     (if (and (> v 0) (< (+ v 9) (vector-at M MM-SIR-N))
       (gn-dot-at? M v OP-LSET 2 0 0)
       (>= index 0) (<= index 4095) (gn-dot-at? M (inc v) OP-CONST 0 index 0)
       (gn-dot-at? M (+ v 2) OP-LSET 3 0 0)
       (gn-dot-at? M (+ v 3) OP-LGET 0 1 0)
       (gn-dot-at? M (+ v 4) OP-LGET 1 3 0)
       (gn-dot-at? M (+ v 5) OP-LGET 2 2 0)
       (gn-dot-at? M (+ v 6) OP-CALL put 0 3)
       (> put 0) (< put (vector-at M MM-FN-N)) (not (gn-clamp-open M put))
       (= (gn-wrapper M put 0 3) (+ RT-VECTOR-ASSOC-IN-PLACE 256))
       (= (gn-fnf M put FF-PT0) TY-VEC) (= (gn-fnf M put (+ FF-PT0 1)) TY-I64)
       (= (gn-fnf M put (+ FF-PT0 2)) TY-I64) (= (gn-fnf M put FF-RTYPE) TY-VEC)
       (gn-dot-at? M (+ v 7) OP-CALL next 0 1) (cw-type M next)
       (gn-dot-at? M (+ v 8) OP-RET 0 0 0)
       (gn-dot-at? M (+ v 9) OP-END f 0 0)) q 0))))))
(defn- cw-next [M :vector-i64 q :i64] :i64 (gn-sir M (+ (cw-value-end M q) 7) IF-A))
(defn- cw-sign [M :vector-i64 q :i64] :i64
 (let [v (cw-value-end M q)]
  (if (= (gn-op M (dec v)) OP-CALL) (gn-sign-wrapper M (gn-sir M (dec v) IF-A) 1) 0)))
(defn- cw-count [M :vector-i64 f :i64 left :i64] :i64
 (let [q (cw-stage M f)]
  (if (or (= left 0) (= q 0)) 0 (inc (cw-count M (cw-next M q) (dec left))))))
(defn- cw-budget [M :vector-i64 f :i64 n :i64] :i64
 (if (= n 0) 0 (let [q (cw-stage M f)]
  (+ 2 (if (>= (cw-sign M q) 1536) 1 0) (cw-budget M (cw-next M q) (dec n))))))
(defn- cw-max [M :vector-i64 f :i64 n :i64] :i64
 (if (= n 0) 0 (let [q (cw-stage M f) v (cw-value-end M q)
   index (gn-sir M (inc v) IF-B) read (if (= (gn-op M q) OP-LGET) (gn-sir M (inc q) IF-B) 0)]
  (gn-max (gn-max index read) (cw-max M (cw-next M q) (dec n))))))
(defn- cw-head [M :vector-i64 j :i64 owner :i64 f :i64] :bool
 (if (>= j (vector-at M MM-SIR-N)) false
  (let [op (gn-op M j) a (gn-sir M j IF-A)]
   (if (and (= op OP-CALL) (= a f)
       (let [q (cw-stage M owner)] (or (= q 0) (not= (cw-next M q) f)))) true
    (cw-head M (inc j) (if (= op OP-FN) a owner) f)))))
(defn- cw-emit [M :vector-i64 f :i64 n :i64] :vector-i64
 (if (= n 0) (-> M (gn-vclear) (gn-fix FX-BL26 f) (gn-emit (enc-b 0)))
  (let [q (cw-stage M f) v (cw-value-end M q) sign (cw-sign M q)
        index (gn-sir M (inc v) IF-B)]
   (cw-emit (-> M
     (cond-> (= (gn-op M q) OP-LGET) (gn-emit (enc-ldr 9 10 (* 8 (gn-sir M (inc q) IF-B)))))
     (cond-> (= (gn-op M q) OP-CONST) (gn-mov-imm 9 (gn-sir M q IF-B)))
     (cond-> (> sign 0) (gn-emit (gn-e-bf 0x93400000 9 9 0 (dec (bit-and sign 511)))))
     (gn-emit (enc-str 9 10 (* 8 index)))) (cw-next M q) (dec n)))))
;; ADR0357: same-register store-to-load availability in existing CW admission.
;; No publication is removed. All preflight helpers are read-only; false keeps
;; the original explicit reload. Counts precede every variable-address lookup.
(defn- cfr-signed [v :i64 sign :i64 modulus :i64] :i64
 (if (>= v sign) (- v modulus) v))
(defn- cfr-labels [M :vector-i64 j :i64 total :i64 at :i64] :bool
 (if (= j total) true
  (let [v (vector-at M (+ MM-LABEL-BASE j))]
   (and (>= v 0) (< v MM-CODE-CAP) (not= v at)
        (cfr-labels M (inc j) total at)))))
(defn- cfr-functions [M :vector-i64 j :i64 total :i64 at :i64] :bool
 (if (= j total) true
  (let [v (gn-fnf M j FF-CODE)]
   (and (>= v 0) (< v at) (cfr-functions M (inc j) total at)))))
(defn- cfr-fixes [M :vector-i64 j :i64 total :i64 at :i64 nf :i64 ln :i64 lit :i64] :bool
 (if (= j total) true
  (let [b (+ MM-FIX-BASE (* j MM-FIX-W))
        site (vector-at M (+ b XF-AT)) kind (vector-at M (+ b XF-KIND))
        target (vector-at M (+ b XF-TARGET)) aux (vector-at M (+ b XF-AUX))]
   (if (or (<= site 0) (>= site (- at 6)) (< kind FX-B26) (> kind FX-ADRL19)) false
    (let [ok (cond (= kind FX-LIT32)
                   (and (= aux 0) (> target 0) (< target lit) (< (inc site) (- at 6)))
               (or (= kind FX-BL26) (= kind FX-ADR19))
                   (if (or (<= target 0) (>= target nf)) false
                    (let [entry (gn-fnf M target FF-CODE)]
                     (and (>= entry 0) (< entry at)
                          (if (= aux 0) true
                           (and (= kind FX-BL26) (or (= aux 1) (= aux 2))
                                (or (= entry 0) (< (+ entry aux) at)))))))
               :else (and (= aux 0) (> target 0) (< target ln)
                          (> (vector-at M (+ MM-LABEL-BASE target)) 0)
                          (< (vector-at M (+ MM-LABEL-BASE target)) at)))]
     (and ok (cfr-fixes M (inc j) total at nf ln lit)))))))
(defn- cfr-code [M :vector-i64 j :i64 at :i64] :bool
 (if (= j at) true
  (let [w (vector-at M (+ MM-CODE-BASE j))]
   (if (or (< w 0) (> w 4294967295)) false
    (let [branch26 (= (bit-and w 2080374784) 335544320)
          branch19 (or (= (bit-and w 4278190096) 1409286144)
                       (= (bit-and w 2113929216) 872415232))
          branch14 (= (bit-and w 2113929216) 905969664)
          literal (= (bit-and w 989855744) 402653184)
          adr (= (bit-and w 2667577344) 268435456)
          adrp (= (bit-and w 2667577344) 2415919104)
          delta (cond branch26 (cfr-signed (bit-and w 67108863) 33554432 67108864)
                   (or branch19 literal) (cfr-signed (bit-and (u64-shift-right w 5) 524287) 262144 524288)
                   branch14 (cfr-signed (bit-and (u64-shift-right w 5) 16383) 8192 16384)
                   :else 0)
          adelta (if adr (cfr-signed
                    (+ (* 4 (bit-and (u64-shift-right w 5) 524287))
                       (bit-and (u64-shift-right w 29) 3)) 1048576 2097152) 0)]
     (and (not adrp)
          (not (and (or branch26 branch19 branch14 literal) (= (+ j delta) at)))
          (not (and adr (= (+ (* 4 (dec j)) adelta) (* 4 (dec at)))))
          (cfr-code M (inc j) at)))))))
(defn- cfr-paid [M :vector-i64 i :i64 f :i64] :bool
 (let [sn (vector-at M MM-SIR-N) nf (vector-at M MM-FN-N)
       cn (vector-at M MM-CODE-N) ln (vector-at M MM-LABEL-N) xn (vector-at M MM-FIX-N) lit (vector-at M MM-LIT-N)]
  (if (or (<= sn 1) (> sn MM-SIR-CAP) (<= i 1) (>= i sn)
          (<= nf 1) (> nf MM-FN-CAP) (<= f 0) (>= f nf)
          (< cn 7) (>= cn MM-CODE-CAP)
          (< ln 1) (> ln MM-LABEL-CAP) (< xn 1) (> xn MM-FIX-CAP)
          (< lit 1) (> lit MM-LIT-CAP)) false
   (and (= (gn-g M gn-f-leaf) 2) (= (gn-g M gn-f-freg) 2)
        (= (gn-g M gn-f-vmode) 2) (= (gn-g M gn-f-fb) 0)
        (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
        (= (gn-fnf M f FF-SIR) (dec i)) (= (gn-fnf M f FF-CODE) (- cn 6))
        (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-NPARAMS) 1)
        (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 3)
        (= (gn-op M (dec i)) OP-FN) (= (gn-sir M (dec i) IF-A) f)
        (= (gn-sir M (dec i) IF-B) 1) (= (gn-sir M (dec i) IF-C) 3)
        (= (gn-op M i) OP-FUEL) (= (gn-sir M i IF-A) 0)
        (= (gn-sir M i IF-B) 0) (= (gn-sir M i IF-C) 0)
        (= (vector-at M (+ MM-CODE-BASE (- cn 6))) (enc-movz 5 0 0))
        (= (vector-at M (+ MM-CODE-BASE (- cn 5))) (enc-ldr 8 7 CTX-FUEL))
        (= (vector-at M (+ MM-CODE-BASE (- cn 4))) (enc-subs-i 8 8 1))
        (= (vector-at M (+ MM-CODE-BASE (- cn 3))) (enc-bcond (enc-cond-hs) 2))
        (= (vector-at M (+ MM-CODE-BASE (- cn 2))) (enc-brk 0))
        (= (vector-at M (+ MM-CODE-BASE (dec cn))) (enc-str 8 7 CTX-FUEL))
        (cfr-labels M 1 ln cn) (cfr-functions M 1 nf cn)
        (cfr-fixes M 1 xn cn nf ln lit) (cfr-code M 1 cn)))))

(defn- cw-entry [M :vector-i64 i :i64] :vector-i64
 (if (or (<= i 1) (not= (gn-op M (dec i)) OP-FN)
         (not= (gn-g M gn-f-leaf) 2) (not= (gn-g M gn-f-freg) 2)
         (not= (gn-g M gn-f-vmode) 2) (not= (gn-g M gn-f-fb) 0)) M
  (let [f (gn-sir M (dec i) IF-A) n (cw-count M f 16)]
   (if (or (< n 4) (not (cw-head M 1 0 f))) M
    (let [cost (dec (cw-budget M f n)) high (cw-max M f n)
          m0 (-> M (cond-> (not (cfr-paid M i f)) (gn-emit (enc-ldr 8 7 CTX-FUEL)))
                    (gn-emit (enc-cmp-i 8 cost))) b0 (vector-at m0 MM-CODE-N)
          m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312))
                   (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
                   (gn-emit (enc-cmp-r 17 16))) b1 (vector-at m1 MM-CODE-N)
          m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                   (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
                   (gn-emit (enc-cmp-i 16 high))) b2 (vector-at m2 MM-CODE-N)
          m3 (-> m2 (gn-emit (enc-bcond 9 0)) (gn-emit (enc-ldr 10 7 328))
                   (gn-emit (gn-e-addsl 10 10 17 3)) (gn-emit (enc-sub-i 8 8 cost))
                   (gn-emit (enc-str 8 7 CTX-FUEL)) (cw-emit f n))
          end (vector-at m3 MM-CODE-N)]
     (-> m3 (gn-dot-patch b0 end (enc-cond-lo)) (gn-dot-patch b1 end (enc-cond-hs))
            (gn-dot-patch b2 end 9)))))))

;; Complete guarded dual affine-reader reduction interval. Exact closed shape,
;; whole bounded index envelopes and fuel proved before any changed effect.
(defn- dr-shape [M :vector-i64 i :i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR) total (vector-at M MM-SIR-N)]
   (if (or (<= p 0) (> p (- total 7))) 0
    (let [d (if (= (gn-sir M (+ p 5) IF-A) CC-GT) 2 0) lh (gn-sir M (+ p 2) IF-A) lb (gn-sir M (+ p 9) IF-A)
          le (gn-sir M (+ p 34 d) IF-A) reader (gn-sir M (+ p 20 d) IF-A)
          q (mr-reader M (+ p 20 d) reader 3)]
     (if (and (<= p (- total (+ 37 d))) (> q 0) (gn-dot-at? M (inc (gn-fnf M reader FF-SIR)) OP-FUEL 0 0 0)
       (> (gn-sir M (+ q 2) IF-B) 0) (<= (gn-sir M (+ q 2) IF-B) 4095)
       (= (gn-fnf M f FF-NPARAMS) 5) (= (gn-fnf M f FF-NSLOTS) 5)
       (= (gn-fnf M f FF-DEPTH) 9) (= (gn-fnf M f FF-RTYPE) TY-I64)
       (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
       (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
       (> lh 0) (< lh MM-LABEL-CAP) (> lb 0) (< lb MM-LABEL-CAP)
       (> le 0) (< le MM-LABEL-CAP) (not= lh lb) (not= lh le) (not= lb le)
       (= (gn-lpos M lh) (+ p 2)) (= (gn-lpos M lb) (+ p 9)) (= (gn-lpos M le) (+ p 34 d))
       (if (= d 0) (and
       (gn-dot-at? M (+ p 0) OP-FN f 5 5)
       (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL lh 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
       (gn-dot-at? M (+ p 4) OP-LGET 1 3 0)
       (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
       (gn-dot-at? M (+ p 6) OP-BRZ 0 lb 0)
       (gn-dot-at? M (+ p 7) OP-LGET 0 5 0)
       (gn-dot-at? M (+ p 8) OP-BR le 0 0)
       (gn-dot-at? M (+ p 9) OP-LABEL lb 0 0)
       (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
       (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
       (gn-dot-at? M (+ p 13) OP-LGET 3 4 0)
       (gn-dot-at? M (+ p 14) OP-CONST 4 1 0)
       (gn-dot-at? M (+ p 15) OP-BIN BOP-ADD 3 0)
       (gn-dot-at? M (+ p 16) OP-LGET 4 5 0)
       (gn-dot-at? M (+ p 17) OP-LGET 5 1 0)
       (gn-dot-at? M (+ p 18) OP-LGET 6 2 0)
       (gn-dot-at? M (+ p 19) OP-LGET 7 4 0)
       (gn-dot-at? M (+ p 20) OP-CALL reader 5 3)
       (gn-dot-at? M (+ p 21) OP-LGET 6 1 0)
       (gn-dot-at? M (+ p 22) OP-LGET 7 4 0)
       (gn-dot-at? M (+ p 23) OP-LGET 8 3 0)
       (gn-dot-at? M (+ p 24) OP-CALL reader 6 3)
       (gn-dot-at? M (+ p 25) OP-BIN BOP-MUL 5 0)
       (gn-dot-at? M (+ p 26) OP-BIN BOP-SUB 4 0)
       (gn-dot-at? M (+ p 27) OP-LSET 1 0 0)
       (gn-dot-at? M (+ p 28) OP-LSET 2 1 0)
       (gn-dot-at? M (+ p 29) OP-LSET 3 2 0)
       (gn-dot-at? M (+ p 30) OP-LSET 4 3 0)
       (gn-dot-at? M (+ p 31) OP-LSET 5 4 0)
       (gn-dot-at? M (+ p 32) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 33) OP-BR lh 0 0)
       (gn-dot-at? M (+ p 34) OP-LABEL le 0 0)
       (gn-dot-at? M (+ p 35) OP-RET 0 0 0)
       (gn-dot-at? M (+ p 36) OP-END f 0 0)
        ) (and
       (gn-dot-at? M (+ p 0) OP-FN f 5 5)
       (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL lh 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
       (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 5) OP-CMP CC-GT 0 0)
       (gn-dot-at? M (+ p 6) OP-BRZ 0 lb 0)
       (gn-dot-at? M (+ p 7) OP-LGET 0 5 0)
       (gn-dot-at? M (+ p 8) OP-BR le 0 0)
       (gn-dot-at? M (+ p 9) OP-LABEL lb 0 0)
       (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
       (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
       (gn-dot-at? M (+ p 13) OP-LGET 3 4 0)
       (gn-dot-at? M (+ p 14) OP-CONST 4 1 0)
       (gn-dot-at? M (+ p 15) OP-BIN BOP-ADD 3 0)
       (gn-dot-at? M (+ p 16) OP-LGET 4 5 0)
       (gn-dot-at? M (+ p 17) OP-LGET 5 1 0)
       (gn-dot-at? M (+ p 18) OP-LGET 6 2 0)
       (gn-dot-at? M (+ p 19) OP-CONST 7 1 0)
       (gn-dot-at? M (+ p 20) OP-BIN BOP-ADD 6 0)
       (gn-dot-at? M (+ p 21) OP-LGET 7 4 0)
       (gn-dot-at? M (+ p 22) OP-CALL reader 5 3)
       (gn-dot-at? M (+ p 23) OP-LGET 6 1 0)
       (gn-dot-at? M (+ p 24) OP-LGET 7 4 0)
       (gn-dot-at? M (+ p 25) OP-LGET 8 3 0)
       (gn-dot-at? M (+ p 26) OP-CALL reader 6 3)
       (gn-dot-at? M (+ p 27) OP-BIN BOP-MUL 5 0)
       (gn-dot-at? M (+ p 28) OP-BIN BOP-SUB 4 0)
       (gn-dot-at? M (+ p 29) OP-LSET 1 0 0)
       (gn-dot-at? M (+ p 30) OP-LSET 2 1 0)
       (gn-dot-at? M (+ p 31) OP-LSET 3 2 0)
       (gn-dot-at? M (+ p 32) OP-LSET 4 3 0)
       (gn-dot-at? M (+ p 33) OP-LSET 5 4 0)
       (gn-dot-at? M (+ p 34) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 35) OP-BR lh 0 0)
       (gn-dot-at? M (+ p 36) OP-LABEL le 0 0)
       (gn-dot-at? M (+ p 37) OP-RET 0 0 0)
       (gn-dot-at? M (+ p 38) OP-END f 0 0)
        ))
      ) q 0))))))
(defn- dr-patch [M :vector-i64 branches :vector-i64 end :i64 j :i64] :vector-i64
 (if (= j (vector-count branches)) M
  (dr-patch (gn-dot-patch M (vector-at branches j) end 8) branches end (inc j))))
(defn- dr-entry [M :vector-i64 i :i64] :vector-i64
 (if (or (<= i 1) (not= (gn-op M (dec i)) OP-FN)
    (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
    (not= (gn-g M gn-f-vmode) 0)
    (or (< (gn-sreg M 1) 19) (> (gn-sreg M 1) 28)) (or (< (gn-sreg M 2) 19) (> (gn-sreg M 2) 28)) (or (< (gn-sreg M 3) 19) (> (gn-sreg M 3) 28)) (or (< (gn-sreg M 4) 19) (> (gn-sreg M 4) 28)) (or (< (gn-sreg M 5) 19) (> (gn-sreg M 5) 28))) M
  (let [f (gn-sir M (dec i) IF-A) q (dr-shape M i f)]
   (if (= q 0) M
    (let [stride (gn-sir M (+ q 2) IF-B)
      upper (= (gn-sir M (+ (gn-fnf M f FF-SIR) 5) IF-A) CC-GT)
      m0 (-> M (gn-mov 0 (gn-sreg M 1)) (gn-mov 1 (gn-sreg M 2))
               (gn-mov 2 (gn-sreg M 3)) (gn-mov 3 (gn-sreg M 4)) (gn-mov 9 (gn-sreg M 5))
               (gn-emit (enc-cmp-i 1 64))) b0 (vector-at m0 MM-CODE-N)
      m1 (-> m0 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-i 2 64))) b1 (vector-at m1 MM-CODE-N)
      m2 (-> m1 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-i 3 64))) b2 (vector-at m2 MM-CODE-N)
      m3 (-> m2 (gn-emit (enc-bcond 8 0))
                (cond-> upper (gn-emit (enc-add-i 1 1 1)))
                (gn-mov 4 (if upper 1 2)) (gn-emit (enc-cmp-r 3 4))) b3 (vector-at m3 MM-CODE-N)
      m4 (-> m3 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-sub-r 13 4 3))
                (gn-emit (enc-cmp-i 13 64))) b4 (vector-at m4 MM-CODE-N)
      m5 (-> m4 (gn-emit (enc-bcond 8 0)) (gn-mov-imm 5 stride) (gn-mov-imm 16 3)
                (gn-emit (enc-mul 15 13 16)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
                (gn-emit (enc-cmp-r 15 8))) b5 (vector-at m5 MM-CODE-N)
      m6 (-> m5 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-ldr 16 7 312))
                (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
                (gn-emit (enc-cmp-r 17 16))) b6 (vector-at m6 MM-CODE-N)
      m7 (-> m6 (gn-emit (enc-bcond 2 0)) (gn-emit (enc-ldr 16 7 320))
                (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
                (gn-emit (enc-sub-i 12 4 1)) (gn-emit (enc-mul 11 1 5))
                (gn-emit (enc-add-r 11 11 12)) (gn-emit (enc-cmp-r 11 16))) b7 (vector-at m7 MM-CODE-N)
      m8 (-> m7 (gn-emit (enc-bcond 2 0)) (gn-emit (enc-mul 11 12 5))
                (gn-emit (enc-add-r 11 11 2)) (gn-emit (enc-cmp-r 11 16))) b8 (vector-at m8 MM-CODE-N)
      m9 (-> m8 (gn-emit (enc-bcond 2 0)) (gn-emit (enc-ldr 10 7 328))
                (gn-emit (gn-e-addsl 10 10 17 3)) (gn-emit (enc-sub-r 8 8 15))
                (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-mul 11 1 5))
                (gn-emit (enc-add-r 11 11 3)) (gn-emit (enc-mul 6 3 5))
                (gn-emit (enc-add-r 6 6 2)) (gn-emit (enc-cmp-i 13 0))) bz (vector-at m9 MM-CODE-N)
      m10 (gn-emit m9 (enc-bcond (enc-cond-eq) 0)) loop (vector-at m10 MM-CODE-N)
      m11 (-> m10 (gn-emit (gn-e-ldrr 12 10 11 1)) (gn-emit (gn-e-ldrr 14 10 6 1))
                 (gn-emit (enc-mul 12 12 14)) (gn-emit (enc-sub-r 9 9 12))
                 (gn-emit (enc-add-i 11 11 1)) (gn-emit (enc-add-r 6 6 5))
                 (gn-emit (enc-subs-i 13 13 1))) back (vector-at m11 MM-CODE-N)
      m12 (gn-emit m11 (enc-bcond (enc-cond-ne) (- loop back))) done (vector-at m12 MM-CODE-N)
      m13 (-> m12 (gn-mov 0 9) (gn-epilogue) (gn-gs gn-f-dead 0)) end (vector-at m13 MM-CODE-N)
      m14 (dr-patch m13 [b0 b1 b2 b3 b4 b5] end 0)]
     (-> m14 (gn-dot-patch b6 end 2) (gn-dot-patch b7 end 2)
               (gn-dot-patch b8 end 2) (gn-dot-patch bz done (enc-cond-eq))))))))

(defn- td-nf [M :vector-i64 n :i64 field :i64] :i64
 (if (and (> n 0) (< n (vector-at M MM-NODE-N)) (< n MM-NODE-CAP))
  (vector-at M (+ MM-NODE-BASE (* n MM-NODE-W) field)) 0))
(defn- td-nth [M :vector-i64 n :i64 k :i64] :i64
 (loop [c (td-nf M n NF-FIRST) j 0]
  (cond (= c 0) 0 (= j k) c :else (recur (td-nf M c NF-NEXT) (inc j)))))
(defn- td-pt [M :vector-i64 f :i64 j :i64] :i64
 (if (< j 5) (gn-fnf M f (+ FF-PT0 j))
  (td-nf M (td-nth M (td-nth M (gn-fnf M f FF-NODE) 2) (inc (* 2 j))) NF-TYPE)))
(defn- td-types [M :vector-i64 f :i64 n :i64 j :i64] :bool
 (if (= j n) true (and (= (td-pt M f j) TY-I64) (td-types M f n (inc j)))))
(defn- td-type [M :vector-i64 f :i64 n :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
      (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) n)
      (= (gn-fnf M f FF-DEPTH) (if (= n 4) 3 n)) (= (gn-fnf M f FF-RTYPE) TY-I64)
      (td-types M f n 0)))
(defn- td-byte [M :vector-i64 f :i64] :bool
 (if (not (td-type M f 2)) false
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (inc p) IF-A)]
   (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 9)) (> l 0) (< l MM-LABEL-CAP)
    
    (gn-dot-at? M p OP-FN f 2 2) (gn-dot-at? M (inc p) OP-LABEL l 0 0)
    (gn-dot-at? M (+ p 2) OP-LGET 0 1 0) (gn-dot-at? M (+ p 3) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 4) OP-BIN BOP-USHR 0 0)
    (gn-dot-at? M (+ p 5) OP-CONST 1 255 0) (gn-dot-at? M (+ p 6) OP-BIN BOP-AND 0 0)
    (gn-dot-at? M (+ p 7) OP-RET 0 0 0) (gn-dot-at? M (+ p 8) OP-END f 0 0)))))
(defn- td-xor4 [M :vector-i64 f :i64] :bool
 (if (not (td-type M f 4)) false
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (inc p) IF-A)]
   (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 11)) (> l 0) (< l MM-LABEL-CAP)
    
    (gn-dot-at? M p OP-FN f 4 4) (gn-dot-at? M (inc p) OP-LABEL l 0 0)
    (gn-dot-at? M (+ p 2) OP-LGET 0 1 0) (gn-dot-at? M (+ p 3) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 4) OP-BIN BOP-XOR 0 0) (gn-dot-at? M (+ p 5) OP-LGET 1 3 0)
    (gn-dot-at? M (+ p 6) OP-LGET 2 4 0) (gn-dot-at? M (+ p 7) OP-BIN BOP-XOR 1 0)
    (gn-dot-at? M (+ p 8) OP-BIN BOP-XOR 0 0)
    (gn-dot-at? M (+ p 9) OP-RET 0 0 0) (gn-dot-at? M (+ p 10) OP-END f 0 0)))))
(defn- td-xor5 [M :vector-i64 f :i64] :bool
 (if (not (td-type M f 5)) false
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (+ p 2) IF-A)]
   (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 12)) (> l 0) (< l MM-LABEL-CAP)
    
    (gn-dot-at? M p OP-FN f 5 5) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL l 0 0)
    (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 5) OP-LGET 2 3 0) (gn-dot-at? M (+ p 6) OP-LGET 3 4 0)
    (gn-dot-at? M (+ p 7) OP-LGET 4 5 0)
    (gn-dot-at? M (+ p 8) OP-CALL (gn-sir M (+ p 8) IF-A) 1 4)
    (td-xor4 M (gn-sir M (+ p 8) IF-A))
    (gn-dot-at? M (+ p 9) OP-BIN BOP-XOR 0 0)
    (gn-dot-at? M (+ p 10) OP-RET 0 0 0) (gn-dot-at? M (+ p 11) OP-END f 0 0)))))
(defn- td-table [M :vector-i64 f :i64] :bool
 (let [lit (tb-shape M f)]
  (and (> lit 0)
       (>= (+ (gn-litf M lit LF-LEN) (gn-litf M (inc lit) LF-LEN)) 2048)
       (= (gn-litf M (inc lit) LF-B) (+ (gn-litf M lit LF-B) (gn-litf M lit LF-LEN))))))
(defn- td-groups [M :vector-i64 p :i64 j :i64] :bool
 (if (= j 5) true
  (let [q (+ p 4 (* (dec j) 15)) le (gn-sir M (+ q 9) IF-A)
       lx (gn-sir M (+ q 14) IF-A) sh (gn-sir M (+ q 5) IF-B)
       bf (gn-sir M (+ q 6) IF-A) tf (gn-sir M (+ q 7) IF-A)
       ff (gn-sir M (+ q 13) IF-A)]
   (and (> le 0) (< le MM-LABEL-CAP) (> lx 0) (< lx MM-LABEL-CAP) (not= le lx)
    (= (gn-lpos M le) (+ q 9)) (= (gn-lpos M lx) (+ q 14))
    (>= sh 0) (<= sh 56) (td-byte M bf) (td-table M tf) (td-table M ff)
    (gn-dot-at? M q OP-LGET j 1 0)
    (gn-dot-at? M (+ q 1) OP-CONST (inc j) (gn-sir M (+ p 5) IF-B) 0)
    (gn-dot-at? M (+ q 2) OP-CMP CC-EQ j 0) (gn-dot-at? M (+ q 3) OP-BRZ j le 0)
    (gn-dot-at? M (+ q 4) OP-LGET j (inc j) 0)
    (gn-dot-at? M (+ q 5) OP-CONST (inc j) sh 0)
    (gn-dot-at? M (+ q 6) OP-CALL bf j 2) (gn-dot-at? M (+ q 7) OP-CALL tf j 1)
    (gn-dot-at? M (+ q 8) OP-BR lx 0 0) (gn-dot-at? M (+ q 9) OP-LABEL le 0 0)
    (gn-dot-at? M (+ q 10) OP-LGET j (inc j) 0)
    (gn-dot-at? M (+ q 11) OP-CONST (inc j) sh 0)
    (gn-dot-at? M (+ q 12) OP-CALL bf j 2) (gn-dot-at? M (+ q 13) OP-CALL ff j 1)
    (gn-dot-at? M (+ q 14) OP-LABEL lx 0 0) (td-groups M p (inc j))))))
(defn- td-shape [M :vector-i64 f :i64] :i64
 (if (not (td-type M f 6)) 0
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (+ p 2) IF-A)]
   (if (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 67)) (> l 0) (< l MM-LABEL-CAP)
    (= (gn-lpos M l) (+ p 2))
    (gn-dot-at? M p OP-FN f 6 6) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL l 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 6 0)
    (td-groups M p 1)
    (gn-dot-at? M (+ p 64) OP-CALL (gn-sir M (+ p 64) IF-A) 0 5)
    (td-xor5 M (gn-sir M (+ p 64) IF-A))
    (gn-dot-at? M (+ p 65) OP-RET 0 0 0) (gn-dot-at? M (+ p 66) OP-END f 0 0)) p 0))))
(defn- td-emit [M :vector-i64 p :i64 j :i64 branch :i64] :vector-i64
 (if (= j 5) M
  (let [q (+ p 4 (* (dec j) 15)) sh (gn-sir M (+ q 5) IF-B)
        f (gn-sir M (+ q (if (= branch 0) 7 13)) IF-A) lit (tb-shape M f)]
   (td-emit (-> M (gn-emit (gn-e-bf 0xd3400000 9 (gn-sreg M (inc j)) sh (+ sh 7)))
     (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
     (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
     (gn-emit (enc-add-r 17 17 16)) (gn-emit (gn-e-ldrr 9 17 9 1))
     (gn-emit (enc-eor-r 0 0 9))) p (inc j) branch))))
(defn- td-distinct [M :vector-i64 j :i64 k :i64] :bool
 (if (= k j) true (and (not= (gn-sreg M j) (gn-sreg M k)) (td-distinct M j (inc k)))))
(defn- td-regs [M :vector-i64 j :i64] :bool
 (if (= j 7) true (and (>= (gn-sreg M j) 19) (<= (gn-sreg M j) 28) (td-distinct M j 1) (td-regs M (inc j)))))
(defn- td-entry [M :vector-i64 i :i64] :vector-i64
 (if (or (<= i 1) (not= (gn-op M (dec i)) OP-FN)
   (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
   (not= (gn-g M gn-f-vmode) 0) (not= (gn-g M gn-f-ns) 6)
   (not= (gn-g M gn-f-dp) 6) (not (td-regs M 1))) M
  (let [f (gn-sir M (dec i) IF-A) p (td-shape M f)]
   (if (= p 0) M
    (let [m0 (-> M (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 5))) bf (vector-at m0 MM-CODE-N)
      m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-sub-i 8 8 5))
       (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov 0 (gn-sreg M 6))
       (gn-mov-imm 16 (gn-sir M (+ p 5) IF-B)) (gn-emit (enc-cmp-r (gn-sreg M 1) 16))) bc (vector-at m1 MM-CODE-N)
      m2 (td-emit (gn-emit m1 (enc-bcond (enc-cond-ne) 0)) p 1 0) bj (vector-at m2 MM-CODE-N)
      m3 (gn-emit m2 (enc-b 0)) alt (vector-at m3 MM-CODE-N)
      m4 (td-emit m3 p 1 1) done (vector-at m4 MM-CODE-N)
      m5 (-> m4 (gn-epilogue) (gn-gs gn-f-dead 0)) end (vector-at m5 MM-CODE-N)]
     (-> m5 (gn-dot-patch bf end (enc-cond-lo)) (gn-dot-patch bc alt (enc-cond-ne))
       (gn-put (+ MM-CODE-BASE bj) (enc-b (- done bj)))))))))
(defn- qb-rem [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) false
 (let [p (gn-fnf M f FF-SIR)]
  (and (> p 0) (< (+ p 10) (vector-at M MM-SIR-N)) (sr-types M f 2)
   (= (gn-fnf M f FF-NSLOTS) 2) (= (gn-fnf M f FF-DEPTH) 4)
   (gn-dot-at? M p OP-FN f 2 2)
   (gn-dot-at? M (+ p 1) OP-LABEL (gn-sir M (+ p 1) IF-A) 0 0)
   (> (gn-sir M (+ p 1) IF-A) 0) (< (gn-sir M (+ p 1) IF-A) MM-LABEL-CAP)
   (gn-dot-at? M (+ p 2) OP-LGET 0 1 0) (gn-dot-at? M (+ p 3) OP-LGET 1 2 0)
   (gn-dot-at? M (+ p 4) OP-LGET 2 1 0) (gn-dot-at? M (+ p 5) OP-LGET 3 2 0)
   (gn-dot-at? M (+ p 6) OP-BIN BOP-QUOT 2 0)
   (gn-dot-at? M (+ p 7) OP-BIN BOP-MUL 1 0) (gn-dot-at? M (+ p 8) OP-BIN BOP-SUB 0 0)
   (gn-dot-at? M (+ p 9) OP-RET 0 0 0) (gn-dot-at? M (+ p 10) OP-END f 0 0)))))
(defn- qb-tree [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
 (let [p (gn-fnf M f FF-SIR) first (+ p 2)]
  (if (and (> p 0) (< first (vector-at M MM-SIR-N)) (sr-types M f 1)
    (= (gn-fnf M f FF-NSLOTS) 1) (= (gn-fnf M f FF-DEPTH) 2)
    (gn-dot-at? M p OP-FN f 1 1)
    (gn-dot-at? M (+ p 1) OP-LABEL (gn-sir M (+ p 1) IF-A) 0 0)
    (> (gn-sir M (+ p 1) IF-A) 0) (< (gn-sir M (+ p 1) IF-A) MM-LABEL-CAP))
   (let [end (gn-tree-end M first 0)]
    (if (and (> end first) (gn-dot-at? M end OP-RET 0 0 0)
      (gn-dot-at? M (inc end) OP-END f 0 0)) first 0)) 0))))
(defn- qb-admit [M :vector-i64 i :i64] :i64
 (if (not= (gn-op M (dec i)) OP-FN) 0
 (let [p (dec i) f (gn-sir M p IF-A) base (gn-sir M (+ p 4) IF-B)
       divisor (gn-sir M (+ p 6) IF-B) stride (gn-sir M (+ p 10) IF-B)
       rem (gn-sir M (+ p 16) IF-A) tree (gn-sir M (+ p 17) IF-A)
       head (gn-sir M (+ p 2) IF-A) alt (gn-sir M (+ p 22) IF-B)
       exit (gn-sir M (+ p 24) IF-A)]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (< (+ p 29) (vector-at M MM-SIR-N))
    (not (gn-clamp-open M f)) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
    (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-RTYPE) TY-I64)
    (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 4)
    (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
    (loop [k 1] (or (= k 4) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
     (loop [j 1] (or (= j k) (and (not= (gn-sreg M k) (gn-sreg M j)) (recur (inc j)))))
     (recur (inc k)))))
    (>= base 0) (<= base 4095) (> divisor 1) (<= divisor 64) (> (gn-pow2 divisor) 0)
    (> stride 0) (<= stride 4095) (qb-rem M rem) (> (qb-tree M tree) 0)
    (> head 0) (< head MM-LABEL-CAP) (> alt 0) (< alt MM-LABEL-CAP)
    (> exit 0) (< exit MM-LABEL-CAP) (not= head alt) (not= head exit) (not= alt exit)
    (= (gn-lpos M head) (+ p 2)) (= (gn-lpos M alt) (+ p 25)) (= (gn-lpos M exit) (+ p 27))
    (bd-edges M 1 alt exit 0 0 0 0)
    (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M i OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL head 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
    (gn-dot-at? M (+ p 4) OP-CONST 1 base 0) (gn-dot-at? M (+ p 5) OP-LGET 2 2 0)
    (gn-dot-at? M (+ p 6) OP-CONST 3 divisor 0) (gn-dot-at? M (+ p 7) OP-BIN BOP-QUOT 2 0)
    (gn-dot-at? M (+ p 8) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 9) OP-LGET 2 3 0)
    (gn-dot-at? M (+ p 10) OP-CONST 3 stride 0) (gn-dot-at? M (+ p 11) OP-BIN BOP-MUL 2 0)
    (gn-dot-at? M (+ p 12) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 13) OP-RT RT-VECTOR-AT 0 2)
    (gn-dot-at? M (+ p 14) OP-LGET 1 2 0) (gn-dot-at? M (+ p 15) OP-CONST 2 divisor 0)
    (gn-dot-at? M (+ p 16) OP-CALL rem 1 2) (gn-dot-at? M (+ p 17) OP-CALL tree 1 1)
    (gn-dot-at? M (+ p 18) OP-BIN BOP-AND 0 0) (gn-dot-at? M (+ p 19) OP-CONST 1 0 0)
    (gn-dot-at? M (+ p 20) OP-CMP CC-EQ 0 0) (gn-dot-at? M (+ p 21) OP-UN UOP-NOT 0 0)
    (gn-dot-at? M (+ p 22) OP-BRZ 0 alt 0) (gn-dot-at? M (+ p 23) OP-CONST 0 1 0)
    (gn-dot-at? M (+ p 24) OP-BR exit 0 0) (gn-dot-at? M (+ p 25) OP-LABEL alt 0 0)
    (gn-dot-at? M (+ p 26) OP-CONST 0 0 0) (gn-dot-at? M (+ p 27) OP-LABEL exit 0 0)
    (gn-dot-at? M (+ p 28) OP-RET 0 0 0) (gn-dot-at? M (+ p 29) OP-END f 0 0))
   (qb-tree M tree) 0))))
(defn- qi-shape [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
 (let [p (gn-fnf M f FF-SIR)]
  (if (or (<= p 0) (>= (+ p 29) (vector-at M MM-SIR-N))) 0
 (let [i (inc p) base (gn-sir M (+ p 4) IF-B)
       divisor (gn-sir M (+ p 6) IF-B) stride (gn-sir M (+ p 10) IF-B)
       rem (gn-sir M (+ p 16) IF-A) tree (gn-sir M (+ p 17) IF-A)
       head (gn-sir M (+ p 2) IF-A) alt (gn-sir M (+ p 22) IF-B)
       exit (gn-sir M (+ p 24) IF-A)]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (< (+ p 29) (vector-at M MM-SIR-N))
    (not (gn-clamp-open M f)) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
    (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-RTYPE) TY-I64)
    (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
    (>= base 0) (<= base 4095) (> divisor 1) (<= divisor 64) (> (gn-pow2 divisor) 0)
    (> stride 0) (<= stride 4095) (qb-rem M rem) (> (qb-tree M tree) 0)
    (> head 0) (< head MM-LABEL-CAP) (> alt 0) (< alt MM-LABEL-CAP)
    (> exit 0) (< exit MM-LABEL-CAP) (not= head alt) (not= head exit) (not= alt exit)
    (= (gn-lpos M head) (+ p 2)) (= (gn-lpos M alt) (+ p 25)) (= (gn-lpos M exit) (+ p 27))
    (bd-edges M 1 alt exit 0 0 0 0)
    (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M i OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL head 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
    (gn-dot-at? M (+ p 4) OP-CONST 1 base 0) (gn-dot-at? M (+ p 5) OP-LGET 2 2 0)
    (gn-dot-at? M (+ p 6) OP-CONST 3 divisor 0) (gn-dot-at? M (+ p 7) OP-BIN BOP-QUOT 2 0)
    (gn-dot-at? M (+ p 8) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 9) OP-LGET 2 3 0)
    (gn-dot-at? M (+ p 10) OP-CONST 3 stride 0) (gn-dot-at? M (+ p 11) OP-BIN BOP-MUL 2 0)
    (gn-dot-at? M (+ p 12) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 13) OP-RT RT-VECTOR-AT 0 2)
    (gn-dot-at? M (+ p 14) OP-LGET 1 2 0) (gn-dot-at? M (+ p 15) OP-CONST 2 divisor 0)
    (gn-dot-at? M (+ p 16) OP-CALL rem 1 2) (gn-dot-at? M (+ p 17) OP-CALL tree 1 1)
    (gn-dot-at? M (+ p 18) OP-BIN BOP-AND 0 0) (gn-dot-at? M (+ p 19) OP-CONST 1 0 0)
    (gn-dot-at? M (+ p 20) OP-CMP CC-EQ 0 0) (gn-dot-at? M (+ p 21) OP-UN UOP-NOT 0 0)
    (gn-dot-at? M (+ p 22) OP-BRZ 0 alt 0) (gn-dot-at? M (+ p 23) OP-CONST 0 1 0)
    (gn-dot-at? M (+ p 24) OP-BR exit 0 0) (gn-dot-at? M (+ p 25) OP-LABEL alt 0 0)
    (gn-dot-at? M (+ p 26) OP-CONST 0 0 0) (gn-dot-at? M (+ p 27) OP-LABEL exit 0 0)
    (gn-dot-at? M (+ p 28) OP-RET 0 0 0) (gn-dot-at? M (+ p 29) OP-END f 0 0))
   (qb-tree M tree) 0))))) )
(defn- qi-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (or (not= n 3) (< t 0) (> t 3) (not= (gn-g M gn-f-leaf) 0)
      (not= (gn-g M gn-f-freg) 0) (> t (gn-g M gn-f-h)) (> t (gn-g M gn-f-dp))
      (> 3 (- (gn-g M gn-f-h) t)) (> 3 (- (gn-g M gn-f-dp) t))) 0
  (if (or (= (gn-op M (inc i)) OP-RES2) (= (gn-op M (inc i)) OP-RET)
          (jt-return M i t) (not (di-args-safe M t 3))) 0 (qi-shape M f))))
(defn- qi-call [M :vector-i64 i :i64 f :i64 t :i64 tree :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) divisor (gn-sir M (+ p 6) IF-B)
       stride (gn-sir M (+ p 10) IF-B) offset (gn-sir M (+ p 4) IF-B)
       m0 (-> M (gn-save 0 t) (gn-args t 0 3) (gn-ctx)
         (gn-emit (enc-ldr 11 7 CTX-FUEL)) (gn-emit (enc-cmp-i 11 1))) b0 (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-cmp-i 1 4095))) b1 (vector-at m1 MM-CODE-N)
       m2 (-> m1 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-i 2 4095))) b2 (vector-at m2 MM-CODE-N)
       m3 (-> m2 (gn-emit (enc-bcond 8 0)) (gn-emit (gn-e-lsr 9 1 (gn-pow2 divisor)))
         (gn-mov-imm 16 stride) (gn-emit (enc-mul 10 2 16)) (gn-emit (enc-add-r 9 9 10))
         (gn-emit (enc-add-i 9 9 offset)) (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
         (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
       m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
         (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
         (gn-emit (enc-cmp-r 9 16))) b4 (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 328))
         (gn-emit (enc-add-r 17 17 9)) (gn-emit (gn-e-addsl 10 16 17 3))
         ;; The complete pure read and original one-charge budget are proven.
         ;; Publish exactly that charge before the original ordered payload read.
         (gn-emit (enc-sub-i 11 11 1)) (gn-emit (enc-str 11 7 CTX-FUEL))
         (gn-emit (enc-ldr 0 10 0)) (gn-mov-imm 16 (dec divisor)) (gn-emit (enc-and-r 9 1 16))) adr (vector-at m5 MM-CODE-N)
       m6 (-> m5 (gn-emit (gn-e-adr 16)) (gn-emit (gn-e-ldrr 16 16 9 1))
         (gn-emit (enc-and-r 0 0 16)) (gn-emit (enc-cmp-i 0 0)) (gn-emit (enc-cset 0 (enc-cond-ne)))) done (vector-at m6 MM-CODE-N)
       m7 (gn-emit m6 (enc-b 0)) table (vector-at m7 MM-CODE-N) delta (* (- table adr) 4)
       m8 (gn-tree-data m7 tree 0 divisor) cold (vector-at m8 MM-CODE-N)
       m9 (-> m8 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))) end (vector-at m9 MM-CODE-N)
       m10 (-> m9 (gn-dot-patch b0 cold (enc-cond-lo)) (gn-dot-patch b1 cold 8) (gn-dot-patch b2 cold 8)
         (gn-dot-patch b3 cold (enc-cond-hs)) (gn-dot-patch b4 cold (enc-cond-hs))
         (gn-put (+ MM-CODE-BASE done) (enc-b (- end done)))
         (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 16) (i64-shift-left (bit-and delta 3) 29)
           (i64-shift-left (i64-shift-right delta 2) 5))))]
  (-> m10 (gn-vclear) (gn-gs gn-f-ctx (if (or (= (gn-g M cc-proof) 1) (>= (gn-ctx-safe M f 3 8 512) 0)) 1 0))
    (gn-take i t 0))))

(defn- qb-entry [M :vector-i64 i :i64] :vector-i64
 (let [tree (qb-admit M i)]
  (if (= tree 0) M
  (let [p (dec i) divisor (gn-sir M (+ p 6) IF-B)
        stride (gn-sir M (+ p 10) IF-B) offset (gn-sir M (+ p 4) IF-B)
        rv (gn-sreg M 1) rx (gn-sreg M 2) ry (gn-sreg M 3) B (gp-save-state M)
        m0 (gn-emit M (enc-cmp-i rx 4095)) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-i ry 4095)))
        b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond 8 0))
             (gn-emit (gn-e-lsr 9 rx (gn-pow2 divisor))) (gn-mov-imm 16 stride)
             (gn-emit (enc-mul 10 ry 16)) (gn-emit (enc-add-r 9 9 10))
             (gn-emit (enc-add-i 9 9 offset)) (gn-emit (enc-ldr 16 7 312))
             (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rv 1))
             (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
             (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
             (gn-emit (enc-cmp-r 9 16))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 328))
             (gn-emit (enc-add-r 17 17 9)) (gn-emit (gn-e-addsl 16 16 17 3))
             (gn-emit (enc-ldr 0 16 0)) (gn-mov-imm 16 (dec divisor))
             (gn-emit (enc-and-r 9 rx 16))) adr (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (gn-e-adr 10)) (gn-emit (gn-e-ldrr 10 10 9 1))
             (gn-emit (enc-and-r 0 0 10)) (gn-emit (enc-cmp-i 0 0))
             (gn-emit (enc-cset 0 (enc-cond-ne))) (gn-epilogue))
        table (vector-at m5 MM-CODE-N) delta (* (- table adr) 4)
        m6 (gn-tree-data m5 tree 0 divisor) end (vector-at m6 MM-CODE-N)
        m7 (-> m6 (gn-dot-patch b0 end 8) (gn-dot-patch b1 end 8)
             (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
             (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 10)
               (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5))))]
   (gp-restore m7 B)))))
(defn- sw-writer [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (< (+ p 8) (vector-at M MM-SIR-N))
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 3)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
    (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    (> (gn-sir M (+ p 2) IF-A) 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
    (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 5) OP-LGET 2 3 0)
    (gn-dot-at? M (+ p 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
    (gn-dot-at? M (+ p 7) OP-RET 0 0 0) (gn-dot-at? M (+ p 8) OP-END f 0 0)))))
(defn- sw-envelope [M :vector-i64 tree :i64 x :i64 n :i64] :i64
 (if (= x n) 0
  (let [v (gn-tree-value M tree x) tail (sw-envelope M tree (inc x) n)]
   (if (or (< v 0) (> v 4095) (< tail 0)) -1 (gn-max v tail)))))
(defn- sw-admit [M :vector-i64 i :i64] :i64
 (if (or (< i 1) (not= (gn-op M (dec i)) OP-FN)) 0
  (let [p (dec i) f (gn-sir M p IF-A)]
   (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)
          (>= (+ p 28) (vector-at M MM-SIR-N))) 0
    (let [head (gn-sir M (+ p 2) IF-A) alt (gn-sir M (+ p 6) IF-B)
          exit (gn-sir M (+ p 8) IF-A) base (gn-sir M (+ p 11) IF-B)
          tree (qb-tree M (gn-sir M (+ p 13) IF-A))]
     (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 3)
      (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 3)
      (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
      (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
      (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 3) (= (gn-g M gn-f-h) 0)
      (= (gn-g M gn-f-skip) 0)
      (loop [k 1] (or (= k 4) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
       (loop [j 1] (or (= j k) (and (not= (gn-sreg M k) (gn-sreg M j)) (recur (inc j)))))
       (recur (inc k)))))
      (> tree 0) (>= base 0) (<= base 4095)
      (> head 0) (< head MM-LABEL-CAP) (> alt 0) (< alt MM-LABEL-CAP)
      (> exit 0) (< exit MM-LABEL-CAP) (not= head alt) (not= head exit) (not= alt exit)
      (= (gn-small-label M 1 head 0) (+ p 2)) (= (gn-small-label M 1 alt 0) (+ p 9))
      (= (gn-small-label M 1 exit 0) (+ p 26)) (bd-edges M 1 alt exit 0 0 0 0)
      (btg-edges M (inc p) f head 0) (bd-edges M 1 head alt 0 0 0 0)
      (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M i OP-FUEL 0 0 0)
      (gn-dot-at? M (+ p 2) OP-LABEL head 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 2 0)
      (gn-dot-at? M (+ p 4) OP-LGET 1 3 0) (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
      (gn-dot-at? M (+ p 6) OP-BRZ 0 alt 0) (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
      (gn-dot-at? M (+ p 8) OP-BR exit 0 0) (gn-dot-at? M (+ p 9) OP-LABEL alt 0 0)
      (gn-dot-at? M (+ p 10) OP-LGET 0 1 0) (gn-dot-at? M (+ p 11) OP-CONST 1 base 0)
      (gn-dot-at? M (+ p 12) OP-LGET 2 2 0)
      (gn-dot-at? M (+ p 13) OP-CALL (gn-sir M (+ p 13) IF-A) 2 1)
      (gn-dot-at? M (+ p 14) OP-BIN BOP-ADD 1 0)
      (gn-dot-at? M (+ p 15) OP-CONST 2 (gn-sir M (+ p 15) IF-B) 0)
      (sw-writer M (gn-sir M (+ p 16) IF-A))
      (gn-dot-at? M (+ p 16) OP-CALL (gn-sir M (+ p 16) IF-A) 0 3)
      (gn-dot-at? M (+ p 17) OP-LGET 1 2 0) (gn-dot-at? M (+ p 18) OP-CONST 2 1 0)
      (gn-dot-at? M (+ p 19) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 20) OP-LGET 2 3 0)
      (gn-dot-at? M (+ p 21) OP-LSET 1 0 0) (gn-dot-at? M (+ p 22) OP-LSET 2 1 0)
      (gn-dot-at? M (+ p 23) OP-LSET 3 2 0) (gn-dot-at? M (+ p 24) OP-FUEL 0 0 0)
      (gn-dot-at? M (+ p 25) OP-BR head 0 0) (gn-dot-at? M (+ p 26) OP-LABEL exit 0 0)
      (gn-dot-at? M (+ p 27) OP-RET 0 0 0) (gn-dot-at? M (+ p 28) OP-END f 0 0))
      (if (>= (sw-envelope M tree 0 (inc (gn-tree-high M tree))) 0) tree 0) 0))))))
;; The freshly emitted sw-owned table is not shared with other tree users.
;; Preserve its i64 representation; prebias only values already certified by
;; sw-admit/sw-envelope. Check before addition: max4095+4095=8190, no overflow.
(defn- sw-data-biased [M :vector-i64 tree :i64 x :i64 count :i64 base :i64] :vector-i64
 (if (= x count) M
  (let [v (gn-tree-value M tree x)]
   (if (or (< base 0) (> base 4095) (< v 0) (> v 4095))
    (gn-err M E-GEN-OP OP-TAB)
    (let [biased (+ base v)]
     (sw-data-biased (-> M (gn-emit (bit-and biased 0xffffffff))
                          (gn-emit (bit-and (i64-shift-right biased 32) 0xffffffff)))
       tree (inc x) count base))))))
(defn- sw-entry [M :vector-i64 i :i64] :vector-i64
 (let [tree (sw-admit M i)]
  (if (= tree 0) M
   (let [p (dec i) n (inc (gn-tree-high M tree)) base (gn-sir M (+ p 11) IF-B)
         bound (+ base (sw-envelope M tree 0 n)) value (gn-sir M (+ p 15) IF-B)
         rv (gn-sreg M 1) rk (gn-sreg M 2) re (gn-sreg M 3) B (gp-save-state M)
         m0 (gn-emit M (enc-cmp-i re n)) b0 (vector-at m0 MM-CODE-N)
         m1 (-> m0 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-r rk re))) b1 (vector-at m1 MM-CODE-N)
         m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-sub-r 9 re rk))
              (gn-emit (enc-add-r 9 9 9)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
              (gn-emit (enc-cmp-r 8 9))) b2 (vector-at m2 MM-CODE-N)
         m3 (-> m2 (gn-emit (enc-bcond (enc-cond-lo) 0))
              (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
              (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
         m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
              (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 3 16 0))
              (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 3 16))) b4 (vector-at m4 MM-CODE-N)
         m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 bound)
              (gn-emit (enc-cmp-r 16 3))) b5 (vector-at m5 MM-CODE-N)
         m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 4 7 328))
              (gn-emit (gn-e-addsl 4 4 17 3)) (gn-mov 11 rk) (gn-mov-imm 13 value)
              ;; Complete preflight succeeded: exactly two original charges
              ;; per visited store, including the final backedge charge.
              (gn-emit (enc-sub-r 8 8 9)) (gn-emit (enc-str 8 7 CTX-FUEL)))
         adr (vector-at m6 MM-CODE-N) m7 (gn-emit m6 (gn-e-adr 10)) loop-at (vector-at m7 MM-CODE-N)
         m8 (-> m7 (gn-emit (gn-e-ldrr 12 10 11 1))
              (gn-emit (gn-e-strr3 13 4 12)) (gn-emit (enc-add-i 11 11 1))
              (gn-emit (enc-cmp-r 11 re))) branch (vector-at m8 MM-CODE-N)
         m9 (-> m8 (gn-emit (enc-bcond (enc-cond-lo) (- loop-at branch)))
              (gn-mov 0 rv) (gn-epilogue)) table (vector-at m9 MM-CODE-N)
         delta (* (- table adr) 4) m10 (sw-data-biased m9 tree 0 n base) end (vector-at m10 MM-CODE-N)
         m11 (-> m10 (gn-dot-patch b0 end 8) (gn-dot-patch b1 end (enc-cond-hs))
               (gn-dot-patch b2 end (enc-cond-lo)) (gn-dot-patch b3 end (enc-cond-hs))
               (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-hs))
               (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 10)
                (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5))))]
    (gp-restore m11 B)))))
(defn- xd-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [h (gn-sir M (+ p 2) IF-A) b (gn-sir M (+ p 8) IF-B)
       e (gn-sir M (+ p 18) IF-A) a (gn-sir M (+ p 50) IF-B) z (gn-sir M (+ p 52) IF-A)
       flag (gn-sir M (+ p 4) IF-B) mask (dec flag)
       leaf (gn-sir M (+ p 10) IF-B) feature (gn-sir M (+ p 21) IF-B)
       threshold (gn-sir M (+ p 29) IF-B) input (gn-sir M (+ p 37) IF-B)
       stride (gn-sir M (+ p 39) IF-B) left (gn-sir M (+ p 51) IF-B) right (gn-sir M (+ p 54) IF-B)]
  (if (= k 77) true
   (and (case k
    0 (gn-dot-at? M (+ p 0) 1 f 5 9)
    1 (gn-dot-at? M (+ p 1) 18 0 0 0)
    2 (gn-dot-at? M (+ p 2) 9 h 0 0)
    3 (gn-dot-at? M (+ p 3) 4 0 5 0)
    4 (gn-dot-at? M (+ p 4) 3 1 flag 0)
    5 (gn-dot-at? M (+ p 5) 6 5 0 0)
    6 (gn-dot-at? M (+ p 6) 3 1 flag 0)
    7 (gn-dot-at? M (+ p 7) 7 1 0 0)
    8 (gn-dot-at? M (+ p 8) 11 0 b 0)
    9 (gn-dot-at? M (+ p 9) 4 0 1 0)
    10 (gn-dot-at? M (+ p 10) 3 1 leaf 0)
    11 (gn-dot-at? M (+ p 11) 4 2 4 0)
    12 (gn-dot-at? M (+ p 12) 4 3 5 0)
    13 (gn-dot-at? M (+ p 13) 3 4 mask 0)
    14 (gn-dot-at? M (+ p 14) 6 5 3 0)
    15 (gn-dot-at? M (+ p 15) 6 1 2 0)
    16 (gn-dot-at? M (+ p 16) 6 1 1 0)
    17 (gn-dot-at? M (+ p 17) 14 176 0 2)
    18 (gn-dot-at? M (+ p 18) 10 e 0 0)
    19 (gn-dot-at? M (+ p 19) 9 b 0 0)
    20 (gn-dot-at? M (+ p 20) 4 0 1 0)
    21 (gn-dot-at? M (+ p 21) 3 1 feature 0)
    22 (gn-dot-at? M (+ p 22) 4 2 3 0)
    23 (gn-dot-at? M (+ p 23) 4 3 5 0)
    24 (gn-dot-at? M (+ p 24) 6 1 2 0)
    25 (gn-dot-at? M (+ p 25) 6 1 1 0)
    26 (gn-dot-at? M (+ p 26) 14 176 0 2)
    27 (gn-dot-at? M (+ p 27) 5 6 0 0)
    28 (gn-dot-at? M (+ p 28) 4 0 1 0)
    29 (gn-dot-at? M (+ p 29) 3 1 threshold 0)
    30 (gn-dot-at? M (+ p 30) 4 2 3 0)
    31 (gn-dot-at? M (+ p 31) 4 3 5 0)
    32 (gn-dot-at? M (+ p 32) 6 1 2 0)
    33 (gn-dot-at? M (+ p 33) 6 1 1 0)
    34 (gn-dot-at? M (+ p 34) 14 176 0 2)
    35 (gn-dot-at? M (+ p 35) 5 7 0 0)
    36 (gn-dot-at? M (+ p 36) 4 0 1 0)
    37 (gn-dot-at? M (+ p 37) 3 1 input 0)
    38 (gn-dot-at? M (+ p 38) 4 2 2 0)
    39 (gn-dot-at? M (+ p 39) 3 3 stride 0)
    40 (gn-dot-at? M (+ p 40) 6 3 2 0)
    41 (gn-dot-at? M (+ p 41) 4 3 6 0)
    42 (gn-dot-at? M (+ p 42) 6 1 2 0)
    43 (gn-dot-at? M (+ p 43) 6 1 1 0)
    44 (gn-dot-at? M (+ p 44) 14 176 0 2)
    45 (gn-dot-at? M (+ p 45) 5 8 0 0)
    46 (gn-dot-at? M (+ p 46) 4 0 1 0)
    47 (gn-dot-at? M (+ p 47) 4 1 8 0)
    48 (gn-dot-at? M (+ p 48) 4 2 7 0)
    49 (gn-dot-at? M (+ p 49) 7 2 1 0)
    50 (gn-dot-at? M (+ p 50) 11 1 a 0)
    51 (gn-dot-at? M (+ p 51) 3 1 left 0)
    52 (gn-dot-at? M (+ p 52) 10 z 0 0)
    53 (gn-dot-at? M (+ p 53) 9 a 0 0)
    54 (gn-dot-at? M (+ p 54) 3 1 right 0)
    55 (gn-dot-at? M (+ p 55) 9 z 0 0)
    56 (gn-dot-at? M (+ p 56) 4 2 3 0)
    57 (gn-dot-at? M (+ p 57) 4 3 5 0)
    58 (gn-dot-at? M (+ p 58) 6 1 2 0)
    59 (gn-dot-at? M (+ p 59) 6 1 1 0)
    60 (gn-dot-at? M (+ p 60) 14 176 0 2)
    61 (gn-dot-at? M (+ p 61) 5 9 0 0)
    62 (gn-dot-at? M (+ p 62) 4 0 1 0)
    63 (gn-dot-at? M (+ p 63) 4 1 2 0)
    64 (gn-dot-at? M (+ p 64) 4 2 3 0)
    65 (gn-dot-at? M (+ p 65) 4 3 4 0)
    66 (gn-dot-at? M (+ p 66) 4 4 9 0)
    67 (gn-dot-at? M (+ p 67) 5 1 0 0)
    68 (gn-dot-at? M (+ p 68) 5 2 1 0)
    69 (gn-dot-at? M (+ p 69) 5 3 2 0)
    70 (gn-dot-at? M (+ p 70) 5 4 3 0)
    71 (gn-dot-at? M (+ p 71) 5 5 4 0)
    72 (gn-dot-at? M (+ p 72) 18 0 0 0)
    73 (gn-dot-at? M (+ p 73) 10 h 0 0)
    74 (gn-dot-at? M (+ p 74) 9 e 0 0)
    75 (gn-dot-at? M (+ p 75) 19 0 0 0)
    76 (gn-dot-at? M (+ p 76) 2 f 0 0)
    false) (xd-shape M p f (inc k))))))

(defn- xd-constants [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 6) true
  (let [at (case k 0 10 1 21 2 29 3 37 4 51 5 54 0) n (gn-sir M (+ p at) IF-B)]
   (and (>= n 0) (<= n 1048575) (xd-constants M p (inc k))))))

(defn- xd-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 5) true
  (let [at (case k 0 2 1 19 2 53 3 55 4 74 0) l (gn-sir M (+ p at) IF-A)]
   (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p at))
    (xd-labels M p (inc k))))))

(defn- xd-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A) flag (gn-sir M (+ p 4) IF-B)
       stride (gn-sir M (+ p 39) IF-B)]
  (and (> p 0) (< (+ p 76) (vector-at M MM-SIR-N))
   (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
   (= (gn-fnf M f FF-NPARAMS) 5) (= (gn-fnf M f FF-NSLOTS) 9)
   (= (gn-fnf M f FF-DEPTH) 5) (= (gn-fnf M f FF-RTYPE) TY-I64)
   (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
   (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-vmode) 3)
