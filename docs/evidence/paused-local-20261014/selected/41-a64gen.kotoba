448265 4294967300 137439019011 131079 277055455363083 17179869188 8590000132 327686 17179934724 4295098376 12885032964 4295294982 393222 4226285578 4227530761 4294967300 206158495747 131079 277008210722827 8589934596 12884967428 458758 17179934724 458758 4226351114 4226809865 12884901892 8590000132 17180000260 8590065672 4295360518 458758 4226351113 4226285577 4226220041 19 4294901762] 4 [281483566579713 4229365769 4294967300 68719542275 131079 277145649676299 4294967300 4226678794 4228907017 4294967300 137439019011 131079 277089815101451 21474836483 4295032836 196614 4295032835 65542 64424574979 327686 4226744330 4228055049 4294967300 206158495747 131079 277033980526603 12884901891 4295032836 196614 21474902019 65542 64424574979 327686 4226809866 4227203081 30064771075 4295032836 196614 64424574979 327686 4226809865 4226744329 4226678793 19 4294901762] []))
(defn- mdc-value [M :vector-i64 p :i64 T :vector-i64 e :i64] :i64
 (cond (= e -1) (vector-at T 0) (<= e -1000) (gn-sir M (+ p (- (- 0 e) 1000)) IF-A)
       (<= e -10) (vector-at T (- (- 0 e) 10)) :else e))
(defn- mdc-match [M :vector-i64 p :i64 T :vector-i64 kind :i64] :bool
 (let [V (mdc-pattern kind) count (vector-count V)]
  (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
   (loop [k 0] (or (= k count)
    (let [w (vector-at V k) op (bit-and w 65535)
          a (i64-shift-right (i64-shift-left w 32) 48)
          b (i64-shift-right (i64-shift-left w 16) 48) c (i64-shift-right w 48)]
     (and (gn-dot-at? M (+ p k) op (mdc-value M p T a) (mdc-value M p T b) c)
          (recur (inc k)))))))))
(defn- mdc-counts [M :vector-i64] :bool
 (and (> (vector-at M MM-SIR-N) 0) (< (vector-at M MM-SIR-N) MM-SIR-CAP)
      (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)))
(defn- mdc-safe-wrapper [M :vector-i64 f :i64 n :i64] :bool
 (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (let [p (gn-fnf M f FF-SIR) limit (vector-at M MM-SIR-N)]
   (and (> p 0) (<= 2 (- limit p)) (= (gn-op M p) OP-FN)
    (= (gn-sir M p IF-A) f)
    (let [start (+ p 1 (if (= (gn-op M (inc p)) OP-FUEL) 1 0))]
     (loop [q start work 64]
      (and (> work 0) (> q 0) (< q limit)
       (if (= (gn-op M q) OP-LABEL) (recur (inc q) (dec work))
        (let [tail (if (= n 1) 4 (+ n 2))]
         (and (< tail (- limit q)) (= (gn-op M (+ q tail)) OP-END)
              (= (gn-sir M (+ q tail) IF-A) f)))))))))
))
(defn- mdc-helper [M :vector-i64 T :vector-i64 kind :i64] :bool
 (let [f (vector-at T (case kind 1 5 2 6 3 3 4 4 0))]
  (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
   (let [n (case kind 1 3 2 2 3 4 4 1 0) slots (case kind 1 4 2 2 3 4 4 1 0)
         depth (case kind 1 4 2 4 3 3 4 2 0) p (gn-fnf M f FF-SIR)
         U (vector-assoc T 0 f)]
    (and (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) slots)
     (= (gn-fnf M f FF-DEPTH) depth) (= (gn-fnf M f FF-RTYPE) TY-I64)
     (loop [k 0] (or (= k n) (and (= (ck-pt M f k) (if (and (= kind 1) (= k 0)) TY-VEC TY-I64)) (recur (inc k)))))
     (mdc-match M p U kind))))))
(defn- mdc-regs [M :vector-i64 s :i64] :bool
 (or (> s 18) (and (= (gn-sreg M s)
  (case s 1 21 2 24 4 25 5 26 6 19 7 27 8 28 12 20 13 22 14 23 -1))
  (recur M (inc s)))))
(defn- mdc-admit [M :vector-i64 i :i64] :bool
 (and (mdc-counts M) (> i 1) (< i (vector-at M MM-SIR-N))
  (<= 101 (- (vector-at M MM-SIR-N) (dec i))) (= (gn-op M (dec i)) OP-FN)
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 14)
    (= (gn-fnf M f FF-NSLOTS) 18) (= (gn-fnf M f FF-DEPTH) 14)
    (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (loop [k 0] (or (= k 14) (and (= (ck-pt M f k) (if (or (= k 0) (= k 3) (= k 4)) TY-VEC TY-I64)) (recur (inc k)))))
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (<= (gn-g M gn-f-vmode) 0)
    (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-fb) 352) (= (gn-g M gn-f-nsv) 10)
    (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-g M gn-f-ctx) 1) (mdc-regs M 1)
    (let [T [f (gn-sir M (+ p 12) IF-A) (gn-sir M (+ p 13) IF-A)
             (gn-sir M (+ p 38) IF-A) (gn-sir M (+ p 41) IF-A)
             (gn-sir M (+ p 52) IF-A) (gn-sir M (+ p 62) IF-A)]
          mask (vector-at T 1) put (vector-at T 2)]
     (and (mdc-safe-wrapper M mask 1) (mdc-safe-wrapper M put 3)
      (= (gn-scalar-mask M (+ p 12) mask 1) 32)
      (not (gn-clamp-open M put)) (= (gn-wrapper M put 0 3) (+ 256 RT-VECTOR-ASSOC-IN-PLACE))
      (mdc-match M p T 0) (mdc-helper M T 1) (mdc-helper M T 2)
      (mdc-helper M T 3) (mdc-helper M T 4)))))))
(defn- mdc-miss [M :vector-i64 G :vector-i64 cond :i64] :vector-i64
 (let [n (vector-at G 40) a (vector-assoc! G (* n 2) (vector-at M MM-CODE-N))
       b (vector-assoc! a (inc (* n 2)) cond) c (vector-assoc! b 40 (inc n))]
  (gn-emit M (enc-bcond cond 0))))
(defn- mdc-root [M :vector-i64 G :vector-i64 rv :i64 dst :i64 lower :i64] :vector-i64
 (-> M (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
  (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)) (mdc-miss G (enc-cond-hs))
  (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
  (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
  (gn-emit (enc-cmp-r 0 16)) (mdc-miss G (enc-cond-hs))
  (gn-emit (enc-cmp-r 0 lower)) (mdc-miss G (enc-cond-lo))
  (gn-emit (enc-ldr dst 7 328)) (gn-emit (gn-e-addsl dst dst 17 3))))
(defn- mdc-fg [M :vector-i64] :vector-i64
 (let [m0 (gn-emit M (enc-cmp-i 19 16)) b0 (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ge) 0))
    (gn-emit (enc-and-r 9 20 22)) (gn-emit (enc-mvn 10 20)) (gn-emit (enc-and-r 10 10 23))
    (gn-emit (enc-orr-r 9 9 10)) (gn-mov 0 19)) e0 (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-b 0)) (gn-emit (enc-cmp-i 19 32))) b1 (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ge) 0))
    (gn-emit (enc-and-r 9 23 20)) (gn-emit (enc-mvn 10 23)) (gn-emit (enc-and-r 10 10 22))
    (gn-emit (enc-orr-r 9 9 10)) (gn-mov-imm 16 5) (gn-emit (enc-mul 0 19 16))
    (gn-emit (enc-add-i 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 3))) e1 (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-b 0)) (gn-emit (enc-cmp-i 19 48))) b2 (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond (enc-cond-ge) 0))
    (gn-emit (enc-eor-r 9 20 22)) (gn-emit (enc-eor-r 9 9 23))
    (gn-mov-imm 16 3) (gn-emit (enc-mul 0 19 16)) (gn-emit (enc-add-i 0 0 5))
    (gn-emit (gn-e-bf 0xd3400000 0 0 0 3))) e2 (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-b 0)) (gn-emit (enc-mvn 10 23))
    (gn-emit (enc-orr-r 10 20 10)) (gn-emit (enc-eor-r 9 22 10))
    (gn-mov-imm 16 7) (gn-emit (enc-mul 0 19 16)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 3))) end (vector-at m6 MM-CODE-N)]
 (-> m6 (gn-dot-patch b0 (+ e0 1) (enc-cond-ge)) (gn-dot-patch b1 (+ e1 1) (enc-cond-ge))
  (gn-dot-patch b2 (+ e2 1) (enc-cond-ge))
  (gn-put (+ MM-CODE-BASE e0) (enc-b (- end e0)))
  (gn-put (+ MM-CODE-BASE e1) (enc-b (- end e1)))
  (gn-put (+ MM-CODE-BASE e2) (enc-b (- end e2))))))
(defn- mdc-body [M :vector-i64] :vector-i64
 (-> M (mdc-fg) (shloop-get 10 11) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (gn-e-ldrr 11 4 19 1)) (gn-emit (enc-add-r 9 9 11)) (gn-st 9 15)
  ;; Original word helper's private charge precedes its first payload read.
  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-subs-i 8 8 1))
  (gn-emit (enc-bcond (enc-cond-hs) 3)) (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))
  (gn-emit (gn-e-addsl 0 24 0 2)) (gn-emit (gn-e-ldrr 9 6 0 1))
  (gn-emit (enc-add-i 1 0 1)) (gn-emit (gn-e-ldrr 10 6 1 1))
  (gn-emit (gn-e-lsl 10 10 8)) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (enc-add-i 1 0 2)) (gn-emit (gn-e-ldrr 10 6 1 1))
  (gn-emit (gn-e-lsl 10 10 16)) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (enc-add-i 1 0 3)) (gn-emit (gn-e-ldrr 10 6 1 1))
  (gn-emit (gn-e-lsl 10 10 24)) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (enc-str 8 7 CTX-FUEL))
  (gn-ld 10 15) (gn-emit (enc-add-r 0 9 10)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31))
  ;; Original shift payload read precedes rotate's public entry transaction.
  (gn-emit (gn-e-ldrr 1 3 19 1)) (gn-op-fuel)
  (gn-emit (gn-e-bf 0xd3400000 9 0 0 31)) (gn-emit (enc-lslv 9 9 1))
  (gn-emit (gn-e-bf 0xd3400000 10 0 0 31)) (gn-mov-imm 16 32)
  (gn-emit (enc-sub-r 11 16 1)) (gn-emit (enc-lsrv 10 10 11))
  (gn-emit (enc-orr-r 9 9 10)) (gn-emit (gn-e-bf 0xd3400000 9 9 0 31))
  (gn-emit (enc-add-r 9 20 9)) (gn-emit (gn-e-bf 0xd3400000 9 9 0 31))
  (shloop-get 0 14) (shloop-put 0 11) (shloop-get 1 12) (shloop-get 2 13)
  (shloop-put 9 12) (shloop-put 1 13) (shloop-put 2 14)
  (gn-emit (enc-add-i 19 19 1)) (gn-op-fuel)))
(defn- mdc-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (mdc-admit M i)) M
  (let [G (vector-alloc 41) p (dec i) B (gp-save-state M)
   m0 (-> M (gn-emit (enc-cmp-i 19 64)) (mdc-miss G (enc-cond-hs))
     (gn-mov-imm 9 64) (gn-emit (enc-sub-r 9 9 19)) (gn-mov-imm 10 3)
     (gn-emit (enc-mul 9 9 10)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
     (gn-emit (enc-cmp-r 8 9)) (mdc-miss G (enc-cond-lo))
     (gn-mov-imm 10 1152921504606846912) (gn-emit (enc-cmp-r 24 10))
     (mdc-miss G 8) (gn-emit (enc-add-i 11 24 64))
     (mdc-root G 21 6 11) (gn-mov-imm 11 64)
     (mdc-root G 26 4 11) (mdc-root G 25 3 11)) head (vector-at m0 MM-CODE-N)
   m1 (-> m0 (mdc-body) (gn-emit (enc-cmp-i 19 64))) back (vector-at m1 MM-CODE-N)
   m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) (- head back)))
