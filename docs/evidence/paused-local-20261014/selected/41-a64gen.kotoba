     (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9))) b2 (vector-at m2 MM-CODE-N)
    m3 (-> m2 (gn-emit (enc-bcond (enc-cond-lo) 0))
     (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
     (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
    m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
     (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
     (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
     (gn-emit (enc-cmp-r 0 16))) b4 (vector-at m4 MM-CODE-N)
    m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 (+ n base))
