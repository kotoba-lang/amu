    m6 (-> m5 (gn-emit (enc-bcond (enc-cond-lo) 0))
     (gn-emit (enc-ldr 5 7 328)) (gn-emit (gn-e-addsl 5 5 17 3))
     (gn-emit (enc-sub-r 8 8 9)) (gn-emit (enc-str 8 7 CTX-FUEL))) start (vector-at m6 MM-CODE-N)
    m7 (-> m6 (srloop-body p) (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16))) back (vector-at m7 MM-CODE-N)
    m8 (-> m7 (gn-emit (enc-bcond (enc-cond-ne) (- start back)))
     (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0))) end (vector-at m8 MM-CODE-N)]
   (-> m8 (gn-dot-patch b0 end (enc-cond-lo)) (gn-dot-patch b1 end (enc-cond-hs))
