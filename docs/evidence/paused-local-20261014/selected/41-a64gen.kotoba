         (gn-emit (gn-e-ldrr 9 10 4 1)) (gn-emit (gn-e-ldrr 5 11 4 1))
         (gn-mov-imm 16 stride) (gn-emit (enc-cmp-r 9 16)) (xd-cold G (enc-cond-hs))
         (gn-emit (gn-e-ldrr 6 12 9 1)) (gn-emit (enc-cmp-r 6 5))) ge-at (vector-at m2 MM-CODE-N)
       m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ge) 0)) (gn-emit (gn-e-ldrr 4 13 4 1))) join-at (vector-at m3 MM-CODE-N)
       m4 (gn-emit m3 (enc-b 0)) ge (vector-at m4 MM-CODE-N)
       m5 (gn-emit m4 (gn-e-ldrr 4 14 4 1)) join (vector-at m5 MM-CODE-N)
       m6 (-> m5 (gn-emit (enc-cmp-i 8 1)) (xd-cold G (enc-cond-lo))
         (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-b 0)))
       leaf (vector-at m6 MM-CODE-N)
       m7 (-> m6 (gn-mov-imm 16 (dec flag)) (gn-emit (enc-and-r 9 4 16))
         (gn-emit (gn-e-ldrr vote 15 9 1)) (gn-emit (enc-str 8 7 CTX-FUEL)))]
  (-> m7 (gn-dot-patch leaf-at leaf (enc-cond-eq)) (gn-dot-patch ge-at ge (enc-cond-ge))
    (gn-put (+ MM-CODE-BASE join-at) (enc-b (- join join-at)))
    ;; Capture the actual backedge word position, not the mutable original M.
    (gn-put (+ MM-CODE-BASE (dec leaf)) (enc-b (- loop-at (dec leaf)))))))
(defn- tbat-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (tbat-admit M i)] (if (= p 0) M
  (let [wp (tbat-walk M (gn-sir M (+ p 43) IF-A))
   flag (gn-sir M (+ wp 4) IF-B) stride (gn-sir M (+ wp 39) IF-B)
   classes (gn-sir M (+ p 4) IF-B) count (gn-sir M (+ p 11) IF-B)
   votes (gn-sir M (+ p 46) IF-B) G (vector-alloc 129) B (gp-save-state M)
   rv (gn-sreg M 1) sample (gn-sreg M 2) cls (gn-sreg M 3) jreg (gn-sreg M 4)
   tree (gn-sreg M 5) nb (gn-sreg M 6) lb (gn-sreg M 7) size (gn-sreg M 8)
   vote (gn-sreg M 9) wreg (gn-sreg M 10) ln (vector-at M MM-LABEL-N)
   m0 (-> M (gn-put MM-LABEL-N (inc ln))
     (gn-mov-imm 16 classes) (gn-emit (enc-cmp-r cls 16)) (xd-cold G (enc-cond-hs))
     (gn-mov-imm 16 count) (gn-emit (enc-cmp-r jreg 16)) (xd-cold G (enc-cond-hs))
     (tbat-alias G)
     (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
     (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)) (xd-cold G (enc-cond-hs))
     (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
     (gn-emit (enc-ldp 17 2 16 0))
     (gn-mov-imm 16 134217728) (gn-emit (enc-cmp-r 17 16)) (xd-cold G (enc-cond-hs))
     (gn-emit (enc-sub-r 16 16 17)) (gn-emit (enc-cmp-r 2 16)) (xd-cold G 8)
     (gn-mov-imm 16 (+ votes classes)) (gn-emit (enc-cmp-r 2 16)) (xd-cold G (enc-cond-lo))
     (gn-emit (enc-ldr 3 7 328)) (gn-emit (gn-e-addsl 3 3 17 3)) (gn-mov-imm 1 0))
   head (vector-at m0 MM-CODE-N)
   ;; Original tree-size read is first, before any speculative model read.
   low (loop [k 0 best votes] (if (= k 6) best
    (let [at (case k 0 10 1 21 2 29 3 37 4 51 5 54 0) b (gn-sir M (+ wp at) IF-B)]
     (recur (inc k) (if (< b best) b best)))))
   m1 (-> m0 (gn-mov-imm 16 low) (gn-emit (enc-cmp-r tree 16)) (xd-cold G (enc-cond-hs))
     (gn-emit (gn-e-ldrr size 3 tree 1))
     (gn-mov-imm 16 1048576) (gn-emit (enc-cmp-r size 16)) (xd-cold G (enc-cond-hs))
     (gn-emit (enc-cmp-r nb 16)) (xd-cold G (enc-cond-hs))
     (gn-emit (enc-cmp-r lb 16)) (xd-cold G (enc-cond-hs)))
   m2 (loop [m m1 k 0] (if (= k 6) m
    (let [at (case k 0 10 1 21 2 29 3 37 4 51 5 54 0) b (gn-sir M (+ wp at) IF-B)]
     (recur (if (= k 3)
       (-> m (gn-mov-imm 16 16384) (gn-emit (enc-cmp-r sample 16)) (xd-cold G (enc-cond-hs))
        (gn-emit (gn-e-lsl 16 (gn-sreg M 2) (gn-pow2 stride)))
        (gn-mov-imm 17 (+ b (dec stride))) (gn-emit (enc-add-r 16 16 17))
        (gn-mov-imm 17 votes) (gn-emit (enc-cmp-r 16 17)) (xd-cold G (enc-cond-hs)))
       (tbat-range m G (if (= k 0) lb nb) b (dec flag) votes)) (inc k)))))
   ;; Future base arithmetic is proved before current mutation, without reading
   ;; any future size. Failing proof replays this original current iteration.
   m3 (-> m2 (gn-emit (enc-add-r 16 nb size)) (gn-mov-imm 17 1048576)
      (gn-emit (enc-cmp-r 16 17)) (xd-cold G (enc-cond-hs))
      (gn-emit (enc-add-r 16 lb size)) (gn-emit (enc-add-i 16 16 1))
      (gn-emit (enc-cmp-r 16 17)) (xd-cold G (enc-cond-hs))
      (gn-emit (enc-cbnz 1 0)))
   pointer-skip (- (vector-at m3 MM-CODE-N) 1)
   m3a (-> m3 (tbat-pointers wp) (gn-mov-imm 1 1))
   pointer-end (vector-at m3a MM-CODE-N)
   m3b (-> m3a (gn-put (+ MM-CODE-BASE pointer-skip) (enc-cbnz 1 (- pointer-end pointer-skip)))
      (tbat-walk-emit G flag stride vote) (scfill-lr-fix ln (+ p 43))
      (gn-mov-imm 16 votes) (gn-emit (enc-add-r 16 cls 16))
      (gn-emit (gn-e-ldrr 17 3 16 1)) (gn-emit (enc-add-r 0 17 vote))
      (gn-op-fuel)
      (gn-mov-imm 16 votes) (gn-emit (enc-add-r 16 cls 16))
      (gn-emit (gn-e-strr3 0 3 16))
      (gn-mov wreg rv) (gn-emit (enc-add-i jreg jreg 1)) (gn-emit (enc-add-i tree tree 1))
      (gn-emit (enc-add-r nb nb size)) (gn-emit (enc-add-r lb lb size)) (gn-emit (enc-add-i lb lb 1))
      (gn-op-fuel)
      ;; Only model planes advance by size; leaf plane additionally advances1.
      (gn-emit (gn-e-lsl 16 size 3))
      (gn-emit (enc-add-r 10 10 16)) (gn-emit (enc-add-r 11 11 16))
      (gn-emit (enc-add-r 13 13 16)) (gn-emit (enc-add-r 14 14 16))
      (gn-emit (enc-add-r 15 15 16)) (gn-emit (enc-add-i 15 15 8))
      (gn-mov-imm 16 count) (gn-emit (enc-cmp-r jreg 16)))
   more (vector-at m3b MM-CODE-N)
   m4 (-> m3b (gn-emit (enc-bcond (enc-cond-ne) (- head more)))
      (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)))
   cold (vector-at m4 MM-CODE-N)
   m5 (loop [m m4 k 0] (if (= k (vector-at G 0)) m
    (recur (gn-dot-patch m (vector-at G (+ 1 (* k 2))) cold (vector-at G (+ 2 (* k 2)))) (inc k))))]
   (gp-restore m5 B)))))


