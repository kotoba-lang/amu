   (gn-mov-imm 11 (+ (* (dec n) stride) (dec n))) (gn-emit (enc-cmp-r 11 10)) (ri-cold G (enc-cond-hs))
   (gn-mov-imm 11 (+ out (dec n))) (gn-emit (enc-cmp-r 11 10)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 14 7 328)) (gn-emit (gn-e-addsl 14 14 17 3))
   (gn-emit (enc-sub-r 8 8 9))
   (gn-mov-imm 10 stride) (gn-emit (enc-madd 10 1 10 2)) (gn-emit (gn-e-addsl 12 14 10 3))
   (gn-mov-imm 10 out) (gn-emit (enc-add-r 10 1 10)) (gn-emit (gn-e-addsl 13 14 10 3))
   (gn-mov-imm 15 factor))
  head (vector-at m0 MM-CODE-N) m1 (gn-emit m0 (enc-cmp-i 2 n)) rowbranch (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-eq) 0)) (gn-emit (enc-add-r 9 1 2))
   (gn-mov-imm 10 bias) (gn-emit (enc-add-r 9 9 10)) (gn-emit (enc-cmp-r 1 2))) diagonal (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ne) 2)) (gn-emit (enc-mul 9 9 15))
   (gn-emit (enc-str 9 12 0)) (gn-emit (enc-add-i 12 12 8)) (gn-emit (enc-add-r 3 3 9)) (gn-emit (enc-add-i 2 2 1))) back (vector-at m3 MM-CODE-N)
