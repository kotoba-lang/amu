(defn- gz-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B)]
  (and (> p 0) (< (+ p 23) (vector-at M MM-SIR-N))
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2)
       (= (gn-fnf M f FF-NSLOTS) 2) (= (gn-fnf M f FF-DEPTH) 3)
       (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
       (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-g M gn-f-leaf) 1)
       (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-freg) 1)
       (= (gn-g M gn-f-h) 0) (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1)
       (>= n 1) (<= n 64)
