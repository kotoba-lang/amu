    false) (d2-shape M p f (inc k))))))
(defn- d2-regs [M :vector-i64 s :i64] :bool
 (if (= s 7) true
  (and (>= (gn-sreg M s) 19) (<= (gn-sreg M s) 28) (d2-regs M (inc s)))))
(defn- d2-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i) f (gn-sir M p IF-A)]
  (if (or (<= p 0) (>= (+ p 84) (vector-at M MM-SIR-N))
          (not= (gn-op M p) OP-FN) (<= f 0) (>= f (vector-at M MM-FN-N))
          (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
          (not= (gn-g M gn-f-h) 0) (gn-clamp-open M f)) 0
   (let [n (gn-sir M (+ p 4) IF-B) oa (gn-sir M (+ p 8) IF-B)
         sh (gn-sir M (+ p 12) IF-B) helper (gn-sir M (+ p 43) IF-A)
         lit (tb-shape M helper) h (gn-sir M (+ p 2) IF-A)
         b (gn-sir M (+ p 6) IF-B) e (gn-sir M (+ p 24) IF-A)]
    (if (and (> lit 0) (= (gn-fnf M f FF-SIR) p)
         (= (gn-fnf M f FF-NPARAMS) 6) (= (gn-fnf M f FF-NSLOTS) 10)
         (= (gn-fnf M f FF-DEPTH) 8) (= (gn-fnf M f FF-PT0) TY-VEC)
         (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
         (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
         (= (ck-pt M f 5) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
         (> n 0) (<= n 64) (= (bit-and n 1) 0)
         (<= (* n 8) (gn-litf M lit LF-LEN))
         (>= oa 0) (< oa 4095) (>= sh 0) (<= sh 63)
         (> h 0) (< h MM-LABEL-CAP) (> b 0) (< b MM-LABEL-CAP)
