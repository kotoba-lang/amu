01 0 13 -2005 0 2] (bit-and k 63)) 11 (vector-at [4 1 28 0 6 2 0 0 13 -2004 0 1 5 29 0 0 4 0 23 0 4 1 28 0 6 1 0 0 13 -2004 0 1 5 30 0 0 4 0 23 0 4 1 28 0 6 2 0 0 13 -2004 0 1 5 31 0 0 4 0 24 0 4 1 29 0] (bit-and k 63)) 12 (vector-at [6 1 0 0 13 -2004 0 1 5 32 0 0 4 0 24 0 4 1 29 0 6 2 0 0 13 -2004 0 1 5 33 0 0 4 0 1 0 4 1 2 0 4 2 3 0 3 3 0 0 4 4 4 0 11 4 -1211 0 4 4 30 0 4 5 17 0] (bit-and k 63)) 13 (vector-at [6 1 4 0 13 -2006 4 1 10 -1215 0 0 9 -1211 0 0 4 4 30 0 4 5 17 0 6 1 4 0 9 -1215 0 0 13 -2009 0 5 5 34 0 0 4 0 34 0 4 1 2 0 4 2 3 0 3 3 1 0 4 4 4 0 11 4 -1229 0] (bit-and k 63)) 14 (vector-at [4 4 32 0 4 5 18 0 6 1 4 0 13 -2006 4 1 10 -1233 0 0 9 -1229 0 0 4 4 32 0 4 5 18 0 6 1 4 0 9 -1233 0 0 13 -2009 0 5 5 35 0 0 4 0 35 0 4 1 2 0 4 2 3 0 3 3 2 0] (bit-and k 63)) 15 (vector-at [4 4 4 0 11 4 -1247 0 4 4 33 0 4 5 19 0 6 1 4 0 13 -2006 4 1 10 -1251 0 0 9 -1247 0 0 4 4 33 0 4 5 19 0 6 1 4 0 9 -1251 0 0 13 -2009 0 5 5 36 0 0 4 0 36 0 4 1 2 0] (bit-and k 63)) 16 (vector-at [4 2 3 0 3 3 3 0 4 4 4 0 11 4 -1265 0 4 4 31 0 4 5 20 0 6 2 4 0 13 -2006 4 1 10 -1269 0 0 9 -1265 0 0 4 4 31 0 4 5 20 0 6 2 4 0 9 -1269 0 0 13 -2009 0 5 5 37 0 0] (bit-and k 63)) 17 (vector-at [4 0 37 0 4 1 2 0 4 2 3 0 3 3 4 0 4 4 4 0 11 4 -1283 0 4 4 31 0 4 5 20 0 6 1 4 0 13 -2006 4 1 10 -1287 0 0 9 -1283 0 0 4 4 31 0 4 5 20 0 6 1 4 0 9 -1287 0 0] (bit-and k 63)) 18 (vector-at [13 -2009 0 5 5 38 0 0 4 0 38 0 4 1 2 0 4 2 3 0 3 3 5 0 4 4 4 0 11 4 -1301 0 4 4 33 0 4 5 19 0 6 2 4 0 13 -2006 4 1 10 -1305 0 0 9 -1301 0 0 4 4 33 0 4 5 19 0] (bit-and k 63)) 19 (vector-at [6 2 4 0 9 -1305 0 0 13 -2009 0 5 5 39 0 0 4 0 39 0 4 1 2 0 4 2 3 0 3 3 6 0 4 4 4 0 11 4 -1319 0 4 4 32 0 4 5 18 0 6 2 4 0 13 -2006 4 1 10 -1323 0 0 9 -1319 0 0] (bit-and k 63)) 20 (vector-at [4 4 32 0 4 5 18 0 6 2 4 0 9 -1323 0 0 13 -2009 0 5 5 40 0 0 4 0 40 0 4 1 2 0 4 2 3 0 3 3 7 0 4 4 4 0 11 4 -1337 0 4 4 30 0 4 5 17 0 6 2 4 0 13 -2006 4 1] (bit-and k 63)) 21 (vector-at [10 -1341 0 0 9 -1337 0 0 4 4 30 0 4 5 17 0 6 2 4 0 9 -1341 0 0 13 -2009 0 5 9 -1343 0 0 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002)
 2 (case (quot k 64) 0 (vector-at [1 -1000000 4 4 18 0 0 0 9 -1002 0 0 4 0 4 0 3 1 8 0 7 1 0 0 11 0 -1009 0 3 0 1 0 10 -1033 0 0 9 -1009 0 0 4 0 1 0 4 1 2 0 4 2 3 0 4 3 4 0 6 3 2 0 6 1 1 0] (bit-and k 63)) 1 (vector-at [14 176 0 2 3 1 0 0 7 1 0 0 11 0 -1032 0 4 0 1 0 4 1 2 0 4 2 3 0 4 3 4 0 3 4 1 0 6 1 3 0 5 1 0 0 5 2 1 0 5 3 2 0 5 4 3 0 18 0 0 0 10 -1002 0 0] (bit-and k 63)) 2 (vector-at [9 -1032 0 0 9 -1033 0 0 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002)
 3 (case (quot k 64) 0 (vector-at [1 -1000000 5 5 18 0 0 0 9 -1002 0 0 4 0 4 0 3 1 8 0 7 1 0 0 11 0 -1009 0 4 0 1 0 10 -1029 0 0 9 -1009 0 0 4 0 1 0 4 1 2 0 4 2 3 0 4 3 4 0 4 4 5 0 13 -2009 0 5] (bit-and k 63)) 1 (vector-at [4 1 2 0 4 2 3 0 4 3 4 0 3 4 1 0 6 1 3 0 4 4 5 0 5 1 0 0 5 2 1 0 5 3 2 0 5 4 3 0 5 5 4 0 18 0 0 0 10 -1002 0 0 9 -1029 0 0 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002)
 4 (case (quot k 64) 0 (vector-at [1 -1000000 1 2 9 -1001 0 0 4 0 1 0 3 1 65535 0 6 5 0 0 5 2 0 0 4 0 2 0 3 1 32768 0 7 5 0 0 11 0 -1014 0 4 0 2 0 3 1 65536 0 6 2 0 0 10 -1016 0 0 9 -1014 0 0 4 0 2 0] (bit-and k 63)) 1 (vector-at [9 -1016 0 0 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002)
 5 (case (quot k 64) 0 (vector-at [1 -1000000 2 2 18 0 0 0 9 -1002 0 0 4 0 1 0 13 -2004 0 1 4 1 2 0 6 3 0 0 3 1 128 0 6 1 0 0 3 1 256 0 13 -2007 0 2 13 -2004 0 1 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002)
 6 (case (quot k 64) 0 (vector-at [1 -1000000 1 1 18 0 0 0 9 -1002 0 0 4 0 1 0 3 1 64 0 6 1 0 0 3 1 128 0 13 -2007 0 2 3 1 128 0 6 1 0 0 13 -2008 0 1 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002)
 7 (case (quot k 64) 0 (vector-at [1 -1000000 2 2 9 -1001 0 0 4 0 1 0 3 1 0 0 7 2 0 0 11 0 -1018 0 3 0 0 0 3 1 0 0 4 2 1 0 6 2 1 0 4 2 2 0 3 3 1 0 6 2 2 0 6 1 1 0 4 2 2 0 6 4 1 0] (bit-and k 63)) 1 (vector-at [6 2 0 0 10 -1022 0 0 9 -1018 0 0 4 0 1 0 4 1 2 0 6 4 0 0 9 -1022 0 0 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002)
 8 (case (quot k 64) 0 (vector-at [1 -1000000 1 2 18 0 0 0 9 -1002 0 0 4 0 1 0 13 -2004 0 1 5 2 0 0 4 0 2 0 3 1 0 0 7 2 0 0 11 0 -1012 0 3 0 0 0 10 -1022 0 0 9 -1012 0 0 4 0 2 0 3 1 255 0 7 3 0 0] (bit-and k 63)) 1 (vector-at [11 0 -1019 0 3 0 255 0 10 -1021 0 0 9 -1019 0 0 4 0 2 0 9 -1021 0 0 9 -1022 0 0 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002)
 9 (case (quot k 64) 0 (vector-at [1 -1000000 5 5 18 0 0 0 9 -1002 0 0 4 0 1 0 4 1 2 0 4 2 3 0 4 3 4 0 6 3 2 0 6 1 1 0 4 2 5 0 13 -2004 2 1 13 -2010 0 3 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002)
 10 (case (quot k 64) 0 (vector-at [1 -1000000 3 3 18 0 0 0 9 -1002 0 0 4 0 1 0 4 1 2 0 4 2 3 0 14 208 0 3 19 0 0 0 2 -1000000 0 0] (bit-and k 63)) -1000002) -1000002))

(defn- clw-counts [M :vector-i64] :bool
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N) ln (vector-at M MM-LABEL-N)]
  (and (> sn 1) (<= sn MM-SIR-CAP) (> fnn 1) (<= fnn MM-FN-CAP)
   (> ln 0) (< ln MM-LABEL-CAP))))
(defn- clw-records [role :i64] :i64 (case role 0 43 1 346 2 36 3 32 4 19 5 14 6 13 7 25 8 25 9 14 10 9 0))
(defn- clw-safe [M :vector-i64 f :i64 n :i64] :bool
 (if (or (not (clw-counts M)) (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N)) (<= n 2) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR) sn (vector-at M MM-SIR-N)]
   (and (> p 0) (<= p (- sn n)) (gn-dot-at? M p OP-FN f (gn-fnf M f FF-NPARAMS) (gn-fnf M f FF-NSLOTS))
    (gn-dot-at? M (+ p (dec n)) OP-END f 0 0)))))
(defn- clw-target [M :vector-i64 f :i64 n :i64 at :i64] :i64
 (if (or (not (clw-safe M f n)) (< at 1) (>= at (dec n))) 0
  (let [p (+ (gn-fnf M f FF-SIR) at)]
   (if (not= (gn-op M p) OP-CALL) 0
    (let [a (gn-sir M p IF-A) q (if (< a 0) (- (- a) 5) a)]
     (if (or (<= q 0) (>= q MM-FN-CAP) (>= q (vector-at M MM-FN-N))) 0 q))))))
(defn- clw-role [M :vector-i64 f :i64 role :i64] :i64
 (case role 0 f 1 (clw-target M f 43 30)
  2 (clw-target M (clw-role M f 1) 346 7)
  3 (clw-target M (clw-role M f 1) 346 25)
  4 (clw-target M (clw-role M f 1) 346 47)
  5 (clw-target M (clw-role M f 1) 346 82)
  6 (clw-target M (clw-role M f 1) 346 20)
  7 (clw-target M (clw-role M f 5) 14 10)
  8 (clw-target M (clw-role M f 6) 13 10)
  9 (clw-target M (clw-role M f 1) 346 216)
  10 (clw-target M (clw-role M f 9) 14 11) 0))

(defn- clw-np [role :i64] :i64 (case role 0 3 1 4 2 4 3 5 4 1 5 2 6 1 7 2 8 1 9 5 10 3 0))

(defn- clw-ns [role :i64] :i64 (case role 0 3 1 40 2 4 3 5 4 2 5 2 6 1 7 2 8 2 9 5 10 3 0))

(defn- clw-dp [role :i64] :i64 (case role 0 4 1 6 2 5 3 5 4 2 5 2 6 2 7 4 8 2 9 4 10 3 0))

(defn- clw-rtype [role :i64] :i64 (case role 0 4 1 4 2 2 3 4 4 1 5 1 6 1 7 1 8 1 9 4 10 4 0))

(defn- clw-fuel [role :i64] :i64 (case role 0 1 1 1 2 1 3 1 4 0 5 1 6 1 7 0 8 1 9 1 10 1 0))

(defn- clw-type [role :i64 k :i64] :i64 (case role 0 (vector-at [4 2 1] k) 1 (vector-at [4 1 1 2] k) 2 (vector-at [4 1 1 1] k) 3 (vector-at [4 1 1 1 1] k) 4 (vector-at [1] k) 5 (vector-at [1 1] k) 6 (vector-at [1] k) 7 (vector-at [1 1] k) 8 (vector-at [1] k) 9 (vector-at [4 1 1 1 1] k) 10 (vector-at [4 1 1] k) 0))

(defn- clw-types [M :vector-i64 f :i64 role :i64] :bool
 (and (= (gn-fnf M f FF-NPARAMS) (clw-np role)) (= (gn-fnf M f FF-NSLOTS) (clw-ns role))
  (= (gn-fnf M f FF-DEPTH) (clw-dp role)) (= (gn-fnf M f FF-RTYPE) (clw-rtype role))
  (= (gn-fnf M f FF-FUEL) (clw-fuel role))
  (or (= (gn-fnf M f FF-KIND) FK-DEFN) (= (gn-fnf M f FF-KIND) FK-PRIV))
  (loop [k 0] (or (= k (clw-np role)) (and (= (gn-fnf M f (+ FF-PT0 k)) (clw-type role k)) (recur (inc k)))))))
(defn- clw-field [M :vector-i64 root :i64 f :i64 role :i64 j :i64 k :i64] :bool
 (let [p (gn-fnf M f FF-SIR) expected (clw-cell role (+ (* j 4) k)) value (gn-sir M (+ p j) k)]
  (cond (= expected -1000000) (= value f)
   (= expected -1000001) (or (not= role 0) (and (>= value 0) (<= value 16777216)))
   (and (<= expected -1000) (> expected -2000))
    (let [q (- (- expected) 1000)] (and (> value 0) (< value (vector-at M MM-LABEL-N))
      (gn-dot-at? M (+ p q) OP-LABEL value 0 0)
      (loop [at 1] (or (= at (vector-at M MM-SIR-N))
        (and (or (not= (gn-op M at) OP-LABEL) (not= (gn-sir M at IF-A) value) (= at (+ p q))) (recur (inc at)))))))
   (and (<= expected -2000) (> expected -3000))
    (let [r (- (- expected) 2000) target (if (< value 0) (- (- value) 5) value)
          required (if (and (= role 0) (= f (dec (vector-at M MM-FN-N))) (< (gn-fnf M f FF-EXPORT) 0)) (- (vector-at M MM-FN-N) 2) (clw-role M root r))]
     (and (> required 0) (= target required) (= (gn-sir M (+ p j) IF-C) (clw-np r))))
   :else (= value expected))))
(defn- clw-pattern [M :vector-i64 root :i64 f :i64 role :i64] :bool
 (and (clw-safe M f (clw-records role)) (clw-types M f role)
  (loop [j 0] (or (= j (clw-records role))
   (and (loop [k 0] (or (= k 4) (and (clw-field M root f role j k) (recur (inc k))))) (recur (inc j)))))))
(defn- clw-caller [M :vector-i64 f :i64] :i64
 (if (not (clw-safe M f 43)) 0
  (if (or (<= (gn-fnf M f FF-SYM) 0) (not (clw-types M f 0))) 0
   (if (loop [r 0] (or (= r 11)
       (let [q (clw-role M f r)] (and (> q 0) (> (gn-fnf M q FF-SYM) 0)
        (clw-pattern M f q r) (recur (inc r)))))) (clw-role M f 1) 0))))
(defn- clw-pick [M :vector-i64 f :i64 end :i64] :i64
 (if (>= f end) 0 (if (> (clw-caller M f) 0) f (clw-pick M (inc f) end))))
(defn- clw-original [M :vector-i64 f :i64 end :i64] :bool
 (if (>= f end) true (and (> (gn-fnf M f FF-SYM) 0) (>= (gn-fnf M f FF-EXPORT) 0) (<= (gn-fnf M f FF-EXPORT) 2) (clw-original M (inc f) end))))
(defn- clw-labels [M :vector-i64 i :i64 sn :i64 ln :i64 fnn :i64] :bool
 (if (>= i sn) true
  (let [op (gn-op M i) a (gn-sir M i IF-A) b (gn-sir M i IF-B)]
   (and (cond (= op OP-LABEL) (and (> a 0) (< a ln))
      (= op OP-BR) (and (> a 0) (< a ln))
      (or (= op OP-BRZ) (= op OP-BRNZ)) (and (> b 0) (< b ln))
      (or (= op OP-CALL) (= op OP-FADDR))
       (let [target (if (= op OP-CALL) a b) q (if (< target 0) (- (- target) 5) target)] (and (> q 0) (< q fnn)))
      (= op OP-CALLI) false (or (= op OP-FN) (= op OP-END)) (and (> a 0) (< a fnn)) :else true)
     (clw-labels M (inc i) sn ln fnn)))))
(defn- clw-copy-ff [M :vector-i64 old :i64 new :i64 p :i64 k :i64] :vector-i64
 (if (= k MM-FN-W) M
  (clw-copy-ff (gn-put M (+ MM-FN-BASE (* new MM-FN-W) k)
    (cond (= k FF-EXPORT) (- old) (= k FF-KIND) FK-PRIV (= k FF-SIR) p (= k FF-CODE) 0 :else (gn-fnf M old k))) old new p (inc k))))
(defn- clw-copy-sir [M :vector-i64 old :i64 new :i64 dest :i64 n :i64 delta :i64 callee :i64 j :i64] :vector-i64
 (if (= j n) M
  (let [p (+ (gn-fnf M old FF-SIR) j) op (gn-op M p) a (gn-sir M p IF-A) b (gn-sir M p IF-B) c (gn-sir M p IF-C)
        aa (cond (or (= op OP-FN) (= op OP-END)) new (or (= op OP-LABEL) (= op OP-BR)) (+ a delta)
             (and (= n 43) (= j 30)) callee :else a)
        bb (if (or (= op OP-BRZ) (= op OP-BRNZ)) (+ b delta) b)
        m (-> M (gn-put (+ MM-SIR-BASE (* (+ dest j) MM-SIR-W) IF-OP) op)
          (gn-put (+ MM-SIR-BASE (* (+ dest j) MM-SIR-W) IF-A) aa)
          (gn-put (+ MM-SIR-BASE (* (+ dest j) MM-SIR-W) IF-B) bb)
          (gn-put (+ MM-SIR-BASE (* (+ dest j) MM-SIR-W) IF-C) c))]
   (clw-copy-sir m old new dest n delta callee (inc j)))))
(defn- clw-prepare [M :vector-i64] :vector-i64
 (if (not (clw-counts M)) M
  (let [fnn (vector-at M MM-FN-N) sn (vector-at M MM-SIR-N) ln (vector-at M MM-LABEL-N)
        cn (vector-at M MM-CODE-N) xn (vector-at M MM-FIX-N)]
   (if (or (> fnn (- MM-FN-CAP 2)) (> sn (- MM-SIR-CAP 389)) (>= ln (quot MM-LABEL-CAP 3))
       (<= cn 0) (> cn (- MM-CODE-CAP 16384)) (<= xn 0) (> xn (- MM-FIX-CAP 1024))
       (not (clw-original M 1 fnn)) (not (clw-labels M 1 sn ln fnn))) M
    (let [f (clw-pick M 1 fnn)] (if (= f 0) M
     (let [callee (clw-caller M f)
       m (-> M (clw-copy-ff callee fnn sn 0) (clw-copy-ff f (inc fnn) (+ sn 346) 0)
         (clw-copy-sir callee fnn sn 346 ln 0 0)
         (clw-copy-sir f (inc fnn) (+ sn 346) 43 (* ln 2) fnn 0))]
      (-> m (gn-put MM-FN-N (+ fnn 2)) (gn-put MM-SIR-N (+ sn 389)) (gn-put MM-LABEL-N (* ln 3))))))))))
(defn- clw-exports [M :vector-i64 k :i64 n :i64 first :i64] :bool
 (if (>= k n) true
  (let [f (vector-at M (+ MM-EXP-BASE (* k MM-EXP-W) EF-FN))]
   (and (> f 0) (< f first) (clw-exports M (inc k) n first)))))
(defn- clw-edges [M :vector-i64 i :i64 end :i64 cf :i64 lf :i64 cp :i64 lp :i64] :bool
 (if (>= i end) true
  (let [op (gn-op M i) a (gn-sir M i IF-A) b (gn-sir M i IF-B)
       target (if (= op OP-FADDR) b a) f (if (< target 0) (- (- target) 5) target)
       label (if (= op OP-BR) a b)
       owned (and (>= i cp) (< i (+ cp 346))) owner2 (and (>= i lp) (< i (+ lp 43)))
       labelcf (and (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ)) (loop [j 0] (and (< j 346) (or (and (= (gn-op M (+ cp j)) OP-LABEL) (= (gn-sir M (+ cp j) IF-A) label)) (recur (inc j))))))
       labellf (and (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ)) (loop [j 0] (and (< j 43) (or (and (= (gn-op M (+ lp j)) OP-LABEL) (= (gn-sir M (+ lp j) IF-A) label)) (recur (inc j))))))]
   (and (cond (= op OP-CALL) (and (not= f lf) (or (not= f cf) (= i (+ lp 30))))
      (= op OP-FADDR) (and (not= f cf) (not= f lf))
      (= op OP-CALLI) false
      (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ)) (and (or (not labelcf) owned) (or (not labellf) owner2))
      :else true)
    (clw-edges M (inc i) end cf lf cp lp)))))
(defn- clw-ownership [M :vector-i64 cf :i64 lf :i64] :bool
 (let [en (vector-at M MM-EXP-N) cp (gn-fnf M cf FF-SIR) lp (gn-fnf M lf FF-SIR)]
  (and (>= en 0) (<= en MM-EXP-CAP) (clw-exports M 1 en cf)
   (clw-edges M 1 (vector-at M MM-SIR-N) cf lf cp lp))))
(defn- clw-witness [M :vector-i64 f :i64 caller :bool] :i64
 (if (not (clw-counts M)) 0
  (let [fnn (vector-at M MM-FN-N) cf (- fnn 2) lf (dec fnn)]
   (if (or (<= cf 1) (not= f (if caller lf cf)) (not (clw-safe M lf 43)) (not (clw-safe M cf 346))) 0
    (let [root (- (gn-fnf M lf FF-EXPORT)) original (- (gn-fnf M cf FF-EXPORT))]
     (if (or (<= root 0) (>= root cf) (<= original 0) (>= original cf)) 0
      (if (and (= (clw-caller M root) original) (clw-pattern M root cf 1) (clw-pattern M root lf 0) (clw-ownership M cf lf)) root 0)))))))
(defn- clw-disjoint [M :vector-i64 P :vector-i64 k :i64] :vector-i64
 ;; interval[3,10) and other[11,12), overflow checked by the caller.
 (scfill-disjoint M P k))
(defn- clw-alias [M :vector-i64 P :vector-i64] :vector-i64
 ;; The witness spans calls: exclude metadata/context as well as payload from
 ;; ALL possible nested frames (11 closed functions, each <=512B).
 (-> M (gn-emit (enc-mov-sp 14 31))
  (gn-mov-imm 17 16384) (gn-emit (enc-cmp-r 14 17)) (vl-guard P 9 (enc-cond-lo))
  (gn-mov-imm 17 -128) (gn-emit (enc-cmp-r 14 17)) (vl-guard P 10 (enc-cond-hs))
  (gn-emit (enc-add-i 15 14 128))
  ;; reset lower endpoint using positive 16KiB: no instruction-immediate overflow
  (gn-emit (enc-mov-sp 14 31)) (gn-mov-imm 17 16384) (gn-emit (enc-sub-r 14 14 17))
  (gn-emit (enc-ldr 3 7 328)) (gn-mov-imm 17 -1073741824) (gn-emit (enc-cmp-r 3 17)) (vl-guard P 11 (enc-cond-hs))
  (gn-mov-imm 17 1073741824) (gn-emit (enc-add-r 10 3 17))
  (gn-mov 11 7) (gn-mov-imm 17 -400) (gn-emit (enc-cmp-r 11 17)) (vl-guard P 12 (enc-cond-hs))
  (gn-emit (enc-add-i 12 11 400)) (clw-disjoint P 13)
  (gn-emit (enc-ldr 11 7 312)) (gn-mov-imm 17 -8) (gn-emit (enc-cmp-r 11 17)) (vl-guard P 14 (enc-cond-hs))
  (gn-emit (enc-add-i 12 11 8)) (clw-disjoint P 15)
  (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 12 31 13 4)) (gn-emit (enc-add-r 12 11 12)) (clw-disjoint P 16)
  (gn-mov 11 14) (gn-mov 12 15) (clw-disjoint P 17)
  ;; context, count and descriptor intervals must also miss the live frame band
  (gn-mov 3 14) (gn-mov 10 15)
  (gn-mov 11 7) (gn-emit (enc-add-i 12 11 400)) (clw-disjoint P 18)
  (gn-emit (enc-ldr 11 7 312)) (gn-emit (enc-add-i 12 11 8)) (clw-disjoint P 19)
  (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 12 31 13 4)) (gn-emit (enc-add-r 12 11 12)) (clw-disjoint P 20)
  ;; fuel publications cannot mutate count/descriptors while calls are retained
  (gn-mov 3 7) (gn-emit (enc-add-i 10 3 400))
  (gn-emit (enc-ldr 11 7 312)) (gn-emit (enc-add-i 12 11 8)) (clw-disjoint P 21)
  (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 12 31 13 4)) (gn-emit (enc-add-r 12 11 12)) (clw-disjoint P 22)))
(defn- clw-loop-entry [M :vector-i64 i :i64] :vector-i64
 (let [fnn (vector-at M MM-FN-N) cf (- fnn 2) lf (dec fnn)]
  (if (or (not (clw-counts M)) (<= cf 1) (not (clw-safe M lf 43))) M
   (let [root (- (gn-fnf M lf FF-EXPORT))]
    (if (or (<= root 0) (>= root cf) (not= i (inc (gn-fnf M root FF-SIR)))
      (= (clw-witness M lf true) 0) (not= (gn-g M gn-f-leaf) 0)
      (not= (gn-g M gn-f-freg) 0) (not= (gn-g M gn-f-fb) 112)
      (not= (gn-g M gn-f-ns) 3) (not= (gn-g M gn-f-dp) 4)
      (not= (gn-g M gn-f-nsv) 3) (not= (gn-g M gn-f-out) 0) (not= (gn-g M gn-f-h) 0)
      (not= (gn-g M gn-f-dead) 0) (not (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1)))
      (not= (gn-g M gn-f-ctx) 1) (not= (gn-g M gn-f-skip) 0)) M
     (let [P (vector-alloc 23) base (gn-sir M (+ (gn-fnf M root FF-SIR) 11) IF-B)
        m (-> M (gn-mov 0 (gn-sreg M 1)) (gn-mov 1 (gn-sreg M 3))
          (gn-emit (enc-cmp-i 1 8)) (vl-guard P 0 (enc-cond-hs))
          (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 0)) (vl-guard P 1 (enc-cond-lt))
          (gn-mov-imm 17 8) (gn-emit (enc-sub-r 17 17 1)) (gn-mov-imm 9 46)
          (gn-emit (enc-mul 17 17 9)) (gn-emit (enc-cmp-r 16 17)) (vl-guard P 2 (enc-cond-lo))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 13 16 0))
          (gn-mov-imm 17 4194305) (gn-emit (enc-cmp-r 13 17)) (vl-guard P 3 (enc-cond-hs))
          (gn-emit (enc-sub-i 9 0 1)) (gn-emit (enc-cmp-r 9 13)) (vl-guard P 4 (enc-cond-hs))
          (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 12 31 13 4)) (gn-emit (enc-sub-r 17 31 12))
          (gn-emit (enc-cmp-r 11 17)) (vl-guard P 5 (enc-cond-hs))
          (gn-emit (gn-e-addsl 16 11 9 4)) (gn-emit (enc-ldp 5 6 16 0))
          (gn-mov-imm 17 134217728) (gn-emit (enc-cmp-r 5 17)) (vl-guard P 6 (enc-cond-hs))
          (gn-emit (enc-sub-r 16 17 5)) (gn-emit (enc-cmp-r 6 16)) (vl-guard P 7 8)
          (gn-mov-imm 17 (+ base 63)) (gn-emit (enc-cmp-r 17 6)) (vl-guard P 8 (enc-cond-hs))
          (clw-alias P) (gn-fix FX-B26 (gn-sir M (+ (gn-fnf M lf FF-SIR) 2) IF-A)) (gn-emit (enc-b 0)))
        cold (vector-at m MM-CODE-N)] (scfill-patches m P cold)))))))

;; ADR0357 one-off bounded algorithm: pair only already-certified private fills.
;; The non-flag-setting guard and exact scalar fallback preserve rejection NZCV.
(defn- ufill-count? [n :i64] :bool
 (and (>= n 2) (<= n 8) (= (bit-and n 1) 0)))
(defn- ufill-loop [M :vector-i64 n :i64] :vector-i64
 (let [m0 (gn-mov-imm M 6 n) head (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-str 0 4 0)) (gn-emit (enc-add-r 4 4 5))
        (gn-emit (enc-subs-i 6 6 1))) back (vector-at m1 MM-CODE-N)]
  (gn-emit m1 (enc-bcond (enc-cond-ne) (- head back)))))
(defn- ufill-linear [M :vector-i64 n :i64 k :i64] :vector-i64
 (if (= k n)
  ;; Restore precisely the final loop counter and SUBS NZCV endpoint.
  (-> M (gn-mov-imm 6 1) (gn-emit (enc-subs-i 6 6 1)))
  (ufill-linear (-> M (gn-emit (enc-str 0 4 0))
                     (gn-emit (enc-add-r 4 4 5))) n (inc k))))
(defn- ufill-scalar [M :vector-i64 n :i64] :vector-i64
 ;; Only already-certified bounded fills. Keep every scalar store in order,
 ;; the address after each store, and the final x6/NZCV. No new memory reads.
 (if (and (>= n 2) (<= n 8) (> (vector-at M MM-CODE-N) 0)
          (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP (+ (* 2 n) 2))))
  (ufill-linear M n 0) (ufill-loop M n)))
(defn- ufill-pairs [M :vector-i64 n :i64 k :i64] :vector-i64
 (if (= k n) M
  (ufill-pairs (gn-emit M (enc-stp 0 0 4 (* k 8))) n (+ k 2))))
(defn- ufill-emit [M :vector-i64 n :i64] :vector-i64
 (if (or (not (ufill-count? n)) (<= (vector-at M MM-CODE-N) 0)
     (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 64))) (ufill-scalar M n)
  (let [m0 (-> M (gn-emit (gn-e-bf 0xd3400000 6 4 0 2))
        (gn-emit (enc-orr-r 6 6 5)) (gn-emit (enc-sub-i 6 6 8)))
        reject (vector-at m0 MM-CODE-N) m1 (gn-emit m0 (enc-cbnz 6 0))
        m2 (-> (ufill-pairs m1 n 0) (gn-emit (enc-add-i 4 4 (* n 8)))
         (gn-mov-imm 6 1) (gn-emit (enc-subs-i 6 6 1)))
        jump (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-b 0))
        scalar (vector-at m3 MM-CODE-N) m4 (ufill-scalar m3 n)
        done (vector-at m4 MM-CODE-N)]
   (-> m4 (gn-put (+ MM-CODE-BASE reject) (enc-cbnz 6 (- scalar reject)))
    (gn-put (+ MM-CODE-BASE jump) (enc-b (- done jump)))))))

(defn- clw-paid16 [M :vector-i64] :bool
 (if (< (vector-count M) MM-WORDS) false
  (let [cn (vector-at M MM-CODE-N)]
   (and (>= cn 5) (<= cn MM-CODE-CAP)
    (= (sf-word M (- cn 5)) (enc-ldr 16 7 CTX-FUEL))
    (= (sf-word M (- cn 4)) (enc-subs-i 16 16 1))
    (= (sf-word M (- cn 3)) (enc-bcond (enc-cond-hs) 2))
    (= (sf-word M (- cn 2)) (enc-brk 0))
    (= (sf-word M (dec cn)) (enc-str 16 7 CTX-FUEL))))))

;; ADR0357 novel path-sensitive restore elision, not a mechanical benchmark rewrite.
;; Preserve the complete saved frame; no caller ABI or runtime guard is weakened.
(defn- dcr-prologue [M :vector-i64 start :i64 end :i64] :bool
 (and (> start 0) (<= (+ start 13) end)
  (= (sf-word M start) (enc-stp-pre 29 30 31 -16))
  (= (sf-word M (+ start 1)) (enc-mov-sp 29 31))
  (= (sf-word M (+ start 2)) (enc-sub-i 31 31 464))
  (loop [k 0] (or (= k 5)
   (and (= (sf-word M (+ start 3 k)) (enc-stp (+ 19 (* k 2)) (+ 20 (* k 2)) 31 (* k 16))) (recur (inc k)))))
  (= (sf-word M (+ start 8)) (enc-str 7 31 (gn-soff M 0)))
  (loop [k 1] (or (= k 5)
   (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 22)
    (= (sf-word M (+ start 8 k)) (enc-mov-r (gn-sreg M k) (dec k))) (recur (inc k)))))))
(defn- dcr-word [M :vector-i64 at :i64 first :i64 end :i64 false-at :i64] :bool
 (let [w (sf-word M at) kind (hld-kind w) writes (hld-write w)
   rn (bit-and (i64-shift-right w 5) 31) dest (bit-and w 31)]
  (and (> kind 0) (not= kind 3) (>= writes 0)
   (= (bit-and writes 0x7ff80080) 0)
   ;; No SP/FP update or new saved-slot stores after canonical prologue.
   (not (and (or (= kind 7) (= kind 8) (= kind 9) (= kind 10) (= kind 11) (= kind 12)) (= rn 31)))
   (not (and (= kind 11) (= (bit-and w 0xffc00000) 0xa8c00000)))
   (not (and (= kind 12) (= (bit-and w 0xffc00000) 0xa9800000)))
   (not (and (= (bit-and w 0x1f000000) 0x11000000)
    (or (= rn 31) (and (= dest 31) (= (bit-and w 0x20000000) 0)))))
   (if (or (= kind 4) (= kind 5) (= kind 6))
    (if (= at false-at) (= w (enc-cbnz 9 0))
     (let [to (of-dest w at)] (and (>= to first) (<= to end)))) true))))
(defn- dcr-code [M :vector-i64 first :i64 end :i64 false-at :i64] :bool
 (and (>= false-at first) (< false-at end)
  (loop [at first] (or (= at end)
   (and (dcr-word M at first end false-at) (recur (inc at)))))))
(defn- dcr-admit [M :vector-i64 f :i64 i :i64 false-at :i64] :bool
 (if (not (jdf-counts M)) false
  (if (or (<= f 0) (>= f (vector-at M MM-FN-N))
   (<= i 0) (>= i (vector-at M MM-SIR-N)) (not (> (clw-witness M f false) 0))) false
   (let [p (gn-fnf M f FF-SIR) start (gn-fnf M f FF-CODE) end (vector-at M MM-CODE-N)]
    (and (= i (+ p 7)) (> start 0) (> end start) (<= (- end start) 512)
     (= (gn-g M gn-f-fb) 464) (= (gn-g M gn-f-out) 0)
     (= (gn-g M gn-f-nsv) 10) (= (gn-g M gn-f-ctx) 1)
     (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-leaf) 0)
     (dcr-prologue M start end)
     (dcr-code M (+ start 13) end false-at))))))
(defn- dcr-return [M :vector-i64] :vector-i64
 (-> M (gn-emit (enc-mov-r 0 9))
  (gn-emit (enc-ldp 19 20 31 0)) (gn-emit (enc-ldp 21 22 31 16))
  (gn-emit (enc-mov-sp 31 29)) (gn-emit (enc-ldp-post 29 30 31 16))
  (gn-emit (enc-ret))))

;; Sequential bounded scan: retain each original load, early exit, pointer
;; advance and flag-setting countdown. Only the successful loop-back branches
;; are removed. One shared nonzero bridge retains the original cold-path hook.
(defn- clw-scan-unroll [M :vector-i64 P :vector-i64 k :i64 n :i64] :vector-i64
 (if (= k n) M
  (let [m1 (gn-emit M (enc-ldr 9 3 0)) at (vector-at m1 MM-CODE-N)
        saved (vector-assoc! P k at)
        m2 (-> m1 (gn-emit (enc-cbnz 9 0))
          (gn-emit (enc-add-r 3 3 5)) (gn-emit (enc-subs-i 6 6 1)))]
   (clw-scan-unroll m2 saved (inc k) n))))
(defn- clw-scan [M :vector-i64 n :i64] :vector-i64
 (if (or (< n 2) (> n 8))
  (let [head (vector-at M MM-CODE-N) m1 (gn-emit M (enc-ldr 9 3 0))
        false-at (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-cbnz 9 0)) (gn-emit (enc-add-r 3 3 5))
          (gn-emit (enc-subs-i 6 6 1))) back (vector-at m2 MM-CODE-N)]
   (gn-put (gn-emit m2 (enc-bcond (enc-cond-ne) (- head back))) MM-R0 false-at))
  (let [P (vector-alloc (dec n)) m1 (clw-scan-unroll M P 0 (dec n))
        skip (vector-at m1 MM-CODE-N) m2 (gn-emit m1 (enc-b 2))
        false-at (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-cbnz 9 0))
        out (loop [V m3 k 0] (if (= k (dec n)) V
          (let [at (vector-at P k)]
           (recur (gn-put V (+ MM-CODE-BASE at) (enc-cbnz 9 (- false-at at))) (inc k)))))]
   (gn-put out MM-R0 false-at))))

(defn- clw-private-entry [M :vector-i64 i :i64] :vector-i64
 (let [owner (if (and (clw-counts M) (> i 0) (< i (vector-at M MM-SIR-N))) (jdag-owner M i 512) 0) f (if (> owner 0) (gn-sir M owner IF-A) 0)
       n (if (> (clw-witness M f false) 0) (scfill-admit M i) 0) ln (vector-at M MM-LABEL-N) xn (vector-at M MM-FIX-N)] (if (or (= n 0) (<= ln 0) (>= ln (- MM-LABEL-CAP 2)) (<= xn 0) (> xn (- MM-FIX-CAP 8))) M
  (let [paid (and (= i (+ owner 7)) (<= n 10) (clw-paid16 M)) P (vector-alloc (if paid 0 2)) scalar (gn-sir M (+ i 13) IF-A)
   ;; Caller entry already paid. Scratch only, no GN facts changed on refusal.
   staged (-> M (gn-put MM-LABEL-N (+ ln 2)) (gn-mov 0 (gn-sreg M 1)) (gn-mov 1 (gn-sreg M 2)) (gn-mov 2 (gn-sreg M 3)))
   m0 (-> (if paid (gn-mov staged 8 16)
     (-> staged (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 0)) (vl-guard P 0 (enc-cond-lt))
      (gn-emit (enc-cmp-i 8 (+ (* 4 n) 3))) (vl-guard P 1 (enc-cond-lo))))
    ;; Only compiler-private dominated calls reach this entry. Metadata rematerialized,
    ;; original element reads remain in the original scan/fill order below.
    (gn-emit (enc-ldr 11 7 320)) (gn-emit (enc-sub-i 9 0 1))
    (gn-emit (gn-e-addsl 16 11 9 4)) (gn-emit (enc-ldp 5 6 16 0))
    (gn-emit (enc-ldr 4 7 328)) (gn-emit (enc-add-r 5 5 1)) (gn-emit (gn-e-addsl 4 4 5 3))
    (gn-emit (gn-e-addsl 5 31 2 3)) (gn-emit (enc-add-r 3 4 5))
    (gn-mov-imm 6 (dec n)) (gn-mov-imm 10 (dec n)) (jdag-sub))
   scan (clw-scan m0 n) false-at (vector-at scan MM-R0)
   m3 (-> scan
     (gn-emit (enc-sub-r 8 8 10)) (jdag-publish) (gn-emit (enc-ldr 0 4 0))
     (gn-mov 16 (gn-sreg M 4))) plain-at (vector-at m3 MM-CODE-N)
   m4 (-> m3 (gn-emit (enc-cbz 16 0)) (scfill-rp scalar)) plain (vector-at m4 MM-CODE-N)
   m5 (-> m4 (gn-emit (gn-e-bf 0x93400000 0 0 0 15))
     (gn-emit (enc-sub-i 8 8 (+ (* 3 n) 1))) (jdag-publish))
   m6 (ufill-emit m5 n)
   direct-return (dcr-admit m6 f i false-at)
   return-state (-> m6 (gn-mov 9 (gn-sreg M 1)) (scfill-lr-fix (inc ln) (+ i 18)))
   m7 (if direct-return (dcr-return return-state)
     (-> return-state (gn-fix FX-B26 (gn-sir M (+ i 19) IF-A)) (gn-emit (enc-b 0))))
   false-start (vector-at m7 MM-CODE-N)
   m8 (-> m7 (gn-emit (enc-sub-r 10 10 6)) (gn-emit (enc-sub-r 8 8 10)) (jdag-publish) (gn-mov-imm 9 0) (scfill-lr-fix ln i)
      (gn-fix FX-B26 (gn-sir M (inc i) IF-B)) (gn-emit (enc-b 0)))
   cold (vector-at m8 MM-CODE-N)]
   (-> m8 (scfill-patches P cold)
    (gn-put (+ MM-CODE-BASE false-at) (enc-cbnz 9 (- false-start false-at)))
    (gn-put (+ MM-CODE-BASE plain-at) (enc-cbz 16 (- plain plain-at))))))))

(defn- clw-call [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :vector-i64
 (let [fast (clw-private-entry M i) m (scfill-entry fast i) xf (vector-at m MM-FIX-N) begin (vector-at m MM-CODE-N)
       pending (scfill-lr-pending m 1 xf i) out (gn-op-call m i f t n)]
  (if (not pending) out
   (let [ret (scfill-lr-bl out xf (vector-at out MM-FIX-N) f begin (vector-at out MM-CODE-N) 0)]
    (if (<= ret 0) (gn-err out E-GEN-OP i) (scfill-lr-bind out 1 xf i ret))))))

;; ADR0357 novel bounded acyclic field repair. Source-only, no qualification claim.
(defn- frfix-root0 [k :i64] :i64 (vector-at [1 60000 4 11 18 0 0 0 9 61000 0 0 4 0 1 0 4 1 2 0 14 176 0 2 5 5 0 0 4 0 1 0 4 1 5 0 4 2 3 0 13 60002 1 2 14 176 0 2 5 6 0 0 4 0 1 0 4 1 5 0 4 2 4 0] k))
(defn- frfix-root1 [k :i64] :i64 (vector-at [13 60002 1 2 14 176 0 2 5 7 0 0 4 0 1 0 4 1 6 0 4 2 3 0 13 60002 1 2 14 176 0 2 5 8 0 0 4 0 1 0 4 1 6 0 4 2 4 0 13 60002 1 2 14 176 0 2 5 9 0 0 4 0 1 0] k))
(defn- frfix-root2 [k :i64] :i64 (vector-at [4 1 7 0 13 60003 0 2 11 0 61005 0 4 0 1 0 4 1 6 0 13 60003 0 2 11 0 61002 0 4 0 1 0 4 1 8 0 13 60003 0 2 12 0 61001 0 4 0 1 0 4 1 9 0 13 60003 0 2 9 61001 0 0 9 61002 0 0] k))
(defn- frfix-root3 [k :i64] :i64 (vector-at [11 0 61003 0 4 0 1 0 4 1 6 0 3 2 1 0 13 60002 1 2 3 2 0 0 13 60001 0 3 4 1 7 0 3 2 1 0 13 60002 1 2 3 2 0 0 13 60001 0 3 4 1 5 0 3 2 1 0 13 60002 1 2 3 2 1 0] k))
(defn- frfix-root4 [k :i64] :i64 (vector-at [13 60001 0 3 10 61004 0 0 9 61003 0 0 4 0 1 0 9 61004 0 0 10 61012 0 0 9 61005 0 0 4 0 1 0 4 1 6 0 13 60003 0 2 11 0 61010 0 4 0 1 0 4 1 8 0 13 60003 0 2 11 0 61006 0 4 0 1 0] k))
(defn- frfix-root5 [k :i64] :i64 (vector-at [4 1 5 0 4 2 3 0 13 60002 1 2 4 2 9 0 13 60001 0 3 4 1 6 0 4 2 3 0 13 60002 1 2 4 2 8 0 13 60001 0 3 4 1 6 0 4 2 4 0 13 60002 1 2 4 2 5 0 13 60001 0 3 4 1 5 0] k))
(defn- frfix-root6 [k :i64] :i64 (vector-at [3 2 1 0 13 60002 1 2 3 2 1 0 13 60001 0 3 4 1 6 0 3 2 1 0 13 60002 1 2 3 2 0 0 13 60001 0 3 4 1 2 0 4 2 6 0 13 60001 0 3 10 61009 0 0 9 61006 0 0 4 0 1 0 4 1 9 0] k))
(defn- frfix-root7 [k :i64] :i64 (vector-at [13 60003 0 2 11 0 61007 0 4 0 1 0 4 1 9 0 4 2 3 0 13 60002 1 2 14 176 0 2 5 10 0 0 4 0 1 0 4 1 9 0 4 2 4 0 13 60002 1 2 14 176 0 2 5 11 0 0 4 0 1 0 4 1 6 0] k))
(defn- frfix-root8 [k :i64] :i64 (vector-at [4 2 4 0 13 60002 1 2 4 2 10 0 13 60001 0 3 4 1 5 0 4 2 3 0 13 60002 1 2 4 2 11 0 13 60001 0 3 4 1 9 0 4 2 3 0 13 60002 1 2 4 2 6 0 13 60001 0 3 4 1 9 0 4 2 4 0] k))
(defn- frfix-root9 [k :i64] :i64 (vector-at [13 60002 1 2 4 2 5 0 13 60001 0 3 4 1 9 0 3 2 1 0 13 60002 1 2 3 2 0 0 13 60001 0 3 4 1 5 0 3 2 1 0 13 60002 1 2 3 2 1 0 13 60001 0 3 4 1 2 0 4 2 9 0 13 60001 0 3] k))
(defn- frfix-root10 [k :i64] :i64 (vector-at [10 61008 0 0 9 61007 0 0 4 0 1 0 9 61008 0 0 9 61009 0 0 10 61011 0 0 9 61010 0 0 4 0 1 0 9 61011 0 0 9 61012 0 0 19 0 0 0 2 60000 0 0] k))
(defn- frfix-root-word [k :i64] :i64 (case (quot k 64) 0 (frfix-root0 (bit-and k 63)) 1 (frfix-root1 (bit-and k 63)) 2 (frfix-root2 (bit-and k 63)) 3 (frfix-root3 (bit-and k 63)) 4 (frfix-root4 (bit-and k 63)) 5 (frfix-root5 (bit-and k 63)) 6 (frfix-root6 (bit-and k 63)) 7 (frfix-root7 (bit-and k 63)) 8 (frfix-root8 (bit-and k 63)) 9 (frfix-root9 (bit-and k 63)) 10 (frfix-root10 (bit-and k 63)) -1))
(defn- frfix-writer0 [k :i64] :i64 (vector-at [1 60000 3 3 18 0 0 0 9 62000 0 0 4 0 1 0 4 1 2 0 4 2 3 0 14 208 0 3 19 0 0 0 2 60000 0 0] k))
(defn- frfix-writer-word [k :i64] :i64 (case (quot k 64) 0 (frfix-writer0 (bit-and k 63)) -1))
(defn- frfix-coord0 [k :i64] :i64 (vector-at [1 60000 2 2 9 62000 0 0 3 0 63000 0 4 1 1 0 3 2 1 0 6 2 1 0 3 2 63001 0 6 3 1 0 6 1 0 0 4 1 2 0 6 1 0 0 19 0 0 0 2 60000 0 0] k))
(defn- frfix-coord-word [k :i64] :i64 (case (quot k 64) 0 (frfix-coord0 (bit-and k 63)) -1))
(defn- frfix-pred0 [k :i64] :i64 (vector-at [1 60000 2 2 18 0 0 0 9 62000 0 0 4 0 2 0 3 1 0 0 7 1 0 0 8 1 0 0 11 0 62001 0 4 0 1 0 4 1 2 0 3 2 1 0 13 60002 1 2 14 176 0 2 3 1 1 0 7 1 0 0 9 62001 0 0] k))
(defn- frfix-pred1 [k :i64] :i64 (vector-at [19 0 0 0 2 60000 0 0] k))
(defn- frfix-pred-word [k :i64] :i64 (case (quot k 64) 0 (frfix-pred0 (bit-and k 63)) 1 (frfix-pred1 (bit-and k 63)) -1))

(defn- frfix-counts [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS) (= (vector-at M MM-ERR) 0)
  (let [g (vector-at M gn-cell) top (vector-at M MM-HEAP-TOP) size (+ gn-a-lp MM-LABEL-CAP 89)]
   (and (>= g MM-HEAP-BASE) (<= g (- MM-HEAP-END size))
    (>= top (+ g size)) (<= top MM-HEAP-END)))
  (>= (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (>= (vector-at M MM-SIR-N) 1) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (>= (vector-at M MM-NODE-N) 1) (<= (vector-at M MM-NODE-N) MM-NODE-CAP)
  (>= (vector-at M MM-LABEL-N) 1) (<= (vector-at M MM-LABEL-N) (- MM-LABEL-CAP 13))
  (>= (vector-at M MM-CODE-N) 1) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 2048))
  (>= (vector-at M MM-FIX-N) 1) (<= (vector-at M MM-FIX-N) (- MM-FIX-CAP 64))
  (>= (gn-g M gn-g-open) 0) (>= (gn-g M gn-g-open-n) 0)
  (<= (gn-g M gn-g-open) (vector-at M MM-FN-N))
  (<= (gn-g M gn-g-open-n) (- (vector-at M MM-FN-N) (gn-g M gn-g-open)))))
(defn- frfix-fn [M :vector-i64 f :i64 records :i64 np :i64 ns :i64 rt :i64 fuel :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP)) 0
  (let [p (gn-fnf M f FF-SIR) n (gn-fnf M f FF-NODE)]
   (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) records))
    (<= n 0) (>= n (vector-at M MM-NODE-N)) (>= n MM-NODE-CAP)) 0
    (if (and (= (gn-fnf M f FF-KIND) 2) (= (gn-fnf M f FF-NPARAMS) np)
     (= (gn-fnf M f FF-NSLOTS) ns) (= (gn-fnf M f FF-DEPTH) 3)
     (= (gn-fnf M f FF-RTYPE) rt) (= (gn-fnf M f FF-FUEL) fuel)
     (= (vector-at M (+ MM-NODE-BASE (* n MM-NODE-W) NF-KIND)) ND-LIST)
     (not (gn-clamp-open M f))
     (gn-dot-at? M p OP-FN f np ns)
     (gn-dot-at? M (+ p records -1) OP-END f 0 0)) p 0)))))
(defn- frfix-label-offset [k :i64] :i64
 (case k 0 2 1 46 2 47 3 66 4 68 5 70 6 109 7 161 8 163 9 164 10 166 11 168 12 169 -1))
(defn- frfix-label [M :vector-i64 p :i64 k :i64] :i64
 (gn-sir M (+ p (frfix-label-offset k)) IF-A))
(defn- frfix-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 13) true
  (let [l (frfix-label M p k)]
   (and (> l 0) (< l (vector-at M MM-LABEL-N)) (< l MM-LABEL-CAP)
    (= (gn-small-label M 1 l 0) (+ p (frfix-label-offset k)))
    (frfix-labels M p (inc k))))))
(defn- frfix-resolve [M :vector-i64 p :i64 f :i64 w :i64 c :i64 r :i64 v :i64] :i64
 (cond (= v 60000) f (= v 60001) w (= v 60002) c (= v 60003) r
  (and (>= v 61000) (< v 61013)) (frfix-label M p (- v 61000)) :else v))
(defn- frfix-root-shape [M :vector-i64 p :i64 f :i64 w :i64 c :i64 r :i64 k :i64] :bool
 (or (= k 688)
  (and (= (gn-sir M (+ p (quot k 4)) (bit-and k 3))
    (frfix-resolve M p f w c r (frfix-root-word k)))
   (frfix-root-shape M p f w c r (inc k)))))
(defn- frfix-helper-label [M :vector-i64 p :i64 kind :i64 k :i64] :i64
 (gn-sir M (+ p (if (= kind 0) 2 (if (= kind 1) 1 (if (= k 0) 2 15)))) IF-A))
(defn- frfix-helper-shape [M :vector-i64 p :i64 f :i64 coord :i64 kind :i64 k :i64] :bool
 (let [n (case kind 0 36 1 52 2 72 0)]
  (if (= k n) true
   (let [v (case kind 0 (frfix-writer-word k) 1 (frfix-coord-word k) (frfix-pred-word k))
    expected (cond (= v 60000) f (= v 60002) coord
     (= v 62000) (frfix-helper-label M p kind 0)
     (= v 62001) (frfix-helper-label M p kind 1)
     (= v 63000) (gn-sir M (+ p 2) IF-B)
     (= v 63001) (gn-sir M (+ p 6) IF-B) :else v)]
    (and (= (gn-sir M (+ p (quot k 4)) (bit-and k 3)) expected)
     (frfix-helper-shape M p f coord kind (inc k)))))))
(defn- frfix-helper-labels [M :vector-i64 p :i64 kind :i64] :bool
 (let [a (frfix-helper-label M p kind 0)]
  (and (> a 0) (< a (vector-at M MM-LABEL-N)) (< a MM-LABEL-CAP)
   (= (gn-small-label M 1 a 0) (+ p (if (= kind 0) 2 (if (= kind 1) 1 2))))
   (if (not= kind 2) true
    (let [b (frfix-helper-label M p kind 1)]
     (and (> b 0) (< b (vector-at M MM-LABEL-N)) (< b MM-LABEL-CAP)
      (not= a b) (= (gn-small-label M 1 b 0) (+ p 15))))))))
(defn- frfix-helper [M :vector-i64 f :i64 coord :i64 kind :i64] :i64
 (let [p (case kind 0 (frfix-fn M f 9 3 3 TY-VEC 1)
   1 (frfix-fn M f 13 2 2 TY-I64 0) 2 (frfix-fn M f 18 2 2 TY-BOOL 1) 0)]
  (if (= p 0) 0
   (if (and (frfix-helper-labels M p kind) (frfix-helper-shape M p f coord kind 0)
    (= (gn-fnf M f FF-PT0) (if (= kind 1) TY-I64 TY-VEC))
    (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (if (= kind 0) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) true)
    (if (= kind 1)
     (let [base (gn-sir M (+ p 2) IF-B) stride (gn-sir M (+ p 6) IF-B)]
      (and (> stride 1) (<= stride 4095) (>= base stride) (<= base 4095))) true)) p 0))))
(defn- frfix-admit [M :vector-i64 i :i64] :i64
 (if (not (frfix-counts M)) 0
  (let [p (dec i)]
   (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 172)) (not= (gn-op M p) OP-FN)
    (not= (gn-g M gn-f-ns) 11) (not= (gn-g M gn-f-dp) 3)
    (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
    (not= (gn-g M gn-f-nsv) 10) (not= (gn-g M gn-f-fb) 208)
    (not= (gn-g M gn-f-out) 0) (not= (gn-g M gn-f-h) 0)
    (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-dead) 0)
    (not= (gn-g M gn-f-vslot) 0) (not= (gn-g M gn-f-ctx) 1)
    (not (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1)))) 0
    (let [f (gn-sir M p IF-A) c (gn-sir M (+ p 10) IF-A)
     r (gn-sir M (+ p 33) IF-A) w (gn-sir M (+ p 54) IF-A)]
     (if (= (frfix-fn M f 172 4 11 TY-VEC 1) 0) 0
      (if (and (not= f w) (not= f c) (not= f r) (not= w c) (not= w r) (not= c r)
       (= (gn-fnf M f FF-PT0) TY-VEC)
       (loop [k 1] (or (= k 4) (and (= (gn-fnf M f (+ FF-PT0 k)) TY-I64) (recur (inc k)))))
       (> (frfix-helper M c c 1) 0) (> (frfix-helper M w c 0) 0) (> (frfix-helper M r c 2) 0)
       (frfix-labels M p 0) (frfix-root-shape M p f w c r 0)
       (loop [k 1] (or (= k 12) (and
        (or (= (gn-sreg M k) -1) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)))
        (recur (inc k)))))
       (loop [k 1] (or (= k 5) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
        (loop [j 1] (or (= j k) (and (not= (gn-sreg M j) (gn-sreg M k)) (recur (inc j)))))
        (recur (inc k)))))) p 0)))))))

;; Issued-context guard. Numeric nonwrap/disjoint checks complement the host
;; issuance contract; they do not prove arbitrary forged pointers are mapped.
(defn- frfix-fail [M :vector-i64 F :vector-i64 cond :i64] :vector-i64
 (let [n (vector-at F 0) f1 (vector-assoc! F (inc n) (vector-at M MM-CODE-N))
  f2 (vector-assoc! f1 0 (inc n))] (gn-emit M (enc-bcond cond 0))))
(defn- frfix-disjoint [M :vector-i64 F :vector-i64 lo :i64 hi :i64] :vector-i64
 (-> M (gn-emit (enc-cmp-r 4 hi)) (gn-emit (enc-bcond 2 3))
  (gn-emit (enc-cmp-r 9 lo)) (frfix-fail F 8)))
;; The sole three callers belong to the unchanged exact frfix certificate.
;; Guard sets x17=stride before UDIV/probes. Body temps9..11, locals19..28,
;; args0..2, predicate15 and scratch16 never write17 before the fast exit.
;; Thus dropping index MOV17 retains the SAME x17 value, including cold edges.
;; Pure modular64 coordinate arithmetic; no flags/fuel/guards/accesses change.
(defn- frfix-index [M :vector-i64 d :i64 id :i64 field :i64 base :i64 stride :i64] :vector-i64
 (let [shift (gn-pow2 stride)]
  (if (and (= d 16) (>= id 0) (< id 31) (not= id 17)
       (>= field 0) (< field 31) (not= field d) (not= field 17)
       (> stride 1) (<= stride 4095) (> shift 0) (<= shift 11)
       (>= base stride) (<= base 4095))
   (-> M (gn-emit (gn-e-addsl d field id shift))
     (gn-emit (enc-add-i d d (- base stride))))
   ;; Keep original lowering for every alias/range/non-power-of2 exclusion.
   (-> M (gn-emit (enc-sub-i d id 1)) (gn-mov-imm 17 stride)
    (gn-emit (enc-mul d d 17)) (gn-emit (enc-add-i d d base))
    (gn-emit (enc-add-r d d field))))))
(defn- frfix-probe [M :vector-i64 F :vector-i64 d :i64 id :i64 field :i64 base :i64 stride :i64] :vector-i64
 (-> M (frfix-index 16 id field base stride)
  (gn-emit (gn-e-ldrr d 4 16 1)) (gn-emit (enc-cmp-r d 2)) (frfix-fail F 8)))
(defn- frfix-guard [M :vector-i64 F :vector-i64 p :i64 base :i64 stride :i64] :vector-i64
 (let [rv (gn-sreg M 1) ref (gn-sreg M 2) lf (gn-sreg M 3) rf (gn-sreg M 4)]
  (-> M
   ;; Entry charge already paid. Budget is comparison-only before new reads.
   (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 11)) (frfix-fail F 3)
   (gn-emit (enc-add-i 0 7 400)) (gn-emit (enc-cmp-r 0 7)) (frfix-fail F 3)
   (gn-emit (enc-ldr 1 7 312)) (gn-emit (enc-add-i 14 1 8))
   (gn-emit (enc-cmp-r 14 1)) (frfix-fail F 3)
   (gn-emit (enc-ldr 2 1 0)) (gn-emit (enc-cmp-i 2 1)) (frfix-fail F 3)
   (gn-mov-imm 17 1048576) (gn-emit (enc-cmp-r 2 17)) (frfix-fail F 8)
   (gn-emit (enc-sub-i 16 rv 1)) (gn-emit (enc-cmp-r 16 2)) (frfix-fail F 2)
   (gn-emit (enc-ldr 5 7 320)) (gn-emit (gn-e-addsl 6 5 2 4))
   (gn-emit (enc-cmp-r 6 5)) (frfix-fail F 3)
   ;; Whole issued descriptor interval admitted before selected descriptor LDP.
   (gn-emit (gn-e-addsl 17 5 16 4)) (gn-emit (enc-ldp 10 3 17 0))
   (gn-mov-imm 17 1152921504606846976)
   (gn-emit (enc-cmp-r 10 17)) (frfix-fail F 2)
   (gn-emit (enc-cmp-r 3 17)) (frfix-fail F 2)
   (gn-emit (enc-cmp-i 3 base)) (frfix-fail F 3)
   (gn-emit (enc-ldr 11 7 328)) (gn-emit (gn-e-addsl 4 11 10 3))
   (gn-emit (enc-cmp-r 4 11)) (frfix-fail F 3)
   (gn-emit (gn-e-addsl 9 4 3 3)) (gn-emit (enc-cmp-r 9 4)) (frfix-fail F 3)
   ;; Full backing vs context, count, all used descriptors, and omitted frames.
   (frfix-disjoint F 7 0) (frfix-disjoint F 1 14) (frfix-disjoint F 5 6)
   (gn-emit (enc-cmp-i 31 96)) (frfix-fail F 3)
   (gn-emit (enc-sub-i 16 31 96)) (gn-emit (enc-add-i 17 31 224))
   (gn-emit (enc-add-i 15 31 0)) (gn-emit (enc-cmp-r 17 15)) (frfix-fail F 3)
   (frfix-disjoint F 16 17)
   ;; All field intervals are unsigned; negative full64 fields fail cold.
   (gn-emit (enc-cmp-i lf stride)) (frfix-fail F 2)
   (gn-emit (enc-cmp-i rf stride)) (frfix-fail F 2)
   (gn-emit (enc-cmp-r ref 3)) (frfix-fail F 2)
   (gn-emit (enc-sub-i 2 3 base)) (gn-mov-imm 17 stride)
   (gn-emit (enc-rrr 2596276224 2 2 17))
   ;; Original five read locations, in source order. Read snapshots are pure;
   ;; rejected probes leave original high locals/context/fuel untouched.
   (gn-emit (gn-e-ldrr 9 4 ref 1)) (gn-emit (enc-cmp-r 9 2)) (frfix-fail F 8)
   (frfix-probe F 10 9 lf base stride)
   (frfix-probe F 11 9 rf base stride)
   (frfix-probe F 12 10 lf base stride)
   (frfix-probe F 13 10 rf base stride))))
(defn- frfix-map [M :vector-i64 p :i64 old :i64 first :i64 k :i64] :i64
 (cond (= k 13) 0 (= old (frfix-label M p k)) (+ first k)
  :else (frfix-map M p old first (inc k))))
(defn- frfix-mark [M :vector-i64 label :i64] :vector-i64
 (let [h (gn-g M gn-f-h) a (if (= (gn-g M gn-f-dead) 1) M (gn-flush M 0 h))]
  (-> a (gn-allreg 0 3) (gn-put (+ MM-LABEL-BASE label) (vector-at a MM-CODE-N))
   (gn-gs gn-f-dead 0) (gn-gs gn-f-ctx 1))))
(defn- frfix-branch [M :vector-i64 label :i64 t :i64 kind :i64] :vector-i64
 (let [a (gn-flush M 0 (gn-g M gn-f-h))]
  (if (= kind 0)
   (-> a (gn-fix FX-B26 label) (gn-emit (enc-b 0)) (gn-gs gn-f-dead 1))
   (-> a (gn-fix FX-CB19 label)
    (gn-emit (if (= kind 1) (enc-cbz (+ 9 t) 0) (enc-cbnz (+ 9 t) 0)))))))
(defn- frfix-result [M :vector-i64 t :i64] :vector-i64
 (-> M (gn-mov (+ 9 t) 0) (gn-def t gn-k-reg 0)))
(defn- frfix-coordinate-call [M :vector-i64 t :i64 base :i64 stride :i64] :vector-i64
 (-> M (gn-args t 0 2) (frfix-index 16 0 1 base stride)
  (gn-mov 0 16) (frfix-result t)))
(defn- frfix-predicate-call [M :vector-i64 t :i64 base :i64 stride :i64] :vector-i64
 (let [a (-> M (gn-args t 0 2) (gn-op-fuel) (gn-mov-imm 0 0))
  jump (vector-at a MM-CODE-N)
  b (-> a (gn-emit (enc-cbz 1 0)) (gn-mov-imm 15 1)
   (frfix-index 16 1 15 base stride) (gn-emit (gn-e-ldrr 0 4 16 1))
   (gn-emit (enc-cmp-i 0 1)) (gn-emit (enc-cset 0 0)))
  end (vector-at b MM-CODE-N)]
  (-> b (gn-put (+ MM-CODE-BASE jump) (enc-cbz 1 (- end jump))) (frfix-result t))))
(defn- frfix-read [M :vector-i64 t :i64] :vector-i64
 (-> M (gn-args t 0 2) (gn-emit (gn-e-ldrr 0 4 1 1)) (frfix-result t)))
(defn- frfix-write [M :vector-i64 t :i64] :vector-i64
 (-> M (gn-args t 0 3) (gn-op-fuel) (gn-emit (gn-e-strr3 2 4 1)) (frfix-result t)))
(defn- frfix-body [M :vector-i64 p :i64 j :i64 first :i64 coord :i64 writer :i64 pred :i64 base :i64 stride :i64] :vector-i64
 (if (= j (+ p 171)) M
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
   n (cond
    (= op OP-LABEL) (frfix-mark M (frfix-map M p a first 0))
    (= (gn-g M gn-f-dead) 1) M
    (= op OP-CONST) (gn-def M a gn-k-const b)
    (= op OP-LGET) (gn-def M a gn-k-local b)
    (= op OP-LSET) (gn-op-lset M a b)
    (= op OP-BR) (frfix-branch M (frfix-map M p a first 0) 0 0)
    (= op OP-BRZ) (frfix-branch M (frfix-map M p b first 0) a 1)
    (= op OP-BRNZ) (frfix-branch M (frfix-map M p b first 0) a 2)
    (= op OP-RT) (frfix-read M b)
    (= op OP-CALL) (cond (= a coord) (frfix-coordinate-call M b base stride)
     (= a writer) (frfix-write M b) :else (frfix-predicate-call M b base stride))
    (= op OP-RET) (gn-op-ret M a)
    :else M)]
   (frfix-body n p (inc j) first coord writer pred base stride))))
(defn- frfix-patch-cold [M :vector-i64 F :vector-i64 cold :i64 k :i64] :vector-i64
 (if (> k (vector-at F 0)) M
  (let [at (vector-at F k) word (vector-at M (+ MM-CODE-BASE at))]
   (frfix-patch-cold (gn-put M (+ MM-CODE-BASE at) (enc-bcond (bit-and word 15) (- cold at))) F cold (inc k)))))
(defn- frfix-extra-save [M :vector-i64] :vector-i64
 (loop [V (vector-alloc 87) k 0] (if (= k 87) V
  (recur (vector-assoc! V k (gn-g M (+ gn-g-open 2 k))) (inc k)))))
(defn- frfix-extra-restore [M :vector-i64 V :vector-i64] :vector-i64
 (loop [m M k 0] (if (= k 87) m (recur (gn-gs m (+ gn-g-open 2 k) (vector-at V k)) (inc k)))))
(defn- frfix-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (frfix-admit M i)]
  (if (= p 0) M
   (let [coord (gn-sir M (+ p 10) IF-A) writer (gn-sir M (+ p 54) IF-A)
    pred (gn-sir M (+ p 33) IF-A) cp (gn-fnf M coord FF-SIR)
    base (gn-sir M (+ cp 2) IF-B) stride (gn-sir M (+ cp 6) IF-B)
    B (gp-save-state M) X (frfix-extra-save M) F (vector-alloc 64)
    first (vector-at M MM-LABEL-N)
    a (frfix-guard (gn-put M MM-LABEL-N (+ first 13)) F p base stride)
    b (frfix-body a p (+ p 2) first coord writer pred base stride)
    cold (vector-at b MM-CODE-N)
    c (frfix-patch-cold b F cold 1)]
    (-> c (gp-restore B) (frfix-extra-restore X))))))

;; ADR0357 one-off novel semantic analysis, not a mechanical source rewrite.
;; Compiler-only slot after the existing89 global cells. Immutable through FN snapshots.
(def alen-state (+ gn-g-open 89))
(defn- alen-at [A :vector-i64 f :i64 k :i64] :i64 (+ 4 (* f 6) k))
(defn- alen-site [A :vector-i64 i :i64] :i64 (+ 4 (* (vector-at A 0) 6) (* i 3)))
(defn- alen-owner [M :vector-i64 f :i64] :i64
 (let [nf (vector-at M MM-FN-N) sn (vector-at M MM-SIR-N)]
  (if (or (<= nf 0) (> nf 1024) (> nf MM-FN-CAP) (<= sn 0) (> sn 20000) (> sn MM-SIR-CAP) (<= f 0) (>= f nf)) 0
   (let [p (gn-fnf M f FF-SIR) np (gn-fnf M f FF-NPARAMS) ns (gn-fnf M f FF-NSLOTS) dp (gn-fnf M f FF-DEPTH)]
    (if (and (> p 0) (< p sn) (>= np 0) (<= np 5) (>= ns np) (<= ns 32) (> dp 0) (<= dp 32)
       (not (gn-clamp-open M f)) (gn-dot-at? M p OP-FN f np ns)) p 0)))))
(defn- alen-end [M :vector-i64 f :i64 p :i64 left :i64] :i64
 (if (or (<= left 0) (<= p 0) (>= p (vector-at M MM-SIR-N))) 0
  (cond (= (gn-op M p) OP-END) (if (gn-dot-at? M p OP-END f 0 0) p 0)
        (= (gn-op M p) OP-FN) 0 :else (alen-end M f (inc p) (dec left)))))
(defn- alen-type [M :vector-i64 f :i64 k :i64] :i64 (gn-fnf M f (+ FF-PT0 k)))
(defn- alen-label [M :vector-i64 j :i64] :bool
 (let [l (gn-sir M j IF-A) ln (vector-at M MM-LABEL-N)]
  (and (> ln 0) (<= ln MM-LABEL-CAP) (> l 0) (< l ln) (gn-dot-at? M j OP-LABEL l 0 0))))
;; This analysis precedes gn-pre: resolve exact owned source labels, not the
;; function-emission label cache. Duplicate labels or missing owner refuse.
(defn- alen-source-owner [M :vector-i64 j :i64 left :i64] :i64
 (if (or (<= j 0) (<= left 0)) 0
  (cond (= (gn-op M j) OP-FN) j (= (gn-op M j) OP-END) 0
   :else (alen-source-owner M (dec j) (dec left)))))
(defn- alen-source-label [M :vector-i64 p :i64 end :i64 l :i64] :i64
 (loop [j (inc p) found 0] (if (= j end) found
  (if (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) l))
   (if (> found 0) 0 (recur (inc j) j)) (recur (inc j) found)))))
(defn- alen-to [M :vector-i64 j :i64 end :i64] :i64
 (let [op (gn-op M j) l (gn-sir M j (if (= op OP-BR) IF-A IF-B)) ln (vector-at M MM-LABEL-N)
       p (alen-source-owner M j 512)]
  (if (and (> p 0) (> l 0) (< l ln)) (alen-source-label M p end l) 0)))
(defn- alen-operands [M :vector-i64 j :i64 end :i64 ns :i64 dp :i64] :bool
 (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
  (case op
   OP-CONST (and (>= a 0) (< a dp) (= c 0))
   OP-LGET (and (>= a 0) (< a dp) (> b 0) (<= b ns) (= c 0))
   OP-LSET (and (> a 0) (<= a ns) (>= b 0) (< b dp) (= c 0))
   (OP-BIN OP-CMP) (and (>= b 0) (< (inc b) dp) (= c 0))
   OP-UN (and (>= b 0) (< b dp) (= c 0))
   OP-LABEL (alen-label M j)
   OP-BR (and (= b 0) (= c 0) (> (alen-to M j end) 0))
   (OP-BRZ OP-BRNZ) (and (>= a 0) (< a dp) (= c 0) (> (alen-to M j end) 0))
   OP-CALL (and (> (alen-owner M a) 0) (>= b 0) (< b dp) (>= c 0) (= c (gn-fnf M a FF-NPARAMS)) (<= (+ b c) dp))
   OP-RT (and (>= b 0) (<= (+ b c) dp)
    (or (and (= a RT-VECTOR-ALLOC) (= c 1)) (and (= a RT-VECTOR-AT) (= c 2))
        (and (= a RT-VECTOR-COUNT) (= c 1)) (and (= a RT-VECTOR-ASSOC-IN-PLACE) (= c 3))))
   OP-FUEL (and (= a 0) (= b 0) (= c 0))
   OP-RET (and (>= a 0) (< a dp) (= b 0) (= c 0))
   false)))
(defn- alen-closed [M :vector-i64 f :i64] :bool
 (let [p (alen-owner M f)] (if (= p 0) false
  (let [end (alen-end M f (inc p) 512) ns (gn-fnf M f FF-NSLOTS) dp (gn-fnf M f FF-DEPTH)]
   (and (> end p) (loop [j (inc p)] (if (= j end) true
    (and (and (alen-operands M j end ns dp) (if (or (= (gn-op M j) OP-BR) (= (gn-op M j) OP-BRZ) (= (gn-op M j) OP-BRNZ)) (> (alen-to M j end) p) true)) (recur (inc j))))))))))
;; A complete whole-source gate rejects indirect/foreign/unknown effects. No
;; descriptor mutation/observer callback or replaceable link can cross a fact.
(defn- alen-whole [M :vector-i64] :bool
 (let [nf (vector-at M MM-FN-N) sn (vector-at M MM-SIR-N) ln (vector-at M MM-LABEL-N)]
  (and (> nf 1) (<= nf 1024) (<= nf MM-FN-CAP) (> sn 0) (<= sn 20000) (<= sn MM-SIR-CAP)
    (> ln 0) (<= ln MM-LABEL-CAP) (= (gn-g M gn-g-open-n) 0)
    (loop [f 1 expected 1]
     (if (= f nf) (= expected sn)
      (and (= (alen-owner M f) expected) (alen-closed M f)
       (recur (inc f) (inc (alen-end M f (inc expected) 512)))))))))
;; Reusable work rows: [seen, kind/value pairs for local0..ns and temp0..dp-1].
;; kind0 unknown;1 vector origin/minimum;2 exact scalar constant. Alias pass
;; uses vector -1 only for the returned first parameter, never min(-1,unknown).
(defn- alen-cell [row :i64 width :i64 slot :i64] :i64 (+ (* row (+ 1 (* 2 width))) 1 (* 2 slot)))
(defn- alen-getk [D :vector-i64 row :i64 width :i64 slot :i64] :i64 (vector-at D (alen-cell row width slot)))
(defn- alen-getv [D :vector-i64 row :i64 width :i64 slot :i64] :i64 (vector-at D (inc (alen-cell row width slot))))
(defn- alen-put [D :vector-i64 row :i64 width :i64 slot :i64 kind :i64 value :i64] :vector-i64
 (-> D (vector-assoc! (alen-cell row width slot) kind) (vector-assoc! (inc (alen-cell row width slot)) value)))
(defn- alen-merge [D :vector-i64 from :i64 to :i64 width :i64 alias :bool] :vector-i64
 (let [seen (vector-at D (* to (+ 1 (* 2 width))))]
  (loop [V D k 0] (if (= k width) (vector-assoc! V (* to (+ 1 (* 2 width))) 1)
   (let [ak (alen-getk V from width k) av (alen-getv V from width k)
         bk (alen-getk V to width k) bv (alen-getv V to width k)
         kind (if (= seen 0) ak (if (= ak bk) ak 0))
         value (if (= seen 0) av (if (= kind 1) (if alias (if (= av bv) av 0) (if (< av bv) av bv)) (if (= av bv) av 0)))
         goodkind (if (and (= kind 2) (not= av bv) (not= seen 0)) 0 kind)]
    (recur (alen-put (if (or (= seen 0) (not= goodkind bk) (not= value bv)) (vector-assoc! V (dec (vector-count V)) 1) V) to width k goodkind value) (inc k)))))))
(defn- alen-kill [D :vector-i64 row :i64 width :i64 start :i64 n :i64] :vector-i64
 (if (= n 0) D (alen-kill (alen-put D row width start 0 0) row width (inc start) (dec n))))
(defn- alen-call-meet [M :vector-i64 A :vector-i64 D :vector-i64 row :i64 width :i64 base :i64 f :i64 n :i64] :vector-i64
 (loop [V A k 0] (if (= k n) V
  (if (not= (alen-type M f k) TY-VEC) (recur V (inc k))
   (let [v (if (= (alen-getk D row width (+ base k)) 1) (alen-getv D row width (+ base k)) 0)
         at (alen-at V f (inc k)) old (vector-at V at)]
    (recur (vector-assoc! V at (if (< v old) v old)) (inc k)))))))
(defn- alen-start [M :vector-i64 A :vector-i64 D :vector-i64 f :i64 width :i64 alias :bool] :vector-i64
 (let [clean (loop [V D k 0] (if (= k (vector-count V)) V (recur (vector-assoc! V k 0) (inc k))))
       ready (vector-assoc! clean 0 1) np (gn-fnf M f FF-NPARAMS)]
  (loop [V ready k 0] (if (= k np) V
   (recur (if (= (alen-type M f k) TY-VEC)
     (alen-put V 0 width (inc k) 1 (if alias (if (= k 0) -1 0) (vector-at A (alen-at A f (inc k))))) V) (inc k))))))
;; Transfer preserves source operands before killing consumed temp cells. Every
;; matrix lookup is dominated by alen-whole's operand/extent bounds.
(defn- alen-flow [M :vector-i64 A :vector-i64 D :vector-i64 f :i64 alias :bool record :bool] :vector-i64
 (let [p (alen-owner M f) end (alen-end M f (inc p) 512) ns (gn-fnf M f FF-NSLOTS)
       width (+ ns 1 (gn-fnf M f FF-DEPTH)) first (inc p) initial (alen-start M A D f width alias)]
  (loop [V A Q initial j first pass 0] (if (= j end)
    (if (= (vector-at Q (dec (vector-count Q))) 0) V
     (if (>= pass 512) (vector-assoc! V 2 0)
      (recur V (vector-assoc! Q (dec (vector-count Q)) 0) first (inc pass))))
   (let [row (- j first) seen (vector-at Q (* row (+ 1 (* 2 width))))]
    (if (= seen 0) (recur V Q (inc j) pass)
     (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
           tb (+ ns 1 b) ta (+ ns 1 a)
           kind (cond (= op OP-CONST) 2 (= op OP-LGET) (alen-getk Q row width b)
              (= op OP-LSET) (alen-getk Q row width tb)
              (and (= op OP-RT) (= a RT-VECTOR-ALLOC)) 1
              (and (= op OP-RT) (= a RT-VECTOR-ASSOC-IN-PLACE)) (alen-getk Q row width tb)
              (and (= op OP-CALL) (= (gn-fnf M a FF-RTYPE) TY-VEC)) 1 :else 0)
           value (cond (= op OP-CONST) b (= op OP-LGET) (alen-getv Q row width b)
              (= op OP-LSET) (alen-getv Q row width tb)
              (and (= op OP-RT) (= a RT-VECTOR-ALLOC))
               (let [v (alen-getv Q row width tb)] (if (and (= (alen-getk Q row width tb) 2) (> v 0) (< v 134217728)) v 0))
              (and (= op OP-RT) (= a RT-VECTOR-ASSOC-IN-PLACE)) (alen-getv Q row width tb)
              (and (= op OP-CALL) (= (vector-at V (alen-at V a 0)) 1) (= (alen-getk Q row width tb) 1)) (alen-getv Q row width tb)
              :else 0)
           updated (cond
             (and (= op OP-RET) alias (= (gn-fnf M f FF-RTYPE) TY-VEC)
                (or (not= (alen-getk Q row width ta) 1) (not= (alen-getv Q row width ta) -1))) (vector-assoc! V (alen-at V f 0) 0)
             (and (= op OP-CALL) (not alias)) (alen-call-meet M V Q row width tb a c)
             (and (= op OP-RT) record (or (= a RT-VECTOR-AT) (= a RT-VECTOR-ASSOC-IN-PLACE)))
              (let [at (alen-site V j)] (-> V
                (vector-assoc! at (if (= (alen-getk Q row width tb) 1) (alen-getv Q row width tb) 0))
                (vector-assoc! (inc at) (alen-getk Q row width (inc tb)))
                (vector-assoc! (+ at 2) (alen-getv Q row width (inc tb))))) :else V)
           work (loop [B Q k 0] (if (= k width) B
             (recur (alen-put B 512 width k (alen-getk Q row width k) (alen-getv Q row width k)) (inc k))))
           next (cond (= op OP-CONST) (alen-put work 512 width ta kind value)
              (= op OP-LGET) (alen-put work 512 width ta kind value)
              (= op OP-LSET) (alen-put work 512 width a kind value)
              (or (= op OP-BIN) (= op OP-CMP)) (alen-kill work 512 width tb 2)
              (= op OP-UN) (alen-put work 512 width tb 0 0)
              (or (= op OP-RT) (= op OP-CALL)) (alen-put (alen-kill work 512 width tb c) 512 width tb kind value)
              :else work)
           out (cond (or (= op OP-RET) (= op OP-BR)) next
              :else (alen-merge next 512 (inc row) width alias))
           joined (if (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ))
              (alen-merge out 512 (- (alen-to M j end) first) width alias) out)]
      (recur updated joined (inc j) pass))))))))
(defn- alen-seed [M :vector-i64 A :vector-i64] :vector-i64
 (loop [V A f 1] (if (= f (vector-at V 0)) V
  (let [np (gn-fnf M f FF-NPARAMS) candidate (and (> np 0) (= (alen-type M f 0) TY-VEC) (= (gn-fnf M f FF-RTYPE) TY-VEC))
        V1 (vector-assoc! V (alen-at V f 0) (if candidate 1 0))]
   (recur (loop [B V1 k 0] (if (= k np) B
    (recur (vector-assoc! B (alen-at B f (inc k))
      (if (and (= (alen-type M f k) TY-VEC) (= (gn-fnf M f FF-EXPORT) 0)) 1152921504606846976 0)) (inc k)))) (inc f))))))
(defn- alen-copy-entries [A :vector-i64 C :vector-i64] :vector-i64
 (loop [V C k 0] (if (= k (+ 4 (* (vector-at A 0) 6))) V (recur (vector-assoc! V k (vector-at A k)) (inc k)))))
(defn- alen-equal-entries [A :vector-i64 C :vector-i64] :bool
 (loop [k 4] (if (= k (+ 4 (* (vector-at A 0) 6))) true (and (= (vector-at A k) (vector-at C k)) (recur (inc k))))))
(defn- alen-solve [M :vector-i64 A :vector-i64 D :vector-i64 C :vector-i64 alias :bool left :i64] :vector-i64
 (if (= left 0) (vector-assoc! A 2 0)
  (let [copy (alen-copy-entries A C)
        next (if alias (loop [V A f 1] (if (= f (vector-at A 0)) V (recur (alen-flow M V D f true false) (inc f))))
         (loop [V A f (dec (vector-at A 0))] (if (= f 0) V (recur (alen-flow M V D f false false) (dec f)))))]
   (if (alen-equal-entries next copy) next (alen-solve M next D copy alias (dec left))))))
(defn- alen-prepare [M :vector-i64] :vector-i64
 (if (not (alen-whole M)) M
  (let [nf (vector-at M MM-FN-N) sn (vector-at M MM-SIR-N)
        A (alen-seed M (-> (vector-alloc (+ 4 (* nf 6) (* sn 3))) (vector-assoc! 0 nf) (vector-assoc! 1 sn) (vector-assoc! 2 1)))
        D (vector-alloc (inc (* 513 131))) C (vector-alloc (+ 4 (* nf 6)))
        alias (alen-solve M A D C true (inc nf))
        lengths (if (= (vector-at alias 2) 1) (alen-solve M alias D C false (inc nf)) alias)
        final (if (= (vector-at lengths 2) 1) (loop [V lengths f 1] (if (= f nf) V (recur (alen-flow M V D f false true) (inc f)))) lengths)]
   (if (= (vector-at final 2) 1) (alen-publish M final) M))))

;; Materialize only immutable per-SIR facts in compiler heap; no vector/I64 cast.
(defn- alen-publish [M :vector-i64 A :vector-i64] :vector-i64
 (let [sn (vector-at A 1) B (mem-alloc M (* sn 3)) ptr (vector-at B MM-R0)]
  (if (not= (vector-at B MM-ERR) 0) B
   (gn-gs (loop [V B i 0] (if (= i sn) V
    (let [at (alen-site A i)]
     (recur (-> V (gn-put (+ ptr (* i 3)) (vector-at A at))
       (gn-put (+ ptr (* i 3) 1) (vector-at A (inc at)))
       (gn-put (+ ptr (* i 3) 2) (vector-at A (+ at 2)))) (inc i))))) alen-state ptr))))
(defn- alen-enabled [M :vector-i64 i :i64] :bool
 (let [ptr (gn-g M alen-state) sn (vector-at M MM-SIR-N)]
  (and (> ptr 0) (> i 0) (< i sn) (<= sn 20000) (<= (gn-g M gn-f-vmode) 0)
    (> (vector-at M (+ ptr (* i 3))) 0)
    (< (vector-at M (+ ptr (* i 3))) 1152921504606846976))))
(defn- alen-address [M :vector-i64 i :i64 rv :i64 ri :i64] :vector-i64
 (let [ptr (+ (gn-g M alen-state) (* i 3))
       len (vector-at M ptr) kind (vector-at M (inc ptr)) k (vector-at M (+ ptr 2))
       safe (and (= kind 2) (>= k 0) (< k len))
       V (-> M (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-ldr 16 7 320))
         (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0)))]
  (-> (if safe V (-> V (gn-emit (enc-cmp-r ri 16))
       (gn-emit (enc-bcond (enc-cond-lo) 2)) (gn-emit (gn-e-udf))))
    (gn-emit (enc-ldr 16 7 328)) (gn-emit (enc-add-r 17 17 ri)))))
(defn- alen-read [M :vector-i64 i :i64 rv :i64 ri :i64 d :i64 slot :i64 k :i64] :vector-i64
 (if (alen-enabled M i) (gn-emit (alen-address M i rv ri) (gn-e-ldrr d 16 17 1))
  (gn-chain-read M rv ri d slot k)))
(defn- alen-write [M :vector-i64 i :i64 rv :i64 ri :i64 rx :i64 slot :i64 k :i64] :vector-i64
 (if (alen-enabled M i) (gn-emit (alen-address M i rv ri) (gn-e-strr3 rx 16 17))
  (gn-chain-store M rv ri rx slot k)))

;; ADR0357 one-off source-owned three-transfer shared-envelope algorithm.
;; Original full64 pairs, original helper frames and all publications retained.
(defn- wrc-pattern [key :i64] :vector-i64 (case key
 0 [2533296265166849 18 4229300233 12884901892 8590000132 131078 327685 17179869188 12884967428 131078 393221 4294967300 281449206972419 562954248126477 458757 21474836484 25769869316 262151 276999620788235 30064771076 281453501939715 8590065668 21475033092 262147 1407379178389517 524293 34359738372 8590000132 12885032964 25770000388 262147 1407379178389517]
 1 [589829 38654705668 8590000132 25769934852 4295032838 281453502005251 21475033092 262147 1407379178389517 4225105930 4226678793 30064771076 281453501939715 12885032964 25770000388 262147 1407379178389517 524293 34359738372 8590000132 25769934852 4295032838 8590065668 21475033092 4295229443 12885032966 1125904201613325 589829 38654705668 8590000132 281453502005251 25770000388]
 2 [262147 1407379178389517 4225105929 19 4294901762]
 4 [1407400653225985 18 4229300233 21474836484 17179934724 65543 277141354709003 4294967300 4227399690 4228841481 4294967300 8590000132 21474967556 4295032838 12885032964 21475033092 8590000134 844429224574989 8590000132 12885032964 17180065796 21475098628 4295294979 17179934726 65541 4295098373 8590131205 12885164037 17180196869 18 4229300234 4227399689]
 5 [19 4294836226]
 8 [1125921381482497 18 4229300233 17179869188 65539 131079 277141354709003 4294967300 4227530762 4228841481 4294967300 8590000132 17180000260 4295032838 12885032964 17180065796 8590000134 844429224574989 8590000132 12885032964 17180065796 4295229443 12885032966 65541 4295098373 8590131205 12885164037 18 4229300234 4227530761 19 4294770690]
 12 [562962838061057 18 4229300233 4294967300 8590000132 4295098372 8590131204 562958554890254 4295163907 8590000134 844429224509453 19 4294705154]
 16 [1407392062898177 18 4229300233 4294967300 12884967428 562954247929869 262149 4294967300 12884967428 8590065667 4295163910 4295098371 4295032838 562949964955662 327685 4294967300 8590000132 8590065667 4295163910 17180000260 844429224509453 8590000132 8590065667 4295163910 4295098371 4295032838 21474967556 844429224509453 19 4294443010]
 20 [562962837864449 18 4229300233 4294967300 8590000132 8590065667 4295163910 562949964955662 19 4294508546]
 24 [844442109411329 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294377474]
 []))
(defn- wrc-count [kind :i64] :i64 (case kind 0 69 1 34 2 32 3 13 4 30 5 10 6 9 0))
(defn- wrc-meta [M :vector-i64 f :i64 kind :i64] :bool
 (and (mdc-counts M) (>= kind 0) (<= kind 6) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (let [p (gn-fnf M f FF-SIR) n (wrc-count kind) np (case kind 0 4 1 5 2 4 3 2 4 3 5 2 3)]
   (and (> p 0) (<= n (- (vector-at M MM-SIR-N) p))
    (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f)
    (= (gn-op M (+ p (dec n))) OP-END) (= (gn-sir M (+ p (dec n)) IF-A) f)
    (not (gn-clamp-open M f)) (= (gn-fnf M f FF-NPARAMS) np)
    (= (gn-fnf M f FF-NSLOTS) (case kind 0 9 1 5 2 4 3 2 4 5 5 2 3))
    (= (gn-fnf M f FF-DEPTH) (case kind 0 5 1 6 2 5 3 4 4 3 5 3 3))
    (= (gn-fnf M f FF-RTYPE) (if (= kind 5) TY-I64 TY-VEC))
    (= (ck-pt M f 0) TY-VEC)
    (loop [k 1] (or (= k np) (and (= (ck-pt M f k) TY-I64) (recur (inc k)))))))))
(defn- wrc-field [M :vector-i64 p :i64 x :i64 f :i64 cf :i64 cb :i64 bump :i64 vr :i64 it :i64 wr :i64] :i64
 (if (<= x -1000) (gn-sir M (+ p (- (- 0 x) 1000)) IF-A)
  (case x -1 f -2 cf -3 cb -4 bump -7 vr -8 it -9 wr
   -5 (gn-sir M (+ p 20) IF-B) -6 (gn-sir M (+ p 12) IF-B) x)))
(defn- wrc-match [M :vector-i64 f :i64 kind :i64 cf :i64 cb :i64 bump :i64 vr :i64 it :i64 wr :i64] :bool
 (and (wrc-meta M f kind)
  (let [p (gn-fnf M f FF-SIR) n (wrc-count kind)]
   (loop [k 0] (or (= k n)
    (let [V (wrc-pattern (+ (* kind 4) (quot k 32))) q (vector-at V (rem k 32))]
     (and (gn-dot-at? M (+ p k) (bit-and q 65535)
      (wrc-field M p (i64-shift-right (i64-shift-left q 32) 48) f cf cb bump vr it wr)
      (wrc-field M p (i64-shift-right (i64-shift-left q 16) 48) f cf cb bump vr it wr)
      (i64-shift-right q 48)) (recur (inc k)))))))))
(defn- wrc-label [M :vector-i64 l :i64 expected :i64 p :i64 n :i64] :bool
 ;; The expected source record already contains l; reject all duplicate labels
 ;; and every foreign branch targeting l, independent of the current GN cache.
 (loop [k 1] (or (= k (vector-at M MM-SIR-N))
  (let [op (gn-op M k) x (gn-sir M k IF-A) y (gn-sir M k IF-B)]
   (and (not= op OP-TAB) (if (and (= op OP-LABEL) (= x l)) (= k expected) true)
    (if (or (and (= op OP-BR) (= x l))
      (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= y l)))
     (and (>= k p) (< k (+ p n))) true)
    (recur (inc k)))))))
(defn- wrc-owned [M :vector-i64 f :i64 kind :i64] :bool
 (and (wrc-meta M f kind) (let [p (gn-fnf M f FF-SIR) n (wrc-count kind)]
  (loop [k 0] (or (= k n)
   (and (if (= (gn-op M (+ p k)) OP-LABEL)
    (let [l (gn-sir M (+ p k) IF-A)]
     (and (> l 0) (< l MM-LABEL-CAP) (wrc-label M l (+ p k) p n))) true)
    (recur (inc k))))))))
(defn- wrc-safe [M :vector-i64 f :i64 kind :i64 cf :i64 cb :i64 bump :i64 vr :i64 it :i64 wr :i64] :bool
 (and (wrc-match M f kind cf cb bump vr it wr) (wrc-owned M f kind)))
(defn- wrc-admit [M :vector-i64 i :i64] :bool
 ;; Post-bump CALL result is already in original slot7; folded LSET is skipped.
 (and (mdc-counts M) (> i 13) (< i (vector-at M MM-SIR-N))
  (<= 69 (- (vector-at M MM-SIR-N) (- i 13))) (= (gn-op M (- i 13)) OP-FN)
  (let [p (- i 13) f (gn-sir M p IF-A)]
   (and (wrc-meta M f 0) (= (gn-fnf M f FF-SIR) p)
    (not (jt-return M (+ p 24) 0)) (not (jt-return M (+ p 31) 0)) (not (jt-return M (+ p 40) 0))
    (not (jt-return M (+ p 48) 0)) (not (jt-return M (+ p 58) 0)) (not (jt-return M (+ p 65) 0))
    (= (gn-g M gn-f-ns) 9) (= (gn-g M gn-f-dp) 5) (= (gn-g M gn-f-nsv) 9)
    (= (gn-g M gn-f-fb) 208) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
    (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 1) (= (gn-g M gn-f-skip) 1) (= (gn-g M gn-f-dead) 0)
    (= (gn-dk M 0) gn-k-local) (= (gn-dv M 0) 7)
    (= (gn-sreg M 1) 26) (= (gn-sreg M 2) 19) (= (gn-sreg M 3) 22) (= (gn-sreg M 4) 27)
    (= (gn-sreg M 5) 21) (= (gn-sreg M 6) 20) (= (gn-sreg M 7) 25)
    (= (gn-sreg M 8) 23) (= (gn-sreg M 9) 24)
    (>= (vector-at M MM-CODE-N) 1) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 1024))
    (>= (vector-at M MM-FIX-N) 1) (<= (vector-at M MM-FIX-N) (- MM-FIX-CAP 32))
    (>= (vector-at M MM-LABEL-N) 1) (< (vector-at M MM-LABEL-N) (- MM-LABEL-CAP 8))
    (let [cf (gn-sir M (+ p 24) IF-A) cb (gn-sir M (+ p 58) IF-A) bump (gn-sir M (+ p 13) IF-A)]
     (and (wrc-meta M cf 1) (wrc-meta M cb 2) (wrc-meta M bump 3)
      (let [cp (gn-fnf M cf FF-SIR) bp (gn-fnf M cb FF-SIR) bup (gn-fnf M bump FF-SIR)
            it (gn-sir M (+ (gn-fnf M cf FF-SIR) 17) IF-A)]
       (and (wrc-meta M it 4)
        (let [ip (gn-fnf M it FF-SIR) vr (gn-sir M (+ (gn-fnf M it FF-SIR) 5) IF-A)
              wr (gn-sir M (+ (gn-fnf M it FF-SIR) 20) IF-A)]
         (and (not= f cf) (not= f cb) (not= f bump) (not= cf cb)
          (not= cf it) (not= cb it) (not= bump it) (not= vr wr) (not= vr it) (not= wr it)
          (wrc-safe M f 0 cf cb bump vr it wr) (wrc-safe M cf 1 cf cb bump vr it wr)
          (wrc-safe M cb 2 cf cb bump vr it wr) (wrc-safe M bump 3 cf cb bump vr it wr)
          (wrc-safe M it 4 cf cb bump vr it wr) (wrc-safe M vr 5 cf cb bump vr it wr)
          (wrc-safe M wr 6 cf cb bump vr it wr)
          (>= (gn-ctx-safe M bump 2 8 512) 0)
          (> (wrc-call-ret M cf it) 0) (> (wrc-call-ret M cb it) 0)
          (>= (wrc-call-ret M cf it) (- (vector-at M MM-CODE-N) 261000))
          (>= (wrc-call-ret M cb it) (- (vector-at M MM-CODE-N) 261000))))))))))))

(defn- wrc-charge [M :vector-i64 n :i64] :vector-i64
 ;; Complete unsigned budget already excludes every synchronous fuel trap.
 (let [r (if (>= n 3) 8 16)]
  (-> M (gn-emit (enc-ldr r 7 CTX-FUEL)) (gn-emit (enc-sub-i r r n))
   (gn-emit (enc-str r 7 CTX-FUEL)))))

(defn- wrc-code-end [M :vector-i64 start :i64 f :i64 best :i64] :i64
 (if (= f (vector-at M MM-FN-N)) best
  (let [c (gn-fnf M f FF-CODE)]
   (wrc-code-end M start (inc f) (if (and (> c start) (< c best)) c best)))))
(defn- wrc-call-ret-scan [M :vector-i64 item :i64 start :i64 end :i64 k :i64 found :i64] :i64
 (if (= k (vector-at M MM-FIX-N)) found
  (let [kind (sf-x M k XF-KIND) at (sf-x M k XF-AT) to (sf-x M k XF-TARGET)]
   (if (and (= kind FX-BL26) (= to item) (>= at start) (< at end))
    (if (or (> found 0) (<= at 0) (>= (inc at) end)
      (not= (bit-and (sf-word M at) 0xfc000000) 0x94000000)) 0
     (wrc-call-ret-scan M item start end (inc k) (inc at)))
    (wrc-call-ret-scan M item start end (inc k) found)))))
(defn- wrc-call-ret [M :vector-i64 f :i64 item :i64] :i64
 ;; All FN/SIR roles have been staged before this issued CODE/FIX lookup.
 (let [cn (vector-at M MM-CODE-N) xn (vector-at M MM-FIX-N)]
  (if (or (<= cn 0) (> cn MM-CODE-CAP) (<= xn 0) (> xn MM-FIX-CAP)) 0
   (let [start (gn-fnf M f FF-CODE)]
    (if (or (<= start 0) (>= start cn)) 0
     (let [end (wrc-code-end M start 1 cn)]
      (wrc-call-ret-scan M item start end 1 0)))))))
(defn- wrc-item [M :vector-i64 label :i64] :vector-i64
 ;; Retain the original144-byte item frame and its original entry1 then
 ;; PI-success3 publications. Pair reads22/23 precede the ordered STP.
 (-> M (gn-fix FX-ADRL19 label) (gn-emit (gn-e-adr 30))
  (gn-emit (enc-stp-pre 29 30 31 -16)) (gn-emit (enc-mov-sp 29 31))
  (gn-emit (enc-sub-i 31 31 128))
  (gn-emit (enc-stp 19 20 31 0)) (gn-emit (enc-stp 21 22 31 16))
  (gn-emit (enc-str 23 31 32)) (gn-emit (enc-str 7 31 120))
  (gn-mov 19 0) (gn-mov 20 1) (gn-mov 21 2)
  (wrc-charge 1) (wrc-charge 3)
  (gn-emit (enc-ldp 22 23 9 0)) (gn-emit (enc-stp 22 23 10 0))
  (gn-mov 0 19) (gn-emit (enc-ldp 19 20 31 0)) (gn-emit (enc-ldp 21 22 31 16))
  (gn-emit (enc-ldr 23 31 32))
  (gn-emit (enc-mov-sp 31 29)) (gn-emit (enc-ldp-post 29 30 31 16))))

(defn- wrc-disjoint [M :vector-i64 G :vector-i64] :vector-i64
 (-> M (gn-emit (enc-cmp-r 3 17)) (gn-emit (enc-bcond (enc-cond-hs) 3))
  (gn-emit (enc-cmp-r 16 4)) (ri-cold G (enc-cond-lo))))
(defn- wrc-meta-disjoint [M :vector-i64 G :vector-i64] :vector-i64
 (-> M (gn-emit (enc-add-i 11 7 400))
  (gn-emit (enc-cmp-r 16 11)) (gn-emit (enc-bcond (enc-cond-hs) 3))
  (gn-emit (enc-cmp-r 7 17)) (ri-cold G (enc-cond-lo))
  (gn-emit (enc-mov-sp 11 31)) (gn-emit (enc-sub-i 11 11 320))
  (gn-emit (enc-add-i 15 29 16))
  (gn-emit (enc-cmp-r 16 15)) (gn-emit (enc-bcond (enc-cond-hs) 3))
  (gn-emit (enc-cmp-r 11 17)) (ri-cold G (enc-cond-lo))))
(defn- wrc-guard [M :vector-i64 G :vector-i64 buffer :i64] :vector-i64
 (-> M
  ;; All caller coordinates unsigned bounded; this proves the original SUBs.
  (gn-mov-imm 17 67108864) (gn-emit (enc-cmp-r 19 17)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-cmp-r 22 17)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-cmp-r 27 17)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-cmp-r 22 19)) (ri-cold G (enc-cond-lo))
  (gn-emit (enc-cmp-r 27 22)) (ri-cold G (enc-cond-lo))
  (gn-mov-imm 6 buffer) (gn-emit (enc-cmp-r 6 17)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-sub-r 17 27 19)) (gn-mov-imm 16 4096)
  (gn-emit (enc-cmp-r 17 16)) (ri-cold G 8)
  ;; Compare only: 3 copy entries plus <=2*span pair steps, 5 charges per step.
  (gn-emit (gn-e-lsl 16 17 3)) (gn-emit (gn-e-lsl 17 17 1))
  (gn-emit (enc-add-r 17 16 17)) (gn-emit (enc-add-i 17 17 3))
  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 17)) (ri-cold G (enc-cond-lo))
  ;; x7 returned unchanged by the exact bump/put closure. Frame exclusion
  ;; precedes any optional saved-context reload; a failure preserves ctx witness.
  (gn-emit (enc-mov-sp 11 31)) (gn-emit (enc-cmp-i 11 320)) (ri-cold G (enc-cond-lo))
  (gn-mov-imm 17 -16) (gn-emit (enc-cmp-r 29 17)) (ri-cold G (enc-cond-hs))
  (gn-mov-imm 17 -400) (gn-emit (enc-cmp-r 7 17)) (ri-cold G (enc-cond-hs))
  (gn-mov 16 7) (gn-emit (enc-add-i 17 7 400))
  (gn-emit (enc-sub-i 11 11 320)) (gn-emit (enc-add-i 15 29 16))
  (gn-emit (enc-cmp-r 16 15)) (gn-emit (enc-bcond (enc-cond-hs) 3))
  (gn-emit (enc-cmp-r 11 17)) (ri-cold G (enc-cond-lo))
  (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 12 16 0))
  (gn-mov-imm 17 16777217) (gn-emit (enc-cmp-r 12 17)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-sub-i 17 25 1)) (gn-emit (enc-cmp-r 17 12)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 17 16 12 4))
  (gn-emit (enc-cmp-r 17 16)) (ri-cold G (enc-cond-lo))
  (gn-emit (enc-sub-i 17 25 1)) (gn-emit (gn-e-addsl 16 16 17 4))
  (gn-emit (enc-ldp 13 14 16 0))
  (gn-mov-imm 17 134217728) (gn-emit (enc-cmp-r 13 17)) (ri-cold G 8)
  (gn-emit (enc-sub-r 17 17 13)) (gn-emit (enc-cmp-r 14 17)) (ri-cold G 8)
  ;; Main [start,end) and conservative buffer [buffer,buffer+span) envelopes.
  (gn-emit (gn-e-lsl 16 27 1)) (gn-emit (enc-cmp-r 16 14)) (ri-cold G 8)
  (gn-emit (enc-sub-r 16 27 19)) (gn-emit (enc-add-r 16 16 6))
  (gn-emit (gn-e-lsl 16 16 1)) (gn-emit (enc-cmp-r 16 14)) (ri-cold G 8)
  (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 3 15 13 3))
  (gn-emit (enc-cmp-r 3 15)) (ri-cold G (enc-cond-lo))
  (gn-emit (gn-e-addsl 4 3 14 3)) (gn-emit (enc-cmp-r 4 3)) (ri-cold G (enc-cond-lo))
  (gn-mov 16 7) (gn-emit (enc-add-i 17 7 400)) (wrc-disjoint G)
  (gn-emit (enc-ldr 16 7 312)) (gn-mov-imm 17 -8)
  (gn-emit (enc-cmp-r 16 17)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-add-i 17 16 8)) (wrc-disjoint G) (wrc-meta-disjoint G)
  (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 17 16 12 4))
  (wrc-disjoint G) (wrc-meta-disjoint G)
  (gn-emit (enc-mov-sp 16 31)) (gn-emit (enc-sub-i 16 16 320))
  (gn-emit (enc-add-i 17 29 16)) (wrc-disjoint G)))
(defn- wrc-copy [M :vector-i64 backward :bool label :i64 call :i64 itemlabel :i64] :vector-i64
 ;; Arguments0..4 follow the original private ABI. Exact original frame stores;
 ;; x26 is an existing caller-owned dead vector home, now immutable backing.
 (let [F (if backward 128 160)
  a (-> M (scfill-lr-fix label call)
   (gn-emit (enc-stp-pre 29 30 31 -16)) (gn-emit (enc-mov-sp 29 31))
   (gn-emit (enc-sub-i 31 31 F))
   (gn-emit (enc-stp 19 20 31 0)) (gn-emit (enc-stp 21 22 31 16))
   (cond-> (not backward) (gn-emit (enc-str 23 31 32)))
   (gn-emit (enc-str 7 31 (- F 8)))
   (gn-mov 20 0) (gn-mov 21 1) (gn-mov 22 2)
   (cond-> (not backward) (gn-mov 23 3)) (gn-mov 19 (if backward 3 4))
   (wrc-charge 1)
   (gn-emit (if backward (enc-cmp-i 19 0) (enc-cmp-r 19 23))))
  done-at (vector-at a MM-CODE-N)
  b (gn-emit a (enc-bcond (if backward (enc-cond-lt) (enc-cond-eq)) 0))
  c (-> b (gn-emit (enc-add-r 9 22 19)) (gn-emit (gn-e-addsl 9 26 9 4))
   (gn-emit (enc-add-r 10 21 19)) (gn-emit (gn-e-addsl 10 26 10 4)))
  head (vector-at c MM-CODE-N)
  d (-> c (gn-mov 0 20) (gn-emit (enc-add-r 1 21 19)) (gn-emit (enc-add-r 2 22 19))
   (wrc-item itemlabel)
   (gn-emit (if backward (enc-sub-i 19 19 1) (enc-add-i 19 19 1)))
   (wrc-charge 1)
   (gn-emit (if backward (enc-sub-i 9 9 16) (enc-add-i 9 9 16)))
   (gn-emit (if backward (enc-sub-i 10 10 16) (enc-add-i 10 10 16)))
   (gn-emit (if backward (enc-cmp-i 19 0) (enc-cmp-r 19 23))))
  back (vector-at d MM-CODE-N)
  e (gn-emit d (enc-bcond (if backward (enc-cond-ge) (enc-cond-ne)) (- head back)))
  done (vector-at e MM-CODE-N)]
  (-> e (gn-put (+ MM-CODE-BASE done-at) (enc-bcond (if backward (enc-cond-lt) (enc-cond-eq)) (- done done-at)))
   (gn-mov 0 20) (gn-emit (enc-ldp 19 20 31 0)) (gn-emit (enc-ldp 21 22 31 16))
   (cond-> (not backward) (gn-emit (enc-ldr 23 31 32)))
   (gn-emit (enc-mov-sp 31 29)) (gn-emit (enc-ldp-post 29 30 31 16)))))
(defn- wrc-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (- i 13) buffer (gn-sir M (+ p 20) IF-B)
  cf (gn-sir M (+ p 24) IF-A) cb (gn-sir M (+ p 58) IF-A)
  it (gn-sir M (+ (gn-fnf M cf FF-SIR) 17) IF-A)
  first (vector-at M MM-LABEL-N) ctx (gn-g M gn-f-ctx) G (vector-alloc 129)
  ;; Guard refusals have not changed any saved high home, context, or frame.
  a (wrc-guard M G buffer)
  b (-> a (gn-ctx) (gn-mov 26 3) (gn-put MM-LABEL-N (+ first 8))
   (gn-put (+ MM-LABEL-BASE first 6) (wrc-call-ret M cf it))
   (gn-put (+ MM-LABEL-BASE first 7) (wrc-call-ret M cb it))
   (gn-emit (enc-cmp-r 21 20)))
  right-at (vector-at b MM-CODE-N) c (gn-emit b (enc-bcond (enc-cond-gt) 0))
  left (-> c (gn-mov 0 25) (gn-mov-imm 1 buffer) (gn-mov 2 19) (gn-mov 3 21) (gn-mov 4 31)
   (wrc-copy false first (+ p 24) (+ first 6)) (gn-mov 23 0)
   (gn-mov 0 23) (gn-mov 1 19) (gn-mov 2 22) (gn-mov 3 20) (gn-mov 4 31)
   (wrc-copy false (inc first) (+ p 31) (+ first 6)) (gn-mov 24 0)
   (gn-emit (enc-add-r 10 19 20)) (gn-mov 0 24) (gn-mov 1 10) (gn-mov-imm 2 buffer) (gn-mov 3 21) (gn-mov 4 31)
   (wrc-copy false (+ first 2) (+ p 40) (+ first 6)) (gn-mov 9 0))
  end-at (vector-at left MM-CODE-N) jump (gn-emit left (enc-b 0))
  right-start (vector-at jump MM-CODE-N)
  right (-> jump (gn-mov 0 25) (gn-mov-imm 1 buffer) (gn-mov 2 22) (gn-mov 3 20) (gn-mov 4 31)
   (wrc-copy false (+ first 3) (+ p 48) (+ first 6)) (gn-mov 23 0)
   (gn-emit (enc-add-r 10 19 20)) (gn-emit (enc-sub-i 12 21 1))
   (gn-mov 0 23) (gn-mov 1 10) (gn-mov 2 19) (gn-mov 3 12)
   (wrc-copy true (+ first 4) (+ p 58) (+ first 7)) (gn-mov 24 0)
   (gn-mov 0 24) (gn-mov 1 19) (gn-mov-imm 2 buffer) (gn-mov 3 20) (gn-mov 4 31)
   (wrc-copy false (+ first 5) (+ p 65) (+ first 6)) (gn-mov 9 0))
  end (vector-at right MM-CODE-N)
  out (-> right (gn-put (+ MM-CODE-BASE right-at) (enc-bcond (enc-cond-gt) (- right-start right-at)))
   (gn-put (+ MM-CODE-BASE end-at) (enc-b (- end end-at)))
   (gn-mov 0 9) (gn-epilogue) (gn-gs gn-f-dead 0) (gn-gs gn-f-ctx ctx))
  cold (vector-at out MM-CODE-N)]
  (ri-patch out G 0 cold)))
(defn- wrc-entry [M :vector-i64 i :i64] :vector-i64
 (if (wrc-admit M i) (wrc-emit M i) M))

;; ADR0357 one-off: bounded per-definition SSA and owned forward phi coalescing.
;; New compiler-only vectors; existing frame/runtime/guard/cold authority unchanged.
(defn- jssa-env [P :vector-i64 r :i64 k :i64] :i64 (+ 16 (+ (* r (vector-at P 1)) (dec k))))
(defn- jssa-row [P :vector-i64 r :i64 k :i64] :i64 (+ (vector-at P 4) (+ (* r 8) k)))
(defn- jssa-mask [P :vector-i64 field :i64 r :i64] :i64 (+ (vector-at P field) (* r 4)))
(defn- jssa-has [P :vector-i64 at :i64 v :i64] :bool
 (and (> v 0) (<= v 256) (let [q (quot (dec v) 64) b (- (dec v) (* q 64))]
  (not= (bit-and (vector-at P (+ at q)) (i64-shift-left 1 b)) 0))))
(defn- jssa-bit [P :vector-i64 at :i64 v :i64] :vector-i64
 (if (or (<= v 0) (> v (vector-at P 2))) (vector-assoc! P 3 1)
  (let [q (quot (dec v) 64) b (- (dec v) (* q 64))]
   (vector-assoc! P (+ at q) (bit-or (vector-at P (+ at q)) (i64-shift-left 1 b))))))
(defn- jssa-raw-bit [G :vector-i64 v :i64] :vector-i64
 (if (or (<= v 0) (> v 256)) G (let [q (quot (dec v) 64) b (- (dec v) (* q 64))]
  (vector-assoc! G q (bit-or (vector-at G q) (i64-shift-left 1 b))))))
(defn- jssa-fresh [P :vector-i64] :vector-i64
 (if (>= (vector-at P 2) 256) (vector-assoc! P 3 1) (vector-assoc! P 2 (inc (vector-at P 2)))))
(defn- jssa-edge [M :vector-i64 start :i64 end :i64 p :i64 to :i64] :bool
 (let [op (gn-op M p)] (or (and (not= op OP-BR) (= (inc p) to))
  (and (= op OP-BR) (= (jdag-label M start end (gn-sir M p IF-A)) to))
  (and (= op OP-BRZ) (= (jdag-label M start end (gn-sir M p IF-B)) to)))))
(defn- jssa-merge [M :vector-i64 P :vector-i64 start :i64 end :i64 r :i64] :vector-i64
 (loop [V P k 1] (if (> k (vector-at V 1)) V
  (let [first (loop [p 0] (cond (= p r) -1 (jssa-edge M start end (+ start p) (+ start r)) p :else (recur (inc p))))
   value (if (< first 0) 0 (vector-at V (jssa-env V first k)))
   same (loop [p 0] (or (= p r) (and (or (not (jssa-edge M start end (+ start p) (+ start r)))
     (= (vector-at V (jssa-env V p k)) value)) (recur (inc p)))))
   known (loop [p 0] (or (= p r) (and (or (not (jssa-edge M start end (+ start p) (+ start r)))
     (> (vector-at V (jssa-env V p k)) 0)) (recur (inc p)))))
   phi (and (not same) known) m (if phi (jssa-fresh V) V)
   id (if phi (vector-at m 2) (if same value 0))
   n (vector-assoc! m (jssa-env m r k) id)]
   (recur (if phi (jssa-bit n (jssa-mask n 7 r) id) n) (inc k))))))
(defn- jssa-inputs [P :vector-i64 r :i64 first :i64 n :i64] :vector-i64
 (loop [V P k 0] (if (= k n) V (let [id (vector-at V (jssa-env V r (+ first k)))
  m (vector-assoc! V (jssa-row V r k) id)] (recur (jssa-bit m (jssa-mask m 6 r) id) (inc k))))))
(defn- jssa-forward [M :vector-i64 P :vector-i64 start :i64 end :i64 ns :i64] :vector-i64
 (loop [V P r 0] (if (= r (vector-at V 0)) V
  (let [j (+ start r) op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
   m (if (= r 0) (loop [X V k 1] (if (> k 4) X (recur (vector-assoc! X (jssa-env X r k) k) (inc k))))
    (jssa-merge M V start end r))
   n (case op OP-LGET (jssa-inputs m r b 1) OP-LSET (jssa-inputs m r (+ ns 1 b) 1)
    OP-BIN (jssa-inputs m r (+ ns 1 b) 2) OP-RT (jssa-inputs m r (+ ns 1 b) c)
    OP-CALL (jssa-inputs m r (+ ns 1 b) c) OP-BRZ (jssa-inputs m r (+ ns 1 a) 1) m)
   fresh (or (= op OP-CONST) (= op OP-BIN) (= op OP-RT) (and (= op OP-CALL) (not= (jdag-call M j) 4)))
   x (if fresh (jssa-fresh n) n) result (if fresh (vector-at x 2) 0)
   y (if fresh (-> x (vector-assoc! (jssa-row x r 6) result) (jssa-bit (jssa-mask x 7 r) result)) x)
   z (cond (= op OP-LGET) (vector-assoc! y (jssa-env y r (+ ns 1 a)) (vector-at y (jssa-row y r 0)))
    (= op OP-LSET) (vector-assoc! y (jssa-env y r a) (vector-at y (jssa-row y r 0)))
    (= op OP-CONST) (vector-assoc! y (jssa-env y r (+ ns 1 a)) result)
    fresh (vector-assoc! y (jssa-env y r (+ ns 1 b)) result) :else y)]
   (recur z (inc r))))))
;; Add incoming phi uses on their exact predecessor edge, not at unrelated arms.
(defn- jssa-out [M :vector-i64 P :vector-i64 start :i64 end :i64 r :i64 G :vector-i64] :vector-i64
 (loop [V G to (inc r)] (if (> to (vector-at P 0)) V
  (if (not (jssa-edge M start end (+ start r) (+ start to))) (recur V (inc to))
   (let [m (if (= to (vector-at P 0))
     (let [v (vector-at P (jssa-env P r (inc (vector-at P 12))))] (jssa-raw-bit V v))
     (loop [X V w 0] (if (= w 4) X (recur (vector-assoc! X w (bit-or (vector-at X w)
      (vector-at P (+ (jssa-mask P 5 to) w)))) (inc w)))))
    n (if (or (= to (vector-at P 0)) (not= (gn-op M (+ start to)) OP-LABEL)) m
     (loop [X m k 1] (if (> k (vector-at P 1)) X
      (let [v (vector-at P (jssa-env P to k))]
       (recur (if (jssa-has P (jssa-mask P 8 to) v)
        (jssa-raw-bit X (vector-at P (jssa-env P r k))) X) (inc k))))))]
    (recur n (inc to)))))))
(defn- jssa-group [P :vector-i64 G :vector-i64] :vector-i64
 (loop [V P a 1] (if (> a (vector-at V 2)) V
  (recur (if (not (jssa-has G 0 a)) V (loop [X V b 1] (if (> b (vector-at X 2)) X
   (recur (if (and (not= a b) (jssa-has G 0 b)) (jssa-bit X (+ (vector-at X 9) (* (dec a) 4)) b) X) (inc b))))) (inc a)))))
(defn- jssa-live [M :vector-i64 P :vector-i64 start :i64 end :i64] :vector-i64
 (loop [V P r (dec (vector-at P 0))] (if (< r 0) V
  ;; Mask scratch advertises same bounded value count for jssa-bit.
  (let [scratch (vector-alloc 4)
   G (jssa-out M V start end r scratch)
   m (loop [X V w 0] (if (= w 4) X
    (let [out (vector-at G w) d (vector-at X (+ (jssa-mask X 7 r) w))
     use (vector-at X (+ (jssa-mask X 6 r) w))]
     (recur (-> X (vector-assoc! (+ (jssa-mask X 5 r) w) (bit-or use (bit-and out (bit-not d))))
      (vector-assoc! (+ (jssa-mask X 8 r) w) (bit-and out d))) (inc w)))))
   in (loop [X (vector-alloc 4) w 0]
    (if (= w 4) X (recur (vector-assoc! X w (vector-at m (+ (jssa-mask m 5 r) w))) (inc w))))
   outdef (loop [X G w 0] (if (= w 4) X (recur (vector-assoc! X w (bit-or (vector-at X w)
     (vector-at m (+ (jssa-mask m 7 r) w)))) (inc w))))]
   (recur (jssa-group (jssa-group (jssa-group m in) G) outdef) (dec r))))))
(defn- jssa-root [P :vector-i64 v :i64] :i64
 (loop [k v steps 0] (cond (or (<= k 0) (> k (vector-at P 2)) (> steps 256)) 0
  (= (vector-at P (+ (vector-at P 10) k)) k) k
  :else (recur (vector-at P (+ (vector-at P 10) k)) (inc steps)))))
(defn- jssa-union [P :vector-i64 v :i64 q :i64] :vector-i64
 (let [a (jssa-root P v) b (jssa-root P q)]
  (if (= a b) P (if (or (= a 0) (= b 0)
   (and (<= a 4) (<= b 4))
   (loop [x 1] (and (<= x (vector-at P 2))
    (or (and (= (jssa-root P x) a) (loop [y 1] (and (<= y (vector-at P 2))
      (or (and (= (jssa-root P y) b) (jssa-has P (+ (vector-at P 9) (* (dec x) 4)) y)) (recur (inc y))))))
     (recur (inc x)))))) (vector-assoc! P 3 1)
    (vector-assoc! P (+ (vector-at P 10) (gn-max a b)) (if (< a b) a b))))))
(defn- jssa-phis [M :vector-i64 P :vector-i64 start :i64 end :i64] :vector-i64
 (loop [V P r 0] (if (= r (vector-at V 0)) V
  (recur (if (not= (gn-op M (+ start r)) OP-LABEL) V
   (loop [X V k 1] (if (> k (vector-at X 1)) X
    (let [v (vector-at X (jssa-env X r k))]
     (recur (if (not (jssa-has X (jssa-mask X 8 r) v)) X
      (loop [Y X p 0] (if (= p r) Y
       (recur (if (jssa-edge M start end (+ start p) (+ start r))
        (jssa-union Y v (vector-at Y (jssa-env Y p k))) Y) (inc p))))) (inc k)))))) (inc r)))))
(defn- jssa-regraph [P :vector-i64] :vector-i64
 (let [G (loop [V (vector-alloc 1024) x 1] (if (> x (vector-at P 2)) V
   (recur (loop [X V y 1] (if (> y (vector-at P 2)) X
    (let [a (jssa-root P x) b (jssa-root P y)]
     (recur (if (and (not= a b) (jssa-has P (+ (vector-at P 9) (* (dec x) 4)) y))
      (let [q (quot (dec b) 64) bit (- (dec b) (* q 64)) at (+ (* (dec a) 4) q)]
       (vector-assoc! X at (bit-or (vector-at X at) (i64-shift-left 1 bit)))) X) (inc y))))) (inc x))))]
  (loop [V P k 0] (if (= k 1024) V (recur (vector-assoc! V (+ (vector-at V 9) k) (vector-at G k)) (inc k))))))
(defn- jssa-degree [P :vector-i64 v :i64] :i64
 (loop [k 1 n 0] (if (> k (vector-at P 2)) n
  (recur (inc k) (+ n (if (jssa-has P (+ (vector-at P 9) (* (dec v) 4)) k) 1 0))))))
(defn- jssa-color [P :vector-i64 M :vector-i64] :vector-i64
 (let [preset (loop [V P k 1] (if (> k 4) V
  (recur (vector-assoc! V (+ (vector-at V 11) (jssa-root V k)) (gn-sreg M k)) (inc k))))]
 (loop [V preset count 0] (if (> count (vector-at V 2)) (vector-assoc! V 3 1)
  (let [x (loop [k 1 best 0 degree -1] (if (> k (vector-at V 2)) best
   (let [d (jssa-degree V k)] (if (and (= (jssa-root V k) k)
    (= (vector-at V (+ (vector-at V 11) k)) 0) (> d degree)) (recur (inc k) k d) (recur (inc k) best degree)))))]
   (if (= x 0) V (let [reg (loop [k 0] (if (= k 16) 0 (let [r (jdag-bank k)]
    (if (loop [q 1] (or (> q (vector-at V 2)) (and (or (not (jssa-has V (+ (vector-at V 9) (* (dec x) 4)) q))
     (not= (vector-at V (+ (vector-at V 11) q)) r)) (recur (inc q))))) r (recur (inc k))))))]
    (if (= reg 0) (vector-assoc! V 3 1) (recur (vector-assoc! V (+ (vector-at V 11) x) reg) (inc count))))))))))
(defn- jssa-plan [M :vector-i64 start :i64 end :i64 ns :i64 dp :i64] :vector-i64
 (let [n (- end start) width (+ ns dp) rb (+ 16 (* n width)) lb (+ rb (* n 8))
  ub (+ lb (* n 4)) db (+ ub (* n 4)) hb (+ db (* n 4)) eb (+ hb (* n 4))
  pb (+ eb 1024) cb (+ pb 257)]
  (if (or (<= n 0) (> n 512) (< ns 11) (> ns 48) (< dp 5) (> dp 7) (> width 55)) (vector-alloc 1)
   (let [P (-> (vector-alloc (+ cb 257)) (vector-assoc! 0 n) (vector-assoc! 1 width) (vector-assoc! 2 4)
    (vector-assoc! 4 rb) (vector-assoc! 5 lb) (vector-assoc! 6 ub) (vector-assoc! 7 db)
    (vector-assoc! 8 hb) (vector-assoc! 9 eb) (vector-assoc! 10 pb) (vector-assoc! 11 cb) (vector-assoc! 12 ns))
    F (jssa-forward M P start end ns)
    init (loop [V F k 1] (if (> k (vector-at V 2)) V (recur (vector-assoc! V (+ pb k) k) (inc k))))]
    (if (or (not= (vector-at F 3) 0) (<= (vector-at F (jssa-env F (dec n) (inc ns))) 0)) (vector-alloc 1)
     (let [L (jssa-live M init start end) U (jssa-phis M L start end)]
      (if (not= (vector-at U 3) 0) (vector-alloc 1)
       (let [C (jssa-color (jssa-regraph U) M)]
        (if (not= (vector-at C 3) 0) (vector-alloc 1) C)))))))))
(defn- jssa-reg [P :vector-i64 id :i64] :i64
 (vector-at P (+ (vector-at P 11) (jssa-root P id))))
(defn- jssa-in [P :vector-i64 r :i64 k :i64] :i64
 (jssa-reg P (vector-at P (jssa-row P r k))))
(defn- jssa-dst [P :vector-i64 r :i64] :i64
 (jssa-reg P (vector-at P (jssa-row P r 6))))
;; Existing bounded RC rounding proof, now rooted in an exact SSA CONST use.
;; Caller is jssa-helper kind2 inside the already-owned jssa-body. Keep every
;; original charge/publication, SBFM, MUL, bias and final sign wrapper.
(defn- ssrq-bounded [M :vector-i64 j :i64 P :vector-i64 r :i64 w :i64] :bool
 (if (or (< (vector-count P) 16) (<= j 1) (>= j (vector-at M MM-SIR-N))
         (<= w 0) (> w 32)) false
  (let [n (vector-at P 0) rb (vector-at P 4) nv (vector-at P 2)]
   (if (or (<= n 0) (> n 512) (< r 1) (>= r n)
           (< rb 16) (>= rb (vector-count P))
           (> (* n 8) (- (vector-count P) rb))
           (<= nv 0) (> nv 256)) false
    (let [t (gn-sir M j IF-B) value (gn-sir M (dec j) IF-B)
          definition (vector-at P (jssa-row P (dec r) 6))
          use (vector-at P (jssa-row P r 1))]
     (and (= (gn-op M j) OP-CALL) (= (gn-sir M j IF-C) 2)
      (= (jdag-call M j) 2)
      (>= t 0) (< t (vector-at P 1)) (<= 2 (- (vector-at P 1) t))
      (= (gn-op M (dec j)) OP-CONST)
      (= (gn-sir M (dec j) IF-A) (inc t))
      (= (gn-sir M (dec j) IF-C) 0)
      (> definition 0) (<= definition nv) (= use definition)
      ;; RAW value identity only; register/phi DSU roots are never inspected.
      (loop [k 0] (or (= k n)
       (and (or (= k (dec r))
                (not= (vector-at P (jssa-row P k 6)) definition)) (recur (inc k)))))
      (>= value -1073741824) (<= value 1073741824)))))))

;; Bounded RAW-SSA range proof for the owned JSSA rounding/clamp consumer.
;; Values and interval arithmetic are deliberately limited to +/-2^40.
;; The returned fourth word is remaining GLOBAL work, not recursion depth.
(defn- sri-bad [] :vector-i64 (vector-alloc 4))
(defn- sri-small [a :i64 b :i64] :i64 (if (< a b) a b))
(defn- sri-large [a :i64 b :i64] :i64 (if (> a b) a b))
(defn- sri-abs [a :i64] :i64 (if (< a 0) (- 0 a) a))
(defn- sri-ok [lo :i64 hi :i64 work :i64] :vector-i64
 (if (or (< lo -1099511627776) (> hi 1099511627776) (> lo hi) (< work 0)) (sri-bad)
  (-> (vector-alloc 4) (vector-assoc! 0 1) (vector-assoc! 1 lo)
   (vector-assoc! 2 hi) (vector-assoc! 3 work))))
(defn- sri-signed [w :i64 work :i64] :vector-i64
 (if (or (<= w 0) (> w 32)) (sri-bad)
  (let [half (i64-shift-left 1 (dec w))] (sri-ok (- 0 half) (dec half) work))))
;; Phi values have no OP result row. Register-coalescing roots are not read.
(defn- sri-def [P :vector-i64 id :i64] :i64
 (if (or (<= id 4) (> id (vector-at P 2))) -1
  (loop [k 0 found -1]
   (if (= k (vector-at P 0)) found
    (if (= (vector-at P (jssa-row P k 6)) id)
     (if (>= found 0) -1 (recur (inc k) k)) (recur (inc k) found))))))
(defn- sri-bin [op :i64 L :vector-i64 R :vector-i64] :vector-i64
 (let [a (vector-at L 1) b (vector-at L 2) c (vector-at R 1) d (vector-at R 2)
       work (vector-at R 3)]
  (cond (= op BOP-ADD) (sri-ok (+ a c) (+ b d) work)
   (= op BOP-SUB) (sri-ok (- a d) (- b c) work)
   (= op BOP-MUL)
    (let [x (sri-large (sri-abs a) (sri-abs b)) y (sri-large (sri-abs c) (sri-abs d))]
     (if (or (= x 0) (<= y (quot 1099511627776 x)))
      (let [ac (* a c) ad (* a d) bc (* b c) bd (* b d)]
       (sri-ok (sri-small (sri-small ac ad) (sri-small bc bd))
               (sri-large (sri-large ac ad) (sri-large bc bd)) work)) (sri-bad)))
   :else (sri-bad))))
(defn- sri-range [M :vector-i64 P :vector-i64 start :i64 limit :i64 id :i64 work :i64] :vector-i64
 (if (<= work 0) (sri-bad)
  (let [row (sri-def P id)]
   (if (or (< row 0) (>= row limit)) (sri-bad)
    (let [j (+ start row) op (gn-op M j) a (gn-sir M j IF-A) left (dec work)]
     (cond
      (and (= op OP-CONST) (= (gn-sir M j IF-C) 0))
       (let [value (gn-sir M j IF-B)] (sri-ok value value left))
      (= op OP-CALL)
       (let [kind (jdag-call M j)]
        (cond (= kind 1) (sri-signed (bit-and (jdag-sign M a) 511) left)
         ;; RC always performs the final sign wrapper, including overflow fallbacks.
         (= kind 2) (let [p (rc-shape M a)]
          (if (> p 0) (sri-signed (bit-and (rc-sign M (gn-sir M (+ p 11) IF-A)) 511) left) (sri-bad)))
         :else (sri-bad)))
      (and (= op OP-BIN) (or (= a BOP-ADD) (= a BOP-SUB) (= a BOP-MUL)))
       (let [L (sri-range M P start row (vector-at P (jssa-row P row 0)) left)]
        (if (= (vector-at L 0) 0) (sri-bad)
         (let [R (sri-range M P start row (vector-at P (jssa-row P row 1)) (vector-at L 3))]
          (if (= (vector-at R 0) 0) (sri-bad) (sri-bin a L R)))))
      :else (sri-bad)))))))
(defn- sri-admit [M :vector-i64 j :i64 P :vector-i64 r :i64] :bool
 (if (or (< (vector-count P) 16) (< r 0) (<= j r) (>= j (vector-at M MM-SIR-N))) false
  (let [n (vector-at P 0) width (vector-at P 1) rb (vector-at P 4) start (- j r)]
   (if (or (<= n 0) (> n 512) (>= r n) (<= width 0) (> width 55)
      (< rb 16) (>= rb (vector-count P)) (> (* n 8) (- (vector-count P) rb))
      (< (vector-at P 2) 4) (> (vector-at P 2) 256)
      (> n (- (vector-at M MM-SIR-N) start))) false
    (let [t (gn-sir M j IF-B)]
     (and (= (gn-op M j) OP-CALL) (= (gn-sir M j IF-C) 1) (>= t 0) (< t width)
      (= (jdag-call M j) 3)
      (= (vector-at (sri-range M P start r (vector-at P (jssa-row P r 0)) 32) 0) 1)))))))

;; Owned closed writer address: preserve full64 wrapping arithmetic and NZCV.
;; If the ADD base aliases scratchx1, original ADD doubles the product; refuse.
(defn- jssa-writer-address [M :vector-i64 P :vector-i64 r :i64] :vector-i64
 (let [index (jssa-in P r 2) stride (jssa-in P r 3) base (jssa-in P r 1)]
  (if (and (>= index 0) (< index 31) (>= stride 0) (< stride 31)
           (>= base 0) (< base 31) (not= base 1))
   (gn-emit M (enc-madd 1 index stride base))
   (-> M (gn-emit (enc-mul 1 index stride)) (gn-emit (enc-add-r 1 1 base))))))
;; The original generic path retains both charges, independent of loader limits.
(defn- jssa-writer-second [M :vector-i64 private-fuel :bool] :vector-i64
 (if private-fuel M (jdag-sub M)))
(defn- jssa-helper [M :vector-i64 j :i64 P :vector-i64 r :i64 kind :i64 private-fuel :bool] :vector-i64
 (let [f (gn-sir M j IF-A) src (jssa-in P r 0)]
  (case kind
   1 (let [w (bit-and (gn-sign-wrapper M f 1) 511)]
    (gn-emit M (gn-e-bf 0x93400000 (jssa-dst P r) src 0 (dec w))))
   2 (let [p (rc-shape M f) w (bit-and (rc-sign M (gn-sir M (+ p 4) IF-A)) 511)
     z (bit-and (rc-sign M (gn-sir M (+ p 11) IF-A)) 511)
     bias (gn-sir M (+ p 7) IF-B) divisor (gn-sir M (+ p 9) IF-B)]
    (-> M (gn-mov 0 src) (gn-mov 1 (jssa-in P r 1)) (jdag-sub) (jdag-publish)
     (gn-emit (gn-e-bf 0x93400000 0 0 0 (dec w))) (gn-emit (enc-mul 0 0 1))
     (gn-emit (enc-add-i 0 0 bias)) (rc-round-emit (ssrq-bounded M j P r w) divisor)
     (gn-emit (gn-e-bf 0x93400000 0 0 0 (dec z))) (gn-mov (jssa-dst P r) 0)))
   3 (let [p (rp-shape M f) before (gn-sir M (+ p 4) IF-B) divisor (gn-sir M (+ p 6) IF-B)
     after (gn-sir M (+ p 8) IF-B) cf (gn-sir M (+ p 10) IF-A)
     q (gn-clamp M (+ p 10) cf 1) width (bit-and (gn-sign-wrapper M (gn-sir M (inc q) IF-A) 1) 511)
     low (gn-sir M (+ q 4) IF-B) high (gn-sir M (+ q 11) IF-B)]
    (-> M (gn-mov 0 src) (jdag-sub) (jdag-publish) (gn-emit (enc-add-i 0 0 before))
     (rc-round-emit (sri-admit M j P r) divisor) (gn-emit (enc-add-i 0 0 after)) (jdag-sub)
     (gn-emit (gn-e-bf 0x93400000 0 0 0 (dec width)))
     (gn-mov-imm 16 low) (gn-emit (enc-cmp-r 0 16)) (gn-emit (enc-csel 0 16 0 (enc-cond-lt)))
     (gn-mov-imm 17 high) (gn-emit (enc-cmp-r 0 17)) (gn-emit (enc-csel 0 17 0 (enc-cond-gt)))
     (jdag-publish) (gn-mov (jssa-dst P r) 0)))
   ;; Only privateCLW signed-nonnegative prepaid owner; generic fuel unchanged.
   4 (-> (if private-fuel (gn-emit M (enc-subs-i 8 8 2)) (jdag-sub M))
     (jssa-writer-address P r) (gn-mov 0 (jssa-in P r 4))
     (gn-emit (gn-e-bf 0x93400000 0 0 0 15)) (jssa-writer-second private-fuel)
     (gn-emit (gn-e-strr3 0 4 1)) (jdag-publish)) M)))
(defn- jssa-body [M :vector-i64 start :i64 end :i64 ns :i64 P :vector-i64 pos :vector-i64 private-fuel :bool] :vector-i64
 (loop [V M j start] (if (= j end) V
  (let [r (- j start) at (vector-assoc! pos r (vector-at V MM-CODE-N))
   op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
   (case op
    OP-LABEL (recur V (inc j)) OP-LGET (recur V (inc j)) OP-LSET (recur V (inc j))
    OP-CONST (recur (gn-mov-imm V (jssa-dst P r) b) (inc j))
    OP-BIN (let [d (jssa-dst P r) x (jssa-in P r 0) y (jssa-in P r 1)]
     (recur (gn-emit V (cond (= a BOP-ADD) (enc-add-r d x y) (= a BOP-SUB) (enc-sub-r d x y)
      :else (enc-mul d x y))) (inc j)))
    OP-RT (recur (-> V (gn-mov 1 (jssa-in P r 1)) (gn-emit (gn-e-ldrr (jssa-dst P r) 4 1 1))) (inc j))
    OP-CALL (recur (jssa-helper V j P r (jdag-call M j) private-fuel) (inc j))
    OP-BR (recur (gn-emit V (enc-b 0)) (inc j))
    OP-BRZ (recur (gn-emit V (enc-cbz (jssa-in P r 0) 0)) (inc j)) V)))))

;; ADR0357 novel owned-edge witness inheritance: no payload value cache or new guard.
(defn- jwi-admit [M :vector-i64 i :i64 end :i64 recipe :vector-i64] :bool
 (if (not (clw-counts M)) false
  (let [owner (jdag-owner M i 512) f (if (> owner 0) (gn-sir M owner IF-A) 0)
        root (if (> f 0) (clw-witness M f false) 0)]
   (and (> root 0) (> owner 0) (= i (+ owner 27)) (= end (+ owner 343))
    (= (vector-count recipe) 7) (= (vector-at recipe 0) 1)
    (= (vector-at recipe 1) 7) (= (vector-at recipe 2) 5)
    (= (vector-at recipe 3) 8) (= (vector-at recipe 4) 8)
    (= (vector-at recipe 5) 8)))))
;; ADR0357: bounded emitted-edge certificate for private paid scanner results.
;; No runtime guard, GN cell, payload cache or register carrier is introduced.
(defn- jdf-counts [M :vector-i64] :bool
 (and (frfix-counts M) (clw-counts M)
  (> (vector-at M MM-CODE-N) 1) (<= (vector-at M MM-CODE-N) MM-CODE-CAP)
  (> (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)))
(defn- jdf-at [M :vector-i64 at :i64 end :i64 w :i64] :bool
 (and (> at 0) (< at end) (= (sf-word M at) w)))
(defn- jdf-paid [M :vector-i64 at :i64 end :i64] :bool
 (and (> at 0) (<= at (- end 21))
  (jdf-at M at end (enc-ldr 16 7 CTX-FUEL))
  (jdf-at M (inc at) end (enc-subs-i 16 16 1))
  (jdf-at M (+ at 2) end (enc-bcond (enc-cond-hs) 2))
  (jdf-at M (+ at 3) end (enc-brk 0))
  (jdf-at M (+ at 4) end (enc-str 16 7 CTX-FUEL))
  (jdf-at M (+ at 5) end (enc-mov-r 0 (gn-sreg M 1)))
  (jdf-at M (+ at 6) end (enc-mov-r 1 (gn-sreg M 2)))
  (jdf-at M (+ at 7) end (enc-mov-r 2 (gn-sreg M 3)))
  (jdf-at M (+ at 8) end (enc-mov-r 8 16))))
(defn- jdf-find [M :vector-i64 start :i64 end :i64] :i64
 (loop [at start found 0]
  (if (> at (- end 21)) found
   (if (jdf-paid M at end)
    (if (> found 0) 0 (recur (inc at) at)) (recur (inc at) found)))))
(defn- jdf-unroll [M :vector-i64 head :i64 end :i64 n :i64] :bool
 (let [hook (+ head (* 4 (dec n)) 1)]
  (and (>= n 2) (<= n 8) (< hook end)
   (loop [k 0] (or (= k (dec n))
    (let [at (+ head (* 4 k))]
     (and (jdf-at M at end (enc-ldr 9 3 0))
      (jdf-at M (inc at) end (enc-cbnz 9 (- hook (inc at))))
      (jdf-at M (+ at 2) end (enc-add-r 3 3 5))
      (jdf-at M (+ at 3) end (enc-subs-i 6 6 1)) (recur (inc k))))))
   (jdf-at M (dec hook) end (enc-b 2))
   (= (bit-and (sf-word M hook) 0xff00001f) 0xb5000009))))
(defn- jdf-scan-hook [M :vector-i64 paid :i64 n :i64] :i64
 (if (= (sf-word M (+ paid 25)) (enc-bcond (enc-cond-ne) -4))
  (+ paid 22) (+ paid 22 (* 4 (dec n)))))
(defn- jdf-scan [M :vector-i64 at :i64 end :i64 n :i64] :bool
 (and (> n 1) (<= n 10) (<= at (- end 26))
  (jdf-at M (+ at 9) end (enc-ldr 11 7 320))
  (jdf-at M (+ at 10) end (enc-sub-i 9 0 1))
  (jdf-at M (+ at 11) end (gn-e-addsl 16 11 9 4))
  (jdf-at M (+ at 12) end (enc-ldp 5 6 16 0))
  (jdf-at M (+ at 13) end (enc-ldr 4 7 328))
  (jdf-at M (+ at 14) end (enc-add-r 5 5 1))
  (jdf-at M (+ at 15) end (gn-e-addsl 4 4 5 3))
  (jdf-at M (+ at 16) end (gn-e-addsl 5 31 2 3))
  (jdf-at M (+ at 17) end (enc-add-r 3 4 5))
  (jdf-at M (+ at 18) end (enc-movz 6 (dec n) 0))
  (jdf-at M (+ at 19) end (enc-movz 10 (dec n) 0))
  (jdf-at M (+ at 20) end (enc-subs-i 8 8 1))
  (or (and (jdf-at M (+ at 21) end (enc-ldr 9 3 0))
       (= (bit-and (sf-word M (+ at 22)) 0xff00001f) 0xb5000009)
       (jdf-at M (+ at 23) end (enc-add-r 3 3 5))
       (jdf-at M (+ at 24) end (enc-subs-i 6 6 1))
       (jdf-at M (+ at 25) end (enc-bcond (enc-cond-ne) -4)))
      (jdf-unroll M (+ at 21) end n))))
(defn- jdf-false [M :vector-i64 at :i64 end :i64] :bool
 (and (> at 0) (<= at (- end 6))
  (jdf-at M at end (enc-sub-r 10 10 6))
  (jdf-at M (inc at) end (enc-sub-r 8 8 10))
  (jdf-at M (+ at 2) end (enc-str 8 7 CTX-FUEL))
  (jdf-at M (+ at 3) end (enc-movz 9 0 0))
  (jdf-at M (+ at 4) end (+ 0x10000000 30))
  (jdf-at M (+ at 5) end (enc-b 0))))
;; D: start,end,paid,scan-head,false-head,exit-label,fail-label,source-owner,
;; exact scanner false hook, scanner end. These are compiler-local proof cells.
;; F[0..511] = unique actual fixup index; F[512] = refusal.
(defn- jdf-fixes [M :vector-i64 D :vector-i64] :vector-i64
 (loop [F (vector-alloc 513) k 1]
  (if (>= k (vector-at M MM-FIX-N)) F
   (let [at (sf-x M k XF-AT) start (vector-at D 0) end (vector-at D 1)]
    (if (or (<= at 0) (>= at (vector-at M MM-CODE-N))) (vector-assoc! F 512 1)
     (if (and (>= at start) (< at end))
      (let [r (- at start)]
       (if (> (vector-at F r) 0) (vector-assoc! F 512 1)
        (recur (vector-assoc! F r k) (inc k)))) (recur F (inc k))))))))
(defn- jdf-label [M :vector-i64 D :vector-i64 label :i64] :i64
 (if (or (<= label 0) (>= label (vector-at M MM-LABEL-N))) -1
  (let [sir (gn-lpos M label) owner (vector-at D 7) end (vector-at D 1)]
   (if (or (<= sir owner) (>= sir (+ owner 346))
     (not (gn-dot-at? M sir OP-LABEL label 0 0))) -1
    (cond (= label (vector-at D 6))
      (if (= (vector-at M (+ MM-LABEL-BASE label)) end) end -1)
     (= label (vector-at D 5)) (inc end)
     :else (let [at (vector-at M (+ MM-LABEL-BASE label))]
      (if (and (>= at (vector-at D 0)) (< at end)) at -1)))))))
(defn- jdf-adr [M :vector-i64 D :vector-i64 F :vector-i64 label :i64] :bool
 (if (or (<= label 0) (>= label (vector-at M MM-LABEL-N))) false
  (let [ret (vector-at M (+ MM-LABEL-BASE label)) start (vector-at D 0) end (vector-at D 1)]
   (if (or (<= ret start) (>= ret end)) false
    (let [fix (vector-at F (- (dec ret) start)) owner (vector-at D 7)]
     (and (> fix 0) (= (sf-x M fix XF-KIND) FX-BL26) (= (sf-x M fix XF-AUX) 0)
      (= (sf-word M (dec ret)) 0x94000000)
      (or (= (sf-x M fix XF-TARGET) (gn-sir M (+ owner 7) IF-A))
          (= (sf-x M fix XF-TARGET) (gn-sir M (+ owner 25) IF-A)))))))))
;; -1 refusal, 0 nonbranch, positive direct target. BL/indirect never traversed.
(defn- jdf-target [M :vector-i64 D :vector-i64 F :vector-i64 at :i64] :i64
 (let [w (sf-word M at) fix (vector-at F (- at (vector-at D 0))) b (of-branch w)]
  (if (> fix 0)
   (let [kind (sf-x M fix XF-KIND) target (sf-x M fix XF-TARGET) aux (sf-x M fix XF-AUX)]
    (if (not= aux 0) -1
     (cond (and (= kind FX-B26) (= (bit-and w 0xfc000000) 0x14000000)
                (= (bit-and w 0x03ffffff) 0)) (jdf-label M D target)
      (and (= kind FX-BC19) (= (bit-and w 0xff000010) 0x54000000)
           (= (bit-and w 0x00ffffe0) 0)) (jdf-label M D target)
      (and (= kind FX-CB19) (= (bit-and w 0x7e000000) 0x34000000)
           (= (bit-and w 0x00ffffe0) 0)) (jdf-label M D target)
      (and (= kind FX-ADRL19) (= w (+ 0x10000000 30))
           (jdf-adr M D F target)) 0
      :else -1)))
   (cond (= (bit-and w 0xfc000000) 0x94000000) -1
    (or (= b 26) (= b 19)) (let [to (of-dest w at)] (if (= to at) -1 to))
    (= b 14) -1 :else 0))))
(defn- jdf-ordinary [w :i64] :bool
 (or (= (bit-and w 0x1f000000) 0x11000000)
  (= (bit-and w 0x1f000000) 0x0b000000)
  (= (bit-and w 0x1f000000) 0x1b000000)
  (= (bit-and w 0x1f800000) 0x13000000)
  (= (bit-and w 0x1f000000) 0x0a000000)
  (= (bit-and w 0x1f800000) 0x12800000)
  (= (bit-and w 0x1fe00000) 0x1a800000)
  (= (bit-and w 0x3b200c00) 0x38200800)
  (= (bit-and w 0x3b000000) 0x39000000)
  (= (bit-and w 0x3a000000) 0x28000000)))
;; V[0..511] visited; V[512..1023] queue; 1024 head,1025 tail,1026 bad,1027 goal.
(defn- jdf-edge [D :vector-i64 V :vector-i64 p :i64 q :i64] :vector-i64
 (let [start (vector-at D 0) end (vector-at D 1) paid (vector-at D 2)
       head (vector-at D 3) f (vector-at D 4)
       hook (vector-at D 8) scan-end (vector-at D 9)]
  (cond (= q (inc end)) V
   (= q end) (if (= p (+ f 5)) (vector-assoc! V 1027 1) (vector-assoc! V 1026 1))
   (or (< q start) (>= q end)) (vector-assoc! V 1026 1)
   (and (< q head) (not= q (inc p))
        (not (and (= p (+ paid 2)) (= q (+ paid 4))))) (vector-assoc! V 1026 1)
   (and (= q head) (not (or (= p (dec head))
        (and (= scan-end (+ head 5)) (= p (+ head 4)))))) (vector-assoc! V 1026 1)
   (and (> q head) (< q scan-end) (not= p (dec q))
        (not (and (= q hook) (> hook (+ head 1))
          (>= p (inc head)) (< p (dec hook)) (= (bit-and (- p head) 3) 1)))) (vector-assoc! V 1026 1)
   (and (= q f) (not= p hook)) (vector-assoc! V 1026 1)
   (and (> q f) (< q (+ f 6)) (not= p (dec q))) (vector-assoc! V 1026 1)
   :else (let [r (- q start) tail (vector-at V 1025)]
    (if (> (vector-at V r) 0) V
     (if (>= tail 512) (vector-assoc! V 1026 1)
      (-> V (vector-assoc! r 1) (vector-assoc! (+ 512 tail) q) (vector-assoc! 1025 (inc tail)))))))))
;; Source-owned DC terminal, never a general RET allowance.
(defn- jdf-dcr-terminal [M :vector-i64 D :vector-i64 F :vector-i64 at :i64] :bool
 (let [start (vector-at D 0) end (vector-at D 1) owner (vector-at D 7)
       false-at (vector-at D 8)]
  (if (or (< at (+ start 15)) (> at (- end 6)) (> (- at start) 512)) false
   (let [f (gn-sir M owner IF-A) adr-fix (vector-at F (- (dec at) start))]
    (and (> f 0) (< f (vector-at M MM-FN-N))
     (= start (gn-fnf M f FF-CODE)) (> (clw-witness M f false) 0)
     (= (gn-g M gn-f-fb) 464) (= (gn-g M gn-f-out) 0)
     (= (gn-g M gn-f-nsv) 10) (= (gn-g M gn-f-ctx) 1)
     (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-leaf) 0)
     (dcr-prologue M start at)
     (jdf-at M (- at 2) end (enc-mov-r 9 (gn-sreg M 1)))
     (jdf-at M (dec at) end (+ 0x10000000 30))
     (> adr-fix 0) (= (sf-x M adr-fix XF-KIND) FX-ADRL19)
     (= (sf-x M adr-fix XF-AUX) 0)
     (jdf-adr M D F (sf-x M adr-fix XF-TARGET))
     (let [ret (vector-at M (+ MM-LABEL-BASE (sf-x M adr-fix XF-TARGET)))
           call-fix (vector-at F (- (dec ret) start))]
      (and (> call-fix 0)
       (= (sf-x M call-fix XF-TARGET) (gn-sir M (+ owner 25) IF-A))))
     (jdf-at M at end (enc-mov-r 0 9))
     (jdf-at M (+ at 1) end (enc-ldp 19 20 31 0))
     (jdf-at M (+ at 2) end (enc-ldp 21 22 31 16))
     (jdf-at M (+ at 3) end (enc-mov-sp 31 29))
     (jdf-at M (+ at 4) end (enc-ldp-post 29 30 31 16))
     (jdf-at M (+ at 5) end (enc-ret))
     (loop [k 0] (or (= k 6)
      (and (= (vector-at F (- (+ at k) start)) 0) (recur (inc k)))))
     ;; Replay the original DCR prefix proof at this later emission phase.
     ;; Only the now-patched exact scanner false branch differs from its placeholder.
     (loop [p (+ start 13)] (or (= p (- at 2))
      (and (if (= p false-at)
       (and (= (bit-and (sf-word M p) 0xff00001f) 0xb5000009)
            (= (jdf-target M D F p) (vector-at D 4)))
       (dcr-word M p (+ start 13) (- at 2) -1))
       (recur (inc p))))))))))
(defn- jdf-walk [M :vector-i64 D :vector-i64 F :vector-i64] :bool
 (let [seed (-> (vector-alloc 1028) (vector-assoc! 0 1)
               (vector-assoc! 512 (vector-at D 0)) (vector-assoc! 1025 1))]
  (loop [V seed]
   (cond (not= (vector-at V 1026) 0) false
    (= (vector-at V 1024) (vector-at V 1025)) (= (vector-at V 1027) 1)
    :else (let [head (vector-at V 1024) p (vector-at V (+ 512 head)) w (sf-word M p)
      target (jdf-target M D F p) next (vector-assoc! V 1024 (inc head))
      b (of-branch w) terminal (= (bit-and w 0xffe0001f) 0xd4200000)]
     (cond (< target 0) false
      (or terminal (jdf-dcr-terminal M D F p)) (recur next)
      (> target 0) (let [taken (jdf-edge D next p target)]
       (recur (if (= b 26) taken (jdf-edge D taken p (inc p)))))
      (or (jdf-ordinary w)
          (and (= w (+ 0x10000000 30)) (> (vector-at F (- p (vector-at D 0))) 0)))
       (recur (jdf-edge D next p (inc p)))
      :else false))))))
;; The existing closed jssa-body allocator forbids initial scratch as value banks.
;; Each quotient defines x17 before its read; clamp defines x16/x17 before CSEL.
(defn- jdf-body [M :vector-i64 C :vector-i64 i :i64 end :i64] :bool
 (and (>= (vector-count C) 16) (> (vector-at C 2) 0) (<= (vector-at C 2) 256)
  (> (vector-at C 10) 0) (> (vector-at C 11) 0)
  (<= (+ (vector-at C 10) 257) (vector-count C))
  (<= (+ (vector-at C 11) 257) (vector-count C))
  (loop [v 1] (or (> v (vector-at C 2))
   (let [parent (vector-at C (+ (vector-at C 10) v))]
    (and (> parent 0) (<= parent v) (recur (inc v))))))
  (loop [v 1] (or (> v (vector-at C 2))
   (let [r (jssa-reg C v)] (and (>= r 0) (< r 31) (not= r 16) (not= r 17) (recur (inc v))))))
  (loop [j i] (or (= j end)
   (let [op (gn-op M j)]
    (and (if (= op OP-CALL) (let [kind (jdag-call M j)] (and (> kind 0) (<= kind 4)))
      (or (= op OP-LABEL) (= op OP-LGET) (= op OP-LSET) (= op OP-CONST)
       (= op OP-BIN) (= op OP-RT) (= op OP-BR) (= op OP-BRZ))) (recur (inc j))))))))
(defn- jdf-admit [M :vector-i64 i :i64 end :i64 C :vector-i64] :bool
 (if (or (not (jdf-counts M)) (<= i 0) (>= i (vector-at M MM-SIR-N))
         (<= end i) (>= end (vector-at M MM-SIR-N))) false
  (let [owner (jdag-owner M i 512) f (if (> owner 0) (gn-sir M owner IF-A) 0)]
   (if (or (<= owner 0) (<= f 0) (>= f (vector-at M MM-FN-N))
    (not= i (+ owner 27)) (not= end (+ owner 343))) false
    (let [start (gn-fnf M f FF-CODE) finish (vector-at M MM-CODE-N)
      label (gn-sir M i IF-A) exit (gn-sir M end IF-A)]
     (if (or (<= start 0) (>= start finish) (> (- finish start) 512)
      (<= label 0) (>= label (vector-at M MM-LABEL-N))
      (not= (vector-at M (+ MM-LABEL-BASE label)) finish)
      (not (loop [k 1] (or (= k 5)
       (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28) (recur (inc k))))))) false
      (let [paid (jdf-find M start finish) scan (gn-sir M (+ owner 7) IF-A)
        n (scfill-scan M scan)]
       (if (or (<= paid 0) (not (jdf-scan M paid finish n))) false
        (let [head (+ paid 21) hook (jdf-scan-hook M paid n)
              scan-end (if (= hook (inc head)) (+ head 5) (inc hook))
              false-head (of-dest (sf-word M hook) hook)]
         (if (not (jdf-false M false-head finish)) false
          (let [D (-> (vector-alloc 10) (vector-assoc! 0 start) (vector-assoc! 1 finish)
            (vector-assoc! 2 paid) (vector-assoc! 3 head) (vector-assoc! 4 false-head)
            (vector-assoc! 5 exit) (vector-assoc! 6 label) (vector-assoc! 7 owner)
            (vector-assoc! 8 hook) (vector-assoc! 9 scan-end))
            F (jdf-fixes M D)]
           (and (= (vector-at F 512) 0) (jdf-body M C i end) (jdf-walk M D F))))))))))))
 )
(defn- jdf-prefix [M :vector-i64 base :i64] :vector-i64
 (gn-emit M (+ 0xcb000000 (i64-shift-left base 16) (i64-shift-left 3 10) (i64-shift-left 4 5) 4)))

(defn- jwi-entry [M :vector-i64 i :i64 end :i64 ns :i64 C :vector-i64] :vector-i64
 (let [rv (gn-sreg M 1) pos (vector-alloc (inc (- end i)))
       prefix (if (jdf-admit M i end C) (jdf-prefix M (gn-sreg M 2))
        (-> M (gn-emit (enc-ldr 8 7 CTX-FUEL))
         (gn-emit (enc-ldr 16 7 320)) (gn-emit (enc-sub-i 17 rv 1))
         (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldr 17 16 0))
         (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))))
       fast (jdag-patch-body (jssa-body prefix i end ns C pos true) i end pos)]
  (-> fast (gn-mov 9 (jssa-reg C (vector-at C (jssa-env C (dec (- end i)) (inc ns)))))
   (gn-fix FX-B26 (gn-sir M end IF-A)) (gn-emit (enc-b 0)))))

(defn- jssa-entry [M :vector-i64 i :i64] :vector-i64
 (let [end (jdag-admit M i)]
  (if (= end 0) M (let [ns (gn-g M gn-f-ns) dp (gn-g M gn-f-dp) recipe (jdag-scan M i end ns dp)]
   (if (= (vector-at recipe 0) 0) M (let [C (jssa-plan M i end ns dp)]
    (if (or (= (vector-count C) 1) (not= (vector-at C (jssa-mask C 5 0)) 15)
      (loop [w 1] (and (< w 4) (or (not= (vector-at C (+ (jssa-mask C 5 0) w)) 0) (recur (inc w)))))) (jdag-entry M i)
     (if (jwi-admit M i end recipe) (jwi-entry M i end ns C)
     (let [rv (gn-sreg M 1) base (gn-sreg M 2) stride (gn-sreg M 3) columns (gn-sreg M 4)
       max (vector-at recipe 1) rowcost (+ (vector-at recipe 2) (* 2 (vector-at recipe 3)))
       colcost (+ rowcost (* 2 (vector-at recipe 4))) pos (vector-alloc (inc (- end i)))
       m0 (-> M (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov-imm 16 rowcost) (gn-mov-imm 17 colcost)
        (gn-emit (enc-cmp-i columns 0)) (gn-emit (enc-csel 16 16 17 (enc-cond-eq))) (gn-emit (enc-cmp-r 8 16))) g0 (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312))
        (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) g1 (vector-at m1 MM-CODE-N)
       m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
        (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 3 16 0))
        (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 3 16))) g2 (vector-at m2 MM-CODE-N)
       m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 17 16))) g3 (vector-at m3 MM-CODE-N)
       m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r base 3))) g4 (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 18014398509481984)
        (gn-emit (enc-cmp-r stride 16))) g5 (vector-at m5 MM-CODE-N)
       m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 max)
        (gn-emit (enc-mul 16 stride 16)) (gn-emit (enc-add-r 16 base 16)) (gn-emit (enc-cmp-r 16 3))) g6 (vector-at m6 MM-CODE-N)
       m7 (-> m6 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3)))
       fast (jdag-patch-body (jssa-body m7 i end ns C pos false) i end pos)
       m8 (-> fast (gn-mov 9 (jssa-reg C (vector-at C (jssa-env C (dec (- end i)) (inc ns))))) (gn-fix FX-B26 (gn-sir M end IF-A)) (gn-emit (enc-b 0)))
       cold (vector-at m8 MM-CODE-N)]
      (-> m8 (gn-dot-patch g0 cold (enc-cond-lo)) (gn-dot-patch g1 cold (enc-cond-hs))
       (gn-dot-patch g2 cold (enc-cond-hs)) (gn-dot-patch g3 cold (enc-cond-hs))
       (gn-dot-patch g4 cold (enc-cond-hs)) (gn-dot-patch g5 cold (enc-cond-hs)) (gn-dot-patch g6 cold (enc-cond-hs))))))))))

))

;; ADR0357 new bounded recurrence/state-updater composition; source-only pending proof review.
(defn- brc-template0 [k :i64] :i64 (vector-at [1 -100 4 8 18 0 0 0 9 -1002 0 0 4 0 3 0 3 1 -201 0 7 1 0 0 11 0 -1012 0 4 0 1 0 3 1 -202 0 3 2 0 0 13 -101 0 3 10 -1092 0 0 9 -1012 0 0 3 0 -203 0 4 1 2 0 3 2 -204 0] k))
(defn- brc-template1 [k :i64] :i64 (vector-at [6 3 1 0 6 1 0 0 5 5 0 0 4 0 1 0 4 1 5 0 3 2 -205 0 6 1 1 0 4 2 3 0 6 1 1 0 14 176 0 2 5 6 0 0 4 0 4 0 4 1 6 0 7 4 0 0 11 0 -1035 0 4 0 6 0] k))
(defn- brc-template2 [k :i64] :i64 (vector-at [3 1 -206 0 7 1 0 0 8 1 0 0 9 -1035 0 0 11 0 -1065 0 4 0 1 0 4 1 5 0 3 2 -207 0 6 1 1 0 4 2 3 0 6 1 1 0 14 176 0 2 4 1 4 0 4 2 1 0 4 3 5 0 4 4 3 0] k))
(defn- brc-template3 [k :i64] :i64 (vector-at [6 1 3 0 14 176 2 2 6 2 1 0 6 1 0 0 3 1 255 0 6 5 0 0 5 7 0 0 4 0 1 0 3 1 -202 0 4 2 1 0 4 3 2 0 13 -102 3 1 4 4 7 0 6 1 3 0 14 176 2 2 13 -101 0 3] k))
(defn- brc-template4 [k :i64] :i64 (vector-at [10 -1091 0 0 9 -1065 0 0 4 0 1 0 13 -103 0 1 5 7 0 0 4 0 4 0 3 1 -208 0 6 3 0 0 3 1 -209 0 6 5 0 0 4 1 7 0 3 2 -202 0 14 176 1 2 6 6 0 0 5 8 0 0 4 0 7 0] k))
(defn- brc-template5 [k :i64] :i64 (vector-at [4 1 2 0 4 2 3 0 3 3 1 0 6 1 2 0 4 3 8 0 5 1 0 0 5 2 1 0 5 3 2 0 5 4 3 0 18 0 0 0 10 -1002 0 0 9 -1091 0 0 9 -1092 0 0 19 0 0 0 2 -100 0 0] k))
(defn- brc-template [k :i64] :i64 (case (quot k 64) 0 (brc-template0 (bit-and k 63)) 1 (brc-template1 (bit-and k 63)) 2 (brc-template2 (bit-and k 63)) 3 (brc-template3 (bit-and k 63)) 4 (brc-template4 (bit-and k 63)) 5 (brc-template5 (bit-and k 63)) -9999))
;; ADR0357: novel bounded source-owned recurrence composition, not a mechanical rule.
(defn- brc-safe [M :vector-i64 f :i64 n :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (< f MM-FN-CAP)
  (clw-safe M f n) (tbat-labels M (gn-fnf M f FF-SIR) n 0)))
(defn- brc-target [M :vector-i64 p :i64 j :i64] :i64
 (let [f (gn-sir M (+ p j) IF-A)] (if (< f 0) 0 f)))
(defn- brc-helper [M :vector-i64 f :i64] :i64
 (if (not (brc-safe M f 68)) 0
  (let [p (gn-fnf M f FF-SIR) a (gn-sir M (+ p 4) IF-B) b (gn-sir M (+ p 19) IF-B)
   c (gn-sir M (+ p 63) IF-B) mask (gn-sir M (+ p 6) IF-B) delta (gn-sir M (+ p 51) IF-B)
   scale (gn-sir M (+ p 58) IF-B) small (brc-target M p 53) wide (brc-target M p 60)
   put (brc-target M p 65) unknown (brc-target M p 26)]
   (if (and (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-NSLOTS) 4)
    (= (gn-fnf M f FF-DEPTH) 5) (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-PT0) TY-VEC)
    (>= a 0) (<= a 4095) (>= b 0) (<= b 4095) (>= c 0) (<= c 4095)
    (not= a b) (not= a c) (not= b c) (not= mask 0) (= delta 1)
    (> scale 0) (<= scale 4095)
    (brc-safe M put 9) (brc-safe M small 11) (brc-safe M wide 11)
    (= (gn-fnf M put FF-FUEL) 1) (= (gn-fnf M small FF-FUEL) 1) (= (gn-fnf M wide FF-FUEL) 1)
    (ss-put M put) (> (ss-mask M small put) 0) (> (ss-mask M wide put) 0)
    (ss-shape M p f a b c mask delta scale small wide put unknown)) p 0))))
(defn- brc-field [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [j (quot k 4) col (bit-and k 3) token (brc-template k) value (gn-sir M (+ p j) col)]
  (cond (= token -100) (= value f)
   (= token -101) (= value (gn-sir M (+ p 10) IF-A))
   (= token -102) (= value (gn-sir M (+ p 59) IF-A))
   (= token -103) (= value (gn-sir M (+ p 67) IF-A))
   (= token -201) (= value (gn-sir M (+ p 4) IF-B))
   (= token -202) (= value (gn-sir M (+ p 8) IF-B))
   (= token -203) (= value (gn-sir M (+ p 13) IF-B))
   (= token -204) (= value (gn-sir M (+ p 15) IF-B))
   (= token -205) (= value (gn-sir M (+ p 21) IF-B))
   (= token -206) (= value (gn-sir M (+ p 32) IF-B))
   (= token -207) (= value (gn-sir M (+ p 39) IF-B))
   (= token -208) (= value (gn-sir M (+ p 70) IF-B))
   (= token -209) (= value (gn-sir M (+ p 72) IF-B))
   (and (<= token -1000) (> token -2000))
    (= value (gn-sir M (+ p (- (- token) 1000)) IF-A))
   :else (= token value))))
(defn- brc-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (or (= k 380) (and (brc-field M p f k) (brc-shape M p f (inc k)))))
(defn- brc-frame [M :vector-i64 f :i64] :bool
 (let [at (gn-fnf M f FF-CODE) cn (vector-at M MM-CODE-N)]
  (and (> at 0) (<= at (- cn 12))
   (= (sf-word M at) (enc-stp-pre 29 30 31 -16))
   (= (sf-word M (+ at 1)) (enc-mov-sp 29 31))
   (= (sf-word M (+ at 2)) (enc-sub-i 31 31 192))
   (loop [k 0] (or (= k 4) (and (= (sf-word M (+ at 3 k)) (enc-stp (+ 19 (* k 2)) (+ 20 (* k 2)) 31 (* k 16))) (recur (inc k)))))
   (= (sf-word M (+ at 7)) (enc-str 7 31 184))
   (= (sf-word M (+ at 8)) (enc-mov-r 19 0)) (= (sf-word M (+ at 9)) (enc-mov-r 22 1))
   (= (sf-word M (+ at 10)) (enc-mov-r 20 2)) (= (sf-word M (+ at 11)) (enc-mov-r 23 3)))))
(defn- brc-admit [M :vector-i64 i :i64] :i64
 (if (or (not (frfix-counts M)) (<= i 2) (>= i (vector-at M MM-SIR-N))
  (not= (gn-op M (- i 2)) OP-FN) (not= (gn-op M i) OP-LABEL)) 0
  (let [p (- i 2) f (gn-sir M p IF-A)]
   (if (not (brc-safe M f 95)) 0
    (let [bound (gn-sir M (+ p 4) IF-B) base (gn-sir M (+ p 13) IF-B)
     stride (gn-sir M (+ p 15) IF-B) offset (gn-sir M (+ p 21) IF-B)
     helper (brc-helper M (brc-target M p 67)) small (brc-target M p 10)]
     (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 4)
      (= (gn-fnf M f FF-NSLOTS) 8) (= (gn-fnf M f FF-DEPTH) 5)
      (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-FUEL) 1)
      (= (gn-fnf M f FF-PT0) TY-VEC)
      (loop [k 1] (or (= k 4) (and (= (gn-fnf M f (+ FF-PT0 k)) TY-I64) (recur (inc k)))))
      (or (= (gn-g M gn-f-ctx) 0) (= (gn-g M gn-f-ctx) 1)) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
      (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
      (= (gn-g M gn-f-ns) 8) (= (gn-g M gn-f-dp) 5) (= (gn-g M gn-f-nsv) 8)
      (= (gn-g M gn-f-fb) 192) (= (gn-g M gn-f-out) 0)
      (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
      (= (gn-sreg M 1) 19) (= (gn-sreg M 2) 22) (= (gn-sreg M 3) 20) (= (gn-sreg M 4) 23)
      (= (gn-sreg M 5) 24) (= (gn-sreg M 6) 25) (= (gn-sreg M 7) 21) (= (gn-sreg M 8) 26)
      (> bound 0) (<= bound 32) (>= base 0) (<= base 4095)
      (> stride 0) (<= stride 4095) (>= offset 0) (<= (+ base offset bound) 4095)
      (> helper 0) (brc-safe M small 11)
      (= (ss-mask M small (brc-target M helper 65)) (ss-mask M (brc-target M helper 53) (brc-target M helper 65)))
      (= (gn-sir M (+ p 8) IF-B) (gn-sir M (+ helper 63) IF-B))
      (brc-shape M p f 0) (brc-frame M f)) p 0))))))
;; Dynamic guard log: each record is appended once and patched once.
(defn- brc-disjoint [M :vector-i64 G :vector-i64] :vector-i64
 (-> M (gn-emit (enc-cmp-r 3 12)) (gn-emit (enc-bcond (enc-cond-hs) 3))
  (gn-emit (enc-cmp-r 11 10)) (xd-cold G (enc-cond-lo))))
(defn- brc-alias [M :vector-i64 G :vector-i64] :vector-i64
 ;; Full issued heap; live caller plus skipped 144-byte helper frame.
 (-> M (gn-emit (enc-mov-sp 14 31)) (gn-emit (enc-cmp-i 14 144)) (xd-cold G (enc-cond-lo))
  (gn-emit (enc-sub-i 14 14 144))
  (gn-mov-imm 17 -16) (gn-emit (enc-cmp-r 29 17)) (xd-cold G (enc-cond-hs))
  (gn-emit (enc-add-i 15 29 16)) (gn-emit (enc-cmp-r 14 15)) (xd-cold G (enc-cond-hs))
  (gn-emit (enc-ldr 3 7 328)) (gn-mov-imm 17 -1073741824)
  (gn-emit (enc-cmp-r 3 17)) (xd-cold G (enc-cond-hs))
  (gn-mov-imm 17 1073741824) (gn-emit (enc-add-r 10 3 17))
  (gn-mov 11 7) (gn-mov-imm 17 -400) (gn-emit (enc-cmp-r 11 17)) (xd-cold G (enc-cond-hs))
  (gn-emit (enc-add-i 12 11 400)) (brc-disjoint G)
  (gn-emit (enc-ldr 11 7 312)) (gn-mov-imm 17 -8) (gn-emit (enc-cmp-r 11 17)) (xd-cold G (enc-cond-hs))
  (gn-emit (enc-add-i 12 11 8)) (brc-disjoint G)
  (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 12 31 13 4)) (gn-emit (enc-add-r 12 11 12)) (brc-disjoint G)
  (gn-mov 11 14) (gn-mov 12 15) (brc-disjoint G)
  (gn-mov 3 14) (gn-mov 10 15)
  (gn-mov 11 7) (gn-emit (enc-add-i 12 11 400)) (brc-disjoint G)
  (gn-emit (enc-ldr 11 7 312)) (gn-emit (enc-add-i 12 11 8)) (brc-disjoint G)
  (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 12 31 13 4)) (gn-emit (enc-add-r 12 11 12)) (brc-disjoint G)
  (gn-mov 3 7) (gn-emit (enc-add-i 10 3 400))
  (gn-emit (enc-ldr 11 7 312)) (gn-emit (enc-add-i 12 11 8)) (brc-disjoint G)
  (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 12 31 13 4)) (gn-emit (enc-add-r 12 11 12)) (brc-disjoint G)))
(defn- brc-state-disjoint [M :vector-i64 G :vector-i64 cell :i64] :vector-i64
 ;; Current maximum-plane indices [x10,x11), scalar cell constant.
 (-> M (gn-mov-imm 16 cell) (gn-emit (enc-cmp-r 16 10)) (gn-emit (enc-bcond (enc-cond-lo) 3))
  (gn-emit (enc-cmp-r 16 11)) (xd-cold G (enc-cond-lo))))
(defn- brc-predicate [M :vector-i64 p :i64 sentinel :i64] :vector-i64
 (let [m (gn-emit M (enc-cmp-r 23 25)) at (vector-at m MM-CODE-N)
  n (-> m (gn-emit (enc-bcond (enc-cond-gt) 0)) (gn-mov-imm 16 sentinel)
   (gn-emit (enc-cmp-r 25 16)) (gn-fix FX-BC19 (gn-sir M (+ p 12) IF-A))
   (gn-emit (enc-bcond (enc-cond-ne) 0)))]
  (gn-dot-patch n at (vector-at n MM-CODE-N) (enc-cond-gt))))
;; ADR0357: private bounded success charge; induction proves borrow impossible.
(defn- brc-proved-charge [M :vector-i64] :vector-i64
 (gn-emit M (enc-subs-i 8 8 1)))
(defn- brc-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (brc-admit M i)]
  (if (= p 0) M
   (let [hp (brc-helper M (brc-target M p 67)) a (gn-sir M (+ hp 4) IF-B)
    b (gn-sir M (+ hp 19) IF-B) c (gn-sir M (+ hp 63) IF-B)
    mask (gn-sir M (+ hp 6) IF-B) scale (gn-sir M (+ hp 58) IF-B)
    put (brc-target M hp 65) sw (ss-mask M (brc-target M hp 53) put)
    ww (ss-mask M (brc-target M hp 60) put) bound (gn-sir M (+ p 4) IF-B)
    base (gn-sir M (+ p 13) IF-B) stride (gn-sir M (+ p 15) IF-B) offset (gn-sir M (+ p 21) IF-B)
    sentinel (gn-sir M (+ p 32) IF-B) codescale (gn-sir M (+ p 70) IF-B) codemask (gn-sir M (+ p 72) IF-B)
    G (vector-alloc 129) E (vector-alloc 9) ln (vector-at M MM-LABEL-N)
    m0 (-> M (gn-put MM-LABEL-N (+ ln 2))
     (gn-emit (enc-cmp-i 20 bound)) (xd-cold G (enc-cond-hs))
     ;; Same physical home load as gn-ctx, without changing GN/cache facts.
     (cond-> (= (gn-g M gn-f-ctx) 0) (gn-ld 7 0))
     (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 0)) (xd-cold G (enc-cond-lt))
     (gn-mov-imm 16 bound) (gn-emit (enc-sub-r 16 16 20)) (gn-mov-imm 17 7)
     (gn-emit (enc-mul 16 16 17)) (gn-emit (enc-cmp-r 8 16)) (xd-cold G (enc-cond-lo))
     (gn-mov-imm 17 (inc (quot (- 4095 base offset bound) stride)))
     (gn-emit (enc-cmp-r 22 17)) (xd-cold G (enc-cond-hs))
     (gn-mov-imm 10 stride) (gn-emit (enc-mul 10 22 10)) (gn-mov-imm 11 (+ base offset))
     (gn-emit (enc-add-r 10 10 11)) (gn-emit (enc-add-i 11 10 bound))
     (brc-state-disjoint G a) (brc-state-disjoint G b) (brc-state-disjoint G c)
     (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 13 16 0))
     (gn-mov-imm 17 4194305) (gn-emit (enc-cmp-r 13 17)) (xd-cold G (enc-cond-hs))
     (gn-emit (enc-sub-i 9 19 1)) (gn-emit (enc-cmp-r 9 13)) (xd-cold G (enc-cond-hs))
     (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 12 31 13 4))
     (gn-emit (enc-sub-r 17 31 12)) (gn-emit (enc-cmp-r 11 17)) (xd-cold G (enc-cond-hs))
     (gn-emit (gn-e-addsl 16 11 9 4)) (gn-emit (enc-ldp 5 6 16 0))
     (gn-mov-imm 17 134217728) (gn-emit (enc-cmp-r 5 17)) (xd-cold G (enc-cond-hs))
     (gn-emit (enc-sub-r 16 17 5)) (gn-emit (enc-cmp-r 6 16)) (xd-cold G 8)
     (gn-mov-imm 16 (inc (gn-max a (gn-max b c)))) (gn-emit (enc-cmp-r 16 6)) (xd-cold G 8)
     ;; Need whole maximum plane through bound, not only the current cell.
     (gn-mov-imm 16 stride) (gn-emit (enc-mul 16 22 16)) (gn-mov-imm 17 (+ base offset bound))
     (gn-emit (enc-add-r 16 16 17)) (gn-emit (enc-cmp-r 16 6)) (xd-cold G 8)
     (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 5 3))
     (brc-alias G)
     (gn-emit (enc-ldr 5 4 (* a 8))) (gn-emit (enc-ldr 6 4 (* b 8)))
     (gn-emit (enc-cmp-i 6 0)) (xd-cold G (enc-cond-eq))
     (gn-mov-imm 17 (i64-shift-left 1 sw)) (gn-emit (enc-cmp-r 6 17)) (xd-cold G (enc-cond-hs)))
    head (vector-at m0 MM-CODE-N)
    m1 (-> m0 (gn-put (+ MM-LABEL-BASE ln) head)
     (gn-emit (enc-cmp-i 20 bound)) (xd-cold E (enc-cond-hs))
     (gn-mov-imm 16 stride) (gn-emit (enc-mul 24 22 16)) (gn-mov-imm 16 base)
     (gn-emit (enc-add-r 24 24 16)) (gn-mov-imm 16 offset)
     (gn-emit (enc-add-r 16 24 16)) (gn-emit (enc-add-r 16 16 20))
     (gn-emit (gn-e-ldrr 25 4 16 1))
     (brc-predicate p sentinel)
     (gn-emit (enc-cmp-i 6 0)) (gn-fix FX-BC19 (gn-sir M (+ p 65) IF-A)) (gn-emit (enc-bcond (enc-cond-eq) 0))
     ;; Exact helper entry transaction, then B/A/C transactions.
     (brc-proved-charge) (gn-emit (enc-str 8 7 CTX-FUEL))
     (gn-mov-imm 16 mask) (gn-emit (enc-and-r 9 5 16))
     (gn-emit (enc-cmp-i 9 0)) (gn-emit (enc-cset 9 (enc-cond-ne)))
     (brc-proved-charge) (gn-emit (enc-sub-i 6 6 1))
     (gn-emit (gn-e-bf 0xd3400000 6 6 0 (dec sw)))
     (brc-proved-charge) (gn-emit (enc-str 6 4 (* b 8))) (gn-emit (enc-str 8 7 CTX-FUEL))
     (gn-mov-imm 16 scale) (gn-emit (enc-mul 5 5 16))
     (brc-proved-charge) (gn-emit (gn-e-bf 0xd3400000 5 5 0 (dec ww)))
     (brc-proved-charge) (gn-emit (enc-str 5 4 (* a 8))) (gn-emit (enc-str 8 7 CTX-FUEL))
     (brc-proved-charge) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-str 9 4 (* c 8)))
     (gn-mov 21 19) (scfill-lr-fix (inc ln) (+ p 67))
     (gn-mov-imm 16 codescale) (gn-emit (enc-mul 26 23 16))
     (gn-mov-imm 16 codemask) (gn-emit (enc-and-r 26 26 16)) (gn-emit (enc-orr-r 26 26 9))
     (gn-mov 19 21) (gn-emit (enc-add-i 20 20 1)) (gn-mov 23 26)
     (brc-proved-charge) (gn-emit (enc-str 8 7 CTX-FUEL))
     (gn-fix FX-B26 ln) (gn-emit (enc-b 0)))
    cold (vector-at m1 MM-CODE-N)]
    (xd-patch (xd-patch m1 G 0 cold) E 0 cold)))))

;; ADR0357 one-off semantic prototype: private tagged paid-reader commoning.
;; No public ABI or public reader change; no product qualification claimed.
(defn- trg-counts [M :vector-i64] :bool
 (and (mdc-counts M) (>= (vector-at M MM-LABEL-N) 1)
  (< (vector-at M MM-LABEL-N) MM-LABEL-CAP)
  (>= (vector-at M MM-EXP-N) 1) (<= (vector-at M MM-EXP-N) MM-EXP-CAP)))
(defn- trg-safe [M :vector-i64 f :i64 n :i64] :bool
 (and (trg-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (<= n (- (vector-at M MM-SIR-N) p))
    (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f)
    (gn-dot-at? M (+ p (dec n)) OP-END f 0 0) (not (gn-clamp-open M f))))))
(defn- trg-owned [M :vector-i64 p :i64 n :i64 l :i64] :bool
 ;; Source-owned unique LABEL + all incoming branch edges, never gn-lpos cache.
 (and (> l 0) (< l (vector-at M MM-LABEL-N)) (< l MM-LABEL-CAP)
  (loop [j 1 seen 0]
   (if (= j (vector-at M MM-SIR-N)) (= seen 1)
    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
          label (and (= op OP-LABEL) (= a l))
          edge (or (and (= op OP-BR) (= a l))
             (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= b l)))
          inside (and (>= j p) (< j (+ p n)))]
     (and (or (not (or label edge)) inside)
      (recur (inc j) (+ seen (if label 1 0)))))))))
(defn- trg-reader [M :vector-i64 f :i64] :bool
 (and (trg-safe M f 17)
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (+ p 2) IF-A)
        le (gn-sir M (+ p 10) IF-A) lx (gn-sir M (+ p 14) IF-A)]
   (and (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
    (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-RTYPE) TY-I64)
    (= (ck-pt M f 0) TY-STR) (= (ck-pt M f 1) TY-I64)
    (not= l le) (not= l lx) (not= le lx)
    (trg-owned M p 17 l) (trg-owned M p 17 le) (trg-owned M p 17 lx)
    (gn-dot-at? M p OP-FN f 2 2) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL l 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 2 0)
    (gn-dot-at? M (+ p 4) OP-LGET 1 1 0) (gn-dot-at? M (+ p 5) OP-RT RT-STRING-LENGTH-VIA 1 1)
    (gn-dot-at? M (+ p 6) OP-CMP CC-EQ 0 0) (gn-dot-at? M (+ p 7) OP-BRZ 0 le 0)
    (gn-dot-at? M (+ p 8) OP-CONST 0 0 0) (gn-dot-at? M (+ p 9) OP-BR lx 0 0)
    (gn-dot-at? M (+ p 10) OP-LABEL le 0 0) (gn-dot-at? M (+ p 11) OP-LGET 0 1 0)
    (gn-dot-at? M (+ p 12) OP-LGET 1 2 0) (gn-dot-at? M (+ p 13) OP-RT RT-STRING-CODE-POINT-AT 0 2)
    (gn-dot-at? M (+ p 14) OP-LABEL lx 0 0) (gn-dot-at? M (+ p 15) OP-RET 0 0 0)))))
(defn- trg-chain [M :vector-i64 f :i64 prepared :bool] :i64
 (if (not (trg-safe M f 23)) 0
  (let [p (gn-fnf M f FF-SIR) h (gn-sir M (+ p 2) IF-A) e (gn-sir M (+ p 20) IF-A)
        first (gn-sir M (+ p 5) IF-A) reader (gn-sir M (+ p 11) IF-A)]
   (if (and (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
    (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-RTYPE) TY-BOOL)
    (= (ck-pt M f 0) TY-STR) (= (ck-pt M f 1) TY-I64)
    (trg-reader M reader) (trg-owned M p 23 h) (trg-owned M p 23 e) (not= h e)
    (if prepared (and (trg-safe M first 17) (= (gn-fnf M first FF-KIND) FK-PRIV)
      (= (gn-fnf M first FF-EXPORT) (- (+ reader MM-FN-CAP)))) (= first reader))
    (gn-dot-at? M p OP-FN f 2 2) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL h 0 0)
    (loop [k 0] (or (= k 3)
     (let [q (+ p 3 (* k 6)) c (gn-sir M (+ q 3) IF-B)]
      (and (gn-dot-at? M q OP-LGET 0 1 0) (gn-dot-at? M (inc q) OP-LGET 1 2 0)
       (gn-dot-at? M (+ q 2) OP-CALL (if (= k 0) first reader) 0 2)
       (>= c 0) (<= c 4095) (gn-dot-at? M (+ q 3) OP-CONST 1 c 0)
       (gn-dot-at? M (+ q 4) OP-CMP CC-EQ 0 0)
       (or (= k 2) (gn-dot-at? M (+ q 5) OP-BRNZ 0 e 0)) (recur (inc k))))))
    (gn-dot-at? M (+ p 20) OP-LABEL e 0 0) (gn-dot-at? M (+ p 21) OP-RET 0 0 0)) reader 0))))
(defn- trg-find [M :vector-i64 f :i64 end :i64] :i64
 (if (>= f end) 0 (if (> (trg-chain M f false) 0) f (trg-find M (inc f) end))))
(defn- trg-copy-ff [M :vector-i64 old :i64 new :i64 p :i64 k :i64] :vector-i64
 (if (= k MM-FN-W) M
  (trg-copy-ff (gn-put M (+ MM-FN-BASE (* new MM-FN-W) k)
   (cond (= k FF-KIND) FK-PRIV (= k FF-EXPORT) (- (+ old MM-FN-CAP))
    (= k FF-SIR) p (= k FF-CODE) 0 :else (gn-fnf M old k))) old new p (inc k))))
(defn- trg-copy-sir [M :vector-i64 old :i64 new :i64 dest :i64 delta :i64 k :i64] :vector-i64
 (if (= k 17) M
  (let [j (+ (gn-fnf M old FF-SIR) k) op (gn-op M j)
        a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
        aa (cond (or (= op OP-FN) (= op OP-END)) new
          (or (= op OP-LABEL) (= op OP-BR)) (+ a delta) :else a)
        bb (if (= op OP-BRZ) (+ b delta) b)]
   (trg-copy-sir (-> M
    (gn-put (+ MM-SIR-BASE (* (+ dest k) MM-SIR-W) IF-OP) op)
    (gn-put (+ MM-SIR-BASE (* (+ dest k) MM-SIR-W) IF-A) aa)
    (gn-put (+ MM-SIR-BASE (* (+ dest k) MM-SIR-W) IF-B) bb)
    (gn-put (+ MM-SIR-BASE (* (+ dest k) MM-SIR-W) IF-C) c)) old new dest delta (inc k)))))
(defn- trg-exports [M :vector-i64 limit :i64] :bool
 (and (trg-counts M)
  (loop [k 1] (or (= k (vector-at M MM-EXP-N))
   (let [f (vector-at M (+ MM-EXP-BASE (* k MM-EXP-W) EF-FN))]
    (and (> f 0) (< f limit) (recur (inc k))))))))
(defn- trg-global [M :vector-i64] :bool
 (and (trg-counts M)
  (loop [j 1] (or (= j (vector-at M MM-SIR-N))
   (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
         label (if (or (= op OP-BRZ) (= op OP-BRNZ)) b a)
         target (if (= op OP-FADDR) b a)
         f (if (< target 0) (- (- target) 5) target)]
    (and (cond (or (= op OP-LABEL) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ))
          (and (> label 0) (< label (vector-at M MM-LABEL-N)) (< label MM-LABEL-CAP))
         (or (= op OP-CALL) (= op OP-FADDR)) (and (> f 0) (< f (vector-at M MM-FN-N)) (< f MM-FN-CAP))
         (or (= op OP-FN) (= op OP-END)) (and (> a 0) (< a (vector-at M MM-FN-N)))
         (= op OP-CALLI) false :else true) (recur (inc j))))))))
(defn- trg-prepare [M :vector-i64] :vector-i64
 (if (not (trg-global M)) M
  (let [fnn (vector-at M MM-FN-N) sn (vector-at M MM-SIR-N) ln (vector-at M MM-LABEL-N)
        cn (vector-at M MM-CODE-N) xn (vector-at M MM-FIX-N)]
   (if (or (not (clw-original M 1 fnn)) (not (trg-exports M fnn)) (> fnn (- MM-FN-CAP 3)) (> sn (- MM-SIR-CAP 406))
     (>= ln (quot MM-LABEL-CAP 6)) (<= cn 0) (> cn (- MM-CODE-CAP 17408))
     (<= xn 0) (> xn (- MM-FIX-CAP 1152))) M
    (let [f (trg-find M 1 fnn)] (if (= f 0) M
     (let [reader (trg-chain M f false) p (gn-fnf M f FF-SIR)
        out (-> M (trg-copy-ff reader fnn sn 0) (trg-copy-sir reader fnn sn ln 0)
          (gn-put (+ MM-SIR-BASE (* (+ p 5) MM-SIR-W) IF-A) fnn)
          (gn-put MM-FN-N (inc fnn)) (gn-put MM-SIR-N (+ sn 17))
          (gn-put MM-LABEL-N (* ln 2)))] out)))))))
(defn- trg-clone [M :vector-i64 f :i64] :i64
 (if (not (trg-safe M f 17)) 0
  (let [x (gn-fnf M f FF-EXPORT) r (- (- x) MM-FN-CAP)]
   (if (and (= (gn-fnf M f FF-KIND) FK-PRIV) (> r 0) (< r f)
     (trg-reader M r) (trg-reader M f) (trg-exports M f)
     (loop [j 1 seen 0]
      (if (= j (vector-at M MM-SIR-N)) (= seen 1)
       (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
             call (and (= op OP-CALL) (= a f))
             root (if (and call (> j 5)) (gn-sir M (- j 5) IF-A) 0)]
        (and (not (and (= op OP-FADDR) (= b f)))
         (or (not call) (and (trg-safe M root 23) (= (gn-fnf M root FF-SIR) (- j 5))
            (= (trg-chain M root true) r)))
         (recur (inc j) (+ seen (if call 1 0)))))))) r 0))))
(defn- trg-se-dispatch [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (if (> (trg-clone M f) 0) (trg-se-entry M i f np) (se-entry M i f np)))
(defn- trg-gp-dispatch [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (if (> (trg-clone M f) 0) M (gp-entry M i f np)))
;; Owned ordinary reader return: strengthen only this internal call contract.
;; Callers require actual emitted restoration before trusting x7 on return.
(defn- scr-source [M :vector-i64 f :i64] :bool
 (and (trg-reader M f) (>= (gn-fnf M f FF-EXPORT) 0)
  (or (= (gn-fnf M f FF-KIND) FK-DEFN) (= (gn-fnf M f FF-KIND) FK-PRIV))
  (= (trg-clone M f) 0)))
(defn- scr-stores [M :vector-i64 at :i64 end :i64 store :i64 seen :i64] :bool
 (if (= at end) (> seen 0)
  (let [w (sf-word M at) ctxstore (= (bit-and w 0xffc003ff) 0xf90003e7)]
   (and (or (not ctxstore) (= w store))
    (scr-stores M (inc at) end store (+ seen (if ctxstore 1 0)))))))
;; Actual already-emitted source-owned bank: no backward/raw exits or hidden
;; callback-before-fast-return path can bypass the new cold restoration.
(defn- scr-native [M :vector-i64 at :i64 lo :i64 hi :i64 load :i64 called :bool] :bool
 (if (= at hi) true
  (let [w (sf-word M at) k (hld-kind w) call (= w (enc-blr 16))
        tb (= (bit-and w 0x7e000000) 0x36000000)
        byte (or (= w (gn-e-ldrb 11 10 1)) (= w (gn-e-ldrb 0 16 2)))
        branch (or (= k 4) (= k 5) (= k 6) tb)
        to (if branch (if tb (if (= (hld-fix M at) 0) (of-dest w at) -2)
                            (hld-target M at)) 0)
        wr (if (> k 0) (hld-write w) 0)]
   (and (or (> k 0) call tb byte) (>= wr 0)
    (or (= (bit-and wr (hld-bit 7)) 0) (= w load))
    (or (not called) (not= w (- load 0x400000)))
    (or (not branch) (and (> to at) (>= to lo) (<= to (- hi 6))))
    (or (not= w (enc-ret)) (not called) (= at (- hi 2)))
    (scr-native M (inc at) lo hi load (or called call))))))
;; No future layout record may patch a saved-context load/store or epilogue.
(defn- scr-fixes [M :vector-i64 lo :i64 hi :i64 k :i64] :bool
 (if (= k (vector-at M MM-FIX-N)) true
  (let [at (sf-x M k XF-AT) kind (sf-x M k XF-KIND)
        span (if (= kind FX-LIT32) 2 1)]
   (and (>= kind FX-B26) (< kind FX-FADDR) (> at 0)
    (<= span (- (vector-at M MM-CODE-N) at))
    (or (>= at hi) (< (+ at (dec span)) lo)
     (and (= (hld-fix M at) k)
      (let [op (hld-kind (sf-word M at))]
       (or (and (= kind FX-B26) (= op 4))
           (and (= kind FX-BC19) (= op 5))
           (and (= kind FX-CB19) (= op 6))))))
    (scr-fixes M lo hi (inc k))))))
(defn- scr-add [R :vector-i64 to :i64 lo :i64 hi :i64 bits :i64] :vector-i64
 (if (or (< to lo) (>= to hi)) R
  (let [ix (- to lo)] (vector-assoc! R ix (bit-or (vector-at R ix) bits)))))
;; scr-native proves all edges forward, so one ordered pass is complete.
;; ENTRY has no savedslot; original-context STR initializes it. Union at merges
;; requires every reaching path to have saved it before any matching ctxLDR.
(defn- scr-saved [M :vector-i64 R :vector-i64 at :i64 lo :i64 hi :i64 load :i64] :bool
 (if (= at hi) true
  (let [bits (vector-at R (- at lo)) w (sf-word M at) k (hld-kind w)
        tb (= (bit-and w 0x7e000000) 0x36000000)
        branch (or (= k 4) (= k 5) (= k 6) tb)
        to (if branch (if tb (of-dest w at) (hld-target M at)) 0)
        nextbits (if (= w (- load 0x400000)) 2 bits)]
   (and (or (= bits 0) (not= w load) (= bits 2))
    (let [A (if (or (= bits 0) (or (= k 2) (= k 3))) R
            (if branch (scr-add R to lo hi nextbits) R))
          B (if (or (= bits 0) (= k 2) (= k 3) (= k 4)) A
             (scr-add A (inc at) lo hi nextbits))]
     (scr-saved M B (inc at) lo hi load))))))
(defn- scr-ready [M :vector-i64 f :i64 n :i64] :bool
 (if (or (not= n 2) (not (scr-source M f))
         (>= f (dec (vector-at M MM-FN-N)))) false
  (let [lo (gn-fnf M f FF-CODE) hi (gn-fnf M (inc f) FF-CODE)]
   (and (> lo 0) (> hi lo) (<= hi (vector-at M MM-CODE-N))
    (>= (- hi lo) 6) (<= (- hi lo) 512)
    (let [load (sf-word M (- hi 6)) pair (sf-word M (- hi 5))
          a (bit-and pair 31) b (bit-and (i64-shift-right pair 10) 31)]
     (and (= (bit-and load 0xffc003ff) 0xf94003e7)
      (= (bit-and pair 0xffc003e0) 0xa94003e0)
      (>= a 19) (<= a 28) (>= b 19) (<= b 28) (not= a b)
      (= (sf-word M (- hi 4)) (enc-mov-sp 31 29))
      (= (sf-word M (- hi 3)) (enc-ldp-post 29 30 31 16))
      (= (sf-word M (- hi 2)) (enc-ret))
      (= (sf-word M (dec hi)) (enc-brk 1))
      (scr-stores M lo hi (- load 0x400000) 0)
      (scr-fixes M lo hi 1)
      (scr-native M lo lo hi load false)
      (scr-saved M (vector-assoc! (vector-alloc (- hi lo)) 0 1) lo lo hi load)))))))
(defn- scr-ret [M :vector-i64 i :i64 t :i64 f :i64] :vector-i64
 (let [owned (and (= t 0) (> i 15) (scr-source M f)
              (= (gn-fnf M f FF-SIR) (- i 15))
              (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-ns) 2)
              (= (gn-g M gn-f-dp) 2) (= (gn-g M gn-f-nsv) 2)
              (> (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768))]
  ;; Deliberate unconditional load is an emitted return certificate. Original
  ;; frame slot0 was saved before params; x0/result/fuel/flags are untouched.
  (let [result (gn-into M 0 t)]
   (gn-epilogue (if owned (-> result (gn-ld 7 0) (gn-gs gn-f-ctx 1)) result)))))
(defn- trg-ret [M :vector-i64 i :i64 t :i64] :vector-i64
 (let [f (if (and (trg-counts M) (> i 15)) (gn-sir M (- i 15) IF-A) 0)
       tagged (and (> (trg-clone M f) 0) (= (gn-fnf M f FF-SIR) (- i 15)) (= t 0))
       m (scr-ret M i t f) at (dec (vector-at m MM-CODE-N))]
  (if (not tagged) m
   (if (or (<= at 0) (>= at MM-CODE-CAP)
       (not= (vector-at m (+ MM-CODE-BASE at)) (enc-ret))
       (>= (vector-at m MM-CODE-N) MM-CODE-CAP))
    (gn-err m E-GEN-FULL at)
    (-> m (gn-put (+ MM-CODE-BASE at) (enc-mov-r 8 31)) (gn-emit (enc-ret)))))))
(defn- trg-slot [M :vector-i64 P :vector-i64 k :i64 at :i64] :vector-i64
 (let [ignored (vector-assoc! P k at)] M))
(defn- trg-patch [M :vector-i64 P :vector-i64 k :i64 cc :i64] :vector-i64
 (-> M (trg-slot P k (vector-at M MM-CODE-N)) (gn-emit (enc-bcond cc 0))))
(defn- trg-disjoint [M :vector-i64 P :vector-i64 k :i64] :vector-i64
 (-> M (gn-emit (enc-cmp-r 9 0)) (gn-emit (enc-bcond 9 3))
  (gn-emit (enc-cmp-r 16 8)) (trg-patch P k 8)))
(defn- trg-guards [M :vector-i64 P :vector-i64 index :i64] :vector-i64
 (let [at (vector-at M MM-CODE-N)
   m (-> M (trg-slot P 0 at) (gn-emit (enc-cbz 8 0))
    (gn-emit (enc-cmp-i 16 2)) (trg-patch P 1 (enc-cond-lo))
    (gn-emit (+ (enc-add-i 8 7 CTX-FUEL) 0x20000000)) (trg-patch P 2 (enc-cond-hs))
    (gn-emit (+ (enc-add-i 9 8 8) 0x20000000)) (trg-patch P 3 (enc-cond-hs))
    (gn-emit (enc-mov-sp 0 31)) (gn-emit (enc-add-i 16 29 16)) (trg-disjoint P 4)
    (gn-emit (enc-ldr 0 7 288)) (gn-emit (+ (enc-add-i 16 0 8) 0x20000000))
    (trg-patch P 5 (enc-cond-hs)) (trg-disjoint P 6)
    (gn-emit (enc-ldr 0 7 296)) (gn-emit (gn-e-addsl 0 0 17 4))
    (gn-emit (+ (enc-add-i 16 0 16) 0x20000000)) (trg-patch P 7 (enc-cond-hs)) (trg-disjoint P 8)
    (gn-emit (+ (enc-add-r 0 10 index) 0x20000000)) (trg-patch P 9 (enc-cond-hs))
    (gn-emit (+ (enc-add-i 16 0 1) 0x20000000)) (trg-patch P 10 (enc-cond-hs)) (trg-disjoint P 11))] m))
(defn- trg-read-call [M :vector-i64 f :i64 h :i64 index :i64] :vector-i64
 (-> M (gn-emit (enc-mov-r 0 h)) (gn-emit (enc-mov-r 1 index))
  (gn-ld 7 0) (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))))
(defn- trg-compare [M :vector-i64 reg :i64 c :i64] :vector-i64
 (-> M (gn-emit (enc-cmp-i reg c)) (gn-emit (enc-cset 9 (enc-cond-eq)))))
(defn- trg-branch-result [M :vector-i64 P :vector-i64 k :i64] :vector-i64
 (-> M (trg-slot P k (vector-at M MM-CODE-N)) (gn-emit (enc-cbnz 9 0))))
(defn- trg-charge [M :vector-i64] :vector-i64
 (-> M (gn-emit (enc-subs-i 16 16 1)) (gn-emit (enc-bcond (enc-cond-hs) 2))
  (gn-emit (enc-brk 0)) (gn-emit (enc-str 16 7 CTX-FUEL))))
(defn- trg-entry [M :vector-i64 i :i64] :vector-i64
 (if (or (not (trg-counts M)) (<= i 1) (> i (- (vector-at M MM-SIR-N) 22))) M
  (let [p (dec i) f (gn-sir M p IF-A) r (trg-chain M f true)
      clone (if (> r 0) (gn-sir M (+ p 5) IF-A) 0)]
   (if (or (= r 0) (not= p (gn-fnf M f FF-SIR)) (= (trg-clone M clone) 0)
    (not= (gn-g M gn-f-fb) 64) (not= (gn-g M gn-f-nsv) 2)
    (not= (gn-g M gn-f-ns) 2) (not= (gn-g M gn-f-dp) 2)
    (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
    (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-dead) 0)
    (< (gn-sreg M 1) 19) (> (gn-sreg M 1) 28)
    (< (gn-sreg M 2) 19) (> (gn-sreg M 2) 28) (= (gn-sreg M 1) (gn-sreg M 2))
    (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 256))
    (> (vector-at M MM-FIX-N) (- MM-FIX-CAP 8))) M
    (let [B (gp-save-state M) P (vector-alloc 16) h (gn-sreg M 1) index (gn-sreg M 2)
      c0 (gn-sir M (+ p 6) IF-B) c1 (gn-sir M (+ p 12) IF-B) c2 (gn-sir M (+ p 18) IF-B)
      m0 (-> M (trg-read-call clone h index) (gn-emit (enc-mov-r 9 0))
        (trg-compare 9 c0) (trg-branch-result P 12) (trg-guards P index)
        (gn-emit (enc-ldr 16 7 CTX-FUEL)) (trg-charge) (trg-compare 11 c1) (trg-branch-result P 13)
        (trg-charge) (trg-compare 11 c2))
      jump (vector-at m0 MM-CODE-N) m1 (-> m0 (trg-slot P 14 jump) (gn-emit (enc-b 0)))
      cold (vector-at m1 MM-CODE-N)
      m2 (-> m1 (trg-read-call r h index) (gn-emit (enc-mov-r 9 0)) (trg-compare 9 c1)
        (trg-branch-result P 15) (trg-read-call r h index) (gn-emit (enc-mov-r 9 0)) (trg-compare 9 c2))
      done (vector-at m2 MM-CODE-N)
      m3 (-> m2 (gn-emit (enc-mov-r 0 9)) (gn-epilogue))
      m4 (loop [cur m3 k 0] (if (= k 16) cur
        (let [at (vector-at P k) to (if (< k 12) cold done)
              word (cond (= k 0) (enc-cbz 8 (- to at))
                    (= k 14) (enc-b (- to at))
                    (>= k 12) (enc-cbnz 9 (- to at))
                    :else (enc-bcond (case k 1 (enc-cond-lo) 4 8 6 8 8 8 11 8 (enc-cond-hs)) (- to at)))]
          (recur (gn-put cur (+ MM-CODE-BASE at) word) (inc k)))))]
     (-> (gp-restore m4 B) (gn-gs gn-f-skip 20) (gn-gs gn-f-dead 1)))))))

(defn- trg-se-entry [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (if (not (se-admit M i f np)) M
  (let [B (gp-save-state M) F (gn-g M gn-f-fb) G (vector-alloc 6)
    m0 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 0)))
    z (vector-at m0 MM-CODE-N) m1 (gn-emit m0 (enc-bcond (enc-cond-ne) 0))
    ;; Fuelzero reaches the identical savedframe/params/FUEL trap state.
    m2 (-> m1 (gn-emit (enc-stp-pre 29 30 31 -16)) (gn-emit (enc-mov-sp 29 31))
      (gn-subsp (bit-and F -4096)) (gn-subsp (bit-and F 4095))
      (gn-csave 0 (gn-g M gn-f-nsv) 0) (gn-st 7 0) (gn-params 1 np)
      (gn-gs gn-f-ctx 1) (gn-op-fuel))
    fast (vector-at m2 MM-CODE-N)
    m3 (-> (gp-restore m2 B) (gn-put (+ MM-CODE-BASE z) (enc-bcond (enc-cond-ne) (- fast z)))
      ;; x16 retains original nonzero fuel on this edge; every original check/store remains.
      (gn-emit (enc-subs-i 16 16 1)) (gn-emit (enc-bcond (enc-cond-hs) 2))
      (gn-emit (enc-brk 0)) (gn-emit (enc-str 16 7 CTX-FUEL))
      (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-ldr 9 7 288)) (gn-emit (enc-ldr 9 9 0))
      (gn-emit (enc-cmp-r 17 9)) (nr-guard G 0 (enc-cond-hs))
      (gn-emit (enc-ldr 9 7 296)) (gn-emit (gn-e-addsl 9 9 17 4)) (gn-emit (enc-ldp 8 9 9 0))
      (gn-emit (enc-cmp-r 1 9)) (nr-guard G 5 (enc-cond-eq))
      (gn-emit (enc-cmp-i 8 0)) (nr-guard G 1 (enc-cond-lt))
      (gn-emit (enc-cmp-r 1 9)) (nr-guard G 2 (enc-cond-hs))
      (gn-emit (enc-add-r 9 8 9)) (gn-emit (enc-ldr 10 7 392))
      (gn-emit (enc-cmp-r 9 10)) (nr-guard G 3 8)
      (gn-emit (enc-ldr 10 7 CTX-CODE-BASE)) (gn-emit (enc-add-r 10 10 8))
      (gn-emit (gn-e-ldrb 11 10 1)) (gn-emit (enc-cmp-i 11 128)) (nr-guard G 4 (enc-cond-hs))
      (gn-emit (enc-mov-r 0 11)) (gn-emit (enc-movz 8 1 0)) (gn-emit (enc-ret)))
    endpoint (vector-at m3 MM-CODE-N)
    m4 (-> m3 (gn-emit (enc-mov-r 0 31)) (gn-emit (enc-mov-r 8 31)) (gn-emit (enc-ret)))
    cold (vector-at m4 MM-CODE-N)
    m5 (loop [cur m4 k 0] (if (= k 6) cur
      (recur (gn-dot-patch cur (vector-at G k) (if (= k 5) endpoint cold)
       (case k 1 (enc-cond-lt) 3 8 5 (enc-cond-eq) (enc-cond-hs))) (inc k))))]
   (gn-gs m5 gn-f-skip 1))))

;; Novel source/native selector continuation; ADR0357 one-off algorithm.
;; Only runs after ly-fix-loop: unresolved BL0 never supplies an effect proof.
(defn- scn-zero [n :i64] :vector-i64
 (loop [V (vector-alloc n) k 0]
  (if (= k n) V (recur (vector-assoc! V k 0) (inc k)))))
(defn- scn-counts [M :vector-i64] :bool
 (and (= (vector-at M MM-ERR) 0)
  (> (vector-at M MM-CODE-N) 1) (<= (vector-at M MM-CODE-N) 32768)
  (> (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) 512)
  (> (vector-at M MM-SIR-N) 1) (<= (vector-at M MM-SIR-N) 20000)
  (> (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) 8192)
  (> (vector-at M MM-LABEL-N) 0) (<= (vector-at M MM-LABEL-N) 4096)
  (> (vector-at M MM-LIT-N) 0) (<= (vector-at M MM-LIT-N) MM-LIT-CAP)
  (mp-sirclosed M 1)))
(defn- scn-end [M :vector-i64 p :i64 f :i64 left :i64] :i64
 (if (or (= left 0) (>= p (vector-at M MM-SIR-N))) 0
  (cond (= (gn-op M p) OP-END) (if (= (gn-sir M p IF-A) f) p 0)
   (= (gn-op M p) OP-FN) 0 :else (scn-end M (inc p) f (dec left)))))
(defn- scn-owned [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N))) 0
  (let [p (gn-fnf M f FF-SIR) np (gn-fnf M f FF-NPARAMS)]
   (if (or (<= p 0) (>= p (vector-at M MM-SIR-N)) (<= np 0) (> np 5) (< (gn-fnf M f FF-NSLOTS) np) (> (gn-fnf M f FF-NSLOTS) 64)
     (< (gn-fnf M f FF-DEPTH) 0) (> (gn-fnf M f FF-DEPTH) 32)
     (not (gn-dot-at? M p OP-FN f np (gn-fnf M f FF-NSLOTS)))) 0
    (scn-end M (inc p) f 512)))))
(defn- scn-label-at [M :vector-i64 label :i64 p :i64 e :i64] :i64
 (if (or (<= label 0) (>= label (vector-at M MM-LABEL-N))) 0
  (loop [j (inc p) found 0]
   (if (>= j e) found
    (if (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) label))
     (if (> found 0) 0 (recur (inc j) j)) (recur (inc j) found))))))
(defn- scn-rebind [M :vector-i64 f :i64 p :i64 j :i64 slot :i64 t :i64 left :i64] :bool
 ;; Only a straight-line, bounded identity LGET can feed a formal rebinding.
 ;; No LABEL/branch/call/fuel/unknown record may enter or cross this witness.
 (if (or (= left 0) (<= j p) (< t 0) (>= t (gn-fnf M f FF-DEPTH))) false
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
    dp (gn-fnf M f FF-DEPTH) ns (gn-fnf M f FF-NSLOTS)]
   (cond (= op OP-LGET)
     (and (>= a 0) (< a dp) (> b 0) (<= b ns)
      (if (= a t) (= b slot) (scn-rebind M f p (dec j) slot t (dec left))))
    (= op OP-CONST) (and (>= a 0) (< a dp) (not= a t) (scn-rebind M f p (dec j) slot t (dec left)))
    (= op OP-BIN) (and (or (and (>= a BOP-ADD) (<= a BOP-MUL)) (and (>= a BOP-AND) (<= a BOP-SSHR)))
      (>= b 0) (< (inc b) dp) (not= b t) (scn-rebind M f p (dec j) slot t (dec left)))
    (= op OP-LSET) (and (> a 0) (<= a ns) (>= b 0) (< b dp) (not= a slot) (scn-rebind M f p (dec j) slot t (dec left)))
    :else false))))
(defn- scn-source [M :vector-i64 f :i64 slot :i64] :bool
 (let [e (scn-owned M f)]
  (if (= e 0) false
   (let [p (gn-fnf M f FF-SIR) np (gn-fnf M f FF-NPARAMS)]
    (and (> slot 0) (<= slot np) (= (gn-fnf M f (+ FF-PT0 (dec slot))) 1)
     (loop [j (inc p)]
      (if (>= j e) true
       (let [op (gn-op M j) a (gn-sir M j IF-A) target
         (cond (= op OP-BR) a (or (= op OP-BRZ) (= op OP-BRNZ)) (gn-sir M j IF-B) :else 0)]
        (and (> op 0) (<= op OP-COUNT) (not= op OP-FADDR) (not= op OP-CALLI) (not= op OP-CAP)
         (or (not= op OP-LSET) (not= a slot)
          (scn-rebind M f p (dec j) slot (gn-sir M j IF-B) 16))
         (or (not (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ))) (> (scn-label-at M target p e) 0))
         (recur (inc j))))))))))
)
(defn- scn-defs [w :i64] :i64
 ;; Must-def mask; -1 is unsupported. Scalar integer forms only.
 (let [d (bit-and w 31) n (bit-and (i64-shift-right w 5) 31)
   one (if (= d 31) 0 (i64-shift-left 1 d)) base (if (= n 31) 0 (i64-shift-left 1 n))]
  (cond (= (bit-and w 0xfc000000) 0x94000000) (i64-shift-left 1 30)
   (or (= (bit-and w 0x7c000000) 0x14000000) (= (bit-and w 0xff000010) 0x54000000)
       (= (bit-and w 0x7e000000) 0x34000000) (= (bit-and w 0xfffffc1f) 0xd65f0000)
       (= (bit-and w 0xffe0001f) 0xd4200000) (= w 0) (= w 0xd503201f)) 0
   ;; No SIMD, exclusive/atomic, literal loads or system effects.
   (and (= (bit-and w 0x3a000000) 0x28000000) (= (bit-and w 0x04000000) 0))
    (let [r (bit-and (i64-shift-right w 10) 31) mode (bit-and (i64-shift-right w 23) 3)]
     (bit-or (if (= (bit-and w 0x00400000) 0) 0 (bit-or one (if (= r 31) 0 (i64-shift-left 1 r))))
      (if (or (= mode 1) (= mode 3)) base 0)))
   (and (or (= (bit-and w 0x3b000000) 0x39000000) (= (bit-and w 0x3b000000) 0x38000000))
        (= (bit-and w 0x04000000) 0))
    (bit-or (if (= (bit-and (i64-shift-right w 22) 3) 0) 0 one)
     (if (and (= (bit-and w 0x3b200000) 0x38000000)
       (or (= (bit-and (i64-shift-right w 10) 3) 1) (= (bit-and (i64-shift-right w 10) 3) 3))) base 0))
   (or (= (bit-and w 0x1f000000) 0x0a000000) (= (bit-and w 0x1f000000) 0x0b000000)
       (= (bit-and w 0x1f000000) 0x1a000000) (= (bit-and w 0x1f000000) 0x1b000000)
       (= (bit-and w 0x1f000000) 0x10000000) (= (bit-and w 0x1f000000) 0x11000000)
       (= (bit-and w 0x1f000000) 0x12000000) (= (bit-and w 0x1f000000) 0x13000000)) one
   :else -1)))
(defn- scn-callee [M :vector-i64 dest :i64 r :i64] :bool
 ;; Exact current owned code identity, not an unresolved BL immediate.
 (loop [f 1 found 0]
  (cond (>= f (vector-at M MM-FN-N))
    (if (= found 0) false
     (let [start (gn-fnf M found FF-CODE) end (sf-codeend M found 1 (vector-at M MM-CODE-N))]
      (and (> (scn-owned M found) 0) (> start 0) (> end start) (<= (- end start) 256)
       (loop [at start]
        (if (>= at end) true
         (let [w (sf-word M at) d (scn-defs w) t (of-dest w at)]
          (and (>= d 0) (= (bit-and d (i64-shift-left 1 r)) 0)
           (not= (bit-and w 0xfc000000) 0x94000000)
           (or (< t 0) (and (>= t start) (< t end))) (recur (inc at)))))))))
   (= (gn-fnf M f FF-CODE) dest) (if (> found 0) false (recur (inc f) f))
   :else (recur (inc f) found))))
(defn- scn-stable [M :vector-i64 at :i64 end :i64 r :i64] :bool
 (if (>= at end) true
  (let [w (sf-word M at) d (scn-defs w)]
   (and (>= d 0) (= (bit-and d (i64-shift-left 1 r)) 0)
    (or (not= (bit-and w 0xfc000000) 0x94000000) (scn-callee M (of-dest w at) r))
    (scn-stable M (inc at) end r)))))
(defn- scn-test [M :vector-i64 at :i64 end :i64 r :i64] :bool
 (and (< (inc at) end) (= (sf-word M at) (enc-cmp-i r 0))
  (= (bit-and (sf-word M (inc at)) 0xff00001f) 0x54000001)))
(defn- scn-flags [M :vector-i64 at :i64 end :i64 left :i64 r :i64 nz :bool] :bool
 ;; Refuse until the deleted CMP flags are overwritten on every selected path.
 ;; Closed call's entry must overwrite flags before reading them as well.
 (if (or (= left 0) (>= at end)) false
  (let [w (sf-word M at) t (of-dest w at)]
   (cond (scn-test M at end r) (scn-flags M (if nz (of-dest (sf-word M (inc at)) (inc at)) (+ at 2)) end (dec left) r nz)
    (or (= (bit-and w 0x7f000000) 0x71000000) (= (bit-and w 0x7f000000) 0x6b000000)
             (= (bit-and w 0x7f000000) 0x72000000) (= (bit-and w 0x7f000000) 0x6a000000)) true
    (= (bit-and w 0xfc000000) 0x94000000) (and (> t 0) (< (+ t 64) (vector-at M MM-CODE-N)) (scn-flags M t (+ t 64) (dec left) r nz))
    (= (bit-and w 0xfc000000) 0x14000000)
     (and (> t at) (< t end) (scn-flags M t end (dec left) r nz))
    ;; No unseen alternative or terminal trap before an actual flags writer.
    (or (= (bit-and w 0xff000010) 0x54000000)
        (= (bit-and w 0x7e000000) 0x34000000) (= (bit-and w 0x7e000000) 0x36000000)
        (= (bit-and w 0xffe0001f) 0xd4200000) (= w 0)
        (= (bit-and w 0x1fe00000) 0x1a800000) (= (bit-and w 0x1fe00000) 0x1a400000)
        (= (bit-and w 0x1fe00000) 0x1a000000) (= (bit-and w 0xfffffc1f) 0xd65f0000)) false
    :else (and (>= (scn-defs w) 0) (scn-flags M (inc at) end (dec left) r nz))))))
(defn- scn-first [M :vector-i64 at :i64 end :i64 r :i64] :i64
 (cond (>= (inc at) end) 0 (scn-test M at end r) at :else (scn-first M (inc at) end r)))
(defn- scn-last [M :vector-i64 at :i64 end :i64 r :i64 first :i64 last :i64] :i64
 (if (>= (inc at) end) last
  (let [w (sf-word M at)]
   (if (or (< (scn-defs w) 0) (not= (bit-and (scn-defs w) (i64-shift-left 1 r)) 0)
           (and (= (bit-and w 0xfc000000) 0x94000000) (not (scn-callee M (of-dest w at) r)))) last
    (scn-last M (inc at) end r first (if (scn-test M at end r) at last))))))
(defn- scn-join [M :vector-i64 at :i64 end :i64 false-at :i64 left :i64] :i64
 (if (or (= left 0) (>= at false-at)) 0
  (let [w (sf-word M at) t (of-dest w at)]
   (if (= (bit-and w 0xfc000000) 0x14000000)
    (if (and (> t false-at) (< t end)) t 0) (scn-join M (inc at) end false-at (dec left))))))
(defn- scn-target [M :vector-i64 at :i64 end :i64 r :i64 nz :bool] :i64
 (if (scn-test M at end r) (if nz (of-dest (sf-word M (inc at)) (inc at)) (+ at 2)) at))
(defn- scn-reach [M :vector-i64 V :vector-i64 head :i64 end :i64 r :i64 nz :bool entry :i64] :vector-i64
 ;; Strict forward CFG. All branch edges terminate in region or shared suffix.
 (let [v (vector-assoc! V (- entry head) 1)]
  (loop [out v at head]
   (if (>= at end) out
    (if (= (vector-at out (- at head)) 0) (recur out (inc at))
     (let [w (sf-word M at) t (of-dest w at) test (scn-test M at end r)
       terminal (or (= w 0) (= (bit-and w 0xffe0001f) 0xd4200000))
       a (cond test (scn-target M at end r nz) terminal end
           (= (bit-and w 0xfc000000) 0x14000000) t :else (inc at))
       c (if (and (not test) (or (= (bit-and w 0xff000010) 0x54000000)
              (= (bit-and w 0x7e000000) 0x34000000))) t end)]
      (if (or (<= a at) (> a end) (<= c at) (> c end)) (vector-assoc! out (dec (vector-count out)) -1)
       (let [o (if (< a end) (vector-assoc! out (- a head) 1) out)
             z (if (< c end) (vector-assoc! o (- c head) 1) o)]
        (recur z (inc at))))))))))
(defn- scn-pair-count [M :vector-i64 first :i64 end :i64 r :i64] :i64
 (loop [at first n 0]
  (if (>= at end) n
   (if (scn-test M at end r)
    (if (and (scn-flags M (+ at 2) (vector-at M MM-CODE-N) 64 r false)
          (scn-flags M (of-dest (sf-word M (inc at)) (inc at)) (vector-at M MM-CODE-N) 64 r true))
     (recur (+ at 2) (inc n)) 0) (recur (inc at) n)))))
(defn- scn-pc-target [w :i64 at :i64] :i64
 (if (= (bit-and w 0x9f000000) 0x10000000)
  (if (= (bit-and (i64-shift-right w 29) 3) 0)
   (+ at (mp-sign (bit-and (i64-shift-right w 5) 0x7ffff) 19)) -2)
  (of-dest w at)))
(defn- scn-incoming [M :vector-i64 head :i64 end :i64] :bool
 (loop [at 1]
  (if (>= at (vector-at M MM-CODE-N)) true
   (let [w (sf-word M at) t (scn-pc-target w at)]
    (and (not= t -2) (not= (bit-and w 0x9f000000) 0x90000000)
     (not= (bit-and w 0x3b000000) 0x18000000)
     (or (< t 0) (and (> t 0) (< t (vector-at M MM-CODE-N))))
     (or (< t head) (>= t end) (and (>= at head) (< at end)) (= at (dec head)))
     ;; Neither ADR nor a call may enter the selected interior.
     (or (< t head) (>= t end)
         (and (not= (bit-and w 0xfc000000) 0x94000000)
              (not= (bit-and w 0x9f000000) 0x10000000)))
     (recur (inc at)))))))
(defn- scn-reach-ok [M :vector-i64 V :vector-i64 head :i64 end :i64 r :i64 nz :bool] :bool
 (and (= (vector-at V (dec (vector-count V))) 0)
  (loop [at head]
   (if (>= at end) true
    (if (= (vector-at V (- at head)) 0) (recur (inc at))
     (let [w (sf-word M at)]
      (and (>= (scn-defs w) 0)
       (not= (bit-and w 0xfffffc1f) 0xd65f0000)
       (not= (bit-and w 0x9f000000) 0x10000000)
       (or (not nz) (not= (bit-and w 0xfc000000) 0x94000000))
       (or (not (scn-test M at end r))
           (and (scn-flags M (+ at 2) (vector-at M MM-CODE-N) 64 r false)
                (scn-flags M (of-dest (sf-word M (inc at)) (inc at)) (vector-at M MM-CODE-N) 64 r true)))
       (recur (inc at)))))))))
(defn- scn-number [M :vector-i64 Map :vector-i64 V :vector-i64 head :i64 end :i64 r :i64 start :i64] :vector-i64
 (loop [out Map at head n start]
  (if (>= at end) (vector-assoc! out 0 n)
   (cond (scn-test M at end r) (recur out (+ at 2) n)
    (= (vector-at V (- at head)) 0) (recur out (inc at) n)
    :else (recur (vector-assoc! out at n) (inc at) (inc n))))))
(defn- scn-map-removed [M :vector-i64 Map :vector-i64 head :i64 end :i64 r :i64 nz :bool] :vector-i64
 (loop [out Map at (dec end)]
  (if (< at head) out
   (if (scn-test M at end r)
    (let [to (scn-target M at end r nz) value (vector-at out to)]
     (recur (-> out (vector-assoc! at value) (vector-assoc! (inc at) value)) (dec at)))
    (recur out (dec at))))))
(defn- scn-default [Z :vector-i64 N :vector-i64 at :i64] :i64
 (if (= at 0) 0 (let [z (vector-at Z at)] (if (> z 0) z (vector-at N at)))))
(defn- scn-patch [w :i64 at :i64 to :i64] :i64
 (let [delta (- to at) b (of-branch w)]
  (cond (= b 26) (ly-patch26 w delta) (= b 19) (ly-patch19 w delta)
   (= b 14) (if (and (>= delta -8192) (< delta 8192))
     (bit-or (bit-and w 0xfff8001f) (i64-shift-left (bit-and delta 0x3fff) 5)) -1)
   (= (bit-and w 0x9f000000) 0x10000000)
    (if (and (>= delta -262144) (< delta 262144))
     (bit-or (bit-and w 0x9f00001f) (i64-shift-left (bit-and delta 0x7ffff) 5)) -1)
   :else w)))
(defn- scn-word [M :vector-i64 Z :vector-i64 N :vector-i64 at :i64 out :i64 head :i64 end :i64 nz :bool] :i64
 (let [w (sf-word M at) t (scn-pc-target w at)
   to (cond (< t 0) 0
        (and (= at (dec head)) (>= t head) (< t end)) (vector-at N t)
        (and (>= at head) (< at end) (>= t head) (< t end))
          (vector-at (if nz N Z) t)
        :else (scn-default Z N t))]
  (if (< t 0) w (if (= to 0) -1 (scn-patch w out to)))))
(defn- scn-output [M :vector-i64 Z :vector-i64 N :vector-i64 head :i64 end :i64 r :i64 size :i64] :vector-i64
 (loop [O (scn-zero size) at 1]
  (if (>= at (vector-at M MM-CODE-N)) O
   (let [z (vector-at Z at) n (vector-at N at)
     deleted (and (>= at head) (< at end)
       (or (scn-test M at end r) (and (> at head) (scn-test M (dec at) end r))))
     a (if (and (not deleted) (> z 0)) (scn-word M Z N at z head end false) 0)
     b (if (and (not deleted) (> n 0) (not= n z)) (scn-word M Z N at n head end true) 0)]
    (if (or (< a 0) (< b 0)) (vector-assoc! O 0 -1)
     (let [A (if (and (not deleted) (> z 0)) (vector-assoc! O z a) O)
           B (if (and (not deleted) (> n 0) (not= n z)) (vector-assoc! A n b) A)]
      (recur B (inc at))))))))
(defn- scn-x-target [M :vector-i64 k :i64] :i64
 (let [kind (sf-x M k XF-KIND) t (sf-x M k XF-TARGET) aux (sf-x M k XF-AUX)]
  (cond (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19) (= kind FX-ADRL19))
    (if (and (> t 0) (< t (vector-at M MM-LABEL-N)) (= aux 0)) (vector-at M (+ MM-LABEL-BASE t)) -1)
   (or (= kind FX-BL26) (= kind FX-ADR19))
    (if (and (> t 0) (< t (vector-at M MM-FN-N)) (>= aux 0) (<= aux 8)) (+ (gn-fnf M t FF-CODE) aux) -1)
   (= kind FX-LIT32) (if (and (= aux 0) (> t 0) (< t (vector-at M MM-LIT-N))) 0 -1)
   :else -1)))
(defn- scn-fix-ok [M :vector-i64 Z :vector-i64 N :vector-i64 head :i64 end :i64] :bool
 (loop [k 1]
  (if (>= k (vector-at M MM-FIX-N)) true
   (let [at (sf-x M k XF-AT) kind (sf-x M k XF-KIND) t (scn-x-target M k)
     inside (and (>= at head) (< at end))]
    (and (> at 0) (< at (vector-at M MM-CODE-N)) (>= t 0)
     (or (= t 0) (= t (scn-pc-target (sf-word M at) at)))
     (or (= t 0) (and (< t (vector-at M MM-CODE-N)) (> (scn-default Z N t) 0)))
     (if inside
      (cond (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19)) true
       (= kind FX-BL26) (and (> (vector-at Z at) 0) (= (vector-at N at) 0))
       (= kind FX-LIT32)
        (and (< (inc at) (vector-at M MM-CODE-N)) (ly-is-movz (sf-word M at)) (ly-is-movk (sf-word M (inc at)))
         (or (= (vector-at Z at) 0) (= (vector-at Z (inc at)) (inc (vector-at Z at))))
         (or (= (vector-at N at) 0) (= (vector-at N (inc at)) (inc (vector-at N at)))))
       :else false)
      (and (> (scn-default Z N at) 0)
       (or (not= kind FX-LIT32) (and (< (inc at) (vector-at M MM-CODE-N))
         (= (scn-default Z N (inc at)) (inc (scn-default Z N at)))))
       (or (not (or (= kind FX-BL26) (= kind FX-ADR19)))
        (= (scn-default Z N t) (+ (scn-default Z N (- t (sf-x M k XF-AUX))) (sf-x M k XF-AUX))))))
     (recur (inc k)))))))
(defn- scn-x-copy [M :vector-i64 X :vector-i64 k :i64 out :i64 at :i64] :vector-i64
 (-> X (vector-assoc! (* out 4) at)
  (vector-assoc! (+ (* out 4) 1) (sf-x M k XF-KIND))
  (vector-assoc! (+ (* out 4) 2) (sf-x M k XF-TARGET))
  (vector-assoc! (+ (* out 4) 3) (sf-x M k XF-AUX))))
(defn- scn-fix-plan [M :vector-i64 Z :vector-i64 N :vector-i64 head :i64 end :i64] :vector-i64
 (loop [X (scn-zero (* 8 (vector-at M MM-FIX-N))) k 1 n 1]
  (if (>= k (vector-at M MM-FIX-N)) (vector-assoc! X 0 n)
   (let [at (sf-x M k XF-AT) kind (sf-x M k XF-KIND)
      inside (and (>= at head) (< at end))
      skip (and inside (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19)))
      z (if inside (vector-at Z at) (scn-default Z N at))
      a (if (and (not skip) (> z 0)) (scn-x-copy M X k n z) X)
      n1 (if (and (not skip) (> z 0)) (inc n) n)
      extra (and inside (= kind FX-LIT32) (> (vector-at N at) 0) (not= (vector-at N at) z))
      b (if extra (scn-x-copy M a k n1 (vector-at N at)) a)]
    (recur b (inc k) (if extra (inc n1) n1))))))
(defn- scn-commit [M :vector-i64 O :vector-i64 Z :vector-i64 N :vector-i64 X :vector-i64] :vector-i64
 ;; All data/branch/fixup plans validated before this first mutation.
 (let [a (loop [out M at 1]
     (if (= at (vector-count O)) (gn-put out MM-CODE-N at)
      (recur (gn-put out (+ MM-CODE-BASE at) (vector-at O at)) (inc at))))
   b (loop [out a f 1]
     (if (>= f (vector-at out MM-FN-N)) out
      (recur (gn-put out (+ MM-FN-BASE (* f MM-FN-W) FF-CODE)
        (scn-default Z N (gn-fnf out f FF-CODE))) (inc f))))
   c (loop [out b l 1]
     (if (>= l (vector-at out MM-LABEL-N)) out
      (recur (gn-put out (+ MM-LABEL-BASE l) (scn-default Z N (vector-at out (+ MM-LABEL-BASE l)))) (inc l))))
   d (loop [out c k 1]
     (if (= k (vector-at X 0)) (gn-put out MM-FIX-N k)
      (let [v (loop [a out field 0]
        (if (= field 4) a (recur (gn-put a (+ MM-FIX-BASE (* k MM-FIX-W) field) (vector-at X (+ (* k 4) field))) (inc field))))]
       (recur v (inc k)))))
   pool (ly-pool d)]
  (if (= (ly-failed pool) 0) (ly-fix-loop pool 1) pool)))
(defn- scn-symbols [M :vector-i64 Z :vector-i64 N :vector-i64] :bool
 (and (loop [f 1]
   (if (>= f (vector-at M MM-FN-N)) true
    (let [at (gn-fnf M f FF-CODE)]
     (and (>= at 0) (< at (vector-at M MM-CODE-N)) (or (= at 0) (> (scn-default Z N at) 0)) (recur (inc f))))))
  (loop [l 1]
   (if (>= l (vector-at M MM-LABEL-N)) true
    (let [at (vector-at M (+ MM-LABEL-BASE l))]
     (and (>= at 0) (< at (vector-at M MM-CODE-N)) (or (= at 0) (> (scn-default Z N at) 0)) (recur (inc l))))))))
(defn- scn-apply [M :vector-i64 head :i64 end :i64 r :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) span (- end head)
    z (scn-reach M (scn-zero (inc span)) head end r false head)
    n (scn-reach M (scn-zero (inc span)) head end r true (of-dest (sf-word M (dec head)) (dec head)))]
  (if (or (not (scn-incoming M head end)) (not (scn-stable M head end r))
        (not (scn-reach-ok M z head end r false)) (not (scn-reach-ok M n head end r true))) M
   (let [Z0 (loop [a (scn-zero cn) at 1]
      (if (= at head) a (recur (vector-assoc! a at at) (inc at))))
     Z1 (scn-number M Z0 z head end r head)
     N1 (scn-number M (scn-zero cn) n head end r (vector-at Z1 0))
     size (+ (vector-at N1 0) (- cn end))
     Z2 (loop [a Z1 at end to (vector-at N1 0)]
       (if (= at cn) a (recur (vector-assoc! a at to) (inc at) (inc to))))
     N2 (loop [a N1 at 1]
       (if (= at cn) a (recur (if (or (< at head) (>= at end)) (vector-assoc! a at (vector-at Z2 at)) a) (inc at))))
     Z (scn-map-removed M Z2 head end r false)
     N (scn-map-removed M N2 head end r true)
     lastz (loop [at (dec end)] (if (or (< at head) (= (vector-at z (- at head)) 1)) at (recur (dec at))))]
    (if (or (<= size cn) (> size MM-CODE-CAP) (> (- size cn) 512) (< lastz head)
         (not= (bit-and (sf-word M lastz) 0xfc000000) 0x14000000)
         (not= (of-dest (sf-word M lastz) lastz) end)
         (not (scn-symbols M Z N)) (not (scn-fix-ok M Z N head end))) M
     (let [O (scn-output M Z N head end r size) X (scn-fix-plan M Z N head end)]
      (if (or (= (vector-at O 0) -1) (> (vector-at X 0) MM-FIX-CAP)) M
       (scn-commit M O Z N X))))))))
(defn- scn-register [M :vector-i64 start :i64 end :i64 arg :i64] :i64
 (loop [r 19]
  (if (> r 28) 0
   (let [first (scn-first M start end r)]
    (if (and (> first start) (<= (- first start) 64)
      (loop [at start]
       (and (< at first) (or (and (= (sf-word M at) (enc-mov-r r arg))
         (scn-stable M (inc at) first r)) (recur (inc at)))))) r
     (recur (inc r)))))))
(defn- scn-code-owner [M :vector-i64 f :i64 start :i64] :bool
 (loop [k 1]
  (if (>= k (vector-at M MM-FN-N)) true
   (and (or (= k f) (not= (gn-fnf M k FF-CODE) start)) (recur (inc k))))))
(defn- scn-try [M :vector-i64 f :i64 slot :i64] :vector-i64
 (if (not (scn-source M f slot)) M
  (let [start (gn-fnf M f FF-CODE) end (sf-codeend M f 1 (vector-at M MM-CODE-N))]
   (if (or (<= start 0) (<= end start) (> (- end start) 1024) (not (scn-code-owner M f start))) M
    (let [r (scn-register M start end (dec slot))]
     (if (= r 0) M
      (let [first (scn-first M start end r) last (scn-last M (+ first 2) end r first first)
         false-at (of-dest (sf-word M (inc last)) (inc last))
         join (scn-join M (+ last 2) end false-at 96)
         head (+ first 2)]
       (if (or (<= join head) (> (- join head) 1024) (< (scn-pair-count M first join r) 4)
             (not (scn-stable M head join r))) M
        (scn-apply M head join r)))))))))
(defn- scn-run [M :vector-i64] :vector-i64
 ;; At most one useful function, bounded 512-SIR and 1024-native-word region.
 ;; Unsupported artifacts are exact fallback, including selfhost default.
 (if (not (scn-counts M)) M
  (loop [f 1 slot 1]
   (if (>= f (vector-at M MM-FN-N)) M
    (if (or (> slot 5) (> slot (gn-fnf M f FF-NPARAMS))) (recur (inc f) 1)
     (let [before (vector-at M MM-CODE-N) out (scn-try M f slot)]
      (if (not= (vector-at out MM-CODE-N) before) out
       (recur f (inc slot)))))))))

;; ADR0357: finite synthesized constant map, a new semantic algorithm.
;; Independent staging precedes every new table/cache read. Public fallback is unchanged.
(defn- cmap-counts [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS) (= (vector-at M MM-ERR) 0)
  (let [g (vector-at M gn-cell) top (vector-at M MM-HEAP-TOP)
        size (+ gn-a-lp MM-LABEL-CAP 90)]
   (and (>= g MM-HEAP-BASE) (<= g (- MM-HEAP-END size))
        (>= top (+ g size)) (<= top MM-HEAP-END)))
  (>= (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (>= (vector-at M MM-SIR-N) 1) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (>= (vector-at M MM-LABEL-N) 1) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)
  (>= (vector-at M MM-CODE-N) 1) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 64))))
(defn- cmap-owned [M :vector-i64 lo :i64 hi :i64 l :i64 at :i64] :bool
 (and (> l 0) (< l (vector-at M MM-LABEL-N)) (< l MM-LABEL-CAP)
  (= (gn-lpos M l) at)
  (loop [j 1 seen 0]
   (if (= j (vector-at M MM-SIR-N)) (= seen 1)
    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
          label (and (= op OP-LABEL) (= a l))
          edge (or (and (= op OP-BR) (= a l))
                   (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= b l)))]
     (and (or (not (or label edge)) (and (>= j lo) (< j hi)))
          (or (not label) (= j at))
          (recur (inc j) (+ seen (if label 1 0)))))))))
(defn- cmap-end [M :vector-i64 p :i64 lo :i64 hi :i64 depth :i64] :i64
 (if (or (> depth 7) (< p lo) (>= p hi)) 0
  (if (gn-dot-at? M p OP-CONST 0 (gn-sir M p IF-B) 0) (inc p)
   (if (< (- hi p) 5) 0
    (if (and (gn-dot-at? M p OP-LGET 0 1 0)
       (gn-dot-at? M (inc p) OP-CONST 1 (gn-sir M (inc p) IF-B) 0)
       (>= (gn-sir M (inc p) IF-B) 0) (< (gn-sir M (inc p) IF-B) 64)
       (or (gn-dot-at? M (+ p 2) OP-CMP CC-LT 0 0)
           (gn-dot-at? M (+ p 2) OP-CMP CC-EQ 0 0))
       (gn-dot-at? M (+ p 3) OP-BRZ 0 (gn-sir M (+ p 3) IF-B) 0))
     (let [a (cmap-end M (+ p 4) lo hi (inc depth))
           le (gn-sir M (+ p 3) IF-B)]
      (if (or (<= a 0) (< (- hi a) 3)) 0
       (if (and (gn-dot-at? M a OP-BR (gn-sir M a IF-A) 0 0)
                (gn-dot-at? M (inc a) OP-LABEL le 0 0)
                (cmap-owned M lo hi le (inc a)))
        (let [b (cmap-end M (+ a 2) lo hi (inc depth)) lx (gn-sir M a IF-A)]
         (if (and (> b 0) (< b hi) (not= le lx)
                  (gn-dot-at? M b OP-LABEL lx 0 0) (cmap-owned M lo hi lx b))
          (inc b) 0)) 0))) 0)))))
(defn- cmap-owner [M :vector-i64 p :i64] :i64
 (loop [f 1 found 0]
  (if (= f (vector-at M MM-FN-N)) found
   (let [a (gn-fnf M f FF-SIR)]
    (if (= a (- p 2))
     (if (or (> found 0) (<= a 0) (> p (- (vector-at M MM-SIR-N) 3))) 0
      (if (and (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-NSLOTS) 1)
               (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-RTYPE) TY-I64)
               (= (gn-fnf M f FF-PT0) TY-I64) (= (gn-fnf M f FF-FUEL) 0)
               (gn-dot-at? M a OP-FN f 1 1)
               (= (gn-op M (inc a)) OP-LABEL))
       (recur (inc f) f) 0)) (recur (inc f) found))))))
(defn- cmap-limit [M :vector-i64 p :i64 f :i64] :i64
 (loop [q p work 2048]
  (if (or (<= work 0) (>= q (vector-at M MM-SIR-N))) 0
   (if (= (gn-op M q) OP-END)
    (if (gn-dot-at? M q OP-END f 0 0) q 0)
    (if (= (gn-op M q) OP-FN) 0 (recur (inc q) (dec work)))))))
(defn- cmap-admit [M :vector-i64 p :i64 charge :i64] :bool
 (and (cmap-counts M) (= charge 0) (> p 2) (< p (vector-at M MM-SIR-N))
  (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-fb) 0)
  (= (gn-g M gn-f-fuel) 0) (= (gn-g M gn-f-freg) 0)
  (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-out) 0)
  (= (gn-g M gn-f-ns) 1) (= (gn-g M gn-f-dp) 2) (= (gn-g M gn-f-h) 0)
  (>= (gn-sreg M 1) 0) (< (gn-sreg M 1) 7)
  (let [f (cmap-owner M p)]
   (and (> f 0)
    (let [hi (cmap-limit M p f)]
     (and (> hi p) (<= (- hi p) 2048)
      (gn-dot-at? M (dec p) OP-LABEL (gn-sir M (dec p) IF-A) 0 0)
      (cmap-owned M (dec p) (inc hi) (gn-sir M (dec p) IF-A) (dec p))
      (let [end (cmap-end M p p hi 0)]
       (and (= end (dec hi)) (gn-dot-at? M end OP-RET 0 0 0)
        (let [high (gn-tree-high M p)]
         (and (>= high 0) (< high 64)
          (loop [x 0]
           (or (> x high)
            (and (= (gn-tree-value M p x) (i64-shift-left 1 x))
                 (recur (inc x)))))))))))))))
(defn- cmap-emit [M :vector-i64 p :i64] :vector-i64
 (let [high-bound (gn-tree-high M p)
       M1 (-> M (gn-mov 9 (gn-sreg M 1)) (gn-emit (enc-cmp-i 9 0)))
       low (vector-at M1 MM-CODE-N)
       M2 (-> M1 (gn-emit (enc-bcond (enc-cond-lt) 0)) (gn-emit (enc-cmp-i 9 high-bound)))
       high (vector-at M2 MM-CODE-N)
       M3 (-> M2 (gn-emit (enc-bcond (enc-cond-gt) 0))
          (gn-mov-imm 10 1) (gn-emit (enc-lslv 0 10 9)) (gn-epilogue))
       l (vector-at M3 MM-CODE-N)
       M4 (-> M3 (gn-mov-imm 0 (gn-tree-value M p -9223372036854775808)) (gn-epilogue))
       h (vector-at M4 MM-CODE-N)
       M5 (-> M4 (gn-mov-imm 0 (gn-tree-value M p 9223372036854775807)) (gn-epilogue))]
  (-> M5 (gn-put (+ MM-CODE-BASE low) (enc-bcond (enc-cond-lt) (- l low)))
         (gn-put (+ MM-CODE-BASE high) (enc-bcond (enc-cond-gt) (- h high)))
         (gn-gs 14 1))))
(defn- gn-tree-emit [M :vector-i64 p :i64 charge :i64] :vector-i64
 (if (cmap-admit M p charge) (cmap-emit M p) (cmap-original M p charge)))

;; ADR0357 one-off semantic algorithm: positive pure return facts through an
;; unchanged adjacent CALL. No runtime guard, call rewrite, or metadata cache.
(defn- srf-counts [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS) (= (vector-at M MM-ERR) 0)
  (>= (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (>= (vector-at M MM-SIR-N) 1) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (>= (vector-at M MM-LABEL-N) 1) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)
  (>= (vector-at M MM-CODE-N) 1) (< (vector-at M MM-CODE-N) (- MM-CODE-CAP 1))
  (let [g (vector-at M gn-cell) top (vector-at M MM-HEAP-TOP)
        size (+ gn-a-lp MM-LABEL-CAP 90)]
   (and (>= g MM-HEAP-BASE) (<= g (- MM-HEAP-END size))
        (>= top (+ g size)) (<= top MM-HEAP-END)))))
(defn- srf-limit [M :vector-i64 p :i64 f :i64] :i64
 (loop [q p left 2048]
  (if (or (<= left 0) (<= q 0) (>= q (vector-at M MM-SIR-N))) 0
   (if (= (gn-op M q) OP-END)
    (if (gn-dot-at? M q OP-END f 0 0) q 0)
    (if (= (gn-op M q) OP-FN) 0 (recur (inc q) (dec left)))))))
(defn- srf-owned [M :vector-i64 lo :i64 hi :i64 l :i64 at :i64] :bool
 (and (> l 0) (< l (vector-at M MM-LABEL-N)) (< l MM-LABEL-CAP)
  (loop [j 1 seen 0]
   (if (= j (vector-at M MM-SIR-N)) (= seen 1)
    (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
          lab (and (= op OP-LABEL) (= a l))
          edge (or (and (= op OP-BR) (= a l))
                   (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= b l)))]
     (and (or (not (or lab edge)) (and (>= j lo) (< j hi)))
          (or (not lab) (= j at))
          (recur (inc j) (+ seen (if lab 1 0)))))))))
;; Every leaf must be a strictly positive signed I64 constant, including defaults.
(defn- srf-tree [M :vector-i64 p :i64 lo :i64 hi :i64 depth :i64] :i64
 (if (or (> depth 7) (< p lo) (>= p hi)) 0
  (if (and (gn-dot-at? M p OP-CONST 0 (gn-sir M p IF-B) 0)
           (> (gn-sir M p IF-B) 0)) (inc p)
   (if (< (- hi p) 5) 0
    (if (and (gn-dot-at? M p OP-LGET 0 1 0)
        (gn-dot-at? M (inc p) OP-CONST 1 (gn-sir M (inc p) IF-B) 0)
        (or (gn-dot-at? M (+ p 2) OP-CMP CC-LT 0 0)
            (gn-dot-at? M (+ p 2) OP-CMP CC-EQ 0 0))
        (gn-dot-at? M (+ p 3) OP-BRZ 0 (gn-sir M (+ p 3) IF-B) 0))
     (let [a (srf-tree M (+ p 4) lo hi (inc depth)) le (gn-sir M (+ p 3) IF-B)]
      (if (or (<= a 0) (< (- hi a) 3)) 0
       (if (and (gn-dot-at? M a OP-BR (gn-sir M a IF-A) 0 0)
                (gn-dot-at? M (inc a) OP-LABEL le 0 0)
                (srf-owned M (dec lo) (inc hi) le (inc a)))
        (let [b (srf-tree M (+ a 2) lo hi (inc depth)) lx (gn-sir M a IF-A)]
         (if (and (> b 0) (< b hi) (not= le lx)
               (gn-dot-at? M b OP-LABEL lx 0 0)
               (srf-owned M (dec lo) (inc hi) lx b)) (inc b) 0)) 0))) 0)))))
(defn- srf-unique-origin [M :vector-i64 f :i64 at :i64] :bool
 (loop [g 1 seen 0]
  (if (= g (vector-at M MM-FN-N)) (= seen 1)
   (let [p (gn-fnf M g FF-SIR)]
    (and (> p 0) (< p (vector-at M MM-SIR-N))
     (or (not= p at) (= g f))
     (recur (inc g) (+ seen (if (= p at) 1 0))))))))
(defn- srf-return-positive [M :vector-i64 f :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (< f MM-FN-CAP)
  (let [a (gn-fnf M f FF-SIR)]
   (and (> a 0) (< a (- (vector-at M MM-SIR-N) 3))
    (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-NSLOTS) 1)
    (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-RTYPE) TY-I64)
    (= (gn-fnf M f FF-PT0) TY-I64) (= (gn-fnf M f FF-FUEL) 0)
    (gn-dot-at? M a OP-FN f 1 1) (srf-unique-origin M f a)
    (= (gn-op M (inc a)) OP-LABEL)
    (let [p (+ a 2) hi (srf-limit M (+ a 2) f)]
     (and (> hi p) (srf-owned M (inc a) (inc hi) (gn-sir M (inc a) IF-A) (inc a))
      (= (srf-tree M p p hi 0) (dec hi)) (gn-dot-at? M (dec hi) OP-RET 0 0 0)))))))
(defn- srf-admit [M :vector-i64 i :i64 bop :i64 t :i64] :bool
 (and (srf-counts M) (= bop BOP-QUOT) (> i 1) (< i (- (vector-at M MM-SIR-N) 1))
  (>= t 0) (< t (- gn-cap 1)) (< (inc t) (gn-g M gn-f-dp))
  (= (gn-g M gn-f-h) (+ t 2)) (= (gn-g M gn-f-dead) 0)
  (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-ctx) 1)
  (= (gn-g M gn-f-freg) 0) (not= (gn-g M gn-f-leaf) 2)
  (gn-dot-at? M i OP-BIN BOP-QUOT t 0)
  (= (gn-op M (dec i)) OP-CALL) (= (gn-sir M (dec i) IF-B) (inc t))
  (= (gn-sir M (dec i) IF-C) 1)
  (= (gn-dk M (inc t)) gn-k-reg) (>= (gn-dv M (inc t)) 0) (< (gn-dv M (inc t)) 31)
  (srf-return-positive M (gn-sir M (dec i) IF-A))))
(defn- srf-emit [M :vector-i64 i :i64 t :i64] :vector-i64
 (let [s (gn-co M i t) d (gn-dreg M t s) m (gn-protect M t s)
       x (gn-src m t 16 0) y (gn-src m (inc t) 17 0)]
  (-> m (gn-ldt t 16 0) (gn-ldt (inc t) 17 0)
        (gn-emit (enc-cmn-i y 1)) (gn-emit (enc-sdiv d x y)) (gn-fin t s d))))
;; ADR0357 one-off semantic algorithm: source-owned repeated frame reads.
;; The original BIN emitter runs first; only two identical redundant reads
;; in its newly emitted straight-line prefix may be removed.
(defn- spr-extent [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS) (= (vector-at M MM-ERR) 0)
  (> (vector-at M MM-SIR-N) 1) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (> (vector-at M MM-NODE-N) 1) (<= (vector-at M MM-NODE-N) MM-NODE-CAP)
  (> (vector-at M MM-LABEL-N) 0) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)
  (>= (vector-at M MM-CODE-N) 5) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 4))
  (>= (vector-at M MM-HEAP-TOP) MM-HEAP-BASE)
  (<= (vector-at M MM-HEAP-TOP) MM-HEAP-END)
  (>= (vector-at M gn-cell) MM-HEAP-BASE)
  (<= (vector-at M gn-cell) (- (vector-at M MM-HEAP-TOP) (+ gn-a-lp MM-LABEL-CAP 91)))))
(defn- spr-label-clear [M :vector-i64 l :i64 first :i64 last :i64] :bool
 (if (>= l (vector-at M MM-LABEL-N)) true
  ;; Read actual source-owned label records, not gn-lpos current-function cache.
  (let [j (vector-at M (+ MM-LABEL-BASE l))]
   (and (not (and (> j first) (<= j last)))
        (spr-label-clear M (inc l) first last)))))
(defn- spr-shape [M :vector-i64 i :i64 bop :i64 t :i64] :bool
 (and (= bop BOP-SUB) (spr-extent M) (> i 6)
  (< i (vector-at M MM-SIR-N)) (>= t 0) (< t 7)
  (< (inc t) (gn-g M gn-f-dp)) (= (gn-g M gn-f-h) (+ t 2))
  (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
  (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
  (or (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-freg) 1))
  (or (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-leaf) 1))
  (> (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768)
  (= (gn-dk M t) gn-k-local) (= (gn-dk M (inc t)) gn-k-local)
  (let [a (gn-dv M t) b (gn-dv M (inc t)) f (smf-owner M i 1024)]
   (and (> f 0) (> a 0) (> b 0) (not= a b)
    (<= a (gn-g M gn-f-ns)) (<= b (gn-g M gn-f-ns))
    (< a gn-cap) (< b gn-cap) (= (gn-sreg M a) -1) (= (gn-sreg M b) -1)
    (= (gn-fnf M f FF-NSLOTS) (gn-g M gn-f-ns))
    (= (gn-fnf M f FF-DEPTH) (gn-g M gn-f-dp))
    (> (- i 6) (gn-fnf M f FF-SIR))
    (> (gn-fnf M f FF-CODE) 0)
    (<= (gn-fnf M f FF-CODE) (- (vector-at M MM-CODE-N) 4))
    (gn-dot-at? M (- i 6) OP-LGET t a 0)
    (gn-dot-at? M (- i 5) OP-LGET (inc t) b 0)
    (gn-dot-at? M (- i 4) OP-BIN BOP-ADD t 0)
    (= (gn-op M (- i 3)) OP-LSET)
    (= (gn-sir M (- i 3) IF-B) t) (= (gn-sir M (- i 3) IF-C) 0)
    (not= (gn-sir M (- i 3) IF-A) a) (not= (gn-sir M (- i 3) IF-A) b)
    (gn-dot-at? M (- i 2) OP-LGET t a 0)
    (gn-dot-at? M (dec i) OP-LGET (inc t) b 0)
    (gn-dot-at? M i OP-BIN BOP-SUB t 0)))))
(defn- spr-replay [O :vector-i64 n :i64 fixes :i64 labels :i64 frame :i64
                    a :i64 b :i64 p0 :i64 p1 :i64 p2 :i64 store :i64] :vector-i64
 (let [end (vector-at O MM-CODE-N) c (+ MM-CODE-BASE n)]
  (if (or (not= (vector-at O MM-ERR) 0) (< end (+ n 3)) (> end (+ n 4))
      (not= (vector-at O MM-FIX-N) fixes)
      (not= (vector-at O MM-LABEL-N) labels)
      (< a 0) (< b 0) (> a (- frame 8))
      (> b (- frame 8))) O
   (let [off (* 8 (bit-and (u64-shift-right store 10) 4095))
         sub (vector-at O (+ c 2)) d (bit-and sub 31)]
    (if (and
      (= p0 (enc-ldr 16 31 a))
      (= p1 (enc-ldr 17 31 b))
      (= p2 (enc-add-r 9 16 17))
      (= store (enc-str 9 31 off))
      (> frame off) (not= off a) (not= off b)
      (= (vector-at O c) (enc-ldr 16 31 a))
      (= (vector-at O (inc c)) (enc-ldr 17 31 b))
      (< d 31) (= sub (gn-bin-word BOP-SUB d 16 17))
      ;; The optional original result spill remains exactly unchanged.
      (or (= end (+ n 3))
       (let [w (vector-at O (+ c 3)) z (* 8 (bit-and (u64-shift-right w 10) 4095))]
        (and (= w (enc-str d 31 z)) (< z frame))))
      ;; Include zero-word label at the second read, excluding entry at the
      ;; first dominating read itself. No source LABEL appears in the grammar.
      (spr-label-clear O 1 (- n 4) n))
     (let [out (gn-put O c sub)
           out2 (if (= end (+ n 4)) (gn-put out (inc c) (vector-at O (+ c 3))) out)]
      (gn-put out2 MM-CODE-N (- end 2))) O)))))
(defn- spr-op-bin [M :vector-i64 i :i64 bop :i64 t :i64] :vector-i64
 (if (spr-shape M i bop t)
  (let [n (vector-at M MM-CODE-N) c (+ MM-CODE-BASE n)
        fixes (vector-at M MM-FIX-N) labels (vector-at M MM-LABEL-N)
        frame (gn-g M gn-f-fb)
        a (gn-soff M (gn-dv M t)) b (gn-soff M (gn-dv M (inc t)))
        p0 (vector-at M (- c 4)) p1 (vector-at M (- c 3))
        p2 (vector-at M (- c 2)) store (vector-at M (dec c))
        out (srf-original-op-bin M i bop t)]
   (spr-replay out n fixes labels frame a b p0 p1 p2 store))
  (srf-original-op-bin M i bop t)))

(defn- gn-op-bin [M :vector-i64 i :i64 bop :i64 t :i64] :vector-i64
 (if (srf-admit M i bop t) (srf-emit M i t) (spr-op-bin M i bop t)))
;; ADR0357 novel whole-leaf memory-generation witness; no names/IDs/PC dispatch.
;; Runs after existing generator postpasses, before layout/literal placement.
(defn- hld-counts [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS)
  (let [g (vector-at M gn-cell) top (vector-at M MM-HEAP-TOP) size (+ gn-a-lp MM-LABEL-CAP 90)]
   (and (>= g MM-HEAP-BASE) (<= g (- MM-HEAP-END size))
    (>= top (+ g size)) (<= top MM-HEAP-END)))
  (= (vector-at M MM-ERR) 0) (= (gn-g M gn-g-open-n) 0)
  (> (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) 1024) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (> (vector-at M MM-SIR-N) 0) (<= (vector-at M MM-SIR-N) 20000) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (vector-at M MM-CODE-N) 1) (<= (vector-at M MM-CODE-N) MM-CODE-CAP)
  (> (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (> (vector-at M MM-LIT-N) 0) (<= (vector-at M MM-LIT-N) MM-LIT-CAP)
  (> (vector-at M MM-LABEL-N) 0) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)))
(defn- hld-end [M :vector-i64 f :i64 j :i64 left :i64] :i64
 (if (or (<= j 0) (>= j (vector-at M MM-SIR-N)) (<= left 0)) 0
  (cond (= (gn-op M j) OP-END) (if (aw-ins M j OP-END f 0 0) j 0)
   (= (gn-op M j) OP-FN) 0 :else (hld-end M f (inc j) (dec left)))))
(defn- hld-source [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N))) false
  (let [p (gn-fnf M f FF-SIR) np (gn-fnf M f FF-NPARAMS)
    ns (gn-fnf M f FF-NSLOTS) dp (gn-fnf M f FF-DEPTH)]
   (if (or (<= p 0) (>= p (vector-at M MM-SIR-N)) (< np 1) (> np 7)
     (< ns np) (> ns 48) (< dp 1) (> dp 8)
     (not (or (= (gn-fnf M f FF-KIND) FK-PRIV) (= (gn-fnf M f FF-KIND) FK-DEFN)))
     (gn-clamp-open M f) (not= (gn-fnf M f FF-PT0) TY-VEC)
     (not= (gn-fnf M f FF-RTYPE) TY-VEC) (not (aw-ins M p OP-FN f np ns))) false
    (let [end (hld-end M f (inc p) 512)]
     (and (> end p)
      (loop [j (inc p)] (if (= j end) true
       (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
        (and
         (case op
          OP-RT (and (>= b 0) (<= (+ b c) dp)
           (or (and (= a RT-VECTOR-AT) (= c 2)) (and (= a RT-VECTOR-ASSOC-IN-PLACE) (= c 3))))
          OP-LSET (alen-operands M j end ns dp)
          (OP-CONST OP-LGET OP-BIN OP-CMP OP-UN OP-LABEL OP-BR OP-BRZ OP-BRNZ OP-FUEL OP-RET)
           (alen-operands M j end ns dp)
          false)
         (recur (inc j))))))))))))
;; Complete source label ownership, including foreign incoming references.)
(defn- hld-edges [M :vector-i64 f :i64] :bool
 (let [p (gn-fnf M f FF-SIR) end (hld-end M f (inc p) 512)]
  (and (> end p)
   (loop [j (inc p)] (if (= j end) true
    (if (= (gn-op M j) OP-LABEL)
     (let [l (gn-sir M j IF-A)]
      (and (= (alen-source-label M p end l) j)
       (loop [k 1] (if (= k (vector-at M MM-SIR-N)) true
        (let [op (gn-op M k) target (gn-sir M k (if (= op OP-BR) IF-A IF-B))]
         (and (or (not (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ)))
           (not= target l) (and (> k p) (< k end))) (recur (inc k))))))
       (recur (inc j))))
     (recur (inc j))))))))
;; Read/written physical register masks. Unknown instructions refuse.
(defn- hld-bit [r :i64] :i64 (if (= r 31) 0 (i64-shift-left 1 r)))
(defn- hld-kind [w :i64] :i64
 (cond (= w 0xd503201f) 1
  (or (= w 0) (= (bit-and w 0xffe0001f) 0xd4200000)) 2
  (= w (enc-ret)) 3
  (= (bit-and w 0xfc000000) 0x14000000) 4
  (= (bit-and w 0xff000010) 0x54000000) 5
  (= (bit-and w 0x7e000000) 0x34000000) 6
  (= (bit-and w 0xffc00000) 0xf9400000) 7
  (= (bit-and w 0xffc00000) 0xf9000000) 8
  (= (bit-and w 0xffe0fc00) 0xf8607800) 9
  (= (bit-and w 0xffe0fc00) 0xf8207800) 10
  (or (= (bit-and w 0xffc00000) 0xa9400000) (= (bit-and w 0xffc00000) 0xa8c00000)) 11
  (or (= (bit-and w 0xffc00000) 0xa9000000) (= (bit-and w 0xffc00000) 0xa9800000)) 12
  (or (= (bit-and w 0xff800000) 0xd2800000) (= (bit-and w 0xff800000) 0xf2800000)) 13
  (or (= (bit-and w 0xff000000) 0x91000000) (= (bit-and w 0xff000000) 0xd1000000)
      (= (bit-and w 0xff000000) 0xb1000000) (= (bit-and w 0xff000000) 0xf1000000)
      (= (bit-and w 0xffc00000) 0xd3400000) (= (bit-and w 0xffc00000) 0x93400000)
      (= (bit-and w 0xff800000) 0x92000000) (= (bit-and w 0xff800000) 0xb2000000)
      (= (bit-and w 0xff800000) 0xd2000000)) 14
  (or (= (bit-and w 0xff200000) 0x8b000000) (= (bit-and w 0xff200000) 0xcb000000)
      (= (bit-and w 0xff200000) 0xeb000000) (= (bit-and w 0xff200000) 0xab000000)
      (= (bit-and w 0xff200000) 0x8a000000) (= (bit-and w 0xff200000) 0xaa000000)
      (= (bit-and w 0xff200000) 0xca000000) (= (bit-and w 0xffe00c00) 0x9a800000)
      (= (bit-and w 0xffe00c00) 0x9a800400)) 15
  (= (bit-and w 0xffe00000) 0x9b000000) 16
  (or (= (bit-and w 0xffe0fc00) 0x9ac02400) (= (bit-and w 0xffe0fc00) 0x9ac02800)
      (= (bit-and w 0xffe0fc00) 0x9ac02000)) 15
  :else 0))
(defn- hld-read [w :i64] :i64
 (let [k (hld-kind w) d (bit-and w 31) n (bit-and (i64-shift-right w 5) 31)
  r (bit-and (i64-shift-right w 16) 31) a (bit-and (i64-shift-right w 10) 31)]
  (case k
   (1 2 4 5) 0 3 (hld-bit 30) 6 (hld-bit d)
   (7 11 14) (hld-bit n) 8 (bit-or (hld-bit n) (hld-bit d))
   9 (bit-or (hld-bit n) (hld-bit r))
   10 (bit-or (bit-or (hld-bit n) (hld-bit r)) (hld-bit d))
   12 (bit-or (bit-or (hld-bit n) (hld-bit d)) (hld-bit a))
   13 (if (= (bit-and w 0xff800000) 0xf2800000) (hld-bit d) 0)
   15 (bit-or (hld-bit n) (hld-bit r))
   16 (bit-or (bit-or (hld-bit n) (hld-bit r)) (hld-bit a)) -1)))
(defn- hld-write [w :i64] :i64
 (let [k (hld-kind w) d (bit-and w 31) n (bit-and (i64-shift-right w 5) 31)
  a (bit-and (i64-shift-right w 10) 31)]
  (case k
   (1 2 3 4 5 6 8 10) 0
   (7 9 13 14 15 16) (hld-bit d)
   11 (bit-or (bit-or (hld-bit d) (hld-bit a))
    (if (= (bit-and w 0xffc00000) 0xa8c00000) (hld-bit n) 0))
   12 (if (= (bit-and w 0xffc00000) 0xa9800000) (hld-bit n) 0) -1)))
;; Existing typed FIX records are resolved in the plan, never guessed from BL0.
(defn- hld-fix [M :vector-i64 at :i64] :i64
 (loop [k 1 found 0] (if (= k (vector-at M MM-FIX-N)) found
  (if (= (sf-x M k XF-AT) at) (if (> found 0) -1 (recur (inc k) k)) (recur (inc k) found)))))
(defn- hld-target [M :vector-i64 at :i64] :i64
 (let [w (sf-word M at) k (hld-fix M at) kind (hld-kind w)]
  (cond (< k 0) -2
   (> k 0) (let [t (sf-x M k XF-TARGET) fk (sf-x M k XF-KIND)]
    (if (and (= (sf-x M k XF-AUX) 0) (> t 0) (< t (vector-at M MM-LABEL-N))
      (or (and (= fk FX-B26) (= kind 4)) (and (= fk FX-BC19) (= kind 5)) (and (= fk FX-CB19) (= kind 6))))
     (let [to (vector-at M (+ MM-LABEL-BASE t))] (if (and (> to 0) (< to (vector-at M MM-CODE-N))) to -2)) -2))
   (or (= kind 4) (= kind 5) (= kind 6)) (of-dest w at) :else -1)))
;; Fifteen-word standard checked indexed access, exactly same handle x0.
(defn- hld-access [M :vector-i64 at :i64 end :i64] :bool
 (if (> (+ at 15) end) false
  (let [cmp (sf-word M (+ at 9)) ix (bit-and (i64-shift-right cmp 5) 31)
   io (sf-word M (+ at 14)) k (hld-kind io)]
   (and (= (sf-word M at) (enc-ldr 16 7 312))
    (= (sf-word M (+ at 1)) (enc-ldr 16 16 0)) (= (sf-word M (+ at 2)) (enc-sub-i 17 0 1))
    (= (sf-word M (+ at 3)) (enc-cmp-r 17 16)) (= (sf-word M (+ at 4)) (enc-bcond (enc-cond-lo) 2))
    (= (sf-word M (+ at 5)) 0) (= (sf-word M (+ at 6)) (enc-ldr 16 7 320))
    (= (sf-word M (+ at 7)) (gn-e-addsl 16 16 17 4)) (= (sf-word M (+ at 8)) (enc-ldp 17 16 16 0))
    (not= ix 12) (not= ix 13) (not= ix 16) (not= ix 17) (not= ix 31)
    (= cmp (enc-cmp-r ix 16)) (= (sf-word M (+ at 10)) (enc-bcond (enc-cond-lo) 2))
    (= (sf-word M (+ at 11)) 0) (= (sf-word M (+ at 12)) (enc-ldr 16 7 328))
    (= (sf-word M (+ at 13)) (enc-add-r 17 17 ix))
    (or (= k 9) (and (= k 10) (not= (bit-and io 31) 16) (not= (bit-and io 31) 17)))
    (= (bit-and (i64-shift-right io 5) 31) 16)
    (= (bit-and (i64-shift-right io 16) 31) 17)))))
 ;; A handle write is allowed only at a closed ordinary return tail.
(defn- hld-return [M :vector-i64 at :i64 end :i64 F :i64] :bool
 (and (<= (- end at) 16) (= (sf-word M at) (enc-mov-r 0 9))
  (= (hld-fix M at) 0)
  (let [next (inc at)]
   (loop [j (if (and (< next end) (= (sf-word M next) (enc-str 8 7 CTX-FUEL))
                    (= (hld-fix M next) 0)) (inc next) next)]
    (if (>= j end) false
     (let [w (sf-word M j) k (hld-kind w) d (bit-and w 31)
      n (bit-and (i64-shift-right w 5) 31) a (bit-and (i64-shift-right w 10) 31)]
      (and (= (hld-fix M j) 0)
       (cond (= w (enc-mov-sp 31 29))
        (and (< (+ j 2) end) (= (sf-word M (inc j)) (enc-ldp-post 29 30 31 16))
         (= (sf-word M (+ j 2)) (enc-ret)) (= (hld-fix M (inc j)) 0)
         (= (hld-fix M (+ j 2)) 0)
         (or (= (+ j 3) end) (and (= (+ j 4) end)
          (= (sf-word M (+ j 3)) (enc-brk 1)) (= (hld-fix M (+ j 3)) 0))))
        (and (= k 11) (= (bit-and w 0xffc00000) 0xa9400000) (= n 31)
         (>= d 19) (<= d 27) (= a (inc d))
         (< (bit-and (i64-shift-right w 15) 127) 64)
         (<= (+ (* 8 (bit-and (i64-shift-right w 15) 127)) 16) F)) (recur (inc j))
        (and (= k 7) (= n 31) (>= d 19) (<= d 28)
         (<= (+ (* 8 (bit-and (i64-shift-right w 10) 4095)) 8) F)) (recur (inc j))
        :else false))))))))
(defn- hld-owner-code [M :vector-i64 f :i64 end :i64] :bool
 (let [start (gn-fnf M f FF-CODE) p (gn-fnf M f FF-SIR)]
  (and (> start 0) (> end (+ start 16)) (<= (- end start) 512)
   (= (sf-word M start) (enc-stp-pre 29 30 31 -16)) (= (sf-word M (inc start)) (enc-mov-sp 29 31))
   (= (bit-and (sf-word M (+ start 2)) 0xffc003ff) 0xd10003ff)
   (let [F (bit-and (i64-shift-right (sf-word M (+ start 2)) 10) 4095)]
    (and (> F 0) (<= F 496) (= (bit-and F 15) 0)
     (loop [j start] (if (= j end) true
      (let [w (sf-word M j) rd (hld-read w) wr (hld-write w) k (hld-kind w)
       n (bit-and (i64-shift-right w 5) 31) to (hld-target M j)]
       (and (> k 0) (>= rd 0) (>= wr 0)
        (= (bit-and (bit-or rd wr) 61440) 0)
        ;; No non-frame memory write except original fuel publication or a checked payload store.
        (or (not (= k 8)) (= w (enc-str 8 7 CTX-FUEL)) (= w (enc-str 31 7 CTX-FUEL))
          (and (= n 31) (< (* 8 (bit-and (i64-shift-right w 10) 4095)) F)))
        (or (not (= k 10)) (and (>= j (+ start 14)) (hld-access M (- j 14) end)))
        (or (not (= k 12)) (= n 31))
        ;; FP/LR ownership is complete-function, not text absence.
        (or (= (bit-and wr (bit-or (hld-bit 29) (hld-bit 30))) 0)
         (and (= j (inc start)) (= w (enc-mov-sp 29 31)))
         (and (= w (enc-ldp-post 29 30 31 16)) (> j start) (< (inc j) end)
          (= (sf-word M (dec j)) (enc-mov-sp 31 29))
          (= (sf-word M (inc j)) (enc-ret))
          (or (= (+ j 2) end) (and (= (+ j 3) end)
           (= (sf-word M (+ j 2)) (enc-brk 1))))))
        ;; Handle/context never change before the bounded ordinary return tail.
        (= (bit-and wr (hld-bit 7)) 0)
        (or (= (bit-and wr 1) 0) (hld-return M j end F))
        (or (= to -1) (and (>= to (+ start 3)) (< to end)))
        (recur (inc j)))))))))))
;; Exact entry scratch liveness: every reachable alternative overwrites before use.))
(defn- hld-dead [M :vector-i64 at :i64 start :i64 end :i64 r :i64] :bool
 (if (or (< at start) (>= at end) (> (- end start) 512)) false
  (let [seen (vector-alloc 512) queue (vector-assoc! (vector-alloc 1025) 0 at)]
   (loop [qh 0 qt 1]
    (if (= qh qt) true
     (if (or (> qt 1025) (>= qh 1025)) false
      (let [i (vector-at queue qh)]
       (if (or (< i start) (>= i end)) false
        (if (not= (vector-at seen (- i start)) 0) (recur (inc qh) qt)
         (let [w (sf-word M i) bit (hld-bit r) k (hld-kind w) to (hld-target M i)
          mark (vector-assoc! seen (- i start) 1)]
          (cond (not= (bit-and (hld-read w) bit) 0) false
           (or (not= (bit-and (hld-write w) bit) 0) (= k 2) (= k 3)) (recur (inc qh) qt)
           (or (< k 1) (>= qt 1024)) false
           (= k 4) (let [next (vector-assoc! queue qt to)] (recur (inc qh) (inc qt)))
           (or (= k 5) (= k 6))
            (let [next (-> queue (vector-assoc! qt to) (vector-assoc! (inc qt) (inc i)))]
             (recur (inc qh) (+ qt 2)))
           :else (let [next (vector-assoc! queue qt (inc i))] (recur (inc qh) (inc qt))))))))))))))
(defn- hld-head [M :vector-i64 start :i64 end :i64] :i64
 (loop [j (+ start 3)] (if (or (>= j (+ start 32)) (> (+ j 5) end)) 0
  (if (and (= (sf-word M j) (enc-ldr 8 7 CTX-FUEL))
    (= (sf-word M (+ j 1)) (enc-subs-i 8 8 1))
    (= (sf-word M (+ j 2)) (enc-bcond (enc-cond-hs) 3))
    (= (sf-word M (+ j 3)) (enc-str 31 7 CTX-FUEL))
    (= (sf-word M (+ j 4)) (enc-brk 0))) (+ j 5) (recur (inc j))))))
(defn- hld-first [M :vector-i64 head :i64 end :i64] :i64
 (loop [j head] (if (>= j end) 0
  (if (hld-access M j end) j (recur (inc j))))))
(defn- hld-before [M :vector-i64 start :i64 first :i64] :bool
 (loop [j start] (if (= j first) true
  (let [w (sf-word M j) k (hld-kind w) n (bit-and (i64-shift-right w 5) 31)]
   (and (or (< k 7) (> k 12) (= n 31) (= w (enc-ldr 8 7 CTX-FUEL)) (= w (enc-str 31 7 CTX-FUEL)))
    (recur (inc j)))))))
(defn- hld-sp [M :vector-i64 start :i64 end :i64 F :i64] :bool
 (loop [j start] (if (= j end) true
  (let [w (sf-word M j) k (hld-kind w) d (bit-and w 31) n (bit-and (i64-shift-right w 5) 31)
    flagimm (or (= (bit-and w 0xff000000) 0xb1000000) (= (bit-and w 0xff000000) 0xf1000000))]
   (and
    (or (not (and (= k 14) (= d 31) (not flagimm)))
     (= j (+ start 2)) (and (<= (- end j) 8) (= w (enc-mov-sp 31 29))))
    (or (not (and (= k 7) (= n 31))) (<= (+ (* 8 (bit-and (i64-shift-right w 10) 4095)) 8) F))
    (or (not (and (or (= k 11) (= k 12)) (= n 31)))
     (= j start) (and (= w (enc-ldp-post 29 30 31 16)) (<= (- end j) 4))
     (and (= (bit-and w 0xffc00000) 0xa9400000)
      (< (bit-and (i64-shift-right w 15) 127) 64) (<= (+ (* 8 (bit-and (i64-shift-right w 15) 127)) 16) F))
     (and (= (bit-and w 0xffc00000) 0xa9000000)
      (< (bit-and (i64-shift-right w 15) 127) 64)
      (<= (+ (* 8 (bit-and (i64-shift-right w 15) 127)) 16) F)))
    (recur (inc j)))))))
;; P[0..4] = head/end/first/number-of-accesses/kernelwords; per original word map starts at8.
(defn- hld-map-at [P :vector-i64 old :i64] :i64 (+ 8 (* 2 (- old (vector-at P 0)))))
(defn- hld-map [P :vector-i64 old :i64] :i64
 (if (or (< old (vector-at P 0)) (>= old (vector-at P 1))) -1 (vector-at P (hld-map-at P old))))
(defn- hld-plan [M :vector-i64 head :i64 end :i64 first :i64] :vector-i64
 (let [P (-> (vector-alloc 1032) (vector-assoc! 0 head) (vector-assoc! 1 end) (vector-assoc! 2 first))]
  (loop [D P j head cursor 0 count 0]
   (if (= j end) (-> D (vector-assoc! 3 count) (vector-assoc! 4 cursor))
    (if (hld-access M j end)
     (let [C (loop [V D k 0] (if (= k 15) V
       (recur (-> V (vector-assoc! (hld-map-at V (+ j k))
        (case k 0 cursor 9 cursor 10 (+ cursor 1) 11 (+ cursor 2) 14 (+ cursor 3) -1))
        (vector-assoc! (inc (hld-map-at V (+ j k))) (if (= k 0) 0 1))) (inc k))))]
      (recur C (+ j 15) (+ cursor 4) (inc count)))
     (recur (vector-assoc! D (hld-map-at D j) cursor) (inc j) (inc cursor) count))))))
(defn- hld-plan-targets [M :vector-i64 P :vector-i64] :bool
 (and
  (loop [j (vector-at P 0)] (if (= j (vector-at P 1)) true
   (if (hld-access M j (vector-at P 1))
    (let [io (sf-word M (+ j 14)) dest (bit-and io 31)]
     (and (or (and (= (hld-kind io) 9) (= dest 16))
       (hld-dead M (+ j 15) (vector-at P 0) (vector-at P 1) 16))
      (or (and (= (hld-kind io) 9) (= dest 17))
       (hld-dead M (+ j 15) (vector-at P 0) (vector-at P 1) 17))
      (recur (+ j 15))))
    (let [to (hld-target M j)]
     (and (or (= to -1) (and (>= to (vector-at P 0)) (< to (vector-at P 1))
       (>= (hld-map P to) 0) (= (vector-at P (inc (hld-map-at P to))) 0)))
      (recur (inc j)))))))
  (loop [l 1] (if (= l (vector-at M MM-LABEL-N)) true
   (let [to (vector-at M (+ MM-LABEL-BASE l))]
    (and (or (< to (vector-at P 0)) (>= to (vector-at P 1))
      (= (vector-at P (inc (hld-map-at P to))) 0)) (recur (inc l))))))))
;; Foreign raw or typed branch/address entry cannot bypass the first guard.
(defn- hld-incoming [M :vector-i64 start :i64 end :i64] :bool
 (and
  (loop [k 1] (if (= k (vector-at M MM-FIX-N)) true
   (let [at (sf-x M k XF-AT) t (sf-x M k XF-TARGET) kind (sf-x M k XF-KIND) aux (sf-x M k XF-AUX)
    to (cond
      (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19) (= kind FX-ADRL19))
       (if (and (= aux 0) (> t 0) (< t (vector-at M MM-LABEL-N)))
        (let [dest (vector-at M (+ MM-LABEL-BASE t))] (if (and (> dest 0) (< dest (vector-at M MM-CODE-N))) dest -2)) -2)
      (or (= kind FX-BL26) (= kind FX-ADR19))
       (if (and (> t 0) (< t (vector-at M MM-FN-N))
         (or (= aux 0) (and (= kind FX-BL26) (or (= aux 1) (= aux 2)))))
        (let [dest (gn-fnf M t FF-CODE)]
         (if (and (> dest 0) (< dest (vector-at M MM-CODE-N))
          (< (+ dest aux) (vector-at M MM-CODE-N))) (+ dest aux) -2)) -2)
      (= kind FX-LIT32) (if (and (= aux 0) (> t 0) (< t (vector-at M MM-LIT-N))) -1 -2) :else -2)]
    (and (> at 0) (< at (vector-at M MM-CODE-N)) (not= to -2)
     (or (not= kind FX-LIT32) (and (< (inc at) (vector-at M MM-CODE-N))
       (or (< (inc at) start) (>= at end))))
     (or (<= to start) (>= to end) (and (>= at start) (< at end))) (recur (inc k))))))
  (loop [j 1] (if (= j (vector-at M MM-CODE-N)) true
   (let [w (sf-word M j) branch (of-branch w) to (if (> branch 0) (hld-target M j) -1)]
    (and (or (<= to start) (>= to end) (and (>= j start) (< j end))) (recur (inc j))))))))
(defn- hld-patch [M :vector-i64 at :i64 target :i64 w :i64] :vector-i64
 (let [bits (of-branch w) delta (- target at)
  v (if (= bits 26) (bit-or (bit-and w 0xfc000000) (bit-and delta 0x03ffffff))
      (bit-or (bit-and w 0xff00001f) (i64-shift-left (bit-and delta 0x7ffff) 5)))]
  (gn-put M (+ MM-CODE-BASE at) v)))
(defn- hld-guard [M :vector-i64 G :vector-i64 c :i64] :vector-i64
 (let [k (vector-at G 0) at (vector-at M MM-CODE-N)]
  (gn-emit (do (vector-assoc! G (inc k) at) (vector-assoc! G 0 (inc k)) M) (enc-bcond c 0))))
(defn- hld-disjoint [M :vector-i64 G :vector-i64 a :i64 ae :i64 b :i64 be :i64] :vector-i64
 (-> M (gn-emit (enc-cmp-r ae b)) (gn-emit (enc-bcond 9 3))
  (gn-emit (enc-cmp-r be a)) (hld-guard G 8)))
;; Only scratch9/11/16/17 are entry-dead. x10 is saved to original-unused14.
;; x12/13 are the witness; 14/15 are original-unused guard scratch.
(defn- hld-runtime [M :vector-i64 G :vector-i64] :vector-i64
 (let [m0 (-> M (gn-emit (enc-mov-r 14 10))
   (gn-emit (+ (enc-add-i 9 7 400) 0x20000000)) (hld-guard G (enc-cond-hs))
   (gn-emit (enc-mov-sp 12 31)) (gn-emit (+ (enc-add-i 17 29 16) 0x20000000)) (hld-guard G (enc-cond-hs))
   (hld-disjoint G 7 9 12 17)
   (gn-emit (enc-ldr 11 7 312)) (gn-emit (+ (enc-add-i 13 11 8) 0x20000000)) (hld-guard G (enc-cond-hs))
   (hld-disjoint G 11 13 7 9) (hld-disjoint G 11 13 12 17)
   (gn-emit (enc-ldr 16 11 0)) (gn-mov-imm 15 67108864)
   (gn-emit (enc-cmp-r 16 15)) (hld-guard G (enc-cond-hs))
   (gn-emit (enc-sub-i 13 0 1)) (gn-emit (enc-cmp-r 13 16)) (hld-guard G (enc-cond-hs))
