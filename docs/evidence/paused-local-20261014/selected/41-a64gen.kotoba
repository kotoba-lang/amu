(defn- pz-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i) f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B)
       h (gn-sir M (+ p 2) IF-A) b (gn-sir M (+ p 6) IF-B) e (gn-sir M (+ p 8) IF-A)]
  (if (and (> p 0) (< (+ p 27) (vector-at M MM-SIR-N))
