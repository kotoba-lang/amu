(defn- gn-copy-writer? [M :vector-i64 f :i64] :bool
 (let [p (gn-fnf M f FF-SIR)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0) (< (+ p 8) (vector-at M MM-SIR-N))
