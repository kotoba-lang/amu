   (if (or (<= f 0) (>= f (vector-at M MM-FN-N))
    (> p (- (vector-at M MM-SIR-N) 327))) 0
   (let [tf (gn-sir M (+ p 72) IF-A) limit (gn-sir M (+ p 18) IF-B)
    base (gn-sir M (+ p 10) IF-B)]
    (if (or (<= tf 0) (>= tf (vector-at M MM-FN-N))) 0
    (let [q (gn-fnf M tf FF-SIR)]
     (if (or (<= q 0) (> q (- (vector-at M MM-SIR-N) 67))) 0
