;; Source of the C-free KX64V1 runner (JUN-29). Build it with the Linux selfhost
;; compiler: compile seed/x86_64-kx64-runner.kotoba --target x86_64-linux
;; --output NEW --format kx64-runner. The runner is the x86_64-linux-static
;; runtime (seed/76) in mode 1; this main is linked but never called.
(ns kx64-runner (:export [main]))
(defn main [] :i64 0)
