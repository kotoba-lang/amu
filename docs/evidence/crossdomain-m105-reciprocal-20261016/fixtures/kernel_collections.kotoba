(ns kernel-collections
  (:export [kernel]))

(defn imod [x :i64 m :i64] :i64
  (- x (* (quot x m) m)))

(defn fill [v :vector-i64 seed :i64 i :i64 k :i64] :vector-i64
  (if (< i k)
    (fill (vector-conj v (imod (+ (* seed 31) (* i 17)) 1000003)) seed (+ i 1) k)
    v))

(defn walk [v :vector-i64 i :i64 end :i64 acc :i64] :i64
  (if (< i end)
    (walk v (+ i 1) end (imod (+ (* acc 31) (vector-at v i)) 1000003))
    acc))

(defn kernel [n :i64] :i64
  (let [len (+ 48 (imod n 16))
        seed (+ 7 (imod n 65521))
        v (fill (vector-i64) seed 0 len)
        s1 (walk v 0 (vector-count v) 7)
        j (imod s1 len)
        v2 (vector-assoc v j (imod (+ s1 13) 1000003))
        v3 (vector-drop v2 (imod n 8))
        s2 (walk v3 0 (vector-count v3) s1)]
    s2))
