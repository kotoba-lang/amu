(ns w4k (:export [ld8 st8 ld16 st16 ld32 st32 ld64 st64]))
(defn ld8 [b :i64 n :i64 i :i64] :i64 (kernel-load-u8-4k b n i))
(defn st8 [b :i64 n :i64 i :i64 v :i64] :i64 (kernel-store-u8-4k b n i v))
(defn ld16 [b :i64 n :i64 i :i64] :i64 (kernel-load-u16-4k b n i))
(defn st16 [b :i64 n :i64 i :i64 v :i64] :i64 (kernel-store-u16-4k b n i v))
(defn ld32 [b :i64 n :i64 i :i64] :i64 (kernel-load-u32-4k b n i))
(defn st32 [b :i64 n :i64 i :i64 v :i64] :i64 (kernel-store-u32-4k b n i v))
(defn ld64 [b :i64 n :i64 i :i64] :i64 (kernel-load-u64-4k b n i))
(defn st64 [b :i64 n :i64 i :i64 v :i64] :i64 (kernel-store-u64-4k b n i v))
