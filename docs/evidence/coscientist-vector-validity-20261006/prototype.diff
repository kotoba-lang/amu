+;; Bounded same-local provenance at a previous read argument. Pure prefix only;
+;; writes to the local or temp, control flow and unknown effects refuse.
+(defn- gn-vlocal [M :vector-i64 j :i64 t :i64 s :i64 work :i64] :bool
+ (if (or (<= j 0) (<= work 0)) false
+  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
+   (case op
+    OP-LGET (if (= a t) (= b s) (gn-vlocal M (dec j) t s (dec work)))
+    OP-CONST (and (not= a t) (gn-vlocal M (dec j) t s (dec work)))
+    (OP-BIN OP-CMP OP-UN) (and (not= b t) (gn-vlocal M (dec j) t s (dec work)))
+    OP-LSET (and (not= a s) (gn-vlocal M (dec j) t s (dec work)))
+    OP-FUEL (gn-vlocal M (dec j) t s (dec work))
+    false))))
+;; Dominating successful exact closed reader in this straight-line region.
+;; No branches/labels, capability/runtime mutation, unknown calls or reassignment.
+;; A chain of admitted reads terminates at a real check (strict decreasing j).
+(defn- gn-vdom [M :vector-i64 j :i64 s :i64 work :i64] :bool
+ (if (or (<= j 0) (<= work 0)) false
+  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) n (gn-sir M j IF-C)]
+   (case op
+    (OP-CONST OP-LGET OP-BIN OP-CMP OP-UN OP-FUEL) (gn-vdom M (dec j) s (dec work))
+    OP-LSET (and (not= a s) (gn-vdom M (dec j) s (dec work)))
+    OP-CALL (and (> (gn-affine-reader M j a n) 0)
+              (or (gn-vlocal M (dec j) b s 32) (gn-vdom M (dec j) s (dec work))))
+    false))))
+(defn- gn-vchecked [M :vector-i64 i :i64 t :i64] :bool
+ (and (gn-isk M t gn-k-local) (gn-vdom M (dec i) (gn-dv M t) 64)))
+;; Reload descriptor afresh; only the already-proved handle range check goes.
+;; Per-access length/index checks and fuel/trap publication remain unchanged.
+(defn- gn-vaddr [M :vector-i64 rv :i64] :vector-i64
+ (-> M (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-ldr 16 7 320))
+       (gn-emit (gn-e-addsl 16 16 17 4))))
