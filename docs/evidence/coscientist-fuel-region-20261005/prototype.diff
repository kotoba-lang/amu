+        M4 (gn-region-emit (gn-region-state M3 true) start end) done (vector-at M4 MM-CODE-N)]
+    (-> M4 (gn-put (+ MM-CODE-BASE guard) (enc-bcond (enc-cond-lo) (- slow guard)))
+           (gn-put (+ MM-CODE-BASE jump) (enc-b (- done jump)))
+           (gn-gs gn-f-skip (- end start 1)))))
+
