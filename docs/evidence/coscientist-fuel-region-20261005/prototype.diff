+;; A bounded straight-line region: no control transfer, external call,
+;; allocation, context mutation or handler. Inline reads/writes retain traps.
+(def gn-region-save (+ gn-a-lp MM-LABEL-CAP))
+(defn- gn-region-call [M :vector-i64 j :i64] :i64
+  (gn-call-wrapper M j (gn-sir M j IF-A) (gn-sir M j IF-B) (gn-sir M j IF-C)))
+(defn- gn-region-charge [M :vector-i64 j :i64] :i64
+  (case (gn-op M j)
+    OP-FUEL 1
+    OP-CALL (let [w (gn-region-call M j)] (if (if (>= w 1024) (>= w 1536) (>= w 256)) 1 0))
+    0))
+(defn- gn-region-safe [M :vector-i64 j :i64] :bool
+  (case (gn-op M j)
+    (OP-CONST OP-LGET OP-LSET OP-BIN OP-UN OP-FUEL) true
+    OP-CALL (> (gn-region-call M j) 0)
+    OP-RT (gn-inl (gn-sir M j IF-A) (gn-sir M j IF-B) (gn-sir M j IF-C))
+    false))
+;; Token: end*256 + cost. Hitting the cap refuses, never splits a consumed op.
+(defn- gn-region-end [M :vector-i64 start :i64 j :i64 cost :i64] :i64
+  (cond (or (>= j (vector-at M MM-SIR-N)) (>= (- j start) 128)) 0
+        (gn-region-safe M j) (gn-region-end M start (inc j) (+ cost (gn-region-charge M j)))
+        (>= cost 3) (+ (* j 256) cost)
+        :else 0))
+;; One private reusable snapshot of metadata and temp descriptors; no labels
+;; or local register assignments can change inside an admitted region.
+(defn- gn-region-copy [M :vector-i64 lo :i64 hi :i64 offset :i64 restore :bool] :vector-i64
+  (if (>= lo hi) M
+    (gn-region-copy (if restore (gn-gs M lo (gn-g M (+ offset lo))) (gn-gs M (+ offset lo) (gn-g M lo)))
+                    (inc lo) hi offset restore)))
+(defn- gn-region-state [M :vector-i64 restore :bool] :vector-i64
+  (let [dp (gn-g M gn-f-dp)]
+    (-> M (gn-region-copy 0 16 gn-region-save restore)
+          (gn-region-copy gn-a-dk (+ gn-a-dk dp) (- (+ gn-region-save 16) gn-a-dk) restore)
+          (gn-region-copy gn-a-dv (+ gn-a-dv dp) (- (+ gn-region-save 16 gn-cap) gn-a-dv) restore))))
+(defn- gn-region-emit [M :vector-i64 j :i64 end :i64] :vector-i64
+  (if (or (>= j end) (not= (vector-at M MM-ERR) 0)) M
+    (let [M1 (gn-ins M j (gn-op M j)) skip (gn-g M1 gn-f-skip)]
+      (gn-region-emit (gn-gs M1 gn-f-skip 0) (+ j 1 skip) end))))
+(defn- gn-region [M :vector-i64 start :i64 token :i64] :vector-i64
