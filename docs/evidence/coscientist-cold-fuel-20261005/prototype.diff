+               (gn-emit (enc-bcond (enc-cond-lo) delta)) (gn-emit (enc-str 16 7 CTX-FUEL))))
+      (if (= (gn-g M1 gn-f-freg) 1)
+    (-> M1 (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 3)) (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0)))
+    (-> M1
