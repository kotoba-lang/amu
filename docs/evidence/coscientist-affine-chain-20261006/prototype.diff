+;; Closed affine chain in an actual loop; integer wrap semantics unchanged.
+;; Intermediate high temps must die before any subsequent read. Keep original
+;; frame/locals and final result placement; no callee-register allocation.
+(defn- gn-affine-chain? [M :vector-i64 i :i64 t :i64] :bool
+ (let [a (gn-sir M i IF-B) b (gn-sir M (+ i 3) IF-B)
+       factor (gn-sir M (inc i) IF-B) prefix (gn-dv M (dec t))]
+  (and (>= t 7) (< (inc t) (gn-g M gn-f-dp)) (< (+ i 5) (vector-at M MM-SIR-N))
+       (> a 0) (<= a (gn-g M gn-f-ns)) (> b 0) (<= b (gn-g M gn-f-ns))
+       (>= (gn-sreg M a) 0) (>= (gn-sreg M b) 0)
+       (gn-isk M (dec t) gn-k-const) (>= prefix -4095) (<= prefix 4095)
+       (not= factor 0) (not= factor 1) (not= factor -1)
+       (= (gn-sir M i IF-C) 0)
+       (= (gn-op M (inc i)) OP-CONST) (= (gn-sir M (inc i) IF-A) (inc t)) (= (gn-sir M (inc i) IF-C) 0)
+       (= (gn-op M (+ i 2)) OP-BIN) (= (gn-sir M (+ i 2) IF-A) BOP-MUL) (= (gn-sir M (+ i 2) IF-B) t) (= (gn-sir M (+ i 2) IF-C) 0)
+       (= (gn-op M (+ i 3)) OP-LGET) (= (gn-sir M (+ i 3) IF-A) (inc t)) (= (gn-sir M (+ i 3) IF-C) 0)
+       (= (gn-op M (+ i 4)) OP-BIN) (= (gn-sir M (+ i 4) IF-A) BOP-ADD) (= (gn-sir M (+ i 4) IF-B) t) (= (gn-sir M (+ i 4) IF-C) 0)
+       (= (gn-op M (+ i 5)) OP-BIN) (= (gn-sir M (+ i 5) IF-A) BOP-ADD) (= (gn-sir M (+ i 5) IF-B) (dec t)) (= (gn-sir M (+ i 5) IF-C) 0)
+       (gn-high-loop M i) (gn-kills M (+ i 6) t 16) (gn-kills M (+ i 6) (inc t) 16))))
+(defn- gn-affine-chain [M :vector-i64 i :i64 t :i64] :vector-i64
+ (let [out (dec t) s (gn-co M (+ i 5) out) d (gn-dreg M out s)
+       a (gn-sreg M (gn-sir M i IF-B)) b (gn-sreg M (gn-sir M (+ i 3) IF-B))
+       factor (gn-sir M (inc i) IF-B) prefix (gn-dv M out)
+       M1 (-> M (gn-protect out s) (gn-mov-imm 16 factor)
+              (gn-emit (enc-madd d a 16 b)) (gn-bin-imm BOP-ADD d d prefix)
+              (gn-fin out s d))]
+  (gn-gs M1 gn-f-skip (+ 5 (gn-g M1 gn-f-skip)))))
+
