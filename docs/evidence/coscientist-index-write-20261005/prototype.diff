+(defn- gn-index-charges [M :vector-i64 n :i64] :vector-i64
+  (if (= n 0) M
+    (gn-index-charges (-> M (gn-emit (enc-subs-i 8 8 1))
+       (gn-emit (enc-bcond (enc-cond-hs) 3)) (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))) (dec n))))
+;; Internal results must not coalesce with the caller's following LSET.
+(defn- gn-index-bin [M :vector-i64 bop :i64 t :i64] :vector-i64
