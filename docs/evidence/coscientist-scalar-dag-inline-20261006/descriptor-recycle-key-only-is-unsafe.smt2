(declare-fun index () Int)
(declare-fun key () Int)
(declare-fun used () Int)
(declare-fun cachedLength () Int)
(declare-fun k!0 () Int)
(declare-fun lengths () (Array Int Int))
(declare-fun k!1 () Bool)
(assert (= key 1))
(assert (= cachedLength 3))
(assert (= index 2))
(assert (= used 1))
(assert (= (select lengths key) 1))
(assert (and (>= index 0) (< index cachedLength)))
(assert (not (and (> key 0) (<= key used) (>= index 0) (< index (select lengths key)))))
(model-add index () Int 2)
(model-add key () Int 1)
(model-add used () Int 1)
(model-add cachedLength () Int 3)
(model-del k!0)
(model-add lengths () (Array Int Int) ((as const (Array Int Int)) k!0))
(model-del k!1)
(model-add k!0 () Int (ite k!1 1 (+ 1 1)))
(model-add k!1 () Bool true)

(check-sat)
