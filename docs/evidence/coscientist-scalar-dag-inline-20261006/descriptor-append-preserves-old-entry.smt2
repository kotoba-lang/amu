(declare-fun valid () Bool)
(declare-fun cachedOffset () Int)
(declare-fun key () Int)
(declare-fun offsets () (Array Int Int))
(declare-fun cachedLength () Int)
(declare-fun lengths () (Array Int Int))
(declare-fun used () Int)
(declare-fun newLength () Int)
(declare-fun newOffset () Int)
(assert (>= used 0))
(assert (=> valid
    (and (> key 0)
         (<= key used)
         (= cachedLength (select lengths key))
         (= cachedOffset (select offsets key))
         (>= cachedLength 0)
         (>= cachedOffset 0))))
(assert (>= newLength 0))
(assert (>= newOffset 0))
(assert (let ((a!1 (= cachedLength (select (store lengths (+ used 1) newLength) key)))
      (a!2 (= cachedOffset (select (store offsets (+ used 1) newOffset) key))))
(let ((a!3 (=> valid
               (and (> key 0)
                    (<= key (+ used 1))
                    a!1
                    a!2
                    (>= cachedLength 0)
                    (>= cachedOffset 0)))))
  (not a!3))))
(model-add valid () Bool true)
(model-add cachedOffset () Int (select offsets key))
(model-add cachedLength () Int (select lengths key))

(check-sat)
