(declare-fun oldSavedRegisters () Int)
(declare-fun bankIndex () Int)
(declare-fun writeRegister () Int)
(declare-fun registers () (Array Int Int))
(declare-fun newValue () Int)
(assert (>= oldSavedRegisters 0))
(assert (<= oldSavedRegisters 7))
(assert (>= bankIndex 0))
(assert (< bankIndex 3))
(assert (or (and (>= writeRegister 0) (< writeRegister 19))
    (and (>= writeRegister 19) (< writeRegister (+ 19 oldSavedRegisters)))))
(assert (distinct (select (store registers writeRegister newValue)
                  (+ 19 oldSavedRegisters bankIndex))
          (select registers (+ 19 oldSavedRegisters bankIndex))))

(check-sat)
