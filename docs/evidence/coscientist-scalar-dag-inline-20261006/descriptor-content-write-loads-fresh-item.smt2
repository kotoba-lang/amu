(declare-fun valid () Bool)
(declare-fun cachedOffset () Int)
(declare-fun key () Int)
(declare-fun offsets () (Array Int Int))
(declare-fun cachedLength () Int)
(declare-fun lengths () (Array Int Int))
(declare-fun used () Int)
(declare-fun index () Int)
(declare-fun newValue () Int)
(declare-fun writeAt () Int)
(declare-fun items () (Array Int Int))
(assert (>= used 0))
(assert (=> valid
    (and (> key 0)
         (<= key used)
         (= cachedLength (select lengths key))
         (= cachedOffset (select offsets key))
         (>= cachedLength 0)
         (>= cachedOffset 0))))
(assert valid)
(assert (and (> key 0) (<= key used) (>= index 0) (< index (select lengths key))))
(assert (distinct (select (store items writeAt newValue) (+ cachedOffset index))
          (select (store items writeAt newValue) (+ (select offsets key) index))))
(model-add valid () Bool true)
(model-add cachedOffset () Int (select offsets key))
(model-add cachedLength () Int (select lengths key))

(check-sat)
