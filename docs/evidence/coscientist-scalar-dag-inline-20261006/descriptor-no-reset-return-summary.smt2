(declare-fun valid () Bool)
(declare-fun cachedOffset () Int)
(declare-fun key () Int)
(declare-fun offsets () (Array Int Int))
(declare-fun cachedLength () Int)
(declare-fun lengths () (Array Int Int))
(declare-fun used () Int)
(declare-fun returnedUsed () Int)
(declare-fun returnedOffsets () (Array Int Int))
(declare-fun returnedLengths () (Array Int Int))
(assert (>= used 0))
(assert (=> valid
    (and (> key 0)
         (<= key used)
         (= cachedLength (select lengths key))
         (= cachedOffset (select offsets key))
         (>= cachedLength 0)
         (>= cachedOffset 0))))
(assert valid)
(assert (>= returnedUsed used))
(assert (forall ((quantifiedOldKey Int))
  (=> (and (> quantifiedOldKey 0) (<= quantifiedOldKey used))
      (and (= (select returnedLengths quantifiedOldKey)
              (select lengths quantifiedOldKey))
           (= (select returnedOffsets quantifiedOldKey)
              (select offsets quantifiedOldKey))))))
(assert (let ((a!1 (=> valid
               (and (> key 0)
                    (<= key returnedUsed)
                    (= cachedLength (select returnedLengths key))
                    (= cachedOffset (select returnedOffsets key))
                    (>= cachedLength 0)
                    (>= cachedOffset 0)))))
  (not a!1)))
(model-add valid () Bool true)
(model-add cachedOffset () Int (select offsets key))
(model-add cachedLength () Int (select lengths key))

(check-sat)
