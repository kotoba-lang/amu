 ;; analyse block h as a loop header; on success records loop l = nlp
+;; An access-free counted loop is worth versioning when it repeats an exact positive constant divide.
+(defn- t2-loop-divmagic-value? [M :vector-i64 v :i64] :bool
+  (if (or (t2-gone? M v) (not= (t2-op-of M v) t2-bin) (not= (t2-vf M v t2-f-a) BOP-QUOT)
+          (= (t2-xf M v t2-x-uses) 0)) false
+    (let [x (t2-res M (t2-vf M v t2-f-b)) y (t2-res M (t2-vf M v t2-f-c))]
+      (and (not (t2-isconst? M x)) (t2-isconst? M y) (> (t2-kval M y) 1) (= (gn-pow2 (t2-kval M y)) 0)))))
+(defn- t2-loop-divmagic-vals? [M :vector-i64 v :i64 v1 :i64] :bool
+  (and (< v v1) (or (t2-loop-divmagic-value? M v) (t2-loop-divmagic-vals? M (inc v) v1))))
+(defn- t2-loop-divmagic? [M :vector-i64 b :i64] :bool
+  (if (>= b (t2-g M t2-s-nb)) false
+    (or (and (t2-in-body? M b)
+             (t2-loop-divmagic-vals? M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b)))
+        (t2-loop-divmagic? M (inc b)))))
