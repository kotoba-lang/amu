 ;; temp t is dead at label l (unknown label: live)
 (defn- gn-dead-at [M :vector-i64 l :i64 t :i64] :bool
   (let [p (gn-lpos M l)] (and (> p 0) (gn-kills M (inc p) t 16))))
+;; Before an explicit local update, only preserve aliases that may be read.
+;; The existing bounded kill proof refuses branches/unknown paths. A proved
+;; dead alias needs no old-value materialization, including at a later flush.
+(defn- gn-prot-live [M :vector-i64 lo :i64 hi :i64 x :i64 s :i64 j :i64] :vector-i64
+  (cond (>= lo hi) M
+        (and (not= lo x) (gn-isk M lo gn-k-local) (= (gn-dv M lo) s))
+        (let [next (if (gn-kills M j lo 16) (gn-dset M lo gn-k-reg 0) (gn-mat M lo))]
+          (gn-prot-live next (inc lo) hi x s j))
+        :else (gn-prot-live M (inc lo) hi x s j)))
 ;; the first reader of temp t from instruction j on in straight-line code (n steps): its index, 0 = none or unknown
