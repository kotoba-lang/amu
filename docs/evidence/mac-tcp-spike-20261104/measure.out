to listener: poll->1 revents=0x4 SO_ERROR=0
accepted fd flags O_NONBLOCK=not inherited FD_CLOEXEC=not inherited

-- POLLOUT and partial writes (peer not reading)
wrote 310828 bytes in 19 writes, 1 partial, stopped with errno=35 (EAGAIN=35)
poll POLLOUT while full -> 1 revents=0x4
drained 114636; poll POLLOUT after -> 1 revents=0x4

-- orderly close: read returns 0
poll->1 revents=0x1 read->52 errno=0

-- reset: SO_LINGER {1,0} then close sends RST
connect(nonblock=0) -> 0 errno=0 (ok)
poll->1 revents=0x11 read->-1 errno=54 (ECONNRESET=54)

-- write to a reset peer: SIGPIPE?
connect(nonblock=0) -> 0 errno=0 (ok)
  child (SO_NOSIGPIPE=0) killed by signal 13 (SIGPIPE=13)
connect(nonblock=0) -> 0 errno=0 (ok)
  child (SO_NOSIGPIPE=1): w1=1 w2=-1 errno=32 (EPIPE=32)
