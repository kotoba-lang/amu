F_GETFD before=0 F_SETFD->0 F_GETFD after=1

-- getsockname with port 0
getsockname: len=16 sin_len=16 family=2 port=51963 (asked 0)

-- dial: refused / success (loopback)
getsockname: len=16 sin_len=16 family=2 port=51964 (asked 0)
connect(nonblock=1) -> -1 errno=36 (Operation now in progress)
poll->1 revents=0x11 SO_ERROR=61 (Connection refused)
