+;; Exact five-argument affine-index/signed-value checked vector write.
+;; Keep original nonleaf caller, closed dependencies and leaf fuel transaction.
+(defn- gn-affine-writer [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
+  (let [p (gn-fnf M f FF-SIR) fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
+        q (gn-skiplab M (+ p 1 fuel)) sign (gn-sir M (+ q 7) IF-A)
+        writer (gn-sir M (+ q 8) IF-A) w (gn-wrapper M writer 0 3)]
+    (if (and (> p 0) (= n 5) (<= t 2) (= (gn-g M gn-f-leaf) 0)
+             (not (gn-clamp-open M f)) (not (gn-clamp-open M sign)) (not (gn-clamp-open M writer))
+             (not= (gn-op M (inc i)) OP-RES2)
+             (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 5)
+             (= (gn-wparams M q 0 4) (+ q 4))
+             (= (gn-op M (+ q 4)) OP-BIN) (= (gn-sir M (+ q 4) IF-A) BOP-MUL) (= (gn-sir M (+ q 4) IF-B) 2)
+             (= (gn-op M (+ q 5)) OP-BIN) (= (gn-sir M (+ q 5) IF-A) BOP-ADD) (= (gn-sir M (+ q 5) IF-B) 1)
+             (= (gn-op M (+ q 6)) OP-LGET) (= (gn-sir M (+ q 6) IF-A) 2) (= (gn-sir M (+ q 6) IF-B) 5)
+             (= (gn-op M (+ q 7)) OP-CALL) (= (gn-sir M (+ q 7) IF-B) 2) (= (gn-sir M (+ q 7) IF-C) 1)
+             (> (gn-sign-wrapper M sign 1) 0)
+             (= (gn-op M (+ q 8)) OP-CALL) (= (gn-sir M (+ q 8) IF-B) 0) (= (gn-sir M (+ q 8) IF-C) 3)
+             (or (= w RT-VECTOR-ASSOC-IN-PLACE) (= w (+ RT-VECTOR-ASSOC-IN-PLACE 256)))
+             (= (gn-op M (+ q 9)) OP-RET) (= (gn-sir M (+ q 9) IF-A) 0)
+             (= (gn-op M (+ q 10)) OP-END) (= (gn-sir M (+ q 10) IF-A) f)) q 0)))
+
