+;; x0 is the signed value, x1 the wrapping affine index; operands read
+;; existing caller registers or distinct x0/x16/x17 scratch words. Pinned vector stays in x9..x11.
+(defn- gn-call-affine-writer [M :vector-i64 i :i64 f :i64 t :i64 q :i64] :vector-i64
+  (let [p (gn-fnf M f FF-SIR) outer (= (gn-op M (inc p)) OP-FUEL)
+        sw (gn-sign-wrapper M (gn-sir M (+ q 7) IF-A) 1)
+        ww (gn-wrapper M (gn-sir M (+ q 8) IF-A) 0 3)
+        charged (or outer (>= sw 1536) (>= ww 256)) width (bit-and sw 511)
+        M1 (gn-pin M t) rv (gn-pinned M1 t)
+        rb (gn-src M1 (inc t) 0 1) rs (gn-src M1 (+ t 2) 16 1)
+        rk (gn-src M1 (+ t 3) 17 1) rx (gn-src M1 (+ t 4) 0 1)]
+    (-> M1 (gn-ldt (inc t) 0 1) (gn-ldt (+ t 2) 16 1) (gn-ldt (+ t 3) 17 1)
+        (gn-ctx)
+        (cond-> charged (gn-emit (enc-ldr 8 7 CTX-FUEL))
+                outer (gn-mask-charge))
+        (gn-emit (enc-madd 1 rs rk rb))
+        (cond-> (>= sw 1536) (gn-mask-charge))
+        (gn-ldt (+ t 4) 0 1) (gn-emit (gn-e-bf 0x93400000 0 rx 0 (dec width)))
+        (cond-> (>= ww 256) (gn-mask-charge))
+        (gn-hchk rv 312 320) (gn-vidx 1) (gn-emit (gn-e-strr3 0 16 17))
+        (cond-> charged (gn-emit (enc-str 8 7 CTX-FUEL)))
+        (gn-into 0 t) (gn-take i t 0))))
