+               (gn-mov-imm 17 (+ base 64)) (gn-emit (enc-cmp-r 16 17))) f3 (vector-at M3 MM-CODE-N)
+        M4 (-> M3 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 328))
