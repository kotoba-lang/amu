+         (gn-put (+ MM-CODE-BASE f2) (enc-bcond (enc-cond-hs) (- fallback f2)))
+         (gn-put (+ MM-CODE-BASE f3) (enc-bcond (enc-cond-lo) (- fallback f3)))
