+;; Exact wrapped negative-quotient diamond; caller's divisor is an adjacent
+;; constant 2^shift, shift 1..12. Token 2048+shift, optional fuel bit 512.
+(defn- gn-floor-wrapper [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
+  (let [p (gn-fnf M f FF-SIR) k (gn-sir M (dec i) IF-B)]
+    (if (or (< p 1) (not= n 2) (not= (gn-op M p) OP-FN)
+            (not= (gn-sir M p IF-A) f) (not= (gn-sir M p IF-B) 2)
+            (not= (gn-op M (dec i)) OP-CONST) (not= (gn-sir M (dec i) IF-A) (inc t))
+            (< k 2) (> k 4096) (not= (bit-and k (dec k)) 0)) 0
+      (let [fuel (if (= (gn-op M (inc p)) OP-FUEL) 1 0)
+            q (gn-skiplab M (+ p 1 fuel)) le (gn-sir M (+ q 3) IF-B) lx (gn-sir M (+ q 15) IF-A)]
+        (if (and (> le 0) (> lx 0) (not= le lx)
+                 (and (= (gn-op M (+ q 0)) OP-LGET) (= (gn-sir M (+ q 0) IF-A) 0) (= (gn-sir M (+ q 0) IF-B) 1) (= (gn-sir M (+ q 0) IF-C) 0))
+                 (and (= (gn-op M (+ q 1)) OP-CONST) (= (gn-sir M (+ q 1) IF-A) 1) (= (gn-sir M (+ q 1) IF-B) 0) (= (gn-sir M (+ q 1) IF-C) 0))
+                 (and (= (gn-op M (+ q 2)) OP-CMP) (= (gn-sir M (+ q 2) IF-A) CC-LT) (= (gn-sir M (+ q 2) IF-B) 0) (= (gn-sir M (+ q 2) IF-C) 0))
+                 (and (= (gn-op M (+ q 3)) OP-BRZ) (= (gn-sir M (+ q 3) IF-A) 0) (= (gn-sir M (+ q 3) IF-B) le) (= (gn-sir M (+ q 3) IF-C) 0))
+                 (and (= (gn-op M (+ q 4)) OP-CONST) (= (gn-sir M (+ q 4) IF-A) 0) (= (gn-sir M (+ q 4) IF-B) 0) (= (gn-sir M (+ q 4) IF-C) 0))
+                 (and (= (gn-op M (+ q 5)) OP-CONST) (= (gn-sir M (+ q 5) IF-A) 1) (= (gn-sir M (+ q 5) IF-B) 0) (= (gn-sir M (+ q 5) IF-C) 0))
+                 (and (= (gn-op M (+ q 6)) OP-LGET) (= (gn-sir M (+ q 6) IF-A) 2) (= (gn-sir M (+ q 6) IF-B) 1) (= (gn-sir M (+ q 6) IF-C) 0))
+                 (and (= (gn-op M (+ q 7)) OP-BIN) (= (gn-sir M (+ q 7) IF-A) BOP-SUB) (= (gn-sir M (+ q 7) IF-B) 1) (= (gn-sir M (+ q 7) IF-C) 0))
+                 (and (= (gn-op M (+ q 8)) OP-LGET) (= (gn-sir M (+ q 8) IF-A) 2) (= (gn-sir M (+ q 8) IF-B) 2) (= (gn-sir M (+ q 8) IF-C) 0))
+                 (and (= (gn-op M (+ q 9)) OP-CONST) (= (gn-sir M (+ q 9) IF-A) 3) (= (gn-sir M (+ q 9) IF-B) 1) (= (gn-sir M (+ q 9) IF-C) 0))
+                 (and (= (gn-op M (+ q 10)) OP-BIN) (= (gn-sir M (+ q 10) IF-A) BOP-SUB) (= (gn-sir M (+ q 10) IF-B) 2) (= (gn-sir M (+ q 10) IF-C) 0))
+                 (and (= (gn-op M (+ q 11)) OP-BIN) (= (gn-sir M (+ q 11) IF-A) BOP-ADD) (= (gn-sir M (+ q 11) IF-B) 1) (= (gn-sir M (+ q 11) IF-C) 0))
+                 (and (= (gn-op M (+ q 12)) OP-LGET) (= (gn-sir M (+ q 12) IF-A) 2) (= (gn-sir M (+ q 12) IF-B) 2) (= (gn-sir M (+ q 12) IF-C) 0))
+                 (and (= (gn-op M (+ q 13)) OP-BIN) (= (gn-sir M (+ q 13) IF-A) BOP-QUOT) (= (gn-sir M (+ q 13) IF-B) 1) (= (gn-sir M (+ q 13) IF-C) 0))
+                 (and (= (gn-op M (+ q 14)) OP-BIN) (= (gn-sir M (+ q 14) IF-A) BOP-SUB) (= (gn-sir M (+ q 14) IF-B) 0) (= (gn-sir M (+ q 14) IF-C) 0))
+                 (and (= (gn-op M (+ q 15)) OP-BR) (= (gn-sir M (+ q 15) IF-A) lx) (= (gn-sir M (+ q 15) IF-B) 0) (= (gn-sir M (+ q 15) IF-C) 0))
+                 (and (= (gn-op M (+ q 16)) OP-LABEL) (= (gn-sir M (+ q 16) IF-A) le) (= (gn-sir M (+ q 16) IF-B) 0) (= (gn-sir M (+ q 16) IF-C) 0))
+                 (and (= (gn-op M (+ q 17)) OP-LGET) (= (gn-sir M (+ q 17) IF-A) 0) (= (gn-sir M (+ q 17) IF-B) 1) (= (gn-sir M (+ q 17) IF-C) 0))
+                 (and (= (gn-op M (+ q 18)) OP-LGET) (= (gn-sir M (+ q 18) IF-A) 1) (= (gn-sir M (+ q 18) IF-B) 2) (= (gn-sir M (+ q 18) IF-C) 0))
+                 (and (= (gn-op M (+ q 19)) OP-BIN) (= (gn-sir M (+ q 19) IF-A) BOP-QUOT) (= (gn-sir M (+ q 19) IF-B) 0) (= (gn-sir M (+ q 19) IF-C) 0))
