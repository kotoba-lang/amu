+(defn- gn-call-floor [M :vector-i64 i :i64 t :i64 w :i64] :vector-i64
+  (let [shift (bit-and w 511) divisor (i64-shift-left 1 shift) mask (dec divisor)
+        M1 (if (>= w 2560) (gn-op-fuel M) M)]
+    (if (gn-isk M1 t gn-k-const)
+      (let [v (gn-dv M1 t) z (+ (- 0 v) mask)]
+        (gn-def M1 t gn-k-const (if (< v 0) (- 0 (quot z divisor)) (quot v divisor))))
+      (let [s (gn-co M1 i t) d (gn-dreg M1 t s) x (gn-src M1 t 16 0)]
+        (-> M1 (gn-protect t s) (gn-ldt t 16 0)
+            (gn-emit (enc-cmp-i x 0)) (gn-emit (enc-bcond (enc-cond-ge) 9))
+            (gn-emit (enc-sub-r 16 31 x)) (gn-emit (enc-add-i 16 16 mask))
+            (gn-emit (gn-e-bf 0x93400000 17 16 63 63))
+            (gn-emit (gn-e-bf 0x92400000 17 17 0 (dec shift)))
+            (gn-emit (enc-add-r 16 16 17))
+            (gn-emit (gn-e-bf 0x93400000 16 16 shift 63))
+            (gn-emit (enc-sub-r d 31 16)) (gn-emit (enc-b 2))
+            (gn-emit (gn-e-bf 0x93400000 d x shift 63)) (gn-fin t s d))))))
