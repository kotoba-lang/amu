  "module CID is not a plain base32 CIDv1" :cid-is-a-path
  "locked module declares a different namespace" :block-declares-another-namespace
  "module lock does not pin its own root" :root-not-pinned
  "unknown module lock schema" :bad-schema
  "module lock must pin at least one module" :empty-lock
  "module lock entry must pin a CID" :entry-without-cid
  "module lock exceeds the project module limit" :over-ceiling
  "block store is not readable" :unreadable-store
  "existing block has different bytes for its CID" :store-disagrees
  "--module-lock requires --blocks <dir>" :usage}
