 :adr/workload-contracts
 [{:workload :scalar-multiply :operation "sum 6 * 7 for N iterations"
   :checksum "42 * N" :cold-iterations 1}
  {:workload :balanced-branch
   :operation "sum 41 for the first half and 43 for the second half of even N"
   :checksum "42 * N for even N" :requires-even-iterations true
   :cold-iterations 2}
  {:workload :integer-mix
   :operation "apply xorshift32 to loop-carried state N times"
   :checksum "xorshift32^N(2463534242)" :closed-form-resistant true
   :cold-iterations 1}
  {:workload :vector-allocate-scan
   :operation "construct eight immutable i64 items and xorshift32-select one per iteration"
   :checksum "sum values[xorshift32^i(seed) & 7]"
   :scalar-replacement-eligible true :closed-form-resistant true :cold-iterations 8}
  {:workload :vector-materialize-scan
   :operation "construct eight immutable i64 items, cross a source vector function boundary every 512th iteration, and xorshift32-select one"
   :checksum "sum values[xorshift32^i(seed) & 7], retaining values when i mod 512 = 0"
   :materialization-required true :function-boundary true
   :native-support :private-internal-candidate
   :exported-native-boundary-supported false
   :closed-form-resistant true :cold-iterations 8}]
