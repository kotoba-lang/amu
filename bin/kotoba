#!/usr/bin/env -S npx --no-install nbb
(ns kotoba-driver
  (:require ["node:child_process" :as child]
            ["node:crypto" :as crypto]
            ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as path]))

(def usage
  ["usage: kotoba -M compile <file.kotoba|file.cljk|file.cljc> --target wasm32-browser|wasm32-wasi|x86_64-linux|x86_64-macos|x86_64-windows|aarch64-linux|aarch64-macos|aarch64-windows|aarch64-android|aarch64-ios|js|js-browser|evm [--policy policy.edn] --output <file>"
   "       kotoba -M check <file.kotoba|file.cljk|file.cljc> [--policy policy.edn]"
   "  multi-file (a module declaring (:require [ns :as alias])):"
   "       kotoba -M module-lock <entry> --source-path <dir> --blocks <dir>"
   "       kotoba -M compile --module-lock <lock> --blocks <dir> --target <target> --output <file>"
   "       kotoba -M check <entry> --source-path <dir>  # links the closed graph, emits nothing"
   "       kotoba -M definition-cids <file.kotoba> [--source-path <dir>]  # one CID per top-level function"
   "       kotoba -M worker [--target wasm32|x86_64|aarch64]  # bounded NDJSON on stdin/stdout"
   "       kotoba -M inspect <file.kotoba|file.cljk|file.cljc> [--output interface.edn]"
   "       kotoba -M test <file.kotoba|file.cljk|file.cljc> [--json]  # runs every test-* export on each qualified target"
   "       kotoba -M module-lock <file.kotoba> --blocks <dir> --source-path <dir> [--output kotoba.modules.edn]"
   "       kotoba -M package-aiueos-boot <kernel> [--output BOOTX64.EFI]"
   "       kotoba -M extract-native <file> [--symbol main] [--output program.bin]"
   "       kotoba -M package-ios program.kexe [--entry main] --output program.S [--manifest-output program.edn]"
   "       kotoba -M sbom <artifact> --output artifact.spdx"
   "       kotoba -M attest-release <artifact> --sbom artifact.spdx --target <target> --key key.edn --not-before <epoch> --expires <epoch> --output release.edn"
   "       kotoba -M verify-release release.edn --artifact <artifact> --sbom artifact.spdx --trust trust.edn --now <epoch>"
   "       kotoba -M coverage <coverage-manifest.edn> --dataset <raw-dataset> [--evidence evidence.edn --trust trust.edn --now <epoch>]"
   "       kotoba -M sign-coverage-evidence <claim.edn> --key <key.edn> --output <evidence.edn>"
   "       kotoba -M keygen --output key.edn"
   "       kotoba -M public-key key.edn --output verification-key.edn"
   "       kotoba -M trust-key verification-key.edn --output trust.edn"
   "       kotoba -M measure-runtime --output runtime.edn --loader-output kotoba-loader"
   "       kotoba -M trust-runtime runtime.edn --trust trust.edn --output pinned-trust.edn"
   "       kotoba -M sign program.kexe --key key.edn --expires <epoch> --output signed.kexe"
   "       kotoba -M verify-signed signed.kexe --trust trust.edn [--now <epoch>]"
   "       kotoba -M run signed.kexe --trust trust.edn --runtime runtime.edn --loader kotoba-loader --policy policy.edn --input input.edn --executor-key key.edn --output receipt.edn"
   "       kotoba -M receipt --signed signed.kexe --trust trust.edn --executor-key key.edn --policy policy.edn --input in.edn --result out.edn ..."
   "       kotoba -M verify-receipt receipt.edn --signed signed.kexe --trust trust.edn --policy policy.edn --input in.edn --result out.edn --now <epoch>"
   "       kotoba -M verify-chain receipts.edn --trust trust.edn"
   "       kotoba -M verify <file>"])

(defn fail! [message code]
  (.error js/console message)
  (.exit js/process code))

;; The wasm32 and ordinary (non-aiueos) native target names
;; The split `kotoba.compiler.nbb.wasm-cli` / `kotoba.compiler.nbb.cli`
;; entrypoints cover the targets below without loading the other backend.
;; `x86_64-aiueos-*`/`aarch64-aiueos-*` (ELF64/PE32+ firmware/kernel
;; packaging) stay JVM-only -- see that namespace's own comment for why.
;; Any other `--target` value, or any subcommand besides `compile`/
;; `check`, falls through to the JVM `clojure -M:run` path below
;; unchanged.
(def ^:private nbb-native-targets
  #{"wasm32" "wasm32-browser" "wasm32-wasi" nil
    "x86_64" "x86_64-linux" "x86_64-macos" "x86_64-windows"
    "aarch64" "aarch64-linux" "aarch64-macos" "aarch64-windows"
    "aarch64-android" "aarch64-ios"})

(defn- option [args flag] (second (drop-while #(not= flag %) args)))

(defn- project-mode? [sub-args]
  ;; Neither nbb entrypoint links a project: they compile the one file handed
  ;; to them. Routing a project-mode invocation there drops --source-path /
  ;; --module-lock silently and reports the entry module's `(:require ...)`
  ;; clause as a malformed `:export`. Same guard as bin/amu's `projectMode`.
  (boolean (some #{"--source-path" "--module-lock"} sub-args)))

;; Signing, trust, receipt, release and inspection commands: `signing_cli.cljk`
;; (ported from the JVM CLI on 2026-09-11, ADR 0347's port ledger).
(def ^:private signing-commands
  #{"keygen" "public-key" "trust-key" "trust-runtime" "sign" "verify-signed"
    "verify" "inspect" "receipt" "verify-receipt" "verify-chain"
    "sbom" "attest-release" "verify-release" "package-ios"})

(defn- nbb-native-eligible? [sub-args]
  (let [cmd (first sub-args)]
    (and
     (not (project-mode? sub-args))
     (or (contains? #{"check" "extract-native"} cmd)
         (contains? signing-commands cmd)
         (and (= cmd "worker") (contains? nbb-native-targets (option sub-args "--target")))
         (and (= cmd "compile") (contains? nbb-native-targets (option sub-args "--target")))))))

(defn- nbb-entrypoint [root sub-args]
  (let [command (first sub-args)
        target (option sub-args "--target")
        wasm? (or (= command "check")
                  (nil? target)
                  (.startsWith target "wasm32"))
        filename (cond
                   (contains? signing-commands command) "signing_cli.cljk"
                   (= command "extract-native") "x86_64_cli.cljk"
                   wasm? "wasm_cli.cljk"
                   (.startsWith target "aarch64") "aarch64_cli.cljk"
                   :else "x86_64_cli.cljk")]
    (.join path root "src" "kotoba" "compiler" "nbb" filename)))

;; Both nbb compiler entrypoint families require `kotoba.kir.admission`, whose
;; transitive dependencies include the shared security controls. nbb has no
;; concept of `deps.edn`/tools.deps -- it only
;; resolves namespaces from directories on its own `--classpath`. `clojure
;; -Spath` is the only thing that (a) fetches those pinned git SHAs into
;; `~/.gitlibs` if it isn't already cached there and (b) prints the
;; resulting directories, so it's used here purely as a classpath
;; resolver, not to run any compiler code on the JVM. Its result is cached
;; to a temp file keyed by a hash of `deps.edn`'s bytes so the fast path
;; only pays the JVM-startup + dependency-resolution cost once per distinct
;; `deps.edn` (e.g. once per CI job's checkout), not once per `compile`/
;; `check` call -- callers like `scripts/fuzz-native.cljk` invoke this
;; fast path thousands of times in a loop.
;;
;; That is now the FALLBACK. `deps-lock.edn` records the closure `clojure
;; -Spath` resolved, and `scripts/print-classpath.cljk` reproduces it from git
;; alone -- so the whole fast path runs with no JDK present, which is what
;; "the nbb path does not touch the JVM" was always supposed to mean. The lock
;; is bound to `deps.edn`'s digest and the resolver fails closed on a stale
;; one, so the fallback is for a checkout whose lock has not been regenerated
;; yet, not a second way of getting an answer.
;;
;; Neither resolver may return "" any more. It used to, and the caller carried
;; on with a truncated classpath, so a resolution failure surfaced as
;; `Could not find namespace: kotoba.artifact.core` from somewhere else
;; entirely -- measured directly by stubbing `clojure` out on a cold cache.
(defn- resolver-failure [result]
  (if-let [error (.-error result)]
    (.-message error)
    (let [lines (-> (or (.-stderr result) "")
                    .trim
                    (.split "\n")
                    (.map (fn [line] (.trim line)))
                    (.filter (fn [line] (not= "" line))))
          tail (.join (.slice lines -3) " / ")]
      (.slice (if (= "" tail) (str "exit " (.-status result)) tail) 0 400))))

(defn- resolve-with-lock
  "Answers {:classpath s} or {:reason s}.

  The reason matters. `kotoba.compiler.nbb.classpath` distinguishes a missing
  lock, a digest that no longer matches deps.edn, a pinned checkout that is not
  at its commit, a lock path that does not exist, and a git clone that failed --
  and only two of those are fixed by regenerating the lock. Collapsing all of
  them into \"missing or stale\" sent a Windows runner's transient clone failure
  to the wrong fix (measured 2026-08-18: the lock was byte-fresh, and the job
  ten minutes earlier on the same image resolved it without complaint)."
  [root nbb-cli]
  (let [script (.join path root "scripts" "print-classpath.cljk")]
    (cond
      (not (.existsSync fs (.join path root "deps-lock.edn")))
      {:reason "deps-lock.edn is not present"}

      (not (.existsSync fs script))
      {:reason "scripts/print-classpath.cljk is not present"}

      :else
      ;; Cold hosted runners clone the pinned closure. Preserve git's safe,
      ;; content-addressed partial progress across bounded transient retries
      ;; before considering the JVM fallback.
      (loop [attempt 0 last "no attempt ran"]
        (let [result (.spawnSync child js/process.execPath
                                 (clj->js [nbb-cli "--classpath" (.join path root "src")
                                           script root])
                                 #js {:cwd root :encoding "utf8" :maxBuffer 16777216})
              ok? (and (not (.-error result)) (zero? (or (.-status result) 1)))
              joined (when ok?
                       (-> (.split (.trim (.-stdout result)) "\n")
                           (.map (fn [line] (.trim line)))
                           (.filter (fn [line] (not= "" line)))
                           (.join (.-delimiter path))))
              last (cond (not ok?) (resolver-failure result)
                         (= "" joined) "the resolver printed no entries"
                         :else last)]
          (if (and ok? (not= "" joined))
            {:classpath joined}
            (if (< attempt 2)
              (recur (inc attempt) last)
              {:reason (str "the lock resolver failed three times: " last)})))))))

(defn- security-classpath-entry [root nbb-cli]
  (let [deps-edn (.join path root "deps.edn")
        ;; The resolved directories are rooted under GITLIBS. A digest-only
        ;; cache key lets an isolated clean-clone test publish temporary paths
        ;; that a later normal invocation reuses after they have been deleted.
        ;; Bind the cache to the dependency-store identity as well as deps.edn.
        gitlibs-root (.resolve path (or (.-GITLIBS js/process.env)
                                        (.join path (.homedir os) ".gitlibs")))
        digest (-> (.createHash crypto "sha256")
                   (.update (.readFileSync fs deps-edn))
                   (.update "\u0000")
                   (.update gitlibs-root)
                   (.digest "hex"))
        cache-file (.join path (.tmpdir os) (str "kotoba-security-classpath-" digest ".txt"))]
    (if (.existsSync fs cache-file)
      (.trim (.readFileSync fs cache-file "utf8"))
      ;; The lock is the only resolver; the `clojure -Spath` fallback was
      ;; removed on 2026-09-11 with the rest of the JVM route (owner decision:
      ;; Kotoba and the amu native/nbb compiler only). A lock that does not
      ;; match deps.edn is a refusal that names the fix, never a JVM spawn.
      (let [attempt (resolve-with-lock root nbb-cli)]
        (if-let [resolved (:classpath attempt)]
          (do (.writeFileSync fs cache-file resolved) resolved)
          (fail! (str "error: dependency resolution from deps-lock.edn failed: "
                      (:reason attempt)
                      "\n  There is no JVM fallback. Regenerate the lock with\n"
                      "    nbb scripts/lock-classpath.cljk\n"
                      "  Diagnose with: nbb --classpath src scripts/print-classpath.cljk")
                 70))))))

(let [args (vec *command-line-args*)
      boundary (first args)]
  (cond
    (contains? #{nil "" "-h" "--help"} boundary)
    (doseq [line usage] (println line))

    (contains? #{"-M" "-M:compiler" "-M:compile"} boundary)
    (let [self (.realpathSync fs *file*)
          root (.resolve path (.dirname path self) "..")
          sub-args (subvec args 1)]
      (if (nbb-native-eligible? sub-args)
        ;; Fast path: no `clojure` (JVM) process is spawned at all. A fresh
        ;; nbb process is spawned (not this one) purely so `--classpath`
        ;; can point at `<root>/src` -- `bin/kotoba` itself is invoked via
        ;; its shebang with no classpath flags, so it can't `:require`
        ;; those namespaces directly in its own process. Spawns nbb's own
        ;; `node_modules/nbb/cli.js` directly via `process.execPath`
        ;; (same pattern `scripts/browser-matrix.cljk`'s `nbb!` already
        ;; uses), NOT `npx` -- confirmed live: `spawnSync("npx", ...)`
        ;; fails on Windows CI ("unable to start nbb-native compiler
        ;; runtime") because `npx` resolves to `npx.cmd`, which needs
        ;; shell interpretation `spawnSync` doesn't provide by default;
        ;; `process.execPath` (the current `node`/`node.exe`) is a real,
        ;; directly-executable binary on every platform.
        (let [nbb-cli (.join path root "node_modules" "nbb" "cli.js")
              security-cp (security-classpath-entry root nbb-cli)
              ;; `<root>/resources` is joined explicitly rather than relying on
              ;; the relative `resources` entry `clojure -Spath` happens to
              ;; emit: the lock records dependency checkouts, and this
              ;; repository's own directories are not a dependency of itself.
              classpath (str (.join path root "src") (.-delimiter path)
                             (.join path root "resources") (.-delimiter path)
                             security-cp)
              ;; Keep the compiler's recursive closed-form oracle below one
              ;; explicit, cross-runner budget. Some hosted Node builds expose
              ;; only ~512 KiB by default, which rejects the admitted lazy
              ;; sequence fixture before Wasm emission.
              result (.spawnSync child js/process.execPath
                                 (clj->js (into ["--stack-size=4096"
                                                 nbb-cli "--classpath"
                                                 classpath
                                                 (nbb-entrypoint root sub-args)]
                                                sub-args))
                                 #js {:cwd root :stdio "inherit" :env js/process.env})]
          (when (.-error result)
            (fail! "error: unable to start nbb-native compiler runtime" 70))
          (.exit js/process (or (.-status result) 70)))
        ;; The JVM route is gone (2026-09-11). Everything not on the nbb route
        ;; above used to be handed to `clojure -M:run` / `-M:native-run`; now
        ;; it is a refusal naming the command, the same exit 64 `bin/amu`
        ;; gives. The gap ledger is amu docs/adr `jvm-route-removed`.
        (fail! (str "error: `kotoba -M " (first sub-args)
                    "` has no implementation on the nbb/native route, and the "
                    "JVM route was removed on 2026-09-11 (Kotoba and the amu "
                    "native compiler only). See amu docs/adr, jvm-route-removed.")
               64)))

    :else
    (fail! "error: compiler commands require the -M execution boundary" 2)))
