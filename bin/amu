#!/usr/bin/env node
"use strict";

const { spawnSync } = require("node:child_process");
const { createHash, randomBytes } = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");

const usage = [
  "usage: amu compile <file.kotoba|file.cljk|file.cljc> [--target <target>] [--policy policy.edn] [--jvm-free] --output <file>",
  "       (no --target: this host's native target, e.g. aarch64-macos / x86_64-linux;",
  "        AMU_TARGET overrides it; wasm32-browser / wasm32-wasi are chosen explicitly)",
  "       amu check <file.kotoba|file.cljk|file.cljc> [--policy policy.edn] [--jvm-free]",
  "  multi-file (a module declaring (:require [ns :as alias])):",
  "       amu module-lock <entry> --source-path <dir> --blocks <dir>",
  "       amu compile --module-lock <lock> --blocks <dir> --target <target> --output <file>",
  "       (both halves run without a JDK; add --jvm-free to prove it)",
  "       amu check <entry> --source-path <dir>            # links, emits nothing",
  "       (a template module -- (ns lib (:params [elem]) ...) -- is instantiated per",
  "        importer binding: (:require [lib :as l :with {elem :i64}]); ADR 0346)",
  "  packages (a signed, CID-pinned kotoba.lock.edn supplying the dependencies):",
  "       amu check <entry> --source-path <dir> --package-lock kotoba.lock.edn \\",
  "         --packages <dir> [--trust trust.edn]",
  "       amu package-manifest <package root> --name <n> --version <v> \\",
  "         --url <git url> --key key.edn",
  "       amu package-fetch --deps kotoba.deps.edn --packages <dir>",
  "       amu package-lock --deps kotoba.deps.edn --packages <dir> --output kotoba.lock.edn",
  "       amu definition-cids <file> [--source-path <dir>]  # one CID per definition",
  "       amu compile <entry> --source-path <dir> --unpinned --target <target> --output <file>",
  "       amu worker [--target <target>]   (no --target: this host's native target)",
  "       amu inspect <file.kotoba|file.cljk|file.cljc> [--output interface.edn]",
  "       amu test <file.kotoba|file.cljk|file.cljc> [--json] [--fuel <n>] [--source-path <dir> ...]   (one instance per test)",
  "       amu module-lock <file.kotoba> --blocks <dir> --source-path <dir>",
  "       amu package-aiueos-boot <kernel> [--output BOOTX64.EFI]",
  "       amu extract-native <file> [--symbol main] [--output program.bin]",
  "       amu package-ios program.kexe [--entry main] --output program.S",
  "       amu sbom <artifact> --output artifact.spdx",
  "       amu attest-release <artifact> --sbom artifact.spdx --target <target> ...",
  "       amu verify-release release.edn --artifact <artifact> --sbom artifact.spdx --trust trust.edn",
  "       amu coverage <coverage-manifest.edn> --dataset <raw-dataset>",
  "       amu keygen --output key.edn",
  "       amu measure-runtime --output runtime.edn --loader-output kotoba-loader",
  "       amu sign program.kexe --key key.edn --expires <epoch> --output signed.kexe",
  "       amu run signed.kexe --trust trust.edn --runtime runtime.edn --loader kotoba-loader ...",
  "       amu verify <file>",
  "       amu sign-output-set <artifact> --key key.edn --not-before <epoch> --expires <epoch>",
  "       amu verify-output-set <artifact> [--attestation FILE --trust FILE --now <epoch>]",
  "       amu <other compiler command> ...",
];

// The aiueos profiles joined this set once the nbb driver gained a packaging
// step (kotoba/compiler/nbb/native_package.cljs). Until then `os/aiueos` built
// every kernel object through `clojure`, not because code generation needed a
// JVM -- these targets reach the same two ISA emitters as the plain ones --
// but because only the JVM CLI ran `elf64/package-kernel-object` on the sealed
// artifact. Both packagers are portable .cljc and load unchanged under nbb.
// `undefined` left this set on 2026-09-24 (ADR 0351). An omitted --target
// used to ride it onto the Wasm driver, because `nbbEntrypoint` read
// `target === undefined` as "wasm". The launcher now resolves an omitted
// target to a NAME before routing (`defaultTarget` below), so nothing reaches
// this set without one.
const nbbNativeTargets = new Set([
  "wasm32", "wasm32-browser", "wasm32-wasi",
  "x86_64", "x86_64-linux", "x86_64-macos", "x86_64-windows",
  "aarch64", "aarch64-linux", "aarch64-macos", "aarch64-windows",
  "aarch64-android", "aarch64-ios",
  "x86_64-aiueos-kernel-v1", "x86_64-aiueos-user-v1", "x86_64-aiueos-uefi-v1",
  "aarch64-aiueos-kernel-v1",
  // The EVM backend is portable .cljc and its nbb parity is already asserted
  // against the JVM's pinned bytes (test/nbb/run.cljk evm case), so the only
  // thing the JVM did here was host the CLI. `evm_cli.cljs` now hosts it.
  // The full profile name is accepted beside the CLI spellings because
  // `--target evm256-kotoba-v1` is what the JVM CLI's own parse-target table
  // documents, and a flag that works on one route but not the other would be
  // the silent fork this launcher exists to prevent.
  "evm", "evm256", "evm256-kotoba-v1",
]);

// The restricted-ESM targets. The emitter (kotoba-lang/kotoba-script) is
// portable .cljc since 2026-09-06 and its nbb bytes are asserted against the
// JVM's (that repo's test/nbb/parity.cljs, and test/nbb/js_parity.cljk here
// against runtime/http/route-decide.mjs), so `js_cli.cljs` hosts these the
// way `evm_cli.cljs` hosts the EVM. `cljs-browser` is deliberately absent:
// that backend emits ClojureScript source text and stays on the JVM route.
const nbbJsTargets = new Set([
  "js", "javascript", "web", "js-kotoba-v1", "js-browser", "js-browser-kotoba-v1",
  // The ClojureScript-source emitter joined the nbb route on 2026-09-11
  // (ADR 0347): `js_cli.cljk`'s `compile-cljs!`.
  "cljs", "cljs-browser", "cljs-node",
  "cljs-kotoba-v1", "cljs-browser-kotoba-v1", "cljs-node-kotoba-v1",
]);

// The host's native target, for a compile or worker that names none (ADR
// 0351, following superproject ADR-2609241300: amu's native compiler is the
// first execution path; wasm is a build target chosen for hosts where native
// cannot run). The same rule as Go's GOOS/GOARCH, Rust's host triple and
// Zig's native target: an omitted target means the machine you are on.
//
// Keys are Node's own `process.platform`/`process.arch` spellings; values are
// the names `kotoba.compiler.nbb.cli/targets` accepts. A host missing from
// this table is REFUSED by name -- falling back to wasm32 there would be the
// old default returning silently on exactly the machines nobody measured.
const hostNativeTargets = Object.freeze({
  "darwin/arm64": "aarch64-macos",
  "darwin/x64": "x86_64-macos",
  "linux/arm64": "aarch64-linux",
  "linux/x64": "x86_64-linux",
  "win32/arm64": "aarch64-windows",
  "win32/x64": "x86_64-windows",
  "android/arm64": "aarch64-android",
});

// `host` is injectable so the refusal can be tested without lying to the
// real process; production passes nothing.
function hostNativeTarget(host = { platform: process.platform, arch: process.arch }) {
  const key = `${host.platform}/${host.arch}`;
  const target = hostNativeTargets[key];
  if (target) return { target };
  return {
    reason: `error: --target was omitted and this host (${key}) has no amu native `
      + "target, so there is no host default. amu does not fall back to wasm: "
      + "pass --target explicitly (wasm32-browser for a browser or Worker, "
      + "wasm32-wasi for a WASI host, or one of "
      + Object.values(hostNativeTargets).join(", ")
      + " to cross-compile), or set AMU_TARGET.",
  };
}

// The commands a default applies to: the two that choose a code generator.
// Everything else either takes no target (check, module-lock, ...) or reads
// it from an artifact it is handed.
const defaultedCommands = new Set(["compile", "worker"]);

// Answers `{args, origin}` or `{reason}`. `origin` is "explicit" when the
// caller wrote --target, "env" when AMU_TARGET supplied it, "host" when the
// host table did, and null for a command no default applies to. An explicit
// flag always wins; an empty AMU_TARGET is treated as unset, the way
// `AMU_TARGET= amu ...` is written to unset it.
function defaultTarget(args, env = process.env, host = undefined) {
  if (!defaultedCommands.has(args[0])) return { args, origin: null };
  if (args.includes("--target")) return { args, origin: "explicit" };
  const fromEnv = env.AMU_TARGET;
  if (typeof fromEnv === "string" && fromEnv !== "") {
    return { args: [...args, "--target", fromEnv], origin: "env" };
  }
  const resolved = hostNativeTarget(host);
  if (!resolved.target) return { reason: resolved.reason };
  return { args: [...args, "--target", resolved.target], origin: "host" };
}

function fail(message, code) {
  console.error(message);
  process.exit(code);
}

function option(args, flag) {
  const index = args.indexOf(flag);
  return index < 0 ? undefined : args[index + 1];
}

// Project mode used to send every invocation to the JVM, because the nbb
// Wasm/native path compiled exactly the one file it was handed and dropping
// --source-path there did not fail loudly: it admitted the entry module alone
// and reported that module's `(:require ...)` clause as a malformed
// `:export`. Measured 2026-08-30 on org-iso-h264/src/h264/sps.kotoba:
// `compile --source-path <src> --unpinned --target wasm32` exited 65 with
// :kotoba.error/namespace-export-clause through this launcher, and exited 0
// with a 6561-byte .wasm through the JVM entry point that owns the linker.
//
// `kotoba.compiler.project-files` (a Node twin on 2026-08-31, one namespace
// on both hosts since ADR 0348) resolved that half.
// --module-lock stayed on the JVM afterwards, and the refusal was right while
// it lasted: serving a lock-pinned build from the PATH resolver would have
// dropped the pinning without saying so, which is the ambience the lock
// exists to remove. But the consequence was that reproducible and JDK-free
// were mutually exclusive, and Q9 forbids a JVM build dependency -- so the
// answer was to remove the reason for the refusal rather than the refusal.
// `kotoba.compiler.module-lock` (one namespace on both hosts since ADR 0348;
// it was a Node twin before) is the CID resolver, and `module-lock`
// itself (which PRODUCES a lock) runs here too: leaving production on the JVM
// would only have moved the JDK one step upstream of every pinned build.
//
// Nothing about project mode forces the JVM now. This function is gone rather
// than left returning false, because a predicate that always answers the same
// way is a claim nobody rechecks.

// The two `kotoba.native.elf64` twins genuinely disagree about ONE container:
// the x86-64 kernel image, 65,904 bytes from the portable file against 110,872
// from the JVM one, because kotoba-native ADR-0036 keeps the live-boot GDT/TSS
// shim in the JVM twin deliberately.
//
// So routing decides, not the packager. Without --jvm-free this still reaches
// the JVM and still produces the live-boot image, exactly as before; with
// --jvm-free it is refused below, naming why. Making the packager refuse
// unconditionally would have broken a working command for callers who never
// asked for a JDK-free build.
function divergentAiueosKernelImage(args) {
  return option(args, "--target") === "x86_64-aiueos-kernel-v1"
    && option(args, "--artifact") === "image";
}

const divergentImageReason =
  "the portable elf64 twin does not carry the live-boot GDT/TSS shim, so this "
  + "route's x86-64 kernel image is not the JVM's (65,904 vs 110,872 bytes "
  + "measured 2026-08-31). kotoba-native ADR-0036 keeps the two files apart "
  + "deliberately. The kernel OBJECT, the CPL3 user image, the UEFI application "
  + "and the AArch64 kernel image are byte-identical on this route.";

// The trust-plane commands: keys, trust sets, signatures, receipts, inspect.
// One portable implementation (`kotoba.compiler.trust-cli`) since 2026-09-11;
// this set is `kotoba.compiler.trust-cli/commands`, spelled again here because
// the driver decides the route before any Clojure is loaded. `run` and
// `measure-runtime` are `runCommands` above: same route, plus the executor's
// alias closure.
// The two commands that EXECUTE: they build the kexe loader and run an
// artifact under it through kototama.native.executor, which lives under the
// `:native-run` alias of deps.edn (a runtime, kept off the compile closure).
// Their classpath adds that alias's locked entries; nothing else's does.
const runCommands = new Set(["run", "measure-runtime"]);

const trustCommands = new Set(["keygen", "public-key", "inspect", "trust-key",
  "trust-runtime", "sign", "verify-signed", "verify", "receipt",
  "verify-receipt", "verify-chain",
  "sbom", "attest-release", "verify-release", "package-ios",
  "coverage", "sign-coverage-evidence", "package-aiueos-boot"]);

function nbbNativeEligible(args) {
  const command = args[0];
  if (command === "compile" && divergentAiueosKernelImage(args)) return false;
  if (trustCommands.has(command)) return true;
  if (command === "test") return true;
  if (runCommands.has(command)) return true;
  return command === "check" || command === "extract-native"
    || command === "definition-cids"
    || command === "module-lock"
    || command === "package-manifest" || command === "package-lock"
    || command === "package-fetch"
    || command === "verify-output-set" || command === "sign-output-set"

    || (command === "worker" && nbbNativeTargets.has(option(args, "--target")))
    || (command === "compile" && nbbNativeTargets.has(option(args, "--target")))
    || (command === "compile" && nbbJsTargets.has(option(args, "--target")));
}

// Commands that take no --target and are implemented by the Wasm driver's
// namespace, which also hosts the linker, the module-lock writer and the
// package authoring commands. `module-lock` is listed by name since ADR 0351:
// before that it reached `wasm_cli.cljk` only because it carries no --target
// and `target === undefined` meant "wasm" -- so making the omitted target
// mean "host native" without this line would have sent `amu module-lock`
// to the x86-64 / AArch64 driver, which implements only compile and
// extract-native.
const targetIndependentCommands = new Set(["check", "definition-cids",
  "module-lock", "package-manifest", "package-lock", "package-fetch"]);

function nbbEntrypoint(root, args) {
  const command = args[0];
  const target = option(args, "--target");
  const targetIndependent = targetIndependentCommands.has(command);
  // Unreachable from `runCompiler` (compile and worker are given a target by
  // `defaultTarget` first), and refused by name rather than dereferenced if
  // a future caller gets here without one.
  if (!targetIndependent && target === undefined
      && !trustCommands.has(command) && command !== "test"
      && !runCommands.has(command) && command !== "extract-native"
      && !["verify-output-set", "sign-output-set"].includes(command)) {
    fail(`error: internal: \`amu ${command}\` reached routing without a --target`, 70);
  }
  const wasm = targetIndependent
    || (target !== undefined && target.startsWith("wasm32"));
  const filename = ["verify-output-set", "sign-output-set"].includes(command) ? "output_set_cli.cljk"
    : trustCommands.has(command) ? "trust_cli.cljk"
    : command === "test" ? "test_cli.cljk"
    : runCommands.has(command) ? "run_cli.cljk"
    : command === "extract-native" ? "x86_64_cli.cljk"
    : (command === "compile" && nbbJsTargets.has(target)) ? "js_cli.cljk"
    : wasm ? "wasm_cli.cljk"
      : target && target.startsWith("evm") ? "evm_cli.cljk"
        : target.startsWith("aarch64") ? "aarch64_cli.cljk" : "x86_64_cli.cljk";
  return path.join(root, "src", "kotoba", "compiler", "nbb", filename);
}

function spawn(command, args, options = {}) {
  return spawnSync(command, args, {
    cwd: options.cwd,
    encoding: options.encoding,
    maxBuffer: options.maxBuffer,
    stdio: options.stdio,
    env: options.env || process.env,
    shell: false,
  });
}

function resolverFailure(result) {
  if (result.error) return result.error.message;
  const stderr = (result.stderr || "").trim().split(/\r?\n/).map((l) => l.trim())
    .filter(Boolean).slice(-3).join(" / ");
  return (stderr || `exit ${result.status}`).slice(0, 400);
}

// Answers `{entries}` or `{reason}`. The reason matters: the resolver
// distinguishes a missing lock, a lock whose digest no longer matches
// deps.edn, a pinned checkout that is not at its commit, and a git clone that
// failed -- and only two of those are fixed by regenerating the lock. Reporting
// all four as "missing or stale" sent a Windows runner's transient clone
// failure to the wrong fix (measured 2026-08-18: the lock was byte-fresh, the
// job before it on the same image had resolved the same lock fine).
function resolveWithLock(root, nbbCli, alias) {
  const script = path.join(root, "scripts", "print-classpath.cljk");
  if (!fs.existsSync(path.join(root, "deps-lock.edn"))) {
    return { entries: null, reason: "deps-lock.edn is not present" };
  }
  if (!fs.existsSync(script)) {
    return { entries: null, reason: "scripts/print-classpath.cljk is not present" };
  }
  // A cold hosted runner clones the pinned closure from GitHub. A transient
  // fetch failure must not silently demote an otherwise valid lock to the JVM
  // path; git's content-addressed partial progress makes a bounded retry safe.
  let last = "no attempt ran";
  for (let attempt = 0; attempt < 3; attempt += 1) {
    const result = spawn(process.execPath,
      [nbbCli, "--classpath", path.join(root, "src"), script, root,
        ...(alias ? ["--alias", alias] : [])], {
        cwd: root, encoding: "utf8", maxBuffer: 16 * 1024 * 1024,
      });
    if (!result.error && result.status === 0) {
      const entries = result.stdout.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
      if (entries.length > 0) return { entries, reason: null };
      last = "the resolver printed no entries";
    } else {
      last = resolverFailure(result);
    }
  }
  return { entries: null, reason: `the lock resolver failed three times: ${last}` };
}

function readProtectedCache(cacheFile) {
  let descriptor;
  try {
    const noFollow = process.platform === "win32" ? 0 : fs.constants.O_NOFOLLOW;
    descriptor = fs.openSync(cacheFile, fs.constants.O_RDONLY | noFollow);
    const info = fs.fstatSync(descriptor);
    if (!info.isFile()) return null;
    if (process.platform !== "win32"
        && (info.uid !== process.getuid() || (info.mode & 0o022) !== 0)) return null;
    return fs.readFileSync(descriptor, "utf8");
  } catch (_) {
    return null;
  } finally {
    if (descriptor !== undefined) fs.closeSync(descriptor);
  }
}

function admittedClasspath(entries, base, allowedRoots) {
  if (entries.length === 0) return null;
  let roots;
  try {
    roots = allowedRoots.filter((root) => fs.existsSync(root)).map((root) => fs.realpathSync(root));
  } catch (_) {
    return null;
  }
  if (roots.length === 0) return null;
  const admitted = [];
  for (const entry of entries) {
    try {
      const absolute = path.isAbsolute(entry) ? entry : path.resolve(base, entry);
      if (!fs.existsSync(absolute)) return null;
      const resolved = fs.realpathSync(absolute);
      if (!roots.some((root) => resolved === root || resolved.startsWith(`${root}${path.sep}`))) {
        return null;
      }
      admitted.push(resolved);
    } catch (_) {
      return null;
    }
  }
  return admitted.join(path.delimiter);
}

function cachedClasspath(encoded) {
  const entries = encoded.split(path.delimiter).map((entry) => entry.trim()).filter(Boolean);
  if (entries.length === 0
      || entries.some((entry) => !path.isAbsolute(entry) || !fs.existsSync(entry))) return null;
  return entries.join(path.delimiter);
}

function publishPrivateCache(cacheFile, value) {
  const temporary = `${cacheFile}.${process.pid}.${randomBytes(8).toString("hex")}.tmp`;
  try {
    fs.writeFileSync(temporary, value, { encoding: "utf8", mode: 0o600, flag: "wx" });
    fs.renameSync(temporary, cacheFile);
  } finally {
    fs.rmSync(temporary, { force: true });
  }
}

// ALIAS, when given, adds the closure deps-lock.edn recorded for that alias
// (`:lock/alias-entries`) on top of the root closure -- `native-run` for the
// two executing commands, nothing for a compile. The cache is keyed by it,
// so a compile never reads an executing command's classpath or vice versa.
function securityClasspath(root, nbbCli, alias) {
  const depsEdn = path.join(root, "deps.edn");
  const gitlibsRoot = path.resolve(process.env.GITLIBS || path.join(os.homedir(), ".gitlibs"));
  const allowedRoots = [gitlibsRoot, root, path.join(os.homedir(), ".m2", "repository")];
  const digest = createHash("sha256")
    .update(fs.readFileSync(depsEdn)).update("\0").update(gitlibsRoot)
    .update("\0").update(alias || "").digest("hex");
  const cacheFile = path.join(os.tmpdir(), `amu-security-classpath-${digest}.txt`);
  const cacheContents = readProtectedCache(cacheFile);
  if (cacheContents !== null) {
    // The protected file can only have been published from a fully admitted
    // closure by this user. Recheck liveness without repeating every realpath
    // on each compiler invocation.
    const cached = cachedClasspath(cacheContents);
    if (cached) return cached;
  }

  // The lock is the only resolver. There is no `kbb -Spath` fallback any
  // more (2026-09-11, owner decision: the JVM route is removed; Kotoba and the
  // amu native/nbb compiler only). A lock that does not match deps.edn is a
  // refusal that names the fix, never a JVM spawn.
  const lockAttempt = resolveWithLock(root, nbbCli, alias);
  const entries = lockAttempt.entries;
  if (!entries) {
    fail("error: dependency resolution from deps-lock.edn failed; "
      + lockAttempt.reason
      + "\n  There is no JVM fallback. Regenerate the lock with: "
      + "kbb --backend sci scripts/lock-classpath.cljk", 70);
  }
  const resolved = admittedClasspath(entries, root, allowedRoots);
  if (!resolved) {
    fail("error: cannot resolve Amu's dependency closure.\n"
      + "  Regenerate deps-lock.edn with: kbb --backend sci scripts/lock-classpath.cljk\n"
      + "  Diagnose with: kbb --backend sci --classpath src scripts/print-classpath.cljk", 70);
  }
  try {
    publishPrivateCache(cacheFile, resolved);
  } catch (_) {
    // The cache is only an optimization. A hostile or broken shared temp
    // directory may deny publication, but must not deny compilation.
  }
  return resolved;
}

// Flags whose value is always a filesystem location, including ones with no
// extension to recognise it by.
const PATH_VALUED_FLAGS = new Set(["--blocks", "--source-path", "--module-lock",
  "--output", "--policy", "--package-lock", "--packages", "--trust"]);

// Flags whose value is NEVER a filesystem location, however much it looks
// like one. A package name is `<org>/<name>` and a repository URL is full of
// separators, so the "contains a slash" heuristic below rewrites both into
// absolute paths under the caller's cwd. Measured 2026-09-06: `--name
// kotoba-lang/demo-util` reached the backend as
// `/…/wt/amu/kotoba-lang/demo-util`, and the manifest was written with that
// as its package name -- accepted by every check, because a package name is
// only ever compared to itself.
const NON_PATH_FLAGS = new Set(["--name", "--version", "--url", "--kind",
  "--capability", "--target", "--symbol", "--entry"]);

// Extensions this CLI is handed as filesystem paths. A bare word like
// `compile` or `wasm32-browser` has none and is left alone.
// `.kexe` joined on 2026-09-11: the compiler's own sealed-artifact extension
// was not in its own list, so `amu verify prog.kexe` from another directory
// read `prog.kexe` inside the Amu checkout and reported "input could not be
// read" -- the exact failure the paragraph above describes, for the one file
// type every signing and receipt command takes.
const PATH_EXTENSIONS = [
  ".kotoba", ".kexe", ".bin", ".spdx",
  ".edn", ".json", ".wasm", ".wat", ".mjs", ".js", ".cljk", ".cljs", ".cljc",
  ".clj", ".lock", ".txt", ".md", ".c", ".h", ".o", ".a", ".so", ".dylib", ".exe"
];

/**
 * Make caller-relative paths absolute before the backend is spawned.
 *
 * Both spawns below set `cwd: root` — the Amu checkout — so a relative path
 * from the caller was being resolved against THIS repository instead of the
 * directory the user is standing in. The failure is quiet and misdirected:
 * measured 2026-08-31, the same bytes compiled from `/tmp` and failed from a
 * consumer repository with `:decode / "input could not be read"`, which reads
 * as "your source is malformed" when what happened is "I looked somewhere
 * else". A tool that cannot find a file should not describe the file.
 *
 * Only arguments that look like paths are touched: something carrying a
 * separator, or ending in an extension this CLI takes. Subcommands, flags and
 * flag values like `wasm32-browser` match neither and pass through untouched.
 * An argument that is already absolute is left as it is.
 */
function resolveCallerPaths(args, cwd) {
  return args.map((arg, index) => {
    if (typeof arg !== "string" || arg.startsWith("-")) return arg;
    if (path.isAbsolute(arg)) return arg;
    // A DIRECTORY name has neither a separator nor an extension, so the
    // heuristic below cannot see it: `--blocks blocks` and `--source-path src`
    // both read as bare words and were left relative, then resolved against
    // the Amu checkout by the spawn's `cwd: root`. The flag says what the next
    // argument is; use it rather than guessing from the spelling.
    if (PATH_VALUED_FLAGS.has(args[index - 1])) return path.resolve(cwd, arg);
    if (NON_PATH_FLAGS.has(args[index - 1])) return arg;
    const looksLikePath = arg.includes("/") || arg.includes("\\")
      || PATH_EXTENSIONS.some(ext => arg.endsWith(ext));
    return looksLikePath ? path.resolve(cwd, arg) : arg;
  });
}

// `--prelude` is honoured only by the CLJS backend
// (src/kotoba/compiler/backend/cljs.cljk). None of the nbb entry points
// under kotoba.compiler.nbb.* parses it, so on every route this launcher
// sends there the flag changes nothing -- and reports :ok true while doing
// so. Measured 2026-08-30 on 2cb7d3f: a single file calling a
// `lang/stdlib/core.kotoba`-only name (`comp2`) is rejected :subset-reject
// with the flag exactly as it is without it, and `grep -c prelude` over
// wasm_cli / x86_64_cli / aarch64_cli is 0 for each.
//
// An ignored flag that leaves a green build behind is the shape this
// workspace keeps paying for: the caller believes the standard library is
// linked and nothing in the output says otherwise. Refuse instead, and name
// the mechanism that does exist.
function preludeIsIgnored(args) {
  return args.includes("--prelude");
}

function runCompiler(root, rawArgs) {
  const defaulted = defaultTarget(resolveCallerPaths(rawArgs, process.cwd()));
  if (defaulted.reason) fail(defaulted.reason, 64);
  const args = defaulted.args;
  // Tells the native driver where its target came from, so a refusal can say
  // "amu chose this for you" when it did. Written (or removed) on every
  // spawn, so a value in the caller's environment is never believed.
  const childEnv = { ...process.env };
  if (defaulted.origin === "host" || defaulted.origin === "env") {
    childEnv.AMU_TARGET_ORIGIN = defaulted.origin;
  } else {
    delete childEnv.AMU_TARGET_ORIGIN;
  }
  if (nbbNativeEligible(args)) {
    if (preludeIsIgnored(args)) {
      fail("error: --prelude is not implemented on this route and would be "
        + "silently ignored; only the CLJS backend reads it. To share "
        + "definitions across modules use the project route "
        + "(--source-path / --module-lock), which links a closed module "
        + "graph.", 64);
    }
    const nbbCli = path.join(root, "node_modules", "nbb", "cli.js");
    const alias = runCommands.has(args[0]) ? "native-run" : null;
    const classpath = [path.join(root, "src"), path.join(root, "resources"),
      securityClasspath(root, nbbCli, alias)].join(path.delimiter);
    const result = spawn(process.execPath,
      ["--stack-size=4096", nbbCli, "--classpath", classpath, nbbEntrypoint(root, args), ...args], {
        cwd: root, stdio: "inherit", env: childEnv,
      });
    if (result.error) fail("error: unable to start the NBB compiler runtime", 70);
    process.exit(result.status ?? 70);
  }

  // The JVM route is gone (2026-09-11). Until 2026-09-11 anything not on the
  // nbb route above was handed to `kbb -M:run`; that spawn hid every
  // command the nbb route did not implement behind a working JVM, and after
  // the .cljk rename the JVM could not load the CLI anyway. Now the answer is
  // a refusal that names the command and the target, so the gap is visible
  // at the call site and in docs/adr (JVM-route-removed ledger) rather than
  // in a stack trace from clojure.main.
  if (args[0] === "compile" && divergentAiueosKernelImage(args)) {
    fail("error: no nbb-route implementation: " + divergentImageReason, 64);
  }
  const target = option(args, "--target");
  fail("error: `amu " + args[0] + (target ? " --target " + target : "") + "` has no "
    + "implementation on the nbb/native route, and the JVM route was removed on "
    + "2026-09-11 (Kotoba and the amu native compiler only). Commands still to "
    + "port are listed in docs/adr under `jvm-route-removed`.", 64);
}

function main() {
  const rawArgs = process.argv.slice(2);
  if (rawArgs.length === 0 || ["-h", "--help"].includes(rawArgs[0])) {
    process.stdout.write(`${usage.join("\n")}\n`);
    process.exit(0);
  }
  const boundaries = new Set(["-M", "-M:compiler", "-M:compile"]);
  const unwrappedArgs = boundaries.has(rawArgs[0]) ? rawArgs.slice(1) : rawArgs;
  // `--jvm-free` is accepted and means nothing: every invocation is JVM-free
  // now. Kept so the thousands of call sites that spell it keep working.
  const args = unwrappedArgs.filter((arg) => arg !== "--jvm-free");
  if (args.length === 0) fail("error: missing Amu compiler command", 2);
  const root = path.resolve(path.dirname(fs.realpathSync(__filename)), "..");
  runCompiler(root, args);
}

// Required as a module (bin/kotoba, scripts/test-default-target.cljk), this
// file answers the target-defaulting rule and runs nothing: one table, so the
// two launchers cannot disagree about what an omitted --target means.
if (require.main === module) {
  main();
} else {
  module.exports = { hostNativeTargets, hostNativeTarget, defaultTarget };
}
