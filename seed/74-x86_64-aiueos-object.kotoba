;; Native seed extension: x86_64-aiueos-kernel-v1 kernel OBJECT route.
;; Assemble after 71-x86_64-runtime, before the entry module (72/73). The
;; adopted 16-module closure, bootstrap and launcher are unchanged.
;;
;; Emits the linkable aiueos kernel object ABI that aiueos's fail-closed
;; `os/aiueos/scripts/verify-kotoba-kernel-object.py` validates: ELF64
;; ET_REL/EM_X86_64 with no program headers, exactly the seven sections
;; "" .text .data .rela.text .symtab .strtab .shstrtab, exactly one public
;; GLOBAL FUNC in .text, one private 80-byte freestanding context in .data,
;; and exactly one R_X86_64_PC32 addend -4 relocation of the wrapper's
;; `lea r9,[rip+.data]` against the .data symbol. The wrapper mirrors
;; kotoba.native.elf64's package-kernel-object shape: load the private
;; context, replenish the per-call fuel word at context+8, call the local
;; Kotoba entry, return.
;;
;; Boundary (say this, do not round it up): this route emits the object ABI
;; only. It is not the kernel IMAGE route (boot shim, ISR region, sealed
;; fuel), it is not the kernel-object entry allowlist or the fuel-tier table
;; (the public symbol is the source's own single export name and --fuel names
;; the bound), and no emitted object has run in a kernel. The public symbol is
;; not silently renamed: the source's export name is the symbol.

;; The wrapper and its one relocation. The context LEA is the only
;; link-time relocation in the object; the call to the local entry is
;; patched in-compile like every other call.
(defn- xo-replenish [M :vector-i64 fuel :i64] :vector-i64
  (if (<= fuel 2147483647) (xg-bytes (xg-bytes M 0x0841c749 4) fuel 4)
    (xg-bytes (xg-bytes (xg-bytes M 0xba49 2) fuel 8) 0x0851894d 4)))
(defn- xo-shim-len [fuel :i64] :i64 (if (<= fuel 2147483647) 29 35))
(defn- xo-shim [M :vector-i64 fuel :i64 entry :i64] :vector-i64
  ;; lea r9,[rip+context]; mov qword [r9+8], fuel; sub rsp,8;
  ;; call entry; add rsp,8; ret.
  (-> M (xg-bytes 0x0d8d4c 3) (xg-bytes 0 4) (xo-replenish fuel)
      (xg-bytes 0x08ec8348 4) (xg-rel 0xe8 1 1 entry)
      (xg-bytes 0x08c48348 4) (xg-byte 0xc3)))

;; ADR 0373: bounded kernel memory windows. The source library below is appended to
;; the guest source for this route only; its private functions are stubs whose
;; calls this backend replaces by inline code (the way the static route's kxrt-
;; intrinsics are), so the shared frontend, checker and lowering are unchanged and
;; the adopted seed/MANIFEST sources are untouched. M[200] is the first stub's FN
;; (0 = none). Objects append all six stubs; locked projects append the same
;; four memory stubs and obtain port writes from their kernel suffix.
;;
;;   (kernel-load-u32 base length index)      -> the u32 at base + index
;;   (kernel-store-u32 base length index v)   -> v, after storing it as a u32
;;   (kernel-subregion base length offset n)  -> base + offset
;;   (kernel-load-u32-16k base length index) -> the u32 at base + index, length <= 16384, index % 4 = 0
;;
;; Every check is unsigned and traps (ud2) before the access: length <= 512 (the
;; tier of the plain u32 pair), base non-null, index < length, index + 4 <= length;
;; subregion: base non-null, offset <= length, n <= length - offset. The byte
;; sequences are kotoba-native's x86_64.cljk emit-kernel-load-u32 /
;; emit-kernel-store-u32 / emit-kernel-subregion, and so are the displacements.
(def XK-INTR-N 6)
(def XK-INTR-W 12)
(def XK-WINDOW-N 4)
;; ids 6..11 (JUN-556 B): u8, u16 and u64 loads and stores at the 512-byte tier. Object and
;; image routes only: the locked-project route keeps the four memory stubs and the ports.
;; The six extra stubs are appended ONLY to a source that names one of them: every stub is a
;; function, so appending them to all sources would change the bytes of every object the route
;; emits (and so of every pinned aiueos object when it is rebuilt). A source that does not use
;; them compiles to the bytes it always had.
(def XK-WIDTH-FIRST 6)
(def XU-LOCAL-CALL-FLAG 211)
;; JUN-556 D1 (ADR 0380): a private function named extern-<symbol> is a declaration of a function
;; of another object. It is marked FF-EXPORT 9 after admission; its call sites are rebuilt as
;; "call rel32" with an R_X86_64_PLT32 relocation against the undefined GLOBAL symbol <symbol>. A call
;; site is an ordinary function fixup (kind 1) whose target carries the extern mark; the displacement
;; xg-fix wrote is zeroed again before the object is written, the linker's relocation fills it.
;; JUN-556 D3: private cell-load-<k> [] and cell-store-<k> [v] (k < 64) are 8-byte cells in .data after the
;; 80-byte context, at 80 + 8k. The mark carries the cell: 100 + k for a load, 200 + k for a store. An access
;; is mov rax,[rip+disp] / mov [rip+disp],rax with an R_X86_64_PC32 relocation against the context symbol,
;; addend 80 + 8k - 4; the site is a function fixup of the marked stub, zeroed like an extern call.
(def XK-EXTERN 100)
(def XK-CELL-LOAD 20000)
(def XK-CELL-STORE 40000)
(def FF-CELL-LOAD-MARK 100)
(def FF-CELL-STORE-MARK 200)
(def XO-MAX-CELLS 64)
;; JUN-556 D4: private mmio-load32-<addr> [] and mmio-store32-<addr> [v], addr being eight lowercase hex digits
;; of one of five local-APIC registers (the closed list in xo-mmio-address). A load is movabs rax,addr;
;; mov eax,[rax]; a store movabs rcx,addr; mov [rcx],eax. The address is an immediate, so there is no
;; relocation and no data. The mark is 300 + index for a load and 400 + index for a store.
(def XK-MMIO-LOAD 60000)
(def XK-MMIO-STORE 80000)
(def FF-MMIO-LOAD-MARK 300)
(def FF-MMIO-STORE-MARK 400)
(def XO-MMIO-N 5)
;; JUN-556 D3b: a private cell-name-<k>-<symbol> [] gives cell k (the same 8-byte cell cell-load-<k> and
;; cell-store-<k> address) a GLOBAL OBJECT symbol <symbol>, size 8, in .data at 80 + 8k, so other objects
;; (entry.S, C) link to it by name. The mark is 500 + k. At most 16 symbols.
(def FF-CELL-NAME-MARK 500)
(def XO-MAX-DSYMS 16)
(def FF-EXTERN-MARK 9)
;; JUN-556 D5 (ADR 0381): private record-load-<w>-<off>-<N> [b] and record-store-<w>-<off>-<N> [b v], w one of u8 u16 u32 u64,
;; off and N canonical decimals, N a multiple of 4 in 8..256, off a multiple of the width, off + width <= N. They read or
;; write the caller-owned N-byte record that the exported function's parameter b points at, at the literal offset off:
;; mov rdx,[b]; (mov rax,[v];) test rdx,rdx; jz ud2; access [rdx+off]; jmp +2; ud2. There is no relocation, symbol or data.
;; The base must be an unassigned parameter of an exported function, every record access to one parameter names the same
;; N, and that parameter is not also a window base (xk-record-ok?). The mark is 1000 + ((dir * 4 + width index) * 256 + off)
;; * 64 + (N / 4 - 2), dir 0 load 1 store, width index 0..3 for 1, 2, 4, 8 bytes.
(def XK-RECORD 100000)
(def FF-REC-MARK 1000)
(def XO-REC-SPAN 131072)
;; JUN-556 D6 (scratch): private cell-addr-<k> [] returns the ADDRESS of cell k (lea rax,[rip+disp32], the same
;; R_X86_64_PC32 relocation against the context symbol as a cell access, addend 80 + 8k - 4). It is how an extern
;; is handed a place to write: the cells k, k+1, ... that the function also loads are the region, and the object's
;; .data covers exactly the cells some stub names, so the author must load every cell the callee may write. The
;; address is an ordinary value, not a rooted base, so no window or record access accepts it. The mark is
;; 200000 + k.
(def XK-CELL-ADDR 120000)
(def FF-CELL-ADDR-MARK 200000)
(def XO-MAX-EXTERNS 16)
(defn- xk-intr-name [k :i64] :string
  (case k 0 "kernel-load-u32" 1 "kernel-store-u32" 2 "kernel-subregion" 3 "kernel-load-u32-16k"
          4 "kernel-out-u8" 5 "kernel-out-u32"
          6 "kernel-load-u8" 7 "kernel-store-u8" 8 "kernel-load-u16" 9 "kernel-store-u16"
          10 "kernel-load-u64" 11 "kernel-store-u64" ""))
(defn- xk-memory-lib [] :string
  "\n(defn- kernel-load-u32 [b :i64 n :i64 i :i64] :i64 0)\n(defn- kernel-store-u32 [b :i64 n :i64 i :i64 v :i64] :i64 0)\n(defn- kernel-subregion [b :i64 n :i64 o :i64 l :i64] :i64 b)\n(defn- kernel-load-u32-16k [b :i64 n :i64 i :i64] :i64 0)\n")
(defn- xk-lib [] :string
  (string-concat (xk-memory-lib)
    "\n(defn- kernel-out-u8 [p :i64 v :i64] :i64 v)\n(defn- kernel-out-u32 [p :i64 v :i64] :i64 v)\n"))
(defn- xk-width-lib [] :string
  (string-concat "(defn- kernel-load-u8 [b :i64 n :i64 i :i64] :i64 0)\n(defn- kernel-store-u8 [b :i64 n :i64 i :i64 v :i64] :i64 0)\n"
    (string-concat "(defn- kernel-load-u16 [b :i64 n :i64 i :i64] :i64 0)\n(defn- kernel-store-u16 [b :i64 n :i64 i :i64 v :i64] :i64 0)\n"
      "(defn- kernel-load-u64 [b :i64 n :i64 i :i64] :i64 0)\n(defn- kernel-store-u64 [b :i64 n :i64 i :i64 v :i64] :i64 0)\n")))
;; true when the guest source S names one of the six width accesses
(defn- xk-uses-widths? [S :string] :bool
  (or (or (>= (string-index-of S "kernel-load-u8") 0) (>= (string-index-of S "kernel-store-u8") 0))
      (or (or (>= (string-index-of S "kernel-load-u16") 0) (>= (string-index-of S "kernel-store-u16") 0))
          (or (>= (string-index-of S "kernel-load-u64") 0) (>= (string-index-of S "kernel-store-u64") 0)))))
(defn- xk-lib-for [S :string] :string
  (if (xk-uses-widths? S) (string-concat (xk-lib) (xk-width-lib)) (xk-lib)))
;; true when the compiled text carries the width block: its first stub is defined there
(defn- xk-has-width-block? [text :string] :bool
  (>= (string-index-of text "(defn- kernel-load-u8 [b :i64 n :i64 i :i64]") 0))
;; Only the object route recognizes the stubs. The static route (seed/75, M[197] > 0) keeps
;; kxrt-ccall's function id in M[200], so without the M[197] guard the three functions after it
;; would be taken for the store, subregion and 16 KiB load (found by an independent review).
(defn- xk-intr [M :vector-i64 f :i64] :i64
  (let [first (vector-at M 200) k (- f first)]
    (cond (and (= (vector-at M 197) 0) (= (xg-f M f FF-EXPORT) FF-EXTERN-MARK)) (+ XK-EXTERN f)
          (and (= (vector-at M 197) 0) (>= (xg-f M f FF-EXPORT) FF-MMIO-LOAD-MARK) (< (xg-f M f FF-EXPORT) (+ FF-MMIO-LOAD-MARK XO-MMIO-N))) (+ XK-MMIO-LOAD f)
          (and (= (vector-at M 197) 0) (>= (xg-f M f FF-EXPORT) FF-MMIO-STORE-MARK) (< (xg-f M f FF-EXPORT) (+ FF-MMIO-STORE-MARK XO-MMIO-N))) (+ XK-MMIO-STORE f)
          (and (= (vector-at M 197) 0) (>= (xg-f M f FF-EXPORT) FF-CELL-LOAD-MARK) (< (xg-f M f FF-EXPORT) (+ FF-CELL-LOAD-MARK XO-MAX-CELLS))) (+ XK-CELL-LOAD f)
          (and (= (vector-at M 197) 0) (>= (xg-f M f FF-EXPORT) FF-CELL-STORE-MARK) (< (xg-f M f FF-EXPORT) (+ FF-CELL-STORE-MARK XO-MAX-CELLS))) (+ XK-CELL-STORE f)
          (and (= (vector-at M 197) 0) (>= (xg-f M f FF-EXPORT) FF-CELL-ADDR-MARK) (< (xg-f M f FF-EXPORT) (+ FF-CELL-ADDR-MARK XO-MAX-CELLS))) (+ XK-CELL-ADDR f)
          (and (= (vector-at M 197) 0) (>= (xg-f M f FF-EXPORT) FF-REC-MARK) (< (xg-f M f FF-EXPORT) (+ FF-REC-MARK XO-REC-SPAN))) (+ XK-RECORD f)
          (and (= (vector-at M 197) 0) (> first 0) (>= k 0) (< k (if (> (vector-at M 201) 0) XK-WINDOW-N XK-INTR-W))) k
          :else -1)))
(defn- xk-extern-call [M :vector-i64 f :i64 t :i64] :vector-i64
  ;; arguments as for a local call (rdi rsi rdx rcx r8), call rel32 with a function fixup that the
  ;; object writer turns into a PLT32 relocation, then the context register back from [rbp-8]
  ;; (a callee may destroy r9; the fuel charge reads it), then the result as any call result.
  (-> M (xg-call-args t 0 (xg-f M f FF-NPARAMS)) (xg-rel 0xe8 1 1 f)
      (xg-bytes 0xf84d8b4c 4) (xg-save t)))
(defn- xk-intrinsic-window [M :vector-i64 k :i64 t :i64] :vector-i64
  (case k
    ;; mov rdx,[base]; mov rcx,[length]; mov rax,[index]; cmp rcx,512; ja; test rdx,rdx; jz;
    ;; cmp rax,rcx; jae; lea rsi,[rax+4]; cmp rsi,rcx; ja; mov eax,[rdx+rax]; jmp +2; ud2
    0 (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0x858b48)
          (xg-bytes 0xf98148 3) (xg-bytes 512 4) (xg-bytes 0x870f 2) (xg-bytes 36 4)
          (xg-bytes 0xd28548 3) (xg-bytes 0x840f 2) (xg-bytes 27 4)
          (xg-bytes 0xc83948 3) (xg-bytes 0x830f 2) (xg-bytes 18 4)
          (xg-bytes 0x04708d48 4) (xg-bytes 0xce3948 3) (xg-bytes 0x870f 2) (xg-bytes 5 4)
          (xg-bytes 0x02048b 3) (xg-bytes 0x02eb 2) (xg-bytes 0x0b0f 2) (xg-save t))
    ;; mov rdx,[base]; mov rcx,[length]; mov rdi,[index]; mov rax,[value]; cmp rcx,512; ja;
    ;; test rdx,rdx; jz; cmp rdi,rcx; jae; lea rsi,[rdi+4]; cmp rsi,rcx; ja; mov [rdx+rdi],eax;
    ;; jmp +2; ud2 -- rax stays the value
    1 (if (= (vector-at M XU-LOCAL-CALL-FLAG) 1) (xu-local-model-call M t)
        (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0xbd8b48)
          (xg-load (+ t 3) 0x858b48)
          (xg-bytes 0xf98148 3) (xg-bytes 512 4) (xg-bytes 0x870f 2) (xg-bytes 36 4)
          (xg-bytes 0xd28548 3) (xg-bytes 0x840f 2) (xg-bytes 27 4)
          (xg-bytes 0xcf3948 3) (xg-bytes 0x830f 2) (xg-bytes 18 4)
          (xg-bytes 0x04778d48 4) (xg-bytes 0xce3948 3) (xg-bytes 0x870f 2) (xg-bytes 5 4)
          (xg-bytes 0x3a0489 3) (xg-bytes 0x02eb 2) (xg-bytes 0x0b0f 2) (xg-save t)))
    ;; mov rdx,[base]; mov rcx,[length]; mov rdi,[offset]; mov rax,[sublen]; test rdx,rdx; jz;
    ;; cmp rdi,rcx; ja; sub rcx,rdi; cmp rax,rcx; ja; lea rax,[rdx+rdi]; jmp +2; ud2
    2 (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0xbd8b48)
          (xg-load (+ t 3) 0x858b48)
          (xg-bytes 0xd28548 3) (xg-bytes 0x840f 2) (xg-bytes 27 4)
          (xg-bytes 0xcf3948 3) (xg-bytes 0x870f 2) (xg-bytes 18 4)
          (xg-bytes 0xf92948 3) (xg-bytes 0xc83948 3) (xg-bytes 0x870f 2) (xg-bytes 6 4)
          (xg-bytes 0x3a048d48 4) (xg-bytes 0x02eb 2) (xg-bytes 0x0b0f 2) (xg-save t))
    ;; the 16 KiB tier: mov rdx,[base]; mov rcx,[length]; mov rax,[index]; cmp rcx,16384; ja; test rdx,rdx;
    ;; jz; cmp rax,rcx; jae; mov rsi,rcx; sub rsi,rax; cmp rsi,4; jl; test rax,3; ja; mov eax,[rdx+rax];
    ;; jmp +2; ud2 -- kotoba-native's emit-memwidth-window for u32 at 16384 (aligned, and the
    ;; non-wrapping length - index >= 4 form machine-ir uses)
    3 (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0x858b48)
          (xg-bytes 0xf98148 3) (xg-bytes 16384 4) (xg-bytes 0x870f 2) (xg-bytes 58 4)
          (xg-bytes 0xd28548 3) (xg-bytes 0x840f 2) (xg-bytes 49 4)
          (xg-bytes 0xc83948 3) (xg-bytes 0x830f 2) (xg-bytes 40 4)
          (xg-bytes 0xce8948 3) (xg-bytes 0xc62948 3) (xg-bytes 0xfe8148 3) (xg-bytes 4 4)
          (xg-bytes 0x8c0f 2) (xg-bytes 21 4)
          (xg-bytes 0xc0f748 3) (xg-bytes 3 4) (xg-bytes 0x870f 2) (xg-bytes 8 4)
          (xg-bytes 0x02048b 3) (xg-bytes 0xe9 1) (xg-bytes 2 4) (xg-bytes 0x0b0f 2) (xg-save t))
    ;; Port writes take scalars, not a region pair. The instruction truncates
    ;; the port to DX and leaves the original value in RAX, as the owner ABI.
    4 (-> M (xg-load t 0x958b48) (xg-load (inc t) 0x858b48) (xg-byte 0xee) (xg-save t))
    5 (-> M (xg-load t 0x958b48) (xg-load (inc t) 0x858b48) (xg-byte 0xef) (xg-save t))
;; kernel-load-u8: byte at 512, the reference emit-kernel-load-u8 of kotoba-native's x86_64.cljk with the operands read from
;; their frame slots as the plain u32 pair does: cmp rcx,512; ja; test rdx,rdx; jz; cmp rax,rcx; jae; movzx eax,byte [rdx+rax]; jmp +2; ud2
    6 (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0x858b48) (xg-bytes 0x200f98148 7) (xg-bytes 0x18870f 6)
          (xg-bytes 0xd28548 3) (xg-bytes 0xf840f 6) (xg-bytes 0xc83948 3) (xg-bytes 0x6830f 6) (xg-bytes 0x204b60f 4) (xg-bytes 0x2eb 2)
          (xg-bytes 0xb0f 2) (xg-save t))
;; kernel-store-u8: byte at 512, the reference emit-kernel-store-u8 of kotoba-native's x86_64.cljk with the operands read from
;; their frame slots as the plain u32 pair does: cmp rcx,512; ja; test rdx,rdx; jz; cmp rdi,rcx; jae; mov [rdx+rdi],al; jmp +2; ud2
    7 (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0xbd8b48) (xg-load (+ t 3) 0x858b48) (xg-bytes 0x200f98148 7)
          (xg-bytes 0x17870f 6) (xg-bytes 0xd28548 3) (xg-bytes 0xe840f 6) (xg-bytes 0xcf3948 3) (xg-bytes 0x5830f 6) (xg-bytes 0x3a0488 3)
          (xg-bytes 0x2eb 2) (xg-bytes 0xb0f 2) (xg-save t))
;; kernel-load-u16: 2 bytes at 512, the reference emit-memwidth-window of kotoba-native's x86_64.cljk with the operands read from
;; their frame slots as the plain u32 pair does: cmp rcx,512; ja; test rdx,rdx; jz; cmp rax,rcx; jae; mov rsi,rcx; sub rsi,rax; cmp rsi,2; jl; test rax,1; ja; movzx eax,word [rdx+rax]; jmp +2; ud2
    8 (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0x858b48) (xg-bytes 0x200f98148 7) (xg-bytes 0x38870f 6)
          (xg-bytes 0xd28548 3) (xg-bytes 0x2f840f 6) (xg-bytes 0xc83948 3) (xg-bytes 0x26830f 6) (xg-bytes 0xce8948 3) (xg-bytes 0xc62948 3)
          (xg-bytes 0x2fe8148 7) (xg-bytes 0x138c0f 6) (xg-bytes 0x1c0f748 7) (xg-bytes 0x6870f 6) (xg-bytes 0x204b70f 4)
          (xg-bytes 0x2eb 2) (xg-bytes 0xb0f 2) (xg-save t))
;; kernel-store-u16: 2 bytes at 512, the reference emit-memwidth-window of kotoba-native's x86_64.cljk with the operands read from
;; their frame slots as the plain u32 pair does: cmp rcx,512; ja; test rdx,rdx; jz; cmp rdi,rcx; jae; mov rsi,rcx; sub rsi,rdi; cmp rsi,2; jl; test rdi,1; ja; mov [rdx+rdi],ax; jmp +2; ud2
    9 (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0xbd8b48) (xg-load (+ t 3) 0x858b48) (xg-bytes 0x200f98148 7)
          (xg-bytes 0x38870f 6) (xg-bytes 0xd28548 3) (xg-bytes 0x2f840f 6) (xg-bytes 0xcf3948 3) (xg-bytes 0x26830f 6) (xg-bytes 0xce8948 3)
          (xg-bytes 0xfe2948 3) (xg-bytes 0x2fe8148 7) (xg-bytes 0x138c0f 6) (xg-bytes 0x1c7f748 7) (xg-bytes 0x6870f 6) (xg-bytes 0x3a048966 4)
          (xg-bytes 0x2eb 2) (xg-bytes 0xb0f 2) (xg-save t))
;; kernel-load-u64: 8 bytes at 512, the reference emit-memwidth-window of kotoba-native's x86_64.cljk with the operands read from
;; their frame slots as the plain u32 pair does: cmp rcx,512; ja; test rdx,rdx; jz; cmp rax,rcx; jae; mov rsi,rcx; sub rsi,rax; cmp rsi,8; jl; test rax,7; ja; mov rax,[rdx+rax]; jmp +2; ud2
    10 (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0x858b48) (xg-bytes 0x200f98148 7) (xg-bytes 0x38870f 6)
          (xg-bytes 0xd28548 3) (xg-bytes 0x2f840f 6) (xg-bytes 0xc83948 3) (xg-bytes 0x26830f 6) (xg-bytes 0xce8948 3) (xg-bytes 0xc62948 3)
          (xg-bytes 0x8fe8148 7) (xg-bytes 0x138c0f 6) (xg-bytes 0x7c0f748 7) (xg-bytes 0x6870f 6) (xg-bytes 0x2048b48 4)
          (xg-bytes 0x2eb 2) (xg-bytes 0xb0f 2) (xg-save t))
;; kernel-store-u64: 8 bytes at 512, the reference emit-memwidth-window of kotoba-native's x86_64.cljk with the operands read from
;; their frame slots as the plain u32 pair does: cmp rcx,512; ja; test rdx,rdx; jz; cmp rdi,rcx; jae; mov rsi,rcx; sub rsi,rdi; cmp rsi,8; jl; test rdi,7; ja; mov [rdx+rdi],rax; jmp +2; ud2
    11 (-> M (xg-load t 0x958b48) (xg-load (+ t 1) 0x8d8b48) (xg-load (+ t 2) 0xbd8b48) (xg-load (+ t 3) 0x858b48) (xg-bytes 0x200f98148 7)
          (xg-bytes 0x38870f 6) (xg-bytes 0xd28548 3) (xg-bytes 0x2f840f 6) (xg-bytes 0xcf3948 3) (xg-bytes 0x26830f 6) (xg-bytes 0xce8948 3)
          (xg-bytes 0xfe2948 3) (xg-bytes 0x8fe8148 7) (xg-bytes 0x138c0f 6) (xg-bytes 0x7c7f748 7) (xg-bytes 0x6870f 6) (xg-bytes 0x3a048948 4)
          (xg-bytes 0x2eb 2) (xg-bytes 0xb0f 2) (xg-save t))
    (xg-err M 7101 OP-CALL)))
(defn- xo-mmio-address [i :i64] :i64
  (case i 0 0xfee00020 1 0xfee000f0 2 0xfee00320 3 0xfee00380 4 0xfee003e0 0))
;; D5 record access. m = the mark minus FF-REC-MARK; low 6 bits N/4-2, then 8 bits of offset, then dir * 4 + width index.
(defn- xk-record-width [wi :i64] :i64 (case wi 0 1 1 2 2 4 8))
(defn- xk-record-access [M :vector-i64 dir :i64 wi :i64 off :i64] :vector-i64
  ;; mov r/m with the [rdx+disp32] form (modrm 0x82); the bytes of each opcode, then the 32-bit offset
  (if (= dir 0)
    (case wi 0 (-> M (xg-bytes 0x82b60f 3) (xg-bytes off 4))
              1 (-> M (xg-bytes 0x82b70f 3) (xg-bytes off 4))
              2 (-> M (xg-bytes 0x828b 2) (xg-bytes off 4))
                (-> M (xg-bytes 0x828b48 3) (xg-bytes off 4)))
    (case wi 0 (-> M (xg-bytes 0x8288 2) (xg-bytes off 4))
              1 (-> M (xg-bytes 0x828966 3) (xg-bytes off 4))
              2 (-> M (xg-bytes 0x8289 2) (xg-bytes off 4))
                (-> M (xg-bytes 0x828948 3) (xg-bytes off 4)))))
(defn- xk-record-value [M :vector-i64 dir :i64 t :i64] :vector-i64
  (if (= dir 1) (xg-load M (+ t 1) 0x858b48) M))
(defn- xk-record-intrinsic [M :vector-i64 k :i64 t :i64] :vector-i64
  (let [m (- (xg-f M (- k XK-RECORD) FF-EXPORT) FF-REC-MARK)
        q (u64-shift-right m 6) off (bit-and q 255) dw (u64-shift-right q 8)
        dir (u64-shift-right dw 2) wi (bit-and dw 3)
        len (if (or (and (= dir 0) (= wi 2)) (and (= dir 1) (or (= wi 0) (= wi 2)))) 6 7)]
    ;; jz skips the access and the two-byte jmp to land on the ud2
    (-> M (xg-load t 0x958b48) (xk-record-value dir t)
          (xg-bytes 0xd28548 3) (xg-bytes 0x840f 2) (xg-bytes (+ len 2) 4)
          (xk-record-access dir wi off)
          (xg-bytes 0x02eb 2) (xg-bytes 0x0b0f 2) (xg-save t))))
(defn- xk-intrinsic [M :vector-i64 k :i64 t :i64] :vector-i64
  (cond (>= k XK-CELL-ADDR) (-> M (xg-rel 0x058d48 3 1 (- k XK-CELL-ADDR)) (xg-save t))
        (>= k XK-RECORD) (xk-record-intrinsic M k t)
        (>= k XK-MMIO-STORE)
          (-> M (xg-load t 0x858b48) (xg-bytes 0xb948 2)
              (xg-bytes (xo-mmio-address (- (xg-f M (- k XK-MMIO-STORE) FF-EXPORT) FF-MMIO-STORE-MARK)) 8)
              (xg-bytes 0x0189 2) (xg-save t))
        (>= k XK-MMIO-LOAD)
          (-> M (xg-bytes 0xb848 2)
              (xg-bytes (xo-mmio-address (- (xg-f M (- k XK-MMIO-LOAD) FF-EXPORT) FF-MMIO-LOAD-MARK)) 8)
              (xg-bytes 0x008b 2) (xg-save t))
        (>= k XK-CELL-STORE)
          (-> M (xg-load t 0x858b48) (xg-rel 0x058948 3 1 (- k XK-CELL-STORE)) (xg-save t))
        (>= k XK-CELL-LOAD) (-> M (xg-rel 0x058b48 3 1 (- k XK-CELL-LOAD)) (xg-save t))
        (>= k XK-EXTERN) (xk-extern-call M (- k XK-EXTERN) t)
        :else (xk-intrinsic-window M k t)))
;; The selected stubs are the final functions, in id order, named as above. A source that
;; leaves them out or reorders them (it cannot: the library is appended here) is refused.
(defn- xk-scan-count [M :vector-i64 S :string count :i64 local-call :bool] :vector-i64
  (let [n (vector-at M MM-FN-N) first (- n count)]
    (if (or (not= (vector-at M MM-ERR) 0) (<= first 1)) (xg-err M 7102 n)
      (loop [k 0]
        (if (= k count) (mem-set M 200 first)
          (let [f (+ first k) sb (+ MM-SYM-BASE (* (xg-f M f FF-SYM) MM-SYM-W))
                a (vector-at M (+ sb SF-START)) b (vector-at M (+ sb SF-END))]
            (if (string=? (string-substring S a b)
                          (if (and local-call (= k 1)) "kernel-local-model-call" (xk-intr-name k)))
              (recur (inc k)) (xg-err M 7102 f))))))))
(defn- xk-scan [M :vector-i64 S :string] :vector-i64
  (xk-scan-count M S (if (xk-has-width-block? S) XK-INTR-W XK-INTR-N) false))

;; ROOTED BASES (ADR 0373, kotoba-native docs/threat-model.md). Narrowing a window with
;; (+ base offset), or taking a base out of memory, would conjure a window nothing
;; checked, so the base operand (the first) of each of the three must be ROOTED:
;;   - a parameter never assigned in its function: of the exported function (the ABI
;;     boundary where the kernel hands in a region), or of a private helper when
;;     EVERY call of that helper passes a rooted value at that position, or
;;   - the result of kernel-subregion over a rooted base, or
;;   - a let-bound local with exactly one assignment whose source is rooted.
;; (ADR 0373 gaps closed: a helper's parameter is rooted only when every call roots it; a literal is not a base; the LENGTH operand
;; must be the length of the base's own region, not a free number -- see xk-region below.)
;; Anything else -- a value read from memory, arithmetic, a call result, a branch's
;; result, a loop variable -- is refused (E7106, detail the SIR index of the call).
;; SIR is read backwards from the call: the argument temps are allocated stack-wise,
;; so the instruction that last wrote the base's temp before the call is the base's
;; own last step. The closed project may cross labels only after proving that
;; no edge bypasses that definition; object admission retains its basic-block
;; rule. Any unmodelled write or merged value is refused.
(defn- xk-fn-start [M :vector-i64 i :i64] :i64
  (if (<= i 1) 1
    (if (and (= (xg-get M 4) 2) (= (vector-at M 197) 0)
             (> (vector-at M 202) 0) (> (vector-at M 206) 0))
      (vector-at M (+ (vector-at M 206) i))
      (if (= (xg-si M i IF-OP) OP-FN) i (xk-fn-start M (dec i))))))
(defn- xk-project-proof? [M :vector-i64] :bool
  (and (= (xg-get M 4) 2) (= (vector-at M 197) 0) (> (vector-at M 202) 0)))
(defn- xk-identity-set? [M :vector-i64 j :i64 s :i64] :bool
  (let [w (xk-writer M j (xg-si M j IF-B))]
    (and (>= w 0) (= (xg-si M w IF-OP) OP-LGET) (= (xg-si M w IF-B) s))))
(defn- xk-lsets [M :vector-i64 j :i64 s :i64 cnt :i64] :i64
  (if (>= j (vector-at M MM-SIR-N)) cnt
    (let [op (xg-si M j IF-OP)]
      (if (or (= op OP-FN) (= op OP-END)) cnt
        (xk-lsets M (inc j) s (if (and (= op OP-LSET) (= (xg-si M j IF-A) s)
             (or (xk-project-proof? M) (not (xk-identity-set? M j s)))) (inc cnt) cnt))))))
(defn- xk-first-lset [M :vector-i64 j :i64 s :i64] :i64
  (if (>= j (vector-at M MM-SIR-N)) -1
    (let [op (xg-si M j IF-OP)]
      (cond (or (= op OP-FN) (= op OP-END)) -1
            (and (= op OP-LSET) (= (xg-si M j IF-A) s)
             (or (xk-project-proof? M) (not (xk-identity-set? M j s)))) j
            :else (xk-first-lset M (inc j) s)))))
;; Lowering may reuse a local slot in disjoint lexical scopes. In a closed
;; project, use the last assignment only when no edge can enter between that
;; assignment and this read. This proves dominance without treating a merge
;; result as a root. Object-profile admission retains its original rule.
(defn- xk-local-dominates? [M :vector-i64 assigned :i64 read :i64] :bool
  ;; Emission has completed before project proof. Reuse its label table as
  ;; bounded scratch, indexing only this function: module label IDs may repeat
  ;; elsewhere. No recursive provenance query runs while this index is read.
  (let [start (inc (xk-fn-start M read))
        indexed (loop [i start]
                  (let [op (xg-si M i IF-OP)]
                    (if (or (>= i (vector-at M MM-SIR-N)) (= op OP-END) (= op OP-FN)) M
                      (let [w (if (= op OP-LABEL)
                                (mem-set M (+ MM-LABEL-BASE (xg-si M i IF-A)) i) M)]
                        (recur (inc i))))))]
    (loop [i start]
      (let [op (xg-si M i IF-OP)
            branch (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ))
            target (if branch (vector-at M (+ MM-LABEL-BASE (xg-si M i (if (= op OP-BR) IF-A IF-B)))) 0)]
        (cond (or (>= i (vector-at M MM-SIR-N)) (= op OP-END) (= op OP-FN)) true
              (and (or (<= i assigned) (>= i read)) branch (> target assigned) (< target read)) false
              :else (recur (inc i)))))))
(defn- xk-local-set [M :vector-i64 read :i64 slot :i64] :i64
  (if (not (xk-project-proof? M))
    (if (= (xk-lsets M (inc (xk-fn-start M read)) slot 0) 1)
      (xk-first-lset M (inc (xk-fn-start M read)) slot) -1)
    (let [start (xk-fn-start M read)]
      (loop [i (dec read)]
      (cond (<= i start) -1
            (and (= (xg-si M i IF-OP) OP-LSET) (= (xg-si M i IF-A) slot))
              (if (xk-local-dominates? M i read) i -1)
            :else (recur (dec i)))))))
(defn- xk-identity-lsets? [M :vector-i64 j :i64 s :i64] :bool
  (loop [i j]
    (cond (>= i (vector-at M MM-SIR-N)) true
          (or (= (xg-si M i IF-OP) OP-FN) (= (xg-si M i IF-OP) OP-END)) true
          (and (= (xg-si M i IF-OP) OP-LSET) (= (xg-si M i IF-A) s))
            (let [w (xk-writer M i (xg-si M i IF-B))]
              (if (and (> w 0) (= (xg-si M w IF-OP) OP-LGET) (= (xg-si M w IF-B) s))
                (recur (inc i)) false))
          :else (recur (inc i)))))
(defn- xk-param-slot? [M :vector-i64 j :i64 s :i64] :bool
  (let [st (xk-fn-start M j) f (xg-si M st IF-A)]
    (and (>= s 1) (<= s (xg-f M f FF-NPARAMS))
         (if (= (xg-get M 4) 2)
           (if (and (> (vector-at M 202) 0) (> (vector-at M 205) 0))
             (= (vector-at M (+ (vector-at M 205) (* f 16) (dec s))) 1)
             (xk-identity-lsets? M (inc st) s))
           (= (xk-lsets M (inc st) s 0) 0)))))
(defn- xk-writer [M :vector-i64 i :i64 t :i64] :i64
  (loop [j (dec i) crossed false]
    (if (< j 1) -1
      (let [op (xg-si M j IF-OP) a (xg-si M j IF-A) b (xg-si M j IF-B) c (xg-si M j IF-C)]
        (cond (or (= op OP-FN) (= op OP-END)) -1
              (or (= op OP-LABEL) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ))
                (if (xk-project-proof? M) (recur (dec j) true) -1)
              (or (and (or (= op OP-CONST) (= op OP-LGET)) (= a t))
                  (and (or (= op OP-BIN) (= op OP-CMP) (= op OP-UN) (= op OP-CALL)) (= b t)))
                (if crossed (if (xk-local-dominates? M j i) j -1) j)
              (or (= op OP-CONST) (= op OP-LGET) (= op OP-BIN) (= op OP-CMP) (= op OP-UN) (= op OP-CALL)
                  (= op OP-LSET) (= op OP-FUEL) (= op OP-RET) (= op OP-TRAP)) (recur (dec j) crossed)
              (or (= a t) (= b t) (= c t)) -1
              :else (recur (dec j) crossed))))))
;; A value's SOURCE as a number, 0 when unknown: 2^32 + v for the integer literal v (0 <= v < 2^31: a wider literal is unknown, so it
;; cannot alias another through masking), 2^33 + s for the unassigned parameter slot s of
;; its function (through a let-bound local with one assignment). Two temps with the same non-zero source hold the same value.
(defn- xk-src [M :vector-i64 i :i64 t :i64 depth :i64] :i64
  (if (> depth 6) 0
    (let [j (xk-writer M i t)]
      (if (< j 0) 0
        (let [op (xg-si M j IF-OP) a (xg-si M j IF-A) b (xg-si M j IF-B)]
          (cond (= op OP-CONST) (if (and (>= b 0) (< b 2147483648)) (+ 4294967296 b) 0)
                (= op OP-LGET)
                  (cond (xk-param-slot? M j b) (+ 8589934592 b)
                        (and (> b (xg-f M (xg-si M (xk-fn-start M j) IF-A) FF-NPARAMS))
                             (> (xk-local-set M j b) 0))
                          (let [k (xk-local-set M j b)]
                            (if (> k 0) (xk-src M k (xg-si M k IF-B) (inc depth)) 0))
                        :else 0)
                :else 0))))))
;; An explicit paired length and a proven fixed length may describe the same
;; parameter. Keep source identities unchanged, and compare their values only
;; through the complete graph's paired+fixed facts for that local function.
(defn- xk-extent-constant [M :vector-i64 i :i64 source :i64] :i64
  (cond (and (>= source 4294967296) (< source 8589934592)) source
        (and (= (xg-get M 4) 2) (= (vector-at M 197) 0)
             (> (vector-at M 202) 0) (> source 8589934593) (< source 8589934609))
          (let [f (xg-si M (xk-fn-start M i) IF-A) p (- source 8589934592)
                at (+ (* f 16) (- p 2))]
            (if (and (<= p (xg-f M f FF-NPARAMS))
                     (= (vector-at M (+ (vector-at M 203) at)) 1))
              (let [v (vector-at M (+ (vector-at M 202) at))] (if (> v 0) v -1)) -1))
        :else -1))
(defn- xk-same-extent? [M :vector-i64 i :i64 a :i64 b :i64] :bool
  (if (= a b) true
    (let [left (xk-extent-constant M i a) right (xk-extent-constant M i b)]
      (and (>= left 4294967296) (= left right)))))
;; Closed project helpers can also have a fixed extent without a redundant
;; adjacent length parameter. EVERY external call must supply an already
;; rooted region with that same literal extent. An identity self-call merely
;; carries that established contract; it cannot seed one or change the base.
;; This rule does not apply to ordinary object ABI exports or IRQ arguments.
(defn- xk-fixed-param-region [M :vector-i64 f :i64 b :i64 depth :i64] :i64
  ;; The closed-project solver freezes both fixed and paired contracts before
  ;; admission. Its table removes recursive graph walking at a use site.
  ;; Other profiles retain the original conservative all-caller rule.
  (if (and (= (xg-get M 4) 2) (= (vector-at M 197) 0) (> (vector-at M 202) 0))
    (let [r (vector-at M (+ (vector-at M 202) (* f 16) (dec b)))]
      (if (> r 0) r -1))
    (loop [c 1 extent -1]
      (if (>= c (vector-at M MM-SIR-N)) extent
        (if (and (= (xg-si M c IF-OP) OP-CALL) (= (xg-si M c IF-A) f))
          (let [t (+ (xg-si M c IF-B) (dec b))
                self (= (xg-si M (xk-fn-start M c) IF-A) f)
                same (and self (= (xk-src M c t 0) (+ 8589934592 b)))]
            (if same (recur (inc c) extent)
              (let [r (xk-region M c t (inc depth))]
                (if (and (>= r 4294967296) (< r 8589934592)
                         (or (= extent -1) (= extent r)))
                  (recur (inc c) r) -1))))
          (recur (inc c) extent))))))
(defn- xk-object-param-region [M :vector-i64 f :i64 b :i64 depth :i64] :i64
  (let [np (xg-f M f FF-NPARAMS)]
    (loop [c 1 pairok 1 constant -2]
      (if (>= c (vector-at M MM-SIR-N))
        (cond (and (= pairok 1) (<= (inc b) np)) (+ 8589934592 (inc b))
              (>= constant 4294967296) constant :else -1)
        (if (and (= (xg-si M c IF-OP) OP-CALL) (= (xg-si M c IF-A) f))
          (let [r (xk-region M c (+ (xg-si M c IF-B) (dec b)) (inc depth))]
            (if (< r 0) -1
              (let [ln (if (<= (inc b) np) (xk-src M c (+ (xg-si M c IF-B) b) 0) 0)
                    literal (and (>= r 4294967296) (< r 8589934592))]
                (recur (inc c) (if (and (= pairok 1) (not= ln 0) (= ln r)) 1 0)
                  (cond (= constant -2) (if literal r -1)
                        (= constant r) constant :else -1)))))
          (recur (inc c) pairok constant))))))
;; The REGION of a base: -1 when the base is not rooted, else the source its length must have. A rooted base is
;;   - a parameter slot p never assigned: of the exported function (the ABI boundary hands in a region as the pair (base, length),
;;     the length being parameter p + 1), or of a private helper when EVERY call of it passes a rooted base at p whose length
;;     (the source of the argument at p + 1) is the length of that base;
;;   - the result of kernel-subregion over a rooted base, when the length it was given is the parent's length; the new region's
;;     length is the subregion's n;
;;   - a let-bound local with one assignment of such a value.
;; A literal is NOT a base: it would name any absolute address (ADR 0373).
(defn- xk-region [M :vector-i64 i :i64 t :i64 depth :i64] :i64
  (if (or (> depth (if (xk-project-proof? M) 24 12))
          (and (not (xk-project-proof? M))
               (> (vector-at (mem-set M 198 (inc (vector-at M 198))) 198) 40000))) -1
    (let [j (xk-writer M i t)]
      (if (< j 0) -1
        (let [op (xg-si M j IF-OP) a (xg-si M j IF-A) b (xg-si M j IF-B)]
          (cond (= op OP-LGET)
                  (cond (xk-param-slot? M j b)
                          (let [f (xg-si M (xk-fn-start M j) IF-A)]
                            (cond (= (xg-f M f FF-EXPORT) 3) (lv-param-region M f b)
                                  (= (xg-f M f FF-EXPORT) 2) -1
                                  (= (xg-f M f FF-EXPORT) 1)
                                    (if (> (inc b) (xg-f M f FF-NPARAMS)) -1 (+ 8589934592 (inc b)))
                                  :else
                                    (let [fixed (if (xk-project-proof? M) (xk-fixed-param-region M f b depth) -1)]
                                      (cond (not (xk-project-proof? M)) (xk-object-param-region M f b depth)
                                            (>= fixed 0) fixed
                                            (> (vector-at M 202) 0)
                                              (if (> (vector-at M (+ (vector-at M 203) (* f 16) (dec b))) 0)
                                                (+ 8589934592 (inc b)) -1)
                                            (> (inc b) (xg-f M f FF-NPARAMS)) -1
                                            :else (loop [c 1]
                                      (if (>= c (vector-at M MM-SIR-N)) (+ 8589934592 (inc b))
                                        (if (and (= (xg-si M c IF-OP) OP-CALL) (= (xg-si M c IF-A) f))
                                          (let [r (xk-region M c (+ (xg-si M c IF-B) (dec b)) (inc depth))
                                                ln (xk-src M c (+ (xg-si M c IF-B) b) 0)]
                                            (if (and (>= r 0) (not= ln 0) (= ln r)) (recur (inc c)) -1))
                                          (recur (inc c)))))))))
                        (and (> b (xg-f M (xg-si M (xk-fn-start M j) IF-A) FF-NPARAMS))
                             (> (xk-local-set M j b) 0))
                          (let [k (xk-local-set M j b)]
                            (if (> k 0) (xk-region M k (xg-si M k IF-B) (inc depth)) -1))
                        :else -1)
                (= op OP-CALL)
                  (if (= (xk-intr M a) 2)
                    (let [p (xk-region M j b (inc depth))
                          l0 (xk-src M j (inc b) 0)
                          n (xk-src M j (+ b 3) 0)]
                      (if (and (>= p 0) (not= l0 0) (xk-same-extent? M j l0 p) (not= n 0)) n -1))
                    (km-owned-region M a j b))
                :else -1))))))
;; D5: a record access names a base that is an unassigned parameter of an EXPORTED function, every access to that parameter
;; names the same N, and the parameter is not also the base of a window access.
(defn- xk-record-n [M :vector-i64 callee :i64] :i64
  (* 4 (+ 2 (bit-and (- (xg-f M callee FF-EXPORT) FF-REC-MARK) 63))))
(defn- xk-window-k? [k :i64] :bool
  (and (>= k 0) (or (< k XK-WINDOW-N) (and (>= k XK-WIDTH-FIRST) (< k XK-EXTERN)))))
(defn- xk-record-conflict? [M :vector-i64 i :i64 st :i64 src :i64 n :i64] :bool
  (loop [c 1]
    (if (>= c (vector-at M MM-SIR-N)) false
      (if (and (= (xg-si M c IF-OP) OP-CALL) (= (xk-fn-start M c) st))
        (let [k2 (xk-intr M (xg-si M c IF-A))]
          (if (and (or (and (>= k2 XK-RECORD) (< k2 XK-CELL-ADDR)) (xk-window-k? k2)) (= (xk-src M c (xg-si M c IF-B) 0) src)
                   (or (xk-window-k? k2) (not= (xk-record-n M (xg-si M c IF-A)) n)))
            true (recur (inc c))))
        (recur (inc c))))))
(defn- xk-record-ok? [M :vector-i64 i :i64] :bool
  (let [st (xk-fn-start M i) f (xg-si M st IF-A)
        src (xk-src M i (xg-si M i IF-B) 0)]
    (and (= (xg-f M f FF-EXPORT) 1)
         (> src 8589934592) (<= src (+ 8589934592 (xg-f M f FF-NPARAMS)))
         (not (xk-record-conflict? M i st src (xk-record-n M (xg-si M i IF-A)))))))
(defn- xk-check [M :vector-i64 i :i64] :vector-i64
  (if (or (not= (vector-at M MM-ERR) 0) (>= i (vector-at M MM-SIR-N))) M
    (let [op (xg-si M i IF-OP) a (xg-si M i IF-A) b (xg-si M i IF-B)]
      (if (or (and (= op OP-CALL) (>= (xk-intr M a) 0) (or (< (xk-intr M a) XK-WINDOW-N) (and (>= (xk-intr M a) XK-WIDTH-FIRST) (< (xk-intr M a) XK-EXTERN)))
                   (let [r (xk-region (mem-set M 198 0) i b 0) ln (xk-src M i (inc b) 0)]
                     (not (and (>= r 0) (not= ln 0) (xk-same-extent? M i ln r)))))
              ;; the exported function's parameters are rooted because the kernel hands them in: a guest call of the export would
              ;; hand them in again with a base of its own making, so nothing in the object may call the export
              (and (= op OP-CALL) (>= (xk-intr M a) XK-RECORD) (< (xk-intr M a) XK-CELL-ADDR) (not (xk-record-ok? M i)))
              (and (= op OP-CALL) (> (xg-f M a FF-EXPORT) 0) (< (xg-f M a FF-EXPORT) FF-EXTERN-MARK)))
        (xg-err M 7106 i)
        (xk-check M (inc i))))))

;; Admission. The scalar profile is the x86_64-linux profile 0 subset with a
;; different export rule: exactly one exported defn, any name, at most five
;; scalar parameters, scalar result. `main` carries no special meaning.
(defn- xo-check-fns-n [M :vector-i64 S :string f :i64 multi :bool] :vector-i64
  (if (or (not= (vector-at M MM-ERR) 0) (= f (vector-at M MM-FN-N))) M
    (let [kind (xg-f M f FF-KIND) n (xg-f M f FF-NPARAMS) sym (xg-f M f FF-SYM)
          sb (+ MM-SYM-BASE (* sym MM-SYM-W)) a (vector-at M (+ sb SF-START)) b (vector-at M (+ sb SF-END))]
      (cond (= kind FK-DEF) (xo-check-fns-n M S (inc f) multi)
            (or (not (or (= kind FK-DEFN) (= kind FK-PRIV)))
                (< n 0) (> n (if (= (xg-get M 4) 2) 16 5)) (not (xg-types M f 0 n)) (not (xg-type M (xg-f M f FF-RTYPE)))
                (<= (xg-f M f FF-SIR) 0) (> (xg-frame M f) 4096)) (xg-refuse-fn M S f a b)
            (= (xg-f M f FF-EXPORT) 1)
              (if (= (xg-get M 4) 2)
                (let [name (string-substring S a b) v (iv-vector name) live (lv-id name)]
                  (cond (string=? name "main")
                          (if (or (not= (xg-get M 1) 0) (not= n 0)) (xg-err M 7102 f)
                            (xo-check-fns-n (xg-set M 1 f) S (inc f) multi))
                        (lv-typed? M f live) (xo-check-fns-n M S (inc f) multi)
                        (and (>= v 0) (= n 4) (= (xg-f M f FF-RTYPE) TY-I64)
                             (= (ck-pt M f 0) TY-I64) (= (ck-pt M f 1) TY-I64)
                             (= (ck-pt M f 2) TY-I64) (= (ck-pt M f 3) TY-I64)) (xo-check-fns-n M S (inc f) multi)
                        :else (xg-err M 7102 f)))
                (cond (= (xg-get M 1) 0) (xo-check-fns-n (xg-set M 1 f) S (inc f) multi)
                      multi (xo-check-fns-n M S (inc f) multi)
                      :else (xg-err M 7102 f)))
            :else (xo-check-fns-n M S (inc f) multi)))))

(defn- xo-check-fns [M :vector-i64 S :string f :i64] :vector-i64 (xo-check-fns-n M S f false))

;; JUN-556 D1: extern declarations. Marking, collection and the relocations they produce.
(defn- xo-ext-name? [S :string a :i64 b :i64] :bool
  (and (> (- b a) 7) (string=? (string-substring S a (+ a 7)) "extern-")))
;; the symbol after the prefix: [a-z_][a-z0-9_]* (a closed set the verifier can rely on)
(defn- xo-ident-ok? [S :string i :i64 b :i64 first :bool] :bool
  (or (>= i b)
      (and (>= (string-index-of "0123456789abcdefghijklmnopqrstuvwxyz_" (string-substring S i (inc i))) (if first 10 0))
           (xo-ident-ok? S (inc i) b false))))
;; a declaration's body is the placeholder 0: only function, end, label, fuel, return (bits of 786950:
;; ops 1, 2, 9, 18, 19) and a zero constant
(defn- xo-body-zero? [M :vector-i64 i :i64 end :i64] :bool
  (or (>= i end)
      (let [op (xg-si M i IF-OP)]
        (and (or (= (bit-and (u64-shift-right 786950 op) 1) 1) (and (= op OP-CONST) (= (xg-si M i IF-B) 0)))
             (xo-body-zero? M (inc i) end)))))
(defn- xo-extern-body-ok? [M :vector-i64 f :i64] :bool
  (xo-body-zero? M (xg-f M f FF-SIR)
                 (if (< (inc f) (vector-at M MM-FN-N)) (xg-f M (inc f) FF-SIR) (vector-at M MM-SIR-N))))
(defn- xo-digits-ok? [S :string i :i64 b :i64] :bool
  (or (>= i b)
      (and (>= (string-index-of "0123456789" (string-substring S i (inc i))) 0) (xo-digits-ok? S (inc i) b))))
;; the cell number in cell-load-<k> / cell-store-<k>: canonical decimal below XO-MAX-CELLS, else -1
(defn- xo-cell-number [S :string i :i64 b :i64] :i64
  (if (and (< i b) (<= (- b i) 2) (xo-digits-ok? S i b))
    (let [k (mem-parse-dec S i b)]
      (if (and (>= k 0) (< k XO-MAX-CELLS) (string=? (string-substring S i b) (mem-u2dec k))) k -1))
    -1))
(defn- xo-cell-mark [M :vector-i64 S :string f :i64 a :i64 b :i64] :i64
  (cond (and (> (- b a) 10) (string=? (string-substring S a (+ a 10)) "cell-load-") (= (xg-f M f FF-NPARAMS) 0))
          (let [k (xo-cell-number S (+ a 10) b)] (if (< k 0) -1 (+ FF-CELL-LOAD-MARK k)))
        (and (> (- b a) 11) (string=? (string-substring S a (+ a 11)) "cell-store-") (= (xg-f M f FF-NPARAMS) 1))
          (let [k (xo-cell-number S (+ a 11) b)] (if (< k 0) -1 (+ FF-CELL-STORE-MARK k)))
        (and (> (- b a) 10) (string=? (string-substring S a (+ a 10)) "cell-addr-") (= (xg-f M f FF-NPARAMS) 0))
          (let [k (xo-cell-number S (+ a 10) b)] (if (< k 0) -1 (+ FF-CELL-ADDR-MARK k)))
        :else -1))
(defn- xo-mmio-index [S :string i :i64 b :i64] :i64
  (if (not= (- b i) 8) -1
    (let [s (string-substring S i b)]
      (cond (string=? s "fee00020") 0 (string=? s "fee000f0") 1 (string=? s "fee00320") 2
            (string=? s "fee00380") 3 (string=? s "fee003e0") 4 :else -1))))
(defn- xo-mmio-mark [M :vector-i64 S :string f :i64 a :i64 b :i64] :i64
  (cond (and (> (- b a) 12) (string=? (string-substring S a (+ a 12)) "mmio-load32-") (= (xg-f M f FF-NPARAMS) 0))
          (let [k (xo-mmio-index S (+ a 12) b)] (if (< k 0) -1 (+ FF-MMIO-LOAD-MARK k)))
        (and (> (- b a) 13) (string=? (string-substring S a (+ a 13)) "mmio-store32-") (= (xg-f M f FF-NPARAMS) 1))
          (let [k (xo-mmio-index S (+ a 13) b)] (if (< k 0) -1 (+ FF-MMIO-STORE-MARK k)))
        :else -1))
;; JUN-556 D5 names: record-load-<w>-<off>-<N> [b] / record-store-<w>-<off>-<N> [b v]
(defn- xo-small-number [S :string i :i64 b :i64] :i64
  (if (and (< i b) (<= (- b i) 3) (xo-digits-ok? S i b))
    (let [k (mem-parse-dec S i b)] (if (and (>= k 0) (string=? (string-substring S i b) (mem-u2dec k))) k -1))
    -1))
(defn- xo-rec-width [s :string] :i64
  (cond (string=? s "u8") 0 (string=? s "u16") 1 (string=? s "u32") 2 (string=? s "u64") 3 :else -1))
(defn- xo-record-mark-rest [dir :i64 rest :string] :i64
  (let [d1 (string-index-of rest "-")]
    (if (< d1 1) -1
      (let [wi (xo-rec-width (string-substring rest 0 d1))
            tail (string-substring rest (inc d1) (string-length rest))
            d2 (string-index-of tail "-")]
        (if (or (< wi 0) (< d2 1)) -1
          (let [off (xo-small-number tail 0 d2)
                n (xo-small-number tail (inc d2) (string-length tail))
                w (case wi 0 1 1 2 2 4 8)]
            (if (and (>= off 0) (>= n 8) (<= n 256) (= (bit-and n 3) 0) (= (bit-and off (dec w)) 0) (<= (+ off w) n))
              (+ FF-REC-MARK (* (+ (* (+ (* dir 4) wi) 256) off) 64) (- (quot n 4) 2))
              -1)))))))
(defn- xo-record-mark [M :vector-i64 S :string f :i64 a :i64 b :i64] :i64
  (cond (and (> (- b a) 12) (string=? (string-substring S a (+ a 12)) "record-load-") (= (xg-f M f FF-NPARAMS) 1))
          (xo-record-mark-rest 0 (string-substring S (+ a 12) b))
        (and (> (- b a) 13) (string=? (string-substring S a (+ a 13)) "record-store-") (= (xg-f M f FF-NPARAMS) 2))
          (xo-record-mark-rest 1 (string-substring S (+ a 13) b))
        :else -1))
(defn- xo-dname-dash [S :string a :i64 b :i64] :i64
  (string-index-of (string-substring S (+ a 10) b) "-"))
(defn- xo-dname-mark [S :string a :i64 b :i64] :i64
  (let [d (xo-dname-dash S a b)
        k (if (or (= d 1) (= d 2)) (xo-cell-number S (+ a 10) (+ a 10 d)) -1)]
    (if (and (>= k 0) (xo-ident-ok? S (+ a 11 d) b true)) (+ FF-CELL-NAME-MARK k) -1)))
(defn- xo-cell-name? [S :string a :i64 b :i64] :bool
  (or (and (> (- b a) 10) (string=? (string-substring S a (+ a 10)) "cell-name-"))
      (and (> (- b a) 10) (string=? (string-substring S a (+ a 10)) "cell-load-"))
      (and (> (- b a) 10) (string=? (string-substring S a (+ a 10)) "cell-addr-"))
      (and (> (- b a) 11) (string=? (string-substring S a (+ a 11)) "cell-store-"))
      (and (> (- b a) 12) (string=? (string-substring S a (+ a 12)) "mmio-load32-"))
      (and (> (- b a) 13) (string=? (string-substring S a (+ a 13)) "mmio-store32-"))
      (and (> (- b a) 12) (string=? (string-substring S a (+ a 12)) "record-load-"))
      (and (> (- b a) 13) (string=? (string-substring S a (+ a 13)) "record-store-"))))
(defn- xo-mark-externs [M :vector-i64 S :string f :i64] :vector-i64
  (if (or (>= f (vector-at M MM-FN-N)) (not= (vector-at M MM-ERR) 0)) M
    (let [sb (+ MM-SYM-BASE (* (xg-f M f FF-SYM) MM-SYM-W))
          a (vector-at M (+ sb SF-START)) b (vector-at M (+ sb SF-END))
          plain (and (= (xg-f M f FF-KIND) FK-PRIV) (= (xg-f M f FF-EXPORT) 0))]
      (cond (and plain (xo-ext-name? S a b))
              ;; a malformed declaration is refused, never silently taken for an ordinary function
              (if (and (xo-ident-ok? S (+ a 7) b true) (xo-extern-body-ok? M f))
                (xo-mark-externs (mem-set M (+ MM-FN-BASE (* f MM-FN-W) FF-EXPORT) FF-EXTERN-MARK) S (inc f))
                (xg-err M 7102 f))
            (and plain (xo-cell-name? S a b))
              (let [m (let [c (xo-cell-mark M S f a b)]
                        (cond (>= c 0) c
                              (and (> (- b a) 10) (string=? (string-substring S a (+ a 10)) "cell-name-") (= (xg-f M f FF-NPARAMS) 0)) (xo-dname-mark S a b)
                              :else (let [mm (xo-mmio-mark M S f a b)] (if (>= mm 0) mm (xo-record-mark M S f a b)))))]
                (if (and (>= m 0) (xo-extern-body-ok? M f))
                  (xo-mark-externs (mem-set M (+ MM-FN-BASE (* f MM-FN-W) FF-EXPORT) m) S (inc f))
                  (xg-err M 7102 f)))
            :else (xo-mark-externs M S (inc f))))))
;; the image and user routes cannot link an undefined symbol: a declaration there is refused
(defn- xo-refuse-externs [M :vector-i64 S :string f :i64] :vector-i64
  (if (or (>= f (vector-at M MM-FN-N)) (not= (vector-at M MM-ERR) 0)) M
    (let [sb (+ MM-SYM-BASE (* (xg-f M f FF-SYM) MM-SYM-W))
          a (vector-at M (+ sb SF-START)) b (vector-at M (+ sb SF-END))]
      (if (or (xo-ext-name? S a b) (xo-cell-name? S a b))
        (xg-err M 7102 f)
        (xo-refuse-externs M S (inc f))))))
(defn- xo-clash? [S :string NS :vector-i64 cnt :i64 NX :vector-i64 i :i64 j :i64 nx :i64] :bool
  (cond (> i nx) false
        (> j cnt) (xo-clash? S NS cnt NX (inc i) 1 nx)
        (string=? (string-substring S (vector-at NX (- (* 2 i) 1)) (vector-at NX (* 2 i)))
                  (string-substring S (vector-at NS (- (* 2 j) 1)) (vector-at NS (* 2 j)))) true
        :else (xo-clash? S NS cnt NX i (inc j) nx)))
(defn- xo-xcollect [M :vector-i64 f :i64 X :vector-i64] :vector-i64
  (if (>= f (vector-at M MM-FN-N)) X
    (if (= (xg-f M f FF-EXPORT) FF-EXTERN-MARK)
      (let [n (inc (vector-at X 0))]
        (xo-xcollect M (inc f) (if (> n XO-MAX-EXTERNS) (vector-assoc! X 0 n)
                                 (vector-assoc! (vector-assoc! X 0 n) n f))))
      (xo-xcollect M (inc f) X))))
;; NX[2i-1], NX[2i]: the symbol's span in the source, after the "extern-" prefix
(defn- xo-xspans [M :vector-i64 X :vector-i64 i :i64 NX :vector-i64] :vector-i64
  (if (> i (vector-at X 0)) NX
    (let [sb (+ MM-SYM-BASE (* (xg-f M (vector-at X i) FF-SYM) MM-SYM-W))]
      (xo-xspans M X (inc i)
                 (vector-assoc! (vector-assoc! NX (- (* 2 i) 1) (+ (vector-at M (+ sb SF-START)) 7))
                                (* 2 i) (vector-at M (+ sb SF-END)))))))
(defn- xo-xrank [X :vector-i64 f :i64 j :i64] :i64
  (if (> j (vector-at X 0)) 0 (if (= (vector-at X j) f) j (xo-xrank X f (inc j)))))
(defn- xo-ext-site? [M :vector-i64 i :i64] :bool
  (let [b (+ MM-FIX-BASE (* i MM-FIX-W))]
    (and (= (vector-at M (+ b 1)) 1) (>= (xg-f M (vector-at M (+ b 2)) FF-EXPORT) FF-EXTERN-MARK))))
(defn- xo-sites [M :vector-i64 i :i64 acc :i64] :i64
  (if (>= i (vector-at M MM-FIX-N)) acc (xo-sites M (inc i) (if (xo-ext-site? M i) (inc acc) acc))))
(defn- xo-zero-sites [M :vector-i64 i :i64] :vector-i64
  (if (>= i (vector-at M MM-FIX-N)) M
    (xo-zero-sites (if (xo-ext-site? M i) (xg-patch M (vector-at M (+ MM-FIX-BASE (* i MM-FIX-W))) 0 4) M) (inc i))))
(defn- xo-max [a :i64 b :i64] :i64 (if (> a b) a b))
(defn- xo-cell-addend [m :i64] :i64
  (- (+ 80 (* 8 (cond (>= m FF-CELL-ADDR-MARK) (- m FF-CELL-ADDR-MARK)
                      (>= m FF-CELL-STORE-MARK) (- m FF-CELL-STORE-MARK)
                      :else (- m FF-CELL-LOAD-MARK)))) 4))
(defn- xo-xrelas [M :vector-i64 cnt :i64 X :vector-i64 i :i64] :vector-i64
  (if (>= i (vector-at M MM-FIX-N)) M
    (let [b (+ MM-FIX-BASE (* i MM-FIX-W)) m (xg-f M (vector-at M (+ b 2)) FF-EXPORT)]
      (xo-xrelas
        (cond (not (xo-ext-site? M i)) M
              (= m FF-EXTERN-MARK)
                (-> M (xg-out (vector-at M b) 8)
                    (xg-out (+ (* (+ cnt 1 (xo-xrank X (vector-at M (+ b 2)) 1)) 4294967296) 4) 8)
                    (xg-out -4 8))
              :else (-> M (xg-out (vector-at M b) 8) (xg-out 4294967298 8) (xg-out (xo-cell-addend m) 8)))
        cnt X (inc i)))))
;; the data section holds the context and 8 bytes for every cell up to the highest one a stub names
(defn- xo-ncells [M :vector-i64 f :i64 acc :i64] :i64
  (if (>= f (vector-at M MM-FN-N)) acc
    (let [m (xg-f M f FF-EXPORT)]
      (xo-ncells M (inc f)
                 (cond (and (>= m FF-CELL-LOAD-MARK) (< m (+ FF-CELL-LOAD-MARK XO-MAX-CELLS))) (xo-max acc (inc (- m FF-CELL-LOAD-MARK)))
                       (and (>= m FF-CELL-STORE-MARK) (< m (+ FF-CELL-STORE-MARK XO-MAX-CELLS))) (xo-max acc (inc (- m FF-CELL-STORE-MARK)))
                       (and (>= m FF-CELL-NAME-MARK) (< m (+ FF-CELL-NAME-MARK XO-MAX-CELLS))) (xo-max acc (inc (- m FF-CELL-NAME-MARK)))
                       (and (>= m FF-CELL-ADDR-MARK) (< m (+ FF-CELL-ADDR-MARK XO-MAX-CELLS))) (xo-max acc (inc (- m FF-CELL-ADDR-MARK)))
                       :else acc)))))
(defn- xo-zero-words [M :vector-i64 n :i64] :vector-i64
  (if (<= n 0) M (xo-zero-words (xg-out M 0 8) (dec n))))
(defn- xo-dcollect [M :vector-i64 f :i64 D :vector-i64] :vector-i64
  (if (>= f (vector-at M MM-FN-N)) D
    (let [m (xg-f M f FF-EXPORT)]
      (if (and (>= m FF-CELL-NAME-MARK) (< m (+ FF-CELL-NAME-MARK XO-MAX-CELLS)))
        (let [n (inc (vector-at D 0))]
          (xo-dcollect M (inc f) (if (> n XO-MAX-DSYMS) (vector-assoc! D 0 n)
                                   (vector-assoc! (vector-assoc! D 0 n) n f))))
        (xo-dcollect M (inc f) D)))))
;; DX[2i-1], DX[2i]: the symbol span of data symbol i (after cell-name-<k>-)
(defn- xo-dspans [M :vector-i64 S :string D :vector-i64 i :i64 DX :vector-i64] :vector-i64
  (if (> i (vector-at D 0)) DX
    (let [f (vector-at D i) sb (+ MM-SYM-BASE (* (xg-f M f FF-SYM) MM-SYM-W))
          a (vector-at M (+ sb SF-START)) b (vector-at M (+ sb SF-END))]
      (xo-dspans M S D (inc i)
                 (vector-assoc! (vector-assoc! DX (- (* 2 i) 1) (+ a 11 (xo-dname-dash S a b))) (* 2 i) b)))))
(defn- xo-dsyms [M :vector-i64 D :vector-i64 DX :vector-i64 i :i64 nd :i64 off :i64] :vector-i64
  (if (> i nd) M
    (xo-dsyms (xo-sym M off 0x11 2 (+ 80 (* 8 (- (xg-f M (vector-at D i) FF-EXPORT) FF-CELL-NAME-MARK))) 8)
              D DX (inc i) nd (+ off (- (vector-at DX (* 2 i)) (vector-at DX (- (* 2 i) 1))) 1))))
(defn- xo-dnames [M :vector-i64 S :string DX :vector-i64 i :i64 nd :i64] :vector-i64
  (if (> i nd) M
    (xo-dnames (-> M (out-put-span S (vector-at DX (- (* 2 i) 1)) (vector-at DX (* 2 i))) (xg-out 0 1)) S DX (inc i) nd)))
(defn- xo-dself-clash? [S :string DX :vector-i64 i :i64 j :i64 nd :i64] :bool
  (cond (> i nd) false
        (> j nd) (xo-dself-clash? S DX (inc i) (+ i 2) nd)
        (string=? (string-substring S (vector-at DX (- (* 2 i) 1)) (vector-at DX (* 2 i)))
                  (string-substring S (vector-at DX (- (* 2 j) 1)) (vector-at DX (* 2 j)))) true
        :else (xo-dself-clash? S DX i (inc j) nd)))
(defn- xo-xsyms [M :vector-i64 NX :vector-i64 i :i64 nx :i64 off :i64] :vector-i64
  (if (> i nx) M
    (xo-xsyms (xo-sym M off 0x10 0 0 0) NX (inc i) nx
              (+ off (- (vector-at NX (* 2 i)) (vector-at NX (- (* 2 i) 1))) 1))))
(defn- xo-xnames [M :vector-i64 S :string NX :vector-i64 i :i64 nx :i64] :vector-i64
  (if (> i nx) M
    (xo-xnames (-> M (out-put-span S (vector-at NX (- (* 2 i) 1)) (vector-at NX (* 2 i))) (xg-out 0 1)) S NX (inc i) nx)))

;; ELF64 ET_REL emission. Layout: header, seven section headers, .text,
;; .data (the private 80-byte context), .rela.text (one entry), .symtab
;; (null, public export, context), .strtab, .shstrtab.
(defn- xo-shdr [M :vector-i64 name :i64 type :i64 flags :i64 addr :i64 off :i64 size :i64 link :i64 info :i64 align :i64 entsize :i64] :vector-i64
  (-> M (xg-out name 4) (xg-out type 4) (xg-out flags 8) (xg-out addr 8) (xg-out off 8)
      (xg-out size 8) (xg-out link 4) (xg-out info 4) (xg-out align 8) (xg-out entsize 8)))
(defn- xo-sym [M :vector-i64 name :i64 info :i64 shndx :i64 value :i64 size :i64] :vector-i64
  (-> M (xg-out name 4) (xg-out info 1) (xg-out 0 1) (xg-out shndx 2) (xg-out value 8) (xg-out size 8)))
;; The exports of an object, in definition order. E[0] is how many, E[i] the
;; function id. NS[2i-1] and NS[2i] are the name span of export i.
(def XO-MAX-EXPORTS 8)
(defn- xo-collect [M :vector-i64 f :i64 E :vector-i64] :vector-i64
  (if (>= f (vector-at M MM-FN-N)) E
    (let [kind (xg-f M f FF-KIND)]
      (if (and (or (= kind FK-DEFN) (= kind FK-PRIV)) (= (xg-f M f FF-EXPORT) 1))
        (let [n (inc (vector-at E 0))]
          (xo-collect M (inc f) (if (> n XO-MAX-EXPORTS) (vector-assoc! E 0 n)
                                  (vector-assoc! (vector-assoc! E 0 n) n f))))
        (xo-collect M (inc f) E)))))
(defn- xo-spans [M :vector-i64 E :vector-i64 i :i64 NS :vector-i64] :vector-i64
  (if (> i (vector-at E 0)) NS
    (let [sym (xg-f M (vector-at E i) FF-SYM) sb (+ MM-SYM-BASE (* sym MM-SYM-W))]
      (xo-spans M E (inc i)
                (vector-assoc! (vector-assoc! NS (- (* 2 i) 1) (vector-at M (+ sb SF-START)))
                               (* 2 i) (vector-at M (+ sb SF-END)))))))
(defn- xo-shims [M :vector-i64 E :vector-i64 i :i64 fuel :i64] :vector-i64
  (if (> i (vector-at E 0)) M (xo-shims (xo-shim M fuel (vector-at E i)) E (inc i) fuel)))
;; the bytes the names take in .strtab: each name and its NUL
(defn- xo-names-len [NS :vector-i64 i :i64 cnt :i64 acc :i64] :i64
  (if (> i cnt) acc
    (xo-names-len NS (inc i) cnt (+ acc (- (vector-at NS (* 2 i)) (vector-at NS (- (* 2 i) 1))) 1))))
(defn- xo-relas [M :vector-i64 i :i64 cnt :i64 shim :i64] :vector-i64
  (if (>= i cnt) M
    (xo-relas (-> M (xg-out (+ (* i shim) 3) 8) (xg-out 4294967298 8) (xg-out -4 8)) (inc i) cnt shim)))
(defn- xo-fsyms [M :vector-i64 NS :vector-i64 i :i64 cnt :i64 shim :i64 off :i64] :vector-i64
  (if (> i cnt) M
    (xo-fsyms (xo-sym M off 0x12 1 (* (dec i) shim) shim) NS (inc i) cnt shim
              (+ off (- (vector-at NS (* 2 i)) (vector-at NS (- (* 2 i) 1))) 1))))
(defn- xo-fnames [M :vector-i64 S :string NS :vector-i64 i :i64 cnt :i64] :vector-i64
  (if (> i cnt) M
    (xo-fnames (-> M (out-put-span S (vector-at NS (- (* 2 i) 1)) (vector-at NS (* 2 i))) (xg-out 0 1)) S NS (inc i) cnt)))

;; cnt exports: cnt shims of shim bytes each, cnt relocations, cnt public symbols.
;; With one export the bytes are the ones this function always wrote.
(defn- xo-elf [M :vector-i64 S :string NS :vector-i64 cnt :i64 X :vector-i64 NX :vector-i64 D :vector-i64 DX :vector-i64 shim :i64 fuel :i64] :vector-i64
  (let [tlen (xg-pos M) text-off 512 data-off (+ text-off tlen)
        nx (vector-at X 0) nd (vector-at D 0) sites (xo-sites M 1 0) ncells (xo-ncells M 1 0) dsize (+ 80 (* 8 ncells))
        rela-size (* 24 (+ cnt sites)) sym-size (* 24 (+ cnt 2 nx nd))
        rela-off (+ data-off dsize) sym-off (+ rela-off rela-size) str-off (+ sym-off sym-size)
        names (xo-names-len NS 1 cnt 0) xnames (xo-names-len NX 1 nx 0) dnames (xo-names-len DX 1 nd 0)
        str-len (+ names 9 xnames dnames) shstr-off (+ str-off str-len)]
    (-> M (mem-set MM-OUT-N 1)
        (xg-out 0x00010102464c457f 8) (xg-out 0 8)
        (xg-out 1 2) (xg-out 62 2) (xg-out 1 4) (xg-out 0 8) (xg-out 0 8) (xg-out 64 8)
        (xg-out 0 4) (xg-out 64 2) (xg-out 0 2) (xg-out 0 2) (xg-out 64 2) (xg-out 7 2) (xg-out 6 2)
        (xg-out 0 8) (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)
        (xg-out 0 8) (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)
        (xo-shdr 1 1 6 0 text-off tlen 0 0 16 0)
        (xo-shdr 7 1 3 0 data-off dsize 0 0 8 0)
        (xo-shdr 13 4 0x40 0 rela-off rela-size 4 1 8 24)
        (xo-shdr 24 2 0 0 sym-off sym-size 5 2 8 24)
        (xo-shdr 32 3 0 0 str-off str-len 0 0 1 0)
        (xo-shdr 40 3 0 0 shstr-off 50 0 0 1 0)
        (xg-out-code 1)
        (xg-out 0 8) (xg-out fuel 8) (xg-out 0 8) (xg-out 0 8)
        (xg-out 0 8) (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)
        (xg-out 0 8) (xg-out 0 8) (xo-zero-words ncells)
        ;; Every shim has the same length, so shim i starts at i * shim and its
        ;; context LEA displacement is at +3. The context symbol (index 1) is
        ;; LOCAL (P1 review): two objects linked into one kernel must not collide
        ;; on a global `context`, so locals come first (null, context, exports)
        ;; and sh_info names the first global.
        (xo-relas 0 cnt shim)
        (xo-xrelas cnt X 1)
        (xo-sym 0 0 0 0 0)
        (xo-sym (+ names 1) 0x01 2 0 80)
        (xo-fsyms NS 1 cnt shim 1)
        (xo-xsyms NX 1 nx (+ names 9)) (xo-dsyms D DX 1 nd (+ names 9 xnames))
        (xg-out 0 1) (xo-fnames S NS 1 cnt) (xg-out 0x747865746e6f63 8) (xo-xnames S NX 1 nx) (xo-dnames S DX 1 nd)
        (xg-out 0x2e00747865742e00 8) (xg-out 0x65722e0061746164 8) (xg-out 0x00747865742e616c 8)
        (xg-out 0x006261746d79732e 8) (xg-out 0x006261747274732e 8) (xg-out 0x617472747368732e 8)
        (xg-out 0x0062 2))))

(defn- xo-report [M :vector-i64 path :string out :string] :i64
  (let [e (vector-at M MM-ERR)]
    (cond (and (> e 0) (< e 7100)) (drv-fail M path)
          (> e 0) (let [w (io-err (string-concat "seed-x86_64-aiueos-object: E" (string-concat (mem-u2dec e)
                            (string-concat " unsupported object profile or code limit; detail "
                              (string-concat (mem-u2dec (vector-at M MM-ERR-N)) "\n")))))] 1)
          :else (let [n (dec (vector-at M MM-OUT-N)) written (out-write-v M out (+ MM-OUT-BASE 1) n)
                      w (io-out (string-concat "{:ok true, :target :x86_64-aiueos-kernel-v1, :format :elf64-rel, :text-bytes "
                               (string-concat (mem-u2dec (xg-pos M))
                                 (string-concat ", :bytes " (string-concat (mem-u2dec n) "}\n")))))]
                  (if (= (io-exists out) 1) 0 (drv-fail0 E-WRITE))))))

(defn- xo-build [M :vector-i64 S :string fuel :i64] :vector-i64
  (let [admitted (-> M (xg-set 0 0) (xg-set 1 0) (xg-set 2 fuel) (xg-set 4 0) (xo-check-fns-n S 1 true) (xo-mark-externs S 1) (xg-check-sir 1) (xk-scan S) (xk-check 1))]
    (cond (not= (vector-at admitted MM-ERR) 0) admitted
          (= (xg-get admitted 1) 0) (xg-err admitted 7102 0)
          (not= (vector-at admitted MM-CAPS) 0) (xg-err admitted 7101 OP-CAP)
          :else (let [E (xo-collect admitted 1 (vector-alloc (+ XO-MAX-EXPORTS 2))) cnt (vector-at E 0)]
                  (if (> cnt XO-MAX-EXPORTS) (xg-err admitted 7102 (xg-get admitted 1))
                    (let [NS (xo-spans admitted E 1 (vector-alloc (+ (* 2 XO-MAX-EXPORTS) 2)))
                          X (xo-xcollect admitted 1 (vector-alloc (+ XO-MAX-EXTERNS 2)))]
                      (if (> (vector-at X 0) XO-MAX-EXTERNS) (xg-err admitted 7102 (xg-get admitted 1))
                        (let [NX (xo-xspans admitted X 1 (vector-alloc (+ (* 2 XO-MAX-EXTERNS) 2)))
                              generated (-> admitted (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1)
                                            (xg-index-labels 1) (xo-shims E 1 fuel) (xg-code 1))]
                          (if (xo-clash? S NS cnt NX 1 1 (vector-at X 0)) (xg-err admitted 7102 (xg-get admitted 1))
                            (let [D (xo-dcollect admitted 1 (vector-alloc (+ XO-MAX-DSYMS 2))) nd (vector-at D 0)]
                              (if (> nd XO-MAX-DSYMS) (xg-err admitted 7102 (xg-get admitted 1))
                                (let [DX (xo-dspans admitted S D 1 (vector-alloc (+ (* 2 XO-MAX-DSYMS) 2)))]
                                  (if (or (xo-clash? S NS cnt DX 1 1 nd) (xo-clash? S NX (vector-at X 0) DX 1 1 nd)
                                          (xo-dself-clash? S DX 1 2 nd))
                                    (xg-err admitted 7102 (xg-get admitted 1))
                                    (xo-elf (xo-zero-sites (xg-fix generated 1) 1) S NS cnt X NX D DX (xo-shim-len fuel) fuel))))))))))))))

(defn- xo-source [S :string path :string out :string fuel :i64] :i64
  (let [text (string-concat (string-concat S (ck-r6b-lib S)) (xk-lib-for S)) front (xg-front text)]
    (if (= (vector-at front MM-ERR) 0) (xo-report (xo-build front text fuel) path out) (drv-fail front path))))

;; JUN-31: the image packaging step, in the same adopted compiler lineage.
;; This grows the existing scalar/object admission; it does not stand in for
;; the complete AIUEOS kernel graph. Multiple exports (including ISR and live
;; ValueRuntime entries), host capabilities and unsupported kernel intrinsics
;; still refuse. No source is trimmed or rewritten to make that graph pass.
;; The image ABI matches kotoba.native.elf64's non-live, no-ISR layout:
;; two PT_LOADs (RX then RW), image-owned stack, GDT/TSS and sealed fuel.
;; A successful image build is not EFI/GPT or a QEMU boot qualification.
(def XI-DATA-SIZE 77824)
(defn- xi-shim [M :vector-i64 entry :i64] :vector-i64
  ;; 77 bytes. RIP displacements for stack/GDTR/boot-info/context are patched
  ;; after code size determines the data page; the entry call uses xg-fix.
  (-> M (xg-byte 0xfa) (xg-bytes 0x258d48 3) (xg-bytes 0 4)
      (xg-bytes 0xf0e48348 4) (xg-bytes 0x15010f 3) (xg-bytes 0 4)
      (xg-bytes 0x086a 2) (xg-bytes 0x058d48 3) (xg-bytes 3 4)
      (xg-bytes 0xcb4850 3) (xg-bytes 0x0010b866 4)
      (xg-bytes 0xd08ec08ed88e 6) (xg-bytes 0xe88ee08ec031 6)
      (xg-bytes 0x0028b866 4) (xg-bytes 0xd8000f 3)
      (xg-bytes 0x3d8948 3) (xg-bytes 0 4)
      (xg-bytes 0x0d8d4c 3) (xg-bytes 0 4) (xg-rel 0xe8 1 1 entry)
      (xg-bytes 0xfdebf4fa 4)))
(defn- xi-patch-shim [M :vector-i64 data :i64 size :i64] :vector-i64
  (let [relative (- data 4096)]
    (-> M (xg-patch 4 (- (+ relative size) 8) 4)
        (xg-patch 15 (- (+ relative 152) 19) 4)
        (xg-patch 57 (- (+ relative 80) 61) 4)
        (xg-patch 64 (- relative 68) 4))))
(defn- xi-phdr [M :vector-i64 flags :i64 off :i64 size :i64] :vector-i64
  (-> M (xg-out 1 4) (xg-out flags 4) (xg-out off 8)
      (xg-out (+ 0x100000 off) 8) (xg-out (+ 0x100000 off) 8)
      (xg-out size 8) (xg-out size 8) (xg-out 4096 8)))
(defn- xi-data [M :vector-i64 data :i64 fuel :i64 isr-base :i64 size :i64 pci :bool] :vector-i64
  (let [context (+ 0x100000 data) tss (+ context 168)
        stack (+ context (if (lv-used? M) 131072 size))]
    (-> M (xg-pad data) (xg-out 0 8) (xg-out fuel 8)
        (xg-pad (+ data 96))
        (xg-out 0 8) (xg-out 0x00af9a000000ffff 8)
        (xg-out 0x00cf92000000ffff 8) (xg-out 0x00cff2000000ffff 8)
        (xg-out 0x00affa000000ffff 8)
        ;; 16-byte available 64-bit TSS descriptor, limit 103.
        (xg-out 103 2) (xg-out tss 3) (xg-out 0x89 1) (xg-out 0 1)
        (xg-out (u64-shift-right tss 24) 1) (xg-out (u64-shift-right tss 32) 4) (xg-out 0 4)
        ;; GDTR (56-byte GDT), then 104-byte TSS with RSP0 and no I/O bitmap.
        (xg-out 55 2) (xg-out (+ context 96) 8)
        (xg-pad (+ data 168)) (xg-out 0 4) (xg-out stack 8)
        (xg-pad (+ data 270)) (xg-out 104 2)
        (xg-pad (+ data 328)) (xg-out isr-base 8)
        (xg-out (if pci 0x31494350 0) 8)
        (xg-out (if (= (xg-get M 4) 2) (+ context (if pci 65536 20480)) 0) 8)
        (xg-pad (+ data 464)) (xg-out (cond (uv-used? M) (uv-magic) (lv-used? M) LV-MAGIC :else 0) 8)
        (lv-data data)
        (cond-> (uv-used? M) (xg-pad (+ data UV-HANDLER))
                  (uv-used? M) (xg-out (vector-at M 210) 8))
        (xg-pad (+ data size)))))
(defn- xi-elf [M :vector-i64 data :i64 fuel :i64 isr-base :i64 pci :bool] :vector-i64
  (let [text (xg-pos M) size (cond (uv-used? M) UV-DATA-SIZE (lv-used? M) LV-DATA-SIZE pci 131072 :else XI-DATA-SIZE) names (+ data size) sections (bit-and (+ names 30) -8)]
    (-> M (mem-set MM-OUT-N 1)
        (xg-out 0x00010102464c457f 8) (xg-out 0 8)
        (xg-out 2 2) (xg-out 62 2) (xg-out 1 4) (xg-out 0x101000 8)
        (xg-out 64 8) (xg-out sections 8) (xg-out 0 4)
        (xg-out 64 2) (xg-out 56 2) (xg-out 2 2) (xg-out 64 2) (xg-out 4 2) (xg-out 3 2)
        (xi-phdr 5 4096 text) (xi-phdr 6 data size)
        (xg-pad 4096) (xg-out-code 1) (xi-data data fuel isr-base size pci)
        (xg-out 0x2e00747865742e00 8) (xg-out 0x68732e0061746164 8) (xg-out 0x00626174727473 7)
        (xg-pad sections) (xg-pad (+ sections 64))
        (xo-shdr 1 1 6 0x101000 4096 text 0 0 16 0)
        (xo-shdr 7 1 3 (+ 0x100000 data) data size 0 0 4096 0)
        (xo-shdr 13 3 0 0 names 23 0 0 1 0))))
(defn- xi-build [M :vector-i64 S :string fuel :i64] :vector-i64
  (let [admitted (-> M (xg-set 0 0) (xg-set 1 0) (xg-set 2 fuel) (xg-set 4 0)
                    (xo-check-fns S 1) (xo-refuse-externs S 1) (xg-check-sir 1) (xk-scan S) (xk-check 1))
        entry (xg-get admitted 1)]
    (cond (not= (vector-at admitted MM-ERR) 0) admitted
          (or (= entry 0) (not= (xg-f admitted entry FF-NPARAMS) 0)) (xg-err admitted 7102 entry)
          (not= (vector-at admitted MM-CAPS) 0) (xg-err admitted 7101 OP-CAP)
          :else (let [generated (-> admitted (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1)
                                    (xg-index-labels 1) (xi-shim entry) (xg-code 1))
                      end (bit-and (+ (xg-pos generated) 15) -16)
                      data (max 32768 (bit-and (+ 8191 end) -4096))]
                  (if (or (>= (+ data XI-DATA-SIZE 280) MM-OUT-CAP) (> (xg-pos generated) 1048576))
                    (xg-err generated 7104 data)
                    (xi-elf (xi-patch-shim (xg-fix generated 1) data XI-DATA-SIZE) data fuel 0 false))))))
(defn- xi-source [S :string path :string out :string fuel :i64] :i64
  (let [text (string-concat (string-concat S (ck-r6b-lib S)) (xk-lib-for S)) front (xg-front text)
        image (if (= (vector-at front MM-ERR) 0) (xi-build front text fuel) front)
        e (vector-at image MM-ERR)]
    (cond (> e 0) (xo-report image path out)
          :else (let [n (dec (vector-at image MM-OUT-N)) written (out-write-v image out (+ MM-OUT-BASE 1) n)
                      w (io-out (string-concat "{:ok true, :target :x86_64-aiueos-kernel-v1, :format :elf64-exec, :bytes "
                                             (string-concat (mem-u2dec n) "}\n")))]
                  (if (= (io-exists out) 1) 0 (drv-fail0 E-WRITE))))))

(defn- xo-command [] :i64
  (let [n (io-argc) src (io-arg 1) explicit (string=? (io-arg 4) "--artifact")
        shift (if explicit 2 0) kind (if explicit (io-arg 5) "object") out (io-arg (+ 5 shift))
        fuel (if (= n (+ 8 shift)) (xg-budget (io-arg (+ 7 shift))) 1000000)]
    (cond (or (not (or (= n (+ 6 shift)) (= n (+ 8 shift))))
              (not (or (string=? kind "object") (string=? kind "image")))
              (not (string=? (io-arg (+ 4 shift)) "--output"))
              (and (= n (+ 8 shift)) (not (string=? (io-arg (+ 6 shift)) "--fuel"))) (< fuel 1)
              (= (string-length out) 0) (= (io-exists out) 1))
            (let [w (io-err "seed-x86_64-aiueos-object: E7100 expected compile SOURCE --target x86_64-aiueos-kernel-v1 [--artifact object|image] --output NEW [--fuel POSITIVE_BUDGET]\n")] 2)
          (= (io-exists src) 0) (drv-fail0 E-READ)
          (string=? kind "image") (xi-source (drv-read src) src out fuel)
          :else (xo-source (drv-read src) src out fuel))))

;; The selfhost AIUEOS CPL3 user-v1 ELF is the zero-argument scalar slice.
;; User-v2 keeps the same zero-capability context and result slot but passes
;; a bounded, OS-filled 64-byte Goal request region to a two-i64 main.
;; v3 adds one bounded, compiled local-model call through syscall5. It has no
;; generic syscall, Linux runtime, raw cap-call, heap or host transport.
(defn- xu-local-model-call [M :vector-i64 t :i64] :vector-i64
  ;; The only writable envelope is context+128..231, disjoint from the
  ;; private context and the Goal input at context+256. RDI names it for the
  ;; image-owned syscall5 entry. The version-2 envelope carries the complete
  ;; 1..51-byte Goal at offset 12, with zero padding through byte 103. The call
  ;; returns zero without an OS request unless the input is the exact 64-byte
  ;; region and ends in a-z.
  (let [fail (vector-at M MM-LABEL-N) done (inc fail)]
    (-> M (iv-reserve 2)
        (xg-load t 0x958b48) (xg-load (inc t) 0x8d8b48)
        (iv-hex "4883f940") (xg-rel 0x850f 2 2 fail)
        (iv-hex "48b8") (xg-bytes (if (string=? (io-arg 3) "x86_64-aiueos-user-v5")
                                   0x421100
                                   (if (string=? (io-arg 3) "x86_64-aiueos-user-v4")
                                     0x321100 0x221100)) 8)
        (iv-hex "4839c2") (xg-rel 0x850f 2 2 fail)
        (iv-hex "8b0283f801") (xg-rel 0x820f 2 2 fail)
        (iv-hex "83f833") (xg-rel 0x870f 2 2 fail)
        (iv-hex "4189c2")
        (iv-hex "8d40030fb60402")
        (iv-hex "83f861") (xg-rel 0x820f 2 2 fail)
        (iv-hex "83f87a") (xg-rel 0x870f 2 2 fail)
        (iv-hex "498db98000000031c0b90d000000f348ab")
        (iv-hex "41c78180000000") (xg-bytes 1364350539 4)
        (iv-hex "41c78184000000") (xg-bytes 1538 4)
        (iv-hex "45899188000000")
        (iv-hex "488d7204498db98c0000004489d1f3a4")
        (iv-hex (if (string=? (io-arg 3) "x86_64-aiueos-user-v5")
                  "498db980000000b830004200ffd04c8b4df8"
                  (if (string=? (io-arg 3) "x86_64-aiueos-user-v4")
                    "498db980000000b830003200ffd04c8b4df8"
                    "498db980000000b830002200ffd04c8b4df8")))
        (xg-rel 0xe9 1 2 done)
        (xg-label fail) (iv-hex "31c0")
        (xg-label done) (xg-save t))))
;; AIUEOS must admit and populate v2 separately; compiler success is not a
;; user turn or a guest execution result.
(defn- xu-input-lib [v3 :bool] :string
  (string-concat
   "\n(defn- kernel-load-u32 [b :i64 n :i64 i :i64] :i64 0)\n"
   (if v3 "(defn- kernel-local-model-call [b :i64 n :i64] :i64 0)\n" "")))
(defn- xu-header [M :vector-i64 v4 :bool v5 :bool] :vector-i64
  (-> M (xg-out 0x00010102464c457f 8) (xg-out 0 8)
      (xg-out 2 2) (xg-out 62 2) (xg-out 1 4)
      (xg-out (if v5 0x420000 (if v4 0x320000 0x220000)) 8)
      (xg-out 64 8) (xg-out 0 8) (xg-out 0 4) (xg-out 64 2)
      (xg-out 56 2) (xg-out 2 2) (xg-out 0 2) (xg-out 0 2) (xg-out 0 2)))
(defn- xu-rx [M :vector-i64 v4 :bool v5 :bool] :vector-i64
  (let [n (xg-pos M)]
    (-> M (xg-out 1 4) (xg-out 5 4) (xg-out 4096 8)
        (xg-out (if v5 0x420000 (if v4 0x320000 0x220000)) 8)
        (xg-out (if v5 0x420000 (if v4 0x320000 0x220000)) 8)
        (xg-out n 8) (xg-out n 8) (xg-out 4096 8))))
(defn- xu-rw [M :vector-i64 v2 :bool v4 :bool v5 :bool] :vector-i64
  ;; v5 reserves 256 KiB for a later bounded kit request/result ABI.
  ;; The current entry still receives the v2 64-byte input.
  (-> M (xg-out 1 4) (xg-out 6 4) (xg-out 8192 8)
      (xg-out (if v5 0x421000 (if v4 0x321000 0x221000)) 8)
      (xg-out (if v5 0x421000 (if v4 0x321000 0x221000)) 8)
      (xg-out 88 8) (xg-out (if v5 262144 (if v2 320 88)) 8)
      (xg-out 4096 8)))
(defn- xu-context [M :vector-i64 v2 :bool v4 :bool v5 :bool] :vector-i64
  (-> M (xg-out 0 8) (xg-out 256 8) (xg-out 0 1)
      (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)
      (xg-out 0 7)
      (xg-out (if v5 0x420030 (if v4 0x320030 (if v2 0x220030 0x220020))) 8)
      (xg-out 0 8) (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)))
(defn- xu-image [M :vector-i64 v2 :bool v4 :bool v5 :bool] :vector-i64
  (-> M (mem-set MM-OUT-N 1) (xu-header v4 v5) (xu-rx v4 v5) (xu-rw v2 v4 v5)
      (xg-pad 4096) (xg-out-code 1) (xg-pad 8192) (xu-context v2 v4 v5)))
(defn- xu-nops [M :vector-i64 end :i64] :vector-i64
  (if (or (not= (vector-at M MM-ERR) 0) (>= (xg-pos M) end)) M
    (xu-nops (xg-byte M 0x90) end)))
(defn- xu-input-args [M :vector-i64] :vector-i64
  ;; RDI = request+256; RSI = 64. R9 remains the private context pointer.
  (-> M (xg-bytes 0x00000100b98d49 7) (xg-bytes 0x40be 5)))
(defn- xu-entry [M :vector-i64 entry :i64 v2 :bool v3 :bool] :vector-i64
  (-> M (xg-rel 0x0d8d4c 3 3 0)
      (cond-> v2 (xu-input-args))
      (xg-rel 0xe8 1 1 entry)
      (xg-rel 0x058948 3 3 0) (xg-bytes 0x90f3 2)
      (xg-bytes 0xfceb 2) (xu-nops (if v2 48 32))
      ;; v3 accepts a bounded envelope pointer in RDI; v1/v2 retain their
      ;; historical zero-capability trampoline bytes unchanged.
      (xg-bytes 0x000005b8 4) (xg-byte 0x00)
      (cond-> v3 (iv-hex "4883ec08"))
      (cond-> (not v3) (xg-bytes 0x507f8b48 4))
      (xg-bytes 0x050f 2)
      (cond-> v3 (iv-hex "4883c408"))
      (xg-byte 0xc3)
      (xu-nops (if v2 80 64))))
(defn- xu-main? [M :vector-i64 S :string] :bool
  (let [f (xg-get M 1)
        sym (xg-f M f FF-SYM)
        sb (+ MM-SYM-BASE (* sym MM-SYM-W))]
    (string=? (string-substring S (vector-at M (+ sb SF-START))
                (vector-at M (+ sb SF-END))) "main")))
(defn- xu-build [M :vector-i64 S :string v2 :bool v3 :bool v4 :bool v5 :bool] :vector-i64
  (let [base (-> M (xg-set 0 0) (xg-set 1 0) (xg-set 2 256) (xg-set 4 0)
                 (mem-set XU-LOCAL-CALL-FLAG (if v3 1 0)))
        checked (if v2 (xo-check-fns base S 1) (xg-check-fns base S 1))
        a (xg-check-sir (xo-refuse-externs checked S 1) 1)
        b (if v2 (xk-check (xk-scan-count a S (if v3 2 1) v3) 1) a)]
    (cond (not= (vector-at b MM-ERR) 0) b
          (= (xg-get b 1) 0) (xg-err b 7102 0)
          (not (xu-main? b S)) (xg-err b 7102 (xg-get b 1))
          (not= (xg-f b (xg-get b 1) FF-NPARAMS) (if v2 2 0))
            (xg-err b 7102 (xg-get b 1))
          (and v2 (or (not= (xg-f b (xg-get b 1) FF-RTYPE) TY-I64)
                      (not= (ck-pt b (xg-get b 1) 0) TY-I64)
                      (not= (ck-pt b (xg-get b 1) 1) TY-I64)))
            (xg-err b 7102 (xg-get b 1))
          (not= (vector-at b MM-CAPS) 0) (xg-err b 7101 OP-CAP)
          :else (let [g (-> b (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1)
                            (xg-index-labels 1) (xu-entry (xg-get b 1) v2 v3)
                            (xg-code 1))]
                  (if (or (> (xg-pos g) 4096) (>= 8281 MM-OUT-CAP))
                    (xg-err g 7104 (xg-pos g))
                    (xu-image (xg-fix (xg-set g 3 8192) 1) v2 v4 v5))))))
(defn- xu-command [] :i64
  (let [src (io-arg 1) out (io-arg 5)
        v5 (string=? (io-arg 3) "x86_64-aiueos-user-v5")
        v4 (string=? (io-arg 3) "x86_64-aiueos-user-v4")
        v3 (or v5 v4 (string=? (io-arg 3) "x86_64-aiueos-user-v3"))
        v2 (or v5 v3 (string=? (io-arg 3) "x86_64-aiueos-user-v2"))]
    (cond (or (not= (io-argc) 6) (not (string=? (io-arg 4) "--output"))
              (= (string-length out) 0) (= (io-exists out) 1))
          (drv-fail0 E-USAGE)
          (= (io-exists src) 0) (drv-fail0 E-READ)
          :else (let [source (drv-read src)
                      s (if v2 (string-concat source (xu-input-lib v3)) source)
                      front (xg-front s)
                      image (if (= (vector-at front MM-ERR) 0) (xu-build front s v2 v3 v4 v5) front)]
                  (if (not= (vector-at image MM-ERR) 0)
                    (xo-report image src out)
                    (let [n (dec (vector-at image MM-OUT-N))
                          written (out-write-v image out (+ MM-OUT-BASE 1) n)
                          target (if v5 ":x86_64-aiueos-user-v5"
                                   (if v4 ":x86_64-aiueos-user-v4"
                                   (if v3 ":x86_64-aiueos-user-v3"
                                     (if v2 ":x86_64-aiueos-user-v2" ":x86_64-aiueos-user-v1"))))
                          w (io-out (string-concat "{:ok true, :target "
                                    (string-concat target
                                      (string-concat ", :format :elf64-exec, :bytes "
                                        (string-concat (mem-u2dec n) "}\n")))))]
                      (if (= (io-exists out) 1) 0 (drv-fail0 E-WRITE))))))))
