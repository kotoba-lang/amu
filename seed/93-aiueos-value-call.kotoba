;; Finite CPL0 call gate for the eight typed ValueRuntime root exports.
;; This is not a SYSCALL handler. Private request pages remain supervisor
;; buffers until a separately qualified user mapping/entry mechanism exists.
(def LV-CALL 85)
(def LV-REQUEST 32896)
(def LV-TABLE 30208)
(def LV-REQUEST-PAGES 131072)
(def LV-DATA-SIZE 147456)
(defn- lv-data [M :vector-i64 data :i64] :vector-i64
  (if (not (lv-used? M)) M
    (let [padded (xg-pad M (+ data LV-TABLE))]
      (loop [id 0]
        (if (= id 8) M
          (let [w (xg-out M (vector-at M (+ (vector-at M 209) id)) 8)]
            (recur (inc id))))))))
(defn- lv-id [name :string] :i64
  (cond (string=? name "aiueos-value-runtime-entry") 0
        (string=? name "aiueos-value-runtime-syscall-plan") 1
        (string=? name "aiueos-value-runtime-publish-domain") 2
        (string=? name "aiueos-value-runtime-provider-status") 3
        (string=? name "aiueos-value-runtime-capability-grant") 4
        (string=? name "aiueos-value-runtime-provider-claim") 5
        (string=? name "aiueos-value-runtime-provider-complete") 6
        (string=? name "aiueos-value-runtime-cas-verify") 7 :else -1))
(defn- lv-arity [id :i64] :i64 (case id 2 1 3 2 5 0 5))
(defn- lv-typed? [M :vector-i64 f :i64 id :i64] :bool
  (and (>= id 0) (= (xg-f M f FF-NPARAMS) (lv-arity id))
       (= (xg-f M f FF-RTYPE) TY-I64)
       (loop [p 0]
         (cond (>= p (lv-arity id)) true
               (not= (ck-pt M f p) TY-I64) false :else (recur (inc p))))))
(defn- lv-param-region [M :vector-i64 f :i64 p :i64] :i64
  (if (or (not (xk-project-proof? M)) (<= (vector-at M 207) 0)) -1
    (let [id (dec (vector-at M (+ (vector-at M 207) f)))
          n (cond (= id 0) (case p 1 4096 3 4096 4 96 5 4096 -1)
                  (= id 6) (if (= p 3) -2 -1)
                  (= id 7) (case p 1 -2 3 32 4 32 5 352 -1) :else -1)]
      (cond (= n -2) (+ 8589934592 (inc p)) (> n 0) (+ 4294967296 n) :else -1))))
;; The range is a subrange of the sealed 15-page allocation. Pointer and
;; length are loaded from declared arguments, not from an untrusted header.
(defn- lv-owned-check [M :vector-i64 pointer :i64 length :i64 fixed :i64 fail :i64] :vector-i64
  (let [loaded (xg-load M pointer 0x858b48)
        sized (if (> fixed 0) (-> loaded (iv-hex "b9") (xg-bytes fixed 4))
                  (xg-load loaded length 0x8d8b48))]
    (-> sized (iv-hex "4883f901") (xg-rel 0x820f 2 2 fail)
        (iv-hex "4881f900300000") (xg-rel 0x870f 2 2 fail)
        (iv-hex "498b91") (xg-bytes KM-SEALED-SCRATCH 4)
        (iv-hex "4839d0") (xg-rel 0x820f 2 2 fail)
        (iv-hex "4829d0483d00f00000") (xg-rel 0x870f 2 2 fail)
        (iv-hex "ba00f000004829c24839d1") (xg-rel 0x870f 2 2 fail))))
(defn- lv-exact-context [M :vector-i64 temp :i64 offset :i64 fail :i64] :vector-i64
  (-> M (xg-load temp 0x858b48) (iv-hex "498d91") (xg-bytes offset 4)
      (iv-hex "4839d0") (xg-rel 0x850f 2 2 fail)))
(defn- lv-entry-check [M :vector-i64 t :i64 fail :i64] :vector-i64
  (-> M (xg-load (+ t 2) 0x858b48) (iv-hex "48c1e81025ffff0000")
      (iv-hex "493981") (xg-bytes LV-DOMAIN 4) (xg-rel 0x850f 2 2 fail)
      (lv-domain-slot false) (iv-hex "83f904") (xg-rel 0x830f 2 2 fail)
      (iv-hex "89c848c1e00c4c01c84805") (xg-bytes LV-ARENAS 4)
      (xg-load (inc t) 0x958b48) (iv-hex "4839d0") (xg-rel 0x850f 2 2 fail)
      (uv-page-address 1)
      (xg-load (+ t 3) 0x958b48) (iv-hex "4839d0") (xg-rel 0x850f 2 2 fail)
      (lv-exact-context (+ t 4) LV-REQUEST fail)
      (lv-exact-context (+ t 5) LV-CAPS fail)))
(defn- lv-call [M :vector-i64 t :i64] :vector-i64
  (let [base (vector-at M MM-LABEL-N) trap base zero (inc base)
        call (+ base 2) done (+ base 3) entry (+ base 4) complete (+ base 5) cas (+ base 6)]
    (-> M (iv-reserve 7) (lv-guard trap)
        (iv-hex "9c415a41f7c200020000") (xg-rel 0x850f 2 2 zero)
        (xg-load t 0x858b48) (iv-hex "4883f808") (xg-rel 0x830f 2 2 zero)
        (iv-hex "4883f800") (xg-rel 0x840f 2 2 entry)
        (iv-hex "4883f806") (xg-rel 0x840f 2 2 complete)
        (iv-hex "4883f807") (xg-rel 0x840f 2 2 cas)
        (xg-rel 0xe9 1 2 call)
        (xg-label entry) (lv-entry-check t zero) (xg-rel 0xe9 1 2 call)
        (xg-label complete) (lv-owned-check (+ t 3) (+ t 4) 0 zero) (xg-rel 0xe9 1 2 call)
        (xg-label cas) (lv-owned-check (inc t) (+ t 2) 0 zero)
        (lv-owned-check (+ t 3) 0 32 zero)
        (lv-exact-context (+ t 4) LV-CAS zero)
        (lv-exact-context (+ t 5) (+ LV-CAS 32) zero)
        (xg-label call)
        (xg-load t 0x858b48) (iv-hex "4d8b9cc1") (xg-bytes LV-TABLE 4)
        (iv-hex "4d85db") (xg-rel 0x840f 2 2 zero)
        (xg-call-args (inc t) 0 5) (iv-hex "41ffd3")
        (xg-rel 0xe9 1 2 done)
        (xg-label trap) (iv-hex "0f0b")
        (xg-label zero) (iv-hex "31c0") (xg-label done) (xg-save t))))
