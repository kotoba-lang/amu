;; END GENERATED SPELLINGS

;; SF-HEAD value of a new spelling S[a..b).
(defn- nm-ascii-span? [S :string a :i64 b :i64] :bool
  (loop [i a] (cond (>= i b) true (> (string-code-point-at S i) 127) false :else (recur (+ i 1)))))
(defn- nm-spelling-code [S :string a :i64 b :i64] :i64
  (if (or (> (- b a) 24) (not (nm-ascii-span? S a b)))
    0
    (let [w0 (nm-pack S a b 0) w1 (nm-pack S a b 1) w2 (nm-pack S a b 2)]
      (if (= (string-code-point-at S a) 58)
        (nm-kw-code w0 w1 w2)
        (nm-head-code w0 w1 w2)))))

;; ---------------------------------------------------------------------------------------------------------
;; interning
;; ---------------------------------------------------------------------------------------------------------
;; 1 when S[a1..b1) and S[a2..b2) hold the same bytes, else 0 (Seed-0 has no boolean literals)
(defn- nm-span-eq [S :string a1 :i64 b1 :i64 a2 :i64 b2 :i64] :i64
  (if (= (- b1 a1) (- b2 a2))
    (loop [i 0]
      (cond (= (+ a1 i) b1) 1
            (= (string-code-point-at S (+ a1 i)) (string-code-point-at S (+ a2 i)))
              (recur (+ i (mem-cpw (string-code-point-at S (+ a1 i)))))
            :else 0))
    0))

;; probe: the symbol id spelled S[a..b) when present, else -(slot + 1) of the empty slot to fill.
(defn- nm-probe [M :vector-i64 S :string a :i64 b :i64 h :i64] :i64
  (loop [slot (bit-and h (- MM-HASH-CAP 1)) n 0]
    (let [s (vector-at M (+ MM-HASH-BASE slot))]
      (cond (= s 0) (- 0 (+ slot 1))
            (= (* (nm-eqi (nm-sf M s SF-HASH) h)
                  (nm-span-eq S (nm-sf M s SF-START) (nm-sf M s SF-END) a b)) 1) s
            :else (recur (bit-and (+ slot 1) (- MM-HASH-CAP 1)) (+ n 1))))))

(defn- nm-new-sym [M :vector-i64 S :string a :i64 b :i64 h :i64] :vector-i64
  (let [s (vector-at M MM-SYM-N)
        slot (- (- 0 (nm-probe M S a b h)) 1)]
    (if (< s MM-SYM-CAP)
      (let [hn (vector-at M MM-HASH-N)
            code (nm-spelling-code S a b)
            M1 (nm-put M (nm-sa s SF-START) a)
            M2 (nm-put M1 (nm-sa s SF-END) b)
            M3 (nm-put M2 (nm-sa s SF-HASH) h)
            M4 (nm-put M3 (nm-sa s SF-HEAD) code)
            M5 (nm-put M4 (+ MM-HASH-BASE slot) s)
            M6 (nm-put M5 MM-HASH-N (+ hn 1))
            M7 (nm-put M6 MM-SYM-N (+ s 1))]
        (nm-put M7 MM-R0 s))
      (nm-put (nm-err M E-HEAP-REGION 0 5) MM-R0 0))))

;; intern S[a..b): M, R0 = the symbol id (ids in first-occurrence order of the calls).
(defn- nm-intern [M :vector-i64 S :string a :i64 b :i64] :vector-i64
  (let [h (nm-hash S a b)
        p (nm-probe M S a b h)]
    (if (> p 0)
      (nm-put M MM-R0 p)
      (nm-new-sym M S a b h))))

;; intern the token of every ND-SYM / ND-KW node, nodes n .. NODE-N-1, in node index order.
(defn- nm-intern-nodes [M :vector-i64 S :string n :i64] :vector-i64
  (cond
    (>= n (vector-at M MM-NODE-N)) (nm-touch M)
    (nm-failed M) (nm-touch M)
    :else
    (let [k (nm-kind M n)]
      (if (nm-is-name k)
        (let [t (nm-nf M n NF-TOK)
              a0 (nm-tf M t TF-START)
              b (nm-tf M t TF-END)
              a (if (= k ND-SYM) (nm-r6b-core a0 b S) a0)   ; R6B: clojure.core/f is f
              M1 (nm-intern M S a b)
              s (vector-at M1 MM-R0)
              M2 (nm-set-nf M1 n NF-SYM s)]
          (nm-intern-nodes M2 S (+ n 1)))
        (nm-intern-nodes M S (+ n 1))))))

;; ---------------------------------------------------------------------------------------------------------
;; the ns form and the FN table
;; ---------------------------------------------------------------------------------------------------------
;; true when every child of node n is an ND-SYM
(defn- nm-all-syms [M :vector-i64 n :i64] :bool
  (loop [c (nm-first M n)]
    (cond (zero? c) true
          (= (nm-kind M c) ND-SYM) (recur (nm-next M c))
          :else false)))

;; true when c is a well-formed (:export [sym ...]) clause (reads of node 0 are harmless: the null record)
(defn- nm-export-ok [M :vector-i64 c :i64] :bool
  (let [k (nm-first M c)
        v (nm-nth M c 1)]
    (and (= (nm-kind M c) ND-LIST) (= (nm-count M c) 2)
         (= (nm-kind M k) ND-KW) (= (nm-head-of M k) KW-EXPORT)
         (= (nm-kind M v) ND-VEC) (nm-all-syms M v))))

;; R4B: true when c is a (:schemas {..}) clause (21-check checks the entries in pass A0)
(defn- nm-schemas-ok [M :vector-i64 c :i64] :bool
  (let [k (nm-first M c)]
    (and (= (nm-kind M c) ND-LIST) (= (nm-count M c) 2)
         (= (nm-kind M k) ND-KW) (= (nm-head-of M k) KW-SCHEMAS)
         (= (nm-kind M (nm-nth M c 1)) ND-MAP))))

;; true when n is (ns NAME) or (ns NAME (:export [sym ...])); R4B: plus at most one (:schemas {..}) clause, in either order
(defn- nm-ns-ok [M :vector-i64 n :i64] :bool
  (and (not= n 0)
       (= (nm-kind M n) ND-LIST)
       (= (nm-kind M (nm-first M n)) ND-SYM)
       (= (nm-head-of M (nm-first M n)) HD-NS)
       (= (nm-kind M (nm-nth M n 1)) ND-SYM)
       (case (nm-count M n)
         2 true
         3 (or (nm-export-ok M (nm-nth M n 2)) (nm-schemas-ok M (nm-nth M n 2)))
         4 (or (and (nm-export-ok M (nm-nth M n 2)) (nm-schemas-ok M (nm-nth M n 3)))
               (and (nm-schemas-ok M (nm-nth M n 2)) (nm-export-ok M (nm-nth M n 3))))
         false)))

;; head code of a top-level list form whose head is a symbol, else 0
(defn- nm-form-head [M :vector-i64 n :i64] :i64
  (if (and (= (nm-kind M n) ND-LIST) (= (nm-kind M (nm-first M n)) ND-SYM))
    (nm-head-of M (nm-first M n))
    0))

(defn- nm-form-kind [hd :i64] :i64
  (case hd HD-DEFN FK-DEFN HD-DEFN-PRIV FK-PRIV HD-DEF FK-DEF 0))

;; number of ND-SYM children of node n (R1: a parameter vector may leave a type out: [a b :i64])
(defn- nm-count-syms [M :vector-i64 n :i64] :i64
  (loop [c (nm-first M n) i 0]
    (cond (= c 0) i
          ;; R4: the rest marker `&` of [p & rest] is not a parameter
          (and (= (nm-kind M c) ND-SYM) (nm-ne (nm-head-of M c) HD-AMP)) (recur (nm-next M c) (+ i 1))
          :else (recur (nm-next M c) i))))

;; JUN-729: the parameters of parameter vector n: its symbols (not `&`) and its destructuring patterns -- a map, or a
;; vector that is not a type form (a type form [:list ..] starts with a keyword); 21-check replaces each pattern by a
;; fresh parameter
(defn- nm-count-params [M :vector-i64 n :i64] :i64
  (loop [c (nm-first M n) i 0]
    (cond (= c 0) i
          (and (= (nm-kind M c) ND-SYM) (nm-ne (nm-head-of M c) HD-AMP)) (recur (nm-next M c) (+ i 1))
          (= (nm-kind M c) ND-MAP) (recur (nm-next M c) (+ i 1))
          (and (= (nm-kind M c) ND-VEC) (or (= (nm-first M c) 0) (nm-ne (nm-kind M (nm-first M c)) ND-KW))) (recur (nm-next M c) (+ i 1))
          :else (recur (nm-next M c) i))))

;; parameter count of a defn form: the parameters of its third child when that is a vector
(defn- nm-nparams [M :vector-i64 n :i64 fk :i64] :i64
  (let [p (nm-nth M n 2)]
    (cond (= fk FK-DEF) 0
          (= (nm-kind M p) ND-VEC) (nm-count-params M p)
          :else 0)))

;; 1 for an R0 head code (1..42): a definition may not take that name. R1 heads (43..) are library sugar that a
;; definition of the same name shadows, as in Clojure (corpus 046-compose defines `inc`); 21-check then calls it.
(defn- nm-r0-head [hd :i64] :bool (and (>= hd 1) (<= hd HD-VECTOR-I64-FROM-BYTES)))

;; register the def form n (kind fk) as a new FN record
(defn- nm-add-fn [M :vector-i64 n :i64 fk :i64] :vector-i64
  (let [nm (nm-nth M n 1)
        s (nm-sym-of M nm)
        f (vector-at M MM-FN-N)]
    (cond
      (> (nm-sf M s SF-FN) 0) (nm-err-node M E-NAMES-DUP nm 0)
      (nm-r0-head (nm-sf M s SF-HEAD)) (nm-err-node M E-NAMES-DUP nm 0)
      (>= f MM-FN-CAP) (nm-err M E-HEAP-REGION 0 6)
      ;; R4: a multi-arity defn (defn NAME ([p ..] body ..) ([q ..] ..)): one FN record per clause, consecutive
      (and (nm-ne fk FK-DEF) (= (nm-kind M (nm-nth M n 2)) ND-LIST)) (nm-clauses (nm-set-sf M s SF-FN f) n fk (nm-nth M n 2))
      :else
      (let [np (nm-nparams M n fk)
            M1 (nm-put M (nm-fa f FF-SYM) s)
            M2 (nm-put M1 (nm-fa f FF-NODE) n)
            M3 (nm-put M2 (nm-fa f FF-KIND) fk)
            M4 (nm-put M3 (nm-fa f FF-NPARAMS) np)
            M5 (nm-put M4 (nm-sa s SF-FN) f)]
        (nm-put M5 MM-FN-N (+ f 1))))))

;; R4: the FN records of the clauses from c of the multi-arity defn n (each FF-NODE = n until 21-check gives the clause its
;; own (defn NAME [..] :R body) node; FF-NPARAMS = the symbols of the clause's parameter vector, `&` not counted)
(defn- nm-clauses [M :vector-i64 n :i64 fk :i64 c :i64] :vector-i64
  (let [f (vector-at M MM-FN-N)
        s (nm-sym-of M (nm-nth M n 1))
        p (nm-first M c)]
    (cond (= c 0) (nm-touch M)
          (>= f MM-FN-CAP) (nm-err M E-HEAP-REGION 0 6)
          :else (nm-clauses (-> M (nm-put (nm-fa f FF-SYM) s) (nm-put (nm-fa f FF-NODE) n) (nm-put (nm-fa f FF-KIND) fk)
                                (nm-put (nm-fa f FF-NPARAMS) (if (= (nm-kind M p) ND-VEC) (nm-count-params M p) 0))
                                (nm-put MM-FN-N (+ f 1)))
                            n fk (nm-next M c)))))

;; the node a top-level refusal names: the head of a non-empty list, else the form itself
(defn- nm-name-node [M :vector-i64 n :i64] :i64
  (cond (= (nm-first M n) 0) n
        (= (nm-kind M n) ND-LIST) (nm-first M n)
        :else n))

;; one top-level form after the ns form. R1: (defrecord Name [..]) is admitted here and registered by 21-check.
(defn- nm-top [M :vector-i64 n :i64] :vector-i64
  (let [hd (nm-form-head M n)
        fk (nm-form-kind hd)
        nn (nm-name-node M n)]
    (cond
      (= hd HD-NS) (nm-err-node M E-NAMES-NS n 0)
      (= hd HD-DEFRECORD) (nm-touch M)
      ;; R5B (agent R5B): (defhandler NAME ..) is registered by 21-check (two clause functions)
      (= hd HD-DEFHANDLER) (nm-touch M)
      (= fk 0) (nm-err-node M E-NAMES-TOP nn 0)
      (= (nm-kind M (nm-nth M n 1)) ND-SYM) (nm-add-fn M n fk)
      :else (nm-err-node M E-NAMES-TOP nn 0))))

(defn- nm-tops [M :vector-i64 n :i64] :vector-i64
  (cond
    (= n 0) (nm-touch M)
    (nm-failed M) (nm-touch M)
    :else
    (let [nx (nm-next M n)
          M1 (nm-top M n)]
      (nm-tops M1 nx))))

;; mark the exported functions: c = the next symbol of the export vector
(defn- nm-exports [M :vector-i64 c :i64] :vector-i64
  (let [f (nm-sf M (nm-sym-of M c) SF-FN)]
    (cond
      (= c 0) (nm-touch M)
      (nm-failed M) (nm-touch M)
      (= f 0) (nm-err-node M E-NAMES-EXPORT c 0)
      (= (nm-ff M f FF-KIND) FK-DEF) (nm-err-node M E-NAMES-EXPORT c 0)
      :else
      (let [nx (nm-next M c)
            M1 (nm-set-ff M f FF-EXPORT 1)]
        (nm-exports M1 nx)))))

;; R4B: the (:export ..) clause of the ns form, 0 when there is none
(defn- nm-export-clause [M :vector-i64 ns :i64] :i64
  (cond (nm-export-ok M (nm-nth M ns 2)) (nm-nth M ns 2)
        (nm-export-ok M (nm-nth M ns 3)) (nm-nth M ns 3)
        :else 0))
;; the first symbol node of the ns form's export vector, 0 when there is none
(defn- nm-export-first [M :vector-i64 ns :i64] :i64
  (let [c (nm-export-clause M ns)] (if (zero? c) 0 (nm-first M (nm-nth M c 1)))))

;; R1: without an (:export [..]) clause (no ns form, or (ns NAME)) every defn is an IMPLICIT export: FF-EXPORT = 2,
;; which 21-check turns into 1 (exportable signature) or 0 (seed/MEMORY-MAP FK-* note).
(defn- nm-implicit-exports [M :vector-i64 f :i64] :vector-i64
  (cond (>= f (vector-at M MM-FN-N)) (nm-touch M)
        (= (nm-ff M f FF-KIND) FK-DEFN) (nm-implicit-exports (nm-set-ff M f FF-EXPORT 2) (+ f 1))
        :else (nm-implicit-exports M (+ f 1))))

(defn- nm-defs-exports [M :vector-i64 ns :i64] :vector-i64
  (if (pos? (nm-export-clause M ns))
    (nm-exports M (nm-export-first M ns))
    (nm-implicit-exports M 1)))

(defn- nm-defs [M :vector-i64 ns :i64] :vector-i64
  (let [nx (nm-next M ns)
        M1 (nm-put M MM-NS-NODE ns)
        M2 (nm-tops M1 nx)]
    (nm-defs-exports M2 ns)))

;; R1: a file without an ns form: every top-level form is a definition, all defns are implicit exports
(defn- nm-defs-nons [M :vector-i64 first :i64] :vector-i64
  (let [M1 (nm-put M MM-NS-NODE 0)
        M2 (nm-tops M1 first)]
    (nm-implicit-exports M2 1)))

;; ==== R6B (agent R6B, 2026-10-03, delimited): the reference's top-level shapes on EVERY route (R6A read them on the project
;; route only, 60-proj pj-norm; CONTRACT-REQUESTS 2026-10-03 R6A -> 20-names):
;;   (defn NAME "doc" ..) / (defn- ..) / (def NAME "doc" value): the docstring is unlinked (a def keeps a string VALUE: only a
;;   string followed by another child is a docstring), then a defn's attr-map {..} likewise (when more children follow);
;;   a top-level `nil` (what #?(:kotoba nil :default ..) reads as) is unlinked;
;;   `clojure.core/f` interns as `f` (nm-intern-nodes; on the project route 60-proj has narrowed the token already).
(defn- nm-r6b-core [a :i64 b :i64 S :string] :i64
  (if (and (> b (+ a 13)) (= (string-code-point-at S a) 99) (nm-ascii-span? S a (+ a 13)) (= (string-code-point-at S (+ a 12)) 47)
           (string=? (string-substring S a (+ a 13)) "clojure.core/"))
    (+ a 13)
    a))
(defn- nm-r6b-unlink-after [M :vector-i64 n :i64 prev :i64] :vector-i64
  (let [x (nm-next M prev)
        M1 (nm-set-nf M prev NF-NEXT (nm-next M x))]
    (nm-set-nf M1 n NF-AUX (- (nm-nf M1 n NF-AUX) 1))))
(defn- nm-r6b-strip [M :vector-i64 n :i64] :vector-i64
  (let [hd (nm-form-head M n)
        defn? (or (= hd HD-DEFN) (= hd HD-DEFN-PRIV))
        nmn (nm-nth M n 1)
        d (nm-next M nmn)
        M1 (if (and (or defn? (= hd HD-DEF)) (nm-ne nmn 0) (= (nm-kind M d) ND-STR) (nm-ne (nm-next M d) 0))
             (nm-r6b-unlink-after M n nmn)
             (nm-touch M))
        a (nm-next M1 nmn)]
    (if (and defn? (nm-ne nmn 0) (= (nm-kind M1 a) ND-MAP) (nm-ne (nm-next M1 a) 0))
      (nm-r6b-unlink-after M1 n nmn)
      (nm-touch M1))))
;; FNV-1a of "nil"
(defn- nm-r6b-nil? [M :vector-i64 n :i64] :bool
  (and (= (nm-kind M n) ND-SYM) (= (nm-sf M (nm-nf M n NF-SYM) SF-HASH) 2397808468787316396)))
(defn- nm-r6b-norm [M :vector-i64] :vector-i64
  (let [root (vector-at M MM-ROOT)]
    (loop [M1 M n (nm-first M root) prev 0]
      (cond (zero? n) (nm-touch M1)
            (nm-r6b-nil? M1 n)
            (let [M2 (if (zero? prev) (nm-set-nf M1 root NF-FIRST (nm-next M1 n)) (nm-set-nf M1 prev NF-NEXT (nm-next M1 n)))
                  M3 (nm-set-nf M2 root NF-AUX (- (nm-nf M2 root NF-AUX) 1))]
              (recur M3 (nm-next M3 n) prev))
            (= (nm-kind M1 n) ND-LIST) (let [M2 (nm-r6b-strip M1 n)] (recur M2 (nm-next M2 n) n))
            :else (recur M1 (nm-next M1 n) n)))))
;; ==== END R6B top-level shapes ====

;; ==== JUN-730: closed static dispatch (lang/guest-grammar.edn :closed-multimethod, :protocol-dispatch, :protocol-extension).
;; Reader sugar, expanded here before any name is registered, into plain top-level defns of this module:
;;   (defmulti NAME [doc] DISPATCH) and every (defmethod NAME KEY [params] body ..) of the module ->
;;     (defn NAME [params] (case (DISPATCH p ..) KEY body .. [the :default body])), in place of the defmulti.
;;     DISPATCH is an unqualified symbol or a keyword; KEY an integer or keyword literal; all parameter vectors identical
;;     and plain (symbols, each optionally typed); several body forms are one (do ..). No hierarchy, prefer or extension.
;;   (defprotocol P [doc] (m [this ..] [doc]) ..) declares the methods; an implementation (m [this ..] body ..) of P for a
;;     record R of this module -- inline in (defrecord R [..] P ..), in (extend-type R P ..) or in (extend-protocol P R ..) --
;;     becomes (defn- G [this [:ref R] ..] body ..) in place of its owner form (after the defrecord), G a gensym; its list
;;     node carries NF-SYM = m. A `default` section of extend-protocol is specialized (cloned) for every record of the module
;;     that has no implementation of P [not yet: E2006, see below]. 21-check resolves (m x ..) on the static record type of x.
;; Refused: E2006 a malformed form (and, for now, an extend-protocol `default` section: its per-record specialization was
;; cut to fit the static token table before JUN-737 raised it; admitting it is separate work), E2007 a defmethod/extension of a multimethod, protocol or record this module does not
;; declare (no cross-module or runtime extension), E2001 a method name that is also defined (or declared twice).
(defn- nm-dp-hash [M :vector-i64 n :i64] :i64 (if (= (nm-kind M n) ND-SYM) (nm-sf M (nm-sym-of M n) SF-HASH) 0))
;; 1 defmulti 2 defmethod 3 defprotocol 4 extend-type 5 extend-protocol 6 defrecord with implementations, else 0
;; (FNV-1a of the head spelling)
(defn- nm-dp-kind [M :vector-i64 n :i64] :i64
  (if (nm-ne (nm-kind M n) ND-LIST)
    0
    (let [h (nm-dp-hash M (nm-first M n))]
      (cond (= h 7861214348977533273) 1
            (= h 3326915533004130693) 2
            (= h -1958457126718279464) 3
            (= h -3664327388371435996) 4
            (= h -4425811502593754760) 5
            (and (= (nm-form-head M n) HD-DEFRECORD) (> (nm-count M n) 3)) 6
            :else 0))))
(defn- nm-dp-root [M :vector-i64] :i64 (nm-first M (vector-at M MM-ROOT)))
(defn- nm-dp-any? [M :vector-i64] :bool
  (loop [c (nm-dp-root M)] (cond (zero? c) false (pos? (nm-dp-kind M c)) true :else (recur (nm-next M c)))))
;; FNV-1a of :default
(defn- nm-dp-default-kw? [M :vector-i64 k :i64] :bool (= (nm-sf M (nm-sym-of M k) SF-HASH) -3101751874453212538))

;; a new node (the fields not set stay zero: no node past MM-NODE-N was written); R0 = its index
(defn- nm-dp-new [M :vector-i64 kind :i64 tok :i64 sym :i64 f0 :i64] :vector-i64
  (let [n (vector-at M MM-NODE-N)]
    (if (< n MM-NODE-CAP)
      (-> M (nm-set-nf n NF-KIND kind) (nm-set-nf n NF-FIRST f0) (nm-set-nf n NF-TOK tok) (nm-set-nf n NF-SYM sym)
          (nm-put MM-NODE-N (+ n 1)) (nm-put MM-R0 n))
      (nm-put (nm-err M E-HEAP-REGION 0 4) MM-R0 0))))
;; a node of kind kind whose symbol is a fresh gensym with SF-HEAD = code (a head code, a KW-* code, or 0 for a fresh name)
(defn- nm-dp-gnode [M :vector-i64 kind :i64 tok :i64 code :i64] :vector-i64
  (let [M1 (nm-gensym M (nm-tf M tok TF-START) code)]
    (nm-dp-new M1 kind tok (vector-at M1 MM-R0) 0)))

;; a type form: a keyword or a vector that starts with a keyword
(defn- nm-dp-tform? [M :vector-i64 t :i64] :bool
  (or (= (nm-kind M t) ND-KW) (and (= (nm-kind M t) ND-VEC) (= (nm-kind M (nm-first M t)) ND-KW))))
;; a plain parameter vector: one or more symbols (not &), each optionally followed by one type form
(defn- nm-dp-plain? [M :vector-i64 v :i64] :bool
  (and (= (nm-kind M v) ND-VEC) (= (nm-kind M (nm-first M v)) ND-SYM)
       (loop [c (nm-first M v) after-sym false]
         (cond (zero? c) true
               (and (= (nm-kind M c) ND-SYM) (nm-ne (nm-head-of M c) HD-AMP)) (recur (nm-next M c) true)
               (and after-sym (nm-dp-tform? M c)) (recur (nm-next M c) false)
               :else false))))
;; structural equality of two trees (kinds, symbols, integer values)
(defn- nm-dp-same? [M :vector-i64 a :i64 b :i64] :bool
  (cond (nm-ne (nm-kind M a) (nm-kind M b)) false
        (nm-ne (nm-sym-of M a) (nm-sym-of M b)) false
        (and (= (nm-kind M a) ND-INT) (nm-ne (nm-nf M a NF-AUX) (nm-nf M b NF-AUX))) false
        (= (nm-kind M a) ND-STR) false
        :else (loop [x (nm-first M a) y (nm-first M b)]
                (cond (and (zero? x) (zero? y)) true
                      (or (zero? x) (zero? y)) false
                      (nm-dp-same? M x y) (recur (nm-next M x) (nm-next M y))
                      :else false))))

;; ---- multimethods ----
;; the method body from b: b itself when it is the only form, else (do b ..); R0 = that node
(defn- nm-dp-body [M :vector-i64 b :i64 tok :i64] :vector-i64
  (if (zero? (nm-next M b))
    (nm-put M MM-R0 b)
    (let [M1 (nm-dp-gnode M ND-SYM tok HD-DO)
          h (vector-at M1 MM-R0)]
      (nm-dp-new (nm-set-nf M1 h NF-NEXT b) ND-LIST tok 0 h))))
;; copies of the parameter symbols of vector pv, chained; R0 = the first
(defn- nm-dp-args [M :vector-i64 pv :i64] :vector-i64
  (loop [M1 M c (nm-first M pv) a0 0 al 0]
    (cond (or (zero? c) (nm-failed M1)) (nm-put M1 MM-R0 a0)
          (= (nm-kind M1 c) ND-SYM)
          (let [M2 (nm-dp-new M1 ND-SYM (nm-nf M1 c NF-TOK) (nm-sym-of M1 c) 0)
                x (vector-at M2 MM-R0)
                M3 (if (zero? al) M2 (nm-set-nf M2 al NF-NEXT x))]
            (recur M3 (nm-next M3 c) (if (zero? a0) x a0) x))
          :else (recur M1 (nm-next M1 c) a0 al))))
;; the defmulti form d becomes (defn NAME pv0 (case (disp p ..) clauses .. [dflt])); cl0 = the first clause key, prev = the
;; last clause body (0 when there is none), dflt = the :default body or 0
(defn- nm-dp-multi-end [M :vector-i64 d :i64 nmn :i64 disp :i64 tok :i64 pv0 :i64 cl0 :i64 prev :i64 dflt :i64] :vector-i64
  (if (zero? pv0)
    (nm-err-node M E-NAMES-DISPATCH nmn 0)
    (let [M1 (if (zero? prev) M (nm-set-nf M prev NF-NEXT dflt))
          M2 (nm-dp-args M1 pv0)
          M3 (nm-set-nf M2 disp NF-NEXT (vector-at M2 MM-R0))
          M4 (nm-dp-new M3 ND-LIST tok 0 disp)
          dc (vector-at M4 MM-R0)
          M5 (nm-set-nf M4 dc NF-NEXT (if (zero? cl0) dflt cl0))
          M6 (nm-dp-gnode M5 ND-SYM tok HD-CASE)
          hc (vector-at M6 MM-R0)
          M7 (nm-dp-new (nm-set-nf M6 hc NF-NEXT dc) ND-LIST tok 0 hc)
          cs (vector-at M7 MM-R0)
          M8 (nm-dp-gnode M7 ND-SYM tok HD-DEFN)
          hd (vector-at M8 MM-R0)]
      (-> M8 (nm-set-nf hd NF-NEXT nmn) (nm-set-nf nmn NF-NEXT pv0) (nm-set-nf pv0 NF-NEXT cs) (nm-set-nf d NF-FIRST hd)))))
;; gather the defmethods of the defmulti d (symbol s) in source order; a consumed defmethod gets NF-SYM -1
(defn- nm-dp-multi2 [M :vector-i64 d :i64 nmn :i64 disp :i64 tok :i64] :vector-i64
  (let [s (nm-sym-of M nmn)]
    (loop [M1 M c (nm-dp-root M) pv0 0 cl0 0 prev 0 dflt 0]
      (cond (nm-failed M1) M1
            (zero? c) (nm-dp-multi-end M1 d nmn disp tok pv0 cl0 prev dflt)
            (and (= (nm-dp-kind M1 c) 2) (= (nm-sym-of M1 (nm-nth M1 c 1)) s) (nm-ne (nm-nf M1 c NF-SYM) -1))
            (let [k (nm-nth M1 c 2)
                  pv (nm-nth M1 c 3)
                  b (nm-next M1 pv)
                  nx (nm-next M1 c)]
              (cond (zero? b) (nm-err-node M1 E-NAMES-DISPATCH (nm-nth M1 c 1) 0)
                    (not (or (= (nm-kind M1 k) ND-INT) (= (nm-kind M1 k) ND-KW))) (nm-err-node M1 E-NAMES-DISPATCH k 0)
                    (not (nm-dp-plain? M1 pv)) (nm-err-node M1 E-NAMES-DISPATCH pv 0)
                    (and (pos? pv0) (not (nm-dp-same? M1 pv pv0))) (nm-err-node M1 E-NAMES-DISPATCH pv 0)
                    (and (nm-dp-default-kw? M1 k) (pos? dflt)) (nm-err-node M1 E-NAMES-DISPATCH k 0)
                    :else
                    (let [M2 (nm-set-nf (nm-dp-body M1 b tok) c NF-SYM -1)
                          bn (vector-at M2 MM-R0)
                          pvk (if (zero? pv0) pv pv0)]
                      (if (nm-dp-default-kw? M2 k)
                        (recur M2 nx pvk cl0 prev bn)
                        (let [M3 (nm-set-nf M2 k NF-NEXT bn)
                              M4 (if (zero? prev) M3 (nm-set-nf M3 prev NF-NEXT k))]
                          (recur M4 nx pvk (if (zero? cl0) k cl0) bn dflt))))))
            :else (recur M1 (nm-next M1 c) pv0 cl0 prev dflt)))))
;; (defmulti NAME [doc] DISPATCH)
(defn- nm-dp-multi [M :vector-i64 d :i64] :vector-i64
  (let [nmn (nm-nth M d 1)
        x (nm-nth M d 2)
        disp (if (and (= (nm-kind M x) ND-STR) (pos? (nm-next M x))) (nm-next M x) x)]
    (cond (nm-ne (nm-kind M nmn) ND-SYM) (nm-err-node M E-NAMES-DISPATCH (nm-first M d) 0)
          (pos? (nm-dp-find M 8 (nm-sym-of M nmn) d)) (nm-err-node M E-NAMES-DUP nmn 0)   ; an earlier definition
          (or (zero? disp) (pos? (nm-next M disp))
              (not (or (= (nm-kind M disp) ND-KW) (and (= (nm-kind M disp) ND-SYM) (nm-ne (nm-head-of M disp) HD-AMP)))))
          (nm-err-node M E-NAMES-DISPATCH nmn 0)
          :else (nm-dp-multi2 M d nmn disp (nm-nf M (nm-first M d) NF-TOK)))))

;; ---- protocols ----
;; the first top-level form before stop named by symbol s, of nm-dp-kind k, or 7 a defrecord, or 8 a def / defn / defn- /
;; defmulti; 0 when there is none
(defn- nm-dp-find [M :vector-i64 k :i64 s :i64 stop :i64] :i64
  (loop [c (nm-dp-root M)]
    (cond (or (zero? c) (= c stop)) 0
          (and (= (nm-sym-of M (nm-nth M c 1)) s)
               (case k
                 7 (= (nm-form-head M c) HD-DEFRECORD)
                 8 (or (= (nm-dp-kind M c) 1) (pos? (nm-form-kind (nm-form-head M c))))
                 (= (nm-dp-kind M c) k)))
          c
          :else (recur (nm-next M c)))))
;; the first signature of protocol form d (after its name and an optional docstring)
(defn- nm-dp-sig0 [M :vector-i64 d :i64] :i64
  (let [x (nm-nth M d 2)] (if (= (nm-kind M x) ND-STR) (nm-next M x) x)))
;; the signature of method symbol m in protocol form d, 0 when it has none
(defn- nm-dp-sig [M :vector-i64 d :i64 m :i64] :i64
  (loop [c (nm-dp-sig0 M d)]
    (cond (zero? c) 0
          (= (nm-sym-of M (nm-first M c)) m) c
          :else (recur (nm-next M c)))))
;; (defprotocol P [doc] (m [this ..]) ..): every signature has a name that is no head and no top-level definition, and one
;; parameter vector of plain symbols (the receiver first). Two protocols may share a method name: dispatch is on the record
(defn- nm-dp-protocol [M :vector-i64 d :i64] :vector-i64
  (let [p (nm-nth M d 1)]
    (cond (nm-ne (nm-kind M p) ND-SYM) (nm-err-node M E-NAMES-DISPATCH (nm-first M d) 0)
          (nm-ne (nm-dp-find M 3 (nm-sym-of M p) 0) d) (nm-err-node M E-NAMES-DUP p 0)
          :else
          (loop [c (nm-dp-sig0 M d)]
            (let [m (nm-first M c)
                  pv (nm-next M m)
                  f (nm-dp-find M 8 (nm-sym-of M m) 0)]
              (cond (zero? c) (nm-touch M)
                    (or (nm-ne (nm-kind M c) ND-LIST) (nm-ne (nm-kind M m) ND-SYM) (pos? (nm-head-of M m))
                        (not (nm-dp-plain? M pv)) (nm-ne (nm-count-syms M pv) (nm-count M pv)) (pos? (nm-next M pv)))
                    (nm-err-node M E-NAMES-DISPATCH (if (zero? m) c m) 0)
                    (pos? f) (nm-err-node M E-NAMES-DUP (nm-nth M f 1) 0)
                    :else (recur (nm-next M c))))))))

;; 1 when some owner form of the module has a rewritten implementation of method m for record r: (defn- G [this [:ref r] ..] ..)
(defn- nm-dp-has-impl? [M :vector-i64 m :i64 r :i64] :bool
  (loop [c (nm-dp-root M)]
    (cond (zero? c) false
          (and (>= (nm-dp-kind M c) 4)
               (loop [i (nm-first M c)]
                 (cond (zero? i) false
                       (and (= (nm-nf M i NF-SYM) m) (= (nm-sym-of M (nm-nth M (nm-nth M (nm-nth M i 2) 1) 1)) r)) true
                       :else (recur (nm-next M i)))))
          true
          :else (recur (nm-next M c)))))
;; implementation i = (m [this ..] body ..) -> (defn- G [this [:ref R] ..] body ..) with NF-SYM = m
(defn- nm-dp-impl [M :vector-i64 i :i64 r :i64] :vector-i64
  (let [mn (nm-first M i)
        pv (nm-next M mn)
        rcv (nm-first M pv)
        tok (nm-nf M mn NF-TOK)
        M1 (nm-dp-gnode M ND-KW tok KW-REF)
        kr (vector-at M1 MM-R0)
        M2 (nm-dp-new M1 ND-KW tok r 0)
        M3 (nm-dp-new (nm-set-nf M2 kr NF-NEXT (vector-at M2 MM-R0)) ND-VEC tok 0 kr)
        rv (vector-at M3 MM-R0)
        M5 (nm-dp-gnode (-> M3 (nm-set-nf rv NF-NEXT (nm-next M3 rcv)) (nm-set-nf rcv NF-NEXT rv)) ND-SYM tok 0)
        g (vector-at M5 MM-R0)
        M6 (nm-dp-gnode M5 ND-SYM tok HD-DEFN-PRIV)
        h (vector-at M6 MM-R0)]
    (-> M6 (nm-set-nf h NF-NEXT g) (nm-set-nf g NF-NEXT pv) (nm-set-nf i NF-FIRST h) (nm-set-nf i NF-SYM (nm-sym-of M6 mn)))))
;; the implementations from i (up to the next non-list) of protocol form d for record r: each a method of d with its arity,
;; an untyped receiver and a body, not implemented for r before; then every method of d must be (else E2006 at node at).
;; R0 = the node after the section
(defn- nm-dp-section [M :vector-i64 i :i64 d :i64 r :i64 at :i64] :vector-i64
  (let [M1 (loop [M2 M x i]
             (let [mn (nm-first M2 x)
                   pv (nm-next M2 mn)
                   sig (nm-dp-sig M2 d (nm-sym-of M2 mn))]
               (cond (or (zero? x) (nm-ne (nm-kind M2 x) ND-LIST) (nm-failed M2)) M2
                     (or (nm-ne (nm-kind M2 mn) ND-SYM) (zero? sig) (not (nm-dp-plain? M2 pv)) (zero? (nm-next M2 pv))
                         (nm-dp-tform? M2 (nm-next M2 (nm-first M2 pv))) (nm-ne (nm-count-syms M2 pv) (nm-count-syms M2 (nm-nth M2 sig 1)))
                         (nm-dp-has-impl? M2 (nm-sym-of M2 mn) r))
                     (nm-err-node M2 E-NAMES-DISPATCH (if (zero? mn) x mn) 0)
                     :else (recur (nm-dp-impl M2 x r) (nm-next M2 x)))))
        stop (loop [x i] (if (and (pos? x) (= (nm-kind M1 x) ND-LIST)) (recur (nm-next M1 x)) x))]
    (loop [sg (nm-dp-sig0 M1 d)]
      (cond (nm-failed M1) M1
            (zero? sg) (nm-put M1 MM-R0 stop)
            (nm-dp-has-impl? M1 (nm-sym-of M1 (nm-first M1 sg)) r) (recur (nm-next M1 sg))
            :else (nm-err-node M1 E-NAMES-DISPATCH at 0)))))
;; the sections of owner form o of kind k (4 extend-type, 5 extend-protocol, 6 defrecord): a protocol symbol (a record
;; symbol for extend-protocol) and its implementations, repeated
(defn- nm-dp-owner [M :vector-i64 o :i64 k :i64] :vector-i64
  (let [nm1 (nm-nth M o 1)
        c0 (nm-nth M o (if (= k 6) 3 2))]
    (cond (zero? (nm-dp-find M (if (= k 5) 3 7) (nm-sym-of M nm1) 0)) (nm-err-node M E-NAMES-OPEN nm1 0)
          :else
          (loop [M1 M c c0]
            (let [p (if (= k 5) nm1 c)
                  r (if (= k 5) c nm1)]
              (cond (or (zero? c) (nm-failed M1)) M1
                    (or (nm-ne (nm-kind M1 c) ND-SYM) (zero? (nm-next M1 c)) (= (nm-dp-hash M1 c) -1464332787667384834))   ; `default`
                    (nm-err-node M1 E-NAMES-DISPATCH c 0)
                    (zero? (nm-dp-find M1 3 (nm-sym-of M1 p) 0)) (nm-err-node M1 E-NAMES-OPEN p 0)
                    (zero? (nm-dp-find M1 7 (nm-sym-of M1 r) 0)) (nm-err-node M1 E-NAMES-OPEN r 0)
                    :else (let [M2 (nm-dp-section M1 (nm-next M1 c) (nm-dp-find M1 3 (nm-sym-of M1 p) 0) (nm-sym-of M1 r) c)]
                            (recur M2 (vector-at M2 MM-R0)))))))))

;; ---- the pass ----
(defn- nm-dp-each [M :vector-i64 k :i64] :vector-i64
  (loop [M1 M c (nm-dp-root M)]
    (let [x (nm-dp-kind M1 c)]
      (cond (or (zero? c) (nm-failed M1)) M1
            (and (= k 2) (= x 2) (nm-ne (nm-nf M1 c NF-SYM) -1)) (nm-err-node M1 E-NAMES-OPEN (nm-nth M1 c 1) 0)
            (and (= k 4) (>= x 4)) (recur (nm-dp-owner M1 c x) (nm-next M1 c))
            (and (= k 1) (= x 1)) (recur (nm-dp-multi M1 c) (nm-next M1 c))
            (and (= k 3) (= x 3)) (recur (nm-dp-protocol M1 c) (nm-next M1 c))
            :else (recur M1 (nm-next M1 c))))))
;; the new top level: defmultis in place (now defns), defmethods and defprotocols dropped, each owner form replaced by its
;; implementations (list children with NF-SYM > 0; a defrecord keeps its first three children and is followed by them)
(defn- nm-dp-relink [M :vector-i64] :vector-i64
  (loop [M1 M c (nm-dp-root M) l 0 x 0]
    (let [k (nm-dp-kind M1 c)]
      (cond (and (zero? c) (zero? x))
            (let [M2 (if (zero? l) (nm-set-nf M1 (vector-at M1 MM-ROOT) NF-FIRST 0) (nm-set-nf M1 l NF-NEXT 0))]
              (nm-set-nf M2 (vector-at M2 MM-ROOT) NF-AUX (nm-count M2 (vector-at M2 MM-ROOT))))
            ;; x > 0: the chain of an owner form's children (impl list nodes are appended), then the root again from c
            (pos? x) (let [nx (nm-next M1 x)]
                       (if (and (= (nm-kind M1 x) ND-LIST) (pos? (nm-nf M1 x NF-SYM)))
                         (recur (nm-dp-app M1 l x) c x nx)
                         (recur M1 c l nx)))
            (or (= k 2) (= k 3)) (recur M1 (nm-next M1 c) l 0)
            (= k 6) (let [fv (nm-nth M1 c 2) x0 (nm-next M1 fv)]
                      (recur (nm-set-nf (nm-dp-app M1 l c) fv NF-NEXT 0) (nm-next M1 c) c x0))
            (>= k 4) (recur M1 (nm-next M1 c) l (nm-first M1 c))
            :else (recur (nm-dp-app M1 l c) (nm-next M1 c) c 0)))))
;; append node x to the new root chain whose last node is l
(defn- nm-dp-app [M :vector-i64 l :i64 x :i64] :vector-i64
  (if (zero? l) (nm-set-nf M (vector-at M MM-ROOT) NF-FIRST x) (nm-set-nf M l NF-NEXT x)))
(defn- nm-dp-norm [M :vector-i64] :vector-i64
  (if (or (nm-failed M) (not (nm-dp-any? M)))
    (nm-touch M)
    (let [M1 (-> M (nm-dp-each 3) (nm-dp-each 1) (nm-dp-each 2) (nm-dp-each 4))]
      (if (nm-failed M1) M1 (nm-put (nm-dp-relink M1) (+ MM-STAT-BASE 21) 1)))))
;; ==== END JUN-730 ====

;; the whole pass
(defn- nm-run [M :vector-i64 S :string] :vector-i64
  (nm-run-defs (nm-dp-norm (nm-r6b-norm (nm-intern-nodes M S 1)))))   ; R6B: + nm-r6b-norm; JUN-730: + nm-dp-norm

(defn- nm-run-defs [M :vector-i64] :vector-i64
  (let [ns (nm-first M (vector-at M MM-ROOT))]
    (cond (nm-failed M) (nm-touch M)
          (nm-ns-ok M ns) (nm-defs M ns)
          (= (nm-form-head M ns) HD-NS) (nm-err-node M E-NAMES-NS ns 0)
          (= ns 0) (nm-err-node M E-NAMES-NS ns 0)
          :else (nm-defs-nons M ns))))

;; ---------------------------------------------------------------------------------------------------------
;; R1: synthetic symbols for 21-check's desugaring. A gensym is a SYM record that is NOT in the hash table, so no
;; spelling ever finds it; its span is empty at pos (diagnostics print an empty name) and SF-HEAD = code (a head
;; code for a synthetic head symbol, a KW-* code for a synthetic keyword, 0 for a fresh local name).
;; ---------------------------------------------------------------------------------------------------------
(defn- nm-gensym [M :vector-i64 pos :i64 code :i64] :vector-i64
  (let [s (vector-at M MM-SYM-N)]
    (if (< s MM-SYM-CAP)
      (let [M1 (nm-put M (nm-sa s SF-START) pos)
            M2 (nm-put M1 (nm-sa s SF-END) pos)
            M3 (nm-put M2 (nm-sa s SF-HASH) 0)
            M4 (nm-put M3 (nm-sa s SF-HEAD) code)
            M5 (nm-put M4 MM-SYM-N (+ s 1))]
        (nm-put M5 MM-R0 s))
      (nm-put (nm-err M E-HEAP-REGION 0 5) MM-R0 0))))

;; the symbol spelled S[a..b) when it was interned, else 0 (never interns)
(defn- nm-lookup [M :vector-i64 S :string a :i64 b :i64] :i64
  (let [p (nm-probe M S a b (nm-hash S a b))]
    (if (> p 0) p 0)))

;; ---------------------------------------------------------------------------------------------------------
;; scope API (used by 21-check). A binding shadows until nm-unbind pops it.
;; ---------------------------------------------------------------------------------------------------------
(defn- nm-scope-height [M :vector-i64] :i64 (vector-at M MM-SCOPE-N))

(defn- nm-bind [M :vector-i64 s :i64 slot :i64 ty :i64] :vector-i64
  (let [h (vector-at M MM-SCOPE-N)
        e (+ MM-SCOPE-BASE (* h MM-SCOPE-W))]
    (if (< h MM-SCOPE-CAP)
      (let [prev (nm-sf M s SF-BIND)
            M1 (nm-put M (+ e CF-SYM) s)
            M2 (nm-put M1 (+ e CF-PREV) prev)
            M3 (nm-put M2 (nm-sa s SF-BIND) (+ (+ slot 1) (* ty RES-SCALE)))]
        (nm-put M3 MM-SCOPE-N (+ h 1)))
      (nm-err M E-HEAP-REGION 0 7))))

(defn- nm-unbind [M :vector-i64 height :i64] :vector-i64
  (let [h (vector-at M MM-SCOPE-N)]
    (if (<= h height)
      (nm-touch M)
      (let [e (+ MM-SCOPE-BASE (* (- h 1) MM-SCOPE-W))
            s (vector-at M (+ e CF-SYM))
            prev (vector-at M (+ e CF-PREV))
            M1 (nm-put M (nm-sa s SF-BIND) prev)
            M2 (nm-put M1 MM-SCOPE-N (- h 1))]
        (nm-unbind M2 height)))))

(defn- nm-local-slot [M :vector-i64 s :i64] :i64
  (let [v (nm-sf M s SF-BIND)]
    (if (= v 0) -1 (- (bit-and v (- RES-SCALE 1)) 1))))

(defn- nm-local-type [M :vector-i64 s :i64] :i64
  (quot (nm-sf M s SF-BIND) RES-SCALE))

(defn- nm-bound-since [M :vector-i64 s :i64 height :i64] :i64
  (loop [h (- (vector-at M MM-SCOPE-N) 1)]
    (cond (< h height) 0
          (= (vector-at M (+ (+ MM-SCOPE-BASE (* h MM-SCOPE-W)) CF-SYM)) s) 1
          :else (recur (- h 1)))))

;; R3 (agent R3, 2026-10-03): hide every local binding while 21-check checks another function on demand (an aborting
;; callee whose error type the caller needs, seed/21-check.kotoba ck-ensure), then show them again. The scope stack itself
;; is untouched (the nested check pushes and pops above it); only SF-BIND of the bound symbols is saved and cleared.
;; R3 rung proof: the saved bindings are a typed list [:list :i64] (entry k = SF-BIND of scope entry k), not a HEAP block.
;;   nm-scope-saved M -> the list; nm-scope-hide M -> M (SF-BIND of every entry cleared); nm-scope-show M list -> M.
(defn- nm-scope-sym [M :vector-i64 k :i64] :i64 (vector-at M (+ MM-SCOPE-BASE (* k MM-SCOPE-W) CF-SYM)))
(defn- nm-scope-saved [M :vector-i64] [:list :i64]
  (let [h (vector-at M MM-SCOPE-N)]
    (loop [k 0 acc (typed-list-new [:list :i64])]
      (if (>= k h)
        acc
        (recur (inc k) (typed-list-conj [:list :i64] acc (nm-sf M (nm-scope-sym M k) SF-BIND)))))))
(defn- nm-scope-hide [M :vector-i64] :vector-i64
  (let [h (vector-at M MM-SCOPE-N)]
    (loop [k 0]
      (if (>= k h)
        M
        (let [M1 (nm-set-sf M (nm-scope-sym M k) SF-BIND 0)] (recur (inc k)))))))
(defn- nm-scope-show [M :vector-i64 saved [:list :i64]] :vector-i64
  (let [h (count saved)]
    (loop [k 0]
      (if (>= k h)
        M
        (let [M1 (nm-set-sf M (nm-scope-sym M k) SF-BIND (typed-list-nth [:list :i64] saved k))] (recur (inc k)))))))
