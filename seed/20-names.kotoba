        7435273060337611578 KW-STATE-GET  ; :state/get
        0)
      29813
      (case w0
        8083791406678963002 KW-STATE-PUT  ; :state/put
        0)
      30575
      (case w0
        7939682742892782394 KW-CLOCK-NOW  ; :clock/now
        0)
      116
      (case w0
        7954884667766694970 KW-DOCUMENT  ; :document
        0)
      121459014923055
      (case w0
        8319104414429376570 KW-PROCESS-SPAWN  ; :process/spawn
        0)
      512735994927
      (case w0
        8750616613351220538 KW-ENTROPY-DRAW  ; :entropy/draw
        0)
      1702131056
      (case w0
        7885630528033941306 KW-GPU-COMPUTE  ; :gpu/compute
        0)
      435744240229
      (case w0
        7954877770216795194 KW-LLM-GENERATE  ; :llm/generate
        0)
      7234932
      (case w0
        8316297137988398650 KW-NET-LISTEN  ; :net/listen
        0)
      7630949
      (case w0
        7161674688893382202 KW-NET-ACCEPT  ; :net/accept
        0)
      108
      (case w0
        7019251649212673594 KW-NET-DIAL  ; :net/dial
