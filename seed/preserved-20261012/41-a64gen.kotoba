;; UNHOOKED current-M closure guards; all reads bounded before row matching.
(defn- ct-bound [M :vector-i64 f :i64 rows :i64 np :i64 ns :i64 dp :i64 fuel :i64 rt :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (>= (vector-at M MM-SIR-N) rows) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) rows))
  (= (gn-fnf M f FF-NPARAMS) np) (= (gn-fnf M f FF-NSLOTS) ns)
  (= (gn-fnf M f FF-DEPTH) dp) (= (gn-fnf M f FF-FUEL) fuel)
  (= (gn-fnf M f FF-RTYPE) rt) (not (gn-clamp-open M f))))
(defn- ct-sign-row [M :vector-i64 p :i64 k :i64] :bool
 (let [f (gn-sir M p IF-A)
  l1 (gn-sir M (+ p 1) IF-A)
  l14 (gn-sir M (+ p 14) IF-A)
  l16 (gn-sir M (+ p 16) IF-A)
] (case k
  0 (gn-dot-at? M (+ p 0) 1 f 1 2)
  1 (gn-dot-at? M (+ p 1) 9 l1 0 0)
  2 (gn-dot-at? M (+ p 2) 4 0 1 0)
  3 (gn-dot-at? M (+ p 3) 3 1 65535 0)
  4 (gn-dot-at? M (+ p 4) 6 5 0 0)
  5 (gn-dot-at? M (+ p 5) 5 2 0 0)
  6 (gn-dot-at? M (+ p 6) 4 0 2 0)
  7 (gn-dot-at? M (+ p 7) 3 1 32768 0)
  8 (gn-dot-at? M (+ p 8) 7 5 0 0)
  9 (gn-dot-at? M (+ p 9) 11 0 l14 0)
  10 (gn-dot-at? M (+ p 10) 4 0 2 0)
  11 (gn-dot-at? M (+ p 11) 3 1 65536 0)
  12 (gn-dot-at? M (+ p 12) 6 2 0 0)
  13 (gn-dot-at? M (+ p 13) 10 l16 0 0)
  14 (gn-dot-at? M (+ p 14) 9 l14 0 0)
  15 (gn-dot-at? M (+ p 15) 4 0 2 0)
  16 (gn-dot-at? M (+ p 16) 9 l16 0 0)
  17 (gn-dot-at? M (+ p 17) 19 0 0 0)
  18 (gn-dot-at? M (+ p 18) 2 f 0 0)
  false)))
(defn- ct-sign-rows [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 19) true (and (ct-sign-row M p k) (ct-sign-rows M p (inc k)))))
(defn- ct-sign-closed [M :vector-i64 f :i64] :bool
 (and (ct-bound M f 19 1 2 2 0 1)
  (= (gn-fnf M f (+ FF-PT0 0)) 1)
  (ct-sign-rows M (gn-fnf M f FF-SIR) 0) (qb-labels M (gn-fnf M f FF-SIR) 19 0)))
