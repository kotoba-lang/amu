(defn- gm-rows [M :vector-i64 p :i64 f :i64 reader :i64 item :i64 copy :i64 k :i64] :bool
 (if (= k 78) true (and (gm-row M p f reader item copy k) (gm-rows M p f reader item copy (inc k)))))
(defn- gm-distinct [M :vector-i64 k :i64 j :i64] :bool
 (if (= j k) true (and (not= (gn-sreg M k) (gn-sreg M j)) (gm-distinct M k (inc j)))))
