;; Closed masked-word schedule72, generic derived shape; source IDs are evidence only.
(defn- sc-mask-row [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [l1 (gn-sir M (+ p 1) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 f 1 1)
   1 (gn-dot-at? M (+ p 1) 9 l1 0 0)
   2 (gn-dot-at? M (+ p 2) 4 0 1 0)
   3 (gn-dot-at? M (+ p 3) 3 1 4294967295 0)
   4 (gn-dot-at? M (+ p 4) 6 5 0 0)
   5 (gn-dot-at? M (+ p 5) 19 0 0 0)
   6 (gn-dot-at? M (+ p 6) 2 f 0 0)
   false)))
(defn- sc-mask-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (or (= k 7) (and (sc-mask-row M p f  k) (sc-mask-rows M p f  (inc k)))))
(defn- sc-word-row [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [l2 (gn-sir M (+ p 2) IF-A)]
  (case k
