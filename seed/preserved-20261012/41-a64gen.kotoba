(defn- pm-reserved-rows [M :vector-i64 p :i64 f :i64 pred :i64 reserved :i64 rem :i64 weight :i64 writer :i64 k :i64] :bool
 (if (= k 50) true (and (pm-reserved-row M p f pred reserved rem weight writer k) (pm-reserved-rows M p f pred reserved rem weight writer (inc k)))))

(defn- pm-rem [M :vector-i64 f :i64] :bool
 (and (qb-bound M f 11 2 2 4 0) (qb-int-params M f 0 2)
  (qb-rem-rows M (gn-fnf M f FF-SIR) f 0) (qb-labels M (gn-fnf M f FF-SIR) 11 0)))
(defn- pm-weight [M :vector-i64 f :i64] :bool
 (and (qb-bound M f 61 1 1 2 0) (qb-int-params M f 0 1)
  (qb-weight-rows M (gn-fnf M f FF-SIR) f 0) (qb-labels M (gn-fnf M f FF-SIR) 61 0)))
(defn- pm-grid [M :vector-i64 f :i64] :bool
 (and (ir-bound M f 155 3 7 3) (= (gn-fnf M f FF-RTYPE) TY-BOOL) (qb-int-params M f 0 3)
  (let [p (gn-fnf M f FF-SIR) rem (gn-sir M (+ p 5) IF-A)]
   (and (gc-rows M p f rem 0) (qb-labels M p 155 0) (pm-rem M rem)))))
(defn- pm-admit [M :vector-i64 i :i64] :bool
 (let [f (gn-g M fr-owner) p (dec i)]
  (and (> i 1) (<= (vector-at M MM-FN-N) MM-FN-CAP) (ir-bound M f 63 4 5 5) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (= p (gn-fnf M f FF-SIR)) (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 4)
   (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-out) 0)
   (= (gn-g M gn-f-ns) 5) (= (gn-g M gn-f-dp) 5) (= (gn-g M gn-f-nsv) 5) (= (gn-g M gn-f-fb) 144)
   (drc-homes M 1 5) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
   (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 256))
   (>= (vector-at M MM-FIX-N) 0) (< (vector-at M MM-FIX-N) MM-FIX-CAP)
   (>= (vector-at M MM-LIT-N) 0) (< (vector-at M MM-LIT-N) MM-LIT-CAP)
   (>= (vector-at M MM-LITB-N) 0) (<= (vector-at M MM-LITB-N) (- MM-LITB-CAP 1024))
   (>= (gn-g M di-sites) 0) (< (gn-g M di-sites) 16) (>= (gn-g M di-used) 0) (<= (gn-g M di-used) 3840)
   (let [pred (gn-sir M (+ p 13) IF-A) reserved (gn-sir M (+ p 18) IF-A)
    rem (gn-sir M (+ p 39) IF-A) weight (gn-sir M (+ p 40) IF-A) writer (gn-sir M (+ p 42) IF-A)
    limit (gn-sir M (+ p 4) IF-B) outputbase (gn-sir M (+ p 22) IF-B) rowstride (gn-sir M (+ p 28) IF-B)]
    (and (> limit 0) (<= limit 31) (>= outputbase 0) (<= outputbase 4095) (> rowstride 0) (<= rowstride 4095)
     (pm-rows M p f pred reserved rem weight writer 0) (qb-labels M p 63 0)
     (pm-grid M pred) (pm-rem M rem) (pm-weight M weight) (rb-writer M writer true)
     (ir-bound M reserved 50 3 6 4) (= (gn-fnf M reserved FF-RTYPE) TY-BOOL)
     (= (gn-fnf M reserved FF-PT0) TY-VEC) (qb-int-params M reserved 1 3)
     (let [rp (gn-fnf M reserved FF-SIR) rb (gn-sir M (+ (gn-fnf M reserved FF-SIR) 34) IF-B)]
      (and (>= rb 0) (<= rb 4095) (pm-reserved-rows M rp reserved pred reserved rem weight writer 0)
       (qb-labels M rp 50 0))))))))

(defn- pm-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) rp (gn-fnf M (gn-sir M (+ p 18) IF-A) FF-SIR)
  limit (gn-sir M (+ p 4) IF-B) outputbase (gn-sir M (+ p 22) IF-B) rowstride (gn-sir M (+ p 28) IF-B)
  reservedbase (gn-sir M (+ rp 34) IF-B)
  last (gn-max (+ reservedbase (quot (+ (quot (* (dec limit) limit) 2) (dec limit)) 8)) (+ outputbase (quot (dec limit) 8) (* (dec limit) rowstride)))
  rv (gn-sreg M 1) mh (gn-sreg M 2) xh (gn-sreg M 3) yh (gn-sreg M 4)
  cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
  lit (vector-at M MM-LIT-N) base (vector-at M MM-LITB-N) r (+ MM-LIT-BASE (* lit MM-LIT-W))
  init (-> M (gc-data base 0) (gn-put (+ r LF-B) base) (gn-put (+ r LF-LEN) 1024) (gn-put (+ r LF-TOK) 0) (gn-put (+ r LF-POOL) 0) (gn-put MM-LIT-N (inc lit)) (gn-put MM-LITB-N (+ base 1024)))
  m0 (-> init (gn-emit (enc-ldr 7 31 136)) (gn-emit (enc-cmp-i xh limit)))
  empty (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-eq) 0)))
  xdomain (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m3 (-> m2 (gn-emit (enc-cmp-i mh 8)))
  mdomain (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m5 (-> m4 (gn-emit (enc-cmp-i yh limit)))
  ydomain (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m7 (-> m6 (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)))
  handlebad (vector-at m7 MM-CODE-N)
  m8 (-> m7 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m9 (-> m8 (gn-emit (enc-ldr 9 7 320)) (gn-emit (gn-e-addsl 9 9 17 4)) (gn-emit (enc-ldp 9 10 9 0)) (gn-mov-imm 16 last) (gn-emit (enc-cmp-r 16 10)))
  rangebad (vector-at m9 MM-CODE-N)
  m10 (-> m9 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m11 (-> m10 (gn-emit (enc-add-r 16 9 16)) (gn-emit (enc-cmp-r 16 9)))
  wrapbad (vector-at m11 MM-CODE-N)
  m12 (-> m11 (gn-emit (enc-bcond (enc-cond-lo) 0)))
  m13 (-> m12 (gn-mov-imm 17 1152921504606846975) (gn-emit (enc-cmp-r 16 17)))
  scalebad (vector-at m13 MM-CODE-N)
  m14 (-> m13 (gn-emit (enc-bcond 8 0)))
  m15 (-> m14 (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 9 3)) (gn-emit (enc-ldr 6 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit) (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1)) (gn-emit (enc-add-r 6 6 16)))
  loopcode (vector-at m15 MM-CODE-N)
  m16 (-> m15 (gn-emit (enc-cmp-i xh limit)))
  end (vector-at m16 MM-CODE-N)
  m17 (-> m16 (gn-emit (enc-bcond (enc-cond-eq) 0)))
  m18 (-> m17 (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 4)))
  lowfuel (vector-at m18 MM-CODE-N)
  m19 (-> m18 (gn-emit (enc-bcond (enc-cond-lo) 0)))
  m20 (-> m19 (gn-op-fuel) (gn-emit (gn-e-lsl 9 mh 10)) (gn-emit (gn-e-lsl 10 xh 5)) (gn-emit (enc-orr-r 9 9 10)) (gn-emit (enc-orr-r 9 9 yh)) (gn-mov-imm 17 63) (gn-emit (enc-and-r 10 9 17)) (gn-emit (gn-e-lsr 9 9 6)) (gn-emit (gn-e-ldrr 5 6 9 1)) (gn-emit (enc-lsrv 5 5 10)) (gn-mov-imm 17 1) (gn-emit (enc-and-r 5 5 17)) (gn-emit (enc-cmp-i 5 0)))
  predicatefalse (vector-at m20 MM-CODE-N)
  m21 (-> m20 (gn-emit (enc-bcond (enc-cond-eq) 0)))
  m22 (-> m21 (gn-op-fuel) (gn-mov 9 xh) (gn-mov 10 yh) (gn-emit (enc-cmp-r xh yh)))
  xyless (vector-at m22 MM-CODE-N)
  m23 (-> m22 (gn-emit (enc-bcond (enc-cond-lo) 0)))
  m24 (-> m23 (gn-mov 9 yh) (gn-mov 10 xh))
  xyready (vector-at m24 MM-CODE-N)
  m25 (-> m24 (gn-emit (enc-mul 11 10 10)) (gn-emit (enc-add-r 11 11 10)) (gn-emit (gn-e-lsr 11 11 1)) (gn-emit (enc-add-r 11 11 9)) (gn-emit (gn-e-lsr 12 11 3)) (gn-mov-imm 17 reservedbase) (gn-emit (enc-add-r 12 12 17)) (gn-emit (gn-e-ldrr 14 4 12 1)) (gn-mov-imm 17 7) (gn-emit (enc-and-r 11 11 17)) (gn-mov-imm 15 128) (gn-emit (enc-lsrv 15 15 11)) (gn-emit (enc-and-r 14 14 15)) (gn-emit (enc-cmp-i 14 0)))
  isreserved (vector-at m25 MM-CODE-N)
  m26 (-> m25 (gn-emit (enc-bcond (enc-cond-ne) 0)))
  m27 (-> m26 (gn-emit (gn-e-lsr 12 xh 3)) (gn-mov-imm 17 rowstride) (gn-emit (enc-madd 12 yh 17 12)) (gn-mov-imm 17 outputbase) (gn-emit (enc-add-r 12 12 17)) (gn-emit (gn-e-ldrr 14 4 12 1)) (gn-mov-imm 17 7) (gn-emit (enc-and-r 11 xh 17)) (gn-mov-imm 15 128) (gn-emit (enc-lsrv 15 15 11)) (gn-emit (enc-eor-r 14 14 15)))
  m28 (-> m27 (gn-emit (enc-ldr 13 7 CTX-FUEL)) (gn-emit (enc-sub-i 13 13 1)) (gn-mov-imm 17 255) (gn-emit (enc-and-r 14 14 17)) (gn-emit (gn-e-strr3 14 4 12)) (gn-emit (enc-str 13 7 CTX-FUEL)))
  advance (vector-at m28 MM-CODE-N)
  m29 (-> m28 (gn-emit (enc-add-i xh xh 1)) (gn-op-fuel))
  back (vector-at m29 MM-CODE-N)
  m30 (-> m29 (gn-emit (enc-b 0)))
  finish (vector-at m30 MM-CODE-N)
  m31 (-> m30 (gn-mov 0 rv) (gn-epilogue) (gn-gs gn-f-dead dead))
  cold (vector-at m31 MM-CODE-N)
  final (-> m31 (gn-dot-patch empty finish (enc-cond-eq)) (gn-dot-patch xdomain cold (enc-cond-hs)) (gn-dot-patch mdomain cold (enc-cond-hs)) (gn-dot-patch ydomain cold (enc-cond-hs)) (gn-dot-patch handlebad cold (enc-cond-hs)) (gn-dot-patch rangebad cold (enc-cond-hs)) (gn-dot-patch wrapbad cold (enc-cond-lo)) (gn-dot-patch scalebad cold 8) (gn-dot-patch end finish (enc-cond-eq)) (gn-dot-patch lowfuel cold (enc-cond-lo)) (gn-dot-patch predicatefalse advance (enc-cond-eq)) (gn-dot-patch xyless xyready (enc-cond-lo)) (gn-dot-patch isreserved advance (enc-cond-ne)) (gn-put (+ MM-CODE-BASE back) (enc-b (- loopcode back))))]
  (if (= (vector-at final MM-ERR) 0)
   (-> final (gn-gs di-sites (inc (gn-g final di-sites))) (gn-gs di-used (+ (gn-g final di-used) (- (vector-at final MM-CODE-N) cn))))
   (-> final (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-put MM-LIT-N lit) (gn-put MM-LITB-N base) (gn-gs gn-f-dead dead)))))
(defn- pm-entry [M :vector-i64 i :i64] :vector-i64
 (if (pm-admit M i) (pm-emit M i) M))

;; Guarded affine linked two-run merge; terminal continuations unchanged.
(defn- lm-row [M :vector-i64 p :i64 f :i64 writer :i64 affine :i64 tail :i64 cont :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) short (gn-sir M (+ p 7) IF-B)
  done (gn-sir M (+ p 13) IF-B) right (gn-sir M (+ p 25) IF-B)
  join (gn-sir M (+ p 49) IF-A) zeroa (gn-sir M (+ p 83) IF-B)
  pickend (gn-sir M (+ p 85) IF-A) end (gn-sir M (+ p 75) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 f 6 8)
