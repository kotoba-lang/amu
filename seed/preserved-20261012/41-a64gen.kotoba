  17 167939
  18 2442
  19 2313
  20 172035
  21 2441
  22 2378
  23 2249
  24 176131
  25 2377
  26 19
  27 2050
  -1))
(defn- ivs-step-token [f :i64 reader :i64 h :i64 a :i64 b :i64 c :i64 d :i64 escape :i64 marker :i64 wide :i64 narrow :i64 plain :i64 v :i64] :i64
 (case v
  32 f
  33 reader
  34 h
  35 a
  36 b
  37 c
  38 d
  39 escape
  40 marker
  41 wide
  42 narrow
  43 plain
  v))
(defn- ivs-step-row [M :vector-i64 p :i64 f :i64 reader :i64 h :i64 a :i64 b :i64 c :i64 d :i64 escape :i64 marker :i64 wide :i64 narrow :i64 plain :i64 k :i64] :bool
 (and (>= k 0) (< k 28)
  (let [key (ivs-step-key k)]
   (uc-row M (+ p k) (bit-and key 63)
    (ivs-step-token f reader h a b c d escape marker wide narrow plain (bit-and (i64-shift-right key 6) 63))
    (ivs-step-token f reader h a b c d escape marker wide narrow plain (bit-and (i64-shift-right key 12) 63))
    (ivs-step-token f reader h a b c d escape marker wide narrow plain (bit-and (i64-shift-right key 18) 63))))))
(defn- ivs-root-key [k :i64] :i64
 (case k
  0 1067009
  1 18
  2 2249
  3 16388
  4 12356
  5 135
  6 147467
  7 4100
  8 8260
  9 16516
  10 4166
  11 526413
  12 168003
  13 71
  14 72
  15 2313
  16 151563
  17 4100
  18 8260
  19 12420
  20 16580
  21 4356
  22 8516
  23 16772
