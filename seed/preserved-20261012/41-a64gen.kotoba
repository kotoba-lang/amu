(defn- gc-rows [M :vector-i64 p :i64 f :i64 rem :i64 k :i64] :bool
 (if (= k 155) true (and (gc-row M p f rem k) (gc-rows M p f rem (inc k)))))
;; This pure expression is authorized only by the complete exact row certificate.
;; Nonnegative bounded inputs and constant positive divisors cannot trap.
(defn- gc-value [m :i64 x :i64 y :i64] :i64
 (let [rx (rem x 3) ry (rem y 3) p (bit-and (bit-and x y) 1)
  same (if (and (not= rx 0) (= rx ry)) 1 0)]
  (if (cond (= m 0) (= (rem (+ x y) 2) 0)
            (= m 1) (= (rem y 2) 0)
            (= m 2) (= rx 0)
            (= m 3) (= (rem (+ x y) 3) 0)
            (= m 4) (= (rem (+ (quot x 3) (quot y 2)) 2) 0)
            (= m 5) (= (+ p (if (and (not= rx 0) (not= ry 0)) 1 0)) 0)
            (= m 6) (= (rem (+ p same) 2) 0)
            :else (= (rem (+ same (rem (+ x y) 2)) 2) 0)) 1 0)))
(defn- gc-word [idx :i64 bit :i64 word :i64] :i64
 (if (= bit 64) word
  (let [j (+ idx bit) m (u64-shift-right j 10)
        x (bit-and (u64-shift-right j 5) 31) y (bit-and j 31)]
   (gc-word idx (inc bit) (bit-or word (i64-shift-left (gc-value m x y) bit))))))
(defn- gc-data [M :vector-i64 base :i64 k :i64] :vector-i64
 (if (= k 128) M
  (gc-data (lw-bytes8 M (+ base (* k 8)) (gc-word (* k 64) 0 0)) base (inc k))))
(defn- gc-admit [M :vector-i64 f :i64 n :i64] :bool
 (and (= n 3) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
  (> f 0) (< f MM-FN-CAP) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (>= (vector-at M MM-SIR-N) 155) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) 155))
  (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 7)
  (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-FUEL) 1)
  (= (gn-fnf M f FF-RTYPE) TY-BOOL) (qb-int-params M f 0 3)
  (< (gn-g M di-sites) 16) (<= (gn-g M di-used) 4032)
  (>= (vector-at M MM-LIT-N) 0) (< (vector-at M MM-LIT-N) MM-LIT-CAP)
  (>= (vector-at M MM-LITB-N) 0) (<= (vector-at M MM-LITB-N) (- MM-LITB-CAP 1024))
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 64))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) (- MM-FIX-CAP 2))
  (let [p (gn-fnf M f FF-SIR) rem (gn-sir M (+ p 5) IF-A)]
   (and (gc-rows M p f rem 0) (qb-labels M p 155 0)
    (qb-bound M rem 11 2 2 4 0) (qb-int-params M rem 0 2)
    (qb-rem-rows M (gn-fnf M rem FF-SIR) rem 0)
    (qb-labels M (gn-fnf M rem FF-SIR) 11 0)))))
(defn- gc-transfer [M :vector-i64 f :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fn (vector-at M MM-FIX-N)
  lit (vector-at M MM-LIT-N) base (vector-at M MM-LITB-N)
  r (+ MM-LIT-BASE (* lit MM-LIT-W))
  m0 (-> M (gc-data base 0) (gn-put (+ r LF-B) base)
   (gn-put (+ r LF-LEN) 1024) (gn-put (+ r LF-TOK) 0) (gn-put (+ r LF-POOL) 0)
   (gn-put MM-LIT-N (inc lit)) (gn-put MM-LITB-N (+ base 1024))
   (gn-emit (enc-cmp-i 0 8)))
  g0 (vector-at m0 MM-CODE-N) m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-i 1 32)))
  g1 (vector-at m1 MM-CODE-N) m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-i 2 32)))
  g2 (vector-at m2 MM-CODE-N) m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 1)))
  gf (vector-at m3 MM-CODE-N) m4 (-> m3 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-op-fuel)
   (gn-mov-imm 16 10) (gn-emit (enc-lslv 0 0 16))
   (gn-mov-imm 16 5) (gn-emit (enc-lslv 1 1 16))
   (gn-emit (enc-orr-r 0 0 1)) (gn-emit (enc-orr-r 0 0 2))
   (gn-mov-imm 16 63) (gn-emit (enc-and-r 1 0 16))
   (gn-mov-imm 16 6) (gn-emit (enc-lsrv 0 0 16))
   (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-emit (gn-e-addsl 17 17 0 3))
   (gn-fix FX-LIT32 lit) (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
   (gn-emit (gn-e-ldrr 0 17 16 0)) (gn-emit (enc-lsrv 0 0 1))
   (gn-mov-imm 16 1) (gn-emit (enc-and-r 0 0 16)))
  join (vector-at m4 MM-CODE-N) m5 (gn-emit m4 (enc-b 2))
  fallback (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))
   (gn-dot-patch g0 fallback (enc-cond-hs)) (gn-dot-patch g1 fallback (enc-cond-hs))
   (gn-dot-patch g2 fallback (enc-cond-hs)) (gn-dot-patch gf fallback (enc-cond-lo)))]
  (if (= (vector-at m6 MM-ERR) 0)
   (-> m6 (gn-gs di-sites (inc (gn-g m6 di-sites)))
    (gn-gs di-used (+ (gn-g m6 di-used) (- (vector-at m6 MM-CODE-N) cn))))
   (-> m6 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fn)
    (gn-put MM-LIT-N lit) (gn-put MM-LITB-N base)))))

;; Closed contiguous integer threshold fold; original private fuel is retained.
(defn- tf-row [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 4 5)
  1 (uc-row M (+ p 1) 18 0 0 0)
  2 (uc-row M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (uc-row M (+ p 3) 4 0 3 0)
  4 (uc-row M (+ p 4) 4 1 2 0)
  5 (uc-row M (+ p 5) 7 3 0 0)
  6 (uc-row M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
  7 (uc-row M (+ p 7) 4 0 4 0)
  8 (uc-row M (+ p 8) 10 (gn-sir M (+ p 42) IF-A) 0 0)
  9 (uc-row M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (uc-row M (+ p 10) 4 0 1 0)
  11 (uc-row M (+ p 11) 3 1 (gn-sir M (+ p 11) IF-B) 0)
  12 (uc-row M (+ p 12) 4 2 3 0)
  13 (uc-row M (+ p 13) 6 1 1 0)
  14 (uc-row M (+ p 14) 14 176 0 2)
  15 (uc-row M (+ p 15) 5 5 0 0)
  16 (uc-row M (+ p 16) 4 0 1 0)
  17 (uc-row M (+ p 17) 4 1 2 0)
  18 (uc-row M (+ p 18) 4 2 3 0)
  19 (uc-row M (+ p 19) 3 3 1 0)
  20 (uc-row M (+ p 20) 6 1 2 0)
  21 (uc-row M (+ p 21) 4 3 4 0)
  22 (uc-row M (+ p 22) 4 4 5 0)
  23 (uc-row M (+ p 23) 3 5 5 0)
  24 (uc-row M (+ p 24) 7 5 4 0)
  25 (uc-row M (+ p 25) 11 4 (gn-sir M (+ p 32) IF-A) 0)
  26 (uc-row M (+ p 26) 3 4 3 0)
  27 (uc-row M (+ p 27) 4 5 5 0)
  28 (uc-row M (+ p 28) 6 1 4 0)
  29 (uc-row M (+ p 29) 3 5 -5 0)
  30 (uc-row M (+ p 30) 6 1 4 0)
  31 (uc-row M (+ p 31) 10 (gn-sir M (+ p 34) IF-A) 0 0)
  32 (uc-row M (+ p 32) 9 (gn-sir M (+ p 32) IF-A) 0 0)
  33 (uc-row M (+ p 33) 3 4 0 0)
  34 (uc-row M (+ p 34) 9 (gn-sir M (+ p 34) IF-A) 0 0)
  35 (uc-row M (+ p 35) 6 1 3 0)
  36 (uc-row M (+ p 36) 5 1 0 0)
  37 (uc-row M (+ p 37) 5 2 1 0)
  38 (uc-row M (+ p 38) 5 3 2 0)
  39 (uc-row M (+ p 39) 5 4 3 0)
  40 (uc-row M (+ p 40) 18 0 0 0)
  41 (uc-row M (+ p 41) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  42 (uc-row M (+ p 42) 9 (gn-sir M (+ p 42) IF-A) 0 0)
  43 (uc-row M (+ p 43) 19 0 0 0)
  44 (uc-row M (+ p 44) 2 f 0 0)
  false))
(defn- tf-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 45) true (and (tf-row M p f k) (tf-rows M p f (inc k)))))
(defn- tf-homes [M :vector-i64 k :i64] :bool
 (if (> k 5) true (and (= (gn-sreg M k) (dec k)) (tf-homes M (inc k)))))
(defn- tf-admit [M :vector-i64 i :i64] :bool
 (let [f (gn-g M fr-owner) p (dec i)]
  (and (> i 1) (qb-bound M f 45 4 5 6 1) (= p (gn-fnf M f FF-SIR))
   (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 4)
   (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-ns) 5) (= (gn-g M gn-f-dp) 6)
   (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-out) 0)
   (tf-homes M 1) (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0)
   (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 64))
   (>= (gn-sir M (+ p 11) IF-B) 0) (<= (gn-sir M (+ p 11) IF-B) 4095)
   (tf-rows M p f 0) (qb-labels M p 45 0))))
(defn- tf-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) base (gn-sir M (+ p 11) IF-B)
  m0 (gn-emit M (enc-cmp-i 2 0))
  start (vector-at m0 MM-CODE-N) m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 1 63)))
  count (vector-at m1 MM-CODE-N) m2 (-> m1 (gn-emit (enc-bcond 8 0))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)))
  handle (vector-at m2 MM-CODE-N) m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 5 7 320)) (gn-emit (gn-e-addsl 5 5 17 4)) (gn-emit (enc-ldp 17 5 5 0))
   (gn-emit (enc-add-i 16 1 base)) (gn-emit (enc-cmp-r 16 5)))
  bounds (vector-at m3 MM-CODE-N) m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 5 7 328)) (gn-emit (gn-e-addsl 5 5 17 3)))
  loopcode (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-add-i 6 2 base)) (gn-emit (gn-e-ldrr 16 5 6 1))
   (gn-emit (enc-cmp-i 16 5)) (gn-emit (enc-sub-i 6 16 2))
   (gn-emit (enc-csel 6 6 31 (enc-cond-ge))) (gn-emit (enc-add-r 3 3 6))
   (gn-emit (enc-add-i 2 2 1)) (gn-op-fuel) (gn-emit (enc-cmp-r 2 1)))
  back (vector-at m5 MM-CODE-N) m6 (-> m5 (gn-emit (enc-bcond (enc-cond-le) (- loopcode back)))
   (gn-mov 0 3) (gn-epilogue) (gn-gs gn-f-dead 0))
  fallback (vector-at m6 MM-CODE-N)]
  (-> m6 (gn-dot-patch start fallback (enc-cond-ne)) (gn-dot-patch count fallback 8)
   (gn-dot-patch handle fallback (enc-cond-hs)) (gn-dot-patch bounds fallback (enc-cond-hs)))))
(defn- tf-entry [M :vector-i64 i :i64] :vector-i64
 (if (tf-admit M i) (tf-emit M i) M))

;; Generic closed packed-bit grid run-length scoring loop; each original debit retained.
(defn- rb-row [M :vector-i64 p :i64 f :i64 reader :i64 writer :i64 natural :i64 k :i64] :bool
 (case k
