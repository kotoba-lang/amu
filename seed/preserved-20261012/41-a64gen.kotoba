(defn- be-rows [M :vector-i64 p :i64 f :i64 L :i64 a :i64 b :i64 c :i64 k :i64] :bool
 (or (= k 177) (and (be-row M p f L a b c k) (be-rows M p f L a b c (inc k)))))
(defn- be-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (< (vector-at M MM-SIR-N) 177)
  (> i (- (vector-at M MM-SIR-N) 176)) (not= (gn-op M (dec i)) OP-FN)) false
 (let [p (dec i) f (gn-sir M p IF-A) L (gn-sir M (+ p 10) IF-B)
  a (gn-sir M (+ p 80) IF-B) b (gn-sir M (+ p 43) IF-B)
  c (gn-sir M (+ p 29) IF-B) d (- b a)]
  (and (ir-bound M f 177 7 11 8) (= (gn-fnf M f FF-SIR) p)
   (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
   (qb-int-params M f 1 5)
   (> L 0) (<= L 4096) (>= a 0) (<= a 1048575) (>= b 0) (<= b 1048575)
   (>= c 0) (<= c 1048575) (> d 0) (<= d 4096)
   (be-separate L L 0 L) (be-separate L L a d) (be-separate L L b d)
   (be-separate c 1 0 L) (be-separate c 1 a d) (be-separate c 1 b d)
   (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 11) (= (gn-g M gn-f-dp) 8)
   (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-out) 0)
   (= (gn-g M gn-f-nsv) 4) (= (gn-g M gn-f-fb) 208)
   (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2)
   (= (gn-sreg M 4) 3) (= (gn-sreg M 5) 4) (= (gn-sreg M 6) 5) (= (gn-sreg M 7) 6)
   (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (= (vector-at M MM-ERR) 0)
   (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 256))
   (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
   (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 3840)
   (be-rows M p f L a b c 0) (qb-labels M p 177 0)))))
;; Last bit/length args have no FF PT fields: exact checked CMP7, integer
;; ADD/SUB/SHL and RT208 integer-index/value provenance is required by rows.
(defn- be-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) L (gn-sir M (+ p 10) IF-B) a (gn-sir M (+ p 80) IF-B)
  b (gn-sir M (+ p 43) IF-B) c (gn-sir M (+ p 29) IF-B) d (- b a)
  last (gn-max c (gn-max (dec (* 2 L)) (dec (+ b d))))
  cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
  m0 (-> M (gn-mov-imm 16 L) (gn-emit (enc-cmp-r 1 16))) gj (vector-at m0 MM-CODE-N)
