  m0 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 1)))
  fuel (vector-at m0 MM-CODE-N) m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-mov-imm 17 9223372036854775804) (gn-emit (enc-cmp-r 1 17)))
  index (vector-at m1 MM-CODE-N) m2 (-> m1 (gn-emit (enc-bcond 8 0))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)))
  handle (vector-at m2 MM-CODE-N) m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 3 7 320)) (gn-emit (gn-e-addsl 3 3 17 4))
   (gn-emit (enc-ldp 4 5 3 0)) (gn-emit (enc-add-i 6 1 3)) (gn-emit (enc-cmp-r 6 5)))
  bounds (vector-at m3 MM-CODE-N) m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-add-r 6 4 6)) (gn-emit (enc-cmp-r 6 4)))
  wrap (vector-at m4 MM-CODE-N) m5 (-> m4 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-mov-imm 17 1152921504606846975) (gn-emit (enc-cmp-r 6 17)))
  scale (vector-at m5 MM-CODE-N) m6 (-> m5 (gn-emit (enc-bcond 8 0))
   (gn-emit (enc-add-r 4 4 1)) (gn-emit (enc-ldr 3 7 328))
   (gn-emit (gn-e-addsl 3 3 4 3)) (gn-emit (enc-ldr 16 7 CTX-FUEL))
   (gn-emit (enc-sub-i 16 16 1)) (gn-emit (enc-str 16 7 CTX-FUEL)) (fw-store 0)
   (gn-emit (enc-b 2))) fallback (vector-at m6 MM-CODE-N)
  m7 (-> m6 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))
