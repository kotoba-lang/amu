 (or (= k 72) (and (sc-owner-row M p f word s1 s0 maskf writer limit split base d1 d2 d3 d4 k) (sc-owner-rows M p f word s1 s0 maskf writer limit split base d1 d2 d3 d4 (inc k)))))
(defn- sc-pure-mask [M :vector-i64 f :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (>= (vector-at M MM-SIR-N) 7) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) 7))
  (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-NSLOTS) 1) (= (gn-fnf M f FF-DEPTH) 2)
  (= (gn-fnf M f FF-FUEL) 0) (= (gn-fnf M f FF-RTYPE) TY-I64) (= (gn-fnf M f FF-PT0) TY-I64)
  (not (gn-clamp-open M f)) (sc-mask-rows M (gn-fnf M f FF-SIR) f 0) (qb-labels M (gn-fnf M f FF-SIR) 7 0)))
(defn- sc-small? [M :vector-i64 f :i64 rot :i64] :bool
 (if (not (ir-bound M f 16 1 1 3)) false
 (let [p (gn-fnf M f FF-SIR) a (gn-sir M (+ p 4) IF-B) b (gn-sir M (+ p 7) IF-B) shift (gn-sir M (+ p 11) IF-B)]
  (and (= (gn-fnf M f FF-RTYPE) TY-I64) (= (gn-fnf M f FF-PT0) TY-I64)
   (> a 0) (< a 32) (> b 0) (< b 32) (> shift 0) (< shift 64)
   (sc-small-rows M p f rot a b shift 0) (qb-labels M p 16 0)))))
(defn- sc-deps [M :vector-i64 word :i64 s1 :i64 s0 :i64 maskf :i64 writer :i64] :bool
 (if (not (and (ir-bound M word 38 3 4 4) (ir-bound M s1 16 1 1 3) (ir-bound M s0 16 1 1 3) (sc-pure-mask M maskf) (lc-writer M writer))) false
 (let [rot (gn-sir M (+ (gn-fnf M s1 FF-SIR) 5) IF-A)]
  (and (= (gn-fnf M word FF-RTYPE) TY-I64) (= (gn-fnf M word FF-PT0) TY-VEC) (qb-int-params M word 1 3)
   (sc-word-rows M (gn-fnf M word FF-SIR) word 0) (qb-labels M (gn-fnf M word FF-SIR) 38 0)
   (ir-bound M rot 15 2 2 4) (= (gn-fnf M rot FF-RTYPE) TY-I64) (qb-int-params M rot 0 2)
   (sc-rot-rows M (gn-fnf M rot FF-SIR) rot maskf 0) (qb-labels M (gn-fnf M rot FF-SIR) 15 0)
   (sc-small? M s1 rot) (sc-small? M s0 rot)))))
(defn- sc-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (< (vector-at M MM-SIR-N) 72) (> (vector-at M MM-SIR-N) MM-SIR-CAP) (> i (- (vector-at M MM-SIR-N) 71))
  (not= (gn-op M (dec i)) OP-FN) (> (vector-at M MM-FN-N) MM-FN-CAP)) false
 (let [p (dec i) f (gn-sir M p IF-A) word (gn-sir M (+ p 17) IF-A) s1 (gn-sir M (+ p 27) IF-A) s0 (gn-sir M (+ p 43) IF-A)
  maskf (gn-sir M (+ p 53) IF-A) writer (gn-sir M (+ p 61) IF-A) limit (gn-sir M (+ p 4) IF-B) split (gn-sir M (+ p 11) IF-B)
  base (gn-sir M (+ p 21) IF-B) d1 (gn-sir M (+ p 23) IF-B) d2 (gn-sir M (+ p 31) IF-B) d3 (gn-sir M (+ p 39) IF-B) d4 (gn-sir M (+ p 47) IF-B)]
  (and (ir-bound M f 72 2 3 6) (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 2)
   (> limit 0) (<= limit 4095) (> split 0) (<= split limit) (>= base 0) (<= base 1048575)
   (> d1 0) (<= d1 split) (> d2 0) (<= d2 split) (> d3 0) (<= d3 split) (> d4 0) (<= d4 split)
   (sc-deps M word s1 s0 maskf writer) (sc-owner-rows M p f word s1 s0 maskf writer limit split base d1 d2 d3 d4 0) (qb-labels M p 72 0)
   (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 6)
   (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-out) 0)
   (= (gn-g M gn-f-nsv) 3) (= (gn-g M gn-f-fb) 128) (drc-homes M 1 3)
   (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (= (vector-at M MM-ERR) 0)
