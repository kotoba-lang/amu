(defn- ct-scan-rows [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 36) true (and (ct-scan-row M p k) (ct-scan-rows M p (inc k)))))
(defn- ct-scan-closed [M :vector-i64 f :i64] :bool
 (and (ct-bound M f 36 4 4 5 1 2)
  (= (gn-fnf M f (+ FF-PT0 0)) 4)
  (= (gn-fnf M f (+ FF-PT0 1)) 1)
  (= (gn-fnf M f (+ FF-PT0 2)) 1)
  (= (gn-fnf M f (+ FF-PT0 3)) 1)
  (ct-scan-rows M (gn-fnf M f FF-SIR) 0) (qb-labels M (gn-fnf M f FF-SIR) 36 0)))
(defn- ct-deps [M :vector-i64 p :i64] :bool
 (let [
  scan (gn-sir M (+ p 7) IF-A)
  descale (gn-sir M (+ p 20) IF-A)
  fill (gn-sir M (+ p 25) IF-A)
  sign (gn-sir M (+ p 47) IF-A)
  multiply (gn-sir M (+ p 82) IF-A)
  writer (gn-sir M (+ p 216) IF-A)
] (and
  (ct-scan-closed M scan)
  (ct-descale-closed M descale)
  (ct-fill-closed M fill)
  (ct-sign-closed M sign)
  (ct-multiply-closed M multiply)
  (ct-writer-closed M writer)
  (let [mp (gn-fnf M multiply FF-SIR) dp (gn-fnf M descale FF-SIR)
   wp (gn-fnf M writer FF-SIR) fp (gn-fnf M fill FF-SIR)
   floor (gn-sir M (+ mp 10) IF-A) clamp (gn-sir M (+ dp 10) IF-A)
   natural (gn-sir M (+ wp 11) IF-A)]
   (and (ct-floor-closed M floor) (ct-clamp-closed M clamp)
    (ct-natural-closed M natural)
    (= (gn-sir M (+ mp 4) IF-A) sign)
    (= (gn-sir M (+ dp 7) IF-A) floor)
    (= (gn-sir M (+ (gn-fnf M clamp FF-SIR) 4) IF-A) sign)
    (= (gn-sir M (+ wp 10) IF-A) sign)
    (= (gn-sir M (+ fp 15) IF-A) writer))))))
(defn- ct-parameter-homes [M :vector-i64 k :i64] :bool
 (if (= k 5) true
  (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
   (ct-home-pairs M k (inc k)) (ct-parameter-homes M (inc k)))))
(defn- ct-home-pairs [M :vector-i64 k :i64 j :i64] :bool
 (if (= j 5) true (and (not= (gn-sreg M k) (gn-sreg M j)) (ct-home-pairs M k (inc j)))))
(defn- ct-prototype-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (> i (- MM-SIR-CAP 345))
  (> i (- (vector-at M MM-SIR-N) 345)) (not= (gn-op M (dec i)) OP-FN)) false
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (ct-bound M f 346 4 40 6 1 TY-VEC) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-BOOL)
    (= (gn-g M gn-f-ns) 40) (= (gn-g M gn-f-dp) 6)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ctx) 1)
    (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-g M fr-owner) f) (ct-parameter-homes M 1)
    (>= (gn-g M gn-f-nsv) 4) (<= (gn-g M gn-f-nsv) 10)
    (>= (gn-g M gn-f-out) 0) (<= (gn-g M gn-f-out) 32768)
    (>= (gn-g M gn-f-fb) 384) (<= (gn-g M gn-f-fb) 32768)
    (= (gn-g M gn-f-fb) (+ (gn-r16 (* 8 (+ 40 6 2)))
      (gn-r16 (* 8 (gn-g M gn-f-nsv))) (gn-g M gn-f-out)))
    (>= (gn-soff M 40) (+ (gn-g M gn-f-out) (gn-r16 (* 8 (gn-g M gn-f-nsv)))))
    (ct-owner-rows M p 0) (qb-labels M p 346 0) (ct-deps M p)
    (>= (vector-at M MM-CODE-N) 0)
    (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 2048))
    (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)))))
;; Deliberately not installed in OP-FUEL until bounded SOURCE controls/review.
(defn- ct-prototype-entry [M :vector-i64 i :i64] :vector-i64
 (if (ct-prototype-admit M i) (ct-prototype-emit M) M))

