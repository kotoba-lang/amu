  38 155659
  39 16388
  40 172099
  41 70
  42 2506
  43 2441
  44 176131
  45 2505
  46 2569
  47 19
  48 2050
  -1))
(defn- ivs-root-token [f :i64 reader :i64 step :i64 h :i64 a :i64 b :i64 c :i64 d :i64 z :i64 delimiter :i64 finish :i64 failure :i64 v :i64] :i64
 (case v
  32 f
  33 reader
  34 step
  35 h
  36 a
  37 b
  38 c
  39 d
  40 z
  41 delimiter
  42 finish
  43 failure
  v))
(defn- ivs-root-row [M :vector-i64 p :i64 f :i64 reader :i64 step :i64 h :i64 a :i64 b :i64 c :i64 d :i64 z :i64 delimiter :i64 finish :i64 failure :i64 k :i64] :bool
 (and (>= k 0) (< k 49)
  (let [key (ivs-root-key k)]
   (uc-row M (+ p k) (bit-and key 63)
    (ivs-root-token f reader step h a b c d z delimiter finish failure (bit-and (i64-shift-right key 6) 63))
    (ivs-root-token f reader step h a b c d z delimiter finish failure (bit-and (i64-shift-right key 12) 63))
    (ivs-root-token f reader step h a b c d z delimiter finish failure (bit-and (i64-shift-right key 18) 63))))))
(defn- ivs-step-rows [M :vector-i64 p :i64 f :i64 reader :i64 h :i64 a :i64 b :i64 c :i64 d :i64 escape :i64 marker :i64 wide :i64 narrow :i64 plain :i64 k :i64] :bool
 (if (= k 28) true (and (ivs-step-row M p f reader h a b c d escape marker wide narrow plain k) (ivs-step-rows M p f reader h a b c d escape marker wide narrow plain (inc k)))))
(defn- ivs-root-rows [M :vector-i64 p :i64 f :i64 reader :i64 step :i64 h :i64 a :i64 b :i64 c :i64 d :i64 z :i64 delimiter :i64 finish :i64 failure :i64 k :i64] :bool
 (if (= k 49) true (and (ivs-root-row M p f reader step h a b c d z delimiter finish failure k) (ivs-root-rows M p f reader step h a b c d z delimiter finish failure (inc k)))))
(defn- ivs-step [M :vector-i64 f :i64 reader :i64] :bool
 (if (not (qb-bound M f 28 2 2 3 1)) false
  (let [p (gn-fnf M f FF-SIR)]
   (and (= (gn-fnf M f FF-PT0) TY-STR) (qb-int-params M f 1 2)
    (>= (gn-sir M (+ p 6) IF-B) 0) (< (gn-sir M (+ p 6) IF-B) 128)
    (>= (gn-sir M (+ p 14) IF-B) 0) (< (gn-sir M (+ p 14) IF-B) 128)
    (> (gn-sir M (+ p 17) IF-B) 0) (<= (gn-sir M (+ p 17) IF-B) 4095)
    (> (gn-sir M (+ p 20) IF-B) 0) (<= (gn-sir M (+ p 20) IF-B) 4095)
    (> (gn-sir M (+ p 24) IF-B) 0) (<= (gn-sir M (+ p 24) IF-B) 4095)
    (ivs-step-rows M p f reader (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 23) IF-A)
     (gn-sir M (+ p 19) IF-A) (gn-sir M (+ p 25) IF-A) (gn-sir M (+ p 21) IF-A)
     (gn-sir M (+ p 6) IF-B) (gn-sir M (+ p 14) IF-B) (gn-sir M (+ p 17) IF-B)
     (gn-sir M (+ p 20) IF-B) (gn-sir M (+ p 24) IF-B) 0) (qb-labels M p 28 0)))))
(defn- ivs-root [M :vector-i64 f :i64] :bool
 (if (not (qb-bound M f 49 4 4 7 1)) false
  (let [p (gn-fnf M f FF-SIR) reader (gn-sir M (+ p 11) IF-A) step (gn-sir M (+ p 25) IF-A)]
   (and (= (gn-fnf M f FF-PT0) TY-STR) (qb-int-params M f 1 4)
    (>= (gn-sir M (+ p 12) IF-B) 0) (< (gn-sir M (+ p 12) IF-B) 128)
    (> (gn-sir M (+ p 40) IF-B) 0) (<= (gn-sir M (+ p 40) IF-B) 4095)
    (ivs-root-rows M p f reader step (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 15) IF-A)
     (gn-sir M (+ p 34) IF-A) (gn-sir M (+ p 43) IF-A) (gn-sir M (+ p 45) IF-A)
     (gn-sir M (+ p 46) IF-A) (gn-sir M (+ p 12) IF-B) (gn-sir M (+ p 40) IF-B)
     (gn-sir M (+ p 44) IF-B) 0) (qb-labels M p 49 0)
    (qb-bound M reader 17 2 2 2 1) (= (gn-fnf M reader FF-PT0) TY-STR)
    (qb-int-params M reader 1 2)
    (let [q (gn-fnf M reader FF-SIR)]
     (and (sa-rows M q reader (gn-sir M (+ q 2) IF-A) (gn-sir M (+ q 10) IF-A) (gn-sir M (+ q 14) IF-A) 0)
      (qb-labels M q 17 0))) (ivs-step M step reader)))))
(defn- ivs-homes [M :vector-i64] :bool
 (let [h1 (gn-sreg M 1) h2 (gn-sreg M 2) h3 (gn-sreg M 3) h4 (gn-sreg M 4)]
  (and (>= h1 19) (<= h1 28) (>= h2 19) (<= h2 28)
   (>= h3 19) (<= h3 28) (>= h4 19) (<= h4 28)
   (not= h1 h2) (not= h1 h3) (not= h1 h4)
   (not= h2 h3) (not= h2 h4) (not= h3 h4))))
(defn- ivs-admit [M :vector-i64 i :i64] :bool
 (and (> i 1) (< i (vector-at M MM-SIR-N)) (< i MM-SIR-CAP)
  (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
  (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
  (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-ns) 4) (= (gn-g M gn-f-dp) 7)
  (= (gn-g M gn-f-out) 0) (ivs-homes M)
  (= (vector-at M MM-ERR) 0)
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (>= (gn-g M gn-f-nsv) 0) (<= (gn-g M gn-f-nsv) 10) (>= (gn-g M gn-f-fb) 0)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 512))
  (> (gn-g M fr-owner) 0) (< (gn-g M fr-owner) MM-FN-CAP)
  (< (gn-g M fr-owner) (vector-at M MM-FN-N))
  (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (= (gn-fnf M (gn-g M fr-owner) FF-SIR) (dec i)) (ivs-root M (gn-g M fr-owner))))
;; One shared charge, preserving original publication. Normal path clobbers x16 only.
(defn- ivs-pay [M :vector-i64 n :i64] :vector-i64
 (if (= n 0) M (ivs-pay (gn-op-fuel M) (dec n))))
(defn- ivs-emit [M :vector-i64 i :i64] :vector-i64
 (let [h1 (gn-sreg M 1) h2 (gn-sreg M 2) h3 (gn-sreg M 3) h4 (gn-sreg M 4)
  cn (vector-at M MM-CODE-N) fn (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead) G (vector-alloc 48)
  p (dec i) q (gn-fnf M (gn-sir M (+ p 25) IF-A) FF-SIR)
  m0 (-> M
   (gn-emit (enc-cmp-i h2 0)) (gt-cold G (enc-cond-lt))
   (gn-emit (enc-cmp-i h3 0)) (gt-cold G (enc-cond-lt))
   (gn-mov-imm 16 1152921504606846975) (gn-emit (enc-cmp-r h3 16)) (gt-cold G 8)
   (gn-emit (enc-cmp-i h4 0)) (gt-cold G (enc-cond-lt))
   (gn-emit (enc-ldr 16 7 288)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 h1 1)) (gn-emit (enc-cmp-r 17 16)) (gt-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 296)) (gn-emit (gn-e-addsl 16 16 17 4))
   (gn-emit (enc-ldp 3 4 16 0)) (gn-emit (enc-cmp-i 3 0)) (gt-cold G (enc-cond-lt))
   (gn-emit (enc-add-r 5 3 4)) (gn-emit (enc-cmp-r 5 3)) (gt-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 16 7 392)) (gn-emit (enc-cmp-r 5 16)) (gt-cold G 8)
   (gn-emit (enc-add-r 5 h2 h3)) (gn-emit (enc-cmp-r 5 h2)) (gt-cold G (enc-cond-lo))
   (gn-emit (enc-cmp-r 5 4)) (gt-cold G 8)
   (gn-emit (enc-ldr 16 7 CTX-CODE-BASE)) (gn-emit (enc-add-r 3 3 16))
   (gn-emit (enc-cmp-r 3 16)) (gt-cold G (enc-cond-lo))
   (gn-emit (enc-add-r 5 3 4)) (gn-emit (enc-cmp-r 5 3)) (gt-cold G (enc-cond-lo)))
  head (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-cmp-r h4 h3)) (gt-cold G (enc-cond-ge))
   (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 5)) (gt-cold G (enc-cond-lo))
   (gn-emit (enc-add-r 5 h2 h4)) (gn-emit (gn-e-ldrb 0 3 5))
   (gn-emit (enc-cmp-i 0 128)) (gt-cold G (enc-cond-hs))
   (gn-emit (enc-cmp-i 0 (gn-sir M (+ p 12) IF-B))))
  done (vector-at m1 MM-CODE-N) m2 (gn-emit m1 (enc-bcond (enc-cond-eq) 0))
  m3 (gn-emit m2 (enc-cmp-i 0 (gn-sir M (+ q 6) IF-B)))
  simple (vector-at m3 MM-CODE-N) m4 (gn-emit m3 (enc-bcond (enc-cond-ne) 0))
  m5 (-> m4 (gn-emit (enc-add-i 5 5 1)) (gn-emit (enc-cmp-r 5 4)))
  zero (vector-at m5 MM-CODE-N) m6 (gn-emit m5 (enc-bcond (enc-cond-eq) 0))
  m7 (-> m6 (gn-emit (gn-e-ldrb 1 3 5)) (gn-emit (enc-cmp-i 1 128)) (gt-cold G (enc-cond-hs)))
  join (vector-at m7 MM-CODE-N) m8 (gn-emit m7 (enc-b 0))
  zeroTarget (vector-at m8 MM-CODE-N) m9 (gn-mov-imm m8 1 0)
  escaped (vector-at m9 MM-CODE-N)
  m10 (-> m9 (ivs-pay 4) (gn-mov-imm 6 (gn-sir M (+ q 20) IF-B))
   (gn-emit (enc-cmp-i 1 (gn-sir M (+ q 14) IF-B))))
  narrow (vector-at m10 MM-CODE-N) m11 (gn-emit m10 (enc-bcond (enc-cond-ne) 0))
  m12 (gn-mov-imm m11 6 (gn-sir M (+ q 17) IF-B))
  advance (vector-at m12 MM-CODE-N) m13 (gn-emit m12 (enc-b 0))
  plain (vector-at m13 MM-CODE-N)
  m14 (-> m13 (ivs-pay 3) (gn-mov-imm 6 (gn-sir M (+ q 24) IF-B)))
  update (vector-at m14 MM-CODE-N)
  m15 (-> m14 (gn-emit (enc-add-r h4 h4 6)) (gn-op-fuel))
  repeat (vector-at m15 MM-CODE-N) m16 (gn-emit m15 (enc-b (- head repeat)))
  finished (vector-at m16 MM-CODE-N)
  m17 (-> m16 (ivs-pay 1) (gn-emit (enc-add-i 0 h4 (gn-sir M (+ p 40) IF-B)))
   (gn-epilogue) (gn-gs gn-f-dead 0))
  cold (vector-at m17 MM-CODE-N)
  m18 (-> m17 (gt-patch G 0 cold)
   (gn-dot-patch done finished (enc-cond-eq)) (gn-dot-patch simple plain (enc-cond-ne))
   (gn-dot-patch zero zeroTarget (enc-cond-eq)) (gn-dot-patch narrow update (enc-cond-ne))
   (gn-put (+ MM-CODE-BASE join) (enc-b (- escaped join)))
   (gn-put (+ MM-CODE-BASE advance) (enc-b (- update advance))))]
  (if (= (vector-at m18 MM-ERR) 0) m18 (-> m18 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fn) (gn-gs gn-f-dead dead)))))
(defn- ivs-entry [M :vector-i64 i :i64] :vector-i64
 (if (ivs-admit M i) (ivs-emit M i) M))

;; Successful closed fresh-vector returns certify fixed field bounds only.
;; Keep producer calls, allocation, all fuel, and all unproved reads unchanged.
(defn- fv-body [M :vector-i64 j :i64 end :i64 work :i64] :bool
 (cond (= j end) true
       (or (<= work 0) (> j end)) false
       :else (and (case (gn-op M j)
                 (OP-CONST OP-LGET OP-LSET OP-BIN OP-CMP OP-UN) true
                 false)
                  (fv-body M (inc j) end (dec work)))))
(defn- fv-size [M :vector-i64 f :i64 n :i64] :i64
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N)]
  (if (or (<= sn 0) (> sn MM-SIR-CAP) (<= fnn 0) (> fnn MM-FN-CAP)
          (<= f 0) (>= f fnn) (< n 0) (> n 7) (gn-clamp-open M f)) 0
   (let [p (gn-fnf M f FF-SIR) ns (gn-fnf M f FF-NSLOTS)
         fuel (gn-fnf M f FF-FUEL)]
    (if (or (<= p 0) (> p (- sn 4)) (> p (- MM-SIR-CAP 4))
            (< ns n) (>= ns gn-cap) (< fuel 0) (> fuel 1)
            (not= (gn-fnf M f FF-NPARAMS) n)
            (not= (gn-fnf M f FF-RTYPE) TY-VEC)
            (not (uc-row M p OP-FN f n ns))) 0
     (let [end (gn-small-end M (inc p) f 256)]
      (if (or (<= end (+ p 3 fuel))
              (not (uc-row M end OP-END f 0 0))) 0
       (let [q (+ p 1 fuel) v (- end 2) t (gn-sir M v IF-A)
             count (gn-sir M v IF-B)]
        (if (and (or (= fuel 0) (uc-row M (inc p) OP-FUEL 0 0 0))
                 (= (gn-op M q) OP-LABEL) (> (gn-sir M q IF-A) 0)
                 (< (gn-sir M q IF-A) MM-LABEL-CAP)
                 (= (gn-sir M q IF-B) 0) (= (gn-sir M q IF-C) 0)
                 (= (gn-op M v) OP-VEC) (= (gn-sir M v IF-C) 0)
                 (>= t 0) (> count 0) (<= count 32) (<= t (- gn-cap count))
                 (uc-row M (dec end) OP-RET t 0 0)
                 (fv-body M (inc q) v 256)) count 0))))))))
)
(defn- fv-binding [M :vector-i64 j :i64 slot :i64 work :i64] :i64
 (cond (or (<= j 1) (<= work 0)) 0
       (and (= (gn-op M j) OP-LSET) (= (gn-sir M j IF-A) slot))
        (let [c (dec j) t (gn-sir M j IF-B)]
         (if (and (= (gn-sir M j IF-C) 0) (= (gn-op M c) OP-CALL)
                  (= (gn-sir M c IF-B) t))
          (fv-size M (gn-sir M c IF-A) (gn-sir M c IF-C)) 0))
       :else (if (case (gn-op M j)
                  (OP-CONST OP-LGET OP-LSET OP-BIN OP-CMP OP-UN) true
                  OP-FUEL (uc-row M j OP-FUEL 0 0 0)
                  OP-RT (and (= (gn-sir M j IF-A) RT-VECTOR-AT)
                             (= (gn-sir M j IF-C) 2))
                  false)
                   (fv-binding M (dec j) slot (dec work)) 0)))
(defn- fv-admit [M :vector-i64 i :i64 t :i64] :bool
 (let [sn (vector-at M MM-SIR-N) cn (vector-at M MM-CODE-N)]
  (if (or (not= (vector-at M MM-ERR) 0) (not= (gn-g M gn-f-leaf) 0)
          (not= (gn-g M gn-f-vmode) 0)
          (<= (gn-g M gn-f-fb) 0) (> (gn-g M gn-f-fb) 32768)
          (<= sn 0) (> sn MM-SIR-CAP) (< i 4) (>= i sn)
          (< cn 0) (> cn (- MM-CODE-CAP 16))
          (< t 0) (> t 5) (< (gn-g M gn-f-h) (+ t 2))
          (> (gn-g M gn-f-h) gn-cap)
          (not (gn-isk M t gn-k-local))
          (not (gn-isk M (inc t) gn-k-const))
          (not (uc-row M i OP-RT RT-VECTOR-AT t 2))) false
   (let [slot (gn-dv M t) k (gn-dv M (inc t))]
    (if (or (<= slot 0) (> slot (gn-g M gn-f-ns)) (>= slot gn-cap)
            (< k 0) (>= k 32) (not (sb-owner M i))
            (not (uc-row M (- i 2) OP-LGET t slot 0))
            (not (uc-row M (dec i) OP-CONST (inc t) k 0))) false
     (let [r (gn-sreg M slot)]
      (and (or (= r -1) (and (>= r 19) (<= r 28)))
           (< k (fv-binding M (- i 3) slot 32))))))))
)
(defn- fv-read [M :vector-i64 i :i64 t :i64] :vector-i64
 (let [k (gn-dv M (inc t)) rv (gn-src M t 17 0)
       s (gn-co M i t) d (gn-dreg M t s)]
  (-> M (gn-protect t s) (gn-ctx) (gn-ldt t 17 0)
        (gn-emit (enc-sub-i 17 rv 1))
        (gn-emit (enc-ldr 16 7 320))
        (gn-emit (gn-e-addsl 16 16 17 4))
        (gn-emit (enc-ldr 17 16 0))
        (gn-emit (enc-ldr 16 7 328))
        (gn-emit (gn-e-addsl 16 16 17 3))
        (gn-emit (enc-ldr d 16 (* k 8)))
        (gn-fin t s d))))

;; Exact pure signed floor helper. Overflow-sensitive inputs retain original CALL.
(defn- pf-shape [M :vector-i64 f :i64] :bool
 (let [p (gn-fnf M f FF-SIR) sn (vector-at M MM-SIR-N)]
  (if (or (<= p 0) (> p (- sn 25)) (> p (- MM-SIR-CAP 25))
          (not= (gn-fnf M f FF-NPARAMS) 2) (not= (gn-fnf M f FF-NSLOTS) 2)
          (not= (gn-fnf M f FF-PT0) TY-I64) (not= (gn-fnf M f (inc FF-PT0)) TY-I64)
          (not= (gn-fnf M f FF-RTYPE) TY-I64) (not= (gn-fnf M f FF-FUEL) 0)
          (not= (gn-fnf M f FF-DEPTH) 4)) false
   (let [entry (gn-sir M (inc p) IF-A) le (gn-sir M (+ p 5) IF-B)
         lj (gn-sir M (+ p 17) IF-A)]
    (and (> entry 0) (< entry MM-LABEL-CAP) (> le 0) (< le MM-LABEL-CAP)
         (> lj 0) (< lj MM-LABEL-CAP) (not= entry le) (not= entry lj) (not= le lj)
         (= (bd-count M 1 entry 0 0) 65536)
         (= (bd-count M 1 le 0 0) 65537) (= (bd-count M 1 lj 0 0) 65537)
         (uc-row M p OP-FN f 2 2) (uc-row M (inc p) OP-LABEL entry 0 0)
         (uc-row M (+ p 2) OP-LGET 0 1 0)
         (uc-row M (+ p 3) OP-CONST 1 0 0)
         (uc-row M (+ p 4) OP-CMP CC-LT 0 0)
         (uc-row M (+ p 5) OP-BRZ 0 le 0)
         (uc-row M (+ p 6) OP-CONST 0 0 0)
         (uc-row M (+ p 7) OP-CONST 1 0 0)
         (uc-row M (+ p 8) OP-LGET 2 1 0)
         (uc-row M (+ p 9) OP-BIN BOP-SUB 1 0)
         (uc-row M (+ p 10) OP-LGET 2 2 0)
         (uc-row M (+ p 11) OP-CONST 3 1 0)
         (uc-row M (+ p 12) OP-BIN BOP-SUB 2 0)
         (uc-row M (+ p 13) OP-BIN BOP-ADD 1 0)
         (uc-row M (+ p 14) OP-LGET 2 2 0)
         (uc-row M (+ p 15) OP-BIN BOP-QUOT 1 0)
         (uc-row M (+ p 16) OP-BIN BOP-SUB 0 0)
         (uc-row M (+ p 17) OP-BR lj 0 0)
         (uc-row M (+ p 18) OP-LABEL le 0 0)
         (uc-row M (+ p 19) OP-LGET 0 1 0)
         (uc-row M (+ p 20) OP-LGET 1 2 0)
         (uc-row M (+ p 21) OP-BIN BOP-QUOT 0 0)
         (uc-row M (+ p 22) OP-LABEL lj 0 0)
         (uc-row M (+ p 23) OP-RET 0 0 0)
         (uc-row M (+ p 24) OP-END f 0 0))))))
(defn- pf-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N)
       cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N)]
  (if (or (not= (vector-at M MM-ERR) 0) (<= sn 0) (> sn MM-SIR-CAP)
          (<= fnn 0) (> fnn MM-FN-CAP) (<= f 0) (>= f fnn) (>= f MM-FN-CAP)
          (gn-clamp-open M f) (not= n 2) (< t 0) (> t 5)
          (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-vmode) 0)
          (not= (gn-g M gn-f-freg) 0) (<= (gn-g M gn-f-fb) 0)
          (> (gn-g M gn-f-fb) 32768)
          (< (gn-g M gn-f-h) (+ t 2)) (> (gn-g M gn-f-h) gn-cap)
          (< (gn-g M gn-f-dp) (+ t 2)) (> (gn-g M gn-f-dp) gn-cap)
          (< i 1) (>= i (dec sn)) (not (uc-row M i OP-CALL f t 2))
          (= (gn-op M (inc i)) OP-RET) (= (gn-op M (inc i)) OP-RES2)
          (< cn 0) (> cn (- MM-CODE-CAP 64)) (< fx 0) (>= fx MM-FIX-CAP)
          (not (gn-isk M (inc t) gn-k-const))) 0
   (let [k (gn-pow2 (gn-dv M (inc t)))]
    (if (and (>= k 1) (<= k 62) (pf-shape M f)) k 0)))))
(defn- pf-transfer [M :vector-i64 f :i64 k :i64] :vector-i64
 (let [threshold (+ -9223372036854775808 (i64-shift-left 1 k))
       m1 (-> M (gn-mov-imm 16 threshold) (gn-emit (enc-cmp-r 0 16)))
       test (vector-at m1 MM-CODE-N)
       m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lt) 0))
                  (gn-emit (gn-e-bf 0x93400000 0 0 k 63)))
       jump (vector-at m2 MM-CODE-N)
       m3 (gn-emit m2 (enc-b 0)) fallback (vector-at m3 MM-CODE-N)
       m4 (-> m3 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0)))
       end (vector-at m4 MM-CODE-N)]
  (-> m4 (gn-put (+ MM-CODE-BASE test) (enc-bcond (enc-cond-lt) (- fallback test)))
         (gn-put (+ MM-CODE-BASE jump) (enc-b (- end jump))))))
(defn- pf-or-cw-transfer [M :vector-i64 i :i64 f :i64 t :i64 n :i64 k :i64] :vector-i64
 (if (> k 0) (pf-transfer M f k) (cw-transfer M i f t n)))

;; Closed pure sign-partition diamond => exact full64 unsigned comparison.
;; Ordinary call preparation and common postfix retained; no fuel or effects.
(defn- spu-child [M :vector-i64 f :i64] :bool
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N)]
  (if (or (<= f 0) (>= f fnn) (> fnn MM-FN-CAP) (< sn 33) (> sn MM-SIR-CAP)) false
   (let [p (gn-fnf M f FF-SIR)]
    (if (or (<= p 0) (> p (- sn 33))) false
     (let [l0 (gn-sir M (+ p 1) IF-A) lb (gn-sir M (+ p 14) IF-A)
           lc (gn-sir M (+ p 16) IF-A) la (gn-sir M (+ p 18) IF-A)
           le (gn-sir M (+ p 25) IF-A) lf (gn-sir M (+ p 29) IF-A)
           ld (gn-sir M (+ p 30) IF-A)]
      (and (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
       (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-FUEL) 0)
       (= (gn-fnf M f FF-RTYPE) TY-BOOL) (= (gn-fnf M f FF-PT0) TY-I64)
       (= (gn-fnf M f (inc FF-PT0)) TY-I64) (not (gn-clamp-open M f))
       (uc-row M p OP-FN f 2 2)
       (uc-row M (+ p 1) OP-LABEL l0 0 0)
       (uc-row M (+ p 2) OP-LGET 0 1 0)
       (uc-row M (+ p 3) OP-CONST 1 0 0)
       (uc-row M (+ p 4) OP-CMP CC-LT 0 0)
       (uc-row M (+ p 5) OP-BRZ 0 la 0)
       (uc-row M (+ p 6) OP-LGET 0 2 0)
       (uc-row M (+ p 7) OP-CONST 1 0 0)
       (uc-row M (+ p 8) OP-CMP CC-LT 0 0)
       (uc-row M (+ p 9) OP-BRZ 0 lb 0)
       (uc-row M (+ p 10) OP-LGET 0 1 0)
       (uc-row M (+ p 11) OP-LGET 1 2 0)
       (uc-row M (+ p 12) OP-CMP CC-LT 0 0)
       (uc-row M (+ p 13) OP-BR lc 0 0)
       (uc-row M (+ p 14) OP-LABEL lb 0 0)
       (uc-row M (+ p 15) OP-CONST 0 0 0)
       (uc-row M (+ p 16) OP-LABEL lc 0 0)
       (uc-row M (+ p 17) OP-BR ld 0 0)
       (uc-row M (+ p 18) OP-LABEL la 0 0)
       (uc-row M (+ p 19) OP-LGET 0 2 0)
       (uc-row M (+ p 20) OP-CONST 1 0 0)
       (uc-row M (+ p 21) OP-CMP CC-LT 0 0)
       (uc-row M (+ p 22) OP-BRZ 0 le 0)
       (uc-row M (+ p 23) OP-CONST 0 1 0)
       (uc-row M (+ p 24) OP-BR lf 0 0)
       (uc-row M (+ p 25) OP-LABEL le 0 0)
       (uc-row M (+ p 26) OP-LGET 0 1 0)
       (uc-row M (+ p 27) OP-LGET 1 2 0)
       (uc-row M (+ p 28) OP-CMP CC-LT 0 0)
       (uc-row M (+ p 29) OP-LABEL lf 0 0)
       (uc-row M (+ p 30) OP-LABEL ld 0 0)
       (uc-row M (+ p 31) OP-RET 0 0 0)
       (uc-row M (+ p 32) OP-END f 0 0)
       (qb-labels M p 33 0))))))))
(defn- spu-safe [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :bool
 (let [sn (vector-at M MM-SIR-N)]
  (if (or (< sn 2) (> sn MM-SIR-CAP) (< i 0) (>= i (dec sn))
          (< t 0) (> t 5) (not= n 2) (not= (+ t n) (gn-g M gn-f-h))) false
   (and (uc-row M i OP-CALL f t n)
    (not= (gn-op M (inc i)) OP-RET) (not= (gn-op M (inc i)) OP-RET2)
    (not= (gn-op M (inc i)) OP-RES2) (not= (gn-op M (inc i)) OP-END)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (> (gn-g M gn-f-fb) 0) (>= (gn-g M gn-f-dp) (gn-g M gn-f-h))
    (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
    (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0)
    (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 2))
    (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
    (spu-child M f)))))
(defn- spu-emit [M :vector-i64] :vector-i64
 (-> M (gn-emit (enc-cmp-r 0 1)) (gn-emit (enc-cset 0 (enc-cond-lo)))))

;; Exact generic typed77-row closed readonly transfer with original private per-edge fuel.
;; Used only after ordinary gn-save/gn-args/gn-ctx, before original BL.
;; Guest inputs x0..4 stay authoritative until full successful leaf + fuel guard.
(defn- bv-child [M :vector-i64 f :i64] :bool
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N)]
  (if (or (<= f 0) (>= f fnn) (> fnn MM-FN-CAP)
    (> sn MM-SIR-CAP) (< sn 77)) false
   (let [p (gn-fnf M f FF-SIR)]
    (if (or (<= p 0) (> p (- sn 77))) false
     (let [flag (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 39) IF-B)]
      (and (= RT-VECTOR-AT 176) (gn-inl RT-VECTOR-AT 0 2) (not (gn-clamp-open M f)) (= (gn-fnf M f FF-NPARAMS) 5)
       (= (gn-fnf M f FF-NSLOTS) 9) (= (gn-fnf M f FF-DEPTH) 5)
       (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-RTYPE) TY-I64)
       (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 5)
       (> flag 1) (<= flag 256) (> (gn-pow2 flag) 0)
       (> stride 1) (<= stride 256) (> (gn-pow2 stride) 0)
       (gt-constants M p 0) (gt-shape M p f 0) (qb-labels M p 77 0))))))))
(defn- bv-transfer-safe [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :bool
 (let [sn (vector-at M MM-SIR-N)]
  (if (or (< i 0) (>= i (- sn 1)) (> sn MM-SIR-CAP)
    (< t 0) (not= n 5) (not= t (- (gn-g M gn-f-h) 5))) false
   (and (uc-row M i OP-CALL f t n)
    (not= (gn-op M (inc i)) OP-RET) (not= (gn-op M (inc i)) OP-RET2)
    (not= (gn-op M (inc i)) OP-RES2) (not= (gn-op M (inc i)) OP-END)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (> (gn-g M gn-f-fb) 0) (>= (gn-g M gn-f-dp) (gn-g M gn-f-h))
    (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-dead) 0)
    (= (gn-g M gn-f-skip) 0)
    (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0)
    (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 192))
    (>= (vector-at M MM-FIX-N) 0)
    (<= (vector-at M MM-FIX-N) (- MM-FIX-CAP 1)) (bv-child M f)))))
;; Installation contract: only inside gn-call-generic ordinary :else, after
;; gn-save(0,t), gn-stack-args(t,7,5) (empty), gn-args(t,0,5), gn-ctx.
;; Retain exact gn-vclear/gn-ctx-safe metadata/gn-take(i,t,0) common postfix.
;; No hook in gn-op-call, CALLI, tail-call, dead or selected inline paths.
 ;; Bounded readonly one-pass: full union and max-path fuel before private debit.
;; After each original private charge, original fresh-read order is retained.
;; A post-debit unsupported path restores8 from unchangedCTX before wholeBL.
(defn- bv-transfer-emit [M :vector-i64 f :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N)
  p (gn-fnf M f FF-SIR) flag (gn-sir M (+ p 4) IF-B) mask (dec flag)
  stride (gn-sir M (+ p 39) IF-B) leaf (gn-sir M (+ p 10) IF-B)
  feature (gn-sir M (+ p 21) IF-B) threshold (gn-sir M (+ p 29) IF-B)
  input (gn-sir M (+ p 37) IF-B) left (gn-sir M (+ p 51) IF-B)
  right (gn-sir M (+ p 54) IF-B) G (vector-alloc 49) H (vector-alloc 49)
  m0 (-> M (gn-mov-imm 9 2147483648)
   (gn-emit (enc-cmp-r 1 9)) (gt-cold G (enc-cond-hs))
   (gn-emit (enc-cmp-r 2 9)) (gt-cold G (enc-cond-hs))
   (gn-emit (enc-cmp-r 3 9)) (gt-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 17 7 312)) (gn-emit (enc-ldr 17 17 0))
   (gn-emit (enc-sub-i 9 0 1)) (gn-emit (enc-cmp-r 9 17))
   (gt-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 17 7 320)) (gn-emit (gn-e-addsl 17 17 9 4))
   (gn-emit (enc-ldp 6 5 17 0)) (gn-emit (enc-ldr 17 7 328))
   (gn-emit (gn-e-addsl 6 17 6 3))
   (gt-range G 3 leaf mask) (gt-range G 2 feature mask)
   (gt-range G 2 threshold mask) (gt-range G 2 left mask)
   (gt-range G 2 right mask)
   (gn-emit (gn-e-lsl 10 1 (gn-pow2 stride)))
   (gt-range G 10 input (dec stride))
   (gt-pointer 11 2 feature) (gt-pointer 12 2 threshold)
   (gt-pointer 13 10 input) (gt-pointer 14 2 left)
   (gt-pointer 15 2 right) (gt-pointer 16 3 leaf)
   (gn-emit (enc-ldr 6 7 CTX-FUEL))
   (gn-emit (enc-cmp-i 6 (inc flag))) (gt-cold G (enc-cond-lo))
   (gn-mov 9 4) (gn-mov-imm 10 0) (gn-mov 8 6) (gn-mask-charge))
  head (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-cmp-i 9 (* 2 flag))) (gt-cold H (enc-cond-hs))
   (gn-bin-imm BOP-AND 5 9 flag) (gn-emit (enc-cmp-i 5 flag)))
  terminal (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-eq) 0))
   (gn-emit (enc-cmp-i 10 flag)) (gt-cold H (enc-cond-hs))
   (gn-emit (gn-e-ldrr 5 11 9 1)) (gn-emit (gn-e-ldrr 6 12 9 1))
   (gn-emit (enc-cmp-i 5 stride)) (gt-cold H (enc-cond-hs))
   (gn-emit (gn-e-ldrr 17 13 5 1)) (gn-emit (enc-cmp-r 17 6)))
  select (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ge) 0))
   (gn-emit (gn-e-ldrr 9 14 9 1))) jump (vector-at m3 MM-CODE-N)
  m4 (gn-emit m3 (enc-b 0)) righth (vector-at m4 MM-CODE-N)
  m5 (gn-emit m4 (gn-e-ldrr 9 15 9 1)) advance (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-add-i 10 10 1)) (gn-mask-charge))
  back (vector-at m6 MM-CODE-N)
  m7 (gn-emit m6 (enc-b (- head back))) leafh (vector-at m7 MM-CODE-N)
  m8 (-> m7 (gn-bin-imm BOP-AND 5 9 mask)
   (gn-emit (gn-e-ldrr 0 16 5 1)) (gn-emit (enc-str 8 7 CTX-FUEL)))
  success (vector-at m8 MM-CODE-N) m9 (gn-emit m8 (enc-b 0))
  restore (vector-at m9 MM-CODE-N) m10 (gn-emit m9 (enc-ldr 8 7 CTX-FUEL))
  cold (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0)))
  join (vector-at m11 MM-CODE-N)
  m12 (-> m11 (gn-dot-patch terminal leafh (enc-cond-eq))
   (gn-dot-patch select righth (enc-cond-ge))
   (gn-put (+ MM-CODE-BASE jump) (enc-b (- advance jump)))
   (gn-put (+ MM-CODE-BASE success) (enc-b (- join success)))
   (gt-patch G 0 cold) (gt-patch H 0 restore))]
  (if (= (vector-at m12 MM-ERR) 0) m12
   (-> m12 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx)))))

;; Bounded closed masked multi-state recurrence. Constants and dependency IDs
;; are read from current typed M; original paid body remains the fallback.
(defn- mdr-get [M :vector-i64 d :i64 s :i64] :vector-i64
 (if (>= (gn-sreg M s) 0) (gn-mov M d (gn-sreg M s)) (gn-ld M d s)))
(defn- mdr-put [M :vector-i64 d :i64 s :i64] :vector-i64
 (if (>= (gn-sreg M s) 0) (gn-mov M (gn-sreg M s) d) (gn-st M d s)))
(defn- mdr-dynamic-constant [kind :i64 k :i64] :bool
 (case kind
  0 (or (= k 4) (= k 8) (= k 14) (= k 20) (= k 26))
  1 (or (= k 17) (= k 25) (= k 33))
  3 (or (= k 3) (= k 17) (= k 31))
  4 (or (= k 3) (= k 10) (= k 13) (= k 16) (= k 18) (= k 23) (= k 26) (= k 29) (= k 31) (= k 35) (= k 38))
  false))
(defn- mdr-pattern [kind :i64] :vector-i64
 (case kind 0 [5066614005235713 18 4229300233 25769803780 274877972483 65543 277038275493899 4294967300 8933532041219 30064902148 47244836868 8590000134 281487860891661 844429224312845 8937827008515 34359869444 51539804164 8590000134 281487860891661 844429224312845 8942121975811 38654836740 55834771460 8590000134 281487860891661 844429224312845 8946416943107 42949804036 60129738756 8590000134 281487860891661 844429224312845 4223008778 4227268617 25769803780 51539673092 55834705924 60129738756 1125904200957965 983045 25769803780 281479270760461 1048581 47244640260 64424574980 65542 21474902020 25769934852 562954259922958 4295098372 8590131204 68719738884 844437814050829 4295032838 65542 281479270957069 1114117 51539607556 73014509572 17180000260 25770000388 562958554890254 562958542307341 65542 281479270957069 1179653 4294967300 8590000132 12885032964 17180065796 21475098628 25770131460 4295360515 21474902022 30065164292 34360197124 38655229956 42950262788 60130197508 77310132228 51540393988 55835426820 65541 4295098373 8590131205 12885164037 17180196869 21475229701 25770262533 30065295365 34360328197 38655361029 42950393861 47245426693 51540459525 55835492357 18 4229300234 4223008777 19 4294901762] 1 [1125917086646273 18 4229300233 8589934596 12884967428 17180000259 4295163910 65542 262149 4294967300 17179934724 562949964955662 4295032836 17180000260 4295163907 8590000134 562954259922958 34359869443 4295491590 65542 4295032836 17180000260 8590131203 8590000134 562954259922958 68719607811 4295491590 65542 4295032836 17180000260 12885098499 8590000134 562954259922958 103079346179 4295491590 65542 19 4294901762] 2 [562962838257665 18 4229300233 4294967300 281479270957069 8590000132 524294 4295032836 281483565924365 137439084547 8590131204 8590065670 4295557126 393222 281479270957069 19 4294901762] 3 [1125921381613569 4229365769 4294967300 68719542275 131079 277115584905227 8589934596 12884967428 327686 8590000132 4295098376 17180000260 4295294982 393222 4226220042 4228448265 4294967300 137439019011 131079 277055455363083 17179869188 8590000132 327686 17179934724 4295098376 12885032964 4295294982 393222 4226285578 4227530761 4294967300 206158495747 131079 277008210722827 8589934596 12884967428 458758 17179934724 458758 4226351114 4226809865 12884901892 8590000132 17180000260 8590065672 4295360518 458758 4226351113 4226285577 4226220041 19 4294901762] 4 [281483566579713 4229365769 4294967300 68719542275 131079 277145649676299 4294967300 4226678794 4228907017 4294967300 137439019011 131079 277089815101451 21474836483 4295032836 196614 4295032835 65542 64424574979 327686 4226744330 4228055049 4294967300 206158495747 131079 277033980526603 12884901891 4295032836 196614 21474902019 65542 64424574979 327686 4226809866 4227203081 30064771075 4295032836 196614 64424574979 327686 4226809865 4226744329 4226678793 19 4294901762] []))
(defn- mdr-value [M :vector-i64 p :i64 T :vector-i64 e :i64] :i64
 (cond (= e -1) (vector-at T 0) (<= e -1000) (gn-sir M (+ p (- (- 0 e) 1000)) IF-A)
       (<= e -10) (vector-at T (- (- 0 e) 10)) :else e))
(defn- mdr-match [M :vector-i64 p :i64 T :vector-i64 kind :i64] :bool
 (let [V (mdr-pattern kind) count (vector-count V)]
  (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
   (loop [k 0] (or (= k count)
    (let [w (vector-at V k) op (bit-and w 65535)
          a (i64-shift-right (i64-shift-left w 32) 48)
          b (i64-shift-right (i64-shift-left w 16) 48) c (i64-shift-right w 48)]
     (and (gn-dot-at? M (+ p k) op (mdr-value M p T a) (if (mdr-dynamic-constant kind k) (gn-sir M (+ p k) IF-B) (mdr-value M p T b)) c)
          (recur (inc k)))))))))
(defn- mdr-counts [M :vector-i64] :bool
 (and (> (vector-at M MM-SIR-N) 0) (< (vector-at M MM-SIR-N) MM-SIR-CAP)
      (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)))
(defn- mdr-writer [M :vector-i64 f :i64] :bool
 (if (not (ir-bound M f 9 3 3 3)) false
  (let [p (gn-fnf M f FF-SIR)]
   (and (not (gn-clamp-open M f)) (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 3) (= (gn-fnf M f FF-FUEL) 1)
    (uc-row M p OP-FN f 3 3) (uc-row M (+ p 1) OP-FUEL 0 0 0)
    (uc-row M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    (uc-row M (+ p 3) OP-LGET 0 1 0) (uc-row M (+ p 4) OP-LGET 1 2 0)
    (uc-row M (+ p 5) OP-LGET 2 3 0) (uc-row M (+ p 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
    (uc-row M (+ p 7) OP-RET 0 0 0) (uc-row M (+ p 8) OP-END f 0 0) (qb-labels M p 9 0)))))
(defn- mdr-helper [M :vector-i64 T :vector-i64 kind :i64] :bool
 (let [f (vector-at T (case kind 1 5 2 6 3 3 4 4 0))]
  (and (mdr-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
   (let [n (case kind 1 3 2 2 3 4 4 1 0) slots (case kind 1 4 2 2 3 4 4 1 0)
         depth (case kind 1 4 2 4 3 3 4 2 0) p (gn-fnf M f FF-SIR)
         U (vector-assoc T 0 f)]
    (and (qb-bound M f (case kind 1 38 2 17 3 52 4 45 0) n slots depth (if (or (= kind 1) (= kind 2)) 1 0))
     (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) slots)
     (= (gn-fnf M f FF-DEPTH) depth) (= (gn-fnf M f FF-RTYPE) TY-I64)
     (loop [k 0] (or (= k n) (and (= (ck-pt M f k) (if (and (= kind 1) (= k 0)) TY-VEC TY-I64)) (recur (inc k)))))
     (= (gn-fnf M f FF-FUEL) (if (or (= kind 1) (= kind 2)) 1 0))
     (mdr-match M p U kind) (qb-labels M p (case kind 1 38 2 17 3 52 4 45 0) 0))))))
(defn- mdr-constants-safe [M :vector-i64 p :i64 T :vector-i64] :bool
 (let [fp (gn-fnf M (vector-at T 3) FF-SIR) gp (gn-fnf M (vector-at T 4) FF-SIR)
  wp (gn-fnf M (vector-at T 5) FF-SIR) limit (gn-sir M (+ p 4) IF-B)
  c1 (gn-sir M (+ fp 3) IF-B) c2 (gn-sir M (+ fp 17) IF-B) c3 (gn-sir M (+ fp 31) IF-B)
  mask (gn-sir M (+ gp 18) IF-B)]
  (and (> limit 0) (<= limit 1023) (> c1 0) (< c1 c2) (< c2 c3) (< c3 limit)
   (= c1 (gn-sir M (+ gp 3) IF-B)) (= c2 (gn-sir M (+ gp 10) IF-B)) (= c3 (gn-sir M (+ gp 23) IF-B))
   (>= mask 0) (<= mask 1022) (= mask (gn-sir M (+ gp 31) IF-B)) (= mask (gn-sir M (+ gp 38) IF-B))
   (>= (gn-sir M (+ gp 13) IF-B) 0) (<= (gn-sir M (+ gp 13) IF-B) 4095)
   (>= (gn-sir M (+ gp 16) IF-B) 0) (<= (gn-sir M (+ gp 16) IF-B) 4095)
   (>= (gn-sir M (+ gp 26) IF-B) 0) (<= (gn-sir M (+ gp 26) IF-B) 4095)
   (>= (gn-sir M (+ gp 29) IF-B) 0) (<= (gn-sir M (+ gp 29) IF-B) 4095)
   (>= (gn-sir M (+ gp 35) IF-B) 0) (<= (gn-sir M (+ gp 35) IF-B) 4095)
   (>= (gn-sir M (+ wp 17) IF-B) 0) (<= (gn-sir M (+ wp 17) IF-B) 63)
   (>= (gn-sir M (+ wp 25) IF-B) 0) (<= (gn-sir M (+ wp 25) IF-B) 63)
   (>= (gn-sir M (+ wp 33) IF-B) 0) (<= (gn-sir M (+ wp 33) IF-B) 63))))
(defn- mdr-regs [M :vector-i64 s :i64] :bool
 (or (> s 18) (and (= (gn-sreg M s)
  (case s 1 21 2 24 4 25 5 26 6 19 7 27 8 28 12 20 13 22 14 23 -1))
  (recur M (inc s)))))
(defn- mdr-admit [M :vector-i64 i :i64] :bool
 (and (mdr-counts M) (= (vector-at M MM-ERR) 0)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 512))
  (>= (vector-at M MM-FIX-N) 0) (< (vector-at M MM-FIX-N) MM-FIX-CAP)
  (> i 1) (< i (vector-at M MM-SIR-N))
  (<= 101 (- (vector-at M MM-SIR-N) (dec i))) (= (gn-op M (dec i)) OP-FN)
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (mdr-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 14)
    (= (gn-fnf M f FF-NSLOTS) 18) (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-DEPTH) 14)
    (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (loop [k 0] (or (= k 14) (and (= (ck-pt M f k) (if (or (= k 0) (= k 3) (= k 4)) TY-VEC TY-I64)) (recur (inc k)))))
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (<= (gn-g M gn-f-vmode) 0)
    (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-fb) 352) (= (gn-g M gn-f-nsv) 10)
    (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-g M gn-f-ctx) 1) (mdr-regs M 1)
    (let [T [f (gn-sir M (+ p 12) IF-A) (gn-sir M (+ p 13) IF-A)
             (gn-sir M (+ p 38) IF-A) (gn-sir M (+ p 41) IF-A)
             (gn-sir M (+ p 52) IF-A) (gn-sir M (+ p 62) IF-A)]
          mask (vector-at T 1) put (vector-at T 2)]
     (and (rr-mask M mask) (qb-labels M (gn-fnf M mask FF-SIR) 7 0) (mdr-writer M put)
      (mdr-match M p T 0) (qb-labels M p 101 0) (mdr-helper M T 1) (mdr-helper M T 2)
      (mdr-helper M T 3) (mdr-helper M T 4) (mdr-constants-safe M p T)))))))
(defn- mdr-miss [M :vector-i64 G :vector-i64 cond :i64] :vector-i64
 (let [n (vector-at G 64) a (vector-assoc! G (* n 2) (vector-at M MM-CODE-N))
       b (vector-assoc! a (inc (* n 2)) cond) c (vector-assoc! b 64 (inc n))]
  (gn-emit M (enc-bcond cond 0))))
(defn- mdr-root [M :vector-i64 G :vector-i64 rv :i64 dst :i64 lower :i64] :vector-i64
 (-> M (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
  (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)) (mdr-miss G (enc-cond-hs))
  (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
  (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
  (gn-emit (enc-cmp-r 0 16)) (mdr-miss G (enc-cond-hs))
  (gn-emit (enc-cmp-r 0 lower)) (mdr-miss G (enc-cond-lo))
  (gn-emit (enc-add-r 0 17 lower)) (gn-emit (enc-cmp-r 0 17)) (mdr-miss G (enc-cond-lo))
  (gn-mov-imm 16 1152921504606846975) (gn-emit (enc-cmp-r 0 16)) (mdr-miss G 8)
  (gn-emit (enc-ldr dst 7 328)) (gn-emit (gn-e-addsl 0 dst 0 3))
  (gn-emit (enc-cmp-r 0 dst)) (mdr-miss G (enc-cond-lo))
  (gn-emit (gn-e-addsl dst dst 17 3))))
(defn- mdr-fg [M :vector-i64 p :i64] :vector-i64
 (let [f (gn-fnf M (gn-sir M (+ p 38) IF-A) FF-SIR)
  g (gn-fnf M (gn-sir M (+ p 41) IF-A) FF-SIR)
  c1 (gn-sir M (+ f 3) IF-B) c2 (gn-sir M (+ f 17) IF-B) c3 (gn-sir M (+ f 31) IF-B)
  mul1 (gn-sir M (+ g 13) IF-B) add1 (gn-sir M (+ g 16) IF-B)
  mul2 (gn-sir M (+ g 26) IF-B) add2 (gn-sir M (+ g 29) IF-B)
  mul3 (gn-sir M (+ g 35) IF-B) mask (gn-sir M (+ g 18) IF-B)
  m0 (gn-emit M (enc-cmp-i 19 c1)) b0 (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ge) 0))
    (gn-emit (enc-and-r 9 20 22)) (gn-emit (enc-mvn 10 20)) (gn-emit (enc-and-r 10 10 23))
    (gn-emit (enc-orr-r 9 9 10)) (gn-mov 0 19)) e0 (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-b 0)) (gn-emit (enc-cmp-i 19 c2))) b1 (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ge) 0))
    (gn-emit (enc-and-r 9 23 20)) (gn-emit (enc-mvn 10 23)) (gn-emit (enc-and-r 10 10 22))
    (gn-emit (enc-orr-r 9 9 10)) (gn-mov-imm 16 mul1) (gn-emit (enc-mul 0 19 16))
    (gn-emit (enc-add-i 0 0 add1)) (gn-mov-imm 16 mask) (gn-emit (enc-and-r 0 0 16))) e1 (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-b 0)) (gn-emit (enc-cmp-i 19 c3))) b2 (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond (enc-cond-ge) 0))
    (gn-emit (enc-eor-r 9 20 22)) (gn-emit (enc-eor-r 9 9 23))
    (gn-mov-imm 16 mul2) (gn-emit (enc-mul 0 19 16)) (gn-emit (enc-add-i 0 0 add2))
    (gn-mov-imm 16 mask) (gn-emit (enc-and-r 0 0 16))) e2 (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-b 0)) (gn-emit (enc-mvn 10 23))
    (gn-emit (enc-orr-r 10 20 10)) (gn-emit (enc-eor-r 9 22 10))
    (gn-mov-imm 16 mul3) (gn-emit (enc-mul 0 19 16)) (gn-mov-imm 16 mask) (gn-emit (enc-and-r 0 0 16))) end (vector-at m6 MM-CODE-N)]
 (-> m6 (gn-dot-patch b0 (+ e0 1) (enc-cond-ge)) (gn-dot-patch b1 (+ e1 1) (enc-cond-ge))
  (gn-dot-patch b2 (+ e2 1) (enc-cond-ge))
  (gn-put (+ MM-CODE-BASE e0) (enc-b (- end e0)))
  (gn-put (+ MM-CODE-BASE e1) (enc-b (- end e1)))
  (gn-put (+ MM-CODE-BASE e2) (enc-b (- end e2))))))
(defn- mdr-body [M :vector-i64 p :i64] :vector-i64
 (let [w (gn-fnf M (gn-sir M (+ p 52) IF-A) FF-SIR)
  s1 (gn-sir M (+ w 17) IF-B) s2 (gn-sir M (+ w 25) IF-B) s3 (gn-sir M (+ w 33) IF-B)]
 (-> M (mdr-fg p) (mdr-get 10 11) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (gn-e-ldrr 11 4 19 1)) (gn-emit (enc-add-r 9 9 11)) (gn-st 9 15)
  ;; Original word helper's private charge precedes its first payload read.
  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-subs-i 8 8 1))
  (gn-emit (enc-bcond (enc-cond-hs) 3)) (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))
  (gn-emit (gn-e-addsl 0 24 0 2)) (gn-emit (gn-e-ldrr 9 6 0 1))
  (gn-emit (enc-add-i 1 0 1)) (gn-emit (gn-e-ldrr 10 6 1 1))
  (gn-emit (gn-e-lsl 10 10 s1)) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (enc-add-i 1 0 2)) (gn-emit (gn-e-ldrr 10 6 1 1))
  (gn-emit (gn-e-lsl 10 10 s2)) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (enc-add-i 1 0 3)) (gn-emit (gn-e-ldrr 10 6 1 1))
  (gn-emit (gn-e-lsl 10 10 s3)) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (enc-str 8 7 CTX-FUEL))
  (gn-ld 10 15) (gn-emit (enc-add-r 0 9 10)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31))
  ;; Original shift payload read precedes rotate's public entry transaction.
  (gn-emit (gn-e-ldrr 1 3 19 1)) (gn-op-fuel)
  (gn-emit (gn-e-bf 0xd3400000 9 0 0 31)) (gn-emit (enc-lslv 9 9 1))
  (gn-emit (gn-e-bf 0xd3400000 10 0 0 31)) (gn-mov-imm 16 32)
  (gn-emit (enc-sub-r 11 16 1)) (gn-emit (enc-lsrv 10 10 11))
  (gn-emit (enc-orr-r 9 9 10)) (gn-emit (gn-e-bf 0xd3400000 9 9 0 31))
  (gn-emit (enc-add-r 9 20 9)) (gn-emit (gn-e-bf 0xd3400000 9 9 0 31))
  (mdr-get 0 14) (mdr-put 0 11) (mdr-get 1 12) (mdr-get 2 13)
  (mdr-put 9 12) (mdr-put 1 13) (mdr-put 2 14)
  (gn-emit (enc-add-i 19 19 1)) (gn-op-fuel))))
(defn- mdr-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (mdr-admit M i)) M
  (let [G (vector-alloc 65) p (dec i) cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
   limit (gn-sir M (+ p 4) IF-B) gp (gn-fnf M (gn-sir M (+ p 41) IF-A) FF-SIR)
   mask (gn-sir M (+ gp 18) IF-B) maxg (if (> (dec limit) mask) (dec limit) mask)
   span (+ (* maxg 4) 4)
   m0 (-> M (gn-emit (enc-cmp-i 19 limit)) (mdr-miss G (enc-cond-hs))
     (gn-mov-imm 9 limit) (gn-emit (enc-sub-r 9 9 19)) (gn-mov-imm 10 3)
     (gn-emit (enc-mul 9 9 10)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
     (gn-emit (enc-cmp-r 8 9)) (mdr-miss G (enc-cond-lo))
     (gn-mov-imm 10 (- 1152921504606846975 span)) (gn-emit (enc-cmp-r 24 10))
     (mdr-miss G 8) (gn-emit (enc-add-i 11 24 span))
     (mdr-root G 21 6 11) (gn-mov-imm 11 limit)
     (mdr-root G 26 4 11) (mdr-root G 25 3 11)) head (vector-at m0 MM-CODE-N)
   m1 (-> m0 (mdr-body p) (gn-emit (enc-cmp-i 19 limit))) back (vector-at m1 MM-CODE-N)
   m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) (- head back)))
     (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0))) cold (vector-at m2 MM-CODE-N)
   m3 (if (= (vector-at m2 MM-ERR) 0) (gn-gs m2 gn-f-dead dead)
    (-> m2 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))]
   (if (not= (vector-at m3 MM-ERR) 0) m3
   (loop [cur m3 k 0] (if (= k (vector-at G 64)) cur
     (recur (gn-dot-patch cur (vector-at G (* k 2)) cold (vector-at G (inc (* k 2)))) (inc k))))))))

;; Generic closed two-cell exchange. Initial private charge is already paid.
;; Guard misses retain parameters0..2/context7/private8 and enter original body.
(defn- ex-row [M :vector-i64 p :i64 f :i64 w :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A)]
  (case k
   0 (uc-row M p OP-FN f 3 5)
   1 (uc-row M (+ p 1) OP-FUEL 0 0 0)
   2 (uc-row M (+ p 2) OP-LABEL head 0 0)
   3 (uc-row M (+ p 3) OP-LGET 0 1 0)
   4 (uc-row M (+ p 4) OP-LGET 1 2 0)
   5 (uc-row M (+ p 5) OP-RT RT-VECTOR-AT 0 2)
   6 (uc-row M (+ p 6) OP-LSET 4 0 0)
   7 (uc-row M (+ p 7) OP-LGET 0 1 0)
   8 (uc-row M (+ p 8) OP-LGET 1 3 0)
   9 (uc-row M (+ p 9) OP-RT RT-VECTOR-AT 0 2)
   10 (uc-row M (+ p 10) OP-LSET 5 0 0)
   11 (uc-row M (+ p 11) OP-LGET 0 1 0)
   12 (uc-row M (+ p 12) OP-LGET 1 2 0)
   13 (uc-row M (+ p 13) OP-LGET 2 5 0)
   14 (uc-row M (+ p 14) OP-CALL w 0 3)
   15 (uc-row M (+ p 15) OP-LGET 1 3 0)
   16 (uc-row M (+ p 16) OP-LGET 2 4 0)
   17 (uc-row M (+ p 17) OP-CALL w 0 3)
   18 (uc-row M (+ p 18) OP-RET 0 0 0)
   19 (uc-row M (+ p 19) OP-END f 0 0)
   false)))
(defn- ex-rows [M :vector-i64 p :i64 f :i64 w :i64 k :i64] :bool
 (if (= k 20) true (and (ex-row M p f w k) (ex-rows M p f w (inc k)))))
(defn- ex-admit [M :vector-i64 i :i64] :bool
 (and (> i 1) (< i (vector-at M MM-SIR-N)) (< i MM-SIR-CAP)
  (<= (vector-at M MM-SIR-N) MM-SIR-CAP) (> (vector-at M MM-FN-N) 0)
  (<= (vector-at M MM-FN-N) MM-FN-CAP) (= (gn-op M (dec i)) OP-FN)
  (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
  (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-out) 0)
  (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
  (= (gn-g M gn-f-ns) 5) (= (gn-g M gn-f-dp) 3)
  (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
  (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2)
  (= (gn-sreg M 4) 3) (= (gn-sreg M 5) 4)
  (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0)
  (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 80))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (let [f (gn-g M fr-owner) p (dec i)]
   (and (> f 0) (< f (vector-at M MM-FN-N)) (< f MM-FN-CAP)
    (not (gn-clamp-open M f)) (ir-bound M f 20 3 5 3)
    (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 3)
    (let [w (gn-sir M (+ p 14) IF-A)]
     (and (> w 0) (< w (vector-at M MM-FN-N)) (< w MM-FN-CAP)
      (gn-copy-writer? M w) (= (gn-fnf M w FF-FUEL) 1)
      (qb-labels M (gn-fnf M w FF-SIR) 9 0)
      (ex-rows M p f w 0) (qb-labels M p 20 0)))))))
(defn- ex-emit [M :vector-i64] :vector-i64
 (let [m0 (-> M (gn-emit (enc-ldr 9 7 312)) (gn-emit (enc-ldr 9 9 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 9))) handle (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 9 7 320))
   (gn-emit (gn-e-addsl 9 9 17 4)) (gn-emit (enc-ldp 17 10 9 0))
   (gn-mov 11 1) (gn-emit (enc-cmp-r 1 2)) (gn-emit (enc-bcond (enc-cond-hs) 2)) (gn-mov 11 2)
   (gn-emit (enc-cmp-r 11 10))) bounds (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-add-r 11 17 11))
   (gn-emit (enc-cmp-r 11 17))) offsetwrap (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (gn-e-lsr 10 11 61))) scale (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-cbnz 10 0)) (gn-emit (enc-ldr 9 7 328))
   (gn-emit (gn-e-addsl 11 9 11 3)) (gn-emit (enc-cmp-r 11 9))) pointerwrap (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-add-i 12 11 7))
   (gn-emit (enc-cmp-r 12 11))) wordwrap (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (gn-e-addsl 9 9 17 3))
   (gn-emit (gn-e-ldrr 13 9 1 1)) (gn-emit (gn-e-ldrr 14 9 2 1))
   (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 3))
   (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))
   (gn-emit (gn-e-strr3 14 9 1))
   (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 3))
   (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))
   (gn-emit (gn-e-strr3 13 9 2))) m7 (gn-epilogue m6) cold (vector-at m7 MM-CODE-N)]
  (-> m7 (gn-dot-patch handle cold (enc-cond-hs)) (gn-dot-patch bounds cold (enc-cond-hs))
   (gn-dot-patch offsetwrap cold (enc-cond-lo)) (gn-put (+ MM-CODE-BASE scale) (enc-cbnz 10 (- cold scale)))
   (gn-dot-patch pointerwrap cold (enc-cond-lo)) (gn-dot-patch wordwrap cold (enc-cond-lo)))))
(defn- ex-entry [M :vector-i64 i :i64] :vector-i64
 (if (ex-admit M i)
  (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead) final (ex-emit M)]
   (if (= (vector-at final MM-ERR) 0) (gn-gs final gn-f-dead dead)
    (-> final (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))) M))

;; Generic closed readonly two-index scan, postpaid private entry.
(defn- rs-row [M :vector-i64 p :i64 f :i64 k :i64 left :bool] :bool
 (let [head (gn-sir M (+ p 2) IF-A) test (gn-sir M (+ p 6) IF-B)
  done (gn-sir M (+ p 19) IF-B) join (gn-sir M (+ p 32) IF-A) base (gn-sir M (+ p 8) IF-B)]
  (case k
   0 (uc-row M (+ p 0) 1 f 4 4)
   1 (uc-row M (+ p 1) 18 0 0 0)
   2 (uc-row M (+ p 2) 9 head 0 0)
   3 (uc-row M (+ p 3) 4 0 2 0)
   4 (uc-row M (+ p 4) 4 1 3 0)
   5 (uc-row M (+ p 5) 7 4 0 0)
   6 (uc-row M (+ p 6) 11 0 test 0)
   7 (uc-row M (+ p 7) 4 0 1 0)
   8 (uc-row M (+ p 8) 3 1 base 0)
   9 (if left (uc-row M (+ p 9) 4 2 2 0) (uc-row M (+ p 9) 4 2 3 0))
   10 (uc-row M (+ p 10) 6 1 1 0)
   11 (uc-row M (+ p 11) 14 176 0 2)
   12 (uc-row M (+ p 12) 4 1 1 0)
   13 (uc-row M (+ p 13) 3 2 base 0)
   14 (uc-row M (+ p 14) 4 3 4 0)
   15 (uc-row M (+ p 15) 6 1 2 0)
   16 (uc-row M (+ p 16) 14 176 1 2)
   17 (if left (uc-row M (+ p 17) 7 4 0 0) (uc-row M (+ p 17) 7 5 0 0))
   18 (uc-row M (+ p 18) 9 test 0 0)
   19 (uc-row M (+ p 19) 11 0 done 0)
   20 (uc-row M (+ p 20) 4 0 1 0)
   21 (uc-row M (+ p 21) 4 1 2 0)
   22 (if left (uc-row M (+ p 22) 3 2 1 0) (uc-row M (+ p 22) 4 2 3 0))
   23 (if left (uc-row M (+ p 23) 6 1 1 0) (uc-row M (+ p 23) 3 3 1 0))
   24 (if left (uc-row M (+ p 24) 4 2 3 0) (uc-row M (+ p 24) 6 2 2 0))
   25 (uc-row M (+ p 25) 4 3 4 0)
   26 (uc-row M (+ p 26) 5 1 0 0)
   27 (uc-row M (+ p 27) 5 2 1 0)
   28 (uc-row M (+ p 28) 5 3 2 0)
   29 (uc-row M (+ p 29) 5 4 3 0)
   30 (uc-row M (+ p 30) 18 0 0 0)
   31 (uc-row M (+ p 31) 10 head 0 0)
   32 (uc-row M (+ p 32) 10 join 0 0)
   33 (uc-row M (+ p 33) 9 done 0 0)
   34 (if left (uc-row M (+ p 34) 4 0 2 0) (uc-row M (+ p 34) 4 0 3 0))
   35 (uc-row M (+ p 35) 9 join 0 0)
   36 (uc-row M (+ p 36) 19 0 0 0)
   37 (uc-row M (+ p 37) 2 f 0 0)
   false)))
(defn- rs-rows [M :vector-i64 p :i64 f :i64 k :i64 left :bool] :bool
 (if (= k 38) true (and (rs-row M p f k left) (rs-rows M p f (inc k) left))))
(defn- rs-admit [M :vector-i64 i :i64] :bool
 (and (> i 1) (< i (vector-at M MM-SIR-N)) (< i MM-SIR-CAP)
  (>= (vector-at M MM-SIR-N) 38) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (= (gn-op M (dec i)) OP-FN) (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
  (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-out) 0)
  (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
  (= (gn-g M gn-f-ns) 4) (= (gn-g M gn-f-dp) 4)
  (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
  (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2) (= (gn-sreg M 4) 3)
  (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0)
  (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 96))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (let [f (gn-g M fr-owner) p (dec i)]
   (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
    (not (gn-clamp-open M f)) (qb-bound M f 38 4 4 4 1)
    (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 4)
    (let [base (gn-sir M (+ p 8) IF-B) cmp (gn-sir M (+ p 17) IF-A)]
     (and (>= base 1) (<= base 4095) (or (= cmp CC-LE) (= cmp CC-GE))
      (rs-rows M p f 0 (= cmp CC-LE)) (qb-labels M p 38 0)))))))
(defn- rs-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) base (gn-sir M (+ p 8) IF-B) left (= (gn-sir M (+ p 17) IF-A) CC-LE)
  moving (if left 1 2) m0 (gn-emit M (enc-cmp-r 1 2)) empty (vector-at m0 MM-CODE-N)
  m1 (gn-emit m0 (enc-bcond (enc-cond-gt) 0))
  m2 (-> m1 (gn-emit (gn-e-lsr 16 1 31)) (gn-emit (gn-e-lsr 17 2 31)) (gn-emit (enc-orr-r 16 16 17))
   (gn-emit (gn-e-lsr 17 3 31)) (gn-emit (enc-orr-r 16 16 17))) domain (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-cbnz 16 0)) (gn-emit (enc-ldr 5 7 312)) (gn-emit (enc-ldr 5 5 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 5))) handle (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 4 7 320))
   (gn-emit (gn-e-addsl 4 4 17 4)) (gn-emit (enc-ldp 17 6 4 0))
   (gn-mov 9 2) (gn-emit (enc-cmp-r 9 3)))
  m5 (gn-emit m4 (enc-bcond (enc-cond-hs) 2)) m6 (gn-mov m5 9 3)
  m7 (-> m6 (gn-emit (enc-add-i 9 9 base)) (gn-emit (enc-cmp-r 9 6))) bounds (vector-at m7 MM-CODE-N)
  m8 (-> m7 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-add-r 9 17 9)) (gn-emit (enc-cmp-r 9 17))) wrapidx (vector-at m8 MM-CODE-N)
  m9 (-> m8 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (gn-e-lsr 6 9 61))) scale (vector-at m9 MM-CODE-N)
  m10 (-> m9 (gn-emit (enc-cbnz 6 0)) (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 9 4 9 3)) (gn-emit (enc-cmp-r 9 4))) wrapptr (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-add-i 17 17 base))
   (gn-emit (gn-e-addsl 4 4 17 3)) (gn-emit (gn-e-addsl 13 4 3 3)) (gn-mov-imm 12 0))
  loop (vector-at m11 MM-CODE-N) m12 (gn-emit m11 (enc-cmp-r 1 2)) stopbound (vector-at m12 MM-CODE-N)
  m13 (-> m12 (gn-emit (enc-bcond (enc-cond-gt) 0)) (gn-emit (gn-e-addsl 9 4 moving 3))
   (gn-emit (enc-ldr 11 9 0)) (gn-emit (enc-cbnz 12 3)) (gn-emit (enc-ldr 10 13 0)) (gn-mov-imm 12 1)
   (gn-emit (enc-cmp-r 11 10))) stopvalue (vector-at m13 MM-CODE-N)
  m14 (gn-emit m13 (enc-bcond (if left (enc-cond-gt) (enc-cond-lt)) 0))
  m15 (if left (gn-emit m14 (enc-add-i 1 1 1)) (gn-emit m14 (enc-sub-i 2 2 1)))
  m16 (-> m15 (gn-emit (enc-subs-i 8 8 1)) (gn-emit (enc-bcond (enc-cond-hs) 3))
   (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))) back (vector-at m16 MM-CODE-N)
  m17 (gn-emit m16 (enc-b (- loop back))) yes (vector-at m17 MM-CODE-N)
  m18 (gn-mov m17 0 moving) m19 (gn-epilogue m18) cold (vector-at m19 MM-CODE-N)]
  (-> m19 (gn-dot-patch empty yes (enc-cond-gt))
   (gn-put (+ MM-CODE-BASE domain) (enc-cbnz 16 (- cold domain)))
   (gn-dot-patch handle cold (enc-cond-hs)) (gn-dot-patch bounds cold (enc-cond-hs))
   (gn-dot-patch wrapidx cold (enc-cond-lo)) (gn-put (+ MM-CODE-BASE scale) (enc-cbnz 6 (- cold scale)))
   (gn-dot-patch wrapptr cold (enc-cond-lo)) (gn-dot-patch stopbound yes (enc-cond-gt))
   (gn-dot-patch stopvalue yes (if left (enc-cond-gt) (enc-cond-lt))))))
(defn- rs-entry [M :vector-i64 i :i64] :vector-i64
 (if (rs-admit M i)
  (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead) final (rs-emit M i)]
   (if (= (vector-at final MM-ERR) 0) (gn-gs final gn-f-dead dead)
    (-> final (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))) M))

;; Closed masked affine state -> immutable scalar table -> XOR recurrence.
;; Derived constants and exact typed helpers; all original publications retained.
(defn- maft-row [M :vector-i64 p :i64 f :i64 affine :i64 table :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 1 8)
  1 (uc-row M (+ p 1) 18 0 0 0)
  2 (uc-row M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (uc-row M (+ p 3) 3 0 (gn-sir M (+ p 3) IF-B) 0)
  4 (uc-row M (+ p 4) 5 2 0 0)
  5 (uc-row M (+ p 5) 3 0 (gn-sir M (+ p 5) IF-B) 0)
  6 (uc-row M (+ p 6) 5 3 0 0)
  7 (uc-row M (+ p 7) 3 0 (gn-sir M (+ p 7) IF-B) 0)
  8 (uc-row M (+ p 8) 5 4 0 0)
  9 (uc-row M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (uc-row M (+ p 10) 4 0 2 0)
  11 (uc-row M (+ p 11) 4 1 1 0)
  12 (uc-row M (+ p 12) 7 1 0 0)
  13 (uc-row M (+ p 13) 11 0 (gn-sir M (+ p 19) IF-A) 0)
  14 (uc-row M (+ p 14) 4 0 4 0)
  15 (uc-row M (+ p 15) 8 2 0 0)
  16 (uc-row M (+ p 16) 3 1 (gn-sir M (+ p 16) IF-B) 0)
  17 (uc-row M (+ p 17) 6 5 0 0)
  18 (uc-row M (+ p 18) 10 (gn-sir M (+ p 50) IF-A) 0 0)
  19 (uc-row M (+ p 19) 9 (gn-sir M (+ p 19) IF-A) 0 0)
  20 (uc-row M (+ p 20) 4 0 3 0)
  21 (uc-row M (+ p 21) 13 affine 0 1)
  22 (uc-row M (+ p 22) 5 5 0 0)
  23 (uc-row M (+ p 23) 4 0 5 0)
  24 (uc-row M (+ p 24) 3 1 (gn-sir M (+ p 24) IF-B) 0)
  25 (uc-row M (+ p 25) 6 9 0 0)
  26 (uc-row M (+ p 26) 5 6 0 0)
  27 (uc-row M (+ p 27) 4 0 4 0)
  28 (uc-row M (+ p 28) 4 1 6 0)
  29 (uc-row M (+ p 29) 6 7 0 0)
  30 (uc-row M (+ p 30) 3 1 (gn-sir M (+ p 30) IF-B) 0)
  31 (uc-row M (+ p 31) 6 5 0 0)
  32 (uc-row M (+ p 32) 5 7 0 0)
  33 (uc-row M (+ p 33) 4 0 7 0)
  34 (uc-row M (+ p 34) 13 table 0 1)
  35 (uc-row M (+ p 35) 4 1 4 0)
  36 (uc-row M (+ p 36) 3 2 (gn-sir M (+ p 36) IF-B) 0)
  37 (uc-row M (+ p 37) 6 9 1 0)
  38 (uc-row M (+ p 38) 6 7 0 0)
  39 (uc-row M (+ p 39) 5 8 0 0)
  40 (uc-row M (+ p 40) 4 0 2 0)
  41 (uc-row M (+ p 41) 3 1 1 0)
  42 (uc-row M (+ p 42) 6 1 0 0)
  43 (uc-row M (+ p 43) 4 1 5 0)
  44 (uc-row M (+ p 44) 4 2 8 0)
  45 (uc-row M (+ p 45) 5 2 0 0)
  46 (uc-row M (+ p 46) 5 3 1 0)
  47 (uc-row M (+ p 47) 5 4 2 0)
  48 (uc-row M (+ p 48) 18 0 0 0)
  49 (uc-row M (+ p 49) 10 (gn-sir M (+ p 9) IF-A) 0 0)
  50 (uc-row M (+ p 50) 9 (gn-sir M (+ p 50) IF-A) 0 0)
  51 (uc-row M (+ p 51) 19 0 0 0)
  52 (uc-row M (+ p 52) 2 f 0 0)
  false))
(defn- maft-aff-row [M :vector-i64 p :i64 f :i64 unused :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 1 1)
  1 (uc-row M (+ p 1) 9 (gn-sir M (+ p 1) IF-A) 0 0)
  2 (uc-row M (+ p 2) 4 0 1 0)
  3 (uc-row M (+ p 3) 3 1 (gn-sir M (+ p 3) IF-B) 0)
  4 (uc-row M (+ p 4) 6 3 0 0)
  5 (uc-row M (+ p 5) 3 1 (gn-sir M (+ p 5) IF-B) 0)
  6 (uc-row M (+ p 6) 6 1 0 0)
  7 (uc-row M (+ p 7) 3 1 (gn-sir M (+ p 7) IF-B) 0)
  8 (uc-row M (+ p 8) 6 5 0 0)
  9 (uc-row M (+ p 9) 19 0 0 0)
  10 (uc-row M (+ p 10) 2 f 0 0)
  false))
(defn- maft-rows [M :vector-i64 p :i64 f :i64 affine :i64 table :i64 k :i64] :bool
 (if (= k 53) true (and (maft-row M p f affine table k) (maft-rows M p f affine table (inc k)))))
(defn- maft-aff-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 11) true (and (maft-aff-row M p f 0 k) (maft-aff-rows M p f (inc k)))))
(defn- maft-affine [M :vector-i64 f :i64] :bool
 (and (qb-bound M f 11 1 1 2 0) (qb-int-params M f 0 1)
  (maft-aff-rows M (gn-fnf M f FF-SIR) f 0) (qb-labels M (gn-fnf M f FF-SIR) 11 0)))
(defn- maft-table [M :vector-i64 f :i64 n :i64] :i64
 (if (or (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))
  (not= (gn-fnf M f FF-NPARAMS) 1) (not= (gn-fnf M f FF-NSLOTS) 1)
  (not= (gn-fnf M f FF-DEPTH) 2) (not= (gn-fnf M f FF-FUEL) 1)
  (not= (gn-fnf M f FF-PT0) TY-I64) (not= (gn-fnf M f FF-RTYPE) TY-I64)
  (gn-clamp-open M f) (<= n 0) (> n 256) (not= (rem n 16) 0)) 0
  (let [p (gn-fnf M f FF-SIR)]
   (if (or (<= p 0) (>= p (dec (vector-at M MM-SIR-N)))
    (not (uc-row M p OP-FN f 1 1)) (not (uc-row M (inc p) OP-FUEL 0 0 0))) 0
    (let [end (tc-end M p f) base (loop [j (+ p 2)]
     (cond (or (= end 0) (>= j end)) 0 (= (gn-op M j) OP-TAB) (gn-sir M j IF-B)
      :else (recur (inc j))))]
     (if (and (> end p) (> base 0) (= (gn-op M end) OP-END)
      (uc-row M end OP-END f 0 0) (qb-labels M p (inc (- end p)) 0)
      (= (tc-scan M p end base) (quot n 16)) (tc-cover M p end base n)) base 0))))))
(defn- maft-homes [M :vector-i64 k :i64] :bool
 (if (= k 5) true
  (let [r (gn-sreg M k)] (and (>= r 19) (<= r 28)
    (loop [j 1] (or (= j k) (and (not= r (gn-sreg M j)) (recur (inc j)))))
    (maft-homes M (inc k))))))
(defn- maft-admit [M :vector-i64 i :i64] :i64
 (let [f (gn-g M fr-owner) p (dec i)]
  (if (or (<= i 1) (not (qb-bound M f 53 1 8 3 1))
   (not= p (gn-fnf M f FF-SIR)) (not (qb-int-params M f 0 1))
   (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
   (not= (gn-g M gn-f-vmode) 0) (not= (gn-g M gn-f-h) 0)
   (not= (gn-g M gn-f-ns) 8) (not= (gn-g M gn-f-dp) 3)
   (not= (gn-g M gn-f-out) 0) (not= (gn-g M gn-f-ctx) 1)
   (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-dead) 0)
   (< (gn-g M gn-f-nsv) 4) (> (gn-g M gn-f-nsv) 10) (<= (gn-g M gn-f-fb) 0)
   (> (gn-g M gn-f-fb) 32768) (not (maft-homes M 1))
   (not= (vector-at M MM-ERR) 0) (< (vector-at M MM-CODE-N) 0)
   (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 160))
   (< (vector-at M MM-FIX-N) 0) (>= (vector-at M MM-FIX-N) MM-FIX-CAP)) 0
   (let [affine (gn-sir M (+ p 21) IF-A) table (gn-sir M (+ p 34) IF-A)
    shift (gn-sir M (+ p 24) IF-B) mask (gn-sir M (+ p 30) IF-B)
    foldshift (gn-sir M (+ p 36) IF-B)]
    (if (and (>= shift 0) (<= shift 63) (>= foldshift 0) (<= foldshift 63)
     (>= mask 15) (<= mask 255) (= (bit-and mask (inc mask)) 0)
     (maft-rows M p f affine table 0) (qb-labels M p 53 0)
     (maft-affine M affine)) (maft-table M table (inc mask)) 0)))))
(defn- maft-emit [M :vector-i64 i :i64 lit :i64] :vector-i64
 (let [p (dec i) ap (gn-fnf M (gn-sir M (+ p 21) IF-A) FF-SIR)
  ih (gn-sreg M 2) sh (gn-sreg M 3) ch (gn-sreg M 4) stop (gn-sreg M 1)
  ;; Hoist only immutable code/literal and pure constants; no payload read/PUB.
  m0 (-> M (gn-mov-imm ih (gn-sir M (+ p 3) IF-B))
   (gn-mov-imm sh (gn-sir M (+ p 5) IF-B)) (gn-mov-imm ch (gn-sir M (+ p 7) IF-B))
   (gn-emit (enc-cmp-r ih stop))) empty (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-eq) 0))
   (gn-mov-imm 10 (gn-sir M (+ ap 3) IF-B))
   (gn-mov-imm 11 (gn-sir M (+ ap 5) IF-B))
   (gn-mov-imm 12 (gn-sir M (+ ap 7) IF-B))
   (gn-mov-imm 14 (gn-sir M (+ p 30) IF-B))
   (gn-emit (enc-ldr 13 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
   (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
   (gn-emit (enc-add-r 13 13 16))) head (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-madd sh sh 10 11)) (gn-emit (enc-and-r sh sh 12))
   (gn-emit (gn-e-lsr 9 sh (gn-sir M (+ p 24) IF-B)))
   (gn-emit (enc-eor-r 9 ch 9)) (gn-emit (enc-and-r 9 9 14))
   ;; Original private table reader charge and zero-publication exhaustion.
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mask-charge)
   (gn-emit (gn-e-ldrr 9 13 9 1)) (gn-emit (enc-str 8 7 CTX-FUEL))
   (gn-emit (gn-e-lsr 17 ch (gn-sir M (+ p 36) IF-B)))
   (gn-emit (enc-eor-r ch 9 17)) (gn-emit (enc-add-i ih ih 1))
   ;; Original shared recurrence charge, including trap-before-PUB ordering.
   (gn-op-fuel) (gn-emit (enc-cmp-r ih stop))) back (vector-at m2 MM-CODE-N)
  m3 (gn-emit m2 (enc-bcond (enc-cond-ne) (- head back))) done (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-orn-r 0 31 ch))
   (gn-mov-imm 17 (gn-sir M (+ p 16) IF-B)) (gn-emit (enc-and-r 0 0 17))
   (gn-epilogue))]
  (gn-dot-patch m4 empty done (enc-cond-eq))))
(defn- maft-entry [M :vector-i64 i :i64] :vector-i64
 (let [lit (maft-admit M i)]
  (if (= lit 0) M
   (let [code (vector-at M MM-CODE-N) fix (vector-at M MM-FIX-N)
    dead (gn-g M gn-f-dead) ctx (gn-g M gn-f-ctx) m1 (maft-emit M i lit)
    words (- (vector-at m1 MM-CODE-N) code)]
    (cond (not= (vector-at m1 MM-ERR) 0) m1
     (and (> words 0) (<= words 160) (= (vector-at m1 MM-FIX-N) (inc fix))) m1
     :else (-> m1 (gn-put MM-CODE-N code) (gn-put MM-FIX-N fix)
      (gn-gs gn-f-dead dead) (gn-gs gn-f-ctx ctx)))))))

;; Generic OR of 2..8 repeated immutable endzero string reads/equalities.
;; Only the checked ASCII/endzero arm is fused; whole original paid body is cold.
(defn- isf-stage [M :vector-i64 p :i64 h :i64 q :i64 n :i64 j :i64] :bool
 (if (= j n) true
  (let [s (+ p 3 (* j 6)) v (gn-sir M (+ s 3) IF-B)]
   (and (uc-row M s OP-LGET 0 1 0) (uc-row M (inc s) OP-LGET 1 2 0)
    (uc-row M (+ s 2) OP-CALL h 0 2) (>= v 0) (< v 128)
    (uc-row M (+ s 3) OP-CONST 1 v 0) (uc-row M (+ s 4) OP-CMP CC-EQ 0 0)
    (or (= (inc j) n) (uc-row M (+ s 5) OP-BRNZ 0 q 0))
    (isf-stage M p h q n (inc j))))))
(defn- isf-count [M :vector-i64 f :i64 n :i64] :i64
 (if (> n 8) 0
  (if (ir-bound M f (+ (* n 6) 5) 2 2 2)
   (let [p (gn-fnf M f FF-SIR) h (gn-sir M (+ p 5) IF-A)
    head (gn-sir M (+ p 2) IF-A) q (gn-sir M (+ p (* n 6) 2) IF-A)]
    (if (and (= (gn-fnf M f FF-RTYPE) TY-BOOL)
     (= (gn-fnf M f FF-PT0) TY-STR) (= (gn-fnf M f (inc FF-PT0)) TY-I64)
     (uc-row M p OP-FN f 2 2) (uc-row M (inc p) OP-FUEL 0 0 0)
     (uc-row M (+ p 2) OP-LABEL head 0 0)
     (ir-bound M h 17 2 2 2) (= (gn-fnf M h FF-RTYPE) TY-I64)
     (= (gn-fnf M h FF-PT0) TY-STR) (= (gn-fnf M h (inc FF-PT0)) TY-I64)
     (let [hp (gn-fnf M h FF-SIR)]
      (sa-rows M hp h (gn-sir M (+ hp 2) IF-A) (gn-sir M (+ hp 10) IF-A) (gn-sir M (+ hp 14) IF-A) 0))
     (qb-labels M (gn-fnf M h FF-SIR) 17 0)
     (isf-stage M p h q n 0)
     (uc-row M (+ p (* n 6) 2) OP-LABEL q 0 0)
     (uc-row M (+ p (* n 6) 3) OP-RET 0 0 0)
     (uc-row M (+ p (* n 6) 4) OP-END f 0 0)
     (qb-labels M p (+ (* n 6) 5) 0)) n (isf-count M f (inc n))))
   (isf-count M f (inc n)))))
(defn- isf-admit [M :vector-i64 i :i64] :i64
 (if (or (<= i 1) (>= i (vector-at M MM-SIR-N)) (>= i MM-SIR-CAP)
  (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
  (not= (gn-g M gn-f-vmode) 0) (not= (gn-g M gn-f-ctx) 1)
  (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-dead) 0) (not= (gn-g M gn-f-h) 0)
  (not= (gn-g M gn-f-ns) 2) (not= (gn-g M gn-f-dp) 2)
  (not= (gn-g M gn-f-fb) 64) (not= (gn-g M gn-f-nsv) 2)
  (not= (gn-g M gn-f-out) 0) (not= (gn-sreg M 1) 19) (not= (gn-sreg M 2) 20)
  (< (gn-g M di-sites) 0) (>= (gn-g M di-sites) 64)
  (< (gn-g M di-used) 0) (> (gn-g M di-used) 12000)
  (< (vector-at M MM-CODE-N) 0) (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 160))) 0
  (let [f (gn-g M fr-owner)]
   (if (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
    (<= (vector-at M MM-FN-N) MM-FN-CAP)
    (= (gn-fnf M f FF-SIR) (dec i))) (isf-count M f 2) 0))))
(defn- isf-tests [M :vector-i64 E :vector-i64 p :i64 n :i64 j :i64] :vector-i64
 (if (= j n) M
  (let [m0 (-> M (gn-op-fuel) (gn-emit (enc-cmp-i 5 (gn-sir M (+ p 6 (* j 6)) IF-B))))
   mark (vector-assoc! E j (vector-at m0 MM-CODE-N))]
   (isf-tests (gn-emit m0 (enc-bcond (enc-cond-eq) 0)) E p n (inc j)))))
(defn- isf-eqs [M :vector-i64 E :vector-i64 n :i64 j :i64 target :i64] :vector-i64
 (if (= j n) M
  (isf-eqs (gn-dot-patch M (vector-at E j) target (enc-cond-eq)) E n (inc j) target)))
(defn- isf-emit [M :vector-i64 i :i64 n :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fn (vector-at M MM-FIX-N)
  G (vector-alloc 24) E (vector-alloc 8)
  m0 (-> M (gn-mov 0 19) (gn-mov 1 20)
   (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 n)) (gt-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 16 7 288)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)) (gt-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 296)) (gn-emit (gn-e-addsl 16 16 17 4))
   (gn-emit (enc-ldp 3 4 16 0)) (gn-emit (enc-cmp-r 1 4)))
  end (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-eq) 0)) (gt-cold G (enc-cond-hs))
   (gn-emit (enc-cmp-i 3 0)) (gt-cold G (enc-cond-lt))
   (gn-emit (enc-add-r 5 3 4)) (gn-emit (enc-cmp-r 5 3)) (gt-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 16 7 392)) (gn-emit (enc-cmp-r 5 16)) (gt-cold G 8)
   (gn-emit (enc-ldr 6 7 CTX-CODE-BASE)) (gn-emit (enc-add-r 5 6 3))
   (gn-emit (enc-cmp-r 5 6)) (gt-cold G (enc-cond-lo))
   (gn-emit (enc-add-r 17 5 1)) (gn-emit (enc-cmp-r 17 5)) (gt-cold G (enc-cond-lo))
   (gn-emit (gn-e-ldrb 5 5 1)) (gn-emit (enc-cmp-i 5 128)) (gt-cold G (enc-cond-hs)))
  join (vector-at m1 MM-CODE-N) m2 (gn-emit m1 (enc-b 0))
  zero (vector-at m2 MM-CODE-N) m3 (gn-mov-imm m2 5 0)
  tests (vector-at m3 MM-CODE-N) m4 (isf-tests m3 E (dec i) n 0)
  m5 (-> m4 (gn-mov-imm 0 0) (gn-epilogue) (gn-gs gn-f-dead 0))
  yes (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-mov-imm 0 1) (gn-epilogue) (gn-gs gn-f-dead 0))
  cold (vector-at m6 MM-CODE-N)
  m7 (-> m6 (gt-patch G 0 cold) (isf-eqs E n 0 yes)
   (gn-dot-patch end zero (enc-cond-eq)) (gn-put (+ MM-CODE-BASE join) (enc-b (- tests join))))]
  (if (= (vector-at m7 MM-ERR) 0)
   (-> m7 (gn-gs di-sites (inc (gn-g m7 di-sites)))
    (gn-gs di-used (+ (gn-g m7 di-used) (- (vector-at m7 MM-CODE-N) cn))))
   (-> m7 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fn)))))
(defn- isf-entry [M :vector-i64 i :i64] :vector-i64
 (let [n (isf-admit M i)] (if (> n 0) (isf-emit M i n) M)))

;; Bounded forward CFG, conservative alias-extended local ranges. No runtime emission.
(defn- la-bit [s :i64] :i64 (i64-shift-left 1 s))
(defn- la-at [X :vector-i64 k :i64] :i64 (gn-g X (+ gn-a-dv k)))
(defn- la-put [X :vector-i64 k :i64 v :i64] :vector-i64 (gn-gs X (+ gn-a-dv k) v))
(defn- la-touch [X :vector-i64 s :i64 j :i64] :vector-i64
 (let [old (la-at X s)]
  (la-put (la-put X s (if (or (= old 0) (< j old)) j old)) (+ 64 s) (gn-max j (la-at X (+ 64 s))))))
(defn- la-bits-touch [X :vector-i64 bits :i64 s :i64 ns :i64 j :i64] :vector-i64
 (if (> s ns) X (la-bits-touch (if (not= (bit-and bits (la-bit s)) 0) (la-touch X s j) X) bits (inc s) ns j)))
(defn- la-next [M :vector-i64 j :i64 end :i64] :i64
 (let [op (gn-op M j)]
  (cond (= op OP-BR) (gn-small-label M 1 (gn-sir M j IF-A) 0)
   (or (= op OP-RET) (= j end)) 0 :else (inc j))))
(defn- la-other [M :vector-i64 j :i64] :i64
 (if (or (= (gn-op M j) OP-BRZ) (= (gn-op M j) OP-BRNZ)) (gn-small-label M 1 (gn-sir M j IF-B) 0) 0))
(defn- la-row [M :vector-i64 j :i64 p :i64 end :i64 ns :i64 dp :i64] :bool
 (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
  d (gn-defd M j) lo (gn-rlo M j) hi (gn-rhi M j)]
  (and (or (> lo hi) (and (>= lo 0) (< hi dp))) (or (< d 0) (< d dp))
   (case op
    OP-CONST (and (>= a 0) (= c 0))
    OP-LGET (and (>= a 0) (> b 0) (<= b ns) (= c 0))
    OP-LSET (and (> a 0) (<= a ns) (>= b 0) (= c 0))
    OP-BIN (and (>= a 0) (< a BOP-F64-ADD) (>= b 0) (= c 0))
    OP-CMP (and (>= a 0) (<= a CC-GE) (>= b 0) (= c 0))
    OP-UN (and (>= a 0) (< a UOP-F64-NEG) (>= b 0) (= c 0))
    (OP-CALL OP-RT) (and (>= b 0) (>= c 0))
    OP-FUEL (and (= a 0) (= b 0) (= c 0))
    OP-LABEL (and (= b 0) (= c 0) (= (gn-small-label M 1 a 0) j))
    OP-BR (let [q (la-next M j end)] (and (= b 0) (= c 0) (> q j) (< q end) (> q p)))
    (OP-BRZ OP-BRNZ) (let [q (la-other M j)] (and (>= a 0) (= c 0) (> q j) (< q end) (> q p)))
    OP-RET (and (>= a 0) (= b 0) (= c 0))
    false))))
(defn- la-rows [M :vector-i64 j :i64 p :i64 end :i64 ns :i64 dp :i64] :bool
 (if (= j end) true (and (la-row M j p end ns dp) (la-rows M (inc j) p end ns dp))))
(defn- la-state [X :vector-i64 p :i64 j :i64 t :i64] :i64 (la-at X (+ 256 (+ (* (- j p) 7) t))))
(defn- la-read [M :vector-i64 X :vector-i64 p :i64 j :i64 t :i64 hi :i64 bits :i64] :i64
 (if (> t hi) bits (la-read M X p j (inc t) hi (bit-or bits (la-state X p j t)))))
(defn- la-all [X :vector-i64 p :i64 j :i64 t :i64 dp :i64 bits :i64] :i64
 (if (= t dp) bits (la-all X p j (inc t) dp (bit-or bits (la-state X p j t)))))
;; Treat every adjacent result/LSET as a potential early register write, even if gn-co would refuse it.
(defn- la-co [M :vector-i64 j :i64 end :i64] :i64
 (let [op (gn-op M j) d (gn-defd M j)]
  (if (and (< (inc j) end) (or (= op OP-BIN) (= op OP-CMP) (= op OP-UN) (= op OP-CALL) (= op OP-RT))
    (= (gn-op M (inc j)) OP-LSET) (= (gn-sir M (inc j) IF-B) d)) (gn-sir M (inc j) IF-A) 0)))
(defn- la-flow [X :vector-i64 p :i64 j :i64 q :i64 t :i64 dp :i64 d :i64 value :i64] :vector-i64
 (if (or (= q 0) (= t dp)) X
  (let [v (cond (= t d) value (and (>= d 0) (> t d)) (la-bit 49) :else (la-state X p j t))
   at (+ 256 (+ (* (- q p) 7) t))]
   (la-flow (la-put X at (bit-or (la-at X at) v)) p j q (inc t) dp d value))))
(defn- la-inputs [X :vector-i64 t :i64 dp :i64] :vector-i64
 (if (= t dp) X (la-inputs (la-put X (+ 263 t) (la-bit 49)) (inc t) dp)))
(defn- la-initialized [X :vector-i64 p :i64 j :i64 t :i64 hi :i64] :bool
 (if (> t hi) true (and (not= (la-state X p j t) 0) (= (bit-and (la-state X p j t) (la-bit 49)) 0) (la-initialized X p j (inc t) hi))))
(defn- la-analyze [M :vector-i64 X :vector-i64 p :i64 j :i64 end :i64 ns :i64 dp :i64] :vector-i64
 (if (= j end) X
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) d (gn-defd M j)
   bits (la-read M X p j (gn-rlo M j) (gn-rhi M j) 0)
   co (la-co M j end)
   write (if (= op OP-LSET) a co)
   Xcheck (if (la-initialized X p j (gn-rlo M j) (gn-rhi M j)) X (la-put X 0 1))
   X0 (la-bits-touch Xcheck (if (> write 0) (bit-or bits (la-all X p j 0 dp 0)) bits) 1 ns j)
   X1 (cond (= op OP-LGET) (la-touch X0 b j) (> write 0) (la-touch X0 write j) :else X0)
   X2 (if (= op OP-LSET) (la-put (la-put X1 (+ 128 a) (inc (la-at X1 (+ 128 a)))) (+ 192 a) j) X1)
   value (bit-or (cond (= op OP-LGET) (bit-or 1 (la-bit b)) (= op OP-CONST) 1 :else bits) (if (> co 0) (la-bit co) 0))
   X3 (la-flow X2 p j (la-next M j end) 0 dp d value)
   X4 (la-flow X3 p j (la-other M j) 0 dp d value)]
   (la-analyze M X4 p (inc j) end ns dp))))
;; Refuse edges bypassing the earliest possible write into its live interval.
;; An edge skipping the entire interval cannot reach any use of that local.
(defn- la-dom [M :vector-i64 j :i64 end :i64 first :i64 last :i64] :bool
 (if (>= j first) true
  (and (or (<= (la-next M j end) first) (> (la-next M j end) last))
       (or (<= (la-other M j) first) (> (la-other M j) last))
       (la-dom M (inc j) end first last))))
(defn- la-disjoint [X :vector-i64 s :i64 q :i64] :bool
 (or (= (la-at X q) 0) (< (la-at X (+ 64 s)) (la-at X q)) (< (la-at X (+ 64 q)) (la-at X s))))
(defn- la-share-ok [M :vector-i64 X :vector-i64 s :i64 r :i64 q :i64 ns :i64 np :i64] :bool
 (if (> q ns) true
  (and (or (not= (gn-sreg M q) r) (and (> q np) (la-disjoint X s q))) (la-share-ok M X s r (inc q) ns np))))
(defn- la-home [M :vector-i64 X :vector-i64 s :i64 r :i64 ns :i64 np :i64] :i64
 (cond (> r 28) -1 (la-share-ok M X s r 1 ns np) r :else (la-home M X s (inc r) ns np)))
(defn- la-promote [M :vector-i64 X :vector-i64 p :i64 end :i64 s :i64 ns :i64 np :i64] :vector-i64
 (if (> s ns) M
  (let [def (la-at X (+ 192 s))
   eligible (and (< (gn-sreg M s) 0) (= (la-at X (+ 128 s)) 1) (> def p)
    (or (>= (la-at X s) def)
     (and (= (la-at X s) (dec def)) (= (la-co M (dec def) end) s)
      (= (bit-and (la-all X p (dec def) 0 (gn-g M gn-f-dp) 0) (la-bit s)) 0))) (la-dom M (inc p) end (la-at X s) (la-at X (+ 64 s))))
   r (if eligible (la-home M X s 19 ns np) -1)]
   (la-promote (if (>= r 19) (gn-gs M (+ gn-a-sreg s) (inc r)) M) X p end (inc s) ns np))))
(defn- la-layout [M :vector-i64 k :i64 ns :i64] :bool
 (if (> k ns) true (and (or (< (gn-sreg M k) 0) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28))) (la-layout M (inc k) ns))))
(defn- la-idle [M :vector-i64 k :i64 dp :i64] :bool
 (if (= k dp) true (and (= (gn-dk M k) 0) (la-idle M (inc k) dp))))
(defn- la-entry [M :vector-i64 p :i64 f :i64 np :i64] :vector-i64
 (let [ns (gn-g M gn-f-ns) dp (gn-g M gn-f-dp)]
  (if (and (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-nsv) 10)
   (>= ns 16) (<= ns 48) (> dp 0) (<= dp 7) (> np 0) (<= np 7) (<= np ns)
   (la-layout M 1 ns) (la-idle M 0 dp)
   (> p 0) (< p (vector-at M MM-SIR-N)) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
   (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) np)
   (> f 0) (< f (vector-at M MM-FN-N)) (<= (vector-at M MM-FN-N) MM-FN-CAP)
   (= (gn-fnf M f FF-SIR) p) (not (gn-clamp-open M f)))
   (let [end (gn-small-end M (inc p) f 512)]
    (if (and (> end p) (<= (- end p) 512) (la-rows M (inc p) p end ns dp))
     (let [X (la-analyze M (la-inputs (gn-zero M gn-a-dv (+ gn-a-dv (+ 256 (* (inc (- end p)) 7)))) 0 dp) p (inc p) end ns dp)]
      (if (= (la-at X 0) 0) (la-promote X X p end (inc np) ns np) M)) M)) M)))

;; Closed zero-base constant fill, post-paid private entry and exact original cold body.
(defn- zf-row [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
  join (gn-sir M (+ p 8) IF-A) n (gn-sir M (+ p 4) IF-B)
  value (gn-sir M (+ p 12) IF-B) writer (gn-sir M (+ p 13) IF-A)]
  (case k
   0 (uc-row M p OP-FN f 2 2)
   1 (uc-row M (+ p 1) OP-FUEL 0 0 0)
   2 (uc-row M (+ p 2) OP-LABEL head 0 0)
   3 (uc-row M (+ p 3) OP-LGET 0 2 0)
   4 (uc-row M (+ p 4) OP-CONST 1 n 0)
   5 (uc-row M (+ p 5) OP-CMP CC-EQ 0 0)
   6 (uc-row M (+ p 6) OP-BRZ 0 body 0)
   7 (uc-row M (+ p 7) OP-LGET 0 1 0)
   8 (uc-row M (+ p 8) OP-BR join 0 0)
   9 (uc-row M (+ p 9) OP-LABEL body 0 0)
   10 (uc-row M (+ p 10) OP-LGET 0 1 0)
   11 (uc-row M (+ p 11) OP-LGET 1 2 0)
   12 (uc-row M (+ p 12) OP-CONST 2 value 0)
   13 (uc-row M (+ p 13) OP-CALL writer 0 3)
   14 (uc-row M (+ p 14) OP-LGET 1 2 0)
   15 (uc-row M (+ p 15) OP-CONST 2 1 0)
   16 (uc-row M (+ p 16) OP-BIN BOP-ADD 1 0)
   17 (uc-row M (+ p 17) OP-LSET 1 0 0)
   18 (uc-row M (+ p 18) OP-LSET 2 1 0)
   19 (uc-row M (+ p 19) OP-FUEL 0 0 0)
   20 (uc-row M (+ p 20) OP-BR head 0 0)
   21 (uc-row M (+ p 21) OP-LABEL join 0 0)
   22 (uc-row M (+ p 22) OP-RET 0 0 0)
   23 (uc-row M (+ p 23) OP-END f 0 0)
   false)))
(defn- zf-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 24) true (and (zf-row M p f k) (zf-rows M p f (inc k)))))
(defn- zf-admit [M :vector-i64 i :i64] :bool
 (and (> i 1) (< i (vector-at M MM-SIR-N)) (< i MM-SIR-CAP)
  (>= (vector-at M MM-SIR-N) 24) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (= (gn-op M (dec i)) OP-FN) (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
  (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-out) 0)
  (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
  (= (gn-g M gn-f-ns) 2) (= (gn-g M gn-f-dp) 3)
  (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
  (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1)
  (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0)
  (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 96))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (let [f (gn-g M fr-owner) p (dec i)]
   (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
    (not (gn-clamp-open M f)) (= (gn-fnf M f FF-SIR) p)
    (<= p (- (vector-at M MM-SIR-N) 24))
    (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
    (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-FUEL) 1)
    (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (let [n (gn-sir M (+ p 4) IF-B) writer (gn-sir M (+ p 13) IF-A)]
     (and (>= n 1) (<= n 4095) (not= writer f) (fc-writer M writer)
      (qb-labels M (gn-fnf M writer FF-SIR) 9 0)
      (= (gn-call-wrapper M (+ p 13) writer 0 3) (+ RT-VECTOR-ASSOC-IN-PLACE 256))
      (zf-rows M p f 0) (qb-labels M p 24 0)))))))
(defn- zf-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) n (gn-sir M (+ p 4) IF-B) value (gn-sir M (+ p 12) IF-B)
  m0 (gn-emit M (enc-cmp-i 1 n)) empty (vector-at m0 MM-CODE-N)
  m1 (gn-emit m0 (enc-bcond (enc-cond-eq) 0)) order (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 5 7 312)) (gn-emit (enc-ldr 5 5 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 5)))
  handle (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-bcond (enc-cond-hs) 0))
  m4 (-> m3 (gn-emit (enc-ldr 4 7 320)) (gn-emit (gn-e-addsl 4 4 17 4))
   (gn-emit (enc-ldp 17 6 4 0)) (gn-mov-imm 16 (dec n)) (gn-emit (enc-cmp-r 16 6)))
  bounds (vector-at m4 MM-CODE-N) m5 (gn-emit m4 (enc-bcond (enc-cond-hs) 0))
  m6 (-> m5 (gn-emit (enc-add-r 16 17 16)) (gn-emit (enc-cmp-r 16 17)))
  wrapidx (vector-at m6 MM-CODE-N) m7 (gn-emit m6 (enc-bcond (enc-cond-lo) 0))
  m8 (gn-emit m7 (gn-e-lsr 6 16 61)) scale (vector-at m8 MM-CODE-N)
  m9 (gn-emit m8 (enc-cbnz 6 0))
  m10 (-> m9 (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 16 4 16 3)) (gn-emit (enc-cmp-r 16 4)))
  wrapptr (vector-at m10 MM-CODE-N) m11 (gn-emit m10 (enc-bcond (enc-cond-lo) 0))
  m12 (-> m11 (gn-mov-imm 5 n) (gn-emit (enc-sub-r 5 5 1))
   (gn-emit (enc-add-r 16 5 5)) (gn-emit (enc-cmp-r 8 16)))
  fuel (vector-at m12 MM-CODE-N) m13 (gn-emit m12 (enc-bcond (enc-cond-lo) 0))
  m14 (-> m13 (gn-emit (enc-sub-r 8 8 16))
   (gn-emit (gn-e-addsl 4 4 17 3)) (gn-emit (gn-e-addsl 4 4 1 3)) (gn-mov-imm 16 value))
  u0 (gn-emit m14 (enc-cmp-i 5 8)) small8 (vector-at u0 MM-CODE-N)
  u1 (gn-emit u0 (enc-bcond (enc-cond-lo) 0)) loop8 (vector-at u1 MM-CODE-N)
  u2 (-> u1 (gn-emit (enc-stp-post 16 16 4 16)) (gn-emit (enc-stp-post 16 16 4 16))
   (gn-emit (enc-stp-post 16 16 4 16)) (gn-emit (enc-stp-post 16 16 4 16))
   (gn-emit (enc-sub-i 5 5 8)) (gn-emit (enc-cmp-i 5 8)))
  back8 (vector-at u2 MM-CODE-N) u3 (gn-emit u2 (enc-bcond (enc-cond-hs) (- loop8 back8)))
  paircheck (vector-at u3 MM-CODE-N) u4 (gn-emit u3 (enc-cmp-i 5 2)) small2 (vector-at u4 MM-CODE-N)
  u5 (gn-emit u4 (enc-bcond (enc-cond-lo) 0)) loop2 (vector-at u5 MM-CODE-N)
  u6 (-> u5 (gn-emit (enc-stp-post 16 16 4 16)) (gn-emit (enc-sub-i 5 5 2)) (gn-emit (enc-cmp-i 5 2)))
  back2 (vector-at u6 MM-CODE-N) u7 (gn-emit u6 (enc-bcond (enc-cond-hs) (- loop2 back2)))
  tail (vector-at u7 MM-CODE-N) u8 (gn-emit u7 (enc-cbz 5 0))
  u9 (gn-emit u8 (enc-str 16 4 0)) done (vector-at u9 MM-CODE-N)
  u10 (gn-mov-imm u9 1 n) yes (vector-at u10 MM-CODE-N)
  u11 (gn-epilogue u10) cold (vector-at u11 MM-CODE-N)]
  (-> u11 (gn-dot-patch empty yes (enc-cond-eq)) (gn-dot-patch order cold (enc-cond-hs))
   (gn-dot-patch handle cold (enc-cond-hs)) (gn-dot-patch bounds cold (enc-cond-hs))
   (gn-dot-patch wrapidx cold (enc-cond-lo)) (gn-put (+ MM-CODE-BASE scale) (enc-cbnz 6 (- cold scale)))
   (gn-dot-patch wrapptr cold (enc-cond-lo)) (gn-dot-patch fuel cold (enc-cond-lo))
   (gn-dot-patch small8 paircheck (enc-cond-lo)) (gn-dot-patch small2 tail (enc-cond-lo))
   (gn-put (+ MM-CODE-BASE tail) (enc-cbz 5 (- done tail))))))
(defn- zf-entry [M :vector-i64 i :i64] :vector-i64
 (if (zf-admit M i)
  (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
   final (zf-emit M i)]
   (if (= (vector-at final MM-ERR) 0) (gn-gs final gn-f-dead dead)
    (-> final (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))) M))

;; Generic four contiguous full-i64 lane assembly after original private entry charge.
(defn- wa-row [M :vector-i64 p :i64 f :i64 stride :i64 s1 :i64 s2 :i64 s3 :i64 k :i64] :bool
 (if (= k 38) true
  (and (case k
    0 (uc-row M (+ p 0) OP-FN f 3 4)
    1 (uc-row M (+ p 1) OP-FUEL 0 0 0)
    2 (uc-row M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    3 (uc-row M (+ p 3) OP-LGET 0 2 0)
    4 (uc-row M (+ p 4) OP-LGET 1 3 0)
    5 (uc-row M (+ p 5) OP-CONST 2 stride 0)
    6 (uc-row M (+ p 6) OP-BIN BOP-MUL 1 0)
    7 (uc-row M (+ p 7) OP-BIN BOP-ADD 0 0)
    8 (uc-row M (+ p 8) OP-LSET 4 0 0)
    9 (uc-row M (+ p 9) OP-LGET 0 1 0)
    10 (uc-row M (+ p 10) OP-LGET 1 4 0)
    11 (uc-row M (+ p 11) OP-RT 176 0 2)
    12 (uc-row M (+ p 12) OP-LGET 1 1 0)
    13 (uc-row M (+ p 13) OP-LGET 2 4 0)
    14 (uc-row M (+ p 14) OP-CONST 3 1 0)
    15 (uc-row M (+ p 15) OP-BIN BOP-ADD 2 0)
    16 (uc-row M (+ p 16) OP-RT 176 1 2)
    17 (uc-row M (+ p 17) OP-CONST 2 s1 0)
    18 (uc-row M (+ p 18) OP-BIN BOP-SHL 1 0)
    19 (uc-row M (+ p 19) OP-BIN BOP-ADD 0 0)
    20 (uc-row M (+ p 20) OP-LGET 1 1 0)
    21 (uc-row M (+ p 21) OP-LGET 2 4 0)
    22 (uc-row M (+ p 22) OP-CONST 3 2 0)
    23 (uc-row M (+ p 23) OP-BIN BOP-ADD 2 0)
    24 (uc-row M (+ p 24) OP-RT 176 1 2)
    25 (uc-row M (+ p 25) OP-CONST 2 s2 0)
    26 (uc-row M (+ p 26) OP-BIN BOP-SHL 1 0)
    27 (uc-row M (+ p 27) OP-BIN BOP-ADD 0 0)
    28 (uc-row M (+ p 28) OP-LGET 1 1 0)
    29 (uc-row M (+ p 29) OP-LGET 2 4 0)
    30 (uc-row M (+ p 30) OP-CONST 3 3 0)
    31 (uc-row M (+ p 31) OP-BIN BOP-ADD 2 0)
    32 (uc-row M (+ p 32) OP-RT 176 1 2)
    33 (uc-row M (+ p 33) OP-CONST 2 s3 0)
    34 (uc-row M (+ p 34) OP-BIN BOP-SHL 1 0)
    35 (uc-row M (+ p 35) OP-BIN BOP-ADD 0 0)
    36 (uc-row M (+ p 36) OP-RET 0 0 0)
    37 (uc-row M (+ p 37) OP-END f 0 0)
    false) (wa-row M p f stride s1 s2 s3 (inc k)))))
(defn- wa-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (>= i MM-SIR-CAP) (>= i (vector-at M MM-SIR-N)) (not= (gn-op M (dec i)) OP-FN)) false
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (qb-bound M f 38 3 4 4 1) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 3)
    (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
    (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-nsv) 0)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
    (= (gn-g M gn-f-ns) 4) (= (gn-g M gn-f-dp) 4)
    (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
    (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2)
    (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0)
    (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 80))
    (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
    (let [stride (gn-sir M (+ p 5) IF-B) s1 (gn-sir M (+ p 17) IF-B)
          s2 (gn-sir M (+ p 25) IF-B) s3 (gn-sir M (+ p 33) IF-B)]
     (and (>= stride 1) (<= stride 4095) (>= s1 0) (<= s1 63)
      (>= s2 0) (<= s2 63) (>= s3 0) (<= s3 63)
      (wa-row M p f stride s1 s2 s3 0) (qb-labels M p 38 0)))))))
(defn- wa-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) stride (gn-sir M (+ p 5) IF-B)
  s1 (gn-sir M (+ p 17) IF-B) s2 (gn-sir M (+ p 25) IF-B) s3 (gn-sir M (+ p 33) IF-B)
  m0 (-> M (gn-emit (enc-orr-r 16 1 2)) (gn-emit (gn-e-lsr 16 16 31)))
  width (vector-at m0 MM-CODE-N) m1 (gn-emit m0 (enc-cbnz 16 0))
  m2 (-> m1 (gn-mov-imm 17 stride) (gn-emit (enc-mul 9 2 17))
   (gn-emit (enc-add-r 9 1 9)) (gn-emit (enc-add-i 10 9 3))
   (gn-emit (enc-ldr 11 7 312)) (gn-emit (enc-ldr 11 11 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 11)))
  handle (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-bcond (enc-cond-hs) 0))
  m4 (-> m3 (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 11 11 17 4))
   (gn-emit (enc-ldp 17 11 11 0)) (gn-emit (enc-cmp-r 10 11)))
  bounds (vector-at m4 MM-CODE-N) m5 (gn-emit m4 (enc-bcond (enc-cond-hs) 0))
  m6 (-> m5 (gn-emit (enc-add-r 10 17 10)) (gn-emit (enc-cmp-r 10 17)))
  wrapidx (vector-at m6 MM-CODE-N) m7 (gn-emit m6 (enc-bcond (enc-cond-lo) 0))
  m8 (gn-emit m7 (gn-e-lsr 11 10 61))
  scale (vector-at m8 MM-CODE-N) m9 (gn-emit m8 (enc-cbnz 11 0))
  m10 (-> m9 (gn-emit (enc-ldr 12 7 328)) (gn-emit (gn-e-addsl 10 12 10 3))
   (gn-emit (enc-cmp-r 10 12)))
  ptrwrap (vector-at m10 MM-CODE-N) m11 (gn-emit m10 (enc-bcond (enc-cond-lo) 0))
  m12 (-> m11 (gn-emit (gn-e-addsl 12 12 17 3)) (gn-emit (gn-e-addsl 12 12 9 3))
   (gn-emit (enc-ldr 13 12 0)) (gn-emit (enc-ldr 14 12 8))
   (gn-emit (gn-e-lsl 14 14 s1)) (gn-emit (enc-add-r 13 13 14))
   (gn-emit (enc-ldr 14 12 16)) (gn-emit (gn-e-lsl 14 14 s2)) (gn-emit (enc-add-r 13 13 14))
   (gn-emit (enc-ldr 14 12 24)) (gn-emit (gn-e-lsl 14 14 s3)) (gn-emit (enc-add-r 13 13 14))
   (gn-emit (enc-orr-r 0 31 13)) (gn-epilogue))
  cold (vector-at m12 MM-CODE-N)]
  (-> m12 (gn-put (+ MM-CODE-BASE width) (enc-cbnz 16 (- cold width)))
   (gn-dot-patch handle cold (enc-cond-hs)) (gn-dot-patch bounds cold (enc-cond-hs))
   (gn-dot-patch wrapidx cold (enc-cond-lo))
   (gn-put (+ MM-CODE-BASE scale) (enc-cbnz 11 (- cold scale)))
   (gn-dot-patch ptrwrap cold (enc-cond-lo)))))
(defn- wa-entry [M :vector-i64 i :i64] :vector-i64
 (if (wa-admit M i)
  (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
   final (wa-emit M i)]
   (if (= (vector-at final MM-ERR) 0) (gn-gs final gn-f-dead dead)
    (-> final (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))) M))

;; Generic charged double-mask dynamic left rotate; ordinary shared calls only.
(defn- lr-shape [M :vector-i64 f :i64] :bool
 (and (qb-bound M f 17 2 2 4 1) (qb-int-params M f 0 2)
  (let [p (gn-fnf M f FF-SIR) mask (gn-sir M (+ (gn-fnf M f FF-SIR) 4) IF-A)]
   (and (uc-row M p OP-FN f 2 2) (uc-row M (+ p 1) OP-FUEL 0 0 0)
    (uc-row M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    (uc-row M (+ p 3) OP-LGET 0 1 0) (uc-row M (+ p 4) OP-CALL mask 0 1)
    (uc-row M (+ p 5) OP-LGET 1 2 0) (uc-row M (+ p 6) OP-BIN BOP-SHL 0 0)
    (uc-row M (+ p 7) OP-LGET 1 1 0) (uc-row M (+ p 8) OP-CALL mask 1 1)
    (uc-row M (+ p 9) OP-CONST 2 32 0) (uc-row M (+ p 10) OP-LGET 3 2 0)
    (uc-row M (+ p 11) OP-BIN BOP-SUB 2 0) (uc-row M (+ p 12) OP-BIN BOP-USHR 1 0)
    (uc-row M (+ p 13) OP-BIN BOP-OR 0 0) (uc-row M (+ p 14) OP-CALL mask 0 1)
    (uc-row M (+ p 15) OP-RET 0 0 0) (uc-row M (+ p 16) OP-END f 0 0)
    (qb-labels M p 17 0) (rr-mask M mask) (qb-labels M (gn-fnf M mask FF-SIR) 7 0)))))
(defn- lr-safe [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :bool
 (and (= n 2) (>= t 0) (<= t 5) (= (gn-g M gn-f-h) (+ t 2))
  (>= (gn-g M gn-f-dp) (+ t 2)) (<= (gn-g M gn-f-dp) gn-cap)
  (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
  (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
  (> (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768)
  (= (vector-at M MM-ERR) 0) (> i 0) (< i (dec (vector-at M MM-SIR-N)))
  (> (vector-at M MM-SIR-N) 0) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (uc-row M i OP-CALL f t 2) (not= (gn-op M (inc i)) OP-RET) (not= (gn-op M (inc i)) OP-RES2)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 16))
  (>= (vector-at M MM-FIX-N) 0) (< (vector-at M MM-FIX-N) MM-FIX-CAP)
  (lr-shape M f)))
(defn- lr-transfer [M :vector-i64 f :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
  m0 (gn-emit M (enc-cmp-i 1 33))
  guard (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-op-fuel)
   (gn-emit (enc-sub-r 17 31 1)) (gn-emit (+ 0x1ac02c00 (i64-shift-left 17 16))))
  jump (vector-at m1 MM-CODE-N) m2 (gn-emit m1 (enc-b 0))
  cold (vector-at m2 MM-CODE-N) m3 (-> m2 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0)))
  end (vector-at m3 MM-CODE-N)
  final (-> m3 (gn-dot-patch guard cold (enc-cond-hs)) (gn-put (+ MM-CODE-BASE jump) (enc-b (- end jump))))]
  (if (= (vector-at final MM-ERR) 0) final
   (-> final (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))))

;; Closed packed mask-row proof: exact source shape, constants derived from current M.
(defn- pm-row [M :vector-i64 p :i64 f :i64 pred :i64 reserved :i64 rem :i64 weight :i64 writer :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 4 5)
  1 (uc-row M (+ p 1) 18 0 0 0)
  2 (uc-row M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (uc-row M (+ p 3) 4 0 3 0)
  4 (uc-row M (+ p 4) 3 1 (gn-sir M (+ p 4) IF-B) 0)
  5 (uc-row M (+ p 5) 7 1 0 0)
  6 (uc-row M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
  7 (uc-row M (+ p 7) 4 0 1 0)
  8 (uc-row M (+ p 8) 10 (gn-sir M (+ p 60) IF-A) 0 0)
  9 (uc-row M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (uc-row M (+ p 10) 4 0 2 0)
  11 (uc-row M (+ p 11) 4 1 3 0)
  12 (uc-row M (+ p 12) 4 2 4 0)
  13 (uc-row M (+ p 13) 13 pred 0 3)
  14 (uc-row M (+ p 14) 11 0 (gn-sir M (+ p 20) IF-A) 0)
  15 (uc-row M (+ p 15) 4 0 1 0)
  16 (uc-row M (+ p 16) 4 1 3 0)
  17 (uc-row M (+ p 17) 4 2 4 0)
  18 (uc-row M (+ p 18) 13 reserved 0 3)
  19 (uc-row M (+ p 19) 8 1 0 0)
  20 (uc-row M (+ p 20) 9 (gn-sir M (+ p 20) IF-A) 0 0)
  21 (uc-row M (+ p 21) 11 0 (gn-sir M (+ p 44) IF-A) 0)
  22 (uc-row M (+ p 22) 3 0 (gn-sir M (+ p 22) IF-B) 0)
  23 (uc-row M (+ p 23) 4 1 3 0)
  24 (uc-row M (+ p 24) 3 2 8 0)
  25 (uc-row M (+ p 25) 6 4 1 0)
  26 (uc-row M (+ p 26) 6 1 0 0)
  27 (uc-row M (+ p 27) 4 1 4 0)
  28 (uc-row M (+ p 28) 3 2 (gn-sir M (+ p 28) IF-B) 0)
  29 (uc-row M (+ p 29) 6 3 1 0)
  30 (uc-row M (+ p 30) 6 1 0 0)
  31 (uc-row M (+ p 31) 5 5 0 0)
  32 (uc-row M (+ p 32) 4 0 1 0)
  33 (uc-row M (+ p 33) 4 1 5 0)
  34 (uc-row M (+ p 34) 4 2 1 0)
  35 (uc-row M (+ p 35) 4 3 5 0)
  36 (uc-row M (+ p 36) 14 176 2 2)
  37 (uc-row M (+ p 37) 4 3 3 0)
  38 (uc-row M (+ p 38) 3 4 8 0)
  39 (uc-row M (+ p 39) 13 rem 3 2)
  40 (uc-row M (+ p 40) 13 weight 3 1)
  41 (uc-row M (+ p 41) 6 7 2 0)
  42 (uc-row M (+ p 42) 13 writer 0 3)
  43 (uc-row M (+ p 43) 10 (gn-sir M (+ p 46) IF-A) 0 0)
  44 (uc-row M (+ p 44) 9 (gn-sir M (+ p 44) IF-A) 0 0)
  45 (uc-row M (+ p 45) 4 0 1 0)
  46 (uc-row M (+ p 46) 9 (gn-sir M (+ p 46) IF-A) 0 0)
  47 (uc-row M (+ p 47) 5 5 0 0)
  48 (uc-row M (+ p 48) 4 0 5 0)
  49 (uc-row M (+ p 49) 4 1 2 0)
  50 (uc-row M (+ p 50) 4 2 3 0)
  51 (uc-row M (+ p 51) 3 3 1 0)
  52 (uc-row M (+ p 52) 6 1 2 0)
  53 (uc-row M (+ p 53) 4 3 4 0)
  54 (uc-row M (+ p 54) 5 1 0 0)
  55 (uc-row M (+ p 55) 5 2 1 0)
  56 (uc-row M (+ p 56) 5 3 2 0)
  57 (uc-row M (+ p 57) 5 4 3 0)
  58 (uc-row M (+ p 58) 18 0 0 0)
  59 (uc-row M (+ p 59) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  60 (uc-row M (+ p 60) 9 (gn-sir M (+ p 60) IF-A) 0 0)
  61 (uc-row M (+ p 61) 19 0 0 0)
  62 (uc-row M (+ p 62) 2 f 0 0)
  false))
(defn- pm-rows [M :vector-i64 p :i64 f :i64 pred :i64 reserved :i64 rem :i64 weight :i64 writer :i64 k :i64] :bool
 (if (= k 63) true (and (pm-row M p f pred reserved rem weight writer k) (pm-rows M p f pred reserved rem weight writer (inc k)))))
(defn- pm-reserved-row [M :vector-i64 p :i64 f :i64 pred :i64 reserved :i64 rem :i64 weight :i64 writer :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 3 6)
  1 (uc-row M (+ p 1) 18 0 0 0)
  2 (uc-row M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (uc-row M (+ p 3) 4 0 2 0)
  4 (uc-row M (+ p 4) 4 1 3 0)
  5 (uc-row M (+ p 5) 7 3 0 0)
  6 (uc-row M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
  7 (uc-row M (+ p 7) 4 0 3 0)
  8 (uc-row M (+ p 8) 10 (gn-sir M (+ p 11) IF-A) 0 0)
  9 (uc-row M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (uc-row M (+ p 10) 4 0 2 0)
  11 (uc-row M (+ p 11) 9 (gn-sir M (+ p 11) IF-A) 0 0)
  12 (uc-row M (+ p 12) 5 4 0 0)
  13 (uc-row M (+ p 13) 4 0 2 0)
  14 (uc-row M (+ p 14) 4 1 3 0)
  15 (uc-row M (+ p 15) 7 3 0 0)
  16 (uc-row M (+ p 16) 11 0 (gn-sir M (+ p 19) IF-A) 0)
  17 (uc-row M (+ p 17) 4 0 2 0)
  18 (uc-row M (+ p 18) 10 (gn-sir M (+ p 21) IF-A) 0 0)
  19 (uc-row M (+ p 19) 9 (gn-sir M (+ p 19) IF-A) 0 0)
  20 (uc-row M (+ p 20) 4 0 3 0)
  21 (uc-row M (+ p 21) 9 (gn-sir M (+ p 21) IF-A) 0 0)
  22 (uc-row M (+ p 22) 5 5 0 0)
  23 (uc-row M (+ p 23) 4 0 5 0)
  24 (uc-row M (+ p 24) 4 1 5 0)
  25 (uc-row M (+ p 25) 6 3 0 0)
  26 (uc-row M (+ p 26) 4 1 5 0)
  27 (uc-row M (+ p 27) 6 1 0 0)
  28 (uc-row M (+ p 28) 3 1 2 0)
  29 (uc-row M (+ p 29) 6 4 0 0)
  30 (uc-row M (+ p 30) 4 1 4 0)
  31 (uc-row M (+ p 31) 6 1 0 0)
  32 (uc-row M (+ p 32) 5 6 0 0)
  33 (uc-row M (+ p 33) 4 0 1 0)
  34 (uc-row M (+ p 34) 3 1 (gn-sir M (+ p 34) IF-B) 0)
  35 (uc-row M (+ p 35) 4 2 6 0)
  36 (uc-row M (+ p 36) 3 3 8 0)
  37 (uc-row M (+ p 37) 6 4 2 0)
  38 (uc-row M (+ p 38) 6 1 1 0)
  39 (uc-row M (+ p 39) 14 176 0 2)
  40 (uc-row M (+ p 40) 4 1 6 0)
  41 (uc-row M (+ p 41) 3 2 8 0)
