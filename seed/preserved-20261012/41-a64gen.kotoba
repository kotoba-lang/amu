;; Installation only on first paid owner FUEL, before the unchanged normal label.
;; Backedges still target that original label, bypassing this one-time prefix.
(defn- btg-distinct [M :vector-i64 k :i64 j :i64] :bool
 (if (= j k) true
  (and (not= (gn-sreg M k) (gn-sreg M j)) (btg-distinct M k (inc j)))))
(defn- btg-homes [M :vector-i64 k :i64] :bool
 (if (= k 8) true
  (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
   (btg-distinct M k 1) (btg-homes M (inc k)))))
(defn- btg-admit [M :vector-i64 i :i64] :bool
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N) p (dec i)
  f (gn-g M fr-owner)]
  (if (or (< p 1) (< sn 88) (> sn MM-SIR-CAP) (> p (- sn 88))
   (<= f 0) (>= f fnn) (> fnn MM-FN-CAP)) false
   (and (= (vector-at M MM-ERR) 0) (= (gn-fnf M f FF-SIR) p)
    (uc-row M p OP-FN f 7 10) (uc-row M i OP-FUEL 0 0 0)
    (= (gn-op M (inc i)) OP-LABEL)
    (= (gn-g M gn-f-ns) 10) (= (gn-g M gn-f-dp) 8)
    (= (gn-g M gn-f-nsv) 10) (= (gn-g M gn-f-out) 0)
    (= (gn-g M gn-f-fb) (+ (gn-r16 (* 8 (+ (gn-g M gn-f-ns) (gn-g M gn-f-dp) 2)))
      (gn-r16 (* 8 (gn-g M gn-f-nsv))) (gn-g M gn-f-out)))
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-h) 0)
    (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-g M gn-f-ctx) 1)
    (>= (vector-at M MM-CODE-N) 0)
    (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 512))
    (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
    (btg-homes M 1) (btg-owner M f)))))
(defn- btg-entry [M :vector-i64 i :i64] :vector-i64
 (if (btg-admit M i)
  (btg-proto-emit M (gn-g M fr-owner)
   (gn-sreg M 1) (gn-sreg M 2) (gn-sreg M 3) (gn-sreg M 4)
   (gn-sreg M 5) (gn-sreg M 6) (gn-sreg M 7)) M))

;; UNHOOKED: exact typed73-row vector transition; no historical IDs dispatch.
(defn- nf-row [M :vector-i64 p :i64 f :i64 child :i64 count1 :i64 count2 :i64 add :i64 limit :i64 base :i64 k :i64] :bool
 (let [l2 (gn-sir M (+ p 2) IF-A) l40 (gn-sir M (+ p 40) IF-A)
  l68 (gn-sir M (+ p 68) IF-A) l64 (gn-sir M (+ p 64) IF-A)
  l65 (gn-sir M (+ p 66) IF-A) l70 (gn-sir M (+ p 70) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 f 7 9)
   1 (gn-dot-at? M (+ p 1) 18 0 0 0)
   2 (gn-dot-at? M (+ p 2) 9 l2 0 0)
