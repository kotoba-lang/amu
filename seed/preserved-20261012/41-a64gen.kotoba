   74 (gn-dot-at? M (+ p 74) 19 0 0 0)
   75 (gn-dot-at? M (+ p 75) 2 f 0 0)
   false)))
(defn- gi-rows [M :vector-i64 p :i64 f :i64 writer :i64 n :i64 stride :i64 off :i64 bias :i64 factor :i64 k :i64] :bool
 (if (= k 76) true (and (gi-row M p f writer n stride off bias factor k)
  (gi-rows M p f writer n stride off bias factor (inc k)))))
(defn- gi-home [M :vector-i64 k :i64] :bool
 (if (= k 7) true (and (= (gn-sreg M k) (dec k)) (gi-home M (inc k)))))
(defn- gi-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (> i (- MM-SIR-CAP 75))
  (> i (- (vector-at M MM-SIR-N) 75)) (not= (gn-op M (dec i)) OP-FN)) false
  (let [p (dec i) f (gn-sir M p IF-A) writer (gn-sir M (+ p 19) IF-A)
   n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 53) IF-B)
   off (gn-sir M (+ p 15) IF-B) bias (gn-sir M (+ p 36) IF-B) factor (gn-sir M (+ p 44) IF-B)]
   (and (ir-bound M f 76 4 6 5) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 4) (> n 0) (<= n 64) (> stride 0) (<= stride 65535)
    (>= off 0) (< off 2147483648)
    (= (gn-g M gn-f-ns) 6) (= (gn-g M gn-f-dp) 5)
    (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-vmode) 0)
    (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
    (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-out) 0)
    (= (gn-g M gn-f-fb) 0) (gi-home M 1)
    (ir-bound M writer 9 3 3 3) (pc3-helper-type M writer 3 TY-VEC)
    (pc3-writer-shape M (gn-fnf M writer FF-SIR) writer)
    (qb-labels M (gn-fnf M writer FF-SIR) 9 0)
    (gi-rows M p f writer n stride off bias factor 0) (qb-labels M p 76 0)
    (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 160))))))
;; Original entry already debits private x8. No shared CTX load/debit is added.
;; Runtime row/col/sum must be zero. Miss leaves all original incoming homes.
;; Scalar cell stores then row-sum store preserve even overlapping destinations.
(defn- gi-emit [M :vector-i64 i :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) p (dec i)
  n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 53) IF-B)
  off (gn-sir M (+ p 15) IF-B) bias (gn-sir M (+ p 36) IF-B)
  factor (gn-sir M (+ p 44) IF-B) G (vector-alloc 49)
  m0 (-> M (gn-emit (enc-cmp-i 1 0)) (gm-cold G (enc-cond-ne))
   (gn-emit (enc-cmp-i 2 0)) (gm-cold G (enc-cond-ne))
   (gn-emit (enc-cmp-i 3 0)) (gm-cold G (enc-cond-ne))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
   (gn-emit (enc-ldp 9 10 16 0))
   (gn-mov-imm 16 (+ (* (dec n) stride) (dec n)))
   (gn-emit (enc-cmp-r 16 10)) (gm-cold G (enc-cond-hs))
   (gn-mov-imm 16 (+ off (dec n))) (gn-emit (enc-cmp-r 16 10)) (gm-cold G (enc-cond-hs))
   (gn-mov-imm 16 (* 2 (+ (* n n) n))) (gn-emit (enc-cmp-r 8 16)) (gm-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 15 15 9 3))
   (gn-mov 13 15) (gn-mov-imm 16 off) (gn-emit (gn-e-addsl 14 15 16 3))
   (gn-mov-imm 6 (* stride 8)) (gn-mov-imm 9 0) (gn-mov-imm 10 0) (gn-mov-imm 11 0))
  head (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-add-r 12 9 10)) (gn-mov-imm 5 bias)
   (gn-emit (enc-add-r 12 12 5)) (gn-emit (enc-cmp-r 9 10))) diag (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-mov-imm 16 factor)
   (gn-emit (enc-mul 12 12 16))) store (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-str 12 13 0))
   (gn-emit (enc-add-r 11 11 12)) (gn-emit (enc-add-i 13 13 8))
   (gn-emit (enc-add-i 10 10 1)) (gn-emit (enc-sub-i 8 8 1))
   (gn-emit (enc-cmp-i 10 n))) cellback (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-ne) (- head cellback)))
   (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-str 11 14 0))
   (gn-emit (enc-add-i 9 9 1)) (gn-mov-imm 10 0) (gn-mov-imm 11 0)
   (gn-emit (enc-add-r 15 15 6)) (gn-mov 13 15)
   (gn-emit (enc-add-i 14 14 8)) (gn-emit (enc-sub-i 8 8 1))
   (gn-emit (enc-cmp-i 9 n))) rowback (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond (enc-cond-ne) (- head rowback)))
   (gn-mov-imm 1 n) (gn-mov-imm 2 0) (gn-mov-imm 3 0)
   (gn-dot-patch diag store (enc-cond-ne))) end (vector-at m5 MM-CODE-N)
  m6 (gm-patch m5 G 0 end)]
  (if (= (vector-at m6 MM-ERR) 0) m6
   (-> m6 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx)))))
(defn- gi-entry [M :vector-i64 i :i64] :vector-i64
 (if (gi-admit M i) (gi-emit M i) M))

;; Generic exact closed strided signed fill with sufficient-fuel bulk success.
(defn- bf-shape [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 32) true
  (let [f (gn-sir M p IF-A) head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B) join (gn-sir M (+ p 8) IF-A) n (gn-sir M (+ p 4) IF-B) child (gn-sir M (+ p 15) IF-A)]
   (and (case k
    0 (gn-dot-at? M p OP-FN f 5 5)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-BR join 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
    13 (gn-dot-at? M (+ p 13) OP-LGET 3 4 0)
    14 (gn-dot-at? M (+ p 14) OP-LGET 4 5 0)
    15 (gn-dot-at? M (+ p 15) OP-CALL child 0 5)
    16 (gn-dot-at? M (+ p 16) OP-LGET 1 2 0)
    17 (gn-dot-at? M (+ p 17) OP-LGET 2 3 0)
    18 (gn-dot-at? M (+ p 18) OP-LGET 3 4 0)
    19 (gn-dot-at? M (+ p 19) OP-CONST 4 1 0)
    20 (gn-dot-at? M (+ p 20) OP-BIN BOP-ADD 3 0)
    21 (gn-dot-at? M (+ p 21) OP-LGET 4 5 0)
    22 (gn-dot-at? M (+ p 22) OP-LSET 1 0 0)
    23 (gn-dot-at? M (+ p 23) OP-LSET 2 1 0)
    24 (gn-dot-at? M (+ p 24) OP-LSET 3 2 0)
    25 (gn-dot-at? M (+ p 25) OP-LSET 4 3 0)
    26 (gn-dot-at? M (+ p 26) OP-LSET 5 4 0)
    27 (gn-dot-at? M (+ p 27) OP-FUEL 0 0 0)
    28 (gn-dot-at? M (+ p 28) OP-BR head 0 0)
    29 (gn-dot-at? M (+ p 29) OP-LABEL join 0 0)
    30 (gn-dot-at? M (+ p 30) OP-RET 0 0 0)
    31 (gn-dot-at? M (+ p 31) OP-END f 0 0)
    false) (bf-shape M p (inc k))))))
(defn- bf-child-shape [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 14) true
  (let [f (gn-sir M p IF-A) lab (gn-sir M (+ p 2) IF-A) sign (gn-sir M (+ p 10) IF-A) writer (gn-sir M (+ p 11) IF-A)]
   (and (case k
    0 (gn-dot-at? M p OP-FN f 5 5)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL lab 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
    4 (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
    5 (gn-dot-at? M (+ p 5) OP-LGET 2 3 0)
    6 (gn-dot-at? M (+ p 6) OP-LGET 3 4 0)
    7 (gn-dot-at? M (+ p 7) OP-BIN BOP-MUL 2 0)
    8 (gn-dot-at? M (+ p 8) OP-BIN BOP-ADD 1 0)
    9 (gn-dot-at? M (+ p 9) OP-LGET 2 5 0)
    10 (gn-dot-at? M (+ p 10) OP-CALL sign 2 1)
    11 (gn-dot-at? M (+ p 11) OP-CALL writer 0 3)
    12 (gn-dot-at? M (+ p 12) OP-RET 0 0 0)
    13 (gn-dot-at? M (+ p 13) OP-END f 0 0)
    false) (bf-child-shape M p (inc k))))))
(defn- bf-child [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))) false
  (let [p (gn-fnf M f FF-SIR)]
   (if (or (< p 1) (> p (- MM-SIR-CAP 14)) (> p (- (vector-at M MM-SIR-N) 14))) false
    (let [sign (gn-sir M (+ p 10) IF-A) writer (gn-sir M (+ p 11) IF-A)]
     (and (ir-bound M f 14 5 5 4) (gn-dot-at? M p OP-FN f 5 5) (bf-child-shape M p 0)
      (= (gn-fnf M f FF-NPARAMS) 5) (= (gn-fnf M f FF-NSLOTS) 5)
      (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-RTYPE) TY-VEC)
      (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
      (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
      (sz-label M (gn-sir M (+ p 2) IF-A) (+ p 2))
      (> sign 0) (< sign MM-FN-CAP) (< sign (vector-at M MM-FN-N))
      (> writer 0) (< writer MM-FN-CAP) (< writer (vector-at M MM-FN-N))
      (>= (gn-fnf M sign FF-SIR) 1)
      (<= (gn-fnf M sign FF-SIR) (- MM-SIR-CAP 20))
      (<= (gn-fnf M sign FF-SIR) (- (vector-at M MM-SIR-N) 20))
      (>= (gn-fnf M writer FF-SIR) 1)
      (<= (gn-fnf M writer FF-SIR) (- MM-SIR-CAP 12))
      (<= (gn-fnf M writer FF-SIR) (- (vector-at M MM-SIR-N) 12))
      (not (gn-clamp-open M sign))
      (= (gn-fnf M sign FF-NPARAMS) 1) (= (gn-fnf M sign FF-NSLOTS) 2)
      (= (gn-fnf M sign FF-DEPTH) 2) (= (gn-fnf M sign FF-FUEL) 0)
      (= (gn-fnf M sign FF-PT0) TY-I64) (= (gn-fnf M sign FF-RTYPE) TY-I64)
      (= (gn-sign-wrapper M sign 1) 1040)
      (gn-dot-at? M (+ (gn-fnf M sign FF-SIR) 18) OP-END sign 0 0)
      (qb-labels M (gn-fnf M sign FF-SIR) 19 0)
      (ir-bound M writer 9 3 3 3) (pc3-helper-type M writer 3 TY-VEC)
      (gn-dot-at? M (+ (gn-fnf M writer FF-SIR) 8) OP-END writer 0 0)
      (qb-labels M (gn-fnf M writer FF-SIR) 9 0)
      (qb-labels M p 14 0)
      (= (gn-wrapper M writer 0 3) (+ RT-VECTOR-ASSOC-IN-PLACE 256))))))))
(defn- bf-distinct [M :vector-i64 k :i64 j :i64] :bool
 (if (= j k) true (and (not= (gn-sreg M k) (gn-sreg M j)) (bf-distinct M k (inc j)))))
(defn- bf-homes [M :vector-i64 k :i64] :bool
 (if (= k 6) true (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
  (bf-distinct M k 1) (bf-homes M (inc k)))))
(defn- bf-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (> i (- MM-SIR-CAP 31))
  (> i (- (vector-at M MM-SIR-N) 31)) (not= (gn-op M (dec i)) OP-FN)) false
  (let [p (dec i) f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B)]
   (and (ir-bound M f 32 5 5 5) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 5) (>= n 1) (<= n 4095)
    (= (gn-g M gn-f-ns) 5) (= (gn-g M gn-f-dp) 5)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ctx) 1)
    (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-g M gn-f-nsv) 5) (= (gn-g M gn-f-out) 0)
    (>= (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768)
    (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 128))
    (bf-homes M 1) (bf-shape M p 0) (bf-child M (gn-sir M (+ p 15) IF-A))
    (qb-labels M p 32 0)))))
;; Entry is paid. Guarded successful region consumes exactly3N: child entry1,
;; natural writer1, recurrence1 including last. All trap cuts retain old body.
;; Success intermediate CTX publications differ only in this certified closed,
;; synchronous nontrapping region; ordered scalar stores remain fresh.
(defn- bf-emit [M :vector-i64 i :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N)
  n (gn-sir M (+ i 3) IF-B) vh (gn-sreg M 1) bh (gn-sreg M 2)
  dh (gn-sreg M 3) kh (gn-sreg M 4) xh (gn-sreg M 5) G (vector-alloc 49)
  m0 (-> M (gn-emit (enc-cmp-i kh n)) (gm-cold G (enc-cond-hs))
   (gn-mov-imm 16 2147483648) (gm-limit G bh) (gm-limit G dh)
   (gn-emit (enc-cmp-i dh 0)) (gm-cold G (enc-cond-eq))
   (gn-mov-imm 16 (dec n)) (gn-emit (enc-mul 16 dh 16))
   (gn-emit (enc-add-r 16 bh 16))
   (gn-emit (enc-ldr 4 7 312)) (gn-emit (enc-ldr 4 4 0))
   (gn-emit (enc-sub-i 17 vh 1)) (gn-emit (enc-cmp-r 17 4)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 4 7 320)) (gn-emit (gn-e-addsl 4 4 17 4))
   (gn-emit (enc-ldp 17 4 4 0)) (gn-emit (enc-cmp-r 16 4)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 5 7 328)) (gn-emit (gn-e-addsl 5 5 17 3))
   (gn-emit (enc-mul 4 dh kh)) (gn-emit (enc-add-r 4 bh 4))
   (gn-emit (gn-e-addsl 5 5 4 3)) (gn-emit (gn-e-lsl 6 dh 3))
   (gn-mov-imm 4 n) (gn-emit (enc-sub-r 4 4 kh))
   (gn-emit (enc-add-r 16 4 4)) (gn-emit (enc-add-r 16 16 4))
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 16)) (gm-cold G (enc-cond-lo))
   (gn-emit (enc-sub-r 8 8 16)) (gn-emit (gn-e-bf 0x93400000 17 xh 0 15)))
  head (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-str 17 5 0)) (gn-emit (enc-add-r 5 5 6))
   (gn-emit (enc-subs-i 4 4 1))) back (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) (- head back)))
   (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov-imm kh n))
  end (vector-at m2 MM-CODE-N) m3 (gm-patch m2 G 0 end)]
  (if (= (vector-at m3 MM-ERR) 0) m3
   (-> m3 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx)))))
(defn- bf-entry [M :vector-i64 i :i64] :vector-i64
 (if (bf-admit M i) (bf-emit M i) M))

;; Closed affine + offset direct-read reductions; current-M constants only.
(defn- ao-forward-row [M :vector-i64 p :i64 f :i64 reader :i64 offset :i64 limit :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B) end (gn-sir M (+ p 8) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 f 4 4)
   1 (gn-dot-at? M (+ p 1) 18 0 0 0)
   2 (gn-dot-at? M (+ p 2) 9 head 0 0)
   3 (gn-dot-at? M (+ p 3) 4 0 3 0)
   4 (gn-dot-at? M (+ p 4) 4 1 2 0)
   5 (gn-dot-at? M (+ p 5) 7 1 0 0)
   6 (gn-dot-at? M (+ p 6) 11 0 body 0)
   7 (gn-dot-at? M (+ p 7) 4 0 4 0)
   8 (gn-dot-at? M (+ p 8) 10 end 0 0)
   9 (gn-dot-at? M (+ p 9) 9 body 0 0)
   10 (gn-dot-at? M (+ p 10) 4 0 1 0)
   11 (gn-dot-at? M (+ p 11) 4 1 2 0)
   12 (gn-dot-at? M (+ p 12) 4 2 3 0)
   13 (gn-dot-at? M (+ p 13) 3 3 1 0)
   14 (gn-dot-at? M (+ p 14) 6 1 2 0)
   15 (gn-dot-at? M (+ p 15) 4 3 4 0)
   16 (gn-dot-at? M (+ p 16) 4 4 1 0)
   17 (gn-dot-at? M (+ p 17) 4 5 2 0)
   18 (gn-dot-at? M (+ p 18) 4 6 3 0)
   19 (gn-dot-at? M (+ p 19) 13 reader 4 3)
   20 (gn-dot-at? M (+ p 20) 4 5 1 0)
   21 (gn-dot-at? M (+ p 21) 3 6 offset 0)
   22 (gn-dot-at? M (+ p 22) 4 7 3 0)
   23 (gn-dot-at? M (+ p 23) 6 1 6 0)
   24 (gn-dot-at? M (+ p 24) 14 176 5 2)
   25 (gn-dot-at? M (+ p 25) 6 3 4 0)
   26 (gn-dot-at? M (+ p 26) 6 2 3 0)
   27 (gn-dot-at? M (+ p 27) 5 1 0 0)
   28 (gn-dot-at? M (+ p 28) 5 2 1 0)
   29 (gn-dot-at? M (+ p 29) 5 3 2 0)
   30 (gn-dot-at? M (+ p 30) 5 4 3 0)
   31 (gn-dot-at? M (+ p 31) 18 0 0 0)
   32 (gn-dot-at? M (+ p 32) 10 head 0 0)
   33 (gn-dot-at? M (+ p 33) 9 end 0 0)
   34 (gn-dot-at? M (+ p 34) 19 0 0 0)
   35 (gn-dot-at? M (+ p 35) 2 f 0 0)
   false)))
(defn- ao-backward-row [M :vector-i64 p :i64 f :i64 reader :i64 offset :i64 limit :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B) end (gn-sir M (+ p 8) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 f 4 4)
   1 (gn-dot-at? M (+ p 1) 18 0 0 0)
   2 (gn-dot-at? M (+ p 2) 9 head 0 0)
   3 (gn-dot-at? M (+ p 3) 4 0 3 0)
   4 (gn-dot-at? M (+ p 4) 3 1 limit 0)
   5 (gn-dot-at? M (+ p 5) 7 1 0 0)
   6 (gn-dot-at? M (+ p 6) 11 0 body 0)
   7 (gn-dot-at? M (+ p 7) 4 0 4 0)
   8 (gn-dot-at? M (+ p 8) 10 end 0 0)
   9 (gn-dot-at? M (+ p 9) 9 body 0 0)
   10 (gn-dot-at? M (+ p 10) 4 0 1 0)
   11 (gn-dot-at? M (+ p 11) 4 1 2 0)
   12 (gn-dot-at? M (+ p 12) 4 2 3 0)
   13 (gn-dot-at? M (+ p 13) 3 3 1 0)
   14 (gn-dot-at? M (+ p 14) 6 1 2 0)
   15 (gn-dot-at? M (+ p 15) 4 3 4 0)
   16 (gn-dot-at? M (+ p 16) 4 4 1 0)
   17 (gn-dot-at? M (+ p 17) 4 5 2 0)
   18 (gn-dot-at? M (+ p 18) 4 6 3 0)
   19 (gn-dot-at? M (+ p 19) 13 reader 4 3)
   20 (gn-dot-at? M (+ p 20) 4 5 1 0)
   21 (gn-dot-at? M (+ p 21) 3 6 offset 0)
   22 (gn-dot-at? M (+ p 22) 4 7 3 0)
   23 (gn-dot-at? M (+ p 23) 6 1 6 0)
   24 (gn-dot-at? M (+ p 24) 14 176 5 2)
   25 (gn-dot-at? M (+ p 25) 6 3 4 0)
   26 (gn-dot-at? M (+ p 26) 6 2 3 0)
   27 (gn-dot-at? M (+ p 27) 5 1 0 0)
   28 (gn-dot-at? M (+ p 28) 5 2 1 0)
   29 (gn-dot-at? M (+ p 29) 5 3 2 0)
   30 (gn-dot-at? M (+ p 30) 5 4 3 0)
   31 (gn-dot-at? M (+ p 31) 18 0 0 0)
   32 (gn-dot-at? M (+ p 32) 10 head 0 0)
   33 (gn-dot-at? M (+ p 33) 9 end 0 0)
   34 (gn-dot-at? M (+ p 34) 19 0 0 0)
   35 (gn-dot-at? M (+ p 35) 2 f 0 0)
   false)))
(defn- ao-rows [M :vector-i64 p :i64 f :i64 reader :i64 offset :i64 limit :i64 fixed :bool k :i64] :bool
 (if (= k 36) true (and (if fixed (ao-backward-row M p f reader offset limit k) (ao-forward-row M p f reader offset limit k))
  (ao-rows M p f reader offset limit fixed (inc k)))))
(defn- ao-distinct [M :vector-i64 k :i64 j :i64] :bool
 (if (= j k) true (and (not= (gn-sreg M k) (gn-sreg M j)) (ao-distinct M k (inc j)))))
(defn- ao-homes [M :vector-i64 k :i64] :bool
 (if (= k 5) true (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
  (ao-distinct M k 1) (ao-homes M (inc k)))))
(defn- ao-shape [M :vector-i64 p :i64 f :i64 fixed :bool] :i64
 (if (not (ir-bound M f 36 4 4 8)) 0
  (let [reader (gn-sir M (+ p 19) IF-A) stride (up-reader M reader)
        offset (gn-sir M (+ p 21) IF-B) limit (if fixed (gn-sir M (+ p 4) IF-B) 0)]
   (if (and (> stride 0) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-RTYPE) TY-I64) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 4) (>= offset 0) (<= offset 2147483647)
    (or (not fixed) (and (> limit 0) (< limit 2147483648)))
    (ao-rows M p f reader offset limit fixed 0) (qb-labels M p 36 0)) stride 0))))
(defn- ao-admit [M :vector-i64 i :i64 fixed :bool] :i64
 (if (or (<= i 1) (> i (- MM-SIR-CAP 35))
         (> i (- (vector-at M MM-SIR-N) 35)) (not= (gn-op M (dec i)) OP-FN)) 0
  (let [p (dec i) f (gn-sir M p IF-A)]
   (if (and (= (gn-g M gn-f-ns) 4) (= (gn-g M gn-f-dp) 8)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
    (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
    (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-nsv) 4) (= (gn-g M gn-f-out) 0)
    (>= (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768)
    (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 128))
    (ao-homes M 1)) (ao-shape M p f fixed) 0))))
;; Entry1 preserved. Direct RT176 second read carries no extra fuel charge.
(defn- ao-emit [M :vector-i64 i :i64 stride :i64 fixed :bool] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) p (dec i)
  offset (gn-sir M (+ p 21) IF-B) limit (if fixed (gn-sir M (+ p 4) IF-B) 0)
  rv (gn-sreg M 1) rh (gn-sreg M 2) kh (gn-sreg M 3) sh (gn-sreg M 4)
  G (vector-alloc 49)
  m0 (-> M (gn-mov-imm 16 2147483648) (gm-limit G rh) (gm-limit G kh))
  m1 (if fixed (gn-mov-imm m0 14 limit) (gn-mov m0 14 rh))
  m2 (-> m1 (gn-emit (enc-cmp-r kh 14)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
   (gn-emit (enc-ldp 5 6 16 0)) (gn-mov-imm 13 stride)
   (gn-emit (enc-mul 16 rh 13)) (gn-emit (enc-add-r 16 16 14))
   (gn-emit (enc-sub-i 16 16 1)) (gn-emit (enc-cmp-r 16 6)) (gm-cold G (enc-cond-hs))
   (gn-mov-imm 13 offset) (gn-emit (enc-add-r 16 13 14))
   (gn-emit (enc-sub-i 16 16 1)) (gn-emit (enc-cmp-r 16 6)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-sub-r 12 14 kh)) (gn-emit (enc-add-r 16 12 12))
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 16)) (gm-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 6 7 328)) (gn-emit (gn-e-addsl 6 6 5 3))
   (gn-emit (enc-add-r 16 13 kh)) (gn-emit (gn-e-addsl 10 6 16 3))
   (gn-mov-imm 13 stride) (gn-emit (enc-mul 16 rh 13))
   (gn-emit (enc-add-r 16 16 kh)) (gn-emit (gn-e-addsl 9 6 16 3)) (gn-mov 11 sh))
  head (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-ldr 4 9 0))
   (gn-emit (enc-ldr 5 10 0)) (gn-emit (enc-mul 4 4 5))
   (gn-emit (enc-sub-r 11 11 4)) (gn-emit (enc-sub-i 8 8 1))
   (gn-emit (enc-add-i 9 9 8)) (gn-emit (enc-add-i 10 10 8))
   (gn-emit (enc-subs-i 12 12 1))) back (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-ne) (- head back)))
   (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov kh 14) (gn-mov sh 11))
  end (vector-at m4 MM-CODE-N) m5 (gm-patch m4 G 0 end)]
  (if (= (vector-at m5 MM-ERR) 0) m5
   (-> m5 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx)))))
(defn- ao-entry [M :vector-i64 i :i64] :vector-i64
 (let [forward (ao-admit M i false)]
  (if (> forward 0) (ao-emit M i forward false)
   (let [backward (ao-admit M i true)] (if (> backward 0) (ao-emit M i backward true) M)))))

;; Closed read-only affine product-subtract recurrences. Historical rows are templates only.
(defn- up-low-row [M :vector-i64 p :i64 f :i64 reader :i64 stride :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B) end (gn-sir M (+ p 8) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 f 5 5)
   1 (gn-dot-at? M (+ p 1) 18 0 0 0)
   2 (gn-dot-at? M (+ p 2) 9 head 0 0)
   3 (gn-dot-at? M (+ p 3) 4 0 4 0)
   4 (gn-dot-at? M (+ p 4) 4 1 3 0)
   5 (gn-dot-at? M (+ p 5) 7 1 0 0)
   6 (gn-dot-at? M (+ p 6) 11 0 body 0)
   7 (gn-dot-at? M (+ p 7) 4 0 5 0)
   8 (gn-dot-at? M (+ p 8) 10 end 0 0)
   9 (gn-dot-at? M (+ p 9) 9 body 0 0)
   10 (gn-dot-at? M (+ p 10) 4 0 1 0)
   11 (gn-dot-at? M (+ p 11) 4 1 2 0)
   12 (gn-dot-at? M (+ p 12) 4 2 3 0)
   13 (gn-dot-at? M (+ p 13) 4 3 4 0)
   14 (gn-dot-at? M (+ p 14) 3 4 1 0)
   15 (gn-dot-at? M (+ p 15) 6 1 3 0)
   16 (gn-dot-at? M (+ p 16) 4 4 5 0)
   17 (gn-dot-at? M (+ p 17) 4 5 1 0)
   18 (gn-dot-at? M (+ p 18) 4 6 2 0)
   19 (gn-dot-at? M (+ p 19) 4 7 4 0)
   20 (gn-dot-at? M (+ p 20) 13 reader 5 3)
   21 (gn-dot-at? M (+ p 21) 4 6 1 0)
   22 (gn-dot-at? M (+ p 22) 4 7 4 0)
   23 (gn-dot-at? M (+ p 23) 4 8 3 0)
   24 (gn-dot-at? M (+ p 24) 13 reader 6 3)
   25 (gn-dot-at? M (+ p 25) 6 3 5 0)
   26 (gn-dot-at? M (+ p 26) 6 2 4 0)
   27 (gn-dot-at? M (+ p 27) 5 1 0 0)
   28 (gn-dot-at? M (+ p 28) 5 2 1 0)
   29 (gn-dot-at? M (+ p 29) 5 3 2 0)
   30 (gn-dot-at? M (+ p 30) 5 4 3 0)
   31 (gn-dot-at? M (+ p 31) 5 5 4 0)
   32 (gn-dot-at? M (+ p 32) 18 0 0 0)
   33 (gn-dot-at? M (+ p 33) 10 head 0 0)
   34 (gn-dot-at? M (+ p 34) 9 end 0 0)
   35 (gn-dot-at? M (+ p 35) 19 0 0 0)
   36 (gn-dot-at? M (+ p 36) 2 f 0 0)
   false)))
(defn- up-high-row [M :vector-i64 p :i64 f :i64 reader :i64 stride :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B) end (gn-sir M (+ p 8) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 f 5 5)
   1 (gn-dot-at? M (+ p 1) 18 0 0 0)
   2 (gn-dot-at? M (+ p 2) 9 head 0 0)
   3 (gn-dot-at? M (+ p 3) 4 0 4 0)
   4 (gn-dot-at? M (+ p 4) 4 1 2 0)
   5 (gn-dot-at? M (+ p 5) 7 3 0 0)
   6 (gn-dot-at? M (+ p 6) 11 0 body 0)
   7 (gn-dot-at? M (+ p 7) 4 0 5 0)
   8 (gn-dot-at? M (+ p 8) 10 end 0 0)
   9 (gn-dot-at? M (+ p 9) 9 body 0 0)
   10 (gn-dot-at? M (+ p 10) 4 0 1 0)
   11 (gn-dot-at? M (+ p 11) 4 1 2 0)
   12 (gn-dot-at? M (+ p 12) 4 2 3 0)
   13 (gn-dot-at? M (+ p 13) 4 3 4 0)
   14 (gn-dot-at? M (+ p 14) 3 4 1 0)
   15 (gn-dot-at? M (+ p 15) 6 1 3 0)
   16 (gn-dot-at? M (+ p 16) 4 4 5 0)
   17 (gn-dot-at? M (+ p 17) 4 5 1 0)
   18 (gn-dot-at? M (+ p 18) 4 6 2 0)
   19 (gn-dot-at? M (+ p 19) 3 7 1 0)
   20 (gn-dot-at? M (+ p 20) 6 1 6 0)
   21 (gn-dot-at? M (+ p 21) 4 7 4 0)
   22 (gn-dot-at? M (+ p 22) 13 reader 5 3)
   23 (gn-dot-at? M (+ p 23) 4 6 1 0)
   24 (gn-dot-at? M (+ p 24) 4 7 4 0)
   25 (gn-dot-at? M (+ p 25) 4 8 3 0)
   26 (gn-dot-at? M (+ p 26) 13 reader 6 3)
   27 (gn-dot-at? M (+ p 27) 6 3 5 0)
   28 (gn-dot-at? M (+ p 28) 6 2 4 0)
   29 (gn-dot-at? M (+ p 29) 5 1 0 0)
   30 (gn-dot-at? M (+ p 30) 5 2 1 0)
   31 (gn-dot-at? M (+ p 31) 5 3 2 0)
   32 (gn-dot-at? M (+ p 32) 5 4 3 0)
   33 (gn-dot-at? M (+ p 33) 5 5 4 0)
   34 (gn-dot-at? M (+ p 34) 18 0 0 0)
   35 (gn-dot-at? M (+ p 35) 10 head 0 0)
   36 (gn-dot-at? M (+ p 36) 9 end 0 0)
   37 (gn-dot-at? M (+ p 37) 19 0 0 0)
   38 (gn-dot-at? M (+ p 38) 2 f 0 0)
   false)))
(defn- up-rows [M :vector-i64 p :i64 f :i64 reader :i64 stride :i64 upper :bool k :i64] :bool
 (if (= k (if upper 39 37)) true
  (and (if upper (up-high-row M p f reader stride k) (up-low-row M p f reader stride k))
   (up-rows M p f reader stride upper (inc k)))))
(defn- up-reader-row [M :vector-i64 p :i64 f :i64 stride :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A)]
  (case k
   0 (gn-dot-at? M p 1 f 3 3)
   1 (gn-dot-at? M (+ p 1) 18 0 0 0)
   2 (gn-dot-at? M (+ p 2) 9 head 0 0)
   3 (gn-dot-at? M (+ p 3) 4 0 1 0)
   4 (gn-dot-at? M (+ p 4) 4 1 2 0)
   5 (gn-dot-at? M (+ p 5) 3 2 stride 0)
   6 (gn-dot-at? M (+ p 6) 6 3 1 0)
   7 (gn-dot-at? M (+ p 7) 4 2 3 0)
   8 (gn-dot-at? M (+ p 8) 6 1 1 0)
   9 (gn-dot-at? M (+ p 9) 14 176 0 2)
   10 (gn-dot-at? M (+ p 10) 19 0 0 0)
   11 (gn-dot-at? M (+ p 11) 2 f 0 0)
   false)))
(defn- up-reader-rows [M :vector-i64 p :i64 f :i64 stride :i64 k :i64] :bool
 (if (= k 12) true (and (up-reader-row M p f stride k) (up-reader-rows M p f stride (inc k)))))
(defn- up-reader [M :vector-i64 f :i64] :i64
 (if (not (ir-bound M f 12 3 3 3)) 0
  (let [p (gn-fnf M f FF-SIR) stride (gn-sir M (+ (gn-fnf M f FF-SIR) 5) IF-B)]
   (if (and (= (gn-fnf M f FF-RTYPE) TY-I64) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 3) (> stride 0) (<= stride 4095)
    (up-reader-rows M p f stride 0) (qb-labels M p 12 0)) stride 0))))
(defn- up-distinct [M :vector-i64 k :i64 j :i64] :bool
 (if (= j k) true (and (not= (gn-sreg M k) (gn-sreg M j)) (up-distinct M k (inc j)))))
(defn- up-homes [M :vector-i64 k :i64] :bool
 (if (= k 6) true (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
  (up-distinct M k 1) (up-homes M (inc k)))))
(defn- up-shape [M :vector-i64 p :i64 f :i64 upper :bool] :i64
 (if (not (ir-bound M f (if upper 39 37) 5 5 9)) 0
  (let [reader (gn-sir M (+ p (if upper 22 20)) IF-A) stride (up-reader M reader)]
   (if (and (> stride 0) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-RTYPE) TY-I64) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 5) (up-rows M p f reader stride upper 0)
    (qb-labels M p (if upper 39 37) 0)) stride 0))))
(defn- up-admit [M :vector-i64 i :i64 upper :bool] :i64
 (if (or (<= i 1) (> i (- MM-SIR-CAP 38))
         (> i (- (vector-at M MM-SIR-N) 38)) (not= (gn-op M (dec i)) OP-FN)) 0
  (let [p (dec i) f (gn-sir M p IF-A)]
   (if (and (= (gn-g M gn-f-ns) 5) (= (gn-g M gn-f-dp) 9)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
    (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
    (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-nsv) 5) (= (gn-g M gn-f-out) 0)
    (>= (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768)
    (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 128))
    (up-homes M 1)) (up-shape M p f upper) 0))))
;; Guard misses retain original homes/CTX. Success keeps the three individual
;; debits, restores k=end/sum, then executes the original terminal head/return.
;; Full ranges prove no read trap; shared intermediate publication is deferred
;; only for this synchronous pure nontrapping region. Original entry is paid.
(defn- up-emit [M :vector-i64 stride :i64 upper :bool] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N)
  rv (gn-sreg M 1) rh (gn-sreg M 2) ch (gn-sreg M 3)
  kh (gn-sreg M 4) sh (gn-sreg M 5) G (vector-alloc 49)
  m0 (-> M (gn-mov-imm 16 2147483648) (gm-limit G rh) (gm-limit G ch) (gm-limit G kh)
   (gn-mov 14 (if upper rh ch)))
  m1 (if upper (-> m0 (gn-emit (enc-add-i 14 14 1)) (gm-limit G 14)) m0)
  m2 (-> m1 (gn-emit (enc-cmp-r kh 14)) (gm-cold G (enc-cond-hs))
   (gn-mov 15 rh))
  m3 (if upper (gn-emit m2 (enc-add-i 15 15 1)) m2)
  m4 (-> m3 (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
   (gn-emit (enc-ldp 5 6 16 0)) (gn-mov-imm 13 stride)
   (gn-emit (enc-mul 16 15 13)) (gn-emit (enc-add-r 16 16 14))
   (gn-emit (enc-sub-i 16 16 1)) (gn-emit (enc-cmp-r 16 6)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-sub-i 16 14 1)) (gn-emit (enc-mul 16 16 13))
   (gn-emit (enc-add-r 16 16 ch)) (gn-emit (enc-cmp-r 16 6)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-sub-r 12 14 kh)) (gn-emit (enc-add-r 16 12 12))
   (gn-emit (enc-add-r 16 16 12)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
   (gn-emit (enc-cmp-r 8 16)) (gm-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 6 7 328)) (gn-emit (gn-e-addsl 6 6 5 3))
   (gn-emit (enc-mul 16 15 13)) (gn-emit (enc-add-r 16 16 kh))
   (gn-emit (gn-e-addsl 9 6 16 3)) (gn-emit (enc-mul 16 kh 13))
   (gn-emit (enc-add-r 16 16 ch)) (gn-emit (gn-e-addsl 10 6 16 3))
   (gn-emit (gn-e-lsl 13 13 3)) (gn-mov 11 sh))
  head (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-ldr 4 9 0))
   (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-ldr 5 10 0))
   (gn-emit (enc-mul 4 4 5)) (gn-emit (enc-sub-r 11 11 4))
   (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-add-i 9 9 8))
   (gn-emit (enc-add-r 10 10 13)) (gn-emit (enc-subs-i 12 12 1))) back (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond (enc-cond-ne) (- head back)))
   (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov kh 14) (gn-mov sh 11))
  end (vector-at m6 MM-CODE-N) m7 (gm-patch m6 G 0 end)]
  (if (= (vector-at m7 MM-ERR) 0) m7
   (-> m7 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx)))))
(defn- up-entry [M :vector-i64 i :i64] :vector-i64
 (let [lower (up-admit M i false)]
  (if (> lower 0) (up-emit M lower false)
   (let [upper (up-admit M i true)] (if (> upper 0) (up-emit M upper true) M)))))

;; Exact generic stable two-run record merge, original terminal copy retained.
(defn- gm-row [M :vector-i64 p :i64 f :i64 reader :i64 item :i64 copy :i64 k :i64] :bool
 (let [h (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 11) IF-B)
       end (gn-sir M (+ p 20) IF-A) short (gn-sir M (+ p 6) IF-B)
       right (gn-sir M (+ p 29) IF-B) join (gn-sir M (+ p 74) IF-A)]
  (case k
    0 (gn-dot-at? M (+ p 0) 1 f 6 6)
    1 (gn-dot-at? M (+ p 1) 18 0 0 0)
    2 (gn-dot-at? M (+ p 2) 9 h 0 0)
