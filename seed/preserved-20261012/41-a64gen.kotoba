(defn- ct-writer-rows [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 14) true (and (ct-writer-row M p k) (ct-writer-rows M p (inc k)))))
(defn- ct-writer-closed [M :vector-i64 f :i64] :bool
 (and (ct-bound M f 14 5 5 4 1 4)
  (= (gn-fnf M f (+ FF-PT0 0)) 4)
  (= (gn-fnf M f (+ FF-PT0 1)) 1)
  (= (gn-fnf M f (+ FF-PT0 2)) 1)
  (= (gn-fnf M f (+ FF-PT0 3)) 1)
  (= (gn-fnf M f (+ FF-PT0 4)) 1)
  (ct-writer-rows M (gn-fnf M f FF-SIR) 0) (qb-labels M (gn-fnf M f FF-SIR) 14 0)))
(defn- ct-fill-row [M :vector-i64 p :i64 k :i64] :bool
 (let [f (gn-sir M p IF-A)
  c0 (gn-sir M (+ p 15) IF-A)
  l2 (gn-sir M (+ p 2) IF-A)
  l9 (gn-sir M (+ p 9) IF-A)
