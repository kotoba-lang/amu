  m58 (gn-dot-patch m57 bend falsefound 13)
  m59 (gn-dot-patch m58 mismatch falsefound (enc-cond-ne))
  m60 (gn-dot-patch m59 cap fallback (enc-cond-hs))
  m61 (gn-put m60 (+ MM-CODE-BASE yesjump) (enc-b (- answer yesjump)))
  m62 (gn-dot-patch m61 fuel fallback (enc-cond-lo))
  m63 (gn-dot-patch m62 gtrue ret (enc-cond-ne))
  m64 (gn-gs m63 gn-f-dead dead)]
  (if (= (vector-at m64 MM-ERR) 0)
   (-> m64 (gn-gs di-sites (inc (gn-g m64 di-sites))) (gn-gs di-used (+ (gn-g m64 di-used) (- (vector-at m64 MM-CODE-N) cn))))
   (-> m64 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))))
(defn- sf-entry [M :vector-i64 i :i64] :vector-i64
 (if (sf-admit M i) (sf-emit M i) M))

;; Closed bounded readonly signed-zero comparator. Only private recurrence fuel is batched.
(defn- zc-row [M :vector-i64 p :i64 f :i64 stride :i64 k :i64] :bool
 (let [l2 (gn-sir M (+ p 2) IF-A) l26 (gn-sir M (+ p 26) IF-A) l30 (gn-sir M (+ p 30) IF-A) l38 (gn-sir M (+ p 38) IF-A) l43 (gn-sir M (+ p 43) IF-A) l58 (gn-sir M (+ p 58) IF-A) l60 (gn-sir M (+ p 60) IF-A) l61 (gn-sir M (+ p 61) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 f 4 6)
   1 (gn-dot-at? M (+ p 1) 18 0 0 0)
   2 (gn-dot-at? M (+ p 2) 9 l2 0 0)
   3 (gn-dot-at? M (+ p 3) 4 0 1 0)
   4 (gn-dot-at? M (+ p 4) 4 1 2 0)
   5 (gn-dot-at? M (+ p 5) 3 2 stride 0)
   6 (gn-dot-at? M (+ p 6) 6 3 1 0)
   7 (gn-dot-at? M (+ p 7) 4 2 4 0)
   8 (gn-dot-at? M (+ p 8) 6 1 1 0)
   9 (gn-dot-at? M (+ p 9) 14 176 0 2)
   10 (gn-dot-at? M (+ p 10) 5 5 0 0)
   11 (gn-dot-at? M (+ p 11) 4 0 1 0)
   12 (gn-dot-at? M (+ p 12) 4 1 3 0)
   13 (gn-dot-at? M (+ p 13) 3 2 stride 0)
   14 (gn-dot-at? M (+ p 14) 6 3 1 0)
   15 (gn-dot-at? M (+ p 15) 4 2 4 0)
   16 (gn-dot-at? M (+ p 16) 6 1 1 0)
   17 (gn-dot-at? M (+ p 17) 14 176 0 2)
   18 (gn-dot-at? M (+ p 18) 5 6 0 0)
   19 (gn-dot-at? M (+ p 19) 4 0 5 0)
   20 (gn-dot-at? M (+ p 20) 3 1 0 0)
   21 (gn-dot-at? M (+ p 21) 7 1 0 0)
   22 (gn-dot-at? M (+ p 22) 11 0 l26 0)
   23 (gn-dot-at? M (+ p 23) 4 0 6 0)
   24 (gn-dot-at? M (+ p 24) 3 1 0 0)
   25 (gn-dot-at? M (+ p 25) 7 1 0 0)
   26 (gn-dot-at? M (+ p 26) 9 l26 0 0)
   27 (gn-dot-at? M (+ p 27) 11 0 l30 0)
   28 (gn-dot-at? M (+ p 28) 3 0 1 0)
   29 (gn-dot-at? M (+ p 29) 10 l61 0 0)
   30 (gn-dot-at? M (+ p 30) 9 l30 0 0)
   31 (gn-dot-at? M (+ p 31) 4 0 5 0)
   32 (gn-dot-at? M (+ p 32) 3 1 0 0)
   33 (gn-dot-at? M (+ p 33) 7 3 0 0)
   34 (gn-dot-at? M (+ p 34) 11 0 l38 0)
   35 (gn-dot-at? M (+ p 35) 4 0 6 0)
   36 (gn-dot-at? M (+ p 36) 3 1 0 0)
   37 (gn-dot-at? M (+ p 37) 7 3 0 0)
   38 (gn-dot-at? M (+ p 38) 9 l38 0 0)
   39 (gn-dot-at? M (+ p 39) 11 0 l43 0)
   40 (gn-dot-at? M (+ p 40) 4 0 5 0)
   41 (gn-dot-at? M (+ p 41) 4 1 6 0)
   42 (gn-dot-at? M (+ p 42) 7 1 0 0)
   43 (gn-dot-at? M (+ p 43) 9 l43 0 0)
   44 (gn-dot-at? M (+ p 44) 11 0 l58 0)
   45 (gn-dot-at? M (+ p 45) 4 0 1 0)
   46 (gn-dot-at? M (+ p 46) 4 1 2 0)
   47 (gn-dot-at? M (+ p 47) 4 2 3 0)
   48 (gn-dot-at? M (+ p 48) 4 3 4 0)
   49 (gn-dot-at? M (+ p 49) 3 4 1 0)
   50 (gn-dot-at? M (+ p 50) 6 1 3 0)
   51 (gn-dot-at? M (+ p 51) 5 1 0 0)
   52 (gn-dot-at? M (+ p 52) 5 2 1 0)
   53 (gn-dot-at? M (+ p 53) 5 3 2 0)
   54 (gn-dot-at? M (+ p 54) 5 4 3 0)
   55 (gn-dot-at? M (+ p 55) 18 0 0 0)
   56 (gn-dot-at? M (+ p 56) 10 l2 0 0)
   57 (gn-dot-at? M (+ p 57) 10 l60 0 0)
