;; UNHOOKED: callable only after installation-contract current-M/home/frame gates.
;; Both kernels return immediately, preserving all saved homes/old frame. No
;; transfer back to old local-consuming body after any new debit or write.
(defn- ct-proto-return [M :vector-i64] :vector-i64
 (-> M (gn-emit (enc-str 8 7 CTX-FUEL))
  (gn-mov 0 (gn-sreg M 1)) (gn-epilogue)))
;; Exact full-i64 wrapped floor(+dc,64)/128 followed by source sign16 clamp.
;; Source negative branch wraps -x+127 before truncating signed /128. The
;; inner truncation's sign bias must therefore be retained even near MIN.
(defn- ct-dc-column [M :vector-i64] :vector-i64
 (let [m0 (-> M (gn-emit (enc-add-i 0 0 64)) (gn-emit (enc-cmp-i 0 0)))
  positive (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ge) 0))
   (gn-emit (enc-sub-r 0 31 0)) (gn-emit (enc-add-i 0 0 127))
   (gn-emit (gn-e-asr 17 0 63)) (gn-emit (gn-e-lsr 17 17 57))
   (gn-emit (enc-add-r 0 0 17)) (gn-emit (gn-e-asr 0 0 7))
   (gn-emit (enc-sub-r 0 31 0)))
  jump (vector-at m1 MM-CODE-N) m2 (gn-emit m1 (enc-b 0))
  pos (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (gn-e-asr 0 0 7))
  join (vector-at m3 MM-CODE-N)]
  (-> m3 (gn-emit (enc-add-i 0 0 128)) (cb-clamp 0)
   (gn-dot-patch positive pos (enc-cond-ge))
   (gn-put (+ MM-CODE-BASE jump) (enc-b (- join jump))))))
(defn- ct-prototype-emit [M :vector-i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead) G (vector-alloc 49)
  ;; Preconditions: parameter homes saved19..28 and disjoint; all guards are
  ;; scratch-only. Any miss has paid only the original owner entry FUEL.
  m0 (-> M (gn-mov 0 (gn-sreg M 1))
   (gn-emit (enc-cmp-i (gn-sreg M 4) 2)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-orr-r 16 (gn-sreg M 2) (gn-sreg M 3)))
   (gn-emit (gn-e-lsr 16 16 31)) (gn-emit (enc-cmp-i 16 0))
   (gm-cold G (enc-cond-ne))
   (gn-emit (enc-cmp-i (gn-sreg M 3) 0)) (gm-cold G (enc-cond-eq))
   (gn-mov-imm 16 7) (gn-emit (enc-mul 16 (gn-sreg M 3) 16))
   (gn-emit (enc-add-r 16 (gn-sreg M 2) 16))
   (gn-emit (enc-ldr 11 7 312)) (gn-emit (enc-ldr 11 11 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 11))
   (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 11 7 320)) (gn-emit (gn-e-addsl 11 11 17 4))
   (gn-emit (enc-ldp 11 12 11 0)) (gn-emit (enc-cmp-r 16 12))
   (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 44))
   (gm-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 14 7 328)) (gn-emit (gn-e-addsl 14 14 11 3))
   (gn-emit (gn-e-addsl 14 14 (gn-sreg M 2) 3))
   (gn-emit (gn-e-lsl 15 (gn-sreg M 3) 3))
   (gn-emit (enc-add-r 13 14 15)) (gn-mov-imm 9 1) (gn-mov-imm 10 0))
  scan (vector-at m0 MM-CODE-N)
  m1 (gn-emit m0 (enc-ldr 16 13 0))
  nonzero (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-cbnz 16 0)) (gn-emit (enc-add-i 10 10 1))
   (gn-emit (enc-add-i 9 9 1)) (gn-emit (enc-cmp-i 9 8)))
  alldc (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-eq) 0))
   (gn-emit (enc-add-r 13 13 15))) back (vector-at m3 MM-CODE-N)
  m4 (gn-emit m3 (enc-b (- scan back)))
  normal (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-cmp-i (gn-sreg M 4) 0)))
  normalcol (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond (enc-cond-ne) 0))
   (gn-emit (enc-add-i 10 10 22)) (gn-emit (enc-sub-r 8 8 10))
   (ct-normal-row) (ct-proto-return))
  col (vector-at m6 MM-CODE-N)
  m7 (-> m6 (gn-emit (enc-add-i 10 10 38)) (gn-emit (enc-sub-r 8 8 10))
   (ct-normal-column) (ct-proto-return))
  dc (vector-at m7 MM-CODE-N)
  m8 (-> m7 (gn-emit (enc-ldr 0 14 0))
   (gn-emit (enc-cmp-i (gn-sreg M 4) 0)))
  dccol (vector-at m8 MM-CODE-N)
  m9 (-> m8 (gn-emit (enc-bcond (enc-cond-ne) 0))
   (gn-emit (enc-sub-i 8 8 33))) dcjoin (vector-at m9 MM-CODE-N)
  m10 (gn-emit m9 (enc-b 0)) dcc (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-emit (enc-sub-i 8 8 35)) (ct-dc-column))
  fill (vector-at m11 MM-CODE-N)
  m12 (-> m11 (gn-emit (gn-e-bf 0x93400000 0 0 0 15)) (gn-mov-imm 9 8))
  loop (vector-at m12 MM-CODE-N)
  m13 (-> m12 (gn-emit (enc-str 0 14 0)) (gn-emit (enc-add-r 14 14 15))
   (gn-emit (enc-sub-i 9 9 1)) (gn-emit (enc-cmp-i 9 0)))
  fillback (vector-at m13 MM-CODE-N)
  m14 (-> m13 (gn-emit (enc-bcond (enc-cond-ne) (- loop fillback)))
   (ct-proto-return)) fallback (vector-at m14 MM-CODE-N)
  m15 (-> (gm-patch m14 G 0 fallback)
   (gn-put (+ MM-CODE-BASE nonzero) (enc-cbnz 16 (- normal nonzero)))
   (gn-dot-patch alldc dc (enc-cond-eq))
   (gn-dot-patch normalcol col (enc-cond-ne))
   (gn-dot-patch dccol dcc (enc-cond-ne))
   (gn-put (+ MM-CODE-BASE dcjoin) (enc-b (- fill dcjoin))))]
  (if (= (vector-at m15 MM-ERR) 0) (gn-gs m15 gn-f-dead dead)
   (-> m15 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))))

;; Exact bounded affine grid initializer, original private fuel/store order.
(defn- gi-row [M :vector-i64 p :i64 f :i64 writer :i64 n :i64 stride :i64 off :i64 bias :i64 factor :i64 k :i64] :bool
 (let [l3 (gn-sir M (+ p 2) IF-A) l4 (gn-sir M (+ p 9) IF-A) l6 (gn-sir M (+ p 32) IF-A) l8 (gn-sir M (+ p 47) IF-A) l9 (gn-sir M (+ p 49) IF-A) l7 (gn-sir M (+ p 72) IF-A) l5 (gn-sir M (+ p 73) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 f 4 6)
   1 (gn-dot-at? M (+ p 1) 18 0 0 0)
   2 (gn-dot-at? M (+ p 2) 9 l3 0 0)
   3 (gn-dot-at? M (+ p 3) 4 0 2 0)
   4 (gn-dot-at? M (+ p 4) 3 1 n 0)
   5 (gn-dot-at? M (+ p 5) 7 1 0 0)
   6 (gn-dot-at? M (+ p 6) 11 0 l4 0)
   7 (gn-dot-at? M (+ p 7) 4 0 1 0)
   8 (gn-dot-at? M (+ p 8) 10 l5 0 0)
   9 (gn-dot-at? M (+ p 9) 9 l4 0 0)
   10 (gn-dot-at? M (+ p 10) 4 0 3 0)
   11 (gn-dot-at? M (+ p 11) 3 1 n 0)
   12 (gn-dot-at? M (+ p 12) 7 1 0 0)
   13 (gn-dot-at? M (+ p 13) 11 0 l6 0)
   14 (gn-dot-at? M (+ p 14) 4 0 1 0)
   15 (gn-dot-at? M (+ p 15) 3 1 off 0)
   16 (gn-dot-at? M (+ p 16) 4 2 2 0)
   17 (gn-dot-at? M (+ p 17) 6 1 1 0)
   18 (gn-dot-at? M (+ p 18) 4 2 4 0)
   19 (gn-dot-at? M (+ p 19) 13 writer 0 3)
   20 (gn-dot-at? M (+ p 20) 4 1 2 0)
   21 (gn-dot-at? M (+ p 21) 3 2 1 0)
   22 (gn-dot-at? M (+ p 22) 6 1 1 0)
   23 (gn-dot-at? M (+ p 23) 3 2 0 0)
   24 (gn-dot-at? M (+ p 24) 3 3 0 0)
   25 (gn-dot-at? M (+ p 25) 5 1 0 0)
   26 (gn-dot-at? M (+ p 26) 5 2 1 0)
   27 (gn-dot-at? M (+ p 27) 5 3 2 0)
   28 (gn-dot-at? M (+ p 28) 5 4 3 0)
   29 (gn-dot-at? M (+ p 29) 18 0 0 0)
   30 (gn-dot-at? M (+ p 30) 10 l3 0 0)
   31 (gn-dot-at? M (+ p 31) 10 l7 0 0)
   32 (gn-dot-at? M (+ p 32) 9 l6 0 0)
   33 (gn-dot-at? M (+ p 33) 4 0 2 0)
   34 (gn-dot-at? M (+ p 34) 4 1 3 0)
   35 (gn-dot-at? M (+ p 35) 6 1 0 0)
   36 (gn-dot-at? M (+ p 36) 3 1 bias 0)
   37 (gn-dot-at? M (+ p 37) 6 1 0 0)
   38 (gn-dot-at? M (+ p 38) 5 5 0 0)
   39 (gn-dot-at? M (+ p 39) 4 0 2 0)
   40 (gn-dot-at? M (+ p 40) 4 1 3 0)
   41 (gn-dot-at? M (+ p 41) 7 1 0 0)
   42 (gn-dot-at? M (+ p 42) 11 0 l8 0)
   43 (gn-dot-at? M (+ p 43) 4 0 5 0)
   44 (gn-dot-at? M (+ p 44) 3 1 factor 0)
   45 (gn-dot-at? M (+ p 45) 6 3 0 0)
   46 (gn-dot-at? M (+ p 46) 10 l9 0 0)
   47 (gn-dot-at? M (+ p 47) 9 l8 0 0)
   48 (gn-dot-at? M (+ p 48) 4 0 5 0)
   49 (gn-dot-at? M (+ p 49) 9 l9 0 0)
   50 (gn-dot-at? M (+ p 50) 5 6 0 0)
   51 (gn-dot-at? M (+ p 51) 4 0 1 0)
   52 (gn-dot-at? M (+ p 52) 4 1 2 0)
   53 (gn-dot-at? M (+ p 53) 3 2 stride 0)
   54 (gn-dot-at? M (+ p 54) 6 3 1 0)
   55 (gn-dot-at? M (+ p 55) 4 2 3 0)
   56 (gn-dot-at? M (+ p 56) 6 1 1 0)
   57 (gn-dot-at? M (+ p 57) 4 2 6 0)
   58 (gn-dot-at? M (+ p 58) 13 writer 0 3)
   59 (gn-dot-at? M (+ p 59) 4 1 2 0)
   60 (gn-dot-at? M (+ p 60) 4 2 3 0)
   61 (gn-dot-at? M (+ p 61) 3 3 1 0)
   62 (gn-dot-at? M (+ p 62) 6 1 2 0)
   63 (gn-dot-at? M (+ p 63) 4 3 4 0)
   64 (gn-dot-at? M (+ p 64) 4 4 6 0)
   65 (gn-dot-at? M (+ p 65) 6 1 3 0)
   66 (gn-dot-at? M (+ p 66) 5 1 0 0)
   67 (gn-dot-at? M (+ p 67) 5 2 1 0)
   68 (gn-dot-at? M (+ p 68) 5 3 2 0)
