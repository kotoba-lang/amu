 (let [p (dec i) f (gn-sir M p IF-A) child (gn-sir M (+ p 14) IF-A)
  cp (if (and (> child 0) (< child MM-FN-CAP) (< child (vector-at M MM-FN-N))) (gn-fnf M child FF-SIR) 0) limit (gn-sir M (+ p 4) IF-B) stride (if (and (> cp 0) (<= cp (- (vector-at M MM-SIR-N) 64)) (<= cp (- MM-SIR-CAP 64))) (gn-sir M (+ cp 5) IF-B) 0)]
  (and (ir-bound M f 33 3 3 4) (= (gn-fnf M f FF-SIR) p)
   (= (gn-fnf M f FF-RTYPE) TY-BOOL) (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 3)
   (ir-bound M child 64 4 6 5) (= (gn-fnf M child FF-RTYPE) TY-BOOL)
   (= (gn-fnf M child FF-PT0) TY-VEC) (qb-int-params M child 1 4)
   (> limit 0) (<= limit 4095) (> stride 0) (<= stride 4095)
   (sf-rows M p f child limit 0) (qb-labels M p 33 0) (zc-rows M cp child stride 0) (qb-labels M cp 64 0)
   (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 4)
   (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-out) 0)
   (= (gn-g M gn-f-nsv) 3) (= (gn-g M gn-f-fb) 112) (drc-homes M 1 3)
   (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (= (vector-at M MM-ERR) 0)
   (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 256))
   (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
   (>= (gn-g M di-sites) 0) (>= (gn-g M di-used) 0) (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 3840)))))
(defn- sf-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) child (gn-sir M (+ p 14) IF-A) cp (gn-fnf M child FF-SIR)
  limit (gn-sir M (+ p 4) IF-B) stride (if (and (> cp 0) (<= cp (- (vector-at M MM-SIR-N) 64)) (<= cp (- MM-SIR-CAP 64))) (gn-sir M (+ cp 5) IF-B) 0)
  rv (gn-sreg M 1) target (gn-sreg M 2) fh (gn-sreg M 3)
  cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
  m0 (-> M (gn-emit (enc-ldr 7 31 104)) (gn-emit (enc-cmp-i fh limit)))
  empty (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-eq) 0)))
  domain (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m3 (-> m2 (gn-emit (enc-cmp-i target limit)))
  gtarget (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m5 (gn-mov-imm m4 10 stride)
  m6 (-> m5 (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)))
  handle (vector-at m6 MM-CODE-N)
  m7 (-> m6 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m8 (-> m7 (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 9 11 16 0)))
  m9 (gn-mov-imm m8 16 (- (* limit stride) 1))
  m10 (-> m9 (gn-emit (enc-cmp-r 16 11)))
  range (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m12 (-> m11 (gn-emit (enc-add-r 16 9 16)) (gn-emit (enc-cmp-r 16 9)))
  wrap (vector-at m12 MM-CODE-N)
  m13 (-> m12 (gn-emit (enc-bcond (enc-cond-lo) 0)))
  m14 (gn-mov-imm m13 17 1152921504606846975)
  m15 (-> m14 (gn-emit (enc-cmp-r 16 17)))
  scale (vector-at m15 MM-CODE-N)
  m16 (-> m15 (gn-emit (enc-bcond 8 0)))
  m17 (-> m16 (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 9 16 9 3)) (gn-emit (enc-mul 16 target 10)) (gn-emit (gn-e-addsl 11 9 16 3)))
  outer (vector-at m17 MM-CODE-N)
  m18 (-> m17 (gn-emit (enc-cmp-i fh limit)))
  end (vector-at m18 MM-CODE-N)
  m19 (-> m18 (gn-emit (enc-bcond (enc-cond-eq) 0)))
  m20 (-> m19 (gn-emit (enc-mul 16 fh 10)) (gn-emit (gn-e-addsl 12 9 16 3)) (gn-emit (enc-orr-r 13 31 11)))
  m21 (gn-mov-imm m20 14 0)
  scan (vector-at m21 MM-CODE-N)
  m22 (-> m21 (gn-emit (enc-ldr 15 12 0)) (gn-emit (enc-ldr 16 13 0)) (gn-emit (enc-cmp-i 15 0)))
  nonzero (vector-at m22 MM-CODE-N)
  m23 (-> m22 (gn-emit (enc-bcond (enc-cond-ne) 0)))
  m24 (-> m23 (gn-emit (enc-cmp-i 16 0)))
  bothzero (vector-at m24 MM-CODE-N)
  m25 (-> m24 (gn-emit (enc-bcond (enc-cond-eq) 0)))
  positive (vector-at m25 MM-CODE-N)
  m26 (-> m25 (gn-emit (enc-cmp-i 15 0)))
  aend (vector-at m26 MM-CODE-N)
  m27 (-> m26 (gn-emit (enc-bcond 13 0)))
  m28 (-> m27 (gn-emit (enc-cmp-i 16 0)))
  bend (vector-at m28 MM-CODE-N)
  m29 (-> m28 (gn-emit (enc-bcond 13 0)))
  m30 (-> m29 (gn-emit (enc-cmp-r 15 16)))
  mismatch (vector-at m30 MM-CODE-N)
  m31 (-> m30 (gn-emit (enc-bcond (enc-cond-ne) 0)))
  m32 (-> m31 (gn-emit (enc-add-i 14 14 1)) (gn-emit (enc-cmp-r 14 10)))
  cap (vector-at m32 MM-CODE-N)
  m33 (-> m32 (gn-emit (enc-bcond (enc-cond-hs) 0)))
  m34 (-> m33 (gn-emit (enc-add-i 12 12 8)) (gn-emit (enc-add-i 13 13 8)))
  scanback (vector-at m34 MM-CODE-N)
  m35 (-> m34 (gn-emit (enc-b (- scan scanback))))
  yesfound (vector-at m35 MM-CODE-N)
  m36 (gn-mov-imm m35 0 1)
  yesjump (vector-at m36 MM-CODE-N)
  m37 (-> m36 (gn-emit (enc-b 0)))
  falsefound (vector-at m37 MM-CODE-N)
  m38 (gn-mov-imm m37 0 0)
  answer (vector-at m38 MM-CODE-N)
  m39 (-> m38 (gn-emit (enc-add-i 1 14 1)) (gn-emit (enc-add-i 2 1 1)) (gn-emit (enc-cmp-i 0 0)) (gn-emit (enc-csel 2 1 2 (enc-cond-ne))) (gn-emit (enc-ldr 17 7 CTX-FUEL)) (gn-emit (enc-cmp-r 17 2)))
  fuel (vector-at m39 MM-CODE-N)
  m40 (-> m39 (gn-emit (enc-bcond (enc-cond-lo) 0)))
  m41 (-> m40 (gn-emit (enc-sub-r 17 17 1)) (gn-emit (enc-str 17 7 CTX-FUEL)) (gn-emit (enc-cmp-i 0 0)))
  gtrue (vector-at m41 MM-CODE-N)
  m42 (-> m41 (gn-emit (enc-bcond (enc-cond-ne) 0)))
  m43 (-> m42 (gn-emit (enc-add-i fh fh 1)) (gn-emit (enc-sub-i 17 17 1)) (gn-emit (enc-str 17 7 CTX-FUEL)))
  outerback (vector-at m43 MM-CODE-N)
  m44 (-> m43 (gn-emit (enc-b (- outer outerback))))
  no (vector-at m44 MM-CODE-N)
  m45 (gn-mov-imm m44 0 0)
