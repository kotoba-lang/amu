(defn- wp-admit [M :vector-i64 i :i64] :bool
 (let [f (gn-g M fr-owner) n (vector-at M MM-SIR-N)]
  (if (or (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))
          (<= n 73) (> n MM-SIR-CAP)
          (not= (gn-g M gn-f-ns) 16) (not= (gn-g M gn-f-dp) 2)
          (not= (gn-g M gn-f-h) 0) (not= (gn-g M gn-f-vmode) 0)
          (not= (gn-g M gn-f-dead) 0) (not= (gn-g M gn-f-skip) 0)
          (not= (vector-at M MM-ERR) 0)
          (< (gn-g M gn-f-nsv) 0) (> (gn-g M gn-f-nsv) 10)
          (not= (bit-and (gn-g M gn-f-fb) 15) 0)
          (< (vector-at M MM-FIX-N) 0) (> (vector-at M MM-FIX-N) MM-FIX-CAP) (<= (gn-g M gn-f-fb) 136) (> (gn-g M gn-f-fb) 32768)
          (< (vector-at M MM-CODE-N) 0) (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 16))) false
   (let [p (gn-fnf M f FF-SIR)]
    (if (or (<= p 0) (> p (- MM-SIR-CAP 73)) (> p (- n 73))) false
     (let [lab (gn-sir M (+ p 1) IF-A) rlo (gn-sreg M 15) rhi (gn-sreg M 16)]
      (and (= i (+ p 2)) (= (gn-fnf M f FF-NPARAMS) 2)
           (= (gn-fnf M f FF-NSLOTS) 16) (= (gn-fnf M f FF-DEPTH) 2)
           (= (gn-fnf M f FF-FUEL) 0) (= (gn-fnf M f FF-RTYPE) TY-VEC)
           (= (gn-fnf M f FF-PT0) TY-I64) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
           (> lab 0) (< lab MM-LABEL-CAP) (= (gn-small-label M 1 lab 0) (+ p 1))
           (wp-home? M 1) (wp-home? M 2) (wp-home? M 15) (wp-home? M 16)
           (or (< rlo 0) (< rhi 0) (not= rlo rhi))
           (wp-shape M p f lab))))))))
(defn- wp-emit [M :vector-i64] :vector-i64
 (-> M (wp-load 0 1) (wp-load 1 2)
       (gn-emit (enc-mul 16 0 1)) (gn-emit (gn-e-umulh 17 0 1))
       (wp-store 16 15) (wp-store 17 16) (gn-gs gn-f-skip 65)))
(defn- wp-entry [M :vector-i64 i :i64] :vector-i64
 (if (wp-admit M i) (wp-emit M) M))

;; Generic immutable endzero-reader variable-step scan. Constants and labels derived from M.
(defn- ivs-step-key [k :i64] :i64
 (case k
  0 534529
  1 18
  2 2185
  3 4100
  4 8260
  5 526413
  6 159811
  7 71
  8 143371
  9 4100
  10 8260
  11 4227
