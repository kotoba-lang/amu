    40 (gn-dot-at? M (+ p 40) 4 5 6 0)
    41 (gn-dot-at? M (+ p 41) 3 6 1 0)
    42 (gn-dot-at? M (+ p 42) 6 1 5 0)
    43 (gn-dot-at? M (+ p 43) 5 1 0 0)
    44 (gn-dot-at? M (+ p 44) 5 2 1 0)
