  21 (uc-row M (+ p 21) 3 2 2 0)
  22 (uc-row M (+ p 22) 6 1 1 0)
  23 (uc-row M (+ p 23) 4 2 3 0)
  24 (uc-row M (+ p 24) 3 3 16 0)
  25 (uc-row M (+ p 25) 13 e 2 2)
  26 (uc-row M (+ p 26) 14 208 0 3)
  27 (uc-row M (+ p 27) 5 6 0 0)
  28 (uc-row M (+ p 28) 4 0 6 0)
  29 (uc-row M (+ p 29) 4 1 2 0)
  30 (uc-row M (+ p 30) 3 2 3 0)
  31 (uc-row M (+ p 31) 6 1 1 0)
  32 (uc-row M (+ p 32) 4 2 3 0)
  33 (uc-row M (+ p 33) 3 3 24 0)
  34 (uc-row M (+ p 34) 13 e 2 2)
  35 (uc-row M (+ p 35) 14 208 0 3)
  36 (uc-row M (+ p 36) 19 0 0 0)
  37 (uc-row M (+ p 37) 2 f 0 0)
  false))
(defn- fw-rows [M :vector-i64 p :i64 f :i64 h :i64 e :i64 k :i64] :bool
 (if (= k 38) true (and (fw-row M p f h e k) (fw-rows M p f h e (inc k)))))
(defn- fw-admit [M :vector-i64 f :i64 n :i64] :bool
 (and (= n 3) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
  (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (<= (vector-at M MM-FN-N) MM-FN-CAP) (not (gn-clamp-open M f))
  (>= (vector-at M MM-SIR-N) 38) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) 38))
  (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 6)
  (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-FUEL) 1)
  (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
  (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
  (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 4032)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 64))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) (- MM-FIX-CAP 1))
  (let [p (gn-fnf M f FF-SIR) h (gn-sir M (+ p 2) IF-A) e (gn-sir M (+ p 7) IF-A)]
   (and (fw-rows M p f h e 0) (qb-labels M p 38 0)
    (> e 0) (< e MM-FN-CAP) (< e (vector-at M MM-FN-N)) (not (gn-clamp-open M e))
    (> (gn-fnf M e FF-SIR) 0) (<= (gn-fnf M e FF-SIR) (- (vector-at M MM-SIR-N) 9))
    (= (gn-fnf M e FF-NPARAMS) 2) (= (gn-fnf M e FF-NSLOTS) 2)
    (= (gn-fnf M e FF-RTYPE) TY-I64) (qb-int-params M e 0 2)
    (= (gn-fnf M e FF-FUEL) 0) (sx-body? M e (gn-fnf M e FF-SIR))
    (= (gn-sir M (+ (gn-fnf M e FF-SIR) 5) IF-B) 255)
    (qb-labels M (gn-fnf M e FF-SIR) 9 0)))))
(defn- fw-store [M :vector-i64 k :i64] :vector-i64
 (if (= k 4) M
  (fw-store (-> M (gn-emit (gn-e-bf 0xd3400000 6 2 (* k 8) (+ (* k 8) 7)))
   (gn-emit (enc-str 6 3 (* k 8)))) (inc k))))
(defn- fw-transfer [M :vector-i64 f :i64] :vector-i64
