(defn- ct-fill-rows [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 32) true (and (ct-fill-row M p k) (ct-fill-rows M p (inc k)))))
(defn- ct-fill-closed [M :vector-i64 f :i64] :bool
 (and (ct-bound M f 32 5 5 5 1 4)
  (= (gn-fnf M f (+ FF-PT0 0)) 4)
  (= (gn-fnf M f (+ FF-PT0 1)) 1)
  (= (gn-fnf M f (+ FF-PT0 2)) 1)
  (= (gn-fnf M f (+ FF-PT0 3)) 1)
  (= (gn-fnf M f (+ FF-PT0 4)) 1)
