;; ADR0357 independent pure bounded byte threshold tree; existing gn-tree/MF unchanged.
;; Return exclusive tree end. Every later index bound is checked before its read.
(defn- bbt-end [M :vector-i64 p :i64 depth :i64] :i64
 (let [sn (vector-at M MM-SIR-N)]
  (if (or (< p 1) (>= p sn) (> depth 12)) 0
   (if (uc-row M p OP-CONST 0 (gn-sir M p IF-B) 0)
    (if (= (bit-and (gn-sir M p IF-B) -256) 0) (inc p) 0)
    (if (> p (- sn 4)) 0
     (let [h (gn-sir M (+ p 1) IF-B) le (gn-sir M (+ p 3) IF-B)]
      (if (not (and (> h 0) (<= h 4095)
       (uc-row M p OP-LGET 0 1 0) (uc-row M (+ p 1) OP-CONST 1 h 0)
       (uc-row M (+ p 2) OP-CMP CC-LT 0 0) (uc-row M (+ p 3) OP-BRZ 0 le 0))) 0
       (let [a (bbt-end M (+ p 4) (inc depth))]
        (if (or (<= a 0) (> a (- sn 2))) 0
         (let [lx (gn-sir M a IF-A)]
          (if (not (and (not= le lx) (uc-row M a OP-BR lx 0 0)
           (uc-row M (inc a) OP-LABEL le 0 0))) 0
           (let [b (bbt-end M (+ a 2) (inc depth))]
            (if (and (> b 0) (< b sn) (uc-row M b OP-LABEL lx 0 0)) (inc b) 0))))))))))))
)
;; These traversals run only after bbt-end proves the whole finite tree/labels.
(defn- bbt-value [M :vector-i64 p :i64 x :i64] :i64
 (if (= (gn-op M p) OP-CONST) (if (< x 0) 0 (gn-sir M p IF-B))
  (let [h (gn-sir M (inc p) IF-B) r (inc (gn-small-label M 1 (gn-sir M (+ p 3) IF-B) 0))]
   (if (< x 0) (gn-max h (gn-max (bbt-value M (+ p 4) x) (bbt-value M r x)))
    (bbt-value M (if (< x h) (+ p 4) r) x)))))





(defn- bbt-entry [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (if (not (and (= np 1) (qb-bound M f 5 1 1 2 0)
  (<= (vector-at M MM-FN-N) MM-FN-CAP) (= (gn-fnf M f FF-SIR) i)
  (= (gn-fnf M f FF-PT0) TY-I64) (= (gn-g M fr-owner) f)
  (= (gn-g M gn-f-ns) 1) (= (gn-g M gn-f-dp) 2) (= (gn-g M gn-f-leaf) 1)
  (= (bit-or (gn-g M gn-f-freg) (bit-or (gn-g M gn-f-vmode)
   (bit-or (gn-g M gn-f-fb) (bit-or (gn-g M gn-f-nsv) (bit-or (gn-g M gn-f-out)
   (bit-or (gn-g M gn-f-h) (bit-or (gn-g M gn-f-skip) (bit-or (gn-g M gn-f-dead)
   (bit-or (gn-g M 14) (vector-at M MM-ERR)))))))))) 0)
  (= (gn-sreg M 1) 0) (= (gn-g M gn-f-ctx) 1)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 16))
  (>= (vector-at M MM-FIX-N) 1) (< (vector-at M MM-FIX-N) MM-FIX-CAP)
  (> (vector-at M MM-LIT-N) 0) (< (vector-at M MM-LIT-N) MM-LIT-CAP)
  (>= (vector-at M MM-LITB-N) 0)
  (uc-row M i OP-FN f 1 1)
  (uc-row M (inc i) OP-LABEL (gn-sir M (inc i) IF-A) 0 0))) M
  (let [p (+ i 2) end (bbt-end M (+ i 2) 0)]
   (if (or (<= end p) (> end (- (vector-at M MM-SIR-N) 2))) M
    (if (not (and (uc-row M end OP-RET 0 0 0) (uc-row M (inc end) OP-END f 0 0)
      (qb-labels M i (+ (- end i) 2) 0))) M
     (let [n (inc (bbt-value M p -1))]
      (if (and (>= n 65) (<= (vector-at M MM-LITB-N) (- MM-LITB-CAP n))) (let [ln (vector-at M MM-LIT-N) lb (vector-at M MM-LITB-N)
  r (+ MM-LIT-BASE (* ln MM-LIT-W))
  low (bbt-value M p 0) high (bbt-value M p (dec n))
  m0 (do (dotimes [x n] (let [v (bbt-value M p x)] (gn-put M (+ MM-LITB-BASE (+ lb x)) v))) (-> M (gn-put (+ r LF-B) lb) (gn-put (+ r LF-LEN) n)
   (gn-put (+ r LF-TOK) 0)
   (gn-put MM-LIT-N (inc ln)) (gn-put MM-LITB-N (+ lb n)))) ]
  (-> m0 (gn-emit 0xf100001f) (gn-emit 0x5400012b)
   (gn-emit (enc-cmp-i 0 (dec n))) (gn-emit 0x5400012c)
   (gn-emit 0xf940c0f1) (gn-emit 0x8b000231)
   (gn-fix FX-LIT32 ln) (gn-emit 0xd2800010) (gn-emit 0xf2a00010)
   (gn-emit 0x38706a20) (gn-epilogue)
   (gn-emit (enc-movz 0 low 0)) (gn-epilogue)
   (gn-emit (enc-movz 0 high 0)) (gn-epilogue) (gn-gs 14 1))) M)))))))

;; ADR0357 novel fixed-field charged wrapper transfer; ordinary call pipeline retained.
(defn- cfw-bound [M :vector-i64 f :i64 n :i64 np :i64 ns :i64 dp :i64 fuel :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (<= (vector-at M MM-FN-N) MM-FN-CAP) (not (gn-clamp-open M f))
  (>= (vector-at M MM-SIR-N) n) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) n))
  (= (gn-fnf M f FF-NPARAMS) np) (= (gn-fnf M f FF-NSLOTS) ns)
  (= (gn-fnf M f FF-DEPTH) dp) (= (gn-fnf M f FF-FUEL) fuel)
  (= (gn-fnf M f FF-RTYPE) TY-VEC)))
(defn- cfw-child [M :vector-i64 g :i64] :bool
 (if (not (cfw-bound M g 11 3 3 4 1)) false
  (let [p (gn-fnf M g FF-SIR) w (gn-sir M (+ p 8) IF-A)]
   (and (= (gn-fnf M g FF-RTYPE) TY-VEC) (= (gn-fnf M g FF-PT0) TY-VEC)
    (= (gn-fnf M g (+ FF-PT0 1)) TY-I64) (= (gn-fnf M g (+ FF-PT0 2)) TY-I64)
    (uc-row M p OP-FN g 3 3) (uc-row M (+ p 1) OP-FUEL 0 0 0)
    (uc-row M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    (uc-row M (+ p 3) OP-LGET 0 1 0) (uc-row M (+ p 4) OP-LGET 1 2 0)
    (uc-row M (+ p 5) OP-LGET 2 3 0) (uc-row M (+ p 6) OP-CONST 3 255 0)
    (uc-row M (+ p 7) OP-BIN BOP-AND 2 0) (uc-row M (+ p 8) OP-CALL w 0 3)
    (uc-row M (+ p 9) OP-RET 0 0 0) (uc-row M (+ p 10) OP-END g 0 0)
    (qb-labels M p 11 0) (not= w g)
    (cfw-bound M w 9 3 3 3 1)
    (let [q (gn-fnf M w FF-SIR)]
     (and (= (gn-fnf M w FF-RTYPE) TY-VEC) (= (gn-fnf M w FF-PT0) TY-VEC)
      (= (gn-fnf M w (+ FF-PT0 1)) TY-I64) (= (gn-fnf M w (+ FF-PT0 2)) TY-I64)
      (uc-row M q OP-FN w 3 3) (uc-row M (+ q 1) OP-FUEL 0 0 0)
      (uc-row M (+ q 2) OP-LABEL (gn-sir M (+ q 2) IF-A) 0 0)
      (uc-row M (+ q 3) OP-LGET 0 1 0) (uc-row M (+ q 4) OP-LGET 1 2 0)
      (uc-row M (+ q 5) OP-LGET 2 3 0)
      (uc-row M (+ q 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
      (uc-row M (+ q 7) OP-RET 0 0 0) (uc-row M (+ q 8) OP-END w 0 0)
      (qb-labels M q 9 0)))))))
(defn- cfw-shape [M :vector-i64 f :i64] :i64
 (if (not (cfw-bound M f 9 2 2 3 1)) 0
  (let [p (gn-fnf M f FF-SIR) field (gn-sir M (+ p 4) IF-B) g (gn-sir M (+ p 6) IF-A)]
   (if (and (>= field 0) (<= field 4095) (not= f g)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (uc-row M p OP-FN f 2 2) (uc-row M (+ p 1) OP-FUEL 0 0 0)
    (uc-row M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    (uc-row M (+ p 3) OP-LGET 0 1 0) (uc-row M (+ p 4) OP-CONST 1 field 0)
    (uc-row M (+ p 5) OP-LGET 2 2 0) (uc-row M (+ p 6) OP-CALL g 0 3)
    (uc-row M (+ p 7) OP-RET 0 0 0) (uc-row M (+ p 8) OP-END f 0 0)
    (qb-labels M p 9 0) (cfw-child M g)) (inc field) 0))))
(defn- cfw-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (or (not= n 2) (< t 0) (> t 5) (not= (gn-g M gn-f-h) (+ t 2))
  (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0) (not= (gn-g M gn-f-vmode) 0)
  (not= (gn-g M gn-f-ctx) 1) (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-dead) 0)
  (< (gn-g M gn-f-ns) 2) (>= (gn-g M gn-f-ns) gn-cap)
  (< (gn-g M gn-f-dp) (+ t 2)) (> (gn-g M gn-f-dp) gn-cap)
  (< (gn-g M gn-f-nsv) 0) (> (gn-g M gn-f-nsv) 10)
  (<= (gn-g M gn-f-fb) 0) (> (gn-g M gn-f-fb) 32768)
  (not= (bit-and (gn-g M gn-f-fb) 15) 0)
  (not= (vector-at M MM-ERR) 0) (<= i 0) (>= i (dec (vector-at M MM-SIR-N)))
  (not (sb-owner M i)) (not (uc-row M i OP-CALL f t 2))
  (= (gn-op M (inc i)) OP-RET) (= (gn-op M (inc i)) OP-RES2)
  (< (vector-at M MM-CODE-N) 0) (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 48))
  (< (vector-at M MM-FIX-N) 1) (> (vector-at M MM-FIX-N) MM-FIX-CAP)) 0
  (cfw-shape M f)))
;; Shared entry precedes private fuel snapshot and both private cuts; fresh checks follow.
(defn- cfw-emit [M :vector-i64 field1 :i64] :vector-i64
 (-> M (gn-op-fuel) (gn-mov 6 0) (gn-emit (enc-ldr 8 7 CTX-FUEL))
  (gn-mask-charge) (gn-mov 0 1) (gn-emit (gn-e-bf 0xd3400000 0 0 0 7))
  (gn-mask-charge) (gn-mov-imm 1 (dec field1)) (gn-hchk 6 312 320) (gn-vidx 1)
  (gn-emit (gn-e-strr3 0 16 17)) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov 0 6)))

;; Closed full64 signed interval predicate. No effects/charges or input-domain assumption.
(defn- cip-shape [M :vector-i64 p :i64 f :i64] :bool
 (let [head (gn-sir M (+ p 1) IF-A) join (gn-sir M (+ p 5) IF-B)
       lo (gn-sir M (+ p 3) IF-B) hi (gn-sir M (+ p 7) IF-B)]
  (and (>= lo 0) (<= lo 4095) (>= hi lo) (<= hi 4095) (not= head join)
   (nr-label M head (+ p 1) 65536) (nr-label M join (+ p 9) 65537)
   (uc-row M p OP-FN f 1 1)
   (uc-row M (+ p 1) OP-LABEL head 0 0)
   (uc-row M (+ p 2) OP-LGET 0 1 0)
   (uc-row M (+ p 3) OP-CONST 1 lo 0)
   (uc-row M (+ p 4) OP-CMP CC-GE 0 0)
   (uc-row M (+ p 5) OP-BRZ 0 join 0)
   (uc-row M (+ p 6) OP-LGET 0 1 0)
   (uc-row M (+ p 7) OP-CONST 1 hi 0)
   (uc-row M (+ p 8) OP-CMP CC-LE 0 0)
   (uc-row M (+ p 9) OP-LABEL join 0 0)
   (uc-row M (+ p 10) OP-RET 0 0 0)
   (uc-row M (+ p 11) OP-END f 0 0))))
(defn- cip-safe [M :vector-i64 p :i64 f :i64 np :i64] :bool
 (if (or (not= np 1) (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))
  (> (vector-at M MM-FN-N) MM-FN-CAP) (<= p 0) (< (vector-at M MM-SIR-N) 12)
  (> (vector-at M MM-SIR-N) MM-SIR-CAP) (> p (- (vector-at M MM-SIR-N) 12))) false
  (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 1)
   (= (gn-fnf M f FF-NSLOTS) 1) (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-FUEL) 0)
   (= (gn-fnf M f FF-PT0) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-BOOL) (not (gn-clamp-open M f))
   (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 1) (= (gn-g M gn-f-dp) 2)
   (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-out) 0) (= (gn-sreg M 1) 0)
   (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
   (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 4))
   (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
   (cip-shape M p f))))
(defn- cip-entry [M :vector-i64 p :i64 f :i64 np :i64] :vector-i64
 (if (cip-safe M p f np)
  (let [lo (gn-sir M (+ p 3) IF-B) hi (gn-sir M (+ p 7) IF-B)]
   (-> M (gn-emit (enc-sub-i 9 0 lo)) (gn-emit (enc-cmp-i 9 (- hi lo)))
    (gn-emit (enc-cset 0 9)) (gn-emit (enc-ret)))) M))

;; ADR0357 one-off novel call-edge rule: reuse closed emitted byte lookup, no payload duplication.
(defn- dt-fixes [M :vector-i64 a :i64 k :i64 found :i64] :i64
 (if (>= k (vector-at M MM-FIX-N)) found
  (let [at (vector-at M (+ MM-FIX-BASE (* k MM-FIX-W) XF-AT))]
   (if (and (>= at a) (< at (+ a 11)))
    (let [kind (vector-at M (+ MM-FIX-BASE (* k MM-FIX-W) XF-KIND))
     target (vector-at M (+ MM-FIX-BASE (* k MM-FIX-W) XF-TARGET))
     aux (vector-at M (+ MM-FIX-BASE (* k MM-FIX-W) XF-AUX))]
     (if (and (= found 0) (= at (+ a 5)) (= kind FX-LIT32) (= aux 0)
       (> target 0) (< target (vector-at M MM-LIT-N)))
      (dt-fixes M a (inc k) target) 0))
    (dt-fixes M a (inc k) found)))))
(defn- dt-labels [M :vector-i64 a :i64 k :i64] :bool
 (if (>= k (vector-at M MM-LABEL-N)) true
  (let [at (vector-at M (+ MM-LABEL-BASE k))]
   (and (not (and (> at a) (< at (+ a 11)))) (dt-labels M a (inc k))))))
(defn- dt-bytes [M :vector-i64 p :i64 base :i64 n :i64 k :i64] :bool
 (or (= k n)
  (let [v (gn-sir M (+ p 6 (* 7 k)) IF-B)]
   (and (>= v 0) (<= v 255) (= (vector-at M (+ MM-LITB-BASE base k)) v)
    (dt-bytes M p base n (inc k))))))
(defn- dt-prefix [M :vector-i64 a :i64 n :i64] :bool
 (and (= (vector-at M (+ MM-CODE-BASE a)) (enc-mov-r 9 0))
  (= (vector-at M (+ MM-CODE-BASE a 1)) (enc-cmp-i 9 n))
  (= (vector-at M (+ MM-CODE-BASE a 2)) (enc-bcond (enc-cond-hs) 7))
  (= (vector-at M (+ MM-CODE-BASE a 3)) (enc-ldr 17 7 CTX-CODE-BASE))
  (= (vector-at M (+ MM-CODE-BASE a 4)) (gn-e-addsl 17 17 9 0))
  (= (vector-at M (+ MM-CODE-BASE a 5)) (enc-movz 16 0 0))
  (= (vector-at M (+ MM-CODE-BASE a 6)) (enc-movk 16 0 1))
  (= (vector-at M (+ MM-CODE-BASE a 7)) 0x38706a20)
  (= (vector-at M (+ MM-CODE-BASE a 8)) (enc-ret))
  (= (vector-at M (+ MM-CODE-BASE a 9)) (enc-movz 0 0 0))
  (= (vector-at M (+ MM-CODE-BASE a 10)) (enc-ret))))
(defn- dt-admit [M :vector-i64 i :i64 f :i64 t :i64 argc :i64] :i64
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N) cn (vector-at M MM-CODE-N)
   xn (vector-at M MM-FIX-N) ln (vector-at M MM-LIT-N) lb (vector-at M MM-LITB-N)
   labels (vector-at M MM-LABEL-N) owner (gn-g M fr-owner)]
  (if (or (< sn 21) (> sn MM-SIR-CAP) (<= fnn 0) (> fnn MM-FN-CAP)
   (<= f 0) (>= f fnn) (>= f MM-FN-CAP) (<= owner 0) (>= owner fnn) (= owner f) (< i 1) (>= i (dec sn))
   (not= argc 1) (< t 0) (> t 6) (not= (vector-at M MM-ERR) 0)
   (< cn 11) (> cn (- MM-CODE-CAP 16)) (< xn 1) (>= xn MM-FIX-CAP)
   (< ln 2) (> ln MM-LIT-CAP) (< lb 0) (> lb MM-LITB-CAP)
   (< labels 1) (> labels MM-LABEL-CAP) (gn-clamp-open M f)
   (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-dead) 0)
   (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
   (not= (gn-g M gn-f-vmode) 0) (not= (gn-g M gn-f-ctx) 1)
   (not= (gn-g M gn-f-h) (+ t 1)) (< (gn-g M gn-f-dp) (+ t 1))
   (> (gn-g M gn-f-dp) gn-cap) (< (gn-g M gn-f-ns) 0) (> (gn-g M gn-f-ns) gn-cap)
   (<= (gn-g M gn-f-fb) 0) (> (gn-g M gn-f-fb) 32768)
   (not= (bit-and (gn-g M gn-f-fb) 15) 0)
   (< (gn-g M gn-f-nsv) 1) (> (gn-g M gn-f-nsv) 10) (not= (gn-g M gn-f-out) 0)
   (not (uc-row M i OP-CALL f t 1)) (= (gn-op M (inc i)) OP-RET)
   (= (gn-op M (inc i)) OP-RES2)) 0
   (let [p (gn-fnf M f FF-SIR) a (gn-fnf M f FF-CODE)]
    (if (or (<= p 0) (> p (- sn 21)) (< a 0) (> a (- cn 11))
      (not= (gn-fnf M f FF-NPARAMS) 1) (not= (gn-fnf M f FF-NSLOTS) 1)
      (not= (gn-fnf M f FF-DEPTH) 2) (not= (gn-fnf M f FF-FUEL) 0)
      (not= (gn-fnf M f FF-PT0) TY-I64) (not= (gn-fnf M f FF-RTYPE) TY-I64)
      (<= (gn-fnf M owner FF-SIR) 0) (>= (gn-fnf M owner FF-SIR) i)
      (not= (gn-fnf M owner FF-NSLOTS) (gn-g M gn-f-ns))
      (not= (gn-fnf M owner FF-DEPTH) (gn-g M gn-f-dp))
      (< (gn-fnf M owner FF-NPARAMS) 0) (> (gn-fnf M owner FF-NPARAMS) (gn-g M gn-f-ns))
      (not (gn-dot-at? M (gn-fnf M owner FF-SIR) OP-FN owner
        (gn-fnf M owner FF-NPARAMS) (gn-g M gn-f-ns)))
      (<= (gn-fnf M owner FF-CODE) a) (> (gn-fnf M owner FF-CODE) cn)) 0
     (let [n (dl-shape M p f)]
      (if (or (< n 2) (> n 4095) (>= (+ p 4 (* n 8)) i) (not= (gn-sir M (+ p 3) IF-B) 0)
        (not= (gn-sir M (+ p 2 (* 7 n)) IF-B) 0) (not (dt-prefix M a n))
        (not (dt-labels M a 1))) 0
       (let [literal (dt-fixes M a 1 0)]
        (if (= literal 0) 0
         (let [r (+ MM-LIT-BASE (* literal MM-LIT-W))
           base (vector-at M (+ r LF-B)) len (vector-at M (+ r LF-LEN))]
          (if (and (= len n) (>= base 0) (<= base (- lb n))
              (= (vector-at M (+ r LF-TOK)) 0) (dt-bytes M p base n 0)) literal 0)))))))))))
(defn- dt-emit [M :vector-i64 f :i64 literal :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) n (dl-shape M p f)
   m0 (gn-emit M (enc-cmp-i 0 n)) outside (vector-at m0 MM-CODE-N)
   m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0))
    (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-emit (gn-e-addsl 17 17 0 0))
    (gn-fix FX-LIT32 literal) (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
    (gn-emit 0x38706a20)) jump (vector-at m1 MM-CODE-N)
   m2 (gn-emit m1 (enc-b 0)) out (vector-at m2 MM-CODE-N)
   m3 (gn-emit m2 (enc-movz 0 0 0)) end (vector-at m3 MM-CODE-N)]
  (-> m3 (gn-put (+ MM-CODE-BASE outside) (enc-bcond (enc-cond-hs) (- out outside)))
    (gn-put (+ MM-CODE-BASE jump) (enc-b (- end jump))))))

;; Closed charged short-circuit checked affine reader; shared publication before any guest read.
(defn- scv-paid [M :vector-i64 f :i64] :bool
 (let [a (gn-fnf M f FF-CODE) e (vector-at M MM-CODE-N)]
  (and (> a 0) (<= a (- e 12))
   (= (vector-at M (+ MM-CODE-BASE a)) (enc-stp-pre 29 30 31 -16))
   (= (vector-at M (+ MM-CODE-BASE a 1)) (enc-mov-sp 29 31))
   (= (vector-at M (+ MM-CODE-BASE a 2)) (enc-sub-i 31 31 80))
   (= (vector-at M (+ MM-CODE-BASE a 3)) (enc-stp 19 20 31 0))
   (= (vector-at M (+ MM-CODE-BASE a 4)) (enc-str 7 31 72))
   (= (vector-at M (+ MM-CODE-BASE a 5)) (enc-mov-r 20 0))
   (= (vector-at M (+ MM-CODE-BASE a 6)) (enc-mov-r 19 1))
   (= (vector-at M (+ MM-CODE-BASE a 7)) (enc-ldr 16 7 CTX-FUEL))
   (= (vector-at M (+ MM-CODE-BASE a 8)) (enc-subs-i 16 16 1))
   (= (vector-at M (+ MM-CODE-BASE a 9)) (enc-bcond (enc-cond-hs) 2))
   (= (vector-at M (+ MM-CODE-BASE a 10)) (enc-brk 0))
   (= (vector-at M (+ MM-CODE-BASE a 11)) (enc-str 16 7 CTX-FUEL)))))
(defn- scv-root [M :vector-i64 f :i64] :bool
 (let [p (gn-fnf M f FF-SIR) sn (vector-at M MM-SIR-N)]
  (if (or (<= p 0) (> p (- sn 18))) false
   (let [head (gn-sir M (+ p 2) IF-A) join (gn-sir M (+ p 7) IF-B)
         child (gn-sir M (+ p 11) IF-A) field (gn-sir M (+ p 10) IF-B)
         value (gn-sir M (+ p 13) IF-B)]
    (and (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
     (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-FUEL) 1)
     (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
     (= (gn-fnf M f FF-RTYPE) TY-BOOL) (>= field 0) (<= field 4095)
     (>= value 0) (<= value 4095)
     (gn-dot-at? M p OP-FN f 2 2) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
     (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
     (gn-dot-at? M (+ p 3) OP-LGET 0 2 0) (gn-dot-at? M (+ p 4) OP-CONST 1 0 0)
     (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0) (gn-dot-at? M (+ p 6) OP-UN UOP-NOT 0 0)
     (gn-dot-at? M (+ p 7) OP-BRZ 0 join 0) (gn-dot-at? M (+ p 8) OP-LGET 0 1 0)
     (gn-dot-at? M (+ p 9) OP-LGET 1 2 0) (gn-dot-at? M (+ p 10) OP-CONST 2 field 0)
     (gn-dot-at? M (+ p 11) OP-CALL child 1 2)
     (gn-dot-at? M (+ p 12) OP-RT RT-VECTOR-AT 0 2)
     (gn-dot-at? M (+ p 13) OP-CONST 1 value 0) (gn-dot-at? M (+ p 14) OP-CMP CC-EQ 0 0)
     (gn-dot-at? M (+ p 15) OP-LABEL join 0 0)
     (gn-dot-at? M (+ p 16) OP-RET 0 0 0) (gn-dot-at? M (+ p 17) OP-END f 0 0)
     (nr-label M head (+ p 2) 65536) (nr-label M join (+ p 15) 65537)
     (lm-affine M child) (scv-paid M f))))))
(defn- scv-safe [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :bool
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N) cn (vector-at M MM-CODE-N)]
  (if (or (< sn 18) (> sn MM-SIR-CAP) (<= fnn 0) (> fnn MM-FN-CAP)
   (<= f 0) (>= f fnn) (>= f MM-FN-CAP) (gn-clamp-open M f)
   (< i 1) (>= i (dec sn)) (not= n 2) (< t 0) (> t 5)
   (not= (vector-at M MM-ERR) 0) (< (vector-at M MM-FIX-N) 0)
   (> (vector-at M MM-FIX-N) MM-FIX-CAP) (not= (gn-g M gn-f-skip) 0)
   (not= (gn-g M gn-f-dead) 0) (not= (gn-g M gn-f-leaf) 0)
   (not= (gn-g M gn-f-vmode) 0) (not= (gn-g M gn-f-freg) 0)
   (not= (gn-g M gn-f-ctx) 1) (not= (gn-g M gn-f-h) (+ t 2))
   (> (gn-g M gn-f-h) gn-cap) (< (gn-g M gn-f-dp) (+ t 2))
   (> (gn-g M gn-f-dp) gn-cap) (< (gn-g M gn-f-ns) 0)
   (> (gn-g M gn-f-ns) gn-cap) (<= (gn-g M gn-f-fb) 0)
   (> (gn-g M gn-f-fb) 32768) (not= (bit-and (gn-g M gn-f-fb) 15) 0)
   (< (gn-g M gn-f-nsv) 1) (> (gn-g M gn-f-nsv) 10)
   (not= (gn-g M gn-f-out) 0) (< cn 0) (> cn (- MM-CODE-CAP 64))
   (not (uc-row M i OP-CALL f t 2)) (= (gn-op M (inc i)) OP-RET)
   (= (gn-op M (inc i)) OP-RES2)) false
   (scv-root M f))))
(defn- scv-emit [M :vector-i64 f :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) child (gn-sir M (+ p 11) IF-A)
        a (gn-fnf M child FF-SIR) base (gn-sir M (+ a 2) IF-B)
        stride (gn-sir M (+ a 6) IF-B) field (gn-sir M (+ p 10) IF-B)
        value (gn-sir M (+ p 13) IF-B)
        m0 (gn-op-fuel M) zero (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-cbz 1 0)) (gn-emit (enc-sub-i 1 1 1))
         (gn-mov-imm 17 stride) (gn-emit (enc-mul 1 1 17))
         (gn-emit (enc-add-i 1 1 base)) (gn-emit (enc-add-i 1 1 field))
         (gn-vread 0 1 0) (gn-emit (enc-cmp-i 0 value))
         (gn-emit (enc-cset 0 (enc-cond-eq)))) jump (vector-at m1 MM-CODE-N)
        m2 (gn-emit m1 (enc-b 0)) z (vector-at m2 MM-CODE-N)
        m3 (gn-mov-imm m2 0 0) end (vector-at m3 MM-CODE-N)]
  (-> m3 (gn-put (+ MM-CODE-BASE zero) (enc-cbz 1 (- z zero)))
   (gn-put (+ MM-CODE-BASE jump) (enc-b (- end jump))))))

;; Generic exact fixed-field bit reservoir, non-refill branch only.
;; Post original entry charge; fallback untouched before all extra debits/stores.
(defn- nr-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 68) true
  (let [head (gn-sir M (+ p 2) IF-A) le (gn-sir M (+ p 11) IF-B)
        lj (gn-sir M (+ p 13) IF-A) refill (gn-sir M (+ p 23) IF-B)
        done (gn-sir M (+ p 41) IF-A) bits (gn-sir M (+ p 4) IF-B)
        left (gn-sir M (+ p 19) IF-B) output (gn-sir M (+ p 34) IF-B)
        g (gn-sir M (+ p 26) IF-A) w16 (gn-sir M (+ p 37) IF-A)
        w8 (gn-sir M (+ p 40) IF-A) w (gn-sir M (+ p 65) IF-A)]
   (and (case k
   0 (gn-dot-at? M (+ p 0) OP-FN f 1 4)
   1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
   2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
   3 (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
   4 (gn-dot-at? M (+ p 4) OP-CONST 1 bits 0)
   5 (gn-dot-at? M (+ p 5) OP-RT 176 0 2)
   6 (gn-dot-at? M (+ p 6) OP-CONST 1 32768 0)
   7 (gn-dot-at? M (+ p 7) OP-BIN 5 0 0)
   8 (gn-dot-at? M (+ p 8) OP-CONST 1 0 0)
   9 (gn-dot-at? M (+ p 9) OP-CMP 1 0 0)
   10 (gn-dot-at? M (+ p 10) OP-UN 1 0 0)
   11 (gn-dot-at? M (+ p 11) OP-BRZ 0 le 0)
   12 (gn-dot-at? M (+ p 12) OP-CONST 0 1 0)
   13 (gn-dot-at? M (+ p 13) OP-BR lj 0 0)
   14 (gn-dot-at? M (+ p 14) OP-LABEL le 0 0)
   15 (gn-dot-at? M (+ p 15) OP-CONST 0 0 0)
   16 (gn-dot-at? M (+ p 16) OP-LABEL lj 0 0)
   17 (gn-dot-at? M (+ p 17) OP-LSET 2 0 0)
   18 (gn-dot-at? M (+ p 18) OP-LGET 0 1 0)
   19 (gn-dot-at? M (+ p 19) OP-CONST 1 left 0)
   20 (gn-dot-at? M (+ p 20) OP-RT 176 0 2)
   21 (gn-dot-at? M (+ p 21) OP-CONST 1 0 0)
   22 (gn-dot-at? M (+ p 22) OP-CMP 1 0 0)
   23 (gn-dot-at? M (+ p 23) OP-BRZ 0 refill 0)
   24 (gn-dot-at? M (+ p 24) OP-LGET 0 1 0)
   25 (gn-dot-at? M (+ p 25) OP-CONST 1 1 0)
   26 (gn-dot-at? M (+ p 26) OP-CALL g 0 2)
   27 (gn-dot-at? M (+ p 27) OP-LSET 3 0 0)
   28 (gn-dot-at? M (+ p 28) OP-LGET 0 3 0)
   29 (gn-dot-at? M (+ p 29) OP-CONST 1 bits 0)
   30 (gn-dot-at? M (+ p 30) OP-LGET 2 3 0)
   31 (gn-dot-at? M (+ p 31) OP-CONST 3 bits 0)
   32 (gn-dot-at? M (+ p 32) OP-RT 176 2 2)
   33 (gn-dot-at? M (+ p 33) OP-LGET 3 3 0)
   34 (gn-dot-at? M (+ p 34) OP-CONST 4 output 0)
   35 (gn-dot-at? M (+ p 35) OP-RT 176 3 2)
   36 (gn-dot-at? M (+ p 36) OP-BIN 6 2 0)
   37 (gn-dot-at? M (+ p 37) OP-CALL w16 0 3)
   38 (gn-dot-at? M (+ p 38) OP-CONST 1 left 0)
   39 (gn-dot-at? M (+ p 39) OP-CONST 2 8 0)
   40 (gn-dot-at? M (+ p 40) OP-CALL w8 0 3)
   41 (gn-dot-at? M (+ p 41) OP-BR done 0 0)
   42 (gn-dot-at? M (+ p 42) OP-LABEL refill 0 0)
   43 (gn-dot-at? M (+ p 43) OP-LGET 0 1 0)
   44 (gn-dot-at? M (+ p 44) OP-LABEL done 0 0)
   45 (gn-dot-at? M (+ p 45) OP-LSET 3 0 0)
   46 (gn-dot-at? M (+ p 46) OP-LGET 0 3 0)
   47 (gn-dot-at? M (+ p 47) OP-CONST 1 left 0)
   48 (gn-dot-at? M (+ p 48) OP-LGET 2 3 0)
   49 (gn-dot-at? M (+ p 49) OP-CONST 3 left 0)
   50 (gn-dot-at? M (+ p 50) OP-RT 176 2 2)
   51 (gn-dot-at? M (+ p 51) OP-CONST 3 1 0)
   52 (gn-dot-at? M (+ p 52) OP-BIN 2 2 0)
   53 (gn-dot-at? M (+ p 53) OP-CALL w8 0 3)
   54 (gn-dot-at? M (+ p 54) OP-CONST 1 bits 0)
   55 (gn-dot-at? M (+ p 55) OP-LGET 2 3 0)
   56 (gn-dot-at? M (+ p 56) OP-CONST 3 bits 0)
   57 (gn-dot-at? M (+ p 57) OP-RT 176 2 2)
   58 (gn-dot-at? M (+ p 58) OP-CONST 3 2 0)
   59 (gn-dot-at? M (+ p 59) OP-BIN 3 2 0)
   60 (gn-dot-at? M (+ p 60) OP-CALL w16 0 3)
   61 (gn-dot-at? M (+ p 61) OP-LSET 4 0 0)
   62 (gn-dot-at? M (+ p 62) OP-LGET 0 4 0)
   63 (gn-dot-at? M (+ p 63) OP-CONST 1 output 0)
   64 (gn-dot-at? M (+ p 64) OP-LGET 2 2 0)
   65 (gn-dot-at? M (+ p 65) OP-CALL w 0 3)
   66 (gn-dot-at? M (+ p 66) OP-RET 0 0 0)
   67 (gn-dot-at? M (+ p 67) OP-END f 0 0)
    false) (nr-shape M p f (inc k))))))
(defn- nr-label [M :vector-i64 l :i64 at :i64 uses :i64] :bool
 (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) at) (= (bd-count M 1 l 0 0) uses)))
(defn- nr-writer [M :vector-i64 g :i64 mask :i64] :bool
 (if (or (<= g 0) (>= g (vector-at M MM-FN-N)) (>= g MM-FN-CAP) (gn-clamp-open M g)) false
  (let [p (gn-fnf M g FF-SIR) sn (vector-at M MM-SIR-N) n (if (= mask 0) 9 11)]
   (and (> p 0) (>= sn n) (<= sn MM-SIR-CAP) (<= p (- sn n)) (<= p (- MM-SIR-CAP n))
    (= (gn-fnf M g FF-NPARAMS) 3) (= (gn-fnf M g FF-NSLOTS) 3)
    (= (gn-fnf M g FF-PT0) TY-VEC) (= (gn-fnf M g (+ FF-PT0 1)) TY-I64)
    (= (gn-fnf M g (+ FF-PT0 2)) TY-I64) (= (gn-fnf M g FF-RTYPE) TY-VEC)
    (= (gn-fnf M g FF-FUEL) 1)
    (gn-dot-at? M p OP-FN g 3 3) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    (nr-label M (gn-sir M (+ p 2) IF-A) (+ p 2) 65536)
    (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 5) OP-LGET 2 3 0)
    (if (= mask 0)
     (and (= (gn-fnf M g FF-DEPTH) 3)
      (gn-dot-at? M (+ p 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
      (gn-dot-at? M (+ p 7) OP-RET 0 0 0) (gn-dot-at? M (+ p 8) OP-END g 0 0))
     (and (= (gn-fnf M g FF-DEPTH) 4)
      (gn-dot-at? M (+ p 6) OP-CONST 3 mask 0) (gn-dot-at? M (+ p 7) OP-BIN BOP-AND 2 0)
      (= (gn-op M (+ p 8)) OP-CALL) (= (gn-sir M (+ p 8) IF-B) 0) (= (gn-sir M (+ p 8) IF-C) 3)
      (nr-writer M (gn-sir M (+ p 8) IF-A) 0)
      (gn-dot-at? M (+ p 9) OP-RET 0 0 0) (gn-dot-at? M (+ p 10) OP-END g 0 0)))))))
(defn- nr-admit [M :vector-i64 i :i64] :bool
 (if (or (< i 2) (< (vector-at M MM-SIR-N) 68) (> (vector-at M MM-SIR-N) MM-SIR-CAP)
         (> i (- MM-SIR-CAP 67)) (> i (- (vector-at M MM-SIR-N) 67))
         (> (vector-at M MM-FN-N) MM-FN-CAP) (not= (vector-at M MM-ERR) 0)
         (< (vector-at M MM-FIX-N) 0) (> (vector-at M MM-FIX-N) MM-FIX-CAP)
         (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-dead) 0)
         (not= (gn-g M gn-f-ctx) 1)
         (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
         (<= (gn-g M gn-f-fb) 0) (> (gn-g M gn-f-fb) 32768)
         (not= (bit-and (gn-g M gn-f-fb) 15) 0)
         (< (gn-g M gn-f-nsv) 1) (> (gn-g M gn-f-nsv) 10)
         (not= (gn-g M gn-f-out) 0) (not= (gn-g M gn-f-vmode) 0)
         (not= (gn-g M gn-f-h) 0) (not= (gn-g M gn-f-ns) 4)
         (not= (gn-g M gn-f-dp) 5) (< (vector-at M MM-CODE-N) 0)
         (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 192))) false
  (let [f (gn-g M fr-owner) p (dec i)]
   (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP)
           (gn-clamp-open M f) (not= (gn-fnf M f FF-SIR) p)) false
    (let [b (gn-sir M (+ p 4) IF-B) c (gn-sir M (+ p 19) IF-B) o (gn-sir M (+ p 34) IF-B)]
     (and (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-NSLOTS) 4)
       (= (gn-fnf M f FF-DEPTH) 5) (= (gn-fnf M f FF-FUEL) 1)
       (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f FF-RTYPE) TY-VEC)
       (>= (gn-sreg M 1) 19) (<= (gn-sreg M 1) (+ 18 (gn-g M gn-f-nsv)))
       (>= b 0) (<= b 4094) (>= c 0) (<= c 4094) (>= o 0) (<= o 4094)
       (not= b c) (not= b o) (not= c o)
       (nr-shape M p f 0)
       (nr-writer M (gn-sir M (+ p 40) IF-A) 255)
       (nr-writer M (gn-sir M (+ p 37) IF-A) 65535)
       (nr-writer M (gn-sir M (+ p 65) IF-A) 0)
       (nr-label M (gn-sir M (+ p 2) IF-A) (+ p 2) 65536)
       (nr-label M (gn-sir M (+ p 11) IF-B) (+ p 14) 65537)
       (nr-label M (gn-sir M (+ p 13) IF-A) (+ p 16) 65537)
       (nr-label M (gn-sir M (+ p 23) IF-B) (+ p 42) 65537)
       (nr-label M (gn-sir M (+ p 41) IF-A) (+ p 44) 65537)))))))
;; Complete pre-effect span guards; cold body owns all unsupported/trapping inputs.
;; Every post-PUB accessor/writer repeats original descriptor validation/read.
(defn- nr-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) b (gn-sir M (+ p 4) IF-B) c (gn-sir M (+ p 19) IF-B)
  o (gn-sir M (+ p 34) IF-B) last (gn-max b (gn-max c o)) rv (gn-sreg M 1)
  m0 (-> M (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) h (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (gn-e-lsr 6 17 60))) ds (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-cbnz 6 0)) (gn-emit (enc-ldr 16 7 320))
   (gn-emit (gn-e-addsl 6 16 17 4)) (gn-emit (enc-cmp-r 6 16))) da (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-add-i 17 6 15))
   (gn-emit (enc-cmp-r 17 6))) dl (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldp 17 12 6 0))
   (gn-emit (enc-cmp-i 12 (inc last)))) l (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-add-i 12 17 last))
   (gn-emit (enc-cmp-r 12 17))) ow (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (gn-e-lsr 6 12 61))) sc (vector-at m6 MM-CODE-N)
  m7 (-> m6 (gn-emit (enc-cbnz 6 0)) (gn-emit (enc-ldr 9 7 328))
   (gn-emit (gn-e-addsl 12 9 12 3)) (gn-emit (enc-cmp-r 12 9))) pw (vector-at m7 MM-CODE-N)
  m8 (-> m7 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-add-i 6 12 7))
   (gn-emit (enc-cmp-r 6 12))) ww (vector-at m8 MM-CODE-N)
  ;; Original first bits accessor precedes count accessor. No state is published.
  m9 (-> m8 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (gn-e-addsl 9 9 17 3))
   (gn-emit (enc-ldr 11 9 (* b 8))) (gn-emit (gn-e-bf 0xd3400000 10 11 15 15))
   (gn-emit (enc-ldr 12 9 (* c 8))) (gn-emit (enc-sub-i 6 12 1))
   (gn-emit (enc-cmp-i 6 8))) count (vector-at m9 MM-CODE-N)
  ;; Each masked writer's private entry and underlying plain writer charge precede checks/store.
  m10 (-> m9 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-sub-i 12 12 1))
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mask-charge) (gn-mask-charge)
   (gn-mov-imm 6 c) (gn-hchk rv 312 320) (gn-vidx 6)
   (gn-emit (gn-e-strr3 12 16 17)) (gn-emit (enc-str 8 7 CTX-FUEL))
   ;; After count publication: original fresh bits read, with fresh descriptor and bounds.
   (gn-mov-imm 6 b) (gn-hchk rv 312 320) (gn-vidx 6)
   (gn-emit (gn-e-ldrr 0 16 17 1)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
   (gn-mask-charge) (gn-emit (gn-e-bf 0xd3400000 0 0 63 14)) (gn-mask-charge)
   (gn-hchk rv 312 320) (gn-vidx 6) (gn-emit (gn-e-strr3 0 16 17))
   (gn-emit (enc-str 8 7 CTX-FUEL))
   ;; After bits publication: original plain writer's fresh descriptor/index check.
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mask-charge) (gn-mov-imm 6 o)
   (gn-hchk rv 312 320) (gn-vidx 6) (gn-emit (gn-e-strr3 10 16 17))
   (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov 0 rv) (gn-epilogue)
   (gn-gs gn-f-dead 0)) cold (vector-at m10 MM-CODE-N)]
  (-> m10 (gn-dot-patch h cold (enc-cond-hs))
   (gn-put (+ MM-CODE-BASE ds) (enc-cbnz 6 (- cold ds)))
   (gn-dot-patch da cold (enc-cond-lo)) (gn-dot-patch dl cold (enc-cond-lo))
   (gn-dot-patch l cold (enc-cond-lo)) (gn-dot-patch ow cold (enc-cond-lo))
   (gn-put (+ MM-CODE-BASE sc) (enc-cbnz 6 (- cold sc)))
   (gn-dot-patch pw cold (enc-cond-lo)) (gn-dot-patch ww cold (enc-cond-lo))
   (gn-dot-patch count cold (enc-cond-hs)))))
(defn- nr-entry [M :vector-i64 i :i64] :vector-i64
 (if (nr-admit M i) (nr-emit M i) M))

;; Closed 32-bit-limb unsigned wide product. Only arithmetic rows replaced.
;; MUL/UMULH do not change flags. Original vector allocation and all debits remain.
(defn- gn-e-umulh [d :i64 n :i64 m :i64] :i64 (enc-rrr 0x9bc07c00 d n m))
(defn- wp-home? [M :vector-i64 s :i64] :bool
 (let [r (gn-sreg M s)] (or (= r -1) (and (>= r 19) (<= r 28) (<= r (+ 18 (gn-g M gn-f-nsv)))))))
(defn- wp-load [M :vector-i64 r :i64 s :i64] :vector-i64
 (let [q (gn-sreg M s)] (if (>= q 0) (gn-mov M r q) (gn-ld M r s))))
(defn- wp-store [M :vector-i64 r :i64 s :i64] :vector-i64
 (let [q (gn-sreg M s)] (if (>= q 0) (gn-mov M q r) (gn-st M r s))))
(defn- wp-shape [M :vector-i64 p :i64 f :i64 lab :i64] :bool
 (and (gn-dot-at? M (+ p 0) 1 f 2 16)
      (gn-dot-at? M (+ p 1) 9 lab 0 0)
      (gn-dot-at? M (+ p 2) 4 0 1 0)
      (gn-dot-at? M (+ p 3) 3 1 4294967295 0)
      (gn-dot-at? M (+ p 4) 6 5 0 0)
      (gn-dot-at? M (+ p 5) 5 3 0 0)
      (gn-dot-at? M (+ p 6) 4 0 1 0)
      (gn-dot-at? M (+ p 7) 3 1 32 0)
      (gn-dot-at? M (+ p 8) 6 9 0 0)
      (gn-dot-at? M (+ p 9) 5 4 0 0)
      (gn-dot-at? M (+ p 10) 4 0 2 0)
      (gn-dot-at? M (+ p 11) 3 1 4294967295 0)
      (gn-dot-at? M (+ p 12) 6 5 0 0)
      (gn-dot-at? M (+ p 13) 5 5 0 0)
      (gn-dot-at? M (+ p 14) 4 0 2 0)
      (gn-dot-at? M (+ p 15) 3 1 32 0)
      (gn-dot-at? M (+ p 16) 6 9 0 0)
      (gn-dot-at? M (+ p 17) 5 6 0 0)
      (gn-dot-at? M (+ p 18) 4 0 3 0)
      (gn-dot-at? M (+ p 19) 4 1 5 0)
      (gn-dot-at? M (+ p 20) 6 3 0 0)
      (gn-dot-at? M (+ p 21) 5 7 0 0)
      (gn-dot-at? M (+ p 22) 4 0 7 0)
      (gn-dot-at? M (+ p 23) 3 1 4294967295 0)
      (gn-dot-at? M (+ p 24) 6 5 0 0)
      (gn-dot-at? M (+ p 25) 5 8 0 0)
      (gn-dot-at? M (+ p 26) 4 0 7 0)
      (gn-dot-at? M (+ p 27) 3 1 32 0)
      (gn-dot-at? M (+ p 28) 6 9 0 0)
      (gn-dot-at? M (+ p 29) 5 9 0 0)
      (gn-dot-at? M (+ p 30) 4 0 4 0)
      (gn-dot-at? M (+ p 31) 4 1 5 0)
      (gn-dot-at? M (+ p 32) 6 3 0 0)
      (gn-dot-at? M (+ p 33) 4 1 9 0)
      (gn-dot-at? M (+ p 34) 6 1 0 0)
