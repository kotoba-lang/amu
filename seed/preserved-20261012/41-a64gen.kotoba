(defn- rl-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 327) true (and (rl-row M p f k) (rl-rows M p f (inc k)))))
(defn- rl-distinct [M :vector-i64 j :i64 k :i64] :bool
 (if (= j 8) true
  (if (= k 8) (rl-distinct M (inc j) (+ j 2))
   (and (not= (gn-sreg M j) (gn-sreg M k)) (rl-distinct M j (inc k))))))
(defn- rl-homes [M :vector-i64 j :i64] :bool
 (if (= j 8) true
  (and (>= (gn-sreg M j) 19) (<= (gn-sreg M j) 28) (rl-homes M (inc j)))))
(defn- rl-admit [M :vector-i64 i :i64] :bool
 (and (> i 1) (< i MM-SIR-CAP) (< i (vector-at M MM-SIR-N))
  (>= (vector-at M MM-SIR-N) 327) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (= (gn-op M (dec i)) OP-FN) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
  (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-ctx) 1)
  (> (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768)
  (= (gn-g M gn-f-ns) 16) (= (gn-g M gn-f-dp) 8)
  (rl-homes M 1) (rl-distinct M 1 2)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 768))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) (- MM-FIX-CAP 64))
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
    (<= (vector-at M MM-FN-N) MM-FN-CAP) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-SIR) p) (<= p (- (vector-at M MM-SIR-N) 327))
    (= (gn-fnf M f FF-NPARAMS) 7) (= (gn-fnf M f FF-NSLOTS) 16)
    (= (gn-fnf M f FF-DEPTH) 8) (= (gn-fnf M f FF-FUEL) 1)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 5) (rl-rows M p f 0) (qb-labels M p 327 0)
    (fb-admit M (gn-sir M (+ p 72) IF-A) 6)))))
;; Scratch4 holds selected literal offset/value;5 holds byte index;6 sum.
;; Staged next words0..3 never overwrite current9..12 before all four finish.
(defn- rl-load [M :vector-i64 lit :i64] :vector-i64
 (-> M (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-emit (gn-e-addsl 17 17 5 3))
  (gn-fix FX-LIT32 lit) (gn-emit (enc-movz 4 0 0)) (gn-emit (enc-movk 4 0 1))
  (gn-emit (gn-e-ldrr 4 17 4 0))))
(defn- rl-lane [M :vector-i64 child :i64 r :i64 shift :i64] :vector-i64
 (let [p (gn-fnf M child FF-SIR)
  m0 (-> M (gn-emit (gn-e-bf 0xd3400000 5 r shift (+ shift 7))) (gn-emit (enc-cmp-i 5 128)))
  split (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (rl-load (gn-sir M (+ p 8) IF-B)))
  join (vector-at m1 MM-CODE-N) m2 (gn-emit m1 (enc-b 0)) high (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-sub-i 5 5 128)) (rl-load (gn-sir M (+ p 14) IF-B)))
  done (vector-at m3 MM-CODE-N)]
  (-> m3 (gn-dot-patch split high (enc-cond-hs))
   (gn-put (+ MM-CODE-BASE join) (enc-b (- done join))) (gn-emit (enc-eor-r 6 6 4)))))
(defn- rl-word [M :vector-i64 fp :i64 family :i64 out :i64 lane :i64] :vector-i64
 (if (= lane 4) (gn-mov M out 6)
  (let [idx (bit-and (+ out (if (= family 0) lane (- 4 lane))) 3)
   child (gn-sir M (+ (+ (+ fp 11) (* lane 15)) (* family 6)) IF-A)]
   (rl-word (rl-lane M child (+ 9 idx) (* lane 8)) fp family out (inc lane)))))
(defn- rl-four [M :vector-i64 fp :i64 family :i64 k :i64] :vector-i64
 (if (= k 4) M
  (rl-four (-> M (gn-emit (enc-ldr 6 13 (* k 8))) (rl-word fp family k 0)) fp family (inc k))))
(defn- rl-loop [M :vector-i64 fp :i64 family :i64] :vector-i64
 (let [head (vector-at M MM-CODE-N)
  m0 (-> M (rl-four fp family 0) (gn-mov 9 0) (gn-mov 10 1) (gn-mov 11 2) (gn-mov 12 3)
   (gn-emit (enc-sub-i 8 8 25)) (gn-emit (enc-add-i 14 14 1))
   (gn-emit (enc-add-i 13 13 32)) (gn-emit (enc-cmp-i 14 14)))
  back (vector-at m0 MM-CODE-N)]
  (gn-emit m0 (enc-bcond (enc-cond-ne) (- head back)))))
(defn- rl-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) fp (gn-fnf M (gn-sir M (+ p 72) IF-A) FF-SIR)
  m0 (-> M (gn-mov 14 (gn-sreg M 3)) (gn-emit (enc-cmp-i 14 1)))
  first (vector-at m0 MM-CODE-N) m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-emit (enc-cmp-i 14 14))) terminal (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 (gn-sreg M 1) 1)) (gn-emit (enc-cmp-r 17 16)))
  badhandle (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 4 7 320)) (gn-emit (gn-e-addsl 4 4 17 4)) (gn-emit (enc-ldp 17 4 4 0))
   (gn-mov-imm 5 0) (gn-emit (enc-cmp-i (gn-sreg M 2) 0)))
  baseselect (vector-at m3 MM-CODE-N) m4 (-> m3 (gn-emit (enc-bcond (enc-cond-eq) 2)) (gn-mov-imm 5 60))
  m5 (-> m4 (gn-emit (enc-add-i 16 5 55)) (gn-emit (enc-cmp-r 16 4)))
  badrange (vector-at m5 MM-CODE-N) m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 13 7 328)) (gn-emit (gn-e-addsl 13 13 17 3))
   (gn-emit (gn-e-addsl 5 5 14 2)) (gn-emit (gn-e-addsl 13 13 5 3))
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov-imm 6 14) (gn-emit (enc-sub-r 6 6 14))
   (gn-mov-imm 16 25) (gn-emit (enc-mul 6 6 16)) (gn-emit (enc-cmp-r 8 6)))
  badfuel (vector-at m6 MM-CODE-N) m7 (-> m6 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-mov 9 (gn-sreg M 4)) (gn-mov 10 (gn-sreg M 5))
   (gn-mov 11 (gn-sreg M 6)) (gn-mov 12 (gn-sreg M 7))
   (gn-emit (enc-cmp-i (gn-sreg M 2) 0)))
  family (vector-at m7 MM-CODE-N) m8 (-> m7 (gn-emit (enc-bcond (enc-cond-ne) 0)) (rl-loop fp 0))
  join (vector-at m8 MM-CODE-N) m9 (gn-emit m8 (enc-b 0)) second (vector-at m9 MM-CODE-N)
  m10 (rl-loop m9 fp 1) publish (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-emit (enc-str 8 7 CTX-FUEL))
   (gn-mov (gn-sreg M 3) 14) (gn-mov (gn-sreg M 4) 9) (gn-mov (gn-sreg M 5) 10)
   (gn-mov (gn-sreg M 6) 11) (gn-mov (gn-sreg M 7) 12)) fallback (vector-at m11 MM-CODE-N)]
  (-> m11 (gn-dot-patch first fallback (enc-cond-lo)) (gn-dot-patch terminal fallback (enc-cond-hs))
   (gn-dot-patch badhandle fallback (enc-cond-hs)) (gn-dot-patch badrange fallback (enc-cond-hs))
   (gn-dot-patch badfuel fallback (enc-cond-lo)) (gn-dot-patch family second (enc-cond-ne))
   (gn-put (+ MM-CODE-BASE join) (enc-b (- publish join))))))
(defn- rl-entry [M :vector-i64 i :i64] :vector-i64
 (pt-entry M i))

;; Generic charged selector over two closed immutable split tables.
(defn- fb-table [M :vector-i64 f :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (not (gn-clamp-open M f)) (= (gn-fnf M f FF-NPARAMS) 1)
  (= (gn-fnf M f FF-NSLOTS) 1) (= (gn-fnf M f FF-DEPTH) 2)
  (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-RTYPE) TY-I64)
  (qb-int-params M f 0 1)
  (> (gn-fnf M f FF-SIR) 0)
  (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) 18))
  (ta-shape? M (gn-fnf M f FF-SIR) f)
  (= (gn-sir M (+ (gn-fnf M f FF-SIR) 4) IF-B) 128)
  (= (gn-sir M (+ (gn-fnf M f FF-SIR) 14) IF-C) 128)
  (qb-labels M (gn-fnf M f FF-SIR) 18 0)))
(defn- fb-fold [M :vector-i64 f :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (= (gn-fnf M f FF-NPARAMS) 5) (= (gn-fnf M f FF-NSLOTS) 5)
  (= (gn-fnf M f FF-DEPTH) 5) (= (gn-fnf M f FF-FUEL) 1)
  (= (gn-fnf M f FF-RTYPE) TY-I64) (qb-int-params M f 0 5)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) 12))
  (let [p (gn-fnf M f FF-SIR) g (gn-sir M (+ p 8) IF-A)]
   (and (uc-row M p OP-FN f 5 5) (uc-row M (+ p 1) OP-FUEL 0 0 0)
    (uc-row M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    (uc-row M (+ p 3) OP-LGET 0 1 0) (uc-row M (+ p 4) OP-LGET 1 2 0)
    (uc-row M (+ p 5) OP-LGET 2 3 0) (uc-row M (+ p 6) OP-LGET 3 4 0)
    (uc-row M (+ p 7) OP-LGET 4 5 0) (uc-row M (+ p 8) OP-CALL g 1 4)
    (uc-row M (+ p 9) OP-BIN BOP-XOR 0 0) (uc-row M (+ p 10) OP-RET 0 0 0)
    (uc-row M (+ p 11) OP-END f 0 0) (qb-labels M p 12 0)
    (aw-child M g BOP-XOR) (qb-labels M (gn-fnf M g FF-SIR) 11 0)))))
(defn- fb-row [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 6 6)
  1 (uc-row M (+ p 1) 18 0 0 0)
  2 (uc-row M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (uc-row M (+ p 3) 4 0 6 0)
  4 (uc-row M (+ p 4) 4 1 1 0)
  5 (uc-row M (+ p 5) 3 2 0 0)
  6 (uc-row M (+ p 6) 7 1 1 0)
  7 (uc-row M (+ p 7) 11 1 (gn-sir M (+ p 13) IF-A) 0)
  8 (uc-row M (+ p 8) 4 1 2 0)
  9 (uc-row M (+ p 9) 3 2 0 0)
  10 (uc-row M (+ p 10) 13 (gn-sir M (+ p 10) IF-A) 1 2)
  11 (uc-row M (+ p 11) 13 (gn-sir M (+ p 11) IF-A) 1 1)
  12 (uc-row M (+ p 12) 10 (gn-sir M (+ p 18) IF-A) 0 0)
  13 (uc-row M (+ p 13) 9 (gn-sir M (+ p 13) IF-A) 0 0)
  14 (uc-row M (+ p 14) 4 1 2 0)
  15 (uc-row M (+ p 15) 3 2 0 0)
  16 (uc-row M (+ p 16) 13 (gn-sir M (+ p 10) IF-A) 1 2)
  17 (uc-row M (+ p 17) 13 (gn-sir M (+ p 17) IF-A) 1 1)
  18 (uc-row M (+ p 18) 9 (gn-sir M (+ p 18) IF-A) 0 0)
  19 (uc-row M (+ p 19) 4 2 1 0)
  20 (uc-row M (+ p 20) 3 3 0 0)
  21 (uc-row M (+ p 21) 7 1 2 0)
  22 (uc-row M (+ p 22) 11 2 (gn-sir M (+ p 28) IF-A) 0)
  23 (uc-row M (+ p 23) 4 2 3 0)
  24 (uc-row M (+ p 24) 3 3 8 0)
  25 (uc-row M (+ p 25) 13 (gn-sir M (+ p 10) IF-A) 2 2)
  26 (uc-row M (+ p 26) 13 (gn-sir M (+ p 26) IF-A) 2 1)
  27 (uc-row M (+ p 27) 10 (gn-sir M (+ p 33) IF-A) 0 0)
  28 (uc-row M (+ p 28) 9 (gn-sir M (+ p 28) IF-A) 0 0)
  29 (uc-row M (+ p 29) 4 2 3 0)
  30 (uc-row M (+ p 30) 3 3 8 0)
  31 (uc-row M (+ p 31) 13 (gn-sir M (+ p 10) IF-A) 2 2)
  32 (uc-row M (+ p 32) 13 (gn-sir M (+ p 32) IF-A) 2 1)
  33 (uc-row M (+ p 33) 9 (gn-sir M (+ p 33) IF-A) 0 0)
  34 (uc-row M (+ p 34) 4 3 1 0)
  35 (uc-row M (+ p 35) 3 4 0 0)
  36 (uc-row M (+ p 36) 7 1 3 0)
  37 (uc-row M (+ p 37) 11 3 (gn-sir M (+ p 43) IF-A) 0)
  38 (uc-row M (+ p 38) 4 3 4 0)
  39 (uc-row M (+ p 39) 3 4 16 0)
  40 (uc-row M (+ p 40) 13 (gn-sir M (+ p 10) IF-A) 3 2)
  41 (uc-row M (+ p 41) 13 (gn-sir M (+ p 41) IF-A) 3 1)
  42 (uc-row M (+ p 42) 10 (gn-sir M (+ p 48) IF-A) 0 0)
  43 (uc-row M (+ p 43) 9 (gn-sir M (+ p 43) IF-A) 0 0)
  44 (uc-row M (+ p 44) 4 3 4 0)
  45 (uc-row M (+ p 45) 3 4 16 0)
  46 (uc-row M (+ p 46) 13 (gn-sir M (+ p 10) IF-A) 3 2)
  47 (uc-row M (+ p 47) 13 (gn-sir M (+ p 47) IF-A) 3 1)
  48 (uc-row M (+ p 48) 9 (gn-sir M (+ p 48) IF-A) 0 0)
  49 (uc-row M (+ p 49) 4 4 1 0)
  50 (uc-row M (+ p 50) 3 5 0 0)
  51 (uc-row M (+ p 51) 7 1 4 0)
  52 (uc-row M (+ p 52) 11 4 (gn-sir M (+ p 58) IF-A) 0)
  53 (uc-row M (+ p 53) 4 4 5 0)
  54 (uc-row M (+ p 54) 3 5 24 0)
  55 (uc-row M (+ p 55) 13 (gn-sir M (+ p 10) IF-A) 4 2)
  56 (uc-row M (+ p 56) 13 (gn-sir M (+ p 56) IF-A) 4 1)
  57 (uc-row M (+ p 57) 10 (gn-sir M (+ p 63) IF-A) 0 0)
  58 (uc-row M (+ p 58) 9 (gn-sir M (+ p 58) IF-A) 0 0)
  59 (uc-row M (+ p 59) 4 4 5 0)
  60 (uc-row M (+ p 60) 3 5 24 0)
  61 (uc-row M (+ p 61) 13 (gn-sir M (+ p 10) IF-A) 4 2)
  62 (uc-row M (+ p 62) 13 (gn-sir M (+ p 62) IF-A) 4 1)
  63 (uc-row M (+ p 63) 9 (gn-sir M (+ p 63) IF-A) 0 0)
  64 (uc-row M (+ p 64) 13 (gn-sir M (+ p 64) IF-A) 0 5)
  65 (uc-row M (+ p 65) 19 0 0 0)
  66 (uc-row M (+ p 66) 2 f 0 0)
  false))
(defn- fb-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 67) true (and (fb-row M p f k) (fb-rows M p f (inc k)))))
(defn- fb-tables [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 4) true
  (and (fb-table M (gn-sir M (+ (+ p 11) (* k 15)) IF-A))
   (fb-table M (gn-sir M (+ (+ p 17) (* k 15)) IF-A)) (fb-tables M p (inc k)))))
(defn- fb-admit [M :vector-i64 f :i64 n :i64] :bool
 (and (= n 6) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
  (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (<= (vector-at M MM-FN-N) MM-FN-CAP) (not (gn-clamp-open M f))
  (>= (vector-at M MM-SIR-N) 67) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) 67))
  (= (gn-fnf M f FF-NPARAMS) 6) (= (gn-fnf M f FF-NSLOTS) 6)
  (= (gn-fnf M f FF-DEPTH) 6) (= (gn-fnf M f FF-FUEL) 1)
  (= (gn-fnf M f FF-RTYPE) TY-I64) (qb-int-params M f 0 5)
  (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 3936)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 160))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) (- MM-FIX-CAP 17))
  (let [p (gn-fnf M f FF-SIR) e (gn-sir M (+ p 10) IF-A)]
   (and (fb-rows M p f 0) (qb-labels M p 67 0) (fb-tables M p 0)
    (> e 0) (< e MM-FN-CAP) (< e (vector-at M MM-FN-N))
    (let [ep (gn-fnf M e FF-SIR)]
     (and (sx-body? M e ep) (= (gn-fnf M e FF-FUEL) 0)
      (= (gn-sir M (+ ep 5) IF-B) 255) (qb-labels M ep 9 0)))
    (fb-fold M (gn-sir M (+ p 64) IF-A))))))
(defn- fb-load [M :vector-i64 lit :i64] :vector-i64
 (-> M (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-emit (gn-e-addsl 17 17 16 3))
  (gn-fix FX-LIT32 lit) (gn-emit (enc-movz 0 0 0)) (gn-emit (enc-movk 0 0 1))
  (gn-emit (gn-e-ldrr 0 17 0 0))))
(defn- fb-lane [M :vector-i64 child :i64 r :i64 shift :i64] :vector-i64
 (let [p (gn-fnf M child FF-SIR)
  m0 (-> M (gn-emit (gn-e-bf 0xd3400000 16 r shift (+ shift 7)))
   (gn-emit (enc-cmp-i 16 128))) split (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (fb-load (gn-sir M (+ p 8) IF-B)))
  join (vector-at m1 MM-CODE-N) m2 (gn-emit m1 (enc-b 0)) high (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-sub-i 16 16 128)) (fb-load (gn-sir M (+ p 14) IF-B)))
  done (vector-at m3 MM-CODE-N)]
  (-> m3 (gn-dot-patch split high (enc-cond-hs))
   (gn-put (+ MM-CODE-BASE join) (enc-b (- done join))) (gn-emit (enc-eor-r 6 6 0)))))
(defn- fb-family [M :vector-i64 p :i64 family :i64 k :i64] :vector-i64
 (if (= k 4) M
  (fb-family (fb-lane M (gn-sir M (+ (+ (+ p 11) (* k 15)) (* family 6)) IF-A) (inc k) (* k 8)) p family (inc k))))
(defn- fb-transfer [M :vector-i64 f :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fn (vector-at M MM-FIX-N) p (gn-fnf M f FF-SIR)
  m0 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 6)))
  gf (vector-at m0 MM-CODE-N) m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-emit (enc-sub-i 16 16 6)) (gn-emit (enc-str 16 7 CTX-FUEL)) (gn-mov 6 5)
   (gn-emit (enc-cmp-i 0 0))) sel (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) 0)) (fb-family p 0 0))
  ja (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-b 0)) second (vector-at m3 MM-CODE-N)
  m4 (fb-family m3 p 1 0) done (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-mov 0 6) (gn-emit (enc-b 2))) fallback (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))
   (gn-dot-patch gf fallback (enc-cond-lo)) (gn-dot-patch sel second (enc-cond-ne))
   (gn-put (+ MM-CODE-BASE ja) (enc-b (- done ja))))]
  (if (= (vector-at m6 MM-ERR) 0)
   (-> m6 (gn-gs di-sites (inc (gn-g m6 di-sites)))
    (gn-gs di-used (+ (gn-g m6 di-used) (- (vector-at m6 MM-CODE-N) cn))))
   (-> m6 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fn)))))

;; Generic charged selector over two closed immutable split tables.
(defn- st-child [M :vector-i64 f :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (not (gn-clamp-open M f)) (= (gn-fnf M f FF-NPARAMS) 1)
  (= (gn-fnf M f FF-NSLOTS) 1) (= (gn-fnf M f FF-DEPTH) 2)
  (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-RTYPE) TY-I64)
  (qb-int-params M f 0 1)
  (> (gn-fnf M f FF-SIR) 0)
  (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) 18))
  (ta-shape? M (gn-fnf M f FF-SIR) f)
  (= (gn-sir M (+ (gn-fnf M f FF-SIR) 4) IF-B) 128)
  (= (gn-sir M (+ (gn-fnf M f FF-SIR) 14) IF-C) 128)
  (qb-labels M (gn-fnf M f FF-SIR) 18 0)))
(defn- st-row [M :vector-i64 p :i64 f :i64 head :i64 els :i64 join :i64 a :i64 b :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) OP-FN f 2 2)
  1 (uc-row M (+ p 1) OP-FUEL 0 0 0)
  2 (uc-row M (+ p 2) OP-LABEL head 0 0)
  3 (uc-row M (+ p 3) OP-LGET 0 1 0)
  4 (uc-row M (+ p 4) OP-CONST 1 0 0)
  5 (uc-row M (+ p 5) OP-CMP CC-EQ 0 0)
  6 (uc-row M (+ p 6) OP-BRZ 0 els 0)
  7 (uc-row M (+ p 7) OP-LGET 0 2 0)
  8 (uc-row M (+ p 8) OP-CALL a 0 1)
  9 (uc-row M (+ p 9) OP-BR join 0 0)
  10 (uc-row M (+ p 10) OP-LABEL els 0 0)
  11 (uc-row M (+ p 11) OP-LGET 0 2 0)
  12 (uc-row M (+ p 12) OP-CALL b 0 1)
  13 (uc-row M (+ p 13) OP-LABEL join 0 0)
  14 (uc-row M (+ p 14) OP-RET 0 0 0)
  15 (uc-row M (+ p 15) OP-END f 0 0)
  false))
(defn- st-rows [M :vector-i64 p :i64 f :i64 head :i64 els :i64 join :i64 a :i64 b :i64 k :i64] :bool
 (if (= k 16) true (and (st-row M p f head els join a b k)
  (st-rows M p f head els join a b (inc k)))))
(defn- st-admit [M :vector-i64 f :i64 n :i64] :bool
 (and (= n 2) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
  (> f 0) (< f MM-FN-CAP) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (>= (vector-at M MM-SIR-N) 16) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) 16))
  (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
  (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-FUEL) 1)
  (= (gn-fnf M f FF-RTYPE) TY-I64) (qb-int-params M f 0 2)
  (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 4032)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 64))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) (- MM-FIX-CAP 6))
  (let [p (gn-fnf M f FF-SIR) head (gn-sir M (+ p 2) IF-A)
   els (gn-sir M (+ p 6) IF-B) join (gn-sir M (+ p 9) IF-A)
   a (gn-sir M (+ p 8) IF-A) b (gn-sir M (+ p 12) IF-A)]
   (and (st-rows M p f head els join a b 0) (qb-labels M p 16 0)
    (st-child M a) (st-child M b)))))
(defn- st-load [M :vector-i64 lit :i64] :vector-i64
 (-> M (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-emit (gn-e-addsl 17 17 1 3))
  (gn-fix FX-LIT32 lit) (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
  (gn-emit (gn-e-ldrr 0 17 16 0))))
(defn- st-transfer [M :vector-i64 f :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fn (vector-at M MM-FIX-N)
  p (gn-fnf M f FF-SIR) a (gn-sir M (+ p 8) IF-A) b (gn-sir M (+ p 12) IF-A)
  pa (gn-fnf M a FF-SIR) pb (gn-fnf M b FF-SIR)
  m0 (gn-emit M (enc-cmp-i 1 256)) gi (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 2)))
  gf (vector-at m1 MM-CODE-N) m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-emit (enc-sub-i 16 16 2)) (gn-emit (enc-str 16 7 CTX-FUEL))
   (gn-emit (enc-cmp-i 0 0)))
  gb (vector-at m2 MM-CODE-N) m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ne) 0))
   (gn-emit (enc-cmp-i 1 128))) ga (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (st-load (gn-sir M (+ pa 8) IF-B))) ja (vector-at m4 MM-CODE-N)
  m5 (gn-emit m4 (enc-b 0)) ahi (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-sub-i 1 1 128)) (st-load (gn-sir M (+ pa 14) IF-B)))
  jah (vector-at m6 MM-CODE-N) m7 (gn-emit m6 (enc-b 0)) bs (vector-at m7 MM-CODE-N)
  m8 (gn-emit m7 (enc-cmp-i 1 128)) gbr (vector-at m8 MM-CODE-N)
  m9 (-> m8 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (st-load (gn-sir M (+ pb 8) IF-B))) jb (vector-at m9 MM-CODE-N)
  m10 (gn-emit m9 (enc-b 0)) bhi (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-emit (enc-sub-i 1 1 128)) (st-load (gn-sir M (+ pb 14) IF-B))
   (gn-emit (enc-b 2))) fallback (vector-at m11 MM-CODE-N)
  m12 (-> m11 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))) done (vector-at m12 MM-CODE-N)
  m13 (-> m12 (gn-dot-patch gi fallback (enc-cond-hs)) (gn-dot-patch gf fallback (enc-cond-lo))
   (gn-dot-patch gb bs (enc-cond-ne)) (gn-dot-patch ga ahi (enc-cond-hs))
   (gn-dot-patch gbr bhi (enc-cond-hs))
   (gn-put (+ MM-CODE-BASE ja) (enc-b (- done ja)))
   (gn-put (+ MM-CODE-BASE jah) (enc-b (- done jah)))
   (gn-put (+ MM-CODE-BASE jb) (enc-b (- done jb))))]
  (if (= (vector-at m13 MM-ERR) 0)
   (-> m13 (gn-gs di-sites (inc (gn-g m13 di-sites)))
    (gn-gs di-used (+ (gn-g m13 di-used) (- done cn))))
   (-> m13 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fn)))))

;; Closed stable two-field record insertion. Success has no helper calls/traps.
;; Entry debit/prologue remain original; preflight misses preserve whole old body.
(defn- ir-row [M :vector-i64 p :i64 f :i64 reader :i64 item :i64 writer :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) testjoin (gn-sir M (+ p 14) IF-A)
       finish (gn-sir M (+ p 36) IF-A) exit (gn-sir M (+ p 50) IF-A)]
  (case k
    0 (bd-row M (+ p 0) OP-FN f 5 5)
    1 (bd-row M (+ p 1) OP-FUEL 0 0 0)
    2 (bd-row M (+ p 2) OP-LABEL head 0 0)
    3 (bd-row M (+ p 3) OP-LGET 0 3 0)
    4 (bd-row M (+ p 4) OP-LGET 1 2 0)
    5 (bd-row M (+ p 5) OP-CMP 3 0 0)
    6 (bd-row M (+ p 6) OP-BRZ 0 testjoin 0)
    7 (bd-row M (+ p 7) OP-LGET 0 4 0)
    8 (bd-row M (+ p 8) OP-LGET 1 1 0)
    9 (bd-row M (+ p 9) OP-LGET 2 3 0)
    10 (bd-row M (+ p 10) OP-CONST 3 1 0)
    11 (bd-row M (+ p 11) OP-BIN 2 2 0)
    12 (bd-row M (+ p 12) OP-CALL reader 1 2)
    13 (bd-row M (+ p 13) OP-CMP 2 0 0)
    14 (bd-row M (+ p 14) OP-LABEL testjoin 0 0)
    15 (bd-row M (+ p 15) OP-BRZ 0 finish 0)
    16 (bd-row M (+ p 16) OP-LGET 0 1 0)
    17 (bd-row M (+ p 17) OP-LGET 1 3 0)
    18 (bd-row M (+ p 18) OP-LGET 2 3 0)
    19 (bd-row M (+ p 19) OP-CONST 3 1 0)
    20 (bd-row M (+ p 20) OP-BIN 2 2 0)
    21 (bd-row M (+ p 21) OP-CALL item 0 3)
    22 (bd-row M (+ p 22) OP-LGET 1 2 0)
    23 (bd-row M (+ p 23) OP-LGET 2 3 0)
    24 (bd-row M (+ p 24) OP-CONST 3 1 0)
    25 (bd-row M (+ p 25) OP-BIN 2 2 0)
    26 (bd-row M (+ p 26) OP-LGET 3 4 0)
    27 (bd-row M (+ p 27) OP-LGET 4 5 0)
    28 (bd-row M (+ p 28) OP-LSET 1 0 0)
    29 (bd-row M (+ p 29) OP-LSET 2 1 0)
    30 (bd-row M (+ p 30) OP-LSET 3 2 0)
    31 (bd-row M (+ p 31) OP-LSET 4 3 0)
    32 (bd-row M (+ p 32) OP-LSET 5 4 0)
    33 (bd-row M (+ p 33) OP-FUEL 0 0 0)
    34 (bd-row M (+ p 34) OP-BR head 0 0)
    35 (bd-row M (+ p 35) OP-BR exit 0 0)
    36 (bd-row M (+ p 36) OP-LABEL finish 0 0)
    37 (bd-row M (+ p 37) OP-LGET 0 1 0)
    38 (bd-row M (+ p 38) OP-LGET 1 3 0)
    39 (bd-row M (+ p 39) OP-CONST 2 2 0)
    40 (bd-row M (+ p 40) OP-BIN 3 1 0)
    41 (bd-row M (+ p 41) OP-LGET 2 4 0)
    42 (bd-row M (+ p 42) OP-CALL writer 0 3)
    43 (bd-row M (+ p 43) OP-LGET 1 3 0)
    44 (bd-row M (+ p 44) OP-CONST 2 2 0)
    45 (bd-row M (+ p 45) OP-BIN 3 1 0)
    46 (bd-row M (+ p 46) OP-CONST 2 1 0)
    47 (bd-row M (+ p 47) OP-BIN 1 1 0)
    48 (bd-row M (+ p 48) OP-LGET 2 5 0)
    49 (bd-row M (+ p 49) OP-CALL writer 0 3)
    50 (bd-row M (+ p 50) OP-LABEL exit 0 0)
    51 (bd-row M (+ p 51) OP-RET 0 0 0)
    52 (bd-row M (+ p 52) OP-END f 0 0)
    false)))
(defn- ir-rows [M :vector-i64 p :i64 f :i64 reader :i64 item :i64 writer :i64 k :i64] :bool
 (if (= k 53) true (and (ir-row M p f reader item writer k)
  (ir-rows M p f reader item writer (inc k)))))
(defn- ir-bound [M :vector-i64 f :i64 rows :i64 np :i64 ns :i64 dp :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (>= (vector-at M MM-SIR-N) rows) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) rows))
  (= (gn-fnf M f FF-NPARAMS) np) (= (gn-fnf M f FF-NSLOTS) ns)
  (= (gn-fnf M f FF-DEPTH) dp) (= (gn-fnf M f FF-FUEL) 1)
  (not (gn-clamp-open M f))))
(defn- ir-deps [M :vector-i64 reader :i64 item :i64 writer :i64] :bool
 (and (ir-bound M reader 10 2 2 3) (ir-bound M item 30 3 5 3) (ir-bound M writer 9 3 3 3)
  (pc3-helper-type M reader 2 TY-I64) (pc3-helper-type M writer 3 TY-VEC)
  (drc-item M item)
  (= (gn-sir M (+ (gn-fnf M item FF-SIR) 5) IF-A) reader)
  (= (gn-sir M (+ (gn-fnf M item FF-SIR) 20) IF-A) writer)
  (pc3-reader-shape M (gn-fnf M reader FF-SIR) reader)
  (pc3-writer-shape M (gn-fnf M writer FF-SIR) writer)
  (qb-labels M (gn-fnf M reader FF-SIR) 10 0)
  (qb-labels M (gn-fnf M item FF-SIR) 30 0)
  (qb-labels M (gn-fnf M writer FF-SIR) 9 0)))
(defn- ir-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (> i (- MM-SIR-CAP 52))
         (> i (- (vector-at M MM-SIR-N) 52)) (not= (gn-op M (dec i)) OP-FN)) false
  (let [p (dec i) f (gn-sir M p IF-A)
        reader (gn-sir M (+ p 12) IF-A) item (gn-sir M (+ p 21) IF-A)
        writer (gn-sir M (+ p 42) IF-A)]
   (and (ir-bound M f 53 5 5 5) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 5)
    (= (gn-g M gn-f-ns) 5) (= (gn-g M gn-f-dp) 5)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
    (= (gn-g M gn-f-nsv) 5) (= (gn-g M gn-f-out) 0)
    (>= (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768)
    (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 96))
    (drc-homes M 1 5) (ir-deps M reader item writer)
    (ir-rows M p f reader item writer 0) (qb-labels M p 53 0)))))
(defn- ir-emit [M :vector-i64] :vector-i64
 (let [rv (gn-sreg M 1) start (gn-sreg M 2) idx (gn-sreg M 3)
       key (gn-sreg M 4) tie (gn-sreg M 5)
       m0 (gn-emit M (enc-cmp-r idx start)) b0 (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0))
                (gn-mov-imm 16 2147483648) (gn-emit (enc-cmp-r idx 16))) b1 (vector-at m1 MM-CODE-N)
       m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0))
                (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
                (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
       m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
                (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
                (gn-emit (enc-ldp 3 4 16 0))
                (gn-emit (gn-e-lsl 17 idx 1)) (gn-emit (enc-add-i 17 17 1))
                (gn-emit (enc-cmp-r 17 4))) b3 (vector-at m3 MM-CODE-N)
       m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
                (gn-emit (enc-sub-r 16 idx start)) (gn-emit (gn-e-lsl 17 16 1))
                (gn-emit (enc-add-r 16 16 17)) (gn-emit (gn-e-lsl 16 16 1))
                (gn-emit (enc-add-i 16 16 2)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
                (gn-emit (enc-cmp-r 8 16))) b4 (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-emit (enc-bcond (enc-cond-lo) 0))
                (gn-emit (enc-ldr 6 7 328)) (gn-emit (gn-e-addsl 6 6 3 3))
                (gn-emit (gn-e-addsl 5 6 idx 4)) (gn-mov 9 idx))
       loop (vector-at m5 MM-CODE-N)
       m6 (gn-emit m5 (enc-cmp-r 9 start)) done0 (vector-at m6 MM-CODE-N)
       m7 (-> m6 (gn-emit (enc-bcond (enc-cond-eq) 0))
                (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-sub-i 16 5 16))
                (gn-emit (enc-ldr 10 16 0)) (gn-emit (enc-cmp-r key 10))) done1 (vector-at m7 MM-CODE-N)
       m8 (-> m7 (gn-emit (enc-bcond (enc-cond-ge) 0))
                (gn-emit (enc-sub-i 8 8 4)) (gn-emit (enc-ldp 10 11 16 0))
                (gn-emit (enc-stp 10 11 5 0)) (gn-emit (enc-sub-i 5 5 16))
                (gn-emit (enc-sub-i 9 9 1)) (gn-emit (enc-sub-i 8 8 1))) back (vector-at m8 MM-CODE-N)
       m9 (gn-emit m8 (enc-b (- loop back))) done (vector-at m9 MM-CODE-N)
       m10 (-> m9 (gn-emit (enc-sub-i 8 8 2)) (gn-emit (enc-stp key tie 5 0))
                 (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov 0 rv)
                 (gn-epilogue) (gn-gs gn-f-dead 0)) end (vector-at m10 MM-CODE-N)]
  (-> m10 (gn-dot-patch b0 end (enc-cond-lo)) (gn-dot-patch b1 end (enc-cond-hs))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
          (gn-dot-patch b4 end (enc-cond-lo)) (gn-dot-patch done0 done (enc-cond-eq))
          (gn-dot-patch done1 done (enc-cond-ge)) (gn-vclear))))
(defn- ir-entry [M :vector-i64 i :i64] :vector-i64
 (if (ir-admit M i) (ir-emit M) M))

