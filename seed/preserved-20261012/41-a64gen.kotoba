   child (gn-sir M (+ (+ (+ fp 11) (* lane 15)) (* family 6)) IF-A)]
   (ho-word (ho-lane M S (+ (* family 4) lane) (+ 9 idx) (* lane 8)) S fp family out (inc lane)))))
(defn- ho-four [M :vector-i64 S :vector-i64 fp :i64 family :i64 k :i64] :vector-i64
 (if (= k 4) M
  (ho-four (-> M (gn-emit (enc-ldr 6 13 (* k 8))) (ho-word S fp family k 0)) S fp family (inc k))))
(defn- ho-loop [M :vector-i64 S :vector-i64 fp :i64 family :i64] :vector-i64
 (let [prepared (ho-bases M S family 0) head (vector-at prepared MM-CODE-N)
  m0 (-> prepared (ho-four S fp family 0) (gn-mov 9 0) (gn-mov 10 1) (gn-mov 11 2) (gn-mov 12 3)
   (gn-emit (enc-sub-i 8 8 25)) (gn-emit (enc-add-i 14 14 1))
   (gn-emit (enc-add-i 13 13 32)) (gn-emit (enc-cmp-i 14 14)))
  back (vector-at m0 MM-CODE-N)]
