(defn- lm-rows [M :vector-i64 p :i64 f :i64 writer :i64 affine :i64 tail :i64 cont :i64 k :i64] :bool
 (or (= k 104) (and (lm-row M p f writer affine tail cont k) (lm-rows M p f writer affine tail cont (inc k)))))
(defn- lm-affine-row [M :vector-i64 p :i64 f :i64 base :i64 stride :i64 k :i64] :bool
 (let [h (gn-sir M (inc p) IF-A)]
  (case k
   0 (gn-dot-at? M p OP-FN f 2 2)
   1 (gn-dot-at? M (inc p) OP-LABEL h 0 0)
   2 (gn-dot-at? M (+ p 2) OP-CONST 0 base 0)
   3 (gn-dot-at? M (+ p 3) OP-LGET 1 1 0)
   4 (gn-dot-at? M (+ p 4) OP-CONST 2 1 0)
   5 (gn-dot-at? M (+ p 5) OP-BIN 2 1 0)
   6 (gn-dot-at? M (+ p 6) OP-CONST 2 stride 0)
   7 (gn-dot-at? M (+ p 7) OP-BIN 3 1 0)
   8 (gn-dot-at? M (+ p 8) OP-BIN 1 0 0)
   9 (gn-dot-at? M (+ p 9) OP-LGET 1 2 0)
   10 (gn-dot-at? M (+ p 10) OP-BIN 1 0 0)
   11 (gn-dot-at? M (+ p 11) OP-RET 0 0 0)
   12 (gn-dot-at? M (+ p 12) OP-END f 0 0)
   false)))
(defn- lm-affine-rows [M :vector-i64 p :i64 f :i64 base :i64 stride :i64 k :i64] :bool
 (or (= k 13) (and (lm-affine-row M p f base stride k) (lm-affine-rows M p f base stride (inc k)))))
(defn- lm-affine [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))) false
  (let [p (gn-fnf M f FF-SIR)]
   (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 13))) false
    (let [base (gn-sir M (+ p 2) IF-B) stride (gn-sir M (+ p 6) IF-B)]
     (and (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
      (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-FUEL) 0)
      (= (gn-fnf M f FF-RTYPE) TY-I64) (qb-int-params M f 0 2) (not (gn-clamp-open M f))
      (>= base 0) (<= base 4095) (> stride 0) (<= stride 4095)
      (lm-affine-rows M p f base stride 0) (qb-labels M p 13 0)))))))
(defn- lm-terminal [M :vector-i64 tail :i64 cont :i64] :bool
 (and (> tail 0) (< tail MM-FN-CAP) (< tail (vector-at M MM-FN-N))
  (> cont 0) (< cont MM-FN-CAP) (< cont (vector-at M MM-FN-N))
  (= (gn-fnf M tail FF-NPARAMS) 2) (= (gn-fnf M tail FF-PT0) TY-VEC)
  (= (gn-fnf M tail (inc FF-PT0)) TY-I64) (= (gn-fnf M tail FF-RTYPE) TY-I64)
  (= (gn-fnf M cont FF-NPARAMS) 5) (= (gn-fnf M cont FF-PT0) TY-VEC)
  (qb-int-params M cont 1 4) (= (gn-fnf M cont (+ FF-PT0 4)) TY-BOOL)
  (= (gn-fnf M cont FF-RTYPE) TY-VEC)))
(defn- lm-homes [M :vector-i64 k :i64] :bool
 (or (= k 9) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
  (gm-distinct M k 1) (lm-homes M (inc k)))))
(defn- lm-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (> (vector-at M MM-FN-N) MM-FN-CAP)
  (> (vector-at M MM-SIR-N) MM-SIR-CAP) (> i (- (vector-at M MM-SIR-N) 103))
  (not= (gn-op M (dec i)) OP-FN)) false
  (let [p (dec i) f (gn-sir M p IF-A) affine (gn-sir M (+ p 17) IF-A)
   writer (gn-sir M (+ p 29) IF-A) tail (gn-sir M (+ p 93) IF-A) cont (gn-sir M (+ p 100) IF-A)]
   (and (ir-bound M f 104 6 8 6) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 5) (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 8) (= (gn-g M gn-f-dp) 6)
    (= (gn-g M gn-f-nsv) 8) (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-fb) 192)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
    (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (lm-homes M 1) (lm-affine M affine) (ir-bound M writer 9 3 3 3)
    (pc3-helper-type M writer 3 TY-VEC) (pc3-writer-shape M (gn-fnf M writer FF-SIR) writer)
    (qb-labels M (gn-fnf M writer FF-SIR) 9 0) (lm-terminal M tail cont)
    (lm-rows M p f writer affine tail cont 0) (qb-labels M p 104 0)
    (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 128))
    (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
    (>= (gn-g M di-sites) 0) (< (gn-g M di-sites) 256) (>= (gn-g M di-used) 0) (<= (gn-g M di-used) 3968)))))
;; All cold edges join original CURRENT head. Every complete iteration publishes
;; writer fuel before store, freshly reads chosen link afterward, then publishes
;; recurrence fuel after all original parameter updates. No publication batching.
(defn- lm-emit [M :vector-i64 i :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
  rv (gn-sreg M 1) ah (gn-sreg M 2) bh (gn-sreg M 3) rh (gn-sreg M 4)
  affine (gn-sir M (+ (dec i) 17) IF-A) ap (gn-fnf M affine FF-SIR)
  base (gn-sir M (+ ap 2) IF-B) stride (gn-sir M (+ ap 6) IF-B) G (vector-alloc 49)
  m0 (-> M (gn-emit (enc-cmp-i ah 0)) (gm-cold G (enc-cond-eq))
   (gn-emit (enc-cmp-i bh 0)) (gm-cold G (enc-cond-eq))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
   (gn-emit (enc-ldp 11 10 16 0))
   (gn-mov-imm 16 2147483648) (gn-emit (enc-cmp-r 11 16)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-cmp-r 10 16)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 9 7 328)) (gn-emit (gn-e-addsl 9 9 11 3))
   (gn-mov-imm 3 base) (gn-mov-imm 4 stride) (gn-mov-imm 6 256))
  head (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-cmp-i ah 0)) (gm-cold G (enc-cond-eq))
   (gn-emit (enc-cmp-i bh 0)) (gm-cold G (enc-cond-eq))
   (gn-emit (enc-cmp-i 6 0)) (gm-cold G (enc-cond-eq))
   (gn-mov-imm 16 2147483648) (gn-emit (enc-cmp-r ah 16)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-cmp-r bh 16)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-cmp-r rh 10)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-sub-i 11 ah 1)) (gn-emit (enc-mul 11 11 4)) (gn-emit (enc-add-r 11 11 3))
   (gn-emit (enc-add-i 13 11 1)) (gn-emit (enc-cmp-r 13 10)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-sub-i 12 bh 1)) (gn-emit (enc-mul 12 12 4)) (gn-emit (enc-add-r 12 12 3))
   (gn-emit (enc-add-i 14 12 1)) (gn-emit (enc-cmp-r 14 10)) (gm-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 2)) (gm-cold G (enc-cond-lo))
   (gn-emit (gn-e-addsl 11 9 11 3)) (gn-emit (gn-e-addsl 12 9 12 3))
   (gn-emit (enc-ldr 13 11 0)) (gn-emit (enc-ldr 14 12 0)) (gn-emit (enc-cmp-r 13 14)))
  choose (vector-at m1 MM-CODE-N) m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ge) 0))
   (gn-mov 0 ah) (gn-mov-imm 5 0)) jump (vector-at m2 MM-CODE-N)
  m3 (gn-emit m2 (enc-b 0)) right (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-mov 0 bh) (gn-mov 11 12) (gn-mov-imm 5 1)) common (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-sub-i 16 16 1)) (gn-emit (enc-str 16 7 CTX-FUEL))
   (gn-emit (gn-e-addsl 17 9 rh 3)) (gn-emit (enc-str 0 17 0))
   (gn-emit (enc-ldr 13 11 8))
   (gn-emit (enc-sub-i 14 0 1)) (gn-emit (enc-mul 14 14 4))
   (gn-emit (enc-add-r 14 14 3)) (gn-emit (enc-add-i 14 14 1))
   (gn-emit (enc-cmp-i 5 0))) update (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-mov ah 13)) ujump (vector-at m6 MM-CODE-N)
  m7 (gn-emit m6 (enc-b 0)) updateright (vector-at m7 MM-CODE-N)
  m8 (gn-mov m7 bh 13) recur (vector-at m8 MM-CODE-N)
  m9 (-> m8 (gn-mov rh 14) (gn-emit (enc-sub-i 6 6 1))
   (gn-emit (enc-sub-i 16 16 1)) (gn-emit (enc-str 16 7 CTX-FUEL))) back (vector-at m9 MM-CODE-N)
  m10 (gn-emit m9 (enc-b (- head back))) end (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-dot-patch choose right (enc-cond-ge))
   (gn-put (+ MM-CODE-BASE jump) (enc-b (- common jump)))
   (gn-dot-patch update updateright (enc-cond-ne))
   (gn-put (+ MM-CODE-BASE ujump) (enc-b (- recur ujump)))
   (gm-patch G 0 end) (gn-gs gn-f-dead dead))]
  (if (= (vector-at m11 MM-ERR) 0)
   (-> m11 (gn-gs di-sites (inc (gn-g m11 di-sites))) (gn-gs di-used (+ (gn-g m11 di-used) (- (vector-at m11 MM-CODE-N) cn))))
   (-> m11 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))))
(defn- lm-entry [M :vector-i64 i :i64] :vector-i64
 (if (lm-admit M i) (lm-emit M i) M))

;; Complete pure dense signed-i64 equality ladder; no guest data or fuel effects.
(defn- dl-end [M :vector-i64 f :i64 j :i64 work :i64] :i64
 (if (or (<= work 0) (>= j (vector-at M MM-SIR-N))) 0
  (case (gn-op M j)
   OP-END (if (gn-dot-at? M j OP-END f 0 0) j 0)
   OP-FN 0
   (dl-end M f (inc j) (dec work)))))
(defn- dl-stage [M :vector-i64 p :i64 n :i64 first :i64 k :i64] :bool
 (let [at (+ (+ p 2) (* 7 k)) els (gn-sir M (+ at 3) IF-B) join (gn-sir M (+ at 5) IF-A)
  val (gn-sir M (+ at 4) IF-B)]
  (and (gn-dot-at? M at OP-LGET 0 1 0)
   (gn-dot-at? M (inc at) OP-CONST 1 (+ first k) 0)
   (gn-dot-at? M (+ at 2) OP-CMP CC-EQ 0 0)
   (gn-dot-at? M (+ at 3) OP-BRZ 0 els 0)
   (gn-dot-at? M (+ at 4) OP-CONST 0 val 0)
   (gn-dot-at? M (+ at 5) OP-BR join 0 0)
   (gn-dot-at? M (+ at 6) OP-LABEL els 0 0)
   (> els 0) (< els MM-LABEL-CAP) (> join 0) (< join MM-LABEL-CAP)
   (gn-dot-at? M (- (+ p (+ (* 8 n) 2)) k) OP-LABEL join 0 0))))
(defn- dl-stages [M :vector-i64 p :i64 n :i64 first :i64 k :i64] :bool
 (or (= k n) (and (dl-stage M p n first k) (dl-stages M p n first (inc k)))))
(defn- dl-shape [M :vector-i64 p :i64 f :i64] :i64
 (let [end (dl-end M f (inc p) 32773) span (- end (+ p 4))]
  (if (or (<= end p) (< span 16) (not= (bit-and span 7) 0)) 0
   (let [n (quot span 8) first (gn-sir M (+ p 3) IF-B) head (gn-sir M (inc p) IF-A)
    default (gn-sir M (+ (+ p 2) (* 7 n)) IF-B)]
    (if (and (>= n 2) (<= n 4095) (<= first (- 9223372036854775807 (dec n)))
     (gn-dot-at? M p OP-FN f 1 1) (gn-dot-at? M (inc p) OP-LABEL head 0 0)
     (dl-stages M p n first 0) (gn-dot-at? M (+ (+ p 2) (* 7 n)) OP-CONST 0 default 0)
     (gn-dot-at? M (+ p (+ (* 8 n) 3)) OP-RET 0 0 0)
     (qb-labels M p (+ (* 8 n) 5) 0)) n 0)))))
(defn- dl-width [M :vector-i64 p :i64 n :i64 k :i64 w :i64] :i64
 (if (= k n) w
  (let [v (gn-sir M (+ (+ p 6) (* 7 k)) IF-B)]
   (dl-width M p n (inc k) (if (or (< v 0) (> v 4294967295)) 8 (if (> v 255) (gn-max w 4) w))))))
(defn- dl-admit [M :vector-i64 i :i64 f :i64 np :i64] :i64
 (if (or (not= np 1) (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))
  (> (vector-at M MM-FN-N) MM-FN-CAP) (<= i 0) (< (vector-at M MM-SIR-N) 21)
  (> (vector-at M MM-SIR-N) MM-SIR-CAP) (> i (- (vector-at M MM-SIR-N) 21))) 0
  (if (and (= (gn-fnf M f FF-SIR) i) (= (gn-fnf M f FF-NPARAMS) 1)
   (= (gn-fnf M f FF-NSLOTS) 1) (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-FUEL) 0)
   (= (gn-fnf M f FF-PT0) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-I64) (not (gn-clamp-open M f))
   (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 1) (= (gn-g M gn-f-dp) 2)
   (> (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-sreg M 1) 0)
   (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
   (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 32))
   (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) (dec MM-FIX-CAP))
   (> (vector-at M MM-LIT-N) 0) (< (vector-at M MM-LIT-N) MM-LIT-CAP)
   (>= (vector-at M MM-LITB-N) 0) (<= (vector-at M MM-LITB-N) MM-LITB-CAP)
   (>= (gn-g M di-sites) 0) (< (gn-g M di-sites) 256) (>= (gn-g M di-used) 0) (<= (gn-g M di-used) 4064))
   (dl-shape M i f) 0)))
(defn- dl-data [M :vector-i64 p :i64 n :i64 width :i64 base :i64 k :i64] :vector-i64
 (if (= k n) M
  (let [v (gn-sir M (+ (+ p 6) (* 7 k)) IF-B)]
   (do (dotimes [j width]
    (gn-put M (+ MM-LITB-BASE (+ base (+ (* k width) j))) (bit-and (u64-shift-right v (* j 8)) 255)))
    (dl-data M p n width base (inc k))))))
(defn- dl-emit [M :vector-i64 p :i64 n :i64 width :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) ln (vector-at M MM-LIT-N) lb (vector-at M MM-LITB-N)
  dead (gn-g M gn-f-dead) first (gn-sir M (+ p 3) IF-B) default (gn-sir M (+ (+ p 2) (* 7 n)) IF-B)
  r (+ MM-LIT-BASE (* ln MM-LIT-W))
  m0 (-> M (dl-data p n width lb 0) (gn-put (+ r LF-B) lb) (gn-put (+ r LF-LEN) (* n width))
   (gn-put (+ r LF-TOK) 0) (gn-put (+ r LF-POOL) 0) (gn-put MM-LIT-N (inc ln)) (gn-put MM-LITB-N (+ lb (* n width))))
  m1 (if (= first 0) (gn-mov m0 9 0) (-> m0 (gn-mov-imm 16 first) (gn-emit (enc-sub-r 9 0 16))))
  m2 (gn-emit m1 (enc-cmp-i 9 n)) outside (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))
   (gn-emit (gn-e-addsl 17 17 9 (if (= width 1) 0 (if (= width 4) 2 3))))
   (gn-fix FX-LIT32 ln) (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1)))
  m4 (gn-emit m3 (if (= width 8) (gn-e-ldrr 0 17 16 0)
   (+ (if (= width 1) 0x38606800 0xb8606800) (+ (i64-shift-left 16 16) (i64-shift-left 17 5)))))
  m5 (gn-emit m4 (enc-ret)) out (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-mov-imm 0 default) (gn-emit (enc-ret)) (gn-dot-patch outside out (enc-cond-hs)) (gn-gs gn-f-dead dead))]
  (if (= (vector-at m6 MM-ERR) 0)
   (-> m6 (gn-gs di-sites (inc (gn-g m6 di-sites))) (gn-gs di-used (+ (gn-g m6 di-used) (- (vector-at m6 MM-CODE-N) cn))))
   (-> m6 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-put MM-LIT-N ln) (gn-put MM-LITB-N lb) (gn-gs gn-f-dead dead)))))
(defn- dl-entry [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (let [n (dl-admit M i f np)]
  (if (= n 0) M
   (let [width (dl-width M i n 0 1)]
    (if (> (vector-at M MM-LITB-N) (- MM-LITB-CAP (* n width))) M (dl-emit M i n width))))))

;; Pure bounded piecewise affine lookup. All out-of-domain i64 inputs stay cold.
(defn- pa-arm [M :vector-i64 j :i64 end :i64] :i64
 (if (or (<= j 0) (>= j end)) 0
  (if (gn-dot-at? M j OP-LGET 0 1 0) 1
   (if (>= (+ j 4) end) 0
    (let [mul (gn-sir M j IF-B) v (gn-sir M (+ j 3) IF-B)]
     (if (and (gn-dot-at? M j OP-CONST 0 mul 0)
       (gn-dot-at? M (+ j 1) OP-LGET 1 1 0)
       (gn-dot-at? M (+ j 2) OP-BIN BOP-MUL 0 0))
      (cond
       (and (gn-dot-at? M (+ j 3) OP-CONST 1 v 0)
            (gn-dot-at? M (+ j 4) OP-BIN BOP-AND 0 0)) 5
       (and (< (+ j 6) end) (gn-dot-at? M (+ j 3) OP-CONST 1 v 0)
            (gn-dot-at? M (+ j 4) OP-BIN BOP-ADD 0 0)
            (gn-dot-at? M (+ j 5) OP-CONST 1 (gn-sir M (+ j 5) IF-B) 0)
            (gn-dot-at? M (+ j 6) OP-BIN BOP-AND 0 0)) 7
       :else 0) 0))))))
(defn- pa-chain [M :vector-i64 j :i64 end :i64 last :i64 n :i64 affine :i64] :i64
 (if (or (<= j 0) (>= j end) (> n 8)) 0
  (if (and (< (+ j 4) end) (gn-dot-at? M j OP-LGET 0 1 0)
       (gn-dot-at? M (+ j 1) OP-CONST 1 (gn-sir M (+ j 1) IF-B) 0)
       (gn-dot-at? M (+ j 2) OP-CMP CC-LT 0 0))
   (let [cut (gn-sir M (+ j 1) IF-B) els (gn-sir M (+ j 3) IF-B)
         arm (pa-arm M (+ j 4) end) br (+ (+ j 4) arm)
         join (if (< br end) (gn-sir M br IF-A) 0)]
    (if (and (< n 8) (> cut last) (<= cut 256) (> arm 0) (< (+ br 1) end)
      (gn-dot-at? M (+ j 3) OP-BRZ 0 els 0)
      (> els 0) (< els MM-LABEL-CAP) (> join 0) (< join MM-LABEL-CAP)
      (gn-dot-at? M br OP-BR join 0 0)
      (gn-dot-at? M (+ br 1) OP-LABEL els 0 0)
      (gn-dot-at? M (- (- end 2) n) OP-LABEL join 0 0))
     (pa-chain M (+ br 2) end cut (inc n) (+ affine (if (> arm 1) 1 0))) 0))
   (let [arm (pa-arm M j end)]
    (if (and (>= n 2) (<= n 8) (> arm 0) (>= (+ affine (if (> arm 1) 1 0)) 2)
      (= (+ j arm) (- (- end 1) n)) (gn-dot-at? M (dec end) OP-RET 0 0 0)) n 0)))))
(defn- pa-shape [M :vector-i64 p :i64 f :i64] :i64
 (let [end (dl-end M f (inc p) 128) head (gn-sir M (inc p) IF-A)]
  (if (and (> end (+ p 20)) (<= end (+ p 128))
   (gn-dot-at? M p OP-FN f 1 1) (gn-dot-at? M (inc p) OP-LABEL head 0 0)
   (> head 0) (< head MM-LABEL-CAP) (qb-labels M p (+ (- end p) 1) 0)
   (> (pa-chain M (+ p 2) end 0 0 0) 0)) end 0)))
(defn- pa-value-arm [M :vector-i64 j :i64 end :i64 x :i64] :i64
 (let [arm (pa-arm M j end)]
  (if (= arm 1) x
   (let [product (* (gn-sir M j IF-B) x)
         bias (if (= arm 7) (gn-sir M (+ j 3) IF-B) 0)
         mask (gn-sir M (+ j (if (= arm 7) 5 3)) IF-B)]
    (bit-and (+ product bias) mask)))))
(defn- pa-value [M :vector-i64 j :i64 end :i64 x :i64] :i64
 (if (gn-dot-at? M (+ j 2) OP-CMP CC-LT 0 0)
  (if (< x (gn-sir M (+ j 1) IF-B)) (pa-value-arm M (+ j 4) end x)
   (pa-value M (+ (+ j 6) (pa-arm M (+ j 4) end)) end x))
  (pa-value-arm M j end x)))
(defn- pa-width [M :vector-i64 p :i64 end :i64 x :i64 width :i64] :i64
 (if (= x 256) width
  (let [v (pa-value M (+ p 2) end x)]
   (pa-width M p end (inc x) (if (or (< v 0) (> v 4294967295)) 8
       (if (> v 255) (gn-max width 4) width))))))
(defn- pa-admit [M :vector-i64 i :i64 f :i64 np :i64] :i64
 (if (or (not= np 1) (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))
  (> (vector-at M MM-FN-N) MM-FN-CAP) (<= i 0) (> (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> i (- (vector-at M MM-SIR-N) 21))) 0
  (if (and (= (gn-fnf M f FF-SIR) i) (= (gn-fnf M f FF-NPARAMS) 1)
   (= (gn-fnf M f FF-NSLOTS) 1) (= (gn-fnf M f FF-DEPTH) 2) (= (gn-fnf M f FF-FUEL) 0)
   (= (gn-fnf M f FF-PT0) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-I64) (not (gn-clamp-open M f))
   (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 1) (= (gn-g M gn-f-dp) 2)
   (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 0) (= (gn-sreg M 1) 0)
   (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
   (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 32))
   (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) (dec MM-FIX-CAP))
   (> (vector-at M MM-LIT-N) 0) (< (vector-at M MM-LIT-N) MM-LIT-CAP)
   (>= (vector-at M MM-LITB-N) 0) (<= (vector-at M MM-LITB-N) (- MM-LITB-CAP 256)))
   (pa-shape M i f) 0)))
(defn- pa-data [M :vector-i64 p :i64 end :i64 width :i64 base :i64 x :i64] :vector-i64
 (if (= x 256) M
  (let [v (pa-value M (+ p 2) end x)]
   (do (dotimes [j width]
    (gn-put M (+ MM-LITB-BASE (+ base (+ (* x width) j))) (bit-and (u64-shift-right v (* j 8)) 255)))
    (pa-data M p end width base (inc x))))))
(defn- pa-emit [M :vector-i64 p :i64 end :i64 width :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) ln (vector-at M MM-LIT-N) lb (vector-at M MM-LITB-N)
  dead (gn-g M gn-f-dead) r (+ MM-LIT-BASE (* ln MM-LIT-W))
  m0 (-> M (pa-data p end width lb 0) (gn-put (+ r LF-B) lb) (gn-put (+ r LF-LEN) (* 256 width))
   (gn-put (+ r LF-TOK) 0) (gn-put (+ r LF-POOL) 0) (gn-put MM-LIT-N (inc ln)) (gn-put MM-LITB-N (+ lb (* 256 width))))
  m1 (gn-emit m0 (enc-cmp-i 0 256)) outside (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))
   (gn-emit (gn-e-addsl 17 17 0 (if (= width 1) 0 (if (= width 4) 2 3))))
   (gn-fix FX-LIT32 ln) (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1)))
  m3 (gn-emit m2 (if (= width 8) (gn-e-ldrr 0 17 16 0)
   (+ (if (= width 1) 0x38606800 0xb8606800) (+ (i64-shift-left 16 16) (i64-shift-left 17 5)))))
