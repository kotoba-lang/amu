(defn- sd-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (< (vector-at M MM-SIR-N) 139) (> i (- (vector-at M MM-SIR-N) 138)) (not= (gn-op M (dec i)) OP-FN)) false
 (let [p (dec i) f (gn-sir M p IF-A) L (gn-sir M (+ p 11) IF-B)
  a (gn-sir M (+ p 38) IF-B) b (gn-sir M (+ p 63) IF-B) d (- b a)]
