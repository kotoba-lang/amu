(defn- lc-writer [M :vector-i64 w :i64] :bool
 (if (not (ir-bound M w 9 3 3 3)) false
 (let [p (gn-fnf M w FF-SIR)]
  (and (= (gn-fnf M w FF-RTYPE) TY-VEC) (= (gn-fnf M w FF-PT0) TY-VEC) (qb-int-params M w 1 3)
   (lc-wrow M p w 0) (lc-wrow M p w 1) (lc-wrow M p w 2) (lc-wrow M p w 3)
   (lc-wrow M p w 4) (lc-wrow M p w 5) (lc-wrow M p w 6) (lc-wrow M p w 7) (lc-wrow M p w 8)
   (qb-labels M p 9 0)))))
(defn- lc-remrows [M :vector-i64 p :i64 r :i64 k :i64] :bool
 (or (= k 11) (and (lc-rrow M p r k) (lc-remrows M p r (inc k)))))
(defn- lc-rem [M :vector-i64 r :i64] :bool
 (if (or (<= r 0) (>= r (vector-at M MM-FN-N)) (>= r MM-FN-CAP)) false
 (let [p (gn-fnf M r FF-SIR)]
  (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 11)) (not (gn-clamp-open M r))
   (= (gn-fnf M r FF-NPARAMS) 2) (= (gn-fnf M r FF-NSLOTS) 2) (= (gn-fnf M r FF-DEPTH) 4)
   (= (gn-fnf M r FF-FUEL) 0) (= (gn-fnf M r FF-RTYPE) TY-I64) (qb-int-params M r 0 2)
