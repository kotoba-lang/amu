  19 (uc-row M (+ p 19) 13 e 4 2)
  20 (uc-row M (+ p 20) 13 s 3 2)
  21 (uc-row M (+ p 21) 3 4 16 0)
  22 (uc-row M (+ p 22) 6 8 3 0)
  23 (uc-row M (+ p 23) 4 4 1 0)
  24 (uc-row M (+ p 24) 4 5 5 0)
  25 (uc-row M (+ p 25) 3 6 24 0)
  26 (uc-row M (+ p 26) 13 e 5 2)
  27 (uc-row M (+ p 27) 13 s 4 2)
  28 (uc-row M (+ p 28) 3 5 24 0)
  29 (uc-row M (+ p 29) 6 8 4 0)
  30 (uc-row M (+ p 30) 13 o 1 4)
  31 (uc-row M (+ p 31) 6 7 0 0)
  32 (uc-row M (+ p 32) 19 0 0 0)
  33 (uc-row M (+ p 33) 2 f 0 0)
  false))
(defn- tt-rows [M :vector-i64 p :i64 f :i64 h :i64 e :i64 s :i64 o :i64 k :i64] :bool
 (if (= k 34) true (and (tt-row M p f h e s o k)
  (tt-rows M p f h e s o (inc k)))))
(defn- tt-admit [M :vector-i64 f :i64 n :i64] :bool
 (and (= n 6) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
  (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (<= (vector-at M MM-FN-N) MM-FN-CAP) (not (gn-clamp-open M f))
  (>= (vector-at M MM-SIR-N) 34) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) 34))
  (= (gn-fnf M f FF-NPARAMS) 6) (= (gn-fnf M f FF-NSLOTS) 6)
  (= (gn-fnf M f FF-DEPTH) 7) (= (gn-fnf M f FF-FUEL) 1)
  (= (gn-fnf M f FF-RTYPE) TY-I64) (qb-int-params M f 0 5)
  (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 4000)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 96))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) (- MM-FIX-CAP 9))
  (> (vector-at M MM-LIT-N) 0) (<= (vector-at M MM-LIT-N) (- MM-LIT-CAP 2))
  (>= (vector-at M MM-LITB-N) 0) (<= (vector-at M MM-LITB-N) (- MM-LITB-CAP 512))
  (let [p (gn-fnf M f FF-SIR) h (gn-sir M (+ p 2) IF-A)
   e (gn-sir M (+ p 7) IF-A) s (gn-sir M (+ p 8) IF-A) o (gn-sir M (+ p 30) IF-A)]
   (and (tt-rows M p f h e s o 0) (qb-labels M p 34 0)
    (> e 0) (< e MM-FN-CAP) (< e (vector-at M MM-FN-N))
    (not (gn-clamp-open M e)) (> (gn-fnf M e FF-SIR) 0)
    (<= (gn-fnf M e FF-SIR) (- (vector-at M MM-SIR-N) 9))
    (sx-body? M e (gn-fnf M e FF-SIR)) (= (gn-fnf M e FF-FUEL) 0)
    (= (gn-sir M (+ (gn-fnf M e FF-SIR) 5) IF-B) 255)
    (qb-labels M (gn-fnf M e FF-SIR) 9 0)
    (aw-child M o BOP-OR) (qb-labels M (gn-fnf M o FF-SIR) 11 0)
    (st-admit M s 2)
    (let [sp (gn-fnf M s FF-SIR) a (gn-sir M (+ sp 8) IF-A) b (gn-sir M (+ sp 12) IF-A)
     ap (gn-fnf M a FF-SIR) bp (gn-fnf M b FF-SIR)]
     (and (= (pt-width M (gn-sir M (+ ap 8) IF-B) (gn-sir M (+ ap 14) IF-B) 0 1) 1)
      (= (pt-width M (gn-sir M (+ bp 8) IF-B) (gn-sir M (+ bp 14) IF-B) 0 1) 1)))))))
;; Sixth owner key has no FF-PT5; exact LGET0slot6 feeds typed i64 BOP-XOR
;; with typed OR4 result under checked/lowered SIR provenance.
(defn- tt-lane [M :vector-i64 lit :i64 r :i64 shift :i64] :vector-i64
 (let [m0 (-> M (gn-emit (gn-e-bf 0xd3400000 16 r shift (+ shift 7)))
  (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-emit (gn-e-addsl 17 17 16 0))
  (gn-fix FX-LIT32 lit) (gn-emit (enc-movz 5 0 0)) (gn-emit (enc-movk 5 0 1))
  (gn-emit (+ 0x38606800 (+ (i64-shift-left 5 16) (+ (i64-shift-left 17 5) 16)))))
  m1 (if (= shift 0) m0 (gn-emit m0 (gn-e-lsl 16 16 shift)))]
  (gn-emit m1 (enc-orr-r 0 0 16))))
(defn- tt-family [M :vector-i64 lit :i64 k :i64] :vector-i64
 (if (= k 4) M (tt-family (tt-lane M lit (inc k) (* k 8)) lit (inc k))))
(defn- tt-transfer [M :vector-i64 f :i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) fn (vector-at M MM-FIX-N)
  ln (vector-at M MM-LIT-N) lb (vector-at M MM-LITB-N)
  p (gn-fnf M f FF-SIR) sp (gn-fnf M (gn-sir M (+ p 8) IF-A) FF-SIR)
  a (gn-sir M (+ sp 8) IF-A) b (gn-sir M (+ sp 12) IF-A)
  la (pt-pack M a) lbb (pt-pack M b)
  m0 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 9)))
  low (vector-at m0 MM-CODE-N) m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-emit (enc-sub-i 16 16 9)) (gn-emit (enc-str 16 7 CTX-FUEL))
   (gn-mov 6 5) (gn-emit (enc-cmp-i 0 0))) family (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-mov-imm 0 0) (tt-family la 0))
  join (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-b 0)) second (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-mov-imm 0 0) (tt-family lbb 0)) done (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-eor-r 0 0 6)) (gn-emit (enc-b 2)))
  fallback (vector-at m5 MM-CODE-N) m6 (-> m5 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))
   (gn-dot-patch low fallback (enc-cond-lo)) (gn-dot-patch family second (enc-cond-ne))
   (gn-put (+ MM-CODE-BASE join) (enc-b (- done join))))]
  (if (= (vector-at m6 MM-ERR) 0)
   (-> m6 (gn-gs di-sites (inc (gn-g m6 di-sites)))
    (gn-gs di-used (+ (gn-g m6 di-used) (- (vector-at m6 MM-CODE-N) cn))))
   (-> m6 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fn)
    (gn-put MM-LIT-N ln) (gn-put MM-LITB-N lb)))))

;; Generic table-base hoist on adopted packed immutable normal-loop parent.
(defn- ho-bases [M :vector-i64 S :vector-i64 family :i64 k :i64] :vector-i64
 (if (= k 4) M
  (let [home (gn-sreg M (+ k 4)) lit (vector-at S (inc (* (+ (* family 4) k) 3)))]
   (ho-bases (-> M (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))
    (gn-fix FX-LIT32 lit) (gn-emit (enc-movz home 0 0)) (gn-emit (enc-movk home 0 1))
    (gn-emit (enc-add-r home 17 home))) S family (inc k)))))
(defn- ho-lane [M :vector-i64 S :vector-i64 k :i64 r :i64 shift :i64] :vector-i64
 (let [home (gn-sreg M (+ 4 (bit-and k 3))) width (vector-at S (+ (* k 3) 2))]
  (-> M (gn-emit (gn-e-bf 0xd3400000 5 r shift (+ shift 7)))
   (gn-emit (+ (if (= width 1) 0x38606800 0xb8607800)
    (+ (i64-shift-left 5 16) (+ (i64-shift-left home 5) 4))))
   (gn-emit (enc-eor-r 6 6 4)))))
