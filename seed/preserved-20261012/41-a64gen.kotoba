  m49 (gn-dot-patch m48 gtarget fallback (enc-cond-hs))
  m50 (gn-dot-patch m49 handle fallback (enc-cond-hs))
  m51 (gn-dot-patch m50 range fallback (enc-cond-hs))
  m52 (gn-dot-patch m51 wrap fallback (enc-cond-lo))
  m53 (gn-dot-patch m52 scale fallback 8)
  m54 (gn-dot-patch m53 end no (enc-cond-eq))
  m55 (gn-dot-patch m54 nonzero positive (enc-cond-ne))
  m56 (gn-dot-patch m55 bothzero yesfound (enc-cond-eq))
