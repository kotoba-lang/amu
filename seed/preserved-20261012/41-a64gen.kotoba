(defn- tpin-rows [M :vector-i64 p :i64 f :i64 a :i64 b :i64 k :i64] :bool
 (or (= k 83) (and (tpin-row M p f a b k) (tpin-rows M p f a b (inc k)))))
(defn- tpin-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (< (vector-at M MM-SIR-N) 83)
  (> i (- (vector-at M MM-SIR-N) 82)) (not= (gn-op M (dec i)) OP-FN)) false
  (let [p (dec i) f (gn-sir M p IF-A) a (gn-sir M (+ p 8) IF-B) b (gn-sir M (+ p 13) IF-B)]
   (and (ir-bound M f 83 4 8 4) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 4) (>= a 0) (<= a 1048575) (>= b 0) (<= b 1048575)
    (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 8) (= (gn-g M gn-f-dp) 4)
    (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
    (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-nsv) 1) (= (gn-g M gn-f-fb) 128)
    (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2) (= (gn-sreg M 4) 3)
    (= (gn-sreg M 8) 19) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0)
    (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 128))
    (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
    (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 3968)
    (tpin-rows M p f a b 0) (qb-labels M p 83 0)))))
(defn- tpin-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) a (gn-sir M (+ p 8) IF-B) b (gn-sir M (+ p 13) IF-B)
  cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
  m0 (-> M (gn-mov-imm 16 4096) (gn-emit (enc-cmp-r 1 16))) cap (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 8 1)))
  fuel (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) handle (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 14 7 320)) (gn-emit (gn-e-addsl 14 14 17 4))
   (gn-emit (enc-ldp 10 11 14 0)) (gn-mov-imm 16 (gn-max a b))
   (gn-emit (enc-add-r 16 16 1)) (gn-emit (enc-cmp-r 16 11))) bounds (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-add-r 16 10 16)) (gn-emit (enc-cmp-r 16 10))) wrap (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-mov-imm 17 1152921504606846975) (gn-emit (enc-cmp-r 16 17))) scale (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-ldr 14 7 328))
   (gn-emit (gn-e-addsl 14 14 10 3)) (gn-mov-imm 16 a) (gn-emit (enc-add-r 16 16 1))
   (gn-emit (gn-e-addsl 10 14 16 3)) (gn-mov-imm 17 b) (gn-emit (enc-add-r 17 17 1))
   (gn-emit (gn-e-addsl 11 14 17 3)) (gn-mov 9 1)) loop (vector-at m6 MM-CODE-N)
  m7 (gn-emit m6 (enc-cmp-i 9 0)) zero (vector-at m7 MM-CODE-N)
  m8 (-> m7 (gn-emit (enc-bcond (enc-cond-eq) 0))
   (gn-emit (enc-sub-i 16 10 8)) (gn-emit (enc-ldr 12 16 0))
   (gn-emit (enc-sub-i 17 11 8)) (gn-emit (enc-ldr 13 17 0))
   (gn-emit (enc-cmp-r 2 12))) finish (vector-at m8 MM-CODE-N)
  m9 (-> m8 (gn-emit (enc-bcond (enc-cond-ge) 0))
   (gn-emit (enc-str 12 10 0)) (gn-emit (enc-str 13 11 0))
   (gn-emit (enc-sub-i 10 10 8)) (gn-emit (enc-sub-i 11 11 8))
   (gn-emit (enc-sub-i 9 9 1)) (gn-emit (enc-sub-i 8 8 1))) back (vector-at m9 MM-CODE-N)
  m10 (gn-emit m9 (enc-b (- loop back))) done (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-emit (enc-str 2 10 0)) (gn-emit (enc-str 3 11 0)) (gn-epilogue))
  fallback (vector-at m11 MM-CODE-N)
  m12 (-> m11 (gn-dot-patch cap fallback (enc-cond-hs))
   (gn-dot-patch fuel fallback (enc-cond-lo)) (gn-dot-patch handle fallback (enc-cond-hs))
   (gn-dot-patch bounds fallback (enc-cond-hs)) (gn-dot-patch wrap fallback (enc-cond-lo))
   (gn-dot-patch scale fallback 8) (gn-dot-patch zero done (enc-cond-eq))
   (gn-dot-patch finish done (enc-cond-ge)) (gn-gs gn-f-dead dead))]
  (if (= (vector-at m12 MM-ERR) 0)
   (-> m12 (gn-gs di-sites (inc (gn-g m12 di-sites)))
    (gn-gs di-used (+ (gn-g m12 di-used) (- (vector-at m12 MM-CODE-N) cn))))
   (-> m12 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))))
(defn- tpin-entry [M :vector-i64 i :i64] :vector-i64
 (if (tpin-admit M i) (tpin-emit M i) M))

(defn- btg-walk [M :vector-i64 f :i64] :bool
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N)]
  (if (or (<= f 0) (>= f fnn) (> fnn MM-FN-CAP)
    (> sn MM-SIR-CAP) (< sn 77)) false
   (let [p (gn-fnf M f FF-SIR)]
    (if (or (<= p 0) (> p (- sn 77))) false
     (let [flag (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 39) IF-B)]
      (and (not (gn-clamp-open M f)) (= (gn-fnf M f FF-NPARAMS) 5)
       (= (gn-fnf M f FF-NSLOTS) 9) (= (gn-fnf M f FF-DEPTH) 5)
       (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-RTYPE) TY-I64)
       (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 5)
       (> flag 1) (<= flag 256) (> (gn-pow2 flag) 0)
       (> stride 1) (<= stride 256) (> (gn-pow2 stride) 0)
       (gt-constants M p 0) (gt-shape M p f 0) (qb-labels M p 77 0))))))))

