(defn- zc-rows [M :vector-i64 p :i64 f :i64 stride :i64 k :i64] :bool
 (or (= k 64) (and (zc-row M p f stride k) (zc-rows M p f stride (inc k)))))
(defn- zc-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (< (vector-at M MM-SIR-N) 64) (> i (- (vector-at M MM-SIR-N) 63)) (not= (gn-op M (dec i)) OP-FN) (> (vector-at M MM-FN-N) MM-FN-CAP)) false
 (let [p (dec i) f (gn-sir M p IF-A) stride (gn-sir M (+ p 5) IF-B)]
  (and (ir-bound M f 64 4 6 5) (= (gn-fnf M f FF-SIR) p)
   (= (gn-fnf M f FF-RTYPE) TY-BOOL) (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 4)
   (> stride 0) (<= stride 4095) (= (gn-g M fr-owner) f)
   (= (gn-g M gn-f-ns) 6) (= (gn-g M gn-f-dp) 5)
   (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-out) 0)
   (= (gn-g M gn-f-nsv) 0) (= (gn-g M gn-f-fb) 0)
   (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2) (= (gn-sreg M 4) 3)
   (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (= (vector-at M MM-ERR) 0)
   (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 128))
   (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
   (>= (gn-g M di-sites) 0) (>= (gn-g M di-used) 0) (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 3968)
   (zc-rows M p f stride 0) (qb-labels M p 64 0)))))
(defn- zc-emit [M :vector-i64 i :i64] :vector-i64
 (let [stride (gn-sir M (+ (dec i) 5) IF-B)
  cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
  m0 (-> M (gn-mov-imm 16 stride) (gn-emit (enc-cmp-r 3 16))) gp (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 17 2147483648) (gn-emit (enc-cmp-r 1 17))) gl (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 2 17))) gr (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 1 2)) (gn-emit (enc-csel 11 1 2 (enc-cond-hs)))
   (gn-emit (enc-add-i 11 11 1)) (gn-emit (enc-mul 11 11 16)) (gn-emit (enc-sub-i 11 11 1))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) gh (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
   (gn-emit (enc-ldp 9 10 16 0)) (gn-emit (enc-cmp-r 11 10))) gx (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-add-r 16 9 11)) (gn-emit (enc-cmp-r 16 9))) gw (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-mov-imm 17 1152921504606846975) (gn-emit (enc-cmp-r 16 17))) gs (vector-at m6 MM-CODE-N)
  m7 (-> m6 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 9 16 9 3))
   (gn-mov-imm 16 stride) (gn-emit (enc-madd 10 1 16 3)) (gn-emit (enc-madd 11 2 16 3))
   (gn-emit (gn-e-addsl 10 9 10 3)) (gn-emit (gn-e-addsl 11 9 11 3))
   (gn-emit (enc-sub-r 12 16 3)) (gn-mov-imm 13 0)) loop (vector-at m7 MM-CODE-N)
  m8 (-> m7 (gn-emit (enc-ldr 14 10 0)) (gn-emit (enc-ldr 15 11 0)) (gn-emit (enc-cmp-i 14 0))) zero (vector-at m8 MM-CODE-N)
  m9 (gn-emit m8 (enc-bcond (enc-cond-eq) 0)) negA (vector-at m9 MM-CODE-N)
  m10 (-> m9 (gn-emit (enc-bcond 13 0)) (gn-emit (enc-cmp-i 15 0))) negB (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-emit (enc-bcond 13 0)) (gn-emit (enc-cmp-r 14 15))) unequal (vector-at m11 MM-CODE-N)
  m12 (-> m11 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-add-i 10 10 8)) (gn-emit (enc-add-i 11 11 8))
   (gn-emit (enc-add-i 13 13 1)) (gn-emit (enc-sub-i 12 12 1)) (gn-emit (enc-cmp-i 12 0))) cap (vector-at m12 MM-CODE-N)
  m13 (gn-emit m12 (enc-bcond (enc-cond-eq) 0)) back (vector-at m13 MM-CODE-N)
  m14 (gn-emit m13 (enc-b (- loop back))) ztest (vector-at m14 MM-CODE-N)
  m15 (gn-emit m14 (enc-cmp-i 15 0)) both (vector-at m15 MM-CODE-N)
  m16 (gn-emit m15 (enc-bcond (enc-cond-eq) 0)) falseAt (vector-at m16 MM-CODE-N)
  m17 (gn-mov-imm m16 16 0) join (vector-at m17 MM-CODE-N)
  m18 (gn-emit m17 (enc-b 0)) trueAt (vector-at m18 MM-CODE-N)
  m19 (gn-mov-imm m18 16 1) finish (vector-at m19 MM-CODE-N)
  m20 (gn-emit m19 (enc-cmp-r 8 13)) gf (vector-at m20 MM-CODE-N)
  m21 (-> m20 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-sub-r 8 8 13)) (gn-mov 0 16))
  m22 (gn-epilogue m21) fallback (vector-at m22 MM-CODE-N)
  m23 (-> m22 (gn-dot-patch gp fallback (enc-cond-hs)) (gn-dot-patch gl fallback (enc-cond-hs)) (gn-dot-patch gr fallback (enc-cond-hs))
   (gn-dot-patch gh fallback (enc-cond-hs)) (gn-dot-patch gx fallback (enc-cond-hs)) (gn-dot-patch gw fallback (enc-cond-lo)) (gn-dot-patch gs fallback 8)
   (gn-dot-patch zero ztest (enc-cond-eq)) (gn-dot-patch negA falseAt 13) (gn-dot-patch negB falseAt 13) (gn-dot-patch unequal falseAt (enc-cond-ne))
   (gn-dot-patch cap fallback (enc-cond-eq)) (gn-dot-patch both trueAt (enc-cond-eq))
   (gn-put (+ MM-CODE-BASE join) (enc-b (- finish join))) (gn-dot-patch gf fallback (enc-cond-lo)) (gn-gs gn-f-dead dead))]
  (if (= (vector-at m23 MM-ERR) 0)
   (-> m23 (gn-gs di-sites (inc (gn-g m23 di-sites))) (gn-gs di-used (+ (gn-g m23 di-used) (- (vector-at m23 MM-CODE-N) cn))))
   (-> m23 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))))
(defn- zc-entry [M :vector-i64 i :i64] :vector-i64
 (if (zc-admit M i) (zc-emit M i) M))

;; Closed masked recurrence with per-operation original shared fuel publication.
(defn- lc-wrow [M :vector-i64 p :i64 w :i64 k :i64] :bool
 (let [l2 (gn-sir M (+ p 2) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 w 3 3)
   1 (gn-dot-at? M (+ p 1) 18 0 0 0)
   2 (gn-dot-at? M (+ p 2) 9 l2 0 0)
   3 (gn-dot-at? M (+ p 3) 4 0 1 0)
   4 (gn-dot-at? M (+ p 4) 4 1 2 0)
   5 (gn-dot-at? M (+ p 5) 4 2 3 0)
   6 (gn-dot-at? M (+ p 6) 14 208 0 3)
   7 (gn-dot-at? M (+ p 7) 19 0 0 0)
   8 (gn-dot-at? M (+ p 8) 2 w 0 0)
   false)))
(defn- lc-rrow [M :vector-i64 p :i64 r :i64 k :i64] :bool
 (let [l1 (gn-sir M (+ p 1) IF-A)]
  (case k
   0 (gn-dot-at? M (+ p 0) 1 r 2 2)
   1 (gn-dot-at? M (+ p 1) 9 l1 0 0)
   2 (gn-dot-at? M (+ p 2) 4 0 1 0)
   3 (gn-dot-at? M (+ p 3) 4 1 2 0)
   4 (gn-dot-at? M (+ p 4) 4 2 1 0)
   5 (gn-dot-at? M (+ p 5) 4 3 2 0)
   6 (gn-dot-at? M (+ p 6) 6 4 2 0)
   7 (gn-dot-at? M (+ p 7) 6 3 1 0)
   8 (gn-dot-at? M (+ p 8) 6 2 0 0)
   9 (gn-dot-at? M (+ p 9) 19 0 0 0)
   10 (gn-dot-at? M (+ p 10) 2 r 0 0)
   false)))
