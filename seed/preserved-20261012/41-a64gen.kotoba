(defn- btg-rows [M :vector-i64 p :i64 f :i64 walk :i64 writer :i64 classes :i64 per :i64 votes :i64 k :i64] :bool
 (if (= k 88) true
  (and (btg-row M p f walk writer classes per votes k)
   (btg-rows M p f walk writer classes per votes (inc k)))))
(defn- btg-owner [M :vector-i64 f :i64] :bool
 (if (not (ir-bound M f 88 7 10 8)) false
  (let [p (gn-fnf M f FF-SIR) walk (gn-sir M (+ p 43) IF-A)
   writer (gn-sir M (+ p 56) IF-A) classes (gn-sir M (+ p 4) IF-B)
   per (gn-sir M (+ p 11) IF-B) votes (gn-sir M (+ p 46) IF-B)]
   (and (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (qb-int-params M f 1 5) (> classes 0) (<= classes 10)
    (> per 0) (<= per 256) (>= votes 0) (<= votes 1048575)
    (btg-walk M walk) (ir-bound M writer 9 3 3 3)
    (pc3-helper-type M writer 3 TY-VEC)
    (pc3-writer-shape M (gn-fnf M writer FF-SIR) writer)
    (qb-labels M (gn-fnf M writer FF-SIR) 9 0)
    (btg-rows M p f walk writer classes per votes 0) (qb-labels M p 88 0)))))

;; start x8,last x16, payload x0,length x1. Scratch17 only. No guest effects.
(defn- btg-span [M :vector-i64 G :vector-i64 votes :i64 classes :i64] :vector-i64
 (let [m0 (-> M (gn-emit (enc-cmp-r 16 1)) (gt-cold G (enc-cond-hs))
   (gn-mov-imm 17 votes) (gn-emit (enc-cmp-r 16 17)))
  ok (vector-at m0 MM-CODE-N) m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0))
   (gn-mov-imm 17 (+ votes classes)) (gn-emit (enc-cmp-r 8 17))
   (gt-cold G (enc-cond-lo))) end (vector-at m1 MM-CODE-N)]
  (gn-dot-patch m1 ok end (enc-cond-lo))))
