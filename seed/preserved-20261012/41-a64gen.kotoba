(defn- qb-weight-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 61) true (and (qb-weight-row M p f k) (qb-weight-rows M p f (inc k)))))
(defn- qb-rem-row [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 2 2)
  1 (uc-row M (+ p 1) 9 (gn-sir M (+ p 1) IF-A) 0 0)
  2 (uc-row M (+ p 2) 4 0 1 0)
  3 (uc-row M (+ p 3) 4 1 2 0)
  4 (uc-row M (+ p 4) 4 2 1 0)
  5 (uc-row M (+ p 5) 4 3 2 0)
  6 (uc-row M (+ p 6) 6 4 2 0)
  7 (uc-row M (+ p 7) 6 3 1 0)
  8 (uc-row M (+ p 8) 6 2 0 0)
  9 (uc-row M (+ p 9) 19 0 0 0)
  10 (uc-row M (+ p 10) 2 f 0 0)
