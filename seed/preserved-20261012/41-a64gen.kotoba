 (or (= k 51) (and (lc-row M p f seed mul add mask byte shift div w r k)
  (lc-rows M p f seed mul add mask byte shift div w r (inc k)))))
(defn- lc-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (< (vector-at M MM-SIR-N) 51) (> i (- (vector-at M MM-SIR-N) 50)) (not= (gn-op M (dec i)) OP-FN)) false
 (let [p (dec i) f (gn-sir M p IF-A) seed (gn-sir M (+ p 11) IF-B)
  mul (gn-sir M (+ p 13) IF-B) add (gn-sir M (+ p 15) IF-B) mask (gn-sir M (+ p 17) IF-B)
  byte (gn-sir M (+ p 20) IF-B) shift (gn-sir M (+ p 22) IF-B) div (gn-sir M (+ p 24) IF-B)
  w (gn-sir M (+ p 31) IF-A) r (gn-sir M (+ p 25) IF-A)]
 (and (ir-bound M f 51 4 6 5) (= (gn-fnf M f FF-SIR) p)
  (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 4)
  (>= seed 0) (<= seed 1048575) (>= mask 0) (> shift 0) (< shift 64) (> div 0) (<= div 4095)
  (lc-writer M w) (lc-rem M r)
  (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 6) (= (gn-g M gn-f-dp) 5)
  (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
  (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-out) 0)
  (= (gn-g M gn-f-nsv) 6) (= (gn-g M gn-f-fb) 160)
  (drc-homes M 1 4) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (= (vector-at M MM-ERR) 0)
  (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 256))
  (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 3840)
