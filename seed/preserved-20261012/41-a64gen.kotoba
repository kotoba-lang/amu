   (gn-dot-patch handle fallback (enc-cond-hs)) (gn-dot-patch bounds fallback (enc-cond-hs))
   (gn-dot-patch wrap fallback (enc-cond-lo)) (gn-dot-patch scale fallback 8))]
  (if (= (vector-at m7 MM-ERR) 0)
   (-> m7 (gn-gs di-sites (inc (gn-g m7 di-sites)))
    (gn-gs di-used (+ (gn-g m7 di-used) (- (vector-at m7 MM-CODE-N) cn))))
   (-> m7 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fn)))))

;; Generic terminal scalar table fold on adopted hoist parent.
(defn- tt-row [M :vector-i64 p :i64 f :i64 h :i64 e :i64 s :i64 o :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 6 6)
  1 (uc-row M (+ p 1) 18 0 0 0)
