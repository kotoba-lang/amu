   (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 5)
   (> L 0) (<= L 4096) (>= a 0) (<= a 1048575) (>= b 0) (<= b 1048575) (> d 0) (<= d 4096)
   (be-separate 0 L L L) (be-separate 0 L a d) (be-separate 0 L b d)
   (= (gn-g M fr-owner) f) (= (gn-g M gn-f-ns) 14) (= (gn-g M gn-f-dp) 7)
   (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-out) 0)
   (= (gn-g M gn-f-nsv) 7) (= (gn-g M gn-f-fb) 256)
   (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2) (= (gn-sreg M 4) 3)
   (= (gn-sreg M 5) 4) (= (gn-sreg M 6) 5) (= (gn-sreg M 7) 6)
   (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (= (vector-at M MM-ERR) 0)
   (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 256))
   (>= (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
   (< (gn-g M di-sites) 256) (<= (gn-g M di-used) 3840)
   (sd-rows M p f L a b 0) (qb-labels M p 139 0)))))
;; Last ptr/first integer types come from exact checked RT indices/ADD and
;; lower_bound loop provenance; no nonexistent FF PT5/PT6 field is read.
(defn- sd-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) L (gn-sir M (+ p 11) IF-B) a (gn-sir M (+ p 38) IF-B)
  b (gn-sir M (+ p 63) IF-B) d (- b a) last (gn-max (dec (* 2 L)) (dec (+ b d)))
  cn (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N) dead (gn-g M gn-f-dead)
  m0 (-> M (gn-mov-imm 16 L) (gn-emit (enc-cmp-r 1 16))) gn (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 5 16))) gp (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 d) (gn-emit (enc-cmp-r 2 16))) gi (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r 6 16))) gfirst (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) gh (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 9 7 320))
   (gn-emit (gn-e-addsl 9 9 17 4)) (gn-emit (enc-ldp 10 11 9 0))
   (gn-mov-imm 16 last) (gn-emit (enc-cmp-r 16 11))) gx (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-add-r 16 10 16)) (gn-emit (enc-cmp-r 16 10))) gw (vector-at m6 MM-CODE-N)
  m7 (-> m6 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-mov-imm 17 1152921504606846975) (gn-emit (enc-cmp-r 16 17))) gs (vector-at m7 MM-CODE-N)
  m8 (-> m7 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-ldr 9 7 328)) (gn-emit (gn-e-addsl 9 9 10 3))
   (gn-mov-imm 16 a) (gn-emit (gn-e-addsl 10 9 16 3))
   (gn-mov-imm 16 b) (gn-emit (gn-e-addsl 11 9 16 3))
   (gn-mov-imm 16 L) (gn-emit (gn-e-addsl 12 9 16 3))
   (gn-emit (enc-ldr 14 10 0)) (gn-mov-imm 13 1) (gn-mov-imm 16 d)) sorted (vector-at m8 MM-CODE-N)
  m9 (gn-emit m8 (enc-cmp-r 13 16)) sortedend (vector-at m9 MM-CODE-N)
  m10 (-> m9 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (gn-e-ldrr 15 10 13 1)) (gn-emit (enc-cmp-r 14 15))) gsort (vector-at m10 MM-CODE-N)
  m11 (-> m10 (gn-emit (enc-bcond 12 0)) (gn-mov 14 15) (gn-emit (enc-add-i 13 13 1))) sortback (vector-at m11 MM-CODE-N)
  m12 (gn-emit m11 (enc-b (- sorted sortback))) head (vector-at m12 MM-CODE-N)
  m13 (-> m12 (gn-mov-imm 17 L) (gn-emit (enc-cmp-r 1 17))) done (vector-at m13 MM-CODE-N)
  m14 (-> m13 (gn-emit (enc-bcond (enc-cond-eq) 0)) (gn-emit (enc-cmp-r 5 17))) gptr (vector-at m14 MM-CODE-N)
  m15 (-> m14 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 17 d) (gn-emit (enc-cmp-r 2 17))) gidx (vector-at m15 MM-CODE-N)
  m16 (-> m15 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (gn-e-ldrr 16 12 5 1))
   (gn-emit (enc-and-r 16 16 4)) (gn-emit (enc-cmp-i 16 0)) (gn-mov-imm 17 1)
   (gn-emit (enc-csel 17 17 31 (enc-cond-ne)))
   (gn-emit (gn-e-addsl 13 3 3 0)) (gn-emit (enc-add-i 13 13 1)) (gn-emit (enc-add-r 13 13 17))
   (gn-mov 14 2) (gn-mov-imm 15 d)) search (vector-at m16 MM-CODE-N)
  m17 (gn-emit m16 (enc-cmp-r 14 15)) foundbranch (vector-at m17 MM-CODE-N)
  m18 (-> m17 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-sub-r 16 15 14))
   (gn-emit (gn-e-lsr 16 16 1)) (gn-emit (enc-add-r 16 14 16))
   (gn-emit (gn-e-ldrr 17 10 16 1)) (gn-emit (enc-cmp-r 17 13))) upperbranch (vector-at m18 MM-CODE-N)
  m19 (-> m18 (gn-emit (enc-bcond 10 0)) (gn-emit (enc-add-i 14 16 1))) searchback0 (vector-at m19 MM-CODE-N)
  m20 (gn-emit m19 (enc-b (- search searchback0))) upper (vector-at m20 MM-CODE-N)
  m21 (gn-mov m20 15 16) searchback1 (vector-at m21 MM-CODE-N)
  m22 (gn-emit m21 (enc-b (- search searchback1))) found (vector-at m22 MM-CODE-N)
  m23 (-> m22 (gn-mov-imm 17 d) (gn-emit (enc-cmp-r 14 17))) gmissing (vector-at m23 MM-CODE-N)
  m24 (-> m23 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-sub-r 17 14 2))
   (gn-emit (enc-add-i 17 17 1)) (gn-emit (enc-cmp-r 8 17))) gfuel (vector-at m24 MM-CODE-N)
  m25 (-> m24 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-sub-i 17 17 1))
   (gn-emit (enc-sub-r 8 8 17)) (gn-emit (gn-e-ldrr 15 10 14 1))
   (gn-emit (gn-e-ldrr 16 11 14 1)) (gn-emit (enc-cmp-i 4 1))) rightbranch (vector-at m25 MM-CODE-N)
  m26 (-> m25 (gn-emit (enc-bcond 12 0)) (gn-mov-imm 4 128) (gn-emit (enc-add-i 5 5 1))) maskjoinbranch (vector-at m26 MM-CODE-N)
  m27 (gn-emit m26 (enc-b 0)) right (vector-at m27 MM-CODE-N)
  m28 (gn-emit m27 (gn-e-lsr 4 4 1)) maskjoin (vector-at m28 MM-CODE-N)
  m29 (gn-emit m28 (enc-cmp-r 13 15)) matchbranch (vector-at m29 MM-CODE-N)
  m30 (-> m29 (gn-emit (enc-bcond (enc-cond-eq) 0)) (gn-mov 2 14) (gn-mov 3 13)) chargedbranch (vector-at m30 MM-CODE-N)
  m31 (gn-emit m30 (enc-b 0)) matched (vector-at m31 MM-CODE-N)
  m32 (-> m31 (gn-emit (gn-e-strr3 16 9 1)) (gn-emit (enc-add-i 1 1 1)) (gn-mov 2 6) (gn-mov-imm 3 0)) charged (vector-at m32 MM-CODE-N)
  m33 (gn-emit m32 (enc-sub-i 8 8 1)) back (vector-at m33 MM-CODE-N)
  m34 (gn-emit m33 (enc-b (- head back))) ret (vector-at m34 MM-CODE-N)
  m35 (gn-epilogue m34) fallback (vector-at m35 MM-CODE-N)
  m36 (-> m35 (gn-dot-patch gn fallback (enc-cond-hs)) (gn-dot-patch gp fallback (enc-cond-hs))
   (gn-dot-patch gi fallback (enc-cond-hs)) (gn-dot-patch gfirst fallback (enc-cond-hs))
   (gn-dot-patch gh fallback (enc-cond-hs)) (gn-dot-patch gx fallback (enc-cond-hs))
   (gn-dot-patch gw fallback (enc-cond-lo)) (gn-dot-patch gs fallback 8)
   (gn-dot-patch sortedend head (enc-cond-hs)) (gn-dot-patch gsort fallback 12)
   (gn-dot-patch done ret (enc-cond-eq)) (gn-dot-patch gptr fallback (enc-cond-hs))
   (gn-dot-patch gidx fallback (enc-cond-hs)) (gn-dot-patch foundbranch found (enc-cond-hs))
   (gn-dot-patch upperbranch upper 10) (gn-dot-patch gmissing fallback (enc-cond-hs))
   (gn-dot-patch gfuel fallback (enc-cond-lo)) (gn-dot-patch rightbranch right 12)
   (gn-put (+ MM-CODE-BASE maskjoinbranch) (enc-b (- maskjoin maskjoinbranch)))
   (gn-dot-patch matchbranch matched (enc-cond-eq))
   (gn-put (+ MM-CODE-BASE chargedbranch) (enc-b (- charged chargedbranch))) (gn-gs gn-f-dead dead))]
  (if (= (vector-at m36 MM-ERR) 0)
   (-> m36 (gn-gs di-sites (inc (gn-g m36 di-sites))) (gn-gs di-used (+ (gn-g m36 di-used) (- (vector-at m36 MM-CODE-N) cn))))
   (-> m36 (gn-put MM-CODE-N cn) (gn-put MM-FIX-N fx) (gn-gs gn-f-dead dead)))))
(defn- sd-entry [M :vector-i64 i :i64] :vector-i64
 (if (sd-admit M i) (sd-emit M i) M))

;; Exact checked seven-state bit encoder, no function IDs/names dispatch.
(defn- be-separate [a :i64 an :i64 b :i64 bn :i64] :bool
 (or (<= (+ a an) b) (<= (+ b bn) a)))
