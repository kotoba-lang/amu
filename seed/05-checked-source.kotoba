;; Checked Seed source -> canonical KIR input, followed by the existing fresh
;; KIR checker/identity producer. This is not a source digest used as a DefCID.
;; The native source checker resolves every binding before serialization. Local
;; names come from its slots; globals come from its resolved FN records. Sugar
;; is serialized by the checked head code, never by a stale source token.
;;
;; The bridge preserves scalar/word and closed parametric interfaces and the
;; expression heads below. Loops use 05-source-loops; closures, state, schemas, type refinements and
;; unregistered capabilities still refuse atomically. They must be bridged before the whole
;; compiler can use this entry. The source fuel/arena proof is a separate build
;; context; KIR identity alone does not qualify source-route object reuse.
;; Seed represents boolean defs as computed-def thunks. Only their literal
;; values cross this bridge; generated thunk names never acquire DefCIDs.
;; Computed expressions/aliases require canonical constant folding and refuse.

;; C: error, offending node/type, hygienic-name salt, current FN; loop metadata
;; follows (05-source-loops). No fresh source resource proof is implied.
(defn- dsb-bad [C :vector-i64 code :i64 node :i64] :string
  (let [a (vector-assoc! C 1 (if (= (vector-at C 0) 0) node (vector-at C 1)))
        b (vector-assoc! C 0 (if (= (vector-at C 0) 0) code (vector-at C 0)))] ""))
(defn- dsb-front-h [S :string H :vector-i64] :vector-i64
  (let [a (lx-run (mem-set (mem-new) MM-SRC-LEN (string-length S)) S)
        b (if (= (vector-at a MM-ERR) 0) (rd-run a S) a)
        c (if (= (vector-at b MM-ERR) 0) (nm-run b S) b)
        d (if (= (vector-at c MM-ERR) 0) (ck-run-h c S H) c)]
    (if (ck-hint-again? H d) (dsb-front-h S H) d)))
(defn- dsb-effects [M :vector-i64] :vector-i64
  (let [direct (loop [f 1]
      (if (= f (vector-at M MM-FN-N)) M
        (let [save (ck-f2-set M f FN2-FX (ck-f2 M f FN2-CAPS))] (recur (inc f)))))]
    (ck-r5b-fx direct)))
(defn- dsb-effect-mask [M :vector-i64 n :i64] :i64
  (let [kind (nm-kind M n) h (nm-first M n) resolution (nm-nf M h NF-RES)
        own (cond (= (nm-nf M n NF-RES) HD-TYPED-CAP-CALL)
                    (ck-wire-bit (ck-kw-wire (nm-nf M (nm-next M h) NF-TYPE)))
                  (= (quot resolution RES-SCALE) RES-FN) (ck-f2 M (rem resolution RES-SCALE) FN2-FX)
                  :else 0)]
    (if (or (= kind ND-LIST) (= kind ND-VEC) (= kind ND-MAP) (= kind ND-SET))
      (loop [p h mask own]
        (if (= p 0) mask (recur (nm-next M p) (bit-or mask (dsb-effect-mask M p))))) 0)))
(defn- dsb-effect-text [mask :i64] :string
  (let [values (loop [wire 0 out ""]
      (if (= wire 48) out
        (recur (inc wire) (if (and (not= (dcp-effect-name wire) "") (not= (bit-and mask (ck-wire-bit wire)) 0))
          (string-concat out (string-concat " [:cap/call " (string-concat (mem-u2dec wire) "]"))) out))))]
    (string-concat "#{" (string-concat values "}"))))
(defn- dsb-cap [M :vector-i64 S :string C :vector-i64 n :i64 depth :i64] :string
  (let [wire (ck-kw-wire (nm-nf M (nm-nth M n 1) NF-TYPE)) argument (nm-nth M n 4)
        request (dsb-type M C (nm-nf M argument NF-TYPE) 0) result (dsb-type M C (nm-nf M n NF-TYPE) 0)
        body (dsb-expr M S C argument depth)]
    (if (= (dcp-effect-name wire) "") (dsb-bad C 3 n)
      (string-concat "(typed-cap-call " (string-concat (mem-u2dec wire)
        (string-concat " " (string-concat request (string-concat " " (string-concat result
          (string-concat " " (string-concat body ")")))))))))))
(defn- dsb-name [M :vector-i64 S :string f :i64] :string
  (let [s (nm-ff M f FF-SYM)]
    (string-substring S (nm-sf M s SF-START) (nm-sf M s SF-END))))
(defn- dsb-prefix [salt :i64] :string
  (string-concat "__dsb" (string-concat (mem-u2dec salt) "_v")))
(defn- dsb-starts? [s :string p :string] :bool
  (and (>= (string-length s) (string-length p))
       (= (string-substring s 0 (string-length p)) p)))
(defn- dsb-salt [M :vector-i64 S :string] :i64
  (loop [salt 0]
    (if (loop [f 1]
          (cond (= f (vector-at M MM-FN-N)) false
                (dsb-starts? (dsb-name M S f) (dsb-prefix salt)) true
                :else (recur (inc f))))
      (recur (inc salt)) salt)))
(defn- dsb-local [M :vector-i64 C :vector-i64 n :i64] :string
  (let [r (nm-nf M n NF-RES) slot (rem r RES-SCALE)]
    (if (or (not= (quot r RES-SCALE) RES-LOCAL) (<= slot 0)
            (> slot (nm-ff M (vector-at C 3) FF-NSLOTS)))
      (dsb-bad C 3 n)
      (string-concat (dsb-prefix (vector-at C 2)) (mem-u2dec slot)))))
;; CT-LIST also represents fixed-length tuples, and CT-OPTION's second field
;; distinguishes :option-i64 from [:option :i64]. Never erase those refinements.
;; A checked table index is not a canonical type spelling or a portable ID.
(defn- dsb-type [M :vector-i64 C :vector-i64 ty :i64 depth :i64] :string
  (cond (or (> depth 64) (not= (vector-at C 0) 0)) (dsb-bad C 2 ty)
    (< ty TY-COMP-BASE)
      (case ty TY-I64 ":i64" TY-BOOL ":bool" TY-STR ":string"
        TY-VEC ":vector-i64" TY-BYTES ":bytes" TY-KW ":keyword"
        (dsb-bad C 2 ty))
    (or (= (vector-at M MM-CT) 0) (= ty TY-COMP-BASE)
        (>= (- ty TY-COMP-BASE) (vector-at M (+ (vector-at M MM-CT) CT-N)))) (dsb-bad C 2 ty)
    :else
      (let [ctor (ck-tcon M ty) a (ck-ta M ty) b (ck-tb M ty)
            unary (or (= ctor TC-LIST) (= ctor TC-SET) (= ctor TC-OPTION))
            binary (or (= ctor TC-MAP) (= ctor TC-RESULT))
            name (case ctor TC-LIST ":list" TC-SET ":set" TC-OPTION ":option"
                            TC-MAP ":map" TC-RESULT ":result" "")]
        (if (or (not (or unary binary)) (and unary (not= b 0))
                (<= a 0) (and binary (<= b 0))) (dsb-bad C 2 ty)
          (let [left (dsb-type M C a (inc depth))
                right (if binary (string-concat " " (dsb-type M C b (inc depth))) "")]
            (string-concat "[" (string-concat name
              (string-concat " " (string-concat left (string-concat right "]"))))))))))
(defn- dsb-literal? [M :vector-i64 n :i64] :bool
  (let [kind (nm-kind M n)]
    (or (= kind ND-INT) (= kind ND-STR) (= kind ND-KW)
        (and (= kind ND-SYM)
          (or (= (nm-head-of M n) HD-TRUE) (= (nm-head-of M n) HD-FALSE))))))
(defn- dsb-thunk-value [M :vector-i64 f :i64] :i64
  (nm-nth M (nm-ff M f FF-NODE) 4))
(defn- dsb-quote [C :vector-i64 text :string] :string
  (let [s (loop [i 0 out "\""]
            (if (or (= i (string-length text)) (not= (vector-at C 0) 0)) out
              (let [c (string-code-point-at text i)
                    part (cond (= c 34) "\\\"" (= c 92) "\\\\"
                               (< c 32) (string-concat "\\u00" (dc-byte-hex c))
                               (< c 128) (string-substring text i (inc i))
                               :else (dsb-bad C 2 i))]
                (recur (inc i) (string-concat out part)))))]
    (string-concat s "\"")))
;; Canonical operation spellings selected by the freshly checked operation.
;; A user function with one of these names is still handled as RES-FN first.
(defn- dsb-op [hd :i64] :string
  (case hd HD-ADD "+" HD-SUB "-" HD-MUL "*" HD-QUOT "quot"
    HD-EQ "=" HD-NOT-EQ "not=" HD-LT "<" HD-GT ">" HD-LE "<=" HD-GE ">="
    HD-NOT "not" HD-AND "and" HD-OR "or" HD-IF "if" HD-DO "do"
    HD-BIT-AND "bit-and" HD-BIT-OR "bit-or" HD-BIT-XOR "bit-xor"
    HD-BIT-NOT "bit-not" HD-SHL "i64-shift-left" HD-SSHR "i64-shift-right"
    HD-USHR "u64-shift-right" HD-VECTOR-AT "vector-at" HD-VECTOR-COUNT "vector-count"
    HD-VECTOR-ALLOC "vector-alloc" HD-VECTOR-CONJ "vector-conj"
    HD-GCOUNT "count" HD-NTH "nth" HD-CONJ "conj"
    HD-VECTOR-ASSOC "vector-assoc" HD-VECTOR-ASSOC-BANG "vector-assoc!"
    HD-BYTES-FROM-VECTOR-I64 "bytes-from-vector-i64"
    HD-VECTOR-I64-FROM-BYTES "vector-i64-from-bytes"
    HD-BYTES-EMPTY "bytes-empty" HD-BYTES-COUNT "bytes-count" HD-BYTES-AT "bytes-at"
    HD-BYTES-CONCAT "bytes-concat" HD-BYTES-SLICE "bytes-slice"
    HD-STRING-FROM-UTF8 "string-from-utf8"
    HD-STRING-COMPARE "string-compare" HD-STRING-INDEX-OF "string-index-of"
    HD-STRING-LENGTH "string-length" HD-STRING-BYTE-LENGTH "string-byte-length"
    HD-STRING-CONCAT "string-concat" HD-STRING-SUBSTRING "string-substring"
    HD-STRING-CODE-POINT-AT "string-code-point-at" HD-STRING-EQ "string=?" ""))
(defn- dsb-seq [M :vector-i64 S :string C :vector-i64 p :i64 depth :i64] :string
  (loop [n p out ""]
    (if (or (= n 0) (not= (vector-at C 0) 0)) out
      (let [value (dsb-expr M S C n depth)]
        (recur (nm-next M n) (string-concat out (string-concat " " value)))))))
(defn- dsb-bindings [M :vector-i64 S :string C :vector-i64 p :i64 depth :i64] :string
  (loop [n p out ""]
    (if (or (= n 0) (not= (vector-at C 0) 0)) out
      (let [v (nm-next M n) name (dsb-local M C n)
            value (if (= v 0) (dsb-bad C 3 n) (dsb-expr M S C v depth))]
        (recur (nm-next M v) (string-concat out
          (string-concat " " (string-concat name (string-concat " " value)))))))))
;; Seed retains checked cond nodes; canonical KIR uses nested if. :else is
;; syntax only in the test position of the final pair. Preserve value keywords,
;; branch order and tail recur; do not copy the old cond token into KIR.
(defn- dsb-cond [M :vector-i64 S :string C :vector-i64 p :i64 depth :i64] :string
  (let [value (nm-next M p) next (nm-next M value)]
    (cond (or (= p 0) (= value 0) (> depth (dip-expression-depth (vector-at C 8))) (not= (vector-at C 0) 0)) (dsb-bad C 3 p)
      (= (nm-kind M p) ND-KW)
        (if (and (= (nm-head-of M p) KW-ELSE) (= next 0))
          (dsb-expr M S C value depth) (dsb-bad C 3 p))
      (= next 0) (dsb-bad C 3 p)
      :else
        (let [test (dsb-expr M S C p depth) yes (dsb-expr M S C value depth)
              no (dsb-cond M S C next (inc depth))]
          (string-concat "(if " (string-concat test (string-concat " "
            (string-concat yes (string-concat " " (string-concat no ")"))))))))))
;; ck-targ stores the resolved constructor on the explicit type argument.
;; It is syntax, not an untyped value vector. Reify its checked closed type;
;; dsb-type keeps nominal types and tuple/refinement variants refused.
(defn- dsb-typed-list [M :vector-i64 S :string C :vector-i64 n :i64 depth :i64] :string
  (let [argument (nm-nth M n 1) ty (nm-nf M argument NF-TYPE)
        op (case (nm-nf M n NF-RES) HD-LIST-NEW "typed-list-new"
             HD-LIST-NTH "typed-list-nth" HD-LIST-CONJ "typed-list-conj" "")
        type (dsb-type M C ty 0)]
    (if (or (= argument 0) (= op "") (not= (ck-tcon M ty) TC-LIST)) (dsb-bad C 3 n)
      (string-concat "(" (string-concat op (string-concat " " (string-concat type
        (string-concat (dsb-seq M S C (nm-nth M n 2) depth) ")"))))))))
(defn- dsb-call [M :vector-i64 S :string C :vector-i64 n :i64 depth :i64] :string
  (let [h (nm-first M n) hd (nm-nf M n NF-RES) r (nm-nf M h NF-RES)
        fi (rem r RES-SCALE)
        op (if (= hd HD-RECUR) (if (> (vector-at C 4) 0) (dsl-name (vector-at C 4)) (dsb-name M S (vector-at C 3)))
             (if (= (quot r RES-SCALE) RES-FN)
             (if (and (> fi 0) (< fi (vector-at M MM-FN-N))) (dsb-name M S fi) (dsb-bad C 3 n))
             (dsb-op hd)))]
    (cond (and (= (quot r RES-SCALE) RES-FN) (ck-r6f-cdef-fn? M fi))
      (let [value (dsb-thunk-value M fi)]
        (if (and (= (nm-count M n) 1) (dsb-literal? M value))
          (dsb-expr M S C value depth) (dsb-bad C 3 n)))
      (= hd HD-LET)
      (let [v (nm-nth M n 1) body (nm-nth M n 2)]
        (if (or (not= (nm-kind M v) ND-VEC) (not= (nm-count M n) 3)) (dsb-bad C 3 n)
          (string-concat "(let [" (string-concat (dsb-bindings M S C (nm-first M v) depth)
            (string-concat "] " (string-concat (dsb-expr M S C body depth) ")"))))))
      (= hd HD-COND) (dsb-cond M S C (nm-next M h) depth)
      (or (= hd HD-LIST-NEW) (= hd HD-LIST-NTH) (= hd HD-LIST-CONJ))
        (dsb-typed-list M S C n depth)
      (= hd HD-TYPED-CAP-CALL) (dsb-cap M S C n depth)
      (= hd HD-LOOP) (dsl-call M S C n depth)
      (= (string-length op) 0) (dsb-bad C 3 n)
      :else (string-concat "(" (string-concat op
        (string-concat (dsb-seq M S C (nm-next M h) depth)
          (string-concat (if (and (= hd HD-RECUR) (> (vector-at C 4) 0))
                          (dsl-capture-text M C (vector-at C 4) false) "") ")")))))))
(defn- dsb-expr [M :vector-i64 S :string C :vector-i64 n :i64 depth :i64] :string
  (let [kind (nm-kind M n) r (nm-nf M n NF-RES) tag (quot r RES-SCALE)]
    (cond (or (= n 0) (> depth (dip-expression-depth (vector-at C 8))) (not= (vector-at C 0) 0)) (dsb-bad C 3 n)
      (= kind ND-INT) (mem-u2dec (nm-nf M n NF-AUX))
      (= kind ND-STR) (dsb-quote C (dcp-string M n))
      (= kind ND-KW) (dcp-text M S n)
      (and (= kind ND-SYM) (= tag RES-LOCAL)) (dsb-local M C n)
      (and (= kind ND-SYM) (= tag RES-DEF))
        (dsb-expr M S C (nm-nth M (nm-ff M (rem r RES-SCALE) FF-NODE) 2) (inc depth))
      (and (= kind ND-SYM) (= tag RES-CONST)) (if (= (rem r RES-SCALE) 0) "false" "true")
      ;; Literal def values are checked by the signature pass, not ck-expr.
      (and (= kind ND-SYM) (= (nm-head-of M n) HD-TRUE)) "true"
      (and (= kind ND-SYM) (= (nm-head-of M n) HD-FALSE)) "false"
      (and (= kind ND-VEC) (= (nm-nf M n NF-TYPE) TY-VEC))
        (string-concat "[" (string-concat (dsb-seq M S C (nm-first M n) (inc depth)) "]"))
      (= kind ND-LIST) (dsb-call M S C n (inc depth))
      :else (dsb-bad C 3 n))))
(defn- dsb-params [M :vector-i64 C :vector-i64 p :i64 types :bool] :string
  (loop [n (nm-first M p) out "" count 0]
    (if (or (= n 0) (not= (vector-at C 0) 0)) out
      (let [t (nm-next M n) value (if types (dsb-type M C (nm-nf M n NF-TYPE) 0) (dsb-local M C n))]
        (if (or (= t 0) (= (nm-head-of M n) HD-AMP)) (dsb-bad C 3 n)
          (recur (nm-next M t) (string-concat out (string-concat " " value)) (inc count)))))))
(defn- dsb-function [M :vector-i64 S :string C :vector-i64 f :i64] :string
  (let [node (nm-ff M f FF-NODE) params (nm-nth M node 2)
        set-f (vector-assoc! C 3 f) no-loop (vector-assoc! C 4 0)
        names (dsb-params M C params false) types (dsb-params M C params true)
        result (dsb-type M C (nm-ff M f FF-RTYPE) 0)
        body (dsb-expr M S C (nm-nth M node 4) 0)]
    (string-concat "{:name " (string-concat (dsb-name M S f)
      (string-concat " :params [" (string-concat names (string-concat "] :param-types ["
        (string-concat types (string-concat "] :result " (string-concat result
          (string-concat " :effects " (string-concat (dsb-effect-text (ck-f2 M f FN2-FX))
            (string-concat " :body " (string-concat body "}"))))))))))))))
(defn- dsb-kir [M :vector-i64 S :string C :vector-i64] :string
  (let [salt (vector-assoc! C 2 (dsb-salt M S)) plan (dsl-plan M S C)
        values (loop [f 1 out "" count 0]
          (if (or (= f (vector-at M MM-FN-N)) (not= (vector-at C 0) 0)) out
            (let [kind (nm-ff M f FF-KIND) sym (nm-ff M f FF-SYM)]
              (cond (= kind FK-DEF) (recur (inc f) out count)
                (ck-r6f-cdef-fn? M f)
                  (if (dsb-literal? M (dsb-thunk-value M f)) (recur (inc f) out count)
                    (dsb-bad C 3 f))
                (or (not (or (= kind FK-DEFN) (= kind FK-PRIV)))
                    (not= (nm-sf M sym SF-FN) f)
                    (lw-tmpl? M f) (lw-spec? M f)) (dsb-bad C 3 f)
                :else (let [value (dsb-function M S C f)]
                        (recur (inc f) (string-concat out (string-concat " " value)) (inc count)))))))
        helpers (dsl-helpers M S C)]
    (if (not= (vector-at C 0) 0) ""
      (string-concat "{:format :kotoba.kir/v4 :entry nil :exports [] :effects "
        (string-concat (dsb-effect-text (vector-at M MM-CAPS)) (string-concat " :functions ["
          (string-concat values (string-concat helpers "]}\n"))))))))
(defn- dsb-source-resource [source :string emit-kir :bool resource :i64] :i64
  (let [S (string-concat source (ck-r6b-lib source)) front (dsb-front-h S (ck-hint-new))
        M (if (= (vector-at front MM-ERR) 0) (dsb-effects front) front)
        C (dsl-new-resource M resource)]
    (cond (not (dip-valid? resource)) (let [out (io-err "DSB:PROFILE\n")] 1)
          (not= (vector-at M MM-ERR) 0)
            (let [out (io-err (string-concat "DSB:SOURCE:" (string-concat (mem-u2dec (vector-at M MM-ERR)) "\n")))] 1)
          (not= (bit-and (vector-at M MM-CAPS)
                    (bit-not (loop [wire 0 mask 0]
                      (if (= wire 48) mask (recur (inc wire) (bit-or mask
                        (if (= (dcp-effect-name wire) "") 0 (ck-wire-bit wire)))))))) 0)
            (let [out (io-err "DSB:EFFECT\n")] 1)
          :else
          (let [K (dsb-kir M S C)]
            (if (not= (vector-at C 0) 0)
              (let [out (io-err (string-concat "DSB:BRIDGE:" (string-concat (mem-u2dec (vector-at C 0))
                      (string-concat ":" (string-concat (mem-u2dec (vector-at C 1)) "\n")))))] 1)
              (if emit-kir
                (if (dcs-native-checked? K) (let [out (io-out K)] 0) (let [out (io-err "DSB:KIR\n")] 1))
                (let [status (dcs-run-resource K resource)]
                  (if (= status 0) 0 (let [out (io-err (string-concat "DSB:IDENTITY:" (string-concat (mem-u2dec status) "\n")))] 1)))))))))
(defn- dsb-source [source :string emit-kir :bool] :i64 (dsb-source-resource source emit-kir 0))
