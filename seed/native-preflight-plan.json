{
  "schema": "amu.native-gate-plan.v1",
  "phases": {
    "preflight": [
      {
        "name": "local-project-fs",
        "argv": ["python3", "scripts/seed/native_preflight_projects.py",
                 "--compiler", "bin/amu-linux-x86_64", "--temporary", "@TEMP@"]
      },
      {
        "name": "early-kotoba",
        "argv": ["python3", "scripts/seed/check-native-kotoba-early.py",
                 "--compiler", "bin/amu-linux-x86_64", "--output", "@TEMP@/early-kotoba"]
      },
      {
        "name": "b2-preflight",
        "argv": ["python3", "scripts/seed/check-b2-libc.py",
                 "--compiler", "bin/amu-linux-x86_64", "--output", "@TEMP@/b2-libc-preflight"]
      }
    ]
  }
}
