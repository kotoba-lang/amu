;; KW-* code of a keyword spelling (the ':' included) from its packed words, 0 if none.
(defn- nm-kw-code [w0 :i64 w1 :i64 w2 :i64] :i64
  (case w2
    0
    (case w1
      0
      (case w0
        875981114 KW-I64  ; :i64
        465726038586 KW-BOOL  ; :bool
        29113321772053306 KW-STRING  ; :string
        32776920252310842 KW-EXPORT  ; :export
        435728180538 KW-ELSE  ; :else
        126879583003194 KW-BYTES  ; :bytes
        7237970110066289466 KW-KEYWORD  ; :keyword
        28273320405594682 KW-RECORD  ; :record
        1952803898 KW-LET  ; :let
        474147747642 KW-WHEN  ; :when
        111516299327290 KW-WHILE  ; :while
        31084746153946938 KW-OPTION  ; :option
        32770349001437754 KW-RESULT  ; :result
        500152495162 KW-LIST  ; :list
        1885433146 KW-MAP  ; :map
        1952805690 KW-SET  ; :set
        7235130 KW-FN  ; :fn
        1717924410 KW-REF  ; :ref
        8314046669413118778 KW-SCHEMAS  ; :schemas
        7233174017630234938 KW-IO-READ  ; :io/read
        0)
      3421801
      (case w0
        3274802424726255162 KW-VECTOR-I64  ; :vector-i64
        0)
      1635017060
      (case w0
        3274240491808581178 KW-FS-APP-DATA  ; :fs/app-data
        0)
      115
      (case w0
        7454127189511660346 KW-CLI-ARGS  ; :cli/args
        0)
      32210684681203045
      (case w0
        8388361637176764730 KW-IO-WRITE-ERROR  ; :io/write-error
        0)
      101
      (case w0
        8388361637176764730 KW-IO-WRITE  ; :io/write
        0)
      909455969
      (case w0
        7526411527925098554 KW-HASH-SHA256  ; :hash/sha256
        0)
      100
      (case w0
        7018141142502761786 KW-ENV-READ  ; :env/read
        0)
      25971
      (case w0
        8606223178956760634 KW-FS-BROWSE  ; :fs/browse
        0)
