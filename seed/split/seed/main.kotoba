;; seed/90-drv.kotoba -- the seed's command-line driver (prefix drv-). Owner: contracts/integration.
;;
;; Commands (guest argv through wire 38; paths are absolute and inside KEXE_CAP_RESOURCES_35):
;;   compile <src> <out> [hex]       also: compile <src> [--target aarch64-macos] --output <out> [hex]
;;       lex -> read -> names -> check -> lower -> a64gen -> layout -> out (kseed/v1 container).
;;       <out> = "-" or the word `hex`: the container is written as lowercase hex on stdout (64 bytes per line,
;;       `xxd -r -p` recovers it; scripts/seed/build.sh uses this). Any other <out>: the container is written to
;;       that file as raw bytes (io-write-bytes, :fs/app-data-bytes) and stdout gets one line
;;       {:ok true, :target :aarch64-macos, :output "<out>", :bytes N}.
;;   extract-native <kseed> --symbol <name> --output <raw>
;;       reads the container (io-read-bytes), writes its code slice to <raw> and prints
;;       {:ok true, :output "<raw>", :offset N, :length L, :arity A} (the qualification runner reads :offset).
;;   check <src>                     lex .. check only; prints "ok\n".
;; Flags the qualification runner passes and the seed ignores: --jvm-free (the seed never has a JVM).
;; Exit status: 0 ok, 1 compile error (one line "seed: E<code> <text> (byte <pos>)" on stderr), 2 usage.
;; Strings are compared by length + FNV-1a 64 (mem-hash-str): HEADS has no string equality and stage-0 must not
;; index a string literal (MEMORY-MAP L13). M is threaded as a nested call argument; each phase's continuation reads
;; MM-ERR through its own parameter (rules L14/L15 of seed/CONTRACT-REQUESTS.md).

;; ---- argv --------------------------------------------------------------------------------------------------------
(defn- drv-is2 [s :string h :i64] :i64 (if (= (mem-hash-str s 0 (string-length s)) h) 1 0))
(defn- drv-is [s :string len :i64 h :i64] :i64 (if (= (string-length s) len) (drv-is2 s h) 0))
(defn- drv-flagv1 [s :string] :i64 (if (= (drv-is s 8 -5168643622338417694) 1) 1 (drv-is s 8 -5041807559351932249)))
;; 1 when s is a flag that takes a value: --target --output --symbol
(defn- drv-flagv [s :string] :i64
  (cond (= (drv-is s 8 4838156518066596434) 1) 1
        ;; R5A: --source-path D (repeatable) and --policy P also take a value
        (string=? s "--source-path") 1
        (string=? s "--policy") 1
        (string=? s "--object-dir") 1
        :else (drv-flagv1 s)))
(defn- drv-hexw [s :string] :i64 (drv-is s 3 3695806134807131338))
(defn- drv-dash [s :string] :i64 (drv-is s 1 -5808622843851602280))

;; argv index of the k-th positional argument after the command (flags and their values skipped), -1 when absent
(defn- drv-pos [i :i64 n :i64 k :i64] :i64
  (cond (>= i n) -1
        (= (drv-flagv (io-arg i)) 1) (drv-pos (+ i 2) n k)
        (= (drv-hexw (io-arg i)) 1) (drv-pos (+ i 1) n k)
        (= k 0) i
        :else (drv-pos (+ i 1) n (- k 1))))

;; argv index of the value after the flag with hash h (length 8), -1 when absent
(defn- drv-flag [i :i64 n :i64 h :i64] :i64
  (cond (>= (+ i 1) n) -1
        (= (drv-is (io-arg i) 8 h) 1) (+ i 1)
        :else (drv-flag (+ i 1) n h)))

;; 1 when the word `hex` is one of the arguments (not as a flag value)
(defn- drv-hexflag [i :i64 n :i64] :i64
  (cond (>= i n) 0
        (= (drv-flagv (io-arg i)) 1) (drv-hexflag (+ i 2) n)
        (= (drv-hexw (io-arg i)) 1) 1
        :else (drv-hexflag (+ i 1) n)))

(defn- drv-arg [i :i64] :string (if (< i 0) "" (io-arg i)))

