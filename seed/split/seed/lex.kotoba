(ns seed.lex)

;; GENERATED by seed/split/gen-split.py from seed/MANIFEST (rung R5 proof); edit the modules, not this file.
;; contract constants used here (seed/00-ns.kotoba)
(def MM-LAYOUT-VERSION 1)
(def MM-VERSION 0)
(def MM-R0 1)
(def MM-ERR 5)
(def MM-ERR-POS 6)
(def MM-ERR-A 7)
(def MM-ERR-B 8)
(def MM-ERR-N 9)
(def MM-TOK-N 16)
(def MM-LIT-N 26)
(def MM-LITB-N 27)
(def MM-TOK-BASE 256)
(def MM-TOK-W 4)
(def MM-TOK-CAP 262144)
(def MM-LIT-BASE 5243136)
(def MM-LIT-W 4)
(def MM-LIT-CAP 16384)
(def MM-LITB-BASE 5308672)
(def MM-LITB-CAP 262144)
(def TF-KIND 0)
(def TF-START 1)
(def TF-END 2)
(def TF-VAL 3)
(def LF-B 0)
(def LF-LEN 1)
(def LF-TOK 3)
(def TK-LPAREN 1)
(def TK-RPAREN 2)
(def TK-LBRACK 3)
(def TK-RBRACK 4)
(def TK-LBRACE 5)
(def TK-RBRACE 6)
(def TK-INT 7)
(def TK-STR 8)
(def TK-SYM 9)
(def TK-KW 10)
(def TK-HASH-BRACE 11)
(def TK-AT 12)
(def E-HEAP-REGION 101)
(def E-LEX-STRING 1001)
(def E-LEX-ASCII 1002)
(def E-LEX-ESCAPE 1003)
(def E-LEX-INT 1004)
(def E-LEX-SYNTAX 1005)
(def E-LEX-RC 1006)

;; seed/10-lex.kotoba -- the lexer of the seed compiler R0 (module 10, prefix lx-). Owner: 10-lex.
;; Contract: seed/HEADS :tokens and :errors (E10nn), seed/MEMORY-MAP TOK/LIT/LITB regions and rules L1-L13.
;;
;;   (lx-run M S) -> M     writer. Fills TOK (kind start end val) for the whole of S, LIT/LITB for every string
;;                         token. Result in MM-R0: the token count (tokens are 1..count). On failure MM-ERR is set
;;                         (E1001-E1005, E101 table full), MM-ERR-POS/A/B/N as listed in seed/HEADS, tokens after
;;                         the error are not produced. Nothing is printed.
;;
;; R0/R1: the source had to be ASCII. R3 (agent R3, 2026-10-03, minimal delimited change marked R3 below; seed/HEADS
;; :tokens): a string literal or a comment may hold any UTF-8 text; a byte >= 128 anywhere else is E1002 at that byte. Whitespace: space tab LF CR ','. Comment: ';'
;; to end of line. TK-INT is -?[0-9]+ that fits i64 (-9223372036854775808 legal, 9223372036854775808 not).
;; TK-SYM is a maximal run of [A-Za-z0-9*+!_?<>=/.-] that is not an integer. TK-KW is ':' + such a run (the
;; span includes ':'; a lone ':' is E1005). Every other byte (# ^ ` ~ @ \ ' | % & $ ...) is E1005 with the
;; one-byte span. TK-STR spans both quotes and decodes \n \t \\ \" into LITB (other escapes: E1003, span = the
;; backslash and the next byte); a raw newline inside a string is kept as a byte.
;; E101 (table full) carries MM-ERR-N = region: 1 TOK, 2 LIT, 3 LITB.

;; Stage-0 linearity (the affine analysis in kotoba/compiler/affine.cljc, `check-affine-writes-module!`), which decides
;; every `vector-assoc!` of this module together. Style rules that follow from it, all measured:
;;   1. a handle returned by a writer is passed on as a NESTED call argument, `(g (f M x) y)`; it is never bound to a let
;;      name that is then passed or written (a let-bound handle must come from vector-alloc/vector-assoc!/...);
;;   2. a result that must be READ (positions, counts) is read in a callee through the callee's parameter:
;;      `(k (f M x))` with `(defn- k [M] (let [j (vector-at M R)] (g M j)))`;
;;   3. every path of a writer consumes the handle (a branch that returns M unchanged returns `(lx-id M)` instead);
;;   4. in an argument list, M is not mentioned again after it was passed (bind reads before the call).
;; lx-set wraps vector-assoc! so that a writer's result can be written without a let name (rule 1).
(defn- lx-set [M :vector-i64 i :i64 v :i64] :vector-i64 (vector-assoc! M i v))

;; Second probed rule: a writer that returns its handle UNCHANGED on some path is refused as soon as a caller reads
;; the result and passes it on ("M is used more than once"). So every path consumes the handle; the identity writer
;; rewrites M[MM-VERSION] with the value it always has.
(defn lx-id [M :vector-i64] :vector-i64 (vector-assoc! M MM-VERSION MM-LAYOUT-VERSION))

(defn lx-ch [S :string i :i64] :i64 (string-code-point-at S i))

(defn- lx-digit? [c :i64] :bool (lx-range? c 48 57))

(defn lx-ws? [c :i64] :bool (or (= c 32) (= c 10) (= c 9) (= c 13) (= c 44)))

;; stage-0 (native image of 2026-10-02) answers "internal compiler error" for and/or/not anywhere but as the TAIL VALUE of a
;; function whose operands are plain comparisons or calls: not in an if/cond test, not nested in each other. So every
;; boolean combination lives in a small :bool function and tests are comparisons or calls (CONTRACT-REQUESTS 2026-10-02).
(defn- lx-range? [c :i64 lo :i64 hi :i64] :bool (and (>= c lo) (<= c hi)))

(defn lx-symch? [c :i64] :bool
  (or (lx-range? c 97 122) (lx-range? c 65 90) (lx-range? c 48 57)
      (= c 42) (= c 43) (= c 33) (= c 95) (= c 63) (= c 60) (= c 62) (= c 61) (= c 47) (= c 46) (= c 45)
      ;; R4 (agent R4, minimal delimited change): `&` is a symbol byte (the rest marker of [p & rest], seed/HEADS HD-AMP)
      (= c 38)))

;; a byte that starts a string, keyword, integer or symbol
(defn lx-multi? [c :i64] :bool (or (= c 34) (= c 58) (lx-symch? c)))

;; bracket byte -> token kind, 0 when the byte is not a bracket
(defn lx-punct [c :i64] :i64
  (cond (= c 40) TK-LPAREN (= c 41) TK-RPAREN (= c 91) TK-LBRACK (= c 93) TK-RBRACK
        (= c 123) TK-LBRACE (= c 125) TK-RBRACE :else 0))

;; ---------------------------------------------------------------------------------------------------------
;; errors (first writer wins)
;; ---------------------------------------------------------------------------------------------------------
(defn lx-fail [M :vector-i64 code :i64 pos :i64 a :i64 b :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [M1 (vector-assoc! M MM-ERR code)
          M2 (vector-assoc! M1 MM-ERR-POS pos)
          M3 (vector-assoc! M2 MM-ERR-A a)]
      (vector-assoc! M3 MM-ERR-B b))
    (lx-id M)))

;; stage-0 rule found by probing: a let-bound handle must not be returned bare in one branch while another branch
;; consumes it. So every "if ERR is clear" decision is taken in a function whose parameter M is the handle.
(defn lx-fail-n [M :vector-i64 code :i64 pos :i64 n :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (lx-fail (vector-assoc! M MM-ERR-N n) code pos pos (+ pos 1))
    (lx-id M)))

(defn lx-full [M :vector-i64 region :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (lx-fail (vector-assoc! M MM-ERR-N region) E-HEAP-REGION -1 0 0)
    (lx-id M)))

;; the lead byte of the UTF-8 sequence whose code point is cp (for the E1002 text)
(defn lx-lead [cp :i64] :i64
  (cond (< cp 2048) (bit-or 192 (u64-shift-right cp 6))
        (< cp 65536) (bit-or 224 (u64-shift-right cp 12))
        :else (bit-or 240 (u64-shift-right cp 18))))

;; ---------------------------------------------------------------------------------------------------------
;; pushing tokens and bytes
;; ---------------------------------------------------------------------------------------------------------
(defn lx-push [M :vector-i64 kind :i64 s :i64 e :i64 v :i64] :vector-i64
  (let [n (vector-at M MM-TOK-N)]
    (if (>= n MM-TOK-CAP)
      (lx-full M 1)
      (let [b (+ MM-TOK-BASE (* n MM-TOK-W))
            M1 (vector-assoc! M (+ b TF-KIND) kind)
            M2 (vector-assoc! M1 (+ b TF-START) s)
            M3 (vector-assoc! M2 (+ b TF-END) e)
            M4 (vector-assoc! M3 (+ b TF-VAL) v)]
        (vector-assoc! M4 MM-TOK-N (+ n 1))))))

(defn- lx-litb-push [M :vector-i64 byte :i64] :vector-i64
  (let [n (vector-at M MM-LITB-N)]
    (if (>= n MM-LITB-CAP)
      (lx-full M 3)
      (let [M1 (vector-assoc! M (+ MM-LITB-BASE n) byte)]
        (vector-assoc! M1 MM-LITB-N (+ n 1))))))

;; ---------------------------------------------------------------------------------------------------------
;; scanners over S (read-only)
;; ---------------------------------------------------------------------------------------------------------
;; R3: a comment may hold UTF-8: step over whole code points (string-code-point-at traps inside one)
(defn lx-eol [S :string i :i64] :i64
  (loop [j i]
    (if (>= j (string-length S)) j (if (= (lx-ch S j) 10) j (recur (+ j (lx-cpw (lx-ch S j))))))))

(defn lx-word-end [S :string i :i64] :i64
  (loop [j i]
    (if (< j (string-length S)) (if (lx-symch? (lx-ch S j)) (recur (+ j 1)) j) j)))

;; Seed-0 has no boolean literals (seed/HEADS): true/false are comparisons of constants
(defn- lx-true [] :bool (= 0 0))
(defn- lx-false [] :bool (= 0 1))

(defn- lx-all-digits [S :string a :i64 b :i64] :bool
  (loop [j a]
    (if (>= j b) (lx-true) (if (lx-digit? (lx-ch S j)) (recur (+ j 1)) (lx-false)))))

;; the span [a,b) (non-empty, symbol characters) is an integer literal
(defn- lx-int? [S :string a :i64 b :i64] :bool
  (if (= (lx-ch S a) 45)
    (if (> b (+ a 1)) (lx-all-digits S (+ a 1) b) (lx-false))
    (lx-all-digits S a b)))

;; first digit of the integer token at a (after the sign)
(defn- lx-int-start [S :string a :i64] :i64
  (if (= (lx-ch S a) 45) (+ a 1) a))

;; digits accumulate as a NEGATIVE magnitude so that -2^63 is representable
(defn- lx-int-ovf [S :string a :i64 b :i64] :bool
  (let [neg (= (lx-ch S a) 45)]
    (loop [j (lx-int-start S a) acc 0]
      (if (>= j b)
        (if neg (lx-false) (= acc -9223372036854775808))
        (let [d (- (lx-ch S j) 48)]
          (if (< acc -922337203685477580)
            (lx-true)
            (if (= acc -922337203685477580)
              (if (> d 8) (lx-true) (recur (+ j 1) (- (* acc 10) d)))
              (recur (+ j 1) (- (* acc 10) d)))))))))

(defn- lx-int-val [S :string a :i64 b :i64] :i64
  (let [neg (= (lx-ch S a) 45)
        m (loop [j (lx-int-start S a) acc 0]
            (if (>= j b) acc (recur (+ j 1) (- (* acc 10) (- (lx-ch S j) 48)))))]
    (if neg m (- 0 m))))

;; ---------------------------------------------------------------------------------------------------------
;; strings: reserve the LIT record, decode into LITB byte by byte, close at the quote
;; ---------------------------------------------------------------------------------------------------------
;; ---------------------------------------------------------------------------------------------------------
;; strings. Third probed rule: the result of a branching writer must not be read by the caller that goes on to pass
;; it (read it in a callee, through the parameter, or do not read it). Here nothing is read after a writer: the end of
;; a token is found first by read-only scans of S, then the writers run and the loop continues at that end.
;; ---------------------------------------------------------------------------------------------------------
;; ---- R3 (agent R3): UTF-8 in strings and comments, escapes \r \b \f \uXXXX ----
;; byte width of the UTF-8 sequence of code point cp
(defn lx-cpw [cp :i64] :i64 (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))
;; value of hex digit c, -1 when c is not one
(defn- lx-hex [c :i64] :i64
  (cond (lx-range? c 48 57) (- c 48) (lx-range? c 97 102) (- c 87) (lx-range? c 65 70) (- c 55) :else -1))
;; the code point of \uXXXX whose 'u' is at j, -1 when malformed (fewer than 4 hex digits) or a surrogate; the digits
;; are read one by one and the scan stops at the first non-digit (so it never indexes inside a UTF-8 sequence)
(defn- lx-u4 [S :string j :i64] :i64
  (if (> (+ j 5) (string-length S))
    -1
    (loop [k 1 v 0]
      (if (> k 4)
        (if (and (>= v 55296) (<= v 57343)) -1 v)
        (let [h (lx-hex (lx-ch S (+ j k)))]
          (if (neg? h) -1 (recur (inc k) (+ (* v 16) h))))))))
;; push the UTF-8 bytes of code point cp
(defn- lx-utf8-push [M :vector-i64 cp :i64] :vector-i64
  (cond (< cp 128) (lx-litb-push M cp)
        (< cp 2048) (-> M (lx-litb-push (bit-or 192 (u64-shift-right cp 6))) (lx-litb-push (bit-or 128 (bit-and cp 63))))
        (< cp 65536) (-> M (lx-litb-push (bit-or 224 (u64-shift-right cp 12)))
                         (lx-litb-push (bit-or 128 (bit-and (u64-shift-right cp 6) 63)))
                         (lx-litb-push (bit-or 128 (bit-and cp 63))))
        :else (-> M (lx-litb-push (bit-or 240 (u64-shift-right cp 18)))
                  (lx-litb-push (bit-or 128 (bit-and (u64-shift-right cp 12) 63)))
                  (lx-litb-push (bit-or 128 (bit-and (u64-shift-right cp 6) 63)))
                  (lx-litb-push (bit-or 128 (bit-and cp 63))))))

(defn- lx-esc-code [e :i64] :i64
  (cond (= e 110) 10 (= e 116) 9 (= e 92) 92 (= e 34) 34 (= e 114) 13 (= e 98) 8 (= e 102) 12 :else -1))
;; R3: the source width of the escape whose backslash is at j (2, or 6 for \uXXXX), 0 when it is not a valid escape
(defn- lx-esc-w [S :string j :i64] :i64
  (let [e (lx-ch S (+ j 1))]
    (cond (= e 117) (if (neg? (lx-u4 S (+ j 1))) 0 6)
          (neg? (lx-esc-code e)) 0
          :else 2)))

;; index of the closing quote of the string that opens at i; -1 = unterminated; -(2+j) = bad escape at the backslash j
(defn lx-str-find [S :string i :i64] :i64
  (loop [j (+ i 1)]
    (if (>= j (string-length S))
      -1
      (let [c (lx-ch S j)]
        (cond
          (= c 34) j
          (= c 92) (if (>= (+ j 1) (string-length S))
                     -1
                     (if (zero? (lx-esc-w S j)) (- -2 j) (recur (+ j (lx-esc-w S j)))))
          :else (recur (+ j (lx-cpw c))))))))

;; decode S[j, e) into LITB (e = the closing quote, escapes already validated)
(defn- lx-str-loop [M :vector-i64 S :string j :i64 e :i64] :vector-i64
  (if (>= j e)
    (lx-id M)
    (let [c (lx-ch S j)]
      (cond (and (= c 92) (= (lx-ch S (+ j 1)) 117)) (lx-str-loop (lx-utf8-push M (lx-u4 S (+ j 1))) S (+ j 6) e)
            (= c 92) (lx-str-loop (lx-litb-push M (lx-esc-code (lx-ch S (+ j 1)))) S (+ j 2) e)
            :else (lx-str-loop (lx-utf8-push M c) S (+ j (lx-cpw c)) e)))))

;; close the string token spanning S[i, e]: LF-LEN of the reserved LIT record, then the token
(defn- lx-str-end [M :vector-i64 i :i64 e :i64] :vector-i64
  (let [lit (- (vector-at M MM-LIT-N) 1)
        b (+ MM-LIT-BASE (* lit MM-LIT-W))
        len (- (vector-at M MM-LITB-N) (vector-at M (+ b LF-B)))]
    (lx-push (lx-set M (+ b LF-LEN) len) TK-STR i (+ e 1) lit)))

;; reserve the LIT record (first byte, token index), then decode, then close
(defn- lx-string [M :vector-i64 S :string i :i64 e :i64] :vector-i64
  (let [lit (vector-at M MM-LIT-N)]
    (if (>= lit MM-LIT-CAP)
      (lx-full M 2)
      (let [b (+ MM-LIT-BASE (* lit MM-LIT-W))
            litb (vector-at M MM-LITB-N)
            tok (vector-at M MM-TOK-N)
            M1 (vector-assoc! M (+ b LF-B) litb)
            M2 (vector-assoc! M1 (+ b LF-TOK) tok)
            M3 (vector-assoc! M2 MM-LIT-N (+ lit 1))]
        (lx-str-end (lx-str-loop M3 S (+ i 1) e) i e)))))

;; ---------------------------------------------------------------------------------------------------------
;; the scan loop (one self tail call per token or skipped byte)
;; ---------------------------------------------------------------------------------------------------------
;; integer or symbol token spanning S[i, j)
;; ==== R6B (agent R6B, 2026-10-03, delimited): hex integer literals -?0x.. / -?0X.. (digits 0-9 a-f A-F), as the reference
;; reader reads them; the value must fit i64 (E1004 otherwise, like a decimal literal): 0x7fffffffffffffff and
;; -0x8000000000000000 are the extremes. The magnitude accumulates NEGATIVE so that -2^63 is representable.
(defn- lx-hx? [S :string a :i64 b :i64] :bool
  (let [s (lx-int-start S a)]
    (and (> b (+ s 2)) (= (lx-ch S s) 48) (or (= (lx-ch S (+ s 1)) 120) (= (lx-ch S (+ s 1)) 88))
         (loop [j (+ s 2)] (cond (>= j b) true (< (lx-hex (lx-ch S j)) 0) false :else (recur (+ j 1)))))))
;; the negated magnitude, or 1 when it does not fit in 64 bits
(defn- lx-hx-neg [S :string a :i64 b :i64] :i64
  (loop [j (+ (lx-int-start S a) 2) acc 0]
    (cond (>= j b) acc
          (< acc -576460752303423488) 1
          :else (let [n (- (* acc 16) (lx-hex (lx-ch S j)))] (if (> n 0) 1 (recur (+ j 1) n))))))
(defn- lx-hx-word [M :vector-i64 S :string i :i64 j :i64] :vector-i64
  (let [m (lx-hx-neg S i j)
        neg (= (lx-ch S i) 45)]
    (cond (> m 0) (lx-fail M E-LEX-INT i i j)
          neg (lx-push M TK-INT i j m)
          (= m -9223372036854775808) (lx-fail M E-LEX-INT i i j)
          :else (lx-push M TK-INT i j (- 0 m)))))
;; ==== END R6B hex ====

(defn- lx-word [M :vector-i64 S :string i :i64 j :i64] :vector-i64
  (if (lx-hx? S i j) (lx-hx-word M S i j)   ; R6B
  (if (lx-int? S i j)
    (if (lx-int-ovf S i j)
      (lx-fail M E-LEX-INT i i j)
      (lx-push M TK-INT i j (lx-int-val S i j)))
    (lx-push M TK-SYM i j 0))))

;; the string token that opens at i, given e = lx-str-find
(defn- lx-str-token [M :vector-i64 S :string i :i64 e :i64] :vector-i64
  (cond (>= e 0) (lx-string M S i e)
        (= e -1) (lx-fail M E-LEX-STRING i i (+ i 1))
        :else (lx-fail M E-LEX-ESCAPE (- -2 e) (- -2 e) (- 0 e))))

;; one multi-byte token at i (string, keyword, integer, symbol): the writer for it. Its end is lx-tok-end.
(defn lx-token [M :vector-i64 S :string i :i64 j :i64] :vector-i64
  (let [c (lx-ch S i)]
    (cond (= c 34) (lx-str-token M S i j)
          (= c 58) (if (= j (+ i 1)) (lx-fail M E-LEX-SYNTAX i i (+ i 1)) (lx-push M TK-KW i j 0))
          :else (lx-word M S i j))))

;; where the multi-byte token at i ends: after the closing quote, or at the end of the symbol-character run.
;; For an erroneous string the "end" is only used as an error carrier (a negative code), see lx-token.
(defn- lx-tok-end [S :string i :i64] :i64
  (let [c (lx-ch S i)]
    (cond (= c 34) (lx-str-find S i)
          (= c 58) (lx-word-end S (+ i 1))
          :else (lx-word-end S i))))

;; the position the scan continues at after the token whose lx-tok-end is j (a string: after the quote)
(defn lx-after [S :string i :i64 j :i64] :i64
  (if (= (lx-ch S i) 34) (+ j 1) j))

(defn- lx-scan [M :vector-i64 S :string i :i64 end :i64] :vector-i64
  (if (>= i end)
    (lx-id M)
    (if (= (vector-at M MM-ERR) 0)
      (let [c (lx-ch S i)
            pk (lx-punct c)]
        (cond
          (lx-ws? c) (lx-scan M S (+ i 1) end)
          (= c 59) (lx-scan M S (lx-eol S i) end)
          (> pk 0) (lx-scan (lx-push M pk i (+ i 1) 0) S (+ i 1) end)
          (lx-hash-brace? S i c) (lx-scan (lx-push M TK-HASH-BRACE i (+ i 2) 0) S (+ i 2) end)
          ;; R5A (agent R5A, minimal delimited change): #?( and #?@( select at read time (lx-rc below)
          (> (lx-rc-w S i c) 0) (lx-rc M S i end (lx-rc-w S i c))
          ;; R5B (agent R5B, delimited): '@' is a token of its own; 11-read reads @x as (deref x)
          (= c 64) (lx-scan (lx-push M TK-AT i (+ i 1) 0) S (+ i 1) end)
          ;; R6A (agent R6A, minimal delimited change): ^meta before a form reads as nothing (the reference keeps metadata off
          ;; the value; 932 of the 940 uses in the R6 modules are (def ^:private ..), and a def is never an export)
          (= c 94) (let [q (lx-sk-next S (+ i 1))] (if (< q 0) (lx-fail M E-LEX-SYNTAX i i (+ i 1)) (lx-scan M S q end)))
          (> c 127) (lx-fail-n M E-LEX-ASCII i (lx-lead c))
          (lx-multi? c)
          (let [j (lx-tok-end S i)]
            (lx-scan (lx-token M S i j) S (lx-after S i j) end))
          :else (lx-fail M E-LEX-SYNTAX i i (+ i 1))))
      (lx-id M))))

;; ---- R5A (agent R5A, 2026-10-03; docs/selfhost-seed-r5-design-20261002.md 2.4): reader conditionals ----------------
;; #?(f1 x1 f2 x2 ..) reads as the FIRST xk whose feature fk is :kotoba or :default, and as nothing when none matches;
;; #?@(..) splices the items of the selected vector or list. Unselected arms are host code, so they are passed over by
;; a lenient skipper (balanced brackets, strings, char literals, comments, #"..", tagged literals, prefixes, metadata)
;; that never classifies tokens; only the selected arm is lexed. Malformed (a feature that is not a keyword, a feature
;; without a form, an unclosed conditional, a splice of a non-sequence): E1006 at the '#'.
;; 3 for "#?(", 4 for "#?@(", else 0
(defn- lx-rc-w [S :string i :i64 c :i64] :i64
  (cond (not= c 35) 0
        (>= (+ i 2) (string-length S)) 0
        (not= (lx-ch S (+ i 1)) 63) 0
        (= (lx-ch S (+ i 2)) 40) 3
        (>= (+ i 3) (string-length S)) 0
        (and (= (lx-ch S (+ i 2)) 64) (= (lx-ch S (+ i 3)) 40)) 4
        :else 0))
;; past whitespace and comments
(defn lx-sk-ws [S :string p :i64] :i64
  (cond (>= p (string-length S)) p
        (lx-ws? (lx-ch S p)) (lx-sk-ws S (+ p 1))
        (= (lx-ch S p) 59) (lx-sk-ws S (lx-eol S p))
        :else p))
(defn- lx-closer? [c :i64] :bool (or (= c 41) (= c 93) (= c 125)))
(defn- lx-delim? [c :i64] :bool (or (lx-ws? c) (= c 40) (lx-closer? c) (= c 91) (= c 123) (= c 34) (= c 59)))
;; end of an atom run from p (stepping whole code points)
(defn- lx-sk-atom [S :string p :i64] :i64
  (cond (>= p (string-length S)) p
        (lx-delim? (lx-ch S p)) p
        :else (lx-sk-atom S (+ p (lx-cpw (lx-ch S p))))))
;; after the closing quote of the string whose first content byte is p, -1 at end of input
(defn- lx-sk-str [S :string p :i64] :i64
  (cond (>= p (string-length S)) -1
        (= (lx-ch S p) 34) (+ p 1)
        (= (lx-ch S p) 92) (if (>= (+ p 1) (string-length S)) -1 (lx-sk-str S (+ p 1 (lx-cpw (lx-ch S (+ p 1))))))
        :else (lx-sk-str S (+ p (lx-cpw (lx-ch S p))))))
;; after the closer of the sequence whose first item may start at p, -1 when unclosed
(defn- lx-sk-seq [S :string p :i64] :i64
  (let [q (lx-sk-ws S p)]
    (cond (>= q (string-length S)) -1
          (lx-closer? (lx-ch S q)) (+ q 1)
          :else (let [r (lx-sk-form S q)] (if (< r 0) -1 (lx-sk-seq S r))))))
;; the form after p (whitespace first), -1 when there is none
(defn- lx-sk-next [S :string p :i64] :i64
  (let [q (lx-sk-ws S p)]
    (if (>= q (string-length S)) -1 (lx-sk-form S q))))
;; '#' at p: dispatch forms
(defn- lx-sk-hash [S :string p :i64] :i64
  (if (>= (+ p 1) (string-length S))
    -1
    (let [d (lx-ch S (+ p 1))]
      (cond (= d 40) (lx-sk-seq S (+ p 2))
            (= d 123) (lx-sk-seq S (+ p 2))
            (= d 34) (lx-sk-str S (+ p 2))
            (= d 63) (lx-sk-form S (if (and (< (+ p 2) (string-length S)) (= (lx-ch S (+ p 2)) 64)) (+ p 3) (+ p 2)))
            (= d 95) (lx-sk-next S (+ p 2))
            (= d 39) (lx-sk-next S (+ p 2))
            (lx-delim? d) -1
            :else (lx-sk-next S (lx-sk-atom S (+ p 1)))))))
;; after the form that starts at p (p is not whitespace), -1 when malformed or unclosed
(defn lx-sk-form [S :string p :i64] :i64
  (let [c (lx-ch S p)]
    (cond (or (= c 40) (= c 91) (= c 123)) (lx-sk-seq S (+ p 1))
          (lx-closer? c) -1
          (= c 34) (lx-sk-str S (+ p 1))
          (= c 92) (if (>= (+ p 1) (string-length S)) -1 (lx-sk-atom S (+ p 1 (lx-cpw (lx-ch S (+ p 1))))))
          (= c 35) (lx-sk-hash S p)
          (= c 94) (let [m (lx-sk-next S (+ p 1))] (if (< m 0) -1 (lx-sk-next S m)))
          (and (= c 126) (< (+ p 1) (string-length S)) (= (lx-ch S (+ p 1)) 64)) (lx-sk-next S (+ p 2))
          (or (= c 39) (= c 96) (= c 126) (= c 64)) (lx-sk-next S (+ p 1))
          :else (lx-sk-atom S p))))
;; 1 when S[a,b) spells :kotoba or :default
(defn- lx-rc-feature? [S :string a :i64 b :i64] :bool
  (let [f (string-substring S a b)]
    (or (string=? f ":kotoba") (string=? f ":default"))))
;; start of the selected form of the clauses from p; -1 = none matches; -2 = malformed
(defn- lx-rc-sel [S :string p :i64 found :i64] :i64
  (let [q (lx-sk-ws S p)]
    (cond (>= q (string-length S)) -2
          (= (lx-ch S q) 41) found
          (not= (lx-ch S q) 58) -2
          :else (let [ke (lx-sk-atom S q)
                      f (lx-sk-ws S ke)]
                  (cond (= ke (+ q 1)) -2
                        (>= f (string-length S)) -2
                        (lx-closer? (lx-ch S f)) -2
                        :else (let [fe (lx-sk-form S f)]
                                (cond (< fe 0) -2
                                      (and (< found 0) (lx-rc-feature? S q ke)) (lx-rc-sel S fe f)
                                      :else (lx-rc-sel S fe found))))))))
;; the conditional at i (w = 3 or 4): lex the selected arm (a splice: its items), then go on after the conditional
(defn- lx-rc [M :vector-i64 S :string i :i64 end :i64 w :i64] :vector-i64
  (let [whole (lx-sk-seq S (+ i w))
        sel (lx-rc-sel S (+ i w) -1)
        se (if (< sel 0) -1 (lx-sk-form S sel))
        sc (if (< sel 0) 0 (lx-ch S sel))]
    (cond (or (< whole 0) (> whole end) (= sel -2)) (lx-fail M E-LEX-RC i i (+ i w))
          (= sel -1) (lx-scan M S whole end)
          (= w 3) (lx-scan (lx-scan M S sel se) S whole end)
          (or (= sc 91) (= sc 40)) (lx-scan (lx-scan M S (+ sel 1) (- se 1)) S whole end)
          :else (lx-fail M E-LEX-RC i i (+ i w)))))
;; ---- end R5A ----

;; whole-input ASCII check; stops at the first non-ASCII lead byte, so it never indexes a continuation byte. R3: no longer
;; part of lx-run (strings and comments may hold UTF-8); kept for 12-kirread's KIR lexer (kr-lex), which still uses it.
(defn- lx-ascii [M :vector-i64 S :string i :i64] :vector-i64
  (if (>= i (string-length S))
    (lx-id M)
    (let [c (lx-ch S i)]
      (if (> c 127)
        (lx-fail-n M E-LEX-ASCII i (lx-lead c))
        (lx-ascii M S (+ i 1))))))

;; R3: '#{' opens a set literal (any other '#' stays E1005)
(defn- lx-hash-brace? [S :string i :i64 c :i64] :bool
  (and (= c 35) (< (+ i 1) (string-length S)) (= (lx-ch S (+ i 1)) 123)))

;; scan after a clean ASCII check; the count of tokens is left in MM-R0
(defn lx-count [M :vector-i64] :vector-i64
  (let [n (- (vector-at M MM-TOK-N) 1)]
    (lx-set M MM-R0 n)))

(defn- lx-run2 [M :vector-i64 S :string] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (lx-count (lx-scan M S 0 (string-length S)))
    (lx-id M)))

(defn lx-run [M :vector-i64 S :string] :vector-i64
  (lx-run2 M S))
