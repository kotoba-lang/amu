;; seed/60-proj.kotoba -- multi-module projects: discovery, per-module compile against interfaces, machine-code link
;; (prefix pj-). Owner: agent R5A (rung R5 part A). Design: docs/selfhost-seed-r5-design-20261002.md sections 2.1-2.3 and 3
;; (option B: one process, M reset between modules, code appended to an image buffer, link = patch).
;;
;; The route (90-drv sends a compile here when --source-path is given or the entry's ns form has a clause 20-names does not
;; read: :require, an attr-map, a docstring):
;;   1. DISCOVER (pj-visit): the entry, then depth first every `:require` in clause order; each module is read into M
;;      (lex + read only), its ns header is parsed (pj-header: name, requires with :as/:refer, exports), its requires are
;;      resolved to files (namespace a.b-c -> a/b_c + .kotoba | .cljk | .cljc in each --source-path root) and visited;
;;      post-order gives the compile order (dependencies first, the entry last). Bounds: 256 modules, depth 64, 256 edges,
;;      8 MiB of source. Cycle, missing module, ns/path mismatch, duplicate alias, :use, two ns forms: refused by name.
;;   2. COMPILE each module alone (pj-module): its source S is followed by a generated TRAILER
;;        (ns <its name> (:export [..]))  -- the entry: its declared exports; a library: (:export []), i.e. nothing is a
;;                                          container export (a library's interface is the link table below, so an
;;                                          aborting or :string export is admitted, as in the reference)
;;        (defn- u/bump [p0 :i64] :i64 (u/bump p0))   -- one IMPORT STUB per interface entry of each required module,
;;                                          named as the importer spells it (alias/name, or the referred name), with the
;;                                          export's checked signature; an aborting export's stub body is (throw <zero of E>)
;;                                          so the importer infers :abort with E at every call (ADR 0363, as the reference's
;;                                          kotoba_import__i stubs)
;;      read as one source; the trailer's ns node replaces the module's own ns node (pj-splice), so 20-names .. 42-layout
;;      run unchanged on a single-namespace program. Qualified symbols a/f are ordinary symbols that resolve to the stubs;
;;      before that, pj-qscan refuses an alias that is not required (E6010) and a name that is not an export (E6004).
;;   3. LINK: 42-layout relocates the module's literal loads by its image base (M[MM-STAT-BASE+43]); 50-out's out-blob
;;      gives the code+pool bytes, copied into the image at an 8-aligned base; the FIRST instruction of every stub clause is
;;      overwritten with `b <entry of the export's clause>` (the stub is entered with the caller's arguments in x0..x4 and
;;      its link register, so the branch is a tail call; fuel is charged by the export). A library's interface (names,
;;      clause offsets in the image, stub templates) is recorded in L; then M is reset. The entry's container is the image
;;      with the entry module's exports (out-image).
;;
;; State that survives the reset lives in L (a second :vector-i64, layout below) and in P, a [:list :string] pool of the
;; strings (paths, names, aliases, stub templates); functions that add strings return P. Errors are recorded in M as by
;; the other modules (MM-ERR, MM-ERR-POS/A/B = a span of the source of module L[pj-k-errmod], which the driver prints).
;; Seed limits refused by name (E6017): interface types other than :i64 :bool :string :vector-i64 and option/result/list/
;; set/map of those, keyword or record types, variadic clauses, more than 8 clauses. Not here (part B / R6): effects,
;; :capabilities checks, --policy, templates (refused, E6023), closures dispatched across modules (a fn value of an import
;; is the stub's address, which branches on).

;; ---- L layout ------------------------------------------------------------------------------------------------------------
(def pj-l-cap 2097152)
(def pj-k-nmod 0)     ; modules
(def pj-k-img 1)      ; image fill in bytes
(def pj-k-nif 2)      ; interface entries
(def pj-k-nreq 3)     ; require edges
(def pj-k-nref 4)     ; referred names
(def pj-k-nroot 5)    ; source-path roots (P indexes at pj-k-root0 ..)
(def pj-k-unpinned 6) ; --unpinned given
(def pj-k-errmod 7)   ; module whose source the error spans of M refer to
(def pj-k-bytes 8)    ; project source bytes so far
(def pj-k-nstub 9)    ; stub clauses of the module being compiled
(def pj-k-stub0 10)   ; FN index of its first stub clause
(def pj-k-nord 11)    ; modules in the compile order
(def pj-k-nexpn 12)   ; declared export names
(def pj-k-trail 13)   ; byte offset of the trailer in the module's source
(def pj-k-base 14)    ; image base of the module being compiled
(def pj-k-root0 16)   ; .. 31: up to 16 roots
(def pj-m-base 64) (def pj-m-w 16) (def pj-m-cap 256)
(def pj-mf-name 0) (def pj-mf-path 1) (def pj-mf-state 2) (def pj-mf-depth 3) (def pj-mf-req0 4) (def pj-mf-nreq 5)
(def pj-mf-if0 6) (def pj-mf-nif 7) (def pj-mf-base 8) (def pj-mf-expk 9) (def pj-mf-exp0 10) (def pj-mf-nexp 11)
(def pj-r-base 8192) (def pj-r-w 8) (def pj-r-cap 256)
(def pj-rf-mod 0) (def pj-rf-name 1) (def pj-rf-alias 2) (def pj-rf-ref0 3) (def pj-rf-nref 4) (def pj-rf-node 5)
(def pj-f-base 12288) (def pj-f-w 3) (def pj-f-cap 1024)   ; referred name: P index, span start, span end
(def pj-x-base 16384) (def pj-x-cap 8192)                  ; declared export names (P indexes)
(def pj-i-base 32768) (def pj-i-w 16) (def pj-i-cap 4096)
(def pj-if-name 0) (def pj-if-text 1) (def pj-if-ncl 2) (def pj-if-off0 3) (def pj-if-maxcl 8)
(def pj-o-base 98304)                                      ; compile order (module indexes)
(def pj-t-base 98816) (def pj-t-cap 16384)                 ; stub clause -> target image offset (module being compiled)
(def pj-img-base 131072)
(def pj-max-depth 64) (def pj-max-edges 256) (def pj-max-bytes 8388608)

(defn- pj-l [L :vector-i64 i :i64] :i64 (vector-at L i))
(defn- pj-max [a :i64 b :i64] :i64 (if (> a b) a b))
(defn- pj-min [a :i64 b :i64] :i64 (if (< a b) a b))
(defn- pj-ls [L :vector-i64 i :i64 v :i64] :vector-i64 (vector-assoc! L i v))
(defn pj-mf [L :vector-i64 m :i64 f :i64] :i64 (vector-at L (+ pj-m-base (* m pj-m-w) f)))
(defn- pj-mset [L :vector-i64 m :i64 f :i64 v :i64] :vector-i64 (vector-assoc! L (+ pj-m-base (* m pj-m-w) f) v))
(defn- pj-rf [L :vector-i64 r :i64 f :i64] :i64 (vector-at L (+ pj-r-base (* r pj-r-w) f)))
(defn- pj-rset [L :vector-i64 r :i64 f :i64 v :i64] :vector-i64 (vector-assoc! L (+ pj-r-base (* r pj-r-w) f) v))
(defn- pj-if [L :vector-i64 e :i64 f :i64] :i64 (vector-at L (+ pj-i-base (* e pj-i-w) f)))
(defn- pj-iset [L :vector-i64 e :i64 f :i64 v :i64] :vector-i64 (vector-assoc! L (+ pj-i-base (* e pj-i-w) f) v))

(defn pj-new-l [] :vector-i64 (vector-alloc pj-l-cap))

;; ---- the string pool P ----------------------------------------------------------------------------------------------------
(defn pj-p [P [:list :string] i :i64] :string (typed-list-nth [:list :string] P i))
(defn pj-padd [P [:list :string] s :string] [:list :string] (typed-list-conj [:list :string] P s))

;; ---- M access ----------------------------------------------------------------------------------------------------------
(defn- pj-ok [M :vector-i64] :bool (= (vector-at M MM-ERR) 0))
(defn- pj-nf [M :vector-i64 n :i64 f :i64] :i64 (vector-at M (+ MM-NODE-BASE (* n MM-NODE-W) f)))
(defn- pj-nset [M :vector-i64 n :i64 f :i64 v :i64] :vector-i64 (vector-assoc! M (+ MM-NODE-BASE (* n MM-NODE-W) f) v))
(defn- pj-tf [M :vector-i64 t :i64 f :i64] :i64 (vector-at M (+ MM-TOK-BASE (* t MM-TOK-W) f)))
(defn- pj-kind [M :vector-i64 n :i64] :i64 (pj-nf M n NF-KIND))
(defn- pj-first [M :vector-i64 n :i64] :i64 (pj-nf M n NF-FIRST))
(defn- pj-next [M :vector-i64 n :i64] :i64 (pj-nf M n NF-NEXT))
(defn- pj-a [M :vector-i64 n :i64] :i64 (pj-tf M (pj-nf M n NF-TOK) TF-START))
(defn- pj-b [M :vector-i64 n :i64] :i64 (pj-tf M (pj-nf M n NF-TOK) TF-END))
;; the text of atom node n
(defn- pj-text [M :vector-i64 S :string n :i64] :string (string-substring S (pj-a M n) (pj-b M n)))
;; S[a,b) spells s (no allocation)
(defn- pj-span= [S :string a :i64 b :i64 s :string] :bool
  (and (= (- b a) (string-length s))
       (loop [i 0]
         (cond (>= i (string-length s)) true
               (not= (string-code-point-at S (+ a i)) (string-code-point-at s i)) false
               :else (recur (+ i 1))))))
(defn- pj-is [M :vector-i64 S :string n :i64 s :string] :bool (pj-span= S (pj-a M n) (pj-b M n) s))

;; first error wins; the span of node n (n = 0: no position)
(defn- pj-err-span [M :vector-i64 code :i64 pos :i64 a :i64 b :i64] :vector-i64
  (if (pj-ok M)
    (-> M (vector-assoc! MM-ERR code) (vector-assoc! MM-ERR-POS pos) (vector-assoc! MM-ERR-A (pj-max a 0)) (vector-assoc! MM-ERR-B (pj-max b 0)))
    M))
(defn- pj-err [M :vector-i64 code :i64 n :i64] :vector-i64
  (if (= n 0) (pj-err-span M code -1 0 0) (pj-err-span M code (pj-a M n) (pj-a M n) (pj-b M n))))

;; ---- reset of M between modules ------------------------------------------------------------------------------------------
(defn- pj-zero [M :vector-i64 a :i64 e :i64] :vector-i64
  (loop [i a]
    (if (>= i e) M (let [w (vector-assoc! M i 0)] (recur (+ i 1))))))

;; zero exactly what a compile filled (every region's prefix up to its fill, the whole HASH and SCOPE regions, the HEAP up to
;; its top, the header and statistics cells), then the state of mem-new: "fresh words are zero" holds for the next module
(defn- pj-reset [M :vector-i64] :vector-i64
  (let [ntok (vector-at M MM-TOK-N) nnode (vector-at M MM-NODE-N) nsym (vector-at M MM-SYM-N) nfn (vector-at M MM-FN-N)
        nsir (vector-at M MM-SIR-N) nlab (vector-at M MM-LABEL-N) ncode (vector-at M MM-CODE-N) nfix (vector-at M MM-FIX-N)
        nlit (vector-at M MM-LIT-N) nlitb (vector-at M MM-LITB-N) nexp (vector-at M MM-EXP-N) nout (vector-at M MM-OUT-N)
        top (vector-at M MM-HEAP-TOP)]
    (-> M
        (pj-zero MM-TOK-BASE (+ MM-TOK-BASE (* ntok MM-TOK-W)))
        (pj-zero MM-NODE-BASE (+ MM-NODE-BASE (* nnode MM-NODE-W)))
        (pj-zero MM-SYM-BASE (+ MM-SYM-BASE (* nsym MM-SYM-W)))
        (pj-zero MM-HASH-BASE (+ MM-HASH-BASE (* MM-HASH-CAP MM-HASH-W)))
        (pj-zero MM-FN-BASE (+ MM-FN-BASE (* nfn MM-FN-W)))
        (pj-zero MM-SCOPE-BASE (+ MM-SCOPE-BASE (* MM-SCOPE-CAP MM-SCOPE-W)))
        (pj-zero MM-SIR-BASE (+ MM-SIR-BASE (* nsir MM-SIR-W)))
        (pj-zero MM-LABEL-BASE (pj-min (+ MM-LABEL-BASE nlab 1) (+ MM-LABEL-BASE MM-LABEL-CAP)))
        (pj-zero MM-CODE-BASE (+ MM-CODE-BASE ncode))
        (pj-zero MM-FIX-BASE (+ MM-FIX-BASE (* nfix MM-FIX-W)))
        (pj-zero MM-LIT-BASE (+ MM-LIT-BASE (* nlit MM-LIT-W)))
        (pj-zero MM-LITB-BASE (+ MM-LITB-BASE nlitb))
        (pj-zero MM-EXP-BASE (+ MM-EXP-BASE (* nexp MM-EXP-W)))
        (pj-zero MM-OUT-BASE (+ MM-OUT-BASE nout))
        (pj-zero MM-HEAP-BASE (pj-max top MM-HEAP-BASE))
        (pj-zero 0 256)
        (vector-assoc! MM-VERSION MM-LAYOUT-VERSION)
        (mem-init-fills MM-TOK-N)
        (mem-set MM-HASH-N 0)
        (mem-set MM-HEAP-TOP MM-HEAP-BASE)
        (mem-set MM-ERR-POS -1))))

;; reset, then lex and read S (one module's source, with or without its trailer)
(defn- pj-read [M :vector-i64 S :string] :vector-i64
  (let [M1 (mem-set (pj-reset M) MM-SRC-LEN (string-length S))
        M2 (lx-run M1 S)]
    (if (pj-ok M2) (rd-run M2 S) M2)))

;; ---- names and paths -----------------------------------------------------------------------------------------------------
;; namespace a.b-c -> relative path a/b_c
(defn- pj-rel [nm :string] :string
  (loop [i 0 a 0 acc ""]
    (cond (>= i (string-length nm)) (string-concat acc (string-substring nm a i))
          (= (string-code-point-at nm i) 46) (recur (+ i 1) (+ i 1) (string-concat (string-concat acc (string-substring nm a i)) "/"))
          (= (string-code-point-at nm i) 45) (recur (+ i 1) (+ i 1) (string-concat (string-concat acc (string-substring nm a i)) "_"))
          :else (recur (+ i 1) a acc))))

(defn- pj-ext [k :i64] :string (case k 0 ".kotoba" 1 ".cljk" ".cljc"))

;; the file of rel in root: the first extension that exists, else ""
(defn- pj-in-root [root :string rel :string] :string
  (loop [k 0]
    (cond (> k 2) ""
          (= (io-exists (string-concat root (string-concat "/" (string-concat rel (pj-ext k))))) 1)
          (string-concat root (string-concat "/" (string-concat rel (pj-ext k))))
          :else (recur (+ k 1)))))

(defn- pj-kotoba? [path :string] :bool
  (and (>= (string-length path) 7) (string=? (string-substring path (- (string-length path) 7) (string-length path)) ".kotoba")))

;; the file of namespace nm over the roots: "" none; "\n" ambiguous (two roots, not exactly one .kotoba among them)
(defn- pj-locate [L :vector-i64 P [:list :string] nm :string] :string
  (let [rel (pj-rel nm)
        n (pj-l L pj-k-nroot)]
    (loop [k 0 found "" nfound 0 nkot 0 kot ""]
      (if (>= k n)
        (cond (= nfound 0) "" (= nfound 1) found (= nkot 1) kot :else "\n")
        (let [c (pj-in-root (pj-p P (pj-l L (+ pj-k-root0 k))) rel)]
          (cond (= (string-length c) 0) (recur (+ k 1) found nfound nkot kot)
                (pj-kotoba? c) (recur (+ k 1) c (+ nfound 1) (+ nkot 1) c)
                :else (recur (+ k 1) c (+ nfound 1) nkot kot)))))))

;; the module named nm, -1 when none
(defn- pj-find-mod [L :vector-i64 P [:list :string] nm :string] :i64
  (loop [m 0]
    (cond (>= m (pj-l L pj-k-nmod)) -1
          (string=? (pj-p P (pj-mf L m pj-mf-name)) nm) m
          :else (recur (+ m 1)))))

;; a new module record (state 0); its index is the old count
(defn- pj-add-mod [L :vector-i64 name :i64 path :i64] :vector-i64
  (let [m (pj-l L pj-k-nmod)]
    (-> L (pj-mset m pj-mf-name name) (pj-mset m pj-mf-path path) (pj-mset m pj-mf-state 0) (pj-mset m pj-mf-depth 0)
        (pj-mset m pj-mf-nreq 0) (pj-mset m pj-mf-nif 0) (pj-mset m pj-mf-expk 0) (pj-mset m pj-mf-nexp 0)
        (pj-ls pj-k-nmod (+ m 1)))))

;; ---- the ns header ------------------------------------------------------------------------------------------------------
;; n is a list whose head symbol spells h
(defn- pj-head? [M :vector-i64 S :string n :i64 h :string] :bool
  (and (= (pj-kind M n) ND-LIST) (= (pj-kind M (pj-first M n)) ND-SYM) (pj-is M S (pj-first M n) h)))

(defn- pj-count-ns [M :vector-i64 S :string] :i64
  (loop [n (pj-first M (vector-at M MM-ROOT)) k 0]
    (cond (= n 0) k
          (pj-head? M S n "ns") (recur (pj-next M n) (+ k 1))
          :else (recur (pj-next M n) k))))

;; the name node of the top-level (defn|defn-|def NAME ..) n, else 0
(defn- pj-def-name [M :vector-i64 S :string n :i64] :i64
  (let [nm (pj-next M (pj-first M n))]
    (if (and (or (pj-head? M S n "defn") (pj-head? M S n "defn-") (pj-head? M S n "def")) (= (pj-kind M nm) ND-SYM)) nm 0)))

;; number of public defns
(defn- pj-count-pub [M :vector-i64 S :string] :i64
  (loop [n (pj-first M (vector-at M MM-ROOT)) k 0]
    (cond (= n 0) k
          (pj-head? M S n "defn") (recur (pj-next M n) (+ k 1))
          :else (recur (pj-next M n) k))))

;; a top-level definition is spelled s
(defn- pj-defined? [M :vector-i64 S :string s :string] :bool
  (loop [n (pj-first M (vector-at M MM-ROOT))]
    (cond (= n 0) false
          (and (> (pj-def-name M S n) 0) (pj-is M S (pj-def-name M S n) s)) true
          :else (recur (pj-next M n)))))

;; append the symbols of vector v as declared exports of module m
(defn- pj-exports [M :vector-i64 L :vector-i64 P [:list :string] S :string v :i64] [:list :string]
  (loop [c (pj-first M v) P P]
    (cond (not (pj-ok M)) P
          (= c 0) P
          (not= (pj-kind M c) ND-SYM) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          (>= (pj-l L pj-k-nexpn) pj-x-cap) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          :else (let [k (pj-l L pj-k-nexpn)
                      w (pj-ls (pj-ls L (+ pj-x-base k) (count P)) pj-k-nexpn (+ k 1))]
                  (recur (pj-next M c) (pj-padd P (pj-text M S c)))))))

;; module m declares its exports with the vector v (kind 1 clause, 2 attr-map)
(defn- pj-declare [M :vector-i64 L :vector-i64 P [:list :string] S :string v :i64] [:list :string]
  (let []
    (cond (> (pj-mf L (pj-l L pj-k-errmod) pj-mf-expk) 0) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          (not= (pj-kind M v) ND-VEC) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          :else (let [cur (pj-l L pj-k-errmod)
                      w (-> L (pj-mset cur pj-mf-expk 1) (pj-mset cur pj-mf-exp0 (pj-l L pj-k-nexpn)))
                      P2 (pj-exports M L P S v)]
                  (let [w2 (pj-mset L cur pj-mf-nexp (- (pj-l L pj-k-nexpn) (pj-mf L cur pj-mf-exp0)))] P2)))))

;; an alias already used by a require of module cur
(defn- pj-alias-dup? [L :vector-i64 P [:list :string] cur :i64 a :string] :bool
  (loop [r (pj-mf L cur pj-mf-req0)]
    (cond (>= r (pj-l L pj-k-nreq)) false
          (and (>= (pj-rf L r pj-rf-alias) 0) (string=? (pj-p P (pj-rf L r pj-rf-alias)) a)) true
          :else (recur (+ r 1)))))

(defn- pj-ns-dup? [L :vector-i64 P [:list :string] cur :i64 a :string] :bool
  (loop [r (pj-mf L cur pj-mf-req0)]
    (cond (>= r (pj-l L pj-k-nreq)) false
          (string=? (pj-p P (pj-rf L r pj-rf-name)) a) true
          :else (recur (+ r 1)))))

;; a name referred by an earlier require of module cur (or the one being read)
(defn- pj-refer-dup? [L :vector-i64 P [:list :string] cur :i64 a :string] :bool
  (loop [f (pj-rf L (pj-mf L cur pj-mf-req0) pj-rf-ref0)]
    (cond (>= f (pj-l L pj-k-nref)) false
          (string=? (pj-p P (pj-l L (+ pj-f-base (* f pj-f-w)))) a) true
          :else (recur (+ f 1)))))

;; the referred names of vector v
(defn- pj-refers [M :vector-i64 L :vector-i64 P [:list :string] S :string v :i64] [:list :string]
  (let [cur (pj-l L pj-k-errmod)]
    (loop [c (pj-first M v) P P]
      (cond (not (pj-ok M)) P
            (= c 0) P
            (not= (pj-kind M c) ND-SYM) (let [w (pj-err M E-PROJ-SPEC c)] P)
            (>= (pj-l L pj-k-nref) pj-f-cap) (let [w (pj-err M E-PROJ-EDGES c)] P)
            (pj-refer-dup? L P cur (pj-text M S c)) (let [w (pj-err M E-PROJ-REFER c)] P)
            (pj-defined? M S (pj-text M S c)) (let [w (pj-err M E-PROJ-REFER c)] P)
            :else (let [f (pj-l L pj-k-nref)
                        b (+ pj-f-base (* f pj-f-w))
                        r (- (pj-l L pj-k-nreq) 1)
                        w (-> L (pj-ls b (count P)) (pj-ls (+ b 1) (pj-a M c)) (pj-ls (+ b 2) (pj-b M c)) (pj-ls pj-k-nref (+ f 1))
                              (pj-rset r pj-rf-nref (+ (pj-rf L r pj-rf-nref) 1)))]
                    (recur (pj-next M c) (pj-padd P (pj-text M S c))))))))

;; the options after the namespace symbol of a require spec, from node o (the edge r is the last one)
(defn- pj-spec-opts [M :vector-i64 L :vector-i64 P [:list :string] S :string o :i64] [:list :string]
  (let [cur (pj-l L pj-k-errmod)
        r (- (pj-l L pj-k-nreq) 1)
        v (pj-next M o)]
    (cond (not (pj-ok M)) P
          (= o 0) P
          (not= (pj-kind M o) ND-KW) (let [w (pj-err M E-PROJ-SPEC o)] P)
          (= v 0) (let [w (pj-err M E-PROJ-SPEC o)] P)
          (pj-is M S o ":as")
          (cond (not= (pj-kind M v) ND-SYM) (let [w (pj-err M E-PROJ-SPEC v)] P)
                (>= (pj-rf L r pj-rf-alias) 0) (let [w (pj-err M E-PROJ-SPEC o)] P)
                (pj-alias-dup? L P cur (pj-text M S v)) (let [w (pj-err M E-PROJ-DUP-ALIAS v)] P)
                :else (let [w (pj-rset L r pj-rf-alias (count P))]
                        (pj-spec-opts M L (pj-padd P (pj-text M S v)) S (pj-next M v))))
          (pj-is M S o ":refer")
          (if (= (pj-kind M v) ND-VEC)
            (pj-spec-opts M L (pj-refers M L P S v) S (pj-next M v))
            (let [w (pj-err M E-PROJ-SPEC v)] P))
          (pj-is M S o ":with") (let [w (pj-err M E-PROJ-TEMPLATE o)] P)
          :else (let [w (pj-err M E-PROJ-SPEC o)] P))))

;; one require spec [ns :as a :refer [..]]
(defn- pj-spec [M :vector-i64 L :vector-i64 P [:list :string] S :string sp :i64] [:list :string]
  (let [cur (pj-l L pj-k-errmod)
        nm (pj-first M sp)
        r (pj-l L pj-k-nreq)]
    (cond (not= (pj-kind M sp) ND-VEC) (let [w (pj-err M E-PROJ-SPEC sp)] P)
          (not= (pj-kind M nm) ND-SYM) (let [w (pj-err M E-PROJ-SPEC sp)] P)
          (pj-ns-dup? L P cur (pj-text M S nm)) (let [w (pj-err M E-PROJ-DUP-NS nm)] P)
          (>= r pj-r-cap) (let [w (pj-err M E-PROJ-EDGES nm)] P)
          :else (let [w (-> L (pj-rset r pj-rf-mod -1) (pj-rset r pj-rf-name (count P)) (pj-rset r pj-rf-alias -1)
                            (pj-rset r pj-rf-ref0 (pj-l L pj-k-nref)) (pj-rset r pj-rf-nref 0) (pj-rset r pj-rf-node nm)
                            (pj-ls pj-k-nreq (+ r 1)) (pj-mset cur pj-mf-nreq (+ (pj-mf L cur pj-mf-nreq) 1)))]
                  (pj-spec-opts M L (pj-padd P (pj-text M S nm)) S (pj-next M nm))))))

(defn- pj-specs [M :vector-i64 L :vector-i64 P [:list :string] S :string sp :i64] [:list :string]
  (if (or (= sp 0) (not (pj-ok M))) P (pj-specs M L (pj-spec M L P S sp) S (pj-next M sp))))

;; the attr-map {k v ..} of the ns form
(defn- pj-attrs [M :vector-i64 L :vector-i64 P [:list :string] S :string k :i64] [:list :string]
  (let [v (pj-next M k)]
    (cond (or (= k 0) (not (pj-ok M))) P
          (= v 0) (let [w (pj-err M E-PROJ-NSFORM k)] P)
          (pj-is M S k ":kotoba/export") (pj-attrs M L (pj-declare M L P S v) S (pj-next M v))
          (pj-is M S k ":kotoba/params") (let [w (pj-err M E-PROJ-TEMPLATE k)] P)
          :else (pj-attrs M L P S (pj-next M v)))))

;; one clause or attr-map of the ns form
(defn- pj-clause [M :vector-i64 L :vector-i64 P [:list :string] S :string c :i64] [:list :string]
  (let [k (pj-first M c)]
    (cond (= (pj-kind M c) ND-STR) P
          (= (pj-kind M c) ND-MAP) (pj-attrs M L P S (pj-first M c))
          (not= (pj-kind M c) ND-LIST) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          (not= (pj-kind M k) ND-KW) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          (pj-is M S k ":require") (pj-specs M L P S (pj-next M k))
          (pj-is M S k ":export") (if (= (pj-next M (pj-next M k)) 0) (pj-declare M L P S (pj-next M k)) (let [w (pj-err M E-PROJ-NSFORM c)] P))
          (or (pj-is M S k ":capabilities") (pj-is M S k ":schemas") (pj-is M S k ":refer-clojure")) P
          (pj-is M S k ":params") (let [w (pj-err M E-PROJ-TEMPLATE k)] P)
          (pj-is M S k ":use") (let [w (pj-err M E-PROJ-USE k)] P)
          :else (let [w (pj-err M E-PROJ-CLAUSE k)] P))))

(defn- pj-clauses [M :vector-i64 L :vector-i64 P [:list :string] S :string c :i64] [:list :string]
  (if (or (= c 0) (not (pj-ok M))) P (pj-clauses M L (pj-clause M L P S c) S (pj-next M c))))

;; parse the header of module L[errmod] (its source S is read into M); expect = the required name ("" for the entry)
(defn- pj-header [M :vector-i64 L :vector-i64 P [:list :string] S :string expect :string] [:list :string]
  (let [cur (pj-l L pj-k-errmod)
        ns (pj-first M (vector-at M MM-ROOT))
        nmn (pj-next M (pj-first M ns))]
    (cond (not= (pj-count-ns M S) 1) (let [w (pj-err M E-PROJ-NS ns)] P)
          (not (pj-head? M S ns "ns")) (let [w (pj-err M E-PROJ-NS ns)] P)
          (not= (pj-kind M nmn) ND-SYM) (let [w (pj-err M E-PROJ-NSFORM ns)] P)
          (and (> (string-length expect) 0) (not (pj-is M S nmn expect))) (let [w (pj-err M E-PROJ-MISMATCH nmn)] P)
          :else (let [w (-> L (pj-mset cur pj-mf-req0 (pj-l L pj-k-nreq)) (pj-mset cur pj-mf-nreq 0))
                      P1 (if (= cur 0) (let [w1 (pj-mset L 0 pj-mf-name (count P))] (pj-padd P (pj-text M S nmn))) P)
                      P2 (pj-clauses M L P1 S (pj-next M nmn))]
                  (cond (not (pj-ok M)) P2
                        (and (> cur 0) (= (pj-mf L cur pj-mf-expk) 0) (= (pj-count-pub M S) 0)) (let [w2 (pj-err M E-PROJ-NOTHING nmn)] P2)
                        :else P2)))))

;; ---- discovery --------------------------------------------------------------------------------------------------------
;; resolve require edge r of module cur (depth d) to a module: an existing one, or a new one from the roots
(defn- pj-resolve [M :vector-i64 L :vector-i64 P [:list :string] r :i64 d :i64] [:list :string]
  (let [nm (pj-p P (pj-rf L r pj-rf-name))
        node (pj-rf L r pj-rf-node)
        m (pj-find-mod L P nm)]
    (cond (> (+ d 1) pj-max-depth) (let [w (pj-err M E-PROJ-DEPTH node)] P)
          (and (>= m 0) (= (pj-mf L m pj-mf-state) 1)) (let [w (pj-err M E-PROJ-CYCLE node)] P)
          (>= m 0) (let [w (pj-rset L r pj-rf-mod m)] P)
          (>= (pj-l L pj-k-nmod) pj-m-cap) (let [w (pj-err M E-PROJ-MODULES node)] P)
          :else (let [path (pj-locate L P nm)]
                  (cond (= (string-length path) 0) (let [w (pj-err M E-PROJ-MISSING node)] P)
                        (string=? path "\n") (let [w (pj-err M E-PROJ-AMBIGUOUS node)] P)
                        :else (let [k (pj-l L pj-k-nmod)
                                    w (-> L (pj-add-mod (pj-rf L r pj-rf-name) (count P)) (pj-rset r pj-rf-mod k) (pj-mset k pj-mf-depth (+ d 1)))]
                                (pj-padd P path)))))))

(defn- pj-resolve-all [M :vector-i64 L :vector-i64 P [:list :string] cur :i64] [:list :string]
  (let [r0 (pj-mf L cur pj-mf-req0)
        n (pj-mf L cur pj-mf-nreq)
        d (pj-mf L cur pj-mf-depth)]
    (loop [k 0 P P]
      (if (or (>= k n) (not (pj-ok M))) P (recur (+ k 1) (pj-resolve M L P (+ r0 k) d))))))

;; visit module m: read, header, resolve, children, then append m to the compile order
(defn- pj-visit [M :vector-i64 L :vector-i64 P [:list :string] m :i64] [:list :string]
  (let [path (pj-p P (pj-mf L m pj-mf-path))
        S (io-read-file M path)
        bytes (+ (pj-l L pj-k-bytes) (string-length S))
        w (-> L (pj-ls pj-k-bytes bytes) (pj-ls pj-k-errmod m) (pj-mset m pj-mf-state 1))
        M1 (pj-read M S)]
    (cond (not (pj-ok M1)) P
          (> bytes pj-max-bytes) (let [w2 (pj-err M1 E-PROJ-BYTES 0)] P)
          :else
          (let [P2 (pj-header M1 L P S (if (= m 0) "" (pj-p P (pj-mf L m pj-mf-name))))
                P3 (if (pj-ok M1) (pj-resolve-all M1 L P2 m) P2)
                r0 (pj-mf L m pj-mf-req0)
                n (pj-mf L m pj-mf-nreq)
                P4 (loop [k 0 P P3]
                     (cond (or (>= k n) (not (pj-ok M1))) P
                           (= (pj-mf L (pj-rf L (+ r0 k) pj-rf-mod) pj-mf-state) 0) (recur (+ k 1) (pj-visit M1 L P (pj-rf L (+ r0 k) pj-rf-mod)))
                           :else (recur (+ k 1) P)))
                no (pj-l L pj-k-nord)]
            (if (pj-ok M1)
              (let [w3 (-> L (pj-mset m pj-mf-state 2) (pj-ls (+ pj-o-base no) m) (pj-ls pj-k-nord (+ no 1)))] P4)
              P4)))))

;; ---- interface types and stub templates -------------------------------------------------------------------------------
(defn- pj-ct [M :vector-i64 t :i64 f :i64] :i64 (vector-at M (+ (vector-at M MM-CT) (* (- t TY-COMP-BASE) CT-W) f)))

;; the source spelling of type t, "" when it does not cross a module boundary in the seed
(defn- pj-ty [M :vector-i64 t :i64] :string
  (cond (= t TY-I64) ":i64" (= t TY-BOOL) ":bool" (= t TY-STR) ":string" (= t TY-VEC) ":vector-i64"
        (< t TY-COMP-BASE) ""
        :else (let [c (pj-ct M t CT-CTOR)
                    a (pj-ty M (pj-ct M t CT-A))
                    b (if (or (= c TC-RESULT) (= c TC-MAP)) (pj-ty M (pj-ct M t CT-B)) ":i64")]
                (cond (or (= (string-length a) 0) (= (string-length b) 0)) ""
                      (= c TC-OPTION) (string-concat "[:option " (string-concat a "]"))
                      (= c TC-LIST) (string-concat "[:list " (string-concat a "]"))
                      (= c TC-SET) (string-concat "[:set " (string-concat a "]"))
                      (= c TC-RESULT) (string-concat "[:result " (string-concat a (string-concat " " (string-concat b "]"))))
                      (= c TC-MAP) (string-concat "[:map " (string-concat a (string-concat " " (string-concat b "]"))))
                      :else ""))))

;; a value of the error type e for a stub's throw, "" when none is spelled here
(defn- pj-zero-of [e :i64] :string
  (cond (= e TY-I64) "0" (= e TY-STR) "\"\"" (= e TY-BOOL) "false" :else ""))

(defn- pj-ff [M :vector-i64 f :i64 k :i64] :i64 (vector-at M (+ MM-FN-BASE (* f MM-FN-W) k)))
(defn- pj-sf [M :vector-i64 s :i64 k :i64] :i64 (vector-at M (+ MM-SYM-BASE (* s MM-SYM-W) k)))

;; "[p0 T0 p1 T1 ..]" of clause f, "" when a type does not cross
(defn- pj-params [M :vector-i64 f :i64] :string
  (let [n (pj-ff M f FF-NPARAMS)]
    (loop [i 0 acc "["]
      (cond (>= i n) (string-concat acc "]")
            (= (string-length (pj-ty M (pj-ff M f (+ FF-PT0 i)))) 0) ""
            :else (recur (+ i 1) (string-concat acc (string-concat (if (= i 0) "p" " p") (string-concat (mem-u2dec i)
                                   (string-concat " " (pj-ty M (pj-ff M f (+ FF-PT0 i))))))))))))

;; "(SEEDSELF p0 p1 ..)": the self call that types a stub body
(defn- pj-selfcall [n :i64] :string
  (loop [i 0 acc "(SEEDSELF"]
    (if (>= i n) (string-concat acc ")") (recur (+ i 1) (string-concat acc (string-concat " p" (mem-u2dec i)))))))

;; the variadic flag of clause f (21-check marks NF-TYPE 1 on a variadic clause's parameter vector)
(defn- pj-variadic? [M :vector-i64 f :i64] :bool
  (let [n (pj-ff M f FF-NODE)
        pv (pj-next M (pj-next M (pj-first M n)))]
    (and (= (pj-kind M pv) ND-VEC) (= (pj-nf M pv NF-TYPE) 1))))

;; "[params] R body" of clause f, "" when it does not cross
(defn- pj-clause-text [M :vector-i64 f :i64] :string
  (let [ps (pj-params M f)
        r (pj-ty M (pj-ff M f FF-RTYPE))
        ab (pj-sf M (pj-ff M f FF-SYM) SF-ABORT)
        body (if (= ab 0) (pj-selfcall (pj-ff M f FF-NPARAMS)) (string-concat "(throw " (string-concat (pj-zero-of ab) ")")))]
    (cond (or (= (string-length ps) 0) (= (string-length r) 0)) ""
          (and (not= ab 0) (= (string-length (pj-zero-of ab)) 0)) ""
          (pj-variadic? M f) ""
          :else (string-concat ps (string-concat " " (string-concat r (string-concat " " body)))))))

;; replace every SEEDSELF in t by q
(defn- pj-subst [t :string q :string] :string
  (let [i (string-index-of t "SEEDSELF")]
    (if (< i 0) t (string-concat (string-substring t 0 i) (string-concat q (pj-subst (string-substring t (+ i 8) (string-length t)) q))))))

;; the first FN clause of the function spelled s in the module in M (S its source), 0 when none
(defn- pj-fn-named [M :vector-i64 S :string s :string] :i64
  (loop [f 1]
    (cond (>= f (vector-at M MM-FN-N)) 0
          (and (or (= (pj-ff M f FF-KIND) FK-DEFN) (= (pj-ff M f FF-KIND) FK-PRIV) (= (pj-ff M f FF-KIND) FK-DEF))
               (= (pj-sf M (pj-ff M f FF-SYM) SF-FN) f)
               (string=? (string-substring S (pj-sf M (pj-ff M f FF-SYM) SF-START) (pj-sf M (pj-ff M f FF-SYM) SF-END)) s)) f
          :else (recur (+ f 1)))))

;; record the interface entry of export s (first clause f0) of module m; base = the module's image offset
(defn- pj-iface-one [M :vector-i64 L :vector-i64 P [:list :string] s :string f0 :i64] [:list :string]
  (let [e (pj-l L pj-k-nif)
        sym (pj-ff M f0 FF-SYM)
        base (pj-l L pj-k-base)
        ncl (loop [f f0 k 0] (if (and (< f (vector-at M MM-FN-N)) (= (pj-ff M f FF-SYM) sym) (not= (pj-ff M f FF-KIND) FK-DEF)) (recur (+ f 1) (+ k 1)) k))
        txt (loop [k 0 acc ""]
              (cond (>= k ncl) acc
                    (= (string-length (pj-clause-text M (+ f0 k))) 0) ""
                    (= ncl 1) (pj-clause-text M f0)
                    :else (recur (+ k 1) (string-concat acc (string-concat " (" (string-concat (pj-clause-text M (+ f0 k)) ")"))))))]
    (cond (or (= ncl 0) (= (pj-ff M f0 FF-KIND) FK-DEF)) (let [w (pj-err-span M E-PROJ-EXPORT-FN (pj-sf M sym SF-START) (pj-sf M sym SF-START) (pj-sf M sym SF-END))] P)
          (or (> ncl pj-if-maxcl) (= (string-length txt) 0)) (let [w (pj-err-span M E-PROJ-IFACE (pj-sf M sym SF-START) (pj-sf M sym SF-START) (pj-sf M sym SF-END))] P)
          (>= e pj-i-cap) (let [w (pj-err M E-PROJ-EDGES 0)] P)
          :else (let [w (-> L (pj-iset e pj-if-name (count P)) (pj-iset e pj-if-text (+ (count P) 1)) (pj-iset e pj-if-ncl ncl) (pj-ls pj-k-nif (+ e 1)))
                      w2 (loop [k 0] (if (>= k ncl) 0 (let [x (pj-iset L e (+ pj-if-off0 k) (+ base (* (- (pj-ff M (+ f0 k) FF-CODE) 1) 4)))] (recur (+ k 1)))))]
                  (pj-padd (pj-padd P s) txt)))))

;; the interface of library module m (compiled, still in M; S = its source with the trailer)
(defn- pj-iface [M :vector-i64 L :vector-i64 P [:list :string] S :string m :i64] [:list :string]
  (let [w (-> L (pj-mset m pj-mf-if0 (pj-l L pj-k-nif)))
        P2 (if (> (pj-mf L m pj-mf-expk) 0)
             (loop [k 0 P P]
               (cond (or (>= k (pj-mf L m pj-mf-nexp)) (not (pj-ok M))) P
                     :else (let [s (pj-p P (pj-l L (+ pj-x-base (pj-mf L m pj-mf-exp0) k)))
                                 f (pj-fn-named M S s)]
                             (if (= f 0)
                               (let [w2 (pj-err-span M E-PROJ-EXPORT-FN -1 0 0)] P)
                               (recur (+ k 1) (pj-iface-one M L P s f))))))
             (loop [f 1 P P]
               (cond (or (>= f (vector-at M MM-FN-N)) (not (pj-ok M))) P
                     (and (= (pj-ff M f FF-KIND) FK-DEFN) (= (pj-sf M (pj-ff M f FF-SYM) SF-FN) f))
                     (recur (+ f 1) (pj-iface-one M L P (string-substring S (pj-sf M (pj-ff M f FF-SYM) SF-START) (pj-sf M (pj-ff M f FF-SYM) SF-END)) f))
                     :else (recur (+ f 1) P))))]
    (let [w3 (pj-mset L m pj-mf-nif (- (pj-l L pj-k-nif) (pj-mf L m pj-mf-if0)))] P2)))

;; the interface entry of module t named s, -1 when none
(defn- pj-if-find [L :vector-i64 P [:list :string] t :i64 s :string] :i64
  (let [e0 (pj-mf L t pj-mf-if0) n (pj-mf L t pj-mf-nif)]
    (loop [k 0]
      (cond (>= k n) -1
            (string=? (pj-p P (pj-if L (+ e0 k) pj-if-name)) s) (+ e0 k)
            :else (recur (+ k 1))))))

;; ---- the trailer ---------------------------------------------------------------------------------------------------------
;; the stub of interface entry e named q; its clause targets are appended to the T table
(defn- pj-stub [L :vector-i64 P [:list :string] e :i64 q :string] :string
  (let [ncl (pj-if L e pj-if-ncl)
        k0 (pj-min (pj-l L pj-k-nstub) (- pj-t-cap pj-if-maxcl))
        w (loop [k 0] (if (>= k ncl) 0 (let [x (pj-ls L (+ pj-t-base k0 k) (pj-if L e (+ pj-if-off0 k)))] (recur (+ k 1)))))
        w2 (pj-ls L pj-k-nstub (+ k0 ncl))]
    (string-concat "(defn- " (string-concat q (string-concat " " (string-concat (pj-subst (pj-p P (pj-if L e pj-if-text)) q) ")\n"))))))

;; the stubs of require edge r, appended to the piece list Q
(defn- pj-stubs-req [L :vector-i64 P [:list :string] Q [:list :string] r :i64] [:list :string]
  (let [t (pj-rf L r pj-rf-mod)
        al (pj-rf L r pj-rf-alias)
        e0 (pj-mf L t pj-mf-if0)
        ne (pj-mf L t pj-mf-nif)
        Q1 (if (< al 0)
             Q
             (loop [k 0 Q Q]
               (if (>= k ne) Q
                 (recur (+ k 1) (pj-padd Q (pj-stub L P (+ e0 k) (string-concat (pj-p P al) (string-concat "/" (pj-p P (pj-if L (+ e0 k) pj-if-name))))))))))
        f0 (pj-rf L r pj-rf-ref0)]
    (loop [k 0 Q Q1]
      (if (>= k (pj-rf L r pj-rf-nref)) Q
        (let [s (pj-p P (pj-l L (+ pj-f-base (* (+ f0 k) pj-f-w))))
              e (pj-if-find L P t s)]
          (recur (+ k 1) (if (< e 0) Q (pj-padd Q (pj-stub L P e s)))))))))

;; the concatenation of Q[a .. b), balanced (each byte is copied log2(b-a) times, not b-a times)
(defn- pj-join [Q [:list :string] a :i64 b :i64] :string
  (cond (>= a b) ""
        (= (+ a 1) b) (pj-p Q a)
        :else (let [m (quot (+ a b) 2)] (string-concat (pj-join Q a m) (pj-join Q m b)))))

;; the trailer of module m: the replacement ns form, then its import stubs
(defn pj-trailer [L :vector-i64 P [:list :string] m :i64] :string
  (let [w (pj-ls L pj-k-nstub 0)
        Q0 (typed-list-new [:list :string])
        ;; the module's own name: a record's identity keyword is :<ns>/<Name> (21-check)
        Qn (pj-padd (pj-padd Q0 "\n(ns ") (pj-p P (pj-mf L m pj-mf-name)))
        Q1 (cond (> m 0) (pj-padd Qn " (:export []))\n")
                 (= (pj-mf L m pj-mf-expk) 0) (pj-padd Qn ")\n")
                 :else (loop [k 0 Q (pj-padd Qn " (:export [")]
                         (if (>= k (pj-mf L m pj-mf-nexp)) (pj-padd Q "]))\n")
                           (recur (+ k 1) (pj-padd (pj-padd Q " ") (pj-p P (pj-l L (+ pj-x-base (pj-mf L m pj-mf-exp0) k))))))))
        r0 (pj-mf L m pj-mf-req0)
        Q2 (loop [k 0 Q Q1]
             (if (>= k (pj-mf L m pj-mf-nreq)) Q (recur (+ k 1) (pj-stubs-req L P Q (+ r0 k)))))]
    (pj-join Q2 0 (count Q2))))

;; ---- per-module checks on the read source (before 20-names) --------------------------------------------------------------
;; the require edge of module m whose alias is a, -1 when none
(defn- pj-req-alias [L :vector-i64 P [:list :string] m :i64 a :string] :i64
  (let [r0 (pj-mf L m pj-mf-req0)]
    (loop [k 0]
      (cond (>= k (pj-mf L m pj-mf-nreq)) -1
            (and (>= (pj-rf L (+ r0 k) pj-rf-alias) 0) (string=? (pj-p P (pj-rf L (+ r0 k) pj-rf-alias)) a)) (+ r0 k)
            :else (recur (+ k 1))))))

;; byte offset of the first '/' in S[a,b) after its first byte, -1 when none
(defn- pj-slash [S :string a :i64 b :i64] :i64
  (loop [i (+ a 1)]
    (cond (>= i (- b 1)) -1
          (= (string-code-point-at S i) 47) i
          :else (recur (+ i 1)))))

;; every symbol token alias/name of the module's own text: alias required, name an export of it
(defn- pj-qscan [M :vector-i64 L :vector-i64 P [:list :string] S :string m :i64] :vector-i64
  (let [trail (pj-l L pj-k-trail)]
    (loop [t 1]
      (if (or (>= t (vector-at M MM-TOK-N)) (not (pj-ok M)) (>= (pj-tf M t TF-START) trail))
        M
        (let [a (pj-tf M t TF-START) b (pj-tf M t TF-END)
              sl (if (= (pj-tf M t TF-KIND) TK-SYM) (pj-slash S a b) -1)]
          (if (< sl 0)
            (recur (+ t 1))
            (let [r (pj-req-alias L P m (string-substring S a sl))]
              (cond (< r 0) (pj-err-span M E-PROJ-UNKNOWN-OP a a b)
                    (< (pj-if-find L P (pj-rf L r pj-rf-mod) (string-substring S (+ sl 1) b)) 0) (pj-err-span M E-PROJ-NOT-EXPORT a a b)
                    :else (recur (+ t 1))))))))))

;; every referred name of module m is an export of its module
(defn- pj-refcheck [M :vector-i64 L :vector-i64 P [:list :string] m :i64] :vector-i64
  (let [r0 (pj-mf L m pj-mf-req0)]
    (loop [k 0]
      (if (or (>= k (pj-mf L m pj-mf-nreq)) (not (pj-ok M)))
        M
        (let [r (+ r0 k)
              bad (loop [j 0]
                    (cond (>= j (pj-rf L r pj-rf-nref)) -1
                          (< (pj-if-find L P (pj-rf L r pj-rf-mod) (pj-p P (pj-l L (+ pj-f-base (* (+ (pj-rf L r pj-rf-ref0) j) pj-f-w))))) 0)
                          (+ pj-f-base (* (+ (pj-rf L r pj-rf-ref0) j) pj-f-w))
                          :else (recur (+ j 1))))]
          (if (< bad 0)
            (recur (+ k 1))
            (pj-err-span M E-PROJ-NOT-EXPORT (pj-l L (+ bad 1)) (pj-l L (+ bad 1)) (pj-l L (+ bad 2)))))))))

;; the trailer's ns form replaces the module's own (the first top-level form)
(defn- pj-splice [M :vector-i64 L :vector-i64] :vector-i64
  (let [root (vector-at M MM-ROOT)
        orig (pj-first M root)
        trail (pj-l L pj-k-trail)
        synth (loop [n orig] (cond (= n 0) 0 (>= (pj-a M n) trail) n :else (recur (pj-next M n))))
        pred (loop [n orig] (cond (= n 0) 0 (= (pj-next M n) synth) n :else (recur (pj-next M n))))
        u1 (pj-next M orig)]
    (cond (= synth 0) (pj-err M E-PROJ-NS 0)
          (= u1 synth) (-> M (pj-nset root NF-FIRST synth) (pj-nset root NF-AUX (- (pj-nf M root NF-AUX) 1)))
          :else (-> M (pj-nset pred NF-NEXT (pj-next M synth)) (pj-nset synth NF-NEXT u1) (pj-nset root NF-FIRST synth)
                    (pj-nset root NF-AUX (- (pj-nf M root NF-AUX) 1))))))

;; ---- compile one module and link it ---------------------------------------------------------------------------------------
(defn- pj-put32 [L :vector-i64 at :i64 w :i64] :vector-i64
  (-> L (pj-ls at (bit-and w 255)) (pj-ls (+ at 1) (bit-and (u64-shift-right w 8) 255))
      (pj-ls (+ at 2) (bit-and (u64-shift-right w 16) 255)) (pj-ls (+ at 3) (bit-and (u64-shift-right w 24) 255))))

;; copy the blob OUT[1 .. n] to the image at base, then patch every stub clause into `b <target>`
(defn- pj-link [M :vector-i64 L :vector-i64] :vector-i64
  (let [n (- (vector-at M MM-OUT-N) 1)
        base (pj-l L pj-k-base)
        w (loop [i 0] (if (>= i n) 0 (let [x (pj-ls L (+ pj-img-base base i) (vector-at M (+ MM-OUT-BASE 1 i)))] (recur (+ i 1)))))
        s0 (pj-l L pj-k-stub0)
        w2 (loop [k 0]
             (if (>= k (pj-l L pj-k-nstub)) 0
               (let [fc (pj-ff M (+ s0 k) FF-CODE)
                     at (+ base (* (- fc 1) 4))
                     d (quot (- (pj-l L (+ pj-t-base k)) at) 4)
                     x (if (> fc 0) (pj-put32 L (+ pj-img-base at) (bit-or 335544320 (bit-and d 67108863))) L)]
                 (recur (+ k 1)))))]
    (let [w3 (pj-ls L pj-k-img (+ base n))] M)))

(defn- pj-c5 [M :vector-i64 L :vector-i64] :vector-i64
  (let [M1 (ly-run (mem-set M (ly-base-slot) (pj-l L pj-k-base)))]
    (if (pj-ok M1) (let [M2 (out-blob M1)] (if (pj-ok M2) (pj-link M2 L) M2)) M1)))
(defn- pj-c4 [M :vector-i64 L :vector-i64 S :string] :vector-i64
  (let [M1 (ck-run M S)]
    (if (pj-ok M1)
      (let [M2 (lw-run M1)] (if (pj-ok M2) (let [M3 (gn-run M2)] (if (pj-ok M3) (pj-c5 M3 L) M3)) M2))
      M1)))
(defn- pj-c3 [M :vector-i64 L :vector-i64 S :string] :vector-i64
  (let [M1 (nm-run M S)]
    (if (pj-ok M1)
      (let [w (pj-ls L pj-k-stub0 (- (vector-at M1 MM-FN-N) (pj-l L pj-k-nstub)))] (pj-c4 M1 L S))
      M1)))

;; compile module m (its source text read from its path) and link it into the image. Returns P (a library adds its
;; interface strings). On return M still holds module m (the entry: its EXP table for the container).
(defn- pj-module [M :vector-i64 L :vector-i64 P [:list :string] m :i64] [:list :string]
  (let [S0 (io-read-file M (pj-p P (pj-mf L m pj-mf-path)))
        T (pj-trailer L P m)
        S (string-concat S0 T)
        base (bit-and (+ (pj-l L pj-k-img) 7) -8)
        w (-> L (pj-ls pj-k-errmod m) (pj-ls pj-k-trail (string-length S0)) (pj-ls pj-k-base base) (pj-mset m pj-mf-base base))
        M1 (pj-read M S)
        M2 (if (pj-ok M1) (pj-refcheck (pj-qscan M1 L P S m) L P m) M1)
        M3 (if (pj-ok M2) (pj-splice M2 L) M2)
        M4 (if (pj-ok M3) (pj-c3 M3 L S) M3)]
    (cond (not (pj-ok M4)) P
          (>= (+ pj-img-base (pj-l L pj-k-img)) pj-l-cap) (let [w2 (pj-err M4 E-PROJ-IMAGE 0)] P)
          (> m 0) (pj-iface M4 L P S m)
          :else P)))

;; ---- the whole project ---------------------------------------------------------------------------------------------------
;; pj-project M L P root -> P : discover from the entry (module 0, path P[root]) and compile every module in order. On
;; success M holds the entry module; the image is L[pj-img-base .. + L[pj-k-img]). A multi-module project needs --unpinned.
(defn pj-project [M :vector-i64 L :vector-i64 P [:list :string] root :i64] [:list :string]
  (let [w (-> L (pj-add-mod (count P) root) (pj-mset 0 pj-mf-depth 1))
        P1 (pj-visit M L (pj-padd P "") 0)]
    (cond (not (pj-ok M)) P1
          (and (> (pj-l L pj-k-nmod) 1) (= (pj-l L pj-k-unpinned) 0)) (let [w2 (pj-err M E-PROJ-UNPINNED 0)] P1)
          :else (loop [k 0 P P1]
                  (if (or (>= k (pj-l L pj-k-nord)) (not (pj-ok M)))
                    P
                    (recur (+ k 1) (pj-module M L P (pj-l L (+ pj-o-base k)))))))))

;; the source path of the module the error of M refers to
(defn pj-err-path [L :vector-i64 P [:list :string]] :string (pj-p P (pj-mf L (pj-l L pj-k-errmod) pj-mf-path)))

;; 1 when a symbol token of S is spelled alias/name
(defn- pj-qualified? [M :vector-i64 S :string] :bool
  (loop [t 1]
    (cond (>= t (vector-at M MM-TOK-N)) false
          (and (= (pj-tf M t TF-KIND) TK-SYM) (>= (pj-slash S (pj-tf M t TF-START) (pj-tf M t TF-END)) 0)) true
          :else (recur (+ t 1)))))

;; 1 when the entry (read into M from S) needs the project route: its ns form has a clause 20-names does not read, or it
;; spells a qualified symbol (refused there by name: E6010 / E6004)
(defn pj-needed [M :vector-i64 S :string] :i64
  (let [ns (pj-first M (vector-at M MM-ROOT))]
    (cond
      (not (pj-head? M S ns "ns")) 0
      (pj-qualified? M S) 1
      :else
      (loop [c (pj-next M (pj-next M (pj-first M ns)))]
        (cond (= c 0) 0
              (and (= (pj-kind M c) ND-LIST) (= (pj-kind M (pj-first M c)) ND-KW) (pj-is M S (pj-first M c) ":export")) (recur (pj-next M c))
              :else 1)))))
