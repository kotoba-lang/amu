;; seed/21-check.kotoba -- the type checker and admission gate of the seed compiler R0 (prefix ck-).
;; Owner: 21-check. Contract: seed/HEADS (types, heads 1..41, :caps, E21nn), seed/MEMORY-MAP (NF-TYPE NF-RES,
;; FF-RTYPE FF-PT0..4 FF-NSLOTS FF-FUEL), seed/SIR (slots, fuel rule). Design section 2.1, module 21.
;;
;; ck-run M S -> M. Runs after nm-run. R1: pass A0 registers the defrecord schemas, pass D DESUGARS every defn
;; (normalized signature, sugar heads 43-63 rewritten in place into core forms, below); then pass A types every
;; signature and def literal (so calls and def references may point forward); pass B checks every defn body; pass E
;; settles the exports (implicit ones, and explicit ones whose result type was inferred). Anything outside Seed-0 is refused with the
;; first E-code found (rule L10); nothing is guessed.
;;
;; Written per node:  NF-TYPE = TY-* of every expression node (0 for recur, which never yields: "bottom");
;;   NF-RES of an ND-LIST = its head code (HD-CALL for a user call), of an expression ND-VEC = HD-VECLIT, of the
;;   head symbol of a list = RES-HEAD*RES-SCALE+hd or RES-FN*RES-SCALE+fn, of a value symbol = RES-LOCAL*.. +slot
;;   or RES-DEF*..+fn, of a binder symbol (param, let, loop name) = RES-LOCAL*..+slot with NF-TYPE its type.
;; Slots: params 1..n, then let/loop names from the next free slot; a slot is reused after its scope ends.
;; Loop names are bound only after ALL inits are checked; a later init that names an earlier binder of the same
;; loop is refused (E2111), so the result does not depend on whether 30-lower assigns them in parallel.
;;
;; Stage-0 shapes (probed 2026-10-02 on build/native-image/amu-native; seed/CONTRACT-REQUESTS.md):
;;   - no and/or/not: conditions are cond chains and i64 flags (nm-eqi, nm-ne from 20-names);
;;   - vector-assoc! only on a parameter handle: every other write goes through nm-put / nm-set-*;
;;   - a let-bound handle is never returned bare in one branch while another branch consumes it. So there are
;;     no "if failed then return" branches on let-bound handles: every writer is harmless once MM-ERR is set
;;     (first error wins, later writes are ignored output), and the walkers stop at their entry test on the
;;     parameter M.
;;
;; Internal packing (at most 5 parameters, rule L7):
;;   fx  = fn * 1024 + next   (the function being checked, the next free slot; next <= 255 by E2120)
;;   ctx = tgt * 2 + tail     (tgt = the binding vector a recur targets: the innermost loop's, or the defn's
;;                             params; tail = 1 when the expression is in tail position of that target)

;; ---------------------------------------------------------------------------------------------------------
;; small helpers
;; ---------------------------------------------------------------------------------------------------------
(defn- ck-poison [] :i64 7)
(defn- ck-max-slots [] :i64 255)

(defn- ck-fx-f [fx :i64] :i64 (quot fx 1024))
(defn- ck-fx-next [fx :i64] :i64 (bit-and fx 1023))
(defn- ck-ty [M :vector-i64] :i64 (vector-at M MM-R0))
;; a writer's result instead of its bare handle (see 20-names nm-put): writes this module's MM-STAT slot
(defn- ck-touch [M :vector-i64] :vector-i64 (vector-assoc! M (+ MM-STAT-BASE 24) 0))

;; type code of a type keyword node (KW-I64..KW-VECTOR-I64 = TY-I64..TY-VEC), 0 when not a signature type
(defn- ck-kw-type [M :vector-i64 n :i64] :i64
  (if (= (nm-kind M n) ND-KW)
    (let [k (nm-head-of M n)]
      (cond (= k KW-I64) TY-I64
            (= k KW-BOOL) TY-BOOL
            (= k KW-STRING) TY-STR
            (= k KW-VECTOR-I64) TY-VEC
            :else 0))
    0))

;; R0 = 0 afterwards: a caller that reads a node index or a type from R0 after an error gets the null record
(defn- ck-err [M :vector-i64 code :i64 node :i64 n :i64] :vector-i64
  (nm-put (nm-err-node (ck-refine-note M code n) code node n) MM-R0 0))

;; NF-TYPE, NF-RES and R0 = ty
(defn- ck-mark [M :vector-i64 n :i64 ty :i64 res :i64] :vector-i64
  (let [M1 (nm-set-nf M n NF-TYPE ty)
        M2 (nm-set-nf M1 n NF-RES res)
        M3 (nm-put M2 MM-CK-LAST 0)]   ; R6C
    (nm-put M3 MM-R0 ty)))

(defn- ck-fuel [M :vector-i64 f :i64] :vector-i64 (nm-set-ff M f FF-FUEL 1))

(defn- ck-use-slot [M :vector-i64 f :i64 slot :i64] :vector-i64
  (if (> slot (nm-ff M f FF-NSLOTS)) (nm-set-ff M f FF-NSLOTS slot) (ck-touch M)))

;; the type two arms share; 0 (bottom, a recur) yields to the other arm. Mismatch -> E2104 at hn.
(defn- ck-unify [M :vector-i64 ta :i64 tb :i64 hn :i64] :vector-i64
  (cond (= ta 0) (nm-put M MM-R0 tb)
        (= tb 0) (nm-put M MM-R0 ta)
        (= ta tb) (nm-put M MM-R0 ta)
        :else (ck-err M E-CHECK-TYPE hn ta)))

;; ---------------------------------------------------------------------------------------------------------
;; R1: type forms and record schemas (seed/HEADS TY-KW TY-REC-BASE HD-DEFRECORD, seed/MEMORY-MAP SF-REC RB-*)
;; ---------------------------------------------------------------------------------------------------------
(defn- ck-r [M :vector-i64] :i64 (vector-at M MM-R0))
(defn- ck-sel [c :i64 a :i64 b :i64] :i64 (if (= c 0) b a))

;; 1 when node t can be a type form: a keyword, or a vector whose first item is a keyword ([:record ..])
(defn- ck-is-tform [M :vector-i64 t :i64] :i64
  (cond (= (nm-kind M t) ND-KW) 1
        (= (nm-kind M t) ND-VEC) (nm-eqi (nm-kind M (nm-first M t)) ND-KW)
        :else 0))

;; 1 when keyword node t is the synthetic result type of an unannotated defn
(defn- ck-is-infer [M :vector-i64 t :i64] :i64
  (if (= (nm-kind M t) ND-KW) (nm-eqi (nm-head-of M t) KW-INFER) 0))

(defn- ck-kwcode-type [k :i64] :i64
  (cond (= k KW-I64) TY-I64
        (= k KW-BOOL) TY-BOOL
        (= k KW-STRING) TY-STR
        (= k KW-VECTOR-I64) TY-VEC
        (= k KW-KEYWORD) TY-KW
        (= k KW-BYTES) TY-BYTES   ; R4B
        (= k KW-DOCUMENT) TY-DOC   ; R6B
        (= k KW-SYMBOL) TY-SYM   ; R6B
        (= k KW-PINFER) TY-I64   ; R6C: an unannotated parameter (refined after pass A by ck-hints-apply)
        (= k KW-F64) TY-F64   ; R6C: an opaque binary64 carrier
        :else 0))

;; the schema block of record type ty (0 for a non-record type)
(defn- ck-blk [M :vector-i64 ty :i64] :i64
  (if (< ty TY-REC-BASE) 0 (nm-sf M (- ty TY-REC-BASE) SF-REC)))
(defn- ck-blk-n [M :vector-i64 blk :i64] :i64 (vector-at M (+ blk RB-N)))
(defn- ck-blk-key [M :vector-i64 blk :i64 i :i64] :i64 (vector-at M (+ (+ blk RB-F0) (* i RB-FW))))
(defn- ck-blk-ty [M :vector-i64 blk :i64 i :i64] :i64 (vector-at M (+ (+ (+ blk RB-F0) (* i RB-FW)) 1)))
(defn- ck-blk-type [M :vector-i64 blk :i64] :i64 (+ TY-REC-BASE (vector-at M (+ blk RB-ID))))

;; field index of keyword symbol ks in block blk, -1 when absent
(defn- ck-field [M :vector-i64 blk :i64 ks :i64] :i64
  (loop [i 0]
    (cond (>= i (ck-blk-n M blk)) -1
          (= (ck-blk-key M blk i) ks) i
          :else (recur (+ i 1)))))

;; 1 when blocks a and b have the same fields (keys and types) in the same order
(defn- ck-blk-same [M :vector-i64 a :i64 b :i64] :i64
  (if (= (ck-blk-n M a) (ck-blk-n M b))
    (loop [i 0]
      (cond (>= i (ck-blk-n M a)) 1
            (nm-ne (ck-blk-key M a i) (ck-blk-key M b i)) 0
            (nm-ne (ck-blk-ty M a i) (ck-blk-ty M b i)) 0
            :else (recur (+ i 1))))
    0))

;; 1 when every child of v is a [:kw T] pair vector
(defn- ck-sch-pairs-ok [M :vector-i64 v :i64] :i64
  (loop [c (nm-first M v)]
    (cond (= c 0) 1
          (nm-ne (nm-kind M c) ND-VEC) 0
          (nm-ne (nm-count M c) 2) 0
          (nm-ne (nm-kind M (nm-first M c)) ND-KW) 0
          :else (recur (nm-next M c)))))

;; 1 when [:record :name [[:f T] ..]] has the right shape (1..32 fields)
(defn- ck-sch-ok [M :vector-i64 n :i64] :i64
  (let [nmk (nm-nth M n 1)
        fv (nm-nth M n 2)]
    (cond (nm-ne (nm-count M n) 3) 0
          (nm-ne (nm-head-of M (nm-first M n)) KW-RECORD) 0
          (nm-ne (nm-kind M nmk) ND-KW) 0
          (nm-ne (nm-kind M fv) ND-VEC) 0
          (< (nm-count M fv) 1) 0
          (> (nm-count M fv) 32) 0
          :else (ck-sch-pairs-ok M fv))))

;; R0 = 1 when the keys of block blk at 0..i-1 do not repeat key ks (0 keys never clash)
(defn- ck-key-fresh [M :vector-i64 blk :i64 i :i64 ks :i64] :i64
  (loop [j 0]
    (cond (= ks 0) 1
          (>= j i) 1
          (= (ck-blk-key M blk j) ks) 0
          :else (recur (+ j 1)))))

;; store field i of block blk: key ks, type ty (E2128 at node at when ty is 0 or the key repeats)
(defn- ck-blk-put [M :vector-i64 blk :i64 i :i64 ks :i64 ty :i64] :vector-i64
  (let [a (+ (+ blk RB-F0) (* i RB-FW))
        M1 (nm-put M a ks)]
    (nm-put M1 (+ a 1) ty)))

;; inline schema fields from pair node c (index i) into block blk
(defn- ck-sch-fields [M :vector-i64 c :i64 blk :i64 i :i64] :vector-i64
  (cond
    (= c 0) (ck-touch M)
    (nm-failed M) (ck-touch M)
    :else
    (let [k (nm-first M c)
          ks (nm-sym-of M k)
          nx (nm-next M c)
          M1 (ck-tform M (nm-next M k))
          ty (ck-r M1)]
      (cond (= ty 0) (ck-err M1 E-CHECK-SCHEMA k 0)
            (= ty TY-F64) (ck-err M1 E-CHECK-SCHEMA k 0)   ; R6C: stage-0 refuses an :f64 record field natively (r1 neg n32)
            (= (ck-key-fresh M1 blk i ks) 0) (ck-err M1 E-CHECK-SCHEMA k 0)
            :else (ck-sch-fields (ck-blk-put M1 blk i ks ty) nx blk (+ i 1))))))

;; a new block of n fields (R0 = its address; mem-alloc reports a full heap itself)
(defn- ck-blk-new [M :vector-i64 n :i64 id :i64] :vector-i64
  (let [M1 (mem-alloc M (+ 2 (* n RB-FW)))
        b (ck-r M1)
        M2 (nm-put M1 (+ b RB-N) n)
        M3 (nm-put M2 (+ b RB-ID) id)]
    (nm-put M3 MM-R0 b)))

;; register / match the inline schema n; R0 = its record type (0 after an error)
(defn- ck-tform-rec [M :vector-i64 n :i64] :vector-i64
  (if (= (ck-sch-ok M n) 0)
    (nm-put (ck-err M E-CHECK-SCHEMA n 0) MM-R0 0)
    (let [nmk (nm-nth M n 1)
          ks (nm-sym-of M nmk)
          fv (nm-nth M n 2)
          M1 (ck-blk-new M (nm-count M fv) ks)
          b (ck-r M1)
          M2 (ck-sch-fields M1 (nm-first M1 fv) b 0)]
      (ck-tform-rec2 M2 nmk ks b))))

(defn- ck-tform-rec2 [M :vector-i64 nmk :i64 ks :i64 b :i64] :vector-i64
  (let [old (nm-sf M ks SF-REC)]
    (cond (nm-failed M) (nm-put M MM-R0 0)
          (= old 0) (nm-put (nm-set-sf M ks SF-REC b) MM-R0 (ck-blk-type M b))
          (= (ck-blk-same M old b) 1) (nm-put M MM-R0 (ck-blk-type M old))
          :else (nm-put (ck-err M E-CHECK-SCHEMA nmk 0) MM-R0 0))))

;; the type of type form t: R0 = TY-* (0 when t is not a type; a malformed schema also records E2128)
;; R3 rung proof (lang/abort-ability.edn): the forms are parsed by aborting functions (ck-tf ..) that throw the malformed
;; node (error type :i64); this try is the only handler, so ck-tform itself does not abort.
(defn- ck-tform [M :vector-i64 t :i64] :vector-i64
  (try (ck-tf M t) (catch :i64 bad (nm-put M MM-R0 0))))
(defn- ck-tf [M :vector-i64 t :i64] :vector-i64
  (cond (= (nm-kind M t) ND-KW) (let [ty (ck-kwcode-type (nm-head-of M t))]
                                  (if (zero? ty) (throw t) (nm-put M MM-R0 ty)))
        (= (ck-is-tform M t) 1) (ck-tf-vec M t)
        :else (throw t)))
;; R3: [:record ..] (R1) or one of the composite forms [:option T] [:list T] [:set T] [:result T E] [:map K V]
(defn- ck-tf-vec [M :vector-i64 t :i64] :vector-i64
  (let [k (nm-head-of M (nm-first M t))]
    (case k
      KW-RECORD (let [M1 (ck-tform-rec M t)] (if (zero? (ck-r M1)) (throw t) M1))
      (KW-OPTION KW-LIST KW-SET KW-RESULT KW-MAP) (ck-tf-comp M t k)
      KW-FN (ck-tf-fn M t)
      KW-REF (ck-tf-ref M t)
      (throw t))))
;; R4B: [:ref :kw] -> the record type registered under :kw; a ref met before its schema is TY-REC-BASE + the keyword symbol
;; (the identity of an inline or :schemas schema); ck-refs-check (before the signatures) refuses a keyword no schema registers (E2179)
(defn- ck-tf-ref [M :vector-i64 t :i64] :vector-i64
  (let [k (nm-nth M t 1)
        ks (nm-sym-of M k)
        b (nm-sf M ks SF-REC)]
    (cond (nm-ne (nm-count M t) 2) (throw t)
          (nm-ne (nm-kind M k) ND-KW) (throw t)
          (pos? b) (nm-put M MM-R0 (ck-blk-type M b))
          :else (nm-put M MM-R0 (+ TY-REC-BASE ks)))))

;; ---- defrecord (registered before desugaring, so (->Name ..) and inline schemas of the same name resolve) ----
;; 1 when S[a1..b1) is a keyword spelling ':' + S[a2..b2)
(defn- ck-kw-spells [S :string a1 :i64 b1 :i64 a2 :i64 b2 :i64] :i64
  (cond (nm-ne (- b1 a1) (+ 1 (- b2 a2))) 0
        (nm-ne (string-code-point-at S a1) 58) 0
        :else (nm-span-eq S (+ a1 1) b1 a2 b2)))

;; the keyword symbol spelled ':' + S[a..b), 0 when the file never spells it
(defn- ck-find-kw [M :vector-i64 S :string a :i64 b :i64] :i64
  (loop [s 1]
    (cond (>= s (vector-at M MM-SYM-N)) 0
          (= (ck-kw-spells S (nm-sf M s SF-START) (nm-sf M s SF-END) a b) 1) s
          :else (recur (+ s 1)))))

;; 1 when S[a..b) spells the byte c1, S[qa..qb), the byte c2, S[ma..mb) (R4B rung proof: 9 parameters, the last two
;; stack-passed; it was a 5-parameter function with the two name nodes packed into one i64 and the spans recomputed per symbol)
(defn- ck-span3-eq [S :string a :i64 b :i64 c1 :i64 qa :i64 qb :i64 c2 :i64 ma :i64 mb :i64] :i64
  (let [q (+ a 1 (- qb qa))]
    (cond (nm-ne (- b a) (+ (- q a) 1 (- mb ma))) 0
          (nm-ne (string-code-point-at S a) c1) 0
          (= (nm-span-eq S (+ a 1) q qa qb) 0) 0
          (nm-ne (string-code-point-at S q) c2) 0
          :else (nm-span-eq S (+ q 1) b ma mb))))

;; the keyword symbol :<ns>/<Name> of record name node m, 0 without an ns form or when never spelled
(defn- ck-find-nskw [M :vector-i64 S :string m :i64] :i64
  (let [ns (vector-at M MM-NS-NODE)
        q (nm-nth M ns 1)]
    (if (= ns 0)
      0
      (let [qa (nm-tf M (nm-nf M q NF-TOK) TF-START)
            qb (nm-tf M (nm-nf M q NF-TOK) TF-END)
            ma (nm-tf M (nm-nf M m NF-TOK) TF-START)
            mb (nm-tf M (nm-nf M m NF-TOK) TF-END)]
        (loop [s 1]
          (cond (>= s (vector-at M MM-SYM-N)) 0
                (= (ck-span3-eq S (nm-sf M s SF-START) (nm-sf M s SF-END) 58 qa qb 47 ma mb) 1) s
                :else (recur (+ s 1))))))))

;; R4B rung proof: a defrecord's field vector as a list of records by reference (the field's name node c and its type
;; form node t, 0 when unannotated = :i64), then typed and stored in order (was: block and index packed as blk*64+i,
;; then with the type as bi*2^21+ty)
(defrecord ck-fld [c :i64 t :i64])
(defn- ck-rec-flds [M :vector-i64 c :i64 acc [:list [:ref :seed.check/ck-fld]]] [:list [:ref :seed.check/ck-fld]]
  (let [t (nm-next M c)]
    (cond (= c 0) acc
          (and (= (nm-kind M c) ND-SYM) (= (ck-is-tform M t) 1)) (ck-rec-flds M (nm-next M t) (conj acc (->ck-fld c t)))
          :else (ck-rec-flds M t (conj acc (->ck-fld c 0))))))
;; type and store fields i.. of fs into block blk (E2128 at a field that is not a symbol, has no type or repeats a key)
(defn- ck-rec-store [M :vector-i64 S :string fs [:list [:ref :seed.check/ck-fld]] blk :i64 i :i64] :vector-i64
  (if (or (>= i (count fs)) (nm-failed M))
    (ck-touch M)
    (let [f (nth fs i)
          c (:c f)
          M1 (cond (nm-ne (nm-kind M c) ND-SYM) M (zero? (:t f)) (nm-put M MM-R0 TY-I64) :else (ck-tform M (:t f)))
          ty (ck-r M1)
          ks (ck-find-kw M1 S (nm-tf M1 (nm-nf M1 c NF-TOK) TF-START) (nm-tf M1 (nm-nf M1 c NF-TOK) TF-END))]
      (cond (nm-ne (nm-kind M1 c) ND-SYM) (ck-err M1 E-CHECK-SCHEMA c 0)
            (nm-failed M1) (ck-touch M1)
            (= ty 0) (ck-err M1 E-CHECK-SCHEMA c 0)
            (= ty TY-F64) (ck-err M1 E-CHECK-SCHEMA c 0)   ; R6C: stage-0 refuses an :f64 record field natively (r1 neg n32)
            (= (ck-key-fresh M1 blk i ks) 0) (ck-err M1 E-CHECK-SCHEMA c 0)
            :else (ck-rec-store (ck-blk-put M1 blk i ks ty) S fs blk (inc i))))))
(defn- ck-rec-fields [M :vector-i64 S :string c :i64 blk :i64 i :i64] :vector-i64
  (ck-rec-store M S (ck-rec-flds M c (typed-list-new [:list [:ref :seed.check/ck-fld]])) blk i))

;; the first symbol of vector v that repeats an earlier symbol of v, else 0
(defn- ck-dup-sym [M :vector-i64 v :i64] :i64
  (loop [c (nm-first M v)]
    (cond (= c 0) 0
          (nm-ne (nm-kind M c) ND-SYM) (recur (nm-next M c))
          (> (ck-sym-later M (nm-sym-of M c) (nm-next M c)) 0) (ck-sym-later M (nm-sym-of M c) (nm-next M c))
          :else (recur (nm-next M c)))))
(defn- ck-sym-later [M :vector-i64 s :i64 c :i64] :i64
  (loop [x c]
    (cond (= x 0) 0
          (= (* (nm-eqi (nm-kind M x) ND-SYM) (nm-eqi (nm-sym-of M x) s)) 1) x
          :else (recur (nm-next M x)))))

;; (defrecord Name [f :T g ..]): the block goes to SF-REC of Name and of the keyword :<ns>/Name when spelled
(defn- ck-defrecord [M :vector-i64 S :string n :i64] :vector-i64
  (let [m (nm-nth M n 1)
        fv (nm-nth M n 2)
        nf (nm-count-syms M fv)
        ms (nm-sym-of M m)]
    (cond (nm-ne (nm-count M n) 3) (ck-err M E-CHECK-SCHEMA n 0)
          (nm-ne (nm-kind M m) ND-SYM) (ck-err M E-CHECK-SCHEMA n 0)
          (nm-ne (nm-kind M fv) ND-VEC) (ck-err M E-CHECK-SCHEMA m 0)
          (< nf 1) (ck-err M E-CHECK-SCHEMA m 0)
          (> nf 32) (ck-err M E-CHECK-SCHEMA m 0)
          (> (nm-sf M ms SF-REC) 0) (ck-err M E-NAMES-DUP m 0)
          (> (ck-dup-sym M fv) 0) (ck-err M E-CHECK-SCHEMA (ck-dup-sym M fv) 0)
          :else
          ;; R4B: every defrecord's block is in SF-REC (of Name and of :<ns>/Name) before any field is typed (ck-recs-fields):
          ;; a field may refer to its own record ([:list [:ref :<ns>/Name]]) or to one defined later in the file
          (let [M1 (ck-blk-new M nf ms)
                b (ck-r M1)
                M2 (nm-set-sf M1 ms SF-REC b)
                k (ck-find-nskw M2 S m)]
            (ck-defrecord-kw M2 k b)))))

;; R4B: the fields of every top-level defrecord form from c (their blocks are registered)
(defn- ck-recs-fields [M :vector-i64 S :string c :i64] :vector-i64
  (cond (= c 0) (ck-schemas M)
        (nm-failed M) (ck-touch M)
        (= (nm-form-head M c) HD-DEFRECORD)
        (let [b (nm-sf M (nm-sym-of M (nm-nth M c 1)) SF-REC)]
          (ck-recs-fields (ck-rec-fields M S (nm-first M (nm-nth M c 2)) b 0) S (nm-next M c)))
        :else (ck-recs-fields M S (nm-next M c))))

(defn- ck-defrecord-kw [M :vector-i64 k :i64 b :i64] :vector-i64
  (cond (= k 0) (ck-touch M)
        (> (nm-sf M k SF-REC) 0) (ck-touch M)
        :else (nm-set-sf M k SF-REC b)))

;; every top-level defrecord form from c (registration; then their fields, then the ns :schemas)
(defn- ck-recs [M :vector-i64 S :string c :i64] :vector-i64
  (cond (= c 0) (ck-recs-fields M S (nm-first M (vector-at M MM-ROOT)))
        (nm-failed M) (ck-touch M)
        (= (nm-form-head M c) HD-DEFRECORD) (ck-recs (ck-defrecord M S c) S (nm-next M c))
        :else (ck-recs M S (nm-next M c))))

;; R4B: the ns clause (:schemas {:kw [:record :kw [[:f T] ..]] ..}) (20-names admits its shape): every value is a schema
;; whose keyword is its key (E2128 otherwise), registered like an inline schema, after the defrecords
(defn- ck-schemas-map [M :vector-i64 ns :i64] :i64
  (let [c2 (nm-nth M ns 2)
        c3 (nm-nth M ns 3)]
    (cond (and (= (nm-kind M c2) ND-LIST) (= (nm-head-of M (nm-first M c2)) KW-SCHEMAS)) (nm-nth M c2 1)
          (and (= (nm-kind M c3) ND-LIST) (= (nm-head-of M (nm-first M c3)) KW-SCHEMAS)) (nm-nth M c3 1)
          :else 0)))
(defn- ck-schemas [M :vector-i64] :vector-i64
  (let [ns (vector-at M MM-NS-NODE)
        mp (if (zero? ns) 0 (ck-schemas-map M ns))]
    (loop [M1 (ck-touch M) k (nm-first M mp)]
      (let [v (nm-next M1 k)]
        (cond (zero? k) M1
              (nm-failed M1) M1
              (nm-ne (nm-kind M1 k) ND-KW) (ck-err M1 E-CHECK-SCHEMA k 0)
              (nm-ne (ck-is-tform M1 v) 1) (ck-err M1 E-CHECK-SCHEMA k 0)
              (nm-ne (nm-head-of M1 (nm-first M1 v)) KW-RECORD) (ck-err M1 E-CHECK-SCHEMA k 0)
              (nm-ne (nm-sym-of M1 (nm-nth M1 v 1)) (nm-sym-of M1 k)) (ck-err M1 E-CHECK-SCHEMA k 0)
              :else (let [M2 (ck-tform-rec M1 v)]
                      (if (zero? (ck-r M2)) (ck-err M2 E-CHECK-SCHEMA k 0) (recur M2 (nm-next M2 v)))))))))

;; R4B: every well-formed inline [:record :kw ..] schema of the file is registered before the signatures (a malformed one
;; is refused where it is typed), so a [:ref :kw] resolves whichever form names its schema first
(defn- ck-inline-scan [M :vector-i64] :vector-i64
  (loop [M1 (ck-touch M) n 1]
    (cond (>= n (vector-at M1 MM-NODE-N)) M1
          (nm-failed M1) M1
          (and (= (nm-kind M1 n) ND-VEC) (= (nm-kind M1 (nm-first M1 n)) ND-KW) (= (nm-head-of M1 (nm-first M1 n)) KW-RECORD)
               (= (ck-sch-ok M1 n) 1))
          (recur (ck-tform-rec M1 n) (inc n))
          :else (recur M1 (inc n)))))

;; R4B (before the signatures): every [:ref :kw] of the file names a registered schema, else E2179 at the keyword
(defn- ck-refs-check [M :vector-i64] :vector-i64
  (loop [M1 (ck-touch M) n 1]
    (let [k (nm-nth M1 n 1)]
      (cond (>= n (vector-at M1 MM-NODE-N)) M1
            (nm-failed M1) M1
            (and (= (nm-kind M1 n) ND-VEC) (= (nm-count M1 n) 2) (= (nm-kind M1 (nm-first M1 n)) ND-KW)
                 (= (nm-head-of M1 (nm-first M1 n)) KW-REF) (= (nm-kind M1 k) ND-KW) (zero? (nm-sf M1 (nm-sym-of M1 k) SF-REC)))
            (ck-err M1 E-CHECK-REF k 0)
            :else (recur M1 (inc n))))))

;; ---------------------------------------------------------------------------------------------------------
;; R1: desugaring (seed/HEADS heads 43-65). Runs after the defrecord registration and before typing. Each sugar
;; form is rewritten IN PLACE into core forms: the form's node keeps its NF-NEXT (so its parent is untouched) and
;; gets new children; new nodes are appended to NODE (seed/CONTRACT-REQUESTS.md, R1 line). Synthetic head and
;; keyword nodes carry the token of the sugar's head symbol, so a later refusal names the sugar ("when", "case").
;; Their symbols are gensyms (20-names nm-gensym) cached per code in a HEAP block at M[89]; fresh locals (the
;; scrutinee of case, the counters of dotimes/doseq) are fresh gensyms that no spelling can name.
;; ---------------------------------------------------------------------------------------------------------
(defn- ck-cache [] :i64 89)

;; symbol with SF-HEAD = code, cached at index idx of the gensym cache
(defn- ck-csym [M :vector-i64 idx :i64 code :i64] :vector-i64
  (let [base (vector-at M (ck-cache))
        s (vector-at M (+ base idx))]
    (if (> s 0)
      (nm-put M MM-R0 s)
      (ck-csym-new (nm-gensym M 0 code) (+ base idx)))))
(defn- ck-csym-new [M :vector-i64 at :i64] :vector-i64
  (let [s (ck-r M)
        M1 (nm-put M at s)]
    (nm-put M1 MM-R0 s)))

;; a new node (first and next 0); R0 = its index
(defn- ck-new [M :vector-i64 kind :i64 tok :i64 aux :i64 sym :i64] :vector-i64
  (let [n (vector-at M MM-NODE-N)]
    (if (< n MM-NODE-CAP)
      (let [M1 (nm-set-nf M n NF-KIND kind)
            M2 (nm-set-nf M1 n NF-FIRST 0)
            M3 (nm-set-nf M2 n NF-NEXT 0)
            M4 (nm-set-nf M3 n NF-TOK tok)
            M5 (nm-set-nf M4 n NF-AUX aux)
            M6 (nm-set-nf M5 n NF-SYM sym)
            M7 (nm-set-nf M6 n NF-TYPE 0)
            M8 (nm-set-nf M7 n NF-RES 0)
            M9 (nm-put M8 MM-NODE-N (+ n 1))]
        (nm-put M9 MM-R0 n))
      (nm-put (ck-err M E-HEAP-REGION 0 4) MM-R0 0))))

(defn- ck-n-head [M :vector-i64 tok :i64 code :i64] :vector-i64
  (let [M1 (ck-csym M code code)
        s (ck-r M1)]
    (ck-new M1 ND-SYM tok 0 s)))
(defn- ck-n-kw [M :vector-i64 tok :i64 kwc :i64] :vector-i64
  (let [M1 (ck-csym M (+ 128 kwc) kwc)
        s (ck-r M1)]
    (ck-new M1 ND-KW tok 0 s)))
(defn- ck-n-int [M :vector-i64 tok :i64 v :i64] :vector-i64 (ck-new M ND-INT tok v 0))
(defn- ck-n-ref [M :vector-i64 tok :i64 s :i64] :vector-i64 (ck-new M ND-SYM tok 0 s))
;; a copy of symbol node x (same symbol and token)
(defn- ck-n-copy [M :vector-i64 x :i64] :vector-i64 (ck-new M ND-SYM (nm-nf M x NF-TOK) 0 (nm-sym-of M x)))
(defn- ck-n-coll [M :vector-i64 kind :i64 tok :i64 first :i64] :vector-i64
  (let [M1 (ck-new M kind tok 0 0)
        n (ck-r M1)
        M2 (nm-set-nf M1 n NF-FIRST first)]
    (nm-put M2 MM-R0 n)))
(defn- ck-n-vec [M :vector-i64 tok :i64 first :i64] :vector-i64 (ck-n-coll M ND-VEC tok first))
(defn- ck-n-list [M :vector-i64 tok :i64 first :i64] :vector-i64 (ck-n-coll M ND-LIST tok first))

;; NF-NEXT a := b (node 0 is never written)
(defn- ck-link [M :vector-i64 a :i64 b :i64] :vector-i64
  (if (= a 0) (ck-touch M) (nm-set-nf M a NF-NEXT b)))
(defn- ck-chain2 [M :vector-i64 a :i64 b :i64] :vector-i64 (ck-link (ck-link M a b) b 0))
(defn- ck-chain3 [M :vector-i64 a :i64 b :i64 c :i64] :vector-i64 (ck-link (ck-link (ck-link M a b) b c) c 0))

;; a new list (code first ..): the head node is followed by the chain that starts at first; R0 = the list
(defn- ck-mkh [M :vector-i64 tok :i64 code :i64 first :i64] :vector-i64
  (let [M1 (ck-n-head M tok code)
        h (ck-r M1)
        M2 (ck-link M1 h first)]
    (ck-n-list M2 tok h)))

;; the token of n's head (the sugar's own symbol)
(defn- ck-htok [M :vector-i64 n :i64] :i64 (nm-nf M (nm-first M n) NF-TOK))

;; list n becomes (code first ..), keeping n's NF-NEXT
(defn- ck-rehead [M :vector-i64 n :i64 code :i64 first :i64] :vector-i64
  (let [tok (ck-htok M n)
        M1 (ck-n-head M tok code)
        h (ck-r M1)
        M2 (ck-link M1 h first)]
    (nm-set-nf M2 n NF-FIRST h)))

;; node n takes over the content of node src (kind, children, token, aux, symbol); n's NF-NEXT stays
(defn- ck-become [M :vector-i64 n :i64 src :i64] :vector-i64
  (let [k (nm-nf M src NF-KIND)
        f (nm-nf M src NF-FIRST)
        tok (nm-nf M src NF-TOK)
        aux (nm-nf M src NF-AUX)
        s (nm-nf M src NF-SYM)
        M1 (nm-set-nf M n NF-KIND k)
        M2 (nm-set-nf M1 n NF-FIRST f)
        M3 (nm-set-nf M2 n NF-TOK tok)
        M4 (nm-set-nf M3 n NF-AUX aux)]
    (nm-set-nf M4 n NF-SYM s)))

;; the last node of the chain from c (c itself when it has no next)
(defn- ck-last [M :vector-i64 c :i64] :i64
  (loop [x c] (if (= (nm-next M x) 0) x (recur (nm-next M x)))))

;; ---- (op x) -> (code x k): inc dec zero? pos? neg? ----
(defn- ck-ds-arith [M :vector-i64 n :i64 code :i64 k :i64] :vector-i64
  (let [h (nm-first M n)
        x (nm-next M h)]
    (if (= (nm-count M n) 2)
      (let [M1 (ck-n-int M (ck-htok M n) k)
            c (ck-r M1)
            M2 (ck-chain2 M1 x c)]
        (ck-rehead M2 n code x))
      (ck-err M E-CHECK-ARITY h 1))))

;; (not= a b) -> (not (= a b))
(defn- ck-ds-noteq [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        a (nm-next M h)
        b (nm-next M a)]
    (if (= (nm-count M n) 3)
      (let [M1 (ck-chain2 M a b)
            M2 (ck-mkh M1 (ck-htok M1 n) HD-EQ a)
            e (ck-r M2)]
        (ck-rehead M2 n HD-NOT e))
      (ck-err M E-CHECK-ARITY h 2))))

;; (if-not c a b) -> (if c b a)
(defn- ck-ds-ifnot [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        c (nm-next M h)
        a (nm-next M c)
        b (nm-next M a)]
    (if (= (nm-count M n) 4)
      (ck-rehead (ck-chain3 M c b a) n HD-IF c)
      (ck-err M E-CHECK-IF h 0))))

;; (when c e ..) -> (if c (do e ..) 0); neg = 1: (when-not c e ..) -> (if c 0 (do e ..))
(defn- ck-ds-when [M :vector-i64 n :i64 neg :i64] :vector-i64
  (let [h (nm-first M n)
        c (nm-next M h)
        e (nm-next M c)
        tok (ck-htok M n)]
    (if (>= (nm-count M n) 3)
      (let [M1 (ck-mkh M tok HD-DO e)
            d (ck-r M1)
            M2 (ck-n-int M1 tok 0)
            z (ck-r M2)
            M3 (ck-chain3 M2 c (ck-sel neg z d) (ck-sel neg d z))]
        (ck-rehead M3 n HD-IF c))
      (ck-err M E-CHECK-ARITY h 2))))

;; (assert c) -> (if c 0 TRAP)
(defn- ck-ds-assert [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        c (nm-next M h)
        tok (ck-htok M n)]
    (if (= (nm-count M n) 2)
      (let [M1 (ck-n-int M tok 0)
            z (ck-r M1)
            M2 (ck-mkh M1 tok HD-TRAP 0)
            tr (ck-r M2)
            M3 (ck-chain3 M2 c z tr)]
        (ck-rehead M3 n HD-IF c))
      (ck-err M E-CHECK-ARITY h 1))))

;; (let|loop [..] e1 e2 ..) -> (let|loop [..] (do e1 e2 ..))
(defn- ck-ds-body [M :vector-i64 n :i64] :vector-i64
  (let [v (nm-next M (nm-first M n))
        e (nm-next M v)
        M1 (ck-mkh M (ck-htok M n) HD-DO e)
        d (ck-r M1)]
    (ck-link M1 v d)))

;; ---- case ----
;; cursor over the constants of a case: c * 2^20 + m (m = the group member, 0 for a single constant)
(defn- ck-kc-clause [M :vector-i64 c :i64] :i64
  (cond (= c 0) 0
        (= (nm-next M c) 0) 0
        (= (nm-kind M c) ND-LIST) (+ (* c 1048576) (nm-first M c))
        :else (* c 1048576)))
(defn- ck-kc-next [M :vector-i64 cur :i64] :i64
  (let [c (quot cur 1048576)
        m (bit-and cur 1048575)]
    (cond (= m 0) (ck-kc-clause M (nm-next M (nm-next M c)))
          (> (nm-next M m) 0) (+ (* c 1048576) (nm-next M m))
          :else (ck-kc-clause M (nm-next M (nm-next M c))))))
(defn- ck-kc-node [cur :i64] :i64
  (let [c (quot cur 1048576)
        m (bit-and cur 1048575)]
    (if (= m 0) c m)))

;; the value class of a case constant: 1 integer (or i64 def), 2 keyword, 0 not a constant
(defn- ck-kc-class [M :vector-i64 k :i64] :i64
  (let [kind (nm-kind M k)
        fi (nm-sf M (nm-sym-of M k) SF-FN)
        lit (nm-nth M (nm-ff M fi FF-NODE) 2)]
    (cond (= kind ND-INT) 1
          (= kind ND-KW) 2
          (nm-ne kind ND-SYM) 0
          (nm-ne (nm-ff M fi FF-KIND) FK-DEF) 0
          (= (nm-kind M lit) ND-INT) 1
          :else 0)))
(defn- ck-kc-value [M :vector-i64 k :i64] :i64
  (let [kind (nm-kind M k)
        fi (nm-sf M (nm-sym-of M k) SF-FN)]
    (cond (= kind ND-INT) (nm-nf M k NF-AUX)
          (= kind ND-KW) (nm-sym-of M k)
          :else (nm-nf M (nm-nth M (nm-ff M fi FF-NODE) 2) NF-AUX))))
(defn- ck-kc-same [M :vector-i64 a :i64 b :i64] :i64
  (if (= (ck-kc-class M a) (ck-kc-class M b)) (nm-eqi (ck-kc-value M a) (ck-kc-value M b)) 0))

;; the first constant node from cursor cur on that is not a constant or repeats an earlier one, else 0
(defn- ck-kc-later [M :vector-i64 k :i64 cur :i64] :i64
  (loop [x cur]
    (cond (= x 0) 0
          (= (ck-kc-same M k (ck-kc-node x)) 1) (ck-kc-node x)
          :else (recur (ck-kc-next M x)))))
(defn- ck-kc-bad [M :vector-i64 cur :i64] :i64
  (loop [x cur]
    (let [k (ck-kc-node x)]
      (cond (= x 0) 0
            (= (ck-kc-class M k) 0) k
            (= k (quot x 1048576)) (recur (ck-kc-next M x))
            :else (recur (ck-kc-next M x))))))
(defn- ck-kc-dup [M :vector-i64 cur :i64] :i64
  (loop [x cur]
    (cond (= x 0) 0
          (> (ck-kc-later M (ck-kc-node x) (ck-kc-next M x)) 0) (ck-kc-later M (ck-kc-node x) (ck-kc-next M x))
          :else (recur (ck-kc-next M x)))))
;; an empty group () is refused too
(defn- ck-kc-empty [M :vector-i64 c :i64] :i64
  (loop [x c]
    (cond (= x 0) 0
          (= (nm-next M x) 0) 0
          (= (* (nm-eqi (nm-kind M x) ND-LIST) (nm-eqi (nm-first M x) 0)) 1) x
          :else (recur (nm-next M (nm-next M x))))))

;; the test of one case clause: (= g k) or, for a group (k1 k2 ..), the group node itself becomes (or (= g k1) ..)
(defn- ck-case-eq [M :vector-i64 k :i64 g :i64 tok :i64] :vector-i64
  (let [M1 (ck-n-ref M tok g)
        r (ck-r M1)
        M2 (ck-chain2 M1 r k)]
    (ck-mkh M2 tok HD-EQ r)))
(defn- ck-case-grp [M :vector-i64 m :i64 g :i64 tok :i64] :vector-i64
  (if (= m 0)
    (nm-put M MM-R0 0)
    (let [nx (nm-next M m)
          M1 (ck-case-eq M m g tok)
          e (ck-r M1)
          M2 (ck-case-grp M1 nx g tok)
          rest (ck-r M2)
          M3 (ck-link M2 e rest)]
      (nm-put M3 MM-R0 e))))
(defn- ck-case-test [M :vector-i64 c :i64 g :i64 tok :i64] :vector-i64
  (if (= (nm-kind M c) ND-LIST)
    (let [M1 (ck-case-grp M (nm-first M c) g tok)
          e (ck-r M1)
          M2 (ck-rehead M1 c HD-OR e)]
      (nm-put M2 MM-R0 c))
    (ck-case-eq M c g tok)))

;; the trailing ":else d" (d = the default node, or a synthetic TRAP when dflt is 0); R0 = the :else node
(defn- ck-case-else [M :vector-i64 dflt :i64 tok :i64] :vector-i64
  (let [M1 (ck-n-kw M tok KW-ELSE)
        k (ck-r M1)
        M2 (ck-mkh M1 tok HD-TRAP 0)
        tr (ck-r M2)
        M3 (ck-chain2 M2 k (ck-sel dflt dflt tr))]
    (nm-put M3 MM-R0 k)))

;; cond clauses from case clause c; mode = g * 2 + (1 for condp, whose tests are (pred k g) with p the pred node)
(defn- ck-case-cl [M :vector-i64 c :i64 mode :i64 p :i64 tok :i64] :vector-i64
  (cond (= c 0) (ck-case-else M 0 tok)
        (= (nm-next M c) 0) (ck-case-else M c tok)
        :else
        (let [r (nm-next M c)
              nx (nm-next M r)
              M1 (ck-clause-test M c mode p tok)
              t (ck-r M1)
              M2 (ck-case-cl M1 nx mode p tok)
              rest (ck-r M2)
              M3 (ck-chain2 M2 t r)
              M4 (ck-link M3 r rest)]
          (nm-put M4 MM-R0 t))))
(defn- ck-clause-test [M :vector-i64 c :i64 mode :i64 p :i64 tok :i64] :vector-i64
  (if (= (bit-and mode 1) 1)
    (ck-condp-test M c (quot mode 2) p)
    (ck-case-test M c (quot mode 2) tok)))
;; condp: (pred k g)
(defn- ck-condp-test [M :vector-i64 k :i64 g :i64 p :i64] :vector-i64
  (let [M1 (ck-n-copy M p)
        pc (ck-r M1)
        M2 (ck-n-ref M1 (nm-nf M1 p NF-TOK) g)
        r (ck-r M2)
        M3 (ck-chain3 M2 pc k r)]
    (ck-n-list M3 (nm-nf M3 p NF-TOK) pc)))

;; n becomes (let [g e] (cond clauses..)), clauses from c1; mode as in ck-case-cl without g
(defn- ck-case-build [M :vector-i64 n :i64 e :i64 c1 :i64 mp :i64] :vector-i64
  (let [tok (ck-htok M n)
        M1 (nm-gensym M (nm-tf M tok TF-START) 0)
        g (ck-r M1)
        M2 (ck-case-cl M1 c1 (+ (* g 2) (bit-and mp 1)) (quot mp 2) tok)
        ch (ck-r M2)
        M3 (ck-mkh M2 tok HD-COND ch)
        cn (ck-r M3)
        M4 (ck-n-ref M3 tok g)
        b (ck-r M4)
        M5 (ck-chain2 M4 b e)
        M6 (ck-n-vec M5 tok b)
        v (ck-r M6)
        M7 (ck-chain2 M6 v cn)]
    (ck-rehead M7 n HD-LET v)))

(defn- ck-ds-case [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        e (nm-next M h)
        c1 (nm-next M e)
        cur (ck-kc-clause M c1)]
    (cond (= e 0) (ck-err M E-CHECK-ARITY h 1)
          (> (ck-kc-empty M c1) 0) (ck-err M E-CHECK-HEAD (ck-kc-empty M c1) 0)
          (> (ck-kc-bad M cur) 0) (ck-err M E-CHECK-HEAD (ck-kc-bad M cur) 0)
          (> (ck-kc-dup M cur) 0) (ck-err M E-CHECK-CASE-DUP (ck-kc-dup M cur) 0)
          :else (ck-case-build M n e c1 0))))

;; (condp pred e c1 r1 .. [d]) pred a symbol
(defn- ck-ds-condp [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        p (nm-next M h)
        e (nm-next M p)
        c1 (nm-next M e)]
    (cond (< (nm-count M n) 3) (ck-err M E-CHECK-ARITY h 2)
          (nm-ne (nm-kind M p) ND-SYM) (ck-err M E-CHECK-HEAD p 0)
          :else (ck-case-build M n e c1 (+ (* p 2) 1)))))

;; ---- -> and ->> (lst = 1 for ->>) ----
;; one step s applied to acc; R0 = the new acc
(defn- ck-thr-list [M :vector-i64 acc :i64 s :i64 lst :i64] :vector-i64
  (let [h (nm-first M s)
        rest (nm-next M h)]
    (cond (= lst 0) (nm-put (ck-link (ck-link (ck-link M h acc) acc rest) s 0) MM-R0 s)
          (= rest 0) (nm-put (ck-link (ck-chain2 M h acc) s 0) MM-R0 s)
          :else (nm-put (ck-link (ck-chain2 (ck-link M h rest) (ck-last M rest) acc) s 0) MM-R0 s))))
(defn- ck-thr-step [M :vector-i64 acc :i64 s :i64 lst :i64 tok :i64] :vector-i64
  (let [k (nm-kind M s)]
    (cond (= k ND-LIST) (if (= (nm-first M s) 0) (ck-err M E-CHECK-HEAD s 0) (ck-thr-list M acc s lst))
          (= k ND-SYM) (ck-n-list (ck-chain2 M s acc) tok s)
          (= k ND-KW) (ck-n-list (ck-chain2 M s acc) tok s)
          :else (ck-err M E-CHECK-HEAD s 0))))
;; steps from s; lt = lst + 2 * tok
(defn- ck-thr-steps [M :vector-i64 acc :i64 s :i64 lt :i64] :vector-i64
  (cond (= s 0) (nm-put M MM-R0 acc)
        (nm-failed M) (nm-put M MM-R0 acc)
        :else
        (let [nx (nm-next M s)
              M1 (ck-thr-step M acc s (bit-and lt 1) (quot lt 2))
              a2 (ck-r M1)]
          (ck-thr-steps M1 a2 nx lt))))
(defn- ck-ds-thread [M :vector-i64 n :i64 lst :i64] :vector-i64
  (let [h (nm-first M n)
        x (nm-next M h)
        s1 (nm-next M x)]
    (if (= x 0)
      (ck-err M E-CHECK-ARITY h 1)
      (let [M1 (ck-link M x 0)
            M2 (ck-thr-steps M1 x s1 (+ lst (* 2 (ck-htok M1 n))))
            acc (ck-r M2)]
        (if (nm-failed M2) (ck-touch M2) (ck-become M2 n acc))))))

;; ---- (as-> x nm f1 ..) -> (let [nm x] (let [nm f1] .. nm)) ----
(defn- ck-let1 [M :vector-i64 b :i64 init :i64 body :i64 tok :i64] :vector-i64
  (let [M1 (ck-chain2 M b init)
        M2 (ck-n-vec M1 tok b)
        v (ck-r M2)
        M3 (ck-chain2 M2 v body)]
    (ck-mkh M3 tok HD-LET v)))
(defn- ck-as-rest [M :vector-i64 f :i64 nm :i64 tok :i64] :vector-i64
  (if (= f 0)
    (ck-n-copy M nm)
    (let [nx (nm-next M f)
          M1 (ck-as-rest M nx nm tok)
          inner (ck-r M1)
          M2 (ck-n-copy M1 nm)
          b (ck-r M2)]
      (ck-let1 M2 b f inner tok))))
(defn- ck-ds-as [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        x (nm-next M h)
        nm (nm-next M x)
        f1 (nm-next M nm)
        tok (ck-htok M n)]
    (cond (< (nm-count M n) 3) (ck-err M E-CHECK-ARITY h 2)
          (nm-ne (nm-kind M nm) ND-SYM) (ck-err M E-CHECK-BINDINGS nm 0)
          :else
          (let [M1 (ck-as-rest M f1 nm tok)
                inner (ck-r M1)
                M2 (ck-let1 M1 nm x inner tok)
                l (ck-r M2)]
            (ck-become M2 n l)))))

;; ---- (cond-> x t1 f1 ..) -> (let [g x] (let [g (if t1 (-> g f1) g)] .. g)); lst = 1 for cond->> ----
(defn- ck-thr-code [lst :i64] :i64 (if (= lst 1) HD-THREAD-LAST HD-THREAD-FIRST))
(defn- ck-ct-rest [M :vector-i64 t :i64 g :i64 tok :i64 lst :i64] :vector-i64
  (if (= t 0)
    (ck-n-ref M tok g)
    (let [f (nm-next M t)
          nx (nm-next M f)
          M1 (ck-ct-rest M nx g tok lst)
          inner (ck-r M1)
          M2 (ck-n-ref M1 tok g)
          r1 (ck-r M2)
          M3 (ck-chain2 M2 r1 f)
          M4 (ck-mkh M3 tok (ck-thr-code lst) r1)
          th (ck-r M4)
          M5 (ck-n-ref M4 tok g)
          r2 (ck-r M5)
          M6 (ck-chain3 M5 t th r2)
          M7 (ck-mkh M6 tok HD-IF t)
          iff (ck-r M7)
          M8 (ck-n-ref M7 tok g)
          b (ck-r M8)]
      (ck-let1 M8 b iff inner tok))))
(defn- ck-ds-condthr [M :vector-i64 n :i64 lst :i64] :vector-i64
  (let [h (nm-first M n)
        x (nm-next M h)
        t1 (nm-next M x)
        tok (ck-htok M n)]
    (cond (< (nm-count M n) 2) (ck-err M E-CHECK-ARITY h 1)
          (= (bit-and (nm-count M n) 1) 1) (ck-err M E-CHECK-ARITY h 2)
          :else
          (let [M1 (nm-gensym M (nm-tf M tok TF-START) 0)
                g (ck-r M1)
                M2 (ck-ct-rest M1 t1 g tok lst)
                inner (ck-r M2)
                M3 (ck-n-ref M2 tok g)
                b (ck-r M3)
                M4 (ck-let1 M3 b x inner tok)
                l (ck-r M4)]
            (ck-become M4 n l)))))

;; ---- loops ----
;; (recur (+ v 1)) for the symbol v
(defn- ck-mk-next [M :vector-i64 v :i64 tok :i64] :vector-i64
  (let [M1 (ck-n-ref M tok v)
        r (ck-r M1)
        M2 (ck-n-int M1 tok 1)
        one (ck-r M2)
        M3 (ck-chain2 M2 r one)
        M4 (ck-mkh M3 tok HD-ADD r)
        p (ck-r M4)]
    (ck-mkh M4 tok HD-RECUR p)))
;; (< v w) for the symbols v w
(defn- ck-mk-lt [M :vector-i64 v :i64 w :i64 tok :i64] :vector-i64
  (let [M1 (ck-n-ref M tok v)
        a (ck-r M1)
        M2 (ck-n-ref M1 tok w)
        b (ck-r M2)
        M3 (ck-chain2 M2 a b)]
    (ck-mkh M3 tok HD-LT a)))
;; (loop [x lo] (if (< x hi) body 0)): x = the binder node (its symbol is the counter), hi a symbol
(defn- ck-mk-count-loop [M :vector-i64 x :i64 lo :i64 hi :i64 body :i64] :vector-i64
  (let [tok (nm-nf M x NF-TOK)
        M1 (ck-mk-lt M (nm-sym-of M x) hi tok)
        test (ck-r M1)
        M2 (ck-n-int M1 tok 0)
        z (ck-r M2)
        M3 (ck-chain3 M2 test body z)
        M4 (ck-mkh M3 tok HD-IF test)
        iff (ck-r M4)
        M5 (ck-chain2 M4 x lo)
        M6 (ck-n-vec M5 tok x)
        v (ck-r M6)
        M7 (ck-chain2 M6 v iff)]
    (ck-mkh M7 tok HD-LOOP v)))

;; (dotimes [i n] e ..) -> (let [g n] (loop [i 0] (if (< i g) (do e .. (recur (+ i 1))) 0)))
(defn- ck-ds-dotimes [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        bv (nm-next M h)
        i (nm-first M bv)
        cnt (nm-next M i)
        e (nm-next M bv)
        tok (ck-htok M n)]
    (cond (nm-ne (nm-kind M bv) ND-VEC) (ck-err M E-CHECK-BINDINGS h 0)
          (nm-ne (nm-count M bv) 2) (ck-err M E-CHECK-BINDINGS h 0)
          (nm-ne (nm-kind M i) ND-SYM) (ck-err M E-CHECK-BINDINGS h 0)
          :else
          (let [M1 (ck-mk-next M (nm-sym-of M i) tok)
                rc (ck-r M1)
                M2 (ck-dotimes-do M1 e rc tok)
                d (ck-r M2)
                M3 (nm-gensym M2 (nm-tf M2 tok TF-START) 0)
                g (ck-r M3)
                M4 (ck-n-int M3 tok 0)
                z (ck-r M4)
                M5 (ck-mk-count-loop M4 i z g d)
                lp (ck-r M5)
                M6 (ck-n-ref M5 tok g)
                b (ck-r M6)
                M7 (ck-let1 M6 b cnt lp tok)
                l (ck-r M7)]
            (ck-become M7 n l)))))
;; (do e .. rc): the body chain e.. (maybe empty) followed by rc
(defn- ck-dotimes-do [M :vector-i64 e :i64 rc :i64 tok :i64] :vector-i64
  (if (= e 0)
    (ck-mkh M tok HD-DO rc)
    (ck-mkh (ck-chain2 M (ck-last M e) rc) tok HD-DO e)))

;; doseq: the per-item expression of the modifiers from m (v = the loop's counter symbol, for the recur)
(defn- ck-seq-mods [M :vector-i64 m :i64 body :i64 v :i64 tok :i64] :vector-i64
  (let [k (nm-kind M m)
        code (nm-head-of M m)
        arg (nm-next M m)
        rest (nm-next M arg)]
    (cond (= m 0) (ck-seq-mods-end M m body v tok)
          (= k ND-SYM) (ck-seq-mods-end M m body v tok)
          (nm-ne k ND-KW) (ck-err M E-CHECK-BINDINGS m 0)
          (= arg 0) (ck-err M E-CHECK-BINDINGS m 0)
          (= code KW-LET)
          (if (= (nm-kind M arg) ND-VEC)
            (let [M1 (ck-seq-mods M rest body v tok)
                  inner (ck-r M1)
                  M2 (ck-chain2 M1 arg inner)]
              (ck-mkh M2 tok HD-LET arg))
            (ck-err M E-CHECK-BINDINGS m 0))
          (= code KW-WHEN)
          (let [M1 (ck-seq-mods M rest body v tok)
                inner (ck-r M1)
                M2 (ck-mk-next M1 v tok)
                nx (ck-r M2)
                M3 (ck-chain3 M2 arg inner nx)]
            (ck-mkh M3 tok HD-IF arg))
          (= code KW-WHILE)
          (let [M1 (ck-seq-mods M rest body v tok)
                inner (ck-r M1)
                M2 (ck-n-int M1 tok 0)
                z (ck-r M2)
                M3 (ck-chain3 M2 arg inner z)]
            (ck-mkh M3 tok HD-IF arg))
          :else (ck-err M E-CHECK-BINDINGS m 0))))
;; the bindings from m (or the body), then the recur: (do inner (recur (+ v 1)))
(defn- ck-seq-mods-end [M :vector-i64 m :i64 body :i64 v :i64 tok :i64] :vector-i64
  (let [M1 (ck-seq M m body tok)
        inner (ck-r M1)
        M2 (ck-mk-next M1 v tok)
        nx (ck-r M2)
        M3 (ck-chain2 M2 inner nx)]
    (ck-mkh M3 tok HD-DO inner)))

;; 1 when node c is (range ..) with 1 or 2 arguments
(defn- ck-is-range [M :vector-i64 c :i64] :i64
  (cond (nm-ne (nm-kind M c) ND-LIST) 0
        (nm-ne (nm-kind M (nm-first M c)) ND-SYM) 0
        (nm-ne (nm-head-of M (nm-first M c)) HD-RANGE) 0
        (> (nm-sf M (nm-sym-of M (nm-first M c)) SF-FN) 0) 0
        (< (nm-count M c) 2) 0
        (> (nm-count M c) 3) 0
        :else 1))

;; the expression for the binding spec from s, body chain body: R0 = the node
(defn- ck-seq [M :vector-i64 s :i64 body :i64 tok :i64] :vector-i64
  (let [c (nm-next M s)]
    (cond (= s 0) (ck-seq-body M body tok)
          (nm-ne (nm-kind M s) ND-SYM) (ck-err M E-CHECK-BINDINGS s 0)
          (= c 0) (ck-err M E-CHECK-BINDINGS s 0)
          (= (ck-is-range M c) 1) (ck-seq-range M s body tok)
          :else (ck-seq-vec M s body tok))))
(defn- ck-seq-body [M :vector-i64 body :i64 tok :i64] :vector-i64
  (if (= body 0) (ck-n-int M tok 0) (ck-mkh M tok HD-DO body)))

;; (let [gb hi] (loop [gi lo] (if (< gi gb) (let [x gi] MODS) 0))) -- a fresh counter, so a :let that rebinds x
;; does not change the iteration
(defn- ck-seq-range [M :vector-i64 s :i64 body :i64 tok :i64] :vector-i64
  (let [c (nm-next M s)
        m (nm-next M c)
        a1 (nm-next M (nm-first M c))
        a2 (nm-next M a1)
        M1 (nm-gensym M (nm-tf M tok TF-START) 0)
        gi (ck-r M1)
        M2 (ck-seq-mods M1 m body gi tok)
        p (ck-r M2)
        M3 (ck-n-ref M2 tok gi)
        ri (ck-r M3)
        M4 (ck-let1 M3 s ri p tok)
        lx (ck-r M4)]
    (ck-seq-range2 M4 gi a1 a2 lx tok)))
(defn- ck-seq-range2 [M :vector-i64 gi :i64 a1 :i64 a2 :i64 lx :i64 tok :i64] :vector-i64
  (let [M1 (ck-link M a1 0)
        M2 (ck-n-int M1 tok 0)
        z (ck-r M2)
        lo (ck-sel a2 a1 z)
        hi (ck-sel a2 a2 a1)
        M3 (nm-gensym M2 (nm-tf M2 tok TF-START) 0)
        gb (ck-r M3)
        M4 (ck-n-ref M3 tok gi)
        bi (ck-r M4)
        M5 (ck-mk-count-loop M4 bi lo gb lx)
        lp (ck-r M5)
        M6 (ck-n-ref M5 tok gb)
        b (ck-r M6)]
    (ck-let1 M6 b hi lp tok)))

;; (let [gv coll gn (vector-count gv)] (loop [gi 0] (if (< gi gn) (let [x (vector-at gv gi)] MODS) 0)))
(defn- ck-seq-vec [M :vector-i64 s :i64 body :i64 tok :i64] :vector-i64
  (let [c (nm-next M s)
        m (nm-next M c)
        M1 (nm-gensym M (nm-tf M tok TF-START) 0)
        gi (ck-r M1)
        M2 (ck-seq-mods M1 m body gi tok)
        p (ck-r M2)
        M3 (nm-gensym M2 (nm-tf M2 tok TF-START) 0)
        gv (ck-r M3)
        M4 (ck-mk-vat M3 gv gi tok)
        va (ck-r M4)
        M5 (ck-let1 M4 s va p tok)
        lx (ck-r M5)]
    (ck-seq-vec2 M5 c gv gi lx)))
(defn- ck-seq-vec2 [M :vector-i64 c :i64 gv :i64 gi :i64 lx :i64] :vector-i64
  (let [tok (nm-nf M c NF-TOK)
        M1 (nm-gensym M (nm-tf M tok TF-START) 0)
        gn (ck-r M1)
        M2 (ck-n-ref M1 tok gi)
        bi (ck-r M2)
        M3 (ck-n-int M2 tok 0)
        z (ck-r M3)
        M4 (ck-mk-count-loop M3 bi z gn lx)
        lp (ck-r M4)
        M5 (ck-n-ref M4 tok gv)
        cv (ck-r M5)
        M6 (ck-mkh M5 tok HD-VECTOR-COUNT cv)
        vc (ck-r M6)
        M7 (ck-n-ref M6 tok gn)
        bn (ck-r M7)
        M8 (ck-let1 M7 bn vc lp tok)
        inner (ck-r M8)
        M9 (ck-n-ref M8 tok gv)
        bv (ck-r M9)]
    (ck-let1 M9 bv c inner tok)))
;; (vector-at gv gi)
(defn- ck-mk-vat [M :vector-i64 gv :i64 gi :i64 tok :i64] :vector-i64
  (let [M1 (ck-n-ref M tok gv)
        a (ck-r M1)
        M2 (ck-n-ref M1 tok gi)
        b (ck-r M2)
        M3 (ck-chain2 M2 a b)]
    (ck-mkh M3 tok HD-VECTOR-AT a)))

(defn- ck-ds-doseq [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        bv (nm-next M h)
        e (nm-next M bv)
        tok (ck-htok M n)]
    (cond (nm-ne (nm-kind M bv) ND-VEC) (ck-err M E-CHECK-BINDINGS h 0)
          (< (nm-count M bv) 2) (ck-err M E-CHECK-BINDINGS h 0)
          :else
          (let [M1 (ck-seq M (nm-first M bv) e tok)
                l (ck-r M1)]
            (ck-become M1 n l)))))

;; ---- (->Name e ..): the head symbol becomes a gensym with SF-HEAD = HD-RECORD-CTOR and SF-REC = Name's block ----
;; (map->Name {:f e ..}) becomes (->Name e ..) with the values in field order (exactly the record's fields).
;; the record block named by S[a..b) when it starts with the k-byte prefix p (packed little-endian), else 0
(defn- ck-prefix-blk [M :vector-i64 S :string a :i64 b :i64 k :i64 p :i64] :i64
  (do
    (cond (<= (- b a) k) 0
          (nm-ne (nm-pack S a (+ a k) 0) p) 0
          :else (nm-sf M (nm-lookup M S (+ a k) b) SF-REC))))
;; "map->" packed little-endian (5 bytes)
(defn- ck-mapctor-word [] :i64 267050312045)
(defn- ck-mapctor-blk [M :vector-i64 S :string h :i64] :i64
  (let [s (nm-sym-of M h)]
    (cond (nm-ne (nm-kind M h) ND-SYM) 0
          (> (nm-sf M s SF-HEAD) 0) 0
          (> (nm-sf M s SF-FN) 0) 0
          :else (ck-prefix-blk M S (nm-sf M s SF-START) (nm-sf M s SF-END) 5 (ck-mapctor-word)))))
;; the value node of key keyword symbol ks in map node mp, 0 when absent
(defn- ck-map-val [M :vector-i64 mp :i64 ks :i64] :i64
  (loop [k (nm-first M mp)]
    (cond (= k 0) 0
          (= ks 0) 0
          (= (* (nm-eqi (nm-kind M k) ND-KW) (nm-eqi (nm-sym-of M k) ks)) 1) (nm-next M k)
          :else (recur (nm-next M (nm-next M k))))))
;; the values of fields i.. of blk, chained in field order; R0 = the first
(defn- ck-mc-vals [M :vector-i64 mp :i64 blk :i64 i :i64] :vector-i64
  (let [v (ck-map-val M mp (ck-blk-key M blk i))]
    (cond (>= i (ck-blk-n M blk)) (nm-put M MM-R0 0)
          (= v 0) (ck-err M E-CHECK-FIELD mp 0)
          :else
          (let [M1 (ck-mc-vals M mp blk (+ i 1))
                rest (ck-r M1)
                M2 (ck-link M1 v rest)]
            (nm-put M2 MM-R0 v)))))
(defn- ck-ds-mapctor [M :vector-i64 n :i64 blk :i64] :vector-i64
  (let [h (nm-first M n)
        mp (nm-next M h)]
    (cond (nm-ne (nm-count M n) 2) (ck-err M E-CHECK-ARITY h 1)
          (nm-ne (nm-kind M mp) ND-MAP) (ck-err M E-CHECK-HEAD h 0)
          (nm-ne (nm-count M mp) (* 2 (ck-blk-n M blk))) (ck-err M E-CHECK-FIELD mp 0)
          :else
          (let [M1 (ck-mc-vals M mp blk 0)
                v0 (ck-r M1)
                M2 (nm-gensym M1 0 HD-RECORD-CTOR)
                g (ck-r M2)
                M3 (nm-set-sf M2 g SF-REC blk)
                M4 (nm-set-nf M3 h NF-SYM g)]
            (if (nm-failed M4) (ck-touch M4) (ck-link M4 h v0))))))

(defn- ck-ctor-blk [M :vector-i64 S :string h :i64] :i64
  (let [s (nm-sym-of M h)
        a (nm-sf M s SF-START)
        b (nm-sf M s SF-END)]
    (cond (nm-ne (nm-kind M h) ND-SYM) 0
          (> (nm-sf M s SF-HEAD) 0) 0
          (> (nm-sf M s SF-FN) 0) 0
          (< (- b a) 3) 0
          (nm-ne (string-code-point-at S a) 45) 0
          (nm-ne (string-code-point-at S (+ a 1)) 62) 0
          :else (nm-sf M (nm-lookup M S (+ a 2) b) SF-REC))))
(defn- ck-ds-ctor [M :vector-i64 S :string n :i64] :vector-i64
  (let [h (nm-first M n)
        blk (ck-ctor-blk M S h)
        mblk (ck-mapctor-blk M S h)]
    (cond
      (> mblk 0) (ck-ds-mapctor M n mblk)
      (= blk 0) (ck-touch M)
      :else
      (let [M1 (nm-gensym M 0 HD-RECORD-CTOR)
            g (ck-r M1)
            M2 (nm-set-sf M1 g SF-REC blk)]
        (nm-set-nf M2 h NF-SYM g)))))

;; ---- the walk ----
;; the sugar code of list n (0 = not sugar): an R1 head that no definition shadows, or a let/loop with several
;; body forms
(defn- ck-ds-hd [M :vector-i64 n :i64] :i64
  (let [h (nm-first M n)
        s (nm-sym-of M h)
        hd (nm-sf M s SF-HEAD)]
    (cond (nm-ne (nm-kind M n) ND-LIST) 0
          (nm-ne (nm-kind M h) ND-SYM) 0
          (> (nm-sf M s SF-FN) 0) 0
          (= hd HD-LET) (ck-sel (nm-eqi (ck-gt3 (nm-count M n)) 1) HD-LET 0)
          (= hd HD-LOOP) (ck-sel (nm-eqi (ck-gt3 (nm-count M n)) 1) HD-LOOP 0)
          (= hd HD-SWAP) HD-SWAP   ; R5B: (swap! a f x ..) -> (reset! a (f (deref a) x ..))
          (= hd HD-HANDLE) (if (ck-r5b-handle-catch? M n) HD-HANDLE 0)   ; R5B: (handle b (catch ..)) -> (try b (catch ..))
          (and (= hd HD-SUB) (= (nm-count M n) 2)) HD-SUB   ; R6C: (- x) -> (- 0 x)
          (< hd HD-WHEN) 0
          (> hd HD-ASSERT) 0
          (= hd HD-RANGE) 0
          :else hd)))
(defn- ck-gt3 [k :i64] :i64 (if (> k 3) 1 0))

(defn- ck-ds-one [M :vector-i64 n :i64 hd :i64] :vector-i64
  (cond (= hd HD-LET) (ck-ds-body M n)
        (= hd HD-LOOP) (ck-ds-body M n)
        (= hd HD-WHEN) (ck-ds-when M n 0)
        (= hd HD-WHEN-NOT) (ck-ds-when M n 1)
        (= hd HD-IF-NOT) (ck-ds-ifnot M n)
        (= hd HD-CASE) (ck-ds-case M n)
        (= hd HD-CONDP) (ck-ds-condp M n)
        (= hd HD-THREAD-FIRST) (ck-ds-thread M n 0)
        (= hd HD-THREAD-LAST) (ck-ds-thread M n 1)
        (= hd HD-AS-THREAD) (ck-ds-as M n)
        (= hd HD-COND-THREAD) (ck-ds-condthr M n 0)
        (= hd HD-COND-THREAD-LAST) (ck-ds-condthr M n 1)
        (= hd HD-DOTIMES) (ck-ds-dotimes M n)
        (= hd HD-DOSEQ) (ck-ds-doseq M n)
        (= hd HD-INC) (ck-ds-arith M n HD-ADD 1)
        (= hd HD-DEC) (ck-ds-arith M n HD-SUB 1)
        (= hd HD-ZERO) (ck-ds-arith M n HD-EQ 0)
        (= hd HD-POS) (ck-ds-arith M n HD-GT 0)
        (= hd HD-NEG) (ck-ds-arith M n HD-LT 0)
        (= hd HD-NOT-EQ) (ck-ds-noteq M n)
        (= hd HD-ASSERT) (ck-ds-assert M n)
        (= hd HD-SWAP) (ck-r5b-ds-swap M n)
        (= hd HD-HANDLE) (ck-rehead M n HD-TRY (nm-next M (nm-first M n)))
        (= hd HD-SUB) (ck-r6c-neg M n)   ; R6C
        :else (ck-err M E-CHECK-HEAD (nm-first M n) 0)))
;; R6C: (- x) -> (- 0 x), the reference's negation (wraps: (- MIN) = MIN)
(defn- ck-r6c-neg [M :vector-i64 n :i64] :vector-i64
  (let [x (nm-next M (nm-first M n))
        M1 (ck-n-int M (ck-htok M n) 0)
        c (ck-r M1)
        M2 (ck-chain2 M1 c x)]
    (ck-rehead M2 n HD-SUB c)))

;; rewrite n until it is no sugar, then walk its children
(defn- ck-ds-walk [M :vector-i64 S :string n :i64] :vector-i64
  (let [k (nm-kind M n)
        hd (ck-ds-hd M n)]
    (cond (= n 0) (ck-touch M)
          (nm-failed M) (ck-touch M)
          (> hd 0) (ck-ds-walk (ck-ds-one M n hd) S n)
          (pos? (ck-r6b-ds-code M n)) (ck-ds-walk (ck-r6b-ds M S n) S n)   ; R6B
          (ck-fn-form? M n) (ck-ds-list (ck-ds-fn M n) S n)
          (= k ND-LIST) (ck-ds-list (ck-ds-ctor M S n) S n)
          (= k ND-VEC) (ck-ds-kids M S (nm-first M n))
          (= k ND-MAP) (ck-ds-kids M S (nm-first M n))
          (= k ND-SET) (ck-ds-kids M S (nm-first M n))
          :else (ck-touch M))))
(defn- ck-ds-list [M :vector-i64 S :string n :i64] :vector-i64 (ck-ds-kids M S (nm-first M n)))
(defn- ck-ds-kids [M :vector-i64 S :string c :i64] :vector-i64
  (if (= c 0)
    (ck-touch M)
    (let [nx (nm-next M c)
          M1 (ck-ds-walk M S c)]
      (ck-ds-kids M1 S nx))))

;; ---- defn normalization: (defn NAME [p :T q ..] [:R] e ..) -> (defn NAME [p :T q :i64 ..] :R|INFER BODY) ----
;; parameters from c: a symbol not followed by a type form gets a synthetic :i64
(defn- ck-ds-params [M :vector-i64 c :i64 tok :i64] :vector-i64
  (let [nx (nm-next M c)]
    (cond (= c 0) (ck-touch M)
          (nm-ne (nm-kind M c) ND-SYM) (ck-ds-params M nx tok)
          (= (ck-is-tform M nx) 1) (ck-ds-params M (nm-next M nx) tok)
          :else
          (let [M1 (ck-n-kw M tok KW-PINFER)   ; R6C: provisional :i64 (refinable, see ck-hint-*)
                k (ck-r M1)
                M2 (ck-link M1 c k)
                M3 (ck-link M2 k nx)]
            (ck-ds-params M3 nx tok)))))

;; 1 when node r is a declared result type: a type form followed by at least one body form
(defn- ck-has-rtype [M :vector-i64 r :i64] :i64
  (cond (= (ck-is-tform M r) 0) 0
        (= (nm-next M r) 0) 0
        :else 1))

(defn- ck-ds-defn [M :vector-i64 n :i64] :vector-i64
  (let [p (nm-nth M n 2)] (ck-ds-defn1 (ck-r5b-ceiling-take (if (= (nm-kind M p) ND-VEC) (ck-ds-rest M p) M) n) n)))
(defn- ck-ds-defn1 [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        p (nm-nth M n 2)
        r (nm-next M p)
        tok (nm-nf M h NF-TOK)]
    (cond (nm-ne (nm-kind M p) ND-VEC) (ck-touch M)
          (= r 0) (ck-touch M)
          (= (ck-has-rtype M r) 1) (ck-ds-defn-body (ck-ds-params M (nm-first M p) tok) r tok)
          :else
          (let [M1 (ck-ds-params M (nm-first M p) tok)
                M2 (ck-n-kw M1 tok KW-INFER)
                k (ck-r M2)
                M3 (ck-link M2 p k)
                M4 (ck-link M3 k r)]
            (ck-ds-defn-body M4 k tok)))))
;; several body forms after the result type node rt -> one (do ..)
(defn- ck-ds-defn-body [M :vector-i64 rt :i64 tok :i64] :vector-i64
  (let [e (nm-next M rt)]
    (if (= (nm-next M e) 0)
      (ck-touch M)
      (let [M1 (ck-mkh M tok HD-DO e)
            d (ck-r M1)]
        (ck-link M1 rt d)))))

(defn- ck-ds-top1 [M :vector-i64 S :string c :i64] :vector-i64
  (let [M1 (ck-r6c-doctail (ck-ds-defn M c) S c)   ; R6C: map/vector literals in the tail of a :document defn
        body (nm-nth M1 c 4)]
    (ck-ds-walk M1 S body)))

;; every top-level defn from c: normalize, then desugar its body
(defn- ck-ds-tops [M :vector-i64 S :string c :i64] :vector-i64
  (let [hd (nm-form-head M c)
        nx (nm-next M c)]
    (cond (= c 0) (ck-touch M)
          (nm-failed M) (ck-touch M)
          (and (or (= hd HD-DEFN) (= hd HD-DEFN-PRIV)) (= (nm-kind M (nm-nth M c 2)) ND-LIST)) (ck-ds-tops (ck-ds-multi M S c hd) S nx)
          (= hd HD-DEFN) (ck-ds-tops (ck-ds-top1 M S c) S nx)
          (= hd HD-DEFN-PRIV) (ck-ds-tops (ck-ds-top1 M S c) S nx)
          :else (ck-ds-tops M S nx))))

(defn- ck-desugar [M :vector-i64 S :string] :vector-i64
  (let [M1 (mem-alloc M 256)
        base (ck-r M1)
        M2 (nm-put M1 (ck-cache) base)]
    (ck-ds-tops M2 S (nm-first M2 (vector-at M2 MM-ROOT)))))

;; ---------------------------------------------------------------------------------------------------------
;; the fixed-signature operations (everything except the special forms)
;; ---------------------------------------------------------------------------------------------------------
;; minimum (variadic) or exact argument count
(defn- ck-r4b-op? [hd :i64] :bool (and (>= hd HD-BYTES-EMPTY) (<= hd HD-STRING-FROM-UTF8)))
(defn- ck-op-arity [hd :i64] :i64
  (cond (= hd HD-NOT) 1
        (= hd HD-BYTES-EMPTY) 0 (= hd HD-BYTES-COUNT) 1 (= hd HD-BYTES-SLICE) 3 (= hd HD-STRING-FROM-UTF8) 1
        (= hd HD-STRING-SUBSTRING) 3
        (= hd HD-STRING-BYTE-LENGTH) 1
        (= hd HD-PAIR-FIRST) 1
        (= hd HD-PAIR-SECOND) 1
        (= hd HD-VECTOR-COUNT) 1
        (= hd HD-BIT-NOT) 1
        (= hd HD-VECTOR-ALLOC) 1
        (= hd HD-STRING-LENGTH) 1
        (= hd HD-BYTES-FROM-VECTOR-I64) 1
        (= hd HD-VECTOR-I64-FROM-BYTES) 1
        (= hd HD-VECTOR-ASSOC) 3
        (= hd HD-VECTOR-ASSOC-BANG) 3
        :else 2))

(defn- ck-op-variadic [hd :i64] :i64
  (cond (= hd HD-ADD) 1 (= hd HD-SUB) 1 (= hd HD-MUL) 1 :else 0))

;; 1 when na arguments fit head hd
(defn- ck-op-count-ok [hd :i64 na :i64] :i64
  (cond (= (ck-op-variadic hd) 0) (nm-eqi na (ck-op-arity hd))
        (>= na (ck-op-arity hd)) 1
        :else 0))

;; type of argument k
(defn- ck-op-arg [hd :i64 k :i64] :i64
  (cond (= hd HD-NOT) TY-BOOL
        (or (= hd HD-BYTES-AT) (= hd HD-BYTES-SLICE)) (if (= k 0) TY-BYTES TY-I64)
        (ck-r4b-op? hd) TY-BYTES
        (= hd HD-STRING-SUBSTRING) (if (= k 0) TY-STR TY-I64)
        (= hd HD-STRING-EQ) TY-STR (= hd HD-STRING-COMPARE) TY-STR (= hd HD-STRING-INDEX-OF) TY-STR
        (= hd HD-STRING-BYTE-LENGTH) TY-STR
        (= hd HD-VECTOR-AT) (if (= k 0) TY-VEC TY-I64)
        (= hd HD-VECTOR-COUNT) TY-VEC
        (= hd HD-VECTOR-CONJ) (if (= k 0) TY-VEC TY-I64)
        (= hd HD-VECTOR-ASSOC) (if (= k 0) TY-VEC TY-I64)
        (= hd HD-VECTOR-ASSOC-BANG) (if (= k 0) TY-VEC TY-I64)
        (= hd HD-BYTES-FROM-VECTOR-I64) TY-VEC
        (= hd HD-VECTOR-I64-FROM-BYTES) TY-BYTES
        (= hd HD-STRING-CODE-POINT-AT) (if (= k 0) TY-STR TY-I64)
        (= hd HD-STRING-LENGTH) TY-STR
        (= hd HD-STRING-CONCAT) TY-STR
        :else TY-I64))

(defn- ck-op-res [hd :i64] :i64
  (cond (= hd HD-NOT) TY-BOOL
        (or (= hd HD-BYTES-EMPTY) (= hd HD-BYTES-CONCAT) (= hd HD-BYTES-SLICE)) TY-BYTES
        (= hd HD-STRING-FROM-UTF8) TY-STR
        (= hd HD-STRING-EQ) TY-BOOL
        (= hd HD-STRING-SUBSTRING) TY-STR
        (= hd HD-LT) TY-BOOL
        (= hd HD-GT) TY-BOOL
        (= hd HD-LE) TY-BOOL
        (= hd HD-GE) TY-BOOL
        (= hd HD-VECTOR-CONJ) TY-VEC
        (= hd HD-VECTOR-ASSOC) TY-VEC
        (= hd HD-VECTOR-ASSOC-BANG) TY-VEC
        (= hd HD-VECTOR-ALLOC) TY-VEC
        (= hd HD-BYTES-FROM-VECTOR-I64) TY-BYTES
        (= hd HD-VECTOR-I64-FROM-BYTES) TY-VEC
        (= hd HD-STRING-CONCAT) TY-STR
        :else TY-I64))

;; 1 when the head lowers to a runtime call (RT), which makes the function charge fuel on entry
(defn- ck-op-rt [hd :i64] :i64
  (cond (= hd HD-BYTES-FROM-VECTOR-I64) 1
        (ck-r4b-op? hd) 1
        (ck-r3-op? hd) 1
        (= hd HD-VECTOR-COUNT) 1
        (= hd HD-VECTOR-I64-FROM-BYTES) 1
        (= hd HD-STRING-CONCAT) 1
        (< hd HD-VECTOR-AT) 0
        (> hd HD-STRING-LENGTH) 0
        :else 1))

;; 1 for the heads ck-op handles (fixed signatures from the tables above)
(defn- ck-op-known [hd :i64] :i64
  (cond (= hd HD-BYTES-FROM-VECTOR-I64) 1
        (ck-r4b-op? hd) 1
        (ck-r3-op? hd) 1
        (= hd HD-VECTOR-COUNT) 1
        (= hd HD-VECTOR-I64-FROM-BYTES) 1
        (= hd HD-STRING-CONCAT) 1
        (< hd HD-NOT) 0
        (> hd HD-STRING-LENGTH) 0
        :else 1))

;; ---------------------------------------------------------------------------------------------------------
;; expressions. ck-expr M n fx ctx -> M, R0 = the type of n (meaningless once MM-ERR is set)
;; ---------------------------------------------------------------------------------------------------------
(defn- ck-expr [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [k (nm-kind M n)]
    (cond (nm-failed M) (ck-touch M)
          (= k ND-INT) (ck-mark M n TY-I64 0)
          (= k ND-STR) (ck-mark M n TY-STR 0)
          (= k ND-KW) (ck-mark M n TY-KW 0)
          (= k ND-SYM) (ck-sym M n)
          (= k ND-VEC) (ck-veclit M n fx)
          (= k ND-MAP) (ck-maplit M n fx)
          (= k ND-SET) (ck-setlit M n fx)
          (= k ND-LIST) (ck-list M n fx ctx)
          :else (ck-err M E-CHECK-HEAD n 0))))

;; a symbol in value position: a local, or a def constant
(defn- ck-sym [M :vector-i64 n :i64] :vector-i64
  (let [s (nm-sym-of M n)
        slot (nm-local-slot M s)
        ty (nm-local-type M s)
        fi (nm-sf M s SF-FN)
        dty (nm-ff M fi FF-RTYPE)]
    (cond (= ty (ck-poison)) (ck-err M E-CHECK-BINDINGS n 0)
          (and (>= slot 0) (neg? (ck-known-get M slot))) (ck-err M E-ATOM-ESCAPE n 0)   ; R5B: a cell as a value
          (and (< slot 0) (= (ck-callable M fi) 1) (ck-r5b-tmpl? M fi)) (ck-err M E-STATE-VALUE n 0)   ; R5B
          (and (>= slot 0) (ck-known-bare? M slot)) (ck-err M E-CHECK-FNVALUE n 0)
          (>= slot 0) (ck-param-use (ck-mark M n ty (+ (* RES-LOCAL RES-SCALE) slot)) n slot ty)   ; R6C
          (and (= (nm-ff M fi FF-KIND) FK-DEF) (zero? dty)) (ck-err M E-CHECK-DEF n 0)   ; R6B: an opaque def
          (= (nm-ff M fi FF-KIND) FK-DEF)   ; FN record 0 has kind 0
          (ck-mark M n dty (+ (* RES-DEF RES-SCALE) fi))
          (= (nm-sf M s SF-HEAD) HD-TRUE) (ck-mark M n TY-BOOL (+ (* RES-CONST RES-SCALE) 1))
          (= (nm-sf M s SF-HEAD) HD-FALSE) (ck-mark M n TY-BOOL (* RES-CONST RES-SCALE))
          :else (ck-err M E-CHECK-SYM n 0))))

;; items c.. of a vector literal must be i64
(defn- ck-items [M :vector-i64 c :i64 fx :i64] :vector-i64
  (cond
    (= c 0) (ck-touch M)
    (nm-failed M) (ck-touch M)
    :else
    (let [nx (nm-next M c)
          M1 (ck-expr M c fx 0)
          ty (ck-ty M1)]
      (if (= ty TY-I64)
        (ck-items M1 nx fx)
        (ck-err M1 E-CHECK-VECLIT c 0)))))

(defn- ck-veclit [M :vector-i64 n :i64 fx :i64] :vector-i64
  (cond
    ;; R4B: 65..128 (the reference's limit, stage-0 "vector literal exceeds item limit") integer literals: a pooled constant table (30-lower OP-VECP)
    (and (> (nm-count M n) 64) (<= (nm-count M n) 128) (= (ck-all-ints M n) 1))
    (ck-mark (ck-mark-items M (nm-first M n)) n TY-VEC HD-VECLIT)
    (> (nm-count M n) 64)
    (ck-err M E-CHECK-VECLIT n 0)
    :else
    (let [c (nm-first M n)
          M1 (ck-items M c fx)]
      (ck-mark M1 n TY-VEC HD-VECLIT))))

;; 1 when fn index fi names a defn/defn- (FN record 0 has kind 0)
(defn- ck-callable [M :vector-i64 fi :i64] :i64
  (cond (= fi 0) 0
        (= (nm-ff M fi FF-KIND) FK-DEF) 0
        :else 1))

;; a list: a builtin form or a call of a defn of the file
;; R1: a definition shadows an R1 head of the same name (20-names), so the call is tried before the head;
;; (:f r) is a record field access.
(defn- ck-list [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        s (nm-sym-of M h)
        hd (nm-sf M s SF-HEAD)
        fi (nm-sf M s SF-FN)]
    (cond (= h 0) (ck-err M E-CHECK-HEAD n 0)
          (= (nm-kind M h) ND-KW) (ck-kwget M n fx)
          (= (nm-kind M h) ND-LIST) (ck-callv M n fx)
          (nm-ne (nm-kind M h) ND-SYM) (ck-err M E-CHECK-HEAD h 0)
          (>= (nm-local-slot M s) 0) (ck-call-local M n fx)
          (and (= (ck-callable M fi) 1) (ck-r5b-tmpl? M fi)) (ck-r5b-scall M n fi fx)   ; R5B: a stateful defn
          (= (ck-callable M fi) 1) (ck-call M n fi fx)
          (> hd 0) (ck-head (nm-set-nf M h NF-RES (+ (* RES-HEAD RES-SCALE) hd)) n hd fx ctx)
          :else (ck-err M E-CHECK-HEAD h 0))))

(defn- ck-head [M :vector-i64 n :i64 hd :i64 fx :i64 ctx :i64] :vector-i64
  (cond (= hd HD-LET) (ck-let M n fx ctx)
        (= hd HD-LOOP) (ck-loop M n fx)
        (= hd HD-RECUR) (ck-recur M n fx ctx)
        (= hd HD-IF) (ck-if M n fx ctx)
        (= hd HD-COND) (ck-cond M n fx ctx)
        (= hd HD-AND) (ck-andor M n hd fx ctx)
        (= hd HD-OR) (ck-andor M n hd fx ctx)
        (= hd HD-EQ) (ck-eq M n fx)
        (= hd HD-TYPED-CAP-CALL) (ck-cap M n fx)
        (= hd HD-DO) (ck-do M n fx ctx)
        (= hd HD-TRAP) (ck-mark M n 0 HD-TRAP)
        (= hd HD-RECORD-NEW) (ck-recnew M n fx)
        (= hd HD-RECORD) (ck-recnew M n fx)
        (= hd HD-RECORD-CTOR) (ck-ctor M n fx)
        (= hd HD-RECORD-GET) (ck-recget M n fx)
        (= hd HD-GET) (ck-get M n fx)
        (= hd HD-ASSOC) (ck-assoc M n fx)
        (and (>= hd HD-OPTION-SOME) (<= hd HD-POP)) (ck-r3 M n hd fx ctx)
        (and (>= hd HD-FN) (<= hd HD-AMP)) (ck-r4 M n hd fx ctx)
        (and (>= hd HD-ATOM) (<= hd HD-DEFHANDLER)) (ck-r5b M n hd fx ctx)   ; R5B
        (or (= hd HD-R6-AS) (= hd HD-R6-IS)) (ck-r6b-as M n fx hd)   ; R6B
        (and (>= hd HD-R6-TODOC) (<= hd HD-R6-TOSTR)) (ck-r6b-conv M n hd fx)   ; R6B
        (= (ck-op-known hd) 1) (ck-op M n hd fx)
        :else (ck-head-err M n)))

(defn- ck-head-err [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)] (ck-err M E-CHECK-HEAD h 0)))

;; ---- fixed-signature operations ----
;; arguments c.. of head hd, k = index of c, hn = the head node
(defn- ck-op-args [M :vector-i64 c :i64 hd :i64 k :i64 fx :i64 hn :i64] :vector-i64
  (cond
    (= c 0) (ck-touch M)
    (nm-failed M) (ck-touch M)
    :else
    (let [want (ck-op-arg hd k)
          nx (nm-next M c)
          M1 (ck-expr M c fx 0)
          ty (ck-ty M1)]
      (if (or (= ty want) (and (= want TY-VEC) (= hd HD-VECTOR-COUNT) (= (ck-tcon M1 ty) TC-LIST)))
        (ck-op-args M1 nx hd (+ k 1) fx hn)
        (ck-err M1 E-CHECK-TYPE hn want)))))

(defn- ck-op-fuel [M :vector-i64 hd :i64 f :i64] :vector-i64
  (if (= (ck-op-rt hd) 1) (ck-fuel M f) (ck-touch M)))

(defn- ck-op [M :vector-i64 n :i64 hd :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 1)]
    (if (= (ck-op-count-ok hd na) 1)
      (let [a (nm-next M h)
            M1 (ck-op-args M a hd 0 fx h)]
        (ck-mark (ck-op-fuel M1 hd (ck-fx-f fx)) n (ck-op-res hd) hd))
      (ck-err M E-CHECK-ARITY h (ck-op-arity hd)))))

;; ---- = ----
(defn- ck-eqable [ty :i64] :i64 (cond (= ty TY-I64) 1 (= ty TY-BOOL) 1 (= ty TY-KW) 1 :else 0))

(defn- ck-eq [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        a (nm-next M h)
        b (nm-next M a)]
    (if (= (nm-count M n) 3)
      (let [M1 (ck-expr M a fx 0)
            ta (ck-ty M1)
            M2 (ck-expr M1 b fx 0)
            tb (ck-ty M2)]
        (cond (= (ck-eqable ta) 0) (ck-err M2 E-CHECK-EQ h 0)
              (= (ck-eqable tb) 0) (ck-err M2 E-CHECK-EQ h 0)
              (nm-ne ta tb) (ck-err M2 E-CHECK-TYPE h ta)
              :else (ck-mark M2 n TY-BOOL HD-EQ)))
      (ck-err M E-CHECK-ARITY h 2))))

;; ---- if ----
(defn- ck-if [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        c (nm-next M h)
        a (nm-next M c)
        b (nm-next M a)]
    (if (= (nm-count M n) 4)
      (let [a0 (ck-aborts M)
            M1 (ck-expr M c fx 0)
            tc (ck-ty M1)
            ctx1 (ck-ctx-after M1 a0 ctx)]
        (if (= tc TY-BOOL)
          (let [M2 (ck-expr M1 a fx ctx1)
                ta (ck-ty M2)
                M3 (ck-expr M2 b fx ctx1)
                tb (ck-ty M3)
                M4 (ck-unify M3 ta tb h)
                ty (ck-ty M4)]
            (ck-mark M4 n ty HD-IF))
          (ck-err (ck-last-clear M1) E-CHECK-TYPE h TY-BOOL)))
      (ck-err M E-CHECK-IF h 0))))

;; ---- cond ----
;; c = the next test node; h = the head node, acc = the arms' type so far
(defn- ck-cond-pairs [M :vector-i64 c :i64 h :i64 acc :i64 fx :i64 ctx :i64] :vector-i64
  (let [e (nm-next M c)
        nx (nm-next M e)]
    (cond
      (nm-failed M) (ck-touch M)
      (= (nm-kind M c) ND-KW)
      (cond (nm-ne nx 0) (ck-err M E-CHECK-ELSE h 0)
            (nm-ne (nm-head-of M c) KW-ELSE) (ck-err M E-CHECK-ELSE h 0)
            :else (let [M1 (ck-expr M e fx ctx)
                        te (ck-ty M1)]
                    (ck-unify M1 acc te h)))
      (= nx 0) (ck-err M E-CHECK-ELSE h 0)
      :else
      (let [a0 (ck-aborts M)
            M1 (ck-expr M c fx 0)
            tc (ck-ty M1)
            ctx1 (ck-ctx-after M1 a0 ctx)]
        (if (= tc TY-BOOL)
          (let [M2 (ck-expr M1 e fx ctx1)
                te (ck-ty M2)
                M3 (ck-unify M2 acc te h)
                ty (ck-ty M3)]
            (ck-cond-pairs M3 nx h ty fx ctx1))
          (ck-err (ck-last-clear M1) E-CHECK-TYPE h TY-BOOL))))))

(defn- ck-cond [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 1)]
    (cond (< na 2) (ck-err M E-CHECK-ELSE h 0)
          (nm-ne (bit-and na 1) 0) (ck-err M E-CHECK-ELSE h 0)
          :else (let [c (nm-next M h)
                      M1 (ck-cond-pairs M c h 0 fx ctx)
                      ty (ck-ty M1)]
                  (ck-mark M1 n ty HD-COND)))))

;; ---- and / or: all bool; the last argument inherits the tail position ----
(defn- ck-last-ctx [nx :i64 ctx :i64] :i64 (if (= nx 0) ctx 0))

(defn- ck-andor-args [M :vector-i64 c :i64 fx :i64 ctx :i64 h :i64] :vector-i64
  (cond
    (= c 0) (ck-touch M)
    (nm-failed M) (ck-touch M)
    :else
    (let [nx (nm-next M c)
          a0 (ck-aborts M)
          M1 (ck-expr M c fx (ck-last-ctx nx ctx))
          ty (ck-ty M1)
          ctx1 (ck-ctx-after M1 a0 ctx)]
      (cond (= ty TY-BOOL) (ck-andor-args M1 nx fx ctx1 h)
            (= ty 0) (ck-andor-args M1 nx fx ctx1 h)
            :else (ck-err (ck-last-clear M1) E-CHECK-TYPE h TY-BOOL)))))

(defn- ck-andor [M :vector-i64 n :i64 hd :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)]
    (if (>= (nm-count M n) 2)
      (let [c (nm-next M h)
            a0 (ck-sg M ck-s-andor)   ; R5B: no cell write inside an and/or operand (E2143)
            M1 (ck-ss (ck-andor-args (ck-ss M ck-s-andor h) c fx ctx h) ck-s-andor a0)]
        (ck-mark M1 n TY-BOOL hd))
      (ck-err M E-CHECK-ARITY h 1))))

;; ---- typed-cap-call ----
;; R4B: the wire as a keyword code: a wire keyword, or the wire id as an integer literal (the spelling of stage-0's KIR,
;; which stage-0 also admits in source): 3 33 34 41 35 37 38 39 (35 with a :bytes request = :fs/app-data-bytes); 0 otherwise.
;; 21-check leaves the code in NF-TYPE of the wire node for 30-lower.
(defn- ck-wire-kw [M :vector-i64 w :i64 q :i64] :i64
  (cond (= (nm-kind M w) ND-KW) (nm-head-of M w)
        (nm-ne (nm-kind M w) ND-INT) 0
        :else (case (nm-nf M w NF-AUX)
                3 KW-HASH-SHA256 33 KW-ENV-READ 34 KW-FS-BROWSE 41 KW-IO-READ
                35 (if (= (nm-head-of M q) KW-BYTES) KW-FS-APP-DATA-BYTES KW-FS-APP-DATA)
                37 KW-IO-WRITE 38 KW-CLI-ARGS 39 KW-IO-WRITE-ERROR
                20 KW-PROCESS-SPAWN 23 KW-ENTROPY-DRAW   ; R6B
                0)))
(defn- ck-wire-ok [k :i64] :i64
  (cond (= k KW-FS-APP-DATA) 1 (= k KW-CLI-ARGS) 1 (= k KW-IO-WRITE-ERROR) 1 (= k KW-IO-WRITE) 1
        (= k KW-FS-APP-DATA-BYTES) 1
        ;; R4B: wires 3 33 34 41 (:string :string)
        (= k KW-HASH-SHA256) 1 (= k KW-ENV-READ) 1 (= k KW-FS-BROWSE) 1 (= k KW-IO-READ) 1
        (= k KW-PROCESS-SPAWN) 1 (= k KW-ENTROPY-DRAW) 1   ; R6B: wires 20 23 (:string :string)
        :else 0))

;; the request/result type of the shape, 0 when the shape is not one of seed/HEADS :cap-shapes
;; (ND-KW kinds are checked by the caller)
(defn- ck-cap-type [wk :i64 r1 :i64 r2 :i64] :i64
  (cond (nm-ne r1 r2) 0
        (= wk KW-FS-APP-DATA-BYTES) (if (= r1 KW-BYTES) TY-BYTES 0)
        (= r1 KW-STRING) TY-STR
        :else 0))
;; R4B: the result type of the shape (wire 35 :string :bytes reads a file as bytes, kind CK-STRING-BYTES), 0 when none
(defn- ck-cap-res [wk :i64 r1 :i64 r2 :i64] :i64
  (if (and (or (= wk KW-FS-APP-DATA) (= wk KW-FS-APP-DATA-BYTES)) (= r1 KW-STRING) (= r2 KW-BYTES))
    TY-BYTES
    (ck-cap-type wk r1 r2)))

(defn- ck-cap [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        w (nm-next M h)
        q (nm-next M w)
        r (nm-next M q)
        x (nm-next M r)
        wk (ck-wire-kw M w q)
        ty (ck-cap-type wk (nm-head-of M q) (nm-head-of M r))
        rty (ck-cap-res wk (nm-head-of M q) (nm-head-of M r))
        aty (if (= rty ty) ty TY-STR)]
    (cond (nm-ne (nm-count M n) 5) (ck-err M E-CHECK-CAP h 0)
          (= (ck-wire-ok wk) 0) (ck-err M E-CHECK-CAP w 0)
          (nm-ne (nm-kind M q) ND-KW) (ck-err M E-CHECK-CAP q 0)
          (nm-ne (nm-kind M r) ND-KW) (ck-err M E-CHECK-CAP r 0)
          (= rty 0) (ck-err M E-CHECK-CAP q 0)
          :else
          (let [M1 (ck-expr M x fx 0)
                tx (ck-ty M1)]
            (if (= tx aty)
              (ck-mark (ck-r5b-cap (ck-fuel (nm-set-nf M1 w NF-TYPE wk) (ck-fx-f fx)) (ck-fx-f fx) (ck-kw-wire wk)) n rty HD-TYPED-CAP-CALL)
              (ck-err M1 E-CHECK-TYPE h aty))))))

;; ---- calls of the file's functions ----
;; argument c is argument k of FN fi; h = the head node
(defn- ck-call-args [M :vector-i64 c :i64 fi :i64 k :i64 fx :i64 h :i64] :vector-i64
  (cond
    (= c 0) (ck-touch M)
    (nm-failed M) (ck-touch M)
    :else
    (let [want (ck-pt M fi k)
          nx (nm-next M c)
          M1 (ck-arg M c fx want)
          ty (ck-ty M1)]
      (if (or (= ty want) (ck-probe-lenient? M1 fi k want))   ; R6C: a probe run passes a provisional parameter by
        (ck-call-args M1 nx fi (+ k 1) fx h)
        (ck-err M1 E-CHECK-TYPE h want)))))

(defn- ck-call [M :vector-i64 n :i64 f0 :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 1)
        fi (ck-pick M f0 na)]
    (cond (pos? fi) (ck-call-abort (ck-call2 (ck-ensure (nm-set-nf M h NF-RES (+ (* RES-FN RES-SCALE) fi)) fi) n fi fx) n fi fx)
          (ck-multi? M f0) (ck-err M E-CHECK-CLAUSE h na)
          :else (ck-err M E-CHECK-ARITY h (nm-ff M f0 FF-NPARAMS)))))
(defn- ck-call2 [M :vector-i64 n :i64 fi :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        np (nm-ff M fi FF-NPARAMS)
        rt (nm-ff M fi FF-RTYPE)]
    (cond (< rt 1) (ck-err M E-CHECK-INFER h 0)
          (ck-variadic? M fi) (ck-call-var M n fi fx)
          (= (- (nm-count M n) 1) np)
          (let [c (nm-next M h)
                M1 (ck-call-args M c fi 0 fx h)]
            (ck-mark (ck-fuel M1 (ck-fx-f fx)) n rt HD-CALL))
          :else (ck-err M E-CHECK-ARITY h np))))

;; ---------------------------------------------------------------------------------------------------------
;; let / loop / recur
;; ---------------------------------------------------------------------------------------------------------
;; bind binder node b to slot with type ty: scope + NF-TYPE/NF-RES of b + FF-NSLOTS
(defn- ck-bind [M :vector-i64 b :i64 slot :i64 ty :i64 f :i64] :vector-i64
  (let [s (nm-sym-of M b)
        M1 (nm-bind M s slot ty)
        M2 (nm-set-nf M1 b NF-TYPE ty)
        M3 (nm-set-nf M2 b NF-RES (+ (* RES-LOCAL RES-SCALE) slot))]
    (ck-known-set (ck-use-slot M3 f slot) slot 0)))

;; a binder must be a symbol, not bound twice since scope height h0. A head spelling is a legal local name
;; (seed code has locals named ns); a local in HEAD position is refused (E2101), so it never shadows a form.
(defn- ck-binder-ok [M :vector-i64 b :i64 h0 :i64] :vector-i64
  (cond (nm-ne (nm-kind M b) ND-SYM) (ck-err M E-CHECK-BINDINGS b 0)
        (= (nm-bound-since M (nm-sym-of M b) h0) 1) (ck-err M E-CHECK-DUPLOCAL b 0)
        :else (ck-touch M)))

;; let bindings from binder b; mode 0 = let (bind with the init's type), 1 = loop (bind as poison until all
;; inits are checked). R0 = the fx after the last binding.
(defn- ck-binds [M :vector-i64 b :i64 fx :i64 h0 :i64 mode :i64] :vector-i64
  (cond
    (= b 0) (nm-put M MM-R0 fx)
    (nm-failed M) (ck-touch M)
    :else
    (let [e (nm-next M b)
          slot (ck-fx-next fx)
          M1 (ck-r5b-shadow (ck-binder-ok M b h0) b)
          M2 (if (and (= mode 0) (ck-r5b-atom-form? M1 e)) (ck-r5b-atom M1 e fx) (ck-expr M1 e fx 0))   ; R5B: a cell
          ty (ck-ty M2)]
      (cond (> slot (ck-max-slots)) (ck-err M2 E-CHECK-SLOTS b slot)
            (= ty 0) (ck-err M2 E-CHECK-BINDINGS b 0)
            :else (ck-binds-next M2 b fx h0 mode)))))

(defn- ck-bind-type [mode :i64 ty :i64] :i64 (if (= mode 1) (ck-poison) ty))

;; bind b (its init has type R0) and continue with the next pair
(defn- ck-binds-next [M :vector-i64 b :i64 fx :i64 h0 :i64 mode :i64] :vector-i64
  (let [ty (ck-ty M)
        nx (nm-next M (nm-next M b))
        M1 (ck-bind M b (ck-fx-next fx) (ck-bind-type mode ty) (ck-fx-f fx))
        M2 (nm-set-nf M1 b NF-TYPE ty)
        M3 (if (and (= mode 0) (ck-fn-form? M2 (nm-next M2 b))) (ck-known-bind M2 b (ck-fx-next fx)) M2)
        ;; R5B: a let-bound (atom e) makes the slot a cell: known table value -(loop depth + 1)
        M3b (if (and (= mode 0) (ck-r5b-atom-form? M3 (nm-next M3 b))) (ck-known-set M3 (ck-fx-next fx) (- -1 (ck-sg M3 ck-s-loopn))) M3)]
    (ck-binds M3b nx (+ fx 1) h0 mode)))

;; loop: re-bind every binder from b with its real type (NF-TYPE) and slot (NF-RES)
(defn- ck-rebind [M :vector-i64 b :i64 f :i64] :vector-i64
  (if (= b 0)
    (ck-touch M)
    (let [nx (nm-next M (nm-next M b))
          slot (- (nm-nf M b NF-RES) (* RES-LOCAL RES-SCALE))
          ty (nm-nf M b NF-TYPE)
          M1 (ck-bind M b slot ty f)]
      (ck-rebind M1 nx f))))

(defn- ck-lt-flag [a :i64 b :i64] :i64 (if (< a b) 1 0))

;; shape of (let|loop [..] body) with at most maxpairs bindings (loop: at least one); error or M unchanged
(defn- ck-binding-form [M :vector-i64 n :i64 maxpairs :i64] :vector-i64
  (let [h (nm-first M n)
        v (nm-next M h)
        nb (nm-count M v)]
    (cond (nm-ne (nm-kind M v) ND-VEC) (ck-err M E-CHECK-BINDINGS h 0)
          (nm-ne (bit-and nb 1) 0) (ck-err M E-CHECK-BINDINGS h 0)
          (> nb (* 2 maxpairs)) (ck-err M E-CHECK-BINDINGS h 0)
          (= (* (ck-lt-flag maxpairs 1000) (nm-eqi nb 0)) 1) (ck-err M E-CHECK-BINDINGS h 0)
          (nm-ne (nm-count M n) 3) (ck-err M E-CHECK-BODY h 0)
          :else (ck-touch M))))

(defn- ck-let [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (ck-let-body (ck-binding-form M n 1000) n fx ctx))

(defn- ck-let-body [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (if (nm-failed M)
    (ck-touch M)
    (let [v (nm-next M (nm-first M n))
          body (nm-next M v)
          h0 (nm-scope-height M)
          b0 (nm-first M v)
          a0 (ck-aborts M)
          lb0 (ck-sg M ck-s-lbody)
          M1 (ck-ss (ck-binds (ck-ss M ck-s-lbody body) b0 fx h0 0) ck-s-lbody lb0)
          fx2 (ck-ty M1)
          M2 (ck-expr M1 body fx2 (ck-ctx-after M1 a0 ctx))
          ty (ck-ty M2)
          M3 (nm-unbind M2 h0)]
      (ck-mark M3 n ty HD-LET))))

(defn- ck-loop [M :vector-i64 n :i64 fx :i64] :vector-i64
  (ck-loop-body (ck-binding-form M n 20) n fx))

(defn- ck-loop-body [M :vector-i64 n :i64 fx :i64] :vector-i64
  (if (nm-failed M)
    (ck-touch M)
    (let [v (nm-next M (nm-first M n))
          body (nm-next M v)
          b0 (nm-first M v)
          h0 (nm-scope-height M)
          M1 (ck-binds M b0 fx h0 1)
          fx2 (ck-ty M1)
          M2 (nm-unbind M1 h0)
          M3 (ck-rebind M2 b0 (ck-fx-f fx))
          ;; R3: aborts caught by a try outside this loop still leave its body (the recur rule, ck-abort-at)
          d0 (ck-sg M3 ck-s-loopd)
          ln (ck-sg M3 ck-s-loopn)   ; R5B: the loop depth of the body
          M4 (ck-ss (ck-ss (ck-expr (ck-ss (ck-ss M3 ck-s-loopn (inc ln)) ck-s-loopd (ck-sg M3 ck-s-tryd)) body fx2 (+ (* v 2) 1)) ck-s-loopd d0)
                    ck-s-loopn ln)
          ty (ck-ty M4)
          M5 (nm-unbind M4 h0)]
      (ck-mark M5 n ty HD-LOOP))))

;; recur arguments from a, binders from b (every second child of the target vector)
(defn- ck-recur-args [M :vector-i64 a :i64 b :i64 fx :i64 h :i64] :vector-i64
  (cond
    (= a 0) (ck-touch M)
    (nm-failed M) (ck-touch M)
    :else
    (let [want (nm-nf M b NF-TYPE)
          nx (nm-next M a)
          nb (nm-next M (nm-next M b))
          M1 (ck-expr M a fx 0)
          ty (ck-ty M1)]
      (if (= ty want)
        (ck-recur-args M1 nx nb fx h)
        (ck-err M1 E-CHECK-TYPE h want)))))

(defn- ck-recur [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        tgt (quot ctx 2)
        nb (quot (nm-count M tgt) 2)]
    (cond (= (bit-and ctx 1) 0) (ck-err M E-CHECK-RECUR-TAIL h 0)
          (= tgt 0) (ck-err M E-CHECK-RECUR-TAIL h 0)
          (nm-ne (- (nm-count M n) 1) nb) (ck-err M E-CHECK-RECUR-ARITY h nb)
          :else
          (let [a (nm-next M h)
                b (nm-first M tgt)
                a0 (ck-aborts M)
                M1 (ck-recur-args M a b fx h)]
            (if (> (ck-aborts M1) a0)
              (ck-err M1 E-CHECK-RECUR-TAIL h 0)
              (ck-mark M1 n 0 HD-RECUR))))))

;; ---------------------------------------------------------------------------------------------------------
;; R1: do, the synthetic trap, records
;; ---------------------------------------------------------------------------------------------------------
;; (do e1 .. en): e1..e(n-1) in no tail position, en inherits ctx; type = en's
(defn- ck-do-args [M :vector-i64 c :i64 fx :i64 ctx :i64] :vector-i64
  (let [nx (nm-next M c)
        a0 (ck-aborts M)]
    (cond (nm-failed M) (ck-touch M)
          (= nx 0) (ck-expr M c fx ctx)
          :else (let [M1 (ck-expr M c fx 0)] (ck-do-args M1 nx fx (ck-ctx-after M1 a0 ctx))))))
(defn- ck-do [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        c (nm-next M h)]
    (if (= c 0)
      (ck-err M E-CHECK-ARITY h 1)
      (let [M1 (ck-do-args M c fx ctx)
            ty (ck-ty M1)]
        (ck-mark M1 n ty HD-DO)))))

;; record arguments from c against the fields of blk (k = field index); h = the head node for errors
(defn- ck-rec-args [M :vector-i64 c :i64 blk :i64 k :i64 fx :i64] :vector-i64
  (cond
    (= c 0) (ck-touch M)
    (nm-failed M) (ck-touch M)
    :else
    (let [want (ck-blk-ty M blk k)
          nx (nm-next M c)
          M1 (ck-expr M c fx 0)
          ty (ck-ty M1)]
      (if (= ty want)
        (ck-rec-args M1 nx blk (+ k 1) fx)
        (ck-err M1 E-CHECK-TYPE c want)))))

;; construct a record of block blk from the arguments a.. (h = head node, res = the NF-RES head code)
(defn- ck-rec-build [M :vector-i64 n :i64 a :i64 blk :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)]
    (if (= (ck-chain-len M a) (ck-blk-n M blk))
      (let [M1 (ck-rec-args M a blk 0 fx)]
        (ck-fuel M1 (ck-fx-f fx)))
      (ck-err M E-CHECK-ARITY h (ck-blk-n M blk)))))
(defn- ck-chain-len [M :vector-i64 c :i64] :i64
  (loop [x c k 0] (if (= x 0) k (recur (nm-next M x) (+ k 1)))))

;; (record-new SCHEMA e ..) / (record SCHEMA e ..)
(defn- ck-recnew [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        sn (nm-next M h)]
    (if (= sn 0)
      (ck-err M E-CHECK-ARITY h 1)
      (let [M1 (ck-tform M sn)
            ty (ck-ty M1)]
        (cond (nm-failed M1) (ck-touch M1)
              (< ty TY-REC-BASE) (ck-err M1 E-CHECK-SCHEMA sn 0)
              :else (ck-mark (ck-rec-build M1 n (nm-next M1 sn) (ck-blk M1 ty) fx) n ty HD-RECORD-NEW))))))

;; (->Name e ..): the head's gensym carries the block
(defn- ck-ctor [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        blk (nm-sf M (nm-sym-of M h) SF-REC)
        M1 (ck-rec-build M n (nm-next M h) blk fx)]
    (ck-mark M1 n (ck-blk-type M1 blk) HD-RECORD-CTOR)))

(defn- ck-mismatch [want :i64 ty :i64] :i64 (cond (= want 0) 0 (= ty want) 0 :else 1))

;; field access: r = the record expression, kw = the field keyword node, want = the record type it must have
;; (0: any record type); res = the NF-RES head code. The keyword's NF-RES = the field index.
(defn- ck-access [M :vector-i64 n :i64 r :i64 kw :i64 want :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        M1 (ck-expr M r fx 0)
        ty (ck-ty M1)
        blk (ck-blk M1 ty)
        i (ck-field M1 blk (nm-sym-of M1 kw))]
    (cond (nm-failed M1) (ck-touch M1)
          (< ty TY-REC-BASE) (ck-err M1 E-CHECK-TYPE h (ck-sel want want TY-REC-BASE))
          (= (ck-mismatch want ty) 1) (ck-err M1 E-CHECK-TYPE h want)
          (nm-ne (nm-kind M1 kw) ND-KW) (ck-err M1 E-CHECK-FIELD kw 0)
          (< i 0) (ck-err M1 E-CHECK-FIELD kw 0)
          :else (ck-fuel (nm-set-nf M1 kw NF-RES i) (ck-fx-f fx)))))
;; the field type of the access whose keyword node is kw (after ck-access)
(defn- ck-access-ty [M :vector-i64 r :i64 kw :i64] :i64
  (ck-blk-ty M (ck-blk M (nm-nf M r NF-TYPE)) (nm-nf M kw NF-RES)))

;; (record-get SCHEMA r :f)
(defn- ck-recget [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        sn (nm-next M h)
        r (nm-next M sn)
        kw (nm-next M r)]
    (if (= (nm-count M n) 4)
      (let [M1 (ck-tform M sn)
            ty (ck-ty M1)]
        (cond (nm-failed M1) (ck-touch M1)
              (< ty TY-REC-BASE) (ck-err M1 E-CHECK-SCHEMA sn 0)
              :else (ck-access-end (ck-access M1 n r kw ty fx) n r kw HD-RECORD-GET)))
      (ck-err M E-CHECK-ARITY h 3))))
(defn- ck-access-end [M :vector-i64 n :i64 r :i64 kw :i64 res :i64] :vector-i64
  (if (nm-failed M) (ck-touch M) (ck-mark M n (ck-access-ty M r kw) res)))

;; (get r :f) on a record
(defn- ck-get [M :vector-i64 n :i64 fx :i64] :vector-i64
  (if (= (nm-count M n) 4) (ck-r6b-get M n fx) (ck-get-rec M n fx)))   ; R6B: (get d k default) on a :document
(defn- ck-get-rec [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        r (nm-next M h)
        kw (nm-next M r)]
    (if (= (nm-count M n) 3)
      (ck-access-end (ck-access M n r kw 0 fx) n r kw HD-GET)
      (ck-err M E-CHECK-ARITY h 2))))

;; (assoc r :f v) on a record: r is held in a hidden slot (the next free one; NF-TYPE of the head node) while
;; the fields are copied, v is checked with the slots after it
(defn- ck-assoc [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [r (nm-nth M n 1)
        M1 (if (= (nm-count M n) 4) (ck-expr M r (+ fx 7) 0) M)]
    (cond (nm-failed M1) (ck-touch M1)
          (and (= (nm-count M1 n) 4) (= (ck-tcon M1 (ck-ty M1)) TC-MAP)) (ck-gassoc M1 n fx)
          (and (= (nm-count M1 n) 4) (= (ck-ty M1) TY-DOC)) (ck-r6b-assoc M1 n fx)   ; R6B: (assoc d k v) on a :document
          :else (ck-assoc-rec M1 n fx))))
(defn- ck-assoc-rec [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        r (nm-next M h)
        kw (nm-next M r)
        v (nm-next M kw)
        slot (ck-fx-next fx)]
    (cond (nm-ne (nm-count M n) 4) (ck-err M E-CHECK-ARITY h 3)
          (> slot (ck-max-slots)) (ck-err M E-CHECK-SLOTS h slot)
          :else
          (let [M1 (ck-access M n r kw 0 fx)
                ty (nm-nf M1 r NF-TYPE)
                fty (ck-access-ty M1 r kw)
                M2 (ck-use-slot M1 (ck-fx-f fx) slot)
                M3 (nm-set-nf M2 h NF-TYPE slot)
                M4 (ck-expr M3 v (+ fx 1) 0)
                tv (ck-ty M4)]
            (cond (nm-failed M4) (ck-touch M4)
                  (nm-ne tv fty) (ck-err M4 E-CHECK-TYPE v fty)
                  :else (ck-mark M4 n ty HD-ASSOC))))))

;; (:f r) on a record
(defn- ck-kwget [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [kw (nm-first M n)
        r (nm-next M kw)]
    (if (= (nm-count M n) 2)
      (ck-access-end (ck-access M n r kw 0 fx) n r kw HD-KWGET)
      (ck-err M E-CHECK-ARITY kw 1))))

;; ---------------------------------------------------------------------------------------------------------
;; pass A: signatures and def literals
;; ---------------------------------------------------------------------------------------------------------
;; R4B: the type of parameter k of FN f: FF-PT0+k for k < 5, else NF-TYPE of the k-th type form of its parameter vector
(defn- ck-pt [M :vector-i64 f :i64 k :i64] :i64
  (if (< k 5)
    (nm-ff M f (+ FF-PT0 k))
    (nm-nf M (nm-nth M (nm-nth M (nm-ff M f FF-NODE) 2) (inc (* 2 k))) NF-TYPE)))
;; params from binder b (k = index); records FF-PT0+k (R4B: NF-TYPE of the type form t for k >= 5)
(defn- ck-sig-params [M :vector-i64 b :i64 f :i64 k :i64] :vector-i64
  (let [t (nm-next M b)]
    (cond (= b 0) (ck-touch M)
          (nm-failed M) (ck-touch M)
          (nm-ne (nm-kind M b) ND-SYM) (ck-err M E-CHECK-SIGNATURE b 0)
          (= (ck-is-tform M t) 0) (ck-err M E-CHECK-SIGNATURE t 0)
          :else (ck-sig-param2 (ck-tform M t) t f k))))
;; R0 = the type of parameter k (type form t)
(defn- ck-sig-param2 [M :vector-i64 t :i64 f :i64 k :i64] :vector-i64
  (let [ty (ck-ty M)
        nx (nm-next M t)]
    (cond (nm-failed M) (ck-touch M)
          (= ty 0) (ck-err M E-CHECK-TYPENAME t 0)
          (>= k 5) (ck-sig-params (nm-set-nf M t NF-TYPE ty) nx f (+ k 1))
          :else (ck-sig-params (nm-set-ff M f (+ FF-PT0 k) ty) nx f (+ k 1)))))

;; 1 when every parameter type of f is i64 (R4B: and there are at most 5)
(defn- ck-params-i64 [M :vector-i64 f :i64] :i64
  (loop [k 0]
    (cond (> (nm-ff M f FF-NPARAMS) 5) 0
          (= k (nm-ff M f FF-NPARAMS)) 1
          (= (nm-ff M f (+ FF-PT0 k)) TY-I64) (recur (+ k 1))
          :else 0)))

;; 1 when f can be exported: params all i64, result i64 or bool
(defn- ck-exportable [M :vector-i64 f :i64] :i64
  (let [rt (nm-ff M f FF-RTYPE)]
    (cond (= (ck-params-i64 M f) 0) 0
          (= rt TY-I64) 1
          (= rt TY-BOOL) 1
          :else 0)))

;; an exported function takes only i64 and returns i64 or bool (seed/HEADS HD-DEFN). R1: implicit exports
;; (FF-EXPORT 2) and inferred results (FF-RTYPE -1 until the body is checked) are settled in pass E.
(defn- ck-sig-export [M :vector-i64 f :i64 nm :i64] :vector-i64
  (let [rt (nm-ff M f FF-RTYPE)]
    (cond (nm-ne (nm-ff M f FF-EXPORT) 1) (ck-touch M)
          (< rt 1) (ck-touch M)
          (> (nm-ff M f FF-NPARAMS) 5) (ck-err M E-CHECK-PARAMS nm 0)   ; R4B: an export takes at most 5
          (= (ck-params-i64 M f) 0) (ck-err M E-CHECK-TYPE nm TY-I64)
          (= rt TY-I64) (ck-touch M)
          (= rt TY-BOOL) (ck-touch M)
          :else (ck-err M E-CHECK-TYPE nm TY-I64))))

(defn- ck-sig-defn [M :vector-i64 f :i64] :vector-i64
  (let [n (nm-ff M f FF-NODE)
        nm (nm-nth M n 1)
        p (nm-nth M n 2)
        r (nm-nth M n 3)]
    (cond (nm-ne (nm-kind M p) ND-VEC) (ck-err M E-CHECK-SIGNATURE nm 0)
          (nm-ne (bit-and (nm-count M p) 1) 0) (ck-err M E-CHECK-SIGNATURE nm 0)
          (> (nm-count M p) 32) (ck-err M E-CHECK-PARAMS16 nm 0)
          ;; R4B: a clause takes up to 16 parameters; an explicit export or a variadic clause up to 5
          (and (> (nm-count M p) 10) (or (= (nm-ff M f FF-EXPORT) 1) (= (nm-nf M p NF-TYPE) 1))) (ck-err M E-CHECK-PARAMS nm 0)
          (= (ck-is-tform M r) 0) (ck-err M E-CHECK-SIGNATURE nm 0)
          (nm-ne (nm-count M n) 5) (ck-err M E-CHECK-BODY nm 0)
          (= (ck-is-infer M r) 1) (ck-sig-defn2 (nm-put M MM-R0 -1) f p nm)
          :else (ck-sig-defn2 (ck-tform M r) f p nm))))
;; R0 = the result type (-1: to infer from the body)
(defn- ck-sig-defn2 [M :vector-i64 f :i64 p :i64 nm :i64] :vector-i64
  (let [rt (ck-ty M)]
    (cond (nm-failed M) (ck-touch M)
          (= rt 0) (ck-err M E-CHECK-TYPENAME (nm-next M p) 0)
          :else
          (let [b0 (nm-first M p)
                M1 (ck-sig-params M b0 f 0)
                M2 (nm-set-ff M1 f FF-RTYPE rt)
                M3 (nm-set-nf M2 nm NF-RES (+ (* RES-FN RES-SCALE) f))]
            (ck-sig-export M3 f nm)))))

;; 1 when every child of v is an integer literal
(defn- ck-all-ints [M :vector-i64 v :i64] :i64
  (loop [c (nm-first M v)]
    (cond (= c 0) 1
          (= (nm-kind M c) ND-INT) (recur (nm-next M c))
          :else 0)))

(defn- ck-mark-items [M :vector-i64 c :i64] :vector-i64
  (if (= c 0)
    (ck-touch M)
    (let [nx (nm-next M c)
          M1 (ck-mark M c TY-I64 0)]
      (ck-mark-items M1 nx))))

;; 1 when v is a vector literal of at most 64 integer literals (R4B: 128)
(defn- ck-def-vec [M :vector-i64 v :i64] :i64
  (cond (nm-ne (nm-kind M v) ND-VEC) 0
        (> (nm-count M v) 128) 0
        :else (ck-all-ints M v)))

(defn- ck-sig-def [M :vector-i64 f :i64] :vector-i64
  (let [n (nm-ff M f FF-NODE)
        nm (nm-nth M n 1)
        v (nm-nth M n 2)
        k (nm-kind M v)]
    (cond (nm-ne (nm-count M n) 3) (ck-err M E-CHECK-DEF nm 0)
          (= k ND-INT) (nm-set-ff (ck-mark M v TY-I64 0) f FF-RTYPE TY-I64)
          (= k ND-STR) (nm-set-ff (ck-mark M v TY-STR 0) f FF-RTYPE TY-STR)
          (= k ND-KW) (nm-set-ff (ck-mark M v TY-KW 0) f FF-RTYPE TY-KW)   ; R6B: (def NAME :ns/k), a keyword constant
          (= (ck-def-vec M v) 1)
          (let [c (nm-first M v)
                M1 (ck-mark-items M c)
                M2 (ck-mark M1 v TY-VEC HD-VECLIT)]
            (nm-set-ff M2 f FF-RTYPE TY-VEC))
          ;; R6B: a set or map literal of constant data (keywords, strings, integers, nested such collections) is OPAQUE:
          ;; FF-RTYPE 0, nothing is checked or emitted, and a REFERENCE to it is E2124 there (kotoba.compiler.schema's unused
          ;; `primitives`); anything else stays E2124 at the def (stage-0 checks a def's value even when nothing uses it)
          (and (or (= k ND-SET) (= k ND-MAP)) (ck-r6b-const? M v)) (nm-set-ff M f FF-RTYPE 0)
          :else (ck-err M E-CHECK-DEF nm 0))))
(defn- ck-r6b-const? [M :vector-i64 v :i64] :bool
  (let [k (nm-kind M v)]
    (cond (or (= k ND-KW) (= k ND-STR) (= k ND-INT)) true
          (or (= k ND-SET) (= k ND-MAP) (= k ND-VEC))
          (loop [c (nm-first M v)] (cond (zero? c) true (ck-r6b-const? M c) (recur (nm-next M c)) :else false))
          :else false)))

(defn- ck-sigs [M :vector-i64 f :i64] :vector-i64
  (cond
    (>= f (vector-at M MM-FN-N)) (ck-touch M)
    (nm-failed M) (ck-touch M)
    (= (nm-ff M f FF-KIND) FK-DEF) (ck-sigs (ck-sig-def M f) (+ f 1))
    :else (ck-sigs (ck-sig-defn M f) (+ f 1))))

;; ---------------------------------------------------------------------------------------------------------
;; pass B: bodies
;; ---------------------------------------------------------------------------------------------------------
;; bind params from binder b to slots k+1..; h0 = scope height at the function start
(defn- ck-bind-params [M :vector-i64 b :i64 f :i64 k :i64 h0 :i64] :vector-i64
  (cond
    (= b 0) (ck-touch M)
    (nm-failed M) (ck-touch M)
    :else
    (let [nx (nm-next M (nm-next M b))
          ty (ck-pt M f k)
          M1 (ck-binder-ok M b h0)
          M2 (ck-bind M1 b (+ k 1) ty f)]
      (ck-bind-params M2 nx f (+ k 1) h0))))

;; the body's type ty against the declared result rt (0 = the body never yields: always fine). R1: rt = -1
;; (unannotated) takes the body's type; a body that never yields cannot give one (E2126).
(defn- ck-body-result [M :vector-i64 nm :i64 ty :i64 rt :i64 f :i64] :vector-i64
  (cond (= (* (nm-eqi rt -1) (nm-eqi ty 0)) 1) (ck-err M E-CHECK-INFER nm 0)
        (= rt -1) (nm-set-ff M f FF-RTYPE ty)   ; R4: f itself (a multi-arity clause is not SF-FN of its name)
        (= ty 0) (ck-touch M)
        (= ty rt) (ck-touch M)
        :else (ck-err M E-CHECK-RESULT nm rt)))

(defn- ck-body [M :vector-i64 f :i64] :vector-i64
  (ck-done-set (ck-r5b-body0 (ck-state-reset (ck-done-set M f 2) f) f) f 1))
(defn- ck-body0 [M :vector-i64 f :i64] :vector-i64
  (let [n (nm-ff M f FF-NODE)
        nm (nm-nth M n 1)
        p (nm-nth M n 2)
        b0 (nm-first M p)
        body (nm-nth M n 4)
        np (nm-ff M f FF-NPARAMS)
        rt (nm-ff M f FF-RTYPE)
        h0 (nm-scope-height M)
        M1 (nm-set-ff M f FF-NSLOTS np)
        M2 (nm-set-ff M1 f FF-FUEL 0)
        M3 (ck-bind-params M2 b0 f 0 h0)
        M4 (ck-expr M3 body (+ (* f 1024) (+ np 1)) (+ (* p 2) 1))
        ty (ck-ty M4)
        M5 (nm-unbind M4 h0)]
    (ck-body-result M5 nm ty rt f)))


(defn- ck-bodies [M :vector-i64 f :i64] :vector-i64
  (cond
    (>= f (vector-at M MM-FN-N)) (ck-touch M)
    (nm-failed M) (ck-touch M)
    (= (nm-ff M f FF-KIND) FK-DEF) (ck-bodies M (+ f 1))
    (pos? (ck-done-get M f)) (ck-bodies M (+ f 1))
    (ck-r5b-tmpl? M f) (ck-bodies M (+ f 1))   ; R5B: a stateful defn is checked as its specializations
    :else (ck-bodies (ck-body M f) (+ f 1))))

;; pass E: implicit exports become 1 (exportable) or 0; explicit ones are checked again (inferred results)
(defn- ck-exports [M :vector-i64 f :i64] :vector-i64
  (let [e (nm-ff M f FF-EXPORT)
        n (nm-ff M f FF-NODE)]
    (cond (>= f (vector-at M MM-FN-N)) (ck-touch M)
          (nm-failed M) (ck-touch M)
          (and (= e 2) (ck-multi? M f)) (ck-exports (nm-set-ff M f FF-EXPORT 0) (+ f 1))
          (and (= e 1) (ck-multi? M f)) (ck-err M E-CHECK-MULTI-EXPORT (nm-nth M n 1) 0)
          (= e 2) (ck-exports (ck-abort-export (nm-set-ff M f FF-EXPORT (ck-exportable M f)) f) (+ f 1))
          (= e 1) (ck-exports (ck-abort-export (ck-sig-export M f (nm-nth M n 1)) f) (+ f 1))
          :else (ck-exports M (+ f 1)))))

;; the whole pass: M, R0 = MM-ERR (0 when the program is admitted)
(defn ck-run [M :vector-i64 S :string] :vector-i64
  (let [M0 (ck-r5b-init (ck-r3-init M))
        M1 (ck-recs M0 S (nm-first M0 (vector-at M0 MM-ROOT)))
        M1b (if (nm-failed M1) M1 (ck-refs-check (ck-inline-scan M1)))
        M2 (ck-desugar M1b S)
        M3 (ck-hints-apply (ck-sigs M2 1))   ; R6C
        M4 (ck-last-clear (ck-bodies (ck-probe-first (ck-r5b-pass (ck-ab-pre (ck-r3-init2 M3)) S)) 1))   ; R6C: ck-last-clear, ck-probe-first
        M5 (if (nm-failed M4) M4 (ck-ab-final M4))]
    (ck-run-end (ck-exports M5 1))))

(defn- ck-run-end [M :vector-i64] :vector-i64
  (let [e (vector-at M MM-ERR)] (nm-put M MM-R0 e)))

;; =========================================================================================================
;; R3 (agent R3, 2026-10-03): values. Composite types (seed/HEADS TY-COMP-BASE, the CT table at M[MM-CT]), options
;; and results, the abort ability (throw / try, lang/abort-ability.edn: an aborting function's interface is
;; [:result T E]), typed lists, sets and maps, map and set literals, strings, pairs and the generic collection heads.
;;
;; Abort analysis, in three steps around pass B:
;;   pre   (ck-ab-pre, before pass B) a syntactic fixed point: a defn ABORTS when its body has a throw, or a call of an
;;         aborting defn, outside every try body. SF-ABORT := -1 (aborts, error type not known yet).
;;   B     the throws and aborting calls give the error types: outside a try body they set E of the function
;;         (SF-ABORT := E; a second, different E is E2129), inside one they set E of the innermost try. A call of an
;;         aborting callee whose E is not known yet checks that callee first (ck-ensure: an on-demand body check with
;;         the caller's locals hidden, 20-names nm-scope-hide), unless it is being checked (recursion).
;;   final (ck-ab-final) E flows from callees to callers until nothing changes; then every aborting call outside a try
;;         body must agree with its caller's E (E2129), and every aborting defn must have one (E2133).
;; Recur: an abort not caught inside the innermost loop body (a try around the loop does not count), before a recur on the same path, is refused (E2106): the elaborated result match
;; would take the recur out of tail position. Each function check counts such aborts (ck-s-aborts); a let binding, an
;; if/cond test, an and/or operand or a do form that raised the count clears the tail bit of what follows it.
;; =========================================================================================================

;; ---- the check-state block (HEAP; M[MM-CK-STATE] = the current one; an on-demand nested check pushes another) ----
(def ck-s-tryd 0)   ; try depth inside the function being checked
(def ck-s-trye 1)   ; error type of the innermost try body so far (0 = none yet)
(def ck-s-tryn 2)   ; aborting forms met in the innermost try body
(def ck-s-aborts 3) ; aborting forms not caught inside the innermost loop body (monotonic: the recur rule)
(def ck-s-done 4)   ; HEAP address of the per-FN table: 0 not checked, 2 being checked, 1 checked
(def ck-s-fn 5)     ; the function being checked
(def ck-s-tryx 6)   ; the explicit catch type of the innermost try (0 = none)
(def ck-s-loopd 7)  ; the try depth at the entry of the innermost loop (0 = the function body)
(def ck-s-known 8)  ; R4: HEAP address of the 256-word table slot -> 2 * lifted FN + 1 when its closure is built (0 = none)
(def ck-s-lbody 9)  ; R4: the body of the let whose bindings are being checked (the scan region of a known function)
(def ck-s-w 16)     ; R5B: words 10..13 are the effects state (ck-s-hslot .. ck-s-andor, R5B block)

(defn- ck-sg [M :vector-i64 k :i64] :i64 (vector-at M (+ (vector-at M MM-CK-STATE) k)))
(defn- ck-ss [M :vector-i64 k :i64 v :i64] :vector-i64 (nm-put M (+ (vector-at M MM-CK-STATE) k) v))
(defn- ck-aborts [M :vector-i64] :i64 (ck-sg M ck-s-aborts))
;; ctx without its tail bit when an abort was counted since a0
(defn- ck-ctx-after [M :vector-i64 a0 :i64 ctx :i64] :i64
  (if (> (ck-aborts M) a0) (- ctx (bit-and ctx 1)) ctx))

(defn- ck-done-get [M :vector-i64 f :i64] :i64 (vector-at M (+ (ck-sg M ck-s-done) f)))
(defn- ck-done-set [M :vector-i64 f :i64 v :i64] :vector-i64 (nm-put M (+ (ck-sg M ck-s-done) f) v))

;; reset the current block for a check of f
(defn- ck-state-reset [M :vector-i64 f :i64] :vector-i64
  (-> M (ck-ss ck-s-tryd 0) (ck-ss ck-s-trye 0) (ck-ss ck-s-tryn 0) (ck-ss ck-s-aborts 0) (ck-ss ck-s-fn f) (ck-ss ck-s-tryx 0)
      (ck-ss ck-s-loopd 0)
      ;; R5B: no handler, loop depth 0, not inside and/or
      (ck-ss ck-s-hslot 0) (ck-ss ck-s-hfn 0) (ck-ss ck-s-loopn 0) (ck-ss ck-s-andor 0)))

;; the CT table and the first state block (before anything is checked)
(defn- ck-r3-init [M :vector-i64] :vector-i64
  (let [M1 (mem-alloc M (* CT-CAP CT-W))
        ct (ck-r M1)
        M2 (-> M1 (nm-put MM-CT ct) (nm-put (+ ct CT-N) 1))
        M3 (mem-alloc M2 ck-s-w)
        st (ck-r M3)
        M4 (mem-alloc (nm-put M3 MM-CK-STATE st) 256)]
    (ck-ss M4 ck-s-known (ck-r M4))))
;; the done table (R4: MM-FN-CAP words: lifted fn literals add FN records while bodies are checked)
(defn- ck-r3-init2 [M :vector-i64] :vector-i64
  (let [M1 (mem-alloc M (+ MM-FN-CAP 1))
        d (ck-r M1)]
    (ck-ss M1 ck-s-done d)))

;; ---- composite types ----
;; field fld of the CT record of composite type ty (0 for any other type)
(defn- ck-ct [M :vector-i64 ty :i64 fld :i64] :i64
  (if (< ty TY-COMP-BASE) 0 (vector-at M (+ (vector-at M MM-CT) (* (- ty TY-COMP-BASE) CT-W) fld))))
(defn- ck-tcon [M :vector-i64 ty :i64] :i64 (ck-ct M ty CT-CTOR))
(defn- ck-ta [M :vector-i64 ty :i64] :i64 (ck-ct M ty CT-A))
(defn- ck-tb [M :vector-i64 ty :i64] :i64 (ck-ct M ty CT-B))

;; the CT index of (c a b), 0 when absent
(defn- ck-ct-find [M :vector-i64 c :i64 a :i64 b :i64] :i64
  (let [base (vector-at M MM-CT)
        n (vector-at M (+ base CT-N))]
    (loop [i 1]
      (let [r (+ base (* i CT-W))]
        (cond (>= i n) 0
              (and (= (vector-at M (+ r CT-CTOR)) c) (= (vector-at M (+ r CT-A)) a) (= (vector-at M (+ r CT-B)) b)) i
              :else (recur (inc i)))))))
;; R0 = the type code of (c a b), interned in CT (E101 region 8 when CT is full)
(defn- ck-ct-intern [M :vector-i64 c :i64 a :i64 b :i64] :vector-i64
  (let [i (ck-ct-find M c a b)
        base (vector-at M MM-CT)
        n (vector-at M (+ base CT-N))
        r (+ base (* n CT-W))]
    (cond (pos? i) (nm-put M MM-R0 (+ TY-COMP-BASE i))
          (>= n CT-CAP) (ck-err M E-HEAP-REGION 0 8)
          :else (-> M (nm-put (+ r CT-CTOR) c) (nm-put (+ r CT-A) a) (nm-put (+ r CT-B) b) (nm-put (+ base CT-N) (inc n))
                    (nm-put MM-R0 (+ TY-COMP-BASE n))))))

;; a key or set item type: compared by value (i64 bool keyword) or by bytes (string)
(defn- ck-keyable [ty :i64] :bool (or (= ty TY-I64) (= ty TY-BOOL) (= ty TY-KW) (= ty TY-STR)))

(defn- ck-tc-of [k :i64] :i64
  (case k KW-OPTION TC-OPTION KW-RESULT TC-RESULT KW-LIST TC-LIST KW-MAP TC-MAP KW-SET TC-SET 0))
(defn- ck-tc-arity [c :i64] :i64 (if (or (= c TC-RESULT) (= c TC-MAP)) 2 1))

;; [:option T] [:list T] [:set T] [:result T E] [:map K V]: R0 = the type; a malformed form throws its node
(defn- ck-tf-comp [M :vector-i64 t :i64 k :i64] :vector-i64
  (let [c (ck-tc-of k)
        na (ck-tc-arity c)]
    (if (nm-ne (nm-count M t) (+ na 1))
      (throw t)
      (let [M1 (ck-tf M (nm-nth M t 1))
            a (ck-ty M1)
            M2 (if (= na 2) (ck-tf M1 (nm-nth M1 t 2)) M1)
            b (if (= na 2) (ck-ty M2) 0)]
        (cond (nm-failed M2) (throw t)
              (and (or (= c TC-SET) (= c TC-MAP)) (not (ck-keyable a))) (throw t)
              :else (ck-ct-intern M2 c a b))))))

;; ---- small helpers for the R3 heads ----
(defn- ck-order-head? [hd :i64] :bool (or (= hd HD-SET-NTH) (= hd HD-MAP-KEYS) (= hd HD-MAP-VALS)))
;; check expression c; when want > 0 its type must be want (a bottom passes), else E2104 at hn. R0 = its type.
(defn- ck-want [M :vector-i64 c :i64 fx :i64 want :i64 hn :i64] :vector-i64
  (let [M1 (ck-expr M c fx 0)
        ty (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (zero? want) M1
          (zero? ty) M1
          (= ty want) M1
          :else (ck-err M1 E-CHECK-TYPE hn want))))

;; the type argument of n (its 2nd child) must be a ctor type: R0 = the type (0 after an error)
(defn- ck-targ [M :vector-i64 n :i64 ctor :i64] :vector-i64
  (let [tn (nm-nth M n 1)
        M1 (ck-tform M tn)
        ty (ck-ty M1)]
    (cond (nm-failed M1) (nm-put M1 MM-R0 0)
          (zero? ty) (ck-err M1 E-CHECK-TYPENAME tn 0)
          (nm-ne (ck-tcon M1 ty) ctor) (ck-err M1 E-CHECK-TYPE tn ty)
          ;; map equality compares values by value or bytes: V must be i64 bool keyword string (E2105)
          (and (= ctor TC-MAP) (= (nm-head-of M1 (nm-first M1 n)) HD-MAP-EQUAL) (not (ck-keyable (ck-tb M1 ty))))
          (ck-err M1 E-CHECK-TYPENAME tn 0)
          ;; the reference orders keyword items/keys by printed text, the seed by interning: no order-observing head on them
          (and (= (ck-ta M1 ty) TY-KW) (ck-order-head? (nm-head-of M1 (nm-first M1 n))))
          (ck-err M1 E-CHECK-TYPENAME tn 0)
          :else (nm-put (nm-set-nf M1 tn NF-TYPE ty) MM-R0 ty))))

;; k hidden slots for node h (their first slot goes to field fld of h: NF-TYPE of a head symbol node, NF-SYM of a
;; literal); R0 = the fx for the arguments (after the hidden slots)
(defn- ck-hide [M :vector-i64 h :i64 fld :i64 k :i64 fx :i64] :vector-i64
  (let [s (ck-fx-next fx)
        last (+ s k -1)]
    (cond (zero? k) (nm-put M MM-R0 fx)
          (> last (ck-max-slots)) (ck-err M E-CHECK-SLOTS h last)
          :else (-> M (nm-set-nf h fld s) (ck-use-slot (ck-fx-f fx) last) (nm-put MM-R0 (+ fx k))))))

;; n has na arguments (after its head), else E2103 at the head
(defn- ck-arity [M :vector-i64 n :i64 na :i64] :vector-i64
  (if (= (- (nm-count M n) 1) na) (ck-touch M) (ck-err M E-CHECK-ARITY (nm-first M n) na)))

;; ---- the R3 heads ----
(defn- ck-r3-op? [hd :i64] :bool
  (or (= hd HD-STRING-EQ) (= hd HD-STRING-SUBSTRING) (= hd HD-STRING-COMPARE) (= hd HD-STRING-INDEX-OF)
      (= hd HD-STRING-BYTE-LENGTH) (= hd HD-PAIR) (= hd HD-PAIR-FIRST) (= hd HD-PAIR-SECOND)))

(defn- ck-r3 [M :vector-i64 n :i64 hd :i64 fx :i64 ctx :i64] :vector-i64
  (cond (ck-r3-op? hd) (ck-op M n hd fx)
        (= hd HD-STRING-FROM-I64) (ck-sfrom M n fx)
        (= hd HD-OPTION-MATCH) (ck-omatch M n fx ctx)
        (= hd HD-RESULT-MATCH) (ck-rmatch M n fx ctx)
        (= hd HD-OPTION-OR) (ck-oor M n fx)
        (= hd HD-THROW) (ck-throw M n fx)
        (= hd HD-TRY) (ck-try M n fx ctx)
        (= hd HD-CATCH) (ck-err M E-CHECK-TRY (nm-first M n) 0)
        (>= hd HD-GCOUNT) (ck-gen M n hd fx)
        :else (ck-typed M n hd fx)))

;; ---- typed heads with a type argument: a table per head ----
;; the constructor of the type argument
(defn- ck-t-ctor [hd :i64] :i64
  (cond (<= hd HD-OPTION-OR) TC-OPTION
        (<= hd HD-RESULT-MATCH) TC-RESULT
        (<= hd HD-LIST-CONJ) TC-LIST
        (<= hd HD-SET-NTH) TC-SET
        :else TC-MAP))
;; value arguments after the type argument; -1 = any number of items, -2 = any number of key/value pairs
(defn- ck-t-nargs [hd :i64] :i64
  (case hd
    HD-OPTION-NONE 0
    (HD-OPTION-SOME HD-OPTION-IS-SOME HD-RESULT-OK HD-RESULT-ERR HD-RESULT-IS-OK HD-SET-COUNT HD-MAP-COUNT HD-MAP-KEYS
     HD-MAP-VALS) 1
    (HD-LIST-NEW HD-SET-NEW) -1
    HD-MAP-NEW -2
    HD-MAP-ASSOC 3
    2))
;; the kind of value argument k: 1 the type argument T, 2 its first parameter, 3 its second, 4 i64
(defn- ck-t-argk [hd :i64 k :i64] :i64
  (case hd
    (HD-OPTION-SOME HD-RESULT-OK HD-LIST-NEW HD-SET-NEW) 2
    HD-RESULT-ERR 3
    HD-MAP-NEW (if (zero? (bit-and k 1)) 2 3)
    (HD-OPTION-VALUE HD-RESULT-VALUE) (if (zero? k) 1 2)
    HD-RESULT-ERROR (if (zero? k) 1 3)
    (HD-LIST-NTH HD-SET-NTH) (if (zero? k) 1 4)
    (HD-SET-EQUAL HD-MAP-EQUAL) 1
    HD-MAP-ASSOC (case k 0 1 1 2 3)
    (if (zero? k) 1 2)))
;; the result: 1 T, 2 its first parameter, 3 bool, 4 i64, 5 [:option V], 6 [:list K], 7 [:list V], 8 its second
(defn- ck-t-resk [hd :i64] :i64
  (case hd
    (HD-OPTION-IS-SOME HD-RESULT-IS-OK HD-SET-CONTAINS HD-SET-EQUAL HD-MAP-CONTAINS HD-MAP-EQUAL) 3
    (HD-OPTION-VALUE HD-RESULT-VALUE HD-LIST-NTH HD-SET-NTH) 2
    HD-RESULT-ERROR 8
    (HD-SET-COUNT HD-MAP-COUNT) 4
    HD-MAP-GET 5 HD-MAP-KEYS 6 HD-MAP-VALS 7
    1))
;; hidden slots of the head's lowering (seed/SIR :r3-lowering)
(defn- ck-t-slots [hd :i64] :i64
  (case hd
    (HD-OPTION-VALUE HD-RESULT-VALUE HD-RESULT-ERROR) 2
    (HD-SET-CONTAINS HD-MAP-CONTAINS HD-MAP-GET HD-MAP-KEYS HD-MAP-VALS) 4
    (HD-SET-NEW HD-SET-CONJ HD-MAP-NEW HD-MAP-ASSOC HD-SET-DISJ HD-MAP-DISSOC HD-SET-EQUAL HD-MAP-EQUAL) 7
    0))

;; the type of kind k for the type argument ty
(defn- ck-kind-ty [M :vector-i64 ty :i64 k :i64] :i64
  (case k 1 ty 2 (ck-ta M ty) 3 (ck-tb M ty) 4 TY-I64 0))

;; value arguments from c (index k) of head hd with type argument ty; hn = the head node
(defn- ck-t-args [M :vector-i64 c :i64 hk :i64 fx :i64 ty :i64] :vector-i64
  (let [hd (quot hk 65536)
        k (bit-and hk 65535)]
    (cond (zero? c) (ck-touch M)
          (nm-failed M) (ck-touch M)
          :else (let [nx (nm-next M c)
                      M1 (ck-want M c fx (ck-kind-ty M ty (ck-t-argk hd k)) c)]
                  (ck-t-args M1 nx (inc hk) fx ty)))))

;; the result type of head hd for the type argument ty (lists and options are interned)
(defn- ck-t-res [M :vector-i64 hd :i64 ty :i64] :vector-i64
  (case (ck-t-resk hd)
    1 (nm-put M MM-R0 ty)
    2 (nm-put M MM-R0 (ck-ta M ty))
    8 (nm-put M MM-R0 (ck-tb M ty))
    3 (nm-put M MM-R0 TY-BOOL)
    4 (nm-put M MM-R0 TY-I64)
    5 (ck-ct-intern M TC-OPTION (ck-tb M ty) 0)
    6 (ck-ct-intern M TC-LIST (ck-ta M ty) 0)
    (ck-ct-intern M TC-LIST (ck-tb M ty) 0)))

;; the number of value arguments na fits head hd (items: at most 64 VEC words)
(defn- ck-t-count-ok [hd :i64 na :i64] :bool
  (let [want (ck-t-nargs hd)]
    (cond (= want -1) (<= na 64)
          (= want -2) (and (<= na 64) (zero? (bit-and na 1)))
          :else (= na want))))

(defn- ck-typed [M :vector-i64 n :i64 hd :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 2)
        M1 (ck-targ M n (ck-t-ctor hd))
        ty (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (< na 0) (ck-err M1 E-CHECK-ARITY h 1)
          (not (ck-t-count-ok hd na)) (ck-err M1 E-CHECK-ARITY h (+ 1 (bit-and (ck-t-nargs hd) 255)))
          :else
          (let [M2 (ck-hide M1 h NF-TYPE (ck-t-slots hd) fx)
                fx2 (ck-ty M2)
                M3 (ck-t-args M2 (nm-nth M2 n 2) (* hd 65536) fx2 ty)
                M4 (ck-t-res M3 hd ty)
                rt (ck-ty M4)
                M5 (if (or (= hd HD-OPTION-NONE) (= hd HD-LIST-NEW)) M4 (ck-fuel M4 (ck-fx-f fx)))]
            (if (nm-failed M5) (ck-touch M5) (ck-mark M5 n rt hd))))))

;; (option-or o d): o any option, d its value type (2 hidden slots)
(defn- ck-oor [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        M0 (ck-arity M n 2)
        M1 (ck-hide M0 h NF-TYPE 2 fx)
        fx2 (ck-ty M1)
        M2 (ck-expr M1 (nm-nth M1 n 1) fx2 0)
        ot (ck-ty M2)]
    (cond (nm-failed M2) (ck-touch M2)
          (nm-ne (ck-tcon M2 ot) TC-OPTION) (ck-err M2 E-CHECK-TYPE h ot)
          :else (let [M3 (ck-want M2 (nm-nth M2 n 2) fx2 (ck-ta M2 ot) h)]
                  (if (nm-failed M3) (ck-touch M3) (ck-mark (ck-fuel M3 (ck-fx-f fx)) n (ck-ta M3 ot) HD-OPTION-OR))))))

;; (string-from-i64 x) (4 hidden slots)
(defn- ck-sfrom [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        M0 (ck-arity M n 1)
        M1 (ck-hide M0 h NF-TYPE 5 fx)
        M2 (ck-want M1 (nm-nth M1 n 1) (ck-ty M1) TY-I64 h)]
    (if (nm-failed M2) (ck-touch M2) (ck-mark (ck-fuel M2 (ck-fx-f fx)) n TY-STR HD-STRING-FROM-I64))))

;; bind binder node b to the next free slot with type ty, check body e (ctx) after it; R0 = e's type
(defn- ck-bind-body [M :vector-i64 b :i64 ty :i64 e :i64 fx :i64 ctx :i64] :vector-i64
  (let [slot (ck-fx-next fx)
        h0 (nm-scope-height M)
        M1 (ck-binder-ok M b h0)
        M2 (if (> slot (ck-max-slots)) (ck-err M1 E-CHECK-SLOTS b slot) (ck-bind M1 b slot ty (ck-fx-f fx)))
        M3 (ck-expr M2 e (+ fx 1) ctx)
        te (ck-ty M3)
        M4 (nm-unbind M3 h0)]
    (nm-put M4 MM-R0 te)))

;; (option-match T o none-body x some-body)
(defn- ck-omatch [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        M0 (ck-arity M n 5)
        M1 (ck-targ M0 n TC-OPTION)
        ty (ck-ty M1)
        a0 (ck-aborts M1)
        M2 (if (nm-failed M1) M1 (ck-want M1 (nm-nth M1 n 2) fx ty h))
        ctx1 (ck-ctx-after M2 a0 ctx)
        M3 (ck-expr M2 (nm-nth M2 n 3) fx ctx1)
        tn (ck-ty M3)
        M4 (ck-bind-body M3 (nm-nth M3 n 4) (ck-ta M3 ty) (nm-nth M3 n 5) fx ctx1)
        ts (ck-ty M4)
        M5 (ck-unify M4 tn ts h)
        rt (ck-ty M5)]
    (if (nm-failed M5) (ck-touch M5) (ck-mark (ck-fuel M5 (ck-fx-f fx)) n rt HD-OPTION-MATCH))))

;; (result-match-of R r v ok-body e err-body)
(defn- ck-rmatch [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        M0 (ck-arity M n 6)
        M1 (ck-targ M0 n TC-RESULT)
        ty (ck-ty M1)
        a0 (ck-aborts M1)
        M2 (if (nm-failed M1) M1 (ck-want M1 (nm-nth M1 n 2) fx ty h))
        ctx1 (ck-ctx-after M2 a0 ctx)
        M3 (ck-bind-body M2 (nm-nth M2 n 3) (ck-ta M2 ty) (nm-nth M2 n 4) fx ctx1)
        tok (ck-ty M3)
        M4 (ck-bind-body M3 (nm-nth M3 n 5) (ck-tb M3 ty) (nm-nth M3 n 6) fx ctx1)
        ter (ck-ty M4)
        M5 (ck-unify M4 tok ter h)
        rt (ck-ty M5)]
    (if (nm-failed M5) (ck-touch M5) (ck-mark (ck-fuel M5 (ck-fx-f fx)) n rt HD-RESULT-MATCH))))

;; ---- map and set literals ----
;; items from c must have type want (k = index for the alternation of a map: want = kt at even k, vt at odd k)
(defn- ck-lit-items [M :vector-i64 c :i64 fx :i64 kt :i64 vt :i64 k :i64] :vector-i64
  (cond (zero? c) (ck-touch M)
        (nm-failed M) (ck-touch M)
        :else (let [want (if (zero? (bit-and k 1)) kt vt)
                    nx (nm-next M c)]
                (ck-lit-items (ck-want M c fx want c) nx fx kt vt (inc k)))))

;; #{x ..}: [:set :keyword], at most 32 items (7 hidden slots: the first in NF-SYM of the node)
(defn- ck-setlit [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [c (nm-first M n)
        M1 (ck-hide M n NF-SYM 7 fx)
        fx2 (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (zero? c) (ck-err M1 E-CHECK-ABORT-INFER n 0)
          (> (nm-count M1 n) 32) (ck-err M1 E-CHECK-VECLIT n 0)
          :else
          (let [M2 (ck-expr M1 c fx2 0)
                t (ck-ty M2)]
            (cond (nm-failed M2) (ck-touch M2)
                  ;; the reference: a #{..} literal is [:set :keyword]; typed-set-new builds the others
                  (nm-ne t TY-KW) (ck-err M2 E-CHECK-TYPE c TY-KW)
                  :else
                  (let [M3 (ck-lit-items M2 (nm-next M2 c) fx2 t t 1)
                        M4 (ck-ct-intern M3 TC-SET t 0)
                        st (ck-ty M4)]
                    (if (nm-failed M4) (ck-touch M4) (ck-mark (ck-fuel M4 (ck-fx-f fx)) n st HD-SETLIT))))))))

;; {k v ..}: [:map K V] from the first entry, K :i64 or :string (the reference reads a keyword-keyed literal as a pair
;; list or a record), at most 31 entries (7 hidden slots: the first in NF-SYM of the node)
(defn- ck-maplit [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [c (nm-first M n)
        M1 (ck-hide M n NF-SYM 7 fx)
        fx2 (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (zero? c) (ck-err M1 E-CHECK-ABORT-INFER n 0)
          (nm-ne (bit-and (nm-count M1 n) 1) 0) (ck-err M1 E-READ-MAP n 0)
          (> (nm-count M1 n) 62) (ck-err M1 E-CHECK-VECLIT n 0)
          :else
          (let [M2 (ck-expr M1 c fx2 0)
                kt (ck-ty M2)
                M3 (ck-expr M2 (nm-next M2 c) fx2 0)
                vt (ck-ty M3)]
            (cond (nm-failed M3) (ck-touch M3)
                  (not (or (= kt TY-I64) (= kt TY-STR))) (ck-err M3 E-CHECK-TYPENAME c 0)
                  (zero? vt) (ck-err M3 E-CHECK-ABORT-INFER n 0)
                  :else
                  (let [M4 (ck-lit-items M3 (nm-next M3 (nm-next M3 c)) fx2 kt vt 0)
                        M5 (ck-ct-intern M4 TC-MAP kt vt)
                        mt (ck-ty M5)]
                    (if (nm-failed M5) (ck-touch M5) (ck-mark (ck-fuel M5 (ck-fx-f fx)) n mt HD-MAPLIT))))))))

;; ---- the generic collection heads: the first argument's type decides (6 = :vector-i64) ----
(defn- ck-g-slots [hd :i64] :i64
  (case hd HD-GCOUNT 0 HD-NTH 3 (HD-CONTAINS HD-KEYS HD-VALS HD-POP) 4 (HD-CONJ HD-DISJ HD-DISSOC) 7 HD-PEEK 1 0))
(defn- ck-g-kind [M :vector-i64 ty :i64] :i64 (if (= ty TY-VEC) 6 (ck-tcon M ty)))

;; the result type of generic head hd over a collection of type ty (kind ck); 0 when the head does not apply
(defn- ck-g-res [M :vector-i64 hd :i64 ty :i64 ck :i64 na :i64] :vector-i64
  (let [vec? (= ck 6)
        lst? (= ck TC-LIST)
        set? (= ck TC-SET)
        map? (= ck TC-MAP)]
    (case hd
      HD-GCOUNT (nm-put M MM-R0 (if (and (= na 1) (or vec? lst? set? map?)) TY-I64 0))
      HD-NTH (nm-put M MM-R0 (cond (and vec? (or (= na 2) (= na 3))) TY-I64
                                   (and lst? (or (= na 2) (= na 3))) (ck-ta M ty)
                                   (and set? (= na 2) (nm-ne (ck-ta M ty) TY-KW)) (ck-ta M ty)
                                   :else 0))
      HD-CONTAINS (nm-put M MM-R0 (if (and (= na 2) map?) TY-BOOL 0))
      HD-CONJ (nm-put M MM-R0 (if (and (>= na 2) (or vec? lst? set?)) ty 0))
      HD-DISJ (nm-put M MM-R0 (if (and (>= na 2) set?) ty 0))
      HD-DISSOC (nm-put M MM-R0 (if (and (= na 2) map?) ty 0))
      HD-KEYS (if (and (= na 1) map? (nm-ne (ck-ta M ty) TY-KW)) (ck-ct-intern M TC-LIST (ck-ta M ty) 0) (nm-put M MM-R0 0))
      HD-VALS (if (and (= na 1) map? (nm-ne (ck-ta M ty) TY-KW)) (ck-ct-intern M TC-LIST (ck-tb M ty) 0) (nm-put M MM-R0 0))
      HD-PEEK (nm-put M MM-R0 (cond (and (= na 1) vec?) TY-I64 (and (= na 1) lst?) (ck-ta M ty) :else 0))
      HD-POP (nm-put M MM-R0 (if (and (= na 1) (or vec? lst?)) ty 0))
      (nm-put M MM-R0 0))))

;; the type of argument k >= 1 of generic head hd over ty (kind ck)
(defn- ck-g-arg [M :vector-i64 hd :i64 ty :i64 ck :i64 k :i64] :i64
  (cond (= ck 6) TY-I64
        (and (= hd HD-NTH) (= k 1)) TY-I64
        :else (ck-ta M ty)))

(defn- ck-g-args [M :vector-i64 c :i64 hk :i64 fx :i64 ty :i64] :vector-i64
  (let [hd (quot hk 65536)
        k (bit-and hk 65535)]
    (cond (zero? c) (ck-touch M)
          (nm-failed M) (ck-touch M)
          :else (let [nx (nm-next M c)
                      M1 (ck-want M c fx (ck-g-arg M hd ty (ck-g-kind M ty) k) c)]
                  (ck-g-args M1 nx (inc hk) fx ty)))))

(defn- ck-gen [M :vector-i64 n :i64 hd :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 1)
        a (nm-next M h)
        M1 (ck-hide M h NF-TYPE (ck-g-slots hd) fx)
        fx2 (ck-ty M1)]
    (if (or (nm-failed M1) (zero? a))
      (if (zero? a) (ck-err M1 E-CHECK-ARITY h 1) (ck-touch M1))
      (let [M2 (ck-expr M1 a fx2 0)
            ty (ck-ty M2)
            M3 (ck-g-res M2 hd ty (ck-g-kind M2 ty) na)
            rt (ck-ty M3)]
        (cond (nm-failed M3) (ck-touch M3)
              (and (zero? rt) (= hd HD-NTH) (= ty TY-DOC) (= na 2)) (ck-r6b-nth M3 n fx ck-r6b-h-__r6-dnth)   ; R6B: (nth d i) on a :document
              (and (zero? rt) (= hd HD-GCOUNT) (= ty TY-DOC) (= na 1)) (ck-r6b-nth M3 n fx ck-r6b-h-document-count)   ; R6B: (count d)
              (and (zero? rt) (= hd HD-KEYS) (= ty TY-DOC) (= na 1)) (ck-r6b-nth M3 n fx ck-r6b-h-__r6-dkeys)   ; R6B: (keys d)
              (and (zero? rt) (= hd HD-CONTAINS) (= ty TY-DOC) (= na 2))   ; R6B: (contains? d k), k a document or keyword
              (ck-r6b-nth (ck-r6b-keyed M3 n) n fx ck-r6b-h-document-contains)
              (zero? rt) (ck-err M3 E-CHECK-TYPE h ty)
              :else (let [M4 (ck-g-args M3 (nm-next M3 a) (+ (* hd 65536) 1) fx2 ty)]
                      (if (nm-failed M4) (ck-touch M4) (ck-mark (ck-fuel M4 (ck-fx-f fx)) n rt hd))))))))

;; (get m k d) on a map (5 hidden slots): the value of k, or d
(defn- ck-gget [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        M1 (ck-hide M h NF-TYPE 5 fx)
        fx2 (ck-ty M1)
        M2 (ck-expr M1 (nm-nth M1 n 1) fx2 0)
        ty (ck-ty M2)]
    (cond (nm-failed M2) (ck-touch M2)
          (nm-ne (ck-tcon M2 ty) TC-MAP) (ck-err M2 E-CHECK-TYPE h ty)
          :else (let [M3 (ck-want M2 (nm-nth M2 n 2) fx2 (ck-ta M2 ty) h)
                      M4 (ck-want M3 (nm-nth M3 n 3) fx2 (ck-tb M3 ty) h)]
                  (if (nm-failed M4) (ck-touch M4) (ck-mark (ck-fuel M4 (ck-fx-f fx)) n (ck-tb M4 ty) HD-GET))))))

;; (assoc m k v) on a map = typed-map-assoc (7 hidden slots); m was checked already (ck-assoc)
(defn- ck-gassoc [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        M1 (ck-hide M h NF-TYPE 7 fx)
        fx2 (ck-ty M1)
        M2 (ck-expr M1 (nm-nth M1 n 1) fx2 0)
        ty (ck-ty M2)
        M3 (ck-want M2 (nm-nth M2 n 2) fx2 (ck-ta M2 ty) h)
        M4 (ck-want M3 (nm-nth M3 n 3) fx2 (ck-tb M3 ty) h)]
    (if (nm-failed M4) (ck-touch M4) (ck-mark (ck-fuel M4 (ck-fx-f fx)) n ty HD-ASSOC))))

;; ---- abort: throw, try, aborting calls ----
;; one aborting form at head node hn with error type te (0 = not known yet)
(defn- ck-abort-at [M :vector-i64 hn :i64 te :i64] :vector-i64
  (ck-abort-at2 (if (= (ck-sg M ck-s-tryd) (ck-sg M ck-s-loopd)) (ck-ss M ck-s-aborts (inc (ck-sg M ck-s-aborts))) M) hn te))
(defn- ck-abort-at2 [M :vector-i64 hn :i64 te :i64] :vector-i64
  (if (pos? (ck-sg M ck-s-tryd))
    (let [M1 (ck-ss M ck-s-tryn (inc (ck-sg M ck-s-tryn)))
          cur (ck-sg M1 ck-s-trye)]
      (cond (zero? te) (if (pos? (ck-sg M1 ck-s-tryx)) M1 (ck-err M1 E-CHECK-ABORT-INFER hn 0))
            (zero? cur) (ck-ss M1 ck-s-trye te)
            (= cur te) M1
            :else (ck-err M1 E-CHECK-ABORT-TYPES hn 0)))
    (let [M1 (ck-touch M)
          fs (nm-ff M1 (ck-sg M1 ck-s-fn) FF-SYM)
          ef (nm-sf M1 fs SF-ABORT)]
      (cond (= (nm-ff M1 (ck-sg M1 ck-s-fn) FF-KIND) FK-LAMBDA) (ck-err M1 E-CHECK-FN-ABORT hn 0)
            (zero? te) (if (zero? ef) (nm-set-sf M1 fs SF-ABORT -1) M1)
            (<= ef 0) (nm-set-sf M1 fs SF-ABORT te)
            (= ef te) M1
            :else (ck-err M1 E-CHECK-ABORT-TYPES hn 0)))))

;; (throw e): bottom
(defn- ck-throw [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        M0 (ck-arity M n 1)
        M1 (if (nm-failed M0) M0 (ck-expr M0 (nm-nth M0 n 1) fx 0))
        te (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (zero? te) (ck-err M1 E-CHECK-ABORT-INFER h 0)
          :else (ck-mark (ck-fuel (ck-abort-at M1 h te) (ck-fx-f fx)) n 0 HD-THROW))))

;; 1 when node c is (catch ..) with a binder symbol (and an optional type form before it)
(defn- ck-catch-ok [M :vector-i64 c :i64] :bool
  (let [h (nm-first M c)
        cn (nm-count M c)]
    (and (= (nm-kind M c) ND-LIST) (= (nm-kind M h) ND-SYM) (= (nm-head-of M h) HD-CATCH)
         (zero? (nm-sf M (nm-sym-of M h) SF-FN))
         (or (= cn 3) (= cn 4))
         (= (nm-kind M (nm-nth M c (- cn 2))) ND-SYM))))

;; (try body (catch [E] x handler))
(defn- ck-try [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        c (nm-nth M n 2)]
    (cond (nm-ne (nm-count M n) 3) (ck-err M E-CHECK-TRY h 0)
          (not (ck-catch-ok M c)) (ck-err M E-CHECK-TRY h 0)
          :else (ck-try2 M n fx ctx))))

(defn- ck-try2 [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [body (nm-nth M n 1)
        c (nm-nth M n 2)
        ch (nm-first M c)
        cn (nm-count M c)
        tn (nm-nth M c 1)
        M0 (if (= cn 4) (ck-tform M tn) (nm-put M MM-R0 0))
        tx (ck-ty M0)
        d0 (ck-sg M0 ck-s-tryd)
        e0 (ck-sg M0 ck-s-trye)
        n0 (ck-sg M0 ck-s-tryn)
        x0 (ck-sg M0 ck-s-tryx)
        M1 (-> M0 (ck-ss ck-s-tryd (inc d0)) (ck-ss ck-s-trye 0) (ck-ss ck-s-tryn 0) (ck-ss ck-s-tryx tx))
        M2 (ck-expr M1 body fx (- ctx (bit-and ctx 1)))
        tb (ck-ty M2)
        te (ck-sg M2 ck-s-trye)
        tcount (ck-sg M2 ck-s-tryn)
        M3 (-> M2 (ck-ss ck-s-tryd d0) (ck-ss ck-s-trye e0) (ck-ss ck-s-tryn n0) (ck-ss ck-s-tryx x0))
        E (if (pos? tx) tx te)]
    (cond (nm-failed M3) (ck-touch M3)
          (and (= cn 4) (zero? tx)) (ck-err M3 E-CHECK-TYPENAME tn 0)
          (and (zero? tcount) (zero? tx)) (ck-err M3 E-CHECK-ABORT-NONE ch 0)   ; R6C: a typed catch may guard a body that cannot abort (stage-0 admits it)
          (and (pos? tx) (pos? te) (nm-ne tx te)) (ck-err M3 E-CHECK-TYPE tn te)
          (zero? E) (ck-err M3 E-CHECK-ABORT-INFER ch 0)
          :else (ck-try3 M3 n tb E fx ctx))))

;; the handler: binder x : E in the next free slot; the try's type joins the body's (tb) and the handler's
(defn- ck-try3 [M :vector-i64 n :i64 tb :i64 E :i64 fx :i64 ctx :i64] :vector-i64
  (let [c (nm-nth M n 2)
        cn (nm-count M c)
        M1 (ck-bind-body M (nm-nth M c (- cn 2)) E (nm-nth M c (- cn 1)) fx ctx)
        th (ck-ty M1)
        M2 (ck-mark M1 c 0 HD-CATCH)
        M3 (ck-unify M2 tb th (nm-first M2 n))
        ty (ck-ty M3)]
    (if (nm-failed M3) (ck-touch M3) (ck-mark M3 n ty HD-TRY))))

;; after a user call (R0 = its type): when the callee aborts, a hidden slot for its result and the abort bookkeeping
(defn- ck-call-abort [M :vector-i64 n :i64 fi :i64 fx :i64] :vector-i64
  (let [ty (ck-ty M)
        e (nm-sf M (nm-ff M fi FF-SYM) SF-ABORT)
        h (nm-first M n)]
    (if (or (zero? e) (nm-failed M))
      M
      (let [M1 (ck-hide M h NF-TYPE 1 fx)
            M2 (ck-abort-at M1 h (if (pos? e) e 0))]
        (nm-put M2 MM-R0 ty)))))

;; an aborting callee g whose error type is not known yet and that was not checked: check it now (its body, with the
;; caller's locals hidden and a fresh state block), so the caller sees its E
;; R4: also a callee whose result type is still to be inferred (a later clause of a multi-arity defn, a later defn)
(defn- ck-ensure [M :vector-i64 g :i64] :vector-i64
  (if (and (or (= (nm-sf M (nm-ff M g FF-SYM) SF-ABORT) -1) (= (nm-ff M g FF-RTYPE) -1)) (zero? (ck-done-get M g)) (ck-is-defn M g))
    (ck-nested M g)
    M))
(defn- ck-nested [M :vector-i64 g :i64] :vector-i64
  (let [old (vector-at M MM-CK-STATE)
        done (ck-sg M ck-s-done)
        sv (nm-scope-saved M)
        M1 (nm-scope-hide M)
        M2 (mem-alloc M1 ck-s-w)
        st (ck-r M2)
        M2b (mem-alloc M2 256)
        M3 (-> M2b (nm-put MM-CK-STATE st) (ck-ss ck-s-done done) (ck-ss ck-s-known (ck-r M2b)))
        M4 (ck-body M3 g)
        M5 (nm-put M4 MM-CK-STATE old)]
    (nm-scope-show M5 sv)))

;; ---- the abort walks (pre / final): a read-only walk over a body that skips try bodies ----
;; mode 0: 1 when an aborting form (throw, call of an aborting defn) is met; mode 1: the first known E of an aborting
;; callee; mode 2: the head node of an aborting call whose known E differs from ef. 0 = nothing.
(defn- ck-aw [M :vector-i64 n :i64 mode :i64 ef :i64] :i64
  (let [k (nm-kind M n)]
    (cond (= k ND-LIST) (ck-aw-list M n mode ef)
          (or (= k ND-VEC) (= k ND-MAP) (= k ND-SET)) (ck-aw-kids M (nm-first M n) mode ef)
          :else 0)))
(defn- ck-aw-kids [M :vector-i64 c :i64 mode :i64 ef :i64] :i64
  (loop [x c]
    (if (zero? x)
      0
      (let [r (ck-aw M x mode ef)]
        (if (zero? r) (recur (nm-next M x)) r)))))
(defn- ck-aw-site [M :vector-i64 h :i64 mode :i64 ef :i64] :i64
  (let [s (nm-sym-of M h)
        fi (nm-sf M s SF-FN)
        e (nm-sf M (nm-ff M fi FF-SYM) SF-ABORT)]
    (cond (= (ck-callable M fi) 1)
          (cond (zero? e) 0
                (= mode 0) 1
                (= mode 1) (if (pos? e) e 0)
                (and (pos? e) (nm-ne e ef)) h
                :else 0)
          (and (= (nm-sf M s SF-HEAD) HD-THROW) (= mode 0)) 1
          :else 0)))
(defn- ck-aw-list [M :vector-i64 n :i64 mode :i64 ef :i64] :i64
  (let [h (nm-first M n)
        s (nm-sym-of M h)
        sym? (= (nm-kind M h) ND-SYM)
        site (if sym? (ck-aw-site M h mode ef) 0)]
    (cond (nm-ne site 0) site
          (ck-fn-form? M n) 0
          (and sym? (zero? (nm-sf M s SF-FN)) (= (nm-sf M s SF-HEAD) HD-TRY)) (ck-aw-kids M (nm-nth M n 2) mode ef)
          :else (ck-aw-kids M h mode ef))))

(defn- ck-defn-body [M :vector-i64 f :i64] :i64 (nm-nth M (nm-ff M f FF-NODE) 4))
(defn- ck-is-defn [M :vector-i64 f :i64] :bool (or (= (nm-ff M f FF-KIND) FK-DEFN) (= (nm-ff M f FF-KIND) FK-PRIV)))

;; pre: one round over the FN table; R0 = how many defns became aborting
(defn- ck-ab-round [M :vector-i64 f :i64 ch :i64] :vector-i64
  (let [s (nm-ff M f FF-SYM)]
    (cond (>= f (vector-at M MM-FN-N)) (nm-put M MM-R0 ch)
          (and (ck-is-defn M f) (zero? (nm-sf M s SF-ABORT)) (= (ck-aw M (ck-defn-body M f) 0 0) 1))
          (ck-ab-round (nm-set-sf M s SF-ABORT -1) (inc f) (inc ch))
          :else (ck-ab-round M (inc f) ch))))
(defn- ck-ab-pre [M :vector-i64] :vector-i64
  (let [M1 (ck-ab-round M 1 0)]
    (if (pos? (ck-r M1)) (ck-ab-pre M1) M1)))

;; final: E flows from callees to callers until nothing changes, then every defn is verified
(defn- ck-ab-fill [M :vector-i64 f :i64 ch :i64] :vector-i64
  (let [s (nm-ff M f FF-SYM)]
    (cond (>= f (vector-at M MM-FN-N)) (nm-put M MM-R0 ch)
          (and (ck-is-defn M f) (= (nm-sf M s SF-ABORT) -1) (pos? (ck-aw M (ck-defn-body M f) 1 0)))
          (ck-ab-fill (nm-set-sf M s SF-ABORT (ck-aw M (ck-defn-body M f) 1 0)) (inc f) (inc ch))
          :else (ck-ab-fill M (inc f) ch))))
(defn- ck-ab-verify [M :vector-i64 f :i64] :vector-i64
  (let [s (nm-ff M f FF-SYM)
        e (nm-sf M s SF-ABORT)
        nm (nm-nth M (nm-ff M f FF-NODE) 1)]
    (cond (>= f (vector-at M MM-FN-N)) (ck-touch M)
          (nm-failed M) (ck-touch M)
          (not (ck-is-defn M f)) (ck-ab-verify M (inc f))
          (zero? e) (ck-ab-verify M (inc f))
          (neg? e) (ck-err M E-CHECK-ABORT-INFER nm 0)
          (pos? (ck-aw M (ck-defn-body M f) 2 e)) (ck-err M E-CHECK-ABORT-TYPES (ck-aw M (ck-defn-body M f) 2 e) 0)
          :else (ck-ab-verify M (inc f)))))
(defn- ck-ab-final [M :vector-i64] :vector-i64
  (let [M1 (ck-ab-fill M 1 0)]
    (if (pos? (ck-r M1)) (ck-ab-final M1) (ck-ab-verify M1 1))))

;; an exported defn (explicitly, or implicitly with an exportable signature) must not abort (E2130)
(defn- ck-abort-export [M :vector-i64 f :i64] :vector-i64
  (if (and (= (nm-ff M f FF-EXPORT) 1) (nm-ne (nm-sf M (nm-ff M f FF-SYM) SF-ABORT) 0))
    (ck-err M E-CHECK-ABORT-EXPORT (nm-nth M (nm-ff M f FF-NODE) 1) 0)
    (ck-touch M)))

;; =========================================================================================================
;; R4 (agent R4, 2026-10-03): functions (seed/HEADS heads 131-141, TC-FN; seed/SIR :r4-lowering). Written in the R3
;; language (the R3 seed compiles it).
;;   fn literals: lambda-lifted here into FN records FK-LAMBDA (+ FK-ADAPTER when 2 or more locals are captured);
;;     parameters first, then the captured locals of the enclosing function (a syntactic scan, ck-cap-walk); the body is
;;     checked in place with the enclosing bindings hidden (as ck-nested does), its own state block and known table.
;;   known functions: a let-bound fn literal; (f a ..) is a direct call (HD-CALLK); its closure is built only when the
;;     rest of the let names f in a value position or inside a nested fn (ck-uses-chain), else the literal's NF-RES is 0.
;;   fn values: (g a ..) for a fn-typed local or a computed head, invoke, apply, fn-ref.
;;   map / filter / reduce: typed heads whose lowering is an inline loop (5 hidden slots on the head symbol node).
;;   multi-arity and variadic defns: one FN record per clause (20-names); ck-pick chooses the clause of a call.
;; =========================================================================================================

;; ---- fn types: [:fn [[P ..] R]] = TC-FN (CT-A R, CT-B the TC-PLIST chain) ----
;; any type but :bytes and callables (the reference: `callable parameter types cannot be callable or linear resources`,
;; `callable results cannot be callable ..`, measured on stage-0)
(defn- ck-fn-ok-type? [M :vector-i64 ty :i64] :bool
  (and (pos? ty) (not= ty TY-BYTES) (not= ty (ck-poison)) (not= (ck-tcon M ty) TC-FN)))
(defn- ck-fn-arity [M :vector-i64 ty :i64] :i64
  (loop [b (ck-tb M ty) k 0] (if (zero? b) k (recur (ck-tb M b) (inc k)))))
;; the type of parameter i of fn type ty (0 past the end)
(defn- ck-fn-param [M :vector-i64 ty :i64 i :i64] :i64
  (loop [b (ck-tb M ty) k 0]
    (cond (zero? b) 0 (= k i) (ck-ta M b) :else (recur (ck-tb M b) (inc k)))))
;; R0 = the TC-PLIST chain of the types PT(i) .. PT(m-1) of FN f
(defn- ck-plist-of [M :vector-i64 f :i64 i :i64 m :i64] :vector-i64
  (if (>= i m)
    (nm-put M MM-R0 0)
    (let [M1 (ck-plist-of M f (inc i) m)] (ck-ct-intern M1 TC-PLIST (nm-ff M1 f (+ FF-PT0 i)) (ck-r M1)))))
;; R0 = [:fn [[PT0 .. PT(m-1)] rt]] of FN f
(defn- ck-fn-type-of [M :vector-i64 f :i64 m :i64 rt :i64] :vector-i64
  (let [M1 (ck-plist-of M f 0 m)] (ck-ct-intern M1 TC-FN rt (ck-r M1))))

;; [:fn [[P ..] R]]: one clause, 0..4 admissible parameter types, an admissible result; a malformed form throws its node
(defn- ck-tf-plist [M :vector-i64 c :i64 t :i64] :vector-i64
  (if (zero? c)
    (nm-put M MM-R0 0)
    (let [M1 (ck-tf-plist M (nm-next M c) t)
          rest (ck-r M1)
          M2 (ck-tf M1 c)
          p (ck-r M2)]
      (if (ck-fn-ok-type? M2 p) (ck-ct-intern M2 TC-PLIST p rest) (throw t)))))
(defn- ck-tf-fn [M :vector-i64 t :i64] :vector-i64
  (let [cl (nm-nth M t 1)
        pv (nm-first M cl)
        rn (nm-next M pv)]
    (cond (nm-ne (nm-count M t) 2) (throw t)
          (nm-ne (nm-kind M cl) ND-VEC) (throw t)
          (nm-ne (nm-count M cl) 2) (throw t)
          (nm-ne (nm-kind M pv) ND-VEC) (throw t)
          (> (nm-count M pv) 4) (throw t)
          :else (let [M1 (ck-tf-plist M (nm-first M pv) t)
                      pl (ck-r M1)
                      M2 (ck-tf M1 rn)
                      r (ck-r M2)]
                  (if (ck-fn-ok-type? M2 r) (ck-ct-intern M2 TC-FN r pl) (throw t))))))

;; ---- the known-function table of the current state block ----
(defn- ck-known-get [M :vector-i64 slot :i64] :i64
  (if (and (>= slot 0) (< slot 256)) (vector-at M (+ (ck-sg M ck-s-known) slot)) 0))
(defn- ck-known-set [M :vector-i64 slot :i64 v :i64] :vector-i64
  (if (and (>= slot 0) (< slot 256)) (nm-put M (+ (ck-sg M ck-s-known) slot) v) M))
;; true when slot holds a known function whose closure is never built
(defn- ck-known-bare? [M :vector-i64 slot :i64] :bool
  (let [k (ck-known-get M slot)] (and (pos? k) (zero? (bit-and k 1)))))

;; ---- recognisers ----
;; true when n is (fn ..) and no definition shadows `fn`
(defn- ck-fn-form? [M :vector-i64 n :i64] :bool
  (let [h (nm-first M n)
        s (nm-sym-of M h)]
    (and (= (nm-kind M n) ND-LIST) (= (nm-kind M h) ND-SYM) (= (nm-sf M s SF-HEAD) HD-FN) (zero? (nm-sf M s SF-FN)))))
;; true when FN f is a variadic clause (its parameter vector carries NF-TYPE 1, ck-ds-rest)
(defn- ck-variadic? [M :vector-i64 f :i64] :bool
  (and (ck-is-defn M f) (= (nm-nf M (nm-nth M (nm-ff M f FF-NODE) 2) NF-TYPE) 1)))
;; true when FN f belongs to a multi-arity defn (a neighbour clause shares its name) or is variadic
(defn- ck-multi? [M :vector-i64 f :i64] :bool
  (let [s (nm-ff M f FF-SYM)]
    (or (ck-variadic? M f)
        (and (> f 1) (= (nm-ff M (dec f) FF-SYM) s))
        (and (< (inc f) (vector-at M MM-FN-N)) (= (nm-ff M (inc f) FF-SYM) s)))))
;; the clause of the defn whose first clause is f0 that takes na arguments: a fixed clause of that arity, else a variadic
;; clause whose fixed part is at most na; 0 when none
(defn- ck-pick [M :vector-i64 f0 :i64 na :i64] :i64
  (let [s (nm-ff M f0 FF-SYM)
        n (vector-at M MM-FN-N)]
    (loop [g f0 var 0]
      (cond (or (>= g n) (nm-ne (nm-ff M g FF-SYM) s))
            var
            (ck-variadic? M g) (recur (inc g) (if (and (zero? var) (<= (dec (nm-ff M g FF-NPARAMS)) na)) g var))
            (= (nm-ff M g FF-NPARAMS) na) g
            :else (recur (inc g) var)))))

;; ---- desugaring ----
;; (fn [p :T ..] e ..): parameters normalized (a missing type is :i64), several body forms -> (do ..). No `&`.
(defn- ck-amp-in [M :vector-i64 p :i64] :i64
  (loop [c (nm-first M p)]
    (cond (zero? c) 0
          (and (= (nm-kind M c) ND-SYM) (= (nm-head-of M c) HD-AMP)) c
          :else (recur (nm-next M c)))))
(defn- ck-ds-fn [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        p (nm-next M h)
        e (nm-next M p)
        tok (nm-nf M h NF-TOK)]
    (cond (nm-ne (nm-kind M p) ND-VEC) (ck-err M E-CHECK-BINDINGS h 0)
          (pos? (ck-amp-in M p)) (ck-err M E-CHECK-FNVALUE (ck-amp-in M p) 0)
          (pos? (ck-non-sym M p)) (ck-err M E-CHECK-FN-PARAM (ck-non-sym M p) 0)
          (zero? e) (ck-err M E-CHECK-BODY h 0)
          (zero? (nm-next M e)) (ck-ds-params M (nm-first M p) tok)
          :else (let [M1 (ck-ds-params M (nm-first M p) tok)
                      M2 (ck-mkh M1 tok HD-DO e)]
                  (ck-link M2 p (ck-r M2))))))

;; the first child of vector p that is not a symbol (a type annotation in a fn literal's parameters), 0 when none
(defn- ck-non-sym [M :vector-i64 p :i64] :i64
  (loop [c (nm-first M p)] (cond (zero? c) 0 (nm-ne (nm-kind M c) ND-SYM) c :else (recur (nm-next M c)))))
;; [p .. & rest :T?]: `&` is unlinked, a rest without a type gets [:list :i64], the vector gets NF-TYPE 1 (variadic)
(defn- ck-ds-rest [M :vector-i64 p :i64] :vector-i64
  (let [a (ck-amp-in M p)
        r (nm-next M a)
        t (nm-next M r)]
    (cond (zero? a) (ck-touch M)
          (or (zero? r) (nm-ne (nm-kind M r) ND-SYM)) (ck-err M E-CHECK-BINDINGS a 0)
          (pos? t) (ck-err M E-CHECK-BINDINGS a 0)
          :else
          (let [M1 (if (= (nm-first M p) a) (nm-set-nf M p NF-FIRST r) (ck-link M (ck-before M p a) r))
                tok (nm-nf M1 a NF-TOK)
                M2 (ck-list-i64-form M1 r tok)]
            (nm-set-nf M2 p NF-TYPE 1)))))
;; the child of p whose next is x
(defn- ck-before [M :vector-i64 p :i64 x :i64] :i64
  (loop [c (nm-first M p)] (if (or (zero? c) (= (nm-next M c) x)) c (recur (nm-next M c)))))
;; r gets the type form [:list :i64] after it
(defn- ck-list-i64-form [M :vector-i64 r :i64 tok :i64] :vector-i64
  (let [M1 (ck-n-kw M tok KW-LIST)
        kl (ck-r M1)
        M2 (ck-n-kw M1 tok KW-I64)
        ki (ck-r M2)
        M3 (ck-chain2 M2 kl ki)
        M4 (ck-n-vec M3 tok kl)
        v (ck-r M4)
        nx (nm-next M4 r)
        M5 (ck-link M4 r v)]
    (ck-link M5 v nx)))

;; (defn NAME ([p ..] e ..) ([q ..] ..)): clause i becomes (defn NAME [p ..] e ..) as FF-NODE of FN SF-FN(NAME) + i
(defn- ck-ds-multi [M :vector-i64 S :string c :i64 hd :i64] :vector-i64
  (let [nmn (nm-nth M c 1)
        f0 (nm-sf M (nm-sym-of M nmn) SF-FN)]
    (loop [M1 M cl (nm-nth M c 2) i 0]
      (cond (nm-failed M1) (ck-touch M1)
            (zero? cl) (ck-dup-clauses M1 f0 nmn)
            (or (nm-ne (nm-kind M1 cl) ND-LIST) (nm-ne (nm-kind M1 (nm-first M1 cl)) ND-VEC)) (ck-err M1 E-CHECK-SIGNATURE nmn 0)
            :else
            (let [tok (nm-nf M1 (nm-first M1 c) NF-TOK)
                  M2 (ck-n-head M1 tok hd)
                  h (ck-r M2)
                  M3 (ck-n-copy M2 nmn)
                  nm (ck-r M3)
                  M4 (ck-link (ck-link M3 h nm) nm (nm-first M3 cl))
                  M5 (ck-n-list M4 tok h)
                  node (ck-r M5)
                  nx (nm-next M5 cl)
                  M6 (ck-ds-top1 (nm-set-ff M5 (+ f0 i) FF-NODE node) S node)]
              (recur M6 nx (inc i)))))))
;; two fixed clauses of one arity, or two variadic clauses: E2001 at the name
(defn- ck-dup-clauses [M :vector-i64 f0 :i64 nmn :i64] :vector-i64
  (let [s (nm-ff M f0 FF-SYM)
        n (vector-at M MM-FN-N)]
    (loop [a f0]
      (if (or (>= a n) (nm-ne (nm-ff M a FF-SYM) s))
        (ck-touch M)
        (let [dup (loop [b (inc a)]
                    (cond (or (>= b n) (nm-ne (nm-ff M b FF-SYM) s)) false
                          (and (ck-variadic? M a) (ck-variadic? M b)) true
                          (and (not (ck-variadic? M a)) (not (ck-variadic? M b))
                               (= (nm-ff M a FF-NPARAMS) (nm-ff M b FF-NPARAMS))) true
                          :else (recur (inc b))))]
          (if dup (ck-err M E-NAMES-DUP nmn 0) (recur (inc a))))))))

;; ---- scans ----
;; true when symbol s is used in chain c as a value: not in the head position of a list, or anywhere inside a fn literal
;; (hd = 1: c is the head of its list)
(defn- ck-uses-chain [M :vector-i64 c :i64 s :i64 hd :i64 infn :bool] :bool
  (loop [x c h hd]
    (if (zero? x)
      false
      (let [k (nm-kind M x)]
        (cond (and (= k ND-SYM) (= (nm-sym-of M x) s) (or infn (zero? h))) true
              (and (= k ND-LIST) (ck-fn-form? M x) (ck-uses-chain M (nm-first M x) s 0 true)) true
              (and (= k ND-LIST) (not (ck-fn-form? M x)) (ck-uses-chain M (nm-first M x) s 1 infn)) true
              (and (or (= k ND-VEC) (= k ND-MAP) (= k ND-SET)) (ck-uses-chain M (nm-first M x) s 0 infn)) true
              :else (recur (nm-next M x) 0))))))

;; the captured symbols of a fn literal: symbols of the chain c that are bound locals now and are not parameters of the
;; vector p, in first-occurrence order (a syntactic over-approximation: an inner rebinding of an outer name captures it)
(defn- ck-is-param [M :vector-i64 p :i64 s :i64] :bool
  (loop [c (nm-first M p)]
    (cond (zero? c) false
          (and (= (nm-kind M c) ND-SYM) (= (nm-sym-of M c) s)) true
          :else (recur (nm-next M c)))))
;; R4 rung proof (filter, reduce, fn literals capturing an i64): the captures are a :vector-i64 of symbols
(defn- ck-in-list [l :vector-i64 s :i64] :bool (pos? (vector-count (filter (fn [x] (= x s)) l))))
;; the distinct items of v in first-occurrence order
(defn- ck-dedupe [v :vector-i64] :vector-i64
  (reduce (fn [acc s] (if (ck-in-list acc s) acc (vector-conj acc s))) (vector-alloc 0) v))
;; every occurrence in chain c of a symbol bound as a local now that is not a parameter of p (duplicates kept)
(defn- ck-cap-walk [M :vector-i64 c :i64 p :i64 acc :vector-i64] :vector-i64
  (loop [x c a acc]
    (if (zero? x)
      a
      (let [k (nm-kind M x)
            s (nm-sym-of M x)]
        (cond (and (= k ND-SYM) (>= (nm-local-slot M s) 0) (not (ck-is-param M p s)))
              (recur (nm-next M x) (vector-conj a s))
              (or (= k ND-LIST) (= k ND-VEC) (= k ND-MAP) (= k ND-SET))
              (recur (nm-next M x) (ck-cap-walk M (nm-first M x) p a))
              :else (recur (nm-next M x) a))))))

;; the first occurrence in chain c of a captured symbol whose type is neither :i64 nor callable (the reference: captures are
;; i64 pair-chain words, `expected i64, got string`, measured on stage-0); 0 when every capture is admissible
(defn- ck-cap-ok? [M :vector-i64 s :i64] :bool
  (let [ty (nm-local-type M s)] (or (= ty TY-I64) (= (ck-tcon M ty) TC-FN))))
(defn- ck-bad-cap [M :vector-i64 c :i64 caps :vector-i64] :i64
  (loop [x c]
    (if (zero? x)
      0
      (let [k (nm-kind M x)
            s (nm-sym-of M x)
            sub (if (or (= k ND-LIST) (= k ND-VEC) (= k ND-MAP) (= k ND-SET)) (ck-bad-cap M (nm-first M x) caps) 0)]
        (cond (and (= k ND-SYM) (ck-in-list caps s) (not (ck-cap-ok? M s))) x
              (pos? sub) sub
              :else (recur (nm-next M x)))))))

;; ---- fn literals ----
;; parameter types of FN f from binder b (index i): the written type, or the hint's parameter i for a synthetic :i64
(defn- ck-fn-ptypes [M :vector-i64 b :i64 f :i64 i :i64 hint :i64] :vector-i64
  (if (or (zero? b) (nm-failed M))
    (ck-touch M)
    (let [t (nm-next M b)
          nx (nm-next M t)
          hp (if (pos? hint) (ck-fn-param M hint i) 0)
          M1 (if (pos? hp) (nm-put M MM-R0 hp) (ck-tform M t))
          ty (ck-r M1)]
      (if (ck-fn-ok-type? M1 ty)
        (ck-fn-ptypes (nm-set-ff M1 f (+ FF-PT0 i) ty) nx f (inc i) hint)
        (ck-err M1 E-CHECK-TYPENAME t 0)))))
;; a new FN record of kind fk for the fn node n; R0 = its index
(defn- ck-fn-new [M :vector-i64 n :i64 fk :i64 np :i64] :vector-i64
  (let [f (vector-at M MM-FN-N)]
    (if (>= f MM-FN-CAP)
      (ck-err M E-HEAP-REGION 0 6)
      (let [M1 (nm-gensym M (nm-tf M (nm-nf M n NF-TOK) TF-START) 0)
            g (ck-r M1)]
        (-> M1 (nm-set-ff f FF-SYM g) (nm-set-ff f FF-NODE n) (nm-set-ff f FF-KIND fk) (nm-set-ff f FF-NPARAMS np)
            (nm-set-ff f FF-RTYPE -1) (nm-set-ff f FF-NSLOTS np) (nm-set-ff f FF-EXPORT 0) (nm-set-ff f FF-FUEL 0)
            (nm-put MM-FN-N (inc f)) (ck-done-set f 1) (nm-put MM-R0 f))))))
;; the captures of FN f: types PT(np+i), the block [k s1 .. sk] (outer slots) in NF-TYPE of the parameter vector p
(defn- ck-fn-caps [M :vector-i64 f :i64 np :i64 caps :vector-i64 p :i64] :vector-i64
  (let [k (count caps)
        M1 (mem-alloc M (inc k))
        blk (ck-r M1)
        M2 (nm-set-nf (nm-put M1 blk k) p NF-TYPE blk)]
    (loop [M3 M2 i 0]
      (if (>= i k)
        (nm-set-ff M3 f FF-NPARAMS (+ np k))
        (let [s (vector-at caps i)]
          (recur (-> M3 (nm-set-ff f (+ FF-PT0 np i) (nm-local-type M3 s)) (nm-put (+ blk 1 i) (nm-local-slot M3 s))) (inc i)))))))
;; bind the captured symbols to slots np+1 .. of FN f (types PT(np+i))
(defn- ck-bind-caps [M :vector-i64 caps :vector-i64 f :i64 np :i64] :vector-i64
  (loop [M1 M i 0]
    (if (>= i (count caps))
      M1
      (let [slot (+ np i 1)]
        (recur (-> M1 (nm-bind (vector-at caps i) slot (nm-ff M1 f (+ FF-PT0 np i))) (ck-use-slot f slot)
                   (ck-known-set slot 0))
               (inc i))))))
;; check the body of FN f (fn node n) with the enclosing bindings hidden and a fresh state block; R0 = the body's type
(defn- ck-fn-body [M :vector-i64 n :i64 f :i64 np :i64 caps :vector-i64] :vector-i64
  (let [p (nm-nth M n 1)
        old (vector-at M MM-CK-STATE)
        done (ck-sg M ck-s-done)
        sv (nm-scope-saved M)
        M1 (nm-scope-hide M)
        M2 (mem-alloc M1 ck-s-w)
        st (ck-r M2)
        M3 (mem-alloc M2 256)
        kt (ck-r M3)
        M4 (-> M3 (nm-put MM-CK-STATE st) (ck-ss ck-s-done done) (ck-ss ck-s-known kt) (ck-state-reset f) (ck-ss ck-s-lbody 0))
        h0 (nm-scope-height M4)
        k (count caps)
        M5 (ck-bind-caps (ck-bind-params M4 (nm-first M4 p) f 0 h0) caps f np)
        M6 (ck-expr M5 (nm-nth M5 n 2) (+ (* f 1024) (+ np k 1)) (+ (* p 2) 1))
        ty (ck-ty M6)
        M7 (nm-put (nm-unbind M6 h0) MM-CK-STATE old)]
    (nm-put (nm-scope-show M7 sv) MM-R0 ty)))

;; (fn [p ..] body) with hint = a fn type whose parameter types replace synthetic :i64 ones (0 = none). Marks the node
;; (NF-TYPE its fn type, NF-RES HD-FN, NF-TYPE of the head = the lifted FN). R0 = the fn type.
(defn- ck-fnlit [M :vector-i64 n :i64 fx :i64 hint :i64] :vector-i64
  (let [h (nm-first M n)
        p (nm-next M h)
        np (nm-count-syms M p)]
    (if (> np 4)
      (ck-err M E-CHECK-CAPTURES h np)
      (let [M1 (ck-fn-new M n FK-LAMBDA np)
            f (ck-r M1)
            M2 (ck-fn-ptypes M1 (nm-first M1 p) f 0 hint)
            caps (ck-dedupe (ck-cap-walk M2 (nm-nth M2 n 2) p (vector-alloc 0)))
            k (count caps)]
        (cond (nm-failed M2) (ck-touch M2)
              (> (+ np k) 5) (ck-err M2 E-CHECK-CAPTURES h (+ np k))
              (pos? (ck-r5b-cell-cap M2 (nm-nth M2 n 2) caps)) (ck-err M2 E-ATOM-ESCAPE (ck-r5b-cell-cap M2 (nm-nth M2 n 2) caps) 0)   ; R5B
              (pos? (ck-bad-cap M2 (nm-nth M2 n 2) caps)) (ck-err M2 E-CHECK-TYPE (ck-bad-cap M2 (nm-nth M2 n 2) caps) TY-I64)
              :else (ck-fnlit2 (nm-set-nf (ck-fn-caps M2 f np caps p) h NF-TYPE f) n (+ (* f 8) np) caps fx))))))
;; fnp = the lifted FN * 8 + its parameter count
(defn- ck-fnlit2 [M :vector-i64 n :i64 fnp :i64 caps :vector-i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        f (quot fnp 8)
        np (bit-and fnp 7)
        k (count caps)
        M1 (if (>= k 2) (ck-fn-new M n FK-ADAPTER (inc np)) M)
        M2 (ck-fn-body M1 n f np caps)
        ty (ck-ty M2)]
    (cond (nm-failed M2) (ck-touch M2)
          (zero? ty) (ck-err M2 E-CHECK-INFER h 0)
          (not (ck-fn-ok-type? M2 ty)) (ck-err M2 E-CHECK-FNVALUE h 0)
          :else
          (let [M3 (-> M2 (nm-set-ff f FF-RTYPE ty)
                       (cond-> (>= k 2) (-> (nm-set-ff (inc f) FF-RTYPE ty) (nm-set-ff (inc f) FF-FUEL 1))))
                M4 (ck-fn-type-of M3 f np ty)]
            (ck-mark (ck-fuel M4 (ck-fx-f fx)) n (ck-r M4) HD-FN)))))

;; a let binder b (slot) whose init is a fn literal: the slot knows its lifted function; the closure is built only when the
;; rest of the let uses b's symbol as a value (else the literal's NF-RES = 0: lowering emits nothing for it)
(defn- ck-known-bind [M :vector-i64 b :i64 slot :i64] :vector-i64
  (let [e (nm-next M b)
        f (nm-nf M (nm-first M e) NF-TYPE)
        s (nm-sym-of M b)
        used (or (ck-uses-chain M (nm-next M e) s 0 false) (ck-uses-chain M (ck-sg M ck-s-lbody) s 0 false))]
    (if (or (nm-failed M) (nm-ne (nm-nf M e NF-RES) HD-FN))
      M
      (-> M (ck-known-set slot (+ (* 2 f) (if used 1 0))) (cond-> (not used) (nm-set-nf e NF-RES 0))))))

;; ---- calls of fn values and known functions ----
;; arguments from c against the parameter types of fn type ty; hk = the node for errors * 8 + the index of c
(defn- ck-fn-args [M :vector-i64 c :i64 ty :i64 hk :i64 fx :i64] :vector-i64
  (if (or (zero? c) (nm-failed M))
    (ck-touch M)
    (let [nx (nm-next M c)]
      (ck-fn-args (ck-want M c fx (ck-fn-param M ty (bit-and hk 7)) (quot hk 8)) nx ty (inc hk) fx))))
;; the operator's type must be a fn type of arity na: E2104 / E2103 at h
(defn- ck-fn-check [M :vector-i64 ty :i64 na :i64 h :i64] :vector-i64
  (cond (nm-failed M) (ck-touch M)
        (nm-ne (ck-tcon M ty) TC-FN) (ck-err M E-CHECK-TYPE h ty)
        (nm-ne (ck-fn-arity M ty) na) (ck-err M E-CHECK-ARITY h (ck-fn-arity M ty))
        :else (ck-touch M)))

;; (g a ..) with g a local: a known function (HD-CALLK) or a fn value (HD-CALLV); any other local in head position: E2101
(defn- ck-call-local [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        s (nm-sym-of M h)
        slot (nm-local-slot M s)
        ty (nm-local-type M s)
        na (- (nm-count M n) 1)
        kn (ck-known-get M slot)]
    (if (nm-ne (ck-tcon M ty) TC-FN)
      (ck-err M E-CHECK-HEAD h 0)
      (let [M1 (ck-fn-check M ty na h)
            M2 (ck-fn-args M1 (nm-next M1 h) ty (* h 8) fx)]
        (cond (nm-failed M2) (ck-touch M2)
              (pos? kn) (ck-mark (ck-fuel (nm-set-nf M2 h NF-RES (+ (* RES-FN RES-SCALE) (quot kn 2))) (ck-fx-f fx))
                                 n (ck-ta M2 ty) HD-CALLK)
              :else (ck-mark (ck-fuel (ck-mark M2 h ty (+ (* RES-LOCAL RES-SCALE) slot)) (ck-fx-f fx)) n (ck-ta M2 ty) HD-CALLV))))))

;; ((..) a ..): the head is an expression of a fn type; its value goes to a hidden slot (NF-SYM of the call node)
(defn- ck-callv [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 1)
        M1 (ck-hide M n NF-SYM 1 fx)
        fx2 (ck-ty M1)
        M2 (ck-expr M1 h fx2 0)
        ty (ck-ty M2)
        M3 (ck-fn-args (ck-fn-check M2 ty na h) (nm-next M2 h) ty (* h 8) fx2)]
    (if (nm-failed M3) (ck-touch M3) (ck-mark (ck-fuel M3 (ck-fx-f fx)) n (ck-ta M3 ty) HD-CALLV))))

;; a call of the variadic clause fi: the first m = np-1 arguments by the signature, the surplus (at most 64) as items of
;; the rest parameter's list type
(defn- ck-call-var [M :vector-i64 n :i64 fi :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        m (dec (nm-ff M fi FF-NPARAMS))
        lt (nm-ff M fi (+ FF-PT0 m))
        na (- (nm-count M n) 1)]
    (if (or (nm-ne (ck-tcon M lt) TC-LIST) (> (- na m) 64))
      (ck-err M E-CHECK-TYPENAME (nm-nth M (nm-ff M fi FF-NODE) 2) 0)
      (let [M1 (loop [M2 M c (nm-next M h) k 0]
                 (if (or (zero? c) (nm-failed M2))
                   M2
                   (recur (ck-want-arg M2 c fx (if (< k m) (nm-ff M2 fi (+ FF-PT0 k)) (ck-ta M2 lt)) h) (nm-next M2 c) (inc k))))]
        (if (nm-failed M1) (ck-touch M1) (ck-mark (ck-fuel M1 (ck-fx-f fx)) n (nm-ff M1 fi FF-RTYPE) HD-CALL))))))

;; an argument c in a slot of type want: a fn literal there takes want's parameter types (the reference's contract-typed
;; parameters, lang/guest-grammar.edn :callable-type)
(defn- ck-arg [M :vector-i64 c :i64 fx :i64 want :i64] :vector-i64
  (if (and (ck-fn-form? M c) (pos? want) (= (ck-tcon M want) TC-FN)) (ck-fnlit M c fx want) (ck-expr M c fx 0)))
(defn- ck-want-arg [M :vector-i64 c :i64 fx :i64 want :i64 hn :i64] :vector-i64
  (let [M1 (ck-arg M c fx want)
        ty (ck-ty M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (or (zero? want) (zero? ty) (= ty want)) M1
          :else (ck-err M1 E-CHECK-TYPE hn want))))
;; the hint of a fn literal in tail position (ctx bit 0): the declared [:fn] result of the function being checked
(defn- ck-rhint [M :vector-i64 ctx :i64] :i64
  (let [rt (nm-ff M (ck-sg M ck-s-fn) FF-RTYPE)]
    (if (and (= (bit-and ctx 1) 1) (pos? rt) (= (ck-tcon M rt) TC-FN)) rt 0)))

;; ---- the R4 heads ----
(defn- ck-r4 [M :vector-i64 n :i64 hd :i64 fx :i64 ctx :i64] :vector-i64
  (case hd
    HD-FN (ck-fnlit M n fx (ck-rhint M ctx))
    HD-FN-REF (ck-fnref M n fx)
    HD-INVOKE (ck-invoke M n fx)
    HD-APPLY (ck-apply M n fx)
    (HD-HOF-MAP HD-FILTER HD-REDUCE) (ck-hof M n hd fx)
    HD-LIST (ck-listlit M n fx)
    (ck-head-err M n)))

;; the clause of the defn named by symbol node x for arity ar that may be a value: R0 = the FN, 0 after an error
(defn- ck-defn-value [M :vector-i64 x :i64 ar :i64] :vector-i64
  (let [fi (nm-sf M (nm-sym-of M x) SF-FN)
        g (if (= (ck-callable M fi) 1) (ck-pick M fi ar) 0)]
    (cond (or (nm-ne (nm-kind M x) ND-SYM) (>= (nm-local-slot M (nm-sym-of M x)) 0) (zero? (ck-callable M fi)))
          (nm-put (ck-err M E-CHECK-FNVALUE x 0) MM-R0 0)
          (ck-r5b-tmpl? M fi) (nm-put (ck-err M E-STATE-VALUE x 0) MM-R0 0)   ; R5B
          (zero? g) (nm-put (ck-err M E-CHECK-CLAUSE x ar) MM-R0 0)
          (ck-variadic? M g) (nm-put (ck-err M E-CHECK-FNVALUE x 0) MM-R0 0)
          (nm-ne (nm-sf M (nm-ff M g FF-SYM) SF-ABORT) 0) (nm-put (ck-err M E-CHECK-FNVALUE x 0) MM-R0 0)
          (< (nm-ff M g FF-RTYPE) 1) (nm-put (ck-err M E-CHECK-INFER x 0) MM-R0 0)
          (not (ck-fn-ok-type? M (nm-ff M g FF-RTYPE))) (nm-put (ck-err M E-CHECK-FNVALUE x 0) MM-R0 0)
          (> ar 4) (nm-put (ck-err M E-CHECK-FNVALUE x 0) MM-R0 0)
          :else (nm-put (nm-set-nf M x NF-RES (+ (* RES-FN RES-SCALE) g)) MM-R0 g))))
;; true when the parameter types 0..np-1 of FN g are admissible in a fn type
(defn- ck-params-ok? [M :vector-i64 g :i64 np :i64] :bool
  (loop [i 0] (cond (>= i np) true (ck-fn-ok-type? M (nm-ff M g (+ FF-PT0 i))) (recur (inc i)) :else false)))

;; (fn-ref f): a single-clause, non-variadic, non-aborting defn of at most 4 parameters
(defn- ck-fnref [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        x (nm-next M h)
        fi (nm-sf M (nm-sym-of M x) SF-FN)
        np (nm-ff M fi FF-NPARAMS)]
    (cond (nm-ne (nm-count M n) 2) (ck-err M E-CHECK-ARITY h 1)
          (and (= (ck-callable M fi) 1) (ck-multi? M fi)) (ck-err M E-CHECK-FNVALUE x 0)
          :else
          (let [M1 (ck-defn-value M x np)
                g (ck-r M1)]
            (cond (nm-failed M1) (ck-touch M1)
                  (not (ck-params-ok? M1 g np)) (ck-err M1 E-CHECK-FNVALUE x 0)
                  :else (let [M2 (ck-fn-type-of M1 g np (nm-ff M1 g FF-RTYPE))]
                          (ck-mark (ck-fuel M2 (ck-fx-f fx)) n (ck-r M2) HD-FN-REF)))))))

;; (invoke [R] c a ..): c of a fn type (its value in a hidden slot, NF-TYPE of the head), R its result when written
(defn- ck-invoke [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        a1 (nm-next M h)
        typed (= (ck-is-tform M a1) 1)
        op (if typed (nm-next M a1) a1)
        M0 (if typed (ck-tform M a1) (nm-put M MM-R0 0))
        want (ck-ty M0)
        na (- (nm-count M n) (if typed 3 2))]
    (cond (nm-failed M0) (ck-touch M0)
          (zero? op) (ck-err M0 E-CHECK-ARITY h 1)
          (and typed (zero? want)) (ck-err M0 E-CHECK-TYPENAME a1 0)
          :else
          (let [M1 (ck-hide (if typed (nm-set-nf M0 a1 NF-TYPE want) M0) h NF-TYPE 1 fx)
                fx2 (ck-ty M1)
                M2 (ck-expr M1 op fx2 0)
                ty (ck-ty M2)
                M3 (ck-fn-args (ck-fn-check M2 ty na h) (nm-next M2 op) ty (* h 8) fx2)
                rt (ck-ta M3 ty)]
            (cond (nm-failed M3) (ck-touch M3)
                  (and typed (nm-ne rt want)) (ck-err M3 E-CHECK-TYPE h want)
                  :else (ck-mark (ck-fuel M3 (ck-fx-f fx)) n rt HD-INVOKE))))))

;; the item type of a :vector-i64 / [:list T] / [:set T] (0 for any other type)
(defn- ck-item-type [M :vector-i64 ty :i64] :i64
  (cond (= ty TY-VEC) TY-I64
        (or (= (ck-tcon M ty) TC-LIST) (= (ck-tcon M ty) TC-SET)) (ck-ta M ty)
        :else 0))

;; (apply c a .. l): 2 hidden slots (closure, list); the trailing parameters of c take l's items
(defn- ck-apply [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 1)
        op (nm-next M h)
        m (- na 2)]
    (if (< na 2)
      (ck-err M E-CHECK-ARITY h 2)
      (let [M1 (ck-hide M h NF-TYPE 2 fx)
            fx2 (ck-ty M1)
            M2 (ck-expr M1 op fx2 0)
            ty (ck-ty M2)
            ar (ck-fn-arity M2 ty)
            M3 (cond (nm-failed M2) M2
                     (nm-ne (ck-tcon M2 ty) TC-FN) (ck-err M2 E-CHECK-TYPE h ty)
                     (> m ar) (ck-err M2 E-CHECK-ARITY h ar)
                     :else (loop [M4 M2 c (nm-next M2 op) k 0]
                             (if (or (>= k m) (nm-failed M4))
                               M4
                               (recur (ck-want M4 c fx2 (ck-fn-param M4 ty k) h) (nm-next M4 c) (inc k)))))
            l (nm-nth M3 n na)
            M5 (if (nm-failed M3) M3 (ck-expr M3 l fx2 0))
            it (ck-item-type M5 (ck-ty M5))]
        (cond (nm-failed M5) (ck-touch M5)
              (nm-ne (ck-tcon M5 (ck-ty M5)) TC-LIST) (ck-err M5 E-CHECK-TYPE h (ck-ty M5))
              (not (loop [k m] (cond (>= k ar) true (= (ck-fn-param M5 ty k) it) (recur (inc k)) :else false)))
              (ck-err M5 E-CHECK-TYPE h it)
              :else (ck-mark (ck-fuel M5 (ck-fx-f fx)) n (ck-ta M5 ty) HD-APPLY))))))

;; (list e ..): [:list T], T the first item's type ((list) is [:list :i64]); at most 64 items
(defn- ck-listlit [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        a (nm-next M h)]
    (if (> (nm-count M n) 65)
      (ck-err M E-CHECK-VECLIT n 0)
      (let [M1 (if (zero? a) (nm-put M MM-R0 TY-I64) (ck-expr M a fx 0))
            t (ck-ty M1)
            M2 (if (or (zero? a) (nm-failed M1)) M1
                   (loop [M3 M1 c (nm-next M1 a)] (if (zero? c) M3 (recur (ck-want M3 c fx t c) (nm-next M3 c)))))
            M4 (ck-ct-intern M2 TC-LIST t 0)]
        (cond (nm-failed M4) (ck-touch M4)
              (not (ck-fn-ok-type? M4 t)) (ck-err M4 E-CHECK-VECLIT n 0)
              :else (ck-mark M4 n (ck-r M4) HD-LIST))))))

;; ---- map / filter / reduce ----
;; R0 = the TC-PLIST chain [a] (b = 0) or [a b]
(defn- ck-hint2 [M :vector-i64 a :i64 b :i64] :vector-i64
  (let [M1 (if (zero? b) (nm-put M MM-R0 0) (ck-ct-intern M TC-PLIST b 0))
        M2 (ck-ct-intern M1 TC-PLIST a (ck-r M1))]
    (ck-ct-intern M2 TC-FN TY-I64 (ck-r M2))))
;; the callback cb of arity ar (pa, pb its parameter types; pb 0 for arity 1): an inline fn (its NF-RES becomes 0: called
;; directly), a defn name (NF-RES RES-FN clause), or a fn value. R0 = its fn type.
(defn- ck-callback [M :vector-i64 cb :i64 ar :i64 pa :i64 pb :i64 fx :i64] :vector-i64
  (do
    (cond (ck-fn-form? M cb)
          (let [M1 (ck-hint2 M pa pb)
                M2 (ck-fnlit M1 cb fx (ck-r M1))
                ty (ck-r M2)]
            (if (nm-failed M2) (ck-touch M2) (nm-put (nm-set-nf M2 cb NF-RES 0) MM-R0 ty)))
          (and (= (nm-kind M cb) ND-SYM) (< (nm-local-slot M (nm-sym-of M cb)) 0) (= (ck-callable M (nm-sf M (nm-sym-of M cb) SF-FN)) 1))
          (let [M1 (ck-defn-value M cb ar)
                g (ck-r M1)]
            (cond (nm-failed M1) (ck-touch M1)
                  (not (ck-params-ok? M1 g ar)) (ck-err M1 E-CHECK-FNVALUE cb 0)
                  :else (ck-fn-type-of M1 g ar (nm-ff M1 g FF-RTYPE))))
          :else (ck-expr M cb fx 0))))

;; reduce without init: the callback must be a defn name with a 0-arity clause (the reference: `named no-init reduce
;; callback must provide arities 0 and 2`; an inline or closure callback would need a multi-clause fn); its FN or 0
(defn- ck-clause0-of [M :vector-i64 cb :i64] :i64
  (let [fi (nm-sf M (nm-sym-of M cb) SF-FN)]
    (if (and (= (nm-kind M cb) ND-SYM) (< (nm-local-slot M (nm-sym-of M cb)) 0) (= (ck-callable M fi) 1))
      (let [g (ck-pick M fi 0)] (if (and (pos? g) (not (ck-variadic? M g))) g 0))
      0)))
;; (map f c) (filter p c) (reduce f [init] c): 5 hidden slots on the head symbol node
(defn- ck-hof [M :vector-i64 n :i64 hd :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 1)
        cb (nm-next M h)
        coll (nm-nth M n na)
        init (if (= na 3) (nm-next M cb) 0)]
    (if (or (< na 2) (> na 3) (and (= na 3) (nm-ne hd HD-REDUCE)))
      (ck-err M E-CHECK-ARITY h 2)
      (let [M1 (ck-hide M h NF-TYPE 5 fx)
            fx2 (ck-ty M1)
            M2 (ck-expr M1 coll fx2 0)
            cty (ck-ty M2)
            it (ck-item-type M2 cty)
            M3 (if (pos? init) (ck-expr M2 init fx2 0) (nm-put M2 MM-R0 it))
            acc (ck-ty M3)
            ar (if (= hd HD-REDUCE) 2 1)
            pa (if (= hd HD-REDUCE) acc it)
            pb (if (= hd HD-REDUCE) it 0)]
        (cond (nm-failed M3) (ck-touch M3)
              ;; the reference: `reduce` and `map` accept a :vector-i64 source only (lang/surface-status.edn
              ;; :reduce-over-typed-set), so the item is an :i64
              (nm-ne cty TY-VEC) (ck-err M3 E-CHECK-TYPE h TY-VEC)
              (and (= hd HD-REDUCE) (= na 2) (zero? (ck-clause0-of M3 cb))) (ck-err M3 E-CHECK-CLAUSE cb 0)
              :else
              (let [M4 (ck-callback M3 cb ar pa pb fx2)
                    fty (ck-ty M4)
                    M5 (ck-fn-check M4 fty ar h)
                    r (ck-ta M5 fty)]
                (cond (nm-failed M5) (ck-touch M5)
                      (nm-ne (ck-fn-param M5 fty 0) (if (= ar 2) acc it)) (ck-err M5 E-CHECK-TYPE h (if (= ar 2) acc it))
                      (and (= ar 2) (nm-ne (ck-fn-param M5 fty 1) it)) (ck-err M5 E-CHECK-TYPE h it)
                      :else (ck-hof2 M5 n hd fty fx))))))))
;; the result type: the collection and init types are NF-TYPE of their nodes, r the callback's result
(defn- ck-hof2 [M :vector-i64 n :i64 hd :i64 fty :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 1)
        cty (nm-nf M (nm-nth M n na) NF-TYPE)
        it (ck-item-type M cty)
        acc (if (= na 3) (nm-nf M (nm-nth M n 2) NF-TYPE) it)
        r (ck-ta M fty)
        M1 (case hd
             (HD-HOF-MAP HD-FILTER) (nm-put M MM-R0 TY-VEC)
             (nm-put M MM-R0 acc))
        out (ck-r M1)]
    (cond (nm-failed M1) (ck-touch M1)
          (and (= hd HD-HOF-MAP) (nm-ne r TY-I64)) (ck-err M1 E-CHECK-TYPE h TY-I64)
          (and (= hd HD-FILTER) (nm-ne r TY-BOOL)) (ck-err M1 E-CHECK-TYPE h TY-BOOL)
          (and (= hd HD-REDUCE) (nm-ne r acc)) (ck-err M1 E-CHECK-TYPE h acc)
          :else (ck-mark (ck-fuel M1 (ck-fx-f fx)) n out hd))))

;; =========================================================================================================
;; R5B (agent R5B, 2026-10-03): effects (docs/selfhost-seed-r5-design-20261002.md section 5; seed/HEADS 148-157, E2140-E2177;
;; seed/SIR :r5b-lowering; seed/MEMORY-MAP FN2). Written in the R5A language (the R5A/R4B seed compiles it).
;;   local state  (let [a (atom e)] ..) binds a CELL: a frame slot whose known-table entry is -(loop depth + 1). The cell may be
;;                spelled only as the first argument of deref / reset! (swap! is desugared into reset!) at the loop depth it was
;;                bound at; anywhere else it escapes (E2140). No SIR change: deref = LGET, reset! = LSET.
;;   handlers     (defhandler h [:state S] (get [s] ..) (put [s v] ..)) -> two FN records (FK-LAMBDA: the body is the clause's
;;                3rd child), get then put; FN2 marks them. Every tail of a clause is (resume v n) (bottom), checked here.
;;   stateful     a defn that performs :state or calls a stateful defn outside every handle body (a syntactic fixed point, before
;;                pass B) is a TEMPLATE: never checked or lowered itself. Under a handler h it is SPECIALIZED: an FN record whose
;;                node is a clone of the template's defn form, checked with the state in slot 1 and its parameters in slots 2..
;;                (one specialization per (template, handler), created at the first call). Calls in a specialization go to the
;;                specializations under the same handler; an inner handle shadows it.
;;   effects      FN2-CAPS = the capabilities a checked body calls; M[MM-CAPS] = the module's; declared {:effects #{..}} ceilings
;;                are checked against a syntactic fixed point of caps + :state.
;; =========================================================================================================
(def ck-s-hslot 10)  ; the state slot of the innermost handler (0 = none; 1 in a specialization)
(def ck-s-hfn 11)    ; its handler (the get clause FN)
(def ck-s-loopn 12)  ; loop nesting depth of the expression being checked
(def ck-s-andor 13)  ; the and/or head node whose operands are being checked (0 = none)

(def ck-fx-state 140737488355328)   ; 2^47: the :state bit of an effect mask (bit w < 47 = capability wire w)

;; ---- FN2 ----
(defn- ck-f2 [M :vector-i64 f :i64 fld :i64] :i64 (vector-at M (+ (vector-at M MM-FN2) (* f FN2-W) fld)))
(defn- ck-f2-set [M :vector-i64 f :i64 fld :i64 v :i64] :vector-i64 (nm-put M (+ (vector-at M MM-FN2) (* f FN2-W) fld) v))
(defn- ck-f2-or [M :vector-i64 f :i64 fld :i64 v :i64] :vector-i64 (ck-f2-set M f fld (bit-or (ck-f2 M f fld) v)))
(defn- ck-r5b-tmpl? [M :vector-i64 f :i64] :bool (and (pos? f) (= (bit-and (ck-f2 M f FN2-FLAGS) 1) 1)))
(defn- ck-r5b-spec? [M :vector-i64 f :i64] :bool (and (pos? f) (= (bit-and (ck-f2 M f FN2-FLAGS) 2) 2)))
(defn- ck-r5b-clause? [M :vector-i64 f :i64] :bool (and (pos? f) (pos? (bit-and (ck-f2 M f FN2-FLAGS) 12))))
;; 1 for a get clause, 2 for a put clause
(defn- ck-r5b-op-of [M :vector-i64 f :i64] :i64 (if (= (bit-and (ck-f2 M f FN2-FLAGS) 8) 8) 2 1))

;; the FN2 table and the module's capability mask (before anything is registered)
(defn- ck-r5b-init [M :vector-i64] :vector-i64
  (let [M1 (mem-alloc M (* (+ MM-FN-CAP 1) FN2-W))]
    (-> M1 (nm-put MM-FN2 (ck-r M1)) (nm-put MM-CAPS 0))))

;; the capability wire of a keyword code (seed/HEADS :caps and the catalogue's :clock/now), -1 when none
(defn- ck-kw-wire [k :i64] :i64
  (case k
    KW-HASH-SHA256 3 KW-CLOCK-NOW 7 KW-ENV-READ 33 KW-FS-BROWSE 34 (KW-FS-APP-DATA KW-FS-APP-DATA-BYTES) 35 KW-IO-WRITE 37
    KW-CLI-ARGS 38 KW-IO-WRITE-ERROR 39 KW-IO-READ 41
    KW-PROCESS-SPAWN 20 KW-ENTROPY-DRAW 23   ; R6B
    -1))
(defn- ck-wire-bit [w :i64] :i64 (if (and (>= w 0) (< w 47)) (i64-shift-left 1 w) 0))
;; FN f calls capability wire w: its FN2-CAPS and the module's mask
;; R5B rung proof (local state in the seed): the heap handle threaded through a cell (atom, swap!, reset!, @)
(defn- ck-r5b-cap [M :vector-i64 f :i64 w :i64] :vector-i64
  (let [m (atom M)]
    (swap! m ck-f2-or f FN2-CAPS (ck-wire-bit w))
    (reset! m (nm-put @m MM-CAPS (bit-or (vector-at @m MM-CAPS) (ck-wire-bit w))))
    @m))

;; ---- recognisers (a head that no definition shadows) ----
(defn- ck-hd-of [M :vector-i64 n :i64] :i64
  (let [h (nm-first M n)
        s (nm-sym-of M h)]
    (if (and (= (nm-kind M n) ND-LIST) (= (nm-kind M h) ND-SYM) (zero? (nm-sf M s SF-FN))) (nm-sf M s SF-HEAD) 0)))
(defn- ck-r5b-atom-form? [M :vector-i64 e :i64] :bool (= (ck-hd-of M e) HD-ATOM))
;; 1 get, 2 put, 0 another operation, of the perform list n
(defn- ck-perform-op [M :vector-i64 n :i64] :i64
  (let [k (nm-head-of M (nm-nth M n 1))]
    (cond (nm-ne (nm-kind M (nm-nth M n 1)) ND-KW) 0 (= k KW-STATE-GET) 1 (= k KW-STATE-PUT) 2 :else 0)))
;; the defn called by list n (its head symbol names a defn and is not a local of the walk's function: a syntactic answer)
(defn- ck-callee-of [M :vector-i64 n :i64] :i64
  (let [h (nm-first M n)
        fi (nm-sf M (nm-sym-of M h) SF-FN)]
    (if (and (= (nm-kind M n) ND-LIST) (= (nm-kind M h) ND-SYM) (= (ck-callable M fi) 1)) fi 0)))
(defn- ck-r5b-handle-catch? [M :vector-i64 n :i64] :bool
  (let [c (nm-nth M n 2)] (and (= (nm-count M n) 3) (= (ck-hd-of M c) HD-CATCH))))

;; ---- desugaring ----
;; (swap! a f x ..) -> (reset! a (f (deref a') x ..)); the reset! head carries NF-AUX 1 (its refusals name swap!)
(defn- ck-r5b-ds-swap [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        a (nm-next M h)
        f (nm-next M a)
        tok (nm-nf M h NF-TOK)]
    (if (or (zero? a) (zero? f))
      (ck-err M E-CHECK-ARITY h 2)
      (let [r (nm-next M f)
            M1 (ck-n-copy M a)
            a2 (ck-r M1)
            M2 (ck-mkh M1 tok HD-DEREF a2)
            d (ck-r M2)
            M3 (-> M2 (ck-link d r) (ck-link f d))
            M4 (ck-n-list M3 tok f)
            l (ck-r M4)
            M5 (-> M4 (ck-link a l) (ck-link l 0) (ck-rehead n HD-RESET a))]
        (nm-set-nf M5 (nm-first M5 n) NF-AUX 1)))))

;; a declared effect ceiling {:effects #{..}} right after the parameters or after the result type: unlinked from the defn
;; form n, kept in NF-TYPE of the name node
(defn- ck-ceil-map? [M :vector-i64 x :i64] :bool
  (and (= (nm-kind M x) ND-MAP) (= (nm-head-of M (nm-first M x)) KW-EFFECTS)))
(defn- ck-r5b-ceiling-take [M :vector-i64 n :i64] :vector-i64
  (let [nm (nm-nth M n 1)
        p (nm-nth M n 2)
        x (nm-next M p)
        y (nm-next M x)]
    (cond (or (nm-failed M) (nm-ne (nm-kind M p) ND-VEC)) M
          (ck-ceil-map? M x) (-> M (ck-link p y) (nm-set-nf nm NF-TYPE x))
          (and (= (ck-is-tform M x) 1) (ck-ceil-map? M y)) (-> M (ck-link x (nm-next M y)) (nm-set-nf nm NF-TYPE y))
          :else M)))

;; ---- node clones (a specialization checks its own copy of the template's tree) ----
(defn- ck-r5b-clone [M :vector-i64 n :i64] :vector-i64
  (let [M1 (ck-new M (nm-kind M n) (nm-nf M n NF-TOK) (nm-nf M n NF-AUX) (nm-sym-of M n))
        c (ck-r M1)
        M2 (-> M1 (nm-set-nf c NF-TYPE (nm-nf M1 n NF-TYPE)) (nm-set-nf c NF-RES (nm-nf M1 n NF-RES)))
        M3 (ck-r5b-clone-chain M2 (nm-first M2 n))
        k (ck-r M3)]
    (if (zero? c) M3 (-> M3 (nm-set-nf c NF-FIRST k) (nm-put MM-R0 c)))))
(defn- ck-r5b-clone-chain [M :vector-i64 c :i64] :vector-i64
  (if (or (zero? c) (nm-failed M))
    (nm-put M MM-R0 0)
    (let [M1 (ck-r5b-clone M c)
          x (ck-r M1)
          M2 (ck-r5b-clone-chain M1 (nm-next M1 c))
          y (ck-r M2)]
      (if (zero? x) M2 (-> M2 (nm-set-nf x NF-NEXT y) (nm-put MM-R0 x))))))

;; ---- local state ----
;; (atom e) as the init of a let binding: R0 = e's type
(defn- ck-r5b-atom [M :vector-i64 e :i64 fx :i64] :vector-i64
  (if (nm-ne (nm-count M e) 2)
    (ck-err M E-CHECK-ARITY (nm-first M e) 1)
    (let [M1 (ck-expr M (nm-nth M e 1) fx 0)
          ty (ck-ty M1)]
      (ck-mark M1 e ty HD-ATOM))))
;; a let binder b whose symbol names a cell now: E2147
(defn- ck-r5b-shadow [M :vector-i64 b :i64] :vector-i64
  (let [slot (nm-local-slot M (nm-sym-of M b))]
    (if (and (= (nm-kind M b) ND-SYM) (>= slot 0) (neg? (ck-known-get M slot))) (ck-err M E-ATOM-SHADOW b 0) M)))
;; the cell named by x for operation code (the refusal of a non-cell): R0 = its type; x's NF-RES = its slot
(defn- ck-r5b-cell [M :vector-i64 x :i64 code :i64] :vector-i64
  (let [s (nm-sym-of M x)
        slot (nm-local-slot M s)
        k (ck-known-get M slot)]
    (cond (or (nm-ne (nm-kind M x) ND-SYM) (< slot 0) (>= k 0)) (ck-err M code x 0)
          (nm-ne (- -1 k) (ck-sg M ck-s-loopn)) (ck-err M E-ATOM-ESCAPE x 0)
          :else (ck-mark M x (nm-local-type M s) (+ (* RES-LOCAL RES-SCALE) slot)))))
(defn- ck-r5b-deref [M :vector-i64 n :i64] :vector-i64
  (if (nm-ne (nm-count M n) 2)
    (ck-err M E-CHECK-ARITY (nm-first M n) 1)
    (let [M1 (ck-r5b-cell M (nm-nth M n 1) E-ATOM-DEREF)]
      (if (nm-failed M1) M1 (ck-mark M1 n (ck-ty M1) HD-DEREF)))))
(defn- ck-r5b-reset [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        a (nm-next M h)
        ao (ck-sg M ck-s-andor)]
    (cond (nm-ne (nm-count M n) 3) (ck-err M E-CHECK-ARITY h 2)
          :else
          (let [M1 (ck-r5b-cell M a (if (= (nm-nf M h NF-AUX) 1) E-ATOM-SWAP E-ATOM-RESET))
                ty (ck-ty M1)
                M2 (cond (nm-failed M1) M1
                         (pos? ao) (ck-err M1 E-ATOM-INSIDE ao 0)
                         :else (ck-expr M1 (nm-next M1 a) fx 0))
                tv (ck-ty M2)]
            (cond (nm-failed M2) M2
                  (and (pos? tv) (nm-ne tv ty)) (ck-err M2 E-ATOM-TYPE a (+ ty (* tv 16777216)))
                  :else (ck-mark M2 n ty HD-RESET))))))
;; the first occurrence in chain c of a captured symbol that is a cell (a fn literal capturing it), 0 when none
(defn- ck-r5b-cell-cap [M :vector-i64 c :i64 caps :vector-i64] :i64
  (loop [x c]
    (if (zero? x)
      0
      (let [k (nm-kind M x)
            s (nm-sym-of M x)
            sub (if (or (= k ND-LIST) (= k ND-VEC) (= k ND-MAP) (= k ND-SET)) (ck-r5b-cell-cap M (nm-first M x) caps) 0)]
        (cond (and (= k ND-SYM) (ck-in-list caps s) (neg? (ck-known-get M (nm-local-slot M s)))) x
              (pos? sub) sub
              :else (recur (nm-next M x)))))))

;; ---- the forms ----
(defn- ck-r5b [M :vector-i64 n :i64 hd :i64 fx :i64 ctx :i64] :vector-i64
  (case hd
    HD-ATOM (ck-err M E-ATOM-POSITION (nm-first M n) 0)
    HD-DEREF (ck-r5b-deref M n)
    HD-RESET (ck-r5b-reset M n fx)
    HD-PERFORM (ck-r5b-perform M n fx)
    HD-HANDLE (ck-r5b-handle M n fx ctx)
    HD-RESUME (ck-r5b-resume M n fx ctx)
    (ck-head-err M n)))

;; the handler name node of clause FN f
(defn- ck-r5b-hname [M :vector-i64 f :i64] :i64 (nm-nth M (ck-f2 M f FN2-NODE) 1))

;; (perform :state/get) (perform :state/put v) under the innermost handler; (perform :clock/now x) a capability call
(defn- ck-r5b-perform [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        kw (nm-nth M n 1)
        op (ck-perform-op M n)
        na (- (nm-count M n) 2)
        f (ck-sg M ck-s-fn)
        hs (ck-sg M ck-s-hslot)
        hf (ck-sg M ck-s-hfn)
        S (cond (ck-r5b-clause? M f) (ck-f2 M f FN2-S) (pos? hs) (ck-f2 M hf FN2-S) :else 0)]
    (cond (nm-ne (nm-kind M kw) ND-KW) (ck-err M E-STATE-UNKNOWN-OP kw 0)
          (and (= op 1) (nm-ne na 0)) (ck-err M E-STATE-GET-ARITY h na)
          (and (= op 2) (nm-ne na 1)) (ck-err M E-STATE-PUT-ARITY h na)
          (pos? op)
          (cond (ck-r5b-clause? M f)   ; a handler clause performs :state: recorded, refused after the clause (E2153)
                (let [M1 (ck-f2-or M f FN2-CAPS ck-fx-state)
                      M2 (if (= op 2) (ck-want M1 (nm-nth M1 n 2) fx S h) M1)]
                  (if (nm-failed M2) M2 (ck-mark M2 n S HD-PERFORM)))
                (zero? hs) (ck-err M E-STATE-FN h (i64-shift-left op 48))
                :else
                (let [M1 (if (= op 2) (ck-want M (nm-nth M n 2) fx S h) M)]
                  (if (nm-failed M1)
                    M1
                    (-> M1 (nm-set-nf h NF-TYPE hs) (nm-set-nf kw NF-TYPE hf) (ck-fuel (ck-fx-f fx)) (ck-mark n S HD-PERFORM)))))
          (= (ck-kw-wire (nm-head-of M kw)) 7)
          (if (nm-ne na 1)
            (ck-err M E-CHECK-ARITY h 2)
            (let [M1 (ck-want M (nm-nth M n 2) fx TY-I64 h)]
              (if (nm-failed M1)
                M1
                (-> M1 (nm-set-nf h NF-TYPE 0) (nm-set-nf kw NF-TYPE 0) (ck-r5b-cap (ck-fx-f fx) 7) (ck-fuel (ck-fx-f fx))
                    (ck-mark n TY-I64 HD-PERFORM)))))
          :else (ck-err M E-STATE-UNKNOWN-OP kw 0))))

;; (handle body (with h init)): the handler was resolved by the pass (NF-TYPE of the `with` symbol node); the state lives in a
;; hidden slot (NF-TYPE of the handle head node); the body is no tail position
(defn- ck-r5b-handle [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        w (nm-nth M n 2)
        hf (nm-nf M (nm-first M w) NF-TYPE)
        S (ck-f2 M hf FN2-S)]
    (if (or (nm-ne (nm-count M n) 3) (zero? hf))
      (ck-err M E-STATE-HANDLE h 0)
      (let [M1 (ck-hide M h NF-TYPE 1 fx)
            fx2 (ck-ty M1)
            sl (nm-nf M1 h NF-TYPE)
            M2 (ck-want M1 (nm-nth M1 w 2) fx2 S h)
            hs0 (ck-sg M2 ck-s-hslot)
            hf0 (ck-sg M2 ck-s-hfn)
            M3 (if (nm-failed M2) M2 (ck-expr (-> M2 (ck-ss ck-s-hslot sl) (ck-ss ck-s-hfn hf)) (nm-nth M2 n 1) fx2 (- ctx (bit-and ctx 1))))
            ty (ck-ty M3)
            M4 (-> M3 (ck-ss ck-s-hslot hs0) (ck-ss ck-s-hfn hf0))]
        (if (nm-failed M4) M4 (ck-mark M4 n ty HD-HANDLE))))))

;; (resume v n) in tail position of a handler clause: v and n of the handler's S; bottom
(defn- ck-r5b-resume [M :vector-i64 n :i64 fx :i64 ctx :i64] :vector-i64
  (let [h (nm-first M n)
        f (ck-sg M ck-s-fn)
        S (ck-f2 M f FN2-S)
        op (if (ck-r5b-clause? M f) (ck-r5b-op-of M f) 0)
        nmn (if (pos? op) (ck-r5b-hname M f) 0)]
    (cond (zero? op) (ck-err M E-STATE-RESUME-WHERE h 0)
          (zero? (bit-and ctx 1)) (ck-err M E-STATE-RESUME nmn (i64-shift-left op 48))
          (nm-ne (nm-count M n) 3) (ck-err M E-CHECK-ARITY h 2)
          :else
          (let [M1 (ck-expr M (nm-nth M n 1) fx 0)
                tv (ck-ty M1)
                M2 (cond (nm-failed M1) M1
                         (and (pos? tv) (nm-ne tv S)) (ck-err M1 E-STATE-RESUME-TYPE nmn (+ tv (* S 16777216) (i64-shift-left op 48)))
                         :else (ck-expr M1 (nm-nth M1 n 2) fx 0))
                tn (ck-ty M2)]
            (cond (nm-failed M2) M2
                  (and (pos? tn) (nm-ne tn S)) (ck-err M2 E-STATE-NEXT-TYPE nmn (+ tn (* S 16777216) (i64-shift-left op 48)))
                  :else (ck-mark M2 n 0 HD-RESUME))))))

;; ---- specializations ----
;; the specialization of template g under handler hf: found, or made (a clone of g's defn form) and checked now; R0 = its FN
(defn- ck-r5b-spec-find [M :vector-i64 g :i64 hf :i64] :i64
  (loop [f 1]
    (cond (>= f (vector-at M MM-FN-N)) 0
          (and (ck-r5b-spec? M f) (= (ck-f2 M f FN2-ORIGIN) g) (= (ck-f2 M f FN2-HAND) hf)) f
          :else (recur (inc f)))))
(defn- ck-r5b-spec [M :vector-i64 g :i64 hf :i64] :vector-i64
  (let [old (ck-r5b-spec-find M g hf)]
    (if (pos? old)
      (nm-put M MM-R0 old)
      (let [np (nm-ff M g FF-NPARAMS)
            M1 (ck-r5b-clone M (nm-ff M g FF-NODE))
            c (ck-r M1)
            M2 (ck-fn-new M1 c FK-PRIV (inc np))
            f (ck-r M2)
            M3 (-> M2 (nm-set-ff f FF-RTYPE (nm-ff M2 g FF-RTYPE)) (nm-set-ff f FF-PT0 (ck-f2 M2 hf FN2-S))
                   (ck-f2-set f FN2-FLAGS 2) (ck-f2-set f FN2-ORIGIN g) (ck-f2-set f FN2-HAND hf) (ck-done-set f 0))
            M4 (loop [M5 M3 k 0] (if (>= k np) M5 (recur (nm-set-ff M5 f (+ FF-PT0 k 1) (nm-ff M5 g (+ FF-PT0 k))) (inc k))))]
        (if (nm-failed M4) (nm-put M4 MM-R0 0) (nm-put (ck-nested M4 f) MM-R0 f))))))

;; the body check of FN f: a specialization binds the state to slot 1 and its parameters to slots 2..
(defn- ck-r5b-body0 [M :vector-i64 f :i64] :vector-i64
  (if (ck-r5b-spec? M f) (ck-r5b-sbody M f) (ck-body0 M f)))
(defn- ck-r5b-sbody [M :vector-i64 f :i64] :vector-i64
  (let [n (nm-ff M f FF-NODE)
        nm (nm-nth M n 1)
        p (nm-nth M n 2)
        body (nm-nth M n 4)
        np (dec (nm-ff M f FF-NPARAMS))
        rt (nm-ff M f FF-RTYPE)
        h0 (nm-scope-height M)
        M1 (-> M (nm-set-ff f FF-NSLOTS (inc np)) (nm-set-ff f FF-FUEL 0) (ck-ss ck-s-hslot 1) (ck-ss ck-s-hfn (ck-f2 M f FN2-HAND)))
        M2 (loop [M3 M1 b (nm-first M1 p) k 0]
             (if (or (zero? b) (nm-failed M3))
               M3
               (recur (ck-bind (ck-binder-ok M3 b h0) b (+ k 2) (ck-pt M3 f (inc k)) f) (nm-next M3 (nm-next M3 b)) (inc k))))
        M4 (ck-expr M2 body (+ (* f 1024) (+ np 2)) (+ (* p 2) 1))
        ty (ck-ty M4)
        M5 (nm-unbind M4 h0)]
    (ck-body-result M5 nm ty rt f)))

;; (g a ..) with g a stateful defn, under the innermost handler: a call of g's specialization (HD-SCALL)
(defn- ck-r5b-scall [M :vector-i64 n :i64 f0 :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        na (- (nm-count M n) 1)
        g (ck-pick M f0 na)
        hs (ck-sg M ck-s-hslot)]
    (cond (zero? g) (ck-err M E-CHECK-ARITY h (nm-ff M f0 FF-NPARAMS))
          (zero? hs) (ck-err M E-STATE-FN-CALL h 0)
          (nm-ne (nm-ff M g FF-NPARAMS) na) (ck-err M E-CHECK-ARITY h (nm-ff M g FF-NPARAMS))
          :else
          (let [M1 (ck-r5b-spec M g (ck-sg M ck-s-hfn))
                sp (ck-r M1)
                rt (nm-ff M1 sp FF-RTYPE)]
            (cond (nm-failed M1) M1
                  (< rt 1) (ck-err M1 E-CHECK-INFER h 0)
                  :else
                  (let [M2 (ck-call-args M1 (nm-next M1 h) g 0 fx h)]
                    (if (nm-failed M2)
                      M2
                      (-> M2 (nm-set-nf h NF-RES (+ (* RES-FN RES-SCALE) sp)) (nm-set-nf h NF-TYPE hs) (ck-fuel (ck-fx-f fx))
                          (ck-mark n rt HD-SCALL)))))))))

;; ---- the pass before pass B: handlers, stateful defns, their refusals, effect ceilings, handler clauses ----
;; the spelling of node x is the text s
(defn- ck-spells? [M :vector-i64 S :string x :i64 s :string] :bool
  (let [a (nm-tf M (nm-nf M x NF-TOK) TF-START)
        b (nm-tf M (nm-nf M x NF-TOK) TF-END)]
    (and (= (- b a) (string-length s)) (string=? (string-substring S a b) s))))
;; the handler (get clause FN) named by symbol s, 0 when none
(defn- ck-r5b-handler [M :vector-i64 s :i64] :i64
  (loop [f 1]
    (cond (>= f (vector-at M MM-FN-N)) 0
          (and (= (bit-and (ck-f2 M f FN2-FLAGS) 4) 4) (= (ck-f2 M f FN2-ORIGIN) s)) f
          :else (recur (inc f)))))
;; R5B rung proof (the state ability in the seed): the clauses of a defhandler form named op are counted by a stateful scan whose
;; counter is the state of handler ck-tally (it was a return register, M[MM-R1]); the scan is self-recursive, so its specialization
;; jumps back to its entry with the state left in slot 1
(defhandler ck-tally [:state :i64]
  (get [s] (resume s s))
  (put [s v] (resume v v)))
(defn- ck-r5b-clause-scan [M :vector-i64 S :string x :i64 op :string] :i64
  (cond (zero? x) 0
        (and (= (nm-kind M x) ND-LIST) (= (nm-kind M (nm-first M x)) ND-SYM) (ck-spells? M S (nm-first M x) op))
        (let [k (perform :state/put (inc (perform :state/get)))
              r (ck-r5b-clause-scan M S (nm-next M x) op)]
          (if (pos? r) r x))
        :else (ck-r5b-clause-scan M S (nm-next M x) op)))
;; the clause of defhandler form d named op ("get" / "put") from chain c: R0 = the last such clause node, R1 = how many there are
(defn- ck-r5b-clause-of [M :vector-i64 S :string c :i64 op :string] :vector-i64
  (let [k (handle (do (ck-r5b-clause-scan M S c op) (perform :state/get)) (with ck-tally 0))
        found (handle (ck-r5b-clause-scan M S c op) (with ck-tally 0))]
    (-> M (nm-put MM-R1 k) (nm-put MM-R0 found))))
;; the source span of the bracketed node v: from its opening token to its closing token (the token after the end of its last child)
(defn- ck-bracket? [M :vector-i64 x :i64] :bool
  (let [k (nm-kind M x)] (or (= k ND-LIST) (= k ND-VEC) (= k ND-MAP) (= k ND-SET))))
(defn- ck-end-tok [M :vector-i64 x :i64] :i64
  (cond (not (ck-bracket? M x)) (nm-nf M x NF-TOK)
        (zero? (nm-first M x)) (inc (nm-nf M x NF-TOK))
        :else (inc (ck-end-tok M (ck-last M (nm-first M x))))))
(defn- ck-r5b-err-vec [M :vector-i64 code :i64 v :i64 n :i64] :vector-i64
  (let [a (nm-tf M (nm-nf M v NF-TOK) TF-START)
        b (nm-tf M (ck-end-tok M v) TF-END)]
    (nm-put (nm-err-span M code a b n) MM-R0 0)))
;; one clause (op [params] body ..) of handler form d (name node nmn): the clause FN f (made by the caller) gets its body
(defn- ck-r5b-clause-fn [M :vector-i64 S :string d :i64 c :i64 op :i64 S0 :i64] :vector-i64
  (let [nmn (nm-nth M d 1)
        p (nm-nth M c 1)
        e (nm-nth M c 2)
        np (if (= op 1) 1 2)
        tok (nm-nf M (nm-first M c) NF-TOK)]
    (cond (or (nm-ne (nm-kind M p) ND-VEC) (nm-ne (nm-count M p) np) (nm-ne (nm-count-syms M p) np))
          (if (= (nm-kind M p) ND-VEC) (ck-r5b-err-vec M E-STATE-PARAMS p (+ nmn (i64-shift-left op 48))) (ck-err M E-STATE-OPS nmn 0))
          (zero? e) (ck-err M E-STATE-RESUME nmn (i64-shift-left op 48))
          :else
          (let [M1 (if (zero? (nm-next M e)) M (let [M2 (ck-mkh M tok HD-DO e)] (ck-link M2 p (ck-r M2))))
                M3 (ck-ds-walk M1 S (nm-nth M1 c 2))
                M4 (ck-fn-new M3 c FK-LAMBDA np)
                f (ck-r M4)]
            (-> M4 (nm-set-ff f FF-PT0 S0) (nm-set-ff f (inc FF-PT0) S0) (nm-set-ff f FF-RTYPE S0)
                (ck-f2-set f FN2-FLAGS (if (= op 1) 4 8)) (ck-f2-set f FN2-ORIGIN (nm-sym-of M4 nmn)) (ck-f2-set f FN2-S S0)
                (ck-f2-set f FN2-NODE d) (nm-put MM-R0 f))))))
;; (defhandler NAME DOC? [:state S] (get [s] ..) (put [s v] ..)): its two clause FNs, get then put
(defn- ck-r5b-defhandler [M :vector-i64 S :string d :i64] :vector-i64
  (let [nmn (nm-nth M d 1)
        x (nm-nth M d 2)
        sv (if (= (nm-kind M x) ND-STR) (nm-next M x) x)
        c0 (nm-next M sv)
        M1 (ck-r5b-clause-of M S c0 "get")
        cg (ck-r M1)
        ng (vector-at M1 MM-R1)
        M2 (ck-r5b-clause-of M1 S c0 "put")
        cp (ck-r M2)
        npt (vector-at M2 MM-R1)]
    (cond (nm-ne (nm-kind M2 nmn) ND-SYM) (ck-err M2 E-CHECK-SIGNATURE d 0)
          (pos? (ck-r5b-handler M2 (nm-sym-of M2 nmn))) (ck-err M2 E-NAMES-DUP nmn 0)
          (or (nm-ne (nm-kind M2 sv) ND-VEC) (nm-ne (nm-count M2 sv) 2) (nm-ne (nm-head-of M2 (nm-first M2 sv)) KW-STATE))
          (ck-err M2 E-CHECK-SIGNATURE nmn 0)
          (or (nm-ne ng 1) (nm-ne npt 1) (nm-ne (ck-chain-len M2 c0) 2)) (ck-err M2 E-STATE-OPS nmn 0)
          :else
          (let [M3 (ck-tform M2 (nm-nth M2 sv 1))
                S0 (ck-r M3)]
            (if (zero? S0)
              (ck-err M3 E-CHECK-TYPENAME (nm-nth M3 sv 1) 0)
              (ck-r5b-clause-fn (ck-r5b-clause-fn M3 S d cg 1 S0) S d cp 2 S0))))))

;; check clause FN f: (s) or (s v) of S; every tail a resume (the body is bottom), no capability and no :state (E2153)
(defn- ck-r5b-clause-body [M :vector-i64 f :i64] :vector-i64
  (let [c (nm-ff M f FF-NODE)
        p (nm-nth M c 1)
        S0 (ck-f2 M f FN2-S)
        op (ck-r5b-op-of M f)
        nmn (ck-r5b-hname M f)
        h0 (nm-scope-height M)
        M1 (-> (ck-state-reset M f) (nm-set-ff f FF-NSLOTS (nm-ff M f FF-NPARAMS)) (nm-set-ff f FF-FUEL 0))
        M2 (loop [M3 M1 b (nm-first M1 p) k 1]
             (if (or (zero? b) (nm-failed M3)) M3 (recur (ck-bind (ck-binder-ok M3 b h0) b k S0 f) (nm-next M3 b) (inc k))))
        M4 (ck-expr M2 (nm-nth M2 c 2) (+ (* f 1024) (inc (nm-ff M2 f FF-NPARAMS))) (+ (* p 2) 1))
        ty (ck-ty M4)
        M5 (nm-unbind M4 h0)]
    (cond (nm-failed M5) M5
          (pos? (ck-f2 M5 f FN2-CAPS)) (ck-err M5 E-STATE-IMPURE nmn (+ (ck-f2 M5 f FN2-CAPS) (i64-shift-left op 48)))
          (pos? ty) (ck-err M5 E-STATE-RESUME nmn (i64-shift-left op 48))
          :else M5)))

;; a walk over node n (fn literals skipped): mode 0 -> 1 when it performs :state or calls a stateful defn outside every handle
;; body; mode 1 -> 1 at a throw/try, 2 at a call of an aborting defn (handle bodies included); mode 2 -> the first handle form
;; whose body has a mode-1 answer: that answer
(defn- ck-r5b-walk [M :vector-i64 n :i64 mode :i64] :i64
  (let [k (nm-kind M n)
        hd (ck-hd-of M n)
        g (ck-callee-of M n)]
    (cond (or (= k ND-VEC) (= k ND-MAP) (= k ND-SET)) (ck-r5b-walks M (nm-first M n) mode)
          (nm-ne k ND-LIST) 0
          (ck-fn-form? M n) 0
          (and (= mode 0) (= hd HD-PERFORM) (pos? (ck-perform-op M n))) 1
          (and (= mode 0) (= hd HD-HANDLE)) (ck-r5b-walks M (nm-nth M n 2) mode)
          (and (= mode 0) (ck-r5b-tmpl? M g)) 1
          (and (= mode 1) (or (= hd HD-THROW) (= hd HD-TRY))) 1
          (and (= mode 1) (pos? g) (nm-ne (nm-sf M (nm-ff M g FF-SYM) SF-ABORT) 0)) 2
          (and (= mode 2) (= hd HD-HANDLE) (pos? (ck-r5b-walk M (nm-nth M n 1) 1))) (ck-r5b-walk M (nm-nth M n 1) 1)
          :else (ck-r5b-walks M (nm-first M n) mode))))
(defn- ck-r5b-walks [M :vector-i64 c :i64 mode :i64] :i64
  (loop [x c]
    (if (zero? x)
      0
      (let [r (ck-r5b-walk M x mode)] (if (zero? r) (recur (nm-next M x)) r)))))

;; mark the stateful defns: rounds until nothing changes
(defn- ck-r5b-stateful [M :vector-i64] :vector-i64
  (let [M1 (loop [M2 M f 1 ch 0]
             (cond (>= f (vector-at M2 MM-FN-N)) (nm-put M2 MM-R0 ch)
                   (and (ck-is-defn M2 f) (not (ck-r5b-tmpl? M2 f)) (pos? (ck-r5b-walk M2 (ck-defn-body M2 f) 0)))
                   (recur (ck-f2-or M2 f FN2-FLAGS 1) (inc f) (inc ch))
                   :else (recur M2 (inc f) ch)))]
    (if (pos? (ck-r M1)) (ck-r5b-stateful M1) M1)))

;; resolve every (handle body (with h init)) of node n: shape (E2164), handler (E2158); the handler's get FN goes to NF-TYPE
;; of the `with` symbol node. S tells a qualified name (alias/name) apart: never a handler of this module.
(defn- ck-r5b-handles [M :vector-i64 S :string n :i64] :vector-i64
  (let [k (nm-kind M n)]
    (cond (nm-failed M) M
          (or (= k ND-LIST) (= k ND-VEC) (= k ND-MAP) (= k ND-SET))
          (let [M1 (if (= (ck-hd-of M n) HD-HANDLE) (ck-r5b-handle1 M S n) M)]
            (loop [M2 M1 x (nm-first M1 n)] (if (or (zero? x) (nm-failed M2)) M2 (recur (ck-r5b-handles M2 S x) (nm-next M2 x)))))
          :else M)))
(defn- ck-r5b-handle1 [M :vector-i64 S :string n :i64] :vector-i64
  (let [h (nm-first M n)
        w (nm-nth M n 2)
        hn (nm-nth M w 1)
        a (nm-tf M (nm-nf M hn NF-TOK) TF-START)
        b (nm-tf M (nm-nf M hn NF-TOK) TF-END)]
    (cond (or (nm-ne (nm-count M n) 3) (nm-ne (ck-hd-of M w) HD-WITH) (nm-ne (nm-count M w) 3) (nm-ne (nm-kind M hn) ND-SYM)
              (pos? (string-index-of (string-substring S a b) "/")))
          (ck-err M E-STATE-HANDLE h 0)
          (zero? (ck-r5b-handler M (nm-sym-of M hn))) (ck-err M E-STATE-NOHANDLER hn 0)
          :else (nm-set-nf M (nm-first M w) NF-TYPE (ck-r5b-handler M (nm-sym-of M hn))))))

;; the refusals of defn f: a stateful one with more than 4 parameters (E2171), exported (E2150), with throw/try (E2157) or an
;; aborting call (E2162); a handle body with throw/try (E2157) or an aborting call (E2163)
(defn- ck-r5b-refuse [M :vector-i64 f :i64] :vector-i64
  (let [nm (nm-nth M (nm-ff M f FF-NODE) 1)
        body (ck-defn-body M f)
        t? (ck-r5b-tmpl? M f)
        a (if t? (ck-r5b-walk M body 1) 0)
        hb (ck-r5b-walk M body 2)]
    (cond (and t? (> (nm-ff M f FF-NPARAMS) 4)) (ck-err M E-STATE-PARAMS4 nm 0)
          (and t? (pos? (nm-ff M f FF-EXPORT))) (ck-err M E-STATE-EXPORT nm 0)
          (= a 1) (ck-err M E-STATE-THROW nm 0)
          (= a 2) (ck-err M E-STATE-ABORTS nm 0)
          (= hb 1) (ck-err M E-STATE-THROW nm 0)
          (= hb 2) (ck-err M E-STATE-ABORT-CALL nm 0)
          :else M)))

;; ---- effect ceilings ----
;; the capabilities of node n (typed-cap-call wires, perform of a capability, the FN2-FX of the defns it calls)
(defn- ck-r5b-caps-of [M :vector-i64 n :i64] :i64
  (let [k (nm-kind M n)
        hd (ck-hd-of M n)
        g (ck-callee-of M n)
        w (nm-nth M n 1)
        own (cond (= hd HD-TYPED-CAP-CALL) (ck-wire-bit (if (= (nm-kind M w) ND-INT) (nm-nf M w NF-AUX) (ck-kw-wire (nm-head-of M w))))
                  (= hd HD-PERFORM) (ck-wire-bit (ck-kw-wire (nm-head-of M w)))
                  (pos? g) (ck-f2 M g FN2-FX)
                  :else 0)]
    (if (or (= k ND-LIST) (= k ND-VEC) (= k ND-MAP) (= k ND-SET))
      (loop [x (nm-first M n) acc own] (if (zero? x) acc (recur (nm-next M x) (bit-or acc (ck-r5b-caps-of M x)))))
      0)))
(defn- ck-r5b-fx-round [M :vector-i64] :vector-i64
  (loop [M1 M f 1 ch 0]
    (cond (>= f (vector-at M1 MM-FN-N)) (nm-put M1 MM-R0 ch)
          (not (ck-is-defn M1 f)) (recur M1 (inc f) ch)
          :else (let [v (bit-or (ck-f2 M1 f FN2-FX) (ck-r5b-caps-of M1 (ck-defn-body M1 f)))]
                  (if (= v (ck-f2 M1 f FN2-FX)) (recur M1 (inc f) ch) (recur (ck-f2-set M1 f FN2-FX v) (inc f) (inc ch)))))))
(defn- ck-r5b-fx [M :vector-i64] :vector-i64
  (let [M1 (ck-r5b-fx-round M)] (if (pos? (ck-r M1)) (ck-r5b-fx M1) M1)))
;; the effect mask a ceiling map {:effects #{..}} declares
(defn- ck-r5b-ceil-mask [M :vector-i64 m :i64] :i64
  (let [v (nm-next M (nm-first M m))]
    (loop [x (nm-first M v) acc 0]
      (cond (zero? x) acc
            (= (nm-head-of M x) KW-STATE) (recur (nm-next M x) (bit-or acc ck-fx-state))
            :else (recur (nm-next M x) (bit-or acc (ck-wire-bit (ck-kw-wire (nm-head-of M x)))))))))
(defn- ck-r5b-ceilings [M :vector-i64] :vector-i64
  (let [any (loop [f 1] (cond (>= f (vector-at M MM-FN-N)) false
                              (and (ck-is-defn M f) (pos? (nm-nf M (nm-nth M (nm-ff M f FF-NODE) 1) NF-TYPE))) true
                              :else (recur (inc f))))]
    (if (not any)
      M
      (let [M1 (ck-r5b-fx M)]
        (loop [M2 M1 f 1]
          (if (or (>= f (vector-at M2 MM-FN-N)) (nm-failed M2))
            M2
            (let [nm (nm-nth M2 (nm-ff M2 f FF-NODE) 1)
                  m (nm-nf M2 nm NF-TYPE)
                  fx (bit-or (ck-f2 M2 f FN2-FX) (if (ck-r5b-tmpl? M2 f) ck-fx-state 0))
                  over (if (and (ck-is-defn M2 f) (pos? m)) (bit-and fx (bit-not (ck-r5b-ceil-mask M2 m))) 0)]
              (if (pos? over) (ck-err M2 E-STATE-CEILING nm over) (recur M2 (inc f))))))))))

;; the whole pass (after ab-pre, before pass B)
(defn- ck-r5b-pass [M :vector-i64 S :string] :vector-i64
  (let [nf0 (vector-at M MM-FN-N)
        M1 (loop [M2 M c (nm-first M (vector-at M MM-ROOT))]
             (cond (or (zero? c) (nm-failed M2)) M2
                   (= (nm-form-head M2 c) HD-DEFHANDLER) (recur (ck-r5b-defhandler M2 S c) (nm-next M2 c))
                   :else (recur M2 (nm-next M2 c))))
        M3 (if (nm-failed M1) M1 (ck-r5b-stateful M1))
        M4 (loop [M5 M3 f 1]
             (cond (or (>= f nf0) (nm-failed M5)) M5
                   (ck-is-defn M5 f) (recur (ck-r5b-refuse (ck-r5b-handles M5 S (ck-defn-body M5 f)) f) (inc f))
                   :else (recur M5 (inc f))))
        M6 (if (nm-failed M4) M4 (ck-r5b-ceilings M4))]
    (loop [M7 M6 f nf0]
      (cond (or (>= f (vector-at M7 MM-FN-N)) (nm-failed M7)) M7
            (ck-r5b-clause? M7 f) (recur (ck-r5b-clause-body M7 f) (inc f))
            :else (recur M7 (inc f))))))

;; =========================================================================================================
;; R6B (agent R6B, 2026-10-03): source-route features of rung R6 (docs/selfhost-seed-r6b-report-20261003.md).
;; (1) The source library. Operations the reference has and the seed has no head for (:document and its document-*
;;     operations, keyword-name, keyword-from-string, string-find-byte, min, max) are Kotoba defn-s
;;     (seed/tests/r6b/srclib/r6b-lib.kotoba + the KIR doclib, embedded below by gen-srclib.py). ck-r6b-lib S answers the
;;     text to APPEND to a module's source: the groups the module spells as a call head (or :document as a keyword),
;;     outside strings and comments, minus a single-function group the module defines itself. The driver (single-module
;;     route) and 60-proj (per module, after its trailer) append it before lexing; a module that spells none of them gets
;;     "" and compiles to the same bytes as before. Representations: a document is the :string of its canonical EDN text
;;     (stage-0's and the KIR route's), a keyword the FNV-1a hash of its spelling (R6A); a keyword's TEXT comes from the
;;     module's table __r6-kwtab (every keyword the module spells + the document kinds).
;; (2) __r6-as (HD-R6-AS): (__r6-as T x) retypes x as T, no code.
;; (3) Desugaring (in ck-ds-walk, before typing): (vector-i64 a ..) -> [a ..]; (document-vector|list|set|map a ..) -> the
;;     fold of the KIR route ((__r6-dbd (step .. (step (document-X) a) ..))); a keyword LITERAL where a document key is
;;     expected (2nd argument of document-get/-contains/-assoc/-dissoc, keys of document-map) -> (document-keyword :k),
;;     the reference's "keyword map keys" (stage-0: a native keyword's text IS its document).
;; =========================================================================================================
;; after the string literal whose opening quote is at i (the end of S when unclosed)
(defn- ck-r6b-strend [S :string i :i64] :i64
  (loop [j (+ i 1)]
    (cond (>= j (string-length S)) j
          (= (string-code-point-at S j) 34) (+ j 1)
          (= (string-code-point-at S j) 92) (if (>= (+ j 1) (string-length S)) (+ j 1) (recur (+ (+ j 1) (lx-cpw (string-code-point-at S (+ j 1))))))
          :else (recur (+ j (lx-cpw (string-code-point-at S j)))))))
;; after the character literal whose backslash is at i
(defn- ck-r6b-charend [S :string i :i64] :i64
  (if (>= (+ i 1) (string-length S)) (+ i 1) (+ (+ i 1) (lx-cpw (string-code-point-at S (+ i 1))))))
(defn- ck-r6b-symend [S :string i :i64] :i64
  (loop [j i] (if (and (< j (string-length S)) (lx-symch? (string-code-point-at S j))) (recur (+ j 1)) j)))
(defn- ck-r6b-is? [S :string a :i64 b :i64 t :string] :bool
  (and (= (- b a) (string-length t)) (string=? (string-substring S a b) t)))
(defn- ck-r6b-head-bit [S :string a :i64 b :i64] :i64
  (if (and (> (- b a) 9) (string=? (string-substring S a (+ a 9)) "document-"))
    ck-r6b-g-doc
    (ck-r6b-name-bit (nm-hash S a b))))
(defn- ck-r6b-defhead? [S :string a :i64 b :i64] :bool
  (or (ck-r6b-is? S a b "defn") (ck-r6b-is? S a b "defn-") (ck-r6b-is? S a b "def")))

;; the library groups module text S needs: the groups it spells, minus single-function groups it defines; exi needs doc,
;; doc needs kw
(defn- ck-r6b-scan [S :string] :i64
  (let [n (string-length S)
        r (loop [i 0 used 0 defd 0 pd false]
            (if (>= i n)
              (bit-and used (bit-not (bit-and defd (bit-not (bit-or ck-r6b-g-kw ck-r6b-g-doc)))))
              (let [c (string-code-point-at S i)]
                (cond (= c 59) (recur (lx-eol S i) used defd false)
                      (= c 34) (recur (ck-r6b-strend S i) used defd false)
                      (= c 92) (recur (ck-r6b-charend S i) used defd false)
                      (= c 40) (let [b (ck-r6b-symend S (+ i 1))]
                                 (if (= b (+ i 1))
                                   (recur b used defd false)
                                   (recur b (bit-or used (ck-r6b-head-bit S (+ i 1) b)) defd (ck-r6b-defhead? S (+ i 1) b))))
                      (= c 58) (let [b (ck-r6b-symend S (+ i 1))]
                                 (recur b (if (ck-r6b-is? S i b ":document") (bit-or used ck-r6b-g-doc) used) defd false))
                      (lx-symch? c) (let [b (ck-r6b-symend S i)]
                                      (recur b used (if pd (bit-or defd (ck-r6b-name-bit (nm-hash S i b))) defd) false))
                      :else (recur (+ i (lx-cpw c)) used defd (if (lx-ws? c) pd false))))))
        r2 (if (pos? (bit-and r ck-r6b-g-exi)) (bit-or r ck-r6b-g-doc) r)]
    (if (pos? (bit-and r2 ck-r6b-g-doc)) (bit-or r2 ck-r6b-g-kw) r2)))

;; the module's keyword table: " :k1 :k2 .. " (each spelling once), the 11 document kinds first
(defn- ck-r6b-kwtab [S :string] :string
  (let [n (string-length S)]
    (loop [i 0 acc " :null :bool :i64 :f64 :string :keyword :symbol :vector :list :set :map "]
      (if (>= i n)
        acc
        (let [c (string-code-point-at S i)]
          (cond (= c 59) (recur (lx-eol S i) acc)
                (= c 34) (recur (ck-r6b-strend S i) acc)
                (= c 92) (recur (ck-r6b-charend S i) acc)
                (= c 58) (let [b (ck-r6b-symend S (+ i 1))]
                           (if (= b (+ i 1))
                             (recur b acc)
                             (let [k (string-substring S i b)]
                               (recur b (if (>= (string-index-of acc (string-concat " " (string-concat k " "))) 0)
                                          acc
                                          (string-concat acc (string-concat k " ")))))))
                :else (recur (+ i (lx-cpw c)) acc)))))))

(defn- ck-r6b-pick [m :i64 g :i64 t :string] :string (if (zero? (bit-and m g)) "" t))

;; the text appended to module source S ("" when it needs no library group)
(defn ck-r6b-lib [S :string] :string
  (let [m (ck-r6b-scan S)]
    (if (zero? m)
      ""
      (-> "\n"
          (string-concat (ck-r6b-pick m ck-r6b-g-kw (ck-r6b-t-kw)))
          (string-concat (ck-r6b-pick m ck-r6b-g-kw (string-concat "(defn- __r6-kwtab [] :string \"" (string-concat (ck-r6b-kwtab S) "\")\n"))))
          (string-concat (ck-r6b-pick m ck-r6b-g-doc (ck-r6b-t-doc)))
          (string-concat (ck-r6b-pick m ck-r6b-g-exi (ck-r6b-t-exi)))
          (string-concat (ck-r6b-pick m ck-r6b-g-sfb (ck-r6b-t-sfb)))
          (string-concat (ck-r6b-pick m ck-r6b-g-min (ck-r6b-t-min)))
          (string-concat (ck-r6b-pick m ck-r6b-g-max (ck-r6b-t-max)))
          (string-concat (ck-r6b-pick m ck-r6b-g-rem (ck-r6b-t-rem)))
          (string-concat (ck-r6b-pick m ck-r6b-g-utf8 (ck-r6b-t-utf8)))
          (string-concat (ck-r6b-pick m ck-r6b-g-parse (ck-r6b-t-parse)))
          (string-concat (ck-r6b-pick m ck-r6b-g-sym (ck-r6b-t-sym)))
          (string-concat (ck-r6b-pick m ck-r6b-g-vec (ck-r6b-t-vec)))
          (string-concat (ck-r6b-pick m ck-r6b-g-f64 (ck-r6b-t-f64)))))))   ; R6C

;; the FN index of the library defn whose spelling hashes to h (the first clause), 0 when absent
(defn- ck-r6b-fn [M :vector-i64 h :i64] :i64
  (loop [f 1]
    (cond (>= f (vector-at M MM-FN-N)) 0
          (and (= (nm-sf M (nm-ff M f FF-SYM) SF-HASH) h) (or (= (nm-ff M f FF-KIND) FK-DEFN) (= (nm-ff M f FF-KIND) FK-PRIV))) f
          :else (recur (inc f)))))

;; synthetic head / keyword nodes of R6B (gensym cache indexes 240.. : clear of the head (code) and keyword (128 + code)
;; indexes the R1 helpers ck-n-head / ck-n-kw use)
(defn- ck-r6b-nhead [M :vector-i64 tok :i64 code :i64 idx :i64] :vector-i64
  (let [M1 (ck-csym M idx code)] (ck-new M1 ND-SYM tok 0 (ck-r M1))))
(defn- ck-r6b-nkw [M :vector-i64 tok :i64 kwc :i64 idx :i64] :vector-i64
  (let [M1 (ck-csym M idx kwc)] (ck-new M1 ND-KW tok 0 (ck-r M1))))
;; a new list (code x) (x's NF-NEXT := 0); R0 = the list
(defn- ck-r6b-wrap [M :vector-i64 tok :i64 code :i64 idx :i64 x :i64] :vector-i64
  (let [M1 (ck-r6b-nhead M tok code idx)
        hn (ck-r M1)
        M2 (ck-chain2 M1 hn x)]
    (ck-n-list M2 tok hn)))
(defn- ck-r6b-dockey [M :vector-i64 x :i64] :vector-i64 (ck-r6b-wrap M (nm-nf M x NF-TOK) HD-R6-DOCKEY 241 x))
(defn- ck-r6b-todoc [M :vector-i64 x :i64] :vector-i64 (ck-r6b-wrap M (nm-nf M x NF-TOK) HD-R6-TODOC 242 x))
(defn- ck-r6b-tostr [M :vector-i64 x :i64] :vector-i64 (ck-r6b-wrap M (nm-nf M x NF-TOK) HD-R6-TOSTR 243 x))

;; ---- (__r6-as T x) / (__r6-is T x): the second also requires x's type to be T ----
(defn- ck-r6b-as [M :vector-i64 n :i64 fx :i64 hd :i64] :vector-i64
  (let [h (nm-first M n)]
    (if (nm-ne (nm-count M n) 3)
      (ck-err M E-CHECK-ARITY h 2)
      (let [tn (nm-nth M n 1)
            M1 (ck-tform M tn)
            ty (ck-ty M1)]
        (cond (nm-failed M1) (ck-touch M1)
              (zero? ty) (ck-err M1 E-CHECK-TYPENAME tn 0)
              :else (let [x (nm-nth M1 n 2)
                          M2 (ck-expr (nm-set-nf M1 tn NF-TYPE ty) x fx 0)]
                      (cond (nm-failed M2) (ck-touch M2)
                            (and (= hd HD-R6-IS) (nm-ne (ck-ty M2) ty)) (ck-err M2 E-CHECK-TYPE (nm-first M2 n) ty)
                            :else (ck-mark M2 n ty hd))))))))

;; ---- (__r6-todoc x) (__r6-dockey x) (__r6-tostr x): x is checked once; the node becomes (do x) or a call of the library
;; defn that converts x's type (the head symbol resolves to it: NF-RES = RES-FN, the node HD-CALL)
(defn- ck-r6b-conv-fn [hd :i64 ty :i64] :i64
  ;; (str ..) items: :string and :i64 only, as stage-0 (measured 2026-10-03: a :keyword or :bool item is "expression type
  ;; mismatch: expected string" there)
  (cond (= hd HD-R6-TOSTR) (cond (= ty TY-STR) -1 (= ty TY-I64) ck-r6b-h-__r6-i2s :else 0)
        (= ty TY-DOC) -1
        (= ty TY-KW) ck-r6b-h-document-keyword
        (= hd HD-R6-DOCKEY) 0
        (= ty TY-I64) ck-r6b-h-document-i64
        (= ty TY-STR) ck-r6b-h-document-string
        (= ty TY-BOOL) ck-r6b-h-document-bool
        :else 0))
(defn- ck-r6b-conv [M :vector-i64 n :i64 hd :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)]
    (if (nm-ne (nm-count M n) 2)
      (ck-err M E-CHECK-ARITY h 1)
      (let [M1 (ck-expr M (nm-nth M n 1) fx 0)
            ty (ck-ty M1)
            fh (ck-r6b-conv-fn hd ty)
            fi (if (and (nm-ne fh 0) (nm-ne fh -1)) (ck-r6b-fn M1 fh) 0)   ; a hash may be negative
            want (if (= hd HD-R6-TOSTR) TY-STR TY-DOC)]
        (cond (nm-failed M1) (ck-touch M1)
              (= fh -1) (ck-mark M1 n ty HD-DO)
              (zero? fh) (ck-err M1 E-CHECK-TYPE h want)
              (zero? fi) (ck-err M1 E-CHECK-HEAD h 0)
              :else (ck-mark (ck-fuel (nm-set-nf M1 h NF-RES (+ (* RES-FN RES-SCALE) fi)) (ck-fx-f fx)) n (nm-ff M1 fi FF-RTYPE) HD-CALL))))))

;; ---- (get d k default) on a :document -> (option-value-of [:option :document] (document-get d (__r6-dockey k)) default).
;; d is checked first (with the 5 hidden slots ck-gget takes, so a map get re-checks it the same way)
(defn- ck-r6b-get [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [M1 (ck-expr M (nm-nth M n 1) (+ fx 5) 0)]
    (cond (nm-failed M1) (ck-touch M1)
          (= (ck-ty M1) TY-DOC) (ck-r6b-docget M1 n fx)
          :else (ck-gget M1 n fx))))
(defn- ck-r6b-docget [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        tok (nm-nf M h NF-TOK)
        d (nm-next M h)
        k (nm-next M d)
        dflt (nm-next M k)
        fi (ck-r6b-fn M ck-r6b-h-document-get)]
    (if (zero? fi)
      (ck-err M E-CHECK-HEAD h 0)
      (let [M1 (ck-r6b-dockey M k)
            dk (ck-r M1)
            M2 (ck-n-ref M1 tok (nm-ff M1 fi FF-SYM))
            gh (ck-r M2)
            M3 (ck-link (ck-chain2 M2 gh d) d dk)
            M4 (ck-n-list M3 tok gh)
            dg (ck-r M4)
            M5 (ck-r6b-nkw M4 tok KW-OPTION 250)
            ko (ck-r M5)
            M6 (ck-r6b-nkw M5 tok KW-DOCUMENT 251)
            kd (ck-r M6)
            M7 (ck-n-vec (ck-chain2 M6 ko kd) tok ko)
            tv (ck-r M7)
            M8 (ck-r6b-nhead M7 tok HD-OPTION-VALUE 244)
            oh (ck-r M8)
            M9 (ck-chain3 (ck-link M8 oh tv) tv dg dflt)
            M10 (nm-set-nf M9 n NF-FIRST oh)]
        (ck-expr M10 n fx 0)))))

;; R6B: (assoc d k v) with d a :document -> (document-assoc d (__r6-dockey k) v), then checked (kotoba.codegen.layout)
(defn- ck-r6b-assoc [M :vector-i64 n :i64 fx :i64] :vector-i64
  (let [h (nm-first M n)
        fi (ck-r6b-fn M ck-r6b-h-document-assoc)]
    (if (zero? fi)
      (ck-err M E-CHECK-HEAD h 0)
      (let [d (nm-next M h)
            k (nm-next M d)
            after (nm-next M k)
            M1 (ck-r6b-dockey M k)
            w (ck-r M1)
            M2 (ck-link (ck-link M1 d w) w after)
            M3 (ck-n-ref M2 (nm-nf M2 h NF-TOK) (nm-ff M2 fi FF-SYM))
            gh (ck-r M3)
            M4 (ck-link M3 gh d)
            M5 (nm-set-nf M4 n NF-FIRST gh)]
        (ck-expr M5 n fx 0)))))

;; R6B: (nth d i) / (count d) with d a :document -> (__r6-dnth d i) (the library's list/vector item, a trap when absent) /
;; (document-count d): the head becomes a call of the library defn with hash fh, then the list is checked again
(defn- ck-r6b-nth [M :vector-i64 n :i64 fx :i64 fh :i64] :vector-i64
  (let [h (nm-first M n)
        fi (ck-r6b-fn M fh)]
    (if (zero? fi)
      (ck-err M E-CHECK-HEAD h 0)
      (let [M1 (ck-n-ref M (nm-nf M h NF-TOK) (nm-ff M fi FF-SYM))
            gh (ck-r M1)
            M2 (ck-link M1 gh (nm-next M1 h))
            M3 (nm-set-nf M2 n NF-FIRST gh)]
        (ck-expr M3 n fx 0)))))

;; ---- desugaring ----
;; the symbol of library defn `name` (its spelling in the appended library text), 0 when the library is absent
(defn- ck-r6b-sym [M :vector-i64 S :string name :string] :i64
  (let [p (string-index-of S (string-concat "(defn- " (string-concat name " ")))]
    (if (< p 0) 0 (nm-lookup M S (+ p 7) (+ (+ p 7) (string-length name))))))

;; the head code of list x, 0 when it is no head
(defn- ck-r6b-hd [M :vector-i64 x :i64] :i64
  (if (= (nm-kind M x) ND-LIST) (nm-head-of M (nm-first M x)) 0))
;; 1 when symbol s is free to mean the library operation: no definition of the module, no head
(defn- ck-r6b-free? [M :vector-i64 s :i64] :bool (and (zero? (nm-sf M s SF-FN)) (zero? (nm-sf M s SF-HEAD))))

;; 0 none, 1 vector-i64, 2 3 4 5 document-vector list set map with items, 6 a document key to wrap, 7 (str ..),
;; 8 match-option, 9 ex-info with a map literal, 10 record-assoc, 11 a comparison of 3 or more operands, 12 a friendly
;; capability call (ck-r6b-cap)
(defn- ck-r6b-ds-code [M :vector-i64 n :i64] :i64
  (let [h (nm-first M n)
        s (nm-sym-of M h)
        hh (if (and (= (nm-kind M n) ND-LIST) (= (nm-kind M h) ND-SYM)) (nm-sf M s SF-HASH) 0)]
    (cond (zero? hh) 0
          (and (> (nm-count M n) 3) (zero? (nm-sf M s SF-FN)) (ck-r6b-cmphd? (nm-sf M s SF-HEAD)) (ck-r6b-mids? M n)) 11
          (= hh ck-r6b-h-vector-i64) (if (ck-r6b-free? M s) 1 0)
          (< (nm-count M n) 2) 0
          (= hh ck-r6b-h-str) (if (ck-r6b-free? M s) 7 0)
          (= hh ck-r6b-h-match-option) (if (ck-r6b-free? M s) 8 0)
          (= hh ck-r6b-h-document-vector) 2
          (= hh ck-r6b-h-document-list) 3
          (= hh ck-r6b-h-document-set) 4
          (= hh ck-r6b-h-document-map) 5
          (and (or (= hh ck-r6b-h-document-get) (= hh ck-r6b-h-document-contains) (= hh ck-r6b-h-document-assoc)
                   (= hh ck-r6b-h-document-dissoc))
               (>= (nm-count M n) 3)
               (nm-ne (ck-r6b-hd M (nm-nth M n 2)) HD-R6-DOCKEY)) 6
          (and (= hh ck-r6b-h-ex-info) (= (nm-count M n) 3) (= (nm-kind M (nm-nth M n 2)) ND-MAP)) 9
          (and (= hh ck-r6b-h-record-assoc) (= (nm-count M n) 5) (ck-r6b-free? M s)) 10
          (and (= (nm-count M n) 2) (ck-r6b-free? M s) (pos? (ck-r6b-capwire hh))) 12
          :else 0)))

;; R6B: a friendly capability call (ns/op x) of the catalogue (ck-r6b-capwire; lang/capability-catalog.edn :elaboration:
;; source arity 1, request from the argument, result from the context) -> (typed-cap-call :ns/op :string R x), R = :bytes for
;; fs/app-data-bytes and :string otherwise. Admitted wires: 3 20 23 33 34 35 37 38 39 41; any other catalogue name is E2115
;; at its head (named, never guessed).
(defn- ck-r6b-capkw [w :i64 hh :i64] :i64
  (case w
    3 KW-HASH-SHA256 20 KW-PROCESS-SPAWN 23 KW-ENTROPY-DRAW 33 KW-ENV-READ 34 KW-FS-BROWSE
    35 (if (= hh ck-r6b-h-fs-app-data-bytes) KW-FS-APP-DATA-BYTES KW-FS-APP-DATA)
    37 KW-IO-WRITE 38 KW-CLI-ARGS 39 KW-IO-WRITE-ERROR 41 KW-IO-READ
    0))
(defn- ck-r6b-cap [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        tok (nm-nf M h NF-TOK)
        x (nm-next M h)
        hh (nm-sf M (nm-sym-of M h) SF-HASH)
        kw (ck-r6b-capkw (ck-r6b-capwire hh) hh)]
    (if (zero? kw)
      (ck-err M E-CHECK-CAP h 0)
      (let [M1 (ck-n-kw M tok kw)
            wn (ck-r M1)
            M2 (ck-n-kw M1 tok KW-STRING)
            qn (ck-r M2)
            M3 (ck-n-kw M2 tok (if (= kw KW-FS-APP-DATA-BYTES) KW-BYTES KW-STRING))
            rn (ck-r M3)
            M4 (ck-link (ck-link (ck-link M3 wn qn) qn rn) rn x)]
        (ck-rehead M4 n HD-TYPED-CAP-CALL wn)))))

;; a new list (name x) (x's NF-NEXT := 0) calling library defn `name`; R0 = the list. E2101 at x when it is missing
(defn- ck-r6b-call1 [M :vector-i64 S :string name :string x :i64] :vector-i64
  (let [s (ck-r6b-sym M S name)
        tok (nm-nf M x NF-TOK)]
    (if (zero? s)
      (ck-err M E-CHECK-HEAD x 0)
      (let [M1 (ck-n-ref M tok s)
            hn (ck-r M1)
            M2 (ck-chain2 M1 hn x)]
        (ck-n-list M2 tok hn)))))

;; (op m k ..) -> (op m (__r6-dockey k) ..)
(defn- ck-r6b-keyed [M :vector-i64 n :i64] :vector-i64
  (let [m (nm-nth M n 1)
        k (nm-next M m)
        after (nm-next M k)
        M1 (ck-r6b-dockey M k)
        w (ck-r M1)]
    (ck-link (ck-link M1 m w) w after)))

;; (document-X a1 .. an) -> (__r6-dbd (step (.. (step (document-X) a1) ..) an)); map items in pairs, keys through __r6-dockey
(defn- ck-r6b-fold [M :vector-i64 S :string n :i64 code :i64] :vector-i64
  (let [h (nm-first M n)
        tok (nm-nf M h NF-TOK)
        ss (ck-r6b-sym M S (case code 4 "__r6-dss" 5 "__r6-dms" "__r6-dvs"))
        M1 (ck-n-copy M h)
        h0 (ck-r M1)
        M3 (ck-n-list (ck-link M1 h0 0) tok h0)]
    (if (zero? ss)
      (ck-err M3 E-CHECK-HEAD h 0)
      (loop [M4 M3 acc (ck-r M3) c (nm-next M3 h)]
        (cond (nm-failed M4) (ck-touch M4)
              (zero? c) (let [M5 (ck-r6b-call1 M4 S "__r6-dbd" acc)] (if (nm-failed M5) (ck-touch M5) (ck-become M5 n (ck-r M5))))
              (and (= code 5) (zero? (nm-next M4 c))) (ck-err M4 E-CHECK-ARITY h 2)
              :else
              (let [v (if (= code 5) (nm-next M4 c) 0)
                    nx (nm-next M4 (if (= code 5) v c))
                    M5 (if (= code 5) (ck-r6b-dockey M4 c) (nm-put M4 MM-R0 c))
                    kk (ck-r M5)
                    M6 (if (= code 5) (ck-chain2 M5 kk v) (ck-link M5 kk 0))
                    M7 (ck-n-ref M6 tok ss)
                    sh (ck-r M7)
                    M8 (ck-link (ck-link M7 sh acc) acc kk)
                    M9 (ck-n-list M8 tok sh)]
                (recur M9 (ck-r M9) nx)))))))

;; (str a) -> (__r6-tostr a); (str a b ..) -> (string-concat (.. (string-concat (__r6-tostr a) (__r6-tostr b)) ..) ..)
(defn- ck-r6b-str [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        tok (nm-nf M h NF-TOK)
        a (nm-next M h)
        nx (nm-next M a)
        M1 (ck-r6b-tostr M a)]
    (loop [M2 M1 acc (ck-r M1) c nx]
      (if (zero? c)
        (ck-become M2 n acc)
        (let [nx2 (nm-next M2 c)
              M3 (ck-r6b-tostr M2 c)
              t (ck-r M3)
              M4 (ck-chain2 M3 acc t)
              M5 (ck-mkh M4 tok HD-STRING-CONCAT acc)]
          (recur M5 (ck-r M5) nx2))))))

;; (match-option o T (none a) (some x b)) (either clause order) -> (option-match T o a x b)
(defn- ck-r6b-clause [M :vector-i64 n :i64 hh :i64] :i64
  (let [c3 (nm-nth M n 3)
        c4 (nm-nth M n 4)]
    (cond (and (= (nm-kind M c3) ND-LIST) (= (nm-sf M (nm-sym-of M (nm-first M c3)) SF-HASH) hh)) c3
          (and (= (nm-kind M c4) ND-LIST) (= (nm-sf M (nm-sym-of M (nm-first M c4)) SF-HASH) hh)) c4
          :else 0)))
(defn- ck-r6b-match [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        o (nm-next M h)
        ty (nm-next M o)
        cn (ck-r6b-clause M n ck-r6b-h-none)
        cs (ck-r6b-clause M n ck-r6b-h-some)]
    (if (or (nm-ne (nm-count M n) 5) (zero? cn) (zero? cs) (nm-ne (nm-count M cn) 2) (nm-ne (nm-count M cs) 3))
      (ck-err M E-CHECK-ARITY h 4)
      (let [a (nm-nth M cn 1)
            x (nm-nth M cs 1)
            b (nm-nth M cs 2)
            M1 (ck-r6b-nhead M (nm-nf M h NF-TOK) HD-OPTION-MATCH 245)
            mh (ck-r M1)
            M2 (-> M1 (ck-link mh ty) (ck-link ty o) (ck-link o a) (ck-link a x) (ck-link x b) (ck-link b 0))]
        (nm-set-nf M2 n NF-FIRST mh)))))

;; (op a b c ..) for op = < > <= >= = -> (and (op a b) (op b' c) ..), the reference's variadic comparison. Admitted only
;; when every operand after the first and before the last is a symbol or an integer literal (b' is a copy of the node, so
;; nothing is evaluated twice that could differ); otherwise the arity error stays.
(defn- ck-r6b-cmphd? [hd :i64] :bool
  (or (= hd HD-LT) (= hd HD-GT) (= hd HD-LE) (= hd HD-GE) (= hd HD-EQ)))
(defn- ck-r6b-mids? [M :vector-i64 n :i64] :bool
  (loop [c (nm-next M (nm-next M (nm-first M n)))]
    (cond (zero? (nm-next M c)) true
          (or (= (nm-kind M c) ND-INT) (and (= (nm-kind M c) ND-SYM) (zero? (nm-head-of M c)))) (recur (nm-next M c))
          :else false)))
(defn- ck-r6b-dup [M :vector-i64 y :i64] :vector-i64
  (if (= (nm-kind M y) ND-INT) (ck-n-int M (nm-nf M y NF-TOK) (nm-nf M y NF-AUX)) (ck-n-copy M y)))
(defn- ck-r6b-cmp [M :vector-i64 n :i64 hd :i64] :vector-i64
  (let [h (nm-first M n)
        tok (nm-nf M h NF-TOK)]
    (loop [M1 M x (nm-next M h) prev 0 f0 0]
      (let [y (nm-next M1 x)]
        (if (zero? y)
          (let [M2 (ck-mkh M1 tok HD-AND f0)] (ck-become M2 n (ck-r M2)))
          (let [ny (nm-next M1 y)
                M2 (if (zero? ny) (nm-put M1 MM-R0 0) (ck-r6b-dup M1 y))
                y2 (ck-r M2)
                M3 (ck-chain2 (ck-link M2 y2 ny) x y)
                M4 (ck-mkh M3 tok hd x)
                pl (ck-r M4)
                M5 (ck-link M4 prev pl)]
            (recur M5 y2 pl (if (zero? f0) pl f0))))))))

;; (record-assoc SCHEMA r :f v) -> (assoc (__r6-is SCHEMA r) :f v)
(defn- ck-r6b-recassoc [M :vector-i64 n :i64] :vector-i64
  (let [h (nm-first M n)
        tok (nm-nf M h NF-TOK)
        s (nm-next M h)
        r (nm-next M s)
        kw (nm-next M r)
        M1 (ck-r6b-nhead M tok HD-R6-IS 246)
        ih (ck-r M1)
        M2 (ck-link (ck-link M1 ih s) r 0)
        M3 (ck-n-list M2 tok ih)
        il (ck-r M3)
        M4 (ck-r6b-nhead M3 tok HD-ASSOC 247)
        ah (ck-r M4)
        M5 (ck-link (ck-link M4 ah il) il kw)]
    (nm-set-nf M5 n NF-FIRST ah)))

;; (ex-info msg {k v ..}) -> (ex-info msg (document-map k (__r6-todoc v) ..)) (the reference's map-literal data)
(defn- ck-r6b-exinfo [M :vector-i64 S :string n :i64] :vector-i64
  (let [m (nm-nth M n 2)
        tok (nm-nf M m NF-TOK)
        s (ck-r6b-sym M S "document-map")]
    (if (zero? s)
      (ck-err M E-CHECK-HEAD m 0)
      (let [M1 (ck-n-ref M tok s)
            dh (ck-r M1)
            M2 (ck-link M1 dh (nm-first M1 m))
            M3 (loop [M4 M2 prev dh c (nm-first M2 m)]
                 (if (or (zero? c) (zero? (nm-next M4 c)))
                   M4
                   (let [v (nm-next M4 c)
                         nx (nm-next M4 v)
                         M5 (ck-r6b-todoc M4 v)
                         w (ck-r M5)]
                     (recur (ck-link (ck-link M5 c w) w nx) w nx))))]
        (-> M3 (nm-set-nf m NF-KIND ND-LIST) (nm-set-nf m NF-FIRST dh))))))

(defn- ck-r6b-ds [M :vector-i64 S :string n :i64] :vector-i64
  (let [code (ck-r6b-ds-code M n)]
    (case code
      1 (nm-set-nf (nm-set-nf M n NF-KIND ND-VEC) n NF-FIRST (nm-next M (nm-first M n)))
      6 (ck-r6b-keyed M n)
      7 (ck-r6b-str M n)
      8 (ck-r6b-match M n)
      9 (ck-r6b-exinfo M S n)
      10 (ck-r6b-recassoc M n)
      11 (ck-r6b-cmp M n (nm-head-of M (nm-first M n)))
      12 (ck-r6b-cap M n)
      (ck-r6b-fold M S n code))))
;; BEGIN R6B srclib (generated by seed/tests/r6b/srclib/gen-srclib.py)
;; edit seed/tests/r6b/srclib/r6b-lib.kotoba (or the KIR doclib), then run the generator
(def ck-r6b-g-kw 1)
(def ck-r6b-g-doc 2)
(def ck-r6b-g-sfb 4)
(def ck-r6b-g-min 8)
(def ck-r6b-g-max 16)
(def ck-r6b-g-exi 32)
(def ck-r6b-g-rem 64)
(def ck-r6b-g-utf8 128)
(def ck-r6b-g-parse 256)
(def ck-r6b-g-sym 512)
(def ck-r6b-g-vec 1024)
(def ck-r6b-g-f64 2048)
(def ck-r6b-h-str -9048150456382168848)
(def ck-r6b-h-match-option 1201494287191572048)
(def ck-r6b-h-none 4327140908117611899)
(def ck-r6b-h-some 6932689201082914001)
(def ck-r6b-h-ex-info 2203569563317006795)
(def ck-r6b-h-__r6-i2s -2945411176932352310)
(def ck-r6b-h-__r6-b2s 8727414380487575083)
(def ck-r6b-h-__r6-kwtext -8845673549209021897)
(def ck-r6b-h-document-i64 -5110041547470111716)
(def ck-r6b-h-document-string 690999184106806014)
(def ck-r6b-h-document-keyword 7060134862450744438)
(def ck-r6b-h-document-bool -1257836948771266241)
(def ck-r6b-h-vector-i64 -1220338344787219618)
(def ck-r6b-h-document-vector 1239673953068744840)
(def ck-r6b-h-document-list -62595317315667325)
(def ck-r6b-h-document-set 7059577448296561193)
(def ck-r6b-h-document-map -2591559586180773685)
(def ck-r6b-h-document-get 1088424468606068501)
(def ck-r6b-h-document-contains 7283803499010354882)
(def ck-r6b-h-document-assoc -3223699498627898274)
(def ck-r6b-h-document-dissoc -4750057269407097116)
(def ck-r6b-h-record-assoc -715500776194032970)
(def ck-r6b-h-__r6-dnth -7168050004506419644)
(def ck-r6b-h-document-count -51795290030251958)
(def ck-r6b-h-__r6-dkeys 8898643555360701642)
;; the group bit of the call-head spelling with hash h (exact names; the document- prefix is tested apart)
(defn- ck-r6b-name-bit [h :i64] :i64
  (cond (= h -1399000368820294352) ck-r6b-g-kw   ; keyword-name
        (= h -5903302927127843025) ck-r6b-g-kw   ; keyword-from-string
        (= h -9048150456382168848) ck-r6b-g-kw   ; str
        (= h 2203569563317006795) ck-r6b-g-exi   ; ex-info
        (= h -741585363824271330) ck-r6b-g-exi   ; ex-message
        (= h -2158987832811628953) ck-r6b-g-exi   ; ex-data
        (= h 6197231196749472553) ck-r6b-g-sfb   ; string-find-byte
        (= h 573156827627667575) ck-r6b-g-min   ; min
        (= h 580772045163143161) ck-r6b-g-max   ; max
        (= h 645364649377164233) ck-r6b-g-doc   ; nil?
        (= h 3988478846623731818) ck-r6b-g-doc   ; some?
        (= h 2252384353609096874) ck-r6b-g-doc   ; map?
        (= h -105946348095602752) ck-r6b-g-doc   ; boolean?
        (= h 9091101342244405390) ck-r6b-g-doc   ; integer?
        (= h -9157093811056680187) ck-r6b-g-doc   ; string?
        (= h 2965165368296370529) ck-r6b-g-doc   ; keyword?
        (= h 3382084118839404583) ck-r6b-g-doc   ; vector?
        (= h -3693705228454459110) ck-r6b-g-doc   ; list?
        (= h 3260232402901290521) ck-r6b-g-doc   ; seq?
        (= h 3257417653133638036) ck-r6b-g-doc   ; set?
        (= h 8642969046350357768) ck-r6b-g-doc   ; coll?
        (= h -8514075438229807807) ck-r6b-g-doc   ; first
        (= h -6586085717218287427) ck-r6b-g-doc   ; second
        (= h 5527727774794834391) ck-r6b-g-doc   ; rest
        (= h -8509051109125074585) ck-r6b-g-rem   ; rem
        (= h -5363147738531601902) ck-r6b-g-utf8   ; string-to-utf8
        (= h 2613634576959465006) ck-r6b-g-parse   ; string-parse-i64
        (= h -8424421939860975699) ck-r6b-g-parse   ; parse-long
        (= h -1721781785132272367) ck-r6b-g-sym   ; symbol
        (= h 6494910307221814324) ck-r6b-g-vec   ; vector-drop
        (= h 1733912242534962942) ck-r6b-g-vec   ; vector-take
        (= h 1682895495272856533) ck-r6b-g-vec   ; subvec
        (= h -745687937792843357) ck-r6b-g-vec   ; into
        (= h 1600856041486620590) ck-r6b-g-f64   ; f64-to-bits
        (= h 7987950950382066285) ck-r6b-g-f64   ; f64-from-bits
        :else 0))
;; the capability catalogue (resources/kotoba/lang/capability-catalog.edn): the wire id of the friendly qualified
;; name (:source-operation) with FNV-1a hash h, 0 for none
(defn ck-r6b-capwire [h :i64] :i64
  (cond (= h 1523489726228185725) 1   ; identity/sign
        (= h -4981883870761471375) 2   ; identity/verify
        (= h 1506410741630539861) 3   ; hash/sha256
        (= h 1456777209906806896) 4   ; http/post
        (= h 4878944748840525602) 5   ; log/read
        (= h -970694661870998130) 6   ; log/append
        (= h 8199700614416819094) 7   ; clock/now
        (= h -6440997922957550731) 8   ; state/transact
        (= h -8963386966565948919) 9   ; ui/commit
