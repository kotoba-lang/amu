(ns seed.check
  (:require [seed.mem :refer [mem-alloc]])
  (:require [seed.lex :refer [lx-cpw lx-eol lx-symch? lx-ws?]])
  (:require [seed.names :refer [nm-bind nm-bound-since nm-count nm-count-syms nm-eqi nm-err-node nm-err-span nm-failed nm-ff nm-first nm-form-head nm-gensym nm-hash nm-head-of nm-kind nm-local-slot nm-local-type nm-lookup nm-ne nm-next nm-nf nm-nth nm-pack nm-put nm-scope-height nm-scope-hide nm-scope-saved nm-scope-show nm-set-ff nm-set-nf nm-set-sf nm-sf nm-span-eq nm-sym-of nm-tf nm-unbind]]))

