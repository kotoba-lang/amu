;; Fixed-source ARM64 private-root worker candidate (JUN-779).
;; No OCI input, archive operations, exec or workload launch is admitted.
;; Private root operations are bounded, with X closing the worker and tmpfs.
;; This text is appended as privileged runtime only by a source-pinned factory.

(defn- fw-die [stage :i64] :i64
  (let [b (+ (kxrt-g) 24000) a (kxrt-w b 0 0x3a45535546455246 8)
        n (+ a (kxrt-dec (+ b a) stage)) z (kxrt-store8 (+ b n) 10)
        w (kxrt-write-all 2 b (+ n 1))]
    (kxrt-exit 2)))

;; Constant C strings in private memory; no caller-controlled host paths.
(defn- fw-strings [] :i64
  (let [b (+ (kxrt-g) 24576)
        e (kxrt-w b 96 0x2f 2) f (kxrt-w b 112 0x706d742f 5) g (kxrt-w b 128 0x7366706d74 6)
        h (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b 144 0x3931343d657a6973 8) 0x5f726e2c34303334 8) 0x343d7365646f6e69 8) 0x363930 4)
        j (kxrt-w b (kxrt-w b 192 0x6f6f722f706d742f 8) 0x736674 4)
        k (kxrt-w b 224 0x0a796e6564 5)] b))

(defn- fw-write-path [path :i64 data :i64 n :i64 stage :i64] :i64
  (let [fd (kxrt-open-path path 524289 0)]
    (if (< fd 0) (fw-die stage)
      (let [w (kxrt-write-all fd data n) c (kxrt-close fd)]
        (if (or (not= w 1) (not= c 0)) (fw-die stage) 0)))))

(defn- fw-map [path :i64 id :i64 stage :i64] :i64
  (let [b (+ (kxrt-g) 25088) a (kxrt-w b 0 0x2030 2)
        n (+ a (kxrt-dec (+ b a) id)) sep (kxrt-w b n 0x0a3120 3)]
    (fw-write-path path b sep stage)))

(defn- fw-proc-path [pid :i64 which :i64] :i64
  (let [b (+ (kxrt-g) 25344) a (kxrt-w b 0 0x2f636f72702f 6)
        n (+ a (kxrt-dec (+ b a) pid))
        e (case which
            0 (kxrt-w b (kxrt-w b n 0x70616d5f6469752f 8) 0 1)
            1 (kxrt-w b (kxrt-w b n 0x70616d5f6469672f 8) 0 1)
            (kxrt-w b (kxrt-w b n 0x756f72677465732f 8) 0x7370 3))] b))

(defn- fw-close [fd :i64 stage :i64] :i64
  (if (< (kxrt-close fd) 0) (fw-die stage) 0))
(defn- fw-read-one [fd :i64 address :i64] :i64
  (loop [attempt 0]
    (let [r (kxrt-syscall 63 fd address 1 0 0 0)]
      (if (= r -4) (recur (+ attempt 1)) r))))

;; Exact bounded protocol I/O. Unexpected EOF or syscall failure kills the
;; worker and its private mount: no partially written tree is published.
(defn- fw-read-exact [fd :i64 address :i64 count :i64 stage :i64] :i64
  (loop [done 0]
    (if (= done count) 0
      (let [r (kxrt-syscall 63 fd (+ address done) (- count done) 0 0 0)]
        (cond (= r -4) (recur done) (<= r 0) (fw-die stage) :else (recur (+ done r)))))))
(defn- fw-path-ok? [path :i64 n :i64] :bool
  (if (or (<= n 0) (> n 255)) false
    (loop [i 0 start 0]
      (if (or (= i n) (= (kxrt-load8 (+ path i)) 47))
        (let [len (- i start)]
          (cond (= len 0) false
                (and (= len 1) (= (kxrt-load8 (+ path start)) 46)) false
                (and (= len 2) (= (kxrt-load8 (+ path start)) 46) (= (kxrt-load8 (+ path start 1)) 46)) false
                (and (>= len 4) (= (kxrt-load8 (+ path start)) 46)
                     (= (kxrt-load8 (+ path start 1)) 119) (= (kxrt-load8 (+ path start 2)) 104)
                     (= (kxrt-load8 (+ path start 3)) 46)) false
                (= i n) true :else (recur (+ i 1) (+ i 1))))
        (let [c (kxrt-load8 (+ path i))]
          (if (or (< c 32) (> c 126)) false (recur (+ i 1) start)))))))

;; openat2: RESOLVE_BENEATH | RESOLVE_NO_SYMLINKS | RESOLVE_NO_MAGICLINKS.
;; No fallback to openat on kernels that do not implement the confinement.
(defn- fw-openat2 [dir :i64 path :i64 flags :i64 mode :i64 how :i64] :i64
  (let [a (kxrt-store64 how flags) b (kxrt-store64 (+ how 8) mode)
        c (kxrt-store64 (+ how 16) 14)]
    (kxrt-syscall 437 dir path how 24 0 0)))
(defn- fw-last-slash [path :i64 n :i64] :i64
  (loop [i 0 last -1]
    (if (= i n) last
      (recur (+ i 1) (if (= (kxrt-load8 (+ path i)) 47) i last)))))
;; Optional transport: H as the first byte selects lowercase ASCII hex for
;; every subsequent protocol byte. This lets a string-only producer stream
;; arbitrary binary without changing the binary protocol or buffering a layer.
(defn- fw-nibble [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 97) (<= c 102)) (+ 10 (- c 97))
        :else (fw-die 16)))
(defn- fw-read-wire [mode :i64 address :i64 count :i64 scratch :i64] :i64
  (if (= mode 0) (fw-read-exact 0 address count 16)
    (let [got (fw-read-exact 0 scratch (* count 2) 16)]
      (loop [i 0]
        (if (= i count) 0
          (let [hi (fw-nibble (kxrt-load8 (+ scratch (* i 2))))
                lo (fw-nibble (kxrt-load8 (+ scratch (+ (* i 2) 1))))
                w (kxrt-store8 (+ address i) (+ (* 16 hi) lo))]
            (recur (+ i 1))))))))

(defn- fw-file-data [fd :i64 buf :i64 size :i64 write? :bool mode :i64 scratch :i64] :i64
  (loop [left size]
    (if (= left 0) 0
      (let [n (if (> left 4096) 4096 left)
            source (if write? 0 fd) target (if write? fd 1)
            got (if write? (fw-read-wire mode buf n scratch) (fw-read-exact source buf n 18))
            sent (if (= (kxrt-write-all target buf n) 1) 0 (fw-die 18))]
        (recur (- left n))))))

;; Protocol: X closes; M/F/U/R/P/V then two-byte big-endian path length,
;; four-byte big-endian payload length and ASCII path. M creates a directory;
;; F creates a new file; U replaces an existing file; R reads the requested
;; exact number of bytes. F/U are followed by that many bytes. Each successful
;; command writes K; R follows K with data. C and a two-byte big-endian count
;; freeze mutations only if the count matches, then write D. One R and X remain
;; available for diagnostics after C. P uses the payload-length field as a
;; mode (0..0777), applies it to an existing file/directory, and starts a
;; finalization phase in which only further P, C, or X are accepted. V reads
;; the two-byte mode of one path after C. Initial modes are 0700/0600.
;; Malformed requests and I/O errors terminate the whole worker, not just a
;; command. The controller must discard the tree on all errors.
(defn- fw-commands [root :i64 mem :i64] :i64
  (let [head mem path (+ mem 1024) how (+ mem 2048) buf (+ mem 4096)]
    (loop [operations 0 mode 0 committed false reads 0 finalizing false finals 0]
      (let [got (if (= mode 0) (fw-read-one 0 head) (let [z (fw-read-wire mode head 1 (+ mem 8192))] 1))
            op (if (= got 1) (kxrt-load8 head) -1)]
        (cond (and (= operations 0) (= mode 0) (not committed) (= op 72)) (recur 0 1 false 0 false 0)
              (= op 88) (kxrt-exit 0)
              (= op 67) (if committed (fw-die 15)
                (let [read (fw-read-wire mode head 2 (+ mem 8192))
                      count (+ (* 256 (kxrt-load8 head)) (kxrt-load8 (+ head 1)))
                      valid (if (not (= count operations)) (fw-die 19) 0)
                      mark (kxrt-store8 head 68)
                      sent (if (= (kxrt-write-all 1 head 1) 1) 0 (fw-die 18))]
                  (recur operations mode true 0 finalizing finals)))
              (or (< got 1) (and (>= operations 640) (not (and committed (or (= op 82) (= op 86)))))
                  (and (>= operations 512) (not committed) (not (= op 80)))
                  (and (= op 80) (>= finals 128))
                  (and committed (not (or (= op 82) (= op 86))))
                  (and committed (>= reads 1))
                  (and finalizing (not committed) (not (= op 80)))
                  (and (= op 86) (not committed))
                  (not (or (= op 77) (= op 70) (= op 85) (= op 82) (= op 80) (= op 86)))) (fw-die 15)
              :else (let [header (fw-read-wire mode head 6 (+ mem 8192))
                          n (+ (* 256 (kxrt-load8 head)) (kxrt-load8 (+ head 1)))
                          size (+ (* 16777216 (kxrt-load8 (+ head 2))) (* 65536 (kxrt-load8 (+ head 3)))
                                  (* 256 (kxrt-load8 (+ head 4))) (kxrt-load8 (+ head 5)))
                          checked (if (or (<= n 0) (> n 255) (> size 1048576) (and (= op 77) (not (= size 0)))
                                          (and (= op 80) (> size 511)) (and (= op 86) (not (= size 0)))) (fw-die 16) 0)
                          received (fw-read-wire mode path n (+ mem 8192)) term (kxrt-store8 (+ path n) 0)
                          valid (if (fw-path-ok? path n) 0 (fw-die 16))
                          slash (fw-last-slash path n)
                          cut (if (>= slash 0) (kxrt-store8 (+ path slash) 0) 0)
                          parent (if (>= slash 0) (fw-openat2 root path 2670592 0 how) root)
                          parent-ok (if (< parent 0) (fw-die 17) 0)
                          leaf (if (>= slash 0) (+ path (+ slash 1)) path)
                          status (if (= op 77)
                                   (if (< (kxrt-syscall 34 parent leaf 448 0 0 0) 0) (fw-die 17) 0)
                                   (let [flags (cond (= op 70) 557249 (= op 85) 557057 :else 557056)
                                         fd (fw-openat2 parent leaf flags (if (= op 70) 384 0) how)
                                         opened (if (< fd 0) (fw-die 17) 0)
                                         trunc (if (and (= op 85) (< (kxrt-syscall 46 fd 0 0 0 0 0) 0)) (fw-die 17) 0)
                                         chmod (if (and (= op 80) (< (kxrt-syscall 52 fd size 0 0 0 0) 0)) (fw-die 17) 0)
                                         stat (if (= op 86) (if (< (kxrt-syscall 80 fd buf 0 0 0 0) 0) (fw-die 17) 0) 0)
                                         ack (if (= op 82) (let [k (kxrt-store8 head 75)] (if (= (kxrt-write-all 1 head 1) 1) 0 (fw-die 18))) 0)
                                         transfer (if (or (= op 80) (= op 86)) 0 (fw-file-data fd buf size (not (= op 82)) mode (+ mem 8192)))
                                         stat-reply (if (= op 86) (let [bits (bit-and (kxrt-load64 (+ buf 16)) 511)
                                                                       a (kxrt-store8 head 75) b (kxrt-store8 (+ head 1) (u64-shift-right bits 8))
                                                                       c (kxrt-store8 (+ head 2) (bit-and bits 255))]
                                                                   (if (= (kxrt-write-all 1 head 3) 1) 0 (fw-die 18))) 0)
                                         close (fw-close fd 18)] 0))
                          parent-close (if (>= slash 0) (fw-close parent 18) 0)
                          reply (if (or (= op 82) (= op 86)) 0 (let [k (kxrt-store8 head 75)] (if (= (kxrt-write-all 1 head 1) 1) 0 (fw-die 18))))]
                      (recur (if committed operations (+ operations 1)) mode committed (if committed (+ reads 1) reads)
                             (or finalizing (= op 80)) (if (= op 80) (+ finals 1) finals))))))))

;; The child has no host directory descriptors, never executes an image and
;; dies if its parent disappears. It cannot proceed until the original-UID
;; parent has installed both maps.
(defn- fw-child [parent :i64 ready-r :i64 ready-w :i64 ack-r :i64 ack-w :i64 b :i64] :i64
  (let [death (if (< (kxrt-syscall 167 1 9 0 0 0 0) 0) (fw-die 4) 0)
        alive (if (not= (kxrt-syscall 173 0 0 0 0 0 0) parent) (fw-die 4) 0)
        c1 (fw-close ready-r 4) c2 (fw-close ack-w 4)
        user (if (< (kxrt-syscall 97 268435456 0 0 0 0 0) 0) (fw-die 4) 0)
        buf (+ b 320) marker (kxrt-store8 buf 85)
        sent (if (not= (kxrt-write-all ready-w buf 1) 1) (fw-die 4) 0)
        c3 (fw-close ready-w 4) got (fw-read-one ack-r buf) c4 (fw-close ack-r 4)
        mapped (if (or (not= got 1) (not= (kxrt-load8 buf) 77)) (fw-die 8) 0)
        nodump2 (if (< (kxrt-syscall 167 4 0 0 0 0 0) 0) (fw-die 8) 0)
        ns (if (< (kxrt-syscall 97 1073872896 0 0 0 0 0) 0) (fw-die 9) 0)
        private (if (< (kxrt-syscall 40 0 (+ b 96) 0 278528 0 0) 0) (fw-die 10) 0)
        mount (if (< (kxrt-syscall 40 (+ b 128) (+ b 112) (+ b 128) 6 (+ b 144) 0) 0) (fw-die 11) 0)
        dir (if (< (kxrt-syscall 34 -100 (+ b 192) 448 0 0 0) 0) (fw-die 12) 0)
        nnp (if (< (kxrt-syscall 167 38 1 0 0 0 0) 0) (fw-die 13) 0)
        out (+ b 256)
        a (kxrt-w out (kxrt-w out (kxrt-w out 0 0x6972702d656e7566 8) 0x6f6f722d65746176 8) 0x0a79646165722d74 8)
        announced (if (not= (kxrt-write-all 1 out a) 1) (fw-die 14) 0)
        root (kxrt-open-path (+ b 192) 2670592 0)
        root-ok (if (< root 0) (fw-die 14) 0)
        mem (kxrt-syscall 222 0 16384 3 34 -1 0)
        mem-ok (if (< mem 0) (fw-die 14) 0)]
    (fw-commands root mem)))

(defn- fw-parent [pid :i64 ready-r :i64 ready-w :i64 ack-r :i64 ack-w :i64 uid :i64 gid :i64 b :i64] :i64
  (let [c1 (fw-close ready-w 5) c2 (fw-close ack-r 5) buf (+ b 320)
        got (fw-read-one ready-r buf) c3 (fw-close ready-r 5)
        ready (if (or (not= got 1) (not= (kxrt-load8 buf) 85)) (fw-die 5) 0)
        umap (fw-map (fw-proc-path pid 0) uid 5)
        groups (fw-write-path (fw-proc-path pid 2) (+ b 224) 5 6)
        gmap (fw-map (fw-proc-path pid 1) gid 7)
        marker (kxrt-store8 buf 77) sent (if (not= (kxrt-write-all ack-w buf 1) 1) (fw-die 8) 0)
        c4 (fw-close ack-w 8) st (+ b 352)
        waited (loop [attempt 0] (let [r (kxrt-syscall 260 pid st 0 0 0 0)] (if (= r -4) (recur (+ attempt 1)) r)))
        status (kxrt-load64 st)]
    (if (or (not= waited pid) (not= (bit-and status 127) 0)) (kxrt-exit 2)
      (kxrt-exit (bit-and (u64-shift-right status 8) 255)))))

(defn- kxrt-start [sp :i64] :i64
  (let [argc (kxrt-load64 sp) b (fw-strings)
        uid (kxrt-syscall 175 0 0 0 0 0 0) gid (kxrt-syscall 177 0 0 0 0 0 0)
        valid (if (or (not= argc 1) (<= uid 0) (< gid 0)
                      (not= uid (kxrt-syscall 174 0 0 0 0 0 0))
                      (not= gid (kxrt-syscall 176 0 0 0 0 0 0))) (fw-die 1) 0)
        dumpable (if (< (kxrt-syscall 167 4 1 0 0 0 0) 0) (fw-die 2) 0)
        close-extra (if (< (kxrt-syscall 436 3 4294967295 0 0 0 0) 0) (fw-die 3) 0)
        pipes (+ b 384) a (kxrt-syscall 59 pipes 524288 0 0 0 0)
        z (kxrt-syscall 59 (+ pipes 8) 524288 0 0 0 0)
        pipes-ok (if (or (< a 0) (< z 0)) (fw-die 3) 0)
        pair1 (kxrt-load64 pipes) pair2 (kxrt-load64 (+ pipes 8))
        ready-r (bit-and pair1 4294967295) ready-w (u64-shift-right pair1 32)
        ack-r (bit-and pair2 4294967295) ack-w (u64-shift-right pair2 32)
        parent (kxrt-syscall 172 0 0 0 0 0 0) child (kxrt-syscall 220 17 0 0 0 0 0)]
    (cond (< child 0) (fw-die 3) (= child 0) (fw-child parent ready-r ready-w ack-r ack-w b)
          :else (fw-parent child ready-r ready-w ack-r ack-w uid gid b))))
