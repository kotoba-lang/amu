        ready (if (or (not= got 1) (not= (kxrt-load8 buf) 85)) (fw-die 5) 0)
        umap (fw-map (fw-proc-path pid 0) uid 5)
        groups (fw-write-path (fw-proc-path pid 2) (+ b 224) 5 6)
        gmap (fw-map (fw-proc-path pid 1) gid 7)
        marker (kxrt-store8 buf 77) sent (if (not= (kxrt-write-all ack-w buf 1) 1) (fw-die 8) 0)
        c4 (fw-close ack-w 8) st (+ b 352)
        waited (loop [attempt 0] (let [r (kxrt-syscall 260 pid st 0 0 0 0)] (if (= r -4) (recur (+ attempt 1)) r)))
        status (kxrt-load64 st)]
    (if (or (not= waited pid) (not= (bit-and status 127) 0)) (kxrt-exit 2)
      (kxrt-exit (bit-and (u64-shift-right status 8) 255)))))

(defn- kxrt-start [sp :i64] :i64
