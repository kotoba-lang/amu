        close-extra (if (< (kxrt-syscall 436 3 4294967295 0 0 0 0) 0) (fw-die 3) 0)
        pipes (+ b 384) a (kxrt-syscall 59 pipes 524288 0 0 0 0)
        z (kxrt-syscall 59 (+ pipes 8) 524288 0 0 0 0)
        pipes-ok (if (or (< a 0) (< z 0)) (fw-die 3) 0)
