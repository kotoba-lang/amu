        a (if (< (kxrt-syscall 24 sup 111 524288 0 0 0) 0) (kxrt-exit 127) 0)
        b (if (< (kxrt-syscall 24 worker 112 0 0 0 0) 0) (kxrt-exit 127) 0)
        c (if (< (kxrt-syscall 24 producer 113 0 0 0 0) 0) (kxrt-exit 127) 0)
        d (if (< (kxrt-syscall 24 cg 114 0 0 0 0) 0) (kxrt-exit 127) 0)
        e (if (< (kxrt-syscall 24 output 1 0 0 0 0) 0) (kxrt-exit 127) 0)
        input-pair (+ m 6160) made (if (< (kxrt-syscall 59 input-pair 524288 0 0 0 0) 0) (kxrt-exit 127) 0)
        input-both (kxrt-load64 input-pair) input-r (bit-and input-both 4294967295)
