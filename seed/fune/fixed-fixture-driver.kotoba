        input-ok (if (or (not= input-shut 0) (< input 0)) (kxrt-exit 127) 0)
        lo (if (< (kxrt-syscall 436 3 110 0 0 0 0) 0) (kxrt-exit 127) 0)
        hi (if (< (kxrt-syscall 436 115 4294967295 0 0 0 0) 0) (kxrt-exit 127) 0)
        nnp (if (< (kxrt-syscall 167 38 1 0 0 0 0) 0) (kxrt-exit 127) 0)
        empty (+ m 200) z (kxrt-store64 empty 0) e0 (kxrt-store64 (+ m 128) 0)
        result (kxrt-syscall 281 111 empty m (+ m 128) 4096 0)] (kxrt-exit 127)))
