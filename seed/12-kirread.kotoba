(defn- kr-doc-text0 [] :string
  (string-concat "(defn __kr_dw [c :i64] :i64 (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))\n"
  (string-concat "(defn __kr_dcloser [c :i64] :bool (or (= c 93) (or (= c 41) (= c 125))))\n"
  (string-concat "(defn __kr_dtrap [] :i64 (vector-at [0] 1))\n"
  (string-concat "(defn __kr_dtraps [] :string (string-substring \"x\" 0 (__kr_dtrap)))\n"
  (string-concat "(defn __kr_dempty [] :string (string-substring \"x\" 0 0))\n"
  (string-concat "(defn __kr_dtokend [s :string i :i64] :i64 (if (>= i (string-length s)) i (let [c (string-code-point-at s i)] (cond (= c 32) i (__kr_dcloser c) i :else (__kr_dtokend s (+ i (__kr_dw c)))))))\n"
  (string-concat "(defn __kr_dstrend [s :string i :i64] :i64 (let [c (string-code-point-at s i)] (cond (= c 34) (+ i 1) (= c 92) (__kr_dstrend s (+ i 2)) :else (__kr_dstrend s (+ i (__kr_dw c))))))\n"
  "(defn __kr_dseqend [s :string i :i64] :i64 (let [c (string-code-point-at s i)] (cond (= c 32) (__kr_dseqend s (+ i 1)) (__kr_dcloser c) (+ i 1) :else (__kr_dseqend s (__kr_dend s i)))))\n"))))))))
(defn- kr-doc-text1 [] :string
  (string-concat "(defn __kr_dend [s :string i :i64] :i64 (let [c (string-code-point-at s i)] (cond (= c 34) (__kr_dstrend s (+ i 1)) (= c 91) (__kr_dseqend s (+ i 1)) (= c 40) (__kr_dseqend s (+ i 1)) (= c 123) (__kr_dseqend s (+ i 1)) (= c 35) (__kr_dseqend s (+ i 2)) :else (__kr_dtokend s i))))\n"
  (string-concat "(defn __kr_dopen [d :string] :i64 (if (= (string-code-point-at d 0) 35) 2 1))\n"
  (string-concat "(defn __kr_ditem [d :string i :i64 k :i64] :i64 (let [c (string-code-point-at d i)] (cond (= c 32) (__kr_ditem d (+ i 1) k) (__kr_dcloser c) -1 (= k 0) i :else (__kr_ditem d (__kr_dend d i) (- k 1)))))\n"
  (string-concat "(defn __kr_dclose [d :string] :i64 (- (string-length d) 1))\n"
  (string-concat "(defn __kr_dcountfrom [d :string i :i64 n :i64] :i64 (let [c (string-code-point-at d i)] (cond (= c 32) (__kr_dcountfrom d (+ i 1) n) (__kr_dcloser c) n :else (__kr_dcountfrom d (__kr_dend d i) (+ n 1)))))\n"
  (string-concat "(defn __kr_dforms [d :string] :i64 (__kr_dcountfrom d (__kr_dopen d) 0))\n"
  (string-concat "(defn __kr_dregeq [s :string i :i64 j :i64 t :string k :i64] :bool (cond (= i j) (= k (string-length t)) (>= k (string-length t)) (= 0 1) :else (let [c (string-code-point-at s i)] (if (= c (string-code-point-at t k)) (__kr_dregeq s (+ i (__kr_dw c)) j t (+ k (__kr_dw c))) (= 0 1)))))\n"
  "(defn __kr_ddigit [c :i64] :bool (and (>= c 48) (< c 58)))\n"))))))))
(defn- kr-doc-text2 [] :string
  (string-concat "(defn __kr_dat [t :string i :i64 e :i64] :i64 (if (>= i e) -1 (string-code-point-at t i)))\n"
  (string-concat "(defn __kr_ddigend [t :string i :i64 e :i64] :i64 (cond (>= i e) i (__kr_ddigit (string-code-point-at t i)) (__kr_ddigend t (+ i 1) e) :else i))\n"
  (string-concat "(defn __kr_dexpend [t :string i :i64 e :i64] :i64 (let [c (__kr_dat t i e)] (if (or (= c 101) (= c 69)) (let [s (__kr_dat t (+ i 1) e) j (if (or (= s 43) (= s 45)) (+ i 2) (+ i 1)) k (__kr_ddigend t j e)] (if (> k j) k -1)) i)))\n"
  (string-concat "(defn __kr_dnumkind [t :string i :i64 e :i64] :i64 (let [c0 (__kr_dat t i e) i0 (if (or (= c0 43) (= c0 45)) (+ i 1) i) d1 (__kr_ddigend t i0 e)] (if (= d1 e) (if (> d1 i0) 2 0) (let [c (string-code-point-at t d1)] (cond (= c 46) (let [d2 (__kr_ddigend t (+ d1 1) e)] (if (and (= d1 i0) (= d2 (+ d1 1))) 0 (if (= (__kr_dexpend t d2 e) e) 3 0))) (or (= c 101) (= c 69)) (if (= d1 i0) 0 (let [x (__kr_dexpend t d1 e)] (if (< x 0) 0 (if (= (__kr_dexpend t x e) e) 3 0)))) :else 0)))))\n"
  (string-concat "(defn __kr_dkindat [d :string i :i64 e :i64] :i64 (let [c (string-code-point-at d i)] (cond (= c 34) 4 (= c 58) 5 (= c 91) 7 (= c 40) 8 (= c 35) 9 (= c 123) 10 (__kr_dregeq d i e \"nil\" 0) 0 (__kr_dregeq d i e \"true\" 0) 1 (__kr_dregeq d i e \"false\" 0) 1 :else (let [k (__kr_dnumkind d i e)] (if (= k 0) 6 k)))))\n"
  (string-concat "(defn __kr_dkindn [d :string] :i64 (__kr_dkindat d 0 (string-length d)))\n"
  (string-concat "(defn __kr_dreq [d :string lo :i64 hi :i64] :string (let [k (__kr_dkindn d)] (if (or (< k lo) (> k hi)) (__kr_dtraps) d)))\n"
  "(defn __kr_dparseneg [t :string i :i64 acc :i64] :i64 (if (>= i (string-length t)) acc (__kr_dparseneg t (+ i 1) (- (* acc 10) (- (string-code-point-at t i) 48)))))\n"))))))))
(defn- kr-doc-text3 [] :string
  (string-concat "(defn __kr_dparse [t :string] :i64 (let [c (string-code-point-at t 0)] (if (= c 45) (__kr_dparseneg t 1 0) (- 0 (__kr_dparseneg t (if (= c 43) 1 0) 0)))))\n"
  (string-concat "(defn __kr_dplain [c :i64] :bool (cond (< c 32) (= 0 1) (= c 34) (= 0 1) :else (not (= c 92))))\n"
  (string-concat "(defn __kr_dplainend [s :string i :i64] :i64 (if (>= i (string-length s)) i (let [c (string-code-point-at s i)] (if (__kr_dplain c) (__kr_dplainend s (+ i (__kr_dw c))) i))))\n"
  (string-concat "(defn __kr_dhexd [k :i64] :string (string-substring \"0123456789abcdef\" k (+ k 1)))\n"
  (string-concat "(defn __kr_descchar [acc :string c :i64] :string (cond (= c 34) (string-concat acc \"\\\\\\\"\") (= c 92) (string-concat acc \"\\\\\\\\\") (= c 8) (string-concat acc \"\\\\b\") (= c 9) (string-concat acc \"\\\\t\") (= c 10) (string-concat acc \"\\\\n\") (= c 12) (string-concat acc \"\\\\f\") (= c 13) (string-concat acc \"\\\\r\") :else (string-concat (string-concat (string-concat acc \"\\\\u00\") (__kr_dhexd (quot c 16))) (__kr_dhexd (- c (* (quot c 16) 16))))))\n"
  (string-concat "(defn __kr_descfrom [acc :string s :string i :i64] :string (let [j (__kr_dplainend s i) a2 (string-concat acc (string-substring s i j))] (if (>= j (string-length s)) (string-concat a2 \"\\\"\") (__kr_descfrom (__kr_descchar a2 (string-code-point-at s j)) s (+ j 1)))))\n"
  (string-concat "(defn __kr_desc [s :string] :string (__kr_descfrom \"\\\"\" s 0))\n"
  "(defn __kr_dhex [c :i64] :i64 (cond (< c 58) (- c 48) (< c 71) (- c 55) :else (- c 87)))\n"))))))))
(defn- kr-doc-text4 [] :string
