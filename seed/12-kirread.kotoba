;; ---------------------------------------------------------------------------------------------------------
;; lexing (10-lex's scan, maps read as vectors)
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-punct [c :i64] :i64
  (cond (= c 123) TK-LBRACK (= c 125) TK-RBRACK :else (lx-punct c)))

;; symbols may contain '$' (KIR's lifted functions: __kotoba_invoke$arity1, f$arity$2)
(defn- kr-symch? [c :i64] :bool (or (= c 36) (lx-symch? c)))

(defn- kr-word-end [S :string i :i64] :i64
  (loop [j i]
    (if (< j (string-length S)) (if (kr-symch? (lx-ch S j)) (recur (+ j 1)) j) j)))

(defn- kr-tok-end [S :string i :i64] :i64
  (let [c (lx-ch S i)]
    (cond (= c 34) (lx-str-find S i)
          (= c 58) (lx-word-end S (+ i 1))
          :else (kr-word-end S i))))

;; 1 when S[i] is the '#' of a namespaced map opener "#:ns{" (the :schemas value): the prefix is skipped
(defn- kr-ns-map [S :string i :i64] :i64
  (cond (>= (+ i 1) (string-length S)) 0
        (= (lx-ch S i) 35) (if (= (lx-ch S (+ i 1)) 58) 1 0)
        :else 0))

;; 1 when S[i] is the '#' of a set opener "#{"
(defn- kr-set-open [S :string i :i64] :i64
  (cond (>= (+ i 1) (string-length S)) 0
        (= (lx-ch S i) 35) (kr-set-open2 S i)
        :else 0))

(defn- kr-set-open2 [S :string i :i64] :i64 (if (= (lx-ch S (+ i 1)) 123) 1 0))

(defn- kr-scan [M :vector-i64 S :string i :i64 end :i64] :vector-i64
  (if (>= i end)
    (lx-id M)
    (if (= (vector-at M MM-ERR) 0)
      (let [c (lx-ch S i)
            pk (kr-punct c)]
        (cond
          (lx-ws? c) (kr-scan M S (+ i 1) end)
          (= c 59) (kr-scan M S (lx-eol S i) end)
          (= (kr-set-open S i) 1) (kr-scan M S (+ i 1) end)
          (= (kr-ns-map S i) 1) (kr-scan M S (lx-word-end S (+ i 2)) end)
          (> pk 0) (kr-scan (lx-push M pk i (+ i 1) 0) S (+ i 1) end)
          (> c 127) (lx-fail-n M E-LEX-ASCII i (lx-lead c))
          (lx-multi? c)
          (let [j (kr-tok-end S i)]
            (kr-scan (lx-token M S i j) S (lx-after S i j) end))
          :else (lx-fail M E-LEX-SYNTAX i i (+ i 1))))
      (lx-id M))))

;; A kexe/v1 input: only the value of its depth-1 key :program is lexed (then the prelude). The rest of a kexe (its
;; :code vector has one integer per code byte, 56k for xgboost) would exceed what 11-read's item recursion can hold on
;; the loader's 1 MiB stack. Byte scans that skip strings and comments and count brackets:
(defn- kr-dd [c :i64] :i64
  (cond (= c 40) 1 (= c 91) 1 (= c 123) 1 (= c 41) -1 (= c 93) -1 (= c 125) -1 :else 0))

(defn- kr-after-str [S :string i :i64 end :i64] :i64
  (let [e (lx-str-find S i)]
    (if (< e 0) end (+ e 1))))

;; 1 when S[i ..) is ":program {"
;; KIR3: compared byte by byte with an early exit (every matched byte is ASCII, so no read lands inside a UTF-8
;; sequence; a hash over S[i, i+9) read continuation bytes of a literal such as "é" and trapped)
(defn- kr-at-prog [S :string i :i64 end :i64] :i64
  (if (> (+ i 10) end) 0 (kr-at-prog2 S i 0)))

(defn- kr-at-prog2 [S :string i :i64 k :i64] :i64
  (cond (= k 10) 1
        (= (lx-ch S (+ i k)) (lx-ch ":program {" k)) (kr-at-prog2 S i (+ k 1))
        :else 0))

;; the offset of the '{' that opens the value of the depth-1 key :program in S[i, end) (d = the depth at i), -1 if none
(defn- kr-prog [S :string i :i64 end :i64 d :i64] :i64
  (if (>= i end)
    -1
    (let [c (lx-ch S i)]
      (cond (= c 34) (kr-prog S (kr-after-str S i end) end d)
            (= c 59) (kr-prog S (lx-eol S i) end d)
            (= (* (kr-eq d 1) (kr-at-prog S i end)) 1) (+ i 9)
            :else (kr-prog S (+ i (lx-cpw c)) end (+ d (kr-dd c)))))))

;; the offset after the bracket that closes the one opened at i (d = 0 before i); end when unbalanced
(defn- kr-close [S :string i :i64 end :i64 d :i64] :i64
  (if (>= i end)
    end
    (let [c (lx-ch S i)
          d2 (+ d (kr-dd c))]
      (cond (= c 34) (kr-close S (kr-after-str S i end) end d)
            (= c 59) (kr-close S (lx-eol S i) end d)
            (= d2 0) (+ i 1)
            :else (kr-close S (+ i (lx-cpw c)) end d2)))))

(defn- kr-lex3 [M :vector-i64 S :string p :i64 l0 :i64] :vector-i64
  (if (< p 0)
    (kr-scan M S 0 (string-length S))
    (kr-scan (kr-scan M S p (kr-close S p l0 0)) S l0 (string-length S))))

(defn- kr-lex2 [M :vector-i64 S :string] :vector-i64
  (let [l0 (- (string-length S) (string-length (kr-prelude)))]
    (if (= (vector-at M MM-ERR) 0)
      (lx-count (kr-lex3 M S (kr-prog S 0 l0 0) l0))
      (lx-id M))))

;; KIR3: string literals may hold UTF-8 (10-lex's R3 string decoder); a byte >= 128 outside a string or comment is E1002
;; at that byte (kr-scan), and the byte scans step over whole code points (lx-cpw), so no index lands inside a sequence
(defn- kr-lex [M :vector-i64 S :string] :vector-i64
  (kr-lex2 M S))

;; ---------------------------------------------------------------------------------------------------------
;; accessors and writers
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-na [n :i64 f :i64] :i64 (+ (+ MM-NODE-BASE (* n MM-NODE-W)) f))
(defn- kr-nf [M :vector-i64 n :i64 f :i64] :i64 (vector-at M (kr-na n f)))
(defn- kr-kind [M :vector-i64 n :i64] :i64 (kr-nf M n NF-KIND))
(defn- kr-first [M :vector-i64 n :i64] :i64 (kr-nf M n NF-FIRST))
(defn- kr-next [M :vector-i64 n :i64] :i64 (kr-nf M n NF-NEXT))
(defn- kr-tf [M :vector-i64 t :i64 f :i64] :i64 (vector-at M (+ (+ MM-TOK-BASE (* t MM-TOK-W)) f)))
(defn- kr-eq [a :i64 b :i64] :i64 (if (= a b) 1 0))
(defn- kr-ne [a :i64 b :i64] :i64 (if (= a b) 0 1))

(defn- kr-count [M :vector-i64 n :i64] :i64
  (loop [c (kr-first M n) i 0]
    (if (= c 0) i (recur (kr-next M c) (+ i 1)))))

(defn- kr-id [M :vector-i64] :vector-i64 (vector-assoc! M MM-VERSION MM-LAYOUT-VERSION))
(defn- kr-put [M :vector-i64 i :i64 v :i64] :vector-i64 (vector-assoc! M i v))
(defn- kr-nset [M :vector-i64 n :i64 f :i64 v :i64] :vector-i64 (vector-assoc! M (kr-na n f) v))

;; a fresh node (fields not listed are 0: the region is zero and never reused)
(defn- kr-node [M :vector-i64 n :i64 kind :i64 tok :i64 aux :i64] :vector-i64
  (let [M1 (kr-nset M n NF-KIND kind)
        M2 (kr-nset M1 n NF-TOK tok)]
    (kr-nset M2 n NF-AUX aux)))

;; E101 with region 4 (the NODE table, as 11-read), unless an error is already recorded
(defn- kr-full [M :vector-i64] :vector-i64
  (let [e (vector-at M MM-ERR)
        n (vector-at M MM-ERR-N)
        M1 (vector-assoc! M MM-ERR (mem-sel e e E-HEAP-REGION))]
    (vector-assoc! M1 MM-ERR-N (mem-sel e n 4))))

;; reserve k nodes: MM-R0 = the first; E101 when the NODE table is full
(defn- kr-alloc [M :vector-i64 k :i64] :vector-i64
  (let [n (vector-at M MM-NODE-N)]
    (if (> (+ n k) MM-NODE-CAP)
      (kr-full M)
      (kr-put (kr-put M MM-NODE-N (+ n k)) MM-R0 n))))

;; token field address (pure)
(defn- kr-ta [t :i64 f :i64] :i64 (+ (+ MM-TOK-BASE (* t MM-TOK-W)) f))

;; error naming node n (first error wins). Stage-0 linearity: reads first (inline vector-at), the writes in kr-fail2.
(defn- kr-fail2 [M :vector-i64 code :i64 a :i64 b :i64] :vector-i64
  (if (= (vector-at M MM-ERR) 0)
    (let [M1 (vector-assoc! M MM-ERR code)
          M2 (vector-assoc! M1 MM-ERR-POS a)
          M3 (vector-assoc! M2 MM-ERR-A a)]
      (vector-assoc! M3 MM-ERR-B b))
    (vector-assoc! M MM-VERSION MM-LAYOUT-VERSION)))

(defn- kr-fail [M :vector-i64 code :i64 n :i64] :vector-i64
  (let [t (vector-at M (kr-na n NF-TOK))
        a (vector-at M (kr-ta t TF-START))
        b (vector-at M (kr-ta t TF-END))]
    (kr-fail2 M code a b)))

(defn- kr-failed [M :vector-i64] :bool (> (vector-at M MM-ERR) 0))

;; ---------------------------------------------------------------------------------------------------------
;; spellings the reader recognises: length + FNV-1a 64 of the span (mem-hash-str), as the driver matches its commands
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-len-ok [len :i64 want :i64 code :i64] :i64 (if (= len want) code 0))

;; 1 :format 2 :entry 3 :exports 4 :signature 5 :effects 6 :functions 7 :name 8 :params 9 :result 10 :body
;; 11 :param-types 12 :kotoba.kir/v3 13 :kotoba.kir/v4 14 nil 15 true 16 false 17 vector-new 18 string-byte-length
;; 21 let 22 if 23 :i64 24 :bool 25 :closure-param-indexes 26 :schemas 27 :cap/call 28 bool-not 29 record-assoc
;; 30 min 31 max 32 - 33 :closure-result? 34 :i64-pair-chain-param-indexes
;; (KIR3) 35 typed-cap-call 36 :bytes 37 vector-get 38 option-some 39 option-none 40 option-some? 41 option-value
;; 42 result-ok 43 result-err 44 result-ok? 45 result-value 46 result-error 47 :state 48 string-find-byte
;; 49 string-contains? 50 string-replace-all 51 string-append-range 52 string-index-of-from 53 vector-take 54 vector-drop
;; (KIR4) 55 :document 56 document-null 57 -bool 58 -i64 59 -string 60 -keyword 61 -symbol 62 -vector 63 -list 64 -set
;; 65 -map 66 -count 67 -kind 68 -equal? 69 -set-contains? 70 -contains 71 -get 72 -vector-at 73 -list-at 74 -map-entry-at
;; 75 -vector-assoc 76 -vector-conj 77 -vector-drop 78 -vector-remove 79 -vector-sort 80 -assoc 81 -dissoc 82 -merge
;; 83 -string-value 84 -bool-value 85 -i64-value 86 -edn-print 87 -edn-read
;; 0 = none of them
(defn- kr-code-of [len :i64 h :i64] :i64
  (cond
    (= h 8937795140641149370) (kr-len-ok len 7 1)
    (= h 6581774632722671467) (kr-len-ok len 6 2)
    (= h 4829298807106586200) (kr-len-ok len 8 3)
    (= h -3234123433174056955) (kr-len-ok len 10 4)
    (= h -6564845071784922083) (kr-len-ok len 8 5)
    (= h -7087538495882574170) (kr-len-ok len 10 6)
    (= h 4231012625856181486) (kr-len-ok len 5 7)
    (= h 8317371729358097035) (kr-len-ok len 7 8)
    (= h 4952616781120422236) (kr-len-ok len 7 9)
    (= h -8261240031619729027) (kr-len-ok len 5 10)
    (= h 1499523671201250954) (kr-len-ok len 12 11)
    (= h 2033750836531590243) (kr-len-ok len 14 12)
    (= h 2033756334089731298) (kr-len-ok len 14 13)
    (= h 2397808468787316396) (kr-len-ok len 3 14)
    (= h 6583304908937478053) (kr-len-ok len 4 15)
    (= h -5333701488999351944) (kr-len-ok len 5 16)
    (= h -1824377047816844663) (kr-len-ok len 10 17)
    (= h 1821388415448265404) (kr-len-ok len 18 18)
    (= h 1329270083436697466) (kr-len-ok len 3 21)
    (= h 628023482707099174) (kr-len-ok len 2 22)
    (= h 6132771630187324942) (kr-len-ok len 4 23)
    (= h -8254470338526158475) (kr-len-ok len 5 24)
    (= h 3375075517377131251) (kr-len-ok len 22 25)
    (= h -2175140937884670441) (kr-len-ok len 8 26)
    (= h -442448048712245260) (kr-len-ok len 9 27)
    (= h 5186466727107661537) (kr-len-ok len 8 28)
    (= h -715500776194032970) (kr-len-ok len 12 29)
    (= h 573156827627667575) (kr-len-ok len 3 30)
    (= h 580772045163143161) (kr-len-ok len 3 31)
    (= h -5808622843851602280) (kr-len-ok len 1 32)
    (= h -7417602207336064879) (kr-len-ok len 16 33)
    (= h 3598762502014493520) (kr-len-ok len 29 34)
    (= h 767857354240711905) (kr-len-ok len 14 35)
    (= h 7043192940227741804) (kr-len-ok len 6 36)
    (= h 2600161097033915871) (kr-len-ok len 10 37)
    (= h -3416085865405386921) (kr-len-ok len 11 38)
    (= h 5474833896677373533) (kr-len-ok len 11 39)
    (= h -5110378306262118984) (kr-len-ok len 12 40)
    (= h 8206252138909507960) (kr-len-ok len 12 41)
    (= h 1735258452003540293) (kr-len-ok len 9 42)
    (= h 7828970525143101422) (kr-len-ok len 10 43)
    (= h 1569146262666716750) (kr-len-ok len 10 44)
    (= h -7055665907701587864) (kr-len-ok len 12 45)
    (= h 5083591168744969843) (kr-len-ok len 12 46)
    (= h -2229425219510920946) (kr-len-ok len 6 47)
    (= h 6197231196749472553) (kr-len-ok len 16 48)
    (= h -9023377547950050021) (kr-len-ok len 16 49)
    (= h 3450483058270114871) (kr-len-ok len 18 50)
    (= h 1424572846352244779) (kr-len-ok len 19 51)
    (= h -8276023412022496092) (kr-len-ok len 20 52)
    (= h 1733912242534962942) (kr-len-ok len 11 53)
    (= h 6494910307221814324) (kr-len-ok len 11 54)
(= h 6703248742119087212) (kr-len-ok len 9 55)
    (= h 6863010667240088542) (kr-len-ok len 13 56)
    (= h -1257836948771266241) (kr-len-ok len 13 57)
    (= h -5110041547470111716) (kr-len-ok len 12 58)
    (= h 690999184106806014) (kr-len-ok len 15 59)
    (= h 7060134862450744438) (kr-len-ok len 16 60)
    (= h 1273108263396186731) (kr-len-ok len 15 61)
    (= h 1239673953068744840) (kr-len-ok len 15 62)
    (= h -62595317315667325) (kr-len-ok len 13 63)
    (= h 7059577448296561193) (kr-len-ok len 12 64)
    (= h -2591559586180773685) (kr-len-ok len 12 65)
    (= h -51795290030251958) (kr-len-ok len 14 66)
    (= h 3444507891035672977) (kr-len-ok len 13 67)
    (= h 6647918705560869338) (kr-len-ok len 15 68)
    (= h -765725758102441586) (kr-len-ok len 22 69)
    (= h 7283803499010354882) (kr-len-ok len 17 70)
    (= h 1088424468606068501) (kr-len-ok len 12 71)
    (= h -7680494379634912982) (kr-len-ok len 18 72)
    (= h -4792256507391924481) (kr-len-ok len 16 73)
    (= h 8251995101810124952) (kr-len-ok len 21 74)
    (= h 5293854995853420882) (kr-len-ok len 21 75)
    (= h 4745849884231880725) (kr-len-ok len 20 76)
    (= h 3243209985101569382) (kr-len-ok len 20 77)
    (= h 6310451889180635779) (kr-len-ok len 22 78)
    (= h 7979946221503940439) (kr-len-ok len 20 79)
    (= h -3223699498627898274) (kr-len-ok len 14 80)
    (= h -4750057269407097116) (kr-len-ok len 15 81)
    (= h -5104306553766125975) (kr-len-ok len 14 82)
    (= h -206829689859411018) (kr-len-ok len 21 83)
    (= h -8858344768677536841) (kr-len-ok len 19 84)
    (= h -2920278823987639616) (kr-len-ok len 18 85)
    (= h 638424652226050050) (kr-len-ok len 18 86)
    (= h -4763474619102018985) (kr-len-ok len 17 87)
    :else 0))

(defn- kr-is-name [k :i64] :i64 (cond (= k ND-SYM) 1 (= k ND-KW) 1 :else 0))

(defn- kr-code2 [S :string k :i64 a :i64 b :i64] :i64
  (if (= (kr-is-name k) 1) (kr-code-of (- b a) (mem-hash-str S a b)) 0))

;; the spelling code of node n (0 for a non-name node)
(defn- kr-code [M :vector-i64 S :string n :i64] :i64
  (let [k (kr-kind M n)
        t (kr-nf M n NF-TOK)
        a (kr-tf M t TF-START)
        b (kr-tf M t TF-END)]
    (kr-code2 S k a b)))

;; 1 when node n is a symbol spelled __kotoba_loop_<something> (KIR's loop helpers)
(defn- kr-helper2 [S :string a :i64 b :i64] :i64
  (if (> (- b a) 14) (kr-eq (mem-hash-str S a (+ a 14)) -5146085560221492899) 0))

(defn- kr-helper [M :vector-i64 S :string n :i64] :i64
  (let [k (kr-kind M n)
        t (kr-nf M n NF-TOK)
        a (kr-tf M t TF-START)
        b (kr-tf M t TF-END)]
    (if (= k ND-SYM) (kr-helper2 S a b) 0)))

;; 1 when node n is a symbol spelled __kotoba_<something> (any name KIR generates: loop helpers, lambdas, invokers)
(defn- kr-helper-any2 [S :string a :i64 b :i64] :i64
  (if (> (- b a) 9) (kr-eq (mem-hash-str S a (+ a 9)) -5027202412368522414) 0))

(defn- kr-helper-any [M :vector-i64 S :string n :i64] :i64
  (let [k (kr-kind M n)
        t (kr-nf M n NF-TOK)
        a (kr-tf M t TF-START)
        b (kr-tf M t TF-END)]
    (if (= k ND-SYM) (kr-helper-any2 S a b) 0)))

;; 1 when nodes x and y have the same spelling
(defn- kr-same2 [S :string ax :i64 bx :i64 ay :i64 by :i64] :i64
  (if (= (- bx ax) (- by ay)) (mem-span-eq S ax ay (- bx ax)) 0))

(defn- kr-same [M :vector-i64 S :string x :i64 y :i64] :i64
  (let [tx (kr-nf M x NF-TOK)
        ty (kr-nf M y NF-TOK)
        ax (kr-tf M tx TF-START)
        bx (kr-tf M tx TF-END)
        ay (kr-tf M ty TF-START)
        by (kr-tf M ty TF-END)]
    (kr-same2 S ax bx ay by)))

;; ---------------------------------------------------------------------------------------------------------
;; the program map: its fields
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-v34 [c :i64] :i64 (cond (= c 12) 1 (= c 13) 1 :else 0))

(defn- kr-format [M :vector-i64 vc :i64 k :i64] :vector-i64
  (if (= (kr-v34 vc) 1) (kr-put M kr-c-tab 1) (kr-fail M kr-e-value k)))

(defn- kr-nil [M :vector-i64 vc :i64 k :i64] :vector-i64
  (if (= vc 14) (kr-id M) (kr-fail M kr-e-value k)))

;; an empty vector (the empty set #{} or map {} of :effects)
(defn- kr-empty [M :vector-i64 vk :i64 vn :i64 k :i64] :vector-i64
  (if (= (* (kr-eq vk ND-VEC) (kr-eq vn 0)) 1) (kr-id M) (kr-fail M kr-e-value k)))

;; :effects: a set of capability effects [:cap/call N] (the seed lowers typed-cap-call itself and the loader enforces
;; the grants; the effect set is an admission matter that stage-0 already settled) and (KIR3) the marker :state: stage-0's
;; KIR has already lowered perform/handle of a defhandler [:state T] to state passing (__kotoba_state_* functions and
;; :kotoba.state/ret1 records), so nothing of the effect is left in the bodies; any other effect is E1203
(defn- kr-cap-eff [M :vector-i64 S :string e :i64] :i64
  (cond (= (kr-kind M e) ND-VEC) (kr-eq (kr-code M S (kr-first M e)) 27)
        (= (kr-kind M e) ND-KW) (kr-eq (kr-code M S e) 47)
        :else 0))

(defn- kr-caps-ok [M :vector-i64 S :string e :i64] :i64
  (cond (= e 0) 1
        (= (kr-cap-eff M S e) 0) 0
        :else (kr-caps-ok M S (kr-next M e))))

(defn- kr-effects [M :vector-i64 S :string v :i64 k :i64] :vector-i64
  (if (= (* (kr-eq (kr-kind M v) ND-VEC) (kr-caps-ok M S (kr-first M v))) 1) (kr-id M) (kr-fail M kr-e-value k)))

;; :entry is nil or a symbol (stage-0 writes `main` when the program has one), :signature nil or a map (the entry's
;; signature): both are informational, the exports are what the seed compiles
(defn- kr-nil-or [M :vector-i64 vc :i64 vk :i64 want :i64 k :i64] :vector-i64
  (if (= (+ (kr-eq vc 14) (kr-eq vk want)) 0) (kr-fail M kr-e-value k) (kr-id M)))

(defn- kr-vec-cell [M :vector-i64 vk :i64 k :i64 v :i64 cell :i64] :vector-i64
  (if (= vk ND-VEC) (kr-put M cell v) (kr-fail M kr-e-value k)))

(defn- kr-top1 [M :vector-i64 S :string k :i64 v :i64] :vector-i64
  (let [c (kr-code M S k)
        vc (kr-code M S v)
        vk (kr-kind M v)
        vn (kr-count M v)]
    (cond
      (= v 0) (kr-fail M kr-e-value k)
      (= c 1) (kr-format M vc k)
      (= c 2) (kr-nil-or M vc vk ND-SYM k)
      (= c 4) (kr-nil-or M vc vk ND-VEC k)
      (= c 5) (kr-effects M S v k)
      (= c 26) (kr-id M)
      (= c 3) (kr-vec-cell M vk k v kr-c-exp)
      (= c 6) (kr-vec-cell M vk k v kr-c-fns)
      :else (kr-fail M kr-e-field k))))

(defn- kr-tops [M :vector-i64 S :string k :i64] :vector-i64
  (cond
    (= k 0) (kr-id M)
    (kr-failed M) (kr-id M)
    :else
    (let [v (kr-next M k)
          nk (kr-next M v)]
      (kr-tops (kr-top1 M S k v) S nk))))

;; ---------------------------------------------------------------------------------------------------------
;; the function table
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-field [M :vector-i64 S :string r :i64 k :i64 v :i64] :vector-i64
  (let [c (kr-code M S k)
        vk (kr-kind M v)
        vn (kr-count M v)]
    (cond
      (= v 0) (kr-fail M kr-e-value k)
      (= c 7) (kr-put M (+ r kr-f-name) v)
      (= c 8) (kr-put M (+ r kr-f-params) v)
      (= c 9) (kr-put M (+ r kr-f-result) v)
      (= c 10) (kr-put M (+ r kr-f-body) v)
      (= c 11) (kr-put M (+ r kr-f-ptypes) v)
      (= c 5) (kr-effects M S v k)
      (= c 25) (kr-id M)
      (= c 33) (kr-id M)
      (= c 34) (kr-id M)
      :else (kr-fail M kr-e-field k))))

(defn- kr-fields [M :vector-i64 S :string r :i64 k :i64] :vector-i64
  (cond
    (= k 0) (kr-id M)
    (kr-failed M) (kr-id M)
    :else
    (let [v (kr-next M k)
          nk (kr-next M v)]
      (kr-fields (kr-field M S r k v) S r nk))))

;; 1 when the :param-types vector (0 = absent) has as many items as the :params vector
(defn- kr-pt-ok [M :vector-i64 ps :i64 pt :i64] :i64
  (cond (= pt 0) 1
        (= (kr-kind M pt) ND-VEC) (kr-eq (kr-count M pt) (kr-count M ps))
        :else 0))

(defn- kr-fn-check [M :vector-i64 r :i64 f :i64] :vector-i64
  (let [nm (vector-at M (+ r kr-f-name))
        ps (vector-at M (+ r kr-f-params))
        rs (vector-at M (+ r kr-f-result))
        bd (vector-at M (+ r kr-f-body))
        pt (vector-at M (+ r kr-f-ptypes))
        ok (* (* (kr-eq (kr-kind M nm) ND-SYM) (kr-eq (kr-kind M ps) ND-VEC))
              (* (+ (kr-eq (kr-kind M rs) ND-KW) (kr-eq (kr-kind M rs) ND-VEC)) (kr-ne bd 0)))
        pok (kr-pt-ok M ps pt)]
    (cond (kr-failed M) (kr-id M)
          (= (* ok pok) 1) (kr-id M)
          :else (kr-fail M kr-e-value f))))

(defn- kr-fn [M :vector-i64 S :string r :i64 f :i64] :vector-i64
  (let [k (kr-kind M f)
        k1 (kr-first M f)]
    (if (= k ND-VEC)
      (kr-fn-check (kr-fields (kr-put M (+ r kr-f-map) f) S r k1) r f)
      (kr-fail M kr-e-doc f))))

(defn- kr-fns [M :vector-i64 S :string r :i64 f :i64] :vector-i64
  (cond
    (= f 0) (kr-id M)
    (kr-failed M) (kr-id M)
    :else
    (let [nx (kr-next M f)]
      (kr-fns (kr-fn M S r f) S (+ r kr-w) nx))))

(defn- kr-tab2 [M :vector-i64 S :string n :i64] :vector-i64
  (let [tab (vector-at M MM-R0)
        fv (vector-at M kr-c-fns)
        f1 (kr-first M fv)]
    (if (kr-failed M)
      (kr-id M)
      (kr-fns (kr-put (kr-put (kr-put (kr-put (kr-put (kr-put M kr-c-tab tab) tab n) (+ tab 1) (+ (+ tab kr-th) (* n kr-w))) (+ tab 2) 1)
                                  (+ tab 3) 0)
                          (+ tab 4) (kr-lib-first M))
              S (+ tab kr-th) f1))))

;; KIR3: the first library defn: the (kr-np + 1)-th sibling of the KIR document under the read root (before kr-emit)
(defn- kr-lib-first [M :vector-i64] :i64
  (loop [c (kr-first M (vector-at M MM-ROOT)) k (+ kr-np 1)]
    (if (= k 0) c (recur (kr-next M c) (- k 1)))))

(defn- kr-tab [M :vector-i64 S :string] :vector-i64
  (let [fv (vector-at M kr-c-fns)
        n (kr-count M fv)
        nl (vector-at M MM-LIT-N)]
    (kr-tab2 (mem-alloc M (+ (+ (* n kr-w) kr-th) (* 4 (+ nl kr-kwcap)))) S n)))

;; the record address of the function whose :name is spelled like node h, 0 when none
(defn- kr-find2 [M :vector-i64 S :string r :i64 end :i64 h :i64] :i64
  (let [nm (vector-at M (+ r kr-f-name))]
    (cond (>= r end) 0
          (= (kr-same M S nm h) 1) r
          :else (kr-find2 M S (+ r kr-w) end h))))

(defn- kr-find [M :vector-i64 S :string h :i64] :i64
  (let [tab (vector-at M kr-c-tab)
        n (vector-at M tab)]
    (kr-find2 M S (+ tab kr-th) (+ (+ tab kr-th) (* n kr-w)) h)))

;; ---------------------------------------------------------------------------------------------------------
;; rewriting expressions (in place). cur = the record address of the loop helper whose body is being walked, 0 outside
;; ---------------------------------------------------------------------------------------------------------
;; where the next child goes: the FIRST of vector pv when last = 0, else the NEXT of last
(defn- kr-link-addr [last :i64 pv :i64] :i64
  (if (= last 0) (kr-na pv NF-FIRST) (kr-na last NF-NEXT)))

;; under node pv, interleave chain a with chain b: a1 b1 a2 b2 ... (both chains have the same length, checked before)
(defn- kr-inter [M :vector-i64 a :i64 b :i64 last :i64 pv :i64] :vector-i64
  (if (= a 0)
    (kr-id M)
    (let [an (kr-next M a)
          bn (kr-next M b)
          M1 (kr-put M (kr-link-addr last pv) a)
          M2 (kr-nset M1 a NF-NEXT b)
          M3 (kr-nset M2 b NF-NEXT 0)]
      (kr-inter M3 an bn b pv))))

;; under node pv, each node of chain a followed by a fresh :i64 keyword node (f, f+1, ...)
(defn- kr-inter-i64 [M :vector-i64 a :i64 f :i64 last :i64 pv :i64] :vector-i64
  (if (= a 0)
    (kr-id M)
    (let [an (kr-next M a)
          pb (vector-at M kr-c-pb)
          M1 (kr-node M f ND-KW (+ pb 10) 0)
          M2 (kr-put M1 (kr-link-addr last pv) a)
          M3 (kr-nset M2 a NF-NEXT f)]
      (kr-inter-i64 M3 an (+ f 1) f pv))))

;; true -> (= 0 0), false -> (= 0 1): node n becomes a list of 3 fresh nodes (its token and NEXT are kept)
(defn- kr-bool2 [M :vector-i64 n :i64 v :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [a (vector-at M MM-R0)
          pb (vector-at M kr-c-pb)
          M1 (kr-node M a ND-SYM (+ pb 6) 0)
          M2 (kr-node M1 (+ a 1) ND-INT (+ pb 7) 0)
          M3 (kr-node M2 (+ a 2) ND-INT (+ (+ pb 7) v) v)
          M4 (kr-nset M3 a NF-NEXT (+ a 1))
          M5 (kr-nset M4 (+ a 1) NF-NEXT (+ a 2))
          M6 (kr-nset M5 n NF-KIND ND-LIST)
          M7 (kr-nset M6 n NF-FIRST a)]
      (kr-nset M7 n NF-AUX 3))))

(defn- kr-bool [M :vector-i64 n :i64 v :i64] :vector-i64
  (kr-bool2 (kr-alloc M 3) n v))

;; (vector-new e ..) -> [e ..]: the list n becomes a vector of the head's siblings
(defn- kr-vecnew [M :vector-i64 n :i64 h :i64] :vector-i64
  (let [a (kr-next M h)
        c (kr-nf M n NF-AUX)
        M1 (kr-nset M n NF-KIND ND-VEC)
        M2 (kr-nset M1 n NF-FIRST a)]
    (kr-nset M2 n NF-AUX (- c 1))))

;; respell symbol node h as prelude token k
(defn- kr-retok [M :vector-i64 h :i64 k :i64] :vector-i64
  (let [pb (vector-at M kr-c-pb)]
    (kr-nset M h NF-TOK (+ pb k))))

(defn- kr-walk-items [M :vector-i64 S :string c :i64 cur :i64] :vector-i64
  (cond
    (= c 0) (kr-id M)
    (kr-failed M) (kr-id M)
    :else
    (let [nx (kr-next M c)]
      (kr-walk-items (kr-walk M S c cur) S nx cur))))

(defn- kr-walk [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (let [k (kr-kind M n)
        c (kr-code M S n)
        f (kr-first M n)]
    (cond
      (= k ND-LIST) (kr-walk-list M S n cur)
      (= k ND-VEC) (kr-walk-items M S f cur)
      (= k ND-STR) (kr-str M n)
      (= c 15) (kr-bool M n 0)
      (= c 16) (kr-bool M n 1)
      (= c 55) (kr-retok M n 38)
      :else (kr-id M))))

(defn- kr-walk-list [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (let [h (kr-first M n)
        hc (kr-code M S h)
        hl (kr-helper M S h)
        a (kr-next M h)]
    (cond
      (= hc 17) (kr-walk-items (kr-vecnew M n h) S a cur)
      (= hc 18) (kr-walk-items (kr-retok M h 9) S a cur)
      (= hc 21) (kr-let M S n cur)
      (= hc 22) (kr-if M S n cur)
      (= hc 28) (kr-walk-items (kr-retok M h 13) S a cur)
      (= hc 29) (kr-rassoc M S n cur)
      (= hc 32) (kr-neg-or M S n cur)
      (= hc 30) (kr-minmax-or M S n cur 17)
      (= hc 31) (kr-minmax-or M S n cur 18)
      (= hc 35) (kr-walk-items (kr-cap M S n) S h cur)
      (= hc 37) (kr-walk-items (kr-retok M h 26) S a cur)
      (= hc 60) (kr-dkw M S n cur)
      (and (>= hc 62) (<= hc 65)) (kr-dfold M S n cur hc)
      (= (kr-dkeyed hc) 1) (kr-dkey (kr-walk-items (kr-lib-use M h (kr-lib-of hc)) S a cur) S (kr-next M a))
      (>= (kr-lib-of hc) 0) (kr-walk-items (kr-lib-use M h (kr-lib-of hc)) S a cur)
      (= (kr-untyped-tok hc) 0) (if (= hl 1) (kr-call M S n cur) (kr-walk-items M S h cur))
      :else (kr-untyped (kr-alloc M (kr-untyped-n hc)) S n cur hc))))

;; ---------------------------------------------------------------------------------------------------------
;; KIR3 (agent KIR3, 2026-10-03): spellings stage-0's KIR uses for R3 heads
;;   (typed-cap-call 35 :string :string x)  -> (typed-cap-call :fs/app-data :string :string x)   KIR writes the wire id;
;;      37 :io/write, 38 :cli/args, 39 :io/write-error, 35 with :bytes kinds :fs/app-data-bytes (seed/HEADS :cap-shapes);
;;      any other wire stays an integer and 21-check refuses it by name (E2115)
;;   (vector-get v i d)                     -> (nth v i d)        (the reference's total vector read = R3 nth with default)
;;   (option-some x) (option-none) (option-some? o) (option-value o d)
;;                                          -> (option-some-of [:option :i64] x) ..   the untyped KIR spellings are the i64
;;   (result-ok x) (result-err e) (result-ok? r) (result-value r d) (result-error r d)
;;                                          -> (result-ok-of [:result :i64 :i64] x) ..   forms; a non-i64 operand is refused
;;                                             by 21-check (E2104), never guessed
;; ---------------------------------------------------------------------------------------------------------
;; the prelude token of the -of spelling of untyped code hc, 0 when hc is not one
(defn- kr-untyped-tok [hc :i64] :i64
  (cond (= hc 38) 29 (= hc 39) 30 (= hc 40) 31 (= hc 41) 32 (= hc 42) 33 (= hc 43) 34 (= hc 44) 35 (= hc 45) 36
        (= hc 46) 37 :else 0))

;; nodes of the inserted type: [:option :i64] 3, [:result :i64 :i64] 4
(defn- kr-untyped-n [hc :i64] :i64 (if (< hc 42) 3 4))

;; the second :i64 of [:result :i64 :i64] (k = 4)
(defn- kr-untyped3 [M :vector-i64 q :i64 pb :i64 k :i64] :vector-i64
  (if (= k 4) (kr-nset (kr-node M (+ q 3) ND-KW (+ pb 10) 0) (+ q 2) NF-NEXT (+ q 3)) (kr-id M)))

(defn- kr-untyped [M :vector-i64 S :string n :i64 cur :i64 hc :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [q (vector-at M MM-R0)
          pb (vector-at M kr-c-pb)
          h (kr-first M n)
          a (kr-next M h)
          c (kr-nf M n NF-AUX)
          k (kr-untyped-n hc)
          M1 (kr-nset (kr-node M q ND-VEC (+ pb (+ 24 k)) (- k 1)) q NF-NEXT a)
          M2 (kr-nset (kr-nset M1 q NF-FIRST (+ q 1)) h NF-NEXT q)
          M3 (kr-nset (kr-node M2 (+ q 1) ND-KW (+ pb (+ 24 k)) 0) (+ q 1) NF-NEXT (+ q 2))
          M4 (kr-node M3 (+ q 2) ND-KW (+ pb 10) 0)
          M6 (kr-nset (kr-retok (kr-untyped3 M4 q pb k) h (kr-untyped-tok hc)) n NF-AUX (+ c 1))]
      (kr-walk-items M6 S a cur))))

;; the prelude token of KIR wire w for a request kind spelled with code qc, 0 when the seed has no such cap shape
(defn- kr-wire-tok [w :i64 qc :i64] :i64
  (cond (= w 35) (if (= qc 36) 25 21) (= w 37) 22 (= w 38) 23 (= w 39) 24 :else 0))

(defn- kr-cap2 [M :vector-i64 w :i64 t :i64] :vector-i64
  (if (= t 0)
    (kr-id M)
    (let [pb (vector-at M kr-c-pb)]
      (kr-node M w ND-KW (+ pb t) 0))))

(defn- kr-cap [M :vector-i64 S :string n :i64] :vector-i64
  (let [h (kr-first M n)
        w (kr-next M h)
        q (kr-next M w)
        ok (* (kr-ne w 0) (kr-ne q 0))]
    (cond (= ok 0) (kr-id M)
          (= (kr-kind M w) ND-INT) (kr-cap2 M w (kr-wire-tok (kr-nf M w NF-AUX) (kr-code M S q)))
          :else (kr-id M))))



;; ---------------------------------------------------------------------------------------------------------
;; builtins that KIR spells differently from the seed (no new SIR: each is a form the seed already compiles)
;;   (bool-not b)                  -> (not b)
;;   (record-assoc SCHEMA r :f v)  -> (assoc r :f v)
;;   (- x)                         -> (- 0 x)                       (KIR's unary minus; Seed-0 has only the binary one)
;;   (min a b) / (max a b)         -> (let [__kr_a a __kr_b b] (if (< __kr_a __kr_b) __kr_a __kr_b))   (> for max)
;;                                    only when the program defines no function of that name and the call has 2 args
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-rassoc [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (let [h (kr-first M n)
        sc (kr-next M h)
        r (kr-next M sc)
        c (kr-nf M n NF-AUX)
        M1 (kr-retok M h 14)
        M2 (kr-nset M1 h NF-NEXT r)
        M3 (kr-nset M2 n NF-AUX (- c 1))]
    (kr-walk-items M3 S r cur)))

(defn- kr-neg [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [z (vector-at M MM-R0)
          pb (vector-at M kr-c-pb)
          h (kr-first M n)
          a (kr-next M h)
          M1 (kr-node M z ND-INT (+ pb 7) 0)
          M2 (kr-nset M1 h NF-NEXT z)
          M3 (kr-nset M2 z NF-NEXT a)
          M4 (kr-nset M3 n NF-AUX 3)]
      (kr-walk-items M4 S a cur))))

;; 1 when list n has 3 items and its head names no function of the program
(defn- kr-builtin [M :vector-i64 S :string n :i64] :i64
  (if (= (kr-count M n) 3) (kr-eq (kr-find M S (kr-first M n)) 0) 0))

(defn- kr-sym-node [M :vector-i64 n :i64 tok :i64 nx :i64] :vector-i64
  (kr-nset (kr-node M n ND-SYM tok 0) n NF-NEXT nx))

;; the 11 reserved nodes q .. q+10 (see kr-minmax); op = prelude token 17 (<) or 18 (>)
(defn- kr-minmax2 [M :vector-i64 n :i64 q :i64 op :i64] :vector-i64
  (let [pb (vector-at M kr-c-pb)
        h (kr-first M n)
        x (kr-next M h)
        y (kr-next M x)
        M1 (kr-nset (kr-node M q ND-VEC (+ pb 15) 4) q NF-NEXT (+ q 3))
        M2 (kr-nset (kr-sym-node M1 (+ q 1) (+ pb 19) x) q NF-FIRST (+ q 1))
        M3 (kr-nset (kr-sym-node M2 (+ q 2) (+ pb 20) y) x NF-NEXT (+ q 2))
        M4 (kr-nset (kr-node M3 (+ q 3) ND-LIST (+ pb 16) 4) (+ q 3) NF-FIRST (+ q 4))
        M5 (kr-sym-node M4 (+ q 4) (+ pb 16) (+ q 5))
        M6 (kr-nset (kr-nset (kr-node M5 (+ q 5) ND-LIST (+ pb op) 3) (+ q 5) NF-NEXT (+ q 9)) (+ q 5) NF-FIRST (+ q 6))
        M7 (kr-sym-node M6 (+ q 6) (+ pb op) (+ q 7))
        M8 (kr-sym-node M7 (+ q 7) (+ pb 19) (+ q 8))
        M9 (kr-sym-node M8 (+ q 8) (+ pb 20) 0)
        M10 (kr-sym-node M9 (+ q 9) (+ pb 19) (+ q 10))
        M11 (kr-sym-node M10 (+ q 10) (+ pb 20) 0)
        M12 (kr-nset (kr-nset M11 y NF-NEXT 0) h NF-NEXT q)]
    (kr-nset (kr-retok M12 h 15) n NF-AUX 3)))

;; (min x y) -> (let [__kr_a x __kr_b y] (if (op __kr_a __kr_b) __kr_a __kr_b)); x and y are walked in place
(defn- kr-minmax [M :vector-i64 S :string n :i64 cur :i64 op :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [q (vector-at M MM-R0)
          h (kr-first M n)
          x (kr-next M h)
          y (kr-next M x)
          M1 (kr-minmax2 M n q op)]
      (kr-walk (kr-walk M1 S x cur) S y cur))))

(defn- kr-neg-or [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (if (= (kr-count M n) 2) (kr-neg (kr-alloc M 1) S n cur) (kr-walk-items M S (kr-first M n) cur)))

(defn- kr-minmax-or [M :vector-i64 S :string n :i64 cur :i64 op :i64] :vector-i64
  (if (= (kr-builtin M S n) 1) (kr-minmax (kr-alloc M 11) S n cur op) (kr-walk-items M S (kr-first M n) cur)))

;; ---------------------------------------------------------------------------------------------------------
;; invariant captured locals. KIR passes the locals a loop body uses as extra helper parameters, unchanged at every
;; self call. Such a parameter p_k is dropped from the loop (the body then reads the enclosing p_k, the same value) when
;; (1) the k-th argument of the outer call is the symbol p_k, (2) the k-th argument of every self call in the helper body
;; is the symbol p_k, and (3) no let in the helper body binds p_k. At least one binding is always kept. Bit k of a mask =
;; parameter k (at most 10 loop bindings in Seed-0).
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-bit [k :i64] :i64 (if (< k 0) 0 (i64-shift-left 1 k)))

;; index of the parameter in chain p (counting from k) spelled like node b, -1 when none
(defn- kr-pidx [M :vector-i64 S :string p :i64 b :i64 k :i64] :i64
  (cond (= p 0) -1
        (= (kr-same M S p b) 1) k
        :else (kr-pidx M S (kr-next M p) b (+ k 1))))

(defn- kr-diff1 [M :vector-i64 S :string p :i64 a :i64 k :i64] :i64
  (if (= (* (kr-eq (kr-kind M a) ND-SYM) (kr-same M S p a)) 1) 0 (kr-bit k)))

;; bits k where the k-th node of chain a is not the symbol spelled like the k-th node of chain p
(defn- kr-diff [M :vector-i64 S :string p :i64 a :i64 k :i64] :i64
  (if (= p 0)
    0
    (bit-or (kr-diff1 M S p a k) (kr-diff M S (kr-next M p) (kr-next M a) (+ k 1)))))

;; bits of the parameters (chain p1) that a let binding vector (first binder b) rebinds
(defn- kr-binders [M :vector-i64 S :string b :i64 p1 :i64 acc :i64] :i64
  (if (= b 0)
    acc
    (let [v (kr-next M b)]
      (kr-binders M S (kr-next M v) p1 (bit-or acc (kr-bit (kr-pidx M S p1 b 0)))))))

(defn- kr-vary-head [M :vector-i64 S :string h :i64 r :i64] :i64
  (let [nm (vector-at M (+ r kr-f-name))
        ps (vector-at M (+ r kr-f-params))
        p1 (kr-first M ps)
        hc (kr-code M S h)
        self (* (kr-eq (kr-kind M h) ND-SYM) (kr-same M S h nm))
        a (kr-next M h)
        b (kr-first M a)]
    (cond (= self 1) (kr-diff M S p1 a 0)
          (= hc 21) (kr-binders M S b p1 0)
          :else 0)))

(defn- kr-vary-items [M :vector-i64 S :string c :i64 r :i64 acc :i64] :i64
  (if (= c 0)
    acc
    (kr-vary-items M S (kr-next M c) r (bit-or acc (kr-vary M S c r)))))

;; the parameters of helper r that are NOT invariant in the (raw) expression n
(defn- kr-vary [M :vector-i64 S :string n :i64 r :i64] :i64
  (let [k (kr-kind M n)
        h (kr-first M n)]
    (cond (= k ND-LIST) (bit-or (kr-vary-head M S h r) (kr-vary-items M S h r 0))
          (= k ND-VEC) (kr-vary-items M S h r 0)
          :else 0)))

(defn- kr-keep1 [d :i64 full :i64] :i64 (if (= d full) (bit-and d -2) d))

;; the drop mask of helper r called with the argument chain a
(defn- kr-drop [M :vector-i64 S :string r :i64 a :i64] :i64
  (let [ps (vector-at M (+ r kr-f-params))
        bd (vector-at M (+ r kr-f-body))
        p1 (kr-first M ps)
        np (kr-count M ps)
        full (- (i64-shift-left 1 np) 1)
        vary (bit-or (kr-diff M S p1 a 0) (kr-vary M S bd r))]
    (kr-keep1 (bit-and full (bit-not vary)) full)))

;; drop the nodes of chain c whose bit is set in d (bit 0 = c); MM-R0 = the first kept node
(defn- kr-filter2 [M :vector-i64 c :i64 d :i64] :vector-i64
  (let [rest (vector-at M MM-R0)]
    (if (= (bit-and d 1) 1)
      (kr-put M MM-R0 rest)
      (kr-put (kr-nset M c NF-NEXT rest) MM-R0 c))))

(defn- kr-filter [M :vector-i64 c :i64 d :i64] :vector-i64
  (if (= c 0)
    (kr-put M MM-R0 0)
    (let [nx (kr-next M c)]
      (kr-filter2 (kr-filter M nx (u64-shift-right d 1)) c d))))

(defn- kr-filter-set [M :vector-i64 addr :i64] :vector-i64
  (let [f (vector-at M MM-R0)]
    (kr-put M addr f)))

;; filter chain c by d and store its new first node at M[addr]
(defn- kr-filter-into [M :vector-i64 addr :i64 c :i64 d :i64] :vector-i64
  (kr-filter-set (kr-filter M c d) addr))

;; ---------------------------------------------------------------------------------------------------------
;; string literals (see the header): new records in the table's literal area, copied over LIT at the end
;; ---------------------------------------------------------------------------------------------------------
;; the new literal index (from j) whose bytes equal LITB[b .. b+len), 0 when none
(defn- kr-lit-find [M :vector-i64 tab :i64 j :i64 b :i64 len :i64] :i64
  (let [base (vector-at M (+ tab 1))
        u (vector-at M (+ tab 2))
        r (+ base (* j 4))
        bj (vector-at M (+ r LF-B))
        lj (vector-at M (+ r LF-LEN))]
    (cond (>= j u) 0
          (= (* (kr-eq lj len) (mem-words-eq M (+ MM-LITB-BASE bj) (+ MM-LITB-BASE b) len)) 1) j
          :else (kr-lit-find M tab (+ j 1) b len))))

(defn- kr-str-new [M :vector-i64 n :i64 tab :i64 lit :i64] :vector-i64
  (let [base (vector-at M (+ tab 1))
        u (vector-at M (+ tab 2))
        lr (+ MM-LIT-BASE (* lit MM-LIT-W))
        b (vector-at M (+ lr LF-B))
        len (vector-at M (+ lr LF-LEN))
        tok (vector-at M (+ lr LF-TOK))
        r (+ base (* u 4))
        M1 (kr-put M (+ r LF-B) b)
        M2 (kr-put M1 (+ r LF-LEN) len)
        M3 (kr-put M2 (+ r LF-TOK) tok)
        M4 (kr-put M3 (+ tab 2) (+ u 1))]
    (kr-nset M4 n NF-AUX u)))

;; the string node n gets its new literal index
(defn- kr-str [M :vector-i64 n :i64] :vector-i64
  (let [tab (vector-at M kr-c-tab)
        lit (kr-nf M n NF-AUX)
        lr (+ MM-LIT-BASE (* lit MM-LIT-W))
        b (vector-at M (+ lr LF-B))
        len (vector-at M (+ lr LF-LEN))
        j (kr-lit-find M tab 1 b len)]
    (if (> j 0)
      (kr-nset M n NF-AUX j)
      (kr-str-new M n tab lit))))

;; copy the new literal records 1 .. u-1 over LIT and set its fill
(defn- kr-lits [M :vector-i64 tab :i64 j :i64] :vector-i64
  (let [base (vector-at M (+ tab 1))
        u (vector-at M (+ tab 2))
        r (+ base (* j 4))
        d (+ MM-LIT-BASE (* j MM-LIT-W))
        b (vector-at M (+ r LF-B))
        len (vector-at M (+ r LF-LEN))
        tok (vector-at M (+ r LF-TOK))]
    (if (>= j u)
      (kr-put M MM-LIT-N u)
      (kr-lits (kr-put (kr-put (kr-put (kr-put M (+ d LF-B) b) (+ d LF-LEN) len) (+ d LF-TOK) tok) (+ d LF-POOL) 0)
               tab (+ j 1)))))

;; ---------------------------------------------------------------------------------------------------------
;; and / or / not, as KIR expands them
;; ---------------------------------------------------------------------------------------------------------
;; 1 when node n is a symbol spelled __kotoba_and_<..>, 2 when __kotoba_or_<..>, else 0
(defn- kr-gensym2 [S :string a :i64 b :i64] :i64
  (cond (<= (- b a) 12) 0
        (= (mem-hash-str S a (+ a 12)) 2863727430345639440) 2
        (<= (- b a) 13) 0
        (= (mem-hash-str S a (+ a 13)) 717256673509837764) 1
        :else 0))

(defn- kr-gensym [M :vector-i64 S :string n :i64] :i64
  (let [k (kr-kind M n)
        t (kr-nf M n NF-TOK)
        a (kr-tf M t TF-START)
        b (kr-tf M t TF-END)]
    (if (= k ND-SYM) (kr-gensym2 S a b) 0)))

;; 1 when node c is a symbol spelled like node nm
(defn- kr-sym-is [M :vector-i64 S :string c :i64 nm :i64] :i64
  (* (kr-eq (kr-kind M c) ND-SYM) (kr-same M S c nm)))

;; the list whose head is h becomes (OP x y), OP = prelude token k (11 and, 12 or)
(defn- kr-andor [M :vector-i64 h :i64 x :i64 y :i64 k :i64] :vector-i64
  (let [M1 (kr-retok M h k)
        M2 (kr-nset M1 h NF-NEXT x)
        M3 (kr-nset M2 x NF-NEXT y)]
    (kr-nset M3 y NF-NEXT 0)))

(defn- kr-let [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (let [h (kr-first M n)
        v (kr-next M h)
        bd (kr-next M v)
        nm (kr-first M v)
        x (kr-next M nm)
        g (kr-gensym M S nm)
        it (kr-first M bd)
        c (kr-next M it)
        th (kr-next M c)
        el (kr-next M th)
        shape (* (* (kr-eq (kr-count M v) 2) (kr-eq (kr-next M bd) 0))
                 (* (* (kr-eq (kr-kind M bd) ND-LIST) (kr-eq (kr-code M S it) 22))
                    (* (kr-eq (kr-next M el) 0) (kr-sym-is M S c nm))))
        and-ok (* (* shape (kr-eq g 1)) (kr-sym-is M S el nm))
        or-ok (* (* shape (kr-eq g 2)) (kr-sym-is M S th nm))]
    (cond (= and-ok 1) (kr-walk-items (kr-nset (kr-andor M h x th 11) n NF-AUX 3) S x cur)
          (= or-ok 1) (kr-walk-items (kr-nset (kr-andor M h x el 12) n NF-AUX 3) S x cur)
          :else (kr-walk-items M S h cur))))

;; (if x false true) -> (not x)
(defn- kr-if [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (let [h (kr-first M n)
        c (kr-next M h)
        th (kr-next M c)
        el (kr-next M th)
        ok (* (* (kr-ne c 0) (kr-eq (kr-code M S th) 16)) (* (kr-eq (kr-code M S el) 15) (kr-eq (kr-next M el) 0)))]
    (if (= ok 1)
      (kr-walk-items (kr-nset (kr-nset (kr-retok M h 13) c NF-NEXT 0) n NF-AUX 2) S c cur)
      (kr-walk-items M S h cur))))

;; ---------------------------------------------------------------------------------------------------------
;; loop helper calls
;; ---------------------------------------------------------------------------------------------------------
;; a call of a loop helper: its own call -> recur (minus the dropped arguments); another helper -> the loop it stands for
(defn- kr-call [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (let [h (kr-first M n)
        a (kr-next M h)
        r (kr-find M S h)
        ps (vector-at M (+ r kr-f-params))
        used (vector-at M (+ r kr-f-used))
        d (vector-at M (+ r kr-f-drop))
        np (kr-count M ps)
        na (- (kr-count M n) 1)]
    (cond
      (= r 0) (kr-fail M kr-e-helper h)
      (= r cur) (kr-self (kr-filter-into (kr-retok M h 5) (kr-na h NF-NEXT) a d) S n cur)
      (> used 0) (kr-fail M kr-e-helper h)
      (= np na) (kr-inline (kr-put M (+ r kr-f-used) 1) S n r cur)
      :else (kr-fail M kr-e-helper h))))

(defn- kr-self [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (let [h (kr-first M n)
        a (kr-next M h)]
    (kr-walk-items M S a cur)))

;; the arguments are walked in the caller's context, the invariant parameters and their arguments are dropped, then
;; (h a1 .. an) becomes (loop [p1 a1 .. pn an] BODY)
(defn- kr-inline [M :vector-i64 S :string n :i64 r :i64 cur :i64] :vector-i64
  (let [h (kr-first M n)
        a (kr-next M h)]
    (kr-inline1 (kr-walk-items M S a cur) S n r)))

(defn- kr-inline1 [M :vector-i64 S :string n :i64 r :i64] :vector-i64
  (let [h (kr-first M n)
        a (kr-next M h)
        ps (vector-at M (+ r kr-f-params))
        p1 (kr-first M ps)
        d (kr-drop M S r a)
        M1 (kr-put M (+ r kr-f-drop) d)
        M2 (kr-filter-into M1 (kr-na ps NF-FIRST) p1 d)
        M3 (kr-filter-into M2 (kr-na h NF-NEXT) a d)]
    (kr-inline2 (kr-alloc M3 2) S n r)))

(defn- kr-inline2 [M :vector-i64 S :string n :i64 r :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [l (vector-at M MM-R0)
          pb (vector-at M kr-c-pb)
          ps (vector-at M (+ r kr-f-params))
          bd (vector-at M (+ r kr-f-body))
          pt (kr-nf M ps NF-TOK)
          p1 (kr-first M ps)
          np (kr-count M ps)
          a (kr-next M (kr-first M n))
          M1 (kr-node M l ND-SYM (+ pb 4) 0)
          M2 (kr-node M1 (+ l 1) ND-VEC pt (* 2 np))
          M3 (kr-nset M2 n NF-FIRST l)
          M4 (kr-nset M3 n NF-AUX 3)
          M5 (kr-nset M4 l NF-NEXT (+ l 1))
          M6 (kr-nset M5 (+ l 1) NF-NEXT bd)
          M7 (kr-nset M6 bd NF-NEXT 0)
          M8 (kr-inter M7 p1 a 0 (+ l 1))]
      (kr-walk M8 S bd r))))

;; ---------------------------------------------------------------------------------------------------------
;; KIR3: the KIR library (kr-lib-text): respelling a builtin call, emitting the used functions
;; ---------------------------------------------------------------------------------------------------------
;; the library function of KIR head code hc, -1 when hc is not a library builtin
(defn- kr-lib-of [hc :i64] :i64
  (cond (= hc 48) 0 (= hc 49) 1 (= hc 50) 2 (= hc 51) 4 (= hc 52) 5 (= hc 53) 6 (= hc 54) 7
        (< hc 56) -1 (> hc 87) -1 :else (kr-doc-of hc)))

;; KIR4: the doc library entry of document head code hc (56 .. 87; 60 and 62..65 are handled before, -1)
(defn- kr-doc-of [hc :i64] :i64
  (cond (= hc 56) kr-dj-dnull (= hc 57) kr-dj-dbool (= hc 58) kr-dj-di64 (= hc 59) kr-dj-desc (= hc 61) kr-dj-dsym
        (= hc 66) kr-dj-dcount (= hc 67) kr-dj-dkind (= hc 68) kr-dj-deq (= hc 69) kr-dj-dsetc (= hc 70) kr-dj-dcontains
        (= hc 71) kr-dj-dget (= hc 72) kr-dj-dvat (= hc 73) kr-dj-dlat (= hc 74) kr-dj-dentry (= hc 75) kr-dj-dvassoc
        (= hc 76) kr-dj-dconj (= hc 77) kr-dj-dvdrop (= hc 78) kr-dj-dvremove (= hc 79) kr-dj-dvsort
        (= hc 80) kr-dj-dassocop (= hc 81) kr-dj-ddissocop (= hc 82) kr-dj-dmerge (= hc 83) kr-dj-dstrval
        (= hc 84) kr-dj-dboolval (= hc 85) kr-dj-di64val (= hc 86) kr-dj-did (= hc 87) kr-dj-did :else -1))

;; the use bits of library function j (replace-all also needs replace-from)
(defn- kr-lib-bits [j :i64] :i64 (cond (= j 2) 12 (>= j kr-nlib) 256 :else (i64-shift-left 1 j)))

;; KIR4: the use bit of library defn j: its own for the KIR3 functions, bit 8 for every doc defn (one group)
(defn- kr-lib-bit [j :i64] :i64 (if (< j kr-nlib) j kr-nlib))

;; the top-level node of library defn j (the first one is word 4 of the function table; the defns are read-tree
;; siblings until kr-lib-emit relinks them at the very end)
(defn- kr-lib-node [M :vector-i64 j :i64] :i64
  (loop [c (vector-at M (+ (vector-at M kr-c-tab) 4)) k j]
    (if (= k 0) c (recur (kr-next M c) (- k 1)))))

;; respell head symbol h as the name of library function j and mark j (and what it calls) used
(defn- kr-lib-use [M :vector-i64 h :i64 j :i64] :vector-i64
  (let [tab (vector-at M kr-c-tab)
        u (vector-at M (+ tab 3))
        nm (kr-next M (kr-first M (kr-lib-node M j)))
        M1 (kr-put M (+ tab 3) (bit-or u (kr-lib-bits j)))]
    (kr-nset M1 h NF-TOK (kr-nf M1 nm NF-TOK))))

;; chain the used library defns after top-level form last (the last one ends the program). c = library defn j; its
;; original NEXT is read before any write could reach it (only a later used defn's predecessor is rewritten)
(defn- kr-lib-emit [M :vector-i64 last :i64 c :i64 j :i64] :vector-i64
  (let [tab (vector-at M kr-c-tab)
        u (vector-at M (+ tab 3))
        nx (kr-next M c)]
    (cond (>= j (+ kr-nlib kr-ndoc)) (kr-nset M last NF-NEXT 0)
          (= (bit-and (u64-shift-right u (kr-lib-bit j)) 1) 1) (kr-lib-emit (kr-strs (kr-nset M last NF-NEXT c) c) c nx (+ j 1))
          :else (kr-lib-emit M last nx (+ j 1)))))

;; ---------------------------------------------------------------------------------------------------------
;; KIR4: document-keyword literals and the variadic document constructors (see the KIR4 header above kr-ndoc)
;; ---------------------------------------------------------------------------------------------------------
;; new literal records a program may gain from (document-keyword :k) (the table reserves this many beyond LIT's fill)
(def kr-kwcap 1024)

(defn- kr-lt [a :i64 b :i64] :i64 (if (< a b) 1 0))

;; the name token of library defn j
(defn- kr-lib-tok [M :vector-i64 j :i64] :i64 (kr-nf M (kr-next M (kr-first M (kr-lib-node M j))) NF-TOK))

;; mark the doc group used
(defn- kr-dmark [M :vector-i64] :vector-i64
  (let [tab (vector-at M kr-c-tab)
        u (vector-at M (+ tab 3))]
    (kr-put M (+ tab 3) (bit-or u 256))))

(defn- kr-dkw [M :vector-i64 S :string n :i64 cur :i64] :vector-i64
  (let [h (kr-first M n)
        a (kr-next M h)
        ok (* (kr-eq (kr-count M n) 2) (kr-eq (kr-kind M a) ND-KW))]
    (if (= ok 1) (kr-dkw2 M S n a) (kr-walk-items M S h cur))))

;; the keyword's bytes S[s, e) go to LITB (E101 region 3 when full; region 2 when the new literal records are)
(defn- kr-dkw2 [M :vector-i64 S :string n :i64 a :i64] :vector-i64
  (let [t (kr-nf M a NF-TOK)
        s (kr-tf M t TF-START)
        e (kr-tf M t TF-END)
        fill (vector-at M MM-LITB-N)
        tab (vector-at M kr-c-tab)
        u (vector-at M (+ tab 2))
        lit-ok (* (kr-lt u (+ (vector-at M MM-LIT-N) kr-kwcap)) (kr-lt u MM-LIT-CAP))]
    (cond (kr-failed M) (kr-id M)
          (> (+ fill (- e s)) MM-LITB-CAP) (lx-full M 3)
          (= lit-ok 0) (lx-full M 2)
          :else (kr-dkw3 (kr-litb M S s e (+ MM-LITB-BASE fill)) n t fill (- e s)))))

(defn- kr-litb [M :vector-i64 S :string i :i64 e :i64 at :i64] :vector-i64
  (if (>= i e) (kr-id M) (kr-litb (kr-put M at (lx-ch S i)) S (+ i 1) e (+ at 1))))

;; the literal index of LITB[fill, fill+len): an equal earlier one, or a new record (LITB keeps the bytes)
(defn- kr-dkw3 [M :vector-i64 n :i64 t :i64 fill :i64 len :i64] :vector-i64
  (let [tab (vector-at M kr-c-tab)
        j (kr-lit-find M tab 1 fill len)
        base (vector-at M (+ tab 1))
        u (vector-at M (+ tab 2))
        r (+ base (* u 4))]
    (if (> j 0)
      (kr-dkw4 M n t j)
      (let [M1 (kr-put M MM-LITB-N (+ fill len))
            M2 (kr-put (kr-put (kr-put M1 (+ r LF-B) fill) (+ r LF-LEN) len) (+ r LF-TOK) t)]
        (kr-dkw4 (kr-put M2 (+ tab 2) (+ u 1)) n t u)))))

;; list node n becomes the string node of literal j
(defn- kr-dkw4 [M :vector-i64 n :i64 t :i64 j :i64] :vector-i64
  (kr-nset (kr-node M n ND-STR t j) n NF-FIRST 0))

;; a KIR keyword is its text where a document key is expected (stage-0: a native keyword IS the string ":k"): the key
;; operand of document-contains / -get / -assoc / -dissoc and the keys of document-map, when they are keyword literals,
;; become string literals in place (after the walk: kr-str must not see them). A keyword-typed variable stays, and
;; 21-check refuses it against the :string parameter (E2104).
(defn- kr-dkeyed [hc :i64] :i64 (cond (= hc 70) 1 (= hc 71) 1 (= hc 80) 1 (= hc 81) 1 :else 0))

(defn- kr-dkey [M :vector-i64 S :string k :i64] :vector-i64
  (if (= (* (kr-ne k 0) (kr-eq (kr-kind M k) ND-KW)) 1) (kr-dkw2 M S k k) (kr-id M)))

;; the keys of a map fold (gs = 2: operands 1, 3, ..), nothing for the others
(defn- kr-dkeys [M :vector-i64 S :string c :i64 gs :i64] :vector-i64
  (cond (= gs 1) (kr-id M)
        (= c 0) (kr-id M)
        :else (kr-dkeys (kr-dkey M S c) S (kr-next M (kr-next M c)) gs)))

;; library defns of the fold for head code hc (62 vector, 63 list, 64 set, 65 map)
(defn- kr-dzero [hc :i64] :i64 (cond (= hc 62) kr-dj-dvz (= hc 63) kr-dj-dlz (= hc 64) kr-dj-dsz :else kr-dj-dmz))
(defn- kr-dstep [hc :i64] :i64 (cond (= hc 64) kr-dj-dsetput (= hc 65) kr-dj-dmapputu :else kr-dj-dvadd))

;; (document-vector a1 .. ak) -> (__kr_dbounded (step (.. (step (zero) a1) ..) ak)); map items go in pairs. The operands
;; are walked first (in place), then 2 + 2m fresh nodes hold the zero call and the m step calls
(defn- kr-dfold [M :vector-i64 S :string n :i64 cur :i64 hc :i64] :vector-i64
  (let [h (kr-first M n)
        a (kr-next M h)
        na (- (kr-count M n) 1)
        gs (if (= hc 65) 2 1)
        m (quot na gs)]
    (cond (kr-failed M) (kr-id M)
          (= (* m gs) na) (kr-dfold2 (kr-alloc (kr-dkeys (kr-walk-items M S a cur) S a gs) (+ 2 (* 2 m))) n hc gs)
          :else (kr-fail M kr-e-value h))))

(defn- kr-dfold2 [M :vector-i64 n :i64 hc :i64 gs :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [q (vector-at M MM-R0)
          h (kr-first M n)
          a (kr-next M h)
          zt (kr-lib-tok M (kr-dzero hc))
          M1 (kr-nset (kr-node M q ND-LIST zt 1) q NF-FIRST (+ q 1))
          M2 (kr-sym-node M1 (+ q 1) zt 0)
          M3 (kr-dfold3 M2 a (+ q 2) (kr-lib-tok M2 (kr-dstep hc)) gs)
          last (vector-at M3 MM-R0)
          M4 (kr-nset (kr-nset M3 h NF-NEXT last) last NF-NEXT 0)
          M5 (kr-nset (kr-nset M4 n NF-AUX 2) h NF-TOK (kr-lib-tok M4 kr-dj-dbounded))]
      (kr-dmark M5))))

;; the step calls from operand c on: f = the next free node pair, the accumulator so far is node f - 2 (the zero call
;; at q, then each step's list node); MM-R0 = the last
(defn- kr-dfold3 [M :vector-i64 c :i64 f :i64 st :i64 gs :i64] :vector-i64
  (if (= c 0)
    (kr-put M MM-R0 (- f 2))
    (let [prev (- f 2)
          b (if (= gs 2) (kr-next M c) c)
          nx (kr-next M b)
          M1 (kr-nset (kr-node M f ND-LIST st (+ 2 gs)) f NF-FIRST (+ f 1))
          M2 (kr-sym-node M1 (+ f 1) st prev)
          M3 (kr-nset (kr-nset M2 prev NF-NEXT c) b NF-NEXT 0)]
      (kr-dfold3 M3 nx (+ f 2) st gs))))

;; KIR4: the string literals of an emitted library defn get their new literal index (kr-str), as the program's do; the
;; defns are not walked otherwise (they are already in the seed language)
(defn- kr-strs [M :vector-i64 n :i64] :vector-i64
  (let [k (kr-kind M n)]
    (cond (= k ND-STR) (kr-str M n)
          (= k ND-LIST) (kr-strs-items M (kr-first M n))
          (= k ND-VEC) (kr-strs-items M (kr-first M n))
          :else (kr-id M))))

(defn- kr-strs-items [M :vector-i64 c :i64] :vector-i64
  (if (= c 0) (kr-id M) (kr-strs-items (kr-strs M c) (kr-next M c))))

;; ---------------------------------------------------------------------------------------------------------
;; emitting the Seed-0 forms
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-params [M :vector-i64 ps :i64 pt :i64 fresh :i64 pv :i64] :vector-i64
  (let [a (kr-first M ps)
        b (kr-first M pt)]
    (if (= pt 0)
      (kr-inter-i64 M a fresh 0 pv)
      (kr-inter M a b 0 pv))))

;; (defn NAME [p :T ..] :R BODY) for record r into the reserved nodes n (list), n+1 (defn), n+2 (params), n+3.. (:i64)
(defn- kr-defn2 [M :vector-i64 S :string r :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [n (vector-at M MM-R0)
          pb (vector-at M kr-c-pb)
          nm (vector-at M (+ r kr-f-name))
          ps (vector-at M (+ r kr-f-params))
          rs (vector-at M (+ r kr-f-result))
          bd (vector-at M (+ r kr-f-body))
          pt (vector-at M (+ r kr-f-ptypes))
          pk (kr-nf M ps NF-TOK)
          np (kr-count M ps)
          M1 (kr-node M n ND-LIST (+ pb 3) 5)
          M2 (kr-node M1 (+ n 1) ND-SYM (+ pb 3) 0)
          M3 (kr-node M2 (+ n 2) ND-VEC pk (* 2 np))
          M4 (kr-nset M3 n NF-FIRST (+ n 1))
          M5 (kr-nset M4 (+ n 1) NF-NEXT nm)
          M6 (kr-nset M5 nm NF-NEXT (+ n 2))
          M7 (kr-nset M6 (+ n 2) NF-NEXT rs)
          M8 (kr-nset M7 rs NF-NEXT bd)
          M9 (kr-nset M8 bd NF-NEXT 0)
          M9a (if (= pt 0) (kr-id M9) (kr-walk M9 S pt 0))
          M10 (kr-params M9a ps pt (+ n 3) (+ n 2))]
      (kr-walk (kr-walk M10 S rs 0) S bd 0))))

(defn- kr-defn [M :vector-i64 S :string r :i64] :vector-i64
  (let [ps (vector-at M (+ r kr-f-params))
        pt (vector-at M (+ r kr-f-ptypes))
        np (kr-count M ps)]
    (kr-defn2 (kr-alloc M (+ 3 (mem-sel pt 0 np))) S r)))

(defn- kr-defs2 [M :vector-i64 S :string i :i64 last :i64 n0 :i64] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (kr-defs (kr-nset M last NF-NEXT n0) S (+ i 1) n0)))

;; function i of the table (helpers skipped: they are inlined where they are called); last = the previous top-level form
(defn- kr-defs [M :vector-i64 S :string i :i64 last :i64] :vector-i64
  (let [tab (vector-at M kr-c-tab)
        n (vector-at M tab)
        r (+ (+ tab kr-th) (* i kr-w))
        nm (vector-at M (+ r kr-f-name))
        n0 (vector-at M MM-NODE-N)]
    (cond
      (>= i n) (kr-lib-emit M last (kr-lib-node M 0) 0)
      (kr-failed M) (kr-id M)
      (= (kr-helper M S nm) 1) (kr-defs M S (+ i 1) last)
      :else (kr-defs2 (kr-defn M S r) S i last n0))))

;; ---------------------------------------------------------------------------------------------------------
;; exports. KIR lists every function of a program without an (:export ..) clause, loop helpers and constructors
;; included. Kept: the names of emitted functions whose signature the seed can export (all params :i64 -- v3 has no
;; :param-types --, result :i64 or :bool); the rest are dropped (the source route's implicit-export rule, applied to
;; explicit exports too: the loader can call only those).
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-is-i64 [M :vector-i64 S :string n :i64] :i64 (kr-eq (kr-code M S n) 23))

(defn- kr-all-i64 [M :vector-i64 S :string c :i64] :i64
  (cond (= c 0) 1
        (= (kr-is-i64 M S c) 0) 0
        :else (kr-all-i64 M S (kr-next M c))))

(defn- kr-exportable2 [M :vector-i64 S :string r :i64] :i64
  (let [nm (vector-at M (+ r kr-f-name))
        rs (vector-at M (+ r kr-f-result))
        pt (vector-at M (+ r kr-f-ptypes))
        rc (kr-code M S rs)
        rok (+ (kr-eq rc 23) (kr-eq rc 24))
        pok (if (= pt 0) 1 (kr-all-i64 M S (kr-first M pt)))]
    (* (* rok pok) (- 1 (kr-helper-any M S nm)))))

(defn- kr-exportable [M :vector-i64 S :string n :i64] :i64
  (let [r (kr-find M S n)]
    (if (= r 0) 0 (kr-exportable2 M S r))))

(defn- kr-xkeep2 [M :vector-i64 c :i64 keep :i64] :vector-i64
  (let [rest (vector-at M MM-R0)]
    (if (= keep 0)
      (kr-put M MM-R0 rest)
      (kr-put (kr-nset M c NF-NEXT rest) MM-R0 c))))

;; MM-R0 = the first kept node of the export chain c
(defn- kr-xfilter [M :vector-i64 S :string c :i64] :vector-i64
  (if (= c 0)
    (kr-put M MM-R0 0)
    (let [nx (kr-next M c)
          keep (kr-exportable M S c)]
      (kr-xkeep2 (kr-xfilter M S nx) c keep))))

(defn- kr-xset [M :vector-i64 ex :i64] :vector-i64
  (let [f (vector-at M MM-R0)
        M1 (kr-nset M ex NF-FIRST f)]
    (kr-nset M1 ex NF-AUX (kr-count M1 ex))))

(defn- kr-exports [M :vector-i64 S :string ex :i64] :vector-i64
  (kr-xset (kr-xfilter M S (kr-first M ex)) ex))

;; the new root n and (ns kir (:export [..])) in the 6 reserved nodes n .. n+5, then the defns
(defn- kr-emit [M :vector-i64 S :string] :vector-i64
  (if (kr-failed M)
    (kr-id M)
    (let [n (vector-at M MM-R0)
          pb (vector-at M kr-c-pb)
          ex (vector-at M kr-c-exp)
          M1 (kr-node M n ND-ROOT 0 0)
          M2 (kr-node M1 (+ n 1) ND-LIST pb 3)
          M3 (kr-node M2 (+ n 2) ND-SYM pb 0)
          M4 (kr-node M3 (+ n 3) ND-SYM (+ pb 1) 0)
          M5 (kr-node M4 (+ n 4) ND-LIST (+ pb 2) 2)
          M6 (kr-node M5 (+ n 5) ND-KW (+ pb 2) 0)
          M7 (kr-nset M6 n NF-FIRST (+ n 1))
          M8 (kr-nset M7 (+ n 1) NF-FIRST (+ n 2))
          M9 (kr-nset M8 (+ n 2) NF-NEXT (+ n 3))
          M10 (kr-nset M9 (+ n 3) NF-NEXT (+ n 4))
          M11 (kr-nset M10 (+ n 4) NF-FIRST (+ n 5))
          M12 (kr-nset M11 (+ n 5) NF-NEXT ex)
          M13 (kr-nset M12 ex NF-NEXT 0)
          M14 (kr-put M13 MM-ROOT n)]
      (kr-emit-end (kr-defs (kr-exports M14 S ex) S 0 (+ n 1))))))

(defn- kr-emit-end [M :vector-i64] :vector-i64
  (let [tab (vector-at M kr-c-tab)]
    (if (kr-failed M) (kr-id M) (kr-lits M tab 1))))

;; ---------------------------------------------------------------------------------------------------------
;; the whole pass
;; ---------------------------------------------------------------------------------------------------------
(defn- kr-run4 [M :vector-i64 S :string] :vector-i64
  (if (kr-failed M) (kr-id M) (kr-emit (kr-alloc M 6) S)))

(defn- kr-run3 [M :vector-i64 S :string doc :i64] :vector-i64
  (let [ok (* (* (kr-ne (vector-at M kr-c-exp) 0) (kr-ne (vector-at M kr-c-fns) 0)) (kr-eq (vector-at M kr-c-tab) 1))]
    (cond (kr-failed M) (kr-id M)
          (= ok 1) (kr-run4 (kr-tab M S) S)
          :else (kr-fail M kr-e-doc doc))))

(defn- kr-run2 [M :vector-i64 S :string doc :i64] :vector-i64
  (let [d1 (kr-first M doc)]
    (kr-run3 (kr-tops M S d1) S doc)))

(defn- kr-run1 [M :vector-i64 S :string] :vector-i64
  (let [root (vector-at M MM-ROOT)
        doc (kr-first M root)
        cnt (kr-count M root)
        pb (kr-nf M (kr-next M doc) NF-TOK)
        ok (* (kr-eq (kr-kind M doc) ND-VEC) (kr-eq cnt (+ (+ kr-np 1) (+ kr-nlib kr-ndoc))))]
    (if (= ok 1)
      (kr-run2 (kr-put M kr-c-pb pb) S doc)
      (kr-fail M kr-e-doc doc))))

(defn- kr-run [M :vector-i64 S :string] :vector-i64
  (if (kr-failed M) (kr-id M) (kr-run1 M S)))
