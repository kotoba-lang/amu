;; Pure framing check for the experimental Darwin watcher. The trusted host
;; must itself launch the pinned helper, authenticate the boot and process
;; identity, obtain EOF, and bind these bytes and exit status to that launch.
;; A matched frame is not a successful workload receipt, a process-tree proof,
;; or permission to release a resource reservation.
(ns amu.darwin-watch-reply (:export [darwin-watch-ready? darwin-watch-heartbeat? darwin-watch-exit-class darwin-watch-monitor-step darwin-watch-reply-class]))

(defn- dwr-u32 [v :vector-i64 at :i64] :i64
  (+ (vector-at v at) (* 256 (vector-at v (+ at 1)))
     (* 65536 (vector-at v (+ at 2))) (* 16777216 (vector-at v (+ at 3)))))

(defn- dwr-bytes? [v :vector-i64] :bool
  (loop [i 0]
    (if (= i (vector-count v)) true
      (let [x (vector-at v i)]
        (and (>= x 0) (<= x 255) (recur (+ i 1)))))))

;; Validate one 32-byte WP01 or WP02 request independently,
;; including the high half of microseconds and the approved timeout limit.
(defn- dwr-request? [r :vector-i64] :bool
  (if (not (= (vector-count r) 32)) false
    (and (dwr-bytes? r) (= (vector-at r 0) 87) (= (vector-at r 1) 80)
         (= (vector-at r 2) 48) (or (= (vector-at r 3) 49) (= (vector-at r 3) 50))
         (> (dwr-u32 r 4) 0) (<= (dwr-u32 r 4) 2147483647)
         (or (> (dwr-u32 r 8) 0) (> (dwr-u32 r 12) 0))
         (= (dwr-u32 r 20) 0) (<= (dwr-u32 r 16) 999999)
         (> (dwr-u32 r 24) 0) (<= (dwr-u32 r 24) 2147483647)
         (> (dwr-u32 r 28) 0) (<= (dwr-u32 r 28) 900))))

;; Accept readiness only from exactly one complete frame from a live, pinned
;; watcher which the trusted host owns. This pure check authenticates nothing.
(defn darwin-watch-ready? [request :vector-i64 ready :vector-i64] :bool
  (and (dwr-request? request) (= (vector-count ready) 40) (dwr-bytes? ready)
       (= (vector-at ready 0) 87) (= (vector-at ready 1) 82)
       (= (vector-at ready 2) 48) (= (vector-at ready 3) 49)
       (= (dwr-u32 ready 4) 0)
       (loop [i 0] (if (= i 32) true
         (and (= (vector-at request i) (vector-at ready (+ i 8))) (recur (+ i 1)))))))

;; The host supplies the next sequence from its own state and must enforce a
;; deadline with an independent monotonic clock. A received frame cannot prove
;; freshness by itself, authenticate the pipe, or establish workload safety.
(defn darwin-watch-heartbeat? [request :vector-i64 frame :vector-i64 next :i64] :bool
  (and (dwr-request? request) (= (vector-at request 3) 50)
       (> next 0) (<= next 4294967295)
       (= (vector-count frame) 40) (dwr-bytes? frame)
       (= (vector-at frame 0) 87) (= (vector-at frame 1) 72)
       (= (vector-at frame 2) 48) (= (vector-at frame 3) 49) (= (dwr-u32 frame 4) next)
       (loop [i 0] (if (= i 32) true
         (and (= (vector-at request i) (vector-at frame (+ i 8))) (recur (+ i 1)))))))

;; Streaming WP02 consumers validate readiness and every heartbeat separately;
;; this final frame cannot prove those prior observations or descendant exit.
(defn darwin-watch-exit-class [request :vector-i64 frame :vector-i64 exit-code :i64 eof :bool] :string
  (if (and (dwr-request? request) (= (vector-at request 3) 50)
           (= exit-code 0) eof (= (vector-count frame) 40) (dwr-bytes? frame)
           (= (vector-at frame 0) 87) (= (vector-at frame 1) 79)
           (= (vector-at frame 2) 48) (= (vector-at frame 3) 49) (= (dwr-u32 frame 4) 0)
           (loop [i 0] (if (= i 32) true
             (and (= (vector-at request i) (vector-at frame (+ i 8))) (recur (+ i 1))))))
    "observer/bound-exit-observed" "observer/unknown"))

;; Host-owned volatile state [phase next-sequence last-monotonic-ms timeout-ms].
;; Start with [0 1 launch-time timeout], advance only after reading from the
;; authenticated helper pipe, and retain a separate durable reservation. A
;; timeout, clock rollback, pipe loss, bad frame or inconsistent status makes
;; state [3 0 0 0] (unknown). Phase 2 observes one bound exit only; it never
;; authorizes a release or proves descendant termination. Buffered frames do
;; not themselves prove freshness; the host must enforce its I/O deadline.
(defn darwin-watch-monitor-step [request :vector-i64 state :vector-i64 event :string frame :vector-i64
                                exit-code :i64 eof :bool now :i64 alive :bool] :vector-i64
  (if (not (= (vector-count state) 4)) [3 0 0 0]
    (let [phase (vector-at state 0) next (vector-at state 1)
          last (vector-at state 2) timeout (vector-at state 3)]
      (if (or (not (dwr-request? request)) (not (= (vector-at request 3) 50))
              (< phase 0) (> phase 1) (< next 1) (> next 4294967296) (and (= phase 0) (not (= next 1)))
              (<= last 0) (> last 9007199254740991) (< now last) (> now 9007199254740991)
              (< timeout 1) (> timeout 900000) (> (- now last) timeout)) [3 0 0 0]
        (cond (and (= event "ready") (= phase 0) (= next 1) alive (= exit-code -1) (not eof)
                   (darwin-watch-ready? request frame)) [1 next now timeout]
              (and (= event "heartbeat") (= phase 1) alive (= exit-code -1) (not eof)
                   (darwin-watch-heartbeat? request frame next)) [1 (+ next 1) now timeout]
              (and (= event "poll") alive (= exit-code -1) (not eof) (= (vector-count frame) 0)) state
              (and (= event "exit") (= phase 1) (not alive)
                   (= (darwin-watch-exit-class request frame exit-code eof) "observer/bound-exit-observed"))
                [2 next now timeout]
              :else [3 0 0 0])))))

;; eof must mean the complete output was observed, not a read timeout or
;; truncated buffer. The total response is WR01/request then WO01/request.
;; Nonzero/unknown status and every mismatch stay unknown.
(defn darwin-watch-reply-class [request :vector-i64 reply :vector-i64 exit-code :i64 eof :bool] :string
  (if (and (= exit-code 0) eof (dwr-request? request) (= (vector-at request 3) 49) (= (vector-count reply) 80)
           (dwr-bytes? reply) (= (vector-at reply 0) 87) (= (vector-at reply 1) 82)
           (= (vector-at reply 2) 48) (= (vector-at reply 3) 49) (= (dwr-u32 reply 4) 0)
           (= (vector-at reply 40) 87) (= (vector-at reply 41) 79)
           (= (vector-at reply 42) 48) (= (vector-at reply 43) 49) (= (dwr-u32 reply 44) 0)
           (loop [i 0]
             (if (= i 32) true
               (and (= (vector-at request i) (vector-at reply (+ i 8)))
                    (= (vector-at request i) (vector-at reply (+ i 48))) (recur (+ i 1))))))
    "observer/bound-exit-observed" "observer/unknown"))
