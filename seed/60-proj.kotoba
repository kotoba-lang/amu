;; seed/60-proj.kotoba -- multi-module projects: discovery, per-module compile against interfaces, machine-code link
;; (prefix pj-). Owner: agent R5A (rung R5 part A). Design: docs/selfhost-seed-r5-design-20261002.md sections 2.1-2.3 and 3
;; (option B: one process, M reset between modules, code appended to an image buffer, link = patch).
;;
;; The route (90-drv sends a compile here when --source-path is given or the entry's ns form has a clause 20-names does not
;; read: :require, an attr-map, a docstring):
;;   1. DISCOVER (pj-visit): the entry, then depth first every `:require` in clause order; each module is read into M
;;      (lex + read only), its ns header is parsed (pj-header: name, requires with :as/:refer, exports), its requires are
;;      resolved to files (namespace a.b-c -> a/b_c + .kotoba | .cljk | .cljc in each --source-path root) and visited;
;;      post-order gives the compile order (dependencies first, the entry last). Bounds: 256 modules, depth 64, 256 edges,
;;      8 MiB of source. Cycle, missing module, ns/path mismatch, duplicate alias, :use, two ns forms: refused by name.
;;   2. COMPILE each module alone (pj-module): its source S is followed by a generated TRAILER
;;        (ns <its name> (:export [..]))  -- the entry: its declared exports; a library: (:export []), i.e. nothing is a
;;                                          container export (a library's interface is the link table below, so an
;;                                          aborting or :string export is admitted, as in the reference)
;;        (defn- u/bump [p0 :i64] :i64 (u/bump p0))   -- one IMPORT STUB per interface entry of each required module,
;;                                          named as the importer spells it (alias/name, or the referred name), with the
;;                                          export's checked signature; an aborting export's stub body is (throw <zero of E>)
;;                                          so the importer infers :abort with E at every call (ADR 0363, as the reference's
;;                                          kotoba_import__i stubs)
;;      read as one source; the trailer's ns node replaces the module's own ns node (pj-splice), so 20-names .. 42-layout
;;      run unchanged on a single-namespace program. Qualified symbols a/f are ordinary symbols that resolve to the stubs;
;;      before that, pj-qscan refuses an alias that is not required (E6010) and a name that is not an export (E6004).
;;   3. LINK: 42-layout relocates the module's literal loads by its image base (M[MM-STAT-BASE+43]); 50-out's out-blob
;;      gives the code+pool bytes, copied into the image at an 8-aligned base; the FIRST instruction of every stub clause is
;;      overwritten with `b <entry of the export's clause>` (the stub is entered with the caller's arguments in x0..x4 and
;;      its link register, so the branch is a tail call; fuel is charged by the export). A library's interface (names,
;;      clause offsets in the image, stub templates) is recorded in L; then M is reset. The entry's container is the image
;;      with the entry module's exports (out-image).
;;
;; State that survives the reset lives in L (a second :vector-i64, layout below) and in P, a :string pool of the
;; strings (paths, names, aliases, stub templates); functions that add strings return P. Errors are recorded in M as by
;; the other modules (MM-ERR, MM-ERR-POS/A/B = a span of the source of module L[pj-k-errmod], which the driver prints).
;; Seed limits refused by name (E6017): interface types other than :i64 :bool :string :vector-i64 and option/result/list/
;; set/map of those, keyword or record types, variadic clauses, more than 8 clauses. Not here (part B / R6): effects,
;; :capabilities checks, --policy, templates (refused, E6023), closures dispatched across modules (a fn value of an import
;; is the stub's address, which branches on).

;; ---- L layout ------------------------------------------------------------------------------------------------------------
(def pj-l-cap 2097152)
(def pj-k-nmod 0)     ; modules
(def pj-k-img 1)      ; image fill in bytes
(def pj-k-nif 2)      ; interface entries
(def pj-k-nreq 3)     ; require edges
(def pj-k-nref 4)     ; referred names
(def pj-k-nroot 5)    ; source-path roots (P indexes at pj-k-root0 ..)
(def pj-k-unpinned 6) ; --unpinned given
(def pj-k-errmod 7)   ; module whose source the error spans of M refer to
(def pj-k-bytes 8)    ; project source bytes so far
(def pj-k-nstub 9)    ; stub clauses of the module being compiled
(def pj-k-stub0 10)   ; FN index of its first stub clause
(def pj-k-nord 11)    ; modules in the compile order
(def pj-k-nexpn 12)   ; declared export names
(def pj-k-trail 13)   ; byte offset of the trailer in the module's source
(def pj-k-base 14)    ; image base of the module being compiled
(def pj-k-mode 15)    ; 0 = link in process (patch stubs now); 1 = emit an object (60-proj separate mode: record the patches)
(def pj-k-root0 16)   ; .. 31: up to 16 roots
(def pj-m-base 64) (def pj-m-w 20) (def pj-m-cap 256)   ; R6A: 20 words (was 16)
(def pj-mf-name 0) (def pj-mf-path 1) (def pj-mf-state 2) (def pj-mf-depth 3) (def pj-mf-req0 4) (def pj-mf-nreq 5)
(def pj-mf-if0 6) (def pj-mf-nif 7) (def pj-mf-base 8) (def pj-mf-expk 9) (def pj-mf-exp0 10) (def pj-mf-nexp 11)
(def pj-mf-entry 12)  ; 1 = the entry module (its exports are the container's; a library exports nothing to it)
(def pj-mf-obj 13)    ; separate mode: P index of the module's object text
(def pj-r-base 8192) (def pj-r-w 8) (def pj-r-cap 256)
(def pj-rf-mod 0) (def pj-rf-name 1) (def pj-rf-alias 2) (def pj-rf-ref0 3) (def pj-rf-nref 4) (def pj-rf-node 5)
(def pj-f-base 12288) (def pj-f-w 3) (def pj-f-cap 1024)   ; referred name: P index, span start, span end
(def pj-x-base 16384) (def pj-x-cap 8192)                  ; declared export names (P indexes)
(def pj-i-base 32768) (def pj-i-w 16) (def pj-i-cap 4096)
(def pj-if-name 0) (def pj-if-text 1) (def pj-if-ncl 2) (def pj-if-off0 3) (def pj-if-maxcl 8)
(def pj-o-base 98304)                                      ; compile order (module indexes)
(def pj-t-base 98816) (def pj-t-cap 16384)                 ; stub clause -> target image offset (module being compiled)
(def pj-u-base 115200)                                     ; stub clause -> (edge * 4096 + entry of the dependency) * 8 + clause
;; R6A: the string table of the arena P (start offsets) and the per-module / per-entry schema fields
(def pj-k-nstr 36)    ; strings in P
(def pj-s-base 135168) (def pj-s-cap 65536)
(def pj-mf-sch 16)    ; P index of the inner text of the module's own :schemas map (-1: none)
(def pj-mf-sche 17)   ; its byte offset in the module's source
(def pj-k-owncpy 34)  ; byte offset of that text's copy in the trailer of the module being compiled (-1: none)
(def pj-k-ownlen 35)  ; its length
(def pj-if-sch 15)    ; P index of the entry's record schemas ("\n:kw [:record :kw [..]]" pieces), "" when none
(def pj-img-base 200704)
(def pj-max-depth 64) (def pj-max-edges 256) (def pj-max-bytes 8388608)

(defn- pj-l [L :vector-i64 i :i64] :i64 (vector-at L i))
(defn- pj-max [a :i64 b :i64] :i64 (if (> a b) a b))
(defn- pj-min [a :i64 b :i64] :i64 (if (< a b) a b))
(defn- pj-ls [L :vector-i64 i :i64 v :i64] :vector-i64 (vector-assoc! L i v))
(defn- pj-mf [L :vector-i64 m :i64 f :i64] :i64 (vector-at L (+ pj-m-base (* m pj-m-w) f)))
(defn- pj-mset [L :vector-i64 m :i64 f :i64 v :i64] :vector-i64 (vector-assoc! L (+ pj-m-base (* m pj-m-w) f) v))
(defn- pj-rf [L :vector-i64 r :i64 f :i64] :i64 (vector-at L (+ pj-r-base (* r pj-r-w) f)))
(defn- pj-rset [L :vector-i64 r :i64 f :i64 v :i64] :vector-i64 (vector-assoc! L (+ pj-r-base (* r pj-r-w) f) v))
(defn- pj-if [L :vector-i64 e :i64 f :i64] :i64 (vector-at L (+ pj-i-base (* e pj-i-w) f)))
(defn- pj-iset [L :vector-i64 e :i64 f :i64 v :i64] :vector-i64 (vector-assoc! L (+ pj-i-base (* e pj-i-w) f) v))

(defn- pj-new-l [] :vector-i64 (vector-alloc pj-l-cap))

;; ---- the string pool P ----------------------------------------------------------------------------------------------------
;; R6A: P is a STRING ARENA, not a list: string k is P[L[pj-s-base + k], end) where end is the next string's start (or the
;; arena's length for the last one); L[pj-k-nstr] strings. Adding a string appends its bytes to the arena (string-concat on
;; the newest string: the loader appends in place into a string region, amortised O(1) per byte) and costs no loader vector
;; handle; the [:list :string] of R5A cost one handle per string (KEXE_VECTORS) and is gone. Reading copies the span
;; (pj-p); comparisons read the arena in place (pj-peq).
(defn- pj-n [L :vector-i64] :i64 (vector-at L pj-k-nstr))
(defn- pj-pa [L :vector-i64 i :i64] :i64 (vector-at L (+ pj-s-base i)))
(defn- pj-pb [L :vector-i64 P :string i :i64] :i64
  (if (< (+ i 1) (pj-n L)) (vector-at L (+ pj-s-base i 1)) (string-length P)))
(defn- pj-p [L :vector-i64 P :string i :i64] :string (string-substring P (pj-pa L i) (pj-pb L P i)))
(defn- pj-padd [L :vector-i64 P :string s :string] :string
  (let [k (pj-n L)
        w (if (>= k (- pj-s-cap 1)) L (-> L (vector-assoc! (+ pj-s-base k) (string-length P)) (vector-assoc! pj-k-nstr (+ k 1))))]
    (if (>= k (- pj-s-cap 1)) P (string-concat P s))))
;; string i of P is s (no allocation)
(defn- pj-peq [L :vector-i64 P :string i :i64 s :string] :bool (pj-span= P (pj-pa L i) (pj-pb L P i) s))
;; a fresh pool (90-drv: the roots are added to it)
(defn- pj-new-p [L :vector-i64] :string (let [w (vector-assoc! L pj-k-nstr 0)] ""))

;; ---- M access ----------------------------------------------------------------------------------------------------------
(defn- pj-ok [M :vector-i64] :bool (= (vector-at M MM-ERR) 0))
(defn- pj-nf [M :vector-i64 n :i64 f :i64] :i64 (vector-at M (+ MM-NODE-BASE (* n MM-NODE-W) f)))
(defn- pj-nset [M :vector-i64 n :i64 f :i64 v :i64] :vector-i64 (vector-assoc! M (+ MM-NODE-BASE (* n MM-NODE-W) f) v))
(defn- pj-tf [M :vector-i64 t :i64 f :i64] :i64 (vector-at M (+ MM-TOK-BASE (* t MM-TOK-W) f)))
(defn- pj-kind [M :vector-i64 n :i64] :i64 (pj-nf M n NF-KIND))
(defn- pj-first [M :vector-i64 n :i64] :i64 (pj-nf M n NF-FIRST))
(defn- pj-next [M :vector-i64 n :i64] :i64 (pj-nf M n NF-NEXT))
(defn- pj-a [M :vector-i64 n :i64] :i64 (pj-tf M (pj-nf M n NF-TOK) TF-START))
(defn- pj-b [M :vector-i64 n :i64] :i64 (pj-tf M (pj-nf M n NF-TOK) TF-END))
;; the text of atom node n
(defn- pj-text [M :vector-i64 S :string n :i64] :string (string-substring S (pj-a M n) (pj-b M n)))
;; S[a,b) spells s (no allocation)
(defn- pj-span= [S :string a :i64 b :i64 s :string] :bool
  (and (= (- b a) (string-length s))
       (loop [i 0]
         (cond (>= i (string-length s)) true
               (not= (string-code-point-at S (+ a i)) (string-code-point-at s i)) false
               :else (recur (+ i 1))))))
(defn- pj-is [M :vector-i64 S :string n :i64 s :string] :bool (pj-span= S (pj-a M n) (pj-b M n) s))

;; first error wins; the span of node n (n = 0: no position)
(defn- pj-err-span [M :vector-i64 code :i64 pos :i64 a :i64 b :i64] :vector-i64
  (if (pj-ok M)
    (-> M (vector-assoc! MM-ERR code) (vector-assoc! MM-ERR-POS pos) (vector-assoc! MM-ERR-A (pj-max a 0)) (vector-assoc! MM-ERR-B (pj-max b 0)))
    M))
(defn- pj-err [M :vector-i64 code :i64 n :i64] :vector-i64
  (if (= n 0) (pj-err-span M code -1 0 0) (pj-err-span M code (pj-a M n) (pj-a M n) (pj-b M n))))

;; ---- reset of M between modules ------------------------------------------------------------------------------------------
(defn- pj-zero [M :vector-i64 a :i64 e :i64] :vector-i64
  (loop [i a]
    (if (>= i e) M (let [w (vector-assoc! M i 0)] (recur (+ i 1))))))

;; zero exactly what a compile filled (every region's prefix up to its fill, the whole HASH and SCOPE regions, the HEAP up to
;; its top, the header and statistics cells), then the state of mem-new: "fresh words are zero" holds for the next module
(defn- pj-reset [M :vector-i64] :vector-i64
  (let [ntok (vector-at M MM-TOK-N) nnode (vector-at M MM-NODE-N) nsym (vector-at M MM-SYM-N) nfn (vector-at M MM-FN-N)
        nsir (vector-at M MM-SIR-N) nlab (vector-at M MM-LABEL-N) ncode (vector-at M MM-CODE-N) nfix (vector-at M MM-FIX-N)
        nlit (vector-at M MM-LIT-N) nlitb (vector-at M MM-LITB-N) nexp (vector-at M MM-EXP-N) nout (vector-at M MM-OUT-N)
        top (vector-at M MM-HEAP-TOP)]
    (-> M
        (pj-zero MM-TOK-BASE (+ MM-TOK-BASE (* ntok MM-TOK-W)))
        (pj-zero MM-NODE-BASE (+ MM-NODE-BASE (* nnode MM-NODE-W)))
        (pj-zero MM-SYM-BASE (+ MM-SYM-BASE (* nsym MM-SYM-W)))
        (pj-zero MM-HASH-BASE (+ MM-HASH-BASE (* MM-HASH-CAP MM-HASH-W)))
        (pj-zero MM-FN-BASE (+ MM-FN-BASE (* nfn MM-FN-W)))
        (pj-zero MM-SCOPE-BASE (+ MM-SCOPE-BASE (* MM-SCOPE-CAP MM-SCOPE-W)))
        (pj-zero MM-SIR-BASE (+ MM-SIR-BASE (* nsir MM-SIR-W)))
        (pj-zero MM-LABEL-BASE (pj-min (+ MM-LABEL-BASE nlab 1) (+ MM-LABEL-BASE MM-LABEL-CAP)))
        (pj-zero MM-CODE-BASE (+ MM-CODE-BASE ncode))
        (pj-zero MM-FIX-BASE (+ MM-FIX-BASE (* nfix MM-FIX-W)))
        (pj-zero MM-LIT-BASE (+ MM-LIT-BASE (* nlit MM-LIT-W)))
        (pj-zero MM-LITB-BASE (+ MM-LITB-BASE nlitb))
        (pj-zero MM-EXP-BASE (+ MM-EXP-BASE (* nexp MM-EXP-W)))
        (pj-zero MM-OUT-BASE (+ MM-OUT-BASE nout))
        (pj-zero MM-HEAP-BASE (pj-max top MM-HEAP-BASE))
        (pj-zero 0 256)
        (vector-assoc! MM-VERSION MM-LAYOUT-VERSION)
        (mem-init-fills MM-TOK-N)
        (mem-set MM-HASH-N 0)
        (mem-set MM-HEAP-TOP MM-HEAP-BASE)
        (mem-set MM-ERR-POS -1))))

;; reset, then lex and read S (one module's source, with or without its trailer)
(defn- pj-read [M :vector-i64 S :string] :vector-i64
  (let [M1 (mem-set (pj-reset M) MM-SRC-LEN (string-length S))
        M2 (lx-run M1 S)]
    (if (pj-ok M2) (rd-run M2 S) M2)))

;; ---- names and paths -----------------------------------------------------------------------------------------------------
;; namespace a.b-c -> relative path a/b_c
(defn- pj-rel [nm :string] :string
  (loop [i 0 a 0 acc ""]
    (cond (>= i (string-length nm)) (string-concat acc (string-substring nm a i))
          (= (string-code-point-at nm i) 46) (recur (+ i 1) (+ i 1) (string-concat (string-concat acc (string-substring nm a i)) "/"))
          (= (string-code-point-at nm i) 45) (recur (+ i 1) (+ i 1) (string-concat (string-concat acc (string-substring nm a i)) "_"))
          :else (recur (+ i 1) a acc))))

(defn- pj-ext [k :i64] :string (case k 0 ".kotoba" 1 ".cljk" ".cljc"))

;; the file of rel in root: the first extension that exists, else ""
(defn- pj-in-root [root :string rel :string] :string
  (loop [k 0]
    (cond (> k 2) ""
          (= (io-exists (string-concat root (string-concat "/" (string-concat rel (pj-ext k))))) 1)
          (string-concat root (string-concat "/" (string-concat rel (pj-ext k))))
          :else (recur (+ k 1)))))

(defn- pj-kotoba? [path :string] :bool
  (and (>= (string-length path) 7) (string=? (string-substring path (- (string-length path) 7) (string-length path)) ".kotoba")))

;; the file of namespace nm over the roots: "" none; "\n" ambiguous (two roots, not exactly one .kotoba among them)
(defn- pj-locate [L :vector-i64 P :string nm :string] :string
  (let [rel (pj-rel nm)
        n (pj-l L pj-k-nroot)]
    (loop [k 0 found "" nfound 0 nkot 0 kot ""]
      (if (>= k n)
        (cond (= nfound 0) "" (= nfound 1) found (= nkot 1) kot :else "\n")
        (let [c (pj-in-root (pj-p L P (pj-l L (+ pj-k-root0 k))) rel)]
          (cond (= (string-length c) 0) (recur (+ k 1) found nfound nkot kot)
                (pj-kotoba? c) (recur (+ k 1) c (+ nfound 1) (+ nkot 1) c)
                :else (recur (+ k 1) c (+ nfound 1) nkot kot)))))))

;; the module named nm, -1 when none
(defn- pj-find-mod [L :vector-i64 P :string nm :string] :i64
  (loop [m 0]
    (cond (>= m (pj-l L pj-k-nmod)) -1
          (pj-peq L P (pj-mf L m pj-mf-name) nm) m
          :else (recur (+ m 1)))))

;; a new module record (state 0); its index is the old count
(defn- pj-add-mod [L :vector-i64 name :i64 path :i64] :vector-i64
  (let [m (pj-l L pj-k-nmod)]
    (-> L (pj-mset m pj-mf-name name) (pj-mset m pj-mf-path path) (pj-mset m pj-mf-state 0) (pj-mset m pj-mf-depth 0)
        (pj-mset m pj-mf-nreq 0) (pj-mset m pj-mf-nif 0) (pj-mset m pj-mf-expk 0) (pj-mset m pj-mf-nexp 0) (pj-mset m pj-mf-entry 0) (pj-mset m pj-mf-sch -1)
        (pj-ls pj-k-nmod (+ m 1)))))

;; ---- the ns header ------------------------------------------------------------------------------------------------------
;; n is a list whose head symbol spells h
(defn- pj-head? [M :vector-i64 S :string n :i64 h :string] :bool
  (and (= (pj-kind M n) ND-LIST) (= (pj-kind M (pj-first M n)) ND-SYM) (pj-is M S (pj-first M n) h)))

(defn- pj-count-ns [M :vector-i64 S :string] :i64
  (loop [n (pj-first M (vector-at M MM-ROOT)) k 0]
    (cond (= n 0) k
          (pj-head? M S n "ns") (recur (pj-next M n) (+ k 1))
          :else (recur (pj-next M n) k))))

;; the name node of the top-level (defn|defn-|def NAME ..) n, else 0
(defn- pj-def-name [M :vector-i64 S :string n :i64] :i64
  (let [nm (pj-next M (pj-first M n))]
    (if (and (or (pj-head? M S n "defn") (pj-head? M S n "defn-") (pj-head? M S n "def")) (= (pj-kind M nm) ND-SYM)) nm 0)))

;; number of public defns
(defn- pj-count-pub [M :vector-i64 S :string] :i64
  (loop [n (pj-first M (vector-at M MM-ROOT)) k 0]
    (cond (= n 0) k
          (pj-head? M S n "defn") (recur (pj-next M n) (+ k 1))
          :else (recur (pj-next M n) k))))

;; a top-level definition is spelled s
(defn- pj-defined? [M :vector-i64 S :string s :string] :bool
  (loop [n (pj-first M (vector-at M MM-ROOT))]
    (cond (= n 0) false
          (and (> (pj-def-name M S n) 0) (pj-is M S (pj-def-name M S n) s)) true
          :else (recur (pj-next M n)))))

;; append the symbols of vector v as declared exports of module m
(defn- pj-exports [M :vector-i64 L :vector-i64 P :string S :string v :i64] :string
  (loop [c (pj-first M v) P P]
    (cond (not (pj-ok M)) P
          (= c 0) P
          (not= (pj-kind M c) ND-SYM) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          (>= (pj-l L pj-k-nexpn) pj-x-cap) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          :else (let [k (pj-l L pj-k-nexpn)
                      w (pj-ls (pj-ls L (+ pj-x-base k) (pj-n L)) pj-k-nexpn (+ k 1))]
                  (recur (pj-next M c) (pj-padd L P (pj-text M S c)))))))

;; module m declares its exports with the vector v (kind 1 clause, 2 attr-map)
(defn- pj-declare [M :vector-i64 L :vector-i64 P :string S :string v :i64] :string
  (let []
    (cond (> (pj-mf L (pj-l L pj-k-errmod) pj-mf-expk) 0) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          (not= (pj-kind M v) ND-VEC) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          :else (let [cur (pj-l L pj-k-errmod)
                      w (-> L (pj-mset cur pj-mf-expk 1) (pj-mset cur pj-mf-exp0 (pj-l L pj-k-nexpn)))
                      P2 (pj-exports M L P S v)]
                  (let [w2 (pj-mset L cur pj-mf-nexp (- (pj-l L pj-k-nexpn) (pj-mf L cur pj-mf-exp0)))] P2)))))

;; an alias already used by a require of module cur
(defn- pj-alias-dup? [L :vector-i64 P :string cur :i64 a :string] :bool
  (loop [r (pj-mf L cur pj-mf-req0)]
    (cond (>= r (pj-l L pj-k-nreq)) false
          (and (>= (pj-rf L r pj-rf-alias) 0) (pj-peq L P (pj-rf L r pj-rf-alias) a)) true
          :else (recur (+ r 1)))))

(defn- pj-ns-dup? [L :vector-i64 P :string cur :i64 a :string] :bool
  (loop [r (pj-mf L cur pj-mf-req0)]
    (cond (>= r (pj-l L pj-k-nreq)) false
          (pj-peq L P (pj-rf L r pj-rf-name) a) true
          :else (recur (+ r 1)))))

;; a name referred by an earlier require of module cur (or the one being read)
(defn- pj-refer-dup? [L :vector-i64 P :string cur :i64 a :string] :bool
  (loop [f (pj-rf L (pj-mf L cur pj-mf-req0) pj-rf-ref0)]
    (cond (>= f (pj-l L pj-k-nref)) false
          (pj-peq L P (pj-l L (+ pj-f-base (* f pj-f-w))) a) true
          :else (recur (+ f 1)))))

;; the referred names of vector v
(defn- pj-refers [M :vector-i64 L :vector-i64 P :string S :string v :i64] :string
  (let [cur (pj-l L pj-k-errmod)]
    (loop [c (pj-first M v) P P]
      (cond (not (pj-ok M)) P
            (= c 0) P
            (not= (pj-kind M c) ND-SYM) (let [w (pj-err M E-PROJ-SPEC c)] P)
            (>= (pj-l L pj-k-nref) pj-f-cap) (let [w (pj-err M E-PROJ-EDGES c)] P)
            (pj-refer-dup? L P cur (pj-text M S c)) (let [w (pj-err M E-PROJ-REFER c)] P)
            (pj-defined? M S (pj-text M S c)) (let [w (pj-err M E-PROJ-REFER c)] P)
            :else (let [f (pj-l L pj-k-nref)
                        b (+ pj-f-base (* f pj-f-w))
                        r (- (pj-l L pj-k-nreq) 1)
                        w (-> L (pj-ls b (pj-n L)) (pj-ls (+ b 1) (pj-a M c)) (pj-ls (+ b 2) (pj-b M c)) (pj-ls pj-k-nref (+ f 1))
                              (pj-rset r pj-rf-nref (+ (pj-rf L r pj-rf-nref) 1)))]
                    (recur (pj-next M c) (pj-padd L P (pj-text M S c))))))))

;; the options after the namespace symbol of a require spec, from node o (the edge r is the last one)
(defn- pj-spec-opts [M :vector-i64 L :vector-i64 P :string S :string o :i64] :string
  (let [cur (pj-l L pj-k-errmod)
        r (- (pj-l L pj-k-nreq) 1)
        v (pj-next M o)]
    (cond (not (pj-ok M)) P
          (= o 0) P
          (not= (pj-kind M o) ND-KW) (let [w (pj-err M E-PROJ-SPEC o)] P)
          (= v 0) (let [w (pj-err M E-PROJ-SPEC o)] P)
          (pj-is M S o ":as")
          (cond (not= (pj-kind M v) ND-SYM) (let [w (pj-err M E-PROJ-SPEC v)] P)
                (>= (pj-rf L r pj-rf-alias) 0) (let [w (pj-err M E-PROJ-SPEC o)] P)
                (pj-alias-dup? L P cur (pj-text M S v)) (let [w (pj-err M E-PROJ-DUP-ALIAS v)] P)
                :else (let [w (pj-rset L r pj-rf-alias (pj-n L))]
                        (pj-spec-opts M L (pj-padd L P (pj-text M S v)) S (pj-next M v))))
          (pj-is M S o ":refer")
          (if (= (pj-kind M v) ND-VEC)
            (pj-spec-opts M L (pj-refers M L P S v) S (pj-next M v))
            (let [w (pj-err M E-PROJ-SPEC v)] P))
          (pj-is M S o ":with") (let [w (pj-err M E-PROJ-TEMPLATE o)] P)
          :else (let [w (pj-err M E-PROJ-SPEC o)] P))))

;; one require spec [ns :as a :refer [..]]
(defn- pj-spec [M :vector-i64 L :vector-i64 P :string S :string sp :i64] :string
  (let [cur (pj-l L pj-k-errmod)
        nm (pj-first M sp)
        r (pj-l L pj-k-nreq)]
    (cond (not= (pj-kind M sp) ND-VEC) (let [w (pj-err M E-PROJ-SPEC sp)] P)
          (not= (pj-kind M nm) ND-SYM) (let [w (pj-err M E-PROJ-SPEC sp)] P)
          (pj-ns-dup? L P cur (pj-text M S nm)) (let [w (pj-err M E-PROJ-DUP-NS nm)] P)
          (>= r pj-r-cap) (let [w (pj-err M E-PROJ-EDGES nm)] P)
          :else (let [w (-> L (pj-rset r pj-rf-mod -1) (pj-rset r pj-rf-name (pj-n L)) (pj-rset r pj-rf-alias -1)
                            (pj-rset r pj-rf-ref0 (pj-l L pj-k-nref)) (pj-rset r pj-rf-nref 0) (pj-rset r pj-rf-node nm)
                            (pj-ls pj-k-nreq (+ r 1)) (pj-mset cur pj-mf-nreq (+ (pj-mf L cur pj-mf-nreq) 1)))]
                  (pj-spec-opts M L (pj-padd L P (pj-text M S nm)) S (pj-next M nm))))))

(defn- pj-specs [M :vector-i64 L :vector-i64 P :string S :string sp :i64] :string
  (if (or (= sp 0) (not (pj-ok M))) P (pj-specs M L (pj-spec M L P S sp) S (pj-next M sp))))

;; the attr-map {k v ..} of the ns form
(defn- pj-attrs [M :vector-i64 L :vector-i64 P :string S :string k :i64] :string
  (let [v (pj-next M k)]
    (cond (or (= k 0) (not (pj-ok M))) P
          (= v 0) (let [w (pj-err M E-PROJ-NSFORM k)] P)
          (pj-is M S k ":kotoba/export") (pj-attrs M L (pj-declare M L P S v) S (pj-next M v))
          (pj-is M S k ":kotoba/params") (let [w (pj-err M E-PROJ-TEMPLATE k)] P)
          (pj-is M S k ":kotoba/schemas") (pj-attrs M L (pj-own-schemas M L P S v) S (pj-next M v))   ; R6A
          (pj-is M S k ":kotoba/capabilities") (let [w (pj-r5b-decl M L S v)] (pj-attrs M L P S (pj-next M v)))   ; R5B
          :else (pj-attrs M L P S (pj-next M v)))))

;; R6A: the module's own schema map v: its inner text (verbatim, re-read in the generated ns form) is string pj-mf-sch
(defn- pj-own-schemas [M :vector-i64 L :vector-i64 P :string S :string v :i64] :string
  (let [cur (pj-l L pj-k-errmod)
        a (pj-a M v)
        e (lx-sk-form S a)]
    (cond (not= (pj-kind M v) ND-MAP) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          (< e 0) (let [w (pj-err M E-PROJ-NSFORM v)] P)
          :else (let [w (-> L (pj-mset cur pj-mf-sch (pj-n L)) (pj-mset cur pj-mf-sche (+ a 1)))] (pj-padd L P (string-substring S (+ a 1) (- e 1)))))))

;; one clause or attr-map of the ns form
(defn- pj-clause [M :vector-i64 L :vector-i64 P :string S :string c :i64] :string
  (let [k (pj-first M c)]
    (cond (= (pj-kind M c) ND-STR) P
          (= (pj-kind M c) ND-MAP) (pj-attrs M L P S (pj-first M c))
          (not= (pj-kind M c) ND-LIST) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          (not= (pj-kind M k) ND-KW) (let [w (pj-err M E-PROJ-NSFORM c)] P)
          (pj-is M S k ":require") (pj-specs M L P S (pj-next M k))
          (pj-is M S k ":export") (if (= (pj-next M (pj-next M k)) 0) (pj-declare M L P S (pj-next M k)) (let [w (pj-err M E-PROJ-NSFORM c)] P))
          (pj-is M S k ":schemas") (pj-own-schemas M L P S (pj-next M k))   ; R6A
          (pj-is M S k ":capabilities") (let [w (pj-r5b-decl M L S (pj-next M k))] P)   ; R5B
          (pj-is M S k ":refer-clojure") P
          (pj-is M S k ":params") (let [w (pj-err M E-PROJ-TEMPLATE k)] P)
          (pj-is M S k ":use") (let [w (pj-err M E-PROJ-USE k)] P)
          :else (let [w (pj-err M E-PROJ-CLAUSE k)] P))))

(defn- pj-clauses [M :vector-i64 L :vector-i64 P :string S :string c :i64] :string
  (if (or (= c 0) (not (pj-ok M))) P (pj-clauses M L (pj-clause M L P S c) S (pj-next M c))))

;; parse the header of module L[errmod] (its source S is read into M); expect = the required name ("" for the entry)
(defn- pj-header [M :vector-i64 L :vector-i64 P :string S :string expect :string] :string
  (let [cur (pj-l L pj-k-errmod)
        ns (pj-first M (vector-at M MM-ROOT))
        nmn (pj-next M (pj-first M ns))]
    (cond (not= (pj-count-ns M S) 1) (let [w (pj-err M E-PROJ-NS ns)] P)
          (not (pj-head? M S ns "ns")) (let [w (pj-err M E-PROJ-NS ns)] P)
          (not= (pj-kind M nmn) ND-SYM) (let [w (pj-err M E-PROJ-NSFORM ns)] P)
          (and (> (string-length expect) 0) (not (pj-is M S nmn expect))) (let [w (pj-err M E-PROJ-MISMATCH nmn)] P)
          :else (let [w (-> L (pj-mset cur pj-mf-req0 (pj-l L pj-k-nreq)) (pj-mset cur pj-mf-nreq 0))
                      P1 (if (= (string-length expect) 0) (let [w1 (pj-mset L cur pj-mf-name (pj-n L))] (pj-padd L P (pj-text M S nmn))) P)
                      P2 (pj-clauses M L P1 S (pj-next M nmn))]
                  (cond (not (pj-ok M)) P2
                        (and (= (pj-mf L cur pj-mf-entry) 0) (= (pj-mf L cur pj-mf-expk) 0) (= (pj-count-pub M S) 0)) (let [w2 (pj-err M E-PROJ-NOTHING nmn)] P2)
                        :else P2)))))

;; ---- discovery --------------------------------------------------------------------------------------------------------
;; resolve require edge r of module cur (depth d) to a module: an existing one, or a new one from the roots
(defn- pj-resolve [M :vector-i64 L :vector-i64 P :string r :i64 d :i64] :string
  (let [nm (pj-p L P (pj-rf L r pj-rf-name))
        node (pj-rf L r pj-rf-node)
        m (pj-find-mod L P nm)]
    (cond (> (+ d 1) pj-max-depth) (let [w (pj-err M E-PROJ-DEPTH node)] P)
          (and (>= m 0) (= (pj-mf L m pj-mf-state) 1)) (let [w (pj-err M E-PROJ-CYCLE node)] P)
          (>= m 0) (let [w (pj-rset L r pj-rf-mod m)] P)
          (>= (pj-l L pj-k-nmod) pj-m-cap) (let [w (pj-err M E-PROJ-MODULES node)] P)
          :else (let [path (pj-locate L P nm)]
                  (cond (= (string-length path) 0) (let [w (pj-err M E-PROJ-MISSING node)] P)
                        (string=? path "\n") (let [w (pj-err M E-PROJ-AMBIGUOUS node)] P)
                        :else (let [k (pj-l L pj-k-nmod)
                                    w (-> L (pj-add-mod (pj-rf L r pj-rf-name) (pj-n L)) (pj-rset r pj-rf-mod k) (pj-mset k pj-mf-depth (+ d 1)))]
                                (pj-padd L P path)))))))

(defn- pj-resolve-all [M :vector-i64 L :vector-i64 P :string cur :i64] :string
  (let [r0 (pj-mf L cur pj-mf-req0)
        n (pj-mf L cur pj-mf-nreq)
        d (pj-mf L cur pj-mf-depth)]
    (loop [k 0 P P]
      (if (or (>= k n) (not (pj-ok M))) P (recur (+ k 1) (pj-resolve M L P (+ r0 k) d))))))

;; visit module m: read, header, resolve, children, then append m to the compile order
(defn- pj-visit [M :vector-i64 L :vector-i64 P :string m :i64] :string
  (let [path (pj-p L P (pj-mf L m pj-mf-path))
        S (io-read-file M path)
        bytes (+ (pj-l L pj-k-bytes) (string-length S))
        w (-> L (pj-ls pj-k-bytes bytes) (pj-ls pj-k-errmod m) (pj-mset m pj-mf-state 1))
        M1 (pj-read M S)]
    (cond (not (pj-ok M1)) P
          (> bytes pj-max-bytes) (let [w2 (pj-err M1 E-PROJ-BYTES 0)] P)
          :else
          (let [P2 (pj-header M1 L P S (if (= (pj-mf L m pj-mf-entry) 1) "" (pj-p L P (pj-mf L m pj-mf-name))))
                P3 (if (pj-ok M1) (pj-resolve-all M1 L P2 m) P2)
                r0 (pj-mf L m pj-mf-req0)
                n (pj-mf L m pj-mf-nreq)
                P4 (loop [k 0 P P3]
                     (cond (or (>= k n) (not (pj-ok M1))) P
                           (= (pj-mf L (pj-rf L (+ r0 k) pj-rf-mod) pj-mf-state) 0) (recur (+ k 1) (pj-visit M1 L P (pj-rf L (+ r0 k) pj-rf-mod)))
                           :else (recur (+ k 1) P)))
                no (pj-l L pj-k-nord)]
            (if (pj-ok M1)
              (let [w3 (-> L (pj-mset m pj-mf-state 2) (pj-ls (+ pj-o-base no) m) (pj-ls pj-k-nord (+ no 1)))] P4)
              P4)))))

;; ---- interface types and stub templates -------------------------------------------------------------------------------
;; R6A: the interface of an export is SOURCE TEXT (a stub template) whose types are spelled canonically, so that the importer
;; re-interns them in its own compile: :i64 :bool :string :vector-i64 :bytes :keyword, records by reference [:ref :kw] (the
;; record travels with its schema: [:record :kw [[:f T] ..]] pieces in the entry's schema text, every record reachable from
;; the signature, so the importer's generated ns declares them and 21-check compares them structurally with any schema of the
;; same name the importer declares itself, E2128), fn types [:fn [[P ..] R]], and option/result/list/set/map of those.
;; A keyword value crosses as is (30-lower: a keyword's value is the hash of its spelling). Variadic clauses cross as
;; [p0 T0 .. & pn] (the caller packs the surplus into the list, the export's clause receives it). E6017 remains for an error
;; type no stub can throw a value of (a record or a collection), more than 8 clauses, and a record whose schema is unknown.
(defn- pj-ct [M :vector-i64 t :i64 f :i64] :i64 (vector-at M (+ (vector-at M MM-CT) (* (- t TY-COMP-BASE) CT-W) f)))
(defn- pj-sf [M :vector-i64 s :i64 k :i64] :i64 (vector-at M (+ MM-SYM-BASE (* s MM-SYM-W) k)))
(defn- pj-symtext [M :vector-i64 S :string s :i64] :string (string-substring S (pj-sf M s SF-START) (pj-sf M s SF-END)))

;; the schema block of record type t, 0 when none is registered
(defn- pj-blk [M :vector-i64 t :i64] :i64 (pj-sf M (- t TY-REC-BASE) SF-REC))

;; the keyword that names record type t across modules: its identity keyword, or :<ns>/Name for a defrecord whose module never
;; spells its keyword (the importer registers the schema under that keyword)
(defn- pj-reckw [M :vector-i64 S :string nsn :string t :i64] :string
  (let [tx (pj-symtext M S (- t TY-REC-BASE))]
    (if (and (> (string-length tx) 0) (= (string-code-point-at tx 0) 58))
      tx
      (string-concat ":" (string-concat nsn (string-concat "/" tx))))))

;; "[P1 P2 ..]" of the parameter-list type chain p (TC-PLIST: CT-A the type, CT-B the rest), "" when one does not cross
(defn- pj-typl [M :vector-i64 S :string nsn :string p :i64] :string
  (loop [q p acc ""]
    (cond (= q 0) (string-concat "[" (string-concat acc "]"))
          (= (string-length (pj-ty M S nsn (pj-ct M q CT-A))) 0) ""
          :else (recur (pj-ct M q CT-B) (string-concat acc (string-concat (if (= q p) "" " ") (pj-ty M S nsn (pj-ct M q CT-A))))))))

;; the source spelling of type t, "" when it does not cross a module boundary in the seed
(defn- pj-ty [M :vector-i64 S :string nsn :string t :i64] :string
  (cond (= t TY-I64) ":i64" (= t TY-BOOL) ":bool" (= t TY-STR) ":string" (= t TY-VEC) ":vector-i64"
        (= t TY-BYTES) ":bytes" (= t TY-KW) ":keyword"
        (= t TY-DOC) ":document"   ; R6B
        (= t TY-SYM) ":symbol"   ; R6B
        (= t TY-F64) ":f64"   ; R6C
        (< t TY-REC-BASE) ""
        (< t TY-COMP-BASE) (if (= (pj-blk M t) 0) "" (string-concat "[:ref " (string-concat (pj-reckw M S nsn t) "]")))
        (= (pj-ct M t CT-CTOR) TC-FN)
        (let [ps (pj-typl M S nsn (pj-ct M t CT-B))
              r (pj-ty M S nsn (pj-ct M t CT-A))]
          (if (or (= (string-length ps) 0) (= (string-length r) 0)) ""
            (string-concat "[:fn [" (string-concat ps (string-concat " " (string-concat r "]]"))))))
        :else (let [c (pj-ct M t CT-CTOR)
                    a (pj-ty M S nsn (pj-ct M t CT-A))
                    b (if (or (= c TC-RESULT) (= c TC-MAP)) (pj-ty M S nsn (pj-ct M t CT-B)) ":i64")]
                (cond (or (= (string-length a) 0) (= (string-length b) 0)) ""
                      (= c TC-OPTION) (string-concat "[:option " (string-concat a "]"))
                      (= c TC-LIST) (string-concat "[:list " (string-concat a "]"))
                      (= c TC-SET) (string-concat "[:set " (string-concat a "]"))
                      (= c TC-RESULT) (string-concat "[:result " (string-concat a (string-concat " " (string-concat b "]"))))
                      (= c TC-MAP) (string-concat "[:map " (string-concat a (string-concat " " (string-concat b "]"))))
                      :else ""))))

;; the record types reachable from type t, added to ids (" t " tokens, each record once: recursive schemas terminate)
(defn- pj-recs [M :vector-i64 t :i64 ids :string] :string
  (cond (< t TY-REC-BASE) ids
        (< t TY-COMP-BASE)
        (let [tok (string-concat " " (string-concat (mem-u2dec t) " "))
              blk (pj-blk M t)]
          (if (or (= blk 0) (>= (string-index-of ids tok) 0))
            ids
            (loop [i 0 acc (string-concat ids tok)]
              (if (>= i (vector-at M (+ blk RB-N))) acc
                (recur (+ i 1) (pj-recs M (vector-at M (+ blk RB-F0 (* i RB-FW) 1)) acc))))))
        :else (pj-recs M (pj-ct M t CT-B) (pj-recs M (pj-ct M t CT-A) ids))))

;; the schema piece of record type t: "\t:kw [:record :kw [[:f T] ..]]", "" when a field type does not cross
(defn- pj-schema [M :vector-i64 S :string nsn :string t :i64] :string
  (let [blk (pj-blk M t)
        kw (pj-reckw M S nsn t)
        fs (loop [i 0 acc ""]
             (if (>= i (vector-at M (+ blk RB-N)))
               acc
               (let [ft (pj-ty M S nsn (vector-at M (+ blk RB-F0 (* i RB-FW) 1)))]
                 (if (= (string-length ft) 0)
                   "\n"
                   (recur (+ i 1) (string-concat acc (string-concat (if (= i 0) "[" " [") (string-concat (pj-symtext M S (vector-at M (+ blk RB-F0 (* i RB-FW))))
                                                         (string-concat " " (string-concat ft "]"))))))))))]
    (if (or (= blk 0) (string=? fs "\n")) ""
      (string-concat "\t" (string-concat kw (string-concat " [:record " (string-concat kw (string-concat " [" (string-concat fs "]]")))))))))

;; the schema pieces of the records in ids; "\n" when one does not cross
(defn- pj-schemas [M :vector-i64 S :string nsn :string ids :string] :string
  (loop [i 0 v 0 acc ""]
    (cond (>= i (string-length ids)) acc
          (and (>= (string-code-point-at ids i) 48) (<= (string-code-point-at ids i) 57)) (recur (+ i 1) (+ (* v 10) (- (string-code-point-at ids i) 48)) acc)
          (= v 0) (recur (+ i 1) 0 acc)
          (= (string-length (pj-schema M S nsn v)) 0) "\n"
          :else (recur (+ i 1) 0 (string-concat acc (pj-schema M S nsn v))))))

;; a value of the error type e for a stub's throw, "" when none is spelled here
(defn- pj-zero-of [e :i64] :string
  (cond (= e TY-I64) "0" (= e TY-STR) "\"\"" (= e TY-BOOL) "false" (= e TY-KW) ":seed/stub"
        (= e TY-DOC) "(__r6-as :document \"nil\")"   ; R6B: the null document, no library needed (__r6-as is a head)
        :else ""))

(defn- pj-ff [M :vector-i64 f :i64 k :i64] :i64 (vector-at M (+ MM-FN-BASE (* f MM-FN-W) k)))

;; the parameter vector of clause f (21-check gives every clause a (defn NAME [..] R body) node)
(defn- pj-pvec [M :vector-i64 f :i64] :i64 (pj-next M (pj-next M (pj-first M (pj-ff M f FF-NODE)))))

;; the type of parameter k of clause f (R4B: FF-PT0+k for k < 5, else NF-TYPE of the k-th type form of its parameter vector)
(defn- pj-pt [M :vector-i64 f :i64 k :i64] :i64
  (if (< k 5)
    (pj-ff M f (+ FF-PT0 k))
    (let [pv (pj-pvec M f)]
      (pj-nf M (loop [c (pj-first M pv) j 0] (if (or (= c 0) (>= j (+ (* 2 k) 1))) c (recur (pj-next M c) (+ j 1)))) NF-TYPE))))

;; the variadic flag of clause f (21-check marks NF-TYPE 1 on a variadic clause's parameter vector)
(defn- pj-variadic? [M :vector-i64 f :i64] :bool
  (let [pv (pj-pvec M f)]
    (and (= (pj-kind M pv) ND-VEC) (= (pj-nf M pv NF-TYPE) 1))))

;; "[p0 T0 p1 T1 ..]" of clause f ("& pn" for the rest parameter of a variadic clause), "" when a type does not cross
(defn- pj-params [M :vector-i64 S :string nsn :string f :i64] :string
  (let [n (pj-ff M f FF-NPARAMS)
        va (pj-variadic? M f)]
    (loop [i 0 acc "["]
      (cond (>= i n) (string-concat acc "]")
            (and va (= i (- n 1))) (recur (+ i 1) (string-concat acc (string-concat (if (= i 0) "& p" " & p") (mem-u2dec i))))
            (= (string-length (pj-ty M S nsn (pj-pt M f i))) 0) ""
            :else (recur (+ i 1) (string-concat acc (string-concat (if (= i 0) "p" " p") (string-concat (mem-u2dec i)
                                   (string-concat " " (pj-ty M S nsn (pj-pt M f i)))))))))))

;; "(SEEDSELF p0 p1 ..)": the self call that types a stub body
(defn- pj-selfcall [n :i64] :string
  (loop [i 0 acc "(SEEDSELF"]
    (if (>= i n) (string-concat acc ")") (recur (+ i 1) (string-concat acc (string-concat " p" (mem-u2dec i)))))))

;; "[params] R body" of clause f, "" when it does not cross
(defn- pj-clause-text [M :vector-i64 S :string nsn :string f :i64] :string
  (let [ps (pj-params M S nsn f)
        r (pj-ty M S nsn (pj-ff M f FF-RTYPE))
        ab (pj-sf M (pj-ff M f FF-SYM) SF-ABORT)
        np (if (pj-variadic? M f) (- (pj-ff M f FF-NPARAMS) 1) (pj-ff M f FF-NPARAMS))
        body (if (= ab 0) (pj-selfcall np) (string-concat "(throw " (string-concat (pj-zero-of ab) ")")))]
    (cond (or (= (string-length ps) 0) (= (string-length r) 0)) ""
          (and (not= ab 0) (= (string-length (pj-zero-of ab)) 0)) ""
          :else (string-concat ps (string-concat " " (string-concat r (string-concat " " body)))))))

;; the record types of the signature of clause f, added to ids
(defn- pj-clause-recs [M :vector-i64 f :i64 ids :string] :string
  (loop [i 0 acc (pj-recs M (pj-ff M f FF-RTYPE) ids)]
    (if (>= i (pj-ff M f FF-NPARAMS)) acc (recur (+ i 1) (pj-recs M (pj-pt M f i) acc)))))

;; replace every SEEDSELF in t by q
(defn- pj-subst [t :string q :string] :string
  (let [i (string-index-of t "SEEDSELF")]
    (if (< i 0) t (string-concat (string-substring t 0 i) (string-concat q (pj-subst (string-substring t (+ i 8) (string-length t)) q))))))

;; the first FN clause of the function spelled s in the module in M (S its source), 0 when none
(defn- pj-fn-named [M :vector-i64 S :string s :string] :i64
  (loop [f 1]
    (cond (>= f (vector-at M MM-FN-N)) 0
          (and (or (= (pj-ff M f FF-KIND) FK-DEFN) (= (pj-ff M f FF-KIND) FK-PRIV) (= (pj-ff M f FF-KIND) FK-DEF))
               (= (pj-sf M (pj-ff M f FF-SYM) SF-FN) f)
               (string=? (string-substring S (pj-sf M (pj-ff M f FF-SYM) SF-START) (pj-sf M (pj-ff M f FF-SYM) SF-END)) s)) f
          :else (recur (+ f 1)))))

;; record the interface entry of export s (first clause f0) of module m; base = the module's image offset
(defn- pj-iface-one [M :vector-i64 L :vector-i64 P :string S :string s :string f0 :i64] :string
  (let [e (pj-l L pj-k-nif)
        sym (pj-ff M f0 FF-SYM)
        base (pj-l L pj-k-base)
        nsn (pj-p L P (pj-mf L (pj-l L pj-k-errmod) pj-mf-name))
        ncl (loop [f f0 k 0] (if (and (< f (vector-at M MM-FN-N)) (= (pj-ff M f FF-SYM) sym) (not= (pj-ff M f FF-KIND) FK-DEF)) (recur (+ f 1) (+ k 1)) k))
        txt (loop [k 0 acc ""]
              (cond (>= k ncl) acc
                    (= (string-length (pj-clause-text M S nsn (+ f0 k))) 0) ""
                    (= ncl 1) (pj-clause-text M S nsn f0)
                    :else (recur (+ k 1) (string-concat acc (string-concat " (" (string-concat (pj-clause-text M S nsn (+ f0 k)) ")"))))))
        sch (pj-schemas M S nsn (loop [k 0 ids ""] (if (>= k ncl) ids (recur (+ k 1) (pj-clause-recs M (+ f0 k) ids)))))]
    (cond (or (= ncl 0) (= (pj-ff M f0 FF-KIND) FK-DEF)) (let [w (pj-err-span M E-PROJ-EXPORT-FN (pj-sf M sym SF-START) (pj-sf M sym SF-START) (pj-sf M sym SF-END))] P)
          (or (> ncl pj-if-maxcl) (= (string-length txt) 0) (string=? sch "\n")) (let [w (pj-err-span M E-PROJ-IFACE (pj-sf M sym SF-START) (pj-sf M sym SF-START) (pj-sf M sym SF-END))] P)
          (>= e pj-i-cap) (let [w (pj-err M E-PROJ-EDGES 0)] P)
          :else (let [w (-> L (pj-iset e pj-if-name (pj-n L)) (pj-iset e pj-if-text (+ (pj-n L) 1)) (pj-iset e pj-if-sch (+ (pj-n L) 2))
                            (pj-iset e pj-if-ncl ncl) (pj-ls pj-k-nif (+ e 1)))
                      w2 (loop [k 0] (if (>= k ncl) 0 (let [x (pj-iset L e (+ pj-if-off0 k) (+ base (* (- (pj-ff M (+ f0 k) FF-CODE) 1) 4)))] (recur (+ k 1)))))]
                  (pj-padd L (pj-padd L (pj-padd L P s) txt) sch)))))

;; the interface of library module m (compiled, still in M; S = its source with the trailer)
(defn- pj-iface [M :vector-i64 L :vector-i64 P :string S :string m :i64] :string
  (let [w (-> L (pj-mset m pj-mf-if0 (pj-l L pj-k-nif)))
        P2 (if (> (pj-mf L m pj-mf-expk) 0)
             (loop [k 0 P P]
               (cond (or (>= k (pj-mf L m pj-mf-nexp)) (not (pj-ok M))) P
                     :else (let [s (pj-p L P (pj-l L (+ pj-x-base (pj-mf L m pj-mf-exp0) k)))
                                 f (pj-fn-named M S s)]
                             (if (= f 0)
                               (let [w2 (pj-err-span M E-PROJ-EXPORT-FN -1 0 0)] P)
                               (recur (+ k 1) (pj-iface-one M L P S s f))))))
             (loop [f 1 P P]
               (cond (or (>= f (vector-at M MM-FN-N)) (not (pj-ok M))) P
                     (and (= (pj-ff M f FF-KIND) FK-DEFN) (= (pj-sf M (pj-ff M f FF-SYM) SF-FN) f))
                     (recur (+ f 1) (pj-iface-one M L P S (string-substring S (pj-sf M (pj-ff M f FF-SYM) SF-START) (pj-sf M (pj-ff M f FF-SYM) SF-END)) f))
                     :else (recur (+ f 1) P))))]
    (let [w3 (pj-mset L m pj-mf-nif (- (pj-l L pj-k-nif) (pj-mf L m pj-mf-if0)))] P2)))

;; the interface entry of module t named s, -1 when none
(defn- pj-if-find [L :vector-i64 P :string t :i64 s :string] :i64
  (let [e0 (pj-mf L t pj-mf-if0) n (pj-mf L t pj-mf-nif)]
    (loop [k 0]
      (cond (>= k n) -1
            (pj-peq L P (pj-if L (+ e0 k) pj-if-name) s) (+ e0 k)
            :else (recur (+ k 1))))))

;; ---- the trailer ---------------------------------------------------------------------------------------------------------
;; the stub of interface entry e named q; its clause targets are appended to the T table
(defn- pj-stub [L :vector-i64 P :string e :i64 q :string r :i64] :string
  (let [ncl (pj-if L e pj-if-ncl)
        k0 (pj-min (pj-l L pj-k-nstub) (- pj-t-cap pj-if-maxcl))
        el (- e (pj-mf L (pj-rf L r pj-rf-mod) pj-mf-if0))
        w (loop [k 0]
            (if (>= k ncl) 0
              (let [x (pj-ls L (+ pj-t-base k0 k) (pj-if L e (+ pj-if-off0 k)))
                    y (pj-ls L (+ pj-u-base k0 k) (+ (* (+ (* (- r (pj-mf L (pj-l L pj-k-errmod) pj-mf-req0)) 4096) el) 8) k))]
                (recur (+ k 1)))))
        w2 (pj-ls L pj-k-nstub (+ k0 ncl))]
    (string-concat "(defn- " (string-concat q (string-concat " " (string-concat (pj-subst (pj-p L P (pj-if L e pj-if-text)) q) ")\n"))))))

;; Long texts are built with two accumulators (big, small): a piece is appended to small, and small (at most about 4 KiB) to
;; big, so a byte is copied a few times, not once per later piece (strings are never freed: KEXE_STRING_POOL), and no list
;; is built (every typed-list-conj is a new loader vector: KEXE_VECTORS).
(defn- pj-small [small :string p :string] :string (string-concat small p))

;; the stubs of require edge r
(defn- pj-stubs-req [L :vector-i64 P :string r :i64] :string
  (let [t (pj-rf L r pj-rf-mod)
        al (pj-rf L r pj-rf-alias)
        e0 (pj-mf L t pj-mf-if0)
        na (if (< al 0) 0 (pj-mf L t pj-mf-nif))
        f0 (pj-rf L r pj-rf-ref0)
        n (+ na (pj-rf L r pj-rf-nref))]
    (loop [k 0 big "" small ""]
      (if (>= k n)
        (string-concat big small)
        (let [p (if (< k na)
                  (pj-stub L P (+ e0 k) (string-concat (pj-p L P al) (string-concat "/" (pj-p L P (pj-if L (+ e0 k) pj-if-name)))) r)
                  (let [s (pj-p L P (pj-l L (+ pj-f-base (* (+ f0 (- k na)) pj-f-w))))
                        e (pj-if-find L P t s)]
                    (if (< e 0) "" (pj-stub L P e s r))))
              s2 (pj-small small p)]
          (if (> (string-length s2) 4096) (recur (+ k 1) (string-concat big s2) "") (recur (+ k 1) big s2)))))))

;; R6A: acc with the schema pieces of text t ("\t:kw [..]" pieces) that acc does not hold yet
(defn- pj-sch-merge [acc :string t :string] :string
  (loop [i 0 acc acc]
    (if (>= i (string-length t))
      acc
      (let [j (loop [j (+ i 1)] (cond (>= j (string-length t)) j (= (string-code-point-at t j) 9) j :else (recur (+ j 1))))
            pc (string-substring t i j)]
        (recur j (if (>= (string-index-of acc pc) 0) acc (string-concat acc pc)))))))

;; R6A: acc with the schemas of the interface entries require edge r stubs (as pj-stubs-req chooses them)
(defn- pj-sch-req [L :vector-i64 P :string r :i64 acc :string] :string
  (let [t (pj-rf L r pj-rf-mod)
        al (pj-rf L r pj-rf-alias)
        e0 (pj-mf L t pj-mf-if0)
        na (if (< al 0) 0 (pj-mf L t pj-mf-nif))
        f0 (pj-rf L r pj-rf-ref0)
        n (+ na (pj-rf L r pj-rf-nref))]
    (loop [k 0 acc acc]
      (if (>= k n)
        acc
        (let [e (if (< k na) (+ e0 k) (pj-if-find L P t (pj-p L P (pj-l L (+ pj-f-base (* (+ f0 (- k na)) pj-f-w))))))]
          (recur (+ k 1) (if (< e 0) acc (pj-sch-merge acc (pj-p L P (pj-if L e pj-if-sch))))))))))

;; the trailer of module m: the replacement ns form, then its import stubs. R6A: the ns form carries (:schemas {..}) with the
;; module's own schema entries (its :schemas clause or :kotoba/schemas attribute, verbatim) and the schemas of the records its
;; imports' signatures reach; 21-check registers both and refuses one name with two different definitions (E2128)
(defn- pj-trailer [L :vector-i64 P :string m :i64] :string
  (let [w (pj-ls L pj-k-nstub 0)
        r0 (pj-mf L m pj-mf-req0)
        body (loop [k 0 big ""]
               (if (>= k (pj-mf L m pj-mf-nreq)) big (recur (+ k 1) (string-concat big (pj-stubs-req L P (+ r0 k))))))
        imp (loop [k 0 acc ""]
              (if (>= k (pj-mf L m pj-mf-nreq)) acc (recur (+ k 1) (pj-sch-req L P (+ r0 k) acc))))
        own (if (< (pj-mf L m pj-mf-sch) 0) "" (pj-p L P (pj-mf L m pj-mf-sch)))
        ;; the imported schemas first: a conflict is then reported at the module's own declaration (pj-module maps the
        ;; position of the copy back to the module's source)
        sc (if (= (+ (string-length own) (string-length imp)) 0) ""
             (string-concat " (:schemas {" (string-concat imp (string-concat " " (string-concat own "})")))))
        ;; the module's own name: a record's identity keyword is :<ns>/<Name> (21-check)
        hn (string-concat "\n(ns " (pj-p L P (pj-mf L m pj-mf-name)))
        hd (cond (= (pj-mf L m pj-mf-entry) 0) (string-concat hn " (:export [])")
                 (= (pj-mf L m pj-mf-expk) 0) hn
                 :else (loop [k 0 acc (string-concat hn " (:export [")]
                         (if (>= k (pj-mf L m pj-mf-nexp)) (string-concat acc "])")
                           (recur (+ k 1) (string-concat acc (string-concat " " (pj-p L P (pj-l L (+ pj-x-base (pj-mf L m pj-mf-exp0) k)))))))))
        w2 (-> L (pj-ls pj-k-owncpy (if (= (string-length own) 0) -1 (+ (string-length hd) 13 (string-length imp))))
               (pj-ls pj-k-ownlen (string-length own)))]
    (string-concat hd (string-concat sc (string-concat ")\n" body)))))

;; ---- per-module checks on the read source (before 20-names) --------------------------------------------------------------
;; the require edge of module m whose alias is a, -1 when none
(defn- pj-req-alias [L :vector-i64 P :string m :i64 a :string] :i64
  (let [r0 (pj-mf L m pj-mf-req0)]
    (loop [k 0]
      (cond (>= k (pj-mf L m pj-mf-nreq)) -1
            (and (>= (pj-rf L (+ r0 k) pj-rf-alias) 0) (pj-peq L P (pj-rf L (+ r0 k) pj-rf-alias) a)) (+ r0 k)
            :else (recur (+ k 1))))))

;; byte offset of the first '/' in S[a,b) after its first byte, -1 when none
(defn- pj-slash [S :string a :i64 b :i64] :i64
  (loop [i (+ a 1)]
    (cond (>= i (- b 1)) -1
          (= (string-code-point-at S i) 47) i
          :else (recur (+ i 1)))))

;; every symbol token alias/name of the module's own text: alias required, name an export of it
(defn- pj-qscan [M :vector-i64 L :vector-i64 P :string S :string m :i64] :vector-i64
  (let [trail (pj-l L pj-k-trail)]
    (loop [t 1]
      (if (or (>= t (vector-at M MM-TOK-N)) (not (pj-ok M)) (>= (pj-tf M t TF-START) trail))
        M
        (let [a (pj-tf M t TF-START) b (pj-tf M t TF-END)
              sl (if (= (pj-tf M t TF-KIND) TK-SYM) (pj-slash S a b) -1)]
          (if (< sl 0)
            (recur (+ t 1))
            (let [r (pj-req-alias L P m (string-substring S a sl))]
              (cond (pj-r5b-with? M S t) (recur (+ t 1))   ; R5B: (with l/h ..) is refused by 21-check (handle shape)
                    ;; R6A: clojure.core/f is the core name f (the token is narrowed to it)
                    (pj-span= S a sl "clojure.core") (let [w (vector-assoc! M (+ MM-TOK-BASE (* t MM-TOK-W) TF-START) (+ sl 1))] (recur (+ t 1)))
                    ;; R6B: a friendly capability name of the catalogue (hash/sha256 ..) is 21-check's (ck-r6b-cap)
                    (and (< r 0) (pos? (ck-r6b-capwire (nm-hash S a b)))) (recur (+ t 1))
                    (< r 0) (pj-err-span M E-PROJ-UNKNOWN-OP a a b)
                    (< (pj-if-find L P (pj-rf L r pj-rf-mod) (string-substring S (+ sl 1) b)) 0) (pj-err-span M E-PROJ-NOT-EXPORT a a b)
                    :else (recur (+ t 1))))))))))

;; ==== R6A: project-route normalization of a module's own forms (before 20-names) ==========================================
;; The reference's top-level shapes that the seed's front end does not read yet, rewritten in the tree (no text change):
;;   (defn NAME "doc" ..) / (defn- ..) / (def NAME "doc" value): the docstring is unlinked (a def keeps a string VALUE: only
;;   a string followed by another child is a docstring), then a defn's attr-map {..} likewise;
;;   a top-level `nil` (what #?(:kotoba nil :default ..) reads as) is unlinked.
;; The single-module route still refuses these (20-names/21-check owners: CONTRACT-REQUESTS 2026-10-03 R6A).
(defn- pj-unlink-after [M :vector-i64 n :i64 prev :i64] :vector-i64
  (let [x (pj-next M prev)]
    (-> M (pj-nset prev NF-NEXT (pj-next M x)) (pj-nset n NF-AUX (- (pj-nf M n NF-AUX) 1)))))
(defn- pj-strip-doc [M :vector-i64 S :string n :i64] :vector-i64
  (let [nm (pj-next M (pj-first M n))
        d (pj-next M nm)
        dn (pj-next M d)
        defn? (or (pj-head? M S n "defn") (pj-head? M S n "defn-"))
        M1 (if (and (or defn? (pj-head? M S n "def")) (= (pj-kind M d) ND-STR) (not= dn 0)) (pj-unlink-after M n nm) M)
        a (pj-next M1 nm)]
    (if (and defn? (= (pj-kind M1 a) ND-MAP) (not= (pj-next M1 a) 0)) (pj-unlink-after M1 n nm) M1)))
(defn- pj-norm [M :vector-i64 L :vector-i64 S :string] :vector-i64
  (let [root (vector-at M MM-ROOT)
        trail (pj-l L pj-k-trail)]
    (loop [n (pj-first M root) prev 0]
      (cond (or (= n 0) (>= (pj-a M n) trail)) M
            (and (= (pj-kind M n) ND-SYM) (pj-is M S n "nil"))
            (let [w (if (= prev 0) (pj-nset M root NF-FIRST (pj-next M n)) (pj-nset M prev NF-NEXT (pj-next M n)))
                  w2 (pj-nset M root NF-AUX (- (pj-nf M root NF-AUX) 1))]
              (recur (pj-next M n) prev))
            (= (pj-kind M n) ND-LIST) (let [w (pj-strip-doc M S n)] (recur (pj-next M n) n))
            :else (recur (pj-next M n) n)))))
;; ==== END R6A normalization ================================================================================================

;; every referred name of module m is an export of its module
(defn- pj-refcheck [M :vector-i64 L :vector-i64 P :string m :i64] :vector-i64
  (let [r0 (pj-mf L m pj-mf-req0)]
    (loop [k 0]
      (if (or (>= k (pj-mf L m pj-mf-nreq)) (not (pj-ok M)))
        M
        (let [r (+ r0 k)
              bad (loop [j 0]
                    (cond (>= j (pj-rf L r pj-rf-nref)) -1
                          (< (pj-if-find L P (pj-rf L r pj-rf-mod) (pj-p L P (pj-l L (+ pj-f-base (* (+ (pj-rf L r pj-rf-ref0) j) pj-f-w))))) 0)
                          (+ pj-f-base (* (+ (pj-rf L r pj-rf-ref0) j) pj-f-w))
                          :else (recur (+ j 1))))]
          (if (< bad 0)
            (recur (+ k 1))
            (pj-err-span M E-PROJ-NOT-EXPORT (pj-l L (+ bad 1)) (pj-l L (+ bad 1)) (pj-l L (+ bad 2)))))))))

;; the trailer's ns form replaces the module's own (the first top-level form)
(defn- pj-splice [M :vector-i64 L :vector-i64] :vector-i64
  (let [root (vector-at M MM-ROOT)
        orig (pj-first M root)
        trail (pj-l L pj-k-trail)
        synth (loop [n orig] (cond (= n 0) 0 (>= (pj-a M n) trail) n :else (recur (pj-next M n))))
        pred (loop [n orig] (cond (= n 0) 0 (= (pj-next M n) synth) n :else (recur (pj-next M n))))
        u1 (pj-next M orig)]
    (cond (= synth 0) (pj-err M E-PROJ-NS 0)
          (= u1 synth) (-> M (pj-nset root NF-FIRST synth) (pj-nset root NF-AUX (- (pj-nf M root NF-AUX) 1)))
          :else (-> M (pj-nset pred NF-NEXT (pj-next M synth)) (pj-nset synth NF-NEXT u1) (pj-nset root NF-FIRST synth)
                    (pj-nset root NF-AUX (- (pj-nf M root NF-AUX) 1))))))

;; ---- compile one module and link it ---------------------------------------------------------------------------------------
(defn- pj-put32 [L :vector-i64 at :i64 w :i64] :vector-i64
  (-> L (pj-ls at (bit-and w 255)) (pj-ls (+ at 1) (bit-and (u64-shift-right w 8) 255))
      (pj-ls (+ at 2) (bit-and (u64-shift-right w 16) 255)) (pj-ls (+ at 3) (bit-and (u64-shift-right w 24) 255))))

;; copy the blob OUT[1 .. n] to the image at base, then patch every stub clause into `b <target>`
(defn- pj-link [M :vector-i64 L :vector-i64] :vector-i64
  (let [n (- (vector-at M MM-OUT-N) 1)
        base (pj-l L pj-k-base)
        w (loop [i 0] (if (>= i n) 0 (let [x (pj-ls L (+ pj-img-base base i) (vector-at M (+ MM-OUT-BASE 1 i)))] (recur (+ i 1)))))
        s0 (pj-l L pj-k-stub0)
        w2 (loop [k 0]
             (if (or (>= k (pj-l L pj-k-nstub)) (= (pj-l L pj-k-mode) 1)) 0
               (let [fc (pj-ff M (+ s0 k) FF-CODE)
                     at (+ base (* (- fc 1) 4))
                     d (quot (- (pj-l L (+ pj-t-base k)) at) 4)
                     x (if (> fc 0) (pj-put32 L (+ pj-img-base at) (bit-or 335544320 (bit-and d 67108863))) L)]
                 (recur (+ k 1)))))]
    (let [w3 (pj-ls L pj-k-img (+ base n))] M)))

(defn- pj-c5 [M :vector-i64 L :vector-i64] :vector-i64
  (let [M1 (ly-run (mem-set M (ly-base-slot) (pj-l L pj-k-base)))]
    (if (pj-ok M1) (let [M2 (out-blob M1)] (if (pj-ok M2) (pj-link M2 L) M2)) M1)))
(defn- pj-c4 [M :vector-i64 L :vector-i64 S :string H :vector-i64] :vector-i64
  (let [M1 (ck-run-h M S H)]   ; R6C: with the parameter refinements so far
    (if (pj-ok M1)
      (let [M2 (lw-run M1)] (if (pj-ok M2) (let [M3 (gn-run M2)] (if (pj-ok M3) (pj-c5 M3 L) M3)) M2))
      M1)))
(defn- pj-c3 [M :vector-i64 L :vector-i64 S :string H :vector-i64] :vector-i64
  (let [M1 (nm-run M S)]
    (if (pj-ok M1)
      (let [w (pj-ls L pj-k-stub0 (- (vector-at M1 MM-FN-N) (pj-l L pj-k-nstub)))] (pj-c4 M1 L S H))
      M1)))

;; R6A: an error inside the trailer's copy of the module's own schema text is moved to the original text
(defn- pj-back1 [M :vector-i64 i :i64 c0 :i64 c1 :i64 d :i64] :vector-i64
  (let [v (vector-at M i)] (if (and (>= v c0) (<= v c1) (> d 0)) (vector-assoc! M i (- v d)) M)))
(defn- pj-err-back [M :vector-i64 L :vector-i64 m :i64 n0 :i64] :vector-i64
  (let [cp (pj-l L pj-k-owncpy)
        c0 (+ n0 cp)
        c1 (+ c0 (pj-l L pj-k-ownlen))
        d (- c0 (pj-mf L m pj-mf-sche))]
    (if (or (< cp 0) (< (vector-at M MM-ERR-POS) c0) (> (vector-at M MM-ERR-POS) c1))
      M
      (-> M (pj-back1 MM-ERR-POS c0 c1 d) (pj-back1 MM-ERR-A c0 c1 d) (pj-back1 MM-ERR-B c0 c1 d)))))

;; compile module m (its source text read from its path) and link it into the image. Returns P (a library adds its
;; interface strings). On return M still holds module m (the entry: its EXP table for the container).
(defn- pj-module [M :vector-i64 L :vector-i64 P :string m :i64] :string (pj-module-h M L P m (ck-hint-new)))
;; R6C: H = the parameter refinements so far (21-check ck-hint-*); a check that asks for a new one compiles the module again
(defn- pj-module-h [M :vector-i64 L :vector-i64 P :string m :i64 H :vector-i64] :string
  (let [S0 (io-read-file M (pj-p L P (pj-mf L m pj-mf-path)))
        T (pj-trailer L P m)
        ;; R6B: the source library the module spells. R6C: BEFORE the trailer (was after it): the stub clauses of the trailer
        ;; must be the LAST FN records (pj-c3 takes stub0 = FN-N - nstub), else an importer that also gets a library group
        ;; patched its library functions as stubs (measured: r6-diff driver of kotoba.compiler.decimal-text looped)
        S1 (string-concat S0 (ck-r6b-lib S0))
        S (string-concat S1 T)
        base (bit-and (+ (pj-l L pj-k-img) 7) -8)
        w (-> L (pj-ls pj-k-errmod m) (pj-ls pj-k-trail (string-length S1)) (pj-ls pj-k-base base) (pj-mset m pj-mf-base base))
        M1 (pj-read M S)
        M2 (if (pj-ok M1) (pj-refcheck (pj-qscan (pj-norm M1 L S) L P S m) L P m) M1)
        M3 (if (pj-ok M2) (pj-splice M2 L) M2)
        M4 (if (pj-ok M3) (pj-c3 M3 L S H) M3)]
    (cond (ck-hint-again? H M4) (pj-module-h M4 L P m H)   ; R6C
          (not (pj-ok M4)) (let [w2 (pj-err-back M4 L m (string-length S1))] P)   ; R6C: the trailer starts after the library
          (>= (pj-n L) (- pj-s-cap 1)) (let [w2 (pj-err M4 E-PROJ-IMAGE 0)] P)
          (not (pj-ok (pj-r5b-after M4 L P S m))) P   ; R5B: namespace :capabilities, stateful library exports
          (>= (+ pj-img-base (pj-l L pj-k-img)) pj-l-cap) (let [w2 (pj-err M4 E-PROJ-IMAGE 0)] P)
          (= (pj-mf L m pj-mf-entry) 0) (pj-iface M4 L P S m)
          :else P)))

;; ---- the whole project ---------------------------------------------------------------------------------------------------
;; pj-discover M L P root -> P : the module table and the compile order from the entry (module 0, path P[root])
(defn- pj-discover [M :vector-i64 L :vector-i64 P :string root :i64] :string
  (let [w (-> L (pj-add-mod (pj-n L) root) (pj-mset 0 pj-mf-depth 1) (pj-mset 0 pj-mf-entry 1))
        P1 (pj-visit M L (pj-padd L P "") 0)]
    (if (and (pj-ok M) (> (pj-l L pj-k-nmod) 1) (= (pj-l L pj-k-unpinned) 0))
      (let [w2 (pj-err M E-PROJ-UNPINNED 0)] P1)
      P1)))

;; pj-project M L P root -> P : discover, then compile every module in order. On success M holds the entry module; the image
;; is L[pj-img-base .. + L[pj-k-img]). A multi-module project needs --unpinned.
(defn- pj-project [M :vector-i64 L :vector-i64 P :string root :i64] :string
  (let [P1 (pj-discover M L P root)]
    (loop [k 0 P P1]
      (if (or (>= k (pj-l L pj-k-nord)) (not (pj-ok M)))
        P
        (recur (+ k 1) (pj-module M L P (pj-l L (+ pj-o-base k))))))))

;; the source path of the module the error of M refers to
(defn- pj-err-path [L :vector-i64 P :string] :string (pj-p L P (pj-mf L (pj-l L pj-k-errmod) pj-mf-path)))

;; 1 when a symbol token of S is spelled alias/name
(defn- pj-qualified? [M :vector-i64 S :string] :bool
  (loop [t 1]
    (cond (>= t (vector-at M MM-TOK-N)) false
          (and (= (pj-tf M t TF-KIND) TK-SYM) (>= (pj-slash S (pj-tf M t TF-START) (pj-tf M t TF-END)) 0)) true
          :else (recur (+ t 1)))))

;; 1 when the entry (read into M from S) needs the project route: its ns form has a clause 20-names does not read, or it
;; spells a qualified symbol (refused there by name: E6010 / E6004)
(defn- pj-needed [M :vector-i64 S :string] :i64
  (let [ns (pj-first M (vector-at M MM-ROOT))]
    (cond
      (not (pj-head? M S ns "ns")) 0
      (pj-qualified? M S) 1
      :else
      (loop [c (pj-next M (pj-next M (pj-first M ns)))]
        (cond (= c 0) 0
              (and (= (pj-kind M c) ND-LIST) (= (pj-kind M (pj-first M c)) ND-KW) (pj-is M S (pj-first M c) ":export")) (recur (pj-next M c))
              ;; R4B (agent R4B, coordinated in CONTRACT-REQUESTS): 20-names reads one (:schemas {..}) clause too
              (and (= (pj-kind M c) ND-LIST) (= (pj-kind M (pj-first M c)) ND-KW) (pj-is M S (pj-first M c) ":schemas")) (recur (pj-next M c))
              :else 1)))))

;; ==== separate mode (design 3.3, option C): module objects and `seed link` ================================================
;;   seed compile <file> --emit-module [--entry] --object-dir O --output <x.kso>
;;       compiles ONE module against the interfaces in O/<dep>.kso of its requires (they must exist: emit dependencies
;;       first, `seed modules` prints the order) and writes its object. --entry: it is the project's entry (its exports are
;;       the container's, the root rules apply); otherwise a library.
;;   seed link <root.kso> --object-dir O --output <x>
;;       loads the root object and, depth first, every required object from O (cycle, depth and module bounds as in
;;       discovery), lays the blobs out in post-order at 8-aligned bases, relocates the literal loads (L lines), patches the
;;       stub clauses (S lines) and writes the KSEED1 container with the root's exports (X lines). The image is the one the
;;       in-process route builds (same order, bases and patches).
;; Object (KSEEDO1, ASCII text, one record per line; offsets are relative to the module's blob):
;;   KSEEDO1 / N <ns> / R <required ns> (edge order) / E <clauses> <off>.. <name> <stub template> (interface, libraries) /
;;   S <stub clause offset> <(edge * 4096 + dependency entry) * 8 + clause> / L <movz offset> / X <name> <offset> <arity>
;;   (the entry) / C <hex of up to 64 blob bytes> ..
(defn- pj-eol [T :string i :i64] :i64
  (loop [j i] (cond (>= j (string-length T)) j (= (string-code-point-at T j) 10) j :else (recur (+ j 1)))))
(defn- pj-sp [T :string i :i64] :i64
  (loop [j i] (cond (>= j (string-length T)) j (= (string-code-point-at T j) 10) j (= (string-code-point-at T j) 32) j :else (recur (+ j 1)))))
(defn- pj-dec [T :string a :i64 b :i64] :i64
  (loop [j a v 0] (if (>= j b) v (recur (+ j 1) (+ (* v 10) (- (string-code-point-at T j) 48))))))
(defn- pj-hexv [c :i64] :i64 (if (< c 58) (- c 48) (- c 87)))

(defn- pj-line [k :string a :string] :string (string-concat k (string-concat " " (string-concat a "\n"))))

;; the E line of interface entry e
(defn- pj-eline [L :vector-i64 P :string e :i64] :string
  (let [offs (loop [j 0 acc ""]
               (if (>= j (pj-if L e pj-if-ncl)) acc (recur (+ j 1) (string-concat acc (string-concat (mem-u2dec (pj-if L e (+ pj-if-off0 j))) " ")))))]
    (pj-line "E" (string-concat (mem-u2dec (pj-if L e pj-if-ncl))
                   (string-concat " " (string-concat offs (string-concat (pj-p L P (pj-if L e pj-if-name)) (string-concat " " (string-concat (pj-p L P (pj-if L e pj-if-text)) (pj-p L P (pj-if L e pj-if-sch)))))))))))

;; the hex text of OUT bytes [a, b) (balanced: no list, each byte copied log2(b-a) times)
(defn- pj-hexr [M :vector-i64 a :i64 b :i64] :string
  (cond (>= a b) ""
        (= (+ a 1) b) (io-hex2 (vector-at M (+ MM-OUT-BASE 1 a)))
        :else (let [m (quot (+ a b) 2)] (string-concat (pj-hexr M a m) (pj-hexr M m b)))))

;; the k-th line of section c of module 0's object ("" past the end of the section): 0 R, 1 E, 2 S, 3 L, 4 X, 5 C
(defn- pj-oline [M :vector-i64 L :vector-i64 P :string S :string ck :i64] :string
  (let [c (quot ck 1048576)
        k (bit-and ck 1048575)
        s0 (pj-l L pj-k-stub0)
        fb (+ MM-FIX-BASE (* (+ k 1) MM-FIX-W))
        eb (+ MM-EXP-BASE (* (+ k 1) MM-EXP-W))
        n (- (vector-at M MM-OUT-N) 1)]
    (case c
      0 (pj-line "R" (pj-p L P (pj-rf L (+ (pj-mf L 0 pj-mf-req0) k) pj-rf-name)))
      1 (pj-eline L P (+ (pj-mf L 0 pj-mf-if0) k))
      2 (if (< (pj-ff M (+ s0 k) FF-CODE) 1) ""
          (pj-line "S" (string-concat (mem-u2dec (* (- (pj-ff M (+ s0 k) FF-CODE) 1) 4)) (string-concat " " (mem-u2dec (pj-l L (+ pj-u-base k)))))))
      3 (if (= (vector-at M (+ fb XF-KIND)) FX-LIT32) (pj-line "L" (mem-u2dec (* (- (vector-at M (+ fb XF-AT)) 1) 4))) "")
      4 (let [sym (pj-ff M (vector-at M (+ eb EF-FN)) FF-SYM)]
          (pj-line "X" (string-concat (string-substring S (pj-sf M sym SF-START) (pj-sf M sym SF-END))
                         (string-concat " " (string-concat (mem-u2dec (vector-at M (+ eb EF-OFFSET))) (string-concat " " (mem-u2dec (vector-at M (+ eb EF-ARITY)))))))))
      (pj-line "C" (pj-hexr M (* k 64) (pj-min n (* (+ k 1) 64)))))))

;; the number of lines of section c
(defn- pj-ocount [M :vector-i64 L :vector-i64 c :i64] :i64
  (case c
    0 (pj-mf L 0 pj-mf-nreq)
    1 (pj-mf L 0 pj-mf-nif)
    2 (pj-l L pj-k-nstub)
    3 (- (vector-at M MM-FIX-N) 1)
    4 (- (vector-at M MM-EXP-N) 1)
    (quot (+ (- (vector-at M MM-OUT-N) 1) 63) 64)))

;; the object text of module 0 (compiled with base 0 and recorded patches, still in M; S = its source with the trailer)
(defn- pj-object [M :vector-i64 L :vector-i64 P :string S :string] :string
  (loop [c 0 k 0 big (string-concat "KSEEDO1\n" (pj-line "N" (pj-p L P (pj-mf L 0 pj-mf-name)))) small ""]
    (cond (> c 5) (string-concat big small)
          (>= k (pj-ocount M L c)) (recur (+ c 1) 0 big small)
          :else (let [s2 (pj-small small (pj-oline M L P S (+ (* c 1048576) k)))]
                  (if (> (string-length s2) 4096) (recur c (+ k 1) (string-concat big s2) "") (recur c (+ k 1) big s2))))))

;; the E lines of object text T (module d) as interface entries, offsets + base
(defn- pj-load-iface [L :vector-i64 P :string T :string d :i64 base :i64] :string
  (let [w (-> L (pj-mset d pj-mf-if0 (pj-l L pj-k-nif)) (pj-mset d pj-mf-nif 0))]
    (loop [i 0 P P]
      (if (>= i (string-length T)) P
        (let [e (pj-eol T i)]
          (if (and (= (string-code-point-at T i) 69) (< (pj-l L pj-k-nif) pj-i-cap))
            (let [x (pj-l L pj-k-nif)
                  a1 (+ i 2) b1 (pj-sp T a1)
                  ncl (pj-min (pj-dec T a1 b1) pj-if-maxcl)
                  nb (loop [j 0 p (+ b1 1)] (if (>= j ncl) p (let [q (pj-sp T p) y (pj-iset L x (+ pj-if-off0 j) (+ base (pj-dec T p q)))] (recur (+ j 1) (+ q 1)))))
                  ne (pj-sp T nb)
                  tb (loop [j (pj-min (+ ne 1) e)] (cond (>= j e) e (= (string-code-point-at T j) 9) j :else (recur (+ j 1))))
                  w2 (-> L (pj-iset x pj-if-name (pj-n L)) (pj-iset x pj-if-text (+ (pj-n L) 1)) (pj-iset x pj-if-sch (+ (pj-n L) 2)) (pj-iset x pj-if-ncl ncl)
                         (pj-ls pj-k-nif (+ x 1)) (pj-mset d pj-mf-nif (+ (pj-mf L d pj-mf-nif) 1)))]
              ;; R6A: the template ends at the first TAB; the schema pieces follow it
              (recur (+ e 1) (pj-padd L (pj-padd L (pj-padd L P (string-substring T nb ne)) (string-substring T (pj-min (+ ne 1) e) tb)) (string-substring T tb e))))
            (recur (+ e 1) P)))))))

;; T starts "KSEEDO1\nN " and its N line is nm ("" = any); the N name
(defn- pj-obj-ok [T :string nm :string] :bool
  (and (> (string-length T) 10) (string=? (string-substring T 0 10) "KSEEDO1\nN ")
       (or (= (string-length nm) 0) (string=? (string-substring T 10 (pj-eol T 10)) nm))))

(defn- pj-objpath [L :vector-i64 P :string nm :string] :string
  (string-concat (pj-p L P (pj-l L pj-k-root0)) (string-concat "/" (string-concat nm ".kso"))))

;; emit: module 0 (the file at P[path]) against the objects of its requires; returns P, the object text is the last string
(defn- pj-emit [M :vector-i64 L :vector-i64 P :string path :i64 entry :i64] :string
  (let [w (-> L (pj-add-mod (pj-n L) path) (pj-mset 0 pj-mf-depth 1) (pj-mset 0 pj-mf-entry entry) (pj-ls pj-k-mode 1) (pj-ls pj-k-errmod 0))
        S (io-read-file M (pj-p L P path))
        M1 (pj-read M S)
        P1 (if (pj-ok M1) (pj-header M1 L (pj-padd L P "") S "") (pj-padd L P ""))
        r0 (pj-mf L 0 pj-mf-req0)
        P2 (loop [k 0 P P1]
             (if (or (>= k (pj-mf L 0 pj-mf-nreq)) (not (pj-ok M1))) P
               (let [r (+ r0 k)
                     nm (pj-p L P (pj-rf L r pj-rf-name))
                     op (pj-objpath L P nm)]
                 (if (= (io-exists op) 0)
                   (let [x (pj-err M1 E-PROJ-NOOBJ (pj-rf L r pj-rf-node))] P)
                   (let [T (io-read-file M1 op)
                         d (pj-l L pj-k-nmod)]
                     (if (not (pj-obj-ok T nm))
                       (let [x (pj-err M1 E-PROJ-OBJ (pj-rf L r pj-rf-node))] P)
                       (let [y (-> L (pj-add-mod (pj-n L) (pj-n L)) (pj-mset d pj-mf-state 3) (pj-rset r pj-rf-mod d))]
                         (recur (+ k 1) (pj-load-iface L (pj-padd L P nm) T d 0)))))))))]
    (if (pj-ok M1)
      (let [P3 (pj-module M1 L P2 0)]
        (if (pj-ok M1) (pj-padd L P3 (pj-object M1 L P3 (string-concat S (string-concat (ck-r6b-lib S) (pj-trailer L P3 0))))) P3))   ; R6B, R6C: library before the trailer (pj-module)
      P2)))

;; link: visit object module m (its text read from its path) at depth d
(defn- pj-lvisit [M :vector-i64 L :vector-i64 P :string m :i64] :string
  (let [T (io-read-file M (pj-p L P (pj-mf L m pj-mf-path)))
        nm (string-substring T 10 (pj-eol T 10))
        w (-> L (pj-mset m pj-mf-state 1) (pj-mset m pj-mf-obj (pj-n L)) (pj-mset m pj-mf-req0 (pj-l L pj-k-nreq)) (pj-mset m pj-mf-nreq 0) (pj-ls pj-k-errmod m))
        P1 (pj-padd L P T)
        P2 (if (= (pj-mf L m pj-mf-entry) 1) (let [x (pj-mset L m pj-mf-name (pj-n L))] (pj-padd L P1 nm)) P1)
        d (pj-mf L m pj-mf-depth)
        P3 (loop [i (+ 11 (string-length nm)) P P2]
             (cond (or (>= i (string-length T)) (not (pj-ok M))) P
                   (not= (string-code-point-at T i) 82) (recur (+ (pj-eol T i) 1) P)
                   :else
                   (let [rn (string-substring T (+ i 2) (pj-eol T i))
                         r (pj-l L pj-k-nreq)
                         t (pj-find-mod L P rn)
                         op (pj-objpath L P rn)
                         x (-> L (pj-rset r pj-rf-name (pj-n L)) (pj-ls pj-k-nreq (+ r 1)) (pj-mset m pj-mf-nreq (+ (pj-mf L m pj-mf-nreq) 1)))
                         P4 (pj-padd L P rn)]
                     (cond (>= r pj-r-cap) (let [y (pj-err M E-PROJ-EDGES 0)] P4)
                           (> (+ d 1) pj-max-depth) (let [y (pj-err M E-PROJ-DEPTH 0)] P4)
                           (and (>= t 0) (= (pj-mf L t pj-mf-state) 1)) (let [y (pj-err M E-PROJ-CYCLE 0)] P4)
                           (>= t 0) (let [y (pj-rset L r pj-rf-mod t)] (recur (+ (pj-eol T i) 1) P4))
                           (>= (pj-l L pj-k-nmod) pj-m-cap) (let [y (pj-err M E-PROJ-MODULES 0)] P4)
                           (= (io-exists op) 0) (let [y (pj-err M E-PROJ-NOOBJ 0)] P4)
                           :else (let [k (pj-l L pj-k-nmod)
                                       y (-> L (pj-add-mod (pj-n L) (+ (pj-n L) 1)) (pj-rset r pj-rf-mod k) (pj-mset k pj-mf-depth (+ d 1)))]
                                   (recur (+ (pj-eol T i) 1) (pj-padd L (pj-padd L P4 rn) op)))))))
        r0 (pj-mf L m pj-mf-req0)
        P5 (loop [k 0 P P3]
             (cond (or (>= k (pj-mf L m pj-mf-nreq)) (not (pj-ok M))) P
                   (= (pj-mf L (pj-rf L (+ r0 k) pj-rf-mod) pj-mf-state) 0) (recur (+ k 1) (pj-lvisit M L P (pj-rf L (+ r0 k) pj-rf-mod)))
                   :else (recur (+ k 1) P)))
        no (pj-l L pj-k-nord)]
    (cond (not (pj-ok M)) P5
          (not (pj-obj-ok T (if (= (pj-mf L m pj-mf-entry) 1) "" (pj-p L P (pj-mf L m pj-mf-name))))) (let [y (pj-err M E-PROJ-OBJ 0)] P5)
          :else (let [y (-> L (pj-mset m pj-mf-state 2) (pj-ls (+ pj-o-base no) m) (pj-ls pj-k-nord (+ no 1)))] P5))))

;; the 32-bit word of the image at byte offset at
(defn- pj-get32 [L :vector-i64 at :i64] :i64
  (+ (pj-l L at) (* 256 (pj-l L (+ at 1))) (* 65536 (pj-l L (+ at 2))) (* 16777216 (pj-l L (+ at 3)))))

;; lay out object module m: blob at the next 8-aligned base, interface entries, literal relocations, stub patches
(defn- pj-lplace [M :vector-i64 L :vector-i64 P :string m :i64] :string
  (let [T (pj-p L P (pj-mf L m pj-mf-obj))
        base (bit-and (+ (pj-l L pj-k-img) 7) -8)
        w (pj-mset L m pj-mf-base base)
        n (loop [i 0 at base]
            (if (>= i (string-length T)) (- at base)
              (let [e (pj-eol T i)]
                (if (= (string-code-point-at T i) 67)
                  (recur (+ e 1) (loop [j (+ i 2) at at]
                                   (if (>= (+ j 1) e) at
                                     (let [x (pj-ls L (+ pj-img-base at) (+ (* 16 (pj-hexv (string-code-point-at T j))) (pj-hexv (string-code-point-at T (+ j 1)))))]
                                       (recur (+ j 2) (+ at 1))))))
                  (recur (+ e 1) at)))))
        w1 (pj-ls L pj-k-img (+ base n))
        P1 (pj-load-iface L P T m base)
        r0 (pj-mf L m pj-mf-req0)
        w2 (loop [i 0]
             (if (>= i (string-length T)) 0
               (let [e (pj-eol T i) c (string-code-point-at T i)]
                 (cond (= c 76)
                       (let [at (+ pj-img-base base (pj-dec T (+ i 2) e))
                             w0 (pj-get32 L at) w1 (pj-get32 L (+ at 4))
                             v (+ base (bit-and (u64-shift-right w0 5) 65535) (* 65536 (bit-and (u64-shift-right w1 5) 65535)))
                             x (-> L (pj-put32 at (ly-patch16 w0 v)) (pj-put32 (+ at 4) (ly-patch16 w1 (u64-shift-right v 16))))]
                         (recur (+ e 1)))
                       (= c 83)
                       (let [sp (pj-sp T (+ i 2))
                             at (+ base (pj-dec T (+ i 2) sp))
                             code (pj-dec T (+ sp 1) e)
                             dep (pj-rf L (+ r0 (quot code 32768)) pj-rf-mod)
                             ent (+ (pj-mf L dep pj-mf-if0) (bit-and (quot code 8) 4095))
                             d (quot (- (pj-if L ent (+ pj-if-off0 (bit-and code 7))) at) 4)
                             x (pj-put32 L (+ pj-img-base at) (bit-or 335544320 (bit-and d 67108863)))]
                         (recur (+ e 1)))
                       :else (recur (+ e 1))))))]
    P1))

;; the KSEED1 container of the linked image into OUT (M fresh): the X lines of the entry object m at its base
(defn- pj-lcontainer [M :vector-i64 L :vector-i64 P :string m :i64] :vector-i64
  (let [T (pj-p L P (pj-mf L m pj-mf-obj))
        base (pj-mf L m pj-mf-base)
        nx (loop [i 0 k 0] (if (>= i (string-length T)) k (recur (+ (pj-eol T i) 1) (if (= (string-code-point-at T i) 88) (+ k 1) k))))
        M1 (-> (vector-assoc! M MM-OUT-N 1) (out-put-magic) (out-put-dec (pj-l L pj-k-img)) (out-put 32) (out-put-dec nx) (out-put 10))
        M2 (loop [i 0]
             (if (>= i (string-length T)) M1
               (let [e (pj-eol T i)]
                 (if (= (string-code-point-at T i) 88)
                   (let [s1 (pj-sp T (+ i 2)) s2 (pj-sp T (+ s1 1))
                         x (-> M1 (out-put-span T (+ i 2) s1) (out-put 32) (out-put-dec (+ base (pj-dec T (+ s1 1) s2))) (out-put 32)
                               (out-put-span T (+ s2 1) e) (out-put 10))]
                     (recur (+ e 1)))
                   (recur (+ e 1))))))
        M3 (out-put-vec (out-set-cs (out-put M2 10)) L pj-img-base (+ pj-img-base (pj-l L pj-k-img)))]
    (if (pj-ok M3) (vector-assoc! M3 MM-R0 (- (vector-at M3 MM-OUT-N) 1)) M3)))

;; link the root object at P[path]: returns P; on success the container is in OUT
(defn- pj-link-objects [M :vector-i64 L :vector-i64 P :string path :i64] :string
  (let [w (-> L (pj-add-mod (pj-n L) path) (pj-mset 0 pj-mf-depth 1) (pj-mset 0 pj-mf-entry 1) (pj-ls pj-k-errmod 0))
        T (io-read-file M (pj-p L P path))
        P1 (pj-padd L P "")]
    (if (not (pj-obj-ok T ""))
      (let [x (pj-err M E-PROJ-OBJ 0)] P1)
      (let [P2 (pj-lvisit M L P1 0)
            P3 (loop [k 0 P P2] (if (or (>= k (pj-l L pj-k-nord)) (not (pj-ok M))) P (recur (+ k 1) (pj-lplace M L P (pj-l L (+ pj-o-base k))))))]
        (cond (not (pj-ok M)) P3
              (>= (+ pj-img-base (pj-l L pj-k-img)) pj-l-cap) (let [x (pj-err M E-PROJ-IMAGE 0)] P3)
              :else (let [x (pj-lcontainer M L P3 0)] P3))))))

;; ==== R5B (agent R5B, 2026-10-03): capability declarations and stateful exports =============================================
;; A module's (:capabilities #{..}) clause / {:kotoba/capabilities #{..}} entry is a capability mask (bit w = wire w) kept in
;; its module record (pj-mf-caps, mask + 1; 0 = no declaration: no check, as the reference distinguishes nil from #{}); after the
;; module compiles, every capability its code calls (M[MM-CAPS], 21-check) must be declared (E2176), and the union over the
;; modules (L[pj-k-caps]) is what 90-drv checks against --policy. A library's exported defn must not be stateful (E2150): the
;; trailer exports nothing from a library, so 21-check cannot see it.
(def pj-k-caps 32)
(def pj-mf-caps 14)

(defn- pj-r5b-wire [s :string] :i64
  (cond (string=? s ":hash/sha256") 3 (string=? s ":clock/now") 7 (string=? s ":env/read") 33 (string=? s ":fs/browse") 34
        (string=? s ":fs/app-data") 35 (string=? s ":fs/app-data-bytes") 35 (string=? s ":io/write") 37 (string=? s ":cli/args") 38
        (string=? s ":io/write-error") 39 (string=? s ":io/read") 41 :else -1))
;; the declared set node v of the module being read (L[pj-k-errmod])
(defn- pj-r5b-decl [M :vector-i64 L :vector-i64 S :string v :i64] :vector-i64
  (let [m (pj-l L pj-k-errmod)
        mask (loop [c (pj-first M v) acc 0]
               (if (= c 0)
                 acc
                 (let [w (if (= (pj-kind M c) ND-KW) (pj-r5b-wire (pj-text M S c)) -1)]
                   (recur (pj-next M c) (if (and (>= w 0) (< w 47)) (bit-or acc (i64-shift-left 1 w)) acc)))))]
    (if (or (= (pj-kind M v) ND-SET) (= (pj-kind M v) ND-VEC))
      (let [w (pj-mset L m pj-mf-caps (+ mask 1))] M)
      (pj-err M E-PROJ-NSFORM v))))

;; token t is the symbol right after `(with`
(defn- pj-r5b-with? [M :vector-i64 S :string t :i64] :bool
  (and (> t 2) (= (pj-tf M (- t 1) TF-KIND) TK-SYM) (= (pj-tf M (- t 2) TF-KIND) TK-LPAREN)
       (string=? (string-substring S (pj-tf M (- t 1) TF-START) (pj-tf M (- t 1) TF-END)) "with")))

(defn- pj-r5b-tmpl? [M :vector-i64 f :i64] :bool
  (= (bit-and (vector-at M (+ (vector-at M MM-FN2) (* f FN2-W) FN2-FLAGS)) 1) 1))
(defn- pj-r5b-err-sym [M :vector-i64 code :i64 f :i64] :vector-i64
  (let [sy (pj-ff M f FF-SYM)] (pj-err-span M code (pj-sf M sy SF-START) (pj-sf M sy SF-START) (pj-sf M sy SF-END))))

;; after module m compiled (M holds it): the checks above; M (with MM-ERR set on a refusal)
(defn- pj-r5b-after [M :vector-i64 L :vector-i64 P :string S :string m :i64] :vector-i64
  (let [used (vector-at M MM-CAPS)
        d (pj-mf L m pj-mf-caps)
        extra (if (> d 0) (bit-and used (bit-not (- d 1))) 0)
        w (pj-ls L pj-k-caps (bit-or (pj-l L pj-k-caps) used))
        bad (cond (= (pj-mf L m pj-mf-entry) 1) 0
                  (> (pj-mf L m pj-mf-expk) 0)
                  (loop [k 0]
                    (if (>= k (pj-mf L m pj-mf-nexp)) 0
                      (let [f (pj-fn-named M S (pj-p L P (pj-l L (+ pj-x-base (pj-mf L m pj-mf-exp0) k))))]
                        (if (and (> f 0) (pj-r5b-tmpl? M f)) f (recur (+ k 1))))))
                  :else (loop [f 1]
                          (cond (>= f (vector-at M MM-FN-N)) 0
                                (and (= (pj-ff M f FF-KIND) FK-DEFN) (pj-r5b-tmpl? M f)) f
                                :else (recur (+ f 1)))))]
    (cond (> bad 0) (pj-r5b-err-sym M E-STATE-EXPORT bad)
          (not= extra 0) (-> (pj-err-span M E-CAP-UNDECLARED -1 0 0) (vector-assoc! MM-ERR-N extra))
          :else M)))
