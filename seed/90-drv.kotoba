;; ---- diagnostics ---------------------------------------------------------------------------------------------------
(defn- drv-tyname [t :i64] :string
  (cond (= t 1) ":i64" (= t 2) ":bool" (= t 3) ":string" (= t 4) ":vector-i64" (= t 5) ":bytes" (= t 6) ":keyword" (= t 8) ":document" (= t 9) ":symbol" (= t 10) ":f64" (= t TY-F32) ":f32"   ; R6B, R6C, R6K
        :else "?"))

(defn- drv-slice [path :string a :i64 b :i64] :string
  (if (> b a) (io-slice path a (- b a)) ""))

;; the text of placeholder kind k
(defn- drv-ph [k :i64 path :string a :i64 b :i64 n :i64] :string
  (cond (= k 1) (drv-slice path a b)
        (= k 2) (mem-u2dec n)
        (= k 3) (drv-tyname n)
        :else ""))

(defn- drv-at [pos :i64] :string
  (if (< pos 0) "" (string-concat " (byte " (string-concat (mem-u2dec pos) ")"))))

(defn- drv-say [c :i64 msg :string pos :i64] :i64 (drv-say-in c msg pos ""))
;; R6K (FOLD, MAINS's request): sfx follows the byte position (" in <module path>" for an error in a dependency module)
(defn- drv-say-in [c :i64 msg :string pos :i64 sfx :string] :i64
  (let [w (io-err (string-concat "seed: E" (string-concat (mem-u2dec c) (string-concat " " (string-concat msg (string-concat (drv-at pos) (string-concat sfx "\n")))))))]
    1))

;; report the error recorded in M; the source path is where {name} spans are sliced from. Status 1.
(defn- drv-fail [M :vector-i64 path :string] :i64 (drv-fail-in M path ""))
(defn- drv-fail-in [M :vector-i64 path :string sfx :string] :i64
  (let [c (vector-at M MM-ERR)
        pos (vector-at M MM-ERR-POS)
        a (vector-at M MM-ERR-A)
        b (vector-at M MM-ERR-B)
        n (vector-at M MM-ERR-N)
        p0 (drv-ph (drv-ek0 c) path a b n)
        p1 (drv-ph (drv-ek1 c) path a b n)]
    (if (pos? (string-length (drv-r5b-text c)))
      (drv-say-in c (drv-r5b-fill M path (drv-r5b-text c) "") pos sfx)   ; R5B: a template text
    (drv-say-in c (string-concat (drv-et0 c) (string-concat p0 (string-concat (drv-et1 c) (string-concat p1 (drv-et2 c))))) pos sfx))))

;; an error found by the driver itself (no M yet)
(defn- drv-fail0 [c :i64] :i64 (drv-say c (drv-et0 c) -1))

;; ---- the pipeline ------------------------------------------------------------------------------------------------
;; mode: 0 = check (stop after 21-check), 1 = compile with the container as hex on stdout
(defn- drv-emit [M :vector-i64] :i64
  (let [n (- (vector-at M MM-OUT-N) 1)
        w (io-write-hex M (+ MM-OUT-BASE 1) n)]
    0))

(defn- drv-cok [out :string n :i64] :i64
  (let [w (io-out (string-concat "{:ok true, :target :aarch64-macos, :output \"" (string-concat out (string-concat "\", :bytes " (string-concat (mem-u2dec n) "}\n")))))]
    0))

;; the container as raw bytes into the file out
(defn- drv-emit-file [M :vector-i64 out :string] :i64
  (let [n (- (vector-at M MM-OUT-N) 1)
        w (io-write-bytes M out (+ MM-OUT-BASE 1) n)]
    (cond (= (io-exists out) 0) (drv-fail0 E-WRITE)
          (= (vector-at M MM-QUIET) 1) 0   ; R6L: drv-compile-file
          :else (drv-cok out n))))

;; out = "" -> hex on stdout, else the file out
(defn- drv-emit2 [M :vector-i64 out :string] :i64
  (if (= (string-length out) 0) (drv-emit M) (drv-emit-file M out)))

(defn- drv-wasm-ack [out :string n :i64] :i64
  (let [w (io-out (string-concat "{:ok true, :target :wasm32-browser, :output \""
                                  (string-concat out (string-concat "\", :bytes "
                                    (string-concat (mem-u2dec n) "}\n")))))]
    0))

(defn- drv-wasm-emit [M :vector-i64 S :string path :string out :string] :i64
  (let [M1 (w32-run M S)
        g (if (= (vector-at M1 MM-ERR) 0)
            (drv-r5b-gate M1 path (vector-at M1 MM-CAPS)) -1)
        n (- (vector-at M1 MM-OUT-N) 1)]
    (cond (> (vector-at M1 MM-ERR) 0) (drv-fail M1 path)
          (>= g 0) g
          (= (string-length out) 0) (let [w (io-write-hex M1 (+ MM-OUT-BASE 1) n)] 0)
          :else (let [w (io-write-bytes M1 out (+ MM-OUT-BASE 1) n)]
                  (if (= (io-exists out) 0) (drv-fail0 E-WRITE) (drv-wasm-ack out n))))))

(defn- drv-c8 [M :vector-i64 path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0)
    (let [g (drv-r5b-gate M path (vector-at M MM-CAPS))] (if (< g 0) (drv-emit2 M out) g))   ; R5B: --policy
    (drv-fail M path)))
(defn- drv-c7 [M :vector-i64 S :string path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-c8 (out-build M S) path out) (drv-fail M path)))
(defn- drv-c6 [M :vector-i64 S :string path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-c7 (ly-run M) S path out) (drv-fail M path)))
(defn- drv-c5 [M :vector-i64 S :string path :string mode :i64 out :string] :i64
  (if (> (vector-at M MM-ERR) 0) (drv-fail M path)
    (if (= mode 2) (drv-wasm-emit M S path out)
      (drv-c6 (gn-run M) S path out))))
(defn- drv-ok [M :vector-i64] :i64
  (let [w (io-out "ok\n")] 0))
(defn- drv-c4 [M :vector-i64 S :string path :string mode :i64 out :string] :i64
  (cond (> (vector-at M MM-ERR) 0) (drv-fail M path)
        (= mode 0) (let [g (drv-r5b-gate M path (vector-at M MM-CAPS))] (if (< g 0) (drv-ok M) g))
        :else (drv-c5 (lw-run M) S path mode out)))
(defn- drv-c3 [M :vector-i64 S :string path :string mode :i64 out :string] :i64 (drv-c3h M S path mode out (ck-hint-new)))
;; R6C: a check that asks for a parameter refinement (21-check ck-hint-*) re-runs from the read with it
(defn- drv-c3h [M :vector-i64 S :string path :string mode :i64 out :string H :vector-i64] :i64
  (if (= (vector-at M MM-ERR) 0)
    (let [M1 (ck-run-h M S H)]
      (if (ck-hint-again? H M1)
        (drv-c3h (drv-reread M1 S) S path mode out H)
        (drv-c4 M1 S path mode out)))
    (drv-fail M path)))
(defn- drv-reread [M :vector-i64 S :string] :vector-i64
  (let [M1 (pj-read M S)] (if (= (vector-at M1 MM-ERR) 0) (nm-run M1 S) M1)))
(defn- drv-c2 [M :vector-i64 S :string path :string mode :i64 out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-c3 (nm-run M S) S path mode out) (drv-fail M path)))
(defn- drv-c1 [M :vector-i64 S :string path :string mode :i64 out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-c2 (rd-run M S) S path mode out) (drv-fail M path)))
(defn- drv-c0 [S :string path :string mode :i64 out :string] :i64
  (drv-c1 (lx-run (mem-set (mem-new) MM-SRC-LEN (string-length S)) S) S path mode out))

(defn- drv-read [path :string] :string (typed-cap-call :fs/app-data :string :string path))

;; ==== BEGIN R5A project route (owner: agent R5A; module seed/60-proj.kotoba) =========================================
;;   compile <entry> [--source-path D ..] [--unpinned] [--policy P] --output X
;; The entry is lexed and read once; it goes the project route (60-proj: discovery, per-module compile against the
;; dependencies' interfaces, image link) when a --source-path is given or its ns form has a clause 20-names does not read
;; (:require, an attr-map, a docstring); otherwise the single-module pipeline from 20-names on (drv-c2), unchanged.
;; --policy is accepted and not yet checked (part B: capabilities). check runs the same route and prints ok.
(defn- drv-pj-has [i :i64 n :i64 s :string] :i64
  (cond (>= i n) 0 (string=? (io-arg i) s) 1 :else (drv-pj-has (+ i 1) n s)))

;; the --source-path values as roots of L (P indexes), up to 16
(defn- drv-pj-roots [L :vector-i64 P :string i :i64 n :i64] :string
  (cond (>= (+ i 1) n) P
        (and (string=? (io-arg i) "--source-path") (< (vector-at L pj-k-nroot) 16))
        (let [k (vector-at L pj-k-nroot)
              w (-> L (vector-assoc! (+ pj-k-root0 k) (pj-n L)) (vector-assoc! pj-k-nroot (+ k 1)))]
          (drv-pj-roots L (pj-padd L P (io-arg (+ i 1))) (+ i 2) n))
        :else (drv-pj-roots L P (+ i 1) n)))

;; an error of the project route: {name} spans and positions beyond the module's file (its generated trailer) are dropped
;; R6K (FOLD, MAINS's request): an error in a module other than the entry (L[pj-k-errmod] > 0) names that module's path
(defn- drv-pj-fail [M :vector-i64 L :vector-i64 P :string] :i64
  (let [path (pj-err-path L P)
        stat (typed-cap-call :fs/app-data :string :string (string-concat path (io-sep "NOFOLLOW")))
        flen (pj-max 0 (pj-stat-size stat))
        b (vector-at M MM-ERR-B)
        w (if (> b flen) (-> M (vector-assoc! MM-ERR-A 0) (vector-assoc! MM-ERR-B 0)) M)
        w2 (if (> (vector-at M MM-ERR-POS) flen) (vector-assoc! M MM-ERR-POS -1) M)]
    (drv-fail-in M path (if (> (vector-at L pj-k-errmod) 0) (string-concat " in " path) ""))))

(defn- drv-pj-emit [M :vector-i64 L :vector-i64 P :string mode :i64 out :string] :i64
  (let [S (string-concat (pj-src M L P 0) (pj-trailer L P 0))
        M1 (if (or (> (vector-at M MM-ERR) 0) (= mode 0)) M (out-image M S L pj-img-base (vector-at L pj-k-img)))]
    (cond (> (vector-at M1 MM-ERR) 0) (drv-pj-fail M1 L P)
          (= mode 0) (let [g (drv-r5b-gate M1 (pj-p L P (pj-mf L 0 pj-mf-path)) (vector-at L pj-k-caps))] (if (< g 0) (drv-ok M1) g))
          ;; R5B: --policy against the capabilities of every module of the project
          :else (let [g (drv-r5b-gate M1 (pj-p L P (pj-mf L 0 pj-mf-path)) (vector-at L pj-k-caps))] (if (< g 0) (drv-emit2 M1 out) g)))))

;; The selfhost lock reader consumes the owner's closed EDN format and stores
;; only namespace/CID string indexes. It never evaluates lock data as code.
(defn- drv-lock-raw [M :vector-i64 S :string node :i64] :string
  (let [tok (nm-nf M node NF-TOK)
        start (nm-tf M tok TF-START)
        end (nm-tf M tok TF-END)]
    (string-substring S start end)))

(defn- drv-lock-plain? [value :string] :bool
  (loop [i 0]
    (if (>= i (string-length value)) true
      (let [c (string-code-point-at value i)]
        (if (or (= c 34) (= c 92)) false (recur (+ i 1)))))))

(defn- drv-lock-string [M :vector-i64 S :string node :i64] :string
  (if (= (nm-kind M node) ND-STR)
    (let [raw (drv-lock-raw M S node)
          n (string-length raw)]
      (if (and (>= n 2) (= (string-code-point-at raw 0) 34) (= (string-code-point-at raw (- n 1)) 34))
        (let [value (string-substring raw 1 (- n 1))]
          (if (drv-lock-plain? value) value ""))
        ""))
    ""))

(defn- drv-lock-name [M :vector-i64 S :string node :i64] :string
  (cond (= (nm-kind M node) ND-SYM) (drv-lock-raw M S node)
        (= (nm-kind M node) ND-STR) (drv-lock-string M S node)
        :else ""))

(defn- drv-lock-name-ok? [name :string] :bool
  (and (> (string-length name) 0) (<= (string-length name) 255)
       (loop [i 0]
         (if (>= i (string-length name)) true
           (let [c (string-code-point-at name i)]
             (if (or (< c 33) (> c 126) (= c 47) (= c 92)) false (recur (+ i 1))))))))

(defn- drv-lock-cid? [cid :string] :bool
  (and (= (string-length cid) 59) (string=? (string-substring cid 0 7) "bafkrei")
       (loop [i 7]
         (if (>= i (string-length cid)) true
           (let [c (string-code-point-at cid i)]
             (if (or (and (>= c 97) (<= c 122)) (and (>= c 50) (<= c 55)))
               (recur (+ i 1)) false))))))

(defn- drv-lock-key? [M :vector-i64 S :string node :i64 name :string] :bool
  (and (= (nm-kind M node) ND-KW) (string=? (drv-lock-raw M S node) name)))

(defn- drv-lock-get [M :vector-i64 S :string map :i64 name :string] :i64
  (loop [key (nm-first M map) result 0]
    (if (= key 0) result
      (let [value (nm-next M key)
            next-key (if (= value 0) 0 (nm-next M value))]
        (if (= value 0) result
          (recur next-key (if (drv-lock-key? M S key name) value result)))))))

(defn- drv-lock-top-keys? [M :vector-i64 S :string map :i64] :bool
  (loop [key (nm-first M map)]
    (if (= key 0) true
      (let [value (nm-next M key)]
        (if (or (= value 0)
                (not (or (drv-lock-key? M S key ":schema")
                         (drv-lock-key? M S key ":root")
                         (drv-lock-key? M S key ":modules"))))
          false (recur (nm-next M value)))))))

(defn- drv-lock-shape? [M :vector-i64 S :string map :i64 root :i64] :bool
  (let [schema (drv-lock-get M S map ":schema")
        modules (drv-lock-get M S map ":modules")
        name (drv-lock-name M S root)]
    (and (= (nm-kind M map) ND-MAP)
         (= (bit-and (nm-count M map) 1) 0)
         (drv-lock-top-keys? M S map)
         (drv-lock-key? M S schema ":kotoba.module-lock/v1")
         (drv-lock-name-ok? name)
         (= (nm-kind M modules) ND-MAP)
         (> (nm-count M modules) 0) (= (bit-and (nm-count M modules) 1) 0)
         (<= (nm-count M modules) (* pj-lock-cap 2)))))

;; Append namespace/CID strings to P and install/update the bounded lock table in L.
(defn- drv-lock-fill [M :vector-i64 S :string L :vector-i64 P :string modules :i64] :string
  (loop [key (nm-first M modules) P P]
    (if (or (= key 0) (< (pj-l L pj-k-lock-count) 0)) P
      (let [value (nm-next M key)
            name (drv-lock-name M S key)
            cid (drv-lock-string M S value)]
        (if (or (= value 0) (not (drv-lock-name-ok? name)) (not (drv-lock-cid? cid)))
          (let [w (pj-ls L pj-k-lock-count -1)] P)
          (let [name-index (pj-n L)
                P1 (pj-padd L P name)
                cid-index (pj-n L)
                P2 (pj-padd L P1 cid)]
            (if (> (pj-l L pj-k-strover) 0)
              (let [w (pj-ls L pj-k-lock-count -1)] P2)
              (let [found (pj-lock-find L P2 name)]
                (if (>= found 0)
                  (let [w (vector-assoc! L (+ (pj-lock-entry L found) 1) cid-index)]
                    (recur (nm-next M value) P2))
                  (if (>= (pj-l L pj-k-lock-count) pj-lock-cap)
                    (let [w (pj-ls L pj-k-lock-count -1)] P2)
                    (let [w (pj-lock-put L name-index cid-index)]
                      (recur (nm-next M value) P2))))))))))))

(defn- drv-lock-flag [i :i64 n :i64 name :string] :i64
  (cond (>= (+ i 1) n) -1
        (string=? (io-arg i) name) (+ i 1)
        (= (drv-flagv (io-arg i)) 1) (drv-lock-flag (+ i 2) n name)
        :else (drv-lock-flag (+ i 1) n name)))

(defn- drv-pj-compile-locked [root-name :string mode :i64 out :string] :i64
  (let [n (io-argc)
        lock-index (drv-lock-flag 1 n "--module-lock")
        blocks-index (drv-lock-flag 1 n "--blocks")
        lock-path (if (< lock-index 0) "" (io-arg lock-index))
        blocks-path (if (< blocks-index 0) "" (io-arg blocks-index))
        lock-before (if (= (string-length lock-path) 0) "" (drv-pol-stat lock-path))
        lock-text (if (and (>= lock-index 0) (>= blocks-index 0)
                           (= (drv-pj-has 1 n "--source-path") 0)
                           (= (drv-pj-has 1 n "--unpinned") 0)
                           (= (io-exists lock-path) 1))
                    (drv-pol-read-sized lock-path lock-before) "")
        R0 (mem-set (mem-new) MM-SRC-LEN (string-length lock-text))
        R1 (lx-run R0 lock-text)
        R2 (if (= (vector-at R1 MM-ERR) 0) (rd-run R1 lock-text) R1)
        forms (nm-count R2 (vector-at R2 MM-ROOT))
        map (if (= (vector-at R2 MM-ERR) 0) (nm-first R2 (vector-at R2 MM-ROOT)) 0)
        root (if (= forms 1) (drv-lock-get R2 lock-text map ":root") 0)
        modules (if (= forms 1) (drv-lock-get R2 lock-text map ":modules") 0)
        parsed (and (= (vector-at R2 MM-ERR) 0) (= forms 1) (drv-lock-shape? R2 lock-text map root))
        L (pj-new-l)
        P0 (pj-new-p L)
        P1 (if parsed (drv-lock-fill R2 lock-text L P0 modules) P0)
        lock-root (drv-lock-name R2 lock-text root)
        root-index (pj-n L)
        P2 (pj-padd L P1 lock-root)
        blocks-index-p (pj-n L)
        P3 (pj-padd L P2 blocks-path)
        root-entry (if parsed (pj-lock-find L P3 root-name) -1)
        L1 (-> L (pj-ls pj-k-locked 1) (pj-ls pj-k-lock-root root-index)
               (pj-ls pj-k-blocks blocks-index-p))
        M0 (mem-set (mem-new) MM-QUIET (if (= mode 3) 1 0))]
    (if (or (not parsed) (< (pj-l L pj-k-lock-count) 1)
            (not (drv-lock-name-ok? lock-root))
            (not (string=? lock-root root-name))
            (< root-entry 0)
            (> (pj-l L pj-k-strover) 0)
            (= (string-length blocks-path) 0) (= (io-exists blocks-path) 0)
            (= (drv-pj-has 1 n "--source-path") 1)
            (= (drv-pj-has 1 n "--unpinned") 1))
      (drv-fail0 6027)
      (if (= mode 2)
        (let [L2 (pj-ls L1 pj-k-mode 2)
              P4 (pj-discover M0 L2 P3 root-index)]
          (if (> (vector-at M0 MM-ERR) 0)
            (drv-pj-fail M0 L2 P4)
            (drv-pj-wasm M0 L2 P4 (pj-p L2 P4 (pj-mf L2 0 pj-mf-path)) out)))
        (let [P4 (pj-project M0 L1 P3 root-index)]
          (if (> (vector-at M0 MM-ERR) 0)
            (drv-pj-fail M0 L1 P4)
            (drv-pj-emit M0 L1 P4 mode out)))))))

(defn- drv-pj-compile [M :vector-i64 path :string mode :i64 out :string] :i64
  (let [L (pj-new-l)
        n (io-argc)
        P0 (drv-pj-roots L (pj-new-p L) 1 n)
        w (vector-assoc! L pj-k-unpinned (drv-pj-has 1 n "--unpinned"))
        Ppath (pj-padd L P0 path)
        root (- (pj-n L) 1)]
    (if (= mode 2)
      (let [P1 (pj-discover M L Ppath root)]
        (if (> (vector-at M MM-ERR) 0)
          (drv-pj-fail M L P1)
          (drv-pj-wasm M L P1 path out)))
      (let [P1 (pj-project M L Ppath root)]
        (if (> (vector-at M MM-ERR) 0)
          (drv-pj-fail M L P1)
          (drv-pj-emit M L P1 mode out))))))

;; Single-module projects keep the direct Wasm artifact format. Multi-module projects compile one Wasm module
;; per Kotoba module and write a KOTOBAP1 bundle; dependency stubs become namespace-qualified Wasm imports.
(defn- drv-pj-wasm [M :vector-i64 L :vector-i64 P :string path :string out :string] :i64
  (let [L (pj-ls L pj-k-mode 2)]
  (if (> (pj-l L pj-k-nmod) 1)
    (drv-pj-wasm-project M L P out)
  (let [S0 (pj-src M L P 0)
        lib (ck-r6b-lib-t S0 (pj-kw-table M L P 0 S0))
        S1 (string-concat S0 lib)
        T (pj-trailer L P 0)
        S (string-concat S1 T)
        w (pj-ls L pj-k-trail (string-length S1))
        M1 (if (= (vector-at M MM-ERR) 0) (pj-read M S) M)
        M2 (if (= (vector-at M1 MM-ERR) 0) (pj-norm M1 L S) M1)
        M3 (if (= (vector-at M2 MM-ERR) 0) (pj-splice M2 L) M2)
        M4 (if (= (vector-at M3 MM-ERR) 0) (pj-qscan M3 L P S 0) M3)
        M5 (if (= (vector-at M4 MM-ERR) 0) (pj-refcheck M4 L P 0) M4)
        M6 (if (= (vector-at M5 MM-ERR) 0) (nm-run M5 S) M5)]
    (if (> (vector-at M6 MM-ERR) 0)
      (drv-pj-fail M6 L P)
      (drv-c3 M6 S path 2 out))))))

(defn- drv-pj-wasm-package-module [M :vector-i64 L :vector-i64 P :string m :i64 i :i64] :vector-i64
  (let [n (pj-mf L m pj-mf-wasm-len)
        off (pj-mf L m pj-mf-wasm-off)]
    (if (>= i n) M
      (drv-pj-wasm-package-module (out-put M (pj-ib L (+ off i))) L P m (+ i 1)))))

(defn- drv-pj-wasm-package-modules [M :vector-i64 L :vector-i64 P :string k :i64] :vector-i64
  (if (>= k (pj-l L pj-k-nord)) M
    (let [m (pj-l L (+ pj-o-base k))
          ns (pj-p L P (pj-mf L m pj-mf-name))
          M1 (out-put-word M (string-length ns))
          M2 (loop [i 0 M M1]
               (if (>= i (string-length ns)) M
                 (recur (+ i 1) (out-put M (string-code-point-at ns i)))))
          M3 (out-put-word M2 (pj-mf L m pj-mf-wasm-len))
          M4 (drv-pj-wasm-package-module M3 L P m 0)]
      (drv-pj-wasm-package-modules M4 L P (+ k 1)))))

(defn- drv-pj-wasm-package [M :vector-i64 L :vector-i64 P :string] :vector-i64
  (let [M0 (out-w M MM-OUT-N 1)
        M1 (loop [i 0 M M0]
             (if (>= i 8) M
               (recur (+ i 1) (out-put M (string-code-point-at "KOTOBAP1" i)))))
        M2 (out-put-word M1 (pj-l L pj-k-nord))]
    (drv-pj-wasm-package-modules M2 L P 0)))

(defn- drv-pj-wasm-project [M :vector-i64 L :vector-i64 P :string out :string] :i64
  (let [w (pj-ls L pj-k-mode 2)
        P1 (pj-project-wasm M L P)]
    (cond (> (vector-at M MM-ERR) 0) (drv-pj-fail M L P1)
          (= (string-length out) 0) (drv-usage)
          :else (let [M1 (drv-pj-wasm-package M L P1)
                      n (- (vector-at M1 MM-OUT-N) 1)
                      w2 (if (= (vector-at M1 MM-ERR) 0) (io-write-bytes M1 out (+ MM-OUT-BASE 1) n) 0)]
                  (cond (> (vector-at M1 MM-ERR) 0) (drv-fail0 (vector-at M1 MM-ERR))
                        (= (io-exists out) 0) (drv-fail0 E-WRITE)
                        :else (let [x (io-out (string-concat "{:ok true, :target :wasm32-browser, :format :kotoba.wasm-project/v1, :output \""
                                      (string-concat out (string-concat "\", :modules "
                                        (string-concat (mem-u2dec (pj-l L pj-k-nord)) (string-concat ", :bytes "
                                          (string-concat (mem-u2dec n) "}\n")))))))] 0))))))

;; argv index of the value after the flag spelled s, -1 when absent
(defn- drv-pj-flag [i :i64 n :i64 s :string] :i64
  (cond (>= (+ i 1) n) -1 (string=? (io-arg i) s) (+ i 1) :else (drv-pj-flag (+ i 1) n s)))

(defn- drv-pj-objdir [L :vector-i64 n :i64] :string
  (let [o (drv-pj-flag 1 n "--object-dir")
        w (-> L (vector-assoc! pj-k-root0 0) (vector-assoc! pj-k-nroot 1))]
    (pj-padd L (pj-new-p L) (if (< o 0) "." (io-arg o)))))

;; compile <file> --emit-module [--entry] --object-dir O --output X: the module object (60-proj separate mode)
(defn- drv-pj-emitmod [M :vector-i64 path :string out :string] :i64
  (let [L (pj-new-l)
        n (io-argc)
        P0 (drv-pj-objdir L n)
        P1 (pj-emit M L (pj-padd L P0 path) (- (pj-n L) 1) (drv-pj-has 1 n "--entry"))]
    (cond (> (vector-at M MM-ERR) 0) (drv-pj-fail M L P1)
          (= (string-length out) 0) (drv-usage)
          :else (let [t (pj-p L P1 (- (pj-n L) 1))
                      w (io-write-text out t)]
                  (if (= (io-exists out) 1) (drv-cok out (string-length t)) (drv-fail0 E-WRITE))))))

;; link <root.kso> --object-dir O --output X
(defn- drv-pj-link [n :i64] :i64
  (let [k (drv-pos 1 n 0)
        o (drv-flag 1 n -5168643622338417694)
        M (mem-new)
        L (pj-new-l)
        P0 (drv-pj-objdir L n)]
    (cond (< k 0) (drv-usage)
          (< o 0) (drv-usage)
          (= (io-exists (io-arg k)) 0) (drv-fail0 E-READ)
          :else (let [P1 (pj-link-objects M L (pj-padd L P0 (io-arg k)) (- (pj-n L) 1))]
                  (if (> (vector-at M MM-ERR) 0)
                    (drv-pj-fail M L P1)
                    (drv-pj-lemit M L (drv-kir-out o)))))))

;; LINK (r6h): the linked container = the header in OUT + the image in L (60-proj pj-lwrite); out "" -> hex on stdout
(defn- drv-pj-lemit [M :vector-i64 L :vector-i64 out :string] :i64
  (let [n (pj-lwrite M L out)]
    (cond (= (string-length out) 0) 0
          (= (io-exists out) 1) (drv-cok out n)
          :else (drv-fail0 E-WRITE))))

;; modules <entry> --source-path D .. : the compile order, one "<ns> <path>" line per module (dependencies first)
(defn- drv-pj-modules [n :i64] :i64
  (let [k (drv-pos 1 n 0)
        M (mem-new)
        L (pj-new-l)
        P0 (drv-pj-roots L (pj-new-p L) 1 n)
        w (vector-assoc! L pj-k-unpinned 1)]
    (if (< k 0)
      (drv-usage)
      (let [P1 (pj-discover M L (pj-padd L P0 (io-arg k)) (- (pj-n L) 1))]
        (if (> (vector-at M MM-ERR) 0)
          (drv-pj-fail M L P1)
          (loop [i 0]
            (if (>= i (vector-at L pj-k-nord))
              0
              (let [m (vector-at L (+ pj-o-base i))
                    x (io-out (string-concat (pj-p L P1 (pj-mf L m pj-mf-name)) (string-concat " " (string-concat (pj-p L P1 (pj-mf L m pj-mf-path)) "\n"))))]
                (recur (+ i 1))))))))))

(defn- drv-pj-run [S :string path :string mode :i64 out :string] :i64
  (let [M (lx-run (mem-set (mem-set (mem-new) MM-QUIET (if (= mode 3) 1 0)) MM-SRC-LEN (string-length S)) S)   ; R6L: mode 3 = 1, quiet
        M1 (if (= (vector-at M MM-ERR) 0) (rd-run M S) M)]
    (if (and (= mode 2) (= (drv-pj-has 1 (io-argc) "--emit-module") 1))
      (drv-fail0 E-WASM-UNSUPPORTED)
    (if (= (drv-pj-has 1 (io-argc) "--emit-module") 1)
      (drv-pj-emitmod M1 path out)
    (if (and (= (vector-at M1 MM-ERR) 0) (or (= (drv-pj-has 1 (io-argc) "--source-path") 1) (= (pj-needed M1 S) 1)))
      (drv-pj-compile M1 path mode out)
      (drv-c2 M1 S path mode out))))))
;; ==== END R5A project route ===========================================================================================

(defn- drv-run [path :string mode :i64 out :string] :i64
  (if (= (drv-pj-has 1 (io-argc) "--module-lock") 1)
    (drv-pj-compile-locked path mode out)
    (if (= (io-exists path) 1) (let [S0 (drv-read path)] (drv-pj-run (string-concat S0 (ck-r6b-lib S0)) path mode out)) (drv-fail0 E-READ))))   ; R6B: + the source library
;; R6L (FOLD, CMD request): compile src into the kseed file out with the flags of argv (--policy, --source-path ..), status 0 /
;; 1 (refusal printed) / 2, WITHOUT the ok line; seed.main of the split exports it (gen-split.py) for amu's compile command.
(defn- drv-compile-file [src :string out :string] :i64 (drv-run src 3 out))

(defn- drv-usage [] :i64
  (let [r (drv-fail0 E-USAGE)] 2))

;; compile: <out> "-" or the word hex -> hex on stdout; any other <out> -> that file (see the header)
(defn- drv-compile2 [src :i64 out :i64 hex :i64 mode :i64] :i64
  (cond (< src 0) (drv-usage)
        (= hex 1) (drv-run (io-arg src) mode "")
        (< out 0) (drv-usage)
        (= (drv-dash (io-arg out)) 1) (drv-run (io-arg src) mode "")
        :else (drv-run (io-arg src) mode (io-arg out))))

;; 1 = aarch64-macos (default), 2 = the scalar wasm32-browser pilot, 0 = refused
(defn- drv-target-mode [t :i64] :i64
  (cond (< t 0) 1
        (string=? (io-arg t) "aarch64-macos") 1
        (string=? (io-arg t) "wasm32-browser") 2
        :else 0))

(defn- drv-compile [n :i64] :i64
  (let [o (drv-flag 1 n -5168643622338417694)
        t (drv-flag 1 n 4838156518066596434)
        mode (drv-target-mode t)]
    (cond (= mode 0) (drv-fail0 E-TARGET)
          (>= o 0) (drv-compile2 (drv-pos 1 n 0) o (drv-hexflag 1 n) mode)
          :else (drv-compile2 (drv-pos 1 n 0) (drv-pos 1 n 1) (drv-hexflag 1 n) mode))))

(defn- drv-check [n :i64] :i64
  (let [s (drv-pos 1 n 0)]
    (if (< s 0) (drv-usage) (drv-run (io-arg s) 0 ""))))

;; ---- extract-native ----------------------------------------------------------------------------------------------
(defn- drv-xok [out :string oa :i64 cl :i64] :i64
  (let [off (quot oa 4294967296)
        ar (- oa (* off 4294967296))
        w (io-out (string-concat "{:ok true, :output \"" (string-concat out (string-concat "\", :offset " (string-concat (mem-u2dec off)
                  (string-concat ", :length " (string-concat (mem-u2dec cl) (string-concat ", :arity " (string-concat (mem-u2dec ar) "}\n")))))))))]
    0))

;; write the code slice V[start .. start+cl) to out (LINK r6h: from the container V itself, in 256 KiB pieces)
(defn- drv-x4 [V :vector-i64 out :string start :i64 cl :i64 oa :i64] :i64
  (let [w (out-write-v V out start cl)]
    (if (= (io-exists out) 1) (drv-xok out oa cl) (drv-fail0 E-WRITE))))

;; an out-parse failure: E5002 (symbol not exported) is the driver's E5, the others are printed as recorded
(defn- drv-xerr [e :i64] :i64
  (if (= e 5002) (drv-fail0 E-NOSYM) (drv-fail0 e)))

(defn- drv-x3 [M :vector-i64 V :vector-i64 out :string] :i64
  (let [e (vector-at M MM-ERR)
        off (vector-at M MM-R0)
        cs (vector-at M MM-R1)
        cl (vector-at M MM-R2)
        ar (vector-at M MM-R3)]
    (if (> e 0) (drv-xerr e) (drv-x4 V out cs cl (+ (* off 4294967296) ar)))))

;; LINK (r6h): only the header goes through OUT (50-out out-load-hdr); was: the whole container, refused above MM-OUT-CAP
(defn- drv-x2 [V :vector-i64 n :i64 sym :string out :string] :i64
  (drv-x3 (out-load-hdr (mem-new) V n sym) V out))

(defn- drv-x1 [V :vector-i64 sym :string out :string] :i64
  (drv-x2 V (out-v-len V) sym out))

(defn- drv-extract [n :i64] :i64
  (let [k (drv-pos 1 n 0)
        s (drv-flag 1 n -5041807559351932249)
        o (drv-flag 1 n -5168643622338417694)]
    (cond (< k 0) (drv-usage)
          (< s 0) (drv-usage)
          (< o 0) (drv-usage)
          (= (io-exists (io-arg k)) 0) (drv-fail0 E-READ)
          :else (drv-x1 (io-read-bytes (io-arg k)) (io-arg s) (io-arg o)))))

;; ==== BEGIN compile-kir (owner: agent KIR; module seed/12-kirread.kotoba, docs/selfhost-seed-kirread-20261002.md) =====
;;   compile-kir <file.kir|file.kexe> <out>|-      also: compile-kir <file> --output <out>
;; The input is KIR text (the :program map of a stage-0 kexe/v1, or the whole kexe/v1). The text plus kr-prelude is
;; lexed by kr-lex, read by 11-read, rewritten into a Seed-0 tree by kr-run, then the compile pipeline from 20-names on
;; is the one of `compile` (drv-kir-c2 .. c8 = drv-c2 .. c8 with drv-kir-fail). Errors E1201-E1204 are 12-kirread's;
;; a {name} span or position that lies in the prelude (a generated node) is printed empty / without a byte offset.
(defn- drv-kir-text [c :i64] :string
  (cond (= c 1201) "not a KIR program (one {:format :kotoba.kir/v3|v4 ..} map or a kexe/v1): '"
        (= c 1202) "unsupported KIR field '"
        (= c 1203) "unsupported KIR value of '"
        (= c 1204) "KIR loop helper is not called exactly once with its arity: '"
        :else ""))

(defn- drv-kir-say [M :vector-i64 path :string] :i64
  (let [c (vector-at M MM-ERR)
        pos (vector-at M MM-ERR-POS)
        a (vector-at M MM-ERR-A)
        b (vector-at M MM-ERR-B)
        t (drv-kir-text c)]
    (if (= (string-length t) 0)
      (drv-fail M path)
      (drv-say c (string-concat t (string-concat (drv-slice path a b) "'")) pos))))

;; alt when v lies beyond the KIR file (in the prelude), else keep
(defn- drv-kir-clip [v :i64 flen :i64 alt :i64 keep :i64] :i64 (if (> v flen) alt keep))

;; positions in the prelude (generated nodes) are dropped: no byte offset, an empty {name}
(defn- drv-kir-fail [M :vector-i64 path :string] :i64
  (let [flen (- (vector-at M MM-SRC-LEN) (string-length (kr-prelude)))
        b (vector-at M MM-ERR-B)
        a2 (drv-kir-clip b flen 0 (vector-at M MM-ERR-A))
        b2 (drv-kir-clip b flen 0 b)
        p2 (drv-kir-clip (+ (vector-at M MM-ERR-POS) 1) flen 0 (+ (vector-at M MM-ERR-POS) 1))]
    (drv-kir-say (mem-set (mem-set (mem-set M MM-ERR-A a2) MM-ERR-B b2) MM-ERR-POS (- p2 1)) path)))

;; the `compile` pipeline from 20-names on (drv-c2 .. drv-c8), with drv-kir-fail as the error report
(defn- drv-kir-c8 [M :vector-i64 path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-emit2 M out) (drv-kir-fail M path)))
(defn- drv-kir-c7 [M :vector-i64 S :string path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-kir-c8 (out-build M S) path out) (drv-kir-fail M path)))
(defn- drv-kir-c6 [M :vector-i64 S :string path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-kir-c7 (ly-run M) S path out) (drv-kir-fail M path)))
(defn- drv-kir-c5 [M :vector-i64 S :string path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-kir-c6 (gn-run M) S path out) (drv-kir-fail M path)))
(defn- drv-kir-c4 [M :vector-i64 S :string path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-kir-c5 (lw-run M) S path out) (drv-kir-fail M path)))
(defn- drv-kir-c3 [M :vector-i64 S :string path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-kir-c4 (ck-run M S) S path out) (drv-kir-fail M path)))
(defn- drv-kir-c2 [M :vector-i64 S :string path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-kir-c3 (nm-run M S) S path out) (drv-kir-fail M path)))
(defn- drv-kir-c1 [M :vector-i64 S :string path :string out :string] :i64
  (if (= (vector-at M MM-ERR) 0) (drv-kir-c2 (kr-run M S) S path out) (drv-kir-fail M path)))
;; SEEDFIX: met = 1 for --metered (12-kirread reads it from cell 124 before it stores the prelude token there)
(defn- drv-kir-c0 [S :string path :string out :string met :i64] :i64
  (drv-kir-c1 (rd-run (kr-lex (mem-set (mem-set (mem-new) MM-SRC-LEN (string-length S)) 124 met) S) S) S path out))

(defn- drv-kir-run [path :string out :string met :i64] :i64
  (if (= (io-exists path) 1) (drv-kir-c0 (string-concat (drv-read path) (kr-prelude)) path out met) (drv-fail0 E-READ)))

;; SEEDFIX: 1 when one of the arguments is --metered (compile-kir <in> --output <out> --metered: a metered artifact; what is
;; not fuel-exact against machine_ir is refused by name, see 12-kirread's SEEDFIX header)
(defn- drv-kir-met [i :i64 n :i64] :i64
  (cond (>= i n) 0 (string=? (io-arg i) "--metered") 1 :else (drv-kir-met (+ i 1) n)))

;; <out> "-" -> hex on stdout (as `compile`), else that file
(defn- drv-kir-out [i :i64] :string (if (= (drv-dash (io-arg i)) 1) "" (io-arg i)))

(defn- drv-kir [n :i64] :i64
  (let [o (drv-flag 1 n -5168643622338417694)
        s (drv-pos 1 n 0)
        p1 (drv-pos 1 n 1)]
    (cond (< s 0) (drv-usage)
          (= (drv-pj-has 1 n "--emit-module") 1) (drv-ke n s o)   ; EMIT (block below)
          (>= o 0) (drv-kir-run (io-arg s) (drv-kir-out o) (drv-kir-met 1 n))
          (< p1 0) (drv-usage)
          :else (drv-kir-run (io-arg s) (drv-kir-out p1) (drv-kir-met 1 n)))))
;; ==== END compile-kir =================================================================================================

;; ==== BEGIN EMIT (agent EMIT, 2026-10-04): compile-kir --emit-module, a 60-proj module object from KIR ================
;;   compile-kir <file.kir> --emit-module --ns NAME [--object-dir O] --output <x.kso>
;; The KIR program goes the compile-kir pipeline (kr-lex .. 42-layout, base 0) and is written as a KSEEDO1 module object
;; named NAME (60-proj separate mode, its header comment): a source-route module that requires NAME compiles against it
;; (`compile --emit-module`) and `seed link` lays both into ONE image. Lines: N NAME / K 0 <the empty keyword union> (the
;; KIR route keeps keyword texts in its own library groups; it has no __r6-kwtab, so no W line) / no R line (a KIR
;; program is closed) / one E line per KIR export (60-proj pj-iface-one: clause offsets in the blob, the stub template of
;; the export's checked signature; an export whose types do not cross modules is E6017 by name) / L lines (literal loads,
;; relocated at link) / X lines (the KIR exports: the object may also be a link root) / C lines (the blob, 64 B a line).
;; The object is written from one byte vector (60-proj's pj-object builds a string: a 2.4 MB blob is 4.8 MB of hex,
;; quadratic in its 4 KiB accumulators). --metered with --emit-module is a usage error. O is accepted and unused.
(defn- drv-ke-put [V :vector-i64 at :i64 s :string] :i64
  (let [w (io-bput-str V s 0 (string-length s) at)] (+ at (string-length s))))
(defn- drv-ke-hexc [d :i64] :i64 (if (< d 10) (+ 48 d) (+ 87 d)))

;; the C lines of OUT bytes [0, n) at V[at0 ..]; the new fill
(defn- drv-ke-clines [M :vector-i64 V :vector-i64 at0 :i64 n :i64] :i64
  (loop [i 0 at at0]
    (if (>= i n)
      at
      (let [e (if (< (+ i 64) n) (+ i 64) n)
            a2 (loop [j i a (drv-ke-put V at "C ")]
                 (if (>= j e)
                   a
                   (let [b (bit-and (vector-at M (+ MM-OUT-BASE 1 j)) 255)
                         x (vector-assoc! V a (drv-ke-hexc (u64-shift-right b 4)))
                         y (vector-assoc! V (+ a 1) (drv-ke-hexc (bit-and b 15)))]
                     (recur (+ j 1) (+ a 2)))))
            z (vector-assoc! V a2 10)]
        (recur e (+ a2 1))))))

;; the lines of object section c (60-proj pj-oline: 1 E, 3 L, 4 X) at V[at0 ..]; the new fill
(defn- drv-ke-sect [M :vector-i64 L :vector-i64 P :string S :string V :vector-i64 c :i64 at0 :i64] :i64
  (loop [k 0 at at0]
    (if (>= k (pj-ocount M L c)) at (recur (+ k 1) (drv-ke-put V at (pj-oline M L P S (+ (* c 1048576) k)))))))

;; the text length of section c
(defn- drv-ke-slen [M :vector-i64 L :vector-i64 P :string S :string c :i64] :i64
  (loop [k 0 t 0]
    (if (>= k (pj-ocount M L c)) t (recur (+ k 1) (+ t (string-length (pj-oline M L P S (+ (* c 1048576) k))))))))

(defn- drv-ke-write [M :vector-i64 L :vector-i64 P :string S :string nsn :string out :string] :i64
  (let [H (string-concat "KSEEDO1\n" (string-concat (pj-line "N" nsn) (string-concat "K 0 " (string-concat (ck-r6b-kwtab "") "\n"))))
        n (- (vector-at M MM-OUT-N) 1)
        cap (+ (string-length H) (drv-ke-slen M L P S 1) (drv-ke-slen M L P S 3) (drv-ke-slen M L P S 4) (* 3 (+ (quot n 64) 1)) (* 2 n) 16)
        V (vector-alloc cap)
        a1 (drv-ke-sect M L P S V 4 (drv-ke-sect M L P S V 3 (drv-ke-sect M L P S V 1 (drv-ke-put V 0 H))))
        a2 (drv-ke-clines M V a1 n)
        w (io-write-bytes V out 0 a2)]
    (if (= (io-exists out) 1) (drv-cok out a2) (drv-fail0 E-WRITE))))

;; the interface entries of module 0 (the KIR program, compiled, in M): one per export of the EXP table
(defn- drv-ke-iface [M :vector-i64 L :vector-i64 P :string S :string] :string
  (let [w (pj-mset L 0 pj-mf-if0 (pj-l L pj-k-nif))
        P2 (loop [k 1 P P]
             (if (or (>= k (vector-at M MM-EXP-N)) (not (pj-ok M)))
               P
               (let [f (vector-at M (+ MM-EXP-BASE (* k MM-EXP-W) EF-FN))
                     sym (pj-ff M f FF-SYM)
                     s (string-substring S (pj-sf M sym SF-START) (pj-sf M sym SF-END))
                     f0 (pj-fn-named M S s)]
                 (recur (+ k 1) (pj-iface-one M L P S s (if (> f0 0) f0 f))))))
        w2 (pj-mset L 0 pj-mf-nif (- (pj-l L pj-k-nif) (pj-mf L 0 pj-mf-if0)))]
    P2))

;; KIR -> the module blob at base 0 in OUT (drv-kir-c1 .. c6, then out-blob instead of out-build)
(defn- drv-ke-blob [M :vector-i64 S :string] :vector-i64
  (let [M1 (kr-run M S)]
    (if (not (pj-ok M1)) M1
      (let [M2 (nm-run M1 S)]
        (if (not (pj-ok M2)) M2
          (let [M3 (ck-run M2 S)]
            (if (not (pj-ok M3)) M3
              (let [M4 (lw-run M3)]
                (if (not (pj-ok M4)) M4
                  (let [M5 (gn-run M4)]
                    (if (not (pj-ok M5)) M5
                      (let [M6 (ly-run M5)] (if (pj-ok M6) (out-blob M6) M6)))))))))))))

(defn- drv-ke-run [path :string nsn :string out :string] :i64
  (let [S (string-concat (drv-read path) (kr-prelude))
        M (rd-run (kr-lex (mem-set (mem-set (mem-new) MM-SRC-LEN (string-length S)) 124 0) S) S)
        M1 (if (pj-ok M) (drv-ke-blob M S) M)]
    (if (not (pj-ok M1))
      (drv-kir-fail M1 path)
      (let [L (pj-new-l)
            P0 (pj-padd L (pj-new-p L) nsn)
            w (-> L (pj-add-mod 0 0) (pj-ls pj-k-mode 1) (pj-ls pj-k-errmod 0) (pj-ls pj-k-base 0))
            P1 (drv-ke-iface M1 L P0 S)]
        (if (pj-ok M1) (drv-ke-write M1 L P1 S nsn out) (drv-kir-fail M1 path))))))

(defn- drv-ke [n :i64 s :i64 o :i64] :i64
  (let [k (drv-pj-flag 1 n "--ns")]
    (cond (< o 0) (drv-usage)
          (< k 0) (drv-usage)
          (= (drv-kir-met 1 n) 1) (drv-usage)
          (= (string-length (drv-kir-out o)) 0) (drv-usage)
          (= (io-exists (io-arg s)) 0) (drv-fail0 E-READ)
          :else (drv-ke-run (io-arg s) (io-arg k) (io-arg o)))))
;; ==== END EMIT ========================================================================================================

(defn- drv-cmd [n :i64] :i64
  (cond (< n 1) (drv-usage)
        (= (drv-is (io-arg 0) 11 1891999495935608509) 1) (drv-kir n)  ; compile-kir (block above)
        (= (drv-is (io-arg 0) 7 1333288279851460382) 1) (drv-compile n)
        (string=? (io-arg 0) "link") (drv-pj-link n)          ; R5A (60-proj separate mode)
        (string=? (io-arg 0) "modules") (drv-pj-modules n)    ; R5A
        (= (drv-is (io-arg 0) 5 -9003556064986789273) 1) (drv-check n)
        (= (drv-is (io-arg 0) 14 -7022508286123793970) 1) (drv-extract n)
        :else (drv-usage)))

(defn- drv-main [] :i64 (drv-cmd (io-argc)))

;; ==== BEGIN R5B (agent R5B, 2026-10-03): effect texts and the capability policy =========================================
;; The texts of E2140-E2177 are TEMPLATES (seed/HEADS :errors, scripts/seed/errors-check.py compares them with =), filled at print
;; time: {name} the span MM-ERR-A..B, {n} MM-ERR-N, {t} the type N with ':', {op} get/put (N bits 48..49), {ty1} {ty2} the types of
;; N bits 0..23 / 24..47 without ':', {kw2} the second one with ':', {fx} the effect set of N, {node} the token of node N bits 0..23,
;; {want} [state] / [state value], {req} {allow} {miss} the grant sets of N, MM-ERR-A and N without A.
(defn- drv-r5b-text [c :i64] :string
  (cond
    (= c 2140) "atom `{name}` escapes its let scope (atom slice 1 admits swap!/reset!/deref in straight-line code of the binding function only)"
    (= c 2141) "atom must be the init expression of a let binding (atom slice 1 admits swap!/reset!/deref in straight-line code of the binding function only)"
    (= c 2142) "deref expects a let-bound atom cell as its first argument; got `{name}` (atom slice 1)"
    (= c 2143) "swap!/reset! is not admitted inside `{name}` (atom slice 1 admits them in let, do, if, when, cond and case only)"
    (= c 2144) "atom `{name}` is {ty1}; this rebinding is {ty2} (atom slice 1 requires one type per cell)"
    (= c 2147) "atom `{name}` shadows an atom of the same name (atom slice 1 admits swap!/reset!/deref in straight-line code of the binding function only)"
    (= c 2148) "swap! expects a let-bound atom cell as its first argument; got `{name}` (atom slice 1)"
    (= c 2149) "reset! expects a let-bound atom cell as its first argument; got `{name}` (atom slice 1)"
    (= c 2150) "unhandled ability :state at export boundary; handle it with (handle body (with handler init)): {name}"
    (= c 2151) "handler {name} resumes state/{op} with {ty1}, but state/{op} returns {ty2} in a [:state {kw2}] handler"
    (= c 2152) "handler {name} resumes state/{op} with next state {ty1}, but the handler's state is {ty2} in a [:state {kw2}] handler"
    (= c 2153) "handler {name} is not pure: its {op} clause performs {fx}; a handler for the pure ability :state must be pure"
    (= c 2154) "inferred effects exceed declared effect ceiling for {name}: {fx}"
    (= c 2155) "handler {name} clause {op} must end every branch in exactly one (resume value state) in tail position"
    (= c 2156) "state slice 1 does not admit perform :state/{op} inside a fn literal"
    (= c 2157) "state slice 1 does not admit throw or try inside a stateful function or a handle body: {name}"
    (= c 2158) "handle names no handler: {name}"
    (= c 2159) "handler {name} does not match the :state ability: it must define exactly get and put, once each"
    (= c 2160) "handler {node} does not match the :state ability: its {op} clause takes {want}, got {name}"
    (= c 2161) "stateful function {name} cannot be used as a value in state slice 1; call it under a handler"
    (= c 2162) "state slice 1 does not admit a stateful function that aborts: {name}"
    (= c 2163) "state slice 1 does not admit a call to an aborting function inside a handle body: {name}"
    (= c 2164) "handle installs one handler with one initial state: (handle body (with handler init))"
    (= c 2165) "perform :state/get takes no value; got {n}"
    (= c 2166) "perform :state/put takes exactly one value; got {n}"
    (= c 2167) "named operation {name} is not a registered capability"
    (= c 2168) "resume is admitted only in tail position of a defhandler clause"
    (= c 2169) "state slice 1 does not admit a call of the stateful function {name} inside a fn literal"
    (= c 2170) "malformed capability policy file (expected an :allow set of [:cap/call wire] items)"
    (= c 2171) "stateful function {name} takes more than 4 parameters (the state is passed first, at most 5 in all)"
    (= c 2176) "cap-call uses a capability not declared in namespace :capabilities: {fx}"
    (= c 2177) "capability policy denies required effects; missing grants {miss} (required {req}, allowed {allow})"
    :else ""))

(def drv-r5b-m24 16777215)
(def drv-r5b-m47 140737488355327)
(def drv-r5b-state 140737488355328)

;; the catalogue name of capability wire w
(defn- drv-r5b-wname [w :i64] :string
  (case w 3 ":hash/sha256" 7 ":clock/now" 33 ":env/read" 34 ":fs/browse" 35 ":fs/app-data" 37 ":io/write" 38 ":cli/args"
        39 ":io/write-error" 41 ":io/read" (mem-u2dec w)))
;; the items of mask m (bit 47 = :state first, then the wires in ascending order), each wrapped by pre/post, as #{..}. R5B rung
;; proof (a handler written in the language): the text is the state of handler drv-acc, whose put APPENDS (it was a loop
;; accumulator); drv-r5b-items is stateful and self-recursive
(defhandler drv-acc [:state :string]
  (get [s] (resume s s))
  (put [s v] (resume v (string-concat s v))))
;; one item: a separating space unless it is the first one after "#{"
(defn- drv-r5b-item [x :string pre :string post :string] :string
  (perform :state/put (string-concat (if (= (string-byte-length (perform :state/get)) 2) "" " ") (string-concat pre (string-concat x post)))))
(defn- drv-r5b-items [m :i64 w :i64 pre :string post :string] :i64
  (cond (>= w 47) 0
        (= (bit-and m (i64-shift-left 1 w)) 0) (drv-r5b-items m (inc w) pre post)
        :else (do (drv-r5b-item (drv-r5b-wname w) pre post) (drv-r5b-items m (inc w) pre post))))
(defn- drv-r5b-set [m :i64 pre :string post :string] :string
  (handle (do (if (= (bit-and m drv-r5b-state) 0) "" (drv-r5b-item ":state" pre post))
              (drv-r5b-items m 0 pre post)
              (perform :state/put "}")
              (perform :state/get))
          (with drv-acc "#{")))
;; a type name; colon 1 = keyword spelling (:i64), 0 = bare (i64)
(defn- drv-r5b-ty [M :vector-i64 path :string t :i64 colon :i64] :string
  (let [c (if (= colon 1) ":" "")]
    (cond (and (>= t 1) (<= t 6)) (string-concat c (case t 1 "i64" 2 "bool" 3 "string" 4 "vector-i64" 5 "bytes" "keyword"))
          (>= t TY-COMP-BASE)
          (let [r (+ (vector-at M MM-CT) (* (- t TY-COMP-BASE) CT-W))
                k (vector-at M (+ r CT-CTOR))
                a (drv-r5b-ty M path (vector-at M (+ r CT-A)) 1)]
            (case k
              TC-OPTION (string-concat "[:option " (string-concat a "]"))
              TC-LIST (string-concat "[:list " (string-concat a "]"))
              TC-SET (string-concat "[:set " (string-concat a "]"))
              TC-RESULT (string-concat "[:result " (string-concat a (string-concat " " (string-concat (drv-r5b-ty M path (vector-at M (+ r CT-B)) 1) "]"))))
              TC-MAP (string-concat "[:map " (string-concat a (string-concat " " (string-concat (drv-r5b-ty M path (vector-at M (+ r CT-B)) 1) "]"))))
              "[:fn ..]"))
          (>= t TY-REC-BASE)
          (let [sy (- t TY-REC-BASE)]
            (drv-slice path (vector-at M (+ MM-SYM-BASE (* sy MM-SYM-W) SF-START)) (vector-at M (+ MM-SYM-BASE (* sy MM-SYM-W) SF-END))))
          :else "?")))
;; the value of placeholder key
(defn- drv-r5b-ph [M :vector-i64 path :string key :string] :string
  (let [n (vector-at M MM-ERR-N)
        a (vector-at M MM-ERR-A)
        b (vector-at M MM-ERR-B)
        op (bit-and (u64-shift-right n 48) 3)
        t1 (bit-and n drv-r5b-m24)
        t2 (bit-and (u64-shift-right n 24) drv-r5b-m24)
        nd (vector-at M (+ MM-NODE-BASE (* t1 MM-NODE-W) NF-TOK))]
    (cond (string=? key "name") (drv-slice path a b)
          (string=? key "n") (mem-u2dec n)
          (string=? key "t") (drv-tyname n)
          (string=? key "op") (if (= op 2) "put" "get")
          (string=? key "ty1") (drv-r5b-ty M path t1 0)
          (string=? key "ty2") (drv-r5b-ty M path t2 0)
          (string=? key "kw2") (drv-r5b-ty M path t2 1)
          (string=? key "fx") (drv-r5b-set (bit-and n (bit-or drv-r5b-m47 drv-r5b-state)) "" "")
          (string=? key "node") (drv-slice path (vector-at M (+ MM-TOK-BASE (* nd MM-TOK-W) TF-START)) (vector-at M (+ MM-TOK-BASE (* nd MM-TOK-W) TF-END)))
          (string=? key "want") (if (= op 2) "[state value]" "[state]")
          (string=? key "req") (drv-r5b-set n "[:cap/call " "]")
          (string=? key "allow") (drv-r5b-set a "[:cap/call " "]")
          (string=? key "miss") (drv-r5b-set (bit-and n (bit-not a)) "[:cap/call " "]")
          :else (string-concat "{" (string-concat key "}")))))
;; template tpl with every {key} replaced, appended to acc
(defn- drv-r5b-fill [M :vector-i64 path :string tpl :string acc :string] :string
  (let [i (string-index-of tpl "{")
        len (string-length tpl)]
    (if (< i 0)
      (string-concat acc tpl)
      (let [rest (string-substring tpl (+ i 1) len)
            j (string-index-of rest "}")]
        (if (< j 0)
          (string-concat acc tpl)
          (drv-r5b-fill M path (string-substring rest (+ j 1) (string-length rest))
                        (string-concat acc (string-concat (string-substring tpl 0 i) (drv-r5b-ph M path (string-substring rest 0 j))))))))))

;; ---- the capability policy (--policy P, the stage-0 file shape {:allow #{[:cap/call N] [:cap/call :name] ..}}) ----
(defn- drv-pol-utf8-width [code-point :i64] :i64
  (cond (< code-point 128) 1
        (< code-point 2048) 2
        (< code-point 65536) 3
        :else 4))

(defn- drv-pol-utf16-width [code-point :i64] :i64
  (if (> code-point 65535) 2 1))

(defn- drv-pol-whitespace? [code-point :i64] :bool
  (or (= code-point 32) (= code-point 9) (= code-point 10)
      (= code-point 13) (= code-point 44)))

(defn- drv-pol-result [status :i64 reason :i64 byte-offset :i64
                  root-count :i64 node-count :i64] :vector-i64
  (let [r0 (vector-assoc! (vector-alloc 5) 0 status)
        r1 (vector-assoc! r0 1 reason)
        r2 (vector-assoc! r1 2 byte-offset)
        r3 (vector-assoc! r2 3 root-count)]
    (vector-assoc! r3 4 node-count)))

(defn- drv-pol-preflight [text :string] :vector-i64
  "Return [status reason byte-offset roots nodes]. Status 1 means the bounded
  scan is safe to hand to a policy decoder; status 0 is a refusal. Reasons:
  1 dispatch, 2 depth, 3 token length, 4 node count, 5 multiple roots,
  6 unterminated string, 7 unclosed collection, 8 empty input,
  9 source-reader prefix, 10 non-ASCII token, 11 mismatched or unmatched closer."
  (let [length (string-length text)]
    (loop [offset 0 depth 0 token-length 0 in-string 0 escaped 0
           in-comment 0 nodes 0 roots 0 stack (vector-alloc 128)]
      (if (>= offset length)
        (cond (= in-string 1) (drv-pol-result 0 6 length roots nodes)
              (> depth 0) (drv-pol-result 0 7 length roots nodes)
              (= roots 0) (drv-pol-result 0 8 length roots nodes)
              :else (drv-pol-result 1 0 -1 roots nodes))
        (let [code-point (string-code-point-at text offset)
              width (drv-pol-utf8-width code-point)
              next-offset (+ offset width)
              next-code-point (if (< next-offset length)
                                (string-code-point-at text next-offset)
                                -1)]
          (cond
            (= in-comment 1)
            (recur next-offset depth 0 0 0
                   (if (= code-point 10) 0 1) nodes roots stack)

            (= in-string 1)
            (cond
              (= escaped 1)
              (recur next-offset depth 0 1 0 0 nodes roots stack)

              (= code-point 92)
              (recur next-offset depth 0 1 1 0 nodes roots stack)

              (= code-point 34)
              (recur next-offset depth 0 0 0 0 nodes roots stack)

              :else
              (recur next-offset depth 0 1 0 0 nodes roots stack))

            (= code-point 59)
            (recur next-offset depth 0 0 0 1 nodes roots stack)

            (= code-point 34)
            (let [next-nodes (+ nodes 1)
                  next-roots (if (= depth 0) (+ roots 1) roots)]
              (cond (> next-nodes 200000)
                    (drv-pol-result 0 4 offset roots nodes)
                    (> next-roots 1)
                    (drv-pol-result 0 5 offset next-roots next-nodes)
                    :else
                    (recur next-offset depth 0 1 0 0 next-nodes next-roots stack)))

            (= code-point 35)
            (if (= next-code-point 123)
              (recur next-offset depth 0 0 0 0 nodes roots stack)
              (drv-pol-result 0 1 offset roots nodes))

            (or (= code-point 40) (= code-point 91) (= code-point 123))
            (let [next-depth (+ depth 1)
                  next-nodes (+ nodes 1)
                  next-roots (if (= depth 0) (+ roots 1) roots)]
              (cond (> next-depth 128)
                    (drv-pol-result 0 2 offset roots nodes)
                    (> next-nodes 200000)
                    (drv-pol-result 0 4 offset roots nodes)
                    (> next-roots 1)
                    (drv-pol-result 0 5 offset next-roots next-nodes)
                    :else
                    (recur next-offset next-depth 0 0 0 0 next-nodes next-roots
                           (vector-assoc! stack depth code-point))))

            (or (= code-point 41) (= code-point 93) (= code-point 125))
            (if (= depth 0)
              (drv-pol-result 0 11 offset roots nodes)
              (let [open (vector-at stack (- depth 1))
                    want (cond (= open 40) 41 (= open 91) 93 :else 125)]
                (if (= code-point want)
                  (recur next-offset (- depth 1) 0 0 0 0 nodes roots stack)
                  (drv-pol-result 0 11 offset roots nodes))))

            (or (= code-point 64) (= code-point 94))
            (drv-pol-result 0 9 offset roots nodes)

            (drv-pol-whitespace? code-point)
            (recur next-offset depth 0 0 0 0 nodes roots stack)

            (> code-point 127)
            (drv-pol-result 0 10 offset roots nodes)

            :else
            (let [starts-token (= token-length 0)
                  next-token-length (+ token-length (drv-pol-utf16-width code-point))
                  next-nodes (+ nodes (if starts-token 1 0))
                  next-roots (if (and starts-token (= depth 0)) (+ roots 1) roots)]
              (cond (> next-token-length 4096)
                    (drv-pol-result 0 3 offset roots next-nodes)
                    (> next-nodes 200000)
                    (drv-pol-result 0 4 offset roots next-nodes)
                    (> next-roots 1)
                    (drv-pol-result 0 5 offset next-roots next-nodes)
                    :else
                    (recur next-offset depth next-token-length 0 0 0
                           next-nodes next-roots stack)))))))))
(defn- drv-pol-separator [name :string] :string
  (string-concat name "_SEP"))

(defn- drv-pol-stat [path :string] :string
  (typed-cap-call :fs/app-data :string :string
    (string-concat path (drv-pol-separator "NOFOLLOW"))))

(defn- drv-pol-decimal-bounded [text :string] :i64
  (let [n (string-length text)]
    (loop [i 0 value 0]
      (if (>= i n)
        (if (> n 0) value -1)
        (let [digit (- (string-code-point-at text i) 48)]
          (if (or (< digit 0) (> digit 9))
            -1
            (let [next-value (+ (* value 10) digit)]
              (if (> next-value 8388608)
                -1
                (recur (+ i 1) next-value)))))))))

(defn- drv-pol-stat-size [stat :string] :i64
  (let [first-space (string-index-of stat " ")]
    (if (< first-space 0)
      -1
      (let [tail1 (string-substring stat (+ first-space 1) (string-length stat))
            second-space (string-index-of tail1 " ")]
        (if (< second-space 0)
          -1
          (let [size-text (string-substring tail1 0 second-space)
                tail2 (string-substring tail1 (+ second-space 1) (string-length tail1))
                third-space (string-index-of tail2 " ")
                kind (if (< third-space 0)
                       ""
                       (string-substring tail2 (+ third-space 1) (string-length tail2)))]
            (if (string=? kind "0")
              (drv-pol-decimal-bounded size-text)
              -1)))))))

(defn- drv-pol-range [path :string size :i64] :string
  (typed-cap-call :fs/app-data :string :string
    (string-concat
      path
      (string-concat
        (drv-pol-separator "RANGE")
        (string-concat "0:" (string-from-i64 size))))))

(defn- drv-pol-valid-text [text :string size :i64] :bool
  (let [scan (drv-pol-preflight text)]
    (and (= (string-byte-length text) size)
         (= (vector-at scan 0) 1))))

(defn- drv-pol-read-sized [path :string before :string] :string
  (let [size (drv-pol-stat-size before)]
    (if (or (< size 0) (= size 0))
      ""
      (let [text (drv-pol-range path size)
            after-size (drv-pol-stat-size (drv-pol-stat path))]
        (if (and (= after-size size)
                 (drv-pol-valid-text text size))
          text
          "")))))

;; locate the value after --policy while skipping other flag values
(defn- drv-pol-argv-path [i :i64 n :i64] :string
  (cond
    (>= i n) ""
    (string=? (io-arg i) "--policy") (if (< (+ i 1) n) (io-arg (+ i 1)) "")
    (= (drv-flagv (io-arg i)) 1) (drv-pol-argv-path (+ i 2) n)
    :else (drv-pol-argv-path (+ i 1) n)))

;; EDN value tags over the source AST. The AST keeps the original token span,
;; so true/false/nil can be recovered as values even though 11-read stores
;; them as ND-SYM. These tags are private to the bounded policy decoder; they
;; do not authorize a policy or alter the source-language symbol table.
(defn- drv-pol-sym-is? [M :vector-i64 S :string node :i64 spelling :string] :bool
  (if (= (nm-kind M node) ND-SYM)
    (let [tok (nm-nf M node NF-TOK)
          start (nm-tf M tok TF-START)
          end (nm-tf M tok TF-END)]
      (string=? (string-substring S start end) spelling))
    false))

(defn- drv-pol-kw-is? [M :vector-i64 S :string node :i64 spelling :string] :bool
  (if (= (nm-kind M node) ND-KW)
    (let [tok (nm-nf M node NF-TOK)
          start (nm-tf M tok TF-START)
          end (nm-tf M tok TF-END)]
      (string=? (string-substring S start end) spelling))
    false))

;; 1 int, 2 string, 3 keyword, 4 nil, 5 false, 6 true, 7 symbol,
;; 8 list, 9 vector, 10 map, 11 set; 0 is not a policy value.
(defn- drv-pol-value-kind [M :vector-i64 S :string node :i64] :i64
  (let [kind (nm-kind M node)]
    (cond (= kind ND-INT) 1
          (= kind ND-STR) 2
          (= kind ND-KW) 3
          (= kind ND-SYM) (cond (drv-pol-sym-is? M S node "nil") 4
                                (drv-pol-sym-is? M S node "false") 5
                                (drv-pol-sym-is? M S node "true") 6
                                :else 7)
          (= kind ND-LIST) 8
          (= kind ND-VEC) 9
          (= kind ND-MAP) 10
          (= kind ND-SET) 11
          :else 0)))

(defn- drv-pol-value-kids? [M :vector-i64 S :string node :i64] :bool
  (loop [child (nm-first M node)]
    (if (= child 0)
      true
      (if (drv-pol-value-tree? M S child)
        (recur (nm-next M child))
        false))))

(defn- drv-pol-value-tree? [M :vector-i64 S :string node :i64] :bool
  (let [kind (drv-pol-value-kind M S node)]
    (cond
      (= kind 0) false
      (and (= kind 10) (= (bit-and (nm-count M node) 1) 1)) false
      (or (= kind 8) (= kind 9) (= kind 10) (= kind 11))
      (drv-pol-value-kids? M S node)
      :else true)))

;; The owner admission schema is closed over these nine keys plus the two
;; compiler controls. Only :allow has a local structural contract here; other
;; values remain untouched for their future owner-equivalent evaluators.
(defn- drv-pol-root-key? [M :vector-i64 S :string node :i64] :bool
  (or (drv-pol-kw-is? M S node ":allow")
      (drv-pol-kw-is? M S node ":abac")
      (drv-pol-kw-is? M S node ":attributes")
      (drv-pol-kw-is? M S node ":information-flow")
      (drv-pol-kw-is? M S node ":crypto-required?")
      (drv-pol-kw-is? M S node ":crypto-policy")
      (drv-pol-kw-is? M S node ":crypto-envelope")
      (drv-pol-kw-is? M S node ":hardware-signing-required?")
      (drv-pol-kw-is? M S node ":hardware-signing-evidence")
      (drv-pol-kw-is? M S node ":language-profile")
      (drv-pol-kw-is? M S node ":budgets")))

(defn- drv-pol-root-keys? [M :vector-i64 S :string map :i64] :bool
  (loop [key (nm-first M map)]
    (if (= key 0)
      true
      (let [value (nm-next M key)]
        (if (= value 0)
          false
          (if (drv-pol-root-key? M S key)
            (recur (nm-next M value))
            false))))))

;; Map construction in the pinned NBB reader applies pairs in source order;
;; assoc makes a repeated key's last value authoritative.
(defn- drv-pol-map-last-value [M :vector-i64 S :string map :i64 key-text :string] :i64
  (loop [key (nm-first M map) result 0]
    (if (= key 0)
      result
      (let [value (nm-next M key)
            next-key (if (= value 0) 0 (nm-next M value))]
        (if (= value 0)
          result
          (recur next-key (if (drv-pol-kw-is? M S key key-text) value result)))))))

(defn- drv-pol-name-wire [M :vector-i64 S :string node :i64] :i64
  (cond
      (drv-pol-kw-is? M S node ":identity/sign") 1
      (drv-pol-kw-is? M S node ":identity/verify") 2
      (drv-pol-kw-is? M S node ":hash/sha256") 3
      (drv-pol-kw-is? M S node ":http/post") 4
      (drv-pol-kw-is? M S node ":log/read") 5
      (drv-pol-kw-is? M S node ":log/append") 6
      (drv-pol-kw-is? M S node ":clock/now") 7
      (drv-pol-kw-is? M S node ":state/transact") 8
      (drv-pol-kw-is? M S node ":ui/commit") 9
      (drv-pol-kw-is? M S node ":ui/next-event") 10
      (drv-pol-kw-is? M S node ":llm/generate") 11
      (drv-pol-kw-is? M S node ":storage/transact") 12
      (drv-pol-kw-is? M S node ":http/get-stream") 13
      (drv-pol-kw-is? M S node ":object/get-stream") 14
      (drv-pol-kw-is? M S node ":object/put-block") 15
      (drv-pol-kw-is? M S node ":object/compare-and-set-ref") 16
      (drv-pol-kw-is? M S node ":http/accept") 17
      (drv-pol-kw-is? M S node ":http/reply") 18
      (drv-pol-kw-is? M S node ":fs/transact") 19
      (drv-pol-kw-is? M S node ":process/spawn") 20
      (drv-pol-kw-is? M S node ":secret/get") 21
      (drv-pol-kw-is? M S node ":git/run") 22
      (drv-pol-kw-is? M S node ":entropy/draw") 23
      (drv-pol-kw-is? M S node ":dataspace/transact") 24
      (drv-pol-kw-is? M S node ":stream/accept") 25
      (drv-pol-kw-is? M S node ":stream/send") 26
      (drv-pol-kw-is? M S node ":net/datagram") 27
      (drv-pol-kw-is? M S node ":link/frame") 28
      (drv-pol-kw-is? M S node ":can/frame") 29
      (drv-pol-kw-is? M S node ":code/eval") 30
      (drv-pol-kw-is? M S node ":screen/observe") 31
      (drv-pol-kw-is? M S node ":screen/act") 32
      (drv-pol-kw-is? M S node ":env/read") 33
      (drv-pol-kw-is? M S node ":fs/browse") 34
      (drv-pol-kw-is? M S node ":fs/app-data") 35
      (drv-pol-kw-is? M S node ":fs/browse-dir") 36
      (drv-pol-kw-is? M S node ":io/write") 37
      (drv-pol-kw-is? M S node ":cli/args") 38
      (drv-pol-kw-is? M S node ":io/write-error") 39
      (drv-pol-kw-is? M S node ":sys/cwd") 40
      (drv-pol-kw-is? M S node ":io/read") 41
      (drv-pol-kw-is? M S node ":gpu/compute") 42
      (drv-pol-kw-is? M S node ":net/listen") 43
      (drv-pol-kw-is? M S node ":net/accept") 44
      (drv-pol-kw-is? M S node ":net/dial") 45
      (drv-pol-kw-is? M S node ":net/read") 46
      (drv-pol-kw-is? M S node ":net/write") 47
      :else -1))

(defn- drv-pol-grant? [M :vector-i64 S :string entry :i64] :bool
  (if (and (= (nm-kind M entry) ND-VEC) (= (nm-count M entry) 2))
    (let [capability (nm-first M entry)
          grant (nm-next M capability)]
      (and (drv-pol-kw-is? M S capability ":cap/call")
           (or (and (= (nm-kind M grant) ND-INT)
                    (let [wire (nm-nf M grant NF-AUX)]
                      (and (>= wire 0) (<= wire 255))))
               (and (= (nm-kind M grant) ND-KW)
                    (>= (drv-pol-name-wire M S grant) 0)))))
    false))

(defn- drv-pol-grant-wire [M :vector-i64 S :string entry :i64] :i64
  (if (and (= (nm-kind M entry) ND-VEC) (= (nm-count M entry) 2))
    (let [capability (nm-first M entry)
          grant (nm-next M capability)]
      (if (drv-pol-kw-is? M S capability ":cap/call")
        (cond (= (nm-kind M grant) ND-INT) (nm-nf M grant NF-AUX)
              (= (nm-kind M grant) ND-KW) (drv-pol-name-wire M S grant)
              :else -1)
        -1))
    -1))

;; Project grants to the seed's recognized wire-mask domain. Repeated numeric
;; and named spellings collapse by bitwise OR, as they do after owner set
;; canonicalization. IDs outside 0..46 cannot satisfy a current seed effect;
;; numeric range refusal remains a later admission decision.
(defn- drv-pol-allow-mask [M :vector-i64 S :string allow :i64] :i64
  (loop [entry (nm-first M allow) mask 0]
    (if (= entry 0)
      mask
      (if (not (drv-pol-grant? M S entry))
        -1
        (let [wire (drv-pol-grant-wire M S entry)
              next-mask (if (and (>= wire 0) (< wire 47))
                          (bit-or mask (i64-shift-left 1 wire))
                          mask)]
          (recur (nm-next M entry) next-mask))))))

;; :allow is optional at the owner boundary, but when present its value is a
;; set of exact [:cap/call id-or-known-name] entries. Resolve duplicate root entries
;; with NBB's last-wins map behavior.
(defn- drv-pol-policy-shape? [M :vector-i64 S :string map :i64] :bool
  (let [allow (drv-pol-map-last-value M S map ":allow")]
    (and (drv-pol-root-keys? M S map)
         (or (= allow 0)
             (and (= (nm-kind M allow) ND-SET)
                  (>= (drv-pol-allow-mask M S allow) 0))))))

;; The admitted policy subset has only the :allow root key (or no keys).
;; Every other policy field stays closed until its owner evaluator is ported.
(defn- drv-pol-allow-only? [M :vector-i64 S :string map :i64] :bool
  (loop [key (nm-first M map)]
    (if (= key 0)
      true
      (let [value (nm-next M key)]
        (if (or (= value 0) (not (drv-pol-kw-is? M S key ":allow")))
          false
          (recur (nm-next M value)))))))

;; parse the preflighted text in an isolated seed heap; require one root map
;; with paired children, typed EDN nodes, known root keys, and an optional
;; :allow set of integer or catalog-named capability-call entries. Status 1
;; is well-shaped but has unsupported policy fields; status 0 is malformed or
;; refused by bounded preflight. A :allow-only map encodes as 2 + 4 * its
;; recognized grant mask so the gate can compare required effects.
(defn- drv-pol-reader-shape? [text :string] :i64
  (let [P0 (mem-set (mem-new) MM-SRC-LEN (string-length text))
        P1 (lx-run P0 text)
        P2 (if (= (vector-at P1 MM-ERR) 0) (rd-run P1 text) P1)
        root (vector-at P2 MM-ROOT)
        forms (nm-count P2 root)
        form (nm-first P2 root)
        items (nm-count P2 form)]
    (if (= (vector-at P2 MM-ERR) 0)
      (if (= forms 1)
        (if (= (nm-kind P2 form) ND-MAP)
          (if (and (= (bit-and items 1) 0)
                   (drv-pol-value-tree? P2 text form)
                   (drv-pol-policy-shape? P2 text form))
            (if (drv-pol-allow-only? P2 text form)
              (let [allow (drv-pol-map-last-value P2 text form ":allow")
                    mask (if (= allow 0) 0 (drv-pol-allow-mask P2 text allow))]
                (+ 2 (* mask 4)))
              1)
            0)
          0)
        0)
      0)))

;; bounded text and raw-reader shape only; status >=2 encodes an allow-only map
(defn- drv-pol-file-safe? [path :string] :i64
  (let [text (if (or (= (string-length path) 0) (= (io-exists path) 0))
               ""
               (drv-pol-read-sized path (drv-pol-stat path)))]
    (if (> (string-length text) 0) (drv-pol-reader-shape? text) 0)))

;; -1 when the compile may write its output: no --policy, or a :allow-only
;; policy covers every recognized required capability; otherwise refuse.
(defn- drv-r5b-gate [M :vector-i64 path :string req :i64] :i64
  (let [present (drv-pj-has 1 (io-argc) "--policy")]
    (if (= present 0)
      -1
      (let [safe (drv-pol-file-safe? (drv-pol-argv-path 1 (io-argc)))]
        (cond
          (>= safe 2)
          (let [allow-mask (quot (- safe 2) 4)
                required-mask (bit-and req drv-r5b-m47)
                unsupported-mask (bit-and req (bit-not (bit-or drv-r5b-m47 drv-r5b-state)))]
            (if (and (= unsupported-mask 0)
                     (= (bit-and required-mask (bit-not allow-mask)) 0))
              -1
              (drv-say E-CAP-POLICY "capability policy denies required effects" -1)))
          (= safe 1) (drv-say E-POLICY-FILE "structured capability policy checking is not qualified in this seed snapshot" -1)
          :else (drv-say E-POLICY-FILE "policy file failed bounded preflight or cannot be read; explicit policy remains closed" -1))))))
;; ==== END R5B ==========================================================================================================
