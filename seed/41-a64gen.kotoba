(defn- cpp-cmp [M :vector-i64 start :i64 end :i64 r :i64 limit :i64] :i64
 (loop [j start]
  (cond (>= j end) 0
   (= (sf-word M j) (enc-cmp-i r limit)) j
   :else (recur (inc j)))))
(defn- cpp-move [w :i64] :bool
