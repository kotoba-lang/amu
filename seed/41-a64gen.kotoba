  72 (uc-row M (+ p 72) 6 1 3 0)
  73 (uc-row M (+ p 73) 4 4 9 0)
  74 (uc-row M (+ p 74) 4 5 8 0)
  75 (uc-row M (+ p 75) 4 6 7 0)
  76 (uc-row M (+ p 76) 4 7 2 0)
  77 (uc-row M (+ p 77) 3 8 0 0)
  78 (uc-row M (+ p 78) 7 1 7 0)
  79 (uc-row M (+ p 79) 11 7 (gn-sir M (+ p 90) IF-A) 0)
  80 (uc-row M (+ p 80) 4 7 8 0)
  81 (uc-row M (+ p 81) 3 8 1 0)
  82 (uc-row M (+ p 82) 7 1 7 0)
  83 (uc-row M (+ p 83) 11 7 (gn-sir M (+ p 86) IF-A) 0)
  84 (uc-row M (+ p 84) 3 7 1 0)
  85 (uc-row M (+ p 85) 10 (gn-sir M (+ p 88) IF-A) 0 0)
  86 (uc-row M (+ p 86) 9 (gn-sir M (+ p 86) IF-A) 0 0)
  87 (uc-row M (+ p 87) 3 7 -1 0)
  88 (uc-row M (+ p 88) 9 (gn-sir M (+ p 88) IF-A) 0 0)
  89 (uc-row M (+ p 89) 10 (gn-sir M (+ p 92) IF-A) 0 0)
  90 (uc-row M (+ p 90) 9 (gn-sir M (+ p 90) IF-A) 0 0)
  91 (uc-row M (+ p 91) 3 7 0 0)
  92 (uc-row M (+ p 92) 9 (gn-sir M (+ p 92) IF-A) 0 0)
  93 (uc-row M (+ p 93) 6 1 6 0)
  94 (uc-row M (+ p 94) 5 1 0 0)
  95 (uc-row M (+ p 95) 5 2 1 0)
  96 (uc-row M (+ p 96) 5 3 2 0)
  97 (uc-row M (+ p 97) 5 4 3 0)
  98 (uc-row M (+ p 98) 5 5 4 0)
  99 (uc-row M (+ p 99) 5 6 5 0)
  100 (uc-row M (+ p 100) 5 7 6 0)
  101 (uc-row M (+ p 101) 18 0 0 0)
  102 (uc-row M (+ p 102) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  103 (uc-row M (+ p 103) 9 (gn-sir M (+ p 103) IF-A) 0 0)
  104 (uc-row M (+ p 104) 19 0 0 0)
  105 (uc-row M (+ p 105) 2 f 0 0)
  false))
(defn- rb-rows [M :vector-i64 p :i64 f :i64 reader :i64 writer :i64 natural :i64 k :i64] :bool
 (if (= k 106) true (and (rb-row M p f reader writer natural k) (rb-rows M p f reader writer natural (inc k)))))
(defn- rb-bound [M :vector-i64 f :i64 n :i64 np :i64 ns :i64 dp :i64 fuel :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (not (gn-clamp-open M f)) (>= (vector-at M MM-SIR-N) n)
  (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) n))
  (= (gn-fnf M f FF-NPARAMS) np) (= (gn-fnf M f FF-NSLOTS) ns)
  (= (gn-fnf M f FF-DEPTH) dp) (= (gn-fnf M f FF-FUEL) fuel)
  (= (gn-fnf M f FF-RTYPE) TY-VEC)))
(defn- rb-masked-row [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 3 3)
  1 (uc-row M (+ p 1) 18 0 0 0)
  2 (uc-row M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (uc-row M (+ p 3) 4 0 1 0)
  4 (uc-row M (+ p 4) 4 1 2 0)
  5 (uc-row M (+ p 5) 4 2 3 0)
  6 (uc-row M (+ p 6) 3 3 255 0)
  7 (uc-row M (+ p 7) 6 5 2 0)
  8 (uc-row M (+ p 8) 14 208 0 3)
  9 (uc-row M (+ p 9) 19 0 0 0)
  10 (uc-row M (+ p 10) 2 f 0 0)
  false))
(defn- rb-masked-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 11) true (and (rb-masked-row M p f k) (rb-masked-rows M p f (inc k)))))
(defn- rb-natural-row [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 3 3)
  1 (uc-row M (+ p 1) 18 0 0 0)
  2 (uc-row M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (uc-row M (+ p 3) 4 0 1 0)
  4 (uc-row M (+ p 4) 4 1 2 0)
  5 (uc-row M (+ p 5) 4 2 3 0)
  6 (uc-row M (+ p 6) 14 208 0 3)
  7 (uc-row M (+ p 7) 19 0 0 0)
  8 (uc-row M (+ p 8) 2 f 0 0)
  false))
(defn- rb-natural-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 9) true (and (rb-natural-row M p f k) (rb-natural-rows M p f (inc k)))))
(defn- rb-writer [M :vector-i64 f :i64 masked :bool] :bool
 (let [n (if masked 11 9) dp (if masked 4 3)]
  (and (rb-bound M f n 3 3 dp 1) (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 3)
   (qb-labels M (gn-fnf M f FF-SIR) n 0)
   (if masked (rb-masked-rows M (gn-fnf M f FF-SIR) f 0) (rb-natural-rows M (gn-fnf M f FF-SIR) f 0)))))
(defn- rb-homes [M :vector-i64 j :i64 k :i64] :bool
 (if (> j 7) true
  (let [r (gn-sreg M j)] (and (>= r 19) (<= r 28)
   (if (> k 7) (rb-homes M (inc j) (+ j 2)) (and (not= r (gn-sreg M k)) (rb-homes M j (inc k))))))))
(defn- rb-locals [M :vector-i64 k :i64] :bool
 (if (> k 11) true (let [r (gn-sreg M k)] (and (or (= r -1) (and (>= r 19) (<= r 28))) (rb-locals M (inc k))))))
(defn- rb-admit [M :vector-i64 i :i64] :bool
 (let [f (gn-g M fr-owner) p (dec i)]
  (and (> i 1) (rb-bound M f 106 7 11 9 1) (= p (gn-fnf M f FF-SIR))
   (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 5)
   (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-ns) 11) (= (gn-g M gn-f-dp) 9)
   (= (gn-g M gn-f-out) 0) (> (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768)
   (rb-homes M 1 2) (rb-locals M 8) (= (vector-at M MM-ERR) 0)
   (>= (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 256))
   (let [reader (gn-sir M (+ p 23) IF-A) writer (gn-sir M (+ p 65) IF-A) natural (gn-sir M (+ p 10) IF-A)
         n (gn-sir M (+ p 4) IF-B) counter (gn-sir M (+ p 49) IF-B)
         term0 (gn-sir M (+ p 8) IF-B) term1 (gn-sir M (+ p 11) IF-B)]
    (and (> n 0) (<= n 63) (>= counter 0) (<= counter 4095) (= counter (gn-sir M (+ p 61) IF-B))
     (>= term0 0) (<= term0 4095) (>= term1 0) (<= term1 4095)
     (rb-rows M p f reader writer natural 0) (qb-labels M p 106 0)
     (qb-deps M reader) (rb-writer M writer true) (rb-writer M natural false))))))

(defn- rb-load [M :vector-i64 d :i64 s :i64] :vector-i64
 (if (< (gn-sreg M s) 0) (gn-ld M d s) (gn-mov M d (gn-sreg M s))))
(defn- rb-bit [M :vector-i64 rp :i64 x :i64 y :i64] :vector-i64
 (-> M (gn-op-fuel) (gn-emit (gn-e-lsr 16 x 3))
  (gn-mov-imm 17 (gn-sir M (+ rp 10) IF-B)) (gn-emit (enc-madd 16 y 17 16))
  (gn-mov-imm 17 (gn-sir M (+ rp 4) IF-B)) (gn-emit (enc-add-r 16 16 17))
  (gn-emit (gn-e-ldrr 10 4 16 1)) (gn-mov-imm 17 7) (gn-emit (enc-and-r 17 x 17))
  (gn-mov-imm 16 7) (gn-emit (enc-sub-r 16 16 17)) (gn-emit (enc-lsrv 10 10 16))
  (gn-mov-imm 17 1) (gn-emit (enc-and-r 10 10 17))))
(defn- rb-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) rp (gn-fnf M (gn-sir M (+ p 23) IF-A) FF-SIR)
  n (gn-sir M (+ p 4) IF-B) counter (gn-sir M (+ p 49) IF-B)
  term0 (gn-sir M (+ p 8) IF-B) term1 (gn-sir M (+ p 11) IF-B)
  last (gn-max (gn-max term0 term1) (gn-max (+ counter n) (+ (gn-sir M (+ rp 4) IF-B) (quot n 8) (* n (gn-sir M (+ rp 10) IF-B)))))
  m0 (-> M (rb-load 0 1) (rb-load 1 2) (rb-load 2 3) (rb-load 3 4) (rb-load 5 5) (rb-load 6 6) (rb-load 9 7)
   (gn-emit (enc-cmp-i 3 0)))
  initiali (vector-at m0 MM-CODE-N) m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 5 0)))
  initialh (vector-at m1 MM-CODE-N) m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 6 0)))
  initialb (vector-at m2 MM-CODE-N) m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 1 1)))
  axisbad (vector-at m3 MM-CODE-N) m4 (-> m3 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-i 2 n)))
  rowbad (vector-at m4 MM-CODE-N) m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)))
  handlebad (vector-at m5 MM-CODE-N) m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 4 7 320)) (gn-emit (gn-e-addsl 4 4 17 4)) (gn-emit (enc-ldp 17 4 4 0))
   (gn-mov-imm 16 last) (gn-emit (enc-cmp-r 16 4)))
  rangebad (vector-at m6 MM-CODE-N) m7 (-> m6 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3)))
  loopcode (vector-at m7 MM-CODE-N) m8 (gn-emit m7 (enc-cmp-i 1 0))
  axis (vector-at m8 MM-CODE-N) m9 (-> m8 (gn-emit (enc-bcond (enc-cond-ne) 0)) (rb-bit rp 3 2))
  joinbit (vector-at m9 MM-CODE-N) m10 (gn-emit m9 (enc-b 0))
  axisother (vector-at m10 MM-CODE-N) m11 (rb-bit m10 rp 2 3)
  bitdone (vector-at m11 MM-CODE-N) m12 (gn-emit m11 (enc-cmp-r 6 10))
  unequal (vector-at m12 MM-CODE-N) m13 (-> m12 (gn-emit (enc-bcond (enc-cond-ne) 0))
   (gn-mov-imm 12 counter) (gn-emit (enc-add-r 12 12 5))
   (gn-emit (gn-e-ldrr 11 4 12 1)) (gn-emit (enc-add-i 11 11 1)))
  joinlen (vector-at m13 MM-CODE-N) m14 (gn-emit m13 (enc-b 0))
  different (vector-at m14 MM-CODE-N) m15 (-> m14 (gn-emit (enc-add-i 5 5 1)) (gn-mov-imm 11 1))
  lendone (vector-at m15 MM-CODE-N) m16 (-> m15 (gn-op-fuel) (gn-mov-imm 12 counter)
   (gn-emit (enc-add-r 12 12 5)) (gn-mov-imm 16 255) (gn-emit (enc-and-r 11 11 16))
   (gn-emit (gn-e-strr3 11 4 12)) (gn-emit (enc-cmp-i 1 0)))
  skipbw (vector-at m16 MM-CODE-N) m17 (-> m16 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 10 1)))
  minus (vector-at m17 MM-CODE-N) m18 (-> m17 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-add-i 9 9 1)))
  joinbw (vector-at m18 MM-CODE-N) m19 (gn-emit m18 (enc-b 0))
  negative (vector-at m19 MM-CODE-N) m20 (gn-emit m19 (enc-sub-i 9 9 1))
  bwdone (vector-at m20 MM-CODE-N) m21 (-> m20 (gn-mov 6 10) (gn-emit (enc-add-i 3 3 1))
   (gn-op-fuel) (gn-emit (enc-cmp-i 3 n)))
  back (vector-at m21 MM-CODE-N) m22 (-> m21 (gn-emit (enc-bcond (enc-cond-ne) (- loopcode back)))
   (gn-op-fuel) (gn-mov-imm 12 term0) (gn-emit (gn-e-strr3 5 4 12))
   (gn-op-fuel) (gn-mov-imm 12 term1) (gn-emit (gn-e-strr3 9 4 12)) (gn-epilogue) (gn-gs gn-f-dead 0))
  fallback (vector-at m22 MM-CODE-N)]
  (-> m22 (gn-dot-patch initiali fallback (enc-cond-ne)) (gn-dot-patch initialh fallback (enc-cond-ne))
   (gn-dot-patch initialb fallback (enc-cond-ne)) (gn-dot-patch axisbad fallback 8)
   (gn-dot-patch rowbad fallback (enc-cond-hs)) (gn-dot-patch handlebad fallback (enc-cond-hs))
   (gn-dot-patch rangebad fallback (enc-cond-hs)) (gn-dot-patch axis axisother (enc-cond-ne))
   (gn-put (+ MM-CODE-BASE joinbit) (enc-b (- bitdone joinbit))) (gn-dot-patch unequal different (enc-cond-ne))
   (gn-put (+ MM-CODE-BASE joinlen) (enc-b (- lendone joinlen))) (gn-dot-patch skipbw bwdone (enc-cond-ne))
   (gn-dot-patch minus negative (enc-cond-ne)) (gn-put (+ MM-CODE-BASE joinbw) (enc-b (- bwdone joinbw))))))
(defn- rb-entry [M :vector-i64 i :i64] :vector-i64
 (if (rb-admit M i) (rb-emit M i) M))

;; Generic closed packed-bit neighborhood score; every original executed debit retained.
(defn- qb-owner-row [M :vector-i64 p :i64 f :i64 reader :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 4 6)
  1 (uc-row M (+ p 1) 18 0 0 0)
  2 (uc-row M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (uc-row M (+ p 3) 4 0 2 0)
  4 (uc-row M (+ p 4) 3 1 (gn-sir M (+ p 4) IF-B) 0)
  5 (uc-row M (+ p 5) 7 1 0 0)
  6 (uc-row M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
  7 (uc-row M (+ p 7) 4 0 4 0)
  8 (uc-row M (+ p 8) 10 (gn-sir M (+ p 65) IF-A) 0 0)
  9 (uc-row M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (uc-row M (+ p 10) 4 0 1 0)
  11 (uc-row M (+ p 11) 4 1 2 0)
  12 (uc-row M (+ p 12) 4 2 3 0)
  13 (uc-row M (+ p 13) 13 reader 0 3)
  14 (uc-row M (+ p 14) 5 5 0 0)
  15 (uc-row M (+ p 15) 4 0 5 0)
  16 (uc-row M (+ p 16) 4 1 1 0)
  17 (uc-row M (+ p 17) 4 2 2 0)
  18 (uc-row M (+ p 18) 3 3 1 0)
  19 (uc-row M (+ p 19) 6 1 2 0)
  20 (uc-row M (+ p 20) 4 3 3 0)
  21 (uc-row M (+ p 21) 13 reader 1 3)
  22 (uc-row M (+ p 22) 7 1 0 0)
  23 (uc-row M (+ p 23) 11 0 (gn-sir M (+ p 43) IF-A) 0)
  24 (uc-row M (+ p 24) 4 0 5 0)
  25 (uc-row M (+ p 25) 4 1 1 0)
  26 (uc-row M (+ p 26) 4 2 2 0)
  27 (uc-row M (+ p 27) 4 3 3 0)
  28 (uc-row M (+ p 28) 3 4 1 0)
  29 (uc-row M (+ p 29) 6 1 3 0)
  30 (uc-row M (+ p 30) 13 reader 1 3)
  31 (uc-row M (+ p 31) 7 1 0 0)
  32 (uc-row M (+ p 32) 11 0 (gn-sir M (+ p 43) IF-A) 0)
  33 (uc-row M (+ p 33) 4 0 5 0)
  34 (uc-row M (+ p 34) 4 1 1 0)
  35 (uc-row M (+ p 35) 4 2 2 0)
  36 (uc-row M (+ p 36) 3 3 1 0)
  37 (uc-row M (+ p 37) 6 1 2 0)
  38 (uc-row M (+ p 38) 4 3 3 0)
  39 (uc-row M (+ p 39) 3 4 1 0)
  40 (uc-row M (+ p 40) 6 1 3 0)
  41 (uc-row M (+ p 41) 13 reader 1 3)
  42 (uc-row M (+ p 42) 7 1 0 0)
  43 (uc-row M (+ p 43) 9 (gn-sir M (+ p 43) IF-A) 0 0)
  44 (uc-row M (+ p 44) 5 6 0 0)
  45 (uc-row M (+ p 45) 4 0 1 0)
  46 (uc-row M (+ p 46) 4 1 2 0)
  47 (uc-row M (+ p 47) 3 2 1 0)
  48 (uc-row M (+ p 48) 6 1 1 0)
  49 (uc-row M (+ p 49) 4 2 3 0)
  50 (uc-row M (+ p 50) 4 3 4 0)
  51 (uc-row M (+ p 51) 4 4 6 0)
  52 (uc-row M (+ p 52) 11 4 (gn-sir M (+ p 55) IF-A) 0)
  53 (uc-row M (+ p 53) 3 4 (gn-sir M (+ p 53) IF-B) 0)
  54 (uc-row M (+ p 54) 10 (gn-sir M (+ p 57) IF-A) 0 0)
  55 (uc-row M (+ p 55) 9 (gn-sir M (+ p 55) IF-A) 0 0)
  56 (uc-row M (+ p 56) 3 4 0 0)
  57 (uc-row M (+ p 57) 9 (gn-sir M (+ p 57) IF-A) 0 0)
  58 (uc-row M (+ p 58) 6 1 3 0)
  59 (uc-row M (+ p 59) 5 1 0 0)
  60 (uc-row M (+ p 60) 5 2 1 0)
  61 (uc-row M (+ p 61) 5 3 2 0)
  62 (uc-row M (+ p 62) 5 4 3 0)
  63 (uc-row M (+ p 63) 18 0 0 0)
  64 (uc-row M (+ p 64) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  65 (uc-row M (+ p 65) 9 (gn-sir M (+ p 65) IF-A) 0 0)
  66 (uc-row M (+ p 66) 19 0 0 0)
  67 (uc-row M (+ p 67) 2 f 0 0)
  false))
(defn- qb-owner-rows [M :vector-i64 p :i64 f :i64 reader :i64 k :i64] :bool
 (if (= k 68) true (and (qb-owner-row M p f reader k) (qb-owner-rows M p f reader (inc k)))))
(defn- qb-reader-row [M :vector-i64 p :i64 f :i64 rem :i64 weight :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 3 3)
  1 (uc-row M (+ p 1) 18 0 0 0)
