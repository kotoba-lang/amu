;; ---- lp (kernels B, round 3): sglib-combined list merge sort. (list-pass v n) starts a pass over the list at v[1] (nodes
;; d(id, f) = 197 + 3 id + f: value, next, prev): v[1] := 0, then list-todo cuts runs of n with nth-node, list-merge merges
;; two runs into ref (the smaller value first, ties to the right run), tail-ref finds the new end, and the next pair
;; follows; a pass that merged anything ends in (list-pass v 2n), the one that merged nothing returns v. Charges: one per
;; call of list-pass, list-todo, list-merge, nth-node, tail-ref and per step of their loops, one per put. Non-leaf (fuel
;; in memory, freg 0 or 2). Fast path when v is valid with |v| >= 500, 1 <= n <= 2^20 and the list from v[1] is at most
;; 100 nodes with ids in [1, 100] (so every pass is bounded and only next fields and ref cells change): a pass starts
;; while the fuel covers 1200 more (else the generic body takes that pass with n); the last pass returns v.
(defn- lp-shape? [M :vector-i64 p :i64 f :i64] :bool
 (let [pt (gn-sir M (+ p 10) IF-A) ltd (gn-sir M (+ p 15) IF-A) q (mmx-q M ltd) nn (gn-sir M (+ q 23) IF-A)
         dd (gn-sir M (+ q 50) IF-A) lm (gn-sir M (+ q 100) IF-A) tr (gn-sir M (+ (mmx-q M lm) 93) IF-A)]
  (and (> q 0) (> (mmx-q M nn) 0) (> (mmx-q M dd) 0) (> (mmx-q M lm) 0) (> (mmx-q M tr) 0) (> (mmx-q M pt) 0)
                  (kpat-match M p [844437814378497 18 4229300233 4294967300 4295032835 562949964955662 196613 4294967300 4295032835 131075 844429224378381 12884967428 4295098371 8590131204 262147 1407379177734157 19 4294311938] [f pt ltd])
