             (gn-mov-imm 16 71960) (gn-emit (enc-add-r 16 14 16)) (gn-emit (enc-ldr 4 16 0))
             (gn-mov-imm 5 1103515245) (gn-mov-imm 6 12345) (gn-mov-imm 12 20165) (gn-emit (pz-tbz 9 0 13))
             (gn-emit (enc-madd 13 4 5 6)) (gn-emit 0x924079A4) (gn-emit (enc-mov-r 13 4)) (lcg-byte 13 0)
             (gn-emit 0xF80085ED) (gn-emit (enc-sub-i 9 9 1)) (gn-emit (enc-cbz 9 0))) b1 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-madd 13 4 5 6)) (gn-emit 0x924079AD) (gn-emit (enc-madd 0 13 5 6)) (gn-emit 0x92407804)
             (gn-emit (enc-mov-r 1 4)) (lcg-byte 13 0) (lcg-byte 1 2)
             (gn-emit 0xA88105ED) (gn-emit (enc-subs-i 9 9 2))) b2 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-ne) (- (inc (dec b1)) b2)))) done (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-put (+ MM-CODE-BASE (dec b1)) (enc-cbz 9 (- done (dec b1))))
             (gn-emit (enc-str 4 16 0)) (gn-mov ri rl)
             (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)) (kb-keep)) cold (vector-at m5 MM-CODE-N)]
