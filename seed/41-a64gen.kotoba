;; a one-parameter non-leaf stage function at p with its SIR through p + n, v in a callee-saved register
(defn- kb-stage? [M :vector-i64 p :i64 f :i64 n :i64] :bool
 (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
      (= (gn-fnf M f FF-SIR) p) (< (+ p n) (vector-at M MM-SIR-N)) (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-g M gn-f-leaf) 0) (or (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-freg) 2))
      (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
      (>= (gn-sreg M 1) 19) (<= (gn-sreg M 1) 28)))
;; ---- qq (kernels B, step 2): sglib (queue-stage v): v[5] := 0, v[6] := 0, queue-add (v[720 + i] := (input i), v[6] := 100),
;; queue-drain from 0 to 100 (v[0] += v[720 + i], i := (i + 1) rem 101, v[5] := 100): 406 charges. Non-leaf (freg 0 or 2).
;; Fast path when |v| >= 820 and the fuel exceeds 406: the values are written to v[720 ..], then read back from there in
;; order and summed into v[0] (written once; the two zero puts are overwritten by the final ones).
(defn- qq-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A) rv (gn-sreg M 1)]
  (if (not (kb-stage? M p f 16)) M
   (let [pt (gn-sir M (+ p 6) IF-A) qa (gn-sir M (+ p 11) IF-A) qd (gn-sir M (+ p 14) IF-A)
         inp (gn-sir M (+ (mmx-q M qa) 18) IF-A) rm (gn-sir M (+ (mmx-q M qd) 29) IF-A)]
    (if (not (and (> (mmx-q M pt) 0) (> (mmx-q M qa) 0) (> (mmx-q M qd) 0) (kb-rem? M rm)
                  (kpat-match M p [281483565989889 18 4229300233 4294967300 21474902019 131075 844429224378381 25769869315 131075 844429224378381 65539 562954247602189 65539 429496860675 844429224247309 19 4294311938] [f pt qa qd])
                  (kpat-match M (mmx-q M qa) [562962837667841 18 4229300233 8589934596 429496795139 65543 277128469807115 4294967300 25769869315 8590065668 844429224312845 4227661834 4228644873 4294967300 3092376518659 8590065668 4295032838 8590065668 281487860891661 844429224312845 8590000132 4295098371 4295032838 65541 4295098373 18 4229300234 4227661833 19 4294311938] [qa inp pt])
                  (kpat-match M (mmx-q M qd) [844442109345793 18 4229300233 8589934596 12884967428 65543 277128469807115 4294967300 21474902019 8590065668 844429224378381 4227072010 4228644873 4294967300 65539 4295098372 196611 562958554890254 4295163908 3092376715267 8590262276 17179934726 562962849857550 8590000134 844429224378381 8590000132 4295098371 4295032838 433791827971 562958542569485 12885032964 65541 4295098373 8590131205 18 4229300234 4227072009 19 4294311938] [qd pt rm])
                  (kpat-match M (mmx-q M pt) [844442109345793 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294311938] [pt]))) M
     (let [lin (sg-input-lit M inp)]
      (if (= lin 0) M
       (let [G (vector-alloc 9)
             m0 (-> M (kb-vec G rv 10 0) (gn-mov-imm 16 820) (gn-emit (enc-cmp-r 10 16)) (ri-cold G (enc-cond-lo))
                  (ab-lit 3 lin) (gn-emit (enc-ldr 4 7 CTX-FUEL))
                  (kb-words G [0xF106589F 10 0x912D0009 0x912D0129 0xD280064A 0xA8C1346C 0xA881352C 0xF100054A 0x54FFFFA1 0xD2800C8C 0xF900180C 0xD10C8129 0xF940000B 0xD280064A 0xA8C1352C 0x8B0C016B 0x8B0D016B 0xF100054A 0x54FFFF81 0xF900000B 0xD2800C8C 0xF900140C 0xD28032C5])
                  (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-sub-r 16 16 5)) (gn-emit (enc-str 16 7 CTX-FUEL))
                  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov 0 rv))
             m1 (-> m0 (gn-epilogue) (kb-keep) (gn-gs gn-f-dead 0))]
        (ri-patch m1 G 0 (vector-at m1 MM-CODE-N))))))))))
;; ---- hb (kernels B, step 2): sglib (hash-build v i) for i .. 99 in place: value = (input i), bucket = 700 + value rem 20,
;; (hash-find v v[bucket] value) walks the chain reading h(id, 0) and h(id, 1) (one charge per call and per step); when it
;; does not meet the value, id = i + 1 gets h(id, 0) := value, h(id, 1) := the old head, v[bucket] := id and v[3] += 16
;; (four puts); one recur charge per i. Non-leaf (slots in callee-saved registers, fuel in memory, freg 0 or 2). Each i runs
;; in the kernel when |v| >= 720, fuel >= 110, the value is >= 0 and its walk stays on ids in [1, 100] for at most 101
;; steps; otherwise that i's start state goes to the loop head (which also returns v at i = 100).
(defn- hb-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A) rv (gn-sreg M 1) ri (gn-sreg M 2)]
  (if (not (hp-head M p f 78)) M
   (let [inp (gn-sir M (+ p 11) IF-A) rm (gn-sir M (+ p 16) IF-A) hf (gn-sir M (+ p 26) IF-A) hh (gn-sir M (+ p 48) IF-A)
         pt (gn-sir M (+ p 50) IF-A) hb f]
    (if (not (and (> (mmx-q M hf) 0) (> (mmx-q M hh) 0) (> (mmx-q M pt) 0) (kb-rem? M rm)
                  (kpat-match M (mmx-q M hb) [1970337721221121 18 4229300233 8589934596 429496795139 65543 277141354709003 4294967300 4224450570 4228841481 8589934596 281479270957069 196613 3006477107203 12884967428 85899476995 562958542569485 65542 262149 4294967300 17179934724 562949964955662 327685 4294967300 21474902020 12885032964 844429224247309 65539 65543 65544 277008210722827 4294967300 8590000132 4295098371 4295032838 65541 4295098373 18 4229300234 4224516106 4226809865 8589934596 4295032835 65542 393221 4294967300 25769869316 131075 562958542438413 12885032964 844429224116237 25769869316 4295098371 562958542438413 21474967556 844429224116237 17179934724 25769934852 844429224116237 12884967427 4295098372 12885098499 562958554890254 68719673347 8590000134 844429224116237 458757 30064771076 8590000132 4295098371 4295032838 65541 4295098373 18 4229300234 4224516105 4224450569 19 4294311938] [hb inp rm hf hh pt])
                  (kpat-match M (mmx-q M hf) [844442109345793 18 4229300233 8589934596 65539 65543 277119879872524 4294967300 8590000132 131075 562958542635021 562949964955662 12884967428 65543 4228513801 277102700003339 8589934596 4227399690 4228251657 4294967300 4295032836 8590065668 4295163907 562962837602317 562954259922958 12885032964 65541 4295098373 8590131205 18 4229300234 4227399689 19 4294311938] [hf hh])
                  (kpat-match M (mmx-q M hh) [562962837667841 4229365769 2147483648003 4295032836 4295098371 4295098374 8590065667 4295163910 65542 8590000132 65542 19 4294311938] [hh])
                  (kpat-match M (mmx-q M pt) [844442109345793 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294311938] [pt]))) M
     (let [lin (sg-input-lit M inp)]
      (if (= lin 0) M
       (let [G (vector-alloc 9)
             m0 (-> M (kb-vec G rv 3 0) (gn-mov 1 ri) (ab-lit 2 lin) (gn-emit (enc-ldr 4 7 CTX-FUEL))
                  (kb-words G [0xD2805A09 0xEB09007F 4 0xD280028F 0x913E4010 0x91400411 0x91178231 0xF101903F 0x540004E2 0xF101B89F 0x540004AB 0xF8617845 0xB7F80465 0x9ACF08A6 0x9B0F94C6 0xF8667A29 0xAA0903EA 0xD280000B 0xB400022A 0xD100054C 0xF1018D9F 0x54000348 0x8B0A120C 0xF940018D 0xEB0501BF 0x540000C0 0xF940058A 0x9100056B 0xF101957F 0x54000248 0x17FFFFF4 0x9100096B 0xCB0B0084 0x91000421 0x17FFFFE5 0x9100042C 0x8B0C120D 0xF90001A5 0xF90005A9 0xF8267A2C 0xF9400C0E 0x910041CE 0xF9000C0E 0x9100196B 0xCB0B0084 0x91000421 0x17FFFFD9])
                  (gn-emit (enc-str 4 7 CTX-FUEL)) (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov ri 1)
                  (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)) (kb-keep))]
        (ri-patch m0 G 0 (vector-at m0 MM-CODE-N))))))))))
;; ---- sf (kernels B, step 3): nettle-sha256 (compress v k base record) with record false: a FUSION of schedule's loop and
;; rounds' loop (allowed loop fusion: every read, write, decision and charge of both loops happens, each w[i] is computed
;; from schedule's own reads and put to v[64 + i] before round i reads it). w[0 .. 15] = (word-at v 0 i) are made from
;; the bytes v[4i .. 4i + 3] and put first; round i (h + big1 e + choice + k[i] + w[i] -> e, a with big0 and the
;; majority, all mod 2^32) reads k[i] and v[64 + i]; with rounds 4j .. 4j + 3 (j < 12) the schedule makes w[4j + 16 ..
;; 4j + 19] = small1 w[t - 2] + w[t - 7] + small0 w[t - 15] + w[t - 16] (mod 2^32) in four 32-bit NEON lanes (lanes 0, 1
;; first; lanes 2, 3 after them, since they read w[4j + 16], w[4j + 17]) from the window of the last 16 words kept in
;; registers, and puts them to v[64 + t]; then finish adds a .. h into v[128 .. 135]. The charges are fixed: schedule
;; 433 (1, 3 per word-at word, 8 per expanded word), rounds 586 (1, 9 per round, finish 9). Non-leaf (slots in
;; callee-saved registers, fuel in memory, freg 0 or 2; x19 .. x28 saved on the frame). Fast path when record is false,
;; |v| >= 136, |k| >= 64, the fuel exceeds 1019, the message bytes v[0 .. 63] are in [0, 255] and the state
;; v[128 .. 135] and k[0 .. 63] are below 2^32 (so every word stays 32-bit and the 32-bit rotates are exact); it returns
;; v. Otherwise the original code runs.
(defn- sf-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A) rv (gn-sreg M 1) rk (gn-sreg M 2) rr4 (gn-sreg M 4)]
  (if (not (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
                (= (gn-fnf M f FF-SIR) p) (< (+ p 56) (vector-at M MM-SIR-N)) (= (gn-fnf M f FF-PT0) TY-VEC)
                (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f (+ FF-PT0 1)) TY-VEC) (= (gn-fnf M f (+ FF-PT0 3)) TY-BOOL)
                (= (gn-g M gn-f-leaf) 0) (or (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-freg) 2))
                (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
                (>= rv 19) (<= rv 28) (>= rk 19) (<= rk 28) (>= rr4 19) (<= rr4 28))) M
   (let [sc (gn-sir M (+ p 5) IF-A) ro (gn-sir M (+ p 34) IF-A) snc (gn-sir M (+ p 43) IF-A)
         wa (gn-sir M (+ (mmx-q M sc) 17) IF-A) s1 (gn-sir M (+ (mmx-q M sc) 27) IF-A) s0 (gn-sir M (+ (mmx-q M sc) 43) IF-A)
         m32 (gn-sir M (+ (mmx-q M sc) 53) IF-A) pt (gn-sir M (+ (mmx-q M sc) 61) IF-A)
         fi (gn-sir M (+ (mmx-q M ro) 16) IF-A) b1 (gn-sir M (+ (mmx-q M ro) 42) IF-A) b0 (gn-sir M (+ (mmx-q M ro) 59) IF-A)
