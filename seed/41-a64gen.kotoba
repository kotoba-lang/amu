(defn- qb-reader-rows [M :vector-i64 p :i64 f :i64 rem :i64 weight :i64 k :i64] :bool
 (if (= k 30) true (and (qb-reader-row M p f rem weight k) (qb-reader-rows M p f rem weight (inc k)))))
