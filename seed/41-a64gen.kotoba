(defn- cpp-arg [M :vector-i64 j :i64 start :i64 arg :i64] :i64
 (if (or (<= j start) (< (- j start) 1) (> (- j start) 16)) -1
  (let [w (sf-word M (dec j)) d (scn-defs w)]
   (if (or (< d 0) (>= (hld-target M (dec j)) 0) (= w 0)
