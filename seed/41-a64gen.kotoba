;; ---- lcg (kernels B): the seeded name loop (name v base len i) = (if (= i len) v (let [seed (bit-and (+ (* v[8995] a) c)
;; m) byte (+ 65 (rem (seed >>u 16) 26))] (name (put (put v 8995 seed) (+ base i) byte) base len (+ i 1)))) with
;; a = 1103515245, c = 12345, m = 2^31 - 1 (non-leaf: v base len i in callee-saved registers, fuel in memory). Per item
;; the original charges both puts and the recur (3). Fast path (at the entry, after the entry charge): 0 <= i <= len,
;; base >= 0, a valid handle with 8995 < n and base + len <= n, 8995 outside [base + i, base + len) and fuel >= 3 (len - i):
;; then nothing can trap and v[8995] is only rewritten by the loop, so the seed stays in x4 (stored once at the end),
;; two seeds per step, each by madd from the one before (s1 = a s + c, s2 = a s1 + c, masked to 31 bits as the original),
;; x = s >> 16 < 2^15, x quot 26 = (x * 20165) >> 19 (exact below 2^15), and the bytes
;; are stored in order; i := len and the loop head returns v. x0-x6, x8-x17 only (the descriptor cache stays as at entry).
(defn- lcg-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A) rf (gn-sir M (+ p 25) IF-A) w (gn-sir M (+ p 31) IF-A)]
  (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-ctx) 1)
       (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
       (loop [k 1] (or (= k 5) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28) (recur (inc k)))))
       (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2)) (kb-rem? M rf) (pz-writer M w)
       (kpat-match M p [1688871334445057 18 4229300233 17179869188 12884967428 65543 277141354709003 4294967300 4226285578 4228841481 4294967300 38633230893059 562949964955662 281419142201347 196614 53021371334659 65542 281414847234051 327686 327685 279172874243 21474902020 68719607811 4295557126 111669280771 562958542635021 65542 393221 4294967300 38633230893059 21474967556 844429224312845 8590000132 17180000260 4295032838 25769934852 844429224312845 8590000132 12885032964 17180065796 4295229443 12884967430 65541 4295098373 8590131205 12885164037 18 4229300234 4226285577 19 4294311938] [f rf w 1103515245 2147483647]))))
;; one byte from x4 (the seed) or the pair's second seed in x(b) to x(d): lsr, quotient by 20165 >> 19, x - 26 q, + 65
(defn- lcg-byte [M :vector-i64 d :i64 q :i64] :vector-i64
 (-> M (gn-emit (gn-e-lsr d d 16)) (gn-emit (enc-mul q d 12)) (gn-emit (gn-e-lsr q q 19))
  (gn-emit (+ (enc-sub-r d d q) 4096)) (gn-emit (+ (enc-sub-r d d q) 3072)) (gn-emit (+ (enc-sub-r d d q) 1024))
  (gn-emit (enc-add-i d d 65))))
