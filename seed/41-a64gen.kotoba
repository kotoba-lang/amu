;; ---- prk (kernels B, step 4): qrduino (pattern-runs v len i score) from its entry: per step, as the source, n = v[1728 + i],
;; a = v[1727 + i], same = (v[1726 + i] = v[1730 + i] = a = v[1729 + i] and 3a = n), white = (v[1725 + i] = 0 or
;; i + 3 > len or 3 v[1725 + i] >= 4n or 3 v[1731 + i] >= 4n), score + 40 when both, i + 2, one recur charge. The
;; step's seven run lengths are a register window (every one read, two new per step; the comparisons are all made,
;; without the short circuit). Leaf (slots x0 .. x3, private fuel x8; a stable-local descriptor cache, vmode 3, keeps
;; its registers x19 and up, which the block does not touch, and its flag cleared by the prologue). Runs when -1725 <= i, len - 1 - i <= 2^20, the
;; fuel covers the k steps and v[1733 + last i] lies in v; then the k charges are paid and i, score go to the loop head
;; (which returns score); otherwise the loop head runs the original. The whole SIR is certified.
(defn- prk-pat [] :vector-i64 (qrow-pattern-copy (qrow-pattern-copy (qrow-pattern-copy (vector-alloc 140) [2251821287866369 18 4229300233 12884901892 8590000132 4295098371 4295098374 327687 277132764774411 17179869188 4220452874 4228710409 4294967300 7421703553027 12885032964 4295032838 562949964955662 327685 4294967300 7421703553027 12885032964 4295032838 281427732201475 4295032838 562949964955662 393221 4294967300 7421703553027 12885032964 4295032838 281466386907139 4295032838 562949964955662 4295032836 7421703618563 12885098500 8590000134 8590131203 8590000134 562954259922958 65543 276892246605835 4294967300 7421703553027 12885032964 4295032838 8590065667 4295032838 562949964955662 25769869316 65543 276892246605835 25769803780 4295032836 7421703618563 12885098500 8590000134 4295163907 8590000134 562954259922958 65543 276892246605835 25769803780 12884967427] 0 0) [196614 21474902020 65543 4225040393 458757 4294967300 7421703553027 12885032964 4295032838 281462091939843 4295032838 562949964955662 65539 65543 276698973077516 12884901892 12884967427 65542 8590000132 196615 276698973077516 4294967300 7421703553027 12885032964 4295032838 281462091939843 4295032838 562949964955662 12884967427 196614 21474902020 17180000259 4295163910 327687 276698973077516 4294967300 7421703553027 12885032964 4295032838 12885032963 4295032838 562949964955662 12884967427 196614 21474902020 17180000259 4295163910 327687 4222091273 524293 4294967300 8590000132 12885032964 8590131203 8590000134 17180065796 30065033220 276651728699403 34360000516 4221370377 276634548830219 171798953987 4220977162 4221108233] 64 0) [262147 4220977161 12884967430 65541 4295098373 8590131205 12885164037 18 4229300234 4220452873 19 4294311938] 128 0))
(defn- prk-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A)]
  (if (not (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
                (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
                (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) 3))
                (loop [s 1] (or (> s 4) (and (= (gn-sreg M s) (dec s)) (recur (inc s)))))
                (kpat-match M p (prk-pat) [f -1]))) M
   (let [G (vector-alloc 5)
         m0 (-> M (kb-vec G 0 10 11)
              (kb-words G [0xD1000429 0xEB09005F 0x5400086A 0x9280D78C 0xEB0C005F 0x5400080B 0xCB02012C 0xD2A0020D 0xEB0D019F 0x54000788 0x9100058C 0xD341FD8C 0xEB0C011F 0x5400070B 0xD100058D 0x8B0D044D 0xD280D8AE 0x8B0E01AD 0xEB0A01BF 0x54000642 0xCB0C0108 0xD280D80E 0x8B0201CE 0x8B0E0D6E 0xF85E81C4 0xF85F01C5 0xF85F81C6 0xF94001CB 0xF94005CF 0xF94009D0 0xF9400DD1 0xD280050D 0xCA1000A9 0xCA06020C 0xAA0C0129 0xCA0F00CC 0xAA0C0129 0x8B0604CC 0xCA0B018C 0xAA0C0129 0xD37EF56C 0x8B04048A 0xEB0C015F 0x9A9FB7EA 0x91000C42 0xEB01005F 0x9A8AD54A 0xD1000C42 0xF100009F 0x9A8A154A 0x8B110624 0xEB0C009F 0x9A8AB54A 0xF100013F 0xFA400944 0x9A9F11AC 0x8B0C0063 0xAA0603E4 0xAA0B03E5 0xAA0F03E6 0xAA1003EB 0xAA1103EF 0xF94011D0 0xF94015D1 0x910041CE 0x91000842 0xD1000429 0xEB09005F 0x54FFFB8B])
              (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)) (kb-keep))]
    (ri-patch m0 G 0 (vector-at m0 MM-CODE-N))))))
;; ---- sg (kernels B, round 3): sglib-combined.
;; (input i) as a chain of (if (= i k) value_k ..) for k = 0 .. 99 in order, default last: a new literal with the 100
;; values (8 bytes 0xff after them, never an ASCII literal), or 0 when f is not that chain or the tables are full
(defn- sg-input-case? [M :vector-i64 q :i64 k :i64] :bool
 (let [c (+ q 2 (* 7 k)) l (gn-sir M (+ c 3) IF-B) e (gn-sir M (+ c 5) IF-A)]
  (and (gn-dot-at? M c OP-LGET 0 1 0) (gn-dot-at? M (+ c 1) OP-CONST 1 k 0) (gn-dot-at? M (+ c 2) OP-CMP CC-EQ 0 0)
       (gn-dot-at? M (+ c 3) OP-BRZ 0 l 0) (= (gn-op M (+ c 4)) OP-CONST) (= (gn-sir M (+ c 4) IF-A) 0)
       (= (gn-sir M (+ c 4) IF-C) 0) (gn-dot-at? M (+ c 5) OP-BR e 0 0) (fo-label? M l (+ c 6))
       (> e 0) (< e MM-LABEL-CAP) (>= (gn-lpos M e) (+ q 703)) (<= (gn-lpos M e) (+ q 802)))))
(defn- sg-input-lit [M :vector-i64 f :i64] :i64
 (let [q (mmx-q M f) lit (vector-at M MM-LIT-N) lb (vector-at M MM-LITB-N)]
  (if (not (and (> q 0) (< (+ q 805) (vector-at M MM-SIR-N)) (gn-dot-at? M q OP-FN f 1 1) (= (gn-op M (inc q)) OP-LABEL)
                (loop [k 0] (or (= k 100) (and (sg-input-case? M q k) (recur (inc k)))))
                (= (gn-op M (+ q 702)) OP-CONST) (= (gn-sir M (+ q 702) IF-A) 0)
                (loop [k 703] (or (= k 803) (and (= (gn-op M (+ q k)) OP-LABEL) (recur (inc k)))))
                (gn-dot-at? M (+ q 803) OP-RET 0 0 0) (gn-dot-at? M (+ q 804) OP-END f 0 0)
                (< (inc lit) MM-LIT-CAP) (<= (+ lb 808) MM-LITB-CAP))) 0
   (let [M1 (loop [k 0 m M] (if (= k 100) m (recur (inc k) (t2-bytes8 m (+ lb (* 8 k)) (gn-sir M (+ q 6 (* 7 k)) IF-B)))))
         r (+ MM-LIT-BASE (* lit MM-LIT-W))]
    (let [M2 (-> M1 (t2-bytes8 (+ lb 800) -1) (gn-put (+ r LF-B) lb) (gn-put (+ r LF-LEN) 808) (gn-put (+ r LF-POOL) 0)
                 (gn-put (+ r LF-TOK) 0) (gn-put MM-LIT-N (inc lit)) (gn-put MM-LITB-N (+ lb 808)))]
     (if (= (vector-at M2 MM-LIT-N) (inc lit)) lit 0))))))
;; ---- tb: (tree-build v i): for i .. 99, (tree-find v v[2] (input i)); when absent the node id = i + 1 gets its value,
;; empty children and v[3] + 24, (tree-insert v 2 id) (red-black insertion, tree-fix on the way up under a black
;; parent) and the root turns black. Charges: tree-find 1 + steps; found: +1; else 4 puts, tree-insert one per level,
;; 2 base puts, per tree-fix 1 + its red calls (short-circuit order) + its puts, the blackening put, the recur.
;; Non-leaf (slots in callee-saved registers, fuel in memory; with freg 2 also in x8, reloaded at the exit). Fast path when
;; v is valid with |v| >= 1300, 0 <= i <= 100,
;; v[2] and every child field of the nodes 0 .. 100 lies in [0, 100] (all t(id, f) then lie in [896, 1299], and every
;; store keeps it so): per iteration, while the fuel covers 1400 more, tree-find's search runs and records its path
;; (ref, node, side); a walk past 101 levels or through the new node leaves the iteration to the loop head. When the
;; value is absent: the four puts, then tree-insert's own descent (per level v[ref], v[t(id, 0)], v[t(root, 0)] and the
;; decision with the tie rule), its loads addressed from the recorded path so the levels overlap, each root and decision
;; checked against it (a difference redoes the descent level by level); the leaf puts and, on the way up, tree-fix at
;; each black root, then the blackening put. The used charges are paid and the loop head goes on from i.
(defn- tb-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A) rv (gn-sreg M 1) ri (gn-sreg M 2)]
  (if (not (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
                (= (gn-fnf M f FF-SIR) p) (< (+ p 87) (vector-at M MM-SIR-N)) (= (gn-fnf M f FF-PT0) TY-VEC)
                (= (gn-g M gn-f-leaf) 0) (or (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-freg) 2)) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
                (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2))
                (>= rv 19) (<= rv 28) (>= ri 19) (<= ri 28))) M
   (let [inp (gn-sir M (+ p 11) IF-A) tfd (gn-sir M (+ p 18) IF-A) tt (gn-sir M (+ p 40) IF-A) pt (gn-sir M (+ p 42) IF-A)
         tin (gn-sir M (+ p 64) IF-A) tfx (gn-sir M (+ (mmx-q M tin) 83) IF-A) rd (gn-sir M (+ (mmx-q M tfx) 33) IF-A)]
    (if (not (and (> (mmx-q M tfd) 0) (> (mmx-q M tt) 0) (> (mmx-q M pt) 0) (> (mmx-q M tin) 0) (> (mmx-q M tfx) 0)
                  (> (mmx-q M rd) 0)
