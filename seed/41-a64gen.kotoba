   (gn-emit (+ (enc-add-i 9 7 400) 0x20000000)) (hld-guard G (enc-cond-hs))
   (gn-emit (enc-mov-sp 12 31)) (gn-emit (+ (enc-add-i 17 29 16) 0x20000000)) (hld-guard G (enc-cond-hs))
   (hld-disjoint G 7 9 12 17)
   (gn-emit (enc-ldr 11 7 312)) (gn-emit (+ (enc-add-i 13 11 8) 0x20000000)) (hld-guard G (enc-cond-hs))
   (hld-disjoint G 11 13 7 9) (hld-disjoint G 11 13 12 17)
   (gn-emit (enc-ldr 16 11 0)) (gn-mov-imm 15 67108864)
   (gn-emit (enc-cmp-r 16 15)) (hld-guard G (enc-cond-hs))
   (gn-emit (enc-sub-i 13 0 1)) (gn-emit (enc-cmp-r 13 16)) (hld-guard G (enc-cond-hs))
   (gn-emit (enc-ldr 15 7 320)) (gn-emit (+ (gn-e-addsl 16 15 16 4) 0x20000000)) (hld-guard G (enc-cond-hs))
   (hld-disjoint G 15 16 7 9) (hld-disjoint G 15 16 12 17)
   (gn-emit (gn-e-addsl 12 15 13 4)) (gn-emit (enc-ldp 12 13 12 0))
   (gn-emit (enc-cmp-i 12 0)) (hld-guard G (enc-cond-lt))
   (gn-emit (enc-cmp-i 13 0)) (hld-guard G (enc-cond-lt))
   (gn-emit (+ (enc-add-r 17 12 13) 0x20000000)) (hld-guard G (enc-cond-hs))
   (gn-mov-imm 16 134217728) (gn-emit (enc-cmp-r 17 16)) (hld-guard G 8)
   (gn-emit (enc-ldr 16 7 328)) (gn-emit (+ (gn-e-addsl 12 16 12 3) 0x20000000)) (hld-guard G (enc-cond-hs))
   (gn-emit (+ (gn-e-addsl 17 16 17 3) 0x20000000)) (hld-guard G (enc-cond-hs))
   (hld-disjoint G 12 17 7 9)
   (gn-emit (enc-add-i 16 11 8)) (hld-disjoint G 12 17 11 16)
   (gn-emit (enc-ldr 16 11 0)) (gn-emit (gn-e-addsl 16 15 16 4)) (hld-disjoint G 12 17 15 16)
   (gn-emit (enc-mov-sp 16 31)) (gn-emit (enc-add-i 9 29 16)) (hld-disjoint G 12 17 16 9)
   (gn-emit (enc-mov-r 10 14)))] m0))
(defn- hld-copy [M :vector-i64 P :vector-i64 base :i64] :vector-i64
 (loop [cur M j (vector-at P 0)] (if (= j (vector-at P 1)) cur
  (if (hld-access cur j (vector-at P 1))
   (let [old (sf-word cur (+ j 14)) ix (bit-and (i64-shift-right (sf-word cur (+ j 9)) 5) 31)
    io (bit-or (bit-or (bit-and old 0xffe0fc1f) (i64-shift-left 12 5)) (i64-shift-left ix 16))]
    (recur (-> cur (gn-emit (enc-cmp-r ix 13)) (gn-emit (enc-bcond (enc-cond-lo) 2))
      (gn-emit 0) (gn-emit io)) (+ j 15)))
