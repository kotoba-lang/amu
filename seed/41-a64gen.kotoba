                  (kpat-match M (mmx-q M tfd) [1125917086056449 18 4229300233 8589934596 65539 65543 277141354709003 3 4226416650 4228841481 12884901892 4295032836 8590065668 196611 562962837602317 562954259922958 131078 262149 17179869188 65539 65543 277076930199563 8589934596 4226482186 4227858441 4294967300 4295032836 8590065668 17180065796 262147 12885032967 277033980723211 8590131203 4227072010 4227203081 12885098499 4227072009 562962837602317 562954259922958 12885032964 65541 4295098373 8590131205 18 4229300234 4226482185 4226416649 19 4294311938] [tfd tt])
                  (kpat-match M (mmx-q M tin) [2251816992899073 18 4229300233 4294967300 8590000132 562949964955662 262149 17179869188 65539 65543 277089815101451 4294967300 12884967428 4295098371 562958542635021 4295098371 844429224312845 8590000132 12885032964 844429224312845 4223664138 4228055049 4294967300 12884967428 131075 562958542635021 562949964955662 4295032836 17180000260 196611 562962837602317 562954259922958 131078 327685 21474836484 65539 131079 276982440919052 21474836484 65539 65543 276986735886347 12884901892 17179934724 131079 4226482185 4226416649 276965261049867 8589934595 4226023434 4226154505 12884901891 4226023433 393221 25769803780 8590000131 65543 276922311376907 12884901891 4225368074 4225499145 8589934595 4225368073 458757 4294967300 17179934724 25769934852 562958542635021 12885032964 844429224443917 524293 34359738372 17179934724 4295098371 562958542635021 562949964955662 65539 65543 276814937194507 34359738372 8590000132 25769934852 30064967684 1125904200957965 4223729674 4223860745 34359738372 4223729673 4223664137 19 4294311938] [tin tt pt tfx])
                  (kpat-match M (mmx-q M tfx) [3096246217998337 18 4229300233 4294967300 8590000132 562949964955662 327685 4294967300 21474902020 12885032964 562958542635021 562949964955662 393221 4294967300 21474902020 17180000260 562958542635021 562949964955662 458757 4294967300 25769869316 12885032964 562958542635021 562949964955662 524293 4294967300 25769869316 17180000260 562958542635021 562949964955662 589829 4294967300 30064836612 562954247602189 276879361703947 4294967300 25769869316 562954247602189 276978145951755 4294967300 34359803908 562954247602189 276982440919052 4294967300 38654771204 562954247602189 4226416649 4226351113 276896541573131 4294967300 25769869316 4295098371 562958542635021 131075 844429224247309 30064836612 4295098371 562958542635021 131075 844429224247309 21474902020 4295098371 562958542635021 4295098371 844429224247309 4224974858 4225105929 4294967300 4224974857 4218355722 4224843785 4294967300 25769869316 562954247602189 276467044843531 4294967300 34359803908 562954247602189 276711857979403 4294967300 21474902020 12885032964 562958542635021 38654836740 844429224247309 25769869316 12885032964 562958542635021 34359869444 844429224247309 25769869316 17180000260 562958542635021 21474967556 844429224247309 21474902020 4295098371 562958542635021 4295098371 844429224247309 25769869316 4295098371 562958542635021 131075 844429224247309 8590000132 25769934852 844429224247309 4218683402 4222287881 4294967300 38654771204 562954247602189 276488519680011 4294967300 38654771204 12885032964 562958542635021 562949964955662 655365] [tfx tt rd pt])
                  (kpat-match M (+ (mmx-q M tfx) 120) [4294967300 38654771204 17180000260 562958542635021 562949964955662 720901 4294967300 25769869316 17180000260 562958542635021 42949804036 844429224247309 21474902020 12885032964 562958542635021 47244771332 844429224247309 38654771204 12885032964 562958542635021 25769934852 844429224247309 38654771204 17180000260 562958542635021 21474967556 844429224247309 38654771204 4295098371 562958542635021 131075 844429224247309 21474902020 4295098371 562958542635021 4295098371 844429224247309 8590000132 38654836740 844429224247309 4226613258 4226744329 4294967300 4226613257 4226547721 4226285578 4226416649 4294967300 4226285577 4226220041 19 4294311938] [tfx tt rd pt])
                  (kpat-match M (mmx-q M rd) [562962837667841 18 4229300233 8589934596 65539 65543 65544 277115584905227 4294967300 8590000132 4295098371 562958542635021 562949964955662 4295032835 65543 4228448265 19 4294311938] [rd tt])
