     (gn-emit (enc-add-r 13 13 16)) (gn-emit (enc-add-r 14 14 16))
     (gn-emit (enc-add-r 15 15 16)) (gn-emit (enc-add-i 15 15 8))
     (gn-mov-imm 16 count) (gn-emit (enc-cmp-r jreg 16)))
   more (vector-at m7 MM-CODE-N)
   m8 (-> m7 (gn-emit (enc-bcond (enc-cond-ne) (- head more))) (gn-emit (enc-str 8 7 CTX-FUEL))
      (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)))
   tcold (vector-at m8 MM-CODE-N)
   m9 (-> m8 (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-put (+ MM-CODE-BASE t1) (enc-bcond (enc-cond-ne) (- tcold t1)))
