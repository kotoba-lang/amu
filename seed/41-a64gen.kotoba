(defn- qb-weight-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 61) true (and (qb-weight-row M p f k) (qb-weight-rows M p f (inc k)))))
(defn- qb-rem-row [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 2 2)
  1 (uc-row M (+ p 1) 9 (gn-sir M (+ p 1) IF-A) 0 0)
  2 (uc-row M (+ p 2) 4 0 1 0)
  3 (uc-row M (+ p 3) 4 1 2 0)
  4 (uc-row M (+ p 4) 4 2 1 0)
  5 (uc-row M (+ p 5) 4 3 2 0)
  6 (uc-row M (+ p 6) 6 4 2 0)
  7 (uc-row M (+ p 7) 6 3 1 0)
  8 (uc-row M (+ p 8) 6 2 0 0)
  9 (uc-row M (+ p 9) 19 0 0 0)
  10 (uc-row M (+ p 10) 2 f 0 0)
  false))
(defn- qb-rem-rows [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 11) true (and (qb-rem-row M p f k) (qb-rem-rows M p f (inc k)))))
(defn- qb-labels [M :vector-i64 p :i64 n :i64 k :i64] :bool
 (if (= k n) true
  (let [j (+ p k) a (gn-sir M j IF-A)]
   (and (or (not= (gn-op M j) OP-LABEL)
       (and (> a 0) (< a MM-LABEL-CAP) (= (gn-small-label M 1 a 0) j)
        (= (bd-count M 1 a 0 0) (+ 65536 (qb-local-refs M p (+ p n) a 0)))))
        (qb-labels M p n (inc k))))))
(defn- qb-local-refs [M :vector-i64 j :i64 end :i64 label :i64 count :i64] :i64
 (if (= j end) count
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)
        target (if (= op OP-BR) a (if (or (= op OP-BRZ) (= op OP-BRNZ)) b 0))]
   (qb-local-refs M (inc j) end label (if (= target label) (inc count) count)))))
(defn- qb-bound [M :vector-i64 f :i64 n :i64 np :i64 ns :i64 dp :i64 fuel :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (not (gn-clamp-open M f)) (>= (vector-at M MM-SIR-N) n)
  (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (gn-fnf M f FF-SIR) 0) (<= (gn-fnf M f FF-SIR) (- (vector-at M MM-SIR-N) n))
  (= (gn-fnf M f FF-NPARAMS) np) (= (gn-fnf M f FF-NSLOTS) ns)
  (= (gn-fnf M f FF-DEPTH) dp) (= (gn-fnf M f FF-FUEL) fuel)
  (= (gn-fnf M f FF-RTYPE) TY-I64)))
(defn- qb-int-params [M :vector-i64 f :i64 j :i64 n :i64] :bool
 (if (= j n) true (and (= (gn-fnf M f (+ FF-PT0 j)) TY-I64) (qb-int-params M f (inc j) n))))
(defn- qb-deps [M :vector-i64 reader :i64] :bool
 (if (not (qb-bound M reader 30 3 3 4 1)) false
  (let [p (gn-fnf M reader FF-SIR) rem (gn-sir M (+ p 16) IF-A) weight (gn-sir M (+ p 17) IF-A)]
   (and (= (gn-fnf M reader FF-PT0) TY-VEC) (qb-int-params M reader 1 3)
    (>= (gn-sir M (+ p 4) IF-B) 0) (<= (gn-sir M (+ p 4) IF-B) 4095)
    (> (gn-sir M (+ p 10) IF-B) 0) (<= (gn-sir M (+ p 10) IF-B) 4095)
    (qb-reader-rows M p reader rem weight 0) (qb-labels M p 30 0)
    (qb-bound M rem 11 2 2 4 0) (qb-int-params M rem 0 2)
    (qb-rem-rows M (gn-fnf M rem FF-SIR) rem 0) (qb-labels M (gn-fnf M rem FF-SIR) 11 0)
    (qb-bound M weight 61 1 1 2 0) (qb-int-params M weight 0 1)
    (qb-weight-rows M (gn-fnf M weight FF-SIR) weight 0) (qb-labels M (gn-fnf M weight FF-SIR) 61 0)))))
(defn- qb-regs [M :vector-i64 k :i64] :bool
 (if (> k 6) true
  (let [r (gn-sreg M k)] (and (or (= r -1) (and (>= r 19) (<= r 28))) (qb-regs M (inc k))))))
(defn- qb-admit [M :vector-i64 i :i64] :bool
 (let [f (gn-g M fr-owner) p (dec i)]
  (and (> i 1) (qb-bound M f 68 4 6 5 1) (= p (gn-fnf M f FF-SIR))
   (= (gn-fnf M f FF-PT0) TY-VEC) (qb-int-params M f 1 4)
   (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
   (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-ns) 6) (= (gn-g M gn-f-dp) 5)
   (= (gn-g M gn-f-out) 0) (> (gn-g M gn-f-fb) 0) (<= (gn-g M gn-f-fb) 32768)
   (qb-regs M 1) (>= (gn-sreg M 1) 19) (>= (gn-sreg M 2) 19)
   (>= (gn-sreg M 3) 19) (>= (gn-sreg M 4) 19)
   (not= (gn-sreg M 1) (gn-sreg M 2)) (not= (gn-sreg M 1) (gn-sreg M 3)) (not= (gn-sreg M 1) (gn-sreg M 4)) (not= (gn-sreg M 2) (gn-sreg M 3)) (not= (gn-sreg M 2) (gn-sreg M 4)) (not= (gn-sreg M 3) (gn-sreg M 4))
   (= (vector-at M MM-ERR) 0) (>= (vector-at M MM-CODE-N) 0)
   (<= (vector-at M MM-CODE-N) (- MM-CODE-CAP 192))
   (let [reader (gn-sir M (+ p 13) IF-A) n (gn-sir M (+ p 4) IF-B) score (gn-sir M (+ p 53) IF-B)]
    (and (> n 0) (<= n 63) (>= score 0) (<= score 4095)
     (qb-owner-rows M p f reader 0) (qb-labels M p 68 0) (qb-deps M reader))))))
(defn- qb-bit [M :vector-i64 rp :i64 x :i64 y :i64 d :i64] :vector-i64
 (-> M (gn-op-fuel) (gn-emit (gn-e-lsr 16 x 3))
  (gn-mov-imm 17 (gn-sir M (+ rp 10) IF-B)) (gn-emit (enc-madd 16 y 17 16))
  (gn-mov-imm 17 (gn-sir M (+ rp 4) IF-B)) (gn-emit (enc-add-r 16 16 17))
  (gn-emit (gn-e-ldrr d 4 16 1)) (gn-mov-imm 17 7) (gn-emit (enc-and-r 17 x 17))
  (gn-mov-imm 16 7) (gn-emit (enc-sub-r 16 16 17))
  (gn-emit (enc-lsrv d d 16)) (gn-mov-imm 17 1) (gn-emit (enc-and-r d d 17))))
(defn- qb-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) rp (gn-fnf M (gn-sir M (+ p 13) IF-A) FF-SIR)
  n (gn-sir M (+ p 4) IF-B) last (+ (gn-sir M (+ rp 4) IF-B) (quot n 8) (* n (gn-sir M (+ rp 10) IF-B)))
  m0 (-> M (gn-mov 0 (gn-sreg M 1)) (gn-mov 1 (gn-sreg M 2))
   (gn-mov 2 (gn-sreg M 3)) (gn-mov 3 (gn-sreg M 4)) (gn-emit (enc-cmp-i 1 n)))
  empty (vector-at m0 MM-CODE-N) m1 (gn-emit m0 (enc-bcond (enc-cond-eq) 0))
  order (vector-at m1 MM-CODE-N) m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-i 2 n)))
  ybad (vector-at m2 MM-CODE-N) m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)))
  handle (vector-at m3 MM-CODE-N) m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 4 7 320)) (gn-emit (gn-e-addsl 4 4 17 4)) (gn-emit (enc-ldp 17 4 4 0))
   (gn-mov-imm 16 last) (gn-emit (enc-cmp-r 16 4)))
  bounds (vector-at m4 MM-CODE-N) m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0))
   (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3)))
  loopcode (vector-at m5 MM-CODE-N)
  m6 (-> m5 (qb-bit rp 1 2 9) (gn-emit (enc-add-i 11 1 1)) (qb-bit rp 11 2 10) (gn-emit (enc-cmp-r 9 10)))
  fail1 (vector-at m6 MM-CODE-N) m7 (-> m6 (gn-emit (enc-bcond (enc-cond-ne) 0))
   (gn-emit (enc-add-i 12 2 1)) (qb-bit rp 1 12 10) (gn-emit (enc-cmp-r 9 10)))
  fail2 (vector-at m7 MM-CODE-N) m8 (-> m7 (gn-emit (enc-bcond (enc-cond-ne) 0))
   (qb-bit rp 11 12 10) (gn-emit (enc-cmp-r 9 10)))
  fail3 (vector-at m8 MM-CODE-N) m9 (-> m8 (gn-emit (enc-bcond (enc-cond-ne) 0))
   (gn-emit (enc-add-i 3 3 (gn-sir M (+ p 53) IF-B))))
  step (vector-at m9 MM-CODE-N) m10 (-> m9 (gn-emit (enc-add-i 1 1 1)) (gn-op-fuel) (gn-emit (enc-cmp-i 1 n)))
  back (vector-at m10 MM-CODE-N) m11 (-> m10 (gn-emit (enc-bcond (enc-cond-ne) (- loopcode back))))
  done (vector-at m11 MM-CODE-N) m12 (-> m11 (gn-mov 0 3) (gn-epilogue) (gn-gs gn-f-dead 0))
  fallback (vector-at m12 MM-CODE-N)]
  (-> m12 (gn-dot-patch empty done (enc-cond-eq)) (gn-dot-patch order fallback (enc-cond-hs))
   (gn-dot-patch ybad fallback (enc-cond-hs)) (gn-dot-patch handle fallback (enc-cond-hs))
   (gn-dot-patch bounds fallback (enc-cond-hs)) (gn-dot-patch fail1 step (enc-cond-ne))
   (gn-dot-patch fail2 step (enc-cond-ne)) (gn-dot-patch fail3 step (enc-cond-ne)))))
(defn- qb-entry [M :vector-i64 i :i64] :vector-i64
 (if (qb-admit M i) (qb-emit M i) M))

