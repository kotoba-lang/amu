     (and (>= (scn-defs w) 0) (< (hld-target M j) 0)
      (not= (bit-and w 0x7c000000) 0x14000000)
      (not= (bit-and w 0xff000010) 0x54000000)
      (not= (bit-and w 0x7e000000) 0x34000000)
      (not= (bit-and w 0x7e000000) 0x36000000)
      (not= (bit-and w 0xfffffc1f) 0xd65f0000)
      (not= (bit-and w 0xffe0001f) 0xd4200000) (not= w 0)
      (not= (bit-and w 0x1f000000) 0x10000000)))
