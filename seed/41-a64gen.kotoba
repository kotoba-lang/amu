;; ---- hd (kernels B, step 3): huffbench (decode-bits s n i k mask ptr first) bit by bit, the source's own scans:
;; byte = s[500 + ptr], nk = 2 k + 1 + (byte & mask != 0), the scan from i reads s[2793 + scan] (two items per load,
;; compared in order) until one is >= nk (a charge per step), key and c = s[3049 + at], mask and ptr advance; nk = key:
;; s[n] := c, n + 1, i := first, k := 0; else i := at, k := nk; a recur charge per bit; the charges are counted and paid
;; at the exit. Leaf (slots x0 .. x6, private fuel x8; x19 .. x21 saved on a frame). Bits run while the charges stay
;; below a budget that keeps more than |s| + 600 fuel and 500 + ptr < |s|, n < 500, and a scan's pair load stays below
;; s[|s| - 257]; otherwise the state of that bit's start goes to the loop head (which also returns s at n = 500).
;; |s| >= 3305 and 0 <= i, first, ptr < |s| at the entry.
(defn- hd-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A)]
  (if (not (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
                (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
                (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-vmode) 0)
                (loop [s 1] (or (> s 7) (and (= (gn-sreg M s) (dec s)) (recur (inc s)))))
                (kpat-match M (+ p 69) [4295032835 196615 277149944643595 21474836484 4295032835 589830 4228841482 4228972553 549755813891 4228841481 851973 21474836484 4295032835 196615 277106994970635 25769803780 4228055050 4228317193 25769803780 4295032835 65542 4228055049 917509 38654705668 47244705796 65543 276969556017163 4294967300 8590000132 51539738628 844424943763470 8590000132 4295098371 4295032838 30064902148 196611 55834836996 60129869828 30065164292 65541 4295098373 8590131205 12885164037 17180196869 21475229701 25770262533 18 4294246410 4225105930 4226220041 4294967300 8590000132 42949804036 38654902276 55834836996 60129869828 30065164292 65541 4295098373 8590131205 12885164037 17180196869 21475229701 25770262533 18 4294246410 4225105929 4225040393 19 4294311938] [f (gn-sir M (+ p 2) IF-A)])
                (kpat-match M p [3940684033032193 18 4229300233 8589934596 2147483713539 65543 277141354709003 4294967300 4220518410 4228841481 4294967300 2147483713539 25769934852 4295032838 562949964955662 524293 17179869188 8590000131 196614 4295032835 65542 34359803908 21474967556 4295294982 131075 4295032839 277055455428619 65539 4227399690 4227530761 4295032835 4227399689 65542 589829 12884901892 655365 4227072009 4294967300 11995843723267 42949804036 4295032838 562949964955662 38654771204 131079 276956671115275 42949672964 4295032835 65542 655365 18 4227072010 4225892362 4226023433 42949672964 4225892361 655365 4294967300 11995843723267 42949804036 4295032838 562949964955662 720901 4294967300 13095355351043 42949804036 4295032838 562949964955662 786437 21474836484] [f]))) M
   (let [G (vector-alloc 5)
         m0 (-> M (kb-vec G 0 10 11)
              (kb-words G [0xD2819D2C 0xEB0C015F 0x540009A3 0xF107D03F 0x54000962 0xEB0A005F 0x54000922 0xEB0A00DF 0x540008E2 0xEB0A00BF 0x540008A2 0xCB0A010C 0xF109618C 0x5400084D 0xCB05014D 0xF107D9AD 0x540007ED 0xD37DF1AD 0xEB0D019F 0x9A8D318C 0xD10083FF 0xA90053F3 0xF9000BF5 0xAA0C03F5 0x913E816F 0xD28AE90C 0x8B0C0173 0x8B020E62 0xD104054C 0x8B0C0D74 0xD2800011 0xD2801010 0xF86579EC 0xD37FF86E 0x910005CE 0xEA04019F 0x9A8E05CE 0xAA0203ED 0xEB14005F 0x54000422 0xA940244C 0xEB0E019F 0x540000EA 0xEB0E013F 0x5400006A 0x91004042 0x17FFFFF8 0x91002042 0xAA0903EC 0xCB0D004D 0x8B4D0E31 0x91000631 0xF944004D 0xD341FC89 0xF100049F 0x9A90C124 0x9A85C4A5 0xEB0C01DF 0x54000141 0xF821796D 0x91000421 0xD2800003 0x8B060E62 0xF107D03F 0x54000122 0xEB15023F 0x54FFFBC3 0x14000006 0xAA0E03E3 0xEB15023F 0x54FFFB43 0x14000002 0xAA0D03E2 0xCB110108 0xCB130042 0x9343FC42 0xA94053F3 0xF9400BF5 0x910083FF])
