    (= (gn-sir M (- i 2) IF-C) 0)
    (= (gn-op M (dec i)) OP-CONST) (= (gn-sir M (dec i) IF-A) (+ t 2))
    (= (gn-sir M (dec i) IF-C) 0)
    (>= t 0) (<= (+ t 3) (gn-fnf M owner FF-DEPTH))
