   (let [G (vector-alloc 5)
         m0 (-> M (kb-vec G 0 10 11)
              (kb-words G [0xD2819D4C 0xEB0C015F 0x54000A63 0xF107D03F 0x54000A22 0xF101005F 0x540009E8 0xD280DE6C 0xEB0C00DF 0x54000988 0xF861796C 0x9123A58C 0xEB0A019F 0x54000902 0xF101010D 0x540008CD 0xD280DE6C 0xCB06018C 0xD37DF18C 0xEB0C01BF 0x9A8C31AD 0xD10043FF 0xF90003F3 0xD2800011 0xD10105B3 0xB7F80733 0x913E816F 0xD288E910 0x8B100170 0xD289E90E 0x8B0E016E 0xB4000342 0xF8617969 0xF8697A09 0xEA03013F 0x9A9F07E9 0xF1001CBF 0x54000140 0xD341FC63 0xD1000442 0x91000631 0xD37FF88C 0x92401D8C 0xAA090184 0x910004A5 0xB5FFFE62 0x1400000B 0xF107CCDF 0x54000440 0xD341FC63 0xD1000442 0x91000631 0xF82679E4 0x910004C6 0xAA0903E4 0xD2800005 0xB5FFFD02 0xEB13023F 0x54000308 0x9100042C 0xF107D19F 0x540002A0 0xF86C796D 0x9127A5AD 0xEB0A01BF 0x54000222 0xF86D796D 0xD10005A9 0xF100FD3F 0x540001A8 0xF86C7969 0x9123A529 0xEB0A013F 0x54000122 0xD10005A9 0xD2800023 0x9AC92063 0xAA0C03E1 0xAA0D03E2 0x91000631 0xB5FFFA02 0x17FFFFE8 0xCB110108 0xF94003F3 0x910043FF])
