     (gn-emit (enc-add-r 1 lb 2)) (gn-emit (enc-add-r 1 1 9)) (gn-emit (enc-cmp-r 1 16)) (xd-cold G (enc-cond-hs)))
   m3 (loop [m m2 k 0] (if (= k 6) m
    (let [at (case k 0 10 1 21 2 29 3 37 4 51 5 54 0) b (gn-sir M (+ wp at) IF-B)]
     (recur (if (= k 3)
       (-> m (gn-mov-imm 16 16384) (gn-emit (enc-cmp-r sample 16)) (xd-cold G (enc-cond-hs))
        (gn-emit (gn-e-lsl 16 sample 6)) (gn-mov-imm 17 (+ b 63)) (gn-emit (enc-add-r 16 16 17))
        (gn-mov-imm 17 votes) (gn-emit (enc-cmp-r 16 17)) (xd-cold G (enc-cond-hs)))
       (tbat-range m G (if (= k 0) 1 0) b 127 votes)) (inc k)))))
   m4 (-> m3 (tbat-pointers wp) (gn-emit (enc-ldr 8 7 CTX-FUEL))
     (gn-mov-imm 16 votes) (gn-emit (enc-add-r 16 16 cls)) (gn-emit (gn-e-addsl wreg 3 16 3)))
   head (vector-at m4 MM-CODE-N)
   m5 (-> m4 (gn-emit (gn-e-ldrr size 3 tree 1)) (gn-mov-imm 4 0) (gn-mov-imm 2 0) (gn-mov-imm vote 0)
     (tbat-step vote) (tbat-step vote) (tbat-step vote) (tbat-step vote) (tbat-step vote)
     (gn-emit (enc-sub-i 16 4 128)) (gn-emit (enc-cmp-i 16 128)) (gn-emit (gn-e-lsr 17 vote 6)) (gn-emit 0xFA403A20))
   t1 (vector-at m5 MM-CODE-N)
   m6 (-> m5 (gn-emit 0) (gn-emit 0x92401890) (gn-emit (gn-e-ldrr 17 15 16 1)) (gn-emit (enc-add-i 16 2 3))
     (gn-emit (enc-cmp-r 8 16))) t2 (vector-at m6 MM-CODE-N)
   m7 (-> m6 (gn-emit 0) (gn-emit (enc-sub-r 8 8 16)) (scfill-lr-fix ln (+ p 43))
     (gn-emit (enc-ldr 16 wreg 0)) (gn-emit (enc-add-r 16 16 17)) (gn-emit (enc-str 16 wreg 0))
     (gn-emit (enc-add-i jreg jreg 1)) (gn-emit (enc-add-i tree tree 1))
