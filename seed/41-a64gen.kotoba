   (not= (gn-fnf M f FF-NPARAMS) 3)
   (not= (gn-fnf M f FF-PT0) TY-VEC) (not= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
   (not= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (not= (gn-fnf M f FF-RTYPE) TY-VEC)) 0
   (loop [j (inc (gn-fnf M f FF-SIR))]
    (cond (>= j end) 0
     (or (= (gn-op M j) OP-CALL) (= (gn-op M j) OP-CALLI)
      (= (gn-op M j) OP-RET) (= (gn-op M j) OP-TRAP)
      (and (= (gn-op M j) OP-LSET) (= (gn-sir M j IF-A) 2))) 0
     (= (gn-op M j) OP-CMP)
