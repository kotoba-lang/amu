(defn- slp-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 178) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 8) (= (gn-fnf M f FF-RTYPE) TY-I64)
   (= (gn-fnf M f FF-PT0) TY-STR) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
   (= (gn-fnf M f (+ FF-PT0 3)) TY-STR) (= (gn-fnf M f FF-PT4) TY-I64)
   ;; (only five parameter types are recorded; info's RT-VECTOR-AT and len / result's arithmetic are in the pattern)
   (let [at (gn-sir M (+ p 11) IF-A) lw (gn-sir M (+ p 99) IF-A) ol (gn-sir M (+ p 151) IF-A) mo (gn-sir M (+ p 160) IF-A)
         mq (kfn-q M mo) sp (if (> mq 0) (gn-sir M (+ mq 26) IF-A) 0) dg (if (> mq 0) (gn-sir M (+ mq 54) IF-A) 0)
         hx (if (> mq 0) (gn-sir M (+ mq 71) IF-A) 0)]
    (and (> mq 0) (not= at f) (not= lw f) (not= ol f) (not= mo f)
     (pj-fn? M f 178 (slp-pat) [f at lw ol mo]) (pj-fn? M mo 155 (slm-pat) [mo at sp dg hx lw -1 -4])
     (pj-fn? M ol 28 (slo-pat) [ol at]) (pj-fn? M at 17 (sla-pat) [at]) (pj-fn? M lw 20 (sll-pat) [lw]))))))
(defn- slp-entry [M :vector-i64 i :i64] :vector-i64 (if (slp-admit M i) (kemit-hex M (slp-code)) M))
;; ---- slre set-len: (f re r n len) counts a character set's items from len while len < n and re[r + len] is not ']'
;; (each item op-len long: an escape 2, or 4 for '\x'), then len + 1 if len <= n, else -1. Charges: 1 at entry and the
;; loop's 1 per item, the condition's at, op-len and its at(s) 1 each. Before the frame: re resolved once (a valid
;; string handle inside the pool), then per item the byte from re in a register (4 per plain item, 5 per escape); the
;; charge is checked with one kept for the entry, and a non-ASCII byte, an index past the end of re or fuel short
;; publishes the items done (not the entry charge) with len advanced and enters set-len's own code (lu-style re-entry).
;; Generated and checked against the source semantics outside the compiler, re-entry included. Carries the T2 keep
;; marker after its ret. The SIRs of set-len, op-len and at are packed patterns.
