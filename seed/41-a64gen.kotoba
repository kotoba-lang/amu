;; ---- eb (kernels B, step 3): huffbench (encode-bits s j remaining mask bout bit length), one step per tail call:
;; remaining = 0 takes symbol s[j + 1] with bits = s[2537 + symbol] and mask 1 << (bits - 1); else one = (s[2281 + s[j]]
;; & mask != 0) (both read per step), mask >>u 1, and at bit = 7 bout is put at s[500 + length] (bout := one, bit := 0,
;; length + 1), else bout := (2 bout & 255) | one, bit + 1; a recur charge per step, counted and paid at the exit. Leaf
;; (slots x0 .. x6, private fuel x8; x19 saved on a frame). Needs |s| >= 3306, 0 <= j < 500, 0 <= remaining <= 64,
;; 0 <= length <= 1779 and the current symbol inside the code table; a symbol starts only while its at most 65 charges
;; stay below a budget that keeps more than 64 fuel and length <= 1779 (the puts stay below the tables), with the next
;; symbol inside both tables and bits - 1 in [0, 63]. The returning steps (j + 1 = 500 at remaining 0, length + 1 = 500
;; at bit 7) and anything outside these bounds go to the loop head with the state of the step's start.
(defn- eb-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A)]
  (if (not (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
                (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1)
                (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-vmode) 0)
                (loop [s 1] (or (> s 7) (and (= (gn-sreg M s) (dec s)) (recur (inc s)))))
