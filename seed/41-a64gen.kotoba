(defn- sln-code [] :string "~WDZ.Rq*4umd/X:[lOX*s;ud/tM[pFTWB_pdWE;RX\\+g1]M[BLOlOa/i;ud-DM[ojtq*5)HlN.'9;ud(OMZWr.lO!YW;ud\"e3,*)b2`Lu!nH!c^;ud#NnH!WZ;ucp6nGj.C;ud'Cd/XaaOT5Mo(]XO*OT5P>lO!\\X;ucsY3,rYp2`LoenH%W6dXV<odXV=[RZIS)nGj:G;ud\",d/XmeM\\#ku(]XNq;ucuNdXV<*(]XNu;uctCdXV<0(]XO+nGik;;ucrod/XIYOT5Mlq#CQ]emANpZiC+4d/X=UOT5MllN.'9g7Q^lq#CQ]emANpeH7K)q#CQ]")
(defn- sln-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 49) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-RTYPE) TY-I64)
   (= (gn-fnf M f FF-PT0) TY-STR) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
   (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
   (let [at (gn-sir M (+ p 11) IF-A) ol (gn-sir M (+ p 25) IF-A)]
    (and (not= at f) (not= ol f) (not= at ol)
     (pj-fn? M f 49 (sln-pat) [f at ol -1]) (pj-fn? M ol 28 (slo-pat) [ol at]) (pj-fn? M at 17 (sla-pat) [at]))))))
(defn- sln-entry [M :vector-i64 i :i64] :vector-i64 (if (sln-admit M i) (kemit-hex M (sln-code)) M))
;; ---- slre's matcher at bar-loop: (bar-loop re r n s p sl info bi i j) matches the items of re[r .. r + n) at s[p + j]
;; while i < n and j <= sl: per item ch = at(re, r + i), step = info[bracket(bi + 1, 1)] + 2 for '(' else get-op-len
;; (set-len for a set), quant(ch) -> -2, step <= 0 -> -5; a quantifier after the item ('?': bar on the item, j += its
;; positive result; '+' / '*': plus-loop's result); else a set (match-set / set-loop: 1 or -1), '(' (bi + 1 against
;; info[0], doh or bracket-search, the capture's two puts when info[2] > 0), '^' (j = 0), '$' (j = sl) or match-op; j at
;; the end. bar is (bar-loop ... 0 0); plus-loop / plus-end retry the item and the rest with bar; doh tries the group's
;; branches with bar; bracket-search widens a group with doh and bar. One activation runs all six as internal routines
;; over globals in x19..x28 (re's, s's and info's resolved bytes / items and lengths, ctx, the three handles; x8 the
;; counter, published before every external call and at the end): before the frame the three handles are checked (valid,
;; code-relative strings) and bar-loop's entry charged. Each bar-loop iteration is first analysed by reads only (the
;; strings' bytes, info's cells) with its charges summed exactly (at, get-op-len / op-len / set-len, quant's ats,
;; match-set / set-loop's items, match-op, the loop; a set's items inside re's bytes scanned by ldrb with their charges
;; counted after, set-loop's d2 being the next item's condition byte, read once; a lowercase letter not followed by a
;; quantifier tested and charged first in the same order), then checked and taken together, and only then come its calls
;; (internal), puts, return or loop; charges around calls (bar 1 + bar-loop's entry 1, the callee's entry, at, the
;; loops) are taken one by one, fuel short there trapping as the source would (counter 0, brk #0). A bar-loop iteration
;; it does not take (an escape, a range or '-' in a set, a non-ASCII byte, an index past the end of a string, an info
;; index out of range, fuel short) calls bar-loop's own code for it (after the block), a doh iteration with an info
;; index out of range calls doh, each with its entry charge refunded. Generated and checked against the source semantics
;; outside the compiler (captures, traps and re-entry included). Carries the T2 keep marker after its ret. The SIRs of
;; bar-loop, bar, plus-loop, plus-end, doh, bracket-search, get-op-len, set-len, op-len, at, quant, bracket, branch,
;; cap, put and match-set (with set-loop's own admission) are packed patterns.
