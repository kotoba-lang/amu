(defn- hfc-code [] :string "~nGit^;udA`nGkg];ud@uq*:J>q*4umd/X:]lOX+^;ud?$q*:VBM\\-R5WB`c^nJ-Wt;ud=/q*5)Hq*:bEM\\-EedXVN5dXY.(Rh.P5M\\$?_dsUL7OUV?7nGit^dX[8dRYq3iq*Y8Jq*YDQq*Y\\Qq*YhVq*Z7cnGkg];ud!8MZO>aq*77VlOEoE;ud\"Od\\$R0lOa0T;ud!8dXV=7lO<k:;ud/uq*9NAq*4unb7O_oM\\-!8P!C&5M[fc*phkB>P!C#,dXV=;b7Oa\\'EA+`dXV=7lO<k:;ud*^dXV<%dXV=;b7Oa\\'EA+YZiC+qdXV?-lO<k:;ud']dXV>fb7Oa\\dn`)\\d/X<GP!C\"`'EA+HZiC4;nH8kW;ud$;ph>$DnH8bT;ud#.dXVC9lO<k:;ud\"&dXVBob74OYdn`)\\d/X?/P!C%HOT5P6P!C$:WY#5adXV>Zdsq.GP!D-_dsq.&P!D->WWiH5OT5MN(]XNNq#g`_q#glfq#h/fq#h;kq#h`#q#CQ]emANpq#g`_q#glfq#h/fq#h;kq#h`#q#CQ]eH7K)")
(defn- hfc-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 95) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-PT0) TY-VEC)
   (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
   (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (let [p8 (gn-sir M (+ p 10) IF-A) hv (gn-sir M (+ p 59) IF-A) bt (gn-sir M (+ p 67) IF-A)
         bq (kfn-q M bt) oc (if (> bq 0) (gn-sir M (+ bq 26) IF-A) 0) p16 (if (> bq 0) (gn-sir M (+ bq 37) IF-A) 0)
         pt (if (> bq 0) (gn-sir M (+ bq 65) IF-A) 0) oq (kfn-q M oc) ch (if (> oq 0) (gn-sir M (+ oq 4) IF-A) 0)
         st (if (> oq 0) (gn-sir M (+ oq 34) IF-A) 0) cq (kfn-q M ch) rf (if (> cq 0) (gn-sir M (+ cq 10) IF-A) 0)]
    (and (> bq 0) (> oq 0) (> cq 0) (not= p8 f) (not= hv f) (not= bt f)
     (pj-fn? M f 95 (hfc-pat) [f p8 hv bt 65535]) (pj-fn? M bt 68 (hfb-pat) [bt oc p16 p8 pt 32768])
     (pj-fn? M oc 52 (hfo-pat) [oc ch st pt]) (pj-fn? M ch 73 (hfh-pat) [ch rf p8 pt])
     (pj-fn? M p8 11 (hf8-pat) [p8 pt]) (pj-fn? M p16 11 (hf16-pat) [p16 pt 65535]) (pj-fn? M pt 9 (pj-put-pat) [pt])
     (pj-fn? M hv 29 (hfv-pat) [hv]))))))
(defn- hfc-entry [M :vector-i64 i :i64] :vector-i64 (if (hfc-admit M i) (kemit-hex M (hfc-code)) M))

;; ---- picojpeg bits: (f v width flag) takes width bits from the reader (v[259] the 16-bit window, v[260] its bits
;; left): width > 8 first refills a byte (refill-bits: window * 2^left, octet's char byte or-ed in, * 2^(8 - left)) and
;; keeps the window's high byte with the new one; then, for n = width (or width - 8) bits, either one more refill
;; (left < n: window * 2^left, byte, * 2^(n - left), v[260] = 8 - (n - left)) or v[260] = left - n and window * 2^n;
;; v[263] = the kept bits quot 2^(16 - width) (pow clamps: below 1 -> 1, from 16 -> 65536; puts keep 8 / 16 bits).
;; Charges: 1, 12 per refill, 2 + 2 or the refill's 12 + 2, 1. Before the frame: 1 <= width <= 16, v live past item
;; 263; everything is computed in registers first (chars need v[257] > 0, v[256] < 256 and, when flag is set, a byte
;; other than 255) and the fuel checked; only then the cells and the counter are stored. Anything else leaves the call
;; to bits' own code untouched. Generated and checked against the source semantics outside the compiler; the SIRs of
;; bits, refill-bits, pow and huff-code's octet / char / put helpers are packed patterns. The T2 keep marker ends the
;; block (only the way into bits' own code passes it), so T2 keeps the kernel without relying on a rollback.
