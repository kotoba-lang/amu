                (= (gn-fnf M f FF-SIR) p) (< (+ p 81) (vector-at M MM-SIR-N)) (= (gn-fnf M f FF-PT0) TY-VEC)
                (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
                (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2))
                (ok rv) (ok ri) (ok rj) (ok rd) (ok rl))) M
