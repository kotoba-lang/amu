(defn- tbat-bank [M :vector-i64 f :i64] :bool
 (let [cn (vector-at M MM-CODE-N) code (gn-fnf M f FF-CODE)]
  (and (> cn 0) (<= cn MM-CODE-CAP) (> code 0) (<= code (- cn 16))
   (= (sf-word M code) (enc-stp-pre 29 30 31 -16))
   (= (sf-word M (inc code)) (enc-mov-sp 29 31))
   (= (sf-word M (+ code 2)) (enc-sub-i 31 31 240))
   (loop [k 0] (or (= k 5)
    (and (= (sf-word M (+ code 3 k)) (enc-stp (+ 19 (* k 2)) (+ 20 (* k 2)) 31 (* k 16)))
     (recur (inc k)))))
   (= (sf-word M (+ code 8)) (enc-str 7 31 232))
   (loop [k 1] (or (= k 11)
    (let [r (gn-sreg M k)] (and (>= r 19) (<= r 28)
     (loop [j 1] (or (= j k) (and (not= r (gn-sreg M j)) (recur (inc j)))))
     (or (> k 7) (= (sf-word M (+ code 8 k)) (enc-mov-r r (dec k))))
     (recur (inc k)))))))))
(defn- tbat-node-at [M :vector-i64 n :i64 nn :i64 k :i64] :i64
 (if (or (<= n 0) (>= n nn) (< k 0) (> k 13)) 0
  (let [c (nm-first M n)]
   (loop [q c left k]
    (if (or (<= q 0) (>= q nn)) 0
     (if (= left 0) q (let [nx (nm-next M q)]
      (if (= nx q) 0 (recur nx (dec left))))))))))
(defn- tbat-high-pt [M :vector-i64 f :i64 k :i64] :bool
 (let [nn (vector-at M MM-NODE-N)]
  (and (> nn 0) (<= nn MM-NODE-CAP) (>= k 5) (<= k 6)
   (let [n (gn-fnf M f FF-NODE)]
    (and (> n 0) (< n nn) (= (nm-kind M n) ND-LIST)
     (let [v (tbat-node-at M n nn 2)]
      (and (> v 0) (= (nm-kind M v) ND-VEC)
       (let [t (tbat-node-at M v nn (inc (* 2 k)))]
        (and (> t 0) (= (nm-nf M t NF-TYPE) TY-I64))))))))))
(defn- tbat-admit [M :vector-i64 i :i64] :i64
 (let [sn (vector-at M MM-SIR-N) fnn (vector-at M MM-FN-N) ln (vector-at M MM-LABEL-N)]
  (if (or (<= sn 0) (> sn MM-SIR-CAP) (<= fnn 0) (> fnn MM-FN-CAP)
    (<= ln 0) (>= ln (dec MM-LABEL-CAP)) (<= i 34) (>= i sn)
    (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
    (not (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1)))
    (not= (gn-g M gn-f-vslot) 0) (not= (gn-g M gn-f-nsv) 10)
    (not= (gn-g M gn-f-ns) 10) (not= (gn-g M gn-f-dp) 8)
    (not= (gn-g M gn-f-ctx) 1) (not= (gn-g M gn-f-out) 0)
    (not= (gn-g M gn-f-skip) 0) (not= (gn-g M gn-f-fb) 240)
    (<= (vector-at M MM-CODE-N) 0) (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 512))
    (<= (vector-at M MM-FIX-N) 0) (> (vector-at M MM-FIX-N) (- MM-FIX-CAP 4))) 0
   (let [p (tbat-owner M (dec i) 128)]
    (if (or (= p 0) (not= i (+ p 34)) (> p (- sn 88))) 0
     (let [f (gn-sir M p IF-A)]
      (if (or (<= f 0) (>= f fnn) (gn-clamp-open M f)) 0
       (let [classes (gn-sir M (+ p 4) IF-B) count (gn-sir M (+ p 11) IF-B)
        votes (gn-sir M (+ p 46) IF-B) walk (gn-sir M (+ p 43) IF-A) put (gn-sir M (+ p 56) IF-A)
        wp (tbat-walk M walk)]
        (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 7)
          (= (gn-fnf M f FF-NSLOTS) 10) (= (gn-fnf M f FF-DEPTH) 8)
          (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-FUEL) 1)
          (= (gn-fnf M f FF-PT0) TY-VEC)
          (loop [k 1] (or (= k 7) (and (if (< k 5) (= (gn-fnf M f (+ FF-PT0 k)) TY-I64) (tbat-high-pt M f k)) (recur (inc k)))))
          (tbat-bank M f)
          (> classes 0) (<= classes 4095) (> count 0) (<= count 4095)
          (> votes 0) (<= votes 1048575) (> wp 0) (tbat-put M put)
          (loop [k 0] (or (= k 6)
           (let [at (case k 0 10 1 21 2 29 3 37 4 51 5 54 0)]
            (and (< (+ (gn-sir M (+ wp at) IF-B) (dec (gn-sir M (+ wp 4) IF-B))) votes)
             (recur (inc k))))))
          (tbat-shape M p f 0) (tbat-labels M p 88 0)) p 0))))))))
)
(defn- tbat-disjoint [M :vector-i64 G :vector-i64] :vector-i64
 (let [m0 (gn-emit M (enc-cmp-r 9 8)) skip (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0))
        (gn-emit (enc-cmp-r 17 16)) (xd-cold G 8)) done (vector-at m1 MM-CODE-N)]
  (gn-dot-patch m1 skip done (enc-cond-hs))))
(defn- tbat-alias [M :vector-i64 G :vector-i64] :vector-i64
 (-> M (gn-emit (enc-ldr 9 7 328)) (gn-mov-imm 8 1073741824)
  (gn-emit (enc-add-r 17 9 8)) (gn-emit (enc-cmp-r 17 9)) (xd-cold G 9)
  (gn-mov 16 7) (gn-emit (enc-add-i 8 16 400))
  (gn-emit (enc-cmp-r 8 16)) (xd-cold G (enc-cond-lo)) (tbat-disjoint G)
  (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-add-i 8 16 8))
  (gn-emit (enc-cmp-r 8 16)) (xd-cold G (enc-cond-lo)) (tbat-disjoint G)
  (gn-emit (enc-ldr 5 16 0)) (gn-mov-imm 8 4194304)
  (gn-emit (enc-cmp-r 5 8)) (xd-cold G (enc-cond-hs))
  (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-lsl 8 5 4))
  (gn-emit (enc-add-r 8 16 8)) (gn-emit (enc-cmp-r 8 16)) (xd-cold G (enc-cond-lo)) (tbat-disjoint G)
  (gn-emit (enc-mov-sp 16 31)) (gn-emit (enc-cmp-i 16 192)) (xd-cold G (enc-cond-lo))
  (gn-emit (enc-sub-i 16 31 192)) (gn-emit (enc-add-i 8 31 256))
  (gn-emit (enc-cmp-r 8 16)) (xd-cold G (enc-cond-lo)) (tbat-disjoint G)))
(defn- tbat-range [M :vector-i64 G :vector-i64 r :i64 base :i64 span :i64 limit :i64] :vector-i64
 (-> M (gn-mov-imm 16 (+ base span)) (gn-emit (enc-add-r 16 r 16))
  (gn-mov-imm 17 limit) (gn-emit (enc-cmp-r 16 17)) (xd-cold G (enc-cond-hs))))
(defn- tbat-pointers [M :vector-i64 wp :i64] :vector-i64
 (loop [m M k 0] (if (= k 6) m
  (let [at (case k 0 21 1 29 2 37 3 51 4 54 5 10 0)
        b (gn-sir M (+ wp at) IF-B) r (+ 10 k) index (gn-sreg M (case k 2 2 5 7 6))]
   (recur (-> m (cond-> (= k 2) (gn-emit (gn-e-lsl 16 (gn-sreg M 2) (gn-pow2 (gn-sir M (+ wp 39) IF-B)))))
    (gn-mov-imm 17 b) (gn-emit (enc-add-r 17 (if (= k 2) 16 index) 17))
    (gn-emit (gn-e-addsl r 3 17 3))) (inc k))))))
;; ---- tbat (rewritten by kernels B): the class loop of trees (40 walks), no branch on the path length.
;; Per entry (cls < classes, j < count, the alias and handle guards as before): tree <u low and tree + n <= low for
;; n = count - j, nb and lb below 2^20, the n tree sizes each below 2^20 (one OR) with sum S, and every plane bound for
;; nb + S and lb + S + n (nb and lb only grow, so each tree's planes are in bounds); else the original loop runs.
;; Per tree: five walk steps without branches (index node & 127, feature & 63 for the row load; an interior node,
;; node <u 128, moves to the chosen child and counts a step, a leaf stays), then the walk must have ended on a leaf
;; (128 <= node < 256) with every interior feature in [0, 64) (their OR below 64), else this tree replays in the
;; original code from its own start (fuel published as of then; nothing was stored). Fuel x8 is private: steps + 3
;; (walk entry, steps, put, recur) is checked, then paid; the vote cell is read, added, stored; x30 gets the walk
;; call's return address as before; the slots advance; x8 is published when the class is done.
(defn- tbat-step [M :vector-i64 err :i64] :vector-i64
 (-> M (gn-emit 0x92401890) (gn-emit (gn-e-ldrr 9 10 16 1)) (gn-emit (gn-e-ldrr 5 11 16 1)) (gn-emit 0x92401531)
  (gn-emit (gn-e-ldrr 6 12 17 1)) (gn-emit (gn-e-ldrr 0 13 16 1)) (gn-emit (gn-e-ldrr 1 14 16 1))
  (gn-emit (enc-cmp-r 6 5)) (gn-emit (enc-csel 0 0 1 (enc-cond-lt))) (gn-emit (enc-cmp-i 4 128))
  (gn-emit (enc-csel 4 0 4 (enc-cond-lo))) (gn-emit 0x9A822442) (gn-emit 0x9A9F3131) (gn-emit (enc-orr-r err err 17))))
(defn- tbat-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (tbat-admit M i) wp (if (= p 0) 0 (tbat-walk M (gn-sir M (+ p 43) IF-A)))]
  (if (or (= p 0) (not= (gn-sir M (+ wp 4) IF-B) 128) (not= (gn-sir M (+ wp 39) IF-B) 64)) M
  (let [classes (gn-sir M (+ p 4) IF-B) count (gn-sir M (+ p 11) IF-B)
   votes (gn-sir M (+ p 46) IF-B) G (vector-alloc 129) B (gp-save-state M)
   rv (gn-sreg M 1) sample (gn-sreg M 2) cls (gn-sreg M 3) jreg (gn-sreg M 4)
   tree (gn-sreg M 5) nb (gn-sreg M 6) lb (gn-sreg M 7) size (gn-sreg M 8)
   vote (gn-sreg M 9) wreg (gn-sreg M 10) ln (vector-at M MM-LABEL-N)
