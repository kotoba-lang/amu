(defn- cpp-plan [M :vector-i64] :i64
 (if (not (cpp-counts M)) 0
  (let [p (gn-g M cpp-state) top (vector-at M MM-HEAP-TOP)]
   (if (and (>= p (+ (vector-at M gn-cell) cpp-state 1)) (<= p (- MM-HEAP-END 4100))
    (>= top (+ p 4100)) (= (vector-at M (+ p 1)) 0x43505031) (= (vector-at M (+ p 2)) (vector-at M gn-cell))
    (= (vector-at M (+ p 3)) 4100)
    (>= (vector-at M p) 0) (<= (vector-at M p) 512)) p 0))))
(defn- cpp-prepare [M :vector-i64] :vector-i64
 (if (not (cpp-counts M)) M
