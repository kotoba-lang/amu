  (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r len 16)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-ldr base 7 328)) (gn-emit (gn-e-addsl base base 17 3))))
