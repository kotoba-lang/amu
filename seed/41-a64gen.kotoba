    172 (gn-dot-at? M (+ p 172) 10 (gn-sir M (+ p 175) IF-A) 0 0)
    173 (and (ac-label M p 173) (gn-dot-at? M (+ p 173) 9 (gn-sir M (+ p 173) IF-A) 0 0))
    174 (gn-dot-at? M (+ p 174) 4 0 8 0)
    175 (and (ac-label M p 175) (gn-dot-at? M (+ p 175) 9 (gn-sir M (+ p 175) IF-A) 0 0))
    176 (gn-dot-at? M (+ p 176) 19 0 0 0)
    177 (gn-dot-at? M (+ p 177) 2 f 0 0)
    false) (ac-shape M p f A L O H (inc k)))))
(defn- ac-meta [M :vector-i64 f :i64 n :i64 ns :i64 dp :i64 count :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (<= p (- (vector-at M MM-SIR-N) count))
    (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) ns)
    (= (gn-fnf M f FF-DEPTH) dp) (= (gn-fnf M f FF-RTYPE) TY-I64)
    (or (= (gn-fnf M f FF-KIND) FK-DEFN) (= (gn-fnf M f FF-KIND) FK-PRIV))))))
(defn- ac-types [M :vector-i64 f :i64 k :i64] :bool
 (if (= k 8) true
  (and (= (td-pt M f k) (case k (0 3) TY-STR 5 TY-VEC TY-I64))
   (ac-types M f (inc k)))))
(defn- ac-ascii [M :vector-i64 b :i64 k :i64 n :i64] :bool
 (if (= k n) true (let [v (vector-at M (+ MM-LITB-BASE b k))]
  (and (>= v 0) (< v 128) (ac-ascii M b (inc k) n)))))
(defn- ac-literals [M :vector-i64 k :i64 V :vector-i64] :vector-i64
 (if (= k (vector-at M MM-LIT-N)) V
  (let [b (gn-litf M k LF-B) n (gn-litf M k LF-LEN) count (vector-at V 0)]
   (if (or (< b 0) (< n 0) (> n 65535) (> b (- (vector-at M MM-LITB-N) n)))
    (vector-assoc! V 0 -1)
    (if (and (> n 0) (ac-ascii M b 0 n))
     (if (>= count 8) (vector-assoc! V 0 -1)
      (ac-literals M (inc k) (-> V (vector-assoc! (inc count) k) (vector-assoc! 0 (inc count)))))
     (ac-literals M (inc k) V))))))
(defn- ac-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (>= i (vector-at M MM-SIR-N)) (> (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (dec i) (- (vector-at M MM-SIR-N) 178))
  (not= (gn-op M (dec i)) OP-FN) (not= (gn-g M gn-f-leaf) 0)
  (not= (gn-g M gn-f-freg) 0) (not= (gn-g M gn-f-vmode) 0)
  (not= (gn-g M gn-f-h) 0) (not= (gn-g M gn-f-skip) 0)
  (not= (gn-g M gn-f-ns) 12) (not= (gn-g M gn-f-dp) 12)
  (not= (gn-g M gn-f-nsv) 10) (not= (gn-g M gn-f-fb) 288)
  (not= (gn-g M gn-f-out) 0)
  (< (vector-at M MM-LIT-N) 1) (> (vector-at M MM-LIT-N) MM-LIT-CAP)
  (< (vector-at M MM-LITB-N) 0) (> (vector-at M MM-LITB-N) MM-LITB-CAP)) false
  (let [p (dec i) f (gn-sir M p IF-A)]
   (if (not (and (ac-meta M f 8 12 12 178) (= (gn-fnf M f FF-SIR) p))) false
    (let [A (gn-sir M (+ p 11) IF-A) O (gn-sir M (+ p 151) IF-A) H (gn-sir M (+ p 160) IF-A)]
     (if (not (and (ac-meta M A 2 2 2 17) (ac-meta M O 2 2 3 28)
                   (ac-meta M H 5 8 3 155))) false
      (let [hp (gn-fnf M H FF-SIR) L (gn-sir M (+ hp 127) IF-A)]
       (and (= (gn-fnf M f FF-SIR) p) (ac-types M f 0)
        (= (gn-fnf M A FF-PT0) TY-STR) (= (gn-fnf M A (+ FF-PT0 1)) TY-I64)
        (= (gn-fnf M O FF-PT0) TY-STR) (= (gn-fnf M O (+ FF-PT0 1)) TY-I64)
        (= (gn-fnf M H FF-PT0) TY-STR) (= (gn-fnf M H (+ FF-PT0 1)) TY-I64)
        (= (gn-fnf M H (+ FF-PT0 2)) TY-STR) (= (gn-fnf M H (+ FF-PT0 3)) TY-I64)
        (= (gn-fnf M H (+ FF-PT0 4)) TY-VEC)
        (ac-meta M L 1 1 2 20) (= (gn-fnf M L FF-PT0) TY-I64)
        (ac-reader-shape M (gn-fnf M A FF-SIR) A A L O H 0)
        (ac-lower-shape M (gn-fnf M L FF-SIR) L A L O H 0)
        (ac-length-shape M (gn-fnf M O FF-SIR) O A L O H 0)
        (ac-match-shape M hp H A L O H 0) (ac-shape M p f A L O H 0)
        (loop [k 1] (if (> k 12) true
         (and (= (gn-sreg M k) (case k 1 20 2 21 3 26 4 23 5 24 6 25 7 19 8 -1 9 22 10 27 11 28 -1))
          (recur (inc k)))))))))))))
;; Compare metadata only: actual pool offset AND length, never containment.
;; x8 offset/x9 length, result saved byte base dst. Q collects success edges.
(defn- ac-pool [M :vector-i64 V :vector-i64 Q :vector-i64 k :i64] :vector-i64
 (if (> k (vector-at V 0)) M
  (let [lit (vector-at V k) n (gn-litf M lit LF-LEN)
        m0 (-> M (gn-mov-imm 17 n) (gn-emit (enc-cmp-r 9 17))) skip (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-fix FX-LIT32 lit)
          (gn-emit (enc-movz 17 0 0)) (gn-emit (enc-movk 17 0 1)) (gn-emit (enc-cmp-r 8 17)))
        m2 (nr-guard m1 Q (dec k) (enc-cond-eq)) end (vector-at m2 MM-CODE-N)]
   (ac-pool (gn-dot-patch m2 skip end (enc-cond-ne)) V Q (inc k)))))
(defn- ac-string [M :vector-i64 V :vector-i64 G :vector-i64 g :i64 r :i64 dst :i64] :vector-i64
 (let [m0 (-> M (gn-emit (enc-ldr 16 7 288)) (gn-emit (enc-ldr 16 16 0))
   (gn-emit (enc-sub-i 17 r 1)) (gn-emit (enc-cmp-r 17 16)) (nr-guard G g (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 296)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 8 9 16 0)))
   Q (vector-alloc 8) m1 (ac-pool m0 V Q 1) fail (vector-at m1 MM-CODE-N)
   m2 (gn-emit m1 (enc-b 0)) success (vector-at m2 MM-CODE-N)
   m3 (loop [current m2 k 0] (if (= k (vector-at V 0)) current
    (recur (gn-dot-patch current (vector-at Q k) success (enc-cond-eq)) (inc k))))
   m4 (-> m3 (gn-emit (enc-ldr dst 7 CTX-CODE-BASE)) (gn-emit (enc-add-r dst dst 8))
     (gn-emit (enc-add-r 17 8 9)) (gn-emit (enc-ldr 16 7 392))
     (gn-emit (enc-cmp-r 17 16)) (nr-guard G (if (= g 3) 16 17) 8))
   save (vector-assoc! G (inc g) fail)] m4))
(defn- ac-charge [M :vector-i64] :vector-i64
 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-subs-i 16 16 1))
   (gn-emit (enc-bcond (enc-cond-hs) 2)) (gn-emit (enc-brk 0)) (gn-emit (enc-str 16 7 CTX-FUEL))))
(defn- ac-lower [M :vector-i64 r :i64] :vector-i64
 (-> M (gn-emit (enc-cmp-i r 65)) (gn-emit (enc-bcond (enc-cond-lt) 4))
   (gn-emit (enc-cmp-i r 90)) (gn-emit (enc-bcond (enc-cond-gt) 2)) (gn-emit (enc-add-i r r 32))))
(defn- ac-cold [M :vector-i64 p :i64 k :i64 C :vector-i64] :vector-i64
 (if (= k 178) M
  (let [z (if (= k 2) (vector-assoc! C 0 (vector-at M MM-CODE-N))
           (if (= k 12) (vector-assoc! C 1 (vector-at M MM-CODE-N))
            (if (= k 37) (vector-assoc! C 2 (vector-at M MM-CODE-N)) C)))
        m1 (gn-ins M (+ p k) (gn-op M (+ p k))) skip (gn-g m1 gn-f-skip)]
   (ac-cold (gn-gs m1 gn-f-skip 0) p (+ k 1 skip) C))))
(defn- ac-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (ac-admit M i)) M
  (let [V (ac-literals M 0 (vector-alloc 9))]
   (if (<= (vector-at V 0) 0) M
    (let [B (gp-save-state M) G (vector-alloc 20) C (vector-alloc 3) p (dec i)
     head (vector-at M MM-CODE-N)
     m0 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-cmp-i 16 9)) (nr-guard G 0 (enc-cond-lo))
      (gn-emit (enc-cmp-r 19 26)) (nr-guard G 1 (enc-cond-gt))
      (gn-ld 16 8) (gn-emit (enc-cmp-i 16 0)) (nr-guard G 2 (enc-cond-gt))
      (gn-emit (enc-add-r 2 21 19)))
     m1 (ac-string m0 V G 3 20 0)
     m2 (-> m1 (gn-emit (enc-sub-i 9 9 1)) (gn-emit (enc-cmp-r 2 9)) (nr-guard G 5 (enc-cond-hs)))
     m3 (ac-string m2 V G 6 23 1)
     m4 (-> m3 (gn-emit (enc-cmp-r 24 9)) (nr-guard G 8 (enc-cond-hs))
      (gn-emit (enc-sub-i 17 25 1)) (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
      (gn-emit (enc-cmp-r 17 16)) (nr-guard G 9 (enc-cond-hs))
      (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 8 9 16 0))
      (gn-emit (enc-cmp-i 9 3)) (nr-guard G 10 9)
      (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 8 3))
      ;; First distinct payload read follows exactly its original at entry charge.
      (ac-charge) (gn-emit (gn-e-ldrb 5 0 2)))
     m5 (loop [current m4 k 0] (if (= k 5) current
      (recur (-> current (gn-emit (enc-cmp-i 5 (case k 0 93 1 92 2 124 3 36 46)))
        (nr-guard G (+ 11 k) (enc-cond-eq))) (inc k))))
     m6 (-> m5 (ac-charge) (gn-emit (enc-cmp-i 5 45))) minus (vector-at m6 MM-CODE-N)
     m7 (-> m6 (gn-emit (enc-bcond (enc-cond-eq) 0)) (ac-charge)
      (gn-emit (enc-add-i 16 2 1)) (gn-emit (gn-e-ldrb 6 0 16))
      (gn-emit (enc-cmp-i 6 45))) range (vector-at m7 MM-CODE-N)
     m8 (gn-emit m7 (enc-bcond (enc-cond-eq) 0)) ordinary (vector-at m8 MM-CODE-N)
     m9 (-> (gn-dot-patch m8 minus ordinary (enc-cond-eq))
      ;; op-len entry, its reused reader, match-op entry, its reused reader,
      ;; then original subject reader entry before the second distinct byte.
      (ac-charge) (ac-charge) (ac-charge) (ac-charge) (ac-charge)
      (gn-emit (gn-e-ldrb 10 1 24)) (gn-emit (enc-ldr 16 4 24)) (gn-mov-imm 17 1)
      (gn-emit (enc-and-r 16 16 17)) (gn-emit (enc-cmp-i 16 1))) raw (vector-at m9 MM-CODE-N)
     m10 (-> m9 (gn-emit (enc-bcond (enc-cond-ne) 0)) (ac-lower 5) (ac-lower 10)) cmp (vector-at m10 MM-CODE-N)
     m11 (-> (gn-dot-patch m10 raw cmp (enc-cond-ne)) (gn-emit (enc-cmp-r 5 10))
      (gn-emit (enc-cset 9 (enc-cond-eq))) (gn-emit (gn-e-lsl 9 9 1)) (gn-emit (enc-sub-i 9 9 1))
      (gn-emit (enc-str 2 31 112)) (gn-emit (enc-str 9 31 120))
      (gn-emit (enc-add-i 19 19 1)) (gn-emit (enc-str 19 31 128)) (gn-st 9 8)
      (ac-charge)) back (vector-at m11 MM-CODE-N)
     m12 (gn-emit m11 (enc-b (- head back)))
     first (vector-at m12 MM-CODE-N) m13 (-> m12 (gn-mov 0 5) (gn-mov 1 2) (gn-mov 9 5)) firstb (vector-at m13 MM-CODE-N)
     m14 (gn-emit m13 (enc-b 0)) second (vector-at m14 MM-CODE-N)
     m15 (-> m14 (gn-mov 0 6) (gn-emit (enc-add-i 1 2 1)) (gn-mov 9 6)) secondb (vector-at m15 MM-CODE-N)
     m16 (gn-emit m15 (enc-b 0)) cold (vector-at m16 MM-CODE-N)
     m17 (ac-cold (gp-restore m16 B) p 2 C)
     m18 (loop [current m17 k 0] (if (= k 18) current
       (let [at (vector-at G k)]
        (recur (if (and (>= k 11) (<= k 15)) current (if (or (= k 4) (= k 7)) (gn-put current (+ MM-CODE-BASE at) (enc-b (- cold at)))
          (gn-dot-patch current at cold (case k (3 5 6 8 9) (enc-cond-hs) (1 2) (enc-cond-gt) 10 9 (16 17) 8 (enc-cond-lo))))) (inc k)))))
     m19 (loop [current m18 k 11] (if (= k 16) current
      (recur (gn-dot-patch current (vector-at G k) first (enc-cond-eq)) (inc k))))]
     (-> m19 (gn-dot-patch range second (enc-cond-eq))
       (gn-put (+ MM-CODE-BASE firstb) (enc-b (- (vector-at C 1) firstb)))
       (gn-put (+ MM-CODE-BASE secondb) (enc-b (- (vector-at C 2) secondb)))
       (gn-put (+ MM-LABEL-BASE (gn-sir M (+ p 2) IF-A)) head)
       (gn-gs gn-f-dead 0) (gn-gs gn-f-skip 176)))))))


;; ---- md5 rounds, unrolled: (rounds v offset block r k i a0 b0 c0 d0 a b c d) runs steps i..63 (f by the step's
;; quarter, g its word index, sum = mask32(a + f + k[i] + word-at(v, offset, g)), b' = mask32(b + rotate-left(sum,
;; r[i])), (a b c d) := (d b' b c)) and then puts mask32(a0 + a) .. mask32(d0 + d) at v[2080..2083]. The whole SIR of
;; rounds and of its helpers is the one mdc-admit certifies.
;; slot s into register d (its callee-saved home, or the frame)
(defn- md5k-get [M :vector-i64 d :i64 s :i64] :vector-i64
 (let [r (gn-sreg M s)] (if (and (>= r 19) (<= r 28)) (gn-mov M d r) (gn-ld M d s))))
(defn- md5k-home? [M :vector-i64 s :i64] :bool
 (let [r (gn-sreg M s)] (or (= r -1) (and (>= r 19) (<= r 28)))))
(defn- md5k-admit [M :vector-i64 i :i64] :bool
 (and (mdc-admit M i) (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-ctx) 1)
  (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
  (loop [s 1] (or (> s 14) (and (md5k-home? M s) (recur (inc s)))))
  (let [p (dec i) mk (gn-sir M (+ p 12) IF-A) pt (gn-sir M (+ p 13) IF-A)
        q (gn-fnf M pt FF-SIR) l (gn-sir M (+ q 2) IF-A)]
   ;; mdc-admit checks the rest; here: mask32 charges nothing, put is (vector-assoc! v i x) with one charge
   (and (not= (gn-op M (inc (gn-fnf M mk FF-SIR))) OP-FUEL) (> q 0) (< (+ q 8) (vector-at M MM-SIR-N))
        (gn-dot-at? M q OP-FN pt 3 3) (gn-dot-at? M (+ q 1) OP-FUEL 0 0 0) (gn-dot-at? M (+ q 2) OP-LABEL l 0 0)
        (gn-dot-at? M (+ q 3) OP-LGET 0 1 0) (gn-dot-at? M (+ q 4) OP-LGET 1 2 0) (gn-dot-at? M (+ q 5) OP-LGET 2 3 0)
        (gn-dot-at? M (+ q 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3) (gn-dot-at? M (+ q 7) OP-RET 0 0 0)
        (gn-dot-at? M (+ q 8) OP-END pt 0 0)))))
(defn- md5k-vec [M :vector-i64 G :vector-i64 rv :i64 dst :i64 lenr :i64] :vector-i64
 (-> M (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
  (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 lenr 16 0))
  (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r lenr 16)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-ldr dst 7 328)) (gn-emit (gn-e-addsl dst dst 17 3))))
(defn- md5k-g [i :i64] :i64
 (cond (< i 16) i (< i 32) (bit-and (+ (* 5 i) 1) 15) (< i 48) (bit-and (+ (* 3 i) 5) 15) :else (bit-and (* 7 i) 15)))
(defn- md5k-w [base :i64 d :i64 n :i64 m :i64 sh :i64] :i64 (+ (enc-rrr base d n m) (* sh 1024)))
;; step i with a b c d in registers A B C D (x0 = &v[offset], x1 = k, x2 = r, x9 = 32): the 32-bit lanes are exact
;; (every value the step keeps is mask32ed; f, the word and the sum only matter mod 2^32); rotate-left of the 32-bit sum
;; by r[i] (the 64-bit shift pair of the source) equals ror by 32 - r[i] when r[i] <= 31: each step's ccmp keeps the
;; flags "ls" only while every r[i] so far is, and the quarter dispatch enters with "lo". b' lands in A; the next step's (a b c d) is (D A B C).
;; t = a + k[i] + word comes first (a is three steps old), so only f, one add, the rotation and the last add wait for b;
;; f by the quarter: ((c ^ d) & b) ^ d; (c & ~d) + (b & d) (disjoint bits, one add of each); b ^ (c ^ d); (b | ~d) ^ c
(defn- md5k-step1 [M :vector-i64 i :i64 A :i64 B :i64 C :i64 D :i64] :vector-i64
 (let [g (md5k-g i)
        m1 (-> M (gn-emit (enc-ldp 11 12 0 (* 32 g))) (gn-emit (enc-ldp 13 14 0 (+ (* 32 g) 16)))
            (gn-emit (md5k-w 0x0b000000 11 11 12 8)) (gn-emit (md5k-w 0x0b000000 11 11 13 16))
            (gn-emit (md5k-w 0x0b000000 11 11 14 24))
            (gn-emit (enc-ldr 15 1 (* 8 i))) (gn-emit (enc-ldr 16 2 (* 8 i)))
            (gn-emit (md5k-w 0x0b000000 10 A 15 0)) (gn-emit (md5k-w 0x0b000000 10 10 11 0))
            (gn-emit (enc-sub-r 15 9 16)))
        m2 (cond (< i 16) (-> m1 (gn-emit (md5k-w 0x4a000000 17 C D 0)) (gn-emit (md5k-w 0x0a000000 17 17 B 0))
                              (gn-emit (md5k-w 0x4a000000 17 17 D 0)) (gn-emit (md5k-w 0x0b000000 10 10 17 0)))
                 (< i 32) (-> m1 (gn-emit (md5k-w 0x0a200000 17 C D 0)) (gn-emit (md5k-w 0x0b000000 10 10 17 0))
                              (gn-emit (md5k-w 0x0a000000 17 B D 0)) (gn-emit (md5k-w 0x0b000000 10 10 17 0)))
                 (< i 48) (-> m1 (gn-emit (md5k-w 0x4a000000 17 C D 0)) (gn-emit (md5k-w 0x4a000000 17 17 B 0))
                              (gn-emit (md5k-w 0x0b000000 10 10 17 0)))
                 :else (-> m1 (gn-emit (md5k-w 0x2a200000 17 B D 0)) (gn-emit (md5k-w 0x4a000000 17 17 C 0))
                           (gn-emit (md5k-w 0x0b000000 10 10 17 0))))]
  ;; ror by 32 - r[i] (= rotate-left by r[i] for r[i] <= 31; the flags carry "every r so far <= 31", tested after the
  ;; last step); then b' = b + the rotated sum
  (-> m2 (gn-emit 0xFA5F9A02) (gn-emit 0x1ACF2D4A) (gn-emit (md5k-w 0x0b000000 A B 10 0)))))
;; after the prologue (OP-FUEL hook): guards i in {0, 16, 32, 48}, fuel >= 3 (64 - i) + 4 (word-at, rotate-left and
;; the self call per step, four puts), v live with 2083 and offset + 63 inside it (0 <= offset), k and r live with 64
;; items; then one fuel publication, the quarters from i on (16 steps each, so the a b c d registers are x3..x6 again
;; at every quarter start), the four stores in order and the epilogue. A failing guard falls into the code after it.
(defn- md5k-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (md5k-admit M i)) M
  (let [p (dec i) G (vector-alloc 27) K0 (gn-sir M (+ p 8) IF-B)
        m0 (-> M (md5k-get 15 6) (gn-emit (enc-cmp-i 15 63)) (ri-cold G 8)
             (gn-emit (gn-e-bf 0xf2400000 31 15 0 3)) (ri-cold G (enc-cond-ne))
             (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov-imm 10 64) (gn-emit (enc-sub-r 10 10 15))
             (gn-emit (gn-e-addsl 10 10 10 1)) (gn-emit (enc-add-i 10 10 4))
             (gn-emit (enc-cmp-r 8 10)) (ri-cold G (enc-cond-lo))
             (md5k-get 11 1) (md5k-vec G 11 0 12) (gn-emit (enc-cmp-i 12 (+ K0 4))) (ri-cold G (enc-cond-lo))
             (md5k-get 13 2) (gn-emit (enc-sub-i 14 12 64)) (gn-emit (enc-cmp-r 13 14)) (ri-cold G 8)
             (gn-emit (gn-e-addsl 0 0 13 3))
             (md5k-get 11 5) (md5k-vec G 11 1 12) (gn-emit (enc-cmp-i 12 64)) (ri-cold G (enc-cond-lo))
             (md5k-get 11 4) (md5k-vec G 11 2 12) (gn-emit (enc-cmp-i 12 64)) (ri-cold G (enc-cond-lo))
             ;; every guard passed
             (gn-emit (enc-sub-r 8 8 10)) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov-imm 9 32)
             (md5k-get 3 11) (md5k-get 4 12) (md5k-get 5 13) (md5k-get 6 14)
             (gn-emit (enc-cmp-i 15 16))) j1 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-cmp-i 15 32))) j2 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-cmp-i 15 48))) j3 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-cmp-i 15 64))) j4 (vector-at m3 MM-CODE-N)
        m4 (gn-emit m3 (enc-b 0)) q1 (vector-at m4 MM-CODE-N)
        m5 (md5k-step-range m4 0 16) q2 (vector-at m5 MM-CODE-N)
        m6 (md5k-step-range m5 16 32) q3 (vector-at m6 MM-CODE-N)
        m7 (md5k-step-range m6 32 48) q4 (vector-at m7 MM-CODE-N)
        m7b (md5k-step-range m7 48 64) hb (vector-at m7b MM-CODE-N)
        ;; some r[i] above 31: the fuel paid at entry back, the original code (nothing was stored)
        m8 (-> m7b (gn-emit (enc-bcond 8 0))
             (md5k-get 16 2) (gn-emit (+ (enc-sub-r 0 0 16) (* 3 1024)))
             (md5k-get 16 7) (gn-emit (md5k-w 0x0b000000 16 16 3 0)) (gn-emit (enc-str 16 0 (* 8 K0)))
             (md5k-get 16 8) (gn-emit (md5k-w 0x0b000000 16 16 4 0)) (gn-emit (enc-str 16 0 (* 8 (gn-sir M (+ p 14) IF-B))))
             (md5k-get 16 9) (gn-emit (md5k-w 0x0b000000 16 16 5 0)) (gn-emit (enc-str 16 0 (* 8 (gn-sir M (+ p 20) IF-B))))
             (md5k-get 16 10) (gn-emit (md5k-w 0x0b000000 16 16 6 0)) (gn-emit (enc-str 16 0 (* 8 (gn-sir M (+ p 26) IF-B))))
             (md5k-get 0 1) (gn-epilogue) (gn-gs gn-f-dead 0) (gn-emit 0xD5032FFF)) fb (vector-at m8 MM-CODE-N)
        m9 (-> m8 (md5k-get 15 6) (gn-mov-imm 10 64) (gn-emit (enc-sub-r 10 10 15))
             (gn-emit (gn-e-addsl 10 10 10 1)) (gn-emit (enc-add-i 10 10 4)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
             (gn-emit (enc-add-r 8 8 10)) (gn-emit (enc-str 8 7 CTX-FUEL)))
        cold (vector-at m9 MM-CODE-N)]
   (-> m9 (gn-dot-patch hb fb 8) (gn-dot-patch j1 q1 (enc-cond-lo)) (gn-dot-patch j2 q2 (enc-cond-lo)) (gn-dot-patch j3 q3 (enc-cond-lo))
    (gn-put (+ MM-CODE-BASE j4) (enc-b (- q4 j4))) (ri-patch G 0 cold)))))
;; steps [i, e) starting with a b c d in x3 x4 x5 x6 (e - i a multiple of 4: they end there again)
(defn- md5k-step-range [M :vector-i64 i :i64 e :i64] :vector-i64
 (md5k-step-to M i e 3 4 5 6))
(defn- md5k-step-to [M :vector-i64 i :i64 e :i64 A :i64 B :i64 C :i64 D :i64] :vector-i64
 (if (= i e) M (md5k-step-to (md5k-step1 M i A B C D) (inc i) e D A B C)))

;; ADR0357 one-off new closed readonly carry-loop algorithm; no existing
;; mechanical AST rule supplies this semantic certificate. No name dispatch.
(defn- mdc-pattern [kind :i64] :vector-i64
 (case kind 0 [5066614005235713 18 4229300233 25769803780 274877972483 65543 277038275493899 4294967300 8933532041219 30064902148 47244836868 8590000134 281487860891661 844429224312845 8937827008515 34359869444 51539804164 8590000134 281487860891661 844429224312845 8942121975811 38654836740 55834771460 8590000134 281487860891661 844429224312845 8946416943107 42949804036 60129738756 8590000134 281487860891661 844429224312845 4223008778 4227268617 25769803780 51539673092 55834705924 60129738756 1125904200957965 983045 25769803780 281479270760461 1048581 47244640260 64424574980 65542 21474902020 25769934852 562954259922958 4295098372 8590131204 68719738884 844437814050829 4295032838 65542 281479270957069 1114117 51539607556 73014509572 17180000260 25770000388 562958554890254 562958542307341 65542 281479270957069 1179653 4294967300 8590000132 12885032964 17180065796 21475098628 25770131460 4295360515 21474902022 30065164292 34360197124 38655229956 42950262788 60130197508 77310132228 51540393988 55835426820 65541 4295098373 8590131205 12885164037 17180196869 21475229701 25770262533 30065295365 34360328197 38655361029 42950393861 47245426693 51540459525 55835492357 18 4229300234 4223008777 19 4294901762] 1 [1125917086646273 18 4229300233 8589934596 12884967428 17180000259 4295163910 65542 262149 4294967300 17179934724 562949964955662 4295032836 17180000260 4295163907 8590000134 562954259922958 34359869443 4295491590 65542 4295032836 17180000260 8590131203 8590000134 562954259922958 68719607811 4295491590 65542 4295032836 17180000260 12885098499 8590000134 562954259922958 103079346179 4295491590 65542 19 4294901762] 2 [562962838257665 18 4229300233 4294967300 281479270957069 8590000132 524294 4295032836 281483565924365 137439084547 8590131204 8590065670 4295557126 393222 281479270957069 19 4294901762] 3 [1125921381613569 4229365769 4294967300 68719542275 131079 277115584905227 8589934596 12884967428 327686 8590000132 4295098376 17180000260 4295294982 393222 4226220042 4228448265 4294967300 137439019011 131079 277055455363083 17179869188 8590000132 327686 17179934724 4295098376 12885032964 4295294982 393222 4226285578 4227530761 4294967300 206158495747 131079 277008210722827 8589934596 12884967428 458758 17179934724 458758 4226351114 4226809865 12884901892 8590000132 17180000260 8590065672 4295360518 458758 4226351113 4226285577 4226220041 19 4294901762] 4 [281483566579713 4229365769 4294967300 68719542275 131079 277145649676299 4294967300 4226678794 4228907017 4294967300 137439019011 131079 277089815101451 21474836483 4295032836 196614 4295032835 65542 64424574979 327686 4226744330 4228055049 4294967300 206158495747 131079 277033980526603 12884901891 4295032836 196614 21474902019 65542 64424574979 327686 4226809866 4227203081 30064771075 4295032836 196614 64424574979 327686 4226809865 4226744329 4226678793 19 4294901762] []))
(defn- mdc-value [M :vector-i64 p :i64 T :vector-i64 e :i64] :i64
 (cond (= e -1) (vector-at T 0) (<= e -1000) (gn-sir M (+ p (- (- 0 e) 1000)) IF-A)
       (<= e -10) (vector-at T (- (- 0 e) 10)) :else e))
(defn- mdc-match [M :vector-i64 p :i64 T :vector-i64 kind :i64] :bool
 (let [V (mdc-pattern kind) count (vector-count V)]
  (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
   (loop [k 0] (or (= k count)
    (let [w (vector-at V k) op (bit-and w 65535)
          a (i64-shift-right (i64-shift-left w 32) 48)
          b (i64-shift-right (i64-shift-left w 16) 48) c (i64-shift-right w 48)]
     (and (gn-dot-at? M (+ p k) op (mdc-value M p T a) (mdc-value M p T b) c)
          (recur (inc k)))))))))
(defn- mdc-counts [M :vector-i64] :bool
 (and (> (vector-at M MM-SIR-N) 0) (< (vector-at M MM-SIR-N) MM-SIR-CAP)
      (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)))
(defn- mdc-safe-wrapper [M :vector-i64 f :i64 n :i64] :bool
 (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (let [p (gn-fnf M f FF-SIR) limit (vector-at M MM-SIR-N)]
   (and (> p 0) (<= 2 (- limit p)) (= (gn-op M p) OP-FN)
    (= (gn-sir M p IF-A) f)
    (let [start (+ p 1 (if (= (gn-op M (inc p)) OP-FUEL) 1 0))]
     (loop [q start work 64]
      (and (> work 0) (> q 0) (< q limit)
       (if (= (gn-op M q) OP-LABEL) (recur (inc q) (dec work))
        (let [tail (if (= n 1) 4 (+ n 2))]
         (and (< tail (- limit q)) (= (gn-op M (+ q tail)) OP-END)
              (= (gn-sir M (+ q tail) IF-A) f)))))))))
))
(defn- mdc-helper [M :vector-i64 T :vector-i64 kind :i64] :bool
 (let [f (vector-at T (case kind 1 5 2 6 3 3 4 4 0))]
  (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
   (let [n (case kind 1 3 2 2 3 4 4 1 0) slots (case kind 1 4 2 2 3 4 4 1 0)
         depth (case kind 1 4 2 4 3 3 4 2 0) p (gn-fnf M f FF-SIR)
         U (vector-assoc T 0 f)]
    (and (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) slots)
     (= (gn-fnf M f FF-DEPTH) depth) (= (gn-fnf M f FF-RTYPE) TY-I64)
     (loop [k 0] (or (= k n) (and (= (ck-pt M f k) (if (and (= kind 1) (= k 0)) TY-VEC TY-I64)) (recur (inc k)))))
     (mdc-match M p U kind))))))
(defn- mdc-regs [M :vector-i64 s :i64] :bool
 (or (> s 18) (and (= (gn-sreg M s)
  (case s 1 21 2 24 4 25 5 26 6 19 7 27 8 28 12 20 13 22 14 23 -1))
  (recur M (inc s)))))
(defn- mdc-admit [M :vector-i64 i :i64] :bool
 (and (mdc-counts M) (> i 1) (< i (vector-at M MM-SIR-N))
  (<= 101 (- (vector-at M MM-SIR-N) (dec i))) (= (gn-op M (dec i)) OP-FN)
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 14)
    (= (gn-fnf M f FF-NSLOTS) 18) (= (gn-fnf M f FF-DEPTH) 14)
    (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (loop [k 0] (or (= k 14) (and (= (ck-pt M f k) (if (or (= k 0) (= k 3) (= k 4)) TY-VEC TY-I64)) (recur (inc k)))))
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (<= (gn-g M gn-f-vmode) 0)
    (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-fb) 352) (= (gn-g M gn-f-nsv) 10)
    (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-g M gn-f-ctx) 1) (mdc-regs M 1)
    (let [T [f (gn-sir M (+ p 12) IF-A) (gn-sir M (+ p 13) IF-A)
             (gn-sir M (+ p 38) IF-A) (gn-sir M (+ p 41) IF-A)
             (gn-sir M (+ p 52) IF-A) (gn-sir M (+ p 62) IF-A)]
          mask (vector-at T 1) put (vector-at T 2)]
     (and (mdc-safe-wrapper M mask 1) (mdc-safe-wrapper M put 3)
      (= (gn-scalar-mask M (+ p 12) mask 1) 32)
      (not (gn-clamp-open M put)) (= (gn-wrapper M put 0 3) (+ 256 RT-VECTOR-ASSOC-IN-PLACE))
      (mdc-match M p T 0) (mdc-helper M T 1) (mdc-helper M T 2)
      (mdc-helper M T 3) (mdc-helper M T 4)))))))
(defn- mdc-miss [M :vector-i64 G :vector-i64 cond :i64] :vector-i64
 (let [n (vector-at G 40) a (vector-assoc! G (* n 2) (vector-at M MM-CODE-N))
       b (vector-assoc! a (inc (* n 2)) cond) c (vector-assoc! b 40 (inc n))]
  (gn-emit M (enc-bcond cond 0))))
(defn- mdc-root [M :vector-i64 G :vector-i64 rv :i64 dst :i64 lower :i64] :vector-i64
 (-> M (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
  (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16)) (mdc-miss G (enc-cond-hs))
  (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
  (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
  (gn-emit (enc-cmp-r 0 16)) (mdc-miss G (enc-cond-hs))
  (gn-emit (enc-cmp-r 0 lower)) (mdc-miss G (enc-cond-lo))
  (gn-emit (enc-ldr dst 7 328)) (gn-emit (gn-e-addsl dst dst 17 3))))
(defn- mdc-fg [M :vector-i64] :vector-i64
 (let [m0 (gn-emit M (enc-cmp-i 19 16)) b0 (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ge) 0))
    (gn-emit (enc-and-r 9 20 22)) (gn-emit (enc-mvn 10 20)) (gn-emit (enc-and-r 10 10 23))
    (gn-emit (enc-orr-r 9 9 10)) (gn-mov 0 19)) e0 (vector-at m1 MM-CODE-N)
  m2 (-> m1 (gn-emit (enc-b 0)) (gn-emit (enc-cmp-i 19 32))) b1 (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ge) 0))
    (gn-emit (enc-and-r 9 23 20)) (gn-emit (enc-mvn 10 23)) (gn-emit (enc-and-r 10 10 22))
    (gn-emit (enc-orr-r 9 9 10)) (gn-mov-imm 16 5) (gn-emit (enc-mul 0 19 16))
    (gn-emit (enc-add-i 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 3))) e1 (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-b 0)) (gn-emit (enc-cmp-i 19 48))) b2 (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond (enc-cond-ge) 0))
    (gn-emit (enc-eor-r 9 20 22)) (gn-emit (enc-eor-r 9 9 23))
    (gn-mov-imm 16 3) (gn-emit (enc-mul 0 19 16)) (gn-emit (enc-add-i 0 0 5))
    (gn-emit (gn-e-bf 0xd3400000 0 0 0 3))) e2 (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-b 0)) (gn-emit (enc-mvn 10 23))
    (gn-emit (enc-orr-r 10 20 10)) (gn-emit (enc-eor-r 9 22 10))
    (gn-mov-imm 16 7) (gn-emit (enc-mul 0 19 16)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 3))) end (vector-at m6 MM-CODE-N)]
 (-> m6 (gn-dot-patch b0 (+ e0 1) (enc-cond-ge)) (gn-dot-patch b1 (+ e1 1) (enc-cond-ge))
  (gn-dot-patch b2 (+ e2 1) (enc-cond-ge))
  (gn-put (+ MM-CODE-BASE e0) (enc-b (- end e0)))
  (gn-put (+ MM-CODE-BASE e1) (enc-b (- end e1)))
  (gn-put (+ MM-CODE-BASE e2) (enc-b (- end e2))))))
(defn- mdc-body [M :vector-i64] :vector-i64
 (-> M (mdc-fg) (shloop-get 10 11) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (gn-e-ldrr 11 4 19 1)) (gn-emit (enc-add-r 9 9 11)) (gn-st 9 15)
  ;; Original word helper's private charge precedes its first payload read.
  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-subs-i 8 8 1))
  (gn-emit (enc-bcond (enc-cond-hs) 3)) (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))
  (gn-emit (gn-e-addsl 0 24 0 2)) (gn-emit (gn-e-ldrr 9 6 0 1))
  (gn-emit (enc-add-i 1 0 1)) (gn-emit (gn-e-ldrr 10 6 1 1))
  (gn-emit (gn-e-lsl 10 10 8)) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (enc-add-i 1 0 2)) (gn-emit (gn-e-ldrr 10 6 1 1))
  (gn-emit (gn-e-lsl 10 10 16)) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (enc-add-i 1 0 3)) (gn-emit (gn-e-ldrr 10 6 1 1))
  (gn-emit (gn-e-lsl 10 10 24)) (gn-emit (enc-add-r 9 9 10))
  (gn-emit (enc-str 8 7 CTX-FUEL))
  (gn-ld 10 15) (gn-emit (enc-add-r 0 9 10)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31))
  ;; Original shift payload read precedes rotate's public entry transaction.
  (gn-emit (gn-e-ldrr 1 3 19 1)) (gn-op-fuel)
  (gn-emit (gn-e-bf 0xd3400000 9 0 0 31)) (gn-emit (enc-lslv 9 9 1))
  (gn-emit (gn-e-bf 0xd3400000 10 0 0 31)) (gn-mov-imm 16 32)
  (gn-emit (enc-sub-r 11 16 1)) (gn-emit (enc-lsrv 10 10 11))
  (gn-emit (enc-orr-r 9 9 10)) (gn-emit (gn-e-bf 0xd3400000 9 9 0 31))
  (gn-emit (enc-add-r 9 20 9)) (gn-emit (gn-e-bf 0xd3400000 9 9 0 31))
  (shloop-get 0 14) (shloop-put 0 11) (shloop-get 1 12) (shloop-get 2 13)
  (shloop-put 9 12) (shloop-put 1 13) (shloop-put 2 14)
  (gn-emit (enc-add-i 19 19 1)) (gn-op-fuel)))
(defn- mdc-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (mdc-admit M i)) M
  (let [G (vector-alloc 41) p (dec i) B (gp-save-state M)
   m0 (-> M (gn-emit (enc-cmp-i 19 64)) (mdc-miss G (enc-cond-hs))
     (gn-mov-imm 9 64) (gn-emit (enc-sub-r 9 9 19)) (gn-mov-imm 10 3)
     (gn-emit (enc-mul 9 9 10)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
     (gn-emit (enc-cmp-r 8 9)) (mdc-miss G (enc-cond-lo))
     (gn-mov-imm 10 1152921504606846912) (gn-emit (enc-cmp-r 24 10))
     (mdc-miss G 8) (gn-emit (enc-add-i 11 24 64))
     (mdc-root G 21 6 11) (gn-mov-imm 11 64)
     (mdc-root G 26 4 11) (mdc-root G 25 3 11)) head (vector-at m0 MM-CODE-N)
   m1 (-> m0 (mdc-body) (gn-emit (enc-cmp-i 19 64))) back (vector-at m1 MM-CODE-N)
   m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) (- head back)))
     (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0))) cold (vector-at m2 MM-CODE-N)
   m3 (gp-restore m2 B)]
   (loop [cur m3 k 0] (if (= k (vector-at G 40)) cur
     (recur (gn-dot-patch cur (vector-at G (* k 2)) cold (vector-at G (inc (* k 2)))) (inc k)))))))


;; ADR0357 one-off bounded initial packed-word phase: a new semantic
;; certificate not supplied by existing mechanical AST refactor rules.
;; No workload names, narrowing, extra frame, prepayment or reordered reads.
(defn- pwphase-pattern [kind :i64] :vector-i64
 (if (= kind 0) [1125917086646273 18 4229300233 8589934596 17179934723 12885032964 4295163910 65542 262149 4294967300 17179934724 562949964955662 103079280643 524294 4295032836 17180000260 4295163907 8590000134 562954259922958 68719607811 4295491590 65542 4295032836 17180000260 8590131203 8590000134 562954259922958 34359869443 4295491590 65542 4295032836 17180000260 12885098499 8590000134 562954259922958 65542 19 4294901762] [844442109935617 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294901762]))
(defn- pwphase-match [M :vector-i64 p :i64 f :i64 kind :i64] :bool
 (let [V (pwphase-pattern kind) count (vector-count V)]
  (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
   (loop [k 0] (or (= k count)
    (let [w (vector-at V k) op (bit-and w 65535)
          x (i64-shift-right (i64-shift-left w 32) 48)
          y (i64-shift-right (i64-shift-left w 16) 48) z (i64-shift-right w 48)
          a (if (= x -1) f (if (<= x -1000) (gn-sir M (+ p (- (- 0 x) 1000)) IF-A) x))]
     (and (gn-dot-at? M (+ p k) op a y z) (recur (inc k)))))))))
(defn- pwphase-helper [M :vector-i64 f :i64 kind :i64] :bool
 (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (not (gn-clamp-open M f))
  (let [p (gn-fnf M f FF-SIR) count (if (= kind 0) 38 9)]
   (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) (if (= kind 0) 4 3))
    (= (gn-fnf M f FF-DEPTH) (if (= kind 0) 4 3))
    (= (gn-fnf M f FF-RTYPE) (if (= kind 0) TY-I64 TY-VEC))
    (= (ck-pt M f 0) TY-VEC) (= (ck-pt M f 1) TY-I64) (= (ck-pt M f 2) TY-I64)
    (> (gn-sir M (+ p 2) IF-A) 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
    (pwphase-match M p f kind)))))
(defn- pwphase-admit [M :vector-i64 i :i64] :bool
 (and (mdc-counts M) (> i 1) (< i (vector-at M MM-SIR-N))
  (<= 72 (- (vector-at M MM-SIR-N) (dec i))) (= (gn-op M (dec i)) OP-FN)
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2)
    (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 6) (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (= (ck-pt M f 0) TY-VEC) (= (ck-pt M f 1) TY-I64)
    (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 6)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
    (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-fb) 128) (= (gn-g M gn-f-nsv) 3)
    (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-sreg M 1) 20) (= (gn-sreg M 2) 19) (= (gn-sreg M 3) 21)
    (let [n (gn-sir M (+ p 4) IF-B) t (gn-sir M (+ p 11) IF-B) base (gn-sir M (+ p 21) IF-B)]
     (and (> n 0) (<= n 4096) (> t 0) (<= t n) (>= base 0) (<= base 4095)
      (srloop-shape M p f 0) (srloop-labels M p 0)
      (pwphase-helper M (gn-sir M (+ p 17) IF-A) 0)
      (pwphase-helper M (gn-sir M (+ p 61) IF-A) 1)))))))
(defn- pwphase-cold [M :vector-i64 G :vector-i64 cond :i64] :vector-i64
 (let [n (vector-at G 16) a (vector-assoc! G (* n 2) (vector-at M MM-CODE-N))
       b (vector-assoc! a (inc (* n 2)) cond) c (vector-assoc! b 16 (inc n))]
  (gn-emit M (enc-bcond cond 0))))
;; prepaid phase (kernels B): the guards prove 0 <= i < t, fuel >= 3 (t - i) (word-at, put and the recur charge per
;; word), 4 t <= len and base + t <= len, so no charge can exhaust and no access can fail. The whole phase is paid at
;; once (x9 = 3 (t - i), x8 = fuel from the guard) and each word is packed from two ldp pairs of &v[4 i]; wrapping adds
;; give (b0 << 24) + (b1 << 16) + (b2 << 8) + b3 in any order. Words run in order (read 4 i .. 4 i + 3, then store
;; base + i), so overlapping bases behave as the original. After the loop i = t and slot 3 holds the last word.
(defn- pwphase-fast [M :vector-i64 t :i64 base :i64] :vector-i64
 (let [m0 (-> M (gn-emit (enc-sub-r 8 8 9)) (gn-emit (enc-str 8 7 CTX-FUEL))
            (gn-emit (gn-e-addsl 0 5 19 5)) (gn-emit (gn-e-addsl 1 5 19 3))
            (gn-mov-imm 2 t) (gn-emit (gn-e-addsl 2 5 2 3))) top (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-ldp 9 10 0 0)) (gn-emit (enc-ldp 11 12 0 16)) (gn-emit (enc-add-i 0 0 32))
            (gn-emit (gn-e-addsl 12 12 11 8)) (gn-emit (gn-e-addsl 12 12 10 16)) (gn-emit (gn-e-addsl 12 12 9 24))
            (gn-emit (enc-str 12 1 (* 8 base))) (gn-emit (enc-add-i 1 1 8)) (gn-emit (enc-cmp-r 1 2)))
       back (vector-at m1 MM-CODE-N)]
  (-> m1 (gn-emit (enc-bcond (enc-cond-ne) (- top back))) (gn-mov 21 12) (gn-mov-imm 19 t))))
(defn- pwphase-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (pwphase-admit M i)) M
  (let [p (dec i) t (gn-sir M (+ p 11) IF-B) base (gn-sir M (+ p 21) IF-B)
        G (vector-alloc 17) B (gp-save-state M)
        m0 (-> M (gn-mov-imm 9 t) (gn-emit (enc-cmp-r 19 9)) (pwphase-cold G (enc-cond-hs))
          (gn-emit (enc-sub-r 9 9 19)) (gn-mov-imm 10 3) (gn-emit (enc-mul 9 9 10))
          (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9)) (pwphase-cold G (enc-cond-lo))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
          (gn-emit (enc-sub-i 17 20 1)) (gn-emit (enc-cmp-r 17 16)) (pwphase-cold G (enc-cond-hs))
          (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
          (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
          (gn-emit (enc-cmp-r 0 16)) (pwphase-cold G (enc-cond-hs))
          (gn-mov-imm 16 (* t 4)) (gn-emit (enc-cmp-r 0 16)) (pwphase-cold G (enc-cond-lo))
          (gn-mov-imm 16 (+ base t)) (gn-emit (enc-cmp-r 0 16)) (pwphase-cold G (enc-cond-lo))
          (gn-emit (enc-ldr 5 7 328)) (gn-emit (gn-e-addsl 5 5 17 3)))
        m2 (-> m0 (pwphase-fast t base) (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)))
        cold (vector-at m2 MM-CODE-N)
        m3 (gp-restore m2 B)]
   (loop [cur m3 k 0] (if (= k (vector-at G 16)) cur
    (recur (gn-dot-patch cur (vector-at G (* k 2)) cold (vector-at G (inc (* k 2)))) (inc k)))))))

;; ADR0357 one-off general two-run closed pair merge loop. New semantic
;; versioning algorithm, not an existing mechanical AST rule; original PI
;; fourcharge-before-pairread and comparator-after-read publications retained.
(defn- wm-pattern [key :i64] :vector-i64 (case key 0 [1688879924969473 18 4229300233 8589934596 12884967428 65543 277137059741708 17179869188 21474902020 65543 4228775945 277089815101451 4294967300 25769869316 8590065668 12885098500 8590196740 12885032966 262147 1407379178192909 4224516106 4228055049 4294967300 17179934724 562954248257549 4295032836 8590065668 562958543224845 327687 276956671115275 4294967300 25769869316 8590065668 844429224837133 8590000132 4295098371 4295032838 12885032964 17180065796 21475098628 25770131460 4295360515 21474902022 65541 4295098373 8590131205 12885164037 17180196869] 1 [21475229701 18 4229300234 4224581642 4226023433 4294967300 25769869316 17180000260 844429224837133 8590000132 12885032964 17180065796 4295229443 12884967430 21475098628 25770131460 4295360515 21474902022 65541 4295098373 8590131205 12885164037 17180196869 21475229701 18 4229300234 4224581641 4224516105 19 4294901762] 2 [1407392063356929 18 4229300233 4294967300 12884967428 562954248257549 262149 4294967300 12884967428 8590065667 4295163910 4295098371 4295032838 562949964955662 327685 4294967300 8590000132 8590065667 4295163910 17180000260 844429224902669 8590000132 8590065667 4295163910 4295098371 4295032838 21474967556 844429224902669 19 4294901762] 4 [562962838257665 18 4229300233 4294967300 8590000132 8590065667 4295163910 562949964955662 19 4294901762] 6 [844442109935617 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294901762] 8 [1407400653291521 18 4229300233 21474836484 17179934724 65543 277141354709003 4294967300 4227399690 4228841481 4294967300 8590000132 21474967556 4295032838 12885032964 21475033092 8590000134 844429224837133 8590000132 12885032964 17180065796 21475098628 4295294979 17179934726 65541 4295098373 8590131205 12885164037 17180196869 18 4229300234 4227399689 19 4294901762] []))
(defn- wm-field [M :vector-i64 p :i64 f :i64 x :i64 vr :i64 it :i64 wr :i64 cp :i64] :i64
 (if (<= x -1000) (gn-sir M (+ p (- (- 0 x) 1000)) IF-A)
  (case x -1 f -2 vr -3 wr -4 it -5 cp x)))
(defn- wm-match [M :vector-i64 p :i64 f :i64 kind :i64 vr :i64 it :i64 wr :i64 cp :i64] :bool
 (let [n (case kind 0 78 1 30 2 10 3 9 34)]
  (loop [k 0] (or (= k n)
   (let [V (wm-pattern (+ (* kind 2) (quot k 48))) w (vector-at V (rem k 48))
         op (bit-and w 65535) x (i64-shift-right (i64-shift-left w 32) 48)
         y (i64-shift-right (i64-shift-left w 16) 48) z (i64-shift-right w 48)]
    (and (gn-dot-at? M (+ p k) op (wm-field M p f x vr it wr cp) (wm-field M p f y vr it wr cp) z)
     (recur (inc k))))))))
(defn- wm-meta [M :vector-i64 f :i64 kind :i64] :bool
 (and (mdc-counts M) (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
  (let [p (gn-fnf M f FF-SIR) count (case kind 0 78 1 30 2 10 3 9 34)
        np (case kind 0 6 1 3 2 2 3 3 5)]
   (and (> p 0) (<= count (- (vector-at M MM-SIR-N) p))
    (not (gn-clamp-open M f)) (= (gn-fnf M f FF-NPARAMS) np)
    (= (gn-fnf M f FF-NSLOTS) (case kind 0 6 1 5 2 2 3 3 5))
    (= (gn-fnf M f FF-DEPTH) (case kind 0 7 1 3 2 3 3 3 6))
    (= (gn-fnf M f FF-RTYPE) (if (= kind 2) TY-I64 TY-VEC))
    (= (ck-pt M f 0) TY-VEC)
    (loop [k 1] (or (= k np) (and (= (ck-pt M f k) TY-I64) (recur (inc k)))))))))
(defn- wm-labels [M :vector-i64 p :i64 kind :i64] :bool
 (let [n (case kind 0 78 1 30 2 10 3 9 34)]
  (loop [k 0] (or (= k n)
   (and (if (= (gn-op M (+ p k)) OP-LABEL)
    (let [label (gn-sir M (+ p k) IF-A)]
     (and (> label 0) (< label MM-LABEL-CAP) (= (gn-lpos M label) (+ p k)))) true)
    (recur (inc k)))))))
(defn- wm-helper [M :vector-i64 f :i64 kind :i64 vr :i64 it :i64 wr :i64 cp :i64] :bool
 (and (wm-meta M f kind) (let [p (gn-fnf M f FF-SIR)]
  (and (wm-match M p f kind vr it wr cp) (wm-labels M p kind)))))
(defn- wm-admit [M :vector-i64 i :i64] :bool
 (and (mdc-counts M) (> i 1) (< i (vector-at M MM-SIR-N))
  (<= 78 (- (vector-at M MM-SIR-N) (dec i))) (= (gn-op M (dec i)) OP-FN)
  (let [p (dec i) f (gn-sir M p IF-A)]
   (and (wm-meta M f 0) (= (gn-fnf M f FF-SIR) p)
    (= (gn-g M gn-f-ns) 6) (= (gn-g M gn-f-dp) 7) (= (gn-g M gn-f-nsv) 6)
    (= (gn-g M gn-f-fb) 176) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
    (= (gn-g M gn-f-out) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
    (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
    (= (gn-sreg M 1) 20) (= (gn-sreg M 2) 19) (= (gn-sreg M 3) 23)
    (= (gn-sreg M 4) 21) (= (gn-sreg M 5) 24) (= (gn-sreg M 6) 22)
    (let [vr (gn-sir M (+ p 24) IF-A) it (gn-sir M (+ p 33) IF-A) cp (gn-sir M (+ p 19) IF-A)]
     (and (wm-meta M it 1)
      (let [wr (gn-sir M (+ (gn-fnf M it FF-SIR) 20) IF-A)]
       (and (wm-helper M vr 2 vr it wr cp) (wm-helper M wr 3 vr it wr cp)
        (wm-helper M it 1 vr it wr cp) (wm-helper M cp 4 vr it wr cp)
        (wm-match M p f 0 vr it wr cp) (wm-labels M p 0)))))))))
(defn- wm-emit [M :vector-i64 V :vector-i64] :vector-i64
 (loop [cur M k 0] (if (= k (vector-count V)) cur
  (recur (gn-emit cur (vector-at V k)) (inc k)))))
(defn- wm-entry [M :vector-i64 i :i64] :vector-i64
 (if (wm-admit M i) (-> M (wm-emit [3531735056 3943694975 1409288834 3943695103 1409288776 3944153727 1409288706 3943695039 1409288642 3943695135 1409288584 3944219327 1409288514 3943695071 1409288456 3407020777 3407151882 2332688681 2332623562 3531866128 3943694687 1409288232 3531604208 2601549097 4181722344 3943235871 1409288067 4181761264 4181721616 3506439825 3943694911 1409287906 4181762288 2333151760 2839544329 3538026512 3943694367 1409287714 3943694655 1409287650 2332033329 3943694911 1409287554 3548379466 3942646111 1409287464 3548379889 3942646335]) (wm-emit [1409287368 3548379921 3942646335 1409287272 4181763307 2332626283 4181722344 3506439432 3548379825 4168186217 4177528040 4181722344 3506439432 3548379761 4168186218 4177528040 3943301439 2594154477 2593370796 4181722344 3506442504 4177528040 2332823921 2333479264 2839560745 2835365897 3036676205 2432697971 335544322 2432698037 2432698070 4181722352 3506439696 4177528048 3944153727 1409286240 3944219327 1426062369])) M))

(defn- qrow-counts [M :vector-i64] :bool
 (and (> (vector-at M MM-SIR-N) 1) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) MM-FN-CAP)))
(defn- qrow-fn [M :vector-i64 f :i64 n :i64 slots :i64 depth :i64 count :i64 rt :i64 pt0 :i64] :i64
 (if (or (not (qrow-counts M)) (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP)) 0
  (let [p (gn-fnf M f FF-SIR)]
   (if (and (> p 0) (<= p (- (vector-at M MM-SIR-N) count))
     (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) slots)
     (= (gn-fnf M f FF-DEPTH) depth) (= (gn-fnf M f FF-RTYPE) rt)
     (not (gn-clamp-open M f)) (aw-ins M p OP-FN f n slots)
     (aw-ins M (+ p (dec count)) OP-END f 0 0)
     (loop [k 0] (or (= k n) (and (= (ck-pt M f k) (if (= k 0) pt0 TY-I64)) (recur (inc k)))))) p 0))))
(defn- qrow-want [M :vector-i64 p :i64 f :i64 marker :i64] :i64
 (cond (= marker -1) f (<= marker -3000) (gn-sir M (+ p (- 0 marker 3000)) IF-B) (<= marker -2000) (gn-sir M (+ p (- 0 marker 2000)) IF-A)
  :else (gn-sir M (+ p (- 0 marker 1000)) IF-A)))
(defn- qrow-match [M :vector-i64 p :i64 f :i64 V :vector-i64 k :i64] :bool
 (if (= k (vector-count V)) true
  (let [a (vector-at V k) v (if (< a 0) (qrow-want M p f a) a)]
   (and (= (gn-sir M (+ p (quot k 4)) (rem k 4)) v) (qrow-match M p f V (inc k))))))
(defn- qrow-labels [M :vector-i64 p :i64 count :i64 k :i64] :bool
 (if (= k count) true
  (let [j (+ p k)]
   (and (if (= (gn-op M j) OP-LABEL)
    (let [l (gn-sir M j IF-A)]
     (and (> l 0) (< l MM-LABEL-CAP)
      (loop [q 1] (or (= q (vector-at M MM-SIR-N))
       (and (not= (gn-op M q) OP-TAB)
        (or (not= (gn-op M q) OP-LABEL) (not= (gn-sir M q IF-A) l) (= q j))
        (not (and (or (= (gn-op M q) OP-BR) (= (gn-op M q) OP-BRZ) (= (gn-op M q) OP-BRNZ))
         (= (gn-sir M q (if (= (gn-op M q) OP-BR) IF-A IF-B)) l)
         (or (< q p) (>= q (+ p count))))) (recur (inc q))))))) true)
    (qrow-labels M p count (inc k))))))
