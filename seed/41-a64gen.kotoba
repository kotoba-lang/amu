;; zero x9 >= 0 items at x16 (8-byte aligned, v16 = 0; x10, x11 scratch): first the items up to the next 64-byte boundary
;; (at most x9; 1, 2, then 4 -- each step leaves the pointer aligned for the next), then two lines per step by q pairs,
;; then 8, 4, 2, 1
;; (misaligned q stores that split lines cost about a third more; dc zva zeros an aligned line about 1.7x faster than
;; two q pairs)
(defn- zf-store [M :vector-i64] :vector-i64
 (-> M (gn-emit (enc-sub-r 10 31 16)) (gn-emit (gn-e-bf 0xd3400000 10 10 3 5)) (gn-emit (enc-cmp-r 10 9))
