(defn- pj-i16-pat [] :string "~!!3,n!!*'$!\"&Q>!!!!!!!E9%!!*'\"!!<3%s7H?l!!WE,!!!!!!!N?(!!!!!!!E9%!!3-#!!<3%s7?9k!!`K-!!!!!!\"/c,r!EE(!!E9%!!3-#!!<3%s763j!!WE)!!!!!!\"/W0!!!!!!\"&Q1!!!!!!!E9%!!3-#!\"&Q/!!!!!!##>4!!!!!!!<2o!!!!!")
;; every LABEL op in [q, q + n) is where its label points
(defn- kpat-labels? [M :vector-i64 q :i64 n :i64] :bool
 (loop [k 0] (or (= k n)
  (and (or (not= (gn-op M (+ q k)) OP-LABEL) (fo-label? M (gn-sir M (+ q k) IF-A) (+ q k))) (recur (inc k))))))
;; g's SIR is the n-op pattern V with placeholders T (T[0] = g), its labels where they point
(defn- pj-fn? [M :vector-i64 g :i64 n :i64 S :string T :vector-i64] :bool
 (and (> g 0) (< g (vector-at M MM-FN-N)) (not (gn-clamp-open M g))
  (let [q (gn-fnf M g FF-SIR)]
   (and (> q 0) (<= (+ q n) (vector-at M MM-SIR-N)) (= (kpat-n S) n) (kpat-smatch M q S T)
        (kpat-labels? M q n)))))
(defn- pjp-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 42) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-PT0) TY-VEC)
   (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (let [lane (gn-sir M (+ p 30) IF-A) q (kfn-q M lane)]
    (and (not= lane f) (pj-fn? M f 43 (pjp-pass-pat) [f lane])
     (> lane 0) (< lane (vector-at M MM-FN-N)) (not (gn-clamp-open M lane)) (> q 0) (< (+ q 345) (vector-at M MM-SIR-N))
     (let [ld (gn-sir M (+ q 7) IF-A) ds (gn-sir M (+ q 20) IF-A) fl (gn-sir M (+ q 25) IF-A)
           s16 (gn-sir M (+ q 47) IF-A) mi (gn-sir M (+ q 82) IF-A) sl (gn-sir M (+ q 216) IF-A)
           T [lane ld ds fl s16 mi sl]
           put (gn-sir M (+ (kfn-q M sl) 11) IF-A) fq (gn-sir M (+ (kfn-q M mi) 10) IF-A)
           pc (gn-sir M (+ (kfn-q M ds) 10) IF-A)]
      (and (kpat-smatch M q (pjl-pat) T)
       (kpat-labels? M q 346)
       (pj-fn? M ld 36 (pj-ld-pat) [ld]) (pj-fn? M fl 32 (pj-fl-pat) [fl sl]) (pj-fn? M sl 14 (pj-sl-pat) [sl s16 put])
       (pj-fn? M mi 14 (pj-mi-pat) [mi s16 fq]) (pj-fn? M ds 13 (pj-ds-pat) [ds fq pc]) (pj-fn? M pc 25 (pj-pc-pat) [pc s16])
       (pj-fn? M fq 25 (pj-fq-pat) [fq]) (pj-fn? M put 9 (pj-put-pat) [put]) (pj-fn? M s16 19 (pj-i16-pat) [s16 65535 32768 65536]))))))))
(defn- pjp-sx [d :i64 n :i64] :i64 (gn-e-bf 0x93400000 d n 0 15))
;; the AC lane from s0..s7 in x2 x3 x4 x5 x6 x11 x12 x13 to the raw outputs o0..o7 in x5 x6 x13 x16 x11 x2 x4 x12
;; (generated and checked against the source semantics on random lanes; x5, x17 hold the multiply-idct factors)
(defn- pjp-ac [M :vector-i64] :vector-i64
 ;; X4 X7 X5 X6 = i16(s5 - s3) i16(s5 + s3) i16(s1 + s7) i16(s1 - s7); TMP1 = mi(X4 - X6, 196) (mi: sxth, mul, + 128, asr 8,
 ;; sxth); STG26 = i16(mi(X6, 277) - TMP1); X24 = i16(TMP1 - mi(X4, 669)); X15 X17 = i16(X5 -+ X7); TMP2 = i16(STG26 - X17);
 ;; TMP3 = i16(mi(X15, 362) - TMP2); X44 = i16(TMP3 + X24); X30 X31 = i16(s0 +- s4); X12 X13 = i16(s2 -+ s6);
 ;; X32 = i16(mi(X12, 362) - X13); X40 X43 = i16(X30 +- X13); X41 X42 = i16(X31 +- X32); then the raw o0..o7
 (kemit-hex M ""))
;; descale of a small sum in x r (the floor quotient is asr: no overflow), clamped with x1 = 255
(defn- pjp-ds [M :vector-i64 r :i64] :vector-i64
 (-> M (gn-emit (enc-add-i r r 64)) (gn-emit (gn-e-asr r r 7)) (gn-emit (enc-add-i r r 128))
  (gn-emit (enc-cmp-i r 0)) (gn-emit (enc-csel r 31 r (enc-cond-lt))) (gn-emit (enc-cmp-i r 255))
  (gn-emit (enc-csel r 1 r (enc-cond-gt)))))
;; the k0 scan: cbnz s_k -> stub k (k = 1..7); returns M with the branch sites in B[1..7]
(defn- pjp-scan [M :vector-i64 B :vector-i64 k :i64] :vector-i64
 (if (= k 8) M
  (let [at (vector-at M MM-CODE-N) b (vector-assoc! B k at)]
   (pjp-scan (gn-emit M (enc-cbnz (case k 1 3 2 4 3 5 4 6 5 11 6 12 13) 0)) B (inc k)))))
;; stubs k = 1..7: charge base + k, then the AC body (the last stub falls into it); patches the scan branches
(defn- pjp-stubs [M :vector-i64 B :vector-i64 base :i64 J :vector-i64 k :i64] :vector-i64
 (if (= k 8) M
  (let [at (vector-at M MM-CODE-N)
        m0 (-> M (gn-put (+ MM-CODE-BASE (vector-at B k)) (enc-cbnz (case k 1 3 2 4 3 5 4 6 5 11 6 12 13) (- at (vector-at B k))))
             (gn-emit (enc-sub-i 8 8 (+ base k))))
        b (vector-assoc! J k (vector-at m0 MM-CODE-N))]
   (pjp-stubs (if (< k 7) (gn-emit m0 (enc-b 0)) m0) B base J (inc k)))))
(defn- pjp-join [M :vector-i64 J :vector-i64 to :i64 k :i64] :vector-i64
 (if (= k 7) M (pjp-join (gn-put M (+ MM-CODE-BASE (vector-at J k)) (enc-b (- to (vector-at J k)))) J to (inc k))))
;; Whole-block passes (i = 0) in NEON, eight lanes of i16 at once. Every s[k] enters the AC lane only through i16(s[a]
;; +- s[b]), so the lane is computed on the low 16 bits (uzp1 narrowing); mi is smull by the constant, rshrn #8 (+128,
;; floor shift, i16); a column output is the widened sum, rshrn #7 (+64, floor shift), + 128, sqxtun (i16 then clamp to
;; 0..255, the sum being small), widened back to i64. A DC lane (s[1..7] zero as i64) takes the source's fill instead,
;; selected per lane (bit) by the lane's mask: rows i16(s0) (the transposed column 0, the mask from the row's byte mask
;; by csetm / ins), columns descale(s0) (srshr #7, + 128, sqxtun on row 0, the mask the AND of the AC rows' zero masks);
;; the columns block first checks that row 0 holds i16 values (else x2 = 0 and the scalar loop). Rows run transposed
;; (trn1/trn2 8x8) and back. The charge is the scalar one, lane by lane, from the lanes' nonzero masks (cmtst on the i64
;; values): rows DC 35 / AC 23 + k0 via rbit/clz of the row's byte mask; columns 40 + #(leading zero AC rows, at most 6)
;; - 9 per DC lane, summed by uaddlv. Generated and checked against the source semantics (random and extreme blocks)
;; outside the compiler; the blocks end in str x8 / ret, the columns block's fallback falls through.
(defn- pjn-rows [] :string "~dXVI<dXV<.X[$H\"X[-f-:73%@:7E2.:0efh:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?mSn8(_dn'FQg;!`*g;\";ZdmO(mOT8gKnGiT>RZ%9k>+ZJq:')HNM[TXTX[6T$X[?r/:73%@:7E2.:0efi:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?mSn8(_dn'FQg;!`*g;\";ZdmO(mOT8gKnGiT>RZ%9k>+ZJq:'M`RM[TXTX[H`&X[R)1:73%@:7E2.:0efj:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?mSn8(_dn'FQg;!`*g;\";ZdmO(mOT8gKnGiT>RZ%9k>+ZJq:'r#VM[TXTX[Zl(X[d53:73%@:7E2.:0efk:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?mSn8(_dn'FQg;!`*g;\";ZdmO(mOT8gKnGiT>RZ%9k>+ZJq:(A;ZM[TXTX[m#*X\\!A5:73%@:7E2.:0efl:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?mSn8(_dn'FQg;!`*g;\";ZdmO(mOT8gKnGiT>RZ%9k>+ZJq:(eS^M[TXTX\\*/,X\\3M7:73%@:7E2.:0efm:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?mSn8(_dn'FQg;!`*g;\";ZdmO(mOT8gKnGiT>RZ%9k>+ZJq:)4kbM[TXTX\\<;.X\\EY9:73%@:7E2.:0efn:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?mSn8(_dn'FQg;!`*g;\";ZdmO(mOT8gKnGiT>RZ%9k>+ZJq:)Y.fM[TXTX\\NG0X\\We;:73%@:7E2.:0efo:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?mSn8(_dn'FQg;!`*g;\";ZdmO(mOT8gKnGiT>RZ%9k>+ZJq:*(FjM[TXT:-g9>:-iP*:.$F-:.&\\n:.6Rq:.8i]:.H_`:.K!L:6I(,:6K>n:6R.N:6TE;:6mA_:6oXL:7!H,:7#^n:;eOl:;gf[:;nV9:;pm(:<\"\\[:<$sJ:<+c(:<.$l:9Yc\\;LfUB:')GK;Lfsl:'M_O;Lh]H:'r\"S;Lg>l:(A:WDKCQ*:32/`:3VF:DKgg[DI\\>&%nE:[:Ih(G%iC?1:Df-<%p,EK:KO37%iC?2:Df-=DIeEs%qhOP:M6=<%iC?3:Df->DJ\"QVDIJ2`:18fADIJ3p%sOZ`:NrHL%iC?/:Df-:DInJf:1f/K:3;3jDKLU8DK^b&:3M@g%sO\\6:NrJ\"%iC?1:Df-<DK(8^:2kjuDK(7A:1T$!DIeEB:18l\":1]0&:1AsEDJ\"W+:1f5aDIS?fDInQGDIJ8]DSI:/DSI:DDSI:FDSI:HDSI:IDSI:GDSI:EDSI:J:/r\\R:/ts>:0B(;:0D?':09#G:0;:3:0T4':0VJh:6I(,:6K>n:6R.N:6TE;:7Nee:7Q'R:7Wl2:7Z-t:;eOl:;gf[:;nV9:;pm(:<\"\\[:<$sJ:<+c(:<.$l%hPT<:CsB(%j7YL:EZG8%j7Yn:EZGZXT/esXT9/)%hPT\\:CsBH%j7YL:EZG8%j7Yn:EZGZXTAquXTK;+%hPU':CsBh%j7YL:EZG8%j7Yn:EZGZXTT)\"XT]G-%hPUG:CsC3%j7YL:EZG8%j7Yn:EZGZXTf5$XToS/%hPUg:CsCS%j7YL:EZG8%j7Yn:EZGZXU#A&XU,_1%hPV2:CsCs%j7YL:EZG8%j7Yn:EZGZXU5M(XU>k3%hPVR:CsD>%j7YL:EZG8%j7Yn:EZGZXUGY*XUQ\"5%hPVr:CsD^%j7YL:EZG8%j7Yn:EZGZXUYe,XUc.7b7=UZq#CQ]emANp")
(defn- pjn-cols [] :string "~WB^nZWBh7eWBr=4WC&[?lQW!/;ue<IlQ`'P;ue;^lQi-q;ue:slQr4=;ue:3lRSZY;ue9HlR\\a%;ue8]lRegF;ue7rlRnmg;ue72%fkZ4X[$H\"X[-f-:73%@:7E2.:0eg#X[6T$X[?r/:73%@:7E2.:0eg$:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?m/g+Ai/j>'jX[H`&X[R)1:73%@:7E2.:0eg%:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?m%X]AT/j>'jX[Zl(X[d53:73%@:7E2.:0eg&:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?m%X]AT/j>'jX[m#*X\\!A5:73%@:7E2.:0eg':ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?m%X]AT/j>'jX\\*/,X\\3M7:73%@:7E2.:0eg(:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?m%X]AT/j>'jX\\<;.X\\EY9:73%@:7E2.:0eg):ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?m%X]AT/j>'jX\\NG0X\\We;:73%@:7E2.:0eg*:ABke:AKr2:AU#T:A^*!:73%@:7E2.:0eg/%O!?m%X]AT/hfBF%K\\a#:DkK$:BZ=N:1/kW/g2bFDAWW90*qm?/hfB'%K\\aDdXV?MRglKXOTbc$b6n=V;LfUB:')GK;Lfsl:'M_O;Lh]H:'r\"S;Lg>l:(A:WDKCQ*:32/`:3VF:DKgg[DI\\>&%nE:[:Ih(G%iC?1:Df-<%p,EK:KO37%iC?2:Df-=DIeEs%qhOP:M6=<%iC?3:Df->DJ\"QVDIJ2`:18fADIJ3p%sOZ`:NrHL%iC?/:Df-:DInJf:1f/K:3;3jDKLU8DK^b&:3M@g%sO\\6:NrJ\"%iC?1:Df-<DK(8^:2kjuDK(7A:1T$!DIeEBDBD7E:BZ=l%UfDu:142a%iLEH:Do3S:4@t%/g2`K0\"iA'0*nIZ0+b$cD\\/gO0-I0;D]ks'0-I0]D]ksIXT2p7XT<9B%V5]d:1XKP%iLEH:Do3S:4@t%/g2`K0\"iA'0*nIZ0+b$cD\\/gO0-I0;D]ks'0-I0]D]ksIXTE'9XTNED%UoL,:1=9m%iLEH:Do3S:4@t%/g2`K0\"iA'0*nIZ0+b$cD\\/gO0-I0;D]ks'0-I0]D]ksIXTW3;XT`QF%V?ne:1b\\Q%iLEH:Do3S:4@t%/g2`K0\"iA'0*nIZ0+b$cD\\/gO0-I0;D]ks'0-I0]D]ksIXTi?=XTr]H%V>cE:1aQ1%iLEH:Do3S:4@t%/g2`K0\"iA'0*nIZ0+b$cD\\/gO0-I0;D]ks'0-I0]D]ksIXU&K?XU/iJ%UpWL:1>E8%iLEH:Do3S:4@t%/g2`K0\"iA'0*nIZ0+b$cD\\/gO0-I0;D]ks'0-I0]D]ksIXU8WAXUAuL%V6i/:1YVp%iLEH:Do3S:4@t%/g2`K0\"iA'0*nIZ0+b$cD\\/gO0-I0;D]ks'0-I0]D]ksIXUJcCXUT,N%UgP@:15>,%iLEH:Do3S:4@t%/g2`K0\"iA'0*nIZ0+b$cD\\/gO0-I0;D]ks'0-I0]D]ksIXU\\oEXUf8Pq#CQ]emANpdXV<!'EA+6")
;; before the frame (kpre-entry): x0 = v (kept), x1 = columns, x2 = i. Guards: 0 <= i <= 7, fuel >= 1 + (8 - i) * 35
;; (rows: the worst lane, DC, costs 34 and the pass's self call 1) or 46 (columns: the worst lane, AC with k0 = 7,
;; costs 38 + 7), v live with 1600 items. Then no trap: x10 walks the lanes, x9 counts them, x8 is the private fuel:
;; DC lanes cost 35 / 37, AC lanes 23 + k0 / 39 + k0 (k0 the first nonzero s[k]: lane-dc's charges), published at ret.
(defn- pjp-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (pjp-admit M i)) M
  (let [G (vector-alloc 13) B (vector-alloc 8) J (vector-alloc 8) B2 (vector-alloc 8) J2 (vector-alloc 8)
        m0 (-> M (gn-emit (enc-cmp-i 2 7)) (ri-cold G 8)
             (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov-imm 9 8) (gn-emit (enc-sub-r 9 9 2))
             (gn-mov-imm 16 35) (gn-mov-imm 17 46) (gn-emit (enc-cmp-i 1 0)) (gn-emit (enc-csel 16 16 17 (enc-cond-eq)))
             (gn-emit (enc-mul 16 9 16)) (gn-emit (enc-add-i 16 16 1)) (gn-emit (enc-cmp-r 8 16)) (ri-cold G (enc-cond-lo))
             (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
             (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)) (ri-cold G (enc-cond-hs))
             (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 10 16 0))
             (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 10 16)) (ri-cold G (enc-cond-hs))
             (gn-emit (enc-cmp-i 10 1600)) (ri-cold G (enc-cond-lo))
             ;; every guard passed: the pass's entry charge, x10 = &v[1536]
             (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 16 16 17 3))
             (gn-mov-imm 10 12288) (gn-emit (enc-add-r 10 16 10))) bc (vector-at m0 MM-CODE-N)
        ;; rows: x10 = &v[1536 + 8i], stride 1
        m1a (gn-emit m0 (enc-cbnz 1 0)) rnb (vector-at m1a MM-CODE-N)
        m1b (-> m1a (gn-emit (enc-cbnz 2 0)) (kemit-hex (pjn-rows))) rsc (vector-at m1b MM-CODE-N)
        m1 (-> m1b (gn-put (+ MM-CODE-BASE rnb) (enc-cbnz 2 (- rsc rnb))) (gn-emit (gn-e-addsl 10 10 2 6))) rloop (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-ldp 2 3 10 0)) (gn-emit (enc-ldp 4 5 10 16)) (gn-emit (enc-ldp 6 11 10 32))
             (gn-emit (enc-ldp 12 13 10 48)) (pjp-scan B 1)
             (gn-emit (pjp-sx 2 2)) (gn-emit (enc-stp 2 2 10 0)) (gn-emit (enc-stp 2 2 10 16))
             (gn-emit (enc-stp 2 2 10 32)) (gn-emit (enc-stp 2 2 10 48)) (gn-emit (enc-sub-i 8 8 35))) rdc (vector-at m2 MM-CODE-N)
        m3 (pjp-stubs (gn-emit m2 (enc-b 0)) B 23 J 1) rac (vector-at m3 MM-CODE-N)
        m4 (-> m3 (pjp-join J rac 1) (pjp-ac)
             (gn-emit (pjp-sx 5 5)) (gn-emit (pjp-sx 6 6)) (gn-emit (pjp-sx 13 13)) (gn-emit (pjp-sx 16 16))
             (gn-emit (pjp-sx 11 11)) (gn-emit (pjp-sx 2 2)) (gn-emit (pjp-sx 4 4)) (gn-emit (pjp-sx 12 12))
             (gn-emit (enc-stp 5 6 10 0)) (gn-emit (enc-stp 13 16 10 16)) (gn-emit (enc-stp 11 2 10 32))
             (gn-emit (enc-stp 4 12 10 48))) rnext (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-put (+ MM-CODE-BASE rdc) (enc-b (- rnext rdc)))
             (gn-emit (enc-add-i 10 10 64)) (gn-emit (enc-subs-i 9 9 1))) rback (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-bcond (enc-cond-ne) (- rloop rback))) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-ret)))
        cols (vector-at m6 MM-CODE-N)
        ;; columns: x10 = &v[1536 + i], stride 8, x1 = 255
        m7a (-> m6 (gn-put (+ MM-CODE-BASE bc) (enc-cbnz 1 (- cols bc))) (gn-emit (enc-cbnz 2 0)) (kemit-hex (pjn-cols)))
        csc (vector-at m7a MM-CODE-N)
        m7 (-> m7a (gn-put (+ MM-CODE-BASE cols) (enc-cbnz 2 (- csc cols)))
             (gn-emit (gn-e-addsl 10 10 2 3)) (gn-mov-imm 1 255)) cloop (vector-at m7 MM-CODE-N)
        m8 (-> m7 (gn-emit (enc-ldr 2 10 0)) (gn-emit (enc-ldr 3 10 64)) (gn-emit (enc-ldr 4 10 128))
             (gn-emit (enc-ldr 5 10 192)) (gn-emit (enc-ldr 6 10 256)) (gn-emit (enc-ldr 11 10 320))
             (gn-emit (enc-ldr 12 10 384)) (gn-emit (enc-ldr 13 10 448)) (pjp-scan B2 1)
             ;; descale(s0) exactly: floor((s0 + 64) / 128) is asr unless s0 + 64 < -2^63 + 128 (then floor-quot's own
             ;; wrapping arithmetic), + 128, i16, clamp
             (gn-emit (enc-add-i 2 2 64)) (gn-emit (enc-cmp-i 2 128))) dvc (vector-at m8 MM-CODE-N)
        m9 (-> m8 (gn-emit (enc-bcond 7 0)) (gn-emit (enc-sub-r 2 31 2)) (gn-emit (enc-add-i 2 2 127))
             (gn-emit (gn-e-asr 17 2 63)) (gn-emit (+ (enc-add-r 2 2 17) (* 0x400000 1) (* 57 1024)))
             (gn-emit (gn-e-asr 2 2 7)) (gn-emit (enc-sub-r 2 31 2))) dj (vector-at m9 MM-CODE-N)
        m10 (gn-emit m9 (enc-b 0)) dfast (vector-at m10 MM-CODE-N)
        m11 (gn-emit m10 (gn-e-asr 2 2 7)) djoin (vector-at m11 MM-CODE-N)
        m12 (-> m11 (gn-dot-patch dvc dfast 7) (gn-put (+ MM-CODE-BASE dj) (enc-b (- djoin dj)))
              (gn-emit (enc-add-i 2 2 128)) (gn-emit (pjp-sx 2 2))
              (gn-emit (enc-cmp-i 2 0)) (gn-emit (enc-csel 2 31 2 (enc-cond-lt))) (gn-emit (enc-cmp-i 2 255))
              (gn-emit (enc-csel 2 1 2 (enc-cond-gt))) (gn-emit (enc-sub-i 8 8 37))
              (gn-emit (enc-str 2 10 0)) (gn-emit (enc-str 2 10 64)) (gn-emit (enc-str 2 10 128)) (gn-emit (enc-str 2 10 192))
              (gn-emit (enc-str 2 10 256)) (gn-emit (enc-str 2 10 320)) (gn-emit (enc-str 2 10 384))
              (gn-emit (enc-str 2 10 448))) cdc (vector-at m12 MM-CODE-N)
        m13 (pjp-stubs (gn-emit m12 (enc-b 0)) B2 39 J2 1) cac (vector-at m13 MM-CODE-N)
        m14 (-> m13 (pjp-join J2 cac 1) (pjp-ac)
              (pjp-ds 5) (pjp-ds 6) (pjp-ds 13) (pjp-ds 16) (pjp-ds 11) (pjp-ds 2) (pjp-ds 4) (pjp-ds 12)
              (gn-emit (enc-str 5 10 0)) (gn-emit (enc-str 6 10 64)) (gn-emit (enc-str 13 10 128)) (gn-emit (enc-str 16 10 192))
              (gn-emit (enc-str 11 10 256)) (gn-emit (enc-str 2 10 320)) (gn-emit (enc-str 4 10 384))
              (gn-emit (enc-str 12 10 448))) cnext (vector-at m14 MM-CODE-N)
        m15 (-> m14 (gn-put (+ MM-CODE-BASE cdc) (enc-b (- cnext cdc)))
              (gn-emit (enc-add-i 10 10 8)) (gn-emit (enc-subs-i 9 9 1))) cback (vector-at m15 MM-CODE-N)
        m16 (-> m15 (gn-emit (enc-bcond (enc-cond-ne) (- cloop cback))) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-ret)))
        cold (vector-at m16 MM-CODE-N)]
   (ri-patch m16 G 0 cold))))

;; ---- wikisort fill: (f v c i) writes the 400 items (int32(x_i), i) for c's input shape, x from a 31-bit LCG kept in
;; v[1830] (c in 1 2 3 7 8) or from v[1830] as it is: c 0 a fixed profile, 1 r, 2 400 - i + r * 429496729 - 2, 3
;; i + r * 429496729 - 2, 4 i, 5 400 - i, 6 1000, 7 i - 2 when quot(r, 1932735283) > 1 (never: r = next >> 16 < 2^15),
;; else 1000 + rem(r, 4), with r = quot(next, 65536). Charges: 1 at entry, 4 per item (three puts, the loop). Before the
;; frame: 0 <= i <= 400, fuel >= 1 + 4(400 - i) and v live with more than 1830 items, all charged at once (nothing
;; after can trap); then one loop per c (the dispatch hoisted) keeping the LCG state in a register, stp of each item,
;; v[1830] stored once at the end (the same final value). Generated and checked against the source semantics (every c,
;; edge i, short vectors, short fuel) outside the compiler; the block falls through to the function when a guard fails.
;; The SIRs of fill, put, int32 and rem are packed patterns (T: the functions, then fill's / int32's wide constants).
(defn- wfl-pat [] :string "")
(defn- wfl-i32-pat [] :string "")
(defn- wfl-rem-pat [] :string "0001fff6000200020009fc1700000000000400000001000000040001000200000004000200010000000400030002000000060004000200000006000300010000000600020000000000130000000000000002fff600000000")
(defn- wfl-code [] :string "")
(defn- wfl-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 206) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-PT0) TY-VEC)
   (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (let [put (gn-sir M (+ p 178) IF-A) i32 (gn-sir M (+ p 185) IF-A) rm (gn-sir M (+ p 164) IF-A)]
    (and (not= put f) (not= i32 f) (not= rm f)
     (pj-fn? M f 206 (wfl-pat) [f put i32 rm 1103515245 2147483647 65536 429496729 1932735283 -2])
     (pj-fn? M put 9 (pj-put-pat) [put]) (pj-fn? M i32 19 (wfl-i32-pat) [i32 4294967295 2147483648 4294967296])
     ;; rem is the prelude's replaceable import (clamp-open, its label not entered): its branch-free SIR, not its
     ;; generated code, is what is relied on
     (> rm 0) (< rm (vector-at M MM-FN-N))
     (let [q (gn-fnf M rm FF-SIR)]
      (and (> q 0) (<= (+ q 11) (vector-at M MM-SIR-N)) (kpat-smatch M q (wfl-rem-pat) [rm]))))))))
(defn- wfl-entry [M :vector-i64 i :i64] :vector-i64 (if (wfl-admit M i) (kemit-hex M (wfl-code)) M))

;; ---- picojpeg huff-code: (f v table i code) walks the code lengths i .. 15 (found when code <= max[i] != 65535: the
;; value at huff-value-base(table) + (valptr[i] + code - mincode[i]) & 255 into v[263]; i = 16: v[263] = 0), else one bit
;; (bit: v[263] = bit 15 of v[259], v[260] - 1 and v[259] * 2 kept to 8 / 16 bits; with v[260] = 0 first octet's char:
;; byte v[v[256]], v[257] - 1, v[256] + 1, then v[259] | byte, v[260] = 8) shifted into code. Charges: 1 at entry, 7 per
;; bit (bit 6, the loop), 18 with a refill (octet 7, its two puts 4), 2 at the end (put8). Before the frame: table 0..3,
;; 0 <= i <= 16, v live past item 1375; v[256 257 259 260 263] are held in registers and stored back at the end. A bit
;; that would need char's refill (v[257] = 0), an input offset v[256] >= 256 or the marker byte 255, or fuel short of
;; the step (one charge reserved for lu-style re-entry) stores them, publishes the steps done (not the entry charge)
;; with i and code advanced, and enters huff-code's own code, which charges its entry (the loop charge it stands for).
;; Generated and checked against the source semantics outside the compiler; the SIRs of huff-code, bit, octet, char,
;; put8, put16, put and huff-value-base are packed patterns. The T2 keep marker ends the block (only the way into
;; huff-code's own code passes it), so T2 keeps the kernel without relying on a rollback.
