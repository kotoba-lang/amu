    (gn-emit (enc-cmp-i 0 (bit-and (i64-shift-right low 10) 1023)))
    (gn-mov-imm 9 (bit-and low 255)) (gn-mov 0 9) (gn-emit (enc-ret))
    (gn-emit (enc-cmp-i 0 (bit-and (i64-shift-right upper 10) 1023)))
    (gn-mov-imm 9 (bit-and upper 255)) (gn-mov 0 9) (gn-emit (enc-ret)))
   M2 (if (= (bit-and (dec (vector-at M1 MM-CODE-N)) 1) 0) M1 (gn-emit M1 0xd503201f))
   table (vector-at M2 MM-CODE-N) delta (* (- table (+ start 4)) 4)
   M3 (blt-data M2 T 0)]
  (-> M3 (gn-put (+ MM-CODE-BASE (+ start 4))
    (+ (gn-e-adr 9) (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5)))
   (gn-put (+ MM-CODE-BASE lo) (enc-b (- start lo))))))
(defn- blt-one [M :vector-i64 f :i64 limit :i64] :vector-i64
 (let [end (blt-source M f)]
  (if (= end 0) M
   (let [p (gn-fnf M f FF-SIR) high (blt-high M p end) lo (gn-fnf M f FF-CODE)
     hi (blt-hi M f lo limit)]
    (if (or (< high 64) (> high 1023) (<= lo 0) (>= lo hi) (> hi limit)
         (> (- hi lo) 4096) (<= (- hi lo) (+ (* 2 (inc high)) 20))
         (> (vector-at M MM-CODE-N) (- MM-CODE-CAP (+ (* 2 (inc high)) 20)))) M
     (let [J (vector-alloc (- hi lo)) T (vector-alloc (inc high))]
      (if (and (blt-fixes M J lo hi) (blt-code M J lo hi high) (blt-incoming M lo hi limit))
       (let [low (blt-eval M J lo hi -9223372036854775808) upper (blt-eval M J lo hi 9223372036854775807)]
        (if (and (>= low 0) (>= upper 0) (> (i64-shift-right low 20) 7)
             (> (i64-shift-right upper 20) 9) (blt-table M J T lo hi high))
         (blt-apply M T lo high low upper) M)) M)))))))
(defn- blt-run [M :vector-i64] :vector-i64
 (if (not (blt-counts M)) M
  (let [limit (vector-at M MM-CODE-N)]
   (loop [f 1 out M]
    (if (= f (vector-at M MM-FN-N)) out (recur (inc f) (blt-one out f limit)))))))

;; Bounded unsigned interval proof over final physical code. Only a complete
;; low-mask/constant/move/MUL chain can prove the dividend nonnegative; an
;; overflow, incoming edge or unknown operation keeps the signed bias.
(defn- uqd-counts [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS) (= (vector-at M MM-ERR) 0)
  (> (vector-at M MM-CODE-N) 3) (<= (vector-at M MM-CODE-N) 65536)
  (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) 512)
  (> (vector-at M MM-LABEL-N) 0) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)
  (> (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (> (vector-at M MM-SIR-N) 0) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (mp-sirclosed M 1)))
(defn- uqd-mark [R :vector-i64 to :i64] :vector-i64
 (if (and (> to 0) (< to (vector-count R))) (vector-assoc! R to 1)
  (vector-assoc! R 0 1)))
(defn- uqd-roots [M :vector-i64 omit-unemitted :bool] :vector-i64
 (let [cn (vector-at M MM-CODE-N)
       R (vector-alloc (inc cn))
       funcs (loop [V R f 1] (if (= f (vector-at M MM-FN-N)) V
         (let [to (gn-fnf M f FF-CODE)] (recur (if (and omit-unemitted (= to 0)) V (uqd-mark V to)) (inc f)))))
       labels (loop [V funcs k 1] (if (= k (vector-at M MM-LABEL-N)) V
         (let [to (vector-at M (+ MM-LABEL-BASE k))]
          (recur (if (= to 0) V (uqd-mark V to)) (inc k)))))
       fixes (loop [V labels k 1] (if (= k (vector-at M MM-FIX-N)) V
         (let [at (sf-x M k XF-AT) kind (sf-x M k XF-KIND)
               t (sf-x M k XF-TARGET) aux (sf-x M k XF-AUX)
               to (cond
                 (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19) (= kind FX-ADRL19))
                  (if (and (= aux 0) (> t 0) (< t (vector-at M MM-LABEL-N)))
                    (vector-at M (+ MM-LABEL-BASE t)) -1)
                 (or (= kind FX-BL26) (= kind FX-ADR19))
                  (if (and (>= aux 0) (<= aux 2) (> t 0) (< t (vector-at M MM-FN-N)))
                    (+ (gn-fnf M t FF-CODE) aux) -1)
                 (= kind FX-LIT32) 0 :else -1)
               marked (if (= to 0) V (uqd-mark V to))]
          (recur (if (and (> at 0) (< at cn))
            (cond (= kind FX-LIT32) (uqd-mark (uqd-mark marked at) (inc at))
                  (= kind FX-BL26) (uqd-mark marked (inc at))
                  :else marked) (vector-assoc! marked 0 1)) (inc k))))) ]
  (loop [V fixes at 1] (if (= at cn) V
   (let [w (sf-word M at) branch (of-branch w)
         adr (= (bit-and w 0x9f000000) 0x10000000)
         literal (= (bit-and w 0x3b000000) 0x18000000)
         bytes (cond adr (+ (* at 4) (mp-sign (bit-or
                    (i64-shift-left (bit-and (i64-shift-right w 5) 0x7ffff) 2)
                    (bit-and (i64-shift-right w 29) 3)) 21))
                literal (* 4 (+ at (mp-sign (bit-and (i64-shift-right w 5) 0x7ffff) 19))) :else -1)
         next (cond (> branch 0) (uqd-mark V (of-dest w at))
                (or adr literal) (if (= (bit-and bytes 3) 0) (uqd-mark V (quot bytes 4))
                                  (vector-assoc! V 0 1))
                :else V)
         call (= (bit-and w 0xfc000000) 0x94000000)]
    (recur (if (or call (= (bit-and w 0xffe0001f) 0xd4200000))
             (uqd-mark next (inc at)) next) (inc at)))))))
(defn- uqd-bound [M :vector-i64 R :vector-i64 reg :i64 at :i64 work :i64] :i64
 (if (or (<= at 0) (<= work 0) (< reg 0) (>= reg 31)) -1
  (let [w (sf-word M at) kind (hld-kind w) writes (hld-write w)
        d (bit-and w 31) n (bit-and (i64-shift-right w 5) 31)
        r (bit-and (i64-shift-right w 16) 31) imms (bit-and (i64-shift-right w 10) 63)]
   (if (or (< kind 13) (> kind 16) (< writes 0)) -1
    (if (= (bit-and writes (hld-bit reg)) 0)
     (if (= (vector-at R at) 0) (uqd-bound M R reg (dec at) (dec work)) -1)
     (cond
      (= (bit-and w 0xffe00000) 0xd2800000) (bit-and (i64-shift-right w 5) 65535)
      (and (= (bit-and w 0xffff0000) 0x92400000) (<= imms 30))
       (dec (i64-shift-left 1 (inc imms)))
      (> (vector-at R at) 0) -1
      (= (bit-and w (bit-not (bit-or (i64-shift-left 31 16) 31))) 0xaa0003e0)
       (uqd-bound M R r (dec at) (dec work))
      (= (bit-and w 0xffe0fc00) 0x9b007c00)
       (let [budget (quot (dec work) 2)
             a (uqd-bound M R n (dec at) budget) b (uqd-bound M R r (dec at) budget)]
        (if (or (< a 0) (< b 0)) -1
         (if (or (= a 0) (= b 0)) 0
          (if (<= a (quot 9223372036854775807 b)) (* a b) -1))))
      :else -1))))))
(defn- uqd-dead17 [M :vector-i64 R :vector-i64 at :i64 work :i64] :bool
 (if (or (<= work 0) (>= at (vector-at M MM-CODE-N))) false
  (let [w (sf-word M at) kind (hld-kind w) reads (hld-read w) writes (hld-write w)]
   (and (>= kind 7) (<= kind 16) (>= reads 0) (>= writes 0)
    (= (bit-and reads (hld-bit 17)) 0)
    (or (> (bit-and writes (hld-bit 17)) 0)
      (and (= (vector-at R at) 0) (uqd-dead17 M R (inc at) (dec work))))))))
(defn- uqd-site [M :vector-i64 R :vector-i64 at :i64] :bool
 (let [cn (vector-at M MM-CODE-N)]
  (if (or (< at 1) (> at (- cn 3))) false
   (let [a (sf-word M at) b (sf-word M (inc at)) c (sf-word M (+ at 2))
         x (bit-and (i64-shift-right a 5) 31) p (bit-and (i64-shift-right c 16) 63)]
    (and (>= x 9) (<= x 15) (>= p 2) (<= p 62)
     (= a (gn-e-asr 17 x 63))
     (= b (+ (gn-e-addsl x x 17 (- 64 p)) 0x400000))
     (= c (gn-e-asr x x p))
     (= (vector-at R at) 0) (= (vector-at R (inc at)) 0) (= (vector-at R (+ at 2)) 0)
     (>= (uqd-bound M R x (dec at) 64) 0)
     (uqd-dead17 M R (+ at 3) 64))))))
(defn- uqd-run [M :vector-i64] :vector-i64
 (if (not (uqd-counts M)) M
  (let [R (uqd-roots M false) cn (vector-at M MM-CODE-N)]
   (if (not= (vector-at R 0) 0) M
    (let [P (loop [V (vector-alloc cn) at 1 used 0]
       (if (or (> at (- cn 3)) (>= used 128)) V
        (let [yes (uqd-site M R at)]
         (recur (if yes (vector-assoc! V at 1) V) (+ at (if yes 3 1)) (+ used (if yes 1 0))))))]
     ;; All proofs use the complete unchanged code before any B2 is installed.
     (loop [V M at 1] (if (= at cn) V
      (recur (if (= (vector-at P at) 1) (gn-put V (+ MM-CODE-BASE at) (enc-b 2)) V) (inc at)))))))))

;; Exact adjacent store-to-load forwarding in final code. All original
;; charges, publications, NZCV, exhaustion targets and physical positions
;; remain. A complete root inventory forbids entering the redundant load.
(defn- afr-site [M :vector-i64 R :vector-i64 at :i64] :bool
 (let [cn (vector-at M MM-CODE-N)]
  (and (> at 1) (< (+ at 3) cn) (= (vector-at R at) 0)
   (= (sf-word M (dec at)) (enc-str 16 7 CTX-FUEL))
   (= (sf-word M at) (enc-ldr 16 7 CTX-FUEL))
   (= (sf-word M (inc at)) (enc-subs-i 16 16 1))
   (or (and (= (sf-word M (+ at 2)) (enc-bcond (enc-cond-hs) 2))
            (= (sf-word M (+ at 3)) (enc-brk 0)))
       (= (bit-and (sf-word M (+ at 2)) 0xff00001f) 0x54000003)))))
(defn- afr-run [M :vector-i64] :vector-i64
 (if (not (uqd-counts M)) M
  (let [R (uqd-roots M true) cn (vector-at M MM-CODE-N)]
   (if (not= (vector-at R 0) 0) M
    (let [P (loop [V (vector-alloc cn) at 1]
             (if (= at cn) V
              (recur (if (afr-site M R at) (vector-assoc! V at 1) V) (inc at))))]
     ;; Frozen plan: changing one load cannot establish another proof.
     (loop [V M at 1] (if (= at cn) V
      (recur (if (= (vector-at P at) 1)
               (gn-put V (+ MM-CODE-BASE at) 0xd503201f) V) (inc at)))))))))
;; A direct B+2 skips one unreachable word. Complete unchanged roots must
;; exclude entry into that word before both become NOP; layout and NZCV stay.
(defn- owj-run [M :vector-i64] :vector-i64
 (if (not (uqd-counts M)) M
  (let [R (uqd-roots M true) cn (vector-at M MM-CODE-N)]
   (if (not= (vector-at R 0) 0) M
    (let [P (loop [V (vector-alloc cn) at 1]
             (if (>= (+ at 2) cn) V
              (recur (if (and (= (sf-word M at) (enc-b 2))
                        (= (vector-at R (inc at)) 0)) (vector-assoc! V at 1) V) (inc at))))]
     (loop [V M at 1] (if (= at cn) V
      (recur (if (= (vector-at P at) 1)
       (-> V (gn-put (+ MM-CODE-BASE at) 0xd503201f)
        (gn-put (+ MM-CODE-BASE (inc at)) 0xd503201f)) V) (inc at)))))))))
(defn- gn-run [M :vector-i64] :vector-i64 (owj-run (afr-run (blt-run (uqd-run (blt-old-run M))))))
;; >>> kc-sm
;; ---- sm: a loop of single-vector state functions as one kernel (statemate's FH_DU loop) -------------------------------
;; A region function takes and returns one vector (the state); its body reads and writes constant items of it (vector-at,
;; an in-place writer wrapper, sign wrappers, an unsigned-less helper, identity calls), tests them, and tail-calls region
;; functions or calls one (a controller: it returns the same handle, writers return their handle) and continues. At the
;; entry charge of a region function E that lies on a tail-call cycle and has a caller outside its region, the whole
;; region becomes one block: the handle is validated once (length above every constant index), the counter lives in x8
;; and is prepaid at E (and at any other cycle head) for the most expensive path to the next head or out of the region,
;; tail calls are branches (straight-line when laid out next), a controller runs inline (its RETs branch back), and no
;; charge, check or call remains inside. A failed check runs E's original code (entry) or publishes the counter and
;; branches to the original function (cycle heads), so every trap and every partial write stays exact; nothing in the
;; block can trap. x0 = the handle, x6 = items base, x9.. temps, x1..x5 let slots 2..6, x16/x17 scratch.
(def sm-maxfn 1024)
(def sm-maxctx 60)
(def sm-maxlen 1000)
(def sm-fail 0) (def sm-nctx 1) (def sm-cnt 2) (def sm-nf 3) (def sm-maxidx 4) (def sm-pend 5) (def sm-dead 6)
(def sm-flagt 7) (def sm-p 8) (def sm-ctx 9) (def sm-ptmax 10) (def sm-e 11) (def sm-ebody 12) (def sm-nstk 13)
(def sm-steps 14) (def sm-skip 15) (def sm-cn0 48) (def sm-fx0 49) (def sm-ldef 50) (def sm-k16 51) (def sm-k16v 52) (def sm-lvb 53) (def sm-f 54)
(def sm-tk 16) (def sm-tv 24) (def sm-sk 32) (def sm-sv 40)
(def sm-cret 64)
(def sm-pt 128)
(def sm-stk 1136)
;; per FN (6 x FN-N): 0 context + 1, 1 flags (1 on stack, 2 cycle head, 4 emitted, 8 scheduled), 2 label, 3 tail-call
;; predecessors, 4 cost + 1, 5 fallback label
(def sm-fa0 2160)
(defn- sm-fa [V :vector-i64 k :i64 f :i64] :i64 (vector-at V (+ sm-fa0 (* k (vector-at V sm-nf)) f)))
(defn- sm-fa! [V :vector-i64 k :i64 f :i64 x :i64] :vector-i64 (vector-assoc! V (+ sm-fa0 (* k (vector-at V sm-nf)) f) x))
(defn- sm-failv [V :vector-i64 code :i64] :vector-i64 (if (> (vector-at V sm-fail) 0) V (vector-assoc! V sm-fail code)))
(defn- sm-ok? [V :vector-i64] :bool (= (vector-at V sm-fail) 0))
(defn- sm-jmp [M :vector-i64 kind :i64 l :i64 w :i64] :vector-i64 (-> M (gn-fix kind l) (gn-emit w)))
(defn- sm-def [M :vector-i64 l :i64] :vector-i64 (gn-put M (+ MM-LABEL-BASE l) (vector-at M MM-CODE-N)))
;; x16 holds no known constant
(defn- sm-k16x [V :vector-i64] :vector-i64 (vector-assoc! V sm-k16 0))
;; define label l here (x16 forgotten); first drop a `b l` just before it, and turn `b.c l ; b m` before it into `b.!c m`
;; (only when no label sits on the dropped word or here: removing a word moves this position)
(defn- sm-defp [M :vector-i64 V :vector-i64 l :i64] :vector-i64
 (let [n (vector-at M MM-CODE-N) fx (vector-at M MM-FIX-N)
       b1 (+ MM-FIX-BASE (* (dec fx) MM-FIX-W)) b2 (+ MM-FIX-BASE (* (- fx 2) MM-FIX-W))
       lastb (and (> (dec fx) (vector-at V sm-fx0)) (= (vector-at M (+ b1 XF-AT)) (dec n)) (= (vector-at M (+ b1 XF-KIND)) FX-B26)
                  (< (vector-at V sm-ldef) (dec n)) (> (dec n) (vector-at V sm-cn0)))
       k2 (vector-at M (+ b2 XF-KIND))]
  (cond (and lastb (= (vector-at M (+ b1 XF-TARGET)) l))
        (sm-defp (-> M (gn-put MM-CODE-N (dec n)) (gn-put MM-FIX-N (dec fx))) V l)
        (and lastb (> (- fx 2) (vector-at V sm-fx0)) (= (vector-at M (+ b2 XF-AT)) (- n 2))
             (= (vector-at M (+ b2 XF-TARGET)) l) (or (= k2 FX-BC19) (= k2 FX-CB19)))
        (let [w (vector-at M (+ MM-CODE-BASE (- n 2)))]
          (sm-defp (-> M (gn-put (+ MM-CODE-BASE (- n 2)) (bit-xor w (if (= k2 FX-BC19) 1 16777216)))
                         (gn-put (+ b2 XF-TARGET) (vector-at M (+ b1 XF-TARGET)))
                         (gn-put MM-CODE-N (dec n)) (gn-put MM-FIX-N (dec fx))) V l))
        :else (let [V1 (-> V (vector-assoc! sm-ldef n) (sm-k16x))] (sm-def M l)))))
;; ---- shapes (SIR only) ----
(defn- sm-q [M :vector-i64 p :i64] :i64
 (let [j (if (= (gn-op M (inc p)) OP-FUEL) (+ p 2) (inc p))] (if (= (gn-op M j) OP-LABEL) (inc j) 0)))
(defn- sm-own [M :vector-i64 p :i64] :i64 (if (= (gn-op M (inc p)) OP-FUEL) 1 0))
(defn- sm-lpos [M :vector-i64 p :i64 l :i64] :i64
 (loop [j (inc p)]
  (let [op (gn-op M j)]
   (cond (or (= op OP-END) (= op OP-FN) (> j (+ p sm-maxlen))) 0
         (and (= op OP-LABEL) (= (gn-sir M j IF-A) l)) j
         :else (recur (inc j))))))
(defn- sm-end [M :vector-i64 p :i64] :i64
 (loop [j (inc p)] (if (or (= (gn-op M j) OP-END) (> j (+ p sm-maxlen))) j (recur (inc j)))))
;; the CALL at j gives the function's result: only LABELs and forward BRs lead to RET 0
(defn- sm-tail? [M :vector-i64 p :i64 j :i64] :bool
 (loop [k (inc j) n 0]
  (let [op (gn-op M k)]
   (cond (> n 32) false
         (= op OP-LABEL) (recur (inc k) (inc n))
         (= op OP-BR) (let [x (sm-lpos M p (gn-sir M k IF-A))] (if (> x k) (recur x (inc n)) false))
         :else (and (= op OP-RET) (= (gn-sir M k IF-A) 0))))))
;; (if (< a 0) (if (< b 0) (< a b) false) (if (< b 0) true (< a b))): a <u b
(defn- sm-upat [] :vector-i64 [562962837667841 4229365769 4294967300 65539 131079 277102700003339 8589934596 65539 131079 277119879872523 4294967300 8590000132 131079 4228382730 4228513801 3 4228382729 4227465226 4228251657 8589934596 65539 131079 277072635232267 4294967299 4227530762 4227792905 4294967300 8590000132 131079 4227530761 4227465225 19 4294311938])
(defn- sm-ident? [M :vector-i64 g :i64] :bool
 (let [p (gn-fnf M g FF-SIR)]
  (and (gn-dot-at? M p OP-FN g 1 (gn-sir M p IF-C)) (= (gn-op M (inc p)) OP-LABEL)
       (gn-dot-at? M (+ p 2) OP-LGET 0 1 0) (gn-dot-at? M (+ p 3) OP-RET 0 0 0) (= (gn-op M (+ p 4)) OP-END))))
;; (defn f [v i] (if (= i N) v (f (put v i 0) (+ i 1)))): zero items i..N-1
(defn- sm-fpat [] :vector-i64 [562962837667841 18 4229300233 8589934596 281423437168643 65543 277141354709003 4294967300 4228055050 4228841481 4294967300 8590000132 131075 844429224378381 8590000132 4295098371 4295032838 65541 4295098373 18 4229300234 4228055049 19 4294311938])
(defn- sm-fill? [M :vector-i64 g :i64] :bool
 (let [p (gn-fnf M g FF-SIR) w (gn-sir M (+ p 13) IF-A) n (gn-sir M (+ p 4) IF-B)]
  (and (= (gn-fnf M g FF-NPARAMS) 2) (= (gn-fnf M g FF-PT0) TY-VEC) (= (gn-fnf M g FF-RTYPE) TY-VEC)
       (>= n 0) (<= n 4096) (> w 0) (< w (vector-at M MM-FN-N))
       (kpat-match M p (sm-fpat) [g w n]) (= (sm-callk M w 3) 1))))
(defn- sm-fillfuel [M :vector-i64 g :i64 i0 :i64] :i64
 (let [p (gn-fnf M g FF-SIR)]
  (+ 1 (* (- (gn-sir M (+ p 4) IF-B) i0) (+ 1 (sm-callfuel M (gn-sir M (+ p 13) IF-A) 1))))))
;; 1 in-place writer (v i x), 2 sign wrapper, 3 unsigned less, 4 identity, 5 zero fill (v i), 0 other
(defn- sm-callk [M :vector-i64 g :i64 n :i64] :i64
 (if (or (<= g 0) (>= g (vector-at M MM-FN-N)) (gn-clamp-open M g) (<= (gn-fnf M g FF-SIR) 0)
         (>= (gn-fnf M g FF-SIR) (- (vector-at M MM-SIR-N) 40))) 0
  (cond (and (= n 3) (let [w (gn-wrapper M g 0 3)] (or (= w RT-VECTOR-ASSOC-IN-PLACE) (= w (+ RT-VECTOR-ASSOC-IN-PLACE 256))))) 1
        (and (= n 1) (> (gn-sign-wrapper M g 1) 0)) 2
        (and (= n 2) (= (gn-fnf M g FF-NPARAMS) 2) (kpat-match M (gn-fnf M g FF-SIR) (sm-upat) [g])) 3
        (and (= n 1) (= (gn-fnf M g FF-NPARAMS) 1) (sm-ident? M g)) 4
        (and (= n 2) (sm-fill? M g)) 5
        :else 0)))
(defn- sm-callfuel [M :vector-i64 g :i64 k :i64] :i64
 (cond (= k 1) (if (>= (gn-wrapper M g 0 3) 256) 1 0)
       (= k 2) (if (= (bit-and (gn-sign-wrapper M g 1) 512) 512) 1 0)
       (= k 5) (sm-fillfuel M g 0)
       :else 0))
(defn- sm-ops-ok? [M :vector-i64 p :i64 j :i64 ns :i64] :bool
 (if (> j (+ p sm-maxlen)) false
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
   (if (= op OP-END) (= a (gn-sir M p IF-A))
    (and (case op
           OP-CONST (and (>= a 0) (< a 5))
           OP-LGET (and (>= a 0) (< a 5) (>= b 1) (<= b ns))
           OP-LSET (and (>= a 2) (<= a ns) (>= b 0) (< b 5))
           OP-BIN (and (>= b 0) (< b 4) (or (= a BOP-ADD) (= a BOP-SUB) (= a BOP-AND) (= a BOP-OR) (= a BOP-XOR)))
           OP-CMP (and (>= b 0) (< b 4) (>= a CC-EQ) (<= a CC-GE))
           OP-UN (and (>= b 0) (< b 5) (= a UOP-NOT))
           OP-RT (and (= a RT-VECTOR-AT) (= c 2) (>= b 0) (< b 4))
           OP-CALL (and (>= b 0) (>= c 1) (<= (+ b c) 5))
           (OP-BRZ OP-BRNZ) (and (>= a 0) (< a 5) (> (sm-lpos M p b) j))
           OP-BR (> (sm-lpos M p a) j)
           OP-LABEL true
           OP-RET (= a 0)
           false)
         (sm-ops-ok? M p (inc j) ns))))))
(defn- sm-body-ok? [M :vector-i64 f :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
      (or (= (gn-fnf M f FF-KIND) FK-DEFN) (= (gn-fnf M f FF-KIND) FK-PRIV))
      (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f FF-RTYPE) TY-VEC)
      (<= (gn-fnf M f FF-DEPTH) 5)
      (let [p (gn-fnf M f FF-SIR)]
       (and (> p 0) (< (+ p 4) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f)
            (= (gn-sir M p IF-B) 1) (>= (gn-sir M p IF-C) 1) (<= (gn-sir M p IF-C) 6) (> (sm-q M p) 0)
            (sm-ops-ok? M p (sm-q M p) (gn-sir M p IF-C))))))
(defn- sm-rcall? [M :vector-i64 j :i64] :bool
 (and (= (gn-op M j) OP-CALL) (= (gn-sir M j IF-C) 1) (= (sm-callk M (gn-sir M j IF-A) 1) 0) (sm-body-ok? M (gn-sir M j IF-A))))
;; ---- region discovery: every function in one context (0: E's; one per controller call), cycle heads in context 0 ----
(defn- sm-visit-ops [M :vector-i64 V :vector-i64 p :i64 j :i64 c :i64] :vector-i64
 (let [op (gn-op M j)]
  (cond (or (= op OP-END) (not (sm-ok? V))) V
        (= op OP-CALL)
        (let [g (gn-sir M j IF-A) t (gn-sir M j IF-B) n (gn-sir M j IF-C)]
          (cond (> (sm-callk M g n) 0) (sm-visit-ops M V p (inc j) c)
                (and (= n 1) (sm-body-ok? M g))
                (if (and (= t 0) (sm-tail? M p j))
                  (sm-visit-ops M (sm-visit M (sm-fa! V 3 g (inc (sm-fa V 3 g))) g c) p (inc j) c)
                  (let [c2 (vector-at V sm-nctx)]
                    (if (>= c2 sm-maxctx) (sm-failv V 5)
                      (sm-visit-ops M (sm-visit M (vector-assoc! V sm-nctx (inc c2)) g c2) p (inc j) c))))
                :else (sm-failv V 6)))
        :else (sm-visit-ops M V p (inc j) c))))
(defn- sm-visit [M :vector-i64 V :vector-i64 f :i64 c :i64] :vector-i64
 (let [cx (sm-fa V 0 f) fl (sm-fa V 1 f)]
  (cond (not (sm-ok? V)) V
        (> cx 0) (cond (not= cx (inc c)) (sm-failv V 1)
                       (= (bit-and fl 1) 1) (if (= c 0) (sm-fa! V 1 f (bit-or fl 2)) (sm-failv V 2))
                       :else V)
        (>= (vector-at V sm-cnt) sm-maxfn) (sm-failv V 4)
        :else
        (let [V1 (-> V (sm-fa! 0 f (inc c)) (sm-fa! 1 f 1) (vector-assoc! sm-cnt (inc (vector-at V sm-cnt))))
              p (gn-fnf M f FF-SIR)
              V2 (sm-visit-ops M V1 p (sm-q M p) c)]
          (sm-fa! V2 1 f (bit-and (sm-fa V2 1 f) -2))))))
;; some function outside the region calls f
(defn- sm-outside? [M :vector-i64 V :vector-i64 f :i64] :bool
 (let [sn (vector-at M MM-SIR-N)]
  (loop [j 1 g 0]
   (if (>= j sn) false
    (let [op (gn-op M j)]
     (cond (= op OP-FN) (recur (inc j) (gn-sir M j IF-A))
           (and (= op OP-CALL) (= (gn-sir M j IF-A) f) (> g 0) (< g (vector-at V sm-nf)) (= (sm-fa V 0 g) 0)) true
           :else (recur (inc j) g)))))))
;; call sites of f (at most 2 counted), + 4 when one is in a region function
(defn- sm-callinfo [M :vector-i64 f :i64] :i64
 (let [sn (vector-at M MM-SIR-N)]
  (loop [j 1 n 0 g 0 r 0]
   (let [op (gn-op M j)]
    (cond (or (>= j sn) (= (+ n r) 6)) (+ n r)
          (= op OP-FN) (recur (inc j) n (gn-sir M j IF-A) r)
          (and (= op OP-CALL) (= (gn-sir M j IF-A) f))
          (recur (inc j) (gn-min 2 (inc n)) g (if (or (= r 4) (and (> g 0) (sm-body-ok? M g))) 4 0))
          :else (recur (inc j) n g r))))))
(defn- sm-heads? [V :vector-i64] :bool
 (loop [f 1] (cond (>= f (vector-at V sm-nf)) false (= (bit-and (sm-fa V 1 f) 2) 2) true :else (recur (inc f)))))
;; ---- the most expensive path (charges) from a function's entry to a cycle head (0 beyond) or its context's return ----
(defn- sm-pmax [M :vector-i64 V :vector-i64 p :i64 j :i64] :i64
 (let [op (gn-op M j) V1 (vector-assoc! V sm-steps (inc (vector-at V sm-steps)))]
  (cond (or (= op OP-RET) (= op OP-END) (> (vector-at V sm-steps) 2000000)) 0
        (= op OP-BR) (sm-pmax M V p (sm-lpos M p (gn-sir M j IF-A)))
        (or (= op OP-BRZ) (= op OP-BRNZ))
        (gn-max (sm-pmax M V p (sm-lpos M p (gn-sir M j IF-B))) (sm-pmax M V p (inc j)))
        (= op OP-CALL)
        (let [g (gn-sir M j IF-A) k (sm-callk M g (gn-sir M j IF-C))]
          (cond (> k 0) (+ (sm-callfuel M g k) (sm-pmax M V p (inc j)))
                (and (= (gn-sir M j IF-B) 0) (sm-tail? M p j)) (if (= (bit-and (sm-fa V 1 g) 2) 2) 0 (sm-cost M V g))
                :else (+ (sm-cost M V g) (sm-pmax M V p (inc j)))))
        :else (sm-pmax M V p (inc j)))))
(defn- sm-cost [M :vector-i64 V :vector-i64 f :i64] :i64
 (let [m (sm-fa V 4 f)]
  (if (> m 0) (dec m)
   (let [p (gn-fnf M f FF-SIR)
         x (+ (sm-own M p) (sm-pmax M V p (sm-q M p)))
         V1 (sm-fa! V 4 f (inc x))]
    x))))
;; ---- item liveness: a store whose item is overwritten before any read on every path, with no exit between, is dropped
;; (nothing in the block can trap; every exit -- RET of E, a cycle head and its fallback -- keeps all items live).
;; Per region function f (array 6: its first position slot), per body position: [item of the access at j (-1 unknown),
;; live items before j: sm-lw words]; items >= 64 * sm-lw are never dropped. Contexts' return sets at sm-stk.
(def sm-lw 4)
(def sm-u -4611686018427387904)
(defn- sm-lva [V :vector-i64 f :i64 p :i64 j :i64] :i64 (+ (vector-at V sm-lvb) (* (+ (sm-fa V 6 f) (- j p)) (inc sm-lw))))
(defn- sm-cra [c :i64] :i64 (+ sm-stk (* c (inc sm-lw))))
(defn- sm-lall [V :vector-i64 a :i64] :vector-i64 (loop [w 1 W V] (if (> w sm-lw) W (recur (inc w) (vector-assoc! W (+ a w) -1)))))
(defn- sm-lcopy [V :vector-i64 d :i64 s :i64] :vector-i64
 (loop [w 1 W V] (if (> w sm-lw) W (recur (inc w) (vector-assoc! W (+ d w) (vector-at W (+ s w)))))))
(defn- sm-lor [V :vector-i64 d :i64 s :i64] :vector-i64
 (loop [w 1 W V] (if (> w sm-lw) W (recur (inc w) (vector-assoc! W (+ d w) (bit-or (vector-at W (+ d w)) (vector-at W (+ s w))))))))
(defn- sm-lbit [V :vector-i64 a :i64 k :i64 on :bool] :vector-i64
 (let [i (+ a 1 (u64-shift-right k 6)) m (i64-shift-left 1 (bit-and k 63)) x (vector-at V i)]
  (vector-assoc! V i (if on (bit-or x m) (bit-xor x (bit-and x m))))))
(defn- sm-lhas? [V :vector-i64 a :i64 k :i64] :bool
 (not= (bit-and (vector-at V (+ a 1 (u64-shift-right k 6))) (i64-shift-left 1 (bit-and k 63))) 0))
(defn- sm-kidx [x :i64] :i64 (if (or (= x sm-u) (< x 0)) -1 x))
(defn- sm-lunk [V :vector-i64] :vector-i64 (loop [k 0 W V] (if (> k 15) W (recur (inc k) (vector-assoc! W (+ sm-pt k) sm-u)))))
;; constant item indices of the accesses of f (temps at sm-pt + t, slots at sm-pt + 8 + s; joins forget)
(defn- sm-lidx [M :vector-i64 V :vector-i64 f :i64 p :i64 q :i64] :vector-i64
 (loop [j q W (sm-lunk V)]
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C) at (sm-lva W f p j)]
   (if (or (= op OP-END) (> j (+ p sm-maxlen))) W
    (recur (inc j)
     (case op
       OP-LABEL (sm-lunk W)
       OP-CONST (vector-assoc! W (+ sm-pt a) b)
       OP-LGET (vector-assoc! W (+ sm-pt a) (if (= b 1) sm-u (vector-at W (+ sm-pt 8 b))))
       OP-LSET (vector-assoc! W (+ sm-pt 8 a) (vector-at W (+ sm-pt b)))
       OP-BIN (let [x (vector-at W (+ sm-pt b)) y (vector-at W (+ sm-pt (inc b)))]
                (vector-assoc! W (+ sm-pt b) (if (or (= x sm-u) (= y sm-u)) sm-u (sm-fold a x y))))
       OP-RT (-> W (vector-assoc! at (sm-kidx (vector-at W (+ sm-pt (inc b))))) (vector-assoc! (+ sm-pt b) sm-u))
       OP-CALL (let [k (sm-callk M a c) x (vector-at W (+ sm-pt b))]
                 (cond (or (= k 1) (= k 5)) (-> W (vector-assoc! at (sm-kidx (vector-at W (+ sm-pt (inc b))))) (vector-assoc! (+ sm-pt b) sm-u))
                       (= k 2) (vector-assoc! W (+ sm-pt b) (if (= x sm-u) sm-u (sm-sext x (bit-and (gn-sign-wrapper M a 1) 511))))
                       (= k 4) W
                       :else (vector-assoc! W (+ sm-pt b) sm-u)))
       (OP-CMP OP-UN) (vector-assoc! W (+ sm-pt b) sm-u)
       W))))))
(defn- sm-lentry [M :vector-i64 V :vector-i64 g :i64] :i64
 (let [p (gn-fnf M g FF-SIR)] (sm-lva V g p (sm-q M p))))
(defn- sm-lop [M :vector-i64 V :vector-i64 f :i64 p :i64 j :i64] :vector-i64
 (let [op (gn-op M j) a (sm-lva V f p j) n (sm-lva V f p (inc j)) x (vector-at V a) c (dec (sm-fa V 0 f)) top (* 64 sm-lw)]
  (case op
    OP-RET (if (= c 0) (sm-lall V a) (sm-lcopy V a (sm-cra c)))
    OP-BR (sm-lcopy V a (sm-lva V f p (sm-lpos M p (gn-sir M j IF-A))))
    (OP-BRZ OP-BRNZ) (-> V (sm-lcopy a n) (sm-lor a (sm-lva V f p (sm-lpos M p (gn-sir M j IF-B)))))
    OP-RT (if (and (>= x 0) (< x top)) (-> V (sm-lcopy a n) (sm-lbit a x true)) (sm-lall V a))
    OP-CALL
    (let [g (gn-sir M j IF-A) k (sm-callk M g (gn-sir M j IF-C))]
     (cond (= k 1) (if (and (>= x 0) (< x top)) (-> V (sm-lcopy a n) (sm-lbit a x false)) (sm-lcopy V a n))
           (= k 5) (let [hi (gn-min top (gn-sir M (+ (gn-fnf M g FF-SIR) 4) IF-B))]
                     (loop [i x W (sm-lcopy V a n)] (if (or (< i 0) (>= i hi)) W (recur (inc i) (sm-lbit W a i false)))))
           (> k 0) (sm-lcopy V a n)
           (and (= (gn-sir M j IF-B) 0) (sm-tail? M p j))
           (if (or (= (bit-and (sm-fa V 1 g) 2) 2) (= (sm-fa V 7 g) 1)) (sm-lall V a)
             (let [V1 (sm-live-fn M V g)] (sm-lcopy V1 a (sm-lentry M V1 g))))
           :else (let [V1 (sm-lcopy V (sm-cra (dec (sm-fa V 0 g))) n) V2 (sm-live-fn M V1 g)]
                   (if (= (sm-fa V2 7 g) 2) (sm-lcopy V2 a (sm-lentry M V2 g)) (sm-lall V2 a)))))
    (sm-lcopy V a n))))
(defn- sm-live-fn [M :vector-i64 V :vector-i64 f :i64] :vector-i64
 (if (> (sm-fa V 7 f) 0) V
  (let [p (gn-fnf M f FF-SIR) e (sm-end M p) q (sm-q M p)
        V1 (sm-lall (sm-lidx M (sm-fa! V 7 f 1) f p q) (sm-lva V f p e))]
   (loop [j (dec e) W V1] (if (< j q) (sm-fa! W 7 f 2) (recur (dec j) (sm-lop M W f p j)))))))
;; the scratch grown by the live sets (after discovery), every region function analysed
(defn- sm-grow [M :vector-i64 V :vector-i64] :vector-i64
 (let [nf (vector-at V sm-nf)
       span (loop [f 1 n 0] (if (>= f nf) n (recur (inc f) (if (> (sm-fa V 0 f) 0) (+ n 1 (- (sm-end M (gn-fnf M f FF-SIR)) (gn-fnf M f FF-SIR))) n))))
       V2 (vector-alloc (+ sm-fa0 (* 8 nf) (* (inc sm-lw) (+ span 2))))
       V3 (loop [k 0 W V2] (if (>= k (+ sm-fa0 (* 6 nf))) W (recur (inc k) (vector-assoc! W k (vector-at V k)))))
       V4 (-> V3 (vector-assoc! sm-lvb (+ sm-fa0 (* 8 nf))))
       V5 (loop [f 1 o 0 W V4] (if (>= f nf) W
            (if (> (sm-fa W 0 f) 0)
              (recur (inc f) (+ o 1 (- (sm-end M (gn-fnf M f FF-SIR)) (gn-fnf M f FF-SIR))) (sm-fa! W 6 f o))
              (recur (inc f) o W))))]
  ;; context-0 functions only: a controller's functions need its call site's continuation first
  (loop [f 1 W (sm-live-fn M V5 (vector-at V5 sm-e))] (if (>= f nf) W (recur (inc f) (if (= (sm-fa W 0 f) 1) (sm-live-fn M W f) W))))))
;; the item written at j is dead: overwritten before read on every path from j
(defn- sm-dead? [M :vector-i64 V :vector-i64 j :i64 idx :i64] :bool
 (let [f (vector-at V sm-f) p (vector-at V sm-p)]
  (and (>= idx 0) (< idx (* 64 sm-lw)) (= (sm-fa V 7 f) 2) (not (sm-lhas? V (sm-lva V f p (inc j)) idx)))))
;; ---- emission state: temps 0..4 (kind 1 the handle, 2 constant, 3 register, 4 flags cond), slots 2..6 (2 or 3) ----
(defn- sm-tkind [V :vector-i64 t :i64] :i64 (vector-at V (+ sm-tk t)))
(defn- sm-tval [V :vector-i64 t :i64] :i64 (vector-at V (+ sm-tv t)))
(defn- sm-tset [V :vector-i64 t :i64 k :i64 x :i64] :vector-i64
 (let [V1 (if (= (vector-at V sm-flagt) t) (vector-assoc! V sm-flagt -1) V)]
  (-> V1 (vector-assoc! (+ sm-tk t) k) (vector-assoc! (+ sm-tv t) x))))
(defn- sm-setf [V :vector-i64 t :i64 c :i64] :vector-i64 (-> V (sm-tset t 4 c) (vector-assoc! sm-flagt t)))
;; temps above t are dead
(defn- sm-kill [V :vector-i64 t :i64] :vector-i64
 (loop [u (inc t) W V] (if (> u 7) W (recur (inc u) (sm-tset W u 0 0)))))
(defn- sm-skind [V :vector-i64 s :i64] :i64 (vector-at V (+ sm-sk s)))
(defn- sm-sval [V :vector-i64 s :i64] :i64 (vector-at V (+ sm-sv s)))
(defn- sm-sset [V :vector-i64 s :i64 k :i64 x :i64] :vector-i64 (-> V (vector-assoc! (+ sm-sk s) k) (vector-assoc! (+ sm-sv s) x)))
(defn- sm-reset [V :vector-i64] :vector-i64
 (loop [u 0 W (vector-assoc! V sm-flagt -1)] (if (> u 7) W (recur (inc u) (-> W (sm-tset u 0 0) (sm-sset u 0 0))))))
;; some temp other than t holds register r
(defn- sm-aliased? [V :vector-i64 r :i64 t :i64] :bool
 (loop [u 0] (cond (> u 4) false (and (not= u t) (= (sm-tkind V u) 3) (= (sm-tval V u) r)) true :else (recur (inc u)))))
(defn- sm-flush [M :vector-i64 V :vector-i64] :vector-i64
 (let [n (vector-at V sm-pend) V1 (vector-assoc! V sm-pend 0)]
  (cond (= n 0) M
        (<= n 4095) (gn-emit M (enc-sub-i 8 8 n))
        :else (let [V2 (sm-k16x V)] (-> M (gn-mov-imm 16 n) (gn-emit (enc-sub-r 8 8 16)))))))
;; temp t into its canonical register x(9+t)
(defn- sm-canon [M :vector-i64 V :vector-i64 t :i64] :vector-i64
 (let [k (sm-tkind V t) x (sm-tval V t) r (+ 9 t)]
  (cond (= k 2) (let [V1 (sm-tset V t 3 r)] (gn-mov-imm M r x))
        (= k 3) (let [V1 (sm-tset V t 3 r)] (gn-mov M r x))
        (= k 4) (let [V1 (sm-tset V t 3 r)] (gn-emit M (enc-cset r x)))
        (= k 1) (let [V1 (sm-failv V 20)] M)
        :else M)))
;; temp t as a register operand: a constant into scratch s, flags into the canonical register
(defn- sm-opnd [M :vector-i64 V :vector-i64 t :i64 s :i64] :vector-i64
 (let [k (sm-tkind V t) x (sm-tval V t)]
  (cond (= k 2) (let [V1 (-> V (sm-tset t 3 s) (cond-> (= s 16) (sm-k16x)))] (gn-mov-imm M s x))
        (= k 4) (sm-canon M V t)
        (= k 3) M
        :else (let [V1 (sm-failv V 21)] M))))
;; before a flag-setting instruction: a flags temp becomes a register
(defn- sm-freef [M :vector-i64 V :vector-i64] :vector-i64
 (let [t (vector-at V sm-flagt)] (if (and (>= t 0) (= (sm-tkind V t) 4)) (sm-canon M V t) M)))
(defn- sm-live? [M :vector-i64 j :i64 t :i64] :bool
 (loop [k j n 0]
  (if (> n 48) true
   (let [op (gn-op M k) a (gn-sir M k IF-A) b (gn-sir M k IF-B) c (gn-sir M k IF-C)]
    (case op
      (OP-LABEL OP-FUEL) (recur (inc k) (inc n))
      (OP-CONST OP-LGET) (if (<= a t) false (recur (inc k) (inc n)))
      OP-LSET (cond (= b t) true (< b t) false :else (recur (inc k) (inc n)))
      (OP-BIN OP-CMP) (cond (or (= b t) (= (inc b) t)) true (> t b) false :else (recur (inc k) (inc n)))
      OP-UN (cond (= b t) true (> t b) false :else (recur (inc k) (inc n)))
      (OP-RT OP-CALL) (cond (and (>= t b) (< t (+ b c))) true (> t b) false :else (recur (inc k) (inc n)))
      (OP-BRZ OP-BRNZ) (if (< a t) false true)
      OP-RET (= a t)
      OP-END false
      true)))))
(defn- sm-canon-live [M :vector-i64 V :vector-i64 j :i64] :vector-i64
 (loop [t 0 m M] (if (> t 4) m (recur (inc t) (if (sm-live? m j t) (sm-canon m V t) m)))))
;; constant let slots read at or after j go to their registers (all paths into a join agree)
(defn- sm-sread? [M :vector-i64 j :i64 s :i64] :bool
 (loop [k j]
  (let [op (gn-op M k)]
   (cond (or (= op OP-END) (= op OP-FN) (> k (+ j sm-maxlen))) false
         (and (= op OP-LGET) (= (gn-sir M k IF-B) s)) true
         (and (= op OP-LSET) (= (gn-sir M k IF-A) s)) false
         :else (recur (inc k))))))
(defn- sm-canon-slots [M :vector-i64 V :vector-i64 j :i64] :vector-i64
 (loop [s 2 m M]
  (if (> s 6) m
   (recur (inc s) (if (and (= (sm-skind V s) 2) (sm-sread? m j s))
                    (let [x (sm-sval V s) V1 (sm-sset V s 3 (dec s))] (gn-mov-imm m (dec s) x))
                    m)))))
(defn- sm-canon-all [M :vector-i64 V :vector-i64 j :i64] :vector-i64 (sm-canon-slots (sm-canon-live M V j) V j))
;; jump target of a branch whose temp t is known zero (z 1) / nonzero (z 2) / unknown (0) on the edge
(defn- sm-thread [M :vector-i64 p :i64 j :i64 t :i64 z :i64] :i64
 (loop [k j n 0]
  (if (> n 32) k
   (let [op (gn-op M k)]
    (cond (= op OP-LABEL) (recur (inc k) (inc n))
          (= op OP-BR) (let [x (sm-lpos M p (gn-sir M k IF-A))] (if (> x k) (recur x (inc n)) k))
          (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= (gn-sir M k IF-A) t) (> z 0))
          (if (= (if (= op OP-BRZ) 1 2) z)
            (let [x (sm-lpos M p (gn-sir M k IF-B))] (if (> x k) (recur x (inc n)) k))
            (recur (inc k) (inc n)))
          :else k)))))
;; the label of position j of the current function (allocated on first use)
(defn- sm-ptlab [M :vector-i64 V :vector-i64 j :i64] :vector-i64
 (let [k (- j (vector-at V sm-p)) l (vector-at M MM-LABEL-N)]
  (cond (> (vector-at V (+ sm-pt k)) 0) M
        (>= l (- MM-LABEL-CAP 8)) (let [V1 (sm-failv V 40)] M)
        :else
   (let [V1 (-> V (vector-assoc! (+ sm-pt k) l) (vector-assoc! sm-ptmax (gn-max k (vector-at V sm-ptmax))))]
    (gn-put M MM-LABEL-N (inc l))))))
;; E's frame (a non-leaf E): callee-saved registers, sp, x29/x30 restored before leaving the block
(defn- sm-epi [M :vector-i64] :vector-i64
 (if (= (gn-g M gn-f-fb) 0) M
  (-> M (gn-csave 0 (gn-g M gn-f-nsv) 1) (gn-emit (enc-mov-sp 31 29)) (gn-emit (enc-ldp-post 29 30 31 16)))))
(defn- sm-ret [M :vector-i64 V :vector-i64] :vector-i64
 (let [M1 (sm-flush M V) c (vector-at V sm-ctx) V1 (vector-assoc! V sm-dead 1)]
  (if (= c 0) (-> M1 (gn-emit (enc-str 8 7 CTX-FUEL)) (sm-epi) (gn-emit (enc-ret)))
   (sm-jmp M1 FX-B26 (vector-at V (+ sm-cret c)) (enc-b 0)))))
;; unconditional transfer to position j
(defn- sm-goto [M :vector-i64 V :vector-i64 j :i64] :vector-i64
 (if (= (gn-op M j) OP-RET)
   (if (= (sm-tkind V 0) 1) (sm-ret M V) (let [V1 (sm-failv V 22)] M))
   (let [M1 (sm-canon-all (sm-flush M V) V j) M2 (sm-ptlab M1 V j) V1 (vector-assoc! V sm-dead 1)]
     (sm-jmp M2 FX-B26 (vector-at V (+ sm-pt (- j (vector-at V sm-p)))) (enc-b 0)))))
;; BRZ (nz false) / BRNZ (nz true) t to label l
(defn- sm-br [M :vector-i64 V :vector-i64 t :i64 l :i64 nz :bool] :vector-i64
 (let [p (vector-at V sm-p) k (sm-tkind V t) x (sm-tval V t) z (if nz 2 1)
       target (sm-thread M p (sm-lpos M p l) t z)]
  (cond (= k 2) (if (= (= x 0) nz) M (sm-goto M V target))
        (or (= k 3) (= k 4))
        (let [M1 (sm-canon-all (sm-flush M V) V target) M2 (sm-ptlab M1 V target)
              lab (vector-at V (+ sm-pt (- target p))) r (sm-tval V t)]
          (if (= k 4) (sm-jmp M2 FX-BC19 lab (enc-bcond (if nz x (bit-xor x 1)) 0))
            (sm-jmp M2 FX-CB19 lab (if nz (enc-cbnz r 0) (enc-cbz r 0)))))
        :else (let [V1 (sm-failv V 23)] M))))
(defn- sm-merge [M :vector-i64 V :vector-i64 j :i64] :vector-i64
 (let [M1 (if (= (vector-at V sm-dead) 0) (sm-canon-all (sm-flush M V) V j) M)
       M2 (sm-defp M1 V (vector-at V (+ sm-pt (- j (vector-at V sm-p)))))
       V1 (-> V (vector-assoc! sm-dead 0) (vector-assoc! sm-flagt -1))]
  (loop [t 0] (if (> t 4) M2
   (let [V2 (if (sm-live? M2 j t) (sm-tset V t 3 (+ 9 t)) (sm-tset V t 0 0))] (recur (inc t)))))))
(defn- sm-fold [bop :i64 a :i64 b :i64] :i64
 (cond (= bop BOP-ADD) (+ a b) (= bop BOP-SUB) (- a b) (= bop BOP-AND) (bit-and a b) (= bop BOP-OR) (bit-or a b)
       :else (bit-xor a b)))
(defn- sm-bin [M :vector-i64 V :vector-i64 bop :i64 t :i64] :vector-i64
 (let [ka (sm-tkind V t) kb (sm-tkind V (inc t)) a (sm-tval V t) b (sm-tval V (inc t)) d (+ 9 t)]
  (cond (and (= ka 2) (= kb 2)) (let [V1 (sm-tset V t 2 (sm-fold bop a b))] M)
        (and (= kb 2) (or (= bop BOP-ADD) (= bop BOP-SUB)) (>= b 0) (<= b 4095))
        (let [M1 (sm-opnd M V t 16) ra (sm-tval V t) V1 (sm-tset V t 3 d)]
          (gn-emit M1 (if (= bop BOP-ADD) (enc-add-i d ra b) (enc-sub-i d ra b))))
        :else
        (let [M1 (sm-opnd M V t 16) M2 (sm-opnd M1 V (inc t) 17) ra (sm-tval V t) rb (sm-tval V (inc t))
              V1 (sm-tset V t 3 d)]
          (gn-emit M2 (cond (= bop BOP-ADD) (enc-add-r d ra rb) (= bop BOP-SUB) (enc-sub-r d ra rb)
                            (= bop BOP-AND) (enc-and-r d ra rb) (= bop BOP-OR) (enc-orr-r d ra rb) :else (enc-eor-r d ra rb)))))))
(defn- sm-ult? [a :i64 b :i64] :bool (if (< a 0) (and (< b 0) (< a b)) (or (< b 0) (< a b))))
(defn- sm-cc-true? [cc :i64 a :i64 b :i64] :bool
 (cond (= cc CC-EQ) (= a b) (= cc CC-LT) (< a b) (= cc CC-GT) (> a b) (= cc CC-LE) (<= a b) (= cc CC-GE) (>= a b)
       :else (sm-ult? a b)))
;; the condition for (b ? a) given (a ? b)
(defn- sm-swapc [c :i64] :i64 (cond (= c 11) 12 (= c 12) 11 (= c 13) 10 (= c 10) 13 (= c 3) 8 (= c 2) 9 :else c))
;; compare temps t, t+1 (cc a CC-*, or 0 = unsigned less) into flags
(defn- sm-cmp [M :vector-i64 V :vector-i64 cc :i64 t :i64] :vector-i64
 (let [ka (sm-tkind V t) kb (sm-tkind V (inc t)) a (sm-tval V t) b (sm-tval V (inc t))
       c (if (= cc 0) 3 (enc-cond-of-cc cc))]
  (if (and (= ka 2) (= kb 2)) (let [V1 (sm-tset V t 2 (if (sm-cc-true? cc a b) 1 0))] M)
   (let [M0 (sm-freef M V)
         swap (and (= ka 2) (not= kb 2) (>= a -4095) (<= a 4095))
         imm (if swap a (if (= kb 2) b 99999))
         M1 (sm-opnd M0 V (if swap (inc t) t) 16)
         rn (sm-tval V (if swap (inc t) t))
         M2 (cond (and (>= imm 0) (<= imm 4095)) (gn-emit M1 (enc-cmp-i rn imm))
                  (and (< imm 0) (>= imm -4095)) (gn-emit M1 (enc-cmn-i rn (- 0 imm)))
                  :else (let [M3 (sm-opnd M1 V (inc t) 17)] (gn-emit M3 (enc-cmp-r rn (sm-tval V (inc t))))))
         V1 (sm-setf V t (if swap (sm-swapc c) c))]
    M2))))
;; a load of item idx of the handle (temp t), fused with a following sign wrapper and let
(defn- sm-vat [M :vector-i64 V :vector-i64 j :i64 t :i64] :vector-i64
 (let [idx (sm-tval V (inc t)) j1 (inc j) g (gn-sir M j1 IF-A)
       sw (if (and (= (gn-op M j1) OP-CALL) (= (gn-sir M j1 IF-B) t) (= (gn-sir M j1 IF-C) 1) (= (sm-callk M g 1) 2))
            (gn-sign-wrapper M g 1) 0)
       width (bit-and sw 511)
       j2 (if (> sw 0) (+ j 2) j1)
       s (if (and (= (gn-op M j2) OP-LSET) (= (gn-sir M j2 IF-B) t) (not (sm-aliased? V (dec (gn-sir M j2 IF-A)) -1)))
           (gn-sir M j2 IF-A) 0)
       d (if (> s 0) (dec s) (+ 9 t)) off (* 8 idx)
       fused (and (> width 0) (cw-ldrs-ok? width off))]
  (if (or (not= (sm-tkind V t) 1) (not= (sm-tkind V (inc t)) 2) (< idx 0) (> idx 4095)) (let [V1 (sm-failv V 24)] M)
   (let [V1 (-> V (vector-assoc! sm-maxidx (gn-max idx (vector-at V sm-maxidx)))
                (vector-assoc! sm-pend (+ (vector-at V sm-pend) (if (> sw 0) (sm-callfuel M g 2) 0)))
                (vector-assoc! sm-skip (+ (if (> sw 0) 1 0) (if (> s 0) 1 0))))
         M1 (cond fused (gn-emit M (cw-ldrs width d 6 off))
                  (> width 0) (-> M (gn-emit (enc-ldr d 6 off)) (gn-emit (gn-e-bf 0x93400000 d d 0 (dec width))))
                  :else (gn-emit M (enc-ldr d 6 off)))
         V2 (if (> s 0) (-> V (sm-sset s 3 d) (sm-tset t 0 0) (sm-kill t)) (-> V (sm-tset t 3 d) (sm-kill t)))]
    M1))))
(defn- sm-put [M :vector-i64 V :vector-i64 t :i64 g :i64 j :i64] :vector-i64
 (let [idx (sm-tval V (inc t)) k (sm-tkind V (+ t 2)) x (sm-tval V (+ t 2)) off (* 8 idx)]
  (if (or (not= (sm-tkind V t) 1) (not= (sm-tkind V (inc t)) 2) (< idx 0) (> idx 4095)) (let [V1 (sm-failv V 25)] M)
   (let [M1 (cond (and (or (= k 2) (= k 3) (= k 4)) (sm-dead? M V j idx)) M
                  (and (= k 2) (= x 0)) (gn-emit M (enc-str 31 6 off))
                  (and (= k 2) (= (vector-at V sm-k16) 1) (= (vector-at V sm-k16v) x)) (gn-emit M (enc-str 16 6 off))
                  (= k 2) (let [V2 (-> V (vector-assoc! sm-k16 1) (vector-assoc! sm-k16v x))] (-> M (gn-mov-imm 16 x) (gn-emit (enc-str 16 6 off))))
                  (= k 3) (gn-emit M (enc-str x 6 off))
                  (= k 4) (let [V2 (sm-k16x V)] (-> M (gn-emit (enc-cset 16 x)) (gn-emit (enc-str 16 6 off))))
                  :else (let [V1 (sm-failv V 26)] M))
         V1 (-> V (vector-assoc! sm-maxidx (gn-max idx (vector-at V sm-maxidx)))
                (vector-assoc! sm-pend (+ (vector-at V sm-pend) (sm-callfuel M g 1)))
                (sm-tset t 1 0) (sm-kill t))]
    M1))))
;; zeros for items k..n-1: q-register pairs (v0 zeroed once), x pairs, single items
(defn- sm-zero [M :vector-i64 k :i64 n :i64 q :bool] :vector-i64
 (cond (>= k n) M
       (= (bit-and k 1) 1) (sm-zero (gn-emit M (enc-str 31 6 (* 8 k))) (inc k) n q)
       (and (>= (- n k) 4) (<= (* 8 k) 1008))
       (sm-zero (gn-emit (if q M (gn-emit M 1862329344)) (+ 2902458560 (i64-shift-left (quot k 2) 15))) (+ k 4) n true)
       (and (>= (- n k) 2) (<= (* 8 k) 504)) (sm-zero (gn-emit M (enc-stp 31 31 6 (* 8 k))) (+ k 2) n q)
       :else (sm-zero (gn-emit M (enc-str 31 6 (* 8 k))) (inc k) n q)))
(defn- sm-fill [M :vector-i64 V :vector-i64 t :i64 g :i64] :vector-i64
 (let [n (gn-sir M (+ (gn-fnf M g FF-SIR) 4) IF-B) i0 (sm-tval V (inc t))]
  (if (or (not= (sm-tkind V t) 1) (not= (sm-tkind V (inc t)) 2) (< i0 0) (> i0 n) (> (- n i0) 512)) (let [V1 (sm-failv V 42)] M)
   (let [V1 (-> V (vector-assoc! sm-maxidx (gn-max (dec n) (vector-at V sm-maxidx)))
                (vector-assoc! sm-pend (+ (vector-at V sm-pend) (sm-fillfuel M g i0)))
                (sm-tset t 1 0) (sm-kill t))]
    (sm-zero M i0 n false)))))
(defn- sm-sext [x :i64 w :i64] :i64
 (let [m (i64-shift-left 1 w) v (bit-and x (dec m))] (if (>= v (i64-shift-right m 1)) (- v m) v)))
(defn- sm-sign [M :vector-i64 V :vector-i64 t :i64 g :i64] :vector-i64
 (let [w (bit-and (gn-sign-wrapper M g 1) 511) k (sm-tkind V t) x (sm-tval V t) d (+ 9 t)
       V0 (vector-assoc! V sm-pend (+ (vector-at V sm-pend) (sm-callfuel M g 2)))]
  (cond (= k 2) (let [V1 (sm-tset V t 2 (sm-sext x w))] M)
        (and (= k 4) (> w 1)) M
        (or (= k 3) (= k 4))
        (let [M1 (sm-opnd M V t 16) r (sm-tval V t) V1 (sm-tset V t 3 d)] (gn-emit M1 (gn-e-bf 0x93400000 d r 0 (dec w))))
        :else (let [V1 (sm-failv V 27)] M))))
(defn- sm-lset [M :vector-i64 V :vector-i64 s :i64 t :i64] :vector-i64
 (let [k (sm-tkind V t) x (sm-tval V t) r (dec s)]
  (if (sm-aliased? V r t) (let [V1 (sm-failv V 28)] M)
   (let [M1 (cond (= k 2) M
                  (= k 3) (gn-mov M r x)
                  (= k 4) (gn-emit M (enc-cset r x))
                  :else (let [V1 (sm-failv V 29)] M))
         V1 (-> V (sm-sset s (if (= k 2) 2 3) (if (= k 2) x r)) (sm-tset t 0 0) (sm-kill (dec t)))]
    M1))))
(defn- sm-sched [V :vector-i64 g :i64] :vector-i64
 (if (> (bit-and (sm-fa V 1 g) 12) 0) V
  (let [n (vector-at V sm-nstk)]
   (-> V (sm-fa! 1 g (bit-or (sm-fa V 1 g) 8)) (vector-assoc! (+ sm-stk n) g) (vector-assoc! sm-nstk (inc n))))))
;; a controller call: its region code returns to a label here; slots and register temps do not survive it
(defn- sm-ctrl [M :vector-i64 V :vector-i64 t :i64 g :i64] :vector-i64
 (let [c2 (dec (sm-fa V 0 g)) rl (vector-at M MM-LABEL-N)
       M1 (gn-put (sm-flush M V) MM-LABEL-N (inc rl))
       V1 (-> V (vector-assoc! (+ sm-cret c2) rl) (sm-sched g))
       M2 (sm-defp (sm-jmp M1 FX-B26 (sm-fa V 2 g) (enc-b 0)) V rl)
       ok (loop [u 0] (cond (>= u t) true (or (= (sm-tkind V u) 1) (= (sm-tkind V u) 2)) (recur (inc u)) :else false))
       V2 (loop [s 0 W (vector-assoc! V sm-flagt -1)] (if (> s 7) W (recur (inc s) (sm-sset W s 0 0))))
       V3 (if ok (-> V (sm-tset t 1 0) (sm-kill t)) (sm-failv V 31))]
  M2))
(defn- sm-op [M :vector-i64 V :vector-i64 j :i64] :vector-i64
 (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)
       V0 (vector-assoc! V sm-skip 0)]
  (case op
    OP-LABEL M
    OP-CONST (let [V1 (-> V (sm-tset a 2 b) (sm-kill a))] M)
    OP-LGET (let [V1 (cond (= b 1) (sm-tset V a 1 0)
                           (= (sm-skind V b) 2) (sm-tset V a 2 (sm-sval V b))
                           (= (sm-skind V b) 3) (sm-tset V a 3 (sm-sval V b))
                           :else (sm-failv V 32))
                  V2 (sm-kill V a)] M)
    OP-LSET (sm-lset M V a b)
    OP-BIN (let [M1 (sm-bin M V a b) V1 (sm-kill V b)] M1)
    OP-CMP (let [M1 (sm-cmp M V a b) V1 (sm-kill V b)] M1)
    OP-UN (let [k (sm-tkind V b) x (sm-tval V b)
                V1 (sm-kill V b)]
            (cond (= k 2) (let [V2 (sm-tset V b 2 (bit-xor x 1))] M)
                  (= k 4) (let [V2 (sm-setf V b (bit-xor x 1))] M)
                  (= k 3) (let [V2 (sm-tset V b 3 (+ 9 b))] (gn-emit M (enc-eor-1 (+ 9 b) x)))
                  :else (let [V2 (sm-failv V 33)] M)))
    OP-RT (sm-vat M V j b)
    OP-CALL (let [k (sm-callk M a c)]
              (cond (= k 1) (sm-put M V b a j)
                    (= k 2) (let [M1 (sm-sign M V b a) V1 (sm-kill V b)] M1)
                    (= k 3) (let [M1 (sm-cmp M V 0 b) V1 (sm-kill V b)] M1)
                    (= k 4) (let [V1 (sm-kill V b)] M)
                    (= k 5) (sm-fill M V b a)
                    (and (= c 1) (= (sm-tkind V b) 1) (> (sm-fa V 0 a) 0))
                    (if (and (= b 0) (sm-tail? M (vector-at V sm-p) j))
                      (let [M1 (sm-jmp (sm-flush M V) FX-B26 (sm-fa V 2 a) (enc-b 0))
                            V1 (-> V (sm-sched a) (vector-assoc! sm-dead 1))] M1)
                      (sm-ctrl M V b a))
                    :else (let [V1 (sm-failv V 34)] M)))
    OP-BRZ (sm-br M V a b false)
    OP-BRNZ (sm-br M V a b true)
    OP-BR (sm-goto M V (sm-thread M (vector-at V sm-p) (sm-lpos M (vector-at V sm-p) a) 0 0))
    OP-RET (if (= (sm-tkind V 0) 1) (sm-ret M V) (let [V1 (sm-failv V 35)] M))
    (let [V1 (sm-failv V 36)] M))))
;; a final tail call (nothing after it is reachable) to a function not laid out yet: lay it out here
(defn- sm-inline? [M :vector-i64 V :vector-i64 j :i64] :bool
 (let [g (gn-sir M j IF-A) p (vector-at V sm-p)]
  (and (= (gn-op M j) OP-CALL) (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) 1) (= (sm-tkind V 0) 1)
       (> g 0) (< g (vector-at V sm-nf)) (> (sm-fa V 0 g) 0) (= (sm-callk M g 1) 0)
       (= (bit-and (sm-fa V 1 g) 6) 0) (<= (vector-at V sm-ptmax) (- j p)) (sm-tail? M p j))))
(defn- sm-emit-ops [M :vector-i64 V :vector-i64 j :i64] :vector-i64
 (let [p (vector-at V sm-p) op (gn-op M j)]
  (cond (not (sm-ok? V)) M
        (or (> (- (vector-at M MM-CODE-N) (vector-at V sm-cn0)) 32768) (> (- (vector-at M MM-FIX-N) (vector-at V sm-fx0)) 12000))
        (let [V1 (sm-failv V 41)] M)
        (or (= op OP-END) (> j (+ p sm-maxlen))) (if (= (vector-at V sm-dead) 0) (let [V1 (sm-failv V 37)] M) M)
        :else
        (let [M1 (if (> (vector-at V (+ sm-pt (- j p))) 0) (sm-merge M V j) M)]
          (cond (= (vector-at V sm-dead) 1) (sm-emit-ops M1 V (inc j))
                (sm-inline? M1 V j)
                (let [g (gn-sir M j IF-A)]
                  (sm-emit-node (if (= (sm-fa V 3 g) 1) M1 (sm-flush M1 V)) V g))
                :else (let [M2 (sm-op M1 V j)] (sm-emit-ops M2 V (+ j 1 (vector-at V sm-skip)))))))))
(defn- sm-emit-node [M :vector-i64 V :vector-i64 f :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) len (- (sm-end M p) p)
       V1 (-> V (sm-fa! 1 f (bit-or (sm-fa V 1 f) 4)) (vector-assoc! sm-p p) (vector-assoc! sm-f f) (vector-assoc! sm-ctx (dec (sm-fa V 0 f)))
              (vector-assoc! sm-dead 0) (vector-assoc! sm-ptmax -1) (sm-reset))
       V2 (loop [k 0 W V] (if (> k len) W (recur (inc k) (vector-assoc! W (+ sm-pt k) 0))))
       k16 (vector-at V sm-k16) k16v (vector-at V sm-k16v)
       M1 (sm-defp M V (sm-fa V 2 f))
       V5 (if (and (= (sm-fa V 3 f) 1) (= (bit-and (sm-fa V 1 f) 2) 0)) (-> V (vector-assoc! sm-k16 k16) (vector-assoc! sm-k16v k16v)) V)
       cost (sm-cost M V f)
       M2 (if (= (bit-and (sm-fa V 1 f) 2) 2)
            (-> (if (<= cost 4095) (gn-emit M1 (enc-cmp-i 8 cost)) (let [V6 (sm-k16x V)] (-> M1 (gn-mov-imm 16 cost) (gn-emit (enc-cmp-r 8 16)))))
                (sm-jmp FX-BC19 (sm-fa V 5 f) (enc-bcond (enc-cond-lo) 0)))
            M1)
       V3 (vector-assoc! V sm-pend (+ (vector-at V sm-pend) (sm-own M p)))
       M3 (if (= f (vector-at V sm-e)) (sm-defp (sm-flush M2 V) V (vector-at V sm-ebody)) M2)]
  (if (or (> len sm-maxlen) (and (= (bit-and (sm-fa V 1 f) 2) 2) (> (- (vector-at V sm-pend) (sm-own M p)) 0)))
    (let [V4 (sm-failv V 38)] M3)
    (sm-emit-ops M3 V (sm-q M p)))))
(defn- sm-drain [M :vector-i64 V :vector-i64] :vector-i64
 (loop [m M]
  (let [n (vector-at V sm-nstk)]
   (if (or (= n 0) (not (sm-ok? V))) m
    (let [g (vector-at V (+ sm-stk (dec n))) V1 (vector-assoc! V sm-nstk (dec n))]
     (recur (cond (> (bit-and (sm-fa V 1 g) 4) 0) m
                  (> (vector-at V sm-pend) 0) (let [V2 (sm-failv V 39)] m)
                  :else (sm-emit-node m (sm-k16x V) g))))))))
(defn- sm-stubs [M :vector-i64 V :vector-i64] :vector-i64
 (loop [f 1 m M]
  (if (>= f (vector-at V sm-nf)) m
   (recur (inc f) (if (and (> (sm-fa V 0 f) 0) (= (bit-and (sm-fa V 1 f) 2) 2))
                    (-> m (sm-def (sm-fa V 5 f)) (gn-emit (enc-str 8 7 CTX-FUEL)) (sm-epi) (gn-fix FX-BL26 f) (gn-emit (enc-b 0)))
                    m)))))
(defn- sm-labels [M :vector-i64 V :vector-i64] :vector-i64
 (loop [f 1 m M]
  (if (>= f (vector-at V sm-nf)) m
   (recur (inc f) (if (> (sm-fa V 0 f) 0)
                    (let [l (vector-at m MM-LABEL-N) V1 (-> V (sm-fa! 2 f l) (sm-fa! 5 f (inc l)))] (gn-put m MM-LABEL-N (+ l 2)))
                    m)))))
(defn- sm-emit [M :vector-i64 V :vector-i64 f :i64 cost :i64] :vector-i64
 (let [cn0 (vector-at M MM-CODE-N) fx0 (vector-at M MM-FIX-N) ln0 (vector-at M MM-LABEL-N)
       e0 (vector-at M MM-ERR) ep0 (vector-at M MM-ERR-POS) en0 (vector-at M MM-ERR-N)
       Vc (-> V (vector-assoc! sm-cn0 cn0) (vector-assoc! sm-fx0 fx0) (vector-assoc! sm-ldef -1) (sm-k16x))
       M0 (sm-labels M V)
       eb (vector-at M0 MM-LABEL-N)
       V0 (-> V (vector-assoc! sm-ebody eb) (vector-assoc! sm-pend 0) (vector-assoc! sm-maxidx 0))
       M1 (-> (gn-put M0 MM-LABEL-N (inc eb)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
              (cond-> (<= cost 4096) (gn-emit (enc-cmp-i 8 (dec cost))))
              (cond-> (> cost 4096) (-> (gn-mov-imm 16 (dec cost)) (gn-emit (enc-cmp-r 8 16)))))
       b0 (vector-at M1 MM-CODE-N)
       M2 (-> M1 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
              (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)))
       b1 (vector-at M2 MM-CODE-N)
       M3 (-> M2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
              (gn-emit (enc-ldp 17 16 16 0)) (gn-emit (enc-cmp-i 16 0)))
       b2 (vector-at M3 MM-CODE-N)
       M4 (-> M3 (gn-emit (enc-bcond 9 0)) (gn-emit (enc-ldr 6 7 328)) (gn-emit (gn-e-addsl 6 6 17 3))
              (sm-jmp FX-B26 eb (enc-b 0)))
       ;; the T2 keep marker (HINT #127, never executed): T2 neither replaces E nor inlines it
       M5 (gn-emit (sm-stubs (sm-drain (sm-emit-node M4 V f) V) V) 0xD5032FFF)
       end (vector-at M5 MM-CODE-N) mx (vector-at V sm-maxidx)]
  (if (or (not (sm-ok? V)) (> (- end cn0) 32768) (> mx 4095) (not= (vector-at M5 MM-ERR) e0)
          (> (vector-at V sm-steps) 2000000))
    (-> M5 (gn-put MM-CODE-N cn0) (gn-put MM-FIX-N fx0) (gn-put MM-LABEL-N ln0)
        (gn-put MM-ERR e0) (gn-put MM-ERR-POS ep0) (gn-put MM-ERR-N en0))
    (-> M5 (gn-dot-patch b0 end (enc-cond-lo)) (gn-dot-patch b1 end (enc-cond-hs)) (gn-dot-patch b2 end 9)
        (gn-put (+ MM-CODE-BASE (dec b2)) (enc-cmp-i 16 mx))))))
(defn- sm-try [M :vector-i64 f :i64 ci :i64] :vector-i64
 (let [nf (vector-at M MM-FN-N)
       V (-> (vector-alloc (+ sm-fa0 (* 6 nf))) (vector-assoc! sm-nf nf) (vector-assoc! sm-nctx 1) (vector-assoc! sm-e f))
