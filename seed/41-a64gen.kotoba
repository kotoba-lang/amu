                  (kpat-match M (mmx-q M lm) [2251829877800961 18 4229300233 8589934596 65539 65543 65544 277128469807115 12884901892 65539 65543 65544 4228644873 276853591900171 4294967300 8590000132 131075 562958542635021 562949964955662 4295032836 12885032964 196611 562962837602317 562954259922958 131079 276965261049867 4294967300 17179934724 8590065668 844429224312845 4295032836 8590065668 4295163907 562962837602317 562954259922958 12885032964 8590131204 4295229443 562967132569613 21475098628 25770131460 65541 4295098373 8590131205 12885164037 17180196869 21475229701 18 4229300234 4224581642 4226154505 4294967300 17179934724 12885032964 844429224312845 8590000132 4295098372 12885098500 4295229443 562967132569613 562958554890254 12885098500 4295229443 562967132569613 21475098628 25770131460 65541 4295098373 8590131205 12885164037 17180196869 21475229701 18 4229300234 4224581641 4222812170 4224450569 4294967300 17179934724 8590065668 196611 8590000135 8590000136 276810642358283 8590065668 4223664138 4223795209 12885032964 4223664137 844429224312845 458757 30064771076 17179934724 562954247536653 524293 30064771076 21474902020 34359869444 25770000388 4295229443 1407379177603085 4222812169 19 4294311938] [lm dd pt tr ltd])
