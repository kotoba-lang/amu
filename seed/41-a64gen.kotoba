    m7 (-> m6 (gn-emit (enc-bcond (enc-cond-hs) 0)) (ga-index b q 0) (gn-mov 6 9)
      (gn-emit (enc-cmp-r 6 16))) badIndexB (vector-at m7 MM-CODE-N)
    m8 (-> m7 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (gn-e-ldrr 10 4 5 1))
