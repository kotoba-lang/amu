;; SOURCE prototype: immediate scalar prefix continuation, before postpass.
;; One new generator-extension cell follows the original allocated 90 cells.
(def cpp-state (+ gn-a-lp MM-LABEL-CAP 90))
(defn- cpp-counts [M :vector-i64] :bool
 (and (>= (vector-count M) MM-WORDS) (= (vector-at M MM-ERR) 0)
