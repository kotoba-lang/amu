(defn- ptb-code-e [] :string "~WW3.m[/^>TnGipr;ud!9q*:J>q*4umd/XAjlOX+^;ucnc!!!!!q*:VBM\\-R5WB`c^dX\\R$lOX(];ucnc!!!!!q*:bFM[9G>pi1T]d/X;9WY5KmdX\\Qq")
(defn- ptb-code-f [] :string "~WW3.mq*5)HZiC+4d/X=Uq#CQ]WYbj3dXV=3R`Q&^RgIbL(]XA$q#CQte0\"_kWY5KmWBjJSWBsh^WC(1iWC1OtWC:n*W5a2_emANpeH7K)")
(defn- ptb-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 96) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-PT0) TY-VEC)
   (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
   (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (let [rm (gn-sir M (+ p 5) IF-A) cb (gn-sir M (+ p 9) IF-A) ip (gn-sir M (+ p 14) IF-A)
         co (gn-sir M (+ p 52) IF-A) ps (gn-sir M (+ p 74) IF-A)
         cq (kfn-q M co) p8 (if (> cq 0) (gn-sir M (+ cq 27) IF-A) 0) s16 (if (> cq 0) (gn-sir M (+ cq 51) IF-A) 0)
         pc (if (> cq 0) (gn-sir M (+ cq 75) IF-A) 0) pt (if (> (kfn-q M p8) 0) (gn-sir M (+ (kfn-q M p8) 8) IF-A) 0)
         pt2 (if (> (kfn-q M ps) 0) (gn-sir M (+ (kfn-q M ps) 8) IF-A) 0)]
    (and (> cq 0) (blp-fn? M rm) (blp-fn? M cb) (blp-fn? M ip) (blp-fn? M ps) (blp-fn? M pt) (blp-fn? M pt2)
     (not= rm f) (not= cb f) (not= ip f) (not= co f) (not= ps f)
     (not (gn-clamp-open M cb)) (not (gn-clamp-open M ip)) (not (gn-clamp-open M co)) (not (gn-clamp-open M ps))
     (= (gn-fnf M cb FF-NPARAMS) 2) (= (gn-fnf M cb FF-PT0) TY-VEC) (= (gn-fnf M cb (+ FF-PT0 1)) TY-I64)
     (= (gn-fnf M cb FF-RTYPE) TY-VEC)
     (pj-fn? M f 97 (ptb-tb-pat) [f rm cb ip co ps])
     ;; rem may be the prelude's replaceable import (its label not entered): its SIR is what is relied on
     (> (gn-fnf M rm FF-SIR) 0) (kpat-smatch M (gn-fnf M rm FF-SIR) (ptb-rem-pat) [rm])
     (> (kfn-q M ip) 0) (pjp-admit M (inc (kfn-q M ip)))
     (pj-fn? M co 152 (ptb-col-pat) [co p8 s16 pc]) (pj-fn? M p8 11 (ptb-put8-pat) [p8 pt])
     (pj-fn? M pt 9 (pj-put-pat) [pt]) (pj-fn? M s16 19 (pj-i16-pat) [s16 65535 32768 65536])
     (pj-fn? M pc 25 (pj-pc-pat) [pc s16])
     (pj-fn? M ps 11 (ptb-put16-pat) [ps pt2 65535]) (pj-fn? M pt2 9 (pj-put-pat) [pt2]))))))
(defn- ptb-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (ptb-admit M i)) M
  (let [p (dec i) cb (gn-sir M (+ p 9) IF-A) ip (gn-sir M (+ p 14) IF-A) co (gn-sir M (+ p 52) IF-A)
        ps (gn-sir M (+ p 74) IF-A)]
   (-> M (kemit-hex (ptb-code-a)) (gn-fix FX-BL26 cb) (gn-emit (enc-bl 0))
       (kemit-hex (ptb-code-b)) (gn-fix FX-BL26 ip) (gn-emit (enc-bl 0))
       (kemit-hex (ptb-code-c)) (gn-fix FX-BL26 ip) (gn-emit (enc-bl 0))
       (kemit-hex (ptb-code-d)) (gn-fix FX-BL26 co) (gn-emit (enc-bl 0))
       (kemit-hex (ptb-code-e)) (gn-fix FX-BL26 ps) (gn-emit (enc-bl 0))
       (kemit-hex (ptb-code-f))))))

;; ---- picojpeg copy-input: (f v n offset i) puts jpeg-byte(offset + j) & 255 at v[4 + j] for j = i .. n - 1;
;; jpeg-byte is a threshold tree without a charge, so the charges are 1 at entry and 3 per item (put8, put, the loop).
;; Before the frame, with 0 <= i <= n, 0 <= offset and offset + n - 1 <= the tree's highest threshold H (patched into
;; the two compares), v live past item 4 + n - 1 and fuel for 1 + 3 (n - i): the charge is published and the items
;; are copied from the tree's values for 0 .. H (a table after the block; a byte table tree's values are 0..255, so
;; the & 255 is the identity) 4 at a time (ldp / stp of q registers), then one at a time. Anything else branches over
;; the table into copy-input's own code. Generated and checked against the source semantics outside the compiler;
;; carries the T2 keep marker after its ret. The SIRs of copy-input, put8 and put are packed patterns.
(defn- cin-pat [] :string "~!!3,n!!E9)!\"o83!!!!!!\"&Q=!!!!!!!E9%!!E9%!!E9&!!3-#!!`K)!!!!!!\"/c,r!rc-!!E9%!!*'\"!\"/W\"!!!!!!\"&Q6!!!!!!!E9%!!*'\"!!<3%!!E9%!!E9'!!E9%!!WE(!!*'\"!!E9'!!<3$!!E9(!!E9%!!WE(!!3-#!\"Ju$!!3-$!\"Ju#!!!!$!!E9&!!3-#!!E9'!!<3$!!E9(!!E9%!!<3(!!*'\"!!WE(!!<3$!!N?'!!!!!!!N?(!!*'\"!!N?)!!3-#!!N?*!!<3$!\"o83!!!!!!\"/W>!!!!!!\"&Q!!!!!!!##>4!!!!!!!<2o!!!!!")
(defn- cin-code-a [] :string "~lN%!8;ud*g\\+g-E")
(defn- cin-code-b [] :string "~;ud)XMZEfT")
(defn- cin-code-c [] :string "~;ud(Qq*:J>q*4umd/X:]lOX+^;ud&Qq*:VBM\\-R5WB`c^OT5qGlOX*s;ud$Ab6%_rM[]imOT5R1q*5)HlOEq;;ud\"&b74OYq#CQ]q*:bFM\\-F1MZXG#OT9tE&-)c-MZWrSM[g3bnGj0';uconXMG(uXFUQUnGj0'<<)umYlGB<;ucokpcsQ$p]-$YnGi`p<<)ulemANpeH7K)")
;; jb's SIR end when it is a byte table tree (blt-source: thresholds 0..1023, values 0..255, no charge), else 0; the
;; tree starts at its FN + 2, and cin-end / cin-val walk it by its shape (then-subtree, BR, LABEL, else-subtree, LABEL)
(defn- cin-tree [M :vector-i64 jb :i64] :i64
 (if (and (> jb 0) (< jb (vector-at M MM-FN-N)) (not (gn-clamp-open M jb))) (blt-source M jb) 0))
(defn- cin-end [M :vector-i64 p :i64] :i64
 (if (= (gn-op M p) OP-CONST) (inc p) (inc (cin-end M (+ (cin-end M (+ p 4)) 2)))))
(defn- cin-val [M :vector-i64 p :i64 x :i64] :i64
 (if (= (gn-op M p) OP-CONST) (gn-sir M p IF-B)
  (let [k (gn-sir M (inc p) IF-B)]
   (if (if (= (gn-sir M (+ p 2) IF-A) CC-LT) (< x k) (= x k)) (cin-val M (+ p 4) x)
    (cin-val M (+ (cin-end M (+ p 4)) 2) x)))))
(defn- cin-data [M :vector-i64 p :i64 x :i64 count :i64] :vector-i64
 (if (= x count) M
  (cin-data (-> M (gn-emit (bit-and (cin-val M p x) 0xffffffff)) (gn-emit 0)) p (inc x) count)))
(defn- cin-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 33) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-PT0) TY-VEC)
   (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
   (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (let [jb (gn-sir M (+ p 17) IF-A) p8 (gn-sir M (+ p 18) IF-A) q8 (kfn-q M p8)
         pt (if (> q8 0) (gn-sir M (+ q8 8) IF-A) 0)]
    (and (> q8 0) (not= jb f) (not= p8 f) (not= jb p8)
     (pj-fn? M f 33 (cin-pat) [f jb p8]) (pj-fn? M p8 11 (hf8-pat) [p8 pt]) (pj-fn? M pt 9 (pj-put-pat) [pt])
     (> (cin-tree M jb) 0))))))
(defn- cin-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (cin-admit M i)) M
  (let [jb (gn-sir M (+ (dec i) 17) IF-A) t (+ (gn-fnf M jb FF-SIR) 2) h (blt-high M t (cin-tree M jb))]
   (-> M (kemit-hex (cin-code-a)) (gn-emit (enc-cmp-i 2 (inc h))) (kemit-hex (cin-code-b))
       (gn-emit (enc-cmp-i 17 (inc h))) (kemit-hex (cin-code-c)) (gn-emit (enc-b (+ 1 (* 2 (inc h)))))
       (cin-data t 0 (inc h))))))

;; ---- slre set-loop: (f re r n s p info len result) walks a character set from len while len <= n, re[r + len] is
;; not ']' and no item matched yet: a range a-b (re[r+len+1] = '-', re[r+len+2] neither ']' nor the end) compares s[p]
;; with both ends (case folded through lower unless info[3] is set), any other item is op-len / match-op ('|' -4,
;; '$' -1, '.' 1, else s[p] equal, case folded by lower when info[3] & 1). Charges: 1 at entry and the loop's 1 per
;; item, at 1 each (the condition's, the range probes, the range's three, op-len's and match-op's), op-len and
;; match-op 1 each. Before the frame (result is the stack argument at [sp]): re and s resolved once (valid string
;; handles inside the pool), info a live vector of at least 4 items, s[p] read once (ASCII or the end); then per item
;; the bytes come from re in registers, the charge is checked with one kept for the entry, and an escape ('\'), a
