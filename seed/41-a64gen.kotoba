;; ---- qp (kernels B, step 2): sglib (partition v pivot i j stack start end) with the rest of the quicksort it leads to:
;; scan-left / scan-right, swaps, quick-next pushing the larger part on v[1300 + s] / v[1364 + s], quick-range and
;; quick-stack, all on v itself in the source's order (the pivot's value kept in a register while that cell is unchanged).
;; Charges: one per call or recur of each function and per scan step, 3 per swap, 1 per put. Non-leaf (slots in
;; callee-saved registers, fuel in memory, freg 0 or 2). Fast path when |v| >= 1428, pivot = start, 0 <= start < end <= 100,
;; start < i <= end, start <= j < end, stack <= 50 with its entries in [0, 100] (so every access stays in v[100 .. 199] and
;; v[1300 .. 1427]): the run goes on step by step while each partition state sees fuel >= 700 (enough for one iteration or
;; the way to the next partition); otherwise that state's slots go to the loop head. When quick-stack meets an empty stack,
;; v returns.
(defn- qp-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A) rv (gn-sreg M 1)]
  (if (not (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
                (= (gn-fnf M f FF-SIR) p) (< (+ p 160) (vector-at M MM-SIR-N)) (= (gn-fnf M f FF-PT0) TY-VEC)
                (= (gn-fnf M f FF-NPARAMS) 7) (= (gn-g M gn-f-leaf) 0) (or (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-freg) 2))
                (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
                (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2))
