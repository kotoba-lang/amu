;; Four-wide early stop: test whether x19..x22 are all leaves after each of
;; the first four walk-level groups. TBNZ reaches common commit validation.
;; Raw direct branches crossing these insertions are relocated with the added words.
;; ---- tw (kernels B, step 2; step 3 group commit): xgboost (trees v sample cls j tree nb lb), the class loop of tree
;; walks, four walks of one class at a time over the source planes: per walk (walk v sample nb lb 0) reads per level
;; feature, threshold, both children and x = v[31235 + 64 sample + feature], branch free for five levels (node 0 is never
;; a leaf; a walk on a leaf stays and counts no level). Then, when all four walks sit on leaves and every feature read is
;; in [0, 64), the group is committed: the charges (walk 1 + levels, put 1, recur 1 per tree) are paid, the four leaf
;; values are read and added in tree order into v[39555 + cls] (read once, written once), and j, tree, nb, lb advance;
;; at j = 40 one charge and the next class. Otherwise (a deeper walk, a feature outside [0, 64), sizes outside
;; [0, 1024), planes or leaves out of range, j not a multiple of 4 or fuel below 40) the group's state goes to the loop
;; head (where tbat and the original take over); nothing of the group has been written or charged then. Non-leaf
;; (slots x19 .. x28, saved around the block; fuel in memory, freg 0 or 2). |v| must hold the vote cells and the
;; sample's row.
(defn- tw-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A) rv (gn-sreg M 1) tr f]
  (if (not (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
                (= (gn-fnf M f FF-SIR) p) (< (+ p 87) (vector-at M MM-SIR-N)) (= (gn-fnf M f FF-PT0) TY-VEC)
                (= (gn-fnf M f FF-NPARAMS) 7) (= (gn-g M gn-f-leaf) 0) (or (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-freg) 2))
                (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
                (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2))
                (loop [k 1] (or (= k 8) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28) (recur (inc k))))))) M
   (let [wk (gn-sir M (+ p 43) IF-A) pt (gn-sir M (+ p 56) IF-A)]
    (if (not (and (> (mmx-q M wk) 0) (> (mmx-q M pt) 0)
