;; Generic closed packed-bit grid run-length scoring loop; each original debit retained.
(defn- rb-row [M :vector-i64 p :i64 f :i64 reader :i64 writer :i64 natural :i64 k :i64] :bool
 (case k
  0 (uc-row M (+ p 0) 1 f 7 11)
  1 (uc-row M (+ p 1) 18 0 0 0)
  2 (uc-row M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (uc-row M (+ p 3) 4 0 4 0)
  4 (uc-row M (+ p 4) 3 1 (gn-sir M (+ p 4) IF-B) 0)
  5 (uc-row M (+ p 5) 7 1 0 0)
  6 (uc-row M (+ p 6) 11 0 (gn-sir M (+ p 15) IF-A) 0)
  7 (uc-row M (+ p 7) 4 0 1 0)
  8 (uc-row M (+ p 8) 3 1 (gn-sir M (+ p 8) IF-B) 0)
  9 (uc-row M (+ p 9) 4 2 5 0)
  10 (uc-row M (+ p 10) 13 natural 0 3)
  11 (uc-row M (+ p 11) 3 1 (gn-sir M (+ p 11) IF-B) 0)
  12 (uc-row M (+ p 12) 4 2 7 0)
  13 (uc-row M (+ p 13) 13 natural 0 3)
  14 (uc-row M (+ p 14) 10 (gn-sir M (+ p 103) IF-A) 0 0)
  15 (uc-row M (+ p 15) 9 (gn-sir M (+ p 15) IF-A) 0 0)
  16 (uc-row M (+ p 16) 4 0 2 0)
  17 (uc-row M (+ p 17) 3 1 0 0)
  18 (uc-row M (+ p 18) 7 1 0 0)
  19 (uc-row M (+ p 19) 11 0 (gn-sir M (+ p 25) IF-A) 0)
  20 (uc-row M (+ p 20) 4 0 1 0)
  21 (uc-row M (+ p 21) 4 1 4 0)
  22 (uc-row M (+ p 22) 4 2 3 0)
  23 (uc-row M (+ p 23) 13 reader 0 3)
  24 (uc-row M (+ p 24) 10 (gn-sir M (+ p 30) IF-A) 0 0)
  25 (uc-row M (+ p 25) 9 (gn-sir M (+ p 25) IF-A) 0 0)
  26 (uc-row M (+ p 26) 4 0 1 0)
  27 (uc-row M (+ p 27) 4 1 3 0)
  28 (uc-row M (+ p 28) 4 2 4 0)
  29 (uc-row M (+ p 29) 13 reader 0 3)
  30 (uc-row M (+ p 30) 9 (gn-sir M (+ p 30) IF-A) 0 0)
  31 (uc-row M (+ p 31) 5 8 0 0)
  32 (uc-row M (+ p 32) 4 0 6 0)
  33 (uc-row M (+ p 33) 4 1 8 0)
  34 (uc-row M (+ p 34) 7 1 0 0)
  35 (uc-row M (+ p 35) 11 0 (gn-sir M (+ p 38) IF-A) 0)
  36 (uc-row M (+ p 36) 4 0 5 0)
  37 (uc-row M (+ p 37) 10 (gn-sir M (+ p 42) IF-A) 0 0)
  38 (uc-row M (+ p 38) 9 (gn-sir M (+ p 38) IF-A) 0 0)
  39 (uc-row M (+ p 39) 4 0 5 0)
  40 (uc-row M (+ p 40) 3 1 1 0)
  41 (uc-row M (+ p 41) 6 1 0 0)
  42 (uc-row M (+ p 42) 9 (gn-sir M (+ p 42) IF-A) 0 0)
  43 (uc-row M (+ p 43) 5 9 0 0)
  44 (uc-row M (+ p 44) 4 0 6 0)
  45 (uc-row M (+ p 45) 4 1 8 0)
  46 (uc-row M (+ p 46) 7 1 0 0)
  47 (uc-row M (+ p 47) 11 0 (gn-sir M (+ p 56) IF-A) 0)
  48 (uc-row M (+ p 48) 4 0 1 0)
  49 (uc-row M (+ p 49) 3 1 (gn-sir M (+ p 49) IF-B) 0)
  50 (uc-row M (+ p 50) 4 2 5 0)
  51 (uc-row M (+ p 51) 6 1 1 0)
  52 (uc-row M (+ p 52) 14 176 0 2)
  53 (uc-row M (+ p 53) 3 1 1 0)
  54 (uc-row M (+ p 54) 6 1 0 0)
  55 (uc-row M (+ p 55) 10 (gn-sir M (+ p 58) IF-A) 0 0)
  56 (uc-row M (+ p 56) 9 (gn-sir M (+ p 56) IF-A) 0 0)
  57 (uc-row M (+ p 57) 3 0 1 0)
  58 (uc-row M (+ p 58) 9 (gn-sir M (+ p 58) IF-A) 0 0)
  59 (uc-row M (+ p 59) 5 10 0 0)
  60 (uc-row M (+ p 60) 4 0 1 0)
  61 (uc-row M (+ p 61) 3 1 (gn-sir M (+ p 61) IF-B) 0)
  62 (uc-row M (+ p 62) 4 2 9 0)
  63 (uc-row M (+ p 63) 6 1 1 0)
  64 (uc-row M (+ p 64) 4 2 10 0)
  65 (uc-row M (+ p 65) 13 writer 0 3)
  66 (uc-row M (+ p 66) 5 11 0 0)
  67 (uc-row M (+ p 67) 4 0 11 0)
  68 (uc-row M (+ p 68) 4 1 2 0)
  69 (uc-row M (+ p 69) 4 2 3 0)
