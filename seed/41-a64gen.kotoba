     (if (and (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
      (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-RTYPE) TY-I64)
      (= (ck-pt M f 0) TY-I64) (= (ck-pt M f 1) TY-I64)
      (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (inc p))
      (>= base -4095) (<= base 4095) (> stride 0) (<= stride 4095)
