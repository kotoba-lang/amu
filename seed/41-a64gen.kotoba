;; ---- ns (kernels B): nsichneu (repeats s n) runs (run-full s) n times; (run-full s) = (full-1 (reset-counts s)),
;; each link full-k = (full-k+1 (t s consts)) or
;; the last (t s consts), t = t1 (P1 cells s[3 + i]) or t2 (P2 cells s[6 + i]); a transition fires (put-output, and
;; demark2 for t2) when its marking test holds. Charges: reset-counts 1, per link 2, a firing t1 1 more, a firing t2 2.
;; The chain is walked at compile time (every link certified, constants in range); the kernel keeps s[0 .. 10] in
;; x0 - x6, x8, x10 - x12 (x13 = s[2] + 3; the firing charges in the frame) and tests each transition by cmp / ccmp
;; into one branch (fail flags chosen so a failed test stays failed; t2's count test s[1] >= minimum and s[2] + 3 <= 6
;; is kept per minimum in x15 - x17, the equalities by eor / orr: three flag ops, which bound this loop); a firing goes
;; through a shared handler on a stack copy of
;; s[0 .. 16] (an output position outside s[0 .. 16] goes back to the original). Non-leaf (fuel in memory; the kernel
;; sits in repeats, as T2 inlines run-full). Fast path for s valid with |s| >= 17, one repetition at a time: when its
;; charges (3 + 2 links + firings) fit, s[0 .. 2] (or the copy after a firing) is written, the charges paid and the
;; count goes down; at 0, short fuel or a bad output position the loop head takes over (that repetition untouched).
(defn- ns-ccr [n :i64 m :i64 nzcv :i64 c :i64] :i64 (+ 0xFA400000 (i64-shift-left m 16) (i64-shift-left c 12) (i64-shift-left n 5) nzcv))
(defn- ns-cci [n :i64 imm :i64 nzcv :i64 c :i64] :i64 (+ 0xFA400800 (i64-shift-left imm 16) (i64-shift-left c 12) (i64-shift-left n 5) nzcv))
(defn- ns-reg [c :i64] :i64 (cond (<= c 6) c (= c 7) 8 :else (+ c 2)))
;; the link f at SIR p: 0 when not a link; 1 / 2 a t1 / t2 test, plus 4 when it continues to a next link
(defn- ns-kind [M :vector-i64 f :i64 t1f :i64 t2f :i64] :i64
 (let [p (mmx-q M f) n (if (= (gn-sir M (+ p 7) IF-A) t1f) 3 6) cp (+ p 4 n) nx (+ cp 1) last (= (gn-op M nx) OP-RET)
       e (if last (+ nx 1) (+ nx 2))]
  (if (and (> p 0) (< (+ p 14) (vector-at M MM-SIR-N)) (gn-dot-at? M p OP-FN f 1 1) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
           (= (gn-op M (+ p 2)) OP-LABEL) (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2)) (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
           (loop [k 1] (or (> k n) (and (= (gn-op M (+ p 3 k)) OP-CONST) (= (gn-sir M (+ p 3 k) IF-A) k) (recur (inc k)))))
           (gn-dot-at? M cp OP-CALL (if (= n 3) t1f t2f) 0 (inc n))
           (or last (and (= (gn-op M nx) OP-CALL) (= (gn-sir M nx IF-B) 0) (= (gn-sir M nx IF-C) 1)
                         (gn-dot-at? M (+ nx 1) OP-RET 0 0 0)))
           (gn-dot-at? M e OP-END f 0 0)
           (let [v1 (gn-sir M (+ p 4) IF-B) v2 (gn-sir M (+ p 5) IF-B) v3 (gn-sir M (+ p 6) IF-B) v4 (gn-sir M (+ p 7) IF-B)
                 v5 (gn-sir M (+ p 8) IF-B) v6 (gn-sir M (+ p 9) IF-B)]
            (if (= n 3) (and (>= v1 0) (<= v1 2) (>= v2 0) (<= v2 2) (>= v3 0) (<= v3 2))
             (and (>= v1 0) (<= v1 4) (>= v2 0) (<= v2 4) (>= v3 0) (<= v3 4) (>= v4 0) (<= v4 4)
                  (>= v5 0) (<= v5 4095) (>= v6 -1) (<= v6 4)))))
   (+ (if (= n 3) 1 2) (if last 0 4)) 0)))
;; s[0 .. 16] from base a to base b by x16 / x17 pairs
(defn- ns-copy [M :vector-i64 a :i64 b :i64 k :i64] :vector-i64
 (cond (= k 16) (-> M (gn-emit (enc-ldr 16 a 128)) (gn-emit (enc-str 16 b 128)))
       :else (ns-copy (-> M (gn-emit (enc-ldp 16 17 a (* 8 k))) (gn-emit (enc-stp 16 17 b (* 8 k)))) a b (+ k 2))))
;; the links from f: their count when the chain is whole (at most 200, ending in a last link), else 0
(defn- ns-chain [M :vector-i64 f :i64 t1f :i64 t2f :i64 k :i64] :i64
 (let [kind (ns-kind M f t1f t2f)]
  (cond (or (= kind 0) (>= k 200)) 0 (< kind 4) (inc k)
        :else (ns-chain M (gn-sir M (+ (mmx-q M f) (if (= (bit-and kind 3) 1) 8 11)) IF-A) t1f t2f (inc k)))))
;; the callee of the first six-constant link from f
(defn- ns-t2 [M :vector-i64 f :i64 k :i64] :i64
 (let [p (mmx-q M f)]
  (cond (or (= p 0) (>= k 200)) 0 (= (gn-op M (+ p 7)) OP-CONST) (gn-sir M (+ p 10) IF-A)
        :else (ns-t2 M (gn-sir M (+ p 8) IF-A) (inc k)))))
;; emit the tests of the links from f; P[2k] := the position of link k's branch, P[2k + 1] its packed constants
;; the t2 minimums: V[0] their count (at most 3, else -1), V[1 ..] the values; g register of a minimum: x15 + its place
(defn- ns-mins [M :vector-i64 f :i64 t1f :i64 V :vector-i64 k :i64 n :i64] :vector-i64
 (if (or (= k n) (< (vector-at V 0) 0)) V
  (let [p (mmx-q M f) one (= (gn-sir M (+ p 7) IF-A) t1f) m (gn-sir M (+ p 8) IF-B) c (vector-at V 0)
        known (or one (and (> c 0) (= (vector-at V 1) m)) (and (> c 1) (= (vector-at V 2) m)) (and (> c 2) (= (vector-at V 3) m)))
        W (cond known V (= c 3) (vector-assoc! V 0 -1) :else (-> V (vector-assoc! (inc c) m) (vector-assoc! 0 (inc c))))]
   (ns-mins M (gn-sir M (+ p (if one 8 11)) IF-A) t1f W (inc k) n))))
(defn- ns-greg [V :vector-i64 m :i64] :i64 (cond (= (vector-at V 1) m) 15 (= (vector-at V 2) m) 16 :else 17))
;; x15 + j := s[1] >= V[1 + j] and s[2] + 3 <= 6
(defn- ns-gs [M :vector-i64 V :vector-i64 j :i64] :vector-i64
 (if (>= j (vector-at V 0)) M
  (ns-gs (-> M (gn-emit (enc-cmp-i 1 (vector-at V (inc j)))) (gn-emit (ns-cci 13 6 0 10)) (gn-emit (enc-cset (+ 15 j) 13)))
   V (inc j))))
(defn- ns-tests [M :vector-i64 P :vector-i64 V :vector-i64 f :i64 t1f :i64 k :i64 n :i64] :vector-i64
 (if (= k n) M
  (let [p (mmx-q M f) one (= (gn-sir M (+ p 7) IF-A) t1f) v1 (gn-sir M (+ p 4) IF-B) v2 (gn-sir M (+ p 5) IF-B)
        v3 (gn-sir M (+ p 6) IF-B) v4 (gn-sir M (+ p 7) IF-B) v5 (gn-sir M (+ p 8) IF-B) v6 (gn-sir M (+ p 9) IF-B)
        m1 (if one
             (-> M (gn-emit (enc-cmp-i 0 3)) (gn-emit (ns-cci 13 6 0 10))
              (gn-emit (ns-ccr (ns-reg (+ 3 v2)) (ns-reg (+ 3 v3)) 0 13))
              (gn-emit (ns-ccr (ns-reg (+ 3 v1)) (ns-reg (+ 3 v2)) 0 0)))
             (-> M (gn-emit (enc-eor-r 9 (ns-reg (+ 6 v2)) (ns-reg (+ 6 v3))))
              (gn-emit (enc-eor-r 14 (ns-reg (+ 6 v2)) (ns-reg (+ 6 v4)))) (gn-emit (enc-orr-r 9 9 14))
              (gn-emit (enc-cmp-r (ns-reg (+ 6 v2)) (ns-reg (+ 6 v1)))) (gn-emit (ns-cci 9 0 0 12))
              (gn-emit (ns-cci (ns-greg V v5) 0 4 0))))
        at (vector-at m1 MM-CODE-N)
        q (-> P (vector-assoc! (* 2 k) at)
              (vector-assoc! (inc (* 2 k)) (if one (+ (i64-shift-left v1 4) (i64-shift-left v2 8))
                                               (+ 1 (i64-shift-left v1 4) (i64-shift-left v2 8) (i64-shift-left (inc v6) 12)))))]
   (ns-tests (gn-emit m1 (enc-bcond (if one 11 1) 0)) q V (gn-sir M (+ p (if one 8 11)) IF-A) t1f (inc k) n))))
;; the stubs: each branch k goes to mov x9, #constants ; bl handler (P[2k + 1] := its place) ; b to the test after it
(defn- ns-stubs [M :vector-i64 P :vector-i64 k :i64 n :i64] :vector-i64
 (if (= k n) M
  (let [at (vector-at P (* 2 k)) here (vector-at M MM-CODE-N) w (vector-at M (+ MM-CODE-BASE at))
        m1 (-> M (gn-put (+ MM-CODE-BASE at) (enc-bcond (bit-and w 15) (- here at))) (gn-mov-imm 9 (vector-at P (inc (* 2 k)))))
        bl (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit 0x94000000) (gn-emit (enc-b (- (inc at) (inc bl)))))]
   (ns-stubs m2 (vector-assoc! P (inc (* 2 k)) bl) (inc k) n))))
(defn- ns-bls [M :vector-i64 P :vector-i64 h :i64 k :i64 n :i64] :vector-i64
 (if (= k n) M
  (let [at (vector-at P (inc (* 2 k)))] (ns-bls (gn-put M (+ MM-CODE-BASE at) (enc-bl (- h at))) P h (inc k) n))))
(defn- ns-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A) rf (gn-sir M (+ p 11) IF-A) q (mmx-q M rf) rc (gn-sir M (+ q 4) IF-A)
       f1 (gn-sir M (+ q 5) IF-A) rs (gn-sreg M 1) rr (gn-sreg M 2)]
  (if (not (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
                (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
                (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
                (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2)) (>= rs 19) (<= rs 28) (>= rr 19) (<= rr 28) (> q 0)
                (kpat-match M p [562962837667841 18 4229300233 8589934596 65539 65543 277141354709003 4294967300 4228186122 4228841481 4294967300 281479270957069 8590000132 4295098371 4295098374 65541 4295098373 18 4229300234 4228186121 19 4294311938] [f rf]) (kpat-match M q [281483565989889 18 4229300233 4294967300 281479270957069 281479270891533 19 4294311938] [rf rc f1]))) M
   (let [q1 (mmx-q M f1) t1f (gn-sir M (+ q1 7) IF-A) t2f (ns-t2 M f1 0) qt1 (mmx-q M t1f) qt2 (mmx-q M t2f)
         po (gn-sir M (+ qt1 63) IF-A) dm (gn-sir M (+ qt2 62) IF-A)
         n (if (and (> q1 0) (> qt1 0) (> qt2 0) (not= t1f t2f) (kpat-match M (mmx-q M rc) [844433519411201 18 4229300233 4294967300 65539 12885032963 844424943763470 131077 8589934596 4295032835 21474967555 844424943763470 196613 12884901892 8590000131 131075 844424943763470 19 4294311938] [rc])
                    (kpat-match M qt1 [2251821287866369 18 4229300233 4294967300 65539 562949964955662 12884967427 327687 277059750330379 4294967300 8590000131 562949964955662 12884967427 65542 25769869315 262151 277059750330379 4294967300 12884967427 12885032964 4295032838 562949964955662 4295032836 12885032963 17180065796 8590000134 562954259922958 65543 4227596297 276883656671243 4294967300 12884967427 8590065668 4295032838 562949964955662 327685 4294967300 12884967427 12885032964 4295032838 562949964955662 393221 21474836484 25769869316 131079 276900836540427 4294967300 65539 562949964955662 458757 4294967300 65539 30064902148 12885098499 8590065670 844424943763470 524293 34359738372 21474902020 25769934852 21475033092 25770065924 12885032966 1125904201089037 4225040394 4225171465 4294967300 4225040393 4224778250 4224909321 4294967300 4224778249 19 4294311938] [t1f po]) (kpat-match M qt2 [2533309149478913 18 4229300233 4294967300 4295032835 562949964955662 25769869316 327687 277008210722827 4294967300 8590000131 562949964955662 12884967427 65542 25769869315 262151 277008210722827 4294967300 25769869315 12885032964 4295032838 562949964955662 4295032836 25769934851 17180065796 8590000134 562954259922958 65543 277008210722827 4294967300 25769869315 12885032964 4295032838 562949964955662 4295032836 25769934851 21475033092 8590000134 562954259922958 65543 4226809865 276887951638539 4294967300 25769869315 8590065668 4295032838 562949964955662 524293 4294967300 25769869315 12885032964 4295032838 562949964955662 589829 38654705668 34359803908 196615 276905131507723 4294967300 34359803908 38654836740 30064967684 1125904201089037 4225105930 4225237001 4294967300 4225105929 4224843786 4224974857 4294967300 4224843785 19 4294311938] [t2f dm])
                    (kpat-match M (mmx-q M dm) [2251821287866369 18 4229300233 4294967300 4295032835 562949964955662 327685 17179869188 65539 131079 277076930199563 4294967300 4295032835 21474967556 17180065795 8590065670 844424943763470 8590000132 12885032964 8590131204 12885164036 12884967430 1125904201089037 4226154506 4227858441 4294967300 25769869315 17180000260 4295032838 562949964955662 393221 4294967300 25769869315 25769934852 844424943763470 458757 30064771076 4295032835 21474967556 17180065795 8590065670 844424943763470 524293 34359738372 8590000132 12885032964 8590131204 12885164036 12884967430 1125904201089037 4226154505 19 4294311938] [dm po]) (kpat-match M (mmx-q M po) [2251821287866369 18 4229300233 4294967300 8590000131 562949964955662 327685 4294967300 47244705795 21474967556 4295032838 8590065668 844424943763470 393221 25769803780 51539673091 21474967556 4295032838 12885032964 844424943763470 458757 30064771076 55834640387 21474967556 4295032838 17180000260 844424943763470 524293 34359738372 8590000131 21474967556 12885098499 8590000134 844424943763470 19 4294311938] [po]))
             (ns-chain M f1 t1f t2f 0) 0)
         V (if (> n 0) (ns-mins M f1 t1f (vector-alloc 4) 0 n) (vector-assoc! (vector-alloc 4) 0 -1))
         head (gn-sir M (+ p 2) IF-A)]
    (if (or (= n 0) (< (vector-at V 0) 0)) M
     (let [G (vector-alloc 13) P (vector-alloc 401)
           m0 (-> M (kb-vec G rs 10 11) (gn-emit (enc-cmp-i 10 17)) (ri-cold G (enc-cond-lo))
                (gn-emit (enc-sub-i 31 31 160)) (gn-emit (enc-str 11 31 136)))
           top (vector-at m0 MM-CODE-N)
           ;; one repetition: remaining = 0 leaves; s[3 .. 10] (s[0 .. 2], s[11] too: a run of loads T2 reads as a kernel) into registers,
           ;; then reset-counts' 3 5 0
           m1 (-> m0 (gn-emit (enc-cmp-i rr 0)) (gn-emit (enc-bcond (enc-cond-eq) 0))
                (gn-emit (enc-ldr 15 31 136)) (gn-emit (enc-ldr 0 15 0)) (gn-emit (enc-ldr 1 15 8)) (gn-emit (enc-ldr 2 15 16))
                (gn-emit (enc-ldr 3 15 24)) (gn-emit (enc-ldr 4 15 32)) (gn-emit (enc-ldr 5 15 40)) (gn-emit (enc-ldr 6 15 48))
                (gn-emit (enc-ldr 8 15 56)) (gn-emit (enc-ldr 10 15 64)) (gn-emit (enc-ldr 11 15 72)) (gn-emit (enc-ldr 12 15 80))
                (gn-emit (enc-ldr 9 15 88)) (gn-mov-imm 0 3) (gn-mov-imm 1 5) (gn-mov-imm 2 0) (gn-mov-imm 13 3)
                (gn-emit (enc-str 31 31 144)) (ns-gs V 0))
           m2 (ns-tests m1 P V f1 t1f 0 n)
           ;; the repetition's charges (run-full, reset-counts, the links, firings, the recur) when they fit; then
           ;; s[0 .. 2] (no firing: nothing else changed) or the whole copy
           m3 (-> m2 (gn-emit (enc-ldr 14 31 144)) (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-mov-imm 17 (+ 3 (* 2 n)))
                (gn-emit (enc-add-r 17 17 14))
                (gn-emit (enc-cmp-r 16 17)) (gn-emit (enc-bcond (enc-cond-lo) 0)))
           low (dec (vector-at m3 MM-CODE-N))
           m4 (-> m3 (gn-emit (enc-sub-r 16 16 17)) (gn-emit (enc-str 16 7 CTX-FUEL)) (gn-emit (enc-ldr 15 31 136))
                (gn-emit (enc-cbnz 14 4)) (gn-emit (enc-stp 0 1 15 0)) (gn-emit (enc-str 2 15 16)))
           skip (vector-at m4 MM-CODE-N)
           m5 (-> m4 (gn-emit (enc-b 0)) (gn-emit (enc-stp 0 1 31 0)) (gn-emit (enc-stp 2 3 31 16)) (gn-emit (enc-stp 4 5 31 32))
                (gn-emit (enc-stp 6 8 31 48)) (gn-emit (enc-stp 10 11 31 64)) (gn-emit (enc-str 12 31 80)) (ns-copy 31 15 0))
           next (vector-at m5 MM-CODE-N)
           m6 (-> m5 (gn-put (+ MM-CODE-BASE skip) (enc-b (- next skip))) (gn-emit (enc-sub-i rr rr 1))
                (gn-emit (enc-b (- top (inc next)))))
           exit (vector-at m6 MM-CODE-N)
           m7 (-> m6 (gn-put (+ MM-CODE-BASE (inc top)) (enc-bcond (enc-cond-eq) (- exit (inc top))))
                (gn-put (+ MM-CODE-BASE low) (enc-bcond (enc-cond-lo) (- exit low)))
                (gn-emit (enc-add-i 31 31 160)) (gn-fix FX-B26 head) (gn-emit (enc-b 0)) (kb-keep))
           m8 (ns-stubs m7 P 0 n) h (vector-at m8 MM-CODE-N)
           m9 (-> m8 (kb-words G [0xF9404BEE 0xB500010E 0xF94047EF 0xA945C5F0 0xA905C7F0 0xA946C5F0 0xA906C7F0 0xA947C5F0 0xA907C7F0 0xA90007E0 0xA9010FE2 0xA90217E4 0xF9001BE6 0xF9001FE8 0xF90023EA 0xF90027EB 0xF9002BEC 0x92400D2F 0xD3441D30 0xD3482D31 0xB500016F 0x91000E10 0xF8707BF0 0x91000E31 0xF8717BF1 0xF94003EF 0xD1000DEF 0xF90003EF 0x910005CE 0xCB11020F 0x1400000F 0x91001A10 0xF8707BF0 0x91001A31 0xF8717BF1 0xD34C3D2F 0xB400008F 0x910015EF 0xF86F7BEF 0xF9001BEF 0xF94007EF 0xD10011EF 0xF90007EF 0x910009CE 0x8B11020F 0xF9400BE9 0x91002D2A 0xF100395F 0x54000248 0x8B2A6FEB 0xF9000170 0xF9000571 0xF900096F 0x91000D29 0xF9000BE9 0xA94007E0 0xA9410FE2 0xA94217E4 0xF9401BE6 0xF9401FE8 0xF94023EA 0xF94027EB 0xF9402BEC 0x91000C4D 0xF9004BEE 0x14000000]) (gn-emit (enc-add-i 31 31 160)) (gn-fix FX-B26 head) (gn-emit (enc-b 0)))
           gt (vector-at m9 MM-CODE-N)
           m10 (-> m9 (gn-put (+ MM-CODE-BASE (+ h 65)) (enc-b (- gt (+ h 65)))) (ns-gs V 0) (gn-emit (enc-ret))
                 (ns-bls P h 0 n))]
      (ri-patch m10 G 0 (vector-at m10 MM-CODE-N))))))))
;; ---- ek / ik (kernels B): nettle-aes key schedule. (expand-keys s base i) for i .. 59: t = s[base + i - 1], s[base + i] :=
;; s[base + i - 8] xor (i rem 8 = 0: subword (rot t 24) xor rcon[i / 8 - 1]; = 4: subword t; else t) with subword the
;; enc-sbox of each byte (or4 of shifted values) and rot exact on 64 bits; charges per i: 1, + 11 (rot, subword, rcon)
;; or + 9 (subword). (invert-keys s i) for i .. 55: s[60 + i] := (mix s[60 + i]) (mt of each byte, three rots, xor4);
;; 9 charges per i. Non-leaf (slots in callee-saved registers, fuel in memory). Fast paths when the vector covers the
;; words, 8 <= i <= 60 (0 <= i <= 56) and fuel covers the most the run can charge: the loops in registers, the exact
;; charges paid, i := 60 (56) and the loop head returns s. Every SIR and the tables (two-half s-box and mt, rcon's one
;; table of at least 7 words) are certified.
(defn- ek-rcon [M :vector-i64 rc :i64] :i64
 (let [q (mmx-q M rc) lit (gn-sir M (+ q 4) IF-B) n (gn-sir M (+ q 4) IF-C)]
  (if (and (> q 0) (gn-dot-at? M q OP-FN rc 1 1) (gn-dot-at? M (+ q 1) OP-FUEL 0 0 0) (= (gn-op M (+ q 2)) OP-LABEL)
           (gn-dot-at? M (+ q 3) OP-LGET 0 1 0) (gn-dot-at? M (+ q 4) OP-TAB 0 lit n) (>= n 7) (tb-lit M lit n)
           (gn-dot-at? M (+ q 5) OP-RET 0 0 0) (gn-dot-at? M (+ q 6) OP-END rc 0 0)) lit 0)))
(defn- ek-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A) rs (gn-sreg M 1) rb (gn-sreg M 2) ri (gn-sreg M 3)
       ok (fn [r] (and (>= r 19) (<= r 28)))]
  (if (not (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
                (= (gn-fnf M f FF-SIR) p) (< (+ p 83) (vector-at M MM-SIR-N)) (= (gn-fnf M f FF-PT0) TY-VEC)
                (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-ctx) 1) (= (gn-g M gn-f-h) 0)
                (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2))
                (ok rs) (ok rb) (ok ri))) M
   (let [rm (gn-sir M (+ p 20) IF-A) rt (gn-sir M (+ p 29) IF-A) sw (gn-sir M (+ p 30) IF-A) rc (gn-sir M (+ p 36) IF-A)
         u3 (gn-sir M (+ (mmx-q M rt) 12) IF-A) ba (gn-sir M (+ (mmx-q M sw) 6) IF-A) bx (gn-sir M (+ (mmx-q M sw) 7) IF-A)
         o4 (gn-sir M (+ (mmx-q M sw) 29) IF-A) es (gn-sir M (+ (mmx-q M bx) 8) IF-A) ds (gn-sir M (+ (mmx-q M bx) 12) IF-A)
         lsb (tb-shape M es) lrc (ek-rcon M rc)]
    (if (not (and (> (mmx-q M rt) 0) (> (mmx-q M sw) 0) (> (mmx-q M bx) 0) (> (mmx-q M u3) 0) (> (mmx-q M ba) 0)
                  (> (mmx-q M o4) 0) (> lsb 0) (> lrc 0) (kb-rem? M rm)
