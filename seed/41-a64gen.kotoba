    120 (gn-dot-at? M (+ p 120) 6 1 6 0)
    121 (gn-dot-at? M (+ p 121) 4 7 12 0)
    122 (gn-dot-at? M (+ p 122) 11 7 (gn-sir M (+ p 125) IF-A) 0)
    123 (gn-dot-at? M (+ p 123) 3 7 1 0)
    124 (gn-dot-at? M (+ p 124) 10 (gn-sir M (+ p 127) IF-A) 0 0)
    125 (and (ac-label M p 125) (gn-dot-at? M (+ p 125) 9 (gn-sir M (+ p 125) IF-A) 0 0))
    126 (gn-dot-at? M (+ p 126) 3 7 0 0)
    127 (and (ac-label M p 127) (gn-dot-at? M (+ p 127) 9 (gn-sir M (+ p 127) IF-A) 0 0))
    128 (gn-dot-at? M (+ p 128) 5 1 0 0)
    129 (gn-dot-at? M (+ p 129) 5 2 1 0)
    130 (gn-dot-at? M (+ p 130) 5 3 2 0)
    131 (gn-dot-at? M (+ p 131) 5 4 3 0)
    132 (gn-dot-at? M (+ p 132) 5 5 4 0)
    133 (gn-dot-at? M (+ p 133) 5 6 5 0)
    134 (gn-dot-at? M (+ p 134) 5 7 6 0)
    135 (gn-dot-at? M (+ p 135) 5 8 7 0)
    136 (gn-dot-at? M (+ p 136) 18 0 0 0)
    137 (gn-dot-at? M (+ p 137) 10 (gn-sir M (+ p 2) IF-A) 0 0)
    138 (gn-dot-at? M (+ p 138) 10 (gn-sir M (+ p 171) IF-A) 0 0)
    139 (and (ac-label M p 139) (gn-dot-at? M (+ p 139) 9 (gn-sir M (+ p 139) IF-A) 0 0))
    140 (gn-dot-at? M (+ p 140) 4 0 1 0)
    141 (gn-dot-at? M (+ p 141) 4 1 2 0)
    142 (gn-dot-at? M (+ p 142) 4 2 3 0)
    143 (gn-dot-at? M (+ p 143) 4 3 4 0)
