(defn- blp-code-b [] :string "~q*505(]XO-d/h/bW;q;DOT5L^W<!CcW<*anW<4+$W<=U3W<Fs?WBq9Yq*61fWC6pSb6J$/lOX)(;ud%0[/Zs.d/X=UM['5lM[BIRb7FZ,q*5n\\dXV<%QiI)dq#E5/\\+g!^WBgpNWBq9YWC%WdWC/,sM[9C1M\\#k3b7FY?MZ<bHM\\#kub7FZ,QiI\"\"WW3.jq*6ao[eKk7q*6IqOT5PWq*6b%W<Fs?[/ZhUd/X=U(]XNjWBbh/OTEB\"emANp")
(defn- blp-fn? [M :vector-i64 g :i64] :bool (and (> g 0) (< g (vector-at M MM-FN-N))))
;; pj-fn? for a function compiled after this one (its labels are not entered yet): the packed pattern, then each LABEL
;; of the n ops defined there only and branched to from inside them only (blt-label scans the whole SIR)
(defn- blp-sir? [M :vector-i64 g :i64 n :i64 S :string T :vector-i64] :bool
 (and (blp-fn? M g) (not (gn-clamp-open M g))
  (let [q (gn-fnf M g FF-SIR)]
   (and (> q 0) (<= (+ q n) (vector-at M MM-SIR-N)) (= (kpat-n S) n) (kpat-smatch M q S T)
    (loop [k 0] (or (= k n) (and (or (not= (gn-op M (+ q k)) OP-LABEL)
                                     (blt-label M (gn-sir M (+ q k) IF-A) q (+ q n) (+ q k)))
                                 (recur (inc k)))))))))
(defn- blp-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 509) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (blp-fn? M f)
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 10) (= (gn-fnf M f FF-RTYPE) TY-I64)
   (= (gn-fnf M f FF-PT0) TY-STR) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
   (= (gn-fnf M f (+ FF-PT0 3)) TY-STR) (= (gn-fnf M f FF-PT4) TY-I64)
   (let [at (gn-sir M (+ p 16) IF-A) gol (gn-sir M (+ p 40) IF-A) qt (gn-sir M (+ p 47) IF-A) br (gn-sir M (+ p 27) IF-A)
         bar (gn-sir M (+ p 98) IF-A) pl (gn-sir M (+ p 183) IF-A) ms (gn-sir M (+ p 207) IF-A) dh (gn-sir M (+ p 281) IF-A)
         bs (gn-sir M (+ p 297) IF-A) cp (gn-sir M (+ p 318) IF-A) pt (gn-sir M (+ p 322) IF-A) mo (gn-sir M (+ p 459) IF-A)
         gq (kfn-q M gol) sln (if (> gq 0) (gn-sir M (+ gq 17) IF-A) 0) ol (if (> gq 0) (gn-sir M (+ gq 24) IF-A) 0)
         qq (kfn-q M qt) at2 (if (> qq 0) (gn-sir M (+ qq 5) IF-A) 0)
         mq (kfn-q M ms) sq (if (> mq 0) (kfn-q M (gn-sir M (+ mq 33) IF-A)) 0)
         lq (kfn-q M pl) pe (if (> lq 0) (gn-sir M (+ lq 64) IF-A) 0)
         dq (kfn-q M dh) bn (if (> dq 0) (gn-sir M (+ dq 35) IF-A) 0)]
    (and (> gq 0) (> qq 0) (> mq 0) (> sq 0) (> lq 0) (> dq 0) (blp-fn? M pe) (blp-fn? M bn)
     (not= at f) (not= gol f) (not= qt f) (not= br f) (not= ms f) (not= cp f) (not= pt f) (not= mo f)
     (not= bar f) (not= pl f) (not= dh f) (not= bs f) (not= pe f) (not= bn f)
     (pj-fn? M f 509 (blp-pat) [f at gol qt br bar pl ms dh bs cp pt mo -1 -2 -4 -5])
     (blp-sir? M bar 16 (blr-pat) [bar f]) (blp-sir? M pl 182 (blpl-pat) [pl bar at pe])
     (blp-sir? M pe 88 (blpe-pat) [pe at bar -1]) (blp-sir? M dh 122 (bld-pat) [dh br bn bar -1])
     (blp-sir? M bs 97 (blbs-pat) [bs dh bar]) (blp-sir? M bn 11 (blbn-pat) [bn])
     (pj-fn? M gol 28 (blg-pat) [gol at sln ol]) (pj-fn? M sln 49 (sln-pat) [sln at ol -1])
     (pj-fn? M ol 28 (slo-pat) [ol at]) (pj-fn? M at 17 (sla-pat) [at])
     (pj-fn? M qt 23 (blq-pat) [qt at2 at])
     ;; quant's first at may be the prelude's replaceable import (clamp-open, its label not entered): its SIR is
     ;; what is relied on, as for wikisort's rem
     (blp-fn? M at2) (> (gn-fnf M at2 FF-SIR) 0) (kpat-smatch M (gn-fnf M at2 FF-SIR) (sla-pat) [at2])
     (pj-fn? M br 11 (blb-pat) [br]) (pj-fn? M cp 11 (blc-pat) [cp]) (pj-fn? M pt 9 (pj-put-pat) [pt])
     (pj-fn? M ms 58 (blm-pat) [ms at (gn-sir M (+ mq 33) IF-A) -1])
     (slp-admit M (inc sq)) (= mo (gn-sir M (+ sq 160) IF-A)))))))
(defn- blp-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (blp-admit M i)) M
  (-> M (kemit-hex (blp-code-a)) (gn-fix FX-BL26 (gn-sir M (+ (dec i) 281) IF-A)) (gn-emit (enc-bl 0))
      (kemit-hex (blp-code-b)))))

;; ---- wikisort merge-loop: (f v a alast b blast dst) merges pairs (value at 2i, index at 2i + 1) taking a while
;; v[2b] >= v[2a], until a = alast or b = blast, then copy-forward of the alast - a pairs left at a; item copies a pair
;; (both reads before both writes). Before the frame, both pairs read per step; SIRs of merge-loop, copy-forward,
;; item, value and put are packed patterns.
(defn- wml-pat [] :string "")
(defn- wcf-pat [] :string "")
(defn- wit-pat [] :string "")
(defn- wva-pat [] :string "0001fff60002000200120000000000000009fc16000000000004000000010000000400010002000000030002000200000006000300010000000e00b00000000200130000000000000002fff600000000")
(defn- wput-pat [] :string "0001fff60003000300120000000000000009fc1600000000000400000001000000040001000200000004000200030000000e00d00000000300130000000000000002fff600000000")
(defn- wml-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 77) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (let [cf (gn-sir M (+ p 19) IF-A) va (gn-sir M (+ p 24) IF-A) it (gn-sir M (+ p 33) IF-A)
         put (gn-sir M (+ (kfn-q M it) 20) IF-A)]
    (and (pj-fn? M f 78 (wml-pat) [f cf va it]) (pj-fn? M cf 34 (wcf-pat) [cf it]) (pj-fn? M it 30 (wit-pat) [it va put])
         (pj-fn? M va 10 (wva-pat) [va]) (pj-fn? M put 9 (wput-pat) [put]))))))
;; before the frame: x0 = v (kept), x1 a, x2 alast, x3 b, x4 blast, x5 dst. Guards: a <= alast, b <= blast (unsigned),
;; v live, 2 alast, 2 blast and 2 (dst + alast - a + blast - b) within its length, no store over a pair held in
;; registers (dst against a and b, below), fuel >= 2 + 7 (na + nb) + 5 na (the
;; entry, 7 per merge step: two values, item, the self call; copy-forward 1 + 5 per pair). Pointers walk the pairs;
;; per step two ldp, cmp, one pair stored; the exact cost 2 + 7 steps + 5 n published at the end.
(defn- wml-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (wml-admit M i)) M
  (let [G (vector-alloc 25)
        m0 (-> M (gn-emit (enc-cmp-r 1 2)) (ri-cold G 8) (gn-emit (enc-cmp-r 3 4)) (ri-cold G 8)
             (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))
             (ri-cold G (enc-cond-hs)) (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 6 16 0))
             (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 6 16)) (ri-cold G (enc-cond-hs))
             (gn-emit (gn-e-lsr 16 6 1)) (gn-emit (enc-cmp-r 2 16)) (ri-cold G 8) (gn-emit (enc-cmp-r 4 16)) (ri-cold G 8)
             (gn-emit (enc-sub-r 9 2 1)) (gn-emit (enc-sub-r 10 4 3)) (gn-emit (enc-add-r 11 9 10))
             ;; no store over a cached pair: step k stores at dst + k; side T at T0 + j (k - j steps of the other side O
             ;; done, k - j < n_O) is hit iff dst - T0 + k - j = 0, so per side dst - T0 >= 1 or dst - T0 + n_O <= 0 (signed)
             (gn-emit (enc-sub-r 13 5 1)) (gn-emit (enc-cmp-i 13 1)) (gn-emit (enc-bcond (enc-cond-ge) 4))
             (gn-emit (enc-add-r 14 13 10)) (gn-emit (enc-cmp-i 14 0)) (ri-cold G (enc-cond-gt))
             (gn-emit (enc-sub-r 13 5 3)) (gn-emit (enc-cmp-i 13 1)) (gn-emit (enc-bcond (enc-cond-ge) 4))
             (gn-emit (enc-add-r 14 13 9)) (gn-emit (enc-cmp-i 14 0)) (ri-cold G (enc-cond-gt))
             (gn-emit (enc-cmp-r 5 16)) (ri-cold G 8) (gn-emit (enc-add-r 12 5 11)) (gn-emit (enc-cmp-r 12 16)) (ri-cold G 8)
             (gn-mov-imm 12 7) (gn-emit (enc-mul 12 11 12)) (gn-mov-imm 13 5) (gn-emit (enc-madd 12 9 13 12))
             (gn-emit (enc-add-i 12 12 2)) (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 12)) (ri-cold G (enc-cond-lo))
             ;; every guard passed: pair pointers
             (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 16 16 17 3)) (gn-emit (gn-e-addsl 1 16 1 4))
             (gn-emit (gn-e-addsl 2 16 2 4)) (gn-emit (gn-e-addsl 3 16 3 4)) (gn-emit (gn-e-addsl 4 16 4 4))
             (gn-emit (gn-e-addsl 5 16 5 4)) (gn-mov 9 1) (gn-mov 10 3)) l (vector-at m0 MM-CODE-N)
        ;; L: cmp pa, pal; ccmp pb, pbl, #4 (Z), ne; b.eq X; both pairs read once; b.lt to the b run
        m1 (-> m0 (gn-emit (enc-cmp-r 1 2)) (gn-emit (+ 0xFA441064 (* 0 1))) (gn-emit 0)) bx (dec (vector-at m1 MM-CODE-N))
        m2 (-> m1 (gn-emit (enc-ldp 11 13 1 0)) (gn-emit (enc-ldp 12 14 3 0)) (gn-emit (enc-cmp-r 12 11)) (gn-emit 0))
        b0 (dec (vector-at m2 MM-CODE-N)) al (vector-at m2 MM-CODE-N) bl (+ al 8)
        ;; a run: store pair a, advance; a = alast ends; next a read; b >= a stays (the source's compare, one taken branch
        ;; per pair); b run alike; a pair is read once (the other one stays in registers)
        m2c (-> m2 (gn-emit (enc-stp 11 13 5 0)) (gn-emit (enc-add-i 5 5 16)) (gn-emit (enc-add-i 1 1 16))
              (gn-emit (enc-cmp-r 1 2)) (gn-emit 0) (gn-emit (enc-ldp 11 13 1 0)) (gn-emit (enc-cmp-r 12 11))
              (gn-emit (enc-bcond (enc-cond-ge) -7))
              (gn-emit (enc-stp 12 14 5 0)) (gn-emit (enc-add-i 5 5 16)) (gn-emit (enc-add-i 3 3 16))
              (gn-emit (enc-cmp-r 3 4)) (gn-emit 0) (gn-emit (enc-ldp 12 14 3 0)) (gn-emit (enc-cmp-r 12 11))
              (gn-emit (enc-bcond (enc-cond-lt) -7)) (gn-emit (enc-b (- al (+ bl 8)))))
        m3 (-> m2c (gn-put (+ MM-CODE-BASE b0) (enc-bcond (enc-cond-lt) (- bl b0)))
              (gn-put (+ MM-CODE-BASE (+ al 4)) (enc-bcond (enc-cond-eq) (- (+ bl 9) (+ al 4))))
              (gn-put (+ MM-CODE-BASE (+ bl 4)) (enc-bcond (enc-cond-eq) (- (+ bl 9) (+ bl 4))))) x (vector-at m3 MM-CODE-N)
        ;; X: steps, n, the cost; then the copy-forward loop C
        m4 (-> m3 (gn-put (+ MM-CODE-BASE bx) (enc-bcond (enc-cond-eq) (- x bx)))
             (gn-emit (enc-sub-r 13 1 9)) (gn-emit (enc-sub-r 14 3 10)) (gn-emit (enc-add-r 13 13 14)) (gn-emit (gn-e-lsr 13 13 4))
             (gn-emit (enc-sub-r 14 2 1)) (gn-emit (gn-e-lsr 14 14 4)) (gn-mov-imm 15 7) (gn-emit (enc-mul 16 13 15))
             (gn-mov-imm 15 5) (gn-emit (enc-madd 16 14 15 16)) (gn-emit (enc-add-i 16 16 2)) (gn-emit (enc-sub-r 8 8 16))
             (gn-emit (enc-str 8 7 CTX-FUEL))) c (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (enc-cmp-r 1 2)) (gn-emit 0) (gn-emit (enc-ldp 11 12 1 0)) (gn-emit (enc-stp 11 12 5 0))
             (gn-emit (enc-add-i 1 1 16)) (gn-emit (enc-add-i 5 5 16))) cb (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-b (- c cb)))) r (vector-at m6 MM-CODE-N)
        m7 (-> m6 (gn-put (+ MM-CODE-BASE (inc c)) (enc-bcond (enc-cond-eq) (- r (inc c)))) (gn-emit (enc-ret)) (gn-emit 0xD5032FFF))
        cold (vector-at m7 MM-CODE-N)]
   (ri-patch m7 G 0 cold))))

;; ---- wikisort insertion: (f v start end i) runs i .. end - 1 of insertion-inner (shift pairs up while j > start
;; and x < v[2 (j - 1)], then the pair x, index at j), one frameless loop; SIRs of both, value, item and put checked.
(defn- wins-pat [] :string "")
(defn- wii-pat [] :string "")
(defn- wins-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A) va (gn-sir M (+ p 12) IF-A) ii (gn-sir M (+ p 27) IF-A) q (kfn-q M ii)
       it (gn-sir M (+ q 21) IF-A) put (gn-sir M (+ q 42) IF-A)]
  (and (> p 0) (< (+ p 41) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (pj-fn? M f 42 (wins-pat) [f va ii]) (pj-fn? M ii 53 (wii-pat) [ii va it put]) (pj-fn? M it 30 (wit-pat) [it va put])
   (pj-fn? M va 10 (wva-pat) [va]) (pj-fn? M put 9 (wput-pat) [put]))))
;; before the frame: x0 = v (kept), x1 start, x2 end, x3 i. Guards: start <= i <= end, start >= 0, 2 end within v,
;; fuel >= 1 + 6n + 3n (i + end - 1 - 2 start) (n = end - i; per step 5 + 6 per move + 1 when the compare stops it).
;; x4 walks the pairs i, x5 the pair j, x6 = &pair start; the private fuel published at ret.
(defn- wins-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (wins-admit M i)) M
  (let [G (vector-alloc 15)
        m0 (-> M (gn-emit (enc-cmp-r 1 3)) (ri-cold G (enc-cond-gt)) (gn-emit (enc-cmp-r 3 2)) (ri-cold G 8)
             (gn-emit (enc-cmp-i 1 0)) (ri-cold G (enc-cond-lt))
             (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))
             (ri-cold G (enc-cond-hs)) (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 6 16 0))
             (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 6 16)) (ri-cold G (enc-cond-hs))
             (gn-emit (gn-e-lsr 16 6 1)) (gn-emit (enc-cmp-r 2 16)) (ri-cold G 8)
             (gn-emit (enc-sub-r 9 2 3)) (gn-emit (enc-add-r 10 3 2)) (gn-emit (enc-sub-i 10 10 1))
             (gn-emit (enc-sub-r 10 10 1)) (gn-emit (enc-sub-r 10 10 1)) (gn-emit (enc-mul 10 9 10))
             (gn-emit (gn-e-addsl 10 10 10 1)) (gn-mov-imm 11 6) (gn-emit (enc-madd 10 9 11 10)) (gn-emit (enc-add-i 10 10 1))
             (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 10)) (ri-cold G (enc-cond-lo))
             ;; every guard passed; an empty range returns at once
             (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 16 16 17 3))
             (gn-emit (gn-e-addsl 4 16 3 4)) (gn-emit (gn-e-addsl 6 16 1 4)) (gn-emit (gn-e-addsl 2 16 2 4))
             (gn-emit (enc-cmp-r 4 2))) e0 (vector-at m0 MM-CODE-N)
        m1 (gn-emit m0 0) top (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-ldp 12 13 4 0)) (gn-mov 5 4)) s (vector-at m2 MM-CODE-N)
        ;; the shift loop twice per back branch (one taken branch per two moves)
        m3 (-> m2 (gn-emit (enc-cmp-r 5 6)) (gn-emit 0) (gn-emit (enc-ldp 14 15 5 -16)) (gn-emit (enc-cmp-r 12 14)) (gn-emit 0)
             (gn-emit (enc-stp 14 15 5 0)) (gn-emit (enc-sub-i 5 5 16))
             (gn-emit (enc-cmp-r 5 6)) (gn-emit 0) (gn-emit (enc-ldp 14 15 5 -16)) (gn-emit (enc-cmp-r 12 14)) (gn-emit 0)
             (gn-emit (enc-stp 14 15 5 0)) (gn-emit (enc-sub-i 5 5 16))) bb (vector-at m3 MM-CODE-N)
        m4 (gn-emit m3 (enc-b (- s bb))) p1 (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (enc-sub-i 8 8 1))) pl (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-put (+ MM-CODE-BASE (inc s)) (enc-bcond 9 (- pl (inc s))))
             (gn-put (+ MM-CODE-BASE (+ s 4)) (enc-bcond (enc-cond-ge) (- p1 (+ s 4))))
             (gn-put (+ MM-CODE-BASE (+ s 8)) (enc-bcond 9 (- pl (+ s 8))))
             (gn-put (+ MM-CODE-BASE (+ s 11)) (enc-bcond (enc-cond-ge) (- p1 (+ s 11))))
             (gn-emit (enc-stp 12 13 5 0)) (gn-emit (enc-sub-r 16 4 5)) (gn-emit (gn-e-lsr 16 16 3))
             (gn-emit (gn-e-addsl 16 16 16 1)) (gn-emit (enc-sub-r 8 8 16)) (gn-emit (enc-sub-i 8 8 5))
             (gn-emit (enc-add-i 4 4 16)) (gn-emit (enc-cmp-r 4 2))) back (vector-at m6 MM-CODE-N)
        m7 (-> m6 (gn-emit (enc-bcond (enc-cond-ne) (- top back)))) done (vector-at m7 MM-CODE-N)
        m8 (-> m7 (gn-put (+ MM-CODE-BASE e0) (enc-bcond (enc-cond-eq) (- done e0))) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-ret))
             (gn-emit 0xD5032FFF))
        cold (vector-at m8 MM-CODE-N)]
   (ri-patch m8 G 0 cold))))
;; ---- huffbench sort-table: (f s i) = (if (= i N) s (f (si s i s[H + i] s[O + i]) (+ i 1))), si the insertion step
;; (while j > 0 and s[H + j - 1] > key: move entry j - 1 of both arrays up; then key, c at j), one frameless loop.
(defn- hst-pat [] :string "")
(defn- hsi-pat [] :string "")
(defn- hst-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A) si (gn-sir M (+ p 26) IF-A)]
  (and (> p 0) (< (+ p 36) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (pj-fn? M f 37 (hst-pat) [f si]) (pj-fn? M si 83 (hsi-pat) [si]))))
;; before the frame: x0 = s (kept), x1 = i. Guards: i < N, s live with H + N and O + N inside it, fuel >= 1 + 2n + the
;; sum of i .. N - 1 (n = N - i: each step's self call and si's entry, one charge per move). Then x9 walks i, x12 j;
;; the private fuel loses 2 + (i - j) per step and is published at ret.
(defn- hst-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (hst-admit M i)) M
  (let [p (dec i) N (gn-sir M (+ p 4) IF-B) H (gn-sir M (+ p 11) IF-B) O (gn-sir M (+ p 17) IF-B)
        top (if (> H O) (+ H N) (+ O N)) G (vector-alloc 11)
        m0 (-> M (gn-mov-imm 9 N) (gn-emit (enc-cmp-r 1 9)) (ri-cold G (enc-cond-hs))
             (gn-emit (enc-sub-r 10 9 1)) (gn-emit (enc-add-r 11 1 9)) (gn-emit (enc-sub-i 11 11 1))
             (gn-emit (enc-mul 11 10 11)) (gn-emit (gn-e-lsr 11 11 1)) (gn-emit (gn-e-addsl 11 11 10 1))
             (gn-emit (enc-add-i 11 11 1)) (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 11)) (ri-cold G (enc-cond-lo))
             (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))
             (ri-cold G (enc-cond-hs)) (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 6 16 0))
             (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 6 16)) (ri-cold G (enc-cond-hs))
             (gn-mov-imm 16 top) (gn-emit (enc-cmp-r 6 16)) (ri-cold G (enc-cond-lo))
             ;; every guard passed: x10 = &s[H], x11 = &s[O], x14 / x15 one item before
             (gn-emit (enc-sub-i 8 8 1)) (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 16 16 17 3))
             (gn-mov-imm 17 (* 8 H)) (gn-emit (enc-add-r 10 16 17)) (gn-mov-imm 17 (* 8 O)) (gn-emit (enc-add-r 11 16 17))
             (gn-emit (enc-sub-i 14 10 8)) (gn-emit (enc-sub-i 15 11 8)) (gn-mov 9 1)) top-i (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (gn-e-ldrr 2 10 9 1)) (gn-emit (gn-e-ldrr 3 11 9 1)) (gn-mov 12 9)) s (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-cbz 12 0)) (gn-emit (gn-e-ldrr 13 14 12 1)) (gn-emit (enc-cmp-r 13 2))) ble (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit 0) (gn-emit (gn-e-ldrr 16 15 12 1)) (gn-emit (gn-e-strr3 13 10 12)) (gn-emit (gn-e-strr3 16 11 12))
             (gn-emit (enc-sub-i 12 12 1))) bb (vector-at m3 MM-CODE-N)
        m4 (gn-emit m3 (enc-b (- s bb))) pl (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-put (+ MM-CODE-BASE s) (enc-cbz 12 (- pl s))) (gn-put (+ MM-CODE-BASE ble) (enc-bcond (enc-cond-le) (- pl ble)))
             (gn-emit (gn-e-strr3 2 10 12)) (gn-emit (gn-e-strr3 3 11 12))
             (gn-emit (enc-sub-r 16 9 12)) (gn-emit (enc-add-i 16 16 2)) (gn-emit (enc-sub-r 8 8 16))
             (gn-emit (enc-add-i 9 9 1)) (gn-mov-imm 16 N) (gn-emit (enc-cmp-r 9 16))) back (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-bcond (enc-cond-ne) (- top-i back))) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-ret)))
        cold (vector-at m6 MM-CODE-N)]
   (ri-patch m6 G 0 cold))))

(defn- gn-copy-writer? [M :vector-i64 f :i64] :bool
 (let [p (gn-fnf M f FF-SIR)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0) (< (+ p 8) (vector-at M MM-SIR-N))
       (not (gn-clamp-open M f)) (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
       (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
       (= (gn-fnf M f FF-RTYPE) TY-VEC)
       (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
       (> (gn-sir M (+ p 2) IF-A) 0) (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))
       (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 5) OP-LGET 2 3 0) (gn-dot-at? M (+ p 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
       (gn-dot-at? M (+ p 7) OP-RET 0 0 0) (gn-dot-at? M (+ p 8) OP-END f 0 0))))
(defn- gn-copy-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 28) true
  (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
        exit (gn-sir M (+ p 8) IF-A) n (gn-sir M (+ p 4) IF-B)
        dest (gn-sir M (+ p 11) IF-B) writer (gn-sir M (+ p 17) IF-A)]
   (and (case k
    0 (gn-dot-at? M (+ p 0) OP-FN f 2 2)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 2 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-CONST 1 dest 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 2 2 0)
    13 (gn-dot-at? M (+ p 13) OP-BIN BOP-ADD 1 0)
    14 (gn-dot-at? M (+ p 14) OP-LGET 2 1 0)
    15 (gn-dot-at? M (+ p 15) OP-LGET 3 2 0)
    16 (gn-dot-at? M (+ p 16) OP-RT RT-VECTOR-AT 2 2)
    17 (gn-dot-at? M (+ p 17) OP-CALL writer 0 3)
    18 (gn-dot-at? M (+ p 18) OP-LGET 1 2 0)
    19 (gn-dot-at? M (+ p 19) OP-CONST 2 1 0)
    20 (gn-dot-at? M (+ p 20) OP-BIN BOP-ADD 1 0)
    21 (gn-dot-at? M (+ p 21) OP-LSET 1 0 0)
    22 (gn-dot-at? M (+ p 22) OP-LSET 2 1 0)
    23 (gn-dot-at? M (+ p 23) OP-FUEL 0 0 0)
    24 (gn-dot-at? M (+ p 24) OP-BR head 0 0)
    25 (gn-dot-at? M (+ p 25) OP-LABEL exit 0 0)
    26 (gn-dot-at? M (+ p 26) OP-RET 0 0 0)
    27 (gn-dot-at? M (+ p 27) OP-END f 0 0)
    false) (gn-copy-shape M p f (inc k))))))
(defn- gn-copy-ready? [M :vector-i64 i :i64 entry :bool] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 27) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 2)
       (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
       (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-fb) 0) (if entry (and (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-fuel) 1))
           (= (gn-g M gn-f-freg) 1))
       (= (gn-g M gn-f-h) 0) (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1)
       (>= (gn-sir M (+ p 4) IF-B) 1) (<= (gn-sir M (+ p 4) IF-B) 2047)
       (>= (gn-sir M (+ p 11) IF-B) 0) (<= (gn-sir M (+ p 11) IF-B) 2047)
       (> (gn-sir M (+ p 2) IF-A) 0) (> (gn-sir M (+ p 6) IF-B) 0) (> (gn-sir M (+ p 8) IF-A) 0)
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 6) IF-B))
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 8) IF-A))
       (not= (gn-sir M (+ p 6) IF-B) (gn-sir M (+ p 8) IF-A))
       (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))
       (= (gn-lpos M (gn-sir M (+ p 6) IF-B)) (+ p 9))
       (= (gn-lpos M (gn-sir M (+ p 8) IF-A)) (+ p 25))
       (gn-copy-writer? M (gn-sir M (+ p 17) IF-A)) (gn-copy-shape M p f 0))))
(defn- gn-copy? [M :vector-i64 i :i64] :bool (gn-copy-ready? M i false))
;; Exact closed constant-zero forward loop, success-only bulk stores.
;; Fast admission is index0, enough original charges, valid handle and full
;; range. Every failing guard falls through the original unchanged body.
;; Complete-budget private affine zero fill; original cold SIR stays emitted.
(defn- pz-writer [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (+ p 2) IF-A)]
   (and (> p 0) (< (+ p 8) (vector-at M MM-SIR-N))
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
    (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-RTYPE) TY-VEC)
    (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (> l 0) (< l MM-LABEL-CAP)
    (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL l 0 0)
    (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 5) OP-LGET 2 3 0)
    (gn-dot-at? M (+ p 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
    (gn-dot-at? M (+ p 7) OP-RET 0 0 0) (gn-dot-at? M (+ p 8) OP-END f 0 0)))))
(defn- pz-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 28) true
  (let [h (gn-sir M (+ p 2) IF-A) b (gn-sir M (+ p 6) IF-B)
        e (gn-sir M (+ p 8) IF-A) n (gn-sir M (+ p 4) IF-B)
        w (gn-sir M (+ p 15) IF-A)]
   (and (case k
    0 (gn-dot-at? M p OP-FN f 3 3)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL h 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 3 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 b 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-BR e 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL b 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
    13 (gn-dot-at? M (+ p 13) OP-BIN BOP-ADD 1 0)
    14 (gn-dot-at? M (+ p 14) OP-CONST 2 0 0)
    15 (gn-dot-at? M (+ p 15) OP-CALL w 0 3)
    16 (gn-dot-at? M (+ p 16) OP-LGET 1 2 0)
    17 (gn-dot-at? M (+ p 17) OP-LGET 2 3 0)
    18 (gn-dot-at? M (+ p 18) OP-CONST 3 1 0)
    19 (gn-dot-at? M (+ p 19) OP-BIN BOP-ADD 2 0)
    20 (gn-dot-at? M (+ p 20) OP-LSET 1 0 0)
    21 (gn-dot-at? M (+ p 21) OP-LSET 2 1 0)
    22 (gn-dot-at? M (+ p 22) OP-LSET 3 2 0)
    23 (gn-dot-at? M (+ p 23) OP-FUEL 0 0 0)
    24 (gn-dot-at? M (+ p 24) OP-BR h 0 0)
    25 (gn-dot-at? M (+ p 25) OP-LABEL e 0 0)
    26 (gn-dot-at? M (+ p 26) OP-RET 0 0 0)
    27 (gn-dot-at? M (+ p 27) OP-END f 0 0) false)
    (pz-shape M p f (inc k))))))
(defn- pz-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i) f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B)
       h (gn-sir M (+ p 2) IF-A) b (gn-sir M (+ p 6) IF-B) e (gn-sir M (+ p 8) IF-A)]
  (if (and (> p 0) (< (+ p 27) (vector-at M MM-SIR-N))
    (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 3)
    (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 4)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
    (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-freg) 1)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
    (= (gn-g M gn-f-ctx) 1) (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2)
    (>= n 1) (<= n 4096) (> h 0) (< h MM-LABEL-CAP) (> b 0) (< b MM-LABEL-CAP)
    (> e 0) (< e MM-LABEL-CAP) (not= h b) (not= h e) (not= b e)
    (= (gn-lpos M h) (+ p 2)) (= (gn-lpos M b) (+ p 9)) (= (gn-lpos M e) (+ p 25))
    (pz-writer M (gn-sir M (+ p 15) IF-A)) (pz-shape M p f 0)) n 0)))
(defn- pz-entry [M :vector-i64 i :i64] :vector-i64
 (let [n (pz-admit M i)]
  (if (= n 0) M
   (let [m0 (-> M (gn-mov-imm 9 n) (gn-emit (enc-cmp-r 2 9))) b0 (vector-at m0 MM-CODE-N)
         m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-emit (enc-sub-r 9 9 2)) (gn-emit (gn-e-lsl 11 9 1))
          (gn-emit (enc-cmp-r 8 11))) b1 (vector-at m1 MM-CODE-N)
         m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
          (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
         m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
          (gn-emit (enc-ldp 17 10 16 0)) (gn-mov-imm 11 1152921504606846975)
          (gn-emit (enc-cmp-r 10 11))) b3 (vector-at m3 MM-CODE-N)
         m4 (-> m3 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-r 1 10))) b4 (vector-at m4 MM-CODE-N)
         m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-mov-imm 11 (dec n)) (gn-emit (enc-add-r 11 1 11))
          (gn-emit (enc-cmp-r 11 10))) b5 (vector-at m5 MM-CODE-N)
         m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-emit (enc-add-r 10 1 2)) (gn-emit (enc-add-r 17 17 10))
          (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 16 16 17 3))
          ;; All original charges preflighted; cached private fuel remains
          ;; private until the unchanged epilogue publishes its final value.
          (gn-emit (gn-e-lsl 11 9 1)) (gn-emit (enc-sub-r 8 8 11))) at (vector-at m6 MM-CODE-N)
         m7 (-> m6 (gn-emit 0x6f00e410) (zf-store))
         m8 (-> m7 (gn-mov-imm 2 n) (gn-epilogue) (gn-gs gn-f-dead 0)) end (vector-at m8 MM-CODE-N)]
    (-> m8 (gn-dot-patch b0 end (enc-cond-hs)) (gn-dot-patch b1 end (enc-cond-lo))
     (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end 8)
     (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-hs)))))))

;; ---- zf (kernels B): range zero fill (fill v start end) = (if (= start end) v (fill (put v start 0) (+ start 1) end))
;; in a leaf (v, start, end in x0, x1, x2; fuel in x8). Per item the original charges put's entry and the recur, then
;; stores. Fast path when 0 <= start <= end <= len of a valid handle and fuel >= 2 (end - start): no charge can exhaust
;; and no store can fail, so the items are zeroed with the pz store ladder, fuel drops by 2 (end - start) at once,
;; start := end and the unchanged epilogue publishes the fuel and returns v. Anything else runs the original code.
(defn- zf-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A) w (gn-sir M (+ p 13) IF-A)]
  (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC)
    (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-freg) 1)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
    (= (gn-g M gn-f-ctx) 1) (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2) (pz-writer M w)
    (kpat-match M p [844442109345793 18 4229300233 8589934596 12884967428 65543 277141354709003 4294967300 4227923978 4228841481 4294967300 8590000132 131075 844429224378381 8590000132 4295098371 4295032838 12885032964 65541 4295098373 8590131205 18 4229300234 4227923977 19 4294311938] [f w]))))
(defn- zf-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (zf-admit M i)) M
  ;; signed 0 <= start <= end first, so end - start < 2^60 once end <= len (no overflow in the fuel need)
  (let [m0 (gn-emit M (enc-cmp-i 1 0)) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lt) 0)) (gn-emit (enc-cmp-r 1 2))) b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-gt) 0))
         (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
         (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
         (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
         (gn-emit (enc-ldp 17 10 16 0)) (gn-mov-imm 11 1152921504606846975)
         (gn-emit (enc-cmp-r 10 11))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-r 2 10))) b4 (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (enc-bcond 8 0))
         (gn-emit (enc-sub-r 9 2 1)) (gn-emit (gn-e-lsl 11 9 1)) (gn-emit (enc-cmp-r 8 11))) b5 (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-bcond (enc-cond-lo) 0))
         (gn-emit (enc-add-r 17 17 1)) (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 16 16 17 3))
         (gn-emit (enc-sub-r 8 8 11))
         (gn-emit 0x6f00e410) (zf-store)
         (gn-mov 1 2) (gn-epilogue) (gn-gs gn-f-dead 0)) end (vector-at m6 MM-CODE-N)]
   (-> m6 (gn-dot-patch b0 end (enc-cond-lt)) (gn-dot-patch b1 end (enc-cond-gt))
    (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end 8)
    (gn-dot-patch b4 end 8) (gn-dot-patch b5 end (enc-cond-lo))))))
;; ---- mmx (kernels B): the whole product loop (multiply v i) of a 20 x 20 x 20 matrix product:
;;   (if (= i 400) v (multiply (put v (+ oc i) (dot v (quot i 20) (rem i 20) 0 0)) (+ i 1)))
;; with dot the certified dot shape (gn-dot-shape; n = sa = sb = 20, ob = oa + 400), rem the closed x - (x quot y) y
;; helper (no charge) and put the plain writer. Per i the original charges dot's entry and its 20 terms, put and the recur
;; (23), reads A = v[oa + 20 r + k] and B = v[ob + 20 k + c], and stores C at v[oc + i]; C lies above A and B.
;; Fast path (at the entry, after the entry charge): i = 0, a valid handle with oc + 400 <= len < 2^60, fuel >= 9200 and
;; every one of the 800 input items in [0, 2^13) (all checked before any store). Then every sum is below 2^31, so the
;; 400 sums come from 32-bit mul/mla (by element, four lanes) over 32-bit copies of A and B in stack scratch, are
;; stored at v[oc ..], the 9200 charges are paid at once, i := 400, x5 := 0 (no cached descriptor; x3/x4 are
;; clobbered) and the loop head returns v. Otherwise the original loop runs. d8-d15 (callee-saved) are saved around.
;; g's SIR start when g is a plain function, else 0
(defn- mmx-q [M :vector-i64 g :i64] :i64
 (if (and (> g 0) (< g (vector-at M MM-FN-N)) (not (gn-clamp-open M g))) (gn-fnf M g FF-SIR) 0))
;; rem as the closed helper x - (x quot y) y (no charge)
(defn- kb-rem? [M :vector-i64 f :i64] :bool
 (kpat-match M (mmx-q M f) [562962837667841 4229365769 4294967300 8590000132 4295098372 8590131204 8590196742 4295163910 131078 19 4294311938] [f]))
;; the oa of the admitted loop (C at oc = 1600 >= oa + 800), else -1; dot: n = sa = sb = 20, ob = oa + 400
(defn- mmx-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i) f (gn-sir M p IF-A) rf (gn-sir M (+ p 16) IF-A) df (gn-sir M (+ p 19) IF-A) w (gn-sir M (+ p 26) IF-A)
       q (mmx-q M df) oa (gn-sir M (+ q 18) IF-B)]
  (if (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
           (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-PT0) TY-VEC)
           (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-ctx) 1)
           (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0)
           (>= (gn-sreg M 1) 19) (>= (gn-sreg M 2) 19) (not= (gn-sreg M 1) (gn-sreg M 2))
           (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2)) (> q 0) (> (mmx-q M rf) 0) (pz-writer M w)
           (kpat-match M p [844437814378497 18 4229300233 8589934596 1717986983939 65543 277141354709003 4294967300 4227203082 4228841481 4294967300 8590000132 85899476995 4295229446 8590065668 85899542531 562962837602317 196611 262147 1407379177734157 196613 4294967300 6871947739139 8590065668 4295032838 12885032964 844429224247309 8590000132 4295098371 4295032838 65541 4295098373 18 4229300234 4227203081 19 4294311938] [f rf df w])
           (kb-rem? M rf)
           (= (gn-sir M (+ q 4) IF-B) 20) (= (gn-sir M (+ q 20) IF-B) 20) (= (gn-sir M (+ q 29) IF-B) 20)
           (>= oa 0) (<= oa 800) (= (gn-sir M (+ q 27) IF-B) (+ oa 400)) (gn-dot-shape M q df 0)) oa -1)))
;; mul/mla (by element, .4s): acc += B lanes x A element
(defn- mmx-mla [first :bool d :i64 n :i64 m :i64 idx :i64] :i64
 (+ (if first 0x4F808000 0x6F800000) (* (bit-and idx 1) 2097152) (* m 65536) (* (u64-shift-right idx 1) 2048) (* n 32) d))
;; one k of a 4-row group: B[k] into v28 v29 v30 v31 v0, then acc v(8 + 5 rr + jj) += B jj x A row rr (v1 + rr) lane k mod 4
(defn- mmx-k [M :vector-i64 k :i64] :vector-i64
 (loop [cur (-> M (gn-emit 0xACC1743C) (gn-emit 0xACC17C3E) (gn-emit 0x3CC10420)) j 0]
  (if (= j 20) cur
   (recur (gn-emit cur (mmx-mla (= k 0) (+ 8 j) (case (rem j 5) 0 28 1 29 2 30 3 31 0) (+ 1 (quot j 5)) (rem k 4))) (inc j)))))
;; rows 4 g .. 4 g + 3 (x0 = their 32-bit A rows, x3 = &v[oc + 80 g]): A blocks of 4 k reloaded per block, then each
;; 4-lane sum zero-extended (it is below 2^31) and stored as two i64 pairs
(defn- mmx-group [M :vector-i64] :vector-i64
 (let [m0 (loop [cur (gn-emit M (enc-add-i 1 31 1664)) k 0]
           (if (= k 20) cur
            (recur (mmx-k (if (= (rem k 4) 0)
                            (loop [c cur rr 0] (if (= rr 4) c
                             (recur (gn-emit c (+ 0x3DC00000 (* (+ (* 5 rr) (quot k 4)) 1024) (inc rr))) (inc rr)))) cur) k)
                   (inc k))))]
  (loop [cur m0 j 0] (if (= j 20) cur
   (recur (-> cur (gn-emit (+ 0x2F20A41C (* (+ 8 j) 32))) (gn-emit (+ 0x6F20A41D (* (+ 8 j) 32)))
              (gn-emit (+ 0xAD00747C (* (+ (* 10 (quot j 5)) (* 2 (rem j 5))) 32768)))) (inc j))))))
;; T2 keep marker (HINT #127, a NOP): T2 neither replaces nor inlines a function whose old code holds it; emitted off the hot path.
(defn- kb-keep [M :vector-i64] :vector-i64 (gn-emit M 0xD5032FFF))
(defn- mmx-entry [M :vector-i64 i :i64] :vector-i64
 (let [oa (mmx-admit M i)]
  (if (< oa 0) M
   (let [p (dec i) rv (gn-sreg M 1) ri (gn-sreg M 2) oc (gn-sir M (+ p 22) IF-B) G (vector-alloc 21)
         m0 (-> M (gn-emit (enc-cmp-i ri 0)) (ri-cold G (enc-cond-ne)) (kb-vec G rv 0 6)
              (gn-mov-imm 16 (+ oc 400)) (gn-emit (enc-cmp-r 0 16)) (ri-cold G (enc-cond-lo))
              (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov-imm 9 9200) (gn-emit (enc-cmp-r 8 9)) (ri-cold G (enc-cond-lo))
              ;; phase 1: 50 blocks of 16 items from &v[oa]: the items OR-ed into v16..v19, their low words (the values
              ;; themselves when all are in [0, 2^13)) to sp + 64 (A rows, then B rows; 80 bytes each). x5, a descriptor
              ;; cache register in some modes, is never touched before the fast path is certain.
              (gn-mov-imm 16 (* 8 oa)) (gn-emit (enc-add-r 0 6 16)) (gn-emit (enc-sub-i 31 31 3264))
              (gn-emit (enc-add-i 1 31 64)) (gn-mov-imm 2 50)
              (gn-emit 0x6F00E410) (gn-emit 0x6F00E411) (gn-emit 0x6F00E412) (gn-emit 0x6F00E413)) l1 (vector-at m0 MM-CODE-N)
         m1 (-> m0 (gn-emit 0xACC10400) (gn-emit 0xACC10C02) (gn-emit 0xACC11404) (gn-emit 0xACC11C06)
              (gn-emit 0x4EA11C14) (gn-emit 0x4EA31C55) (gn-emit 0x4EA51C96) (gn-emit 0x4EA71CD7)
              (gn-emit 0x4EB41E10) (gn-emit 0x4EB51E31) (gn-emit 0x4EB61E52) (gn-emit 0x4EB71E73)
              (gn-emit 0x4E811800) (gn-emit 0x4E831842) (gn-emit 0x4E851884) (gn-emit 0x4E8718C6)
