;; kept as dead code), t2-end re-compiles f when it is admitted and its old code carries no certified-kernel signature,
;; and points FF-CODE at the new entry. Semantics replicated exactly:
;; - fuel: gen's leaf mode 1 -- counter in x8 from entry, every FUEL `subs x8,x8,#1 ; b.lo` to `str xzr,[x7,#8] ; brk #0`,
;;   published only at RET; traps inside see the entry value (as the old leaf);
;; - every FUEL, trap (udf: handle/index; brk #0: table range, quot) and vector store keeps its program order;
;; - a vector parameter's descriptor (items base, length) is read once at entry WITHOUT trapping (length 0 for an invalid
;;   handle): call-free leaf code cannot allocate, so the count and descriptors are constant for the whole body. Each access
;;   then checks `index <u length` at its original position and branches to `udf #0` (handle and index failures are both
;;   SIGILL; the counter state is the same);
;; - first word `mov x5,#0`, second word `ldr x8,[x7,#8]` when charged: existing private-entry callers (42-layout checks)
;;   stay valid; x3/x4/x5 are never read on entry; x7 is never written; only x0-x17 (and saved x19-x28) are clobbered.
;; All branches go through FIX records to fresh global labels so post-emission passes see every target as a root.
(def t2-cell 98)
(def t2-maxops 2048)
(def t2-maxb 256)
(def t2-maxv 2048)
(def t2-maxvar 256)
(def t2-maxphi 4096)
(def t2-maxpred 1024)
(def t2-vw 8)
;; scalars
(def t2-s-p 0)       ; SIR index of the FN
(def t2-s-end 1)     ; SIR index of the END
(def t2-s-nb 2)      ; blocks
(def t2-s-nv 3)      ; values (1-based; 0 = none)
(def t2-s-nphi 4)    ; phi operand fill
(def t2-s-ns 5)      ; slots: variable s (1..ns); temp t is variable ns+1+t
(def t2-s-nvar 6)
(def t2-s-fail 7)    ; nonzero = refuse (reason code)
(def t2-s-npred 8)
(def t2-s-f 9)
(def t2-s-np 10)
(def t2-s-fuel 11)   ; 1 = has FUEL
(def t2-s-lab0 12)   ; first T2 label
(def t2-s-cur 13)    ; current block while building
(def t2-s-npos 14)   ; linear positions
(def t2-s-regs 15)   ; callee-saved pairs used
(def t2-s-udf 16)    ; label of the udf stub
(def t2-s-brk 17)    ; label of the brk #0 stub
(def t2-s-fstub 18)  ; label of the fuel stub
(def t2-s-nstub 19)  ; edge stubs queued
(def t2-s-busy 20)   ; register busy mask during linear scan
;; arrays
(def t2-a-blk 128)   ; scalars 0..127 are zeroed per compile
(def t2-a-bs (+ t2-a-blk t2-maxops))
(def t2-a-be (+ t2-a-bs t2-maxb))
(def t2-a-bp0 (+ t2-a-be t2-maxb))
(def t2-a-bpn (+ t2-a-bp0 t2-maxb))
(def t2-a-bseal (+ t2-a-bpn t2-maxb))
(def t2-a-bmaxp (+ t2-a-bseal t2-maxb))
(def t2-a-bphi (+ t2-a-bmaxp t2-maxb))
(def t2-a-bv0 (+ t2-a-bphi t2-maxb))
(def t2-a-bv1 (+ t2-a-bv0 t2-maxb))
(def t2-a-blab (+ t2-a-bv1 t2-maxb))
(def t2-a-bt (+ t2-a-blab t2-maxb))      ; taken successor block (-1 none)
(def t2-a-bf (+ t2-a-bt t2-maxb))        ; fallthrough successor block (-1 none)
(def t2-a-bpos0 (+ t2-a-bf t2-maxb))     ; first linear position
(def t2-a-bpos1 (+ t2-a-bpos0 t2-maxb))  ; last linear position
(def t2-a-breach (+ t2-a-bpos1 t2-maxb)) ; 1 = reachable
(def t2-a-pred (+ t2-a-breach t2-maxb))
(def t2-a-def (+ t2-a-pred t2-maxpred))
(def t2-a-v (+ t2-a-def (* t2-maxvar t2-maxb)))
(def t2-a-phiop (+ t2-a-v (* t2-maxv t2-vw)))
(def t2-a-live (+ t2-a-phiop t2-maxphi))  ; per block: 32 words live-in, 32 words live-out
(def t2-a-stub (+ t2-a-live (* t2-maxb 64)))  ; edge stubs: 4 words each (label, from block, to block, target label), 6 per block max
(def t2-a-ue (+ t2-a-stub (* 4 6 t2-maxb)))  ; per block 32 words: upward-exposed uses
(def t2-a-vx (+ t2-a-ue (* t2-maxb 32)))   ; per value 6 words: pos start end flags next uses
(def t2-xw 6)
(def t2-a-mv (+ t2-a-vx (* t2-maxv t2-xw))) ; pending moves: 64 x (dst, src, kind, k)
(def t2-a-pd (+ t2-a-mv 256))              ; descriptor slot k (one per handle class, part4): 4 words (active?, base reg,
                                           ; len reg, 1 + index of the class's parameter or 0)
(def t2-a-tb (+ t2-a-pd 64))               ; tables: 16 x (lit, reg)
(def t2-a-sl (+ t2-a-tb 32))               ; start-list heads per position
(def t2-maxpos 2560)
(def t2-a-re (+ t2-a-sl t2-maxpos))        ; per register (0..31): end position of its current value
;; per FN index: T2 decision (0 none, 1 applied, 2 rolled back as not smaller, 3 kernel signature, 100+k refused with
;; t2-fail code k), read only by diagnostic builds
(def t2-a-st (+ t2-a-re 64))
(def t2-a-calls (+ t2-a-st MM-FN-CAP 4096 t2-maxb 4096))   ; positions of real calls (<= 256)
;; after the persistent handoff records: table base adjustments 16 (t2-a-tbadj) and tree leaves 64 x 6 (t2-a-trl), part2x;
;; then the handle classes (t2-hnd-words, from t2-a-uf, part4)
(def t2-hnd-words (+ (* 3 t2-maxv) 256 16 (* 8 t2-maxb)))
(def t2-size (+ t2-a-calls 256 192 (* 3 t2-maxb) 64 4096 t2-maxb (* 8 17) (* 64 10) (* 2 t2-maxb) 6 t2-maxv 32 MM-FN-CAP 4097
                16 (* 64 6) t2-hnd-words 256 t2-str-words))
;; before it, 256 words: the callees being expanded (t2-a-xstk, part2x)
;; string support at the END of the block (t2-size - t2-str-words): 8 counters (t2-a-sx: string labels used, string stubs,
;; size credit; zeroed per compile), string slots 8 x 8 words (t2-a-sd), string stubs 40 x 6 words (t2-a-ss), per block
;; the slots read from its start on (t2-a-sneed); then per block the jump-threading decision (t2-a-thr, part4t)
(def t2-str-words (+ 8 64 256 t2-maxb t2-maxb (* 9 t2-maxv) 256 (* 16 MM-FN-CAP) (* 20 t2-maxb) t2-maxv 32))
(def t2-a-sx (- t2-size t2-str-words))
(def t2-a-sd (+ t2-a-sx 8))
(def t2-a-ss (+ t2-a-sd 64))
(def t2-a-sneed (+ t2-a-ss 256))
(def t2-a-thr (+ t2-a-sneed t2-maxb))
;; strength reduction in fast copies (part4l): per value the access group + 1 (t2-a-srg), its byte offset from the group
;; pointer (t2-a-sro) and its uses by fast-dead values or reduced indices (t2-a-srd); per loop 32 words (t2-a-sr)
(def t2-a-srg (+ t2-a-thr t2-maxb))
(def t2-a-sro (+ t2-a-srg t2-maxv))
(def t2-a-srd (+ t2-a-sro t2-maxv))
(def t2-a-sr (+ t2-a-srd t2-maxv))
;; persistent per FN (part6): may change descriptors (t2-a-mcd), returns its parameter-0 vector (t2-a-ret0)
(def t2-a-mcd (+ t2-a-sr 256))
(def t2-a-ret0 (+ t2-a-mcd MM-FN-CAP))
(def t2-a-obj (+ t2-a-ret0 MM-FN-CAP))   ; per value: object identity (part4)
(def t2-a-dla (+ t2-a-obj t2-maxv))      ; per value (calls) 4 words: members desc-live right after it (part4)
(def t2-a-bch (+ t2-a-dla (* 4 t2-maxv)))  ; per block 16 words: hoisted constant-index check per slot (part5b)
;; persistent per FN (part6): least vector length of parameters 0..3 (t2-a-pmin, 4 words) and of the result (t2-a-rmin)
(def t2-a-pmin (+ t2-a-bch (* 16 t2-maxb)))
(def t2-a-rmin (+ t2-a-pmin (* 4 MM-FN-CAP)))
(def t2-a-hmin (+ t2-a-rmin MM-FN-CAP))   ; per value: least length of a handle (part4t)
(def t2-mlinf 4611686018427387904)        ; "no call seen" (an optimistic start, read as 0)
;; persistent per FN (part6), 8 words: the value range of parameter k (k < 8) over every call, packed (t2-rg)
(def t2-a-prng (+ t2-a-hmin t2-maxv))
;; persistent per FN (part5b): 1 when its T2 code returns with x8 = the exact fuel and x7 = the context (every T2 return
;; publishes x8 and restores x7 after calls; its tail calls go only to such functions)
(def t2-a-x8r (+ t2-a-prng (* 8 MM-FN-CAP)))
;; fuel regions (part4f): per block its region (head index + 1, 0 none) and per head the precheck bound (0 none)
(def t2-a-rgn (+ t2-a-x8r MM-FN-CAP))
(def t2-a-rgk (+ t2-a-rgn t2-maxb))
(def t2-a-rgd (+ t2-a-rgk t2-maxb))   ; per block: most charges on a path from its region head through it
(def t2-a-rgm (+ t2-a-rgd t2-maxb))   ; per block: fewest exhaustion checks on a path from its region head through it
(def t2-s-rfast 82)     ; emitting a region member's ordinary copy: charges without exhaustion checks
(def t2-s-cregion 83)   ; emitting the cold copy of region (head + 1): its member targets are their cold copies
(def t2-s-tailbad 84)   ; a tail call of the function being compiled goes to code without that guarantee
;; ---- spilling (part4c t2-sp-*, part5 t2-loc/t2-ldloc): a value whose reg field is -2 lives in memory for its whole
;; interval, at location t2-a-spl[v]: 32 + j for frame spill slot j, 32 + 4096 + k for stack parameter k (the caller's
;; outgoing area, read in place). Operands load into x16/x17 where they are read, results go through x16 and are stored.
(def t2-a-spl (+ t2-a-rgm t2-maxb))     ; per value: spill location (after the fuel regions, part4f)
(def t2-a-own (+ t2-a-spl t2-maxv))     ; per register: the value holding it during the scan (0 = fixed, scratch or none)
(def t2-s-spill 100)    ; 1 = spill mode (a retry after running out of registers)
(def t2-s-nspl 101)     ; frame spill slots
(def t2-s-spadj 102)    ; bytes pushed below the frame since its set-up (outgoing stack arguments, string stub saves)
(def t2-s-frame 103)    ; bytes of the frame tail below the saved registers ([sp, #0] = x7 with calls, then the slots)
(def t2-maxspl 400)
;; a value range [lo, hi] of 32-bit bounds in one word: lo * 2^32 + (hi + 2^31). t2-mlinf reads as the empty range
;; (lo 2^30 > hi -2^31), the start of a union; t2-rg-unk is every value.
(defn- t2-rg [lo :i64 hi :i64] :i64 (+ (* lo 4294967296) (+ hi 2147483648)))
(defn- t2-rg-lo [w :i64] :i64 (i64-shift-right w 32))
(defn- t2-rg-hi [w :i64] :i64 (- (bit-and w 4294967295) 2147483648))
(def t2-rg-unk (t2-rg -2147483648 2147483647))
(defn- t2-rg-empty? [w :i64] :bool (> (t2-rg-lo w) (t2-rg-hi w)))
;; [lo, hi] when both fit 32 bits (else every value)
(defn- t2-rg-mk [lo :i64 hi :i64] :i64
  (if (and (>= lo -2147483648) (<= hi 2147483647) (<= lo hi)) (t2-rg lo hi) t2-rg-unk))
(defn- t2-rg-union [a :i64 b :i64] :i64
  (cond (t2-rg-empty? a) b (t2-rg-empty? b) a
        :else (t2-rg (gn-min (t2-rg-lo a) (t2-rg-lo b)) (gn-max (t2-rg-hi a) (t2-rg-hi b)))))
(defn- t2-rg-k [k :i64] :i64 (t2-rg-mk k k))
;; value fields
(def t2-f-op 0) (def t2-f-a 1) (def t2-f-b 2) (def t2-f-c 3) (def t2-f-blk 4) (def t2-f-link 5) (def t2-f-repl 6) (def t2-f-reg 7)
;; value ops
(def t2-const 1) (def t2-param 2) (def t2-bin 3) (def t2-cmp 4) (def t2-un 5) (def t2-vat 6) (def t2-vset 7)
(def t2-vcnt 8) (def t2-tab 9) (def t2-fuel 10) (def t2-phi 11) (def t2-brz 12) (def t2-br 13) (def t2-ret 14)
(def t2-trap 15) (def t2-undef 16) (def t2-pub 17) (def t2-call 18)
;; string-length / pair-second of a parameter handle (b = handle): its slot's length register, after the handle check;
;; string-code-point-at (b = handle, c = index): the slot's ASCII fast path, else the host call
;; the scanning idiom (if (= i (string-length s)) 0 (string-code-point-at s i)) as one op (b = handle, c = index):
;; the fast path first (an index below FLEN is a valid handle's and differs from its length), the rest in order cold
(def t2-slen 19) (def t2-cpa 20) (def t2-cpz 21)
(defn- t2-cpx? [op :i64] :bool (or (= op t2-cpa) (= op t2-cpz)))
;; sel: a = condition, b = value when a != 0, c = value when a = 0 (csel); dtab: a = literal table, b = packed clamp
;; (base, entries, variant: t2-dt-*), c = index operand -- a bounded table lookup that never traps (part2x)
(def t2-sel 22) (def t2-dtab 23)
;; accessors
(defn- t2-base [M :vector-i64] :i64 (vector-at M t2-cell))
(defn- t2-g [M :vector-i64 k :i64] :i64 (vector-at M (+ (vector-at M t2-cell) k)))
(defn- t2-s [M :vector-i64 k :i64 v :i64] :vector-i64 (gn-put M (+ (vector-at M t2-cell) k) v))
(defn- t2-vf [M :vector-i64 v :i64 fld :i64] :i64 (t2-g M (+ t2-a-v (* v t2-vw) fld)))
(defn- t2-vs [M :vector-i64 v :i64 fld :i64 x :i64] :vector-i64 (t2-s M (+ t2-a-v (* v t2-vw) fld) x))
(defn- t2-fail [M :vector-i64 code :i64] :vector-i64 (if (= (t2-g M t2-s-fail) 0) (t2-s M t2-s-fail code) M))
(defn- t2-zero [M :vector-i64 i :i64 k :i64] :vector-i64 (if (>= i k) M (t2-zero (t2-s M i 0) (inc i) k)))
;; the scratch block, allocated once when the HEAP has room (else T2 stays off)
(defn- t2-ready [M :vector-i64] :vector-i64
  (cond (> (vector-at M t2-cell) 0) M
        (< (- MM-HEAP-END (vector-at M MM-HEAP-TOP)) (+ t2-size 65536)) M
        :else (let [M1 (mem-alloc M t2-size)]
                (if (= (vector-at M1 MM-R1) 1)
                  ;; FN-0's status cell caches a whole-program fact (t2-sf-free?): unknown
                  (-> M1 (gn-put t2-cell (vector-at M1 MM-R0)) (gn-put (+ (vector-at M1 MM-R0) t2-a-st) 0) (t2-mcd-init) (t2-ml-init) (t2-r0-init))
                  M1))))

;; ---- admission (SIR only) -------------------------------------------------------------------------------------------
;; op j of the body is supported by M1
(defn- t2-op-ok? [M :vector-i64 j :i64] :bool
  (let [op (gn-op M j) a (gn-sir M j IF-A) c (gn-sir M j IF-C)]
    (case op
      (OP-CONST OP-LGET OP-LSET OP-LABEL OP-BR OP-BRZ OP-BRNZ OP-FUEL OP-RET OP-TRAP OP-TAB) true
      OP-BIN (< a BOP-F64-ADD)
      OP-CMP (< a CC-F64-EQ)
      OP-UN (or (= a UOP-NOT) (= a UOP-BITNOT))
      OP-RT (or (and (= a RT-VECTOR-AT) (= c 2)) (and (= a RT-VECTOR-ASSOC-IN-PLACE) (= c 3)) (and (= a RT-VECTOR-COUNT) (= c 1))
                (and (= a RT-PAIR-SECOND) (= c 1)) (and (= a RT-STRING-CODE-POINT-AT) (= c 2)))
      false)))
(defn- t2-scan-ok? [M :vector-i64 j :i64 end :i64] :bool
  (cond (>= j end) true
        (t2-op-ok? M j) (t2-scan-ok? M (inc j) end)
        :else false))
;; END index of the function whose FN is at p, 0 when not found within t2-maxops
(defn- t2-endof [M :vector-i64 p :i64 j :i64] :i64
  (cond (>= j (vector-at M MM-SIR-N)) 0
        (>= (- j p) t2-maxops) 0
        (= (gn-op M j) OP-END) j
        (= (gn-op M j) OP-FN) 0
        :else (t2-endof M p (inc j))))
;; ---- CFG -------------------------------------------------------------------------------------------------------------
(def t2-s-last 21)
(defn- t2-last [M :vector-i64] :i64 (t2-g M t2-s-last))
(defn- t2-bget [M :vector-i64 arr :i64 b :i64] :i64 (t2-g M (+ arr b)))
(defn- t2-bset [M :vector-i64 arr :i64 b :i64 v :i64] :vector-i64 (t2-s M (+ arr b) v))
(defn- t2-term? [op :i64] :bool (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ) (= op OP-RET) (= op OP-TRAP)))
;; assign blocks to body ops j = p+1 .. end-1
(defn- t2-blocks [M :vector-i64 j :i64 end :i64 b :i64] :vector-i64
  (if (>= j end)
    (t2-s M t2-s-nb (inc b))
    (let [p (t2-g M t2-s-p)
          ;; a LABEL right after the LABEL that starts the current block is the same point: one block (nested and/or
          ;; joins meet in one phi, which can then thread)
          same (and (= (gn-op M j) OP-LABEL) (= (gn-op M (dec j)) OP-LABEL) (= (t2-bget M t2-a-bs b) (dec j)))
          lead (and (> j (inc p)) (not same)
                    (or (and (= (gn-op M j) OP-LABEL) (> (t2-g M (+ t2-a-lref (gn-sir M j IF-A))) 0))
                        (t2-term? (gn-op M (dec j)))
                        ;; after a real call (unless only its return follows: a tail call stays one block),
                        ;; so the charges after it can be batched (a block with a call is not)
                        (and (= (gn-op M (dec j)) OP-CALL) (not (t2-ret-follows? M j end)))))
          nb (if lead (inc b) b)]
      (if (>= nb t2-maxb)
        (t2-fail M 2)
        (t2-blocks (-> M (t2-s (+ t2-a-blk (- j p)) nb)
                       (cond-> lead (t2-bset t2-a-bs nb j))
                       (t2-bset t2-a-be nb j))
                   (inc j) end nb)))))
;; only local moves, constants and nops up to a RET from j on
(defn- t2-ret-follows? [M :vector-i64 j :i64 end :i64] :bool
  (cond (>= j end) false
        (= (gn-op M j) OP-RET) true
        (or (= (gn-op M j) OP-LSET) (= (gn-op M j) OP-LGET) (= (gn-op M j) OP-CONST) (= (gn-op M j) t2-op-nop)) (t2-ret-follows? M (inc j) end)
        :else false))
;; block of the LABEL l of this function, -1 when unknown
(defn- t2-lblk [M :vector-i64 l :i64] :i64
  (let [pos (if (and (> l 0) (< l 4096)) (t2-g M (+ (+ t2-a-st MM-FN-CAP) l)) 0) p (t2-g M t2-s-p)]
    (if (and (> pos p) (< pos (t2-g M t2-s-end)) (= (gn-op M pos) OP-LABEL) (= (gn-sir M pos IF-A) l))
      (t2-g M (+ t2-a-blk (- pos p))) -1)))
;; successors of every block
(defn- t2-succs [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (let [e (t2-bget M t2-a-be b) op (gn-op M e) nb (t2-g M t2-s-nb)
          next (if (< (inc b) nb) (inc b) -1)
          taken (cond (= op OP-BR) (t2-lblk M (gn-sir M e IF-A))
                      (or (= op OP-BRZ) (= op OP-BRNZ)) (t2-lblk M (gn-sir M e IF-B))
                      :else -1)
          fall (cond (or (= op OP-BR) (= op OP-RET) (= op OP-TRAP)) -1 :else next)
          bad (or (and (or (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ)) (< taken 0))
                  (and (not (t2-term? op)) (< next 0)))]
      (if bad (t2-fail M 5)
        (t2-succs (-> M (t2-bset t2-a-bt b (if (= taken fall) -1 taken)) (t2-bset t2-a-bf b fall)) (inc b))))))
;; an empty block J (labels/nops, then a BR or nothing): its single successor, -1 otherwise
(defn- t2-cth-empty [M :vector-i64 b :i64 J :i64] :i64
  (let [eJ (t2-bget M t2-a-be J) opJ (gn-op M eJ)
        S (cond (= opJ OP-BR) (t2-bget M t2-a-bt J)
                (or (= opJ OP-LABEL) (= opJ t2-op-nop)) (t2-bget M t2-a-bf J)
                :else -1)]
    (if (and (>= S 0) (not= S J) (not= S b) (t2-cth-only? M (t2-bget M t2-a-bs J) eJ)) S -1)))
;; branch threading on the block graph (before SSA): a block whose BRZ/BRNZ on temp t takes it to a block J holding only
;; labels/nops and a BRZ/BRNZ on the same t goes straight to J's successor for that known value (and/or chains)
(defn- t2-cth-only? [M :vector-i64 j :i64 e :i64] :bool   ; ops [j, e) are labels or nops
  (or (>= j e) (and (or (= (gn-op M j) OP-LABEL) (= (gn-op M j) t2-op-nop)) (t2-cth-only? M (inc j) e))))
(defn- t2-cth-dest [M :vector-i64 b :i64 J :i64 zero :bool] :i64   ; J's successor when t is zero/nonzero, -1 not threadable
  (if (or (< J 0) (= J b)) -1
    (let [e (t2-bget M t2-a-be b) eJ (t2-bget M t2-a-be J) opJ (gn-op M eJ)]
      (if (not (and (or (= opJ OP-BRZ) (= opJ OP-BRNZ)) (= (gn-sir M eJ IF-A) (gn-sir M e IF-A))
                    (t2-cth-only? M (t2-bget M t2-a-bs J) eJ)))
        (t2-cth-empty M b J)
        (let [jumps (if (= opJ OP-BRZ) zero (not zero)) tJ (t2-bget M t2-a-bt J) fJ (t2-bget M t2-a-bf J)
              S (if (and jumps (>= tJ 0)) tJ fJ)]
          (if (= S J) -1 S))))))
(defn- t2-cth-b [M :vector-i64 b :i64] :vector-i64
  (let [e (t2-bget M t2-a-be b) op (gn-op M e)]
    (if (not (or (= op OP-BRZ) (= op OP-BRNZ)))
      ;; a BR or a fallthrough into an empty block goes to its successor
      (let [T (t2-bget M t2-a-bt b) F (t2-bget M t2-a-bf b)
            ST (if (>= T 0) (t2-cth-empty M b T) -1) SF (if (>= F 0) (t2-cth-empty M b F) -1)]
        (if (and (< ST 0) (< SF 0)) M
          (-> M (cond-> (>= ST 0) (t2-bset t2-a-bt b ST)) (cond-> (>= SF 0) (t2-bset t2-a-bf b SF)) (t2-s t2-s-last 1))))
      ;; the taken edge sees t zero after a BRZ (nonzero after a BRNZ), the fallthrough edge the opposite
      (let [T (t2-bget M t2-a-bt b) F (t2-bget M t2-a-bf b)
            ST (t2-cth-dest M b T (= op OP-BRZ)) SF (t2-cth-dest M b F (not (= op OP-BRZ)))
            T1 (if (>= ST 0) ST T) F1 (if (>= SF 0) SF F)]
        (if (and (< ST 0) (< SF 0)) M
          (-> M (t2-bset t2-a-bt b (if (= T1 F1) -1 T1)) (t2-bset t2-a-bf b F1) (t2-s t2-s-last 1)))))))
(defn- t2-cth-pass [M :vector-i64 b :i64 ch :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) (t2-s M t2-s-last ch)
    (let [M1 (t2-cth-b (t2-s M t2-s-last 0) b)] (t2-cth-pass M1 (inc b) (if (= (t2-last M1) 1) 1 ch)))))
(defn- t2-cth-fix [M :vector-i64 i :i64] :vector-i64
  (if (>= i 8) M (let [M1 (t2-cth-pass M 0 0)] (if (= (t2-last M1) 1) (t2-cth-fix M1 (inc i)) M1))))
;; reachability from block 0 (worklist over block order until stable)
(defn- t2-reach1 [M :vector-i64 b :i64 changed :bool] :vector-i64
  (if (>= b (t2-g M t2-s-nb))
    (if changed (t2-reach1 M 0 false) M)
    (if (= (t2-bget M t2-a-breach b) 1)
      (let [t (t2-bget M t2-a-bt b) f (t2-bget M t2-a-bf b)
            c1 (and (>= t 0) (= (t2-bget M t2-a-breach t) 0))
            c2 (and (>= f 0) (= (t2-bget M t2-a-breach f) 0))]
        (t2-reach1 (-> M (cond-> c1 (t2-bset t2-a-breach t 1)) (cond-> c2 (t2-bset t2-a-breach f 1)))
                   (inc b) (or changed c1 c2)))
      (t2-reach1 M (inc b) changed))))
;; preds: count, offsets, fill (reachable sources only); max pred index
(defn- t2-addpred-count [M :vector-i64 s :i64 b :i64] :vector-i64
  (if (< s 0) M (-> M (t2-bset t2-a-bpn s (inc (t2-bget M t2-a-bpn s)))
                      (t2-bset t2-a-bmaxp s (gn-max (t2-bget M t2-a-bmaxp s) b)))))
(defn- t2-pcount [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-pcount (if (= (t2-bget M t2-a-breach b) 1)
                 (-> M (t2-addpred-count (t2-bget M t2-a-bt b) b) (t2-addpred-count (t2-bget M t2-a-bf b) b)) M)
               (inc b))))
;; NB: M is mutated in place, so the count is read BEFORE the reset in the same call
(defn- t2-poff [M :vector-i64 b :i64 acc :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb))
    (if (> acc t2-maxpred) (t2-fail M 6) M)
    (let [n (t2-bget M t2-a-bpn b)]
      (t2-poff (-> M (t2-bset t2-a-bp0 b acc) (t2-bset t2-a-bpn b 0)) (inc b) (+ acc n)))))
(defn- t2-addpred [M :vector-i64 s :i64 b :i64] :vector-i64
  (if (< s 0) M
    (let [k (t2-bget M t2-a-bpn s)]
      (-> M (t2-s (+ t2-a-pred (t2-bget M t2-a-bp0 s) k) b) (t2-bset t2-a-bpn s (inc k))))))
(defn- t2-pfill [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-pfill (if (= (t2-bget M t2-a-breach b) 1)
                (-> M (t2-addpred (t2-bget M t2-a-bt b) b) (t2-addpred (t2-bget M t2-a-bf b) b)) M)
              (inc b))))
(defn- t2-pred [M :vector-i64 b :i64 k :i64] :i64 (t2-g M (+ t2-a-pred (t2-bget M t2-a-bp0 b) k)))
(defn- t2-clear-blocks [M :vector-i64 b :i64] :vector-i64
  (if (>= b t2-maxb) M
    (t2-clear-blocks (-> M (t2-bset t2-a-bpn b 0) (t2-bset t2-a-bmaxp b -1) (t2-bset t2-a-bseal b 0)
                           (t2-bset t2-a-bphi b 0) (t2-bset t2-a-breach b 0) (t2-bset t2-a-bt b -1) (t2-bset t2-a-bf b -1))
                     (inc b))))
(defn- t2-cfg [M :vector-i64] :vector-i64
  (let [p (t2-g M t2-s-p) end (t2-g M t2-s-end)
        M1 (-> M (t2-clear-blocks 0) (t2-bset t2-a-bs 0 (inc p)) (t2-blocks (inc p) end 0))]
    (if (not= (t2-g M1 t2-s-fail) 0) M1
      (let [M2 (t2-succs M1 0)]
        (if (not= (t2-g M2 t2-s-fail) 0) M2
          (-> M2 (t2-cth-fix 0) (t2-bset t2-a-breach 0 1) (t2-reach1 0 false) (t2-pcount 0) (t2-poff 0 0) (t2-pfill 0)
              ;; bphi was used as scratch by t2-poff: reset
              (t2-clear-phis 0)))))))
(defn- t2-clear-phis [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M (t2-clear-phis (t2-bset M t2-a-bphi b 0) (inc b))))

;; ---- SSA (Braun et al.) -------------------------------------------------------------------------------------------------
(defn- t2-new [M :vector-i64 op :i64 a :i64 b :i64 c :i64 blk :i64] :vector-i64
  (let [v (inc (t2-g M t2-s-nv))]
    (if (>= v t2-maxv)
      (-> M (t2-fail 3) (t2-s t2-s-last 0))
      (-> M (t2-s t2-s-nv v) (t2-vs v t2-f-op op) (t2-vs v t2-f-a a) (t2-vs v t2-f-b b) (t2-vs v t2-f-c c)
          (t2-vs v t2-f-blk blk) (t2-vs v t2-f-link 0) (t2-vs v t2-f-repl 0) (t2-vs v t2-f-reg -1) (t2-s t2-s-last v)))))
(defn- t2-res [M :vector-i64 v :i64] :i64
  (if (or (<= v 0) (= (t2-vf M v t2-f-repl) 0)) v (t2-res M (t2-vf M v t2-f-repl))))
(defn- t2-defget [M :vector-i64 var :i64 b :i64] :i64 (t2-g M (+ t2-a-def (* var t2-maxb) b)))
(defn- t2-defset [M :vector-i64 var :i64 b :i64 v :i64] :vector-i64 (t2-s M (+ t2-a-def (* var t2-maxb) b) v))
(defn- t2-phi-link [M :vector-i64 b :i64 v :i64] :vector-i64
  (-> M (t2-vs v t2-f-link (t2-bget M t2-a-bphi b)) (t2-bset t2-a-bphi b v)))
(def t2-s-depth 28)
;; walk single-pred sealed blocks without a def back to the first block that has a def, is unsealed, or merges
(defn- t2-chain-end [M :vector-i64 var :i64 c :i64] :i64
  (if (and (= (t2-defget M var c) 0) (= (t2-bget M t2-a-bseal c) 1) (= (t2-bget M t2-a-bpn c) 1))
    (t2-chain-end M var (t2-pred M c 0))
    c))
(defn- t2-chain-fill [M :vector-i64 var :i64 c :i64 stop :i64 v :i64] :vector-i64
  (if (= c stop) M (t2-chain-fill (t2-defset M var c v) var (t2-pred M c 0) stop v)))
(defn- t2-read [M :vector-i64 var :i64 b :i64] :vector-i64
  (let [d (t2-defget M var b)]
    (if (> d 0) (t2-s M t2-s-last (t2-res M d))
      (let [c (t2-chain-end M var b)
            dc (t2-defget M var c)
            M1 (if (> dc 0) (t2-s M t2-s-last (t2-res M dc)) (t2-read-rec M var c))
            v (t2-last M1)]
        (t2-s (t2-chain-fill M1 var b c v) t2-s-last v)))))
(defn- t2-read-rec [M :vector-i64 var :i64 b :i64] :vector-i64
  (cond (not= (t2-g M t2-s-fail) 0) (t2-s M t2-s-last 0)
        (> (t2-g M t2-s-depth) 40) (-> M (t2-fail 17) (t2-s t2-s-last 0))
        (= (t2-bget M t2-a-bseal b) 0)
        (let [M1 (t2-new M t2-phi 0 0 var b) v (t2-last M1)]
          (-> M1 (t2-phi-link b v) (t2-defset var b v) (t2-s t2-s-last v)))
        (= (t2-bget M t2-a-bpn b) 0)
        (let [M1 (t2-new M t2-undef 0 0 0 b) v (t2-last M1)]
          (-> M1 (t2-defset var b v) (t2-s t2-s-last v)))
        (= (t2-bget M t2-a-bpn b) 1)
        (let [M1 (t2-read M var (t2-pred M b 0)) v (t2-last M1)]
          (-> M1 (t2-defset var b v) (t2-s t2-s-last v)))
        :else
        (let [M1 (t2-new M t2-phi 0 0 var b) v (t2-last M1)
              M2 (-> M1 (t2-phi-link b v) (t2-defset var b v)
                     (t2-s t2-s-depth (inc (t2-g M1 t2-s-depth)))
                     (t2-phi-ops v var b))
              M3 (t2-s M2 t2-s-depth (dec (t2-g M2 t2-s-depth)))]
          (t2-s M3 t2-s-last (t2-res M3 v)))))
(defn- t2-phi-ops [M :vector-i64 v :i64 var :i64 b :i64] :vector-i64
  (let [n (t2-bget M t2-a-bpn b) start (t2-g M t2-s-nphi)]
    (if (> (+ start n) t2-maxphi)
      (t2-fail M 4)
      (t2-phi-trivial (t2-phi-fill (-> M (t2-s t2-s-nphi (+ start n)) (t2-vs v t2-f-a start) (t2-vs v t2-f-b n))
                                   var b 0 n start)
                      v))))
(defn- t2-phi-fill [M :vector-i64 var :i64 b :i64 k :i64 n :i64 start :i64] :vector-i64
  (if (>= k n) M
    (let [M1 (t2-read M var (t2-pred M b k))]
      (t2-phi-fill (t2-s M1 (+ t2-a-phiop start k) (t2-last M1)) var b (inc k) n start))))
(defn- t2-phi-same [M :vector-i64 v :i64 start :i64 k :i64 n :i64 s :i64] :i64
  (if (>= k n) s
    (let [x (t2-res M (t2-g M (+ t2-a-phiop start k)))]
      (cond (or (= x v) (= x s)) (t2-phi-same M v start (inc k) n s)
            (not= s 0) -1
            :else (t2-phi-same M v start (inc k) n x)))))
(defn- t2-phi-trivial [M :vector-i64 v :i64] :vector-i64
  (let [same (t2-phi-same M v (t2-vf M v t2-f-a) 0 (t2-vf M v t2-f-b) 0)]
    (if (> same 0) (t2-vs M v t2-f-repl same) M)))
(defn- t2-seal-phis [M :vector-i64 b :i64 v :i64] :vector-i64
  (if (= v 0) M
    (let [nxt (t2-vf M v t2-f-link)]
      (t2-seal-phis (if (and (= (t2-vf M v t2-f-b) 0) (= (t2-vf M v t2-f-repl) 0))
                      (t2-phi-ops M v (t2-vf M v t2-f-c) b) M)
                    b nxt))))
(defn- t2-seal [M :vector-i64 b :i64] :vector-i64
  (t2-seal-phis (t2-bset M t2-a-bseal b 1) b (t2-bget M t2-a-bphi b)))
;; after finishing block b: seal every unsealed reachable block h <= b whose preds are all <= b
(defn- t2-seal-after [M :vector-i64 h :i64 b :i64] :vector-i64
  (if (> h b) M
    (t2-seal-after (if (and (= (t2-bget M t2-a-breach h) 1) (= (t2-bget M t2-a-bseal h) 0)
                            (<= (t2-bget M t2-a-bmaxp h) b))
                     (t2-seal M h) M)
                   (inc h) b)))
;; ---- M3a: T2-private SIR expansion with call inlining ------------------------------------------------------------------
;; F's SIR is copied into the free tail of the SIR region (beyond MM-SIR-N, never read by anything else) with labels renamed
;; to local ids (t2-a-lpos: local label -> buffer index) and every CALL to an inlinable callee g expanded in place:
;;   LSET args ; g's body (temps +t, slots into a fresh block, labels renamed, RET 0 -> BR exit) ; LABEL exit [; PUB]
;; Fuel publication mirrors the existing backend exactly. Buffer FUEL a = 1: a published charge (subs + store), a = 0: an
;; unpublished charge (subs only); T2-PUB publishes x8. F as gen compiled it: a leaf keeps every charge unpublished (its
;; calls are wrapper calls gen inlines into its x8 counter); a nonleaf publishes its own charges and those of wrapper calls;
;; a non-wrapper call to a gen-LEAF g runs g's charges unpublished and publishes at g's exit (g's RET stored x8), a call to a
;; gen-nonleaf g keeps g's charges published.
(def t2-op-pub 27)                 ; buffer-only opcode: publish x8
(def t2-a-lpos (+ t2-a-st MM-FN-CAP)) ; local label -> buffer index (4096)
(def t2-maxlab 4096)
(def t2-s-xo 30)      ; next buffer index
(def t2-s-xlab 31)    ; next local label id
(def t2-s-xns 32)     ; slots allocated so far
(def t2-s-xdp 33)     ; max temp + 1
(def t2-s-xb 34)      ; buffer start
(defn- t2-xput [M :vector-i64 op :i64 a :i64 b :i64 c :i64] :vector-i64
  (let [o (t2-g M t2-s-xo)]
    (if (>= (+ o 2) MM-SIR-CAP) (t2-fail M 20)
      (-> M (gn-put (+ MM-SIR-BASE (* o MM-SIR-W) IF-OP) op) (gn-put (+ MM-SIR-BASE (* o MM-SIR-W) IF-A) a)
          (gn-put (+ MM-SIR-BASE (* o MM-SIR-W) IF-B) b) (gn-put (+ MM-SIR-BASE (* o MM-SIR-W) IF-C) c)
          (t2-s t2-s-xo (inc o))
          (cond-> (>= (- (inc o) (t2-g M t2-s-xb)) t2-maxops) (t2-fail 21))))))
(defn- t2-xdepth [M :vector-i64 d :i64] :vector-i64 (if (> d (t2-g M t2-s-xdp)) (t2-s M t2-s-xdp d) M))
;; label range of the function body starting at i: lo * 2^20 + hi (lo = -1 when none)
(defn- t2-xlrange [M :vector-i64 i :i64 lo :i64 hi :i64] :i64
  (let [op (gn-op M i) l (gn-sir M i IF-A)]
    (cond (or (= op OP-END) (= op 0)) (if (< lo 0) -1 (+ (* lo 1048576) hi))
          (= op OP-LABEL) (t2-xlrange M (inc i) (if (or (< lo 0) (< l lo)) l lo) (if (> l hi) l hi))
          :else (t2-xlrange M (inc i) lo hi))))
;; conditional branches and ops of a callee body (inline only small, nearly branch-free callees: a decision tree inlined as
;; branches mispredicts where the existing backend may have turned it into a lookup table)
(defn- t2-xcost [M :vector-i64 i :i64 nbr :i64 nops :i64] :i64
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) (+ (* nbr 65536) nops)
          (or (= op OP-BRZ) (= op OP-BRNZ)) (t2-xcost M (inc i) (inc nbr) (inc nops))
          :else (t2-xcost M (inc i) nbr (inc nops)))))
;; does the body from i only contain T2 ops and CALLs (checked separately)?
(defn- t2-xops-ok? [M :vector-i64 i :i64] :bool
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) true
          (or (t2-op-ok? M i) (= op OP-CALL)) (t2-xops-ok? M (inc i))
          :else false)))
;; gen-leafness of callee g from its SIR: every RT inline at its own temp and every CALL a wrapper call
(defn- t2-gleaf? [M :vector-i64 i :i64] :bool
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) true
          (and (= op OP-RT) (not (gn-inl (gn-sir M i IF-A) (gn-sir M i IF-B) (gn-sir M i IF-C)))) false
          (and (= op OP-CALL) (= (gn-call-wrapper M i (gn-sir M i IF-A) (gn-sir M i IF-B) (gn-sir M i IF-C)) 0)) false
          :else (t2-gleaf? M (inc i)))))
;; arguments of the call at the buffer end (temps t+1 .. t+n-1) set by a CONST among the n+1 preceding ops
(defn- t2-constargs [M :vector-i64 t :i64 n :i64] :i64
  (let [o (t2-g M t2-s-xo) lo (gn-max (t2-g M t2-s-xb) (- o (+ n 1)))]
    (loop [i (dec o) c 0]
      (if (< i lo) c
        (recur (dec i) (if (and (= (gn-op M i) OP-CONST) (> (gn-sir M i IF-A) t) (< (gn-sir M i IF-A) (+ t n))) (inc c) c))))))
(def t2-s-inlops 58)
(def t2-s-inlraw 59)
(def t2-s-xnsmax 60)
;; a callee whose call passes mostly constant arguments specializes by folding: larger branch/op limits
(defn- t2-callee-big? [M :vector-i64 t :i64 n :i64] :bool
  (and (not= (t2-g M t2-s-xlvl) 1) (> n 1) (>= (* 2 (t2-constargs M t n)) (dec n))))
(defn- t2-callee-ok? [M :vector-i64 g :i64 n :i64 depth :i64] :bool (t2-callee-ok2? M g n depth false))
;; the SIR body from i contains a call with mostly constant arguments to a callee that itself calls
(defn- t2-spec-link? [M :vector-i64 i :i64] :bool
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) false
          (= op OP-CALL)
          (let [h (gn-sir M i IF-A) t (gn-sir M i IF-B) n (gn-sir M i IF-C)
                q (if (and (> h 0) (< h (vector-at M MM-FN-N))) (gn-fnf M h FF-SIR) 0)
                kc (loop [j (dec i) c 0 k 0] (if (or (> k n) (<= j 0)) c
                                                (recur (dec j) (if (and (= (gn-op M j) OP-CONST) (> (gn-sir M j IF-A) t) (< (gn-sir M j IF-A) (+ t n))) (inc c) c) (inc k))))]
            (or (and (> n 1) (>= (* 2 kc) (dec n)) (> q 0) (< q (vector-at M MM-SIR-N)) (not (t2-callfree? M (inc q))))
                (t2-spec-link? M (inc i))))
          :else (t2-spec-link? M (inc i)))))
(defn- t2-callfree? [M :vector-i64 i :i64] :bool
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) true
          (or (= op OP-CALL) (= op OP-CALLI)) false
          :else (t2-callfree? M (inc i)))))
(defn- t2-leafy-calls? [M :vector-i64 i :i64] :bool
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) true
          (= op OP-CALLI) false
          (= op OP-CALL) (let [h (gn-sir M i IF-A) q (if (and (> h 0) (< h (vector-at M MM-FN-N))) (gn-fnf M h FF-SIR) 0)]
                           (and (> q 0) (< q (vector-at M MM-SIR-N)) (t2-callfree? M (inc q)) (t2-leafy-calls? M (inc i))))
          :else (t2-leafy-calls? M (inc i)))))
(defn- t2-callee-ok2? [M :vector-i64 g :i64 n :i64 depth :i64 big :bool] :bool
  (and (t2-callee-pre? M g n depth big) (t2-callee-small? M g big)))
;; every requirement except the size: the expansion is tried (t2-xcall) and kept when it is small after branch-free
;; conversion (decision trees become one table lookup, cheap diamonds selects)
(defn- t2-callee-pre? [M :vector-i64 g :i64 n :i64 depth :i64 big :bool] :bool
  (let [k (gn-fnf M g FF-KIND) p (gn-fnf M g FF-SIR)]
    (and (> g 0) (< g (vector-at M MM-FN-N)) (<= depth 3) (not= g (t2-g M t2-s-f))
         (or (= k FK-DEFN) (= k FK-PRIV)) (not (lw-tmpl? M g)) (not (lw-spec? M g)) (not (gn-clamp-open M g))
         (> p 0) (< p (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) g)
         (= (gn-fnf M g FF-NPARAMS) n) (= (gn-sir M p IF-B) n)
         (t2-xops-ok? M (inc p)) (not (t2-loops? M (inc p)))
         (not= (t2-g M (+ t2-a-st g)) 4)   ; a kernel carrying the keep marker stays a real call
         ;; ordinary inlining skips a link that itself specializes a non-leaf callee with constant arguments (each
         ;; inlined link would expand another copy): it stays a real call that specializes once
         ;; (replacing a prepaid kernel, whose fast path may hold the link's own fast path, the link is inlined and its
         ;; specializing callee called: t2-s-xcred)
         (or big (= (t2-g M t2-s-weak) 1) (= (t2-g M t2-s-weakr) 1) (not (t2-spec-link? M (inc p))))
         (<= (- (t2-xcost M (inc p) 0 0) (* (quot (t2-xcost M (inc p) 0 0) 65536) 65536)) 512))))
;; the size rule: at most 3 conditional branches and 64 ops (8 and 192 for a constant-argument specialization)
(defn- t2-callee-small? [M :vector-i64 g :i64 big :bool] :bool
  (let [c (t2-xcost M (inc (gn-fnf M g FF-SIR)) 0 0)]
    (if big (and (<= (quot c 65536) 8) (<= (- c (* (quot c 65536) 65536)) 192))
      (and (<= (quot c 65536) 3) (<= (- c (* (quot c 65536) 65536)) 64)))))
;; copy the body from i (until END) into the buffer. to/so: temp/slot offsets; lb/lo: local label base and the body's lowest
;; label; ex: local exit label (0 at the top: RET stays RET); pub: 1 = charges published; d: inline depth.
(defn- t2-xcopy [M :vector-i64 i :i64 to :i64 so :i64 lb :i64 lo :i64 ex :i64 pub :i64 d :i64] :vector-i64
  (let [op (gn-op M i) a (gn-sir M i IF-A) b (gn-sir M i IF-B) c (gn-sir M i IF-C)]
    (cond
      (or (= op OP-END) (= op 0) (not= (t2-g M t2-s-fail) 0)) M
      (= op OP-CALL)
      ;; (a call of F's own body: the ops of F after it still need buffer room, t2-s-xleft)
      (t2-xcopy (t2-xcall (cond-> M (= ex 0) (t2-s t2-s-xleft (- (t2-g M t2-s-xend) i))) i a (+ b to) c so d pub) (inc i) to so lb lo ex pub d)
      :else
      (let [M1 (case op
                 OP-LABEL (let [l (+ lb (- a lo))]
                            (if (or (< l 1) (>= l t2-maxlab)) (t2-fail M 22)
                              (-> M (t2-s (+ t2-a-lpos l) (t2-g M t2-s-xo)) (t2-xput OP-LABEL l 0 0))))
                 OP-BR (t2-xput M OP-BR (+ lb (- a lo)) 0 0)
                 (OP-BRZ OP-BRNZ) (t2-xput M op (+ a to) (+ lb (- b lo)) 0)
                 ;; an inlined callee's final RET falls into the exit label (which then need not start a block)
                 OP-RET (cond (= ex 0) (t2-xput M OP-RET (+ a to) 0 0)
                              (= (gn-op M (inc i)) OP-END) M
                              :else (t2-xput M OP-BR ex 0 0))
                 OP-FUEL (t2-xput M OP-FUEL pub 0 0)
                 (OP-CONST OP-TAB) (t2-xput M op (+ a to) b c)
                 OP-LGET (t2-xput M op (+ a to) (+ b so) c)
                 OP-LSET (t2-xput M op (+ a so) (+ b to) c)
                 (OP-BIN OP-CMP OP-UN OP-RT) (t2-xput M op a (+ b to) c)
                 (t2-xput M op a b c))]
        (t2-xcopy (t2-xdepth M1 (+ to 1 (gn-max 0 (lw-hi op a b c)))) (inc i) to so lb lo ex pub d)))))
;; expand CALL g (global SIR index j) whose arguments sit in buffer temps t.. ; so: caller slot offset
(def t2-s-hascall 35)
;; LABEL l defined after index i, before the END
(defn- t2-fwd? [M :vector-i64 i :i64 l :i64] :bool
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) false
          (and (= op OP-LABEL) (= (gn-sir M i IF-A) l)) true
          :else (t2-fwd? M (inc i) l))))
;; a callee the existing backend would call plainly: large, or itself calling, or looping (its call-site
;; specializations -- scalar DAG inlining, wrappers, readers, masks, clamps -- all target small straight-line callees)
(defn- t2-big-callee? [M :vector-i64 i :i64 n :i64] :bool
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) (> n 48)
          (or (= op OP-CALL) (= op OP-CALLI)) true
          (and (= op OP-BR) (not (t2-fwd? M i (gn-sir M i IF-A)))) true
          :else (t2-big-callee? M (inc i) (inc n)))))
;; a real (BL) call: published caller mode only, at most 7 arguments, no two-register result, a defn callee with code
(defn- t2-realcall-ok? [M :vector-i64 j :i64 g :i64 n :i64 pub :i64] :bool
  (let [k (gn-fnf M g FF-KIND)]
    (and (= pub 1) (<= n 31) (> g 0) (< g (vector-at M MM-FN-N)) (or (= k FK-DEFN) (= k FK-PRIV))
         (not (lw-tmpl? M g)) (not (gn-clamp-open M g)) (> (gn-fnf M g FF-SIR) 0)
         (not= (gn-op M (inc j)) OP-RES2)
         ;; the existing backend called g plainly at least as often, or g loops (its call-site specializations only
         ;; target small straight-line callees; strong kernels that fuse loops are never replaced)
         (or (< (t2-new-calls M g (t2-g M t2-s-xb) 0) (t2-old-calls M g (t2-g M t2-s-fix0) 0))
             (t2-loops? M (inc (gn-fnf M g FF-SIR)))
             (t2-xcred? M g)))))
;; inside the inlined copy of a callee the existing backend called plainly: the old code made that call, which ran g (or its
;; own inlined copy of g) -- no more calls than before. Replacing a prepaid kernel, whose fast path may hold its own copy of
;; a call-free g (its call-site specializations -- scalar DAG inlining, wrappers, readers, masks, clamps, tree tables -- only
;; target call-free callees), only a g that calls itself.
(defn- t2-xcred? [M :vector-i64 g :i64] :bool
  (and (= (t2-g M t2-s-xcred) 1) (not= (t2-g M t2-s-xlvl) 1)
       (or (and (= (t2-g M t2-s-weak) 0) (= (t2-g M t2-s-weakr) 0)) (not (t2-callfree? M (inc (gn-fnf M g FF-SIR)))))))
;; FX-BL26 fixups the existing backend emitted for FN f targeting g (it called g plainly that many times)
(def t2-s-fix0 37)
(def t2-s-xcred 90)   ; 1 while expanding (the inlined copy of) a callee the existing backend called plainly
(def t2-s-xlvl 92)    ; retries (t2-end): 2 after a buffer failure, expansions leave room for the rest of F; 1 after a register
                      ; failure (or a second one), only small callees are inlined and nothing is credited
(def t2-s-xsp 93)     ; callees being expanded (t2-a-xstk)
(def t2-s-xtry 94)    ; expansions tried
(def t2-s-xleft 95)   ; ops of F's own body after its current call (an expansion leaves room for them)
(def t2-s-xend 96)    ; SIR index of F's END
(def t2-xstk-n 256)
(def t2-xtry-max 65536)
(def t2-a-xstk (- t2-a-sx t2-xstk-n))
(defn- t2-xactive? [M :vector-i64 g :i64 k :i64 sp :i64] :bool
  (and (< k sp) (or (= (t2-g M (+ t2-a-xstk k)) g) (t2-xactive? M g (inc k) sp))))
(def t2-s-credit (+ t2-a-sx 2))   ; words the size rule allows beyond the old body (inlined string readers)
(def t2-str-credit 32)
(defn- t2-old-calls [M :vector-i64 g :i64 k :i64 n :i64] :i64
  (if (>= k (vector-at M MM-FIX-N)) n
    (let [b (+ MM-FIX-BASE (* k MM-FIX-W))]
      ;; a private-entry (chain protocol) call to a chain target is a plain call with a descriptor handoff
      (t2-old-calls M g (inc k) (if (and (= (vector-at M (+ b XF-KIND)) FX-BL26) (= (vector-at M (+ b XF-TARGET)) g)
                                         (or (= (vector-at M (+ b XF-AUX)) 0) (gn-chain-target M g))) (inc n) n)))))
;; real calls to g already in the T2 buffer
(defn- t2-new-calls [M :vector-i64 g :i64 i :i64 n :i64] :i64
  (if (>= i (t2-g M t2-s-xo)) n
    (t2-new-calls M g (inc i) (if (and (= (gn-op M i) OP-CALL) (= (gn-sir M i IF-A) g)) (inc n) n))))
(defn- t2-xcall-out [M :vector-i64 j :i64 g :i64 t :i64 n :i64 pub :i64] :vector-i64
  ;; (diagnostic builds decode 23 + 1000 g as the refused callee)
  (cond (not (t2-realcall-ok? M j g n pub)) (t2-fail M (+ 23 (* 1000 g)))
        ;; replacing a (prepaid) kernel: its fast path may have inlined a small loop-free helper the T2 code would call
        ;; (a callee that makes calls itself is not such a helper: the old code calls it plainly too)
        (and (or (= (t2-g M t2-s-weak) 1) (= (t2-g M t2-s-weakr) 1)) (not (t2-loops? M (inc (gn-fnf M g FF-SIR))))
             (not (t2-xcred? M g)) (t2-callfree? M (inc (gn-fnf M g FF-SIR))))
        (t2-fail M (+ 29 (* 1000 g)))
        :else (-> M (t2-s t2-s-hascall 1) (t2-xput OP-CALL g t n))))
;; inline g when it is small (the size rule), or when its expansion is small after branch-free conversion: at most 2 (8
;; for a constant-argument specialization) conditional branches and 66 + n (194 + n) ops of its own (nested inlined
;; callees count apart). A refused expansion is dropped completely (buffer, labels, slots, temps, literal tables, size
;; credits, failure state) before g is called or refused as before.
(defn- t2-xcall [M :vector-i64 j :i64 g :i64 t :i64 n :i64 so :i64 d :i64 pub :i64] :vector-i64
  (let [big (t2-callee-big? M t n) sp (t2-g M t2-s-xsp)]
    ;; a callee already being expanded (recursion) is called; so are callees past the nesting and attempt bounds (a refused
    ;; expansion falls back to a real call, so expansions are tried again in every enclosing copy)
    (if (or (not (t2-callee-pre? M g n (inc d) big)) (t2-xactive? M g 0 sp) (>= sp t2-xstk-n) (>= (t2-g M t2-s-xtry) t2-xtry-max))
      (t2-xcall-out M j g t n pub)
      (let [o0 (t2-g M t2-s-xo) lab0 (t2-g M t2-s-xlab) ns0 (t2-g M t2-s-xns) dp0 (t2-g M t2-s-xdp) nsmax0 (t2-g M t2-s-xnsmax)
            lit0 (vector-at M MM-LIT-N) litb0 (vector-at M MM-LITB-N) fail0 (t2-g M t2-s-fail) hc0 (t2-g M t2-s-hascall)
            cvb0 (t2-g M t2-s-cvb) cvo0 (t2-g M t2-s-cvo) io0 (t2-g M t2-s-inlops) ir0 (t2-g M t2-s-inlraw) cr0 (t2-g M t2-s-credit)
            small (t2-callee-small? M g big)
            ;; a callee the existing backend called plainly from F: real calls inside its inlined copy are credited
            cred0 (t2-g M t2-s-xcred)
            cred (if (or (= cred0 1) (> (t2-old-calls M g (t2-g M t2-s-fix0) 0) (t2-new-calls M g (t2-g M t2-s-xb) 0))) 1 0)
            M1 (-> (t2-xinline (-> M (t2-s t2-s-cvb 0) (t2-s t2-s-cvo 0) (t2-s t2-s-xcred cred)
                                   (t2-s (+ t2-a-xstk sp) g) (t2-s t2-s-xsp (inc sp)) (t2-s t2-s-xtry (inc (t2-g M t2-s-xtry))))
                               j g t n d pub)
                   (t2-s t2-s-xcred cred0) (t2-s t2-s-xsp sp))
            o1 (t2-g M1 t2-s-xo)
            M2 (if (t2-ok? M1) (t2-cv-region M1 o0 o1 lab0) M1)
            nbr (t2-nbr M2 o0 o1 0) nop (t2-nnop M2 o0 o1 0)]
        ;; an expansion that failed (a nested call refused) or (retry level 2) leaves no buffer room for the rest of F
        ;; falls back to calling g. Replacing a prepaid kernel, whose fast path may hold its own range-proven table for a decision tree,
        ;; a converted expansion holds no tree table.
        (if (and (t2-ok? M2) (or (not= (t2-g M2 t2-s-xlvl) 2) (<= (- o1 (t2-g M2 t2-s-xb)) (- t2-maxops (+ (t2-g M2 t2-s-xleft) 32))))
                 (or small (and (not= (t2-g M2 t2-s-xlvl) 1) (<= (- nbr (t2-g M2 t2-s-cvb)) (if big 8 2))
                                (<= (- nop (t2-g M2 t2-s-cvo)) (+ (if big 194 66) n))
                                (or (and (= (t2-g M2 t2-s-weak) 0) (= (t2-g M2 t2-s-weakr) 0)) (not (t2-has-tab? M2 o0 o1))))
                     ;; replacing a prepaid kernel, a loop-free callee it could not call (its fast path inlined it): a larger
                     ;; expansion without tree tables
                     (and (not= (t2-g M2 t2-s-xlvl) 1) (or (= (t2-g M2 t2-s-weak) 1) (= (t2-g M2 t2-s-weakr) 1))
                          (not (t2-xcred? M2 g)) (<= (- nbr (t2-g M2 t2-s-cvb)) 16) (<= (- nop (t2-g M2 t2-s-cvo)) (+ 256 n))
                          (not (t2-has-tab? M2 o0 o1)))))
          ;; the size credit of the inlined ops is at most what remains after the conversion
          (-> M2 (t2-s t2-s-cvb (+ cvb0 nbr)) (t2-s t2-s-cvo (+ cvo0 nop))
              (t2-s t2-s-inlops (+ io0 (gn-min (- (t2-g M2 t2-s-inlops) io0) (* (if big 2 1) nop))))
              (t2-s t2-s-inlraw (+ ir0 (gn-min (- (t2-g M2 t2-s-inlraw) ir0) nop))))
          (t2-xcall-out (-> M2 (t2-s t2-s-xo o0) (t2-s t2-s-xlab lab0) (t2-s t2-s-xns ns0) (t2-s t2-s-xdp dp0) (t2-s t2-s-xnsmax nsmax0)
                            (gn-put MM-LIT-N lit0) (gn-put MM-LITB-N litb0) (t2-s t2-s-fail fail0) (t2-s t2-s-hascall hc0)
                            (t2-s t2-s-cvb cvb0) (t2-s t2-s-cvo cvo0)
                            (t2-s t2-s-inlops io0) (t2-s t2-s-inlraw ir0) (t2-s t2-s-credit cr0))
                        j g t n pub))))))
(defn- t2-has-tab? [M :vector-i64 i :i64 e :i64] :bool
  (and (< i e) (or (= (gn-op M i) t2-op-dtab) (= (gn-op M i) OP-TAB) (t2-has-tab? M (inc i) e))))
(defn- t2-xinline [M :vector-i64 j :i64 g :i64 t :i64 n :i64 d :i64 pub :i64] :vector-i64
    (let [p (gn-fnf M g FF-SIR)
          wrapper (> (gn-call-wrapper M j g (gn-sir M j IF-B) n) 0)
          leaf (t2-gleaf? M (inc p))
          ;; region mode: wrapper -> caller's mode; leaf g -> unpublished then PUB at exit (when caller publishes)
          gpub (cond wrapper pub leaf 0 :else 1)
          pubexit (and (not wrapper) leaf (= pub 1))
          rng (t2-xlrange M (inc p) -1 -1)
          lo (if (< rng 0) 0 (quot rng 1048576))
          hi (if (< rng 0) -1 (- rng (* (quot rng 1048576) 1048576)))
          lb (t2-g M t2-s-xlab)
          ex (+ lb (inc (- hi lo)))
          gs (gn-max (gn-max (gn-fnf M g FF-NSLOTS) (gn-sir M p IF-C)) (gn-max n (gn-scan M (inc p) 2 0)))
          sb (t2-g M t2-s-xns)
          M0 (-> M (t2-s t2-s-xlab (inc ex)) (t2-s t2-s-xns (+ sb gs)) (t2-s t2-s-xnsmax (gn-max (t2-g M t2-s-xnsmax) (+ sb gs))))
          M1 (loop [k 0 m M0] (if (>= k n) m (recur (inc k) (t2-xput m OP-LSET (+ sb k 1) (+ t k) 0))))
          ;; inlined ops earn a size credit (a constant-argument specialization twice as much)
          ops (bit-and (t2-xcost M1 (inc p) 0 0) 65535)
          M2 (t2-xcopy (-> M1 (t2-s t2-s-inlraw (+ (t2-g M1 t2-s-inlraw) ops))
                           (t2-s t2-s-inlops (+ (t2-g M1 t2-s-inlops) (* (if (t2-callee-big? M t n) 2 1) ops))))
                       (inc p) t sb lb lo ex gpub d)]
      ;; the callee's slots are dead after its exit: a later inline reuses them (the high-water mark sizes the frame)
      (if (or (>= ex t2-maxlab) (>= (+ sb gs) t2-maxvar)) (t2-fail M2 24)
        (-> M2 (t2-s (+ t2-a-lpos ex) (t2-g M2 t2-s-xo)) (t2-xput OP-LABEL ex 0 0)
            ;; a callee reading string code points is a real call in the old code (the host call makes it nonleaf,
            ;; outside every call-site specialization): its inlined copy is credited against the size rule
            (cond-> (= (bit-and (t2-str-ops M (inc p) 0) 2) 2) (t2-s t2-s-credit (+ (t2-g M2 t2-s-credit) t2-str-credit)))
            (cond-> pubexit (t2-xput t2-op-pub 0 0 0)) (t2-s t2-s-xns sb)))))
;; expand FN f (global p..end) into the buffer; returns M with t2-s-p/t2-s-end set to the buffer copy
(defn- t2-expand [M :vector-i64 p :i64 end :i64 f :i64 pub :i64] :vector-i64
  (let [B (+ (vector-at M MM-SIR-N) 8)
        np (gn-fnf M f FF-NPARAMS)
        ns (gn-max (gn-max (gn-sir M p IF-C) (gn-fnf M f FF-NSLOTS)) (gn-max np (gn-scan M (inc p) 2 0)))
        rng (t2-xlrange M (inc p) -1 -1)
        lo (if (< rng 0) 0 (quot rng 1048576))
        hi (if (< rng 0) -1 (- rng (* (quot rng 1048576) 1048576)))
        M0 (-> M (t2-s t2-s-xend end) (t2-s t2-s-xb B) (t2-s t2-s-xo B) (t2-s t2-s-xlab (+ 1 (inc (- hi lo)))) (t2-s t2-s-xns ns) (t2-s t2-s-xnsmax ns) (t2-s t2-s-xdp 0)
               (t2-xput OP-FN f np ns))
        M1 (t2-xcopy (t2-s M0 t2-s-lit0 (vector-at M0 MM-LIT-N)) (inc p) 0 0 1 lo 0 pub 0)
        M2 (t2-xput M1 OP-END f 0 0)]
    (-> M2 (t2-s t2-s-p B) (t2-s t2-s-end (dec (t2-g M2 t2-s-xo)))
        (t2-wzero t2-a-lref 0 t2-maxlab) (t2-lrefs B (t2-g M2 t2-s-xo)) (t2-cpz-scan B (t2-g M2 t2-s-xo))
        (cond-> (t2-ok? M2) (-> (t2-s t2-s-trk 0) (t2-tr-scan B (t2-g M2 t2-s-xo) 0) (t2-cv-top B (t2-g M2 t2-s-xo))
                                (t2-bth-fix B (t2-g M2 t2-s-xo) 0)))
        ;; the FN copy carries the grown slot count
        (gn-put (+ MM-SIR-BASE (* B MM-SIR-W) IF-C) (t2-g M2 t2-s-xnsmax)))))
;; ---- branch threading in the buffer: a BRZ/BRNZ on temp t whose target label is followed (past labels and nops) by
;; another BRZ/BRNZ on the same t goes straight to where that one goes, as t is the same there (and/or chains: the
;; join's block then has the right predecessors, so dominance, load CSE and loop rotation see through it)
(defn- t2-bth-skip [M :vector-i64 q :i64 e :i64] :i64   ; first op at or after q that is not a LABEL or nop
  (if (and (< q e) (or (= (gn-op M q) OP-LABEL) (= (gn-op M q) t2-op-nop))) (t2-bth-skip M (inc q) e) q))
(defn- t2-bth-at [M :vector-i64 i :i64 e :i64] :vector-i64
  (let [op (gn-op M i) t (gn-sir M i IF-A) L (gn-sir M i IF-B)
        q (if (and (> L 0) (< L t2-maxlab)) (t2-g M (+ t2-a-lpos L)) -1)]
    (if (or (< q 0) (>= q e) (not= (gn-op M q) OP-LABEL) (not= (gn-sir M q IF-A) L)) M
      (let [r (t2-bth-skip M q e) rop (if (< r e) (gn-op M r) 0)]
        (if (not (and (or (= rop OP-BRZ) (= rop OP-BRNZ)) (= (gn-sir M r IF-A) t) (not= r i))) M
          ;; t == 0 at L after a BRZ, t != 0 after a BRNZ; the second jumps when its condition holds, else falls
          (let [zero (= op OP-BRZ) jumps (if (= rop OP-BRZ) zero (not zero))
                L2 (cond jumps (gn-sir M r IF-B)
                         (and (< (inc r) e) (= (gn-op M (inc r)) OP-LABEL)) (gn-sir M (inc r) IF-A)
                         :else -1)]
            (if (or (<= L2 0) (>= L2 t2-maxlab) (= L2 L)) M
              (-> M (gn-put (+ MM-SIR-BASE (* i MM-SIR-W) IF-B) L2)
                  (t2-s (+ t2-a-lref L) (dec (t2-g M (+ t2-a-lref L))))
                  (t2-s (+ t2-a-lref L2) (inc (t2-g M (+ t2-a-lref L2))))
                  (t2-s t2-s-cvch 1)))))))))
(defn- t2-bth-pass [M :vector-i64 i :i64 e :i64] :vector-i64
  (if (>= i e) M
    (t2-bth-pass (if (or (= (gn-op M i) OP-BRZ) (= (gn-op M i) OP-BRNZ)) (t2-bth-at M i e) M) (inc i) e)))
(defn- t2-bth-fix [M :vector-i64 s :i64 e :i64 iter :i64] :vector-i64
  (if (>= iter 8) M
    (let [M1 (t2-bth-pass (t2-s M t2-s-cvch 0) s e)] (if (= (t2-g M1 t2-s-cvch) 1) (t2-bth-fix M1 s e (inc iter)) M1))))
;; branch references of every local label in the buffer [i, e): a LABEL nobody branches to does not start a block
(defn- t2-lrefs [M :vector-i64 i :i64 e :i64] :vector-i64
  (if (>= i e) M
    (let [op (gn-op M i)
          l (cond (= op OP-BR) (gn-sir M i IF-A) (or (= op OP-BRZ) (= op OP-BRNZ)) (gn-sir M i IF-B) :else -1)]
      (t2-lrefs (if (and (>= l 0) (< l t2-maxlab)) (t2-s M (+ t2-a-lref l) (inc (t2-g M (+ t2-a-lref l)))) M) (inc i) e))))
;; ---- the string scanning idiom (if (= i (string-length s)) 0 (string-code-point-at s i)), as lowered:
;;   LGET t I ; LGET t+1 S ; RT pair-second t+1 1 ; CMP EQ t ; BRZ t L1 ; CONST t 0 ; BR L2 ;
;;   LABEL L1 ; LGET t S ; LGET t+1 I ; RT code-point-at t 2 ; LABEL L2        (L1, L2 referenced only here)
;; becomes LGET t S ; LGET t+1 I ; RT cpz t 2 and nine no-ops (LABEL 0, never a branch target). t+1 is an expression
;; temp above the result t, dead after L2 on both paths.
(def t2-rt-cpz 100144)   ; buffer-only RT code
(defn- t2-sir-is? [M :vector-i64 j :i64 op :i64 a :i64 b :i64] :bool
  (and (= (gn-op M j) op) (= (gn-sir M j IF-A) a) (= (gn-sir M j IF-B) b)))
(defn- t2-cpz-at? [M :vector-i64 j :i64 e :i64] :bool
  (and (< (+ j 11) e) (= (gn-op M j) OP-LGET)
       (let [t (gn-sir M j IF-A) I (gn-sir M j IF-B) S (gn-sir M (inc j) IF-B)
             L1 (gn-sir M (+ j 4) IF-B) L2 (gn-sir M (+ j 6) IF-A)]
         (and (t2-sir-is? M (inc j) OP-LGET (inc t) S)
              (t2-sir-is? M (+ j 2) OP-RT RT-PAIR-SECOND (inc t)) (= (gn-sir M (+ j 2) IF-C) 1)
              (t2-sir-is? M (+ j 3) OP-CMP CC-EQ t)
              (= (gn-op M (+ j 4)) OP-BRZ) (= (gn-sir M (+ j 4) IF-A) t)
              (t2-sir-is? M (+ j 5) OP-CONST t 0)
              (= (gn-op M (+ j 6)) OP-BR)
              (= (gn-op M (+ j 7)) OP-LABEL) (= (gn-sir M (+ j 7) IF-A) L1)
              (t2-sir-is? M (+ j 8) OP-LGET t S) (t2-sir-is? M (+ j 9) OP-LGET (inc t) I)
              (t2-sir-is? M (+ j 10) OP-RT RT-STRING-CODE-POINT-AT t) (= (gn-sir M (+ j 10) IF-C) 2)
              (= (gn-op M (+ j 11)) OP-LABEL) (= (gn-sir M (+ j 11) IF-A) L2)
              (not= L1 L2) (> L1 0) (> L2 0) (< L1 t2-maxlab) (< L2 t2-maxlab) (not= I S)
              (= (t2-g M (+ t2-a-lref L1)) 1) (= (t2-g M (+ t2-a-lref L2)) 1)
              (t2-tdead? M (+ j 12) e (inc t) 64)))))
;; temp t is not read after index j in straight-line code before something at or below it is defined
(defn- t2-tdead? [M :vector-i64 j :i64 e :i64 t :i64 n :i64] :bool
  (let [op (gn-op M j) d (gn-defd M j)]
    (cond (or (>= j e) (<= n 0)) true
          (or (= op OP-LABEL) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ) (= op OP-RET) (= op OP-TRAP) (= op OP-END)) true
          ;; the branch-free buffer ops (part2x): SEL reads a b c and writes a, DTAB reads and writes a, NOP nothing
          (= op t2-op-nop) (t2-tdead? M (inc j) e t (dec n))
          (or (= op t2-op-sel) (= op t2-op-dtab))
          (cond (or (= (gn-sir M j IF-A) t) (and (= op t2-op-sel) (or (= (gn-sir M j IF-B) t) (= (gn-sir M j IF-C) t)))) false
                (<= (gn-sir M j IF-A) t) true
                :else (t2-tdead? M (inc j) e t (dec n)))
          (and (<= (gn-rlo M j) t) (<= t (gn-rhi M j))) false
          (and (>= d 0) (<= d t)) true
          :else (t2-tdead? M (inc j) e t (dec n)))))
(defn- t2-sir-set [M :vector-i64 j :i64 op :i64 a :i64 b :i64 c :i64] :vector-i64
  (-> M (gn-put (+ MM-SIR-BASE (* j MM-SIR-W) IF-OP) op) (gn-put (+ MM-SIR-BASE (* j MM-SIR-W) IF-A) a)
      (gn-put (+ MM-SIR-BASE (* j MM-SIR-W) IF-B) b) (gn-put (+ MM-SIR-BASE (* j MM-SIR-W) IF-C) c)))
(defn- t2-cpz-scan [M :vector-i64 j :i64 e :i64] :vector-i64
  (cond (>= j e) M
        (t2-cpz-at? M j e)
        (let [t (gn-sir M j IF-A) I (gn-sir M j IF-B) S (gn-sir M (inc j) IF-B) c (gn-sir M (+ j 8) IF-C) d (gn-sir M (+ j 9) IF-C)
              M1 (-> M (t2-sir-set j OP-LGET t S c) (t2-sir-set (inc j) OP-LGET (inc t) I d) (t2-sir-set (+ j 2) OP-RT t2-rt-cpz t 2))]
          (t2-cpz-scan (loop [k 3 m M1] (if (> k 11) m (recur (inc k) (t2-sir-set m (+ j k) OP-LABEL 0 0 0)))) (+ j 12) e))
        :else (t2-cpz-scan M (inc j) e)))
;; a looping callee (a BR back to an earlier label): the existing backend may run it as a certified kernel
(defn- t2-loops? [M :vector-i64 i :i64] :bool
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) false
          (and (= op OP-BR) (not (t2-fwd? M i (gn-sir M i IF-A)))) true
          :else (t2-loops? M (inc i)))))
;; ---- branch-free conversion of the buffer -------------------------------------------------------------------------------
;; Buffer-only ops: SEL t x y (temp t := temp t != 0 ? temp x : temp y), NOP, DTAB t lit packed (temp t := item
;; clamp(temp t, base, base + n - 1) - base of the literal table lit; never traps). A rewrite replaces the ops of one region
;; in place and never moves a LABEL that is still referenced.
;; (1) Decision trees over one slot x (t2-tr-scan): nested `x cc k ; BRZ|BRNZ t Le ; A ; BR Lx ; LABEL Le ; B ; LABEL Lx`
;;     (Le, Lx referenced once). Constant leaves: DTAB over a new literal with f(base) .. f(base + n - 1), base = least
;;     threshold - 1, n = greatest - least + 3. Every x below base (above base + n - 1) takes the path of base (of
;;     base + n - 1), so the clamp is exact for every x. Leaves `(vector-at LIT (- x c))` (TAB, range trap brk #0): one TAB
;;     over the pool-contiguous literals when every leaf's reach inside the merged range is exactly its own table, so every
;;     x gives the same item or the same brk #0 trap at the same point.
;; (2) Cheap diamonds/triangles (t2-cv-fix): arms that evaluate an expression into the branch temp t without effects (CONST
;;     LGET BIN CMP UN SEL DTAB; quot only by a constant other than 0 and -1: no trap, no charge, no store) are run in fresh
;;     temps t+1, t+2 and joined by a SEL, when the select needs no more instructions than the cheaper branch path. A join
;;     that feeds a branch on t directly is left to jump threading.
(def t2-op-sel 28)
(def t2-op-nop 29)
(def t2-op-dtab 30)
(def t2-s-cvb 64)    ; conditional branches left in finished nested inline regions
(def t2-s-cvo 65)    ; ops in finished nested inline regions
(def t2-s-cvch 66)   ; the last pass changed something
(def t2-s-lit0 67)   ; literal count when this function's compilation started (its new tables are deduplicated)
(def t2-s-trlo 68)   ; tree scan: least / greatest threshold, leaves, leaf kinds (1 constant, 2 table, 4 an = test), slot
(def t2-s-trhi 69)
(def t2-s-trn 70)
(def t2-s-trk 71)
(def t2-s-trx 72)
(def t2-a-tbadj (+ t2-a-hoff 4097))      ; per table: byte adjustment of its base register
(def t2-a-trl (+ t2-a-tbadj 16))         ; table leaves: 64 x (lit, items, offset c, reach lo, reach hi, -)
(def t2-maxleaf 64)
(def t2-dtmax 1024)
(def t2-inf 4611686018427387904)
(def t2-kmax 1099511627776)
(defn- t2-bput [M :vector-i64 i :i64 op :i64 a :i64 b :i64 c :i64] :vector-i64
  (let [w (+ MM-SIR-BASE (* i MM-SIR-W))]
    (-> M (gn-put (+ w IF-OP) op) (gn-put (+ w IF-A) a) (gn-put (+ w IF-B) b) (gn-put (+ w IF-C) c))))
(defn- t2-bnops [M :vector-i64 i :i64 e :i64] :vector-i64
  (if (>= i e) M (t2-bnops (t2-bput M i t2-op-nop 0 0 0) (inc i) e)))
;; op k copied to index d with its temps shifted by s
(defn- t2-bmove [M :vector-i64 d :i64 k :i64 s :i64] :vector-i64
  (let [op (gn-op M k) a (gn-sir M k IF-A) b (gn-sir M k IF-B) c (gn-sir M k IF-C)]
    (cond (or (= op OP-CONST) (= op OP-LGET) (= op t2-op-dtab)) (t2-bput M d op (+ a s) b c)
          (or (= op OP-BIN) (= op OP-CMP) (= op OP-UN)) (t2-bput M d op a (+ b s) c)
          (= op t2-op-sel) (t2-bput M d op (+ a s) (+ b s) (+ c s))
          :else (t2-bput M d op a b c))))
;; ops [k, e) to d.. (d <= k, in increasing order) with temps shifted by s
(defn- t2-bmoves [M :vector-i64 d :i64 k :i64 e :i64 s :i64] :vector-i64
  (if (>= k e) M (t2-bmoves (t2-bmove M d k s) (inc d) (inc k) e s)))
(defn- t2-lref [M :vector-i64 l :i64] :i64 (if (and (> l 0) (< l t2-maxlab)) (t2-g M (+ t2-a-lref l)) -1))
(defn- t2-lref-dec [M :vector-i64 l :i64] :vector-i64
  (if (and (> l 0) (< l t2-maxlab)) (t2-s M (+ t2-a-lref l) (dec (t2-g M (+ t2-a-lref l)))) M))
(defn- t2-nbr [M :vector-i64 i :i64 e :i64 n :i64] :i64
  (if (>= i e) n (t2-nbr M (inc i) e (if (or (= (gn-op M i) OP-BRZ) (= (gn-op M i) OP-BRNZ)) (inc n) n))))
(defn- t2-nnop [M :vector-i64 i :i64 e :i64 n :i64] :i64
  (if (>= i e) n (t2-nnop M (inc i) e (if (= (gn-op M i) t2-op-nop) n (inc n)))))
(defn- t2-skipnop [M :vector-i64 i :i64 e :i64] :i64
  (if (and (< i e) (= (gn-op M i) t2-op-nop)) (t2-skipnop M (inc i) e) i))
;; ---- (2) diamonds and triangles ----
(defn- t2-armop? [op :i64] :bool
  (or (= op OP-CONST) (= op OP-LGET) (= op OP-BIN) (= op OP-CMP) (= op OP-UN) (= op t2-op-sel) (= op t2-op-nop)
      (= op t2-op-dtab)))
(defn- t2-armend [M :vector-i64 i :i64 e :i64] :i64
  (if (and (< i e) (t2-armop? (gn-op M i))) (t2-armend M (inc i) e) i))
(defn- t2-wbit [w :i64 r :i64] :i64 (bit-or w (i64-shift-left 1 r)))
(defn- t2-hbit? [w :i64 r :i64] :bool (and (>= r 0) (< r 62) (not= (bit-and w (i64-shift-left 1 r)) 0)))
;; arm [i, j) into temp t: cost * 256 + its highest temp (relative to t); -1 unless every op is effect-free, uses only
;; temps >= t, reads only temps written before inside the arm, and the last op writes t
(defn- t2-arm [M :vector-i64 i :i64 j :i64 t :i64] :i64
  (loop [k i w 0 cost 0 last -1 hi 0]
    (if (>= k j) (if (= last 0) (+ (* cost 256) hi) -1)
      (let [op (gn-op M k) a (- (gn-sir M k IF-A) t) b (- (gn-sir M k IF-B) t) c (- (gn-sir M k IF-C) t)]
        (cond (= op t2-op-nop) (recur (inc k) w cost last hi)
              (or (= op OP-CONST) (= op OP-LGET))
              (if (and (>= a 0) (< a 60)) (recur (inc k) (t2-wbit w a) cost a (gn-max hi a)) -1)
              (or (= op OP-BIN) (= op OP-CMP))
              (let [quot? (and (= op OP-BIN) (= (gn-sir M k IF-A) BOP-QUOT))]
                (if (and (t2-hbit? w b) (t2-hbit? w (inc b))
                         (or (not quot?)
                             (and (> k i) (= (gn-op M (dec k)) OP-CONST) (= (gn-sir M (dec k) IF-A) (+ t b 1))
                                  (not= (gn-sir M (dec k) IF-B) 0) (not= (gn-sir M (dec k) IF-B) -1))))
                  (recur (inc k) w (+ cost (if quot? 3 1)) b hi) -1))
              (= op OP-UN) (if (t2-hbit? w b) (recur (inc k) w (inc cost) b hi) -1)
              (= op t2-op-sel) (if (and (t2-hbit? w a) (t2-hbit? w b) (t2-hbit? w c)) (recur (inc k) w (inc cost) a hi) -1)
              (= op t2-op-dtab) (if (t2-hbit? w a) (recur (inc k) w (+ cost 5) a hi) -1)
              :else -1)))))
;; the arm [i, j) is one constant
(defn- t2-armk? [M :vector-i64 i :i64 j :i64] :bool
  (let [k (t2-skipnop M i j)] (and (< k j) (= (gn-op M k) OP-CONST) (= (t2-skipnop M (inc k) j) j))))
(defn- t2-armk [M :vector-i64 i :i64 j :i64] :i64 (gn-sir M (t2-skipnop M i j) IF-B))
(defn- t2-spec? [k :i64] :bool (or (= k 0) (= k 1) (= k -1)))
;; instructions of the select itself for arm x (condition nonzero) and arm y, each a constant (kx, ky) or a register
(defn- t2-selcost [xc :bool kx :i64 yc :bool ky :i64] :i64
  (cond (and xc yc) (cond (= kx ky) 1
                          (and (t2-spec? kx) (t2-spec? ky) (or (= kx 0) (= ky 0))) 1
                          (or (= kx 0) (= ky 0) (= kx (inc ky)) (= ky (inc kx))) 2
                          :else 3)
        xc (if (t2-spec? kx) 1 2)
        yc (if (t2-spec? ky) 1 2)
        :else 1))
;; the join at k feeds a branch on t right away
(defn- t2-feeds-br? [M :vector-i64 k :i64 e :i64 t :i64] :bool
  (let [n (t2-skipnop M (inc k) e)]
    (and (< n e) (or (= (gn-op M n) OP-BRZ) (= (gn-op M n) OP-BRNZ)) (= (gn-sir M n IF-A) t))))
;; try the branch at i: diamond `BRZ|BRNZ t L ; A ; BR Lx ; LABEL L ; B ; LABEL Lx` (L referenced once) or triangle
;; `BRZ|BRNZ t L ; X ; LABEL L` (the jump carries t: 0 for BRZ, t itself for BRNZ)
(defn- t2-cv-at [M :vector-i64 i :i64 e :i64 s :i64] :vector-i64
  (let [op (gn-op M i) t (gn-sir M i IF-A) L (gn-sir M i IF-B) nz (= op OP-BRNZ)
        j (t2-armend M (inc i) e)
        jop (if (< j e) (gn-op M j) 0)
        pv (t2-prevop M (dec i) s)]
    (cond
      ;; a branch on an and/or join value: jump threading branches on its parts directly
      (and (>= pv s) (= (gn-op M pv) OP-LABEL) (> (t2-lref M (gn-sir M pv IF-A)) 0)) M
      (and (= jop OP-BR) (< (inc j) e) (= (gn-op M (inc j)) OP-LABEL) (= (gn-sir M (inc j) IF-A) L) (= (t2-lref M L) 1))
      (let [Lx (gn-sir M j IF-A) k (t2-armend M (+ j 2) e)
            ca (t2-arm M (inc i) j t) cb (if (< k e) (t2-arm M (+ j 2) k t) -1)]
        (if (and (< k e) (= (gn-op M k) OP-LABEL) (= (gn-sir M k IF-A) Lx) (not= Lx L) (>= (t2-lref M Lx) 1)
                 (>= ca 0) (>= cb 0) (not (t2-feeds-br? M k e t)))
          (let [ak (t2-armk? M (inc i) j) bk (t2-armk? M (+ j 2) k)
                cA (quot ca 256) cB (quot cb 256)
                sc (+ cA cB (t2-selcost ak (if ak (t2-armk M (inc i) j) 0) bk (if bk (t2-armk M (+ j 2) k) 0)))
                ;; (+ 1 when both arms compute values: the branch path also pays a move into the join's register)
                br (+ (gn-min (+ 2 cA (if ak 1 0)) (+ 1 cB (if bk 1 0))) (if (or ak bk) 0 1))]
            (if (> sc br) M
              (let [na (- j (inc i)) nb (- k (+ j 2))]
                (-> M (t2-bmoves i (inc i) j 1) (t2-bmoves (+ i na) (+ j 2) k 2)
                    (t2-bput (+ i na nb) t2-op-sel t (if nz (+ t 2) (inc t)) (if nz (inc t) (+ t 2)))
                    (t2-bnops (+ i na nb 1) k)
                    (t2-lref-dec L) (t2-lref-dec Lx)
                    (t2-xdepth (+ t 3 (gn-max (bit-and ca 255) (bit-and cb 255))))
                    (t2-s t2-s-cvch 1)))))
          M))
      (and (= jop OP-LABEL) (= (gn-sir M j IF-A) L) (>= (t2-lref M L) 1) (not (t2-feeds-br? M j e t)))
      (let [cx (t2-arm M (inc i) j t)]
        (if (< cx 0) M
          (let [xk (t2-armk? M (inc i) j) kx (if xk (t2-armk M (inc i) j) 0)
                sc (+ (quot cx 256) (if nz (t2-selcost false 0 xk kx) (t2-selcost xk kx true 0)))]
            (if (> sc 1) M
              (let [nx (- j (inc i))]
                (-> M (t2-bmoves i (inc i) j 1)
                    (t2-bput (+ i nx) t2-op-sel t (if nz t (inc t)) (if nz (inc t) t))
                    (t2-lref-dec L)
                    (t2-xdepth (+ t 2 (bit-and cx 255)))
                    (t2-s t2-s-cvch 1)))))))
      :else M)))
(defn- t2-cv-pass [M :vector-i64 i :i64 e :i64 s :i64 ps :i64 pe :i64] :vector-i64
  (if (or (>= i e) (not (t2-ok? M))) M
    (let [op (gn-op M i)]
      (t2-cv-pass (if (and (or (= op OP-BRZ) (= op OP-BRNZ)) (or (< i ps) (>= i pe))) (t2-cv-at M i e s) M) (inc i) e s ps pe))))
;; the last op before i (from s on) that is not a NOP, s - 1 when none
(defn- t2-prevop [M :vector-i64 i :i64 s :i64] :i64
  (if (and (>= i s) (= (gn-op M i) t2-op-nop)) (t2-prevop M (dec i) s) i))
;; inner diamonds first: a pass converts every branch whose arms are already straight; repeat until nothing changes.
;; Branches in [ps, pe) are kept.
(defn- t2-cv-fix [M :vector-i64 s :i64 e :i64 iter :i64 ps :i64 pe :i64] :vector-i64
  (if (>= iter 24) M
    (let [M1 (t2-cv-pass (t2-s M t2-s-cvch 0) s e s ps pe)]
      (if (= (t2-g M1 t2-s-cvch) 1) (t2-cv-fix M1 s e (inc iter) ps pe) M1))))
;; the whole buffer, keeping a whole-function constant tree (marked by t2-tr-scan: trx = start, trk = -end) as it is
(defn- t2-cv-top [M :vector-i64 s :i64 e :i64] :vector-i64
  (if (< (t2-g M t2-s-trk) 0) (t2-cv-fix M s e 0 (t2-g M t2-s-trx) (- 0 (t2-g M t2-s-trk))) (t2-cv-fix M s e 0 0 0)))
;; an inlined callee's region [s, e) with its labels from lab0: label references, trees, then diamonds
(defn- t2-cv-region [M :vector-i64 s :i64 e :i64 lab0 :i64] :vector-i64
  (-> M (t2-wzero t2-a-lref lab0 (gn-min t2-maxlab (t2-g M t2-s-xlab))) (t2-lrefs s e) (t2-tr-scan s e 1) (t2-cv-fix s e 0 0 0)))
;; ---- (1) decision trees over one slot ----
;; x cc k test at i into temp t: 1 = `LGET t x ; CONST t+1 k ; CMP cc t ; BRZ|BRNZ t`, 2 = the constant first, 0 = none
(defn- t2-tr-form [M :vector-i64 i :i64 t :i64 x :i64] :i64
  (let [tail (and (= (gn-op M (+ i 2)) OP-CMP) (= (gn-sir M (+ i 2) IF-B) t)
                  (or (= (gn-op M (+ i 3)) OP-BRZ) (= (gn-op M (+ i 3)) OP-BRNZ)) (= (gn-sir M (+ i 3) IF-A) t))]
    (cond (not tail) 0
          (and (= (gn-op M i) OP-LGET) (= (gn-sir M i IF-A) t) (= (gn-sir M i IF-B) x)
               (= (gn-op M (inc i)) OP-CONST) (= (gn-sir M (inc i) IF-A) (inc t))) 1
          (and (= (gn-op M i) OP-CONST) (= (gn-sir M i IF-A) t)
               (= (gn-op M (inc i)) OP-LGET) (= (gn-sir M (inc i) IF-A) (inc t)) (= (gn-sir M (inc i) IF-B) x)) 2
          :else 0)))
(defn- t2-tr-k [M :vector-i64 i :i64 form :i64] :i64 (if (= form 1) (gn-sir M (inc i) IF-B) (gn-sir M i IF-B)))
;; the test with x on the left
(defn- t2-tr-cc [M :vector-i64 i :i64 form :i64] :i64
  (let [cc (gn-sir M (+ i 2) IF-A)]
    (if (= form 1) cc (cond (= cc CC-LT) CC-GT (= cc CC-GT) CC-LT (= cc CC-LE) CC-GE (= cc CC-GE) CC-LE :else cc))))
(defn- t2-cc-ok? [cc :i64] :bool (or (= cc CC-EQ) (= cc CC-LT) (= cc CC-GT) (= cc CC-LE) (= cc CC-GE)))
(defn- t2-cc-eval [cc :i64 v :i64 k :i64] :bool
  (cond (= cc CC-EQ) (= v k) (= cc CC-LT) (< v k) (= cc CC-GT) (> v k) (= cc CC-LE) (<= v k) :else (>= v k)))
;; the part of [lo, hi] where `x cc k` is tv (an = test's false part is all of [lo, hi])
(defn- t2-tr-lo [cc :i64 k :i64 lo :i64 tv :bool] :i64
  (cond (= cc CC-EQ) (if tv (gn-max lo k) lo)
        (or (= cc CC-LT) (= cc CC-LE)) (if tv lo (gn-max lo (if (= cc CC-LT) k (inc k))))
        :else (if tv (gn-max lo (if (= cc CC-GT) (inc k) k)) lo)))
(defn- t2-tr-hi [cc :i64 k :i64 hi :i64 tv :bool] :i64
  (cond (= cc CC-EQ) (if tv (gn-min hi k) hi)
        (or (= cc CC-LT) (= cc CC-LE)) (if tv (gn-min hi (if (= cc CC-LT) (dec k) k)) hi)
        :else (if tv hi (gn-min hi (if (= cc CC-GT) k (dec k))))))
;; tree node at i into temp t over slot x reaching [lo, hi]: M[last] = its end (exclusive), 0 when it is not one
(defn- t2-tr-node [M :vector-i64 i :i64 t :i64 x :i64 lo :i64 hi :i64 depth :i64] :vector-i64
  (let [form (t2-tr-form M i t x)]
    (cond
      (or (> depth 12) (not (t2-ok? M))) (t2-s M t2-s-last 0)
      (> form 0)
      (let [k (t2-tr-k M i form) cc (t2-tr-cc M i form) Le (gn-sir M (+ i 3) IF-B) brz (= (gn-op M (+ i 3)) OP-BRZ)]
        (if (or (not (t2-cc-ok? cc)) (> k t2-kmax) (< k (- 0 t2-kmax)) (not= (t2-lref M Le) 1)) (t2-s M t2-s-last 0)
          ;; the fallthrough arm runs when the test holds (BRZ) or fails (BRNZ)
          (let [M1 (-> M (t2-s t2-s-trlo (gn-min (t2-g M t2-s-trlo) k)) (t2-s t2-s-trhi (gn-max (t2-g M t2-s-trhi) k))
                       (cond-> (= cc CC-EQ) (t2-s t2-s-trk (bit-or (t2-g M t2-s-trk) 4)))
                       (t2-tr-node (+ i 4) t x (t2-tr-lo cc k lo brz) (t2-tr-hi cc k hi brz) (inc depth)))
                j (t2-last M1)]
            (if (or (= j 0) (not= (gn-op M1 j) OP-BR) (not= (gn-op M1 (inc j)) OP-LABEL) (not= (gn-sir M1 (inc j) IF-A) Le))
              (t2-s M1 t2-s-last 0)
              (let [Lx (gn-sir M1 j IF-A)
                    M2 (t2-tr-node M1 (+ j 2) t x (t2-tr-lo cc k lo (not brz)) (t2-tr-hi cc k hi (not brz)) (inc depth))
                    e (t2-last M2)]
                (if (and (> e 0) (= (gn-op M2 e) OP-LABEL) (= (gn-sir M2 e IF-A) Lx) (= (t2-lref M2 Lx) 1))
                  (t2-s M2 t2-s-last (inc e))
                  (t2-s M2 t2-s-last 0)))))))
      (and (= (gn-op M i) OP-CONST) (= (gn-sir M i IF-A) t))
      (-> M (t2-s t2-s-trk (bit-or (t2-g M t2-s-trk) 1)) (t2-s t2-s-trn (inc (t2-g M t2-s-trn))) (t2-s t2-s-last (inc i)))
      :else (t2-tr-tableaf M i t x lo hi))))
;; leaf `LGET t x ; [CONST t+1 c ; BIN SUB|ADD t] ; TAB t lit n` reaching [lo, hi]: recorded in t2-a-trl
(defn- t2-tr-tableaf [M :vector-i64 i :i64 t :i64 x :i64 lo :i64 hi :i64] :vector-i64
  (let [lg (and (= (gn-op M i) OP-LGET) (= (gn-sir M i IF-A) t) (= (gn-sir M i IF-B) x))
        d (cond (not lg) -1
                (and (= (gn-op M (inc i)) OP-TAB) (= (gn-sir M (inc i) IF-A) t)) 1
                (and (= (gn-op M (inc i)) OP-CONST) (= (gn-sir M (inc i) IF-A) (inc t))
                     (= (gn-op M (+ i 2)) OP-BIN) (= (gn-sir M (+ i 2) IF-B) t)
                     (or (= (gn-sir M (+ i 2) IF-A) BOP-SUB) (= (gn-sir M (+ i 2) IF-A) BOP-ADD))
                     (= (gn-op M (+ i 3)) OP-TAB) (= (gn-sir M (+ i 3) IF-A) t)) 3
                :else -1)
        n (t2-g M t2-s-trn)]
    (if (or (< d 0) (>= n t2-maxleaf)) (t2-s M t2-s-last 0)
      (let [c (cond (= d 1) 0 (= (gn-sir M (+ i 2) IF-A) BOP-SUB) (gn-sir M (inc i) IF-B) :else (- 0 (gn-sir M (inc i) IF-B)))
            w (+ t2-a-trl (* 6 n))]
        (if (or (> c t2-kmax) (< c (- 0 t2-kmax))) (t2-s M t2-s-last 0)
          (-> M (t2-s w (gn-sir M (+ i d) IF-B)) (t2-s (+ w 1) (gn-sir M (+ i d) IF-C)) (t2-s (+ w 2) c)
              (t2-s (+ w 3) lo) (t2-s (+ w 4) hi)
              (t2-s t2-s-trk (bit-or (t2-g M t2-s-trk) 2)) (t2-s t2-s-trn (inc n)) (t2-s t2-s-last (+ i d 1))))))))
;; value of the (validated) constant-leaf tree at i for x = v
(defn- t2-tr-eval [M :vector-i64 i :i64 t :i64 x :i64 v :i64 depth :i64] :i64
  (let [form (t2-tr-form M i t x)]
    (if (or (= form 0) (> depth 14)) (gn-sir M i IF-B)
      (let [hold (t2-cc-eval (t2-tr-cc M i form) v (t2-tr-k M i form))
            brz (= (gn-op M (+ i 3)) OP-BRZ)]
        (t2-tr-eval M (if (= hold brz) (+ i 4) (inc (t2-g M (+ t2-a-lpos (gn-sir M (+ i 3) IF-B))))) t x v (inc depth))))))
;; trees whose root test starts in [i, e); inl = 1 inside an inlined callee
(defn- t2-tr-scan [M :vector-i64 i :i64 e :i64 inl :i64] :vector-i64
  (if (or (>= (+ i 3) e) (not (t2-ok? M))) M
    (let [op (gn-op M i) t (gn-sir M i IF-A)
          x (cond (= op OP-LGET) (gn-sir M i IF-B) (= op OP-CONST) (gn-sir M (inc i) IF-B) :else -1)
          form (if (>= x 0) (t2-tr-form M i t x) 0)]
      (if (= form 0) (t2-tr-scan M (inc i) e inl)
        (let [M1 (-> M (t2-s t2-s-trlo t2-inf) (t2-s t2-s-trhi (- 0 t2-inf)) (t2-s t2-s-trn 0) (t2-s t2-s-trk 0)
                     (t2-s t2-s-trx x) (t2-tr-node i t x (- 0 t2-inf) t2-inf 0))
              e1 (t2-last M1) k (t2-g M1 t2-s-trk)
              ;; a function returning its own constant tree keeps the existing backend's whole-function table: no part
              ;; of it is converted
              whole (and (> e1 0) (<= e1 e) (= (bit-and k 3) 1) (= inl 0) (= (gn-op M1 (t2-skipnop M1 e1 e)) OP-RET))]
          (t2-tr-scan (cond whole (-> M1 (t2-s t2-s-trx i) (t2-s t2-s-trk (- 0 e1)))
                            (or (= e1 0) (> e1 e)) M1
                            (and (= (bit-and k 3) 1) (>= (t2-g M1 t2-s-trn) 3)) (t2-dtab-at M1 i e1 t x inl)
                            (and (= k 2) (>= (t2-g M1 t2-s-trn) 2)) (t2-tabmerge-at M1 i e1 t x)
                            :else M1)
                      (if whole e1 (inc i)) e inl))))))
;; constant leaves: `LGET t x ; DTAB t lit packed`, packed = 4 (4096 base + n) + 2 inl + u; u = 1 when f(base) =
;; f(base + n - 1) (one unsigned clamp of x - base suffices), else the base register points at item -base (signed clamp)
(defn- t2-dtab-at [M :vector-i64 i :i64 e1 :i64 t :i64 x :i64 inl :i64] :vector-i64
  (let [lo (t2-g M t2-s-trlo) hi (t2-g M t2-s-trhi) base (dec lo) n (+ (- hi lo) 3)]
    (if (or (> n t2-dtmax) (and (<= (vector-at M MM-LIT-N) 1) (not (t2-sf-free? M)))) M
      (let [M1 (t2-mklit M i t x base n) lit (t2-last M1)]
        (if (<= lit 0) M1
          (let [u (if (= (t2-tr-eval M1 i t x base 0) (t2-tr-eval M1 i t x (+ base (dec n)) 0)) 1 0)]
            (-> M1 (t2-bput i OP-LGET t x 0) (t2-bput (inc i) t2-op-dtab t lit (+ (* 4 (+ (* base 4096) n)) (* 2 inl) u))
                (t2-bnops (+ i 2) e1))))))))
;; a program without literals may only get one when no function has the shape sf-collapse (a post-pass that needs a
;; literal-free program) rewrites; cached in the unused FN-0 status cell (1 none, 2 some)
(defn- t2-sf-free? [M :vector-i64] :bool
  (let [c (t2-g M t2-a-st)]
    (if (> c 0) (= c 1)
      (let [none (loop [f 1] (or (>= f (vector-at M MM-FN-N)) (and (= (sf-body M f) 0) (recur (inc f)))))
            cached (t2-s M t2-a-st (if none 1 2))]
        (and none (= (t2-g cached t2-a-st) 1))))))
;; a new literal with the tree's values at base .. base + n - 1 (plus one item 255 when every byte would be below 128, so
;; it never reads as an ASCII literal); an identical table made for this function is reused, at most 3 are made (each
;; holds a base register). M[last] = lit, 0 = none.
;; A function T2 does not apply drops its literals again (t2-end).
(defn- t2-mklit [M :vector-i64 i :i64 t :i64 x :i64 base :i64 n :i64] :vector-i64
  (let [lit (vector-at M MM-LIT-N) lb (vector-at M MM-LITB-N)]
    (if (or (>= (inc lit) MM-LIT-CAP) (> (+ lb (* 8 (inc n))) MM-LITB-CAP)) (t2-s M t2-s-last 0)
      (let [M1 (loop [j 0 m M] (if (>= j n) m (recur (inc j) (t2-bytes8 m (+ lb (* 8 j)) (t2-tr-eval m i t x (+ base j) 0)))))
            asc (t2-ascii? M1 lb 0 (* 8 n))
            len (if asc (* 8 (inc n)) (* 8 n))
            M2 (if asc (t2-bytes8 M1 (+ lb (* 8 n)) 255) M1)
            same (t2-samelit M2 (t2-g M2 t2-s-lit0) lit lb len)]
        (cond (> same 0) (t2-s M2 t2-s-last same)
              ;; every table holds a base register for the whole function: at most 3 new ones
              (>= (- lit (t2-g M2 t2-s-lit0)) 3) (t2-s M2 t2-s-last 0)
              :else
              (let [r (+ MM-LIT-BASE (* lit MM-LIT-W))]
                (-> M2 (gn-put (+ r LF-B) lb) (gn-put (+ r LF-LEN) len) (gn-put (+ r LF-POOL) 0) (gn-put (+ r LF-TOK) 0)
                    (gn-put MM-LIT-N (inc lit)) (gn-put MM-LITB-N (+ lb len)) (t2-s t2-s-last lit))))))))
(defn- t2-bytes8 [M :vector-i64 b :i64 v :i64] :vector-i64
  (loop [k 0 m M] (if (>= k 8) m (recur (inc k) (gn-put m (+ MM-LITB-BASE b k) (bit-and (u64-shift-right v (* 8 k)) 255))))))
(defn- t2-ascii? [M :vector-i64 b :i64 k :i64 n :i64] :bool
  (or (>= k n) (and (< (vector-at M (+ MM-LITB-BASE b k)) 128) (t2-ascii? M b (inc k) n))))
;; a literal in [l, e) with the bytes LITB[b, b + len)
(defn- t2-samelit [M :vector-i64 l :i64 e :i64 b :i64 len :i64] :i64
  (cond (or (<= l 0) (>= l e)) 0
        (and (= (gn-litf M l LF-LEN) len) (t2-samebytes? M (gn-litf M l LF-B) b 0 len)) l
        :else (t2-samelit M (inc l) e b len)))
(defn- t2-samebytes? [M :vector-i64 a :i64 b :i64 k :i64 n :i64] :bool
  (or (>= k n) (and (= (vector-at M (+ MM-LITB-BASE a k)) (vector-at M (+ MM-LITB-BASE b k))) (t2-samebytes? M a b (inc k) n))))
;; pool bytes from literal a to literal b (42-layout: every literal 8-byte aligned, in literal order, no gaps otherwise)
(defn- t2-poolgap [M :vector-i64 a :i64 b :i64 acc :i64] :i64
  (if (>= a b) acc (t2-poolgap M (inc a) b (+ acc (bit-and (+ (gn-litf M a LF-LEN) 7) -8)))))
(defn- t2-trl [M :vector-i64 j :i64 f :i64] :i64 (t2-g M (+ t2-a-trl (* 6 j) f)))
;; table leaves: `LGET t x ; [CONST t+1 cmin ; BIN SUB t] ; TAB t lmin N` when the leaf tables tile [cmin, cmin + N)
;; disjointly, each at its own pool place, and each leaf's reach inside [cmin, cmin + N) lies in its own table: below
;; cmin or from cmin + N on, every leaf index is out of range, so both forms trap the same
(defn- t2-tabmerge-at [M :vector-i64 i :i64 e1 :i64 t :i64 x :i64] :vector-i64
  (let [m (t2-g M t2-s-trn)
        jm (loop [j 1 b 0] (if (>= j m) b (recur (inc j) (if (< (t2-trl M j 2) (t2-trl M b 2)) j b))))
        cmin (t2-trl M jm 2) lmin (t2-trl M jm 0)
        top (loop [j 0 h cmin] (if (>= j m) h (recur (inc j) (gn-max h (+ (t2-trl M j 2) (t2-trl M j 1))))))
        tot (loop [j 0 s 0] (if (>= j m) s (recur (inc j) (+ s (t2-trl M j 1)))))
        N (- top cmin)
        ok (and (= (bit-and (t2-g M t2-s-trk) 4) 0) (= tot N) (> N 0) (< N 1048576)
                (loop [j 0]
                  (or (>= j m)
                      (let [l (t2-trl M j 0) nj (t2-trl M j 1) cj (t2-trl M j 2)
                            rlo (gn-max (t2-trl M j 3) cmin) rhi (gn-min (t2-trl M j 4) (dec top))]
                        (and (>= l lmin) (< l (vector-at M MM-LIT-N)) (> nj 0) (= (gn-litf M l LF-LEN) (* 8 nj))
                             (= (t2-poolgap M lmin l 0) (* 8 (- cj cmin)))
                             (or (> rlo rhi) (and (>= rlo cj) (<= rhi (+ cj (dec nj)))))
                             (loop [q 0]
                               (or (>= q m)
                                   (and (or (= q j) (<= (+ cj nj) (t2-trl M q 2)) (<= (+ (t2-trl M q 2) (t2-trl M q 1)) cj))
                                        (recur (inc q)))))
                             (recur (inc j)))))))
        at (if (= cmin 0) (inc i) (+ i 3))]
    (if (not ok) M
      (-> M (t2-bput i OP-LGET t x 0)
          (cond-> (not= cmin 0) (-> (t2-bput (+ i 1) OP-CONST (inc t) cmin 0) (t2-bput (+ i 2) OP-BIN BOP-SUB t 0)))
          (t2-bnops at e1) (t2-bput at OP-TAB t lmin N)))))
;; ---- SIR -> SSA values -----------------------------------------------------------------------------------------------
(defn- t2-tv [M :vector-i64 t :i64] :i64 (+ (t2-g M t2-s-ns) 1 t))
;; read variable var in block b into the last-cell, then write it to variable dst
(defn- t2-copy [M :vector-i64 dst :i64 src :i64 b :i64] :vector-i64
  (let [M1 (t2-read M src b)] (t2-defset M1 dst b (t2-last M1))))
;; read two variables; returns M with x in last-cell of the first read stored at scalar 22, y in last
(def t2-s-x 22)
(def t2-s-y 23)
(defn- t2-read2 [M :vector-i64 va :i64 vb :i64 b :i64] :vector-i64
  (let [M1 (t2-read M va b) x (t2-last M1) M2 (t2-read M1 vb b)]
    (-> M2 (t2-s t2-s-x x) (t2-s t2-s-y (t2-last M2)))))
(defn- t2-emit-val [M :vector-i64 op :i64 a :i64 b :i64 c :i64 blk :i64 dst :i64] :vector-i64
  (let [M1 (t2-new M op a b c blk)] (if (>= dst 0) (t2-defset M1 dst blk (t2-last M1)) M1)))
;; CALL g t n: argument values are stored in the phi-operand array (start, n); result -> temp t
(defn- t2-ssa-args [M :vector-i64 t :i64 k :i64 n :i64 start :i64 b :i64] :vector-i64
  (if (>= k n) M
    (let [M1 (t2-read M (t2-tv M (+ t k)) b)]
      (t2-ssa-args (t2-s M1 (+ t2-a-phiop start k) (t2-last M1)) t (inc k) n start b))))
(defn- t2-ssa-call [M :vector-i64 g :i64 t :i64 n :i64 b :i64] :vector-i64
  (let [start (t2-g M t2-s-nphi)]
    (if (> (+ start n) t2-maxphi) (t2-fail M 4)
      (let [M1 (t2-ssa-args (t2-s M t2-s-nphi (+ start n)) t 0 n start b)]
        (t2-emit-val M1 t2-call g start n b (t2-tv M t))))))
(defn- t2-op [M :vector-i64 j :i64 b :i64] :vector-i64
  (let [op (gn-op M j) a (gn-sir M j IF-A) x (gn-sir M j IF-B) c (gn-sir M j IF-C)]
    (case op
      OP-LABEL M
      OP-CONST (t2-emit-val M t2-const x 0 0 b (t2-tv M a))
      OP-LGET (t2-copy M (t2-tv M a) x b)
      OP-LSET (t2-copy M a (t2-tv M x) b)
      (OP-BIN OP-CMP)
      (let [M1 (t2-read2 M (t2-tv M x) (t2-tv M (inc x)) b)]
        (t2-emit-val M1 (if (= op OP-BIN) t2-bin t2-cmp) a (t2-g M1 t2-s-x) (t2-g M1 t2-s-y) b (t2-tv M x)))
      OP-UN (let [M1 (t2-read M (t2-tv M x) b)] (t2-emit-val M1 t2-un a (t2-last M1) 0 b (t2-tv M x)))
      OP-RT
      (cond (= a RT-VECTOR-AT)
            (let [M1 (t2-read2 M (t2-tv M x) (t2-tv M (inc x)) b)]
              (t2-emit-val M1 t2-vat (t2-g M1 t2-s-x) (t2-g M1 t2-s-y) 0 b (t2-tv M x)))
            (= a RT-VECTOR-ASSOC-IN-PLACE)
            (let [M1 (t2-read2 M (t2-tv M x) (t2-tv M (inc x)) b)
                  h (t2-g M1 t2-s-x) i (t2-g M1 t2-s-y)
                  M2 (t2-read M1 (t2-tv M (+ x 2)) b)
                  M3 (t2-new M2 t2-vset h i (t2-last M2) b)]
              (t2-defset M3 (t2-tv M x) b h))
            (= a RT-PAIR-SECOND)
            (let [M1 (t2-read M (t2-tv M x) b)] (t2-emit-val M1 t2-slen 0 (t2-last M1) 0 b (t2-tv M x)))
            (or (= a RT-STRING-CODE-POINT-AT) (= a t2-rt-cpz))
            (let [M1 (t2-read2 M (t2-tv M x) (t2-tv M (inc x)) b)]
              (t2-emit-val M1 (if (= a t2-rt-cpz) t2-cpz t2-cpa) 0 (t2-g M1 t2-s-x) (t2-g M1 t2-s-y) b (t2-tv M x)))
            :else
            (let [M1 (t2-read M (t2-tv M x) b)] (t2-emit-val M1 t2-vcnt (t2-last M1) 0 0 b (t2-tv M x))))
      OP-CALL (t2-ssa-call M a x c b)
      OP-TAB (let [M1 (t2-read M (t2-tv M a) b)] (t2-emit-val M1 t2-tab x c (t2-last M1) b (t2-tv M a)))
      OP-FUEL (t2-emit-val (t2-s M t2-s-fuel 1) t2-fuel a 0 0 b -1)
      27 (t2-emit-val M t2-pub 0 0 0 b -1)
      ;; SEL a x c: temp a := temp a != 0 ? temp x : temp c
      28 (let [M1 (t2-read M (t2-tv M a) b) vc (t2-last M1)
               M2 (t2-read M1 (t2-tv M x) b) vx (t2-last M2)
               M3 (t2-read M2 (t2-tv M c) b)]
           (t2-emit-val M3 t2-sel vc vx (t2-last M3) b (t2-tv M a)))
      29 M
      ;; DTAB a lit packed: temp a := table item of temp a
      30 (let [M1 (t2-read M (t2-tv M a) b)] (t2-emit-val M1 t2-dtab x c (t2-last M1) b (t2-tv M a)))
      OP-TRAP (t2-emit-val M t2-trap a 0 0 b -1)
      OP-RET (let [M1 (t2-read M (t2-tv M a) b)] (t2-emit-val M1 t2-ret (t2-last M1) 0 0 b -1))
      OP-BR (t2-emit-val M t2-br 0 0 0 b -1)
      (OP-BRZ OP-BRNZ)
      (let [M1 (t2-read M (t2-tv M a) b)] (t2-emit-val M1 t2-brz (t2-last M1) (if (= op OP-BRNZ) 1 0) 0 b -1))
      (t2-fail M 7))))
(defn- t2-ops [M :vector-i64 j :i64 e :i64 b :i64] :vector-i64
  (if (or (> j e) (not= (t2-g M t2-s-fail) 0)) M (t2-ops (t2-op M j b) (inc j) e b)))
(defn- t2-params [M :vector-i64 k :i64 np :i64] :vector-i64
  (if (>= k np) M (t2-params (t2-emit-val M t2-param k 0 0 0 (inc k)) (inc k) np)))
;; build every reachable block in order
(defn- t2-build [M :vector-i64 b :i64] :vector-i64
  (if (or (>= b (t2-g M t2-s-nb)) (not= (t2-g M t2-s-fail) 0)) M
    (if (= (t2-bget M t2-a-breach b) 0)
      (t2-build M (inc b))
      (let [M0 (if (and (= (t2-bget M t2-a-bseal b) 0) (< (t2-bget M t2-a-bmaxp b) b)) (t2-seal M b) M)
            M1 (-> M0 (t2-bset t2-a-bv0 b (inc (t2-g M0 t2-s-nv)))
                   (cond-> (= b 0) (t2-params 0 (t2-g M0 t2-s-np))))
            M2 (t2-ops M1 (t2-bget M1 t2-a-bs b) (t2-bget M1 t2-a-be b) b)
            M3 (-> M2 (t2-bset t2-a-bv1 b (inc (t2-g M2 t2-s-nv))) (t2-seal-after 0 b))]
        (t2-build M3 (inc b))))))
;; ---- GVN: dominator-scoped value numbering of pure values ----------------------------------------------------------------
;; CONST, BIN (QUOT included: a dominating identical quot already trapped or passed), CMP, UN and TAB (constant tables cannot
;; change; a dominating identical lookup already passed its range check) are replaced by an identical dominating value.
;; Ordinary values replaced this way (repl != 0) are skipped by every later stage.
(def t2-a-idom (+ (+ t2-a-st MM-FN-CAP) 4096))   ; per block immediate dominator (-1 = none)
(def t2-a-hash (+ t2-a-idom t2-maxb))            ; 4096-slot open-addressing table of value ids
(def t2-hsize 4096)
(defn- t2-idom [M :vector-i64 b :i64] :i64 (t2-g M (+ t2-a-idom b)))
(defn- t2-isect [M :vector-i64 a :i64 b :i64] :i64
  (cond (or (< a 0) (< b 0)) (if (< a 0) b a)
        (= a b) a
        (> a b) (t2-isect M (t2-idom M a) b)
        :else (t2-isect M a (t2-idom M b))))
(defn- t2-dom-preds [M :vector-i64 b :i64 k :i64 n :i64 acc :i64] :i64
  (if (>= k n) acc
    (let [p (t2-pred M b k)]
      (t2-dom-preds M b (inc k) n (if (or (= (t2-bget M t2-a-breach p) 0) (and (< (t2-idom M p) 0) (not= p 0))) acc (t2-isect M acc p))))))
(defn- t2-dom-pass [M :vector-i64 b :i64 changed :bool] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) (t2-s M t2-s-last (if changed 1 0))
    (if (or (= b 0) (= (t2-bget M t2-a-breach b) 0)) (t2-dom-pass M (inc b) changed)
      (let [d (t2-dom-preds M b 0 (t2-bget M t2-a-bpn b) -1)]
        (if (= d (t2-idom M b)) (t2-dom-pass M (inc b) changed)
          (t2-dom-pass (t2-s M (+ t2-a-idom b) d) (inc b) true))))))
(defn- t2-dominators [M :vector-i64 iter :i64] :vector-i64
  (if (>= iter 32) (t2-fail M 25)
    (let [M1 (t2-dom-pass M 0 false)] (if (= (t2-last M1) 1) (t2-dominators M1 (inc iter)) M1))))
(defn- t2-dom-init [M :vector-i64 b :i64] :vector-i64
  (if (>= b t2-maxb) M (t2-dom-init (t2-s M (+ t2-a-idom b) (if (= b 0) 0 -1)) (inc b))))
;; does block a dominate block b?
(defn- t2-dom? [M :vector-i64 a :i64 b :i64] :bool
  (cond (= a b) true (<= b 0) (= a 0) (< (t2-idom M b) 0) false :else (t2-dom? M a (t2-idom M b))))
;; string-length and string-code-point-at too: a dominating identical one already passed its handle check (or trapped),
;; and the pair and the bytes of a handle never change while it is valid
(defn- t2-gvn-op? [op :i64] :bool
  (or (= op t2-const) (= op t2-bin) (= op t2-cmp) (= op t2-un) (= op t2-tab) (= op t2-slen) (t2-cpx? op)
      (= op t2-sel) (= op t2-dtab)))
;; normalized operands: commutative BIN sorts its two operands; table items, counts and packed clamps are not values
(defn- t2-gvn-a [M :vector-i64 v :i64] :i64
  (if (= (t2-op-of M v) t2-sel) (t2-res M (t2-vf M v t2-f-a)) (t2-vf M v t2-f-a)))
(defn- t2-gvn-b [M :vector-i64 v :i64] :i64
  (let [op (t2-op-of M v)]
    (cond (or (= op t2-const) (= op t2-tab) (= op t2-dtab)) (t2-vf M v t2-f-b)
          :else (let [b (t2-res M (t2-vf M v t2-f-b))]
                  (if (and (= op t2-bin) (t2-comm? (t2-vf M v t2-f-a)))
                    (let [c (t2-res M (t2-vf M v t2-f-c))] (if (> b c) c b))
                    b)))))
(defn- t2-gvn-c [M :vector-i64 v :i64] :i64
  (let [op (t2-op-of M v)]
    (cond (or (= op t2-const) (= op t2-un)) 0
          :else (let [c (t2-res M (t2-vf M v t2-f-c))]
                  (if (and (= op t2-bin) (t2-comm? (t2-vf M v t2-f-a)))
                    (let [b (t2-res M (t2-vf M v t2-f-b))] (if (> b c) b c))
                    c)))))
(defn- t2-gvn-same? [M :vector-i64 w :i64 op :i64 a :i64 b :i64 c :i64] :bool
  (and (= (t2-op-of M w) op) (= (t2-gvn-a M w) a) (= (t2-gvn-b M w) b) (= (t2-gvn-c M w) c)))
(defn- t2-hash [op :i64 a :i64 b :i64 c :i64] :i64
  (bit-and (+ (* op 1000003) (* a 9176) (* b 31) (* c 131071)) (dec t2-hsize)))
;; find a dominating equal value starting at slot h; else insert v at the first empty slot. M[last] = replacement or 0.
(defn- t2-gvn-probe [M :vector-i64 v :i64 op :i64 a :i64 b :i64 c :i64 h :i64 n :i64] :vector-i64
  (let [w (t2-g M (+ t2-a-hash h))]
    (cond (>= n t2-hsize) (t2-s M t2-s-last 0)
          (= w 0) (-> M (t2-s (+ t2-a-hash h) v) (t2-s t2-s-last 0))
          ;; (a compare only within its block: elsewhere it is recomputed, so each branch fuses its own)
          (and (t2-gvn-same? M w op a b c) (t2-dom? M (t2-vf M w t2-f-blk) (t2-vf M v t2-f-blk))
               (or (not= op t2-cmp) (= (t2-vf M w t2-f-blk) (t2-vf M v t2-f-blk))))
          (t2-s M t2-s-last w)
          :else (t2-gvn-probe M v op a b c (bit-and (inc h) (dec t2-hsize)) (inc n)))))
(defn- t2-gvn-vals [M :vector-i64 b :i64 v :i64 v1 :i64] :vector-i64
  (if (>= v v1) M
    (let [op (t2-op-of M v)]
      (cond
        (and (t2-gvn-op? op) (= (t2-vf M v t2-f-repl) 0) (= (t2-vf M v t2-f-blk) b) (t2-foldable? M v))
        (let [M1 (t2-new M t2-const (t2-foldk M v) 0 0 b) k (t2-last M1)]
          (t2-gvn-vals (if (> k 0) (t2-vs M1 v t2-f-repl k) M1) b (inc v) v1))
        (and (t2-gvn-op? op) (= (t2-vf M v t2-f-repl) 0) (= (t2-vf M v t2-f-blk) b) (> (t2-identity M v) 0))
        (t2-gvn-vals (t2-vs M v t2-f-repl (t2-identity M v)) b (inc v) v1)
        :else
      (if (and (t2-gvn-op? op) (= (t2-vf M v t2-f-repl) 0) (= (t2-vf M v t2-f-blk) b))
        (let [a (t2-gvn-a M v) bb (t2-gvn-b M v) cc (t2-gvn-c M v)
              M1 (t2-gvn-probe M v op a bb cc (t2-hash op a bb cc) 0)
              w (t2-last M1)]
          (t2-gvn-vals (if (> w 0) (t2-vs M1 v t2-f-repl w) M1) b (inc v) v1))
        (t2-gvn-vals M b (inc v) v1))))))
;; integer BIN (the old backend's gn-foldable/gn-fold: no trapping quotient), CMP and UN of constants fold to a constant
(defn- t2-foldable? [M :vector-i64 v :i64] :bool
  (let [op (t2-op-of M v)
        ;; fields b/c are operands only for BIN, CMP, UN (a table's are an item count / packed clamp)
        ar (or (= op t2-bin) (= op t2-cmp) (= op t2-un))
        x (if ar (t2-res M (t2-vf M v t2-f-b)) 0) y (if ar (t2-res M (t2-vf M v t2-f-c)) 0)]
    (cond (= op t2-bin) (and (t2-isconst? M x) (t2-isconst? M y) (< (t2-vf M v t2-f-a) BOP-F64-ADD)
                             (gn-foldable (t2-vf M v t2-f-a) (t2-kval M x) (t2-kval M y)))
          (= op t2-cmp) (and (t2-isconst? M x) (t2-isconst? M y) (< (t2-vf M v t2-f-a) CC-F64-EQ))
          (= op t2-un) (and (t2-isconst? M x) (or (= (t2-vf M v t2-f-a) UOP-NOT) (= (t2-vf M v t2-f-a) UOP-BITNOT)))
          :else false)))
(defn- t2-foldk [M :vector-i64 v :i64] :i64
  (let [op (t2-op-of M v) a (t2-vf M v t2-f-a) x (t2-kval M (t2-res M (t2-vf M v t2-f-b))) y (t2-kval M (t2-res M (t2-vf M v t2-f-c)))]
    (cond (= op t2-bin) (gn-fold a x y)
          (= op t2-cmp) (if (cond (= a CC-EQ) (= x y) (= a CC-LT) (< x y) (= a CC-GT) (> x y) (= a CC-LE) (<= x y)
                                  (= a t2-cc-ne) (not= x y) :else (>= x y)) 1 0)
          (= a UOP-NOT) (bit-xor x 1)
          :else (bit-not x))))
;; x + 0, x - 0, x | 0, x ^ 0, x << 0 (count mod 64), x * 1, x & -1, x / 1: the operand x (0 when no identity applies)
(defn- t2-identity [M :vector-i64 v :i64] :i64
  (cond (= (t2-op-of M v) t2-sel) (t2-sel-identity M v)
        (not= (t2-op-of M v) t2-bin) 0
        :else (t2-bin-identity M v)))
;; sel(c, x, x) = x ; sel(k, x, y) = x or y ; sel(c, c, 0) = c ; sel(c, 1, 0) = sel(c, 1, c) = c for a 0/1 c
(defn- t2-sel-identity [M :vector-i64 v :i64] :i64
  (let [c (t2-res M (t2-vf M v t2-f-a)) x (t2-res M (t2-vf M v t2-f-b)) y (t2-res M (t2-vf M v t2-f-c))
        y0 (and (t2-isconst? M y) (= (t2-kval M y) 0))]
    (cond (= x y) x
          (t2-isconst? M c) (if (not= (t2-kval M c) 0) x y)
          (and y0 (= x c)) c
          (and (or y0 (= y c)) (t2-isconst? M x) (= (t2-kval M x) 1) (t2-bool? M c 0)) c
          :else 0)))
;; v is 0 or 1
(defn- t2-bool? [M :vector-i64 v0 :i64 depth :i64] :bool
  (let [v (t2-res M v0) op (t2-op-of M v)]
    (cond (> depth 6) false
          (= op t2-cmp) true
          (t2-isconst? M v) (or (= (t2-kval M v) 0) (= (t2-kval M v) 1))
          (and (= op t2-un) (= (t2-vf M v t2-f-a) UOP-NOT)) (t2-bool? M (t2-vf M v t2-f-b) (inc depth))
          (= op t2-sel) (and (t2-bool? M (t2-vf M v t2-f-b) (inc depth)) (t2-bool? M (t2-vf M v t2-f-c) (inc depth)))
          ;; a join of booleans (a cycle runs out of depth: not known)
          (and (= op t2-phi) (= (t2-vf M v t2-f-repl) 0))
          (loop [k 0 n (t2-bget M t2-a-bpn (t2-vf M v t2-f-blk))]
            (cond (>= k n) (> n 0)
                  (let [x (t2-phiarg M v k)] (and (> x 0) (not= x v) (t2-bool? M x (inc depth)))) (recur (inc k) n)
                  :else false))
          :else false)))
(defn- t2-bin-identity [M :vector-i64 v :i64] :i64
  (if false 0
    (let [bop (t2-vf M v t2-f-a) x (t2-res M (t2-vf M v t2-f-b)) y (t2-res M (t2-vf M v t2-f-c))
          kx (if (t2-isconst? M x) (t2-kval M x) 7) ky (if (t2-isconst? M y) (t2-kval M y) 7)
          yc (t2-isconst? M y) xc (t2-isconst? M x)]
      (cond (and yc (= ky 0) (or (= bop BOP-ADD) (= bop BOP-SUB) (= bop BOP-OR) (= bop BOP-XOR))) x
            (and xc (= kx 0) (or (= bop BOP-ADD) (= bop BOP-OR) (= bop BOP-XOR))) y
            (and yc (= (bit-and ky 63) 0) (or (= bop BOP-SHL) (= bop BOP-USHR) (= bop BOP-SSHR))) x
            (and yc (= ky 1) (or (= bop BOP-MUL) (= bop BOP-QUOT))) x
            (and xc (= kx 1) (= bop BOP-MUL)) y
            (and yc (= ky -1) (= bop BOP-AND)) x
            (and xc (= kx -1) (= bop BOP-AND)) y
            :else 0))))
(defn- t2-gvn-blocks [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-gvn-blocks (if (= (t2-bget M t2-a-breach b) 1) (t2-gvn-vals M b (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b)) M) (inc b))))
(defn- t2-gvn [M :vector-i64] :vector-i64
  (let [M1 (-> M (t2-dom-init 0) (t2-dominators 0))]
    (if (not= (t2-g M1 t2-s-fail) 0) M1
      (-> M1 (t2-wzero t2-a-hash 0 t2-hsize) (t2-gvn-blocks 0)))))
;; ---- reassociation of constant offsets (after GVN; then GVN again) ----------------------------------------------------
;; v = x + k or x - k with x = y + k2: v := y + (k + k2). v = x << s or x * m (s, m constants) with x = y + k used only by v:
;; x := y << s (y * m), v := x + (k << s) (k * m). x - k is x + (-k). All exact modulo 2^64; folded values die, and equal
;; scaled bases (struct-in-vector indices) meet in the second GVN. Use counts (t2-uses) are kept current.
(defn- t2-ra-binop? [M :vector-i64 v :i64 bop :i64] :bool
  (and (> v 0) (= (t2-op-of M v) t2-bin) (= (t2-vf M v t2-f-a) bop) (= (t2-vf M v t2-f-repl) 0)))
;; x = y + k with a constant k (either side) and y not constant: y (0 when not that shape); its k in M[last]
(defn- t2-ra-addk [M :vector-i64 x :i64] :vector-i64
  (if (not (t2-ra-binop? M x BOP-ADD)) (t2-s M t2-s-last 0)
    (let [p (t2-res M (t2-vf M x t2-f-b)) q (t2-res M (t2-vf M x t2-f-c))]
      (cond (and (t2-isconst? M q) (not (t2-isconst? M p)) (= (t2-op-of M q) t2-const)) (t2-s (t2-s M t2-s-tmpk (t2-kval M q)) t2-s-last p)
            (and (t2-isconst? M p) (not (t2-isconst? M q)) (= (t2-op-of M p) t2-const)) (t2-s (t2-s M t2-s-tmpk (t2-kval M p)) t2-s-last q)
            :else (t2-s M t2-s-last 0)))))
(def t2-s-tmpk 79)
(defn- t2-ra-uses [M :vector-i64 x :i64 d :i64] :vector-i64 (if (> x 0) (t2-xs M x t2-x-uses (+ (t2-xf M x t2-x-uses) d)) M))
;; v := y op k (a new constant)
(defn- t2-ra-set [M :vector-i64 v :i64 bop :i64 y :i64 k :i64] :vector-i64
  (let [M1 (t2-new M t2-const k 0 0 (t2-vf M v t2-f-blk)) c (t2-last M1)]
    (if (= c 0) M1 (-> M1 (t2-vs v t2-f-a bop) (t2-vs v t2-f-b y) (t2-vs v t2-f-c c)))))
;; a branch on (not x) of a boolean x used only there: a branch on x with the other polarity (the not dies)
(defn- t2-ra-brz [M :vector-i64 v :i64] :vector-i64
  (let [c (t2-res M (t2-vf M v t2-f-a))]
    (if (and (> c 0) (= (t2-op-of M c) t2-un) (= (t2-vf M c t2-f-a) UOP-NOT) (= (t2-vf M c t2-f-repl) 0)
             (= (t2-xf M c t2-x-uses) 1) (t2-bool? M (t2-vf M c t2-f-b) 0))
      (-> M (t2-vs v t2-f-a (t2-res M (t2-vf M c t2-f-b))) (t2-vs v t2-f-b (- 1 (t2-vf M v t2-f-b))) (t2-xs c t2-x-uses 0))
      M)))
;; sign extension: sel(n >= 2^(k-1), n - 2^k, n) (or sel(n < 2^(k-1), n, n - 2^k)) with n = z & (2^k - 1) is the low k
;; bits of z sign-extended: one sbfx (an UN with a = 1000 + k)
(defn- t2-ra-kof [M :vector-i64 x :i64] :i64 (if (and (> x 0) (= (t2-op-of M x) t2-const)) (t2-kval M x) -1))
(defn- t2-ra-minus? [M :vector-i64 a :i64 n :i64 p :i64] :bool
  (and (> a 0) (= (t2-op-of M a) t2-bin) (= (t2-vf M a t2-f-repl) 0)
       (let [bop (t2-vf M a t2-f-a) x (t2-res M (t2-vf M a t2-f-b)) y (t2-res M (t2-vf M a t2-f-c))]
         (or (and (= bop BOP-SUB) (= x n) (= (t2-ra-kof M y) p))
             (and (= bop BOP-ADD) (= x n) (= (t2-op-of M y) t2-const) (= (t2-kval M y) (- 0 p)))
             (and (= bop BOP-ADD) (= y n) (= (t2-op-of M x) t2-const) (= (t2-kval M x) (- 0 p)))))))
(defn- t2-ra-sel [M :vector-i64 v :i64] :vector-i64
  (let [c (t2-res M (t2-vf M v t2-f-a)) x (t2-res M (t2-vf M v t2-f-b)) y (t2-res M (t2-vf M v t2-f-c))]
    (if (or (<= c 0) (not= (t2-op-of M c) t2-cmp)) M
      (let [cc (t2-vf M c t2-f-a) p (t2-res M (t2-vf M c t2-f-b)) q (t2-res M (t2-vf M c t2-f-c))
            ;; n >= H (x the minus arm) or n < H (y the minus arm)
            ge (or (and (= cc CC-GE) (> (t2-ra-kof M q) 0)) (and (= cc CC-LE) (> (t2-ra-kof M p) 0)))
            lt (or (and (= cc CC-LT) (> (t2-ra-kof M q) 0)) (and (= cc CC-GT) (> (t2-ra-kof M p) 0)))
            n (if (or (= cc CC-GE) (= cc CC-LT)) p q)
            H (if (or (= cc CC-GE) (= cc CC-LT)) (t2-ra-kof M q) (t2-ra-kof M p))
            k (inc (gn-pow2 H))
            ok (and (or ge lt) (> H 1) (> (gn-pow2 H) 0) (< k 64)
                    (t2-ra-binop? M n BOP-AND)
                    (if ge (and (= y n) (t2-ra-minus? M x n (* 2 H))) (and (= x n) (t2-ra-minus? M y n (* 2 H)))))
            z (if ok (let [a (t2-res M (t2-vf M n t2-f-b)) b (t2-res M (t2-vf M n t2-f-c))]
                       (cond (= (t2-ra-kof M b) (dec (* 2 H))) a (= (t2-ra-kof M a) (dec (* 2 H))) b :else 0)) 0)]
        (if (or (not ok) (= z 0) (t2-isconst? M z)) M
          (-> M (t2-vs v t2-f-op t2-un) (t2-vs v t2-f-a (+ 1000 k)) (t2-vs v t2-f-b z) (t2-vs v t2-f-c 0)
              (t2-ra-uses c -1) (t2-ra-uses x -1) (t2-ra-uses y -1) (t2-ra-uses z 1)))))))
;; not(x cc y) of a compare used only there: the compare with the negated condition (T2's private NE = 6 for not =)
(def t2-cc-ne 6)
(defn- t2-cc-neg [cc :i64] :i64
  (cond (= cc CC-EQ) t2-cc-ne (= cc t2-cc-ne) CC-EQ (= cc CC-LT) CC-GE (= cc CC-GE) CC-LT (= cc CC-GT) CC-LE (= cc CC-LE) CC-GT :else 0))
(defn- t2-ra-not [M :vector-i64 v :i64] :vector-i64
  (let [c (t2-res M (t2-vf M v t2-f-b))]
    (if (and (= (t2-vf M v t2-f-a) UOP-NOT) (= (t2-vf M v t2-f-repl) 0) (> c 0) (= (t2-op-of M c) t2-cmp) (= (t2-vf M c t2-f-repl) 0)
             (= (t2-xf M c t2-x-uses) 1) (> (t2-cc-neg (t2-vf M c t2-f-a)) 0))
      (let [a (t2-res M (t2-vf M c t2-f-b)) b (t2-res M (t2-vf M c t2-f-c))]
        (-> M (t2-vs v t2-f-op t2-cmp) (t2-vs v t2-f-a (t2-cc-neg (t2-vf M c t2-f-a))) (t2-vs v t2-f-b a) (t2-vs v t2-f-c b)
            (t2-xs c t2-x-uses 0) (t2-ra-uses a 1) (t2-ra-uses b 1)))
      M)))
(defn- t2-ra-val [M :vector-i64 v :i64] :vector-i64
  (if (and (= (t2-op-of M v) t2-un) (not (t2-gone? M v))) (t2-ra-not M v)
  (if (and (= (t2-op-of M v) t2-sel) (not (t2-gone? M v))) (t2-ra-sel M v)
  (if (and (= (t2-op-of M v) t2-brz) (not (t2-gone? M v))) (t2-ra-brz M v)
  (if (or (not= (t2-op-of M v) t2-bin) (not= (t2-vf M v t2-f-repl) 0)) M
    (let [bop (t2-vf M v t2-f-a) p (t2-res M (t2-vf M v t2-f-b)) q (t2-res M (t2-vf M v t2-f-c))
          qk (and (t2-isconst? M q) (= (t2-op-of M q) t2-const)) pk (and (t2-isconst? M p) (= (t2-op-of M p) t2-const))]
      (cond
        ;; x - k: x + (-k)
        (and (= bop BOP-SUB) qk (not pk) (not= (t2-kval M q) -9223372036854775808))
        (t2-ra-val (t2-ra-set M v BOP-ADD p (- 0 (t2-kval M q))) v)
        (and (= bop BOP-ADD) (or qk pk) (not (and qk pk)))
        (let [x (if qk p q) k (t2-kval M (if qk q p)) M1 (t2-ra-addk M x) y (t2-last M1)]
          (if (= y 0) M1
            (-> M1 (t2-ra-set v BOP-ADD y (+ k (t2-g M1 t2-s-tmpk))) (t2-ra-uses x -1) (t2-ra-uses y 1))))
        (or (and (= bop BOP-SHL) qk (not pk) (>= (t2-kval M q) 0) (< (t2-kval M q) 64))
            (and (= bop BOP-MUL) (or qk pk) (not (and qk pk))))
        (let [x (if (and (= bop BOP-MUL) pk) q p) m (t2-kval M (if (and (= bop BOP-MUL) pk) p q))
              M1 (t2-ra-addk M x) y (t2-last M1) k (t2-g M1 t2-s-tmpk)]
          (if (or (= y 0) (not= (t2-xf M1 x t2-x-uses) 1)) M1
            (let [M2 (t2-ra-set M1 x bop y m)]
              (t2-ra-set M2 v BOP-ADD x (if (= bop BOP-SHL) (i64-shift-left k m) (* k m))))))
        :else M)))))))
(defn- t2-ra-pass [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (or (> v nv) (not (t2-ok? M))) M (t2-ra-pass (t2-ra-val M v) (inc v) nv)))
(defn- t2-reassoc [M :vector-i64] :vector-i64
  (if (or (= t2-ra-on 0) (not (t2-ok? M))) M
    (let [nv (t2-g M t2-s-nv)
          M1 (-> M (t2-clear-x 1 nv) (t2-uses 1 nv) (t2-ra-pass 1 nv))]
      ;; GVN again (folded index expressions meet), then redundant loads, then GVN once more for their users
      (if (not (t2-ok? M1)) M1
        (-> M1 (t2-wzero t2-a-hash 0 t2-hsize) (t2-gvn-blocks 0) (t2-ldcse (t2-g M1 t2-s-nv))
            (t2-wzero t2-a-hash 0 t2-hsize) (t2-gvn-blocks 0))))))
(def t2-ra-on 1)
;; ---- redundant loads: a vat with the same handle and index as a dominating vat w, with no store (vset) or real call on
;; any path from w to it, reads the same item (w's check already passed): it is w. Blocks on such paths: reachable from
;; w's block and reaching v's block (kd marks: forward 0..maxb, backward maxb..2maxb); a block on a cycle through them
;; counts whole.
(defn- t2-clob? [M :vector-i64 x :i64] :bool
  (and (not (t2-gone? M x)) (let [op (t2-op-of M x)] (or (= op t2-vset) (= op t2-call)))))
(defn- t2-clean? [M :vector-i64 v0 :i64 v1 :i64] :bool
  (loop [x v0] (or (>= x v1) (and (not (t2-clob? M x)) (recur (inc x))))))
(defn- t2-mark-pass [M :vector-i64 base :i64 fwd :bool changed :i64] :vector-i64
  (loop [b 0 m M ch changed]
    (if (>= b (t2-g m t2-s-nb)) (t2-s m t2-s-last ch)
      (if (not= (t2-bget m base b) 1) (recur (inc b) m ch)
        (if fwd
          (let [t (t2-bget m t2-a-bt b) f (t2-bget m t2-a-bf b)
                nt (and (>= t 0) (not= (t2-bget m base t) 1))
                nf (and (>= f 0) (not= (t2-bget m base f) 1) (not= f t))
                m2 (-> m (cond-> nt (t2-bset base t 1)) (cond-> nf (t2-bset base f 1)))]
            (recur (inc b) m2 (if (or nt nf) 1 ch)))
          (let [n (t2-bget m t2-a-bpn b)
                r (loop [k 0 mm m c ch] (if (>= k n) (t2-s mm t2-s-last c)
                                          (let [p (t2-pred mm b k)] (if (= (t2-bget mm base p) 1) (recur (inc k) mm c) (recur (inc k) (t2-bset mm base p 1) 1)))))]
            (recur (inc b) r (t2-last r))))))))
(defn- t2-mark-fix [M :vector-i64 base :i64 fwd :bool] :vector-i64
  (loop [m M i 0] (if (>= i 64) m (let [m1 (t2-mark-pass m base fwd 0)] (if (= (t2-last m1) 1) (recur m1 (inc i)) m1)))))
(defn- t2-ld-path-ok? [M :vector-i64 w :i64 v :i64] :bool
  (let [bw (t2-vf M w t2-f-blk) bv (t2-vf M v t2-f-blk) nb (t2-g M t2-s-nb)]
    (if (= bw bv) (and (< w v) (t2-clean? M (inc w) v))
      (let [m0 (t2-wzero M t2-a-kd 0 (* 2 t2-maxb))
            ;; forward from w's successors, backward from v's predecessors
            m1 (let [t (t2-bget m0 t2-a-bt bw) f (t2-bget m0 t2-a-bf bw)]
                 (-> m0 (cond-> (>= t 0) (t2-bset t2-a-kd t 1)) (cond-> (>= f 0) (t2-bset t2-a-kd f 1)) (t2-mark-fix t2-a-kd true)))
            m2 (loop [k 0 m m1] (if (>= k (t2-bget m t2-a-bpn bv)) m (recur (inc k) (t2-bset m (+ t2-a-kd t2-maxb) (t2-pred m bv k) 1))))
            m3 (t2-mark-fix m2 (+ t2-a-kd t2-maxb) false)]
        (and (t2-clean? m3 (inc w) (t2-bget m3 t2-a-bv1 bw))
             (t2-clean? m3 (t2-bget m3 t2-a-bv0 bv) v)
             ;; w's block again on a path (a cycle): all of it; v's block likewise
             (or (not (and (= (t2-bget m3 t2-a-kd bw) 1) (= (t2-bget m3 (+ t2-a-kd t2-maxb) bw) 1)))
                 (t2-clean? m3 (t2-bget m3 t2-a-bv0 bw) (t2-bget m3 t2-a-bv1 bw)))
             (or (not (and (= (t2-bget m3 t2-a-kd bv) 1) (= (t2-bget m3 (+ t2-a-kd t2-maxb) bv) 1)))
                 (t2-clean? m3 (t2-bget m3 t2-a-bv0 bv) (t2-bget m3 t2-a-bv1 bv)))
             (loop [b 0]
               (or (>= b nb)
                   (and (or (= b bw) (= b bv) (not= (t2-bget m3 t2-a-kd b) 1) (not= (t2-bget m3 (+ t2-a-kd t2-maxb) b) 1)
                            (t2-clean? m3 (t2-bget m3 t2-a-bv0 b) (t2-bget m3 t2-a-bv1 b)))
                        (recur (inc b))))))))))
;; one index value, or two constants of one value (folded constants are separate values outside every block)
(defn- t2-same-index? [M :vector-i64 a :i64 b :i64] :bool
  (or (= a b) (and (= (t2-op-of M a) t2-const) (= (t2-op-of M b) t2-const) (= (t2-kval M a) (t2-kval M b)))))
;; the handle's object (aliases through returned arguments and phis are one vector)
(defn- t2-ld-obj [M :vector-i64 h :i64] :i64 (if (t2-objkind? M h) (t2-obj M h) h))
(defn- t2-ldcse [M :vector-i64 nv :i64] :vector-i64
  (if (= t2-ldcse-on 0) M
    (loop [v 1 m (t2-objs M nv) n 0]
      (if (or (> v nv) (> n 4096)) m
        (if (or (not= (t2-op-of m v) t2-vat) (t2-gone? m v) (= (t2-bget m t2-a-breach (t2-vf m v t2-f-blk)) 0)) (recur (inc v) m n)
          (let [h (t2-ld-obj m (t2-res m (t2-vf m v t2-f-a))) i (t2-res m (t2-vf m v t2-f-b))
                w (loop [w (dec v) k 0]
                    (cond (or (< w 1) (> k 64)) 0
                          (and (= (t2-op-of m w) t2-vat) (not (t2-gone? m w)) (= (t2-ld-obj m (t2-res m (t2-vf m w t2-f-a))) h)
                               (t2-same-index? m (t2-res m (t2-vf m w t2-f-b)) i) (t2-dom? m (t2-vf m w t2-f-blk) (t2-vf m v t2-f-blk))
                               (t2-ld-path-ok? m w v)) w
                          (= (t2-op-of m w) t2-vat) (recur (dec w) (inc k))
                          :else (recur (dec w) k)))]
            (recur (inc v) (if (> w 0) (t2-vs m v t2-f-repl w) m) (inc n))))))))
(def t2-ldcse-on 1)
;; an ordinary value replaced by GVN is not emitted
(defn- t2-gone? [M :vector-i64 v :i64] :bool (and (not= (t2-op-of M v) t2-phi) (not= (t2-vf M v t2-f-repl) 0)))
;; ---- positions, uses, validation ---------------------------------------------------------------------------------------
(def t2-x-pos 0) (def t2-x-start 1) (def t2-x-end 2) (def t2-x-flags 3) (def t2-x-next 4) (def t2-x-uses 5)
(def t2-s-ntab 24)
(def t2-s-maxpos 25)
(defn- t2-xf [M :vector-i64 v :i64 fld :i64] :i64 (t2-g M (+ t2-a-vx (* v t2-xw) fld)))
(defn- t2-xs [M :vector-i64 v :i64 fld :i64 x :i64] :vector-i64 (t2-s M (+ t2-a-vx (* v t2-xw) fld) x))
(defn- t2-op-of [M :vector-i64 v :i64] :i64 (t2-vf M v t2-f-op))
;; a value that never needs a register (materialized or no result)
(defn- t2-noreg? [M :vector-i64 v :i64] :bool
  (let [op (t2-op-of M v)]
    (or (= op t2-const) (= op t2-undef) (= op t2-fuel) (= op t2-pub) (= op t2-vset) (= op t2-trap) (= op t2-ret)
        (= op t2-br) (= op t2-brz) (= op t2-slen) (not= (bit-and (t2-xf M v t2-x-flags) 165) 0))))
(defn- t2-use1 [M :vector-i64 x :i64] :vector-i64
  (let [r (t2-res M x)] (if (> r 0) (t2-xs M r t2-x-uses (inc (t2-xf M r t2-x-uses))) M)))
;; count uses: operands (resolved), phi operands; vector handles of vat/vset count only in a function with a non-tail
;; real call (descriptor refresh after a call reads the register of the class member desc-live across it); without one
;; the descriptor registers alone serve; nor is the handle of string-length a use (its slot's registers serve);
;; string-code-point-at reads its handle and index (the host call of its slow path takes both)
(defn- t2-uses-phi [M :vector-i64 start :i64 k :i64 n :i64] :vector-i64
  (if (>= k n) M (t2-uses-phi (t2-use1 M (t2-g M (+ t2-a-phiop start k))) start (inc k) n)))
;; ---- transitive dead values: a value nothing live uses gives back its operands' uses (pure values only: integer BIN
;; except a quotient that may trap, CMP, UN, SEL, DTAB, phis; tables, accesses, calls and charges stay) ----
(defn- t2-dce-pure? [M :vector-i64 v :i64] :bool
  (let [op (t2-op-of M v)]
    (or (= op t2-cmp) (= op t2-un) (= op t2-sel) (= op t2-dtab) (and (= op t2-phi) (= (t2-vf M v t2-f-repl) 0))
        (and (= op t2-bin) (< (t2-vf M v t2-f-a) BOP-F64-ADD)
             (or (not= (t2-vf M v t2-f-a) BOP-QUOT)
                 (let [y (t2-res M (t2-vf M v t2-f-c))] (and (t2-isconst? M y) (not= (t2-kval M y) 0) (not= (t2-kval M y) -1))))))))
(defn- t2-dce-dec [M :vector-i64 x0 :i64] :vector-i64
  (let [x (t2-res M x0)] (if (and (> x 0) (> (t2-xf M x t2-x-uses) 0)) (t2-xs M x t2-x-uses (dec (t2-xf M x t2-x-uses))) M)))
(defn- t2-dce-pass [M :vector-i64 v :i64 changed :i64] :vector-i64
  (if (< v 1) (t2-s M t2-s-last changed)
    (if (and (not (t2-gone? M v)) (= (t2-xf M v t2-x-uses) 0) (not= (bit-and (t2-xf M v t2-x-flags) 512) 512) (t2-dce-pure? M v))
      (let [op (t2-op-of M v)
            M1 (cond (= op t2-phi) (loop [k 0 m M] (if (>= k (t2-vf M v t2-f-b)) m (recur (inc k) (t2-dce-dec m (t2-g m (+ t2-a-phiop (t2-vf M v t2-f-a) k))))))
                     (= op t2-un) (t2-dce-dec M (t2-vf M v t2-f-b))
                     (= op t2-sel) (-> M (t2-dce-dec (t2-vf M v t2-f-a)) (t2-dce-dec (t2-vf M v t2-f-b)) (t2-dce-dec (t2-vf M v t2-f-c)))
                     (= op t2-dtab) (t2-dce-dec M (t2-vf M v t2-f-c))
                     :else (-> M (t2-dce-dec (t2-vf M v t2-f-b)) (t2-dce-dec (t2-vf M v t2-f-c))))]
        (t2-dce-pass (t2-xs M1 v t2-x-flags (bit-or (t2-xf M1 v t2-x-flags) 512)) (dec v) 1))
      (t2-dce-pass M (dec v) changed))))
(defn- t2-dce [M :vector-i64 nv :i64] :vector-i64
  (loop [m M i 0] (if (>= i 16) m (let [m1 (t2-dce-pass m nv 0)] (if (= (t2-last m1) 1) (recur m1 (inc i)) m1)))))
(defn- t2-uses [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (> v nv) M
    (let [op (t2-op-of M v) a (t2-vf M v t2-f-a) b (t2-vf M v t2-f-b) c (t2-vf M v t2-f-c)
          M1 (cond (t2-gone? M v) M
                   (and (= op t2-phi) (= (t2-vf M v t2-f-repl) 0)) (t2-uses-phi M a 0 b)
                   (or (= op t2-bin) (= op t2-cmp)) (-> M (t2-use1 b) (t2-use1 c))
                   (= op t2-un) (t2-use1 M b)
                   (= op t2-vat) (-> M (t2-use1 b) (cond-> (= (t2-g M t2-s-hc) 1) (t2-use1 a)))
                   (= op t2-vset) (-> M (t2-use1 b) (t2-use1 c) (cond-> (= (t2-g M t2-s-hc) 1) (t2-use1 a)))
                   (= op t2-tab) (t2-use1 M c)
                   (t2-cpx? op) (-> M (t2-use1 b) (t2-use1 c))
                   (= op t2-sel) (-> M (t2-use1 a) (t2-use1 b) (t2-use1 c))
                   (= op t2-dtab) (t2-use1 M c)
                   (= op t2-call) (t2-uses-phi M b 0 c)
                   (or (= op t2-ret) (= op t2-brz)) (t2-use1 M a)
                   :else M)]
      (t2-uses M1 (inc v) nv))))
(defn- t2-clear-x [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (> v nv) M
    (t2-clear-x (-> M (t2-xs v t2-x-pos -1) (t2-xs v t2-x-start 999999) (t2-xs v t2-x-end -1)
                      (t2-xs v t2-x-flags 0) (t2-xs v t2-x-next 0) (t2-xs v t2-x-uses 0))
                (inc v) nv)))
;; the last ordinary value of block b (its terminator when it has one), 0 when none
(defn- t2-lastval [M :vector-i64 b :i64] :i64
  (loop [v (dec (t2-bget M t2-a-bv1 b))]
    (cond (< v (t2-bget M t2-a-bv0 b)) 0
          (or (= (t2-op-of M v) t2-phi) (t2-gone? M v)) (recur (dec v))
          :else v)))
;; mark a CMP fused into its block's BRZ when that is its only use
(defn- t2-fuse [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (let [t (if (= (t2-bget M t2-a-breach b) 1) (t2-lastval M b) 0)
          c (if (and (> t 0) (= (t2-op-of M t) t2-brz)) (t2-res M (t2-vf M t t2-f-a)) 0)
          ok (and (> c 0) (= (t2-op-of M c) t2-cmp) (= (t2-vf M c t2-f-blk) b) (= (t2-xf M c t2-x-uses) 1))]
      (t2-fuse (if ok (t2-xs M c t2-x-flags 1) M) (inc b)))))
;; a CMP whose every use is the condition (or an arm equal to the condition) of a SEL in its own block, or that block's
;; BRZ, is emitted by each of them (flag 128): no register, no cset, its operands live until the last of them
(defn- t2-sel-cuses [M :vector-i64 c :i64 v :i64 v1 :i64 n :i64] :i64
  (if (>= v v1) n
    (t2-sel-cuses M c (inc v) v1
                  (if (and (= (t2-op-of M v) t2-sel) (not (t2-gone? M v)) (= (t2-res M (t2-vf M v t2-f-a)) c))
                    (+ n 1 (if (= (t2-res M (t2-vf M v t2-f-b)) c) 1 0) (if (= (t2-res M (t2-vf M v t2-f-c)) c) 1 0))
                    n))))
(defn- t2-sfuse-b [M :vector-i64 b :i64 v :i64 v1 :i64] :vector-i64
  (if (>= v v1) M
    (t2-sfuse-b (if (and (= (t2-op-of M v) t2-cmp) (not (t2-gone? M v)) (> (t2-xf M v t2-x-uses) 0)
                         (= (bit-and (t2-xf M v t2-x-flags) 5) 0) (= (t2-vf M v t2-f-blk) b)
                         (= (+ (t2-sel-cuses M v (inc v) v1 0)
                               (let [t (t2-lastval M b)] (if (and (> t 0) (= (t2-op-of M t) t2-brz) (= (t2-res M (t2-vf M t t2-f-a)) v)) 1 0)))
                            (t2-xf M v t2-x-uses))
                         (> (t2-sel-cuses M v (inc v) v1 0) 0))
                  (t2-xs M v t2-x-flags (bit-or (t2-xf M v t2-x-flags) 128))
                  M)
                b (inc v) v1)))
(defn- t2-sfuse [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-sfuse (if (= (t2-bget M t2-a-breach b) 1) (t2-sfuse-b M b (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b)) M) (inc b))))
;; validate vector/table ops; record handle class members, string slots and tables
(defn- t2-tab-reg [M :vector-i64 lit :i64 adj :i64 k :i64 n :i64] :vector-i64
  (cond (>= k n) (if (>= n 16) (t2-fail M 9)
                   (-> M (t2-s (+ t2-a-tb (* 2 n)) lit) (t2-s (+ t2-a-tb (* 2 n) 1) -1) (t2-s (+ t2-a-tbadj n) adj)
                       (t2-s t2-s-ntab (inc n))))
        (= (t2-g M (+ t2-a-tb (* 2 k))) lit) M
        :else (t2-tab-reg M lit adj (inc k) n)))
;; a bounded table's base register points at its item -base for the signed clamp (t2-e-dtab); its t2-a-tbadj entry is
;; that byte adjustment + 1 when it comes from an inlined callee (odd: its words are not counted by the size rule)
(defn- t2-dt-u [pk :i64] :i64 (bit-and pk 1))
(defn- t2-dt-inl [pk :i64] :i64 (bit-and (i64-shift-right pk 1) 1))
(defn- t2-dt-n [pk :i64] :i64 (bit-and (i64-shift-right pk 2) 4095))
(defn- t2-dt-base [pk :i64] :i64 (i64-shift-right pk 14))
(defn- t2-dt-adj [pk :i64] :i64 (if (= (t2-dt-u pk) 1) 0 (* -8 (t2-dt-base pk))))
(defn- t2-check [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (or (> v nv) (not= (t2-g M t2-s-fail) 0)) M
    (let [op (t2-op-of M v)
          M1 (cond (= op t2-vcnt) (t2-fail M 9)
                   (or (= op t2-slen) (t2-cpx? op)) (t2-sd-reg-slot M v op)
                   (or (= op t2-vat) (= op t2-vset)) (t2-hadd M (t2-res M (t2-vf M v t2-f-a)))
                   (= op t2-tab) (t2-tab-reg M (t2-vf M v t2-f-a) 0 0 (t2-g M t2-s-ntab))
                   (= op t2-dtab) (t2-tab-reg M (t2-vf M v t2-f-a) (+ (t2-dt-adj (t2-vf M v t2-f-b)) (t2-dt-inl (t2-vf M v t2-f-b)))
                                              0 (t2-g M t2-s-ntab))
                   :else M)]
      (t2-check M1 (inc v) nv))))
;; ---- string (pair) slots: one per parameter handle k (0..7) read by string-length / string-code-point-at ----------------
;; A pair never changes while its handle is valid, and a handle valid at some point stays valid (pairs are only appended;
;; an arena scope releases only handles minted inside it, which no enclosing frame holds), so a slot's registers are read
;; once at entry WITHOUT trapping and after every real call (as vector descriptors are):
;;   V     pairs_base + 16 (h - 1) for a valid handle (never 0), 0 for an invalid one   (need bit 1)
;;   SLEN  the pair's second word (string-length)                                         (need bit 2)
;;   FLEN  the length when the bytes are code-relative (first >= 0, first + length <=u code_length) -- the old inline
;;         fast path's condition -- else 0                                                  (need bit 4)
;;   FBASE code_base + first                                                               (need bit 4)
;; string-length checks V at its own position (udf as the old handle check) and IS the SLEN register; string-code-point-
;; at runs the old inline fast path (index <u FLEN, ASCII byte) and otherwise calls the same host helper with the same
;; arguments at the same point (a cold stub that publishes the fuel and saves every register T2 uses).
;; fields: 0 needs, 1 V, 2 SLEN, 3 FLEN, 4 FBASE, 5 handle value
(def t2-sdw 8)
(defn- t2-sd [M :vector-i64 k :i64 fld :i64] :i64 (t2-g M (+ t2-a-sd (* k t2-sdw) fld)))
(defn- t2-sds [M :vector-i64 k :i64 fld :i64 x :i64] :vector-i64 (t2-s M (+ t2-a-sd (* k t2-sdw) fld) x))
;; parameter index of the handle (field b) of string op v, -1 when the handle is not a parameter
(defn- t2-hparam [M :vector-i64 v :i64] :i64
  (let [h (t2-res M (t2-vf M v t2-f-b))] (if (and (> h 0) (= (t2-op-of M h) t2-param)) (t2-vf M h t2-f-a) -1)))
(defn- t2-sd-reg-slot [M :vector-i64 v :i64 op :i64] :vector-i64
  (let [k (t2-hparam M v)]
    (cond (or (< k 0) (>= k 7)) (t2-fail M 30)   ; a register parameter (k >= 7 arrives on the stack)
          ;; the host call needs the published counter: only in published (nonleaf) mode, as in the old code
          (and (t2-cpx? op) (= (t2-g M t2-s-pub) 0)) (t2-fail M 31)
          :else (-> M (t2-sds k 0 (bit-or (t2-sd M k 0) (cond (= op t2-slen) 3 (= op t2-cpa) 4 :else 7)))
                    (t2-sds k 5 (t2-res M (t2-vf M v t2-f-b)))))))
(defn- t2-has-sd? [M :vector-i64] :bool (loop [k 0] (and (< k 8) (or (not= (t2-sd M k 0) 0) (recur (inc k))))))
;; ---- descriptor slots: handle classes -----------------------------------------------------------------------------------
;; Every value used as a vector handle (vat/vset operand a) and, transitively, every operand of such a phi is a class
;; member: a register parameter, a real call's result or a phi (anything else refuses with 8, a stack parameter with 34). Phi-connected members form one class
;; (union-find), and a class owns one descriptor slot: base and length registers fixed for the whole function.
;; Invariant: wherever a member h is desc-live (its descriptor is read before the next call, see below), its slot holds
;; desc(h) (non-faulting: length 0 for an invalid handle). Writes: a parameter at entry; after a call, the call's result
;; from x0 or a refresh from the register of the member desc-live across it (handle uses count as register uses with
;; calls, so that register is callee-saved and holds it); a phi needs no write, as its incoming operand is a member
;; desc-live at the edge and owns the slot there. So the members of a class must not interfere (t2-cls-interf, on
;; register liveness). Without non-tail calls a class has no call results, and with its single parameter as the only root
;; every member equals that parameter. A class has at most one parameter.
(def t2-s-hc 80)      ; 1 = the function makes a non-tail real call
(def t2-s-nslot 81)   ; descriptor slots (classes)
(def t2-a-uf (+ t2-a-trl (* 64 6)))      ; per value: union-find parent (0 = not a member); t2-hnd-words in all
(def t2-a-cls (+ t2-a-uf t2-maxv))      ; per value: slot + 1 (0 = none)
(def t2-a-cm (+ t2-a-cls t2-maxv))      ; per slot: up to 16 members
(def t2-a-cmn (+ t2-a-cm 256))          ; per slot: member count
(def t2-maxcm 16)
;; a non-tail real call (descriptors are refreshed only after those; nothing lives across a tail call)
(defn- t2-hcflag [M :vector-i64 v :i64 nv :i64] :vector-i64
  (cond (> v nv) M
        (and (= (t2-op-of M v) t2-call) (not (t2-tailcall? M v (t2-bget M t2-a-bv1 (t2-vf M v t2-f-blk))))) (t2-s M t2-s-hc 1)
        :else (t2-hcflag M (inc v) nv)))
(defn- t2-hmember? [M :vector-i64 h :i64] :bool (and (> h 0) (> (t2-g M (+ t2-a-uf h)) 0)))
(defn- t2-hadd [M :vector-i64 h :i64] :vector-i64
  (let [op (if (> h 0) (t2-op-of M h) 0)]
    (cond (<= h 0) (t2-fail M 8)
          (t2-hmember? M h) M
          (and (= op t2-param) (>= (t2-vf M h t2-f-a) 7)) (t2-fail M 34)   ; a stack vector parameter
          (or (= op t2-param) (= op t2-call) (= op t2-phi)) (t2-s M (+ t2-a-uf h) h)
          :else (t2-fail M 8))))
(defn- t2-uf-find [M :vector-i64 v :i64] :i64
  (let [p (t2-g M (+ t2-a-uf v))] (if (or (= p v) (<= p 0)) v (t2-uf-find M p))))
(defn- t2-uf-union [M :vector-i64 a :i64 b :i64] :vector-i64
  (let [ra (t2-uf-find M a) rb (t2-uf-find M b)] (if (= ra rb) M (t2-s M (+ t2-a-uf (gn-max ra rb)) (gn-min ra rb)))))
;; one pass: every operand of a member phi joins its class; M[last] = 1 when a member was added
(defn- t2-cls-pass [M :vector-i64 v :i64 nv :i64 changed :i64] :vector-i64
  (if (or (> v nv) (not (t2-ok? M))) (t2-s M t2-s-last changed)
    (if (and (t2-hmember? M v) (= (t2-op-of M v) t2-phi))
      (let [a (t2-vf M v t2-f-a) n (t2-vf M v t2-f-b)
            r (loop [k 0 m M ch changed]
                (if (or (>= k n) (not (t2-ok? m))) (t2-s m t2-s-last ch)
                  (let [x (t2-res m (t2-g m (+ t2-a-phiop a k))) new (not (t2-hmember? m x)) m1 (t2-hadd m x)]
                    (recur (inc k) (if (t2-ok? m1) (t2-uf-union m1 v x) m1) (if new 1 ch)))))]
        (t2-cls-pass r (inc v) nv (t2-last r)))
      (t2-cls-pass M (inc v) nv changed))))
(defn- t2-cls-close [M :vector-i64 nv :i64 iter :i64] :vector-i64
  (if (>= iter 64) (t2-fail M 8)
    (let [M1 (t2-cls-pass M 1 nv 0)] (if (and (t2-ok? M1) (= (t2-last M1) 1)) (t2-cls-close M1 nv (inc iter)) M1))))
;; a slot per class (roots are least ids, met first), its member list and parameter
(defn- t2-cls-slots [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (or (> v nv) (not (t2-ok? M))) M
    (t2-cls-slots
      (if (t2-hmember? M v)
        (let [r (t2-uf-find M v) n (t2-g M t2-s-nslot)
              M1 (cond (> (t2-g M (+ t2-a-cls r)) 0) M
                       (>= n 16) (t2-fail M 8)
                       :else (-> M (t2-s t2-s-nslot (inc n)) (t2-s (+ t2-a-cls r) (inc n)) (t2-s (+ t2-a-pd (* 4 n)) 1)
                                 (t2-s (+ t2-a-pd (* 4 n) 3) 0) (t2-s (+ t2-a-cmn n) 0)))
              s (dec (t2-g M1 (+ t2-a-cls r)))
              c (if (>= s 0) (t2-g M1 (+ t2-a-cmn s)) 0)]
          (cond (or (not (t2-ok? M1)) (< s 0)) M1
                (>= c t2-maxcm) (t2-fail M1 37)
                (and (= (t2-op-of M1 v) t2-param) (not= (t2-g M1 (+ t2-a-pd (* 4 s) 3)) 0)) (t2-fail M1 35)
                :else (-> M1 (t2-s (+ t2-a-cls v) (inc s)) (t2-s (+ t2-a-cm (* t2-maxcm s) c) v) (t2-s (+ t2-a-cmn s) (inc c))
                          (t2-s (+ t2-a-cmx v) (+ (* t2-maxcm s) c 1))
                          (cond-> (= (t2-op-of M1 v) t2-param) (t2-s (+ t2-a-pd (* 4 s) 3) (inc (t2-vf M1 v t2-f-a)))))))
        M)
      (inc v) nv)))
;; every class has a root: its parameter, or (with calls) a call result
(defn- t2-cls-roots [M :vector-i64 s :i64] :vector-i64
  (if (or (>= s (t2-g M t2-s-nslot)) (not (t2-ok? M))) M
    (let [n (t2-g M (+ t2-a-cmn s))
          ok (or (> (t2-g M (+ t2-a-pd (* 4 s) 3)) 0)
                 (loop [i 0] (and (< i n) (or (= (t2-op-of M (t2-g M (+ t2-a-cm (* t2-maxcm s) i))) t2-call) (recur (inc i))))))]
      (t2-cls-roots (if ok M (t2-fail M 35)) (inc s)))))
;; ---- object identity: aliases share one descriptor ------------------------------------------------------------------------
;; obj(v) for a parameter, call or phi value: the value v always equals -- a parameter, a call that does not return its
;; first argument, or a phi whose operands are not all one object (itself then) -- 0 while unknown (optimistic, lowered
;; monotonically: unknown, an object, itself). A call to g that returns its parameter-0 argument (RET0[g], persistent; the
;; function itself assumed, then checked: every reachable return yields parameter 0's object) is its first argument's.
;; Two members of one object never conflict over the slot (same descriptor), and single-object classes are merged.
(def t2-s-ret0self 77)
(defn- t2-objkind? [M :vector-i64 v :i64] :bool
  (and (> v 0) (let [op (t2-op-of M v)] (or (= op t2-param) (= op t2-call) (and (= op t2-phi) (= (t2-vf M v t2-f-repl) 0))))))
(defn- t2-obj [M :vector-i64 v :i64] :i64 (let [o (if (> v 0) (t2-g M (+ t2-a-obj v)) 0)] (if (> o 0) o v)))
(defn- t2-ret0? [M :vector-i64 g :i64] :bool
  (or (and (= g (t2-g M t2-s-f)) (= (t2-g M t2-s-ret0self) 1))
      (and (> g 0) (< g MM-FN-CAP) (not= g (t2-g M t2-s-f)) (= (t2-g M (+ t2-a-ret0 g)) 1))))
;; meet of the current obj o of v with a computed object x (0 = no information)
(defn- t2-obj-meet [o :i64 x :i64 v :i64] :i64 (cond (= x 0) o (= o 0) x (= o x) o :else v))
(defn- t2-obj-new [M :vector-i64 v :i64] :i64
  (let [op (t2-op-of M v) o (t2-g M (+ t2-a-obj v))]
    (cond (= op t2-param) v
          (= op t2-call)
          (let [n (t2-vf M v t2-f-c) a (if (> n 0) (t2-res M (t2-g M (+ t2-a-phiop (t2-vf M v t2-f-b)))) 0)]
            (if (and (> n 0) (t2-ret0? M (t2-vf M v t2-f-a)) (t2-objkind? M a))
              (t2-obj-meet o (t2-g M (+ t2-a-obj a)) v) v))
          :else
          (loop [k 0 x o]
            (if (>= k (t2-vf M v t2-f-b)) x
              (let [y (t2-phiarg M v k)]
                (cond (= y v) (recur (inc k) x)
                      (not (t2-objkind? M y)) v
                      :else (let [x1 (t2-obj-meet x (t2-g M (+ t2-a-obj y)) v)] (if (= x1 v) v (recur (inc k) x1))))))))))
(defn- t2-obj-pass [M :vector-i64 v :i64 nv :i64 changed :i64] :vector-i64
  (if (> v nv) (t2-s M t2-s-last changed)
    (if (not (t2-objkind? M v)) (t2-obj-pass M (inc v) nv changed)
      (let [o (t2-g M (+ t2-a-obj v)) x (t2-obj-new M v)]
        (if (= x o) (t2-obj-pass M (inc v) nv changed) (t2-obj-pass (t2-s M (+ t2-a-obj v) x) (inc v) nv 1))))))
(defn- t2-obj-fix [M :vector-i64 nv :i64] :vector-i64
  (loop [m (t2-wzero M t2-a-obj 0 (inc nv)) i 0]
    (if (>= i 64) (loop [v 1 m m] (if (> v nv) m (recur (inc v) (t2-s m (+ t2-a-obj v) v))))   ; no fixpoint: no aliases
      (let [m1 (t2-obj-pass m 1 nv 0)] (if (= (t2-last m1) 1) (recur m1 (inc i)) m1)))))
;; every reachable return yields parameter 0's object
(defn- t2-rets-p0? [M :vector-i64 nv :i64] :bool
  (let [p0 (loop [v 1] (cond (> v nv) 0 (and (= (t2-op-of M v) t2-param) (= (t2-vf M v t2-f-a) 0)) v :else (recur (inc v))))]
    (and (> p0 0)
         (loop [v 1 any false]
           (cond (> v nv) any
                 (or (not= (t2-op-of M v) t2-ret) (t2-gone? M v) (= (t2-bget M t2-a-breach (t2-vf M v t2-f-blk)) 0)) (recur (inc v) any)
                 :else (let [x (t2-res M (t2-vf M v t2-f-a))]
                         (if (and (t2-objkind? M x) (= (t2-obj M x) p0)) (recur (inc v) true) false)))))))
(defn- t2-objs [M :vector-i64 nv :i64] :vector-i64
  (let [f (t2-g M t2-s-f)
        M1 (t2-obj-fix (t2-s M t2-s-ret0self 1) nv)
        ok (t2-rets-p0? M1 nv)
        M2 (if ok M1 (t2-obj-fix (t2-s M1 t2-s-ret0self 0) nv))]
    (cond-> M2 (and ok (> f 0) (< f MM-FN-CAP)) (t2-s (+ t2-a-ret0 f) 1))))
;; ---- merging single-object classes: a call returning its argument joins the argument's class ----
(defn- t2-cls-objonly? [M :vector-i64 r :i64 O :i64 nv :i64] :bool
  (let [R (t2-uf-find M r)]
    (loop [v 1] (or (> v nv) (and (or (not (t2-hmember? M v)) (not= (t2-uf-find M v) R) (= (t2-obj M v) O)) (recur (inc v)))))))
(defn- t2-cls-size [M :vector-i64 r :i64 nv :i64] :i64
  (let [R (t2-uf-find M r)] (loop [v 1 n 0] (if (> v nv) n (recur (inc v) (if (and (t2-hmember? M v) (= (t2-uf-find M v) R)) (inc n) n))))))
(defn- t2-cls-merge [M :vector-i64 v :i64 nv :i64 changed :i64] :vector-i64
  (if (or (> v nv) (not (t2-ok? M))) (t2-s M t2-s-last changed)
    (let [O (t2-obj M v)
          a (if (and (t2-hmember? M v) (= (t2-op-of M v) t2-call) (not= O v) (> (t2-vf M v t2-f-c) 0))
              (t2-res M (t2-g M (+ t2-a-phiop (t2-vf M v t2-f-b)))) 0)
          ok (and (> a 0) (t2-objkind? M a) (= (t2-obj M a) O)
                  (not (and (= (t2-op-of M a) t2-param) (>= (t2-vf M a t2-f-a) 7)))
                  (or (not (t2-hmember? M a)) (not= (t2-uf-find M a) (t2-uf-find M v)))
                  (t2-cls-objonly? M v O nv)
                  (or (not (t2-hmember? M a)) (t2-cls-objonly? M a O nv))
                  (<= (+ (t2-cls-size M v nv) (if (t2-hmember? M a) (t2-cls-size M a nv) 1)) 12))]
      (if ok (t2-cls-merge (t2-uf-union (t2-hadd M a) v a) (inc v) nv 1) (t2-cls-merge M (inc v) nv changed)))))
(defn- t2-cls-merges [M :vector-i64 nv :i64 iter :i64] :vector-i64
  (if (>= iter 16) M
    (let [M1 (t2-cls-merge M 1 nv 0)]
      (if (and (t2-ok? M1) (= (t2-last M1) 1)) (t2-cls-merges (t2-cls-close M1 nv 0) nv (inc iter)) M1))))
(defn- t2-handles [M :vector-i64 nv :i64] :vector-i64
  (-> M (t2-wzero t2-a-uf 0 (inc nv)) (t2-wzero t2-a-cls 0 (inc nv)) (t2-wzero t2-a-cmx 0 (inc nv)) (t2-wzero t2-a-cmn 0 16)
      (t2-s t2-s-nslot 0)
      (t2-check 1 nv) (t2-cls-close nv 0) (t2-cls-merges nv 0) (t2-cls-slots 1 nv) (t2-cls-roots 0)))
;; descriptor slot of the handle operand of access v
(defn- t2-pk [M :vector-i64 v :i64] :i64 (dec (t2-g M (+ t2-a-cls (t2-res M (t2-vf M v t2-f-a))))))
;; ---- class interference (with calls; after liveness) ----
;; does ordinary value w read h (handle operands included)?
(defn- t2-reads? [M :vector-i64 w :i64 h :i64] :bool
  (let [op (t2-op-of M w) a (t2-vf M w t2-f-a) b (t2-vf M w t2-f-b) c (t2-vf M w t2-f-c)]
    (cond (or (= op t2-bin) (= op t2-cmp)) (or (= (t2-res M b) h) (= (t2-res M c) h))
          (= op t2-un) (= (t2-res M b) h)
          (= op t2-vat) (or (= (t2-res M a) h) (= (t2-res M b) h))
          (= op t2-vset) (or (= (t2-res M a) h) (= (t2-res M b) h) (= (t2-res M c) h))
          (= op t2-tab) (= (t2-res M c) h)
          (= op t2-dtab) (= (t2-res M c) h)
          (t2-cpx? op) (or (= (t2-res M b) h) (= (t2-res M c) h))
          (= op t2-sel) (or (= (t2-res M a) h) (= (t2-res M b) h) (= (t2-res M c) h))
          (or (= op t2-ret) (= op t2-brz)) (= (t2-res M a) h)
          (= op t2-call) (loop [k 0] (and (< k c) (or (= (t2-res M (t2-g M (+ t2-a-phiop b k))) h) (recur (inc k)))))
          :else false)))
;; is h live right after call C: defined before C and read after it (later in C's block, or live out of it)?
(defn- t2-live-after? [M :vector-i64 C :i64 h :i64] :bool
  (let [b (t2-vf M C t2-f-blk) v1 (t2-bget M t2-a-bv1 b)]
    (and (not= h C)
         (not (and (= (t2-vf M h t2-f-blk) b) (not= (t2-op-of M h) t2-phi) (> h C)))
         (or (t2-bit? M (t2-out b) h)
             (loop [w (inc C)]
               (and (< w v1) (or (and (not= (t2-op-of M w) t2-phi) (not (t2-gone? M w)) (t2-reads? M w h)) (recur (inc w)))))))))
;; is member h live where member x is defined?
(defn- t2-live-at-def? [M :vector-i64 h :i64 x :i64] :bool
  (let [op (t2-op-of M x) H (t2-vf M x t2-f-blk)]
    (cond (= op t2-param) (= (t2-op-of M h) t2-param)
          (= op t2-call) (t2-live-after? M x h)
          (and (= (t2-op-of M h) t2-phi) (= (t2-vf M h t2-f-blk) H)) true
          :else (t2-bit? M (t2-in H) h))))
(defn- t2-cm [M :vector-i64 s :i64 i :i64] :i64 (t2-g M (+ t2-a-cm (* t2-maxcm s) i)))
(defn- t2-cls-interf [M :vector-i64 s :i64] :vector-i64
  (if (or (>= s (t2-g M t2-s-nslot)) (not (t2-ok? M))) M
    (let [n (t2-g M (+ t2-a-cmn s))
          bad (loop [i 0]
                (and (< i n)
                     (or (let [h1 (t2-cm M s i)]
                           (loop [j (inc i)]
                             (and (< j n)
                                  (or (let [h2 (t2-cm M s j)]
                                        (and (not= (t2-obj M h1) (t2-obj M h2))   ; one object: one descriptor
                                             (or (t2-live-at-def? M h1 h2) (t2-live-at-def? M h2 h1))))
                                      (recur (inc j))))))
                         (recur (inc i)))))]
      (t2-cls-interf (if bad (t2-fail M 36) M) (inc s)))))
;; ---- descriptor liveness (with calls) ----
;; A member is desc-live where its descriptor is read before the member is redefined and before the next real call: by an
;; access (vat/vset), by the handoff of a tail call (t2-handoff-x), or through a desc-live member phi it feeds on an edge
;; (the phi's slot is its operand's slot there). A call ends desc-liveness: after it, the slot of the member desc-live
;; there is (re)computed -- the call's own result from x0, any other member from its register (t2-e-redesc) -- and no
;; other slot is. Invariant: wherever h is desc-live, its slot holds desc(h). (Between the last call or definition before
;; such a point and the point, h is desc-live throughout, so that call wrote desc(h), or h's definition did: entry
;; descriptor, call result, or a phi whose incoming operand was desc-live at the edge; nothing else writes the slot
;; there, as another member's definition or refresh would make the two live together.) Register liveness (handle uses
;; included) contains desc liveness, so the member's register holds it at a refresh; interference is checked on register
;; liveness, the stronger relation.
(def t2-a-cmx (+ t2-a-cmn 16))          ; per value: member id (16 slot + index) + 1 (0 = none)
(def t2-a-dl (+ t2-a-cmx t2-maxv))      ; per block 8 words: desc-live in (after the phis) and out, over member ids
(defn- t2-dlin [b :i64] :i64 (+ t2-a-dl (* 8 b)))
(defn- t2-dlout [b :i64] :i64 (+ t2-a-dl (* 8 b) 4))
(defn- t2-mid [M :vector-i64 h :i64] :i64 (if (> h 0) (dec (t2-g M (+ t2-a-cmx h))) -1))
;; the member whose descriptor ordinary value w reads (0 none): an access's handle, a tail call's handed-off argument
;; (also a non-tail call's to a callee known to read it, t2-hent-known?)
(defn- t2-dreads [M :vector-i64 w :i64] :i64
  (let [op (t2-op-of M w)]
    (cond (or (= op t2-vat) (= op t2-vset)) (t2-res M (t2-vf M w t2-f-a))
          (and (= op t2-call) (t2-hoff-call? M w (t2-tailcall? M w (t2-bget M t2-a-bv1 (t2-vf M w t2-f-blk)))))
          (t2-handoff-x M w)
          :else 0)))
;; member h is an ordinary value (a call result) of block b
(defn- t2-odef? [M :vector-i64 h :i64 b :i64] :bool (and (= (t2-vf M h t2-f-blk) b) (not= (t2-op-of M h) t2-phi)))
;; out(b) |= what entering s from b needs: in(s) minus s's phis, plus the operand from b of each desc-live phi of s
(defn- t2-dl-succ [M :vector-i64 b :i64 s :i64] :vector-i64
  (if (< s 0) M
    (let [k (t2-predidx M s b 0)]
      (loop [j 0 m M]
        (if (>= j (* t2-maxcm (t2-g m t2-s-nslot))) m
          (let [h (t2-g m (+ t2-a-cm j)) id j]
            (recur (inc j)
                   (cond (or (>= (- j (* t2-maxcm (quot j t2-maxcm))) (t2-g m (+ t2-a-cmn (quot j t2-maxcm))))
                             (not (t2-bit? m (t2-dlin s) id))) m
                         (and (= (t2-op-of m h) t2-phi) (= (t2-vf m h t2-f-blk) s))
                         (let [x (t2-phiarg m h k) mx (t2-mid m x)] (if (>= mx 0) (t2-bitset m (t2-dlout b) mx) m))
                         :else (t2-bitset m (t2-dlout b) id)))))))))
;; in(b): backward from out(b); a call clears the set (then its handoff argument is read), an access adds its handle;
;; M[last] = 1 when in(b) changed
(defn- t2-dl-block [M :vector-i64 b :i64] :vector-i64
  (let [i (t2-dlin b) o (t2-dlout b) v0 (t2-bget M t2-a-bv0 b) v1 (t2-bget M t2-a-bv1 b)
        M0 (-> M (t2-cpw t2-a-tmp i 0) (t2-wzero o 0 4) (t2-dl-succ b (t2-bget M t2-a-bt b)) (t2-dl-succ b (t2-bget M t2-a-bf b)))
        M1 (loop [k 0 m M0] (if (>= k 4) m (recur (inc k) (t2-s m (+ i k) (t2-g m (+ o k))))))
        M3 (loop [w (dec v1) m M1]
             (if (< w v0) m
               (recur (dec w)
                      (if (or (= (t2-op-of m w) t2-phi) (t2-gone? m w)) m
                        (let [m1 (if (= (t2-op-of m w) t2-call) (t2-dl-call (t2-cpw4 m (+ t2-a-dla (* 4 w)) i) w i) m)
                              h (t2-dreads m1 w)]
                          (if (and (> h 0) (>= (t2-mid m1 h) 0)) (t2-bitset m1 i (t2-mid m1 h)) m1))))))]
    (t2-s M3 t2-s-last (if (loop [k 0] (or (>= k 4) (and (= (t2-g M3 (+ t2-a-tmp k)) (t2-g M3 (+ i k))) (recur (inc k))))) 0 1))))
(defn- t2-dl-pass [M :vector-i64 b :i64 changed :i64] :vector-i64
  (cond (< b 0) (t2-s M t2-s-last changed)
        (= (t2-bget M t2-a-breach b) 0) (t2-dl-pass M (dec b) changed)
        :else (let [M1 (t2-dl-block M b)] (t2-dl-pass M1 (dec b) (if (= (t2-last M1) 1) 1 changed)))))
(defn- t2-dl-iter [M :vector-i64 iter :i64] :vector-i64
  (if (>= iter 64) (t2-fail M 12)
    (let [M1 (t2-dl-pass M (dec (t2-g M t2-s-nb)) 0)] (if (= (t2-last M1) 1) (t2-dl-iter M1 (inc iter)) M1))))
(defn- t2-descliveness [M :vector-i64] :vector-i64
  (if (not (t2-ok? M)) M (t2-dl-iter (t2-wzero M t2-a-dl 0 (* 8 (t2-g M t2-s-nb))) 0)))
;; a call's effect, backward: one that may change descriptors (or a tail call) ends every desc-liveness; any other
;; leaves every descriptor as it was, so desc-liveness flows through it, except that its own result is defined there
;; (killed) -- and a result that is its argument's object in the argument's class needs the argument's descriptor
(defn- t2-cpw4 [M :vector-i64 dst :i64 src :i64] :vector-i64
  (loop [k 0 m M] (if (>= k 4) m (recur (inc k) (t2-s m (+ dst k) (t2-g m (+ src k)))))))
(defn- t2-alias-arg [M :vector-i64 w :i64] :i64
  (let [a (if (and (not= (t2-obj M w) w) (> (t2-vf M w t2-f-c) 0)) (t2-res M (t2-g M (+ t2-a-phiop (t2-vf M w t2-f-b)))) 0)]
    (if (and (> a 0) (> (t2-g M (+ t2-a-cls w)) 0) (= (t2-g M (+ t2-a-cls a)) (t2-g M (+ t2-a-cls w)))) a 0)))
(defn- t2-dl-call [M :vector-i64 w :i64 i :i64] :vector-i64
  (if (or (t2-mcd? M (t2-vf M w t2-f-a)) (t2-tailcall? M w (t2-bget M t2-a-bv1 (t2-vf M w t2-f-blk)))) (t2-wzero M i 0 4)
    (let [mw (t2-mid M w) live (and (>= mw 0) (t2-bit? M i mw)) M1 (if (>= mw 0) (t2-bitclr M i mw) M) a (t2-alias-arg M1 w)]
      (if (and live (> a 0) (>= (t2-mid M1 a) 0)) (t2-bitset M1 i (t2-mid M1 a)) M1))))
;; is member h (possibly C's own result) desc-live right after call C (recorded by the analysis)?
(defn- t2-dlive-after? [M :vector-i64 C :i64 h :i64] :bool
  (let [m (t2-mid M h)] (and (>= m 0) (t2-bit? M (+ t2-a-dla (* 4 C)) m))))
;; the member of slot s desc-live across call C (0 when none)
(defn- t2-live-member [M :vector-i64 s :i64 C :i64] :i64
  (let [n (t2-g M (+ t2-a-cmn s))]
    (loop [i 0] (if (>= i n) 0 (let [h (t2-cm M s i)] (if (and (not= h C) (t2-dlive-after? M C h)) h (recur (inc i))))))))
;; ---- multiply-add / shift-add fusion: a single-use product (MUL of two registers, MUL by 2^p, SHL by a constant) in its
;; user's block feeds ADD (either operand) or SUB (second operand) as madd/msub or a shifted-register add/sub. The product
;; (flag 32) has no register and takes its user's (flag 64) position.
(defn- t2-prod-kind [M :vector-i64 m :i64 v :i64] :i64
  (if (or (<= m 0) (not= (t2-op-of M m) t2-bin) (not= (t2-xf M m t2-x-uses) 1) (not= (t2-vf M m t2-f-blk) (t2-vf M v t2-f-blk))
          (not= (bit-and (t2-xf M m t2-x-flags) 127) 0) (t2-gone? M m))
    0
    (let [bop (t2-vf M m t2-f-a) a (t2-res M (t2-vf M m t2-f-b)) b (t2-res M (t2-vf M m t2-f-c))]
      (cond (and (= bop BOP-MUL) (not (t2-isconst? M a)) (not (t2-isconst? M b))) 1
            (and (= bop BOP-MUL) (not (t2-isconst? M a)) (t2-isconst? M b) (> (gn-pow2 (t2-kval M b)) 0)) 2
            (and (= bop BOP-MUL) (t2-isconst? M a) (not (t2-isconst? M b)) (> (gn-pow2 (t2-kval M a)) 0)) 2
            ;; A SUB of a product by a non-power-of-two constant can use MSub.
            (and (= bop BOP-MUL) (= (t2-vf M v t2-f-a) BOP-SUB) (not (t2-isconst? M a)) (t2-isconst? M b)
                 (> (t2-kval M b) 1) (= (gn-pow2 (t2-kval M b)) 0)) 3
            (and (= bop BOP-MUL) (= (t2-vf M v t2-f-a) BOP-SUB) (t2-isconst? M a) (not (t2-isconst? M b))
                 (> (t2-kval M a) 1) (= (gn-pow2 (t2-kval M a)) 0)) 3
            (and (= bop BOP-SHL) (not (t2-isconst? M a)) (t2-isconst? M b) (> (bit-and (t2-kval M b) 63) 0)) 2
            :else 0))))
(defn- t2-rem-reuse? [M :vector-i64 m :i64 v :i64] :bool
  (let [a (t2-res M (t2-vf M m t2-f-b)) b (t2-res M (t2-vf M m t2-f-c))
        kx (if (t2-isconst? M a) a b) q (if (t2-isconst? M a) b a) k (t2-kval M kx)
        qx (t2-res M (t2-vf M q t2-f-b)) qk (t2-res M (t2-vf M q t2-f-c))
        x (t2-res M (t2-vf M v t2-f-b))]
    (and (= (t2-vf M v t2-f-a) BOP-SUB) (> k 1) (= (gn-pow2 k) 0)
         (not (t2-isconst? M q)) (= (t2-op-of M q) t2-bin) (= (t2-vf M q t2-f-a) BOP-QUOT)
         (= (t2-xf M q t2-x-uses) 1) (= qx x) (t2-isconst? M qk) (= (t2-kval M qk) k)
         (= (t2-vf M q t2-f-blk) (t2-vf M v t2-f-blk)) (< q m) (< m v)
         ;; The quotient leaves its divisor in x17. Only no-code values may
         ;; intervene before MSub consumes it.
         (loop [i (inc q)]
           (or (>= i v)
               (and (or (= i m) (t2-gone? M i) (= (t2-op-of M i) t2-const) (= (t2-op-of M i) t2-phi))
                    (recur (inc i))))))))
(defn- t2-fusedop [M :vector-i64 v :i64] :i64
  (let [x (t2-res M (t2-vf M v t2-f-b)) y (t2-res M (t2-vf M v t2-f-c))]
    (if (and (> y 0) (= (bit-and (t2-xf M y t2-x-flags) 32) 32)) y x)))
(defn- t2-mfuse [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (> v nv) M
    (t2-mfuse
      (if (and (= (t2-op-of M v) t2-bin) (not (t2-gone? M v)) (> (t2-xf M v t2-x-uses) 0)
               (or (= (t2-vf M v t2-f-a) BOP-ADD) (= (t2-vf M v t2-f-a) BOP-SUB)))
        (let [x (t2-res M (t2-vf M v t2-f-b)) y (t2-res M (t2-vf M v t2-f-c))
              m (cond (and (> (t2-prod-kind M y v) 0) (not (t2-isconst? M x))) y
                      (and (= (t2-vf M v t2-f-a) BOP-ADD) (> (t2-prod-kind M x v) 0) (not (t2-isconst? M y))) x
                      :else 0)]
          (if (> m 0)
            (-> M (t2-xs m t2-x-flags (bit-or (t2-xf M m t2-x-flags) 32))
                  (t2-xs v t2-x-flags (bit-or (t2-xf M v t2-x-flags) (bit-or 64 (if (t2-rem-reuse? M m v) 1024 0)))))
            M))
        M)
      (inc v) nv)))
(defn- t2-pos-tfused [M :vector-i64 v :i64 v1 :i64 p :i64] :vector-i64
  (if (>= v v1) M
    (t2-pos-tfused (if (= (bit-and (t2-xf M v t2-x-flags) 4) 4) (t2-xs M v t2-x-pos p) M) (inc v) v1 p)))
;; linear positions: params/descriptors/tables at 0; per block: phis at P, ordinary values P+1..; a fused CMP takes its
;; terminator's position; a thread-fused CMP (emitted with the block's exit) has its own position, after every definition
;; of the block, so no definition can take an operand register it still reads
(defn- t2-pos-phis [M :vector-i64 v :i64 p :i64] :vector-i64
  (if (= v 0) M (t2-pos-phis (if (= (t2-vf M v t2-f-repl) 0) (t2-xs M v t2-x-pos p) M) (t2-vf M v t2-f-link) p)))
(defn- t2-pos-vals [M :vector-i64 v :i64 v1 :i64 p :i64] :vector-i64
  (cond (>= v v1) (t2-s M t2-s-npos p)
        (or (= (t2-op-of M v) t2-phi) (t2-gone? M v) (= (bit-and (t2-xf M v t2-x-flags) 33) 1)
            (= (bit-and (t2-xf M v t2-x-flags) 32) 32) (= (bit-and (t2-xf M v t2-x-flags) 128) 128)) (t2-pos-vals M (inc v) v1 p)
        :else (let [M1 (t2-xs M v t2-x-pos p)
                    M2 (cond (= (t2-op-of M v) t2-brz)
                             (let [c (t2-res M (t2-vf M v t2-f-a))]
                               (if (and (> c 0) (not= (bit-and (t2-xf M c t2-x-flags) 129) 0)) (t2-xs M1 c t2-x-pos p) M1))
                             (= (bit-and (t2-xf M v t2-x-flags) 64) 64) (t2-xs M1 (t2-fusedop M v) t2-x-pos p)
                             ;; a compare emitted by its selects takes the position of the last of them
                             (= (t2-op-of M v) t2-sel)
                             (let [c (t2-res M (t2-vf M v t2-f-a))]
                               (if (= (bit-and (t2-xf M c t2-x-flags) 128) 128) (t2-xs M1 c t2-x-pos p) M1))
                             :else M1)]
                (t2-pos-vals M2 (inc v) v1 (inc p)))))
(defn- t2-positions [M :vector-i64 b :i64 p :i64] :vector-i64
  (cond (>= b (t2-g M t2-s-nb)) (t2-s M t2-s-maxpos p)
        (= (t2-bget M t2-a-breach b) 0) (t2-positions M (inc b) p)
        :else (let [M1 (-> M (t2-bset t2-a-bpos0 b p) (t2-pos-phis (t2-bget M t2-a-bphi b) p))
                    M2 (t2-pos-vals M1 (t2-bget M1 t2-a-bv0 b) (t2-bget M1 t2-a-bv1 b) (inc p))
                    ;; a block without a terminator (it falls through) ends one position after its last value: a value
                    ;; live out of it (a phi operand on the edge) must not end where that value (a call) is defined, or
                    ;; it would not count as crossing the call (fix found by the handles agent, repro t2test/t24)
                    t (t2-lastval M2 b) top (if (> t 0) (t2-op-of M2 t) 0)
                    q (+ (t2-g M2 t2-s-npos) (if (or (= top t2-br) (= top t2-brz) (= top t2-ret) (= top t2-trap)) 0 1))]
                (if (>= q (- t2-maxpos 2)) (t2-fail M2 11)
                  (t2-positions (t2-bset M2 t2-a-bpos1 b (dec q)) (inc b) q)))))
;; ---- liveness (bitsets of 32 words over value ids) -----------------------------------------------------------------------
(defn- t2-bit? [M :vector-i64 base :i64 v :i64] :bool
  (not= (bit-and (t2-g M (+ base (u64-shift-right v 6))) (i64-shift-left 1 (bit-and v 63))) 0))
(defn- t2-bitset [M :vector-i64 base :i64 v :i64] :vector-i64
  (let [a (+ base (u64-shift-right v 6))] (t2-s M a (bit-or (t2-g M a) (i64-shift-left 1 (bit-and v 63))))))
(defn- t2-bitclr [M :vector-i64 base :i64 v :i64] :vector-i64
  (let [a (+ base (u64-shift-right v 6))] (t2-s M a (bit-and (t2-g M a) (bit-not (i64-shift-left 1 (bit-and v 63)))))))
(defn- t2-in [b :i64] :i64 (+ t2-a-live (* b 64)))
(defn- t2-out [b :i64] :i64 (+ t2-a-live (* b 64) 32))
(defn- t2-ue [b :i64] :i64 (+ t2-a-ue (* b 32)))
(defn- t2-regval? [M :vector-i64 x :i64] :bool (and (> x 0) (not (t2-noreg? M x))))
(defn- t2-ue-add [M :vector-i64 b :i64 x :i64] :vector-i64
  (let [r (t2-res M x)]
    (if (and (t2-regval? M r) (not= (t2-vf M r t2-f-blk) b)) (t2-bitset M (t2-ue b) r) M)))
;; operands of value v that are register uses (handle operands only in a function with a real call, see t2-uses)
(defn- t2-ue-args [M :vector-i64 b :i64 start :i64 k :i64 n :i64] :vector-i64
  (if (>= k n) M (t2-ue-args (t2-ue-add M b (t2-g M (+ t2-a-phiop start k))) b start (inc k) n)))
(defn- t2-ue-val [M :vector-i64 b :i64 v :i64] :vector-i64
  (let [op (t2-op-of M v) a (t2-vf M v t2-f-a) x (t2-vf M v t2-f-b) c (t2-vf M v t2-f-c)]
    (cond (= op t2-call) (t2-ue-args M b x 0 c)
          (or (= op t2-bin) (= op t2-cmp)) (-> M (t2-ue-add b x) (t2-ue-add b c))
          (= op t2-un) (t2-ue-add M b x)
          (or (= op t2-ret) (= op t2-brz)) (t2-ue-add M b a)
          (= op t2-vat) (-> M (t2-ue-add b x) (cond-> (= (t2-g M t2-s-hc) 1) (t2-ue-add b a)))
          (= op t2-vset) (-> M (t2-ue-add b x) (t2-ue-add b c) (cond-> (= (t2-g M t2-s-hc) 1) (t2-ue-add b a)))
          (= op t2-tab) (t2-ue-add M b c)
          (t2-cpx? op) (-> M (t2-ue-add b x) (t2-ue-add b c))
          (= op t2-sel) (-> M (t2-ue-add b a) (t2-ue-add b x) (t2-ue-add b c))
          (= op t2-dtab) (t2-ue-add M b c)
          :else M)))
(defn- t2-ue-vals [M :vector-i64 b :i64 v :i64 v1 :i64] :vector-i64
  (cond (>= v v1) M
        (or (= (t2-op-of M v) t2-phi) (t2-gone? M v)) (t2-ue-vals M b (inc v) v1)
        :else (t2-ue-vals (t2-ue-val M b v) b (inc v) v1)))
(defn- t2-wzero [M :vector-i64 base :i64 k :i64 n :i64] :vector-i64
  (if (>= k n) M (t2-wzero (t2-s M (+ base k) 0) base (inc k) n)))
(defn- t2-ue-all [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-ue-all (-> M (t2-wzero (t2-ue b) 0 32) (t2-wzero (t2-in b) 0 64)
                   (cond-> (= (t2-bget M t2-a-breach b) 1) (t2-ue-vals b (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b))))
               (inc b))))
;; index of pred b among the preds of s (-1 when absent)
(defn- t2-predidx [M :vector-i64 s :i64 b :i64 k :i64] :i64
  (cond (>= k (t2-bget M t2-a-bpn s)) -1
        (= (t2-pred M s k) b) k
        :else (t2-predidx M s b (inc k))))
;; operand of phi p for its pred index k (resolved)
(defn- t2-phiarg [M :vector-i64 p :i64 k :i64] :i64 (t2-res M (t2-g M (+ t2-a-phiop (t2-vf M p t2-f-a) k))))
(defn- t2-live-phis [M :vector-i64 b :i64 p :i64 k :i64] :vector-i64
  (if (= p 0) M
    (t2-live-phis (if (and (= (t2-vf M p t2-f-repl) 0) (> (t2-xf M p t2-x-uses) 0))
                    (let [x (t2-phiarg M p k)] (if (t2-regval? M x) (t2-bitset M (t2-out b) x) M)) M)
                  b (t2-vf M p t2-f-link) k)))
(defn- t2-orw [M :vector-i64 dst :i64 src :i64 k :i64] :vector-i64
  (if (>= k 32) M (t2-orw (t2-s M (+ dst k) (bit-or (t2-g M (+ dst k)) (t2-g M (+ src k)))) dst src (inc k))))
(defn- t2-out-succ [M :vector-i64 b :i64 s :i64] :vector-i64
  (if (< s 0) M
    (t2-live-phis (t2-orw M (t2-out b) (t2-in s) 0) b (t2-bget M t2-a-bphi s) (t2-predidx M s b 0))))
;; live-in of b: UE(b) | (out(b) minus the ordinary values of b), plus phis of OTHER blocks numbered inside b's range,
;; minus b's own phis. M[last] = 1 when it changed.
(defn- t2-newin-w [M :vector-i64 b :i64 k :i64] :vector-i64
  (if (>= k 32) M
    (let [lo (* k 64) v0 (t2-bget M t2-a-bv0 b) v1 (t2-bget M t2-a-bv1 b)
          a (gn-max lo v0) z (gn-min (+ lo 64) v1)
          m (if (>= a z) 0 (if (= (- z a) 64) -1 (i64-shift-left (dec (i64-shift-left 1 (- z a))) (- a lo))))
          w (bit-or (t2-g M (+ (t2-ue b) k)) (bit-and (t2-g M (+ (t2-out b) k)) (bit-not m)))]
      (t2-newin-w (t2-s M (+ (t2-in b) k) w) b (inc k)))))
(defn- t2-in-foreign [M :vector-i64 b :i64 v :i64 v1 :i64] :vector-i64
  (if (>= v v1) M
    (t2-in-foreign (if (and (= (t2-op-of M v) t2-phi) (not= (t2-vf M v t2-f-blk) b) (t2-bit? M (t2-out b) v))
                     (t2-bitset M (t2-in b) v) M)
                   b (inc v) v1)))
(defn- t2-in-nophi [M :vector-i64 b :i64 p :i64] :vector-i64
  (if (= p 0) M (t2-in-nophi (t2-bitclr M (t2-in b) p) b (t2-vf M p t2-f-link))))
(def t2-a-tmp (+ t2-a-re 32))   ; 32 words, inside the 64 reserved after t2-a-re
(defn- t2-cpw [M :vector-i64 dst :i64 src :i64 k :i64] :vector-i64
  (if (>= k 32) M (t2-cpw (t2-s M (+ dst k) (t2-g M (+ src k))) dst src (inc k))))
(defn- t2-eqw? [M :vector-i64 x :i64 y :i64 k :i64] :bool
  (or (>= k 32) (and (= (t2-g M (+ x k)) (t2-g M (+ y k))) (t2-eqw? M x y (inc k)))))
(defn- t2-live-pass [M :vector-i64 b :i64 changed :i64] :vector-i64
  (if (< b 0) (t2-s M t2-s-last changed)
    (if (= (t2-bget M t2-a-breach b) 0) (t2-live-pass M (dec b) changed)
      (let [M1 (-> M (t2-cpw t2-a-tmp (t2-in b) 0)
                   (t2-wzero (t2-out b) 0 32) (t2-out-succ b (t2-bget M t2-a-bt b)) (t2-out-succ b (t2-bget M t2-a-bf b))
                   (t2-newin-w b 0)
                   (t2-in-foreign b (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b)))
            M2 (t2-in-nophi M1 b (t2-bget M1 t2-a-bphi b))]
        (t2-live-pass M2 (dec b) (if (t2-eqw? M2 t2-a-tmp (t2-in b) 0) changed 1))))))
(defn- t2-liveness [M :vector-i64 iter :i64] :vector-i64
  (if (>= iter 64) (t2-fail M 12)
    (let [M1 (t2-live-pass M (dec (t2-g M t2-s-nb)) 0)]
      (if (= (t2-last M1) 1) (t2-liveness M1 (inc iter)) M1))))
;; ---- intervals ---------------------------------------------------------------------------------------------------------
(defn- t2-ext [M :vector-i64 x :i64 lo :i64 hi :i64] :vector-i64
  (if (t2-regval? M x)
    (-> M (t2-xs x t2-x-start (gn-min (t2-xf M x t2-x-start) lo)) (t2-xs x t2-x-end (gn-max (t2-xf M x t2-x-end) hi)))
    M))
(defn- t2-use-at [M :vector-i64 x :i64 u :i64] :vector-i64 (t2-ext M (t2-res M x) 999999 u))
(defn- t2-iv-val [M :vector-i64 v :i64] :vector-i64
  (let [op (t2-op-of M v) a (t2-vf M v t2-f-a) x (t2-vf M v t2-f-b) c (t2-vf M v t2-f-c) u (t2-xf M v t2-x-pos)
        M0 (if (and (>= u 0) (t2-regval? M v)) (t2-ext M v u u) M)]
    (cond (or (< u 0) (t2-gone? M v)) M0
          (= op t2-call) (loop [k 0 m M0] (if (>= k c) m (recur (inc k) (t2-use-at m (t2-g m (+ t2-a-phiop x k)) u))))
          (or (= op t2-bin) (= op t2-cmp)) (-> M0 (t2-use-at x u) (t2-use-at c u))
          (= op t2-un) (t2-use-at M0 x u)
          (or (= op t2-ret) (= op t2-brz)) (t2-use-at M0 a u)
          (= op t2-vat) (-> M0 (t2-use-at x u) (cond-> (= (t2-g M t2-s-hc) 1) (t2-use-at a u)))
          (= op t2-vset) (-> M0 (t2-use-at x u) (t2-use-at c u) (cond-> (= (t2-g M t2-s-hc) 1) (t2-use-at a u)))
          (= op t2-tab) (t2-use-at M0 c u)
          ;; the handle and the index stay live one position longer: the result register never takes theirs (the slow
          ;; path, after the byte load, still passes both to the host)
          (t2-cpx? op) (-> M0 (t2-use-at x (inc u)) (t2-use-at c (inc u)))
          (= op t2-sel) (-> M0 (t2-use-at a u) (t2-use-at x u) (t2-use-at c u))
          (= op t2-dtab) (t2-use-at M0 c u)
          :else M0)))
(defn- t2-iv-vals [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (> v nv) M (t2-iv-vals (t2-iv-val M v) (inc v) nv)))
(defn- t2-iv-bits [M :vector-i64 base :i64 k :i64 lo :i64 hi :i64] :vector-i64
  (if (>= k 2048) M
    (let [w (t2-g M (+ base (u64-shift-right k 6)))]
      (if (= w 0) (t2-iv-bits M base (+ k 64) lo hi)
        (t2-iv-bits (if (t2-bit? M base k) (t2-ext M k lo hi) M) base (inc k) lo hi)))))
(defn- t2-iv-blocks [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-iv-blocks (if (= (t2-bget M t2-a-breach b) 1)
                    (let [p0 (t2-bget M t2-a-bpos0 b) p1 (t2-bget M t2-a-bpos1 b)]
                      (-> M (t2-iv-bits (t2-in b) 0 p0 p0) (t2-iv-bits (t2-out b) 0 p1 p1)))
                    M)
                  (inc b))))
;; ---- jump threading through boolean join blocks ------------------------------------------------------------------------
;; A THREAD block J holds only phis and a terminating BRZ on one of them (p, its only use) and no other live phi. An edge
;; b -> J whose incoming value of p is known (a constant, or b's own branch condition on b's taken/fallthrough edge) goes
;; straight to J's corresponding successor S (with J's copies for S); an incoming CMP computed last in b (used only there)
;; branches on its flags (flag bit 2: fused-thread, no register, positioned at b's terminator).
;; The decision is taken once for every block (t2-thread-snap, before t2-tuse) and then fixed: t2-tuse drops uses of
;; values copied only on threaded edges, which could turn a join whose phi feeds a later thread block's phi into a thread
;; block too -- and threading into it would copy that never-materialized phi.
(defn- t2-thread? [M :vector-i64 J :i64] :bool
  (and (>= J 0) (= (t2-bget M t2-a-breach J) 1) (>= (t2-bget M t2-a-thr J) 1)))
;; a thread block every reachable incoming edge of which the emitter threads past (as t2-e-brz / t2-goto decide) is
;; never jumped to: it is not emitted (t2-a-thr = 2), so the block before it falls through to the next one
(defn- t2-dead-thread? [M :vector-i64 J :i64] :bool (and (>= J 0) (= (t2-bget M t2-a-thr J) 2)))
(defn- t2-goto-threads? [M :vector-i64 b :i64 J :i64] :bool
  (let [x (t2-phiarg M (t2-thread-p M J) (t2-predidx M J b 0))]
    (or (>= (t2-known M b J false) 0) (and (> x 0) (= (bit-and (t2-xf M x t2-x-flags) 4) 4)))))
(defn- t2-edge-threads? [M :vector-i64 b :i64 J :i64] :bool
  (let [t (t2-lastval M b) op (if (> t 0) (t2-op-of M t) 0) tk (t2-bget M t2-a-bt b) fl (t2-bget M t2-a-bf b)]
    (cond (or (= op t2-ret) (= op t2-trap)) true
          (and (= op t2-brz) (>= tk 0))
          (let [c (t2-res M (t2-vf M t t2-f-a)) nz (t2-vf M t t2-f-b)]
            (cond (t2-isconst? M c)
                  (let [S (if (if (= nz 1) (not= (t2-kval M c) 0) (= (t2-kval M c) 0)) tk fl)]
                    (or (not= S J) (t2-goto-threads? M b J)))
                  (= tk J) (and (not= fl J) (>= (t2-known M b J true) 0))
                  (= fl J) (t2-goto-threads? M b J)
                  :else true))
          (= op t2-br) (or (not= tk J) (t2-goto-threads? M b J))
          :else (or (not= fl J) (t2-goto-threads? M b J)))))
(defn- t2-dthread [M :vector-i64 J :i64] :vector-i64
  (if (>= J (t2-g M t2-s-nb)) M
    (t2-dthread (if (and (t2-thread? M J) (> J 0)
                         (loop [k 0] (or (>= k (t2-bget M t2-a-bpn J))
                                         (let [b (t2-pred M J k)]
                                           (and (or (= (t2-bget M t2-a-breach b) 0) (t2-edge-threads? M b J)) (recur (inc k)))))))
                  (t2-bset M t2-a-thr J 2) M)
                (inc J))))
(defn- t2-thread-snap [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M (t2-thread-snap (t2-bset M t2-a-thr b (if (t2-thread-raw? M b) 1 0)) (inc b))))
(defn- t2-thread-raw? [M :vector-i64 J :i64] :bool
  (and (>= J 0) (= (t2-bget M t2-a-breach J) 1)
       (let [t (t2-lastval M J)]
         (and (> t 0) (= (t2-op-of M t) t2-brz)
              (let [p (t2-res M (t2-vf M t t2-f-a))]
                (and (> p 0) (= (t2-op-of M p) t2-phi) (= (t2-vf M p t2-f-blk) J) (= (t2-xf M p t2-x-uses) 1)
                     ;; no other ordinary value in J before its terminator, no other live phi
                     (loop [v (t2-bget M t2-a-bv0 J)] (or (>= v t) (and (or (= (t2-op-of M v) t2-phi) (t2-gone? M v)) (recur (inc v)))))
                     (loop [q (t2-bget M t2-a-bphi J)] (or (= q 0) (and (or (= q p) (not= (t2-vf M q t2-f-repl) 0) (= (t2-xf M q t2-x-uses) 0))
                                                                         (recur (t2-vf M q t2-f-link)))))))))))
(defn- t2-thread-p [M :vector-i64 J :i64] :i64 (t2-res M (t2-vf M (t2-lastval M J) t2-f-a)))
;; known value of p on edge b -> J: 0 = zero, 1 = nonzero, -1 = unknown. taken: the edge is b's BRZ taken edge.
(defn- t2-known [M :vector-i64 b :i64 J :i64 taken :bool] :i64
  (let [x (t2-phiarg M (t2-thread-p M J) (t2-predidx M J b 0)) t (t2-lastval M b)]
    (cond (t2-isconst? M x) (if (= (t2-kval M x) 0) 0 1)
          (and (> t 0) (= (t2-op-of M t) t2-brz) (= (t2-res M (t2-vf M t t2-f-a)) x))
          (let [nz (t2-vf M t t2-f-b)] (if taken (if (= nz 0) 0 1) (if (= nz 0) 1 0)))
          :else -1)))
;; J's successor for a known value: BRZ(nz) jumps to J's taken block when (value==0) for nz 0 / (value!=0) for nz 1
(defn- t2-thread-dest [M :vector-i64 J :i64 known :i64] :i64
  (let [nz (t2-vf M (t2-lastval M J) t2-f-b)
        jump (if (= nz 0) (= known 0) (= known 1))
        tk (t2-bget M t2-a-bt J)]
    (if (and jump (>= tk 0)) tk (t2-bget M t2-a-bf J))))
;; mark incoming CMPs of thread blocks as fused-thread when b falls/BRs into J and the CMP is b's last value
(defn- t2-tfuse-b [M :vector-i64 b :i64] :vector-i64
  (let [t (t2-lastval M b) op (if (> t 0) (t2-op-of M t) 0)
        J (cond (= op t2-br) (t2-bget M t2-a-bt b)
                (or (= op t2-ret) (= op t2-brz) (= op t2-trap)) -1
                :else (t2-bget M t2-a-bf b))]
    (if (and (>= J 0) (t2-thread? M J))
      (let [x (t2-phiarg M (t2-thread-p M J) (t2-predidx M J b 0))
            ;; the CMP must be the last value of b before its BR (or the last value when b falls through)
            last (if (= op t2-br) (loop [v (dec t)] (cond (< v (t2-bget M t2-a-bv0 b)) 0 (or (= (t2-op-of M v) t2-phi) (t2-gone? M v)) (recur (dec v)) :else v)) t)]
        (if (and (> x 0) (= x last) (= (t2-op-of M x) t2-cmp) (= (t2-vf M x t2-f-blk) b) (= (t2-xf M x t2-x-uses) 1))
          (t2-xs M x t2-x-flags (bit-or (t2-xf M x t2-x-flags) 4)) M))
      M)))
(defn- t2-tfuse [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M (t2-tfuse (if (= (t2-bget M t2-a-breach b) 1) (t2-tfuse-b M b) M) (inc b))))
;; a phi operand on an edge the emitter threads with a known value is never copied: drop that use
(defn- t2-tuse-b [M :vector-i64 J :i64 k :i64 n :i64] :vector-i64
  (if (>= k n) M
    (let [b (t2-pred M J k)
          t (t2-lastval M b)
          tk (and (> t 0) (= (t2-op-of M t) t2-brz) (= (t2-bget M t2-a-bt b) J))
          known (t2-known M b J tk)
          x (t2-phiarg M (t2-thread-p M J) k)]
      (t2-tuse-b (if (and (>= known 0) (> x 0) (> (t2-xf M x t2-x-uses) 0))
                   (t2-xs M x t2-x-uses (dec (t2-xf M x t2-x-uses))) M)
                 J (inc k) n))))
(defn- t2-tuse [M :vector-i64 J :i64] :vector-i64
  (if (>= J (t2-g M t2-s-nb)) M
    (t2-tuse (if (t2-thread? M J) (t2-tuse-b M J 0 (t2-bget M t2-a-bpn J)) M) (inc J))))
;; ---- redundant bounds checks: an access whose (handle value, index value) check is dominated by an identical one ----
;; a handle's length never changes, so the dominated check cannot fail: flag bit 8 = unchecked. (Handle values, not slots:
;; members of one class share a slot.)
(defn- t2-chk-probe [M :vector-i64 v :i64 hv :i64 ix :i64 h :i64 n :i64] :vector-i64
  (let [w (t2-g M (+ t2-a-hash h))]
    (cond (>= n t2-hsize) M
          (= w 0) (t2-s M (+ t2-a-hash h) v)
          (and (= (t2-res M (t2-vf M w t2-f-a)) hv) (= (t2-res M (t2-vf M w t2-f-b)) ix) (t2-dom? M (t2-vf M w t2-f-blk) (t2-vf M v t2-f-blk)))
          (t2-xs M v t2-x-flags (bit-or (t2-xf M v t2-x-flags) 8))
          :else (t2-chk-probe M v hv ix (bit-and (inc h) (dec t2-hsize)) (inc n)))))
;; or the handle is at least k + 1 long: the least vector length of each value (t2-a-hmin), from the interprocedural facts
;; (part6) for parameters and call results, the least over the operands for phis (greatest fixpoint), else 0
(defn- t2-hm-cap [x :i64] :i64 (if (>= x t2-mlinf) 0 x))
(defn- t2-hm-base [M :vector-i64 v :i64] :i64
  (let [op (t2-op-of M v) a (t2-vf M v t2-f-a) f (t2-g M t2-s-f)]
    (cond (= op t2-phi) t2-mlinf
          (= op t2-param) (if (and (>= a 0) (< a 4) (> f 0) (< f MM-FN-CAP)) (t2-hm-cap (t2-g M (+ t2-a-pmin (* 4 f) a))) 0)
          (= op t2-call) (if (and (> a 0) (< a MM-FN-CAP)) (t2-hm-cap (t2-g M (+ t2-a-rmin a))) 0)
          :else 0)))
(defn- t2-hm-phi [M :vector-i64 v :i64 k :i64 n :i64 m :i64] :i64
  (if (>= k n) m
    (let [x (t2-phiarg M v k)] (t2-hm-phi M v (inc k) n (gn-min m (if (> x 0) (t2-g M (+ t2-a-hmin x)) 0))))))
(defn- t2-hm-pass [M :vector-i64 v :i64 n :i64 ch :i64] :vector-i64
  (if (> v n) (t2-s M t2-s-last ch)
    (if (and (= (t2-op-of M v) t2-phi) (not (t2-gone? M v)))
      (let [x (t2-hm-phi M v 0 (t2-bget M t2-a-bpn (t2-vf M v t2-f-blk)) (t2-g M (+ t2-a-hmin v)))]
        (if (< x (t2-g M (+ t2-a-hmin v))) (t2-hm-pass (t2-s M (+ t2-a-hmin v) x) (inc v) n 1) (t2-hm-pass M (inc v) n ch)))
      (t2-hm-pass M (inc v) n ch))))
(defn- t2-hmin-all [M :vector-i64] :vector-i64
  (let [n (t2-g M t2-s-nv)
        M0 (loop [v 1 m (t2-s M t2-a-hmin 0)] (if (> v n) m (recur (inc v) (t2-s m (+ t2-a-hmin v) (t2-hm-base m v)))))]
    (loop [m M0 i 0]
      (if (>= i 32) (t2-wzero m t2-a-hmin 0 (inc n))
        (let [m1 (t2-hm-pass m 1 n 0)] (if (= (t2-last m1) 1) (recur m1 (inc i)) m1))))))
(defn- t2-hm [M :vector-i64 hv :i64] :i64 (if (and (> hv 0) (< hv t2-maxv)) (t2-hm-cap (t2-g M (+ t2-a-hmin hv))) 0))
;; the value range of v (t2-rg): constants, parameters (their interprocedural range, part6), + - of ranges, bit-and with
;; a non-negative constant or range, phis (bounded depth: a cycle reads every value)
(defn- t2-vr [M :vector-i64 v :i64 d :i64] :i64
  (let [op (if (> v 0) (t2-op-of M v) 0) a (if (> v 0) (t2-vf M v t2-f-a) 0) f (t2-g M t2-s-f)]
    (cond (or (<= v 0) (> d 6)) t2-rg-unk
          (= op t2-const) (t2-rg-k a)
          (= op t2-param) (if (and (>= a 0) (< a 8) (> f 0) (< f MM-FN-CAP))
                            (let [w (t2-g M (+ t2-a-prng (* 8 f) a))] (if (t2-rg-empty? w) t2-rg-unk w)) t2-rg-unk)
          (and (= op t2-bin) (or (= a BOP-ADD) (= a BOP-SUB) (= a BOP-AND)))
          (let [x (t2-vr M (t2-res M (t2-vf M v t2-f-b)) (inc d)) y (t2-vr M (t2-res M (t2-vf M v t2-f-c)) (inc d))
                xl (t2-rg-lo x) xh (t2-rg-hi x) yl (t2-rg-lo y) yh (t2-rg-hi y)]
            (cond (= a BOP-ADD) (if (or (= x t2-rg-unk) (= y t2-rg-unk)) t2-rg-unk (t2-rg-mk (+ xl yl) (+ xh yh)))
                  (= a BOP-SUB) (if (or (= x t2-rg-unk) (= y t2-rg-unk)) t2-rg-unk (t2-rg-mk (- xl yh) (- xh yl)))
                  (and (>= xl 0) (>= yl 0)) (t2-rg 0 (gn-min xh yh))
                  (>= yl 0) (t2-rg 0 yh)
                  (>= xl 0) (t2-rg 0 xh)
                  :else t2-rg-unk))
          (and (= op t2-phi) (not (t2-gone? M v)))
          (loop [k 0 n (t2-bget M t2-a-bpn (t2-vf M v t2-f-blk)) r t2-mlinf]
            (if (or (>= k n) (= r t2-rg-unk)) (if (t2-rg-empty? r) t2-rg-unk r)
              (recur (inc k) n (t2-rg-union r (t2-vr M (t2-phiarg M v k) (inc d))))))
          :else t2-rg-unk)))
;; a variable index proven inside [0, least length of the handle)
(defn- t2-rg-in? [M :vector-i64 ix :i64 hv :i64] :bool
  (let [n (t2-hm M hv)]
    (and (> n 0) (let [r (t2-vr M ix 0)] (and (not= r t2-rg-unk) (>= (t2-rg-lo r) 0) (< (t2-rg-hi r) n))))))
(defn- t2-chk-vals [M :vector-i64 b :i64 v :i64 v1 :i64] :vector-i64
  (if (>= v v1) M
    (let [op (t2-op-of M v)]
      (t2-chk-vals (if (and (or (= op t2-vat) (= op t2-vset)) (= (t2-vf M v t2-f-blk) b))
                     (let [hv (t2-res M (t2-vf M v t2-f-a)) ix (t2-res M (t2-vf M v t2-f-b))
                           M1 (t2-chk-probe M v hv ix (t2-hash 7 hv ix 0) 0)]
                       (if (and (not= (bit-and (t2-xf M1 v t2-x-flags) 8) 8)
                                (if (t2-isconst? M1 ix)
                                  (and (>= (t2-kval M1 ix) 0) (or (< (t2-kval M1 ix) (t2-hm M1 hv)) (t2-chk-bigger? M1 v hv (t2-kval M1 ix) 1)))
                                  (t2-rg-in? M1 ix hv)))
                         (t2-xs M1 v t2-x-flags (bit-or (t2-xf M1 v t2-x-flags) 8)) M1))
                     M)
                   b (inc v) v1))))
;; an earlier access on the same handle value with a constant index >= k dominates v: its check implies v's
(defn- t2-chk-bigger? [M :vector-i64 v :i64 hv :i64 k :i64 w :i64] :bool
  (and (< w v)
       (or (let [op (t2-op-of M w) ix (if (or (= op t2-vat) (= op t2-vset)) (t2-res M (t2-vf M w t2-f-b)) 0)]
             (and (> ix 0) (not (t2-gone? M w)) (t2-isconst? M ix) (>= (t2-kval M ix) k) (= (t2-res M (t2-vf M w t2-f-a)) hv)
                  (t2-dom? M (t2-vf M w t2-f-blk) (t2-vf M v t2-f-blk))))
           (t2-chk-bigger? M v hv k (inc w)))))
(defn- t2-chk-blocks [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-chk-blocks (if (= (t2-bget M t2-a-breach b) 1) (t2-chk-vals M b (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b)) M) (inc b))))
(defn- t2-chk [M :vector-i64] :vector-i64 (-> M (t2-wzero t2-a-hash 0 t2-hsize) (t2-hmin-all) (t2-chk-blocks 0)))
;; ---- linear scan --------------------------------------------------------------------------------------------------------
;; preference order: x9..x15, x0..x6, x19..x28
(defn- t2-rk [k :i64] :i64 (cond (< k 7) (+ 9 k) (< k 14) (- k 7) :else (+ 5 k)))
(defn- t2-busy? [M :vector-i64 r :i64] :bool (not= (bit-and (t2-g M t2-s-busy) (i64-shift-left 1 r)) 0))
(defn- t2-take [M :vector-i64 r :i64 end :i64] :vector-i64
  (-> M (t2-s t2-s-busy (bit-or (t2-g M t2-s-busy) (i64-shift-left 1 r))) (t2-s (+ t2-a-re r) end)))
;; first free register in preference order from index k; skip x0..x6 when lowonly is false? (nolow: never x0..x6)
(defn- t2-free [M :vector-i64 k :i64 nolow :bool] :i64
  (cond (>= k 24) -1
        (and nolow (>= k 7) (< k 14)) (t2-free M (inc k) nolow)
        (t2-busy? M (t2-rk k)) (t2-free M (inc k) nolow)
        :else (t2-rk k)))
(defn- t2-expire [M :vector-i64 r :i64 pos :i64] :vector-i64
  (if (>= r 29) M
    (t2-expire (if (and (t2-busy? M r) (< (t2-g M (+ t2-a-re r)) pos))
                 (t2-s M t2-s-busy (bit-and (t2-g M t2-s-busy) (bit-not (i64-shift-left 1 r)))) M)
               (inc r) pos)))
(def t2-s-ncalls 36)
;; does v's interval contain a real call strictly inside (live across it)?
(defn- t2-crosses? [M :vector-i64 v :i64] :bool
  (let [s (t2-xf M v t2-x-start) e (t2-xf M v t2-x-end) n (t2-g M t2-s-ncalls)]
    (loop [k 0] (and (< k n) (let [p (t2-g M (+ t2-a-calls k))] (or (and (< s p) (> e p)) (recur (inc k))))))))
;; non-tail calls only: nothing lives across a tail call and it reuses the caller's return address, so a function
;; whose calls are all tail calls needs no frame
(defn- t2-collect-calls [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (> v nv) M
    (t2-collect-calls (if (and (= (t2-op-of M v) t2-call) (>= (t2-xf M v t2-x-pos) 0) (< (t2-g M t2-s-ncalls) 256)
                               (not (t2-tailcall? M v (t2-bget M t2-a-bv1 (t2-vf M v t2-f-blk)))))
                        (-> M (t2-s (+ t2-a-calls (t2-g M t2-s-ncalls)) (t2-xf M v t2-x-pos)) (t2-s t2-s-ncalls (inc (t2-g M t2-s-ncalls))))
                        M)
                      (inc v) nv)))
(defn- t2-alloc1 [M :vector-i64 v :i64] :vector-i64
  (let [cr (t2-crosses? M v) h (t2-hintreg M v cr)
        r (cond (>= h 0) h cr (t2-free M 14 false) :else (t2-free M 0 false))]
    (cond (>= r 0) (-> M (t2-take r (t2-xf M v t2-x-end)) (t2-vs v t2-f-reg r) (t2-s (+ t2-a-own r) v))
          (= (t2-g M t2-s-spill) 1) (t2-sp-alloc M v cr)
          :else (t2-fail M 13))))
;; spill mode, no register of v's class free: a value living across calls may take a free caller-saved register,
;; saved before and reloaded after each call it crosses (flag 1 in t2-a-spl, a slot from t2-sp-slots); else a victim
;; (while parameters are allocated, not an incoming parameter register x1..: a later parameter takes its own)
(defn- t2-cs-free [M :vector-i64 k :i64 lo :i64] :i64
  (if (>= k 13) -1 (let [r (if (< k 7) (+ 9 k) (- k 6))] (if (or (t2-busy? M r) (and (< r 9) (< r lo))) (t2-cs-free M (inc k) lo) r))))
(defn- t2-sp-alloc [M :vector-i64 v :i64 cr :bool] :vector-i64
  (let [c (if cr (t2-cs-free M 0 (if (= (t2-op-of M v) t2-param) (t2-g M t2-s-np) 0)) -1)]
    (if (>= c 0) (-> M (t2-take c (t2-xf M v t2-x-end)) (t2-vs v t2-f-reg c) (t2-s (+ t2-a-own c) v) (t2-s (+ t2-a-spl v) 1))
      (t2-sp-victim M v cr (gn-max 0 (t2-xf M v t2-x-start))))))
;; ---- spilling (spill mode): no register free for v at position pos -- v or the value holding a register of v's class
;; (callee-saved when v lives across a call) with the least uses per remaining position goes to memory for its whole
;; interval (its register, if any, passes to v)
(defn- t2-sp-weight [M :vector-i64 w :i64 pos :i64] :i64
  (quot (* 1024 (+ 1 (t2-xf M w t2-x-uses))) (+ 1 (gn-max 0 (- (t2-xf M w t2-x-end) pos)))))
(defn- t2-sp-victim [M :vector-i64 v :i64 cr :bool pos :i64] :vector-i64
  (let [best (loop [r 0 bw (t2-sp-weight M v pos) b -1]
               (if (> r 28) b
                 (let [w (t2-g M (+ t2-a-own r))
                       ok (and (or (not cr) (>= r 19) (and (>= r 1) (<= r 15))) (not= r 7) (not= r 8) (not= r 16) (not= r 17) (not= r 18)
                               (t2-busy? M r) (> w 0) (not= w v) (= (t2-vf M w t2-f-reg) r))
                       x (if ok (t2-sp-weight M w pos) 0)]
                   (if (and ok (< x bw)) (recur (inc r) x r) (recur (inc r) bw b)))))]
    (if (< best 0) (t2-vs M v t2-f-reg -2)
      (let [w (t2-g M (+ t2-a-own best))]
        (-> M (t2-vs w t2-f-reg -2) (t2-take best (t2-xf M v t2-x-end)) (t2-vs v t2-f-reg best) (t2-s (+ t2-a-own best) v)
            (t2-s (+ t2-a-spl v) (if (and cr (< best 19)) 1 0)))))))
;; spill locations: a stack parameter stays in the caller's outgoing area, every other spilled value (and every value
;; keeping a caller-saved register across calls) gets a frame slot
;; (pass 0: the values keeping a register across calls, adjacent slots so their saves pair; pass 1: the spilled values)
(defn- t2-sp-slots [M :vector-i64 v :i64 nv :i64 ps :i64] :vector-i64
  (let [r (if (<= v nv) (t2-vf M v t2-f-reg) 0)]
    (cond (or (> v nv) (not (t2-ok? M))) (if (and (= ps 0) (t2-ok? M)) (t2-sp-slots M 1 nv 1) M)
          (not (if (= ps 0) (and (>= r 0) (= (t2-g M (+ t2-a-spl v)) 1)) (= r -2))) (t2-sp-slots M (inc v) nv ps)
          (and (= ps 1) (= (t2-op-of M v) t2-param) (>= (t2-vf M v t2-f-a) 7))
          (t2-sp-slots (t2-s M (+ t2-a-spl v) (+ 32 4096 (t2-vf M v t2-f-a))) (inc v) nv ps)
          (>= (t2-g M t2-s-nspl) t2-maxspl) (t2-fail M 40)
          :else (t2-sp-slots (-> M (t2-s (+ t2-a-spl v) (+ 32 (t2-g M t2-s-nspl))) (t2-s t2-s-nspl (inc (t2-g M t2-s-nspl)))) (inc v) nv ps))))
(defn- t2-alloc-list [M :vector-i64 v :i64] :vector-i64
  (if (= v 0) M (t2-alloc-list (if (= (t2-vf M v t2-f-reg) -1) (t2-alloc1 M v) M) (t2-xf M v t2-x-next))))
(defn- t2-scan [M :vector-i64 pos :i64 maxpos :i64] :vector-i64
  (if (or (> pos maxpos) (not= (t2-g M t2-s-fail) 0)) M
    (let [l (t2-g M (+ t2-a-sl pos))]
      ;; a value defined at pos may take the register of an operand whose last use is at pos (every emitted
      ;; instruction sequence reads its operands before writing its result); phis (block starts) may not
      (t2-scan (t2-alloc-list (t2-expire M 0 (if (t2-sl-phi? M l) pos (inc pos))) l) (inc pos) maxpos))))
(defn- t2-sl-phi? [M :vector-i64 v :i64] :bool
  (and (not= v 0) (or (= (t2-op-of M v) t2-phi) (t2-sl-phi? M (t2-xf M v t2-x-next)))))
;; coalescing hints: a phi takes a free register of one of its operands; an operand takes its phi's free register
(def t2-a-hint (+ t2-a-aterm 6))   ; per value: the phi using it as an operand (0 none)
(defn- t2-okreg? [M :vector-i64 r :i64 cr :bool] :bool
  (and (>= r 0) (not= r 7) (not= r 8) (< r 16) (not (t2-busy? M r)) (or (not cr) (>= r 19)))
  )
(defn- t2-hintreg [M :vector-i64 v :i64 cr :bool] :i64
  (if (= (t2-op-of M v) t2-phi)
    (let [a (t2-vf M v t2-f-a) n (t2-vf M v t2-f-b)]
      (loop [k 0]
        (if (>= k n) -1
          (let [x (t2-res M (t2-g M (+ t2-a-phiop a k))) r (if (t2-regval? M x) (t2-vf M x t2-f-reg) -1)]
            (if (or (t2-okreg? M r cr) (and (>= r 19) (<= r 28) (not (t2-busy? M r)))) r (recur (inc k)))))))
    (let [p (t2-g M (+ t2-a-hint v)) r (if (> p 0) (t2-vf M p t2-f-reg) -1)]
      (if (or (t2-okreg? M r cr) (and (>= r 19) (<= r 28) (not (t2-busy? M r)))) r -1))))
(defn- t2-hints [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (> v nv) M
    (t2-hints (if (and (= (t2-op-of M v) t2-phi) (= (t2-vf M v t2-f-repl) 0) (> (t2-xf M v t2-x-uses) 0))
                (let [a (t2-vf M v t2-f-a) n (t2-vf M v t2-f-b)]
                  (loop [k 0 m M]
                    (if (>= k n) m
                      (let [x (t2-res m (t2-g m (+ t2-a-phiop a k)))]
                        (recur (inc k) (if (and (> x 0) (= (t2-g m (+ t2-a-hint x)) 0)) (t2-s m (+ t2-a-hint x) v) m))))))
                M)
              (inc v) nv)))
;; start lists over regval values with a position
(defn- t2-slists [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (> v nv) M
    (t2-slists (if (and (t2-regval? M v) (>= (t2-xf M v t2-x-pos) 0) (<= (t2-xf M v t2-x-start) (t2-xf M v t2-x-end)))
                 (let [s (gn-max 0 (t2-xf M v t2-x-start))]
                   (-> M (t2-xs v t2-x-next (t2-g M (+ t2-a-sl s))) (t2-s (+ t2-a-sl s) v)))
                 M)
               (inc v) nv)))
(defn- t2-maxcall [M :vector-i64 k :i64 m :i64] :i64
  (if (>= k (t2-g M t2-s-ncalls)) m (t2-maxcall M (inc k) (gn-max m (t2-g M (+ t2-a-calls k))))))
;; with non-tail calls, a string slot's handle is re-read after every call (string slot refresh): keep it live for the
;; whole function (a call inside a loop re-reads it on every iteration). Vector descriptor slots need no such extension:
;; their handle uses count as register uses (t2-uses), and only members desc-live across a call are refreshed.
(defn- t2-vparams-live [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (or (> v nv) (= (t2-g M t2-s-ncalls) 0)) M
    (t2-vparams-live (cond (and (= (t2-op-of M v) t2-param) (not= (t2-sd M (t2-vf M v t2-f-a) 0) 0))
                           (-> M (t2-xs v t2-x-uses (inc (t2-xf M v t2-x-uses))) (t2-xs v t2-x-start 0)
                               (t2-xs v t2-x-end (+ (t2-g M t2-s-maxpos) 5)))
                           :else M)
                     (inc v) nv)))
;; parameters first (x0..), then descriptor and table-base registers (never x0..x6, live everywhere)
(defn- t2-alloc-params [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (> v nv) M
    (t2-alloc-params (if (and (= (t2-op-of M v) t2-param) (t2-regval? M v))
                       (let [k (t2-vf M v t2-f-a)]
                         ;; a stack parameter (k >= 7) or one live across a call takes a free register
                         (if (or (>= k 7) (t2-crosses? M v))
                           (let [r (t2-free M (if (t2-crosses? M v) 14 0) false)]
                             (cond (>= r 0) (-> M (t2-take r (t2-xf M v t2-x-end)) (t2-vs v t2-f-reg r) (t2-s (+ t2-a-own r) v))
                                   (= (t2-g M t2-s-spill) 1) (t2-sp-alloc M v (t2-crosses? M v))
                                   :else (t2-fail M 13)))
                           (-> M (t2-take k (t2-xf M v t2-x-end)) (t2-vs v t2-f-reg k) (t2-s (+ t2-a-own k) v))))
                       M)
                     (inc v) nv)))
(defn- t2-alloc-fixed [M :vector-i64 base :i64 forever :i64] :vector-i64
  (let [r (t2-free M (if (> (t2-g M t2-s-ncalls) 0) 14 0) true)] (if (< r 0) (t2-fail M 14) (-> M (t2-take r forever) (t2-s base r)))))
;; a function that may receive a handed-over descriptor for parameter 0 (at most 3 parameters, no non-tail call) keeps
;; that slot in x4 (base) / x3 (length), the registers of the handoff: neither side moves it
(defn- t2-hoff-slot? [M :vector-i64 k :i64] :bool
  ;; no real call clobbers x3/x4: a chain link (tail calls only), or a leaf holding few table bases (depthconv's
  ;; nine-table loop lost 5% when two registers went to the handoff)
  (and (= (t2-g M (+ t2-a-pd (* 4 k) 3)) 1) (<= (t2-g M t2-s-np) 3) (= (t2-g M t2-s-ncalls) 0)
       (or (= (t2-g M t2-s-hascall) 1) (<= (t2-g M t2-s-ntab) 1))
       (not (t2-busy? M 3)) (not (t2-busy? M 4))))
(defn- t2-alloc-descs [M :vector-i64 k :i64 forever :i64] :vector-i64
  (if (>= k 16) M
    (t2-alloc-descs (cond (not= (t2-g M (+ t2-a-pd (* 4 k))) 1) M
                          (t2-hoff-slot? M k)
                          (-> M (t2-take 4 forever) (t2-s (+ t2-a-pd (* 4 k) 1) 4) (t2-take 3 forever) (t2-s (+ t2-a-pd (* 4 k) 2) 3))
                          :else (-> M (t2-alloc-fixed (+ t2-a-pd (* 4 k) 1) forever) (t2-alloc-fixed (+ t2-a-pd (* 4 k) 2) forever)))
                    (inc k) forever)))
;; string slot registers (unused fields -1), then every string-length value IS its slot's SLEN register
(defn- t2-alloc-sfld [M :vector-i64 k :i64 fld :i64 need :bool forever :i64] :vector-i64
  (if need (t2-alloc-fixed M (+ t2-a-sd (* k t2-sdw) fld) forever) (t2-sds M k fld -1)))
(defn- t2-alloc-sdescs [M :vector-i64 k :i64 forever :i64] :vector-i64
  (if (>= k 8) M
    (let [n (t2-sd M k 0)]
      (t2-alloc-sdescs (if (= n 0) M
                         (-> M (t2-alloc-sfld k 1 (= (bit-and n 1) 1) forever) (t2-alloc-sfld k 2 (= (bit-and n 2) 2) forever)
                             (t2-alloc-sfld k 3 (= (bit-and n 4) 4) forever) (t2-alloc-sfld k 4 (= (bit-and n 4) 4) forever)))
                       (inc k) forever))))
(defn- t2-slen-regs [M :vector-i64 v :i64 nv :i64] :vector-i64
  (if (> v nv) M
    (t2-slen-regs (if (and (= (t2-op-of M v) t2-slen) (>= (t2-hparam M v) 0)) (t2-vs M v t2-f-reg (t2-sd M (t2-hparam M v) 2)) M)
                  (inc v) nv)))
(defn- t2-alloc-tabs [M :vector-i64 k :i64 forever :i64] :vector-i64
  (if (>= k (t2-g M t2-s-ntab)) M (t2-alloc-tabs (t2-alloc-fixed M (+ t2-a-tb (* 2 k) 1) forever) (inc k) forever)))
(defn- t2-regalloc [M :vector-i64] :vector-i64
  (let [maxpos (t2-g M t2-s-maxpos) forever (+ maxpos 10) nv (t2-g M t2-s-nv)
        M0 (-> M (t2-s t2-s-busy 0) (t2-wzero t2-a-re 0 32) (t2-wzero t2-a-sl 0 (+ maxpos 1)) (t2-wzero t2-a-own 0 32)
               (t2-wzero t2-a-spl 0 (inc nv)) (t2-s t2-s-nspl 0) (t2-s t2-s-ncalls 0) (t2-collect-calls 1 nv) (t2-vparams-live 1 nv))
        ;; spill mode: the fixed registers (descriptor, table and string slots) first, then parameters may spill
        M1 (if (= (t2-g M t2-s-spill) 1)
             (-> M0 (t2-alloc-descs 0 forever) (t2-alloc-tabs 0 forever) (t2-alloc-sdescs 0 forever) (t2-slen-regs 1 nv)
                 (t2-alloc-params 1 nv))
             (-> M0 (t2-alloc-params 1 nv) (t2-alloc-descs 0 forever) (t2-alloc-tabs 0 forever) (t2-alloc-sdescs 0 forever)
                 (t2-slen-regs 1 nv)))]
    (-> M1 (t2-wzero t2-a-hint 0 (inc nv)) (t2-hints 1 nv)
        (t2-slists 1 nv) (t2-scan 1 maxpos) (t2-coalesce 0) (t2-sp-slots 1 nv 0))))
;; ---- latch copy coalescing (after allocation): a block b whose only successor is s (no conditional edge) and phi p of s
;; whose operand from b is a value v defined in b, used only there and after b's last call: when p's register d is held or
;; read by no other value from v's position to b's end (intervals; p's own may end at v), v takes d and the edge's move
;; disappears (single-interval linear scan keeps a header phi busy across its whole loop)
;; (the phi p itself by liveness: not live out of b, not read in b after v, no other phi's operand on the edge)
(defn- t2-cl-dfree? [M :vector-i64 d :i64 v :i64 b :i64 p :i64 s :i64 k :i64] :bool
  (let [pv (t2-xf M v t2-x-pos) pe (t2-bget M t2-a-bpos1 b) nv (t2-g M t2-s-nv)]
    (and (loop [u 1]
           (or (> u nv)
               (and (or (= u v) (= u p) (not= (t2-vf M u t2-f-reg) d) (not (t2-regval? M u)) (t2-gone? M u)
                        (> (t2-xf M u t2-x-start) pe) (<= (t2-xf M u t2-x-end) pv))
                    (recur (inc u)))))
         (not (t2-bit? M (t2-out b) p))
         ;; every other reader of p in b reads it before v's position and is not fused into a later user (a fused
         ;; product, a compare fused into a branch: they read at their user's position)
         (loop [w (t2-bget M t2-a-bv0 b)]
           (or (>= w (t2-bget M t2-a-bv1 b))
               (and (or (= w v) (= (t2-op-of M w) t2-phi) (t2-gone? M w) (not (t2-reads? M w p))
                        (and (= (bit-and (t2-xf M w t2-x-flags) 165) 0) (< (t2-xf M w t2-x-pos) pv)))
                    (recur (inc w)))))
         (loop [q (t2-bget M t2-a-bphi s)] (or (= q 0) (and (or (= q p) (not= (t2-phiarg M q k) p)) (recur (t2-vf M q t2-f-link))))))))
(defn- t2-cl-ok? [M :vector-i64 v :i64 b :i64] :bool
  (let [op (t2-op-of M v)]
    (and (> v 0) (= (t2-vf M v t2-f-blk) b) (not (t2-gone? M v)) (t2-regval? M v) (= (t2-xf M v t2-x-uses) 1)
         (>= (t2-vf M v t2-f-reg) 0)
         (or (= op t2-bin) (= op t2-un) (= op t2-cmp) (= op t2-vat) (= op t2-sel) (= op t2-dtab) (= op t2-tab))
         (= (bit-and (t2-xf M v t2-x-flags) 165) 0)
         ;; no call in b from v on
         (loop [w v] (or (>= w (t2-bget M t2-a-bv1 b)) (and (or (not= (t2-op-of M w) t2-call) (t2-gone? M w)) (recur (inc w))))))))
(defn- t2-cl-block [M :vector-i64 b :i64] :vector-i64
  (let [t (t2-lastval M b) op (if (> t 0) (t2-op-of M t) 0)
        s (cond (= op t2-br) (t2-bget M t2-a-bt b)
                (or (= op t2-brz) (= op t2-ret) (= op t2-trap)) -1
                :else (t2-bget M t2-a-bf b))
        k (if (>= s 0) (t2-predidx M s b 0) -1)]
    (if (< k 0) M
      (loop [p (t2-bget M t2-a-bphi s) m M]
        (if (= p 0) m
          (recur (t2-vf m p t2-f-link)
                 (let [v (t2-phiarg m p k) d (t2-vf m p t2-f-reg)]
                   (if (and (= (t2-vf m p t2-f-repl) 0) (> (t2-xf m p t2-x-uses) 0) (>= d 0) (< d 29)
                            (t2-cl-ok? m v b) (not= (t2-vf m v t2-f-reg) d) (t2-cl-dfree? m d v b p s k))
                     (t2-vs m v t2-f-reg d) m))))))))
(defn- t2-coalesce [M :vector-i64 b :i64] :vector-i64
  (cond (or (>= b (t2-g M t2-s-nb)) (not (t2-ok? M))) M
        (= (t2-bget M t2-a-breach b) 0) (t2-coalesce M (inc b))
        :else (t2-coalesce (t2-cl-block M b) (inc b))))
;; highest callee-saved register in use (18 = none)
(defn- t2-maxcs [M :vector-i64 v :i64 nv :i64 m :i64] :i64
  (if (> v nv) m (t2-maxcs M (inc v) nv (let [r (t2-vf M v t2-f-reg)] (if (and (>= r 19) (> r m)) r m)))))
(defn- t2-maxcs-fixed [M :vector-i64 m :i64] :i64
  (let [a (loop [k 0 x m] (if (>= k 16) x (recur (inc k) (if (= (t2-g M (+ t2-a-pd (* 4 k))) 1)
                                                         (gn-max x (gn-max (t2-g M (+ t2-a-pd (* 4 k) 1)) (t2-g M (+ t2-a-pd (* 4 k) 2)))) x))))]
    (loop [k 0 x (t2-maxcs-sd M a 0)] (if (>= k (t2-g M t2-s-ntab)) x (recur (inc k) (gn-max x (t2-g M (+ t2-a-tb (* 2 k) 1))))))))
(defn- t2-maxcs-sd [M :vector-i64 m :i64 k :i64] :i64
  (if (>= k 8) m
    (t2-maxcs-sd M (if (= (t2-sd M k 0) 0) m
                     (gn-max m (gn-max (gn-max (t2-sd M k 1) (t2-sd M k 2)) (gn-max (t2-sd M k 3) (t2-sd M k 4)))))
                 (inc k))))
;; ---- fuel plan: deferred publication and batched block charges ----------------------------------------------------------
;; Published (nonleaf) mode: memory must hold the original program's published fuel P only where it is observed -- a trap,
;; a real call, the return. P = x8 + u, u = charges since the original's last publication (a FUEL a=1 or a PUB), u > 0 only
;; inside an inlined gen-leaf callee. When u is a constant at every point (forward dataflow), defer = 1: charges only
;; `subs`, a real call stores x8 first, and every trap goes through a stub `add x8,x8,#c ; str x8,[x7,#8] ; udf|brk #0`.
;; Batched block (k >= 2 charges, no real call; leaf mode or defer): `subs x8,x8,#k ; b.lo cold` at its start replaces its k
;; checks (none can exhaust then); a trap with j of the block's charges still pending uses c = u + j. Its cold copy (fuel
;; below k) restores x8 and runs the block with per-charge checks, so exhaustion, stores before it and traps stay exact.
(def t2-s-defer 39)
(def t2-s-ntst 40)
(def t2-s-curu 41)
(def t2-s-pend 42)
(def t2-s-cold 43)
(def t2-s-pub 44)
(def t2-a-uin (+ t2-a-dstub 192))
(def t2-a-uout (+ t2-a-uin t2-maxb))
(def t2-a-fast (+ t2-a-uout t2-maxb))
(def t2-a-tstub (+ t2-a-fast t2-maxb))   ; 32 x (kind * 65536 + c, label)
(def t2-a-lref (+ t2-a-tstub 64))        ; per local label: branch references (4096)
;; labels after the block labels: 3 fixed stubs, edge stubs (6 per block), cold copies, fast copies, loop prechecks (8),
;; trap stubs (32), descriptor stubs (2 each)
(defn- t2-l-estub [M :vector-i64 n :i64] :i64 (+ (t2-lab M (t2-g M t2-s-nb)) 3 n))
(defn- t2-l-cold [M :vector-i64 b :i64] :i64 (+ (t2-lab M (* 7 (t2-g M t2-s-nb))) 3 b))
(defn- t2-l-trap [M :vector-i64 n :i64] :i64 (+ (t2-lab M (* 9 (t2-g M t2-s-nb))) 11 n))
(defn- t2-l-dstub [M :vector-i64 n :i64] :i64 (+ (t2-lab M (* 9 (t2-g M t2-s-nb))) 43 (* 2 n)))
(defn- t2-wfill [M :vector-i64 base :i64 k :i64 n :i64 x :i64] :vector-i64
  (if (>= k n) M (t2-wfill (t2-s M (+ base k) x) base (inc k) n x)))
;; u after value v
(defn- t2-u1 [M :vector-i64 v :i64 u :i64] :i64
  (let [op (t2-op-of M v)]
    (cond (= op t2-fuel) (if (= (t2-vf M v t2-f-a) 1) 0 (if (< u 0) u (inc u)))
          (or (= op t2-pub) (= op t2-call)) 0
          :else u)))
(defn- t2-u-scan [M :vector-i64 v :i64 v1 :i64 u :i64] :i64
  (if (>= v v1) u (t2-u-scan M (inc v) v1 (t2-u1 M v u))))
;; join over reachable preds' u_out: -2 none yet, -1 conflicting
(defn- t2-u-meet [M :vector-i64 b :i64 k :i64 n :i64 acc :i64] :i64
  (if (>= k n) acc
    (let [x (t2-bget M t2-a-uout (t2-pred M b k))]
      (t2-u-meet M b (inc k) n (cond (= x -2) acc (= acc -2) x (= acc x) acc :else -1)))))
(defn- t2-u-pass [M :vector-i64 b :i64 changed :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) (t2-s M t2-s-last changed)
    (if (= (t2-bget M t2-a-breach b) 0) (t2-u-pass M (inc b) changed)
      (let [uin (if (= b 0) 0 (t2-u-meet M b 0 (t2-bget M t2-a-bpn b) -2))
            uout (if (< uin 0) uin (t2-u-scan M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b) uin))
            ch (or (not= uin (t2-bget M t2-a-uin b)) (not= uout (t2-bget M t2-a-uout b)))]
        (t2-u-pass (-> M (t2-bset t2-a-uin b uin) (t2-bset t2-a-uout b uout)) (inc b) (if ch 1 changed))))))
;; every real call and the return see u = 0
(defn- t2-u-calls-ok? [M :vector-i64 v :i64 v1 :i64 u :i64] :bool
  (cond (>= v v1) true
        (and (or (= (t2-op-of M v) t2-call) (= (t2-op-of M v) t2-ret)) (not (t2-gone? M v)) (not= u 0)) false
        :else (t2-u-calls-ok? M (inc v) v1 (t2-u1 M v u))))
(defn- t2-u-ok? [M :vector-i64 b :i64] :bool
  (or (>= b (t2-g M t2-s-nb))
      (and (or (= (t2-bget M t2-a-breach b) 0)
               (and (>= (t2-bget M t2-a-uin b) 0)
                    (t2-u-calls-ok? M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b) (t2-bget M t2-a-uin b))))
           (t2-u-ok? M (inc b)))))
(defn- t2-u-iter [M :vector-i64 iter :i64] :vector-i64
  (if (>= iter 64) M
    (let [M1 (t2-u-pass M 0 0)]
      (cond (= (t2-last M1) 1) (t2-u-iter M1 (inc iter))
            (t2-u-ok? M1 0) (t2-s M1 t2-s-defer 1)
            :else M1))))
;; charges of block b's values [v, v1), -1 when it makes a real call
(defn- t2-kcount [M :vector-i64 v :i64 v1 :i64 k :i64] :i64
  (cond (>= v v1) k
        (= (t2-op-of M v) t2-call) -1
        (= (t2-op-of M v) t2-fuel) (t2-kcount M (inc v) v1 (inc k))
        :else (t2-kcount M (inc v) v1 k)))
;; charges of a block to batch: -1 when one follows a real call (a call after every charge sees them all made, and
;; blocks end after their calls)
(defn- t2-kbatch [M :vector-i64 v :i64 v1 :i64 k :i64 c :i64] :i64
  (cond (>= v v1) k
        (= (t2-op-of M v) t2-call) (t2-kbatch M (inc v) v1 k 1)
        (= (t2-op-of M v) t2-fuel) (if (= c 1) -1 (t2-kbatch M (inc v) v1 (inc k) c))
        :else (t2-kbatch M (inc v) v1 k c)))
(defn- t2-fast-plan [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (let [k (if (and (= (t2-bget M t2-a-breach b) 1) (or (= (t2-g M t2-s-pub) 0) (= (t2-g M t2-s-defer) 1)))
              (t2-kbatch M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b) 0 0) 0)]
      (t2-fast-plan (t2-bset M t2-a-fast b (if (and (>= k 2) (< k 2048)) k 0)) (inc b)))))
;; reachability with constant branch conditions folded: blocks only reached through a folded edge are not emitted
(defn- t2-fsucc-mark [M :vector-i64 b :i64] :vector-i64
  (let [t (t2-lastval M b) taken (t2-bget M t2-a-bt b) fall (t2-bget M t2-a-bf b)
        c (if (and (> t 0) (= (t2-op-of M t) t2-brz)) (t2-res M (t2-vf M t t2-f-a)) 0)
        known (and (> c 0) (t2-isconst? M c) (>= taken 0))
        jump (and known (if (= (t2-vf M t t2-f-b) 1) (not= (t2-kval M c) 0) (= (t2-kval M c) 0)))]
    (cond known (let [s (if jump taken fall)] (if (>= s 0) (t2-bset M t2-a-kd s 1) M))
          :else (-> M (cond-> (>= taken 0) (t2-bset t2-a-kd taken 1)) (cond-> (>= fall 0) (t2-bset t2-a-kd fall 1))))))
(defn- t2-freach-pass [M :vector-i64 b :i64 changed :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) (t2-s M t2-s-last changed)
    (if (and (= (t2-bget M t2-a-kd b) 1) (= (t2-bget M t2-a-breach b) 1) (= (t2-bget M (+ t2-a-kd t2-maxb) b) 0))
      (t2-freach-pass (-> M (t2-bset (+ t2-a-kd t2-maxb) b 1) (t2-fsucc-mark b)) (inc b) 1)
      (t2-freach-pass M (inc b) changed))))
(defn- t2-freach [M :vector-i64] :vector-i64
  (let [M1 (loop [m (-> M (t2-wzero t2-a-kd 0 (* 2 t2-maxb)) (t2-bset t2-a-kd 0 1)) i 0]
             (if (>= i 300) m (let [m1 (t2-freach-pass m 0 0)] (if (= (t2-last m1) 1) (recur m1 (inc i)) m1))))]
    (loop [b 0 m M1] (if (>= b (t2-g m t2-s-nb)) m
                       (recur (inc b) (if (and (= (t2-bget m t2-a-breach b) 1) (= (t2-bget m (+ t2-a-kd t2-maxb) b) 0))
                                        (t2-bset m t2-a-breach b 0) m))))))
(defn- t2-fuelplan [M :vector-i64] :vector-i64
  (let [nb (t2-g M t2-s-nb)
        M0 (-> M (t2-s t2-s-defer 0) (t2-s t2-s-ntst 0) (t2-s t2-s-cold 0) (t2-s t2-s-pend 0) (t2-s t2-s-curu 0)
               (t2-wfill t2-a-uin 0 nb -2) (t2-wfill t2-a-uout 0 nb -2))
        M1 (if (and (= (t2-g M t2-s-pub) 1) (= (t2-g M t2-s-fuel) 1)) (t2-u-iter M0 0) M0)]
    (t2-fast-plan M1 0)))
(def t2-rgn-on 1)
;; ---- fuel regions: a single-entry acyclic set of blocks (a head, then blocks whose predecessors are all members; no
;; member's real call followed by a charge; no loop, versioned or check-hoisting block) checks once at the head that the
;; counter covers the most charges along any path in it (cmp x8, #K ; b.lo cold) and then charges with plain subs (no
;; exhaustion check). Its cold copy (every member, ordinary checks, jumps between members staying in the copy) runs when
;; the counter is short, so exhaustion, traps and the counter stay exact. Blocks after a real call start a new region.
(defn- t2-rg-member? [M :vector-i64 b :i64] :bool
  (and (= (t2-bget M t2-a-breach b) 1) (not (t2-bch-any? M b)) (not (t2-vhead? M b)) (= (t2-bget M t2-a-bloop b) 0)
       (>= (t2-kbatch M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b) 0 0) 0)))
(defn- t2-rg-hascall? [M :vector-i64 b :i64] :bool
  (loop [v (t2-bget M t2-a-bv0 b)]
    (cond (>= v (t2-bget M t2-a-bv1 b)) false
          (and (= (t2-op-of M v) t2-call) (not (t2-gone? M v))) true
          :else (recur (inc v)))))
(defn- t2-rg-checks [M :vector-i64 b :i64] :i64   ; exhaustion checks the ordinary copy of b would make
  (let [k (t2-kbatch M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b) 0 0)]
    (cond (<= k 0) 0 (> (t2-bget M t2-a-fast b) 0) 1 :else k)))
;; region of block s: joins its predecessors' region when all are members of one region, come earlier and make no call
(defn- t2-rg-join [M :vector-i64 s :i64] :i64
  (loop [k 0 r -1]
    (if (>= k (t2-bget M t2-a-bpn s)) (if (> r 0) r 0)
      (let [p (t2-pred M s k)]
        (cond (= (t2-bget M t2-a-breach p) 0) (recur (inc k) r)
              (or (>= p s) (= (t2-bget M t2-a-rgn p) 0) (t2-rg-hascall? M p)) 0
              (or (< r 0) (= r (t2-bget M t2-a-rgn p))) (recur (inc k) (t2-bget M t2-a-rgn p))
              :else 0)))))
(defn- t2-rg-backpred? [M :vector-i64 s :i64] :bool
  (loop [k 0] (and (< k (t2-bget M t2-a-bpn s)) (or (>= (t2-pred M s k) s) (recur (inc k))))))
(defn- t2-rgn-plan [M :vector-i64] :vector-i64
  (let [nb (t2-g M t2-s-nb)
        ;; membership in block order (forward edges only inside a region), path charges in kd
        M1 (loop [b 0 m (-> M (t2-wzero t2-a-rgn 0 nb) (t2-wzero t2-a-rgk 0 nb) (t2-wzero t2-a-rgd 0 nb) (t2-wzero t2-a-rgm 0 nb))]
             (if (>= b nb) m
               (recur (inc b)
                      (if (not (t2-rg-member? m b)) m
                        (let [r (if (= b 0) 0 (t2-rg-join m b))
                              head (= r 0)
                              rid (if head (if (t2-rg-backpred? m b) 0 (inc b)) r)
                              k (gn-max 0 (t2-kbatch m (t2-bget m t2-a-bv0 b) (t2-bget m t2-a-bv1 b) 0 0))
                              d (if head k (+ k (loop [j 0 x 0] (if (>= j (t2-bget m t2-a-bpn b)) x
                                                                  (recur (inc j) (gn-max x (t2-bget m t2-a-rgd (t2-pred m b j))))))))]
                          (if (= rid 0) m
                            (-> m (t2-bset t2-a-rgn b rid) (t2-bset t2-a-rgd b d)
                                (t2-bset t2-a-rgm b (+ (t2-rg-checks m b)
                                                       (if head 0 (loop [j 0 x 1000000] (if (>= j (t2-bget m t2-a-bpn b)) x
                                                                                         (recur (inc j) (gn-min x (t2-bget m t2-a-rgm (t2-pred m b j)))))))))
                                (t2-bset t2-a-rgk (dec rid) (gn-max (t2-bget m t2-a-rgk (dec rid)) d)))))))))
        ;; a region pays when it removes at least 3 checks for its 2-instruction precheck, and K fits a cmp immediate
        M2 (loop [h 0 m M1]
             (if (>= h nb) m
               (recur (inc h)
                      (if (and (= (t2-bget m t2-a-rgn h) (inc h))
                               ;; every path from the head to a member leaving the region must drop at least 3 checks
                               (let [n (loop [b h c 1000000]
                                         (if (>= b nb) c
                                           (recur (inc b)
                                                  (if (and (= (t2-bget m t2-a-rgn b) (inc h))
                                                           (let [t (t2-bget m t2-a-bt b) f (t2-bget m t2-a-bf b)]
                                                             (or (and (< t 0) (< f 0))
                                                                 (and (>= t 0) (not= (t2-bget m t2-a-rgn t) (inc h)))
                                                                 (and (>= f 0) (not= (t2-bget m t2-a-rgn f) (inc h))))))
                                                    (gn-min c (t2-bget m t2-a-rgm b)) c))))]
                                 (and (>= n 3) (< n 1000000) (> (t2-bget m t2-a-rgk h) 0) (< (t2-bget m t2-a-rgk h) 4096))))
                        m
                        (if (= (t2-bget m t2-a-rgn h) (inc h))
                          (loop [b h mm (t2-bset m t2-a-rgk h 0)] (if (>= b nb) mm
                                                                     (recur (inc b) (if (= (t2-bget mm t2-a-rgn b) (inc h)) (t2-bset mm t2-a-rgn b 0) mm))))
                          m)))))]
    (if (= t2-rgn-on 1) M2 (t2-wzero M2 t2-a-rgn 0 nb))))
(defn- t2-rgn-in? [M :vector-i64 b :i64] :bool (and (>= b 0) (> (t2-bget M t2-a-rgn b) 0)))
;; label of a trap of kind (0 udf, 1 brk #0) at the current point (M[last]): the shared plain stub, or with deferral the
;; stub publishing x8 + u + pending
(defn- t2-trapl [M :vector-i64 kind :i64] :vector-i64
  (if (= (t2-g M t2-s-defer) 0) (t2-s M t2-s-last (+ (t2-lab M (t2-g M t2-s-nb)) kind))
    (let [c (+ (t2-g M t2-s-curu) (t2-g M t2-s-pend)) key (+ (* kind 65536) c) n (t2-g M t2-s-ntst)]
      (loop [i 0]
        (cond (>= i n) (if (or (>= n 32) (< c 0) (>= c 4096)) (-> M (t2-fail 27) (t2-s t2-s-last (+ (t2-lab M (t2-g M t2-s-nb)) kind)))
                         (let [l (t2-l-trap M n)]
                           (-> M (t2-s (+ t2-a-tstub (* 2 n)) key) (t2-s (+ t2-a-tstub (* 2 n) 1) l) (t2-s t2-s-ntst (inc n))
                               (t2-s t2-s-last l))))
              (= (t2-g M (+ t2-a-tstub (* 2 i))) key) (t2-s M t2-s-last (t2-g M (+ t2-a-tstub (* 2 i) 1)))
              :else (recur (inc i)))))))
(defn- t2-e-tstubs [M :vector-i64 k :i64] :vector-i64
  (if (>= k (t2-g M t2-s-ntst)) M
    (let [key (t2-g M (+ t2-a-tstub (* 2 k))) kind (quot key 65536) c (- key (* kind 65536))]
      (t2-e-tstubs (-> M (t2-deflab (t2-g M (+ t2-a-tstub (* 2 k) 1)))
                       (cond-> (> c 0) (gn-emit (enc-add-i 8 8 c)))
                       (gn-emit (enc-str 8 7 CTX-FUEL))
                       (gn-emit (if (= kind 0) (gn-e-udf) (enc-brk 0))))
                   (inc k)))))
;; a quotient with a register divisor: zero divisor and MIN / -1 trap (brk #0) through the trap stub
(defn- t2-quot [M :vector-i64 d :i64 x :i64 y :i64] :vector-i64
  (let [M0 (t2-trapl M 1) l (t2-last M0)]
    (-> M0 (t2-jmp FX-CB19 l (enc-cbz y 0)) (gn-emit (enc-cmn-i y 1)) (gn-emit (enc-bcond (enc-cond-ne) 3))
        (gn-emit (enc-cmp-i x 1)) (t2-bcond 6 l) (gn-emit (enc-sdiv d x y)))))
;; ---- loop versioning ------------------------------------------------------------------------------------------------------
;; An innermost natural loop (header h, call-free body) whose header ends in a test of an induction phi p (stepped by +1 or
;; -1 on every back edge) against a loop-invariant limit L gets a fast copy. Entering edges go to a precheck that computes
;; the body range [lo, hi] of p (p is distinct in every body iteration, so at most hi - lo + 1 of them) and requires
;; lo <= hi, hi - lo < 2^32, fuel >= (hi - lo + 2) * K (K: most charges on one pass through the loop, so no charge in the
;; fast copy can exhaust: each just subtracts) and, for every body access whose index is affine in p (a*p + invariants,
;; |a| < 2^16), index(lo) and index(hi) below the length. Affine indices are exact modulo 2^64, so with both ends in range
;; and the p-dependent part below 2^48 every body index is in range and its check is dropped in the fast copy. Any failed
;; precheck runs the original loop. Fast copies keep every other trap (through the same stubs), store and charge order.
(def t2-maxlp 8)
(def t2-maxacc 64)
(def t2-lpw 17)
(def t2-accw 10)
(def t2-s-nlp 45)
(def t2-s-nacc 46)
(def t2-s-fastl 47)   ; loop id + 1 while emitting its fast copies
(def t2-s-nextl 48)   ; label emitted right after the current block (-1: none)
(def t2-s-aa 49)      ; affine scratch: coefficient of p, constant, term count, failure
(def t2-s-ac 50)
(def t2-s-an 51)
(def t2-s-af 52)
(def t2-a-bloop (+ t2-a-lref 4096))           ; per block: versioned loop id + 1 (0 none)
(def t2-a-lp (+ t2-a-bloop t2-maxb))
(def t2-a-acc (+ t2-a-lp (* t2-maxlp t2-lpw)))
(def t2-a-kd (+ t2-a-acc (* t2-maxacc t2-accw)))  ; per block: scratch (body marks, path charges)
(def t2-a-aterm (+ t2-a-kd (* 2 t2-maxb)))          ; 3 x (coefficient, value)
;; loop fields
(def t2-lf-h 0) (def t2-lf-p 1) (def t2-lf-s 2) (def t2-lf-kind 3) (def t2-lf-L 4) (def t2-lf-K 5) (def t2-lf-a0 6) (def t2-lf-a1 7)
(def t2-lf-R 8)   ; search loops (kind 7): the register holding the greatest p every access allows
(defn- t2-lp [M :vector-i64 l :i64 fld :i64] :i64 (t2-g M (+ t2-a-lp (* l t2-lpw) fld)))
(defn- t2-lps [M :vector-i64 l :i64 fld :i64 x :i64] :vector-i64 (t2-s M (+ t2-a-lp (* l t2-lpw) fld) x))
(defn- t2-acc [M :vector-i64 k :i64 fld :i64] :i64 (t2-g M (+ t2-a-acc (* k t2-accw) fld)))
(defn- t2-accs [M :vector-i64 k :i64 fld :i64 x :i64] :vector-i64 (t2-s M (+ t2-a-acc (* k t2-accw) fld) x))
(defn- t2-l-fast [M :vector-i64 b :i64] :i64 (+ (t2-lab M (* 8 (t2-g M t2-s-nb))) 3 b))
(defn- t2-l-pre [M :vector-i64 l :i64] :i64 (+ (t2-lab M (* 9 (t2-g M t2-s-nb))) 3 l))
(defn- t2-vhead? [M :vector-i64 b :i64] :bool
  (let [l (t2-bget M t2-a-bloop b)] (and (> l 0) (= (t2-lp M (dec l) t2-lf-h) b))))
;; the label an edge from block `from` to block S jumps to: the fast copy inside the loop being copied, the precheck when
;; entering a versioned loop from outside, else S itself
(defn- t2-tlab [M :vector-i64 from :i64 S :i64] :i64
  (let [lS (t2-bget M t2-a-bloop S) fl (t2-g M t2-s-fastl)]
    (cond (and (> fl 0) (= lS fl) (> (t2-g M t2-s-ucur) 0)) (t2-ulab M S)
          (and (> fl 0) (= lS fl)) (t2-l-fast M S)
          ;; inside a fuel region's cold copy, a member stays in the copy
          (and (> (t2-g M t2-s-cregion) 0) (>= S 0) (= (t2-bget M t2-a-rgn S) (t2-g M t2-s-cregion))) (t2-l-cold M S)
          (and (t2-vhead? M S) (not= (t2-bget M t2-a-bloop from) lS)) (t2-l-pre M (dec lS))
          :else (t2-lab M S))))
(defn- t2-next-label [M :vector-i64 b :i64] :i64
  (let [n (t2-nextb M b)] (cond (< n 0) -1 (t2-vhead? M n) (t2-l-pre M (dec (t2-bget M t2-a-bloop n))) :else (t2-lab M n))))
;; ---- natural loop body: blocks reaching a latch without passing h (marks in kd: 1) ----
(defn- t2-body-pass [M :vector-i64 h :i64 b :i64 changed :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) (t2-s M t2-s-last changed)
    (if (or (= b h) (not= (t2-bget M t2-a-kd b) 1)) (t2-body-pass M h (inc b) changed)
      (let [n (t2-bget M t2-a-bpn b)
            r (loop [k 0 m M ch changed]
                (if (>= k n) (t2-s m t2-s-last ch)
                  (let [p (t2-pred m b k)]
                    (cond (or (= p h) (= (t2-bget m t2-a-kd p) 1)) (recur (inc k) m ch)
                          (t2-dom? m h p) (recur (inc k) (t2-bset m t2-a-kd p 1) 1)
                          :else (recur (inc k) (t2-s m t2-s-af 1) ch)))))]
        (t2-body-pass r h (inc b) (t2-last r))))))
(defn- t2-body [M :vector-i64 h :i64 iter :i64] :vector-i64
  (if (>= iter 64) (t2-s M t2-s-af 1)
    (let [M1 (t2-body-pass M h 0 0)] (if (= (t2-last M1) 1) (t2-body M1 h (inc iter)) M1))))
(defn- t2-mark-latches [M :vector-i64 h :i64 k :i64 n :i64] :vector-i64
  (if (>= k n) M
    (let [p (t2-pred M h k)]
      (t2-mark-latches (if (and (not= p h) (t2-dom? M h p)) (t2-bset M t2-a-kd p 1) (if (= p h) (t2-s M t2-s-af 1) M)) h (inc k) n))))
(defn- t2-in-body? [M :vector-i64 b :i64] :bool (and (>= b 0) (= (t2-bget M t2-a-kd b) 1)))
;; body blocks: no real call, no other loop, no inner back edge
(defn- t2-body-ok? [M :vector-i64 h :i64 b :i64] :bool
  (or (>= b (t2-g M t2-s-nb))
      (and (or (not (t2-in-body? M b))
               (and (= (t2-bget M t2-a-bloop b) 0)
                    (>= (t2-kcount M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b) 0) 0)
                    (let [t (t2-bget M t2-a-bt b) f (t2-bget M t2-a-bf b)]
                      (and (or (not (t2-in-body? M t)) (= t h) (not (t2-dom? M t b)))
                           (or (not (t2-in-body? M f)) (= f h) (not (t2-dom? M f b)))))))
           (t2-body-ok? M h (inc b)))))
;; ---- most charges on one pass (longest path from h over body edges, back edges excluded) ----
(defn- t2-kof [M :vector-i64 b :i64] :i64 (t2-kcount M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b) 0))
(defn- t2-kd-relax [M :vector-i64 h :i64 b :i64 changed :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) (t2-s M t2-s-last changed)
    (if (or (not (t2-in-body? M b)) (< (t2-bget M (+ t2-a-kd t2-maxb) b) 0)) (t2-kd-relax M h (inc b) changed)
      (let [d (t2-bget M (+ t2-a-kd t2-maxb) b)
            t (t2-bget M t2-a-bt b) f (t2-bget M t2-a-bf b)
            M1 (if (and (t2-in-body? M t) (not= t h) (< (t2-bget M (+ t2-a-kd t2-maxb) t) (+ d (t2-kof M t))))
                 (t2-s (t2-bset M (+ t2-a-kd t2-maxb) t (+ d (t2-kof M t))) t2-s-last 1) (t2-s M t2-s-last 0))
            c1 (t2-last M1)
            M2 (if (and (t2-in-body? M1 f) (not= f h) (< (t2-bget M1 (+ t2-a-kd t2-maxb) f) (+ d (t2-kof M1 f))))
                 (t2-s (t2-bset M1 (+ t2-a-kd t2-maxb) f (+ d (t2-kof M1 f))) t2-s-last 1) (t2-s M1 t2-s-last 0))]
        (t2-kd-relax M2 h (inc b) (if (or (= c1 1) (= (t2-last M2) 1)) 1 changed))))))
(defn- t2-kd-iter [M :vector-i64 h :i64 iter :i64] :vector-i64
  (if (>= iter 300) (t2-s M t2-s-af 1)
    (let [M1 (t2-kd-relax M h 0 0)] (if (= (t2-last M1) 1) (t2-kd-iter M1 h (inc iter)) M1))))
(defn- t2-kd-max [M :vector-i64 b :i64 m :i64] :i64
  (if (>= b (t2-g M t2-s-nb)) m (t2-kd-max M (inc b) (if (t2-in-body? M b) (gn-max m (t2-bget M (+ t2-a-kd t2-maxb) b)) m))))
;; ---- affine index analysis: acc += m * v ----
(defn- t2-small? [x :i64] :bool (and (> x -65536) (< x 65536)))
(defn- t2-aff-term [M :vector-i64 m :i64 v :i64 k :i64] :vector-i64
  (let [n (t2-g M t2-s-an)]
    (cond (>= k n) (if (>= n 3) (t2-s M t2-s-af 1)
                     (-> M (t2-s (+ t2-a-aterm (* 2 n)) m) (t2-s (+ t2-a-aterm (* 2 n) 1) v) (t2-s t2-s-an (inc n))))
          (= (t2-g M (+ t2-a-aterm (* 2 k) 1)) v)
          (let [c (+ (t2-g M (+ t2-a-aterm (* 2 k))) m)] (if (t2-small? c) (t2-s M (+ t2-a-aterm (* 2 k)) c) (t2-s M t2-s-af 1)))
          :else (t2-aff-term M m v (inc k)))))
(defn- t2-aff [M :vector-i64 v0 :i64 m :i64 p :i64 depth :i64] :vector-i64
  (let [v (t2-res M v0) op (t2-op-of M v)]
    (cond (or (not= (t2-g M t2-s-af) 0) (> depth 8) (not (t2-small? m))) (t2-s M t2-s-af 1)
          (t2-isconst? M v)
          (let [k (t2-kval M v)]
            (if (and (> k -1099511627776) (< k 1099511627776)) (t2-s M t2-s-ac (+ (t2-g M t2-s-ac) (* m k))) (t2-s M t2-s-af 1)))
          (= v p) (let [a (+ (t2-g M t2-s-aa) m)] (if (t2-small? a) (t2-s M t2-s-aa a) (t2-s M t2-s-af 1)))
          ;; string-length is its slot's (loop-invariant) length register, checked at its own position before any use
          (= op t2-slen) (if (>= (t2-vf M v t2-f-reg) 0) (t2-aff-term M m v 0) (t2-s M t2-s-af 1))
          (not (t2-in-body? M (t2-vf M v t2-f-blk)))
          (if (or (= op t2-phi) (t2-regval? M v)) (if (>= (t2-vf M v t2-f-reg) 0) (t2-aff-term M m v 0) (t2-s M t2-s-af 1)) (t2-s M t2-s-af 1))
          (= op t2-bin)
          (let [bop (t2-vf M v t2-f-a) x (t2-res M (t2-vf M v t2-f-b)) y (t2-res M (t2-vf M v t2-f-c))]
            (cond (= bop BOP-ADD) (-> M (t2-aff x m p (inc depth)) (t2-aff y m p (inc depth)))
                  (= bop BOP-SUB) (-> M (t2-aff x m p (inc depth)) (t2-aff y (- 0 m) p (inc depth)))
                  (and (= bop BOP-MUL) (t2-isconst? M y) (t2-small? (t2-kval M y))) (t2-aff M x (* m (t2-kval M y)) p (inc depth))
                  (and (= bop BOP-MUL) (t2-isconst? M x) (t2-small? (t2-kval M x))) (t2-aff M y (* m (t2-kval M x)) p (inc depth))
                  (and (= bop BOP-SHL) (t2-isconst? M y) (>= (t2-kval M y) 0) (< (t2-kval M y) 16))
                  (t2-aff M x (* m (i64-shift-left 1 (t2-kval M y))) p (inc depth))
                  :else (t2-s M t2-s-af 1)))
          :else (t2-s M t2-s-af 1))))
;; record body access v (index value ix, a vat/vset/tab not already unchecked) when its index is affine in p
(defn- t2-acc-add [M :vector-i64 v :i64 ix :i64 p :i64] :vector-i64
  (let [n (t2-g M t2-s-nacc)
        M1 (-> M (t2-s t2-s-aa 0) (t2-s t2-s-ac 0) (t2-s t2-s-an 0) (t2-s t2-s-af 0) (t2-aff ix 1 p 0))]
    (if (or (not= (t2-g M1 t2-s-af) 0) (>= n t2-maxacc) (not (t2-small? (t2-g M1 t2-s-ac))) ) (t2-s M1 t2-s-af 0)
      (let [M2 (-> M1 (t2-accs n 0 v) (t2-accs n 1 (t2-g M1 t2-s-aa)) (t2-accs n 2 (t2-g M1 t2-s-ac)) (t2-accs n 3 (t2-g M1 t2-s-an))
                   (t2-s t2-s-nacc (inc n)) (t2-xs v t2-x-flags (bit-or (t2-xf M1 v t2-x-flags) 16)))]
        (loop [k 0 m M2] (if (>= k (t2-g M1 t2-s-an)) m
                           (recur (inc k) (-> m (t2-accs n (+ 4 (* 2 k)) (t2-g M1 (+ t2-a-aterm (* 2 k))))
                                              (t2-accs n (+ 5 (* 2 k)) (t2-g M1 (+ t2-a-aterm (* 2 k) 1)))))))))))
(defn- t2-acc-vals [M :vector-i64 v :i64 v1 :i64 p :i64] :vector-i64
  (if (>= v v1) M
    (let [op (t2-op-of M v)
          M1 (cond (t2-gone? M v) M
                   (and (or (= op t2-vat) (= op t2-vset)) (not= (bit-and (t2-xf M v t2-x-flags) 8) 8))
                   (t2-acc-add M v (t2-vf M v t2-f-b) p)
                   (= op t2-tab) (t2-acc-add M v (t2-vf M v t2-f-c) p)
                   :else M)]
      (t2-acc-vals M1 (inc v) v1 p))))
;; only blocks run on every iteration (dominating every latch): a conditional access may be unreachable for part of the
;; range (its index there out of bounds), so it keeps its check instead of failing the precheck
(defn- t2-every-iter? [M :vector-i64 h :i64 b :i64 k :i64 n :i64] :bool
  (or (>= k n) (and (or (not (t2-in-body? M (t2-pred M h k))) (t2-dom? M b (t2-pred M h k))) (t2-every-iter? M h b (inc k) n))))
(defn- t2-acc-blocks [M :vector-i64 h :i64 b :i64 p :i64] :vector-i64 (t2-acc-blocks2 M h b p false))
;; (a search loop's header accesses too: its fast copy tests p <= R before the header)
(defn- t2-acc-blocks2 [M :vector-i64 h :i64 b :i64 p :i64 withh :bool] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-acc-blocks2 (if (and (t2-in-body? M b) (or withh (not= b h)) (= (t2-bget M t2-a-breach b) 1) (t2-every-iter? M h b 0 (t2-bget M t2-a-bpn h)))
                      (t2-acc-vals M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b) p) M) h (inc b) p withh)))
;; ---- header test and induction phi ----
;; step of phi p along latch preds of h: 1 / -1, 0 when not uniform
(defn- t2-step-of [M :vector-i64 x :i64 p :i64] :i64
  (let [v (t2-res M x)]
    (if (not= (t2-op-of M v) t2-bin) 0
      (let [bop (t2-vf M v t2-f-a) a (t2-res M (t2-vf M v t2-f-b)) c (t2-res M (t2-vf M v t2-f-c))]
        (cond (and (= bop BOP-ADD) (= a p) (t2-isconst? M c)) (t2-kval M c)
              (and (= bop BOP-ADD) (= c p) (t2-isconst? M a)) (t2-kval M a)
              (and (= bop BOP-SUB) (= a p) (t2-isconst? M c)) (- 0 (t2-kval M c))
              :else 0)))))
(defn- t2-phi-step [M :vector-i64 h :i64 p :i64 k :i64 n :i64 s :i64] :i64
  (if (>= k n) s
    (if (t2-in-body? M (t2-pred M h k))
      (let [x (t2-step-of M (t2-phiarg M p k) p)]
        (if (or (= x 0) (and (not= s 0) (not= x s))) 0 (t2-phi-step M h p (inc k) n x)))
      (t2-phi-step M h p (inc k) n s))))
;; continue predicate kind (p on the left): 1 <, 2 <=, 3 !=, 4 >, 5 >=, 6 == (unsupported), 0 none
(defn- t2-cckind [cc :i64] :i64 (cond (= cc CC-LT) 1 (= cc CC-LE) 2 (= cc CC-GT) 4 (= cc CC-GE) 5 (= cc CC-EQ) 6 (= cc t2-cc-ne) 3 :else 0))
(defn- t2-kswap [k :i64] :i64 (cond (= k 1) 4 (= k 2) 5 (= k 4) 1 (= k 5) 2 :else k))
(defn- t2-kneg [k :i64] :i64 (cond (= k 1) 5 (= k 2) 4 (= k 3) 6 (= k 4) 2 (= k 5) 1 (= k 6) 3 :else 0))
;; body range endpoints lo = (src) + d, hi = (src) + d; src 0 = p (its entry value), 1 = L; step s in +-1/2/4/8:
;; s > 0: [p, L-1] for <, [p, L] for <=, [p, L-s] for != ; s < 0: [L+1, p] for >, [L, p] for >=, [L-s, p] for !=
(defn- t2-lo-src [kind :i64 s :i64] :i64 (if (> s 0) 0 1))
(defn- t2-hi-src [kind :i64 s :i64] :i64 (if (> s 0) 1 0))
(defn- t2-lo-d [kind :i64 s :i64] :i64 (if (> s 0) 0 (cond (= kind 5) 0 (= kind 4) 1 :else (- 0 s))))
(defn- t2-hi-d [kind :i64 s :i64] :i64 (if (> s 0) (cond (or (= kind 2) (= kind 7)) 0 (= kind 1) -1 :else (- 0 s)) 0))
(defn- t2-step-ok? [s :i64] :bool (or (= s 1) (= s -1) (= s 2) (= s -2) (= s 4) (= s -4) (= s 8) (= s -8)))
(defn- t2-kind-ok? [kind :i64 s :i64] :bool
  (and (t2-step-ok? s) (or (and (> s 0) (or (= kind 1) (= kind 2) (= kind 3))) (and (< s 0) (or (= kind 3) (= kind 4) (= kind 5)))
                           (and (= s 1) (= kind 7)))))
;; L + k does not wrap (k small, nonzero)
(defn- t2-nowrap? [L :i64 k :i64] :bool
  (if (> k 0) (<= L (- 9223372036854775807 k)) (>= L (- -9223372036854775808 k))))
;; the stepping past the last body value cannot wrap: k added to L (0: no check)
(defn- t2-wrapk [kind :i64 s :i64] :i64
  (cond (and (= kind 1) (> s 1)) (dec s)
        (= kind 2) s
        (and (= kind 4) (< s -1)) (inc s)
        (= kind 5) s
        :else 0))
;; analyse block h as a loop header; on success records loop l = nlp
(defn- t2-try-loop [M :vector-i64 h :i64] :vector-i64
  (let [nb (t2-g M t2-s-nb)
        M0 (-> M (t2-wzero t2-a-kd 0 t2-maxb) (t2-s t2-s-af 0) (t2-mark-latches h 0 (t2-bget M t2-a-bpn h)))
        any (loop [b 0] (and (< b nb) (or (= (t2-bget M0 t2-a-kd b) 1) (recur (inc b)))))]
    (if (or (not any) (not= (t2-g M0 t2-s-af) 0)) M
      (let [M1 (t2-body M0 h 0)
            t (t2-lastval M1 h)
            c (if (and (> t 0) (= (t2-op-of M1 t) t2-brz)) (t2-res M1 (t2-vf M1 t t2-f-a)) 0)]
        (if (or (not= (t2-g M1 t2-s-af) 0) (not (t2-body-ok? (t2-bset M1 t2-a-kd h 1) h 0))
                (= c 0) (not= (t2-op-of M1 c) t2-cmp) (= (t2-cckind (t2-vf M1 c t2-f-a)) 0))
          M
          (let [M2 (t2-bset M1 t2-a-kd h 1)
                x (t2-res M2 (t2-vf M2 c t2-f-b)) y (t2-res M2 (t2-vf M2 c t2-f-c))
                px (and (= (t2-op-of M2 x) t2-phi) (= (t2-vf M2 x t2-f-blk) h))
                p (if px x y) L (if px y x)
                k0 (if px (t2-cckind (t2-vf M2 c t2-f-a)) (t2-kswap (t2-cckind (t2-vf M2 c t2-f-a))))
                tk (t2-bget M2 t2-a-bt h) fl (t2-bget M2 t2-a-bf h)
                tin (t2-in-body? M2 tk) fin (t2-in-body? M2 fl)
                nz (t2-vf M2 t t2-f-b)
                ;; the body successor is reached when the compare is true: taken with BRNZ, fallthrough with BRZ
                ctrue (if tin (= nz 1) (= nz 0))
                kind (if ctrue k0 (t2-kneg k0))
                s (if (and (= (t2-op-of M2 p) t2-phi) (= (t2-vf M2 p t2-f-blk) h) (>= (t2-vf M2 p t2-f-reg) 0))
                    (t2-phi-step M2 h p 0 (t2-bget M2 t2-a-bpn h) 0) 0)
                Lok (or (t2-isconst? M2 L) (and (= (t2-op-of M2 L) t2-slen) (>= (t2-vf M2 L t2-f-reg) 0))
                        (and (not (t2-in-body? M2 (t2-vf M2 L t2-f-blk))) (>= (t2-vf M2 L t2-f-reg) 0)))
                Lk (t2-kval M2 L)
                Lconst-ok (or (not (t2-isconst? M2 L)) (= (t2-wrapk kind s) 0) (t2-nowrap? Lk (t2-wrapk kind s)))]
            (if (or (= tin fin) (not (t2-kind-ok? kind s)) (not Lok) (not Lconst-ok) (= (t2-g M2 t2-s-nlp) t2-maxlp)
                    (and (= (t2-g M2 t2-s-pub) 1) (= (t2-g M2 t2-s-defer) 0) (= (t2-g M2 t2-s-fuel) 1)))
              M
              (let [M3 (-> M2 (t2-wfill (+ t2-a-kd t2-maxb) 0 nb -1) (t2-bset (+ t2-a-kd t2-maxb) h (t2-kof M2 h)) (t2-kd-iter h 0))
                    K (t2-kd-max M3 0 0)
                    a0 (t2-g M3 t2-s-nacc)
                    M4 (t2-acc-blocks M3 h 0 p)
                    a1 (t2-g M4 t2-s-nacc)
                    l (t2-g M4 t2-s-nlp)]
                (if (or (not= (t2-g M3 t2-s-af) 0) (>= K 65536) (= a0 a1))
                  (t2-acc-unflag M4 a0 a1)
                  (-> M4 (t2-lps l t2-lf-h h) (t2-lps l t2-lf-p p) (t2-lps l t2-lf-s s) (t2-lps l t2-lf-kind kind)
                      (t2-lps l t2-lf-L L) (t2-lps l t2-lf-K K) (t2-lps l t2-lf-a0 a0) (t2-lps l t2-lf-a1 a1)
                      (t2-s t2-s-nlp (inc l)) (t2-mark-loop 0 (inc l))))))))))))
(defn- t2-acc-unflag [M :vector-i64 a0 :i64 a1 :i64] :vector-i64
  (if (>= a0 a1) (t2-s M t2-s-nacc (gn-min a0 (t2-g M t2-s-nacc)))
    (let [v (t2-acc M a0 0)] (t2-acc-unflag (t2-xs M v t2-x-flags (bit-and (t2-xf M v t2-x-flags) (bit-not 16))) (inc a0) a1))))
(defn- t2-mark-loop [M :vector-i64 b :i64 id :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M (t2-mark-loop (if (t2-in-body? M b) (t2-bset M t2-a-bloop b id) M) (inc b) id)))
(defn- t2-find-loops [M :vector-i64 h :i64] :vector-i64
  (if (>= h (t2-g M t2-s-nb)) M
    (t2-find-loops (if (and (= (t2-bget M t2-a-breach h) 1) (= (t2-bget M t2-a-bloop h) 0))
                     (let [M1 (t2-try-loop M h)] (if (and (= t2-sloop-on 1) (= (t2-g M1 t2-s-nlp) (t2-g M t2-s-nlp))) (t2-try-sloop M1 h) M1)) M)
                   (inc h))))
(defn- t2-loopplan [M :vector-i64] :vector-i64
  (-> M (t2-s t2-s-nlp 0) (t2-s t2-s-nacc 0) (t2-s t2-s-fastl 0) (t2-wzero t2-a-bloop 0 t2-maxb) (t2-wzero t2-a-sr 0 256)
      (t2-wzero t2-a-srg 0 (inc (t2-g M t2-s-nv))) (t2-s t2-s-srskip 0)
      (cond-> (= t2-loops-on 1) (t2-find-loops 1))))
(def t2-loops-on 1)
;; ---- precheck and fast copies ----
;; register x := (p or L) + d
(defn- t2-lreg [M :vector-i64 l :i64] :i64
  (if (= (t2-lp M l t2-lf-kind) 7) (t2-lp M l t2-lf-R) (t2-vf M (t2-lp M l t2-lf-L) t2-f-reg)))
(defn- t2-lconst? [M :vector-i64 l :i64] :bool (and (not= (t2-lp M l t2-lf-kind) 7) (t2-isconst? M (t2-lp M l t2-lf-L))))
(defn- t2-e-endpt [M :vector-i64 x :i64 l :i64 src :i64 d :i64] :vector-i64
  (let [L (t2-lp M l t2-lf-L) r (if (= src 0) (t2-vf M (t2-lp M l t2-lf-p) t2-f-reg) (t2-lreg M l))]
    (cond (and (= src 1) (t2-lconst? M l)) (gn-mov-imm M x (+ (t2-kval M L) d))
          (= d 0) (gn-mov M x r)
          (> d 0) (gn-emit M (enc-add-i x r d))
          :else (gn-emit M (enc-sub-i x r (- 0 d))))))
;; x16 := index of access k (with constant C) at endpoint (src, d)
(defn- t2-addk [M :vector-i64 d :i64 x :i64 k :i64] :vector-i64
  (cond (and (= k 0) (= d x)) M
        (= k 0) (gn-mov M d x)
        (and (> k 0) (< k 4096)) (gn-emit M (enc-add-i d x k))
        (and (< k 0) (> k -4096)) (gn-emit M (enc-sub-i d x (- 0 k)))
        :else (-> M (gn-mov-imm 17 k) (gn-emit (enc-add-r d x 17)))))
(defn- t2-e-accval [M :vector-i64 k :i64 l :i64 src :i64 d :i64 C :i64] :vector-i64
  (let [a (t2-acc M k 1) n (t2-acc M k 3) L (t2-lp M l t2-lf-L)
        M1 (cond (= a 0) (gn-mov-imm M 16 C)
                 (and (= src 1) (t2-lconst? M l)) (gn-mov-imm M 16 (+ (* a (+ (t2-kval M L) d)) C))
                 (= a 1)
                 (t2-addk M 16 (if (= src 0) (t2-vf M (t2-lp M l t2-lf-p) t2-f-reg) (t2-lreg M l)) (+ d C))
                 :else
                 (let [M0 (t2-e-endpt M 17 l src d)
                       Ma (cond (= a -1) (gn-emit M0 (enc-sub-r 16 31 17))
                                (> (gn-pow2 a) 0) (gn-emit M0 (gn-e-lsl 16 17 (gn-pow2 a)))
                                :else (-> M0 (gn-mov-imm 16 a) (gn-emit (enc-mul 16 17 16))))]
                   (t2-addk Ma 16 16 C)))]
    (loop [j 0 m M1]
      (if (>= j n) m
        (let [c (t2-acc m k (+ 4 (* 2 j))) r (t2-vf m (t2-acc m k (+ 5 (* 2 j))) t2-f-reg)]
          (recur (inc j) (cond (= c 1) (gn-emit m (enc-add-r 16 16 r))
                               (= c -1) (gn-emit m (enc-sub-r 16 16 r))
                               :else (-> m (gn-mov-imm 17 c) (gn-emit (enc-madd 16 r 17 16))))))))))
;; branch to slow unless x16 <u the length of access k
(defn- t2-e-acclim [M :vector-i64 k :i64 slow :i64] :vector-i64
  (let [v (t2-acc M k 0)]
    (if (= (t2-op-of M v) t2-tab)
      (let [n (t2-vf M v t2-f-b)]
        (-> (if (< n 4096) (gn-emit M (enc-cmp-i 16 n)) (-> M (gn-mov-imm 17 n) (gn-emit (enc-cmp-r 16 17)))) (t2-bcond 2 slow)))
      (-> M (gn-emit (enc-cmp-r 16 (t2-dlen M v))) (t2-bcond 2 slow)))))
;; accesses j and k check the same index shape against the same length
(defn- t2-acc-len [M :vector-i64 k :i64] :i64
  (let [v (t2-acc M k 0)] (if (= (t2-op-of M v) t2-tab) (- 0 (inc (t2-vf M v t2-f-b))) (t2-dlen M v))))
(defn- t2-acc-same? [M :vector-i64 j :i64 k :i64] :bool
  (and (= (t2-acc M j 1) (t2-acc M k 1)) (= (t2-acc M j 3) (t2-acc M k 3)) (= (t2-acc-len M j) (t2-acc-len M k))
       (loop [i 4] (or (>= i (+ 4 (* 2 (t2-acc M k 3)))) (and (= (t2-acc M j i) (t2-acc M k i)) (recur (inc i)))))))
;; an endpoint check of access k whose index is a compile-time constant inside a table's constant length: nothing
(defn- t2-acc-static-ok? [M :vector-i64 k :i64 l :i64 src :i64 d :i64 C :i64] :bool
  (let [v (t2-acc M k 0) a (t2-acc M k 1)]
    (and (= (t2-op-of M v) t2-tab) (= (t2-acc M k 3) 0)
         (let [known (or (= a 0) (and (= src 1) (t2-lconst? M l)))
               x (cond (= a 0) C (and (= src 1) (t2-lconst? M l)) (+ (* a (+ (t2-kval M (t2-lp M l t2-lf-L)) d)) C) :else -1)]
           (and known (>= x 0) (< x (t2-vf M v t2-f-b)))))))
(defn- t2-e-accend [M :vector-i64 k :i64 l :i64 src :i64 d :i64 C :i64 slow :i64] :vector-i64
  (if (t2-acc-static-ok? M k l src d C) M (-> M (t2-e-accval k l src d C) (t2-e-acclim k slow))))
;; one group per (shape, length): only its least and greatest index (corners of the range) are checked
(defn- t2-e-accs [M :vector-i64 l :i64 k :i64 a1 :i64 slow :i64] :vector-i64
  (if (>= k a1) M
    (if (= (t2-g M (+ t2-a-kd k)) 1) (t2-e-accs M l (inc k) a1 slow)
      (let [kind (t2-lp M l t2-lf-kind) s (t2-lp M l t2-lf-s) a (t2-acc M k 1)
            r (loop [j k m M cmin (t2-acc M k 2) cmax (t2-acc M k 2)]
                (if (>= j a1) (-> m (t2-s t2-s-aa cmin) (t2-s t2-s-ac cmax))
                  (if (and (not= (t2-g m (+ t2-a-kd j)) 1) (t2-acc-same? m j k))
                    (recur (inc j) (t2-s m (+ t2-a-kd j) 1) (gn-min cmin (t2-acc m j 2)) (gn-max cmax (t2-acc m j 2)))
                    (recur (inc j) m cmin cmax))))
            cmin (t2-g r t2-s-aa) cmax (t2-g r t2-s-ac)
            ;; the least index: lo end for a >= 0, hi end for a < 0
            M1 (t2-e-accend r k l (if (>= a 0) (t2-lo-src kind s) (t2-hi-src kind s)) (if (>= a 0) (t2-lo-d kind s) (t2-hi-d kind s)) cmin slow)
            M2 (if (and (= a 0) (= cmin cmax)) M1
                 (t2-e-accend M1 k l (if (>= a 0) (t2-hi-src kind s) (t2-lo-src kind s)) (if (>= a 0) (t2-hi-d kind s) (t2-lo-d kind s)) cmax slow))]
        (t2-e-accs M2 l (inc k) a1 slow)))))
(defn- t2-e-precheck [M :vector-i64 l :i64] :vector-i64
  (let [h (t2-lp M l t2-lf-h) kind (t2-lp M l t2-lf-kind) s (t2-lp M l t2-lf-s) K (t2-lp M l t2-lf-K)
        L (t2-lp M l t2-lf-L) slow (t2-lab M h)
        M1 (-> M (t2-deflab (t2-l-pre M l))
               (cond-> (= kind 7) (t2-e-slimit l (t2-lp M l t2-lf-a0) (t2-lp M l t2-lf-a1) true))
               (t2-e-endpt 16 l (t2-lo-src kind s) (t2-lo-d kind s)) (t2-e-endpt 17 l (t2-hi-src kind s) (t2-hi-d kind s))
               (gn-emit (enc-cmp-r 16 17)) (t2-bcond 12 slow)          ; lo > hi
               (gn-emit (enc-sub-r 17 17 16))
               (gn-mov-imm 16 4294967296) (gn-emit (enc-cmp-r 17 16)) (t2-bcond 2 slow)   ; hi - lo >= 2^32
               (cond-> (and (> K 0) (= (t2-g M t2-s-fuel) 1))
                 (-> (gn-emit (enc-add-i 17 17 2))
                     (cond-> (> (gn-pow2 K) 0) (gn-emit (gn-e-lsl 17 17 (gn-pow2 K))))
                     (cond-> (and (> K 1) (= (gn-pow2 K) 0)) (-> (gn-mov-imm 16 K) (gn-emit (enc-mul 17 17 16))))
                     (gn-emit (enc-cmp-r 8 17)) (t2-bcond 3 slow)))                       ; fuel < (hi - lo + 2) K
               ;; stepping past the last body value must not wrap (L + k)
               (cond-> (and (not= kind 7) (not= (t2-wrapk kind s) 0) (not (t2-isconst? M L)))
                 (-> (gn-emit (if (> (t2-wrapk kind s) 0) (enc-adds-i 16 (t2-vf M L t2-f-reg) (t2-wrapk kind s))
                                (enc-subs-i 16 (t2-vf M L t2-f-reg) (- 0 (t2-wrapk kind s)))))
                     (t2-bcond 6 slow)))
               ;; != with |s| > 1: the distance must be a multiple of s
               (cond-> (and (= kind 3) (not= s 1) (not= s -1))
                 (-> (t2-e-endpt 16 l 1 0) (t2-e-endpt 17 l 0 0) (gn-emit (enc-sub-r 16 16 17))
                     (gn-emit (t2-limm BOP-AND 16 16 (dec (if (> s 0) s (- 0 s))))) (t2-jmp FX-CB19 slow (enc-cbnz 16 0)))))]
    (-> (t2-e-accs (t2-wzero M1 t2-a-kd 0 t2-maxacc) l (t2-lp M l t2-lf-a0) (t2-lp M l t2-lf-a1) slow)
        (cond-> (> (t2-lp M l t2-lf-CS) 0) (t2-e-cellguard l (t2-lp M l t2-lf-a0) slow)))))
;; ---- loop rotation: a fast-copy back edge runs a copy of the (small) header and branches straight back into the body ----
(def t2-s-inrot 55)
(defn- t2-hcount [M :vector-i64 v :i64 v1 :i64 n :i64] :i64
  (if (>= v v1) n (t2-hcount M (inc v) v1 (if (or (= (t2-op-of M v) t2-phi) (t2-gone? M v)) n (inc n)))))
(defn- t2-rot? [M :vector-i64 s :i64] :bool
  (let [fl (t2-g M t2-s-fastl)]
    (and (> fl 0) (>= s 0) (= (t2-g M t2-s-inrot) 0) (= (t2-g M t2-s-ucur) 0) (= s (t2-lp M (dec fl) t2-lf-h))
         (let [t (t2-lastval M s) taken (t2-bget M t2-a-bt s) fall (t2-bget M t2-a-bf s)]
           (and (> t 0) (= (t2-op-of M t) t2-brz) (>= taken 0) (>= fall 0)
                (not (t2-thread? M taken)) (not (t2-thread? M fall))
                (<= (t2-hcount M (t2-bget M t2-a-bv0 s) (t2-bget M t2-a-bv1 s) 0) 12))))))
;; header h inline (after the latch's copies): its charges, values, then a branch to the body successor on the
;; continue condition and a jump to the exit
(defn- t2-e-hinline [M :vector-i64 h :i64] :vector-i64
  (let [k (t2-kof M h) t (t2-lastval M h)
        M0 (-> M (t2-e-slimit-test h (t2-g M t2-s-fastl))
               (t2-s t2-s-inrot 1) (t2-s t2-s-curu (t2-bget M t2-a-uin h)) (t2-s t2-s-pend k) (t2-s t2-s-nextl -1)
               (cond-> (> k 0) (gn-emit (enc-sub-i 8 8 k))))
        M1 (t2-e-vals M0 h (t2-bget M0 t2-a-bv0 h) t)
        taken (t2-bget M1 t2-a-bt h) fall (t2-bget M1 t2-a-bf h) nz (t2-vf M1 t t2-f-b) c (t2-res M1 (t2-vf M1 t t2-f-a))
        tin (= (t2-bget M1 t2-a-bloop taken) (t2-g M1 t2-s-fastl))
        IN (if tin taken fall) OUT (if tin fall taken)
        jnz (if tin (= nz 1) (= nz 0))
        M2 (if (t2-needs-copies? M1 h IN) (t2-stub-label M1 h IN (t2-tlab M1 h IN)) (t2-s M1 t2-s-last (t2-tlab M1 h IN)))
        l (t2-last M2)
        fused (and (= (t2-op-of M2 c) t2-cmp) (not= (bit-and (t2-xf M2 c t2-x-flags) 129) 0))
        M3 (if fused
             (let [cc (t2-cmp-cond M2 c)] (-> M2 (t2-e-cmpflags c) (t2-bcond (if jnz cc (bit-xor cc 1)) l)))
             (let [Ma (t2-src M2 c 16) rc (t2-last Ma)] (t2-jmp Ma FX-CB19 l (if jnz (enc-cbnz rc 0) (enc-cbz rc 0)))))]
    (-> M3 (t2-copies h OUT) (t2-jmp FX-B26 (t2-tlab M3 h OUT) (enc-b 0)) (t2-s t2-s-inrot 0))))
;; ---- loop rotation outside fast copies: a latch b whose back edge goes to a header s (dominating b) that ends in its exit
;; test runs a copy of the header there and branches straight into the body (saving the jump back); only plain headers:
;; no batch, no hoisted checks, no version, no call, at most 12 values, and exactly one successor dominating the latch.
(def t2-rotn-on 1)
(defn- t2-rotn-eff [M :vector-i64 s :i64 x :i64 tk :bool] :i64   ; successor x of s past a thread block (-2: unknown)
  (cond (< x 0) -2
        (t2-thread? M x) (let [k (t2-known M s x tk)] (if (>= k 0) (t2-thread-dest M x k) -2))
        :else x))
(defn- t2-rotn-in [M :vector-i64 b :i64 s :i64] :i64   ; the header's in-loop successor (past threads), -1 none
  (let [taken (t2-rotn-eff M s (t2-bget M t2-a-bt s) true) fall (t2-rotn-eff M s (t2-bget M t2-a-bf s) false)
        dt (and (>= taken 0) (not= taken s) (t2-dom? M taken b)) df (and (>= fall 0) (not= fall s) (t2-dom? M fall b))]
    (cond (or (< taken 0) (< fall 0) (= taken fall)) -1 (and dt (not df)) taken (and df (not dt)) fall :else -1)))
(defn- t2-rotn? [M :vector-i64 b :i64 s :i64] :bool
  (and (= t2-rotn-on 1) (= (t2-g M t2-s-fastl) 0) (= (t2-g M t2-s-cold) 0) (= (t2-g M t2-s-inrot) 0)
       (>= s 0) (>= b 0) (not= b s) (= (t2-bget M t2-a-breach s) 1) (not (t2-thread? M s)) (not (t2-vhead? M s))
       (= (t2-bget M t2-a-fast s) 0) (not (t2-bch-any? M s)) (t2-dom? M s b)
       (let [t (t2-lastval M s) taken (t2-bget M t2-a-bt s) fall (t2-bget M t2-a-bf s)]
         (and (> t 0) (= (t2-op-of M t) t2-brz) (>= taken 0) (>= fall 0)
              (>= (t2-kcount M (t2-bget M t2-a-bv0 s) (t2-bget M t2-a-bv1 s) 0) 0)
              (<= (t2-hcount M (t2-bget M t2-a-bv0 s) (t2-bget M t2-a-bv1 s) 0) 12)
              (>= (t2-rotn-in M b s) 0)))))
;; header s inline at the latch b (after b's copies): its values (charges checked one by one), then a branch to the
;; in-loop successor on the continue condition and a jump to the exit (each past a thread block whose value s's branch
;; decides: copies from the thread block)
(defn- t2-e-hinline-n [M :vector-i64 b :i64 s :i64] :vector-i64
  (let [t (t2-lastval M s) IN (t2-rotn-in M b s)
        M0 (-> M (t2-s t2-s-inrot 1) (t2-s t2-s-curu (t2-bget M t2-a-uin s)) (t2-s t2-s-pend 0) (t2-s t2-s-nextl -1))
        M1 (t2-e-vals M0 s (t2-bget M0 t2-a-bv0 s) t)
        taken (t2-bget M1 t2-a-bt s) fall (t2-bget M1 t2-a-bf s) nz (t2-vf M1 t t2-f-b) c (t2-res M1 (t2-vf M1 t t2-f-a))
        eT (t2-rotn-eff M1 s taken true) eF (t2-rotn-eff M1 s fall false)
        tin (= IN eT) OUT (if tin eF eT)
        fIN (if (= (if tin taken fall) IN) s (if tin taken fall))     ; copies come from the thread block when threaded
        fOUT (if (= (if tin fall taken) OUT) s (if tin fall taken))
        jnz (if tin (= nz 1) (= nz 0))
        M2 (if (t2-needs-copies? M1 fIN IN) (t2-stub-label M1 fIN IN (t2-tlab M1 s IN)) (t2-s M1 t2-s-last (t2-tlab M1 s IN)))
        l (t2-last M2)
        fused (and (= (t2-op-of M2 c) t2-cmp) (not= (bit-and (t2-xf M2 c t2-x-flags) 129) 0))
        M3 (if fused
             (let [cc (t2-cmp-cond M2 c)] (-> M2 (t2-e-cmpflags c) (t2-bcond (if jnz cc (bit-xor cc 1)) l)))
             (let [Ma (t2-src M2 c 16) rc (t2-last Ma)] (t2-jmp Ma FX-CB19 l (if jnz (enc-cbnz rc 0) (enc-cbz rc 0)))))]
    (-> M3 (t2-copies fOUT OUT) (t2-jmp FX-B26 (t2-tlab M3 s OUT) (enc-b 0)) (t2-s t2-s-inrot 0))))
;; ---- constants of a fast loop that need materializing live in free caller-saved registers, set after the precheck ----
;; Hoist keys are positive value IDs for literal values and negative IDs for quotient magic reciprocals.
(def t2-s-nhoist 56)
(def t2-s-hbusy 57)
(def t2-a-hoist (+ t2-a-hint t2-maxv))   ; 16 x (const value, register)
(defn- t2-hoisted [M :vector-i64 x :i64] :i64
  (if (= (t2-g M t2-s-fastl) 0) -1
    (loop [i 0] (cond (>= i (t2-g M t2-s-nhoist)) -1
                      (= (t2-g M (+ t2-a-hoist (* 2 i))) x) (t2-g M (+ t2-a-hoist (* 2 i) 1))
                      :else (recur (inc i))))))
(defn- t2-hoist-magic? [M :vector-i64 v :i64 x0 :i64] :bool
  (let [x (t2-res M x0) k (t2-kval M x)]
    (and (= (t2-op-of M v) t2-bin) (= (t2-vf M v t2-f-a) BOP-QUOT)
         (= x (t2-res M (t2-vf M v t2-f-c))) (t2-isconst? M x) (> k 1) (= (gn-pow2 k) 0))))
;; registers busy anywhere in positions [p0, p1]: live values and the fixed descriptor/string-slot/table registers
(defn- t2-busy-in [M :vector-i64 p0 :i64 p1 :i64] :i64
  (let [m (loop [v 1 m 0]
            (if (> v (t2-g M t2-s-nv)) m
              (recur (inc v) (let [r (t2-vf M v t2-f-reg)]
                               (if (and (>= r 0) (< r 31) (t2-regval? M v) (not (t2-gone? M v))
                                        (<= (t2-xf M v t2-x-start) p1) (>= (t2-xf M v t2-x-end) p0))
                                 (bit-or m (i64-shift-left 1 r)) m)))))
        m2 (loop [k 0 m m] (if (>= k 16) m (recur (inc k) (if (= (t2-g M (+ t2-a-pd (* 4 k))) 1)
                                                            (bit-or m (bit-or (i64-shift-left 1 (t2-g M (+ t2-a-pd (* 4 k) 1))) (i64-shift-left 1 (t2-g M (+ t2-a-pd (* 4 k) 2))))) m))))
        ;; string slot registers (fixed for the whole function)
        m3 (loop [k 0 m m2] (if (>= k 8) m (recur (inc k) (if (= (t2-sd M k 0) 0) m
                                                            (loop [f 1 m m] (if (> f 4) m (recur (inc f) (let [r (t2-sd M k f)] (if (>= r 0) (bit-or m (i64-shift-left 1 r)) m)))))))))]
    (loop [k 0 m m3] (if (>= k (t2-g M t2-s-ntab)) m (recur (inc k) (bit-or m (i64-shift-left 1 (t2-g M (+ t2-a-tb (* 2 k) 1)))))))))
;; a constant operand the fast loop would materialize: not a 12-bit immediate, or the multiplier of a generic MUL
(defn- t2-hoist-want? [M :vector-i64 v :i64 x0 :i64] :bool
  (let [x (t2-res M x0) k (t2-kval M x)]
    (and (= (t2-op-of M x) t2-const)
         (or (>= k 4096) (<= k -4096)
             (and (= (t2-op-of M v) t2-bin) (= (t2-vf M v t2-f-a) BOP-MUL) (= (gn-pow2 k) 0) (not= k 1) (not= k 0))
             ;; the divisor of a quotient by a constant that is not a power of two (sdiv by the register then)
             (and (= (t2-op-of M v) t2-bin) (= (t2-vf M v t2-f-a) BOP-QUOT) (= x (t2-res M (t2-vf M v t2-f-c)))
                  (= (gn-pow2 k) 0) (not= k 1) (not= k 0) (not= k -1))))))
(defn- t2-hoist-add [M :vector-i64 x0 :i64 busy :i64 divmagic :bool] :vector-i64
  (let [x (t2-res M x0) key (if divmagic (- x) x) n (t2-g M t2-s-nhoist)]
    (if (or (>= n 16) (>= (t2-hoisted-any M key) 0)) M
      (let [taken (bit-or busy (t2-g M t2-s-hbusy))
            r (loop [i 0] (if (>= i 14) -1
                            (let [c (if (< i 7) (+ 9 i) (- i 7))]
                              (if (= (bit-and taken (i64-shift-left 1 c)) 0) c (recur (inc i))))))]
        (if (< r 0) M
          (-> M (t2-s (+ t2-a-hoist (* 2 n)) key) (t2-s (+ t2-a-hoist (* 2 n) 1) r) (t2-s t2-s-nhoist (inc n))
              (t2-s t2-s-hbusy (bit-or (t2-g M t2-s-hbusy) (i64-shift-left 1 r)))))))))
(defn- t2-hoisted-any [M :vector-i64 x :i64] :i64
  (loop [i 0] (cond (>= i (t2-g M t2-s-nhoist)) -1
                    (= (t2-g M (+ t2-a-hoist (* 2 i))) x) i
                    :else (recur (inc i)))))
(defn- t2-hoist-fused-mul? [M :vector-i64 v :i64] :bool
  (if (and (= (bit-and (t2-xf M v t2-x-flags) 32) 32) (= (t2-op-of M v) t2-bin) (= (t2-vf M v t2-f-a) BOP-MUL))
    (let [a (t2-res M (t2-vf M v t2-f-b)) b (t2-res M (t2-vf M v t2-f-c))]
      (or (and (not (t2-isconst? M a)) (t2-isconst? M b) (> (t2-kval M b) 1) (= (gn-pow2 (t2-kval M b)) 0))
          (and (t2-isconst? M a) (not (t2-isconst? M b)) (> (t2-kval M a) 1) (= (gn-pow2 (t2-kval M a)) 0))))
    false))
(defn- t2-hoist-vals [M :vector-i64 v :i64 v1 :i64 busy :i64] :vector-i64
  (if (>= v v1) M
    (let [op (t2-op-of M v)
          M1 (if (or (t2-gone? M v) (= op t2-phi)
                     (and (= (bit-and (t2-xf M v t2-x-flags) 32) 32) (not (t2-hoist-fused-mul? M v)))) M
               (cond (or (= op t2-bin) (= op t2-cmp))
                     (-> M (cond-> (t2-hoist-want? M v (t2-vf M v t2-f-b))
                                     (t2-hoist-add (t2-vf M v t2-f-b) busy (t2-hoist-magic? M v (t2-vf M v t2-f-b))))
                           (cond-> (t2-hoist-want? M v (t2-vf M v t2-f-c))
                                     (t2-hoist-add (t2-vf M v t2-f-c) busy (t2-hoist-magic? M v (t2-vf M v t2-f-c)))))
                     (= op t2-vset) (-> M (cond-> (t2-hoist-want? M v (t2-vf M v t2-f-c))
                                                   (t2-hoist-add (t2-vf M v t2-f-c) busy (t2-hoist-magic? M v (t2-vf M v t2-f-c))))
                                        (cond-> (t2-hoist-want? M v (t2-vf M v t2-f-b))
                                                   (t2-hoist-add (t2-vf M v t2-f-b) busy (t2-hoist-magic? M v (t2-vf M v t2-f-b)))))
                     ;; a constant index beyond the load/store offset range
                     (= op t2-vat) (cond-> M (t2-hoist-want? M v (t2-vf M v t2-f-b))
                                                    (t2-hoist-add (t2-vf M v t2-f-b) busy false))
                     :else M))]
      (t2-hoist-vals M1 (inc v) v1 busy))))
(defn- t2-lbusy [M :vector-i64 id :i64] :i64
  (let [nb (t2-g M t2-s-nb)
        p0 (loop [b 0 m 999999] (if (>= b nb) m (recur (inc b) (if (and (= (t2-bget M t2-a-bloop b) id) (= (t2-bget M t2-a-breach b) 1)) (gn-min m (t2-bget M t2-a-bpos0 b)) m))))
        p1 (loop [b 0 m -1] (if (>= b nb) m (recur (inc b) (if (and (= (t2-bget M t2-a-bloop b) id) (= (t2-bget M t2-a-breach b) 1)) (gn-max m (t2-bget M t2-a-bpos1 b)) m))))]
    (bit-or (t2-busy-in M p0 p1)
            (if (= (t2-lp M (dec id) t2-lf-kind) 7) (i64-shift-left 1 (t2-lp M (dec id) t2-lf-R)) 0))))
(defn- t2-hoist-plan [M :vector-i64 id :i64] :vector-i64
  (let [nb (t2-g M t2-s-nb)
        busy (t2-lbusy M id)]
    (loop [b 0 m (-> M (t2-s t2-s-nhoist 0) (t2-s t2-s-hbusy (t2-g M t2-s-creserve)))]
      (if (>= b nb) m
        (recur (inc b) (if (and (= (t2-bget m t2-a-bloop b) id) (= (t2-bget m t2-a-breach b) 1))
                         (t2-hoist-vals m (t2-bget m t2-a-bv0 b) (t2-bget m t2-a-bv1 b) busy) m))))))
(defn- t2-e-hoists [M :vector-i64 i :i64] :vector-i64
  (if (>= i (t2-g M t2-s-nhoist)) M
    (let [key (t2-g M (+ t2-a-hoist (* 2 i))) x (if (< key 0) (- key) key) k (t2-kval M x)
          value (if (< key 0) (gn-sdiv-magic k (gn-floor-log2 k 0)) k)]
      (t2-e-hoists (gn-mov-imm M (t2-g M (+ t2-a-hoist (* 2 i) 1)) value) (inc i)))))
;; the loop's next block in order after b (-1 none)
(defn- t2-lnext [M :vector-i64 b :i64 id :i64] :i64
  (loop [n (inc b)] (cond (>= n (t2-g M t2-s-nb)) -1
                          (and (= (t2-bget M t2-a-bloop n) id) (= (t2-bget M t2-a-breach n) 1) (not (t2-dead-thread? M n))) n
                          :else (recur (inc n)))))
(defn- t2-e-fastb [M :vector-i64 b :i64 id :i64] :vector-i64
  (if (or (< b 0) (not (t2-ok? M))) M
    (let [k (t2-kof M b) n (t2-lnext M b id)
          M0 (-> M (t2-deflab (t2-l-fast M b)) (t2-e-slimit-test b id) (t2-s t2-s-curu (t2-bget M t2-a-uin b)) (t2-s t2-s-pend k)
                 (t2-s t2-s-nextl (if (< n 0) -1 (t2-l-fast M n)))
                 (cond-> (> k 0) (gn-emit (enc-sub-i 8 8 k))))]
      (t2-e-fastb (t2-e-body M0 b) n id))))
;; ---- unrolled groups in a fast copy -------------------------------------------------------------------------------------
;; A versioned loop (not a search loop) whose body is straight-line -- the header's in-loop successor starts a chain of
;; single-predecessor blocks, none ending in a conditional branch, the last one the only latch -- leaves the loop only
;; at its header test, and runs one pass per p in the precheck's body range [lo, hi] (hi - lo < 2^32).
;; After the precheck, while at least 4 passes are left (L - p >= 3s - (hi - L) for s > 0, p - L >= 3|s| + (lo - L)
;; for s < 0: a difference below 2^33, no overflow; x16 is free at a pass start), a group runs 4 copies of the header's values (its exit test
;; dropped: the pass is known to happen) and the chain, each ending in the back edge's phi copies (and SR pointer
;; increments), and charges the group's 4 K1 units with one subtraction at its start (K1 the charges of one pass: the
;; precheck covered every pass, so none can exhaust; a trap stub inside the group adds back the group's charges not yet
;; made, through t2-s-pend). The last 0..3 passes and the final exit test run in the ordinary fast copy that follows.
(def t2-unroll-on 1)
(def t2-unroll-maxv 48)   ; body values (header and chain) per pass at most
(def t2-s-nunr 110)       ; loops unrolled in this function
(def t2-lf-U 9)           ; 1: unrolled
(def t2-lf-K1 10)         ; charges of one pass
(def t2-lf-L1 11)         ; the chain's last block (the latch)
(def t2-lf-OB 12)         ; 1: copies address through their group pointers at offsets, one increment per group
(def t2-lf-PS 13)         ; the one store of a pass, of a loop-invariant value to adjacent items: stp per two passes (0 none)
(def t2-s-ucopy 111)      ; pass of the group being emitted (1..4) when its loop has t2-lf-OB, else 0
;; labels past the descriptor / string stub labels: group starts (8), group ends (8), then 4 copies of every block
(defn- t2-l-ubase [M :vector-i64] :i64 (+ (t2-lab M (* 9 (t2-g M t2-s-nb))) (if (t2-has-sd? M) 300 172)))
(defn- t2-l-unr [M :vector-i64 l :i64] :i64 (+ (t2-l-ubase M) l))
(defn- t2-l-uend [M :vector-i64 l :i64] :i64 (+ (t2-l-ubase M) 8 l))
(defn- t2-l-ucopy [M :vector-i64 c :i64 b :i64] :i64 (+ (t2-l-ubase M) 16 (* c (t2-g M t2-s-nb)) b))
(defn- t2-l-uhi [M :vector-i64] :i64 (+ (t2-l-ubase M) 16 (* 4 (t2-g M t2-s-nb))))
(def t2-s-ucur 112)       ; copy being emitted (1..4) in a multi-block group, else 0
;; the label an in-loop edge to S takes inside copy c of loop l's group: S's copy, or (to the header) the next copy's start
(defn- t2-ulab [M :vector-i64 S :i64] :i64
  (let [c (dec (t2-g M t2-s-ucur)) l (dec (t2-g M t2-s-fastl))]
    (cond (not= S (t2-lp M l t2-lf-h)) (t2-l-ucopy M c S) (< c 3) (t2-l-ucopy M (inc c) S) :else (t2-l-uend M l))))
;; the in-loop successor of header h of loop id (-1 none)
(defn- t2-u-in [M :vector-i64 h :i64 id :i64] :i64
  (let [t (t2-bget M t2-a-bt h) f (t2-bget M t2-a-bf h)
        ti (and (>= t 0) (= (t2-bget M t2-a-bloop t) id)) fi (and (>= f 0) (= (t2-bget M t2-a-bloop f) id))]
    (cond (and ti (not fi)) t (and fi (not ti)) f :else -1)))
;; a BRZ on a constant (a folded test, e.g. an inlined helper's): it always takes one known successor
(defn- t2-u-constbrz? [M :vector-i64 v :i64] :bool (and (= (t2-op-of M v) t2-brz) (t2-isconst? M (t2-res M (t2-vf M v t2-f-a)))))
;; values of b fit a copy: no call, return or trap, and no terminator but its last value (in the chain a BR, or a BRZ on
;; a constant)
(defn- t2-u-vals-ok? [M :vector-i64 b :i64 header :bool] :bool
  (let [t (t2-lastval M b)]
    (loop [v (t2-bget M t2-a-bv0 b)]
      (or (>= v (t2-bget M t2-a-bv1 b))
          (let [op (t2-op-of M v)]
            (and (or (t2-gone? M v) (= op t2-phi)
                     (and (not= op t2-call) (not= op t2-ret) (not= op t2-trap)
                          ;; (a publication inside a group charged at once only resets the deferred count)
                          (or (not= op t2-pub) (= (t2-g M t2-s-defer) 1))
                          (or (and (not= op t2-br) (not= op t2-brz)) (= v t))
                          (or header (not= op t2-brz) (t2-u-constbrz? M v))))
                 (recur (inc v))))))))
(defn- t2-u-nvals [M :vector-i64 b :i64] :i64
  (loop [v (t2-bget M t2-a-bv0 b) n 0]
    (if (>= v (t2-bget M t2-a-bv1 b)) n (recur (inc v) (if (or (t2-gone? M v) (= (t2-op-of M v) t2-phi)) n (inc n))))))
;; the successor block b leaves for (b straight-line: a BR, a BRZ on a constant or a fallthrough), -1 when none
(defn- t2-u-succ [M :vector-i64 b :i64] :i64
  (let [t (t2-lastval M b)]
    (cond (and (> t 0) (= (t2-op-of M t) t2-br)) (t2-bget M t2-a-bt b)
          (and (> t 0) (t2-u-constbrz? M t))
          (let [k (t2-kval M (t2-res M (t2-vf M t t2-f-a)))]
            (if (and (>= (t2-bget M t2-a-bt b) 0) (if (= (t2-vf M t t2-f-b) 1) (not= k 0) (= k 0))) (t2-bget M t2-a-bt b) (t2-bget M t2-a-bf b)))
          (< (t2-bget M t2-a-bt b) 0) (t2-bget M t2-a-bf b)
          :else -1)))
;; the chain from b1: its last block when every block is straight-line, single-predecessor and in loop id, and the chain
;; reaches h covering every block of the loop (-1 otherwise); M[last] := charges of the chain
(defn- t2-u-chain [M :vector-i64 h :i64 id :i64 b1 :i64] :i64
  (let [nloop (loop [b 0 n 0] (if (>= b (t2-g M t2-s-nb)) n
                                (recur (inc b) (if (and (= (t2-bget M t2-a-bloop b) id) (= (t2-bget M t2-a-breach b) 1)) (inc n) n))))]
    (loop [b b1 n 1 last -1 nv (t2-u-nvals M h)]
      (cond (= b h) (if (and (= n nloop) (<= nv t2-unroll-maxv)) last -1)
            (or (< b 0) (> n 9) (not= (t2-bget M t2-a-bloop b) id) (not= (t2-bget M t2-a-breach b) 1) (t2-thread? M b)
                (t2-dead-thread? M b) (not= (t2-bget M t2-a-bpn b) 1) (not (t2-u-vals-ok? M b false))
                ;; (no copies entering a chain block: it has no live phi)
                (t2-needs-copies? M (if (< last 0) h last) b)) -1
            :else (recur (t2-u-succ M b) (inc n) b (+ nv (t2-u-nvals M b)))))))
(defn- t2-u-charges [M :vector-i64 h :i64 b1 :i64] :i64
  (loop [b b1 k (t2-kof M h)] (if (or (= b h) (< b 0)) k (recur (t2-u-succ M b) (+ k (t2-kof M b))))))
;; after the SR plan: decide whether loop l runs unrolled groups
(defn- t2-unroll-plan [M :vector-i64 l :i64] :vector-i64
  (let [h (t2-lp M l t2-lf-h) id (inc l) b1 (t2-u-in M h id) t (t2-lastval M h)
        last (if (and (= t2-unroll-on 1) (not= (t2-lp M l t2-lf-kind) 7) (>= b1 0) (not= b1 h) (> t 0) (= (t2-op-of M t) t2-brz)
                      (t2-u-vals-ok? M h true))
               (t2-u-chain M h id b1) -1)
        K1 (if (< last 0) 0 (t2-u-charges M h b1))]
    (if (or (< last 0) (> (* 4 K1) 4095) (not= K1 (t2-lp M l t2-lf-K)))
      ;; not straight-line: copies of a branching body (per-block charges), when it qualifies
      (let [latch (if (and (= t2-unroll-on 1) (not= (t2-lp M l t2-lf-kind) 7) (>= b1 0) (not= b1 h) (> t 0) (= (t2-op-of M t) t2-brz)
                           (t2-u-vals-ok? M h true) (not (t2-needs-copies? M h b1)))
                    (t2-u-dag M h id) -1)]
        (if (< latch 0) (t2-lps M l t2-lf-U 0)
          (-> M (t2-lps l t2-lf-U 2) (t2-lps l t2-lf-L1 latch) (t2-lps l t2-lf-OB (if (t2-u-ob? M l) 1 0)) (t2-lps l t2-lf-PS 0)
              (t2-s t2-s-nunr (inc (t2-g M t2-s-nunr))))))
      (let [ob (t2-u-ob? M l)]
        (-> M (t2-lps l t2-lf-U 1) (t2-lps l t2-lf-K1 K1) (t2-lps l t2-lf-L1 last) (t2-lps l t2-lf-OB (if ob 1 0))
            (t2-lps l t2-lf-PS (if ob (t2-u-ps M l h b1) 0)) (t2-s t2-s-nunr (inc (t2-g M t2-s-nunr))))))))
;; every SR group steps forward and its accesses stay within ldr/str offsets over 4 passes
(defn- t2-u-ob? [M :vector-i64 l :i64] :bool
  (let [a0 (t2-lp M l t2-lf-a0) a1 (t2-lp M l t2-lf-a1)]
    (and (> (t2-sr M l 0) 0)
         (loop [j 0] (or (>= j (t2-sr M l 0)) (and (> (t2-srgf M l j 1) 0) (recur (inc j)))))
         (loop [k a0] (or (>= k a1)
                          (let [v (t2-acc M k 0) g (t2-g M (+ t2-a-srg v))]
                            (and (or (= g 0) (<= (+ (t2-g M (+ t2-a-sro v)) (* 3 (t2-srgf M l (dec g) 1))) 32760)) (recur (inc k)))))))))
;; the pass's only memory access: a reduced store of an invariant value (a constant, or a register value from outside
;; the loop) stepping by one item, and nothing else that touches memory or can trap -- 0 when not so
(defn- t2-u-ps-op-ok? [M :vector-i64 v :i64] :bool
  (let [op (t2-op-of M v)]
    (or (t2-gone? M v) (= op t2-phi) (= op t2-const) (= op t2-fuel) (= op t2-cmp) (= op t2-un) (= op t2-brz) (= op t2-br)
        (= op t2-undef) (= op t2-sel)
        (and (= op t2-bin) (not= (t2-vf M v t2-f-a) BOP-QUOT)))))
(defn- t2-u-ps-block [M :vector-i64 b :i64 acc :i64] :i64   ; acc: the store (0 none yet, -1 refused)
  (loop [v (t2-bget M t2-a-bv0 b) a acc]
    (cond (or (< a 0) (>= v (t2-bget M t2-a-bv1 b))) a
          (and (= (t2-op-of M v) t2-vset) (not (t2-gone? M v))) (recur (inc v) (if (= a 0) v -1))
          (t2-u-ps-op-ok? M v) (recur (inc v) a)
          :else -1)))
(defn- t2-u-ps [M :vector-i64 l :i64 h :i64 b1 :i64] :i64
  (let [v (loop [b b1 a (t2-u-ps-block M h 0)] (if (or (= b h) (< b 0) (< a 0)) a (recur (t2-u-succ M b) (t2-u-ps-block M b a))))
        g (if (> v 0) (t2-g M (+ t2-a-srg v)) 0)
        x (if (> v 0) (t2-res M (t2-vf M v t2-f-c)) 0)]
    (if (and (> g 0) (= (t2-srgf M l (dec g) 1) 8) (<= (+ (t2-g M (+ t2-a-sro v)) 24) 504)
             (or (t2-isconst? M x)
                 (and (t2-regval? M x) (not (t2-spilled? M x)) (>= (t2-vf M x t2-f-reg) 0)
                      (not= (t2-bget M t2-a-bloop (t2-vf M x t2-f-blk)) (inc l)))))
      v 0)))
;; values [v, v1) of block b in a copy: everything but the terminator (a BR, or the header's BRZ)
(defn- t2-e-uvals [M :vector-i64 v :i64 v1 :i64] :vector-i64
  (if (or (>= v v1) (not (t2-ok? M))) M
    (let [op (t2-op-of M v)]
      (t2-e-uvals (if (or (= op t2-phi) (t2-gone? M v) (= op t2-br) (= op t2-brz)) M (t2-sp-store (t2-e-val M v) v)) (inc v) v1))))
;; one pass: the header's values, the chain, the back edge's copies
(defn- t2-e-upass [M :vector-i64 l :i64] :vector-i64
  (let [h (t2-lp M l t2-lf-h) id (inc l) last (t2-lp M l t2-lf-L1)
        M1 (-> M (t2-s t2-s-curu (t2-bget M t2-a-uin h)) (t2-e-uvals (t2-bget M t2-a-bv0 h) (t2-bget M t2-a-bv1 h)))]
    (loop [b (t2-u-in M1 h id) m M1]
      (if (or (= b h) (< b 0)) (t2-copies m last h)
        (recur (t2-u-succ m b) (-> m (t2-s t2-s-curu (t2-bget m t2-a-uin b)) (t2-e-uvals (t2-bget m t2-a-bv0 b) (t2-bget m t2-a-bv1 b))))))))
;; flags := (at least 4 passes left) ? ge : lt -- x16 := L - p (s > 0) or p - L (s < 0), compared with 3|s| -/+ the end's
;; offset from L
(defn- t2-e-ucheck [M :vector-i64 l :i64] :vector-i64
  (let [kind (t2-lp M l t2-lf-kind) s (t2-lp M l t2-lf-s) L (t2-lp M l t2-lf-L) pr (t2-vf M (t2-lp M l t2-lf-p) t2-f-reg)
        c (if (> s 0) (- (* 3 s) (t2-hi-d kind s)) (+ (* -3 s) (t2-lo-d kind s)))
        M1 (cond (t2-lconst? M l) (-> M (gn-mov-imm 16 (t2-kval M L))
                                      (gn-emit (if (> s 0) (enc-sub-r 16 16 pr) (enc-sub-r 16 pr 16))))
                 (> s 0) (gn-emit M (enc-sub-r 16 (t2-lreg M l) pr))
                 :else (gn-emit M (enc-sub-r 16 pr (t2-lreg M l))))]
    (gn-emit M1 (enc-cmp-i 16 c))))
;; after the precheck and the SR set-up (fastl set): groups while at least 4 passes are left, then the ordinary fast copy
(defn- t2-e-unroll [M :vector-i64 l :i64] :vector-i64
  (cond (= (t2-lp M l t2-lf-U) 0) M
        (= (t2-lp M l t2-lf-U) 2) (t2-e-udag M l)
        :else
    (let [K1 (t2-lp M l t2-lf-K1) h (t2-lp M l t2-lf-h)
          M1 (-> M (t2-e-ucheck l) (t2-bcond (enc-cond-lt) (t2-l-fast M h))
                 (t2-deflab (t2-l-unr M l)) (t2-s t2-s-nextl -1)
                 (cond-> (> K1 0) (gn-emit (enc-sub-i 8 8 (* 4 K1)))) (t2-s t2-s-pend (* 4 K1)))
          ob (= (t2-lp M l t2-lf-OB) 1)
          M2 (loop [j 1 m M1] (if (> j 4) (t2-s m t2-s-ucopy 0) (recur (inc j) (-> m (t2-s t2-s-ucopy (if ob j 0)) (t2-e-upass l)))))]
      (if (not= (t2-g M2 t2-s-pend) 0) (t2-fail M2 28)
        (-> M2 (cond-> ob (t2-e-srincs4 l 0)) (t2-e-ucheck l) (t2-bcond (enc-cond-ge) (t2-l-unr M2 l)))))))
(defn- t2-e-srincs4 [M :vector-i64 l :i64 j :i64] :vector-i64
  (if (>= j (t2-sr M l 0)) M
    (t2-e-srincs4 (t2-addk M (t2-srgf M l j 0) (t2-srgf M l j 0) (* 4 (t2-srgf M l j 1))) l (inc j))))
;; ---- unrolled groups of a branching body: the loop's blocks after h (index order, t2-lnext) are all of its blocks; none
;; leaves the loop (the header test is the only exit) and one latch goes back to h, as its only successor; no thread
;; block, no call, return or trap. Each copy of a pass charges its blocks like the ordinary fast copy (sub at a block's
;; start), its in-loop edges stay in the copy, and its back edge goes to the next copy (the fourth: the group's end).
(def t2-unroll-dagmaxv 64)
(defn- t2-u-dagvals-ok? [M :vector-i64 b :i64] :bool
  (let [t (t2-lastval M b)]
    (loop [v (t2-bget M t2-a-bv0 b)]
      (or (>= v (t2-bget M t2-a-bv1 b))
          (let [op (t2-op-of M v)]
            (and (or (t2-gone? M v) (= op t2-phi)
                     (and (not= op t2-call) (not= op t2-ret) (not= op t2-trap)
                          (or (and (not= op t2-br) (not= op t2-brz)) (= v t))))
                 (recur (inc v))))))))
;; the latch, or -1 when loop id's body does not qualify
(defn- t2-u-dag [M :vector-i64 h :i64 id :i64] :i64
  (let [nloop (loop [b 0 n 0] (if (>= b (t2-g M t2-s-nb)) n
                                ;; (a dead thread block, never emitted, is counted: such a loop is left alone)
                                (recur (inc b) (if (and (= (t2-bget M t2-a-bloop b) id) (= (t2-bget M t2-a-breach b) 1)) (inc n) n))))]
    (loop [b (t2-lnext M h id) n 1 latch -1 nv (t2-u-nvals M h)]
      (if (< b 0)
        (if (and (= n nloop) (>= latch 0) (<= nv t2-unroll-dagmaxv)) latch -1)
        (let [t (t2-lastval M b) tk (t2-bget M t2-a-bt b) fl (t2-bget M t2-a-bf b)
              br (and (> t 0) (= (t2-op-of M t) t2-br))
              ;; successors actually left for (a BR ignores its fallthrough slot)
              s1 (if br tk (if (and (> t 0) (= (t2-op-of M t) t2-brz)) tk -1))
              s2 (if br -1 fl)
              tolatch (or (= s1 h) (= s2 h))
              okb (and (not (t2-thread? M b)) (t2-u-dagvals-ok? M b)
                       (or (< s1 0) (= (t2-bget M t2-a-bloop s1) id)) (or (< s2 0) (= (t2-bget M t2-a-bloop s2) id))
                       (or (>= s1 0) (>= s2 0))
                       ;; the latch's only successor is h
                       (or (not tolatch) (and (or (< s1 0) (= s1 h)) (or (< s2 0) (= s2 h)) (< latch 0))))]
          (if (not okb) -1 (recur (t2-lnext M b id) (inc n) (if tolatch b latch) (+ nv (t2-u-nvals M b)))))))))
;; copy c (0..3) of a pass of a branching body
(defn- t2-e-udcopy [M :vector-i64 l :i64 c :i64] :vector-i64
  (let [h (t2-lp M l t2-lf-h) id (inc l) kh (t2-kof M h) b1 (t2-u-in M h id) n1 (t2-lnext M h id)
        M1 (-> M (t2-s t2-s-ucur (inc c)) (cond-> (= (t2-lp M l t2-lf-OB) 1) (t2-s t2-s-ucopy (inc c)))
               (t2-deflab (t2-l-ucopy M c h)) (t2-s t2-s-curu (t2-bget M t2-a-uin h)) (t2-s t2-s-pend kh) (t2-s t2-s-nextl -1)
               (cond-> (> kh 0) (gn-emit (enc-sub-i 8 8 kh)))
               (t2-e-uvals (t2-bget M t2-a-bv0 h) (t2-bget M t2-a-bv1 h))
               (cond-> (not= b1 n1) (t2-jmp FX-B26 (t2-l-ucopy M c b1) (enc-b 0))))]
    (loop [b n1 m M1]
      (if (or (< b 0) (not (t2-ok? m))) m
        (let [k (t2-kof m b) n (t2-lnext m b id)
              m0 (-> m (t2-deflab (t2-l-ucopy m c b)) (t2-s t2-s-curu (t2-bget m t2-a-uin b)) (t2-s t2-s-pend k)
                     (t2-s t2-s-nextl (cond (>= n 0) (t2-l-ucopy m c n) (< c 3) (t2-l-ucopy m (inc c) h) :else (t2-l-uend m l)))
                     (cond-> (> k 0) (gn-emit (enc-sub-i 8 8 k))))]
          (recur n (t2-e-body m0 b)))))))
(defn- t2-e-udag [M :vector-i64 l :i64] :vector-i64
  (let [h (t2-lp M l t2-lf-h)
        M1 (-> M (t2-e-ucheck l) (t2-bcond (enc-cond-lt) (t2-l-fast M h)) (t2-deflab (t2-l-unr M l))
               (t2-e-udcopy l 0) (t2-e-udcopy l 1) (t2-e-udcopy l 2) (t2-e-udcopy l 3)
               (t2-s t2-s-ucur 0) (t2-s t2-s-ucopy 0) (t2-deflab (t2-l-uend M l)))]
    (-> M1 (cond-> (= (t2-lp M l t2-lf-OB) 1) (t2-e-srincs4 l 0)) (t2-e-ucheck l) (t2-bcond (enc-cond-ge) (t2-l-unr M1 l)))))
;; ---- a vector cell kept in a register over a fast copy (scalar promotion / store-to-load forwarding) -------------------
;; A versioned loop that reads and writes the item c (a constant index whose every access in the loop runs unchecked:
;; proven by the precheck, or by a check before the loop / the slot's least length) of one vector slot keeps
;; it in a register R over its fast copy: R := v[c] once after the precheck; each read of v[c] takes R; each write of
;; v[c] still stores (memory stays exact on every pass) and sets R. No other store of the loop may write that item: the
;; loop's every other store goes to the same slot, at a constant index other than c or at an index the precheck checks
;; (its least and greatest value over the body range must leave c out, else the original loop runs). Not in a search
;; loop.
(def t2-lf-CS 14)          ; the cell's slot + 1 (0: none)
(def t2-lf-CI 15)          ; its index
(def t2-lf-CR 16)          ; the register holding it
(def t2-s-creserve 113)    ; register mask the hoist plan leaves free (the cell's register)
(def t2-s-ncg 114)         ; cell-guard labels used
(defn- t2-l-ucell [M :vector-i64 n :i64] :i64 (+ (t2-l-uhi M) n))
(def t2-cell-on 1)
;; a vector access v with a constant index (its value, -1 when not constant or negative)
(defn- t2-cidx [M :vector-i64 v :i64] :i64
  (let [i (t2-res M (t2-vf M v t2-f-b))] (if (and (t2-isconst? M i) (>= (t2-kval M i) 0)) (t2-kval M i) -1)))
;; an access of the cell that runs without its index check in the fast copy: proven by the precheck (16), or dominated
;; by an identical check / below the slot's least length (8) -- so v[c] is in range at the loop's entry too
(defn- t2-cell-free? [M :vector-i64 v :i64] :bool (not= (bit-and (t2-xf M v t2-x-flags) 24) 0))
(defn- t2-cell-acc? [M :vector-i64 v :i64] :bool
  (let [op (t2-op-of M v)] (and (or (= op t2-vat) (= op t2-vset)) (not (t2-gone? M v)))))
;; the values of loop id's blocks, folded: f 0 count of (slot s, index c) reads, 1 its writes, 2 refusals of a write
;; elsewhere (another slot, or an index neither constant nor checked by the precheck), 3 its accesses not proven
(defn- t2-cell-scan [M :vector-i64 id :i64 s :i64 c :i64 f :i64] :i64
  (loop [b 0 n 0]
    (if (>= b (t2-g M t2-s-nb)) n
      (recur (inc b)
        (if (or (not= (t2-bget M t2-a-bloop b) id) (not= (t2-bget M t2-a-breach b) 1)) n
          (loop [v (t2-bget M t2-a-bv0 b) n n]
            (if (>= v (t2-bget M t2-a-bv1 b)) n
              (recur (inc v)
                (if (not (t2-cell-acc? M v)) n
                  (let [op (t2-op-of M v) mine (and (= (t2-pk M v) s) (= (t2-cidx M v) c))
                        proven (= (bit-and (t2-xf M v t2-x-flags) 16) 16)]
                    (cond (= f 0) (if (and mine (= op t2-vat)) (inc n) n)
                          (= f 1) (if (and mine (= op t2-vset)) (inc n) n)
                          (= f 3) (if (and mine (not (t2-cell-free? M v))) (inc n) n)
                          ;; f 2: other writes
                          (or (not= op t2-vset) mine) n
                          (not= (t2-pk M v) s) (inc n)
                          (>= (t2-cidx M v) 0) n
                          proven n
                          :else (inc n))))))))))))
;; the first proven constant-index read of a slot whose item the loop also writes (as M[last]: slot * 2^32 + index + 1)
(defn- t2-cell-pick [M :vector-i64 id :i64] :i64
  (loop [b 0]
    (if (>= b (t2-g M t2-s-nb)) 0
      (let [r (if (or (not= (t2-bget M t2-a-bloop b) id) (not= (t2-bget M t2-a-breach b) 1)) 0
                (loop [v (t2-bget M t2-a-bv0 b)]
                  (cond (>= v (t2-bget M t2-a-bv1 b)) 0
                        (and (t2-cell-acc? M v) (= (t2-op-of M v) t2-vat) (>= (t2-cidx M v) 0) (>= (t2-pk M v) 0)
                             (t2-cell-free? M v)
                             (> (t2-cell-scan M id (t2-pk M v) (t2-cidx M v) 1) 0)
                             (= (t2-cell-scan M id (t2-pk M v) (t2-cidx M v) 2) 0)
                             (= (t2-cell-scan M id (t2-pk M v) (t2-cidx M v) 3) 0))
                        (+ (* (t2-pk M v) 4294967296) (t2-cidx M v) 1)
                        :else (recur (inc v)))))]
        (if (> r 0) r (recur (inc b)))))))
(defn- t2-cell-plan [M :vector-i64 l :i64] :vector-i64
  (let [id (inc l)
        k (if (or (= t2-cell-on 0) (= (t2-lp M l t2-lf-kind) 7)) 0 (t2-cell-pick M id))
        r (if (= k 0) -1 (t2-sr-freereg (t2-lbusy M id)))]
    (if (< r 0) (-> M (t2-lps l t2-lf-CS 0) (t2-s t2-s-creserve 0))
      (-> M (t2-lps l t2-lf-CS (inc (quot k 4294967296))) (t2-lps l t2-lf-CI (dec (bit-and k 4294967295))) (t2-lps l t2-lf-CR r)
          (t2-s t2-s-creserve (i64-shift-left 1 r))))))
;; in the precheck (after the range checks): every checked store k of the cell's slot leaves c out of [least, greatest]
(defn- t2-e-cellguard [M :vector-i64 l :i64 k :i64 slow :i64] :vector-i64
  (if (>= k (t2-lp M l t2-lf-a1)) M
    (let [v (t2-acc M k 0) s (dec (t2-lp M l t2-lf-CS)) c (t2-lp M l t2-lf-CI)]
      (t2-e-cellguard
        (if (or (not= (t2-op-of M v) t2-vset) (t2-gone? M v) (not= (t2-pk M v) s) (>= (t2-cidx M v) 0)) M
          (let [kind (t2-lp M l t2-lf-kind) st (t2-lp M l t2-lf-s) a (t2-acc M k 1) C (t2-acc M k 2) n (t2-g M t2-s-ncg)
                nx (t2-l-ucell M n)]
            (if (>= n 16) (t2-fail M 29)
              (-> M (t2-s t2-s-ncg (inc n))
                  ;; least index: c below it leaves the range
                  (t2-e-accval k l (if (>= a 0) (t2-lo-src kind st) (t2-hi-src kind st)) (if (>= a 0) (t2-lo-d kind st) (t2-hi-d kind st)) C)
                  (gn-mov-imm 17 c) (gn-emit (enc-cmp-r 17 16)) (t2-bcond (enc-cond-lt) nx)
                  ;; greatest index: c at or below it is inside
                  (t2-e-accval k l (if (>= a 0) (t2-hi-src kind st) (t2-lo-src kind st)) (if (>= a 0) (t2-hi-d kind st) (t2-lo-d kind st)) C)
                  (gn-mov-imm 17 c) (gn-emit (enc-cmp-r 17 16)) (t2-bcond (enc-cond-le) slow)
                  (t2-deflab nx)))))
        l (inc k) slow))))
;; after the precheck: R := v[c]
(defn- t2-e-cellinit [M :vector-i64 l :i64] :vector-i64
  (if (= (t2-lp M l t2-lf-CS) 0) M
    (let [B (t2-g M (+ t2-a-pd (* 4 (dec (t2-lp M l t2-lf-CS))) 1)) c (t2-lp M l t2-lf-CI) r (t2-lp M l t2-lf-CR)]
      (if (<= (* 8 c) 32760) (gn-emit M (enc-ldr r B (* 8 c)))
        (-> M (gn-mov-imm 16 c) (gn-emit (gn-e-ldrr r B 16 1)))))))
;; access v is the cell of the fast copy being emitted: its register, else -1
(defn- t2-cellreg [M :vector-i64 v :i64] :i64
  (let [fl (t2-g M t2-s-fastl)]
    (if (or (= fl 0) (= (t2-lp M (dec fl) t2-lf-CS) 0)) -1
      (if (and (= (t2-pk M v) (dec (t2-lp M (dec fl) t2-lf-CS))) (= (t2-cidx M v) (t2-lp M (dec fl) t2-lf-CI))
               (t2-cell-free? M v))
        (t2-lp M (dec fl) t2-lf-CR) -1))))
;; at versioned header h: precheck, then the fast copies (the original loop follows at h's own label)
;; (their words are counted apart: the size rule compares the original-loop body with the old code)
(def t2-s-vsize 53)
(defn- t2-e-version [M :vector-i64 l :i64] :vector-i64
  (let [h (t2-lp M l t2-lf-h) at (vector-at M MM-CODE-N)
        M1 (-> M (t2-cell-plan l) (t2-e-precheck l) (t2-hoist-plan (inc l)) (t2-e-hoists 0) (t2-e-cellinit l)
               (t2-sr-plan l) (t2-e-srinit l 0) (t2-s t2-s-creserve 0)
               (t2-unroll-plan l)
               (t2-s t2-s-fastl (inc l)) (t2-e-unroll l) (t2-e-fastb h (inc l)) (t2-s t2-s-fastl 0) (t2-s t2-s-nhoist 0))]
    (t2-s M1 t2-s-vsize (+ (t2-g M1 t2-s-vsize) (- (vector-at M1 MM-CODE-N) at)))))
;; ---- strength reduction in fast copies -----------------------------------------------------------------------------------
;; In the fast copy of loop l the proven accesses (vat/vset, a != 0) of one shape -- descriptor slot, coefficient a of p,
;; invariant terms -- address through one pointer register q = items base + 8 (a p + terms + cmin), set after the precheck
;; and advanced by 8 a s on every fast back edge; each access is `ldr|str [q, #8 (c - cmin)]`, adjacent ones paired
;; (ldp/stp). Pure values whose every use is such an index or another such value are not computed in the fast copy (xflag
;; 256). Applied only when it removes more instructions than the pointer increments add.
(def t2-sr-on 1)
(def t2-srw 32)
(def t2-s-srskip 76)   ; a value already emitted as the second half of a pair
(defn- t2-sr [M :vector-i64 l :i64 fld :i64] :i64 (t2-g M (+ t2-a-sr (* l t2-srw) fld)))
(defn- t2-srs [M :vector-i64 l :i64 fld :i64 x :i64] :vector-i64 (t2-s M (+ t2-a-sr (* l t2-srw) fld) x))
;; group j fields: 0 pointer register, 1 byte increment per iteration, 2 representative access, 3 least constant cmin
(defn- t2-srgf [M :vector-i64 l :i64 j :i64 f :i64] :i64 (t2-sr M l (+ 1 (* 4 j) f)))
(defn- t2-srgs [M :vector-i64 l :i64 j :i64 f :i64 x :i64] :vector-i64 (t2-srs M l (+ 1 (* 4 j) f) x))
(defn- t2-sr-same? [M :vector-i64 j :i64 k :i64] :bool
  (and (= (t2-dbase M (t2-acc M j 0)) (t2-dbase M (t2-acc M k 0))) (= (t2-acc M j 1) (t2-acc M k 1)) (= (t2-acc M j 3) (t2-acc M k 3))
       (loop [i 4] (or (>= i (+ 4 (* 2 (t2-acc M k 3)))) (and (= (t2-acc M j i) (t2-acc M k i)) (recur (inc i)))))))
(defn- t2-sr-freereg [busy :i64] :i64
  (loop [i 0] (if (>= i 14) -1 (let [c (if (< i 7) (+ 9 i) (- i 7))] (if (= (bit-and busy (i64-shift-left 1 c)) 0) c (recur (inc i)))))))
;; access k joins or opens a group (M[last] = busy mask)
(defn- t2-sr-group [M :vector-i64 l :i64 k :i64 busy :i64] :vector-i64
  (let [v (t2-acc M k 0) op (t2-op-of M v) n (t2-sr M l 0)]
    (if (or (and (not= op t2-vat) (not= op t2-vset)) (= (t2-acc M k 1) 0) (t2-gone? M v))
      (t2-s M t2-s-last busy)
      (let [j (loop [j 0] (cond (>= j n) -1 (t2-sr-same? M (t2-srgf M l j 2) k) j :else (recur (inc j))))]
        (if (>= j 0)
          (-> M (t2-srgs l j 3 (gn-min (t2-srgf M l j 3) (t2-acc M k 2))) (t2-s (+ t2-a-srg v) (inc j)) (t2-s t2-s-last busy))
          (let [r (t2-sr-freereg busy)]
            (if (or (< r 0) (>= n 6)) (t2-s M t2-s-last busy)
              (-> M (t2-srgs l n 0 r) (t2-srgs l n 1 (* 8 (t2-acc M k 1) (t2-lp M l t2-lf-s))) (t2-srgs l n 2 k)
                  (t2-srgs l n 3 (t2-acc M k 2)) (t2-srs l 0 (inc n)) (t2-s (+ t2-a-srg v) (inc n))
                  (t2-s t2-s-last (bit-or busy (i64-shift-left 1 r)))))))))))
(defn- t2-sr-groups [M :vector-i64 l :i64 k :i64 a1 :i64 busy :i64] :vector-i64
  (if (>= k a1) M (let [M1 (t2-sr-group M l k busy)] (t2-sr-groups M1 l (inc k) a1 (t2-last M1)))))
;; byte offsets from the group pointer (an access too far from cmin keeps its index)
(defn- t2-sr-offsets [M :vector-i64 l :i64 k :i64 a1 :i64] :vector-i64
  (if (>= k a1) M
    (let [v (t2-acc M k 0) g (t2-g M (+ t2-a-srg v))]
      (t2-sr-offsets (if (= g 0) M
                       (let [off (- (t2-acc M k 2) (t2-srgf M l (dec g) 3))]
                         (if (> off 4095) (t2-s M (+ t2-a-srg v) 0) (t2-s M (+ t2-a-sro v) (* 8 off)))))
                     l (inc k) a1))))
(defn- t2-sr-inbody? [M :vector-i64 l :i64 v :i64] :bool (= (t2-bget M t2-a-bloop (t2-vf M v t2-f-blk)) (inc l)))
(defn- t2-sr-pure? [M :vector-i64 v :i64] :bool
  (let [op (t2-op-of M v) b (t2-vf M v t2-f-a)]
    (or (= op t2-un)
        (and (= op t2-bin) (or (= b BOP-ADD) (= b BOP-SUB) (= b BOP-MUL) (= b BOP-AND) (= b BOP-OR) (= b BOP-XOR) (= b BOP-SHL)
                               (= b BOP-USHR) (= b BOP-SSHR))))))
(defn- t2-sr-bump [M :vector-i64 l :i64 x0 :i64] :vector-i64
  (let [x (t2-res M x0)]
    (if (and (> x 0) (not (t2-isconst? M x)) (t2-sr-inbody? M l x)) (t2-s M (+ t2-a-srd x) (inc (t2-g M (+ t2-a-srd x)))) M)))
;; every body value: f 0 zero its count, 1 seed from reduced accesses, 2 one marking pass (M[last] = changed),
;; 3 count saved instructions (M[last]), 4 undo
(defn- t2-sr-walk [M :vector-i64 l :i64 f :i64] :vector-i64
  (loop [b 0 m (t2-s M t2-s-last 0)]
    (if (>= b (t2-g m t2-s-nb)) m
      (recur (inc b)
        (if (not= (t2-bget m t2-a-bloop b) (inc l)) m
          (loop [v (dec (t2-bget m t2-a-bv1 b)) m m]
            (if (< v (t2-bget m t2-a-bv0 b)) m
              (recur (dec v)
                (cond (= f 0) (t2-s m (+ t2-a-srd v) 0)
                      (t2-gone? m v) m
                      (= f 1) (if (> (t2-g m (+ t2-a-srg v)) 0) (t2-sr-bump m l (t2-vf m v t2-f-b)) m)
                      (= f 2) (if (and (= (bit-and (t2-xf m v t2-x-flags) 256) 0) (t2-sr-pure? m v) (> (t2-xf m v t2-x-uses) 0)
                                       (= (t2-g m (+ t2-a-srd v)) (t2-xf m v t2-x-uses)))
                                (-> m (t2-xs v t2-x-flags (bit-or (t2-xf m v t2-x-flags) 256)) (t2-sr-bump l (t2-vf m v t2-f-b))
                                    (cond-> (= (t2-op-of m v) t2-bin) (t2-sr-bump l (t2-vf m v t2-f-c))) (t2-s t2-s-last 1))
                                m)
                      (= f 3) (if (and (= (bit-and (t2-xf m v t2-x-flags) 256) 256) (= (bit-and (t2-xf m v t2-x-flags) 32) 0))
                                (t2-s m t2-s-last (inc (t2-last m))) m)
                      :else (-> m (t2-xs v t2-x-flags (bit-and (t2-xf m v t2-x-flags) (bit-not 256))) (t2-s (+ t2-a-srg v) 0)))))))))))
(defn- t2-sr-plan [M :vector-i64 l :i64] :vector-i64
  (if (or (= t2-sr-on 0) (= (t2-lp M l t2-lf-a0) (t2-lp M l t2-lf-a1))) (t2-srs M l 0 0)
    (let [a0 (t2-lp M l t2-lf-a0) a1 (t2-lp M l t2-lf-a1)
          M1 (-> M (t2-srs l 0 0) (t2-sr-groups l a0 a1 (bit-or (t2-lbusy M (inc l)) (t2-g M t2-s-hbusy)))
                 (t2-sr-offsets l a0 a1) (t2-sr-walk l 0) (t2-sr-walk l 1))
          M2 (loop [i 0 m M1] (if (>= i 32) m (let [m1 (t2-sr-walk m l 2)] (if (= (t2-last m1) 1) (recur (inc i) m1) m1))))
          saved (t2-last (t2-sr-walk M2 l 3))]
      (if (> saved (t2-sr M2 l 0)) M2 (-> M2 (t2-sr-walk l 4) (t2-srs l 0 0))))))
;; after the precheck: each group pointer := items base + 8 (index of its representative at p, constant cmin)
(defn- t2-e-srinit [M :vector-i64 l :i64 j :i64] :vector-i64
  (if (>= j (t2-sr M l 0)) M
    (let [k (t2-srgf M l j 2) M1 (t2-e-accval M k l 0 0 (t2-srgf M l j 3))]
      (t2-e-srinit (gn-emit M1 (gn-e-addsl (t2-srgf M l j 0) (t2-dbase M1 (t2-acc M1 k 0)) 16 3)) l (inc j)))))
;; on a fast back edge (after the phi copies): advance every group pointer
(defn- t2-e-srincs [M :vector-i64 l :i64 j :i64] :vector-i64
  (if (>= j (t2-sr M l 0)) M
    (t2-e-srincs (t2-addk M (t2-srgf M l j 0) (t2-srgf M l j 0) (t2-srgf M l j 1)) l (inc j))))
;; edge to s inside the fast copy of the loop being emitted ends a fast iteration
(defn- t2-sr-edge? [M :vector-i64 s :i64] :bool
  (let [fl (t2-g M t2-s-fastl)]
    (and (> fl 0) (>= s 0) (= (t2-bget M t2-a-bloop s) fl) (= (t2-lp M (dec fl) t2-lf-h) s) (> (t2-sr M (dec fl) 0) 0))))
;; an edge stub emitted after the body: it ends a fast iteration when it jumps to s's fast label
(defn- t2-sr-stub-incs [M :vector-i64 s :i64 target :i64] :vector-i64
  (if (and (>= s 0) (t2-vhead? M s) (= target (t2-l-fast M s))) (t2-e-srincs M (dec (t2-bget M t2-a-bloop s)) 0) M))
;; the next value of the block that emits code after v (-1 when it is not a plain one); fused, dead and pending charges skip
(defn- t2-sr-next [M :vector-i64 v :i64 v1 :i64] :i64
  (loop [w (inc v)]
    (if (>= w v1) -1
      (let [op (t2-op-of M w)]
        (cond (or (= op t2-phi) (t2-gone? M w) (= op t2-const) (= op t2-undef) (= (bit-and (t2-xf M w t2-x-flags) 256) 256)
                  (and (= op t2-fuel) (> (t2-g M t2-s-pend) 0)))
              (recur (inc w))
              :else w)))))
;; reduced access v in the fast copy: ldr/str [q, #off], paired with the next value when it is the adjacent access of the
;; same group and the same kind
(defn- t2-e-sracc [M :vector-i64 v :i64] :vector-i64
  (let [l (dec (t2-g M t2-s-fastl)) g (t2-g M (+ t2-a-srg v)) q (t2-srgf M l (dec g) 0)
        ;; pass u of an unrolled group (t2-lf-OB): the group pointer still points at the group's first pass
        u (t2-g M t2-s-ucopy) uoff (if (> u 0) (* (dec u) (t2-srgf M l (dec g) 1)) 0)
        off (+ (t2-g M (+ t2-a-sro v)) uoff)
        op (t2-op-of M v) b (t2-vf M v t2-f-blk)
        w (t2-sr-next M v (t2-bget M t2-a-bv1 b))
        pw (and (> w 0) (= (t2-op-of M w) op) (= (t2-g M (+ t2-a-srg w)) g) (= (t2-vf M w t2-f-blk) b)
                ;; (a spilled result goes through x16 and is stored after its own access: no pair)
                (or (= op t2-vset) (and (not= (t2-dst M v) (t2-dst M w)) (not (t2-spilled? M v)) (not (t2-spilled? M w)))))
        wo (if pw (+ (t2-g M (+ t2-a-sro w)) uoff) -1)
        pair (and pw (= wo (+ off 8)) (<= off 496))
        ;; the next access at the item below: the pair in the other order
        rpair (and pw (not pair) (= wo (- off 8)) (>= wo 0) (<= wo 496))]
    (cond
      ;; the invariant store of a pass: nothing in passes 1 and 3, both items of passes 1-2 (3-4) at the second
      (and (> u 0) (= v (t2-lp M l t2-lf-PS)))
      (if (= (bit-and u 1) 1) M
        (let [M1 (t2-src0 M (t2-vf M v t2-f-c) 16) rx (t2-last M1)] (gn-emit M1 (enc-stp rx rx q (- off 8)))))
      (= op t2-vat)
      (cond pair (-> M (gn-emit (enc-ldp (t2-dst M v) (t2-dst M w) q off)) (t2-s t2-s-srskip w))
            rpair (-> M (gn-emit (enc-ldp (t2-dst M w) (t2-dst M v) q wo)) (t2-s t2-s-srskip w))
            :else (gn-emit M (enc-ldr (t2-dst M v) q off)))
      :else
      (let [M1 (t2-src0 M (t2-vf M v t2-f-c) 16) rx (t2-last M1)]
        (cond pair (let [M2 (t2-src0 M1 (t2-vf M w t2-f-c) 17) ry (t2-last M2)] (-> M2 (gn-emit (enc-stp rx ry q off)) (t2-s t2-s-srskip w)))
              rpair (let [M2 (t2-src0 M1 (t2-vf M w t2-f-c) 17) ry (t2-last M2)] (-> M2 (gn-emit (enc-stp ry rx q wo)) (t2-s t2-s-srskip w)))
              :else (gn-emit M1 (enc-str rx q off)))))))
;; search loops are off: a short scan entered often (huffbench decode-bits) pays the precheck more than the fast copy saves
(def t2-sloop-on 0)
;; ---- search loops (kind 7): the header's exit test is not a bound on p, but p steps by +1 and every every-iteration access
;; is p + c + terms (or invariant). The precheck computes R = the least over those accesses of len - 1 - c - terms (the
;; greatest p all of them allow), then checks [p, R] like a counted loop's range (fuel for R - p + 2 passes, both index
;; ends). The fast copy tests p <= R at the head of every pass; past R it continues in the original loop with the current
;; state, which then checks and traps (or not) exactly as before.
(defn- t2-try-sloop [M :vector-i64 h :i64] :vector-i64
  (let [nb (t2-g M t2-s-nb)
        M0 (-> M (t2-wzero t2-a-kd 0 t2-maxb) (t2-s t2-s-af 0) (t2-mark-latches h 0 (t2-bget M t2-a-bpn h)))
        any (loop [b 0] (and (< b nb) (or (= (t2-bget M0 t2-a-kd b) 1) (recur (inc b)))))]
    (if (or (not any) (not= (t2-g M0 t2-s-af) 0) (= (t2-g M0 t2-s-nlp) t2-maxlp)
            (and (= (t2-g M0 t2-s-pub) 1) (= (t2-g M0 t2-s-defer) 0) (= (t2-g M0 t2-s-fuel) 1)))
      M
      (let [M1 (t2-body M0 h 0)
            t (t2-lastval M1 h)
            tk (t2-bget M1 t2-a-bt h) fl (t2-bget M1 t2-a-bf h)]
        (if (or (not= (t2-g M1 t2-s-af) 0) (not (t2-body-ok? (t2-bset M1 t2-a-kd h 1) h 0))
                (<= t 0) (not= (t2-op-of M1 t) t2-brz) (< tk 0) (< fl 0))
          M
          (let [M2 (t2-bset M1 t2-a-kd h 1)
                tin (t2-in-body? M2 tk) fin (t2-in-body? M2 fl)
                ;; the induction: a header phi stepping by +1 on every back edge
                p (loop [q (t2-bget M2 t2-a-bphi h)]
                    (cond (= q 0) 0
                          (and (= (t2-vf M2 q t2-f-repl) 0) (> (t2-xf M2 q t2-x-uses) 0) (>= (t2-vf M2 q t2-f-reg) 0)
                               (= (t2-phi-step M2 h q 0 (t2-bget M2 t2-a-bpn h) 0) 1)) q
                          :else (recur (t2-vf M2 q t2-f-link))))]
            (if (or (= tin fin) (= p 0)) M
              (let [M3 (-> M2 (t2-wfill (+ t2-a-kd t2-maxb) 0 nb -1) (t2-bset (+ t2-a-kd t2-maxb) h (t2-kof M2 h)) (t2-kd-iter h 0))
                    K (t2-kd-max M3 0 0)
                    a0 (t2-g M3 t2-s-nacc)
                    M4 (t2-acc-blocks2 M3 h 0 p true)
                    a1 (t2-g M4 t2-s-nacc)
                    l (t2-g M4 t2-s-nlp)
                    ;; every recorded access is p + ... (a = 1) or invariant (a = 0), at least one moves with p
                    shape (loop [k a0 one false] (if (>= k a1) one
                                                   (let [a (t2-acc M4 k 1)] (cond (= a 1) (recur (inc k) true) (= a 0) (recur (inc k) one) :else false))))
                    r (t2-sr-freereg (t2-lbusy-raw M4 h))]
                (if (or (not= (t2-g M3 t2-s-af) 0) (>= K 65536) (= a0 a1) (not shape) (< r 0))
                  (t2-acc-unflag M4 a0 a1)
                  (-> M4 (t2-lps l t2-lf-h h) (t2-lps l t2-lf-p p) (t2-lps l t2-lf-s 1) (t2-lps l t2-lf-kind 7)
                      (t2-lps l t2-lf-L 0) (t2-lps l t2-lf-K K) (t2-lps l t2-lf-a0 a0) (t2-lps l t2-lf-a1 a1) (t2-lps l t2-lf-R r)
                      (t2-s t2-s-nlp (inc l)) (t2-mark-loop 0 (inc l))))))))))))
;; registers busy over the natural loop of h (body marks in kd) before it is recorded
(defn- t2-lbusy-raw [M :vector-i64 h :i64] :i64
  (let [nb (t2-g M t2-s-nb)
        p0 (loop [b 0 m 999999] (if (>= b nb) m (recur (inc b) (if (and (t2-in-body? M b) (= (t2-bget M t2-a-breach b) 1)) (gn-min m (t2-bget M t2-a-bpos0 b)) m))))
        p1 (loop [b 0 m -1] (if (>= b nb) m (recur (inc b) (if (and (t2-in-body? M b) (= (t2-bget M t2-a-breach b) 1)) (gn-max m (t2-bget M t2-a-bpos1 b)) m))))]
    (t2-busy-in M p0 p1)))
;; R := least over accesses k in [k, a1) with a = 1 of (len - 1 - c - terms)
(defn- t2-e-slimit [M :vector-i64 l :i64 k :i64 a1 :i64 first :bool] :vector-i64
  (if (>= k a1) M
    (if (not= (t2-acc M k 1) 1) (t2-e-slimit M l (inc k) a1 first)
      (let [v (t2-acc M k 0) R (t2-lp M l t2-lf-R) n (t2-acc M k 3)
            M1 (loop [j 0 m (gn-mov-imm M 16 (t2-acc M k 2))]
                 (if (>= j n) m
                   (let [c (t2-acc m k (+ 4 (* 2 j))) r (t2-vf m (t2-acc m k (+ 5 (* 2 j))) t2-f-reg)]
                     (recur (inc j) (cond (= c 1) (gn-emit m (enc-add-r 16 16 r))
                                          (= c -1) (gn-emit m (enc-sub-r 16 16 r))
                                          :else (-> m (gn-mov-imm 17 c) (gn-emit (enc-madd 16 r 17 16))))))))
            M2 (if (= (t2-op-of M1 v) t2-tab)
                 (-> M1 (gn-mov-imm 17 (dec (t2-vf M1 v t2-f-b))) (gn-emit (enc-sub-r 16 17 16)))
                 (-> M1 (gn-emit (enc-sub-r 16 (t2-dlen M1 v) 16)) (gn-emit (enc-sub-i 16 16 1))))
            M3 (if first (gn-mov M2 R 16)
                 (-> M2 (gn-emit (enc-cmp-r R 16)) (gn-emit (enc-csel R 16 R (enc-cond-of-cc CC-GT)))))]
        (t2-e-slimit M3 l (inc k) a1 false)))))
;; in the fast copy of search loop id, at block b = its header: past R, continue in the original loop
(defn- t2-e-slimit-test [M :vector-i64 b :i64 id :i64] :vector-i64
  (if (or (<= id 0) (not= (t2-lp M (dec id) t2-lf-kind) 7) (not= (t2-lp M (dec id) t2-lf-h) b)) M
    (-> M (gn-emit (enc-cmp-r (t2-vf M (t2-lp M (dec id) t2-lf-p) t2-f-reg) (t2-lp M (dec id) t2-lf-R)))
        (t2-bcond (enc-cond-of-cc CC-GT) (t2-lab M b)))))
;; ---- emission -----------------------------------------------------------------------------------------------------------
(defn- t2-lab [M :vector-i64 b :i64] :i64 (+ (t2-g M t2-s-lab0) b))
(defn- t2-deflab [M :vector-i64 l :i64] :vector-i64
  (-> M (gn-put (+ MM-LABEL-BASE l) (vector-at M MM-CODE-N)) (t2-s t2-s-labpos (vector-at M MM-CODE-N))))
;; ---- flag reuse: a compare word identical to the one two words back, with only a conditional branch between them and
;; no label since that compare (a block entered only by falling through from its single predecessor keeps the flags:
;; t2-flagkeep?), sets the flags they already hold -- the same registers, unchanged
(def t2-fcse-on 1)
(def t2-s-labpos 105)   ; position of the latest label that may be entered from elsewhere
(defn- t2-emit-cmp [M :vector-i64 w :i64] :vector-i64
  (let [n (vector-at M MM-CODE-N)]
    (if (and (= t2-fcse-on 1) (>= n 2) (< (t2-g M t2-s-labpos) (dec n))
             (= (vector-at M (+ MM-CODE-BASE (- n 2))) w)
             (= (bit-and (vector-at M (+ MM-CODE-BASE (dec n))) 0xFF000010) 0x54000000))
      M (gn-emit M w))))
(defn- t2-jmp [M :vector-i64 kind :i64 l :i64 w :i64] :vector-i64 (-> M (gn-fix kind l) (gn-emit w)))
(defn- t2-bcond [M :vector-i64 c :i64 l :i64] :vector-i64 (t2-jmp M FX-BC19 l (enc-bcond c 0)))
(defn- t2-isconst? [M :vector-i64 x :i64] :bool
  (let [op (t2-op-of M x)] (or (= op t2-const) (= op t2-undef))))
(defn- t2-kval [M :vector-i64 x :i64] :i64 (if (= (t2-op-of M x) t2-const) (t2-vf M x t2-f-a) 0))
;; ---- spilled values (part4c t2-sp-victim): reg field -2, location t2-a-spl (32 + frame slot, 32 + 4096 + stack param)
(defn- t2-spilled? [M :vector-i64 x :i64] :bool (and (> x 0) (= (t2-vf M x t2-f-reg) -2)))
;; location of value x: its register (< 32) or its memory location (>= 32)
(defn- t2-loc [M :vector-i64 x :i64] :i64 (if (t2-spilled? M x) (t2-g M (+ t2-a-spl x)) (t2-vf M x t2-f-reg)))
;; byte offset from sp of memory location loc: frame slots above x7's word ([sp, #0] with calls), stack parameters in
;; the caller's outgoing area above the saved registers (as t2-param-moves), both past what was pushed since (spadj)
(defn- t2-sp-off [M :vector-i64 loc :i64] :i64
  (let [calls (> (t2-g M t2-s-ncalls) 0) adj (t2-g M t2-s-spadj)]
    (if (>= loc (+ 32 4096))
      (+ adj (t2-g M t2-s-frame) (* 16 (t2-g M t2-s-ncs)) (if calls 16 0) (* 8 (- loc (+ 32 4096 7))))
      (+ adj (if calls 8 0) (* 8 (- loc 32))))))
(defn- t2-ldloc [M :vector-i64 r :i64 loc :i64] :vector-i64 (gn-emit M (enc-ldr r 31 (t2-sp-off M loc))))
(defn- t2-stloc [M :vector-i64 r :i64 loc :i64] :vector-i64 (gn-emit M (enc-str r 31 (t2-sp-off M loc))))
;; d := s over locations (memory to memory through x17)
(defn- t2-mvx [M :vector-i64 d :i64 s :i64] :vector-i64
  (cond (and (< d 32) (< s 32)) (gn-mov M d s)
        (< d 32) (t2-ldloc M d s)
        (< s 32) (t2-stloc M s d)
        (= d s) M
        :else (-> M (t2-ldloc 17 s) (t2-stloc 17 d))))
;; after value v's code: a spilled result (written to x16, t2-dst) goes to its location
(defn- t2-sp-store [M :vector-i64 v :i64] :vector-i64
  (let [op (t2-op-of M v)]
    (if (and (t2-spilled? M v) (> (t2-xf M v t2-x-uses) 0)
             (not (and (> (t2-g M t2-s-fastl) 0) (= (bit-and (t2-xf M v t2-x-flags) 256) 256)))
             (or (= op t2-bin) (= op t2-cmp) (= op t2-sel) (= op t2-dtab) (= op t2-un) (= op t2-vat) (= op t2-tab) (t2-cpx? op)))
      (t2-stloc M 16 (t2-loc M v))
      M)))
;; register holding operand x (resolved); constants are materialized into scratch s, spilled values loaded into it.
;; Register in M[last].
(defn- t2-src [M :vector-i64 x0 :i64 s :i64] :vector-i64
  (let [x (t2-res M x0)]
    (cond (t2-isconst? M x)
          (let [h (t2-hoisted M x)] (if (>= h 0) (t2-s M t2-s-last h) (t2-s (gn-mov-imm M s (t2-kval M x)) t2-s-last s)))
          (t2-spilled? M x) (-> M (t2-ldloc s (t2-loc M x)) (t2-s t2-s-last s))
          :else (t2-s M t2-s-last (t2-vf M x t2-f-reg)))))
;; a stored value: xzr for zero
(defn- t2-src0 [M :vector-i64 x0 :i64 s :i64] :vector-i64
  (let [x (t2-res M x0)] (if (and (t2-isconst? M x) (= (t2-kval M x) 0)) (t2-s M t2-s-last 31) (t2-src M x s))))
(defn- t2-dst [M :vector-i64 v :i64] :i64 (let [r (t2-vf M v t2-f-reg)] (if (>= r 0) r 16)))
(defn- t2-dead? [M :vector-i64 v :i64] :bool (= (t2-xf M v t2-x-uses) 0))
;; descriptor registers of the handle operand of v (its class's slot, t2-pk)
(defn- t2-dbase [M :vector-i64 v :i64] :i64 (t2-g M (+ t2-a-pd (* 4 (t2-pk M v)) 1)))
(defn- t2-dlen [M :vector-i64 v :i64] :i64 (t2-g M (+ t2-a-pd (* 4 (t2-pk M v)) 2)))
(defn- t2-tabreg [M :vector-i64 lit :i64 k :i64] :i64
  (cond (>= k (t2-g M t2-s-ntab)) 16
        (= (t2-g M (+ t2-a-tb (* 2 k))) lit) (t2-g M (+ t2-a-tb (* 2 k) 1))
        :else (t2-tabreg M lit (inc k))))
(defn- t2-small-index? [k :i64 limit :i64] :bool (and (>= k 0) (< k 4096) (< k limit) (<= (* 8 k) 32760)))
;; an already-checked index: M[last] = index register, or -1 for a small constant
(defn- t2-nocheck [M :vector-i64 i0 :i64] :vector-i64
  (let [i (t2-res M i0)]
    (if (and (t2-isconst? M i) (t2-small-index? (t2-kval M i) 4096)) (t2-s M t2-s-last -1)
      (let [M1 (t2-src M i 16)] M1))))
;; index check against register L (unsigned), branching to label l on failure; M[last] = index register (or -1 for const)
(defn- t2-icheck [M :vector-i64 i0 :i64 L :i64 l :i64] :vector-i64
  (let [i (t2-res M i0)]
    (if (and (t2-isconst? M i) (t2-small-index? (t2-kval M i) 4096))
      (-> M (gn-emit (enc-cmp-i L (t2-kval M i))) (t2-bcond 9 l) (t2-s t2-s-last -1))   ; b.ls: len <= k
      (let [M1 (t2-src M i 16) ri (t2-last M1)]
        (-> M1 (gn-emit (enc-cmp-r ri L)) (t2-bcond 2 l) (t2-s t2-s-last ri))))))       ; b.hs
;; index i = x & k with a constant 0 <= k < n: always in [0, n), no range check
(defn- t2-masked? [M :vector-i64 i :i64 n :i64] :bool
  (and (= (t2-op-of M i) t2-bin) (= (t2-vf M i t2-f-a) BOP-AND)
       (let [x (t2-res M (t2-vf M i t2-f-b)) y (t2-res M (t2-vf M i t2-f-c))
             k (cond (t2-isconst? M y) (t2-kval M y) (t2-isconst? M x) (t2-kval M x) :else -1)]
         (and (>= k 0) (< k n)))))
;; commutative operations take a constant first operand second (immediate forms)
(defn- t2-comm? [bop :i64] :bool (or (= bop BOP-ADD) (= bop BOP-MUL) (= bop BOP-AND) (= bop BOP-OR) (= bop BOP-XOR)))
;; logical immediate (N=1, 64-bit) word for and/orr/eor d, n, #k when k is one contiguous run of ones, else -1
(defn- t2-limm [bop :i64 d :i64 n :i64 k :i64] :i64
  (let [len (gn-run-len k) base (gn-logic-base bop)]
    (if (or (= len 0) (< base 0)) -1
      (let [tz (gn-tz k 0)] (gn-e-bf base d n (bit-and (- 64 tz) 63) (dec len))))))
;; ADD/SUB with a fused product operand: madd/msub, or add/sub with a shifted register (spilled operands load into x16
;; then x17; all three of a madd spilled: x16 := a * b first)
(defn- t2-e-msub [M :vector-i64 v :i64 d :i64 r :i64 k :i64 x :i64] :vector-i64
  (let [rk (t2-kval M k) sr (t2-spilled? M r) sx (t2-spilled? M x)
        reuse (and (= (bit-and (t2-xf M v t2-x-flags) 1024) 1024) (= (t2-g M t2-s-fastl) 0) (not sr) (not sx))
        hk (t2-hoisted M k) hoisted (and (> (t2-g M t2-s-fastl) 0) (>= hk 0) (not sr) (not sx))
        rr (if sr 16 (t2-vf M r t2-f-reg)) rx (if sx 17 (t2-vf M x t2-f-reg))]
    (cond reuse (gn-emit M (+ (enc-madd d rr 17 rx) 0x8000))
          hoisted (gn-emit M (+ (enc-madd d rr hk rx) 0x8000))
          (and sr sx) (-> M (t2-ldloc 16 (t2-loc M r)) (gn-mov-imm 17 rk) (gn-emit (enc-mul 16 16 17))
                         (t2-ldloc 17 (t2-loc M x)) (gn-emit (enc-sub-r d 17 16)))
          sr (-> M (t2-ldloc 16 (t2-loc M r)) (gn-mov-imm 17 rk) (gn-emit (+ (enc-madd d 16 17 rx) 0x8000)))
          sx (-> M (gn-mov-imm 16 rk) (t2-ldloc 17 (t2-loc M x)) (gn-emit (+ (enc-madd d rr 16 17) 0x8000)))
          :else (-> M (gn-mov-imm 16 rk) (gn-emit (+ (enc-madd d rr 16 rx) 0x8000))))))
(defn- t2-e-fused [M :vector-i64 v :i64 d :i64] :vector-i64
  (let [m (t2-fusedop M v) x (t2-res M (if (= m (t2-res M (t2-vf M v t2-f-c))) (t2-vf M v t2-f-b) (t2-vf M v t2-f-c)))
        sub (= (t2-vf M v t2-f-a) BOP-SUB)
        bop (t2-vf M m t2-f-a) a (t2-res M (t2-vf M m t2-f-b)) b (t2-res M (t2-vf M m t2-f-c))
        sx (t2-spilled? M x)]
    (cond (and (= bop BOP-MUL) sub (or (t2-isconst? M a) (t2-isconst? M b))
               (> (t2-kval M (if (t2-isconst? M a) a b)) 1)
               (= (gn-pow2 (t2-kval M (if (t2-isconst? M a) a b))) 0))
          (t2-e-msub M v d (if (t2-isconst? M a) b a) (if (t2-isconst? M a) a b) x)
      (and (= bop BOP-MUL) (not (t2-isconst? M a)) (not (t2-isconst? M b)))
      (let [sa (t2-spilled? M a) sb (t2-spilled? M b)]
        (if (and sa sb sx)
          (-> M (t2-ldloc 16 (t2-loc M a)) (t2-ldloc 17 (t2-loc M b)) (gn-emit (enc-mul 16 16 17)) (t2-ldloc 17 (t2-loc M x))
              (gn-emit (if sub (enc-sub-r d 17 16) (enc-add-r d 17 16))))
          (let [Ma (if sa (t2-ldloc M 16 (t2-loc M a)) M) ra (if sa 16 (t2-vf M a t2-f-reg))
                bs (if sa 17 16)
                Mb (if sb (t2-ldloc Ma bs (t2-loc M b)) Ma) rb (if sb bs (t2-vf M b t2-f-reg))
                xs (if (or sa sb) 17 16)
                Mc (if sx (t2-ldloc Mb xs (t2-loc M x)) Mb) rx (if sx xs (t2-vf M x t2-f-reg))
                w (enc-madd d ra rb rx)]
            (gn-emit Mc (if sub (+ w 0x8000) w)))))
      :else
      (let [r (if (t2-isconst? M a) b a)
            k (if (t2-isconst? M a) (t2-kval M a) (t2-kval M b))
            sh (if (= bop BOP-SHL) (bit-and k 63) (gn-pow2 k))
            sr (t2-spilled? M r)
            Mr (if sr (t2-ldloc M 16 (t2-loc M r)) M) rr (if sr 16 (t2-vf M r t2-f-reg))
            Mx (if sx (t2-ldloc Mr 17 (t2-loc M x)) Mr) rx (if sx 17 (t2-vf M x t2-f-reg))
            w (gn-e-addsl d rx rr sh)]
        (gn-emit Mx (if sub (+ w 0x40000000) w))))))
(defn- t2-e-bin [M :vector-i64 v :i64] :vector-i64
  (let [bop (t2-vf M v t2-f-a) x0 (t2-res M (t2-vf M v t2-f-b)) y0 (t2-res M (t2-vf M v t2-f-c)) d (t2-dst M v)
        sw (and (t2-comm? bop) (t2-isconst? M x0) (not (t2-isconst? M y0)))
        x (if sw y0 x0) y (if sw x0 y0)
        ky (t2-kval M y) yc (t2-isconst? M y)]
    (cond (= (bit-and (t2-xf M v t2-x-flags) 32) 32) M   ; a product fused into its user
          (and (t2-dead? M v) (or (not= bop BOP-QUOT) (and yc (not= ky 0) (not= ky -1)))) M
          (= (bit-and (t2-xf M v t2-x-flags) 64) 64) (t2-e-fused M v d)
          ;; (the register operand x through t2-src into x16 when spilled; gn-bin-imm's own scratch is x17)
          (and yc (or (= bop BOP-ADD) (= bop BOP-SUB)) (>= ky 0) (< ky 4096) (not (t2-isconst? M x)))
          (let [M1 (t2-src M x 16) rx (t2-last M1)] (gn-emit M1 (if (= bop BOP-ADD) (enc-add-i d rx ky) (enc-sub-i d rx ky))))
          (and yc (or (= bop BOP-ADD) (= bop BOP-SUB)) (< ky 0) (> ky -4096) (not (t2-isconst? M x)))
          (let [M1 (t2-src M x 16) rx (t2-last M1)] (gn-emit M1 (if (= bop BOP-ADD) (enc-sub-i d rx (- 0 ky)) (enc-add-i d rx (- 0 ky)))))
          (and yc (or (= bop BOP-AND) (= bop BOP-OR) (= bop BOP-XOR)) (not (t2-isconst? M x))
               (>= (t2-limm bop d 0 ky) 0))
          (let [M1 (t2-src M x 16) rx (t2-last M1)] (gn-emit M1 (t2-limm bop d rx ky)))
          (and yc (or (= bop BOP-SHL) (= bop BOP-USHR) (= bop BOP-SSHR)) (not (t2-isconst? M x)))
          (let [M1 (t2-src M x 16) rx (t2-last M1) k (bit-and ky 63)]
            (gn-emit M1 (cond (= bop BOP-SHL) (gn-e-lsl d rx k) (= bop BOP-USHR) (gn-e-lsr d rx k) :else (gn-e-asr d rx k))))
          ;; positive constant division consumes the reciprocal hoisted before the loop
          (and yc (= bop BOP-QUOT) (not (t2-isconst? M x)) (> ky 1) (= (gn-pow2 ky) 0)
               (>= (t2-hoisted M (- y)) 0))
          (let [M1 (t2-src M x 16)]
            (gn-sdiv-regmagic M1 d (t2-last M1) (t2-hoisted M (- y)) (gn-floor-log2 ky 0)))
          ;; negative constant division keeps the signed hardware instruction
          (and yc (= bop BOP-QUOT) (not (t2-isconst? M x)) (< ky 0) (= (gn-pow2 ky) 0)
               (not= ky -1) (>= (t2-hoisted M y) 0))
          (let [M1 (t2-src M x 16)] (gn-emit M1 (enc-sdiv d (t2-last M1) (t2-hoisted M y))))
          ;; multiplication by 2^p / 2^p+1 and division by a constant (never 0 or -1): the existing immediate forms
          (and yc (not (t2-isconst? M x))
               (or (and (= bop BOP-MUL) (or (> (gn-pow2 ky) 0) (and (> ky 2) (> (gn-pow2 (dec ky)) 0))))
                   (and (= bop BOP-QUOT) (not= ky 0) (not= ky -1))))
          (let [M1 (t2-src M x 16)] (gn-bin-imm M1 bop d (t2-last M1) ky))
          :else
          (let [M1 (t2-src M x 16) rx (t2-last M1) M2 (t2-src M1 y 17) ry (t2-last M2)]
            (if (= bop BOP-QUOT) (t2-quot M2 d rx ry) (gn-emit M2 (gn-bin-word bop d rx ry)))))))
;; compare x with y (setting flags)
;; condition of a compare whose operands were swapped (x cc y == y cc' x)
(defn- t2-swapcc [c :i64] :i64 (cond (= c 11) 12 (= c 12) 11 (= c 10) 13 (= c 13) 10 :else c))
(defn- t2-cmp-swapped? [M :vector-i64 v :i64] :bool
  (and (t2-isconst? M (t2-res M (t2-vf M v t2-f-b))) (not (t2-isconst? M (t2-res M (t2-vf M v t2-f-c))))))
(defn- t2-cmp-cond [M :vector-i64 v :i64] :i64
  (let [cc (t2-vf M v t2-f-a) c (if (= cc t2-cc-ne) 1 (enc-cond-of-cc cc))] (if (t2-cmp-swapped? M v) (t2-swapcc c) c)))
(defn- t2-e-cmpflags [M :vector-i64 v :i64] :vector-i64
  (let [sw (t2-cmp-swapped? M v)
        x (t2-res M (if sw (t2-vf M v t2-f-c) (t2-vf M v t2-f-b))) y (t2-res M (if sw (t2-vf M v t2-f-b) (t2-vf M v t2-f-c))) ky (t2-kval M y)]
    (cond (and (t2-isconst? M y) (>= ky 0) (< ky 4096) (not (t2-isconst? M x)))
      (let [M1 (t2-src M x 16)] (t2-emit-cmp M1 (enc-cmp-i (t2-last M1) ky)))
      (and (t2-isconst? M y) (< ky 0) (> ky -4096) (not (t2-isconst? M x)))
      (let [M1 (t2-src M x 16)] (t2-emit-cmp M1 (enc-cmn-i (t2-last M1) (- 0 ky))))
      :else
      (let [M1 (t2-src M x 16) rx (t2-last M1) M2 (t2-src M1 y 17) ry (t2-last M2)]
        (t2-emit-cmp M2 (enc-cmp-r rx ry))))))
(defn- t2-e-val [M :vector-i64 v :i64] :vector-i64
  (let [op (t2-op-of M v) d (t2-dst M v)]
    (cond
      ;; fast copy: strength-reduced accesses and the values only their indices needed
      (and (> (t2-g M t2-s-fastl) 0) (= (bit-and (t2-xf M v t2-x-flags) 256) 256)) M
      (and (> (t2-g M t2-s-fastl) 0) (= (t2-g M t2-s-srskip) v)) (t2-s M t2-s-srskip 0)
      (and (> (t2-g M t2-s-fastl) 0) (or (= op t2-vat) (= op t2-vset)) (> (t2-g M (+ t2-a-srg v)) 0)) (t2-e-sracc M v)
      (= op t2-bin) (t2-e-bin M v)
      (= op t2-cmp) (if (or (t2-dead? M v) (not= (bit-and (t2-xf M v t2-x-flags) 133) 0)) M
                      (-> M (t2-e-cmpflags v) (gn-emit (enc-cset d (t2-cmp-cond M v)))))
      (= op t2-sel) (if (t2-dead? M v) M (t2-e-sel M v))
      ;; an inlined callee's lookup replaces a call (about 2 words) for the size rule, outside fast and cold copies
      (= op t2-dtab) (if (t2-dead? M v) M
                       (let [at (vector-at M MM-CODE-N) M1 (t2-e-dtab M v)]
                         (if (and (= (t2-g M t2-s-fastl) 0) (= (t2-g M t2-s-cold) 0) (= (t2-dt-inl (t2-vf M v t2-f-b)) 1))
                           (t2-s M1 t2-s-vsize (+ (t2-g M1 t2-s-vsize) (- (vector-at M1 MM-CODE-N) at 2))) M1)))
      (= op t2-un) (if (t2-dead? M v) M
                     (let [M1 (t2-src M (t2-vf M v t2-f-b) 16) rx (t2-last M1)]
                       (gn-emit M1 (cond (= (t2-vf M v t2-f-a) UOP-NOT) (enc-eor-1 d rx)
                                         ;; sign extension of the low k bits (part3b t2-ra-sel): sbfx d, rx, #0, #k
                                         (>= (t2-vf M v t2-f-a) 1000) (gn-e-bf 0x93400000 d rx 0 (- (t2-vf M v t2-f-a) 1001))
                                         :else (enc-mvn d rx)))))
      ;; the fast copy's cell: a read takes its register
      (and (= op t2-vat) (>= (t2-cellreg M v) 0)) (gn-mov M d (t2-cellreg M v))
      (= op t2-vat)
      (let [B (t2-dbase M v) i (t2-res M (t2-vf M v t2-f-b))
            M1 (if (t2-unchecked? M v) (t2-nocheck M i)
                 (let [M0 (t2-trapl M 0)] (t2-icheck M0 i (t2-dlen M v) (t2-last M0)))) ri (t2-last M1)]
        (gn-emit M1 (if (< ri 0) (enc-ldr d B (* 8 (t2-kval M i))) (gn-e-ldrr d B ri 1))))
      (= op t2-vset)
      (let [B (t2-dbase M v) i (t2-res M (t2-vf M v t2-f-b))
            M1 (if (t2-unchecked? M v) (t2-nocheck M i)
                 (let [M0 (t2-trapl M 0)] (t2-icheck M0 i (t2-dlen M v) (t2-last M0)))) ri (t2-last M1)
            M2 (t2-src0 M1 (t2-vf M v t2-f-c) 17) rx (t2-last M2) cr (t2-cellreg M v)]
        ;; (a write of the fast copy's cell also sets its register)
        (cond-> (gn-emit M2 (if (< ri 0) (enc-str rx B (* 8 (t2-kval M i))) (gn-e-strr3 rx B ri))) (>= cr 0) (gn-mov cr rx)))
      (= op t2-tab)
      (let [T (t2-tabreg M (t2-vf M v t2-f-a) 0) n (t2-vf M v t2-f-b) i (t2-res M (t2-vf M v t2-f-c))]
        (cond (and (t2-isconst? M i) (t2-small-index? (t2-kval M i) n))
          (gn-emit M (enc-ldr d T (* 8 (t2-kval M i))))
          (or (t2-unchecked? M v) (t2-masked? M i n)) (let [M1 (t2-src M i 16)] (gn-emit M1 (gn-e-ldrr d T (t2-last M1) 1)))
          :else
          (let [M1 (t2-src M i 16) ri (t2-last M1)
                M2 (if (< n 4096) (gn-emit M1 (enc-cmp-i ri n)) (-> M1 (gn-mov-imm 17 n) (gn-emit (enc-cmp-r ri 17))))
                M3 (t2-trapl M2 1)]
            (-> M3 (t2-bcond 2 (t2-last M3)) (gn-emit (gn-e-ldrr d T ri 1))))))
      ;; string-length: the handle check at its own position (its value is the slot's SLEN register)
      (= op t2-slen)
      (let [M0 (t2-trapl M 0)] (t2-jmp M0 FX-CB19 (t2-last M0) (enc-cbz (t2-sd M (t2-hparam M v) 1) 0)))
      (t2-cpx? op) (t2-e-cpa M v)
      ;; a charge: batched (pending in a fast block) or checked; published per charge only without deferral
      (= op t2-fuel)
      (let [a (t2-vf M v t2-f-a) pend (t2-g M t2-s-pend) M0 (t2-s M t2-s-curu (t2-u1 M v (t2-g M t2-s-curu)))]
        (cond (> pend 0) (t2-s M0 t2-s-pend (dec pend))
              ;; a fuel region member: its head's check covers this charge
              (= (t2-g M t2-s-rfast) 1)
              (-> M0 (gn-emit (enc-sub-i 8 8 1)) (cond-> (and (= a 1) (= (t2-g M t2-s-defer) 0)) (gn-emit (enc-str 8 7 CTX-FUEL))))
              :else
              (-> M0 (gn-emit (enc-subs-i 8 8 1)) (t2-bcond 3 (+ (t2-lab M (t2-g M t2-s-nb)) 2))
                  (cond-> (and (= a 1) (= (t2-g M t2-s-defer) 0)) (gn-emit (enc-str 8 7 CTX-FUEL))))))
      (= op t2-pub) (-> M (t2-s t2-s-curu 0) (cond-> (= (t2-g M t2-s-defer) 0) (gn-emit (enc-str 8 7 CTX-FUEL))))
      (= op t2-trap)
      (let [c (+ (t2-g M t2-s-curu) (t2-g M t2-s-pend))]
        (-> M (cond-> (= (t2-g M t2-s-defer) 1)
                (-> (cond-> (> c 0) (gn-emit (enc-add-i 8 8 c))) (gn-emit (enc-str 8 7 CTX-FUEL))))
            (gn-emit (enc-brk (t2-vf M v t2-f-a)))))
      :else M)))
;; ---- string-code-point-at -------------------------------------------------------------------------------------------------
;; the old inline fast path on the slot's registers: index <u FLEN (FLEN = 0 unless the bytes are code-relative), the byte,
;; ASCII; any failure goes to a cold stub that calls the host helper exactly as the old slow path did (x0 = context,
;; x1 = handle, x2 = index), after publishing the counter (deferred mode: x8 + pending, as a trap stub) and saving every
;; caller-saved register T2 uses (and x7, x8, x30); the helper's answer or trap is then the old one.
(def t2-s-nsl t2-a-sx)          ; string stub labels used
(def t2-s-nss (+ t2-a-sx 1))    ; string stub entries: 6 words (kind, label 1, label 2, x, y, z)
(def t2-maxss 40)
(defn- t2-l-sx [M :vector-i64 n :i64] :i64 (+ (t2-lab M (* 9 (t2-g M t2-s-nb))) 163 n))
;; a new string stub entry with two fresh labels; M[last] = its first label (the second is the next one)
(defn- t2-ss-new [M :vector-i64 kind :i64 x :i64 y :i64 z :i64] :vector-i64
  (let [n (t2-g M t2-s-nss) l (t2-l-sx M (t2-g M t2-s-nsl)) a (+ t2-a-ss (* 6 n))]
    (if (>= n t2-maxss) (-> M (t2-fail 32) (t2-s t2-s-last (t2-l-sx M 0)))
      (-> M (t2-s a kind) (t2-s (+ a 1) l) (t2-s (+ a 2) (inc l)) (t2-s (+ a 3) x) (t2-s (+ a 4) y) (t2-s (+ a 5) z)
          (t2-s t2-s-nss (inc n)) (t2-s t2-s-nsl (+ (t2-g M t2-s-nsl) 2)) (t2-s t2-s-last l)))))
;; ldrb wt, [xn, #off] (0 <= off < 4096) ; ccmp xn, #imm5, #nzcv, cond
(defn- t2-ldrbi [t :i64 n :i64 off :i64] :i64 (+ 0x39400000 (i64-shift-left off 10) (i64-shift-left n 5) t))
(defn- t2-ccmpi [n :i64 imm :i64 nzcv :i64 c :i64] :i64
  (+ 0xFA400800 (i64-shift-left imm 16) (i64-shift-left c 12) (i64-shift-left n 5) nzcv))
(defn- t2-e-cpa [M :vector-i64 v :i64] :vector-i64
  (let [k (t2-hparam M v) FL (t2-sd M k 3) FB (t2-sd M k 4)
        i (t2-res M (t2-vf M v t2-f-c)) d (t2-dst M v)
        c (if (= (t2-g M t2-s-defer) 1) (+ (t2-g M t2-s-curu) (t2-g M t2-s-pend)) -1)
        cpz (= (t2-op-of M v) t2-cpz)
        Mt (if cpz (t2-trapl M 0) M)                 ; the idiom's string-length trap at this point
        M0 (cond-> (t2-ss-new Mt (if cpz 3 2) v c (if cpz (t2-last Mt) 0)) (>= c 4096) (t2-fail 32))
        Ls (t2-last M0)
        kv (t2-kval M i)
        M1 (if (and (t2-isconst? M i) (>= kv 0) (< kv 4096))
             (-> M0 (gn-emit (enc-cmp-i FL kv)) (t2-bcond 9 Ls) (gn-emit (t2-ldrbi d FB kv)))       ; b.ls: FLEN <= k
             (let [Ma (t2-src M0 i 17) ri (t2-last Ma)]
               (-> Ma (gn-emit (enc-cmp-r ri FL)) (t2-bcond 2 Ls) (gn-emit (gn-e-ldrb d FB ri)))))]  ; b.hs
    (-> M1 (gn-emit (enc-cmp-i d 128)) (t2-bcond 2 Ls) (t2-deflab (inc Ls)))))
;; ---- select and bounded table ------------------------------------------------------------------------------------------
;; csinv xd, xn, xm, c (xd := c ? xn : ~xm)
(defn- t2-e-csinv [d :i64 n :i64 m :i64 c :i64] :i64
  (+ 0xda800000 (i64-shift-left (bit-and m 31) 16) (i64-shift-left c 12) (i64-shift-left (bit-and n 31) 5) (bit-and d 31)))
;; v = sel(c, x, y): the condition in the flags (a fused compare, else c != 0), then one csel/csinc/csinv/cset; an arm
;; equal to c is 0 on the zero side and 1 (a compare) or c on the other; constants 0, 1, -1 need no register, others are
;; put in x16/x17 after the flags are set
(defn- t2-e-sel [M :vector-i64 v :i64] :vector-i64
  (let [d (t2-dst M v) c (t2-res M (t2-vf M v t2-f-a)) x (t2-res M (t2-vf M v t2-f-b)) y (t2-res M (t2-vf M v t2-f-c))
        fused (= (bit-and (t2-xf M c t2-x-flags) 128) 128)
        boolc (= (t2-op-of M c) t2-cmp)
        M1 (if fused (t2-e-cmpflags M c) (let [Ma (t2-src M c 16)] (gn-emit Ma (enc-cmp-i (t2-last Ma) 0))))
        cc (if fused (t2-cmp-cond M c) 1)
        nc (bit-xor cc 1)
        xc (or (t2-isconst? M x) (and (= x c) boolc))
        kx (if (t2-isconst? M x) (t2-kval M x) 1)
        yc (or (t2-isconst? M y) (= y c))
        ky (if (t2-isconst? M y) (t2-kval M y) 0)
        ;; spilled arms load after the flags are set (x16, x17: free again once the compare is made)
        sx (and (not xc) (t2-spilled? M x)) sy (and (not yc) (t2-spilled? M y))
        Mx (if sx (t2-ldloc M1 16 (t2-loc M x)) M1)
        My (if sy (t2-ldloc Mx 17 (t2-loc M y)) Mx)
        rx (cond xc 31 sx 16 :else (t2-vf M x t2-f-reg))
        ry (cond yc 31 sy 17 :else (t2-vf M y t2-f-reg))]
    (cond
      (and xc yc)
      (cond (= kx ky) (gn-mov-imm My d kx)
            (and (= kx 1) (= ky 0)) (gn-emit My (enc-cset d cc))
            (and (= kx 0) (= ky 1)) (gn-emit My (enc-cset d nc))
            (and (= kx -1) (= ky 0)) (gn-emit My (t2-e-csinv d 31 31 nc))
            (and (= kx 0) (= ky -1)) (gn-emit My (t2-e-csinv d 31 31 cc))
            (= ky 0) (-> My (gn-mov-imm 16 kx) (gn-emit (enc-csel d 16 31 cc)))
            (= kx 0) (-> My (gn-mov-imm 16 ky) (gn-emit (enc-csel d 31 16 cc)))
            (= kx (inc ky)) (-> My (gn-mov-imm 16 ky) (gn-emit (enc-csinc d 16 16 nc)))
            (= ky (inc kx)) (-> My (gn-mov-imm 16 kx) (gn-emit (enc-csinc d 16 16 cc)))
            :else (-> My (gn-mov-imm 16 kx) (gn-mov-imm 17 ky) (gn-emit (enc-csel d 16 17 cc))))
      xc
      (cond (= kx 0) (gn-emit My (enc-csel d 31 ry cc))
            (= kx 1) (gn-emit My (enc-csinc d ry 31 nc))
            (= kx -1) (gn-emit My (t2-e-csinv d ry 31 nc))
            :else (-> My (gn-mov-imm 16 kx) (gn-emit (enc-csel d 16 ry cc))))
      yc
      (cond (= ky 0) (gn-emit My (enc-csel d rx 31 cc))
            (= ky 1) (gn-emit My (enc-csinc d rx 31 cc))
            (= ky -1) (gn-emit My (t2-e-csinv d rx 31 cc))
            :else (-> My (gn-mov-imm 17 ky) (gn-emit (enc-csel d rx 17 cc))))
      :else (gn-emit My (enc-csel d rx ry cc)))))
;; v = item clamp(x, base, top) - base of a literal table (top = base + n - 1). Unsigned variant (both outer items equal):
;; i = x - base, i := i <=u n - 1 ? i : n - 1. Signed variant: i := max(x, base), i := min(i, top), the base register
;; pointing at item -base. Both are exact for every x (t2-dtab-at); nothing traps.
;; x16 := r cc k ? r : k (the flags from comparing r with k; k in x17)
(defn- t2-clampk [M :vector-i64 r :i64 k :i64 cc :i64] :vector-i64
  (-> (cond (and (>= k 0) (< k 4096)) (-> M (gn-emit (enc-cmp-i r k)) (gn-mov-imm 17 k))
            (and (< k 0) (> k -4096)) (-> M (gn-emit (enc-cmn-i r (- 0 k))) (gn-mov-imm 17 k))
            :else (-> M (gn-mov-imm 17 k) (gn-emit (enc-cmp-r r 17))))
      (gn-emit (enc-csel 16 r 17 cc))))
(defn- t2-e-dtab [M :vector-i64 v :i64] :vector-i64
  (let [d (t2-dst M v) T (t2-tabreg M (t2-vf M v t2-f-a) 0) pk (t2-vf M v t2-f-b)
        n (t2-dt-n pk) base (t2-dt-base pk) top (+ base (dec n))
        M1 (t2-src M (t2-vf M v t2-f-c) 16) rx (t2-last M1)]
    (if (= (t2-dt-u pk) 1)
      (let [M2 (if (= base 0) M1 (t2-addk M1 16 rx (- 0 base))) ri (if (= base 0) rx 16)]
        (-> M2 (gn-emit (enc-cmp-i ri (dec n))) (gn-mov-imm 17 (dec n)) (gn-emit (enc-csel 16 ri 17 9))
            (gn-emit (gn-e-ldrr d T 16 1))))
      (let [M2 (cond (= base 0) (-> M1 (gn-emit (enc-cmp-i rx 0)) (gn-emit (enc-csel 16 rx 31 12)))
                     (= base -1) (-> M1 (gn-emit (enc-cmn-i rx 1)) (gn-emit (t2-e-csinv 16 rx 31 12)))
                     :else (t2-clampk M1 rx base 12))]
        (-> M2 (t2-clampk 16 top 11) (gn-emit (gn-e-ldrr d T 16 1)))))))
;; ---- phi copies on edge b -> s ------------------------------------------------------------------------------------------
(def t2-s-nmv 26)
(defn- t2-mv-add [M :vector-i64 dst :i64 src :i64 isk :i64 k :i64] :vector-i64
  (let [n (t2-g M t2-s-nmv) a (+ t2-a-mv (* 4 n))]
    (if (>= n 63) (t2-fail M 15)
      (-> M (t2-s a dst) (t2-s (+ a 1) src) (t2-s (+ a 2) isk) (t2-s (+ a 3) k) (t2-s t2-s-nmv (inc n))))))
(defn- t2-mv-collect [M :vector-i64 p :i64 k :i64] :vector-i64
  (if (= p 0) M
    (t2-mv-collect
      (if (and (= (t2-vf M p t2-f-repl) 0) (> (t2-xf M p t2-x-uses) 0))
        ;; (over locations: a spilled phi or operand is a memory location, t2-loc)
        (let [x (t2-phiarg M p k) d (t2-loc M p)]
          (cond (t2-isconst? M x) (t2-mv-add M d 0 1 (t2-kval M x))
                (= (t2-loc M x) d) M
                :else (t2-mv-add M d (t2-loc M x) 0 0)))
        M)
      (t2-vf M p t2-f-link) k)))
(defn- t2-mv-f [M :vector-i64 i :i64 f :i64] :i64 (t2-g M (+ t2-a-mv (* 4 i) f)))
;; pending register move i (isk 0, not done: isk 2 = done)
(defn- t2-mv-src-of? [M :vector-i64 r :i64 i :i64 n :i64 except :i64] :bool
  (cond (>= i n) false
        (and (not= i except) (= (t2-mv-f M i 2) 0) (= (t2-mv-f M i 1) r)) true
        :else (t2-mv-src-of? M r (inc i) n except)))
(defn- t2-mv-ready [M :vector-i64 i :i64 n :i64] :i64
  (cond (>= i n) -1
        (and (= (t2-mv-f M i 2) 0) (not (t2-mv-src-of? M (t2-mv-f M i 0) 0 n i))) i
        :else (t2-mv-ready M (inc i) n)))
(defn- t2-mv-first [M :vector-i64 i :i64 n :i64] :i64
  (cond (>= i n) -1 (= (t2-mv-f M i 2) 0) i :else (t2-mv-first M (inc i) n)))
(defn- t2-mv-resrc [M :vector-i64 i :i64 n :i64 from :i64 to :i64] :vector-i64
  (if (>= i n) M
    (t2-mv-resrc (if (and (= (t2-mv-f M i 2) 0) (= (t2-mv-f M i 1) from)) (t2-s M (+ t2-a-mv (* 4 i) 1) to) M) (inc i) n from to)))
(defn- t2-mv-regs [M :vector-i64 n :i64 guard :i64] :vector-i64
  (let [i (t2-mv-ready M 0 n)]
    (cond (<= guard 0) M
          (>= i 0) (t2-mv-regs (-> M (t2-mvx (t2-mv-f M i 0) (t2-mv-f M i 1)) (t2-s (+ t2-a-mv (* 4 i) 2) 2)) n (dec guard))
          :else (let [j (t2-mv-first M 0 n)]
                  (if (< j 0) M
                    ;; cycle: save the blocked destination's current value in x16 and redirect its readers
                    (let [d (t2-mv-f M j 0)]
                      (t2-mv-regs (-> M (t2-mvx 16 d) (t2-mv-resrc 0 n d 16)) n (dec guard))))))))
(defn- t2-mv-consts [M :vector-i64 i :i64 n :i64] :vector-i64
  (if (>= i n) M
    (t2-mv-consts (let [d (t2-mv-f M i 0) k (t2-mv-f M i 3)]
                    (cond (not= (t2-mv-f M i 2) 1) M
                          (< d 32) (gn-mov-imm M d k)
                          (= k 0) (t2-stloc M 31 d)     ; str xzr
                          :else (-> M (gn-mov-imm 17 k) (t2-stloc 17 d))))
                  (inc i) n)))
(defn- t2-copies [M :vector-i64 b :i64 s :i64] :vector-i64
  (if (< s 0) M
    (let [M1 (t2-mv-collect (t2-s M t2-s-nmv 0) (t2-bget M t2-a-bphi s) (t2-predidx M s b 0)) n (t2-g M1 t2-s-nmv)]
      (-> M1 (t2-mv-regs n 200) (t2-mv-consts 0 n) (cond-> (and (t2-sr-edge? M1 s) (= (t2-g M1 t2-s-ucopy) 0)) (t2-e-srincs (dec (t2-g M1 t2-s-fastl)) 0))))))
(defn- t2-needs-copies? [M :vector-i64 b :i64 s :i64] :bool
  (let [M1 (t2-mv-collect (t2-s M t2-s-nmv 0) (t2-bget M t2-a-bphi s) (t2-predidx M s b 0))]
    (or (> (t2-g M1 t2-s-nmv) 0) (t2-sr-edge? M s))))
;; next reachable block after b (-1 when none)
(defn- t2-nextb [M :vector-i64 b :i64] :i64
  (cond (>= (inc b) (t2-g M t2-s-nb)) -1
        (and (= (t2-bget M t2-a-breach (inc b)) 1) (not (t2-dead-thread? M (inc b)))) (inc b)
        :else (t2-nextb M (inc b))))
;; a block that emits no code: no values (only phis or gone), no batch, no hoisted checks, no version, falling through
;; to its successor without copies
(defn- t2-silent? [M :vector-i64 E :i64] :bool
  (let [F (t2-bget M t2-a-bf E)]
    (and (= (t2-lastval M E) 0) (= (t2-bget M t2-a-bt E) -1) (>= F 0) (not= F E)
         (= (t2-bget M t2-a-fast E) 0) (not (t2-bch-any? M E)) (not (t2-vhead? M E)) (not (t2-thread? M E))
         (not (t2-needs-copies? M E F)))))
;; a block T that emits only its jump (only phis before a BR, or nothing before falling through), entered from b
;; with no copies and leaving with none: b goes straight to T's successor (plain emission only)
(defn- t2-hop [M :vector-i64 b :i64 T :i64] :i64
  (if (or (< T 0) (not= (t2-g M t2-s-fastl) 0) (not= (t2-g M t2-s-cold) 0)) T
    (let [v (t2-lastval M T) br (and (> v 0) (= (t2-op-of M v) t2-br))
          S (cond br (t2-bget M t2-a-bt T) (= v 0) (t2-bget M t2-a-bf T) :else -1)]
      (if (and (>= S 0) (not= S T) (not= S b) (= (t2-bget M t2-a-breach T) 1)
               (or (not br) (loop [w (t2-bget M t2-a-bv0 T)]
                              (cond (>= w v) true (or (= (t2-op-of M w) t2-phi) (t2-gone? M w)) (recur (inc w)) :else false)))
               (= (t2-bget M t2-a-fast T) 0) (not (t2-bch-any? M T)) (not (t2-vhead? M T)) (not (t2-thread? M T))
               (not (t2-vhead? M S)) (not (t2-thread? M S))
               (not (t2-needs-copies? M b T)) (not (t2-needs-copies? M T S)))
        S T))))
;; in plain emission (block b in layout order, nothing pending after it), S starts right after b: it is the next
;; block, or comes after silent blocks that fall into it
(defn- t2-next-is? [M :vector-i64 b :i64 S :i64] :bool
  (and (>= S 0) (= (t2-g M t2-s-fastl) 0) (= (t2-g M t2-s-cold) 0) (>= (t2-g M t2-s-nextl) 0)
       (= (t2-g M t2-s-nextl) (t2-next-label M b)) (= (t2-tlab M b S) (t2-lab M S))
       (loop [n (t2-nextb M b) k 0]
         (cond (or (< n 0) (> k 8)) false
               (= n S) true
               (and (t2-silent? M n) (= (t2-bget M t2-a-bf n) (t2-nextb M n)) (not (t2-vhead? M (t2-nextb M n))))
               (recur (t2-nextb M n) (inc k))
               :else false))))
(defn- t2-jump-from [M :vector-i64 b :i64 S :i64] :vector-i64
  (let [l (t2-tlab M b S)] (if (or (= l (t2-g M t2-s-nextl)) (t2-next-is? M b S)) M (t2-jmp M FX-B26 l (enc-b 0)))))
;; an access emitted without its index check: dominated by an identical check, or proven by the precheck of the fast copy
;; being emitted
(defn- t2-unchecked? [M :vector-i64 v :i64] :bool
  (or (= (bit-and (t2-xf M v t2-x-flags) 8) 8)
      (and (> (t2-g M t2-s-fastl) 0) (= (bit-and (t2-xf M v t2-x-flags) 16) 16))
      (t2-bch-covered? M v)))
;; leave block b for s on a BR or fallthrough edge: phi copies and the jump, threaded through a thread block s
(defn- t2-goto [M :vector-i64 b :i64 s :i64] :vector-i64
  (if (or (< s 0) (not (t2-thread? M s)))
    (cond (t2-rot? M s) (-> M (t2-copies b s) (t2-e-hinline s))   ; fast-copy back edge: run the header test here
          (t2-rotn? M b s) (-> M (t2-copies b s) (t2-e-hinline-n b s))   ; any other loop's back edge too
          ;; (falling into the next block costs nothing: hop only when s is not next)
          :else (-> M (t2-copies b s) (t2-jump-from b (if (or (= (t2-tlab M b s) (t2-g M t2-s-nextl)) (t2-next-is? M b s)) s (t2-hop M b s)))))
    (let [k (t2-known M b s false) x (t2-phiarg M (t2-thread-p M s) (t2-predidx M s b 0))]
      (cond (>= k 0)
            (let [S (t2-thread-dest M s k)] (-> M (t2-copies s S) (t2-jump-from b S)))
            (and (> x 0) (= (bit-and (t2-xf M x t2-x-flags) 4) 4))
            (let [Sz (t2-thread-dest M s 0) Snz (t2-thread-dest M s 1)]
              (if (and (or (= (t2-tlab M b Snz) (t2-g M t2-s-nextl)) (t2-next-is? M b Snz)) (not (t2-needs-copies? M s Snz)) (not= Sz Snz))
                ;; the nonzero successor is the next block: branch on the inverse condition to the zero one, fall into it
                (let [M0 (if (t2-needs-copies? M s Sz) (t2-stub-label M s Sz (t2-tlab M b Sz)) (t2-s M t2-s-last (t2-tlab M b Sz)))
                      l (t2-last M0)]
                  (-> M0 (t2-e-cmpflags x) (t2-bcond (bit-xor (t2-cmp-cond M0 x) 1) l) (t2-jump-from b Snz)))
                (let [M0 (if (t2-needs-copies? M s Snz) (t2-stub-label M s Snz (t2-tlab M b Snz)) (t2-s M t2-s-last (t2-tlab M b Snz)))
                      l (t2-last M0)]
                  (-> M0 (t2-e-cmpflags x) (t2-bcond (t2-cmp-cond M0 x) l) (t2-copies s Sz) (t2-jump-from b Sz)))))
            :else (-> M (t2-copies b s) (t2-jump-from b s))))))
;; ---- blocks, prologue, epilogue -----------------------------------------------------------------------------------------
(def t2-s-ncs 27)    ; callee-saved pairs saved
(defn- t2-save [M :vector-i64 k :i64 n :i64] :vector-i64
  (if (>= k n) M (t2-save (gn-emit M (enc-stp-pre (+ 19 (* 2 k)) (+ 20 (* 2 k)) 31 -16)) (inc k) n)))
(defn- t2-restore [M :vector-i64 k :i64] :vector-i64
  (if (< k 0) M (t2-restore (gn-emit M (enc-ldp-post (+ 19 (* 2 k)) (+ 20 (* 2 k)) 31 16)) (dec k))))
;; restore the frame (no ret)
(defn- t2-unframe [M :vector-i64] :vector-i64
  (let [calls (> (t2-g M t2-s-ncalls) 0) F (t2-g M t2-s-frame)]
    (-> M (cond-> (= (t2-g M t2-s-fuel) 1) (gn-emit (enc-str 8 7 CTX-FUEL)))
        (cond-> (> F 0) (gn-emit (enc-add-i 31 31 F)))
        (t2-restore (dec (t2-g M t2-s-ncs)))
        (cond-> calls (gn-emit (enc-ldp-post 29 30 31 16))))))
;; the frame tail below the saved registers: x7's word with calls, then the spill slots, a multiple of 16
(defn- t2-frame-size [M :vector-i64] :i64
  (let [calls (> (t2-g M t2-s-ncalls) 0) n (t2-g M t2-s-nspl) raw (+ (if calls 8 0) (* 8 n))]
    (if (or calls (> n 0)) (* 16 (quot (+ raw 15) 16)) 0)))
(defn- t2-e-ret [M :vector-i64 v :i64] :vector-i64
  (let [M1 (t2-src M (t2-vf M v t2-f-a) 0) r (t2-last M1)]
    (-> M1 (gn-mov 0 r) (t2-unframe) (gn-emit (enc-ret)))))
;; arguments of call v into x0.. (parallel move)
(defn- t2-call-args [M :vector-i64 v :i64] :vector-i64 (t2-call-args2 M v false))
;; with a handoff to a callee of 4 to 7 parameters: x9/x10 := the handed-over slot's base/length in the same parallel move
;; (the slot may live in argument registers, x4/x3 in a chain link), then x11 := the handle unless the length is 0
(defn- t2-call-args2 [M :vector-i64 v :i64 h7 :bool] :vector-i64
  (let [start (t2-vf M v t2-f-b) n (t2-vf M v t2-f-c)
        s (if h7 (t2-hslot M (t2-handoff-x M v)) -1)
        M0 (if (>= s 0)
             (let [B (t2-g M (+ t2-a-pd (* 4 s) 1)) L (t2-g M (+ t2-a-pd (* 4 s) 2)) m (t2-s M t2-s-nmv 0)]
               (-> m (cond-> (not= B 9) (t2-mv-add 9 B 0 0)) (cond-> (not= L 10) (t2-mv-add 10 L 0 0))))
             (t2-s M t2-s-nmv 0))
        M1 (loop [k 0 m M0]
             (if (>= k (gn-min n 7)) m
               (let [x (t2-res m (t2-g m (+ t2-a-phiop start k)))]
                 (recur (inc k) (cond (t2-isconst? m x) (t2-mv-add m k 0 1 (t2-kval m x))
                                      (= (t2-loc m x) k) m
                                      :else (t2-mv-add m k (t2-loc m x) 0 0))))))
        nm (t2-g M1 t2-s-nmv)]
    (-> M1 (t2-mv-regs nm 200) (t2-mv-consts 0 nm)
        (cond-> (>= s 0) (-> (gn-emit (enc-cmp-i 10 0)) (gn-emit (enc-csel 11 0 31 1)) (t2-s t2-s-hoffk 1))))))
(defn- t2-stack-args [M :vector-i64 v :i64 ns :i64] :vector-i64
  (let [start (t2-vf M v t2-f-b) n (t2-vf M v t2-f-c)]
    (loop [k 7 m (gn-emit M (enc-sub-i 31 31 ns))]
      (if (>= k n) m
        (let [m1 (t2-src m (t2-g m (+ t2-a-phiop start k)) 16) r (t2-last m1)]
          (recur (inc k) (gn-emit m1 (enc-str r 31 (* 8 (- k 7))))))))))
;; descriptor refresh after call v: v's own slot from x0 when v is a desc-live class member; every other slot whose member
;; is desc-live across v from that member's (callee-saved) register; other slots are not read before their next write
(defn- t2-e-redesc [M :vector-i64 v :i64 k :i64 mcd :bool] :vector-i64
  (if (>= k (t2-g M t2-s-nslot)) M
    (t2-e-redesc (cond (and (= (t2-g M (+ t2-a-cls v)) (inc k)) (= (t2-alias-arg M v) 0))   ; a new object (for its slot)
                       (if (t2-dlive-after? M v v) (t2-e-desc-from M k 0) M)
                       ;; a callee that changes no descriptor leaves every other slot valid (also the slot of the
                       ;; argument a call returns)
                       (not mcd) M
                       (and (= (t2-g M (+ t2-a-cls v)) (inc k)) (t2-dlive-after? M v v)) (t2-e-desc-from M k 0)
                       :else
                       (let [h (t2-live-member M k v)]
                         (cond (= h 0) M
                               (>= (t2-vf M h t2-f-reg) 0) (t2-e-desc-from M k (t2-vf M h t2-f-reg))
                               ;; a spilled member: its handle into x17 (read once, after x16's two loads)
                               (t2-spilled? M h) (-> M (t2-ldloc 17 (t2-loc M h)) (t2-e-desc-from k 17))
                               :else (t2-fail M 36))))
                 v (inc k) mcd)))
;; values keeping a caller-saved register across non-tail call v (t2-sp-alloc) and live after it (register liveness, or
;; a string slot's handle, re-read by its refresh): stored before it (ld false), reloaded after; adjacent slots in pairs
(defn- t2-sh-handle? [M :vector-i64 w :i64] :bool
  (loop [k 0] (and (< k 8) (or (and (not= (t2-sd M k 0) 0) (= (t2-sd M k 5) w)) (recur (inc k))))))
(defn- t2-csac1 [M :vector-i64 r1 :i64 l1 :i64 r2 :i64 ld :bool] :vector-i64
  (cond (< r1 0) M
        (>= r2 0) (gn-emit M (if ld (enc-ldp r1 r2 31 (t2-sp-off M l1)) (enc-stp r1 r2 31 (t2-sp-off M l1))))
        ld (t2-ldloc M r1 l1)
        :else (t2-stloc M r1 l1)))
(defn- t2-csac [M :vector-i64 v :i64 ld :bool] :vector-i64
  (let [p (t2-xf M v t2-x-pos) nv (t2-g M t2-s-nv)]
    (loop [w 1 m M pr -1 pl 0]
      (if (> w nv) (t2-csac1 m pr pl -1 ld)
        (let [r (t2-vf m w t2-f-reg) loc (t2-g m (+ t2-a-spl w))]
          (if (and (>= r 0) (>= loc 32) (< (t2-xf m w t2-x-start) p) (> (t2-xf m w t2-x-end) p)
                   (or (t2-live-after? m v w) (t2-sh-handle? m w)))
            (if (and (>= pr 0) (= loc (inc pl)) (< loc (+ 32 4096)) (<= (t2-sp-off m pl) 496))
              (recur (inc w) (t2-csac1 m pr pl r ld) -1 0)
              (recur (inc w) (t2-csac1 m pr pl -1 ld) r loc))
            (recur (inc w) m pr pl)))))))
;; is call v a tail call: its only use is the RET right after it in block b?
;; (a call with stack arguments, more than 7, is a plain call followed by the return)
(defn- t2-tailcall? [M :vector-i64 v :i64 v1 :i64] :bool
  (let [n (loop [w (inc v)] (cond (>= w v1) 0 (or (= (t2-op-of M w) t2-phi) (t2-gone? M w)) (recur (inc w)) :else w))]
    (and (> n 0) (= (t2-op-of M n) t2-ret) (= (t2-res M (t2-vf M n t2-f-a)) v) (<= (t2-xf M v t2-x-uses) 1)
         (<= (t2-vf M v t2-f-c) 7))))
;; a call ending block b that falls into a block R of only phis and a RET of the phi whose operand from b is the call
;; (an if whose call arm falls into the join that returns): a tail call too -- the fall edge is never taken
(defn- t2-tail-fall? [M :vector-i64 v :i64 b :i64] :bool
  (let [R (t2-bget M t2-a-bf b)]
    (and (= (t2-bget M t2-a-bt b) -1) (>= R 0) (not= R b) (= (t2-bget M t2-a-breach R) 1)
         (= (t2-lastval M b) v) (= (t2-op-of M v) t2-call)
         (<= (t2-xf M v t2-x-uses) 1) (<= (t2-vf M v t2-f-c) 7)
         (let [t (t2-lastval M R)]
           (and (> t 0) (= (t2-op-of M t) t2-ret)
                (loop [w (t2-bget M t2-a-bv0 R)]
                  (cond (>= w t) true (or (= (t2-op-of M w) t2-phi) (t2-gone? M w)) (recur (inc w)) :else false))
                ;; the RET returns the call itself (R's only real predecessor is b) or R's phi of it
                (let [p (t2-res M (t2-vf M t t2-f-a)) k (t2-predidx M R b 0)]
                  (or (= p v)
                      (and (> p 0) (= (t2-op-of M p) t2-phi) (= (t2-vf M p t2-f-blk) R) (>= k 0)
                           (= (t2-phiarg M p k) v) (= (t2-xf M p t2-x-uses) 1)))))))))
;; descriptor slot of handle value x (a member of a handle class), -1 when none
(defn- t2-hslot [M :vector-i64 x :i64] :i64 (if (and (> x 0) (> (t2-g M (+ t2-a-cls x)) 0)) (dec (t2-g M (+ t2-a-cls x))) -1))
;; the member whose descriptor a tail call v hands off (its first argument, at most 3 arguments), 0 when none. The
;; argument is desc-live at the call (t2-dreads), so its slot holds its descriptor.
(defn- t2-handoff-x [M :vector-i64 v :i64] :i64
  (let [n (t2-vf M v t2-f-c) x (if (> n 0) (t2-res M (t2-g M (+ t2-a-phiop (t2-vf M v t2-f-b)))) 0)]
    (if (and (> n 0) (<= n 7) (>= (t2-hslot M x) 0)) x 0)))
;; handoff registers for a callee of n parameters: key, items base, length -- x5, x4, x3 (at most 3 parameters, the
;; existing chain protocol) or x11, x9, x10 (4 to 7 parameters; T2 callees only)
(defn- t2-hk [n :i64] :i64 (if (<= n 3) 5 11))
(defn- t2-hb [n :i64] :i64 (if (<= n 3) 4 9))
(defn- t2-hl [n :i64] :i64 (if (<= n 3) 3 10))
;; d1 := s1, d2 := s2 at once (through x16/x17 when a destination is the other's source)
(defn- t2-mov2 [M :vector-i64 d1 :i64 s1 :i64 d2 :i64 s2 :i64] :vector-i64
  (cond (and (not= d1 s2) (not= d2 s1)) (-> M (gn-mov d1 s1) (gn-mov d2 s2))
        (and (= d1 s2) (= d2 s1)) (-> M (gn-mov 16 s1) (gn-mov d2 s2) (gn-mov d1 16))
        (= d1 s2) (-> M (gn-mov d2 s2) (gn-mov d1 s1))
        :else (-> M (gn-mov d1 s1) (gn-mov d2 s2))))
;; the chain protocol from the caller side: a callee with at most 3 parameters whose first argument is a vector with a
;; descriptor slot receives x3 = length, x4 = items base, x5 = handle (0 when the length is 0, so an invalid or empty
;; vector is validated by the callee itself). The ordinary entry clears x5; T2 upgrades the tail branch to the private
;; entry (+1) after code generation only when the callee is a T2 function that reads the handoff (t2-patch-handoffs).
;; (this function: its entry reads one when parameter 0 is a class's parameter and it has at most 3 parameters)
(defn- t2-hent-known? [M :vector-i64 g :i64] :bool
  (or (and (= g (t2-g M t2-s-f)) (<= (t2-g M t2-s-np) 7)
           (loop [k 0] (and (< k (t2-g M t2-s-nslot)) (or (= (t2-g M (+ t2-a-pd (* 4 k) 3)) 1) (recur (inc k))))))
      (and (> g 0) (< g MM-FN-CAP) (not= g (t2-g M t2-s-f)) (>= (t2-g M (+ t2-a-hent g)) 1))))
;; call w hands its first argument's descriptor over: a tail call to a callee of at most 3 parameters (the chain
;; protocol, patched later), else only to a callee known to read it
;; a callee not compiled yet whose parameter 0 is always a vector (least length > 0, part6): T2 will most likely read a
;; handed-over descriptor there; if it does not, the call enters at +0 and the handoff registers are simply unused
(defn- t2-hent-likely? [M :vector-i64 g :i64 n :i64] :bool
  (and (> g (t2-g M t2-s-f)) (< g MM-FN-CAP) (< g (vector-at M MM-FN-N)) (<= n 7) (>= n 1)
       (= (gn-fnf M g FF-KIND) FK-PRIV) (= (gn-fnf M g FF-NPARAMS) n)
       (let [m (t2-g M (+ t2-a-pmin (* 4 g)))] (and (> m 0) (< m t2-mlinf)))))
(defn- t2-hoff-call? [M :vector-i64 w :i64 tail :bool] :bool
  (and (> (t2-handoff-x M w) 0)
       (or (and tail (<= (t2-vf M w t2-f-c) 3)) (t2-hent-known? M (t2-vf M w t2-f-a))
           (t2-hent-likely? M (t2-vf M w t2-f-a) (t2-vf M w t2-f-c)))))
(defn- t2-handoff [M :vector-i64 v :i64] :vector-i64
  (let [x (t2-handoff-x M v) s (if (> x 0) (t2-hslot M x) -1)]
    (if (>= s 0)
      (let [B (t2-g M (+ t2-a-pd (* 4 s) 1)) L (t2-g M (+ t2-a-pd (* 4 s) 2))]
        (-> M (gn-mov 4 B) (gn-mov 3 L) (gn-emit (enc-cmp-i L 0)) (gn-emit (enc-csel 5 0 31 1))
            (t2-s t2-s-hoffk 1)))
      (t2-s M t2-s-hoffk 0))))
(def t2-s-hoffk 61)
(def t2-s-hent 62)
(def t2-a-hent (+ t2-a-hoist 32))             ; per FN: its T2 code reads a handed-over descriptor (persistent)
(def t2-a-hoff (+ t2-a-hent MM-FN-CAP))       ; [count, FIX indices of handoff tail branches...] (persistent, 4096)
;; records (FIX index, index of the caller's fuel store before the branch or -1)
(defn- t2-hoff-add [M :vector-i64 k :i64 sx :i64] :vector-i64
  (let [n (t2-g M t2-a-hoff)] (if (>= n 4094) M (-> M (t2-s (+ t2-a-hoff 1 n) k) (t2-s (+ t2-a-hoff 2 n) sx) (t2-s t2-a-hoff (+ n 2))))))
;; after code generation: handoff tail branches to T2 callees that read the handoff enter at +1 (skipping mov x5,#0)
(defn- t2-patch-handoffs [M :vector-i64] :vector-i64
  (if (= (t2-base M) 0) M
    (loop [i 0 m M]
      (if (>= i (t2-g m t2-a-hoff)) m
        (let [k (t2-g m (+ t2-a-hoff 1 i)) sx (t2-g m (+ t2-a-hoff 2 i)) b (+ MM-FIX-BASE (* k MM-FIX-W))
              g (vector-at m (+ b XF-TARGET)) he (if (and (> g 0) (< g MM-FN-CAP)) (t2-g m (+ t2-a-hent g)) 0)
              ok (and (>= he 1) (= (vector-at m (+ b XF-AUX)) 0) (= (vector-at m (+ b XF-KIND)) FX-BL26))]
          ;; AUX 2 (skip the callee's fuel load too) when the callee publishes fuel itself wherever it is observed and
          ;; the caller's x8 is the exact count: the caller's own store before the branch becomes a nop
          ;; with a callee that keeps its frame (3), only the callee's fuel load is skipped: the caller's store stays
          (recur (+ i 2) (cond (and ok (= he 2) (>= sx 0) (= (vector-at m (+ MM-CODE-BASE sx)) (enc-str 8 7 CTX-FUEL)))
                               (-> m (gn-put (+ b XF-AUX) 2) (gn-put (+ MM-CODE-BASE sx) 0xd503201f))
                               (and ok (= he 3) (>= sx 0) (= (vector-at m (+ MM-CODE-BASE sx)) (enc-str 8 7 CTX-FUEL)))
                               (gn-put m (+ b XF-AUX) 2)
                               ok (gn-put m (+ b XF-AUX) 1)
                               :else m)))))))
;; g's code returns with x8 exact and x7 the context (compiled before this function, or this function itself when
;; every tail call it will make goes to such code or to itself)
(def t2-s-selfx8r 85)   ; 0 not known yet, 1 yes, 2 no
(defn- t2-tails-ok? [M :vector-i64 b :i64] :bool
  (or (>= b (t2-g M t2-s-nb))
      (and (or (= (t2-bget M t2-a-breach b) 0)
               (loop [v (t2-bget M t2-a-bv0 b)]
                 (cond (>= v (t2-bget M t2-a-bv1 b)) true
                       (and (= (t2-op-of M v) t2-call) (not (t2-gone? M v))
                            (or (t2-tailcall? M v (t2-bget M t2-a-bv1 b)) (t2-tail-fall? M v b))
                            (let [g (t2-vf M v t2-f-a)]
                              (not (or (= g (t2-g M t2-s-f)) (and (> g 0) (< g MM-FN-CAP) (= (t2-g M (+ t2-a-x8r g)) 1))))))
                       false
                       :else (recur (inc v)))))
           (t2-tails-ok? M (inc b)))))
(defn- t2-x8r? [M :vector-i64 g :i64] :bool
  (if (= g (t2-g M t2-s-f))
    (let [k (t2-g M t2-s-selfx8r)] (if (= k 0) (t2-tails-ok? M 0) (= k 1)))
    (and (> g 0) (< g MM-FN-CAP) (= (t2-g M (+ t2-a-x8r g)) 1))))
(defn- t2-e-call [M :vector-i64 v :i64 tail :bool] :vector-i64
  (let [g (t2-vf M v t2-f-a)]
    (if tail
      (let [M (if (or (t2-x8r? M g) (= g (t2-g M t2-s-f))) M (t2-s M t2-s-tailbad 1))
            hd (t2-hoff-call? M v true)
            h7 (and hd (> (t2-vf M v t2-f-c) 3))
            M0 (-> M (t2-call-args2 v h7) (cond-> (and hd (not h7)) (t2-handoff v))) sx (if (= (t2-g M0 t2-s-fuel) 1) (vector-at M0 MM-CODE-N) -1)
            M1 (t2-unframe M0) k (vector-at M1 MM-FIX-N)]
        (-> M1 (gn-fix FX-BL26 g) (gn-emit (enc-b 0)) (cond-> (and hd (= (t2-g M1 t2-s-hoffk) 1)) (t2-hoff-add k sx))))
      ;; a callee known to read a handed-over descriptor (compiled before, or this function) gets one here too
      (let [hd (t2-hoff-call? M v false)
            M0 (cond-> (t2-csac M v false) (= (t2-g M t2-s-defer) 1) (gn-emit (enc-str 8 7 CTX-FUEL)))
            sx (if (= (t2-g M t2-s-defer) 1) (dec (vector-at M0 MM-CODE-N)) -1)
            h7 (and hd (> (t2-vf M v t2-f-c) 3))
            at0 (vector-at M0 MM-CODE-N)
            ;; arguments 7.. of a call with more than 7: the outgoing area [sp, #8 (k - 7)] below the frame, released after
            ns (if (> (t2-vf M v t2-f-c) 7) (* 16 (quot (+ (* 8 (- (t2-vf M v t2-f-c) 7)) 15) 16)) 0)
            ;; (spilled arguments load past the outgoing area while it is allocated)
            Mb (-> (cond-> (t2-s M0 t2-s-spadj ns) (> ns 0) (t2-stack-args v ns)) (t2-call-args2 v h7) (t2-s t2-s-spadj 0))
            at (vector-at Mb MM-CODE-N)
            ;; the handoff words replace the callee's descriptor computation: counted apart by the size rule
            Ma (cond h7 (t2-s Mb t2-s-vsize (+ (t2-g Mb t2-s-vsize) 4))
                     hd (let [m (t2-handoff Mb v)] (t2-s m t2-s-vsize (+ (t2-g m t2-s-vsize) (- (vector-at m MM-CODE-N) at))))
                     :else Mb)
            k (vector-at Ma MM-FIX-N)
            M1 (-> Ma (gn-fix FX-BL26 g) (gn-emit (enc-bl 0)) (cond-> (and hd (= (t2-g Ma t2-s-hoffk) 1)) (t2-hoff-add k sx))
                   (cond-> (> ns 0) (gn-emit (enc-add-i 31 31 ns)))
                   ;; x7 and x8 come back exact from such a callee: no reload through memory
                   (cond-> (not (t2-x8r? Ma g)) (-> (gn-emit (enc-ldr 7 31 0)) (gn-emit (enc-ldr 8 7 CTX-FUEL)))))
            r (t2-vf M v t2-f-reg)]
        (-> M1 (t2-csac v true) (t2-e-redesc v 0 (t2-mcd? M1 g)) (cond-> (t2-mcd? M1 g) (t2-e-sredesc 0 (t2-sneed-after M1 v)))
            (cond-> (>= r 0) (gn-mov r 0))
            (cond-> (t2-spilled? M1 v) (t2-stloc 0 (t2-loc M1 v))))))))
(defn- t2-stub-label [M :vector-i64 b :i64 s :i64 target :i64] :vector-i64
  (let [n (t2-g M t2-s-nstub) l (t2-l-estub M n) a (+ t2-a-stub (* 4 n))]
    (if (>= n (* 6 (t2-g M t2-s-nb))) (-> M (t2-fail 16) (t2-s t2-s-last target))
      (-> M (t2-s a l) (t2-s (+ a 1) b) (t2-s (+ a 2) s) (t2-s (+ a 3) target) (t2-s t2-s-nstub (inc n)) (t2-s t2-s-last l)))))
(defn- t2-e-brz [M :vector-i64 b :i64 v :i64] :vector-i64
  (let [taken (t2-bget M t2-a-bt b) fall (t2-bget M t2-a-bf b) nz (t2-vf M v t2-f-b)
        c (t2-res M (t2-vf M v t2-f-a))]
    (cond (< taken 0) (t2-goto M b fall)
      ;; a folded condition: the known successor only
      (t2-isconst? M c) (t2-goto M b (if (if (= nz 1) (not= (t2-kval M c) 0) (= (t2-kval M c) 0)) taken fall))
      :else
      (let [tk (if (t2-thread? M taken) (t2-known M b taken true) -1)
            S (cond (>= tk 0) (t2-thread-dest M taken tk)
                    (or (= (t2-tlab M b taken) (t2-g M t2-s-nextl)) (t2-next-is? M b taken)) taken
                    :else (t2-hop M b taken))
            from (if (or (>= tk 0) (not= S taken)) taken b)   ; past a thread block or a hop block: its edge
            ;; the fallthrough edge, threaded through a thread block with a known value
            fk (if (and (>= fall 0) (t2-thread? M fall)) (t2-known M b fall false) -1)
            F (if (>= fk 0) (t2-thread-dest M fall fk) fall)
            ffrom (if (>= fk 0) fall b)
            ;; the taken target is the next block: branch on the inverse condition to the fallthrough successor instead
            inv (and (or (= (t2-tlab M b S) (t2-g M t2-s-nextl)) (t2-next-is? M b S)) (not (t2-needs-copies? M from S))
                     (>= fall 0) (>= F 0) (not= F S) (or (not (t2-thread? M fall)) (>= fk 0)))
            ;; the fallthrough successor is a hop block only b enters, laid out right before the taken successor: branch on
            ;; the inverse condition straight to the hop's successor H and fall into the taken one (the hop block's jump
            ;; moves to an edge stub under its own label: t2-skip-hop)
            H (if (and (not inv) (= t2-skiph-on 1) (< tk 0) (< fk 0) (= S taken) (>= fall 0) (= (t2-g M t2-s-fastl) 0)
                       (= (t2-g M t2-s-cold) 0) (= (t2-g M t2-s-inrot) 0) (= (t2-bget M t2-a-bpn fall) 1)
                       (not (t2-rgn-in? M fall)) (= (t2-nextb M b) fall) (= (t2-g M t2-s-nextl) (t2-lab M fall))
                       (= (t2-tlab M b S) (t2-next-label M fall)) (not (t2-needs-copies? M b S)))
                (t2-hop M b fall) -1)
            hop2 (and (>= H 0) (not= H fall) (not= H S))
            M0 (cond inv (if (t2-needs-copies? M ffrom F) (t2-stub-label M ffrom F (t2-tlab M b F)) (t2-s M t2-s-last (t2-tlab M b F)))
                     hop2 (t2-s M t2-s-last (t2-tlab M fall H))
                     (t2-needs-copies? M from S) (t2-stub-label M from S (t2-tlab M b S))
                     :else (t2-s M t2-s-last (t2-tlab M b S)))
            l (t2-last M0)
            jnz (if (or inv hop2) (= nz 0) (= nz 1))
            fused (and (= (t2-op-of M0 c) t2-cmp) (not= (bit-and (t2-xf M0 c t2-x-flags) 129) 0))
            M1 (if fused
                 (let [cc (t2-cmp-cond M0 c)]
                   (-> M0 (t2-e-cmpflags c) (t2-bcond (if jnz cc (bit-xor cc 1)) l)))
                 (let [Ma (t2-src M0 c 16) rc (t2-last Ma)]
                   (t2-jmp Ma FX-CB19 l (if jnz (enc-cbnz rc 0) (enc-cbz rc 0)))))]
        (cond inv M1 hop2 (t2-skip-hop M1 fall H) :else (t2-goto M1 b fall))))))
(def t2-skiph-on 1)
(def t2-s-skip 104)   ; block (+ 1) whose layout slot is skipped: its jump was registered as an edge stub
(def t2-s-lastskip 106)   ; the latest block (+ 1) skipped so
(defn- t2-skip-hop [M :vector-i64 T :i64 H :i64] :vector-i64
  (let [n (t2-g M t2-s-nstub) a (+ t2-a-stub (* 4 n))]
    (if (>= n (* 6 (t2-g M t2-s-nb))) (t2-fail M 16)
      (-> M (t2-s a (t2-lab M T)) (t2-s (+ a 1) T) (t2-s (+ a 2) H) (t2-s (+ a 3) (t2-tlab M T H)) (t2-s t2-s-nstub (inc n))
          (t2-s t2-s-skip (inc T))))))
(defn- t2-e-vals [M :vector-i64 b :i64 v :i64 v1 :i64] :vector-i64
  (if (>= v v1) M
    (let [op (t2-op-of M v)]
      (cond (or (= op t2-phi) (t2-gone? M v)) (t2-e-vals M b (inc v) v1)
            (= op t2-ret) (t2-e-ret M v)
            (= op t2-call) (if (or (t2-tailcall? M v v1) (t2-tail-fall? M v b)) (t2-e-call M v true)
                             (t2-e-vals (t2-e-call M v false) b (inc v) v1))
            (= op t2-br) (t2-goto M b (t2-bget M t2-a-bt b))
            (= op t2-brz) (t2-e-brz M b v)
            :else (t2-e-vals (t2-sp-store (t2-e-val M v) v) b (inc v) v1)))))
(defn- t2-e-body [M :vector-i64 b :i64] :vector-i64
  (let [M1 (t2-e-vals M b (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b))
        last (t2-lastval M b) op (if (> last 0) (t2-op-of M last) 0)]
    ;; a block without a terminator falls into its successor (unless it ended in a tail call)
    (if (or (= op t2-ret) (= op t2-br) (= op t2-brz) (= op t2-trap) (and (= op t2-call) (t2-tail-fall? M last b)))
      M1
      (t2-goto M1 b (t2-bget M t2-a-bf b)))))
;; a batched block charges its k units at once, its cold copy (fuel below k) charges them one by one
;; ---- block check hoisting: a block without a real call whose checked accesses use at least two constant indices on one
;; slot checks the greatest of them once at its start (the slot holds its member's descriptor there: nothing in the
;; block writes it before those accesses); failing that, its cold copy runs the block with every check in place, so a
;; trap happens where and as it did. Per block and slot: the greatest such index + 1 (0 none).
(def t2-s-bchb 78)   ; block being emitted (+ 1) under its hoisted checks
(defn- t2-bchk [M :vector-i64 b :i64 s :i64] :i64 (t2-g M (+ t2-a-bch (* 16 b) s)))
(defn- t2-bch-k [M :vector-i64 v :i64] :i64
  (let [op (t2-op-of M v)]
    (if (and (or (= op t2-vat) (= op t2-vset)) (not (t2-gone? M v)) (not= (bit-and (t2-xf M v t2-x-flags) 8) 8))
      (let [i (t2-res M (t2-vf M v t2-f-b))] (if (and (t2-isconst? M i) (t2-small-index? (t2-kval M i) 4096)) (t2-kval M i) -1))
      -1)))
(defn- t2-bch-covered? [M :vector-i64 v :i64] :bool
  (let [bb (t2-g M t2-s-bchb)]
    (and (> bb 0) (= (t2-vf M v t2-f-blk) (dec bb)) (let [k (t2-bch-k M v)] (and (>= k 0) (< k (t2-bchk M (dec bb) (t2-pk M v))))))))
(defn- t2-bch-block [M :vector-i64 b :i64] :vector-i64
  (let [v0 (t2-bget M t2-a-bv0 b) v1 (t2-bget M t2-a-bv1 b) base (+ t2-a-bch (* 16 b))
        M0 (-> M (t2-wzero base 0 16) (t2-wzero t2-a-tmp 0 16))
        call (loop [v v0] (and (< v v1) (or (and (= (t2-op-of M v) t2-call) (not (t2-gone? M v))) (recur (inc v)))))]
    (if (or call (= (t2-bget M t2-a-breach b) 0)) M0
      (let [M1 (loop [v v0 m M0]
                 (if (>= v v1) m
                   (let [k (t2-bch-k m v)]
                     (recur (inc v) (if (< k 0) m
                                      (let [s (t2-pk m v)]
                                        (-> m (t2-s (+ t2-a-tmp s) (inc (t2-g m (+ t2-a-tmp s))))
                                            (t2-s (+ base s) (gn-max (t2-g m (+ base s)) (inc k))))))))))]
        (loop [s 0 m M1] (if (>= s 16) m (recur (inc s) (if (< (t2-g m (+ t2-a-tmp s)) 2) (t2-s m (+ base s) 0) m))))))))
(defn- t2-bch-plan [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M (t2-bch-plan (t2-bch-block M b) (inc b))))
(defn- t2-bch-any? [M :vector-i64 b :i64] :bool (loop [s 0] (and (< s 16) (or (> (t2-bchk M b s) 0) (recur (inc s))))))
(defn- t2-e-bchecks [M :vector-i64 b :i64 s :i64] :vector-i64
  (if (>= s 16) M
    (t2-e-bchecks (let [k (t2-bchk M b s)]
                    (if (= k 0) M
                      (-> M (gn-emit (enc-cmp-i (t2-g M (+ t2-a-pd (* 4 s) 2)) (dec k))) (t2-bcond 9 (t2-l-cold M b)))))
                  b (inc s))))
;; b is entered only by falling through from its single predecessor p, laid out right before it and ending in a plain
;; BRZ (no thread, hop, copies, batch, hoisted checks, region, version or cold copy on either side): its label keeps flags
(defn- t2-flagkeep? [M :vector-i64 b :i64] :bool
  (let [p (if (= (t2-bget M t2-a-bpn b) 1) (t2-pred M b 0) -1) t (if (>= p 0) (t2-lastval M p) 0)]
    (and (>= p 0) (not= p b) (> t 0) (= (t2-op-of M t) t2-brz)
         ;; laid out right after p, or after the hop block p's inverted branch skipped (t2-skip-hop)
         (let [n (t2-nextb M p) k (dec (t2-g M t2-s-lastskip))]
           (or (= n b) (and (>= k 0) (= n k) (= (t2-nextb M k) b) (= (t2-pred M k 0) p))))
         (= (t2-g M t2-s-fastl) 0) (= (t2-g M t2-s-cold) 0) (= (t2-g M t2-s-inrot) 0)
         (not (t2-thread? M p)) (not (t2-vhead? M b)) (= (t2-bget M t2-a-bloop p) 0) (= (t2-bget M t2-a-bloop b) 0)
         (= (t2-bget M t2-a-fast p) 0) (= (t2-bget M t2-a-fast b) 0) (not (t2-bch-any? M p)) (not (t2-bch-any? M b))
         (not (t2-rgn-in? M p)) (not (t2-rgn-in? M b)) (not (t2-needs-copies? M p b)))))
(defn- t2-e-block [M :vector-i64 b :i64] :vector-i64
  (let [k (t2-bget M t2-a-fast b)
        rg (t2-rgn-in? M b) head (and rg (= (t2-bget M t2-a-rgn b) (inc b)))
        lp (t2-g M t2-s-labpos)
        M0 (-> M (t2-deflab (t2-lab M b)) (cond-> (t2-flagkeep? M b) (t2-s t2-s-labpos lp))
               (t2-s t2-s-curu (t2-bget M t2-a-uin b)) (t2-s t2-s-pend k)
               (t2-s t2-s-nextl (t2-next-label M b)))
        ;; a fuel region's head checks the counter for its longest path; its members charge without checks
        Mh (if head (-> M0 (gn-emit (enc-cmp-i 8 (t2-bget M0 t2-a-rgk b))) (t2-bcond 3 (t2-l-cold M0 b))) M0)
        M1 (cond (and (> k 0) rg) (gn-emit Mh (enc-sub-i 8 8 k))
                 (> k 0) (-> Mh (gn-emit (enc-subs-i 8 8 k)) (t2-bcond 3 (t2-l-cold Mh b)))
                 :else Mh)]
    (-> M1 (t2-s t2-s-rfast (if rg 1 0)) (t2-e-bchecks b 0) (t2-s t2-s-bchb (inc b)) (t2-e-body b) (t2-s t2-s-bchb 0)
        (t2-s t2-s-rfast 0))))
;; cold copies of fuel-region members: ordinary checks, jumps to members of the same region stay in the copy
(defn- t2-e-rcolds [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-e-rcolds (if (and (t2-rgn-in? M b) (= (t2-bget M t2-a-breach b) 1) (not (t2-dead-thread? M b)))
                   (-> M (t2-deflab (t2-l-cold M b)) (t2-s t2-s-curu (t2-bget M t2-a-uin b)) (t2-s t2-s-pend 0) (t2-s t2-s-cold 1)
                       (t2-s t2-s-cregion (t2-bget M t2-a-rgn b)) (t2-s t2-s-nextl -1)
                       (t2-e-body b) (t2-s t2-s-cold 0) (t2-s t2-s-cregion 0))
                   M)
                 (inc b))))
(defn- t2-e-colds [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (let [k (t2-bget M t2-a-fast b)]
      (t2-e-colds (if (and (or (> k 0) (t2-bch-any? M b)) (= (t2-bget M t2-a-breach b) 1) (not (t2-rgn-in? M b)))
                    (-> M (t2-deflab (t2-l-cold M b)) (cond-> (> k 0) (gn-emit (enc-add-i 8 8 k)))
                        (t2-s t2-s-curu (t2-bget M t2-a-uin b)) (t2-s t2-s-pend 0) (t2-s t2-s-cold 1) (t2-s t2-s-nextl -1)
                        (t2-e-body b) (t2-s t2-s-cold 0))
                    M)
                  (inc b)))))
(defn- t2-e-blocks [M :vector-i64 b :i64] :vector-i64
  (if (>= b (t2-g M t2-s-nb)) M
    (t2-e-blocks (cond (or (= (t2-bget M t2-a-breach b) 0) (t2-dead-thread? M b)) M
                       (= (t2-g M t2-s-skip) (inc b)) (-> M (t2-s t2-s-skip 0) (t2-s t2-s-lastskip (inc b)))
                       ;; a versioned loop header: its precheck and fast copies come first
                       (t2-vhead? M b) (t2-e-block (t2-e-version M (dec (t2-bget M t2-a-bloop b))) b)
                       :else (t2-e-block M b))
                 (inc b))))
(defn- t2-e-stubs [M :vector-i64 k :i64] :vector-i64
  (if (>= k (t2-g M t2-s-nstub)) M
    (let [a (+ t2-a-stub (* 4 k)) s (t2-g M (+ a 2))]
      (t2-e-stubs (-> M (t2-deflab (t2-g M a)) (t2-copies (t2-g M (+ a 1)) s) (t2-sr-stub-incs s (t2-g M (+ a 3)))
                      (t2-jmp FX-B26 (t2-g M (+ a 3)) (enc-b 0))) (inc k)))))
;; descriptor of slot k from handle register rh: base := items + 8*offset, len; a predicted branch (no data dependency on
;; the validity test) to a cold stub that sets length 0 for an invalid handle and returns
(def t2-s-ndst 38)
(def t2-a-dstub (+ t2-a-calls 256))   ; 64 x (invalid label, done label, length register)
(defn- t2-e-desc-from [M :vector-i64 k :i64 rh :i64] :vector-i64
  (let [B (t2-g M (+ t2-a-pd (* 4 k) 1)) L (t2-g M (+ t2-a-pd (* 4 k) 2))
        n (t2-g M t2-s-ndst)
        li (t2-l-dstub M n)
        ld (inc li)
        a (+ t2-a-dstub (* 3 n))]
    (if (>= n 60) (t2-fail M 26)
      (-> M (t2-s a li) (t2-s (+ a 1) ld) (t2-s (+ a 2) L) (t2-s t2-s-ndst (inc n))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rh 1))
          (gn-emit (enc-cmp-r 17 16)) (t2-bcond 2 li)
          (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp B L 16 0))
          (gn-emit (enc-ldr 17 7 328)) (gn-emit (gn-e-addsl B 17 B 3))
          (t2-deflab ld)))))
(defn- t2-e-dstubs [M :vector-i64 k :i64] :vector-i64
  (if (>= k (t2-g M t2-s-ndst)) M
    (let [a (+ t2-a-dstub (* 3 k))]
      (t2-e-dstubs (if (< (t2-g M a) 0) M
                     (-> M (t2-deflab (t2-g M a)) (gn-emit (enc-movz (t2-g M (+ a 2)) 0 0))
                         (t2-jmp FX-B26 (t2-g M (+ a 1)) (enc-b 0))))
                   (inc k)))))
;; entry descriptor of slot s from vector parameter k. With at most 3 parameters (x3..x5 are not parameters) a
;; private-entry caller of the existing chain protocol may hand over a validated descriptor: key x5 = handle (nonzero),
;; x3 = length, x4 = items base. The ordinary entry clears x5 first (word 0), so only such callers reuse it.
(defn- t2-e-desc-entry [M :vector-i64 s :i64 k :i64] :vector-i64
  ;; parameter 0 of a function with at most 7 parameters may arrive with a handed-over descriptor (x5/x4/x3 up to 3
  ;; parameters, x11/x9/x10 from 4 on). Only T2 callers enter past the marker, and they set the key to x0 or 0 right
  ;; after the argument moves (csel), so a nonzero key is x0's: no comparison.
  (if (or (not= k 0) (> (t2-g M t2-s-np) 7)) (t2-e-desc-from M s k)
    (if (> (t2-g M t2-s-np) 3) (t2-e-desc-entry7 M s)
    (let [B (t2-g M (+ t2-a-pd (* 4 s) 1)) L (t2-g M (+ t2-a-pd (* 4 s) 2))
          n (t2-g M t2-s-ndst)
          lc (t2-l-dstub M n)
          lj (inc lc)]
      (if (>= n 60) (t2-fail M 26)
        (if (and (= B 4) (= L 3))
          ;; the slot lives in the handoff registers: a matching handoff falls straight through; the computation is a
          ;; cold block (t2-e-cdesc) entered from the ordinary entry
          (-> M (t2-s t2-s-ndst (inc n)) (t2-s (+ t2-a-dstub (* 3 n)) -1) (t2-s t2-s-cdesc (inc n)) (t2-s t2-s-cdslot s)
              (t2-jmp FX-CB19 lc (enc-cbz 5 0))
              (t2-deflab lj) (t2-s t2-s-hent 1))
          (let [M1 (-> M (t2-s t2-s-ndst (inc n)) (t2-s (+ t2-a-dstub (* 3 n)) -1)
                       (t2-jmp FX-CB19 lc (enc-cbz 5 0))
                       (gn-mov B 4) (gn-mov L 3) (t2-jmp FX-B26 lj (enc-b 0))
                       (t2-deflab lc))]
            (-> M1 (t2-e-desc-from s k) (t2-deflab lj) (t2-s t2-s-hent 1)))))))))
(defn- t2-e-desc-entry7 [M :vector-i64 s :i64] :vector-i64
  (let [B (t2-g M (+ t2-a-pd (* 4 s) 1)) L (t2-g M (+ t2-a-pd (* 4 s) 2)) n (t2-g M t2-s-ndst) lc (t2-l-dstub M n) lj (inc lc)]
    (if (>= n 60) (t2-fail M 26)
      (-> M (t2-s t2-s-ndst (inc n)) (t2-s (+ t2-a-dstub (* 3 n)) -1)
          (t2-jmp FX-CB19 lc (enc-cbz 11 0))
          (t2-mov2 B 9 L 10) (t2-jmp FX-B26 lj (enc-b 0))
          (t2-deflab lc) (t2-e-desc-from s 0) (t2-deflab lj) (t2-s t2-s-hent 1)))))
;; the cold descriptor computation of parameter 0 (handoff-register slot t2-s-cdslot), back to the entry path
(def t2-s-cdesc 74)
(def t2-s-cdslot 75)
(defn- t2-e-cdesc [M :vector-i64] :vector-i64
  (let [n (dec (t2-g M t2-s-cdesc))]
    (if (< n 0) M
      (let [lc (t2-l-dstub M n) lj (inc lc)]
        (-> M (t2-s t2-s-cdesc 0) (t2-deflab lc) (t2-e-desc-from (t2-g M t2-s-cdslot) 0) (t2-jmp FX-B26 lj (enc-b 0)))))))
;; entry descriptors: each slot whose class has a (register) parameter, from that parameter's incoming register
;; ---- string slots: entry / after-call computation (non-faulting), invalid-handle stubs, host-call stubs ------------------
;; pairs: [x7,#288] -> pair_used, [x7,#296] = pairs base; [x7,#384] = code_base, [x7,#392] = code_length
(defn- t2-e-sdesc-from [M :vector-i64 k :i64 rh :i64] :vector-i64
  (let [n (t2-sd M k 0) hv (= (bit-and n 1) 1) hs (= (bit-and n 2) 2) hf (= (bit-and n 4) 4)
        V (t2-sd M k 1) S (t2-sd M k 2) FL (t2-sd M k 3) FB (t2-sd M k 4)
        Q (if hv V FL)          ; pairs base, then the pair pointer
        M0 (t2-ss-new M 1 (if hv V -1) (if hf FL -1) 0)
        Li (t2-last M0)]
    (-> M0 (gn-emit (enc-ldp 16 Q 7 288)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rh 1))
        (gn-emit (enc-cmp-r 17 16)) (t2-bcond 2 Li)                        ; b.hs: invalid handle
        (gn-emit (gn-e-addsl Q Q 17 4))
        (cond-> (and hs (not hf)) (gn-emit (enc-ldr S Q 8)))
        (cond-> (and hf hs)
          (-> (gn-emit (enc-ldp FB S Q 0)) (gn-emit (enc-ldp 16 17 7 CTX-CODE-BASE))
              (gn-emit (enc-add-r FL FB S)) (gn-emit (enc-cmp-r FL 17))
              (gn-emit (t2-ccmpi FB 0 8 9)) (gn-emit (enc-csel FL S 31 10))     ; ls ? (first >= 0) : false ; ge
              (gn-emit (enc-add-r FB 16 FB))))
        (cond-> (and hf (not hs))
          (-> (gn-emit (enc-ldp FB FL Q 0)) (gn-emit (enc-ldr 17 7 (+ CTX-CODE-BASE 8)))
              (gn-emit (enc-add-r 16 FB FL)) (gn-emit (enc-cmp-r 16 17))
              (gn-emit (t2-ccmpi FB 0 8 9)) (gn-emit (enc-csel FL FL 31 10))
              (gn-emit (enc-ldr 16 7 CTX-CODE-BASE)) (gn-emit (enc-add-r FB 16 FB))))
        (t2-deflab (inc Li)))))
(defn- t2-e-sdescs [M :vector-i64 k :i64] :vector-i64
  (if (>= k 8) M (t2-e-sdescs (if (not= (t2-sd M k 0) 0) (t2-e-sdesc-from M k k) M) (inc k))))
;; after a real call: every slot read later again from its handle's (callee-saved) register (bits: the slots read later)
(defn- t2-e-sredesc [M :vector-i64 k :i64 need :i64] :vector-i64
  (if (>= k 8) M
    (t2-e-sredesc (if (or (= (t2-sd M k 0) 0) (= (bit-and (u64-shift-right need k) 1) 0)) M
                    (let [h (t2-sd M k 5) r (t2-vf M h t2-f-reg)]
                      (cond (>= r 0) (t2-e-sdesc-from M k r)
                            (t2-spilled? M h) (-> M (t2-ldloc 17 (t2-loc M h)) (t2-e-sdesc-from k 17))
                            :else (t2-fail M 33))))
                  (inc k) need)))
;; slots read by the (kept) string ops among values [v, v1)
(defn- t2-sops [M :vector-i64 v :i64 v1 :i64 acc :i64] :i64
  (if (>= v v1) acc
    (t2-sops M (inc v) v1
             (let [op (t2-op-of M v)]
               (if (and (or (= op t2-slen) (t2-cpx? op)) (not (t2-gone? M v)) (>= (t2-hparam M v) 0))
                 (bit-or acc (i64-shift-left 1 (t2-hparam M v))) acc)))))
(defn- t2-sneed-of [M :vector-i64 b :i64] :i64 (if (< b 0) 0 (t2-g M (+ t2-a-sneed b))))
;; per block: the slots read from its start on, over every path (backward fixpoint; all slots when it does not settle)
(defn- t2-sneed-pass [M :vector-i64 b :i64 ch :i64] :vector-i64
  (if (< b 0) (t2-s M t2-s-last ch)
    (if (= (t2-bget M t2-a-breach b) 0) (t2-sneed-pass M (dec b) ch)
      (let [x (bit-or (t2-sops M (t2-bget M t2-a-bv0 b) (t2-bget M t2-a-bv1 b) 0)
                      (bit-or (t2-sneed-of M (t2-bget M t2-a-bt b)) (t2-sneed-of M (t2-bget M t2-a-bf b))))]
        (if (= x (t2-sneed-of M b)) (t2-sneed-pass M (dec b) ch)
          (t2-sneed-pass (t2-s M (+ t2-a-sneed b) x) (dec b) 1))))))
(defn- t2-sneed [M :vector-i64 iter :i64] :vector-i64
  (if (>= iter 300) (t2-wfill M t2-a-sneed 0 (t2-g M t2-s-nb) 255)
    (let [M1 (t2-sneed-pass M (dec (t2-g M t2-s-nb)) 0)] (if (= (t2-last M1) 1) (t2-sneed M1 (inc iter)) M1))))
;; the slots read after call v (later in its block, or from a successor on)
(defn- t2-sneed-after [M :vector-i64 v :i64] :i64
  (let [b (t2-vf M v t2-f-blk)]
    (bit-or (t2-sops M (inc v) (t2-bget M t2-a-bv1 b) 0)
            (bit-or (t2-sneed-of M (t2-bget M t2-a-bt b)) (t2-sneed-of M (t2-bget M t2-a-bf b))))))
;; registers a host call must preserve: every caller-saved register T2 uses, x7, x8, x30
(defn- t2-mbit [m :i64 r :i64] :i64 (if (and (>= r 0) (< r 16)) (bit-or m (i64-shift-left 1 r)) m))
(defn- t2-smask [M :vector-i64] :i64
  (let [nv (t2-g M t2-s-nv)
        m0 (loop [v 1 m 0] (if (> v nv) m (recur (inc v) (t2-mbit m (t2-vf M v t2-f-reg)))))
        m1 (loop [k 0 m m0] (if (>= k 16) m
                              (recur (inc k) (if (= (t2-g M (+ t2-a-pd (* 4 k))) 1)
                                               (t2-mbit (t2-mbit m (t2-g M (+ t2-a-pd (* 4 k) 1))) (t2-g M (+ t2-a-pd (* 4 k) 2))) m))))
        m2 (loop [k 0 m m1] (if (>= k (t2-g M t2-s-ntab)) m (recur (inc k) (t2-mbit m (t2-g M (+ t2-a-tb (* 2 k) 1))))))
        m3 (loop [k 0 m m2] (if (>= k 8) m
                              (recur (inc k) (if (= (t2-sd M k 0) 0) m
                                               (t2-mbit (t2-mbit (t2-mbit (t2-mbit m (t2-sd M k 1)) (t2-sd M k 2)) (t2-sd M k 3)) (t2-sd M k 4))))))]
    (bit-or m3 (+ 384 1073741824))))
;; r := value x (its register, or its spill location)
(defn- t2-mov-from [M :vector-i64 r :i64 x :i64] :vector-i64
  (if (t2-spilled? M x) (t2-ldloc M r (t2-loc M x)) (gn-mov M r (t2-vf M x t2-f-reg))))
(defn- t2-popcount [m :i64 r :i64 n :i64] :i64
  (if (> r 30) n (t2-popcount m (inc r) (+ n (bit-and (u64-shift-right m r) 1)))))
;; push the mask's registers in ascending pairs (an odd last one with x17); pop them in reverse
(defn- t2-push [M :vector-i64 mask :i64 r :i64 pend :i64] :vector-i64
  (cond (> r 30) (if (>= pend 0) (gn-emit M (enc-stp-pre pend 17 31 -16)) M)
        (= (bit-and (u64-shift-right mask r) 1) 1)
        (if (< pend 0) (t2-push M mask (inc r) r) (t2-push (gn-emit M (enc-stp-pre pend r 31 -16)) mask (inc r) -1))
        :else (t2-push M mask (inc r) pend)))
(defn- t2-pop [M :vector-i64 mask :i64 r :i64 pend :i64] :vector-i64
  (cond (> r 30) (if (>= pend 0) (gn-emit M (enc-ldp-post pend 17 31 16)) M)
        (= (bit-and (u64-shift-right mask r) 1) 1)
        (if (< pend 0) (t2-pop M mask (inc r) r) (gn-emit (t2-pop M mask (inc r) -1) (enc-ldp-post pend r 31 16)))
        :else (t2-pop M mask (inc r) pend)))
(defn- t2-e-sstubs [M :vector-i64 n :i64 mask :i64] :vector-i64
  (if (>= n (t2-g M t2-s-nss)) M
    (let [a (+ t2-a-ss (* 6 n)) kind (t2-g M a) l1 (t2-g M (+ a 1)) l2 (t2-g M (+ a 2)) x (t2-g M (+ a 3)) y (t2-g M (+ a 4))]
      (t2-e-sstubs
        (if (= kind 1)
          ;; invalid handle: V = 0 (string-length traps), FLEN = 0 (string-code-point-at takes the host call)
          (-> M (t2-deflab l1) (cond-> (>= x 0) (gn-emit (enc-movz x 0 0))) (cond-> (>= y 0) (gn-emit (enc-movz y 0 0)))
              (t2-jmp FX-B26 l2 (enc-b 0)))
          (let [v x c y h (t2-res M (t2-vf M v t2-f-b)) i (t2-res M (t2-vf M v t2-f-c))
                k (t2-hparam M v) lc (t2-l-sx M (t2-g M t2-s-nsl))]
            (-> M (t2-deflab l1)
                ;; the idiom: string-length's handle check, then length -> 0, else the host call
                (cond-> (= kind 3)
                  (-> (t2-s t2-s-nsl (inc (t2-g M t2-s-nsl)))
                      (t2-jmp FX-CB19 (t2-g M (+ a 5)) (enc-cbz (t2-sd M k 1) 0))
                      (cond-> (t2-isconst? M i) (gn-mov-imm 17 (t2-kval M i)))
                      (cond-> (not (t2-isconst? M i)) (t2-mov-from 17 i))
                      (gn-emit (enc-cmp-r 17 (t2-sd M k 2))) (t2-bcond 1 lc)
                      (gn-emit (enc-movz (t2-dst M v) 0 0)) (t2-jmp FX-B26 l2 (enc-b 0))
                      (t2-deflab lc)))
                (cond-> (> c 0) (-> (gn-emit (enc-add-i 16 8 c)) (gn-emit (enc-str 16 7 CTX-FUEL))))
                (cond-> (= c 0) (gn-emit (enc-str 8 7 CTX-FUEL)))
                (t2-push mask 0 -1)
                (t2-s t2-s-spadj (* 16 (quot (inc (t2-popcount mask 0 0)) 2)))   ; spilled operands past the saves
                (t2-mov-from 16 h)
                (cond-> (t2-isconst? M i) (gn-mov-imm 17 (t2-kval M i)))
                (cond-> (not (t2-isconst? M i)) (t2-mov-from 17 i))
                (t2-s t2-s-spadj 0)
                (gn-mov 1 16) (gn-mov 2 17) (gn-mov 0 7)
                (gn-emit (enc-ldr 16 0 RT-STRING-CODE-POINT-AT)) (gn-emit (enc-blr 16))
                (gn-mov 16 0)
                (t2-pop mask 0 -1)
                (gn-mov (t2-dst M v) 16)
                (t2-jmp FX-B26 l2 (enc-b 0)))))
        (inc n) mask))))
;; parameter 0's slot first: its handoff registers (x9..x11 from 4 parameters on) may be other slots' registers
(defn- t2-e-descs [M :vector-i64 k :i64] :vector-i64
  (-> M (t2-e-descs1 0 true) (t2-e-descs1 0 false)))
(defn- t2-e-descs1 [M :vector-i64 k :i64 p0 :bool] :vector-i64
  (if (>= k (t2-g M t2-s-nslot)) M
    (t2-e-descs1 (let [q (t2-g M (+ t2-a-pd (* 4 k) 3))] (if (and (> q 0) (= (= q 1) p0)) (t2-e-desc-entry M k (dec q)) M)) (inc k) p0)))
(defn- t2-e-tabs [M :vector-i64 k :i64] :vector-i64
  (if (>= k (t2-g M t2-s-ntab)) M
    (let [r (t2-g M (+ t2-a-tb (* 2 k) 1)) dt (bit-and (t2-g M (+ t2-a-tbadj k)) 1) adj (- (t2-g M (+ t2-a-tbadj k)) dt)
          at (vector-at M MM-CODE-N)
          ;; x17 still holds the code base after the previous table unless its base needed an adjustment
          reload (or (= k 0) (not= (- (t2-g M (+ t2-a-tbadj (dec k))) (bit-and (t2-g M (+ t2-a-tbadj (dec k))) 1)) 0))
          M1 (-> M (cond-> reload (gn-emit (enc-ldr 17 7 CTX-CODE-BASE))) (gn-fix FX-LIT32 (t2-g M (+ t2-a-tb (* 2 k))))
                 (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
                 (gn-emit (enc-add-r r 17 16))
                 ;; a bounded table's base points at its item -base (t2-dt-adj)
                 (cond-> (not= adj 0) (t2-addk r r adj)))]
      ;; an inlined decision tree replaces a call: its table setup is not counted by the size rule
      (t2-e-tabs (if (= dt 1) (t2-s M1 t2-s-vsize (+ (t2-g M1 t2-s-vsize) (- (vector-at M1 MM-CODE-N) at))) M1) (inc k)))))
;; parameters allocated away from their incoming x(k) (live across calls) move after the descriptors are read
;; parameters k >= 7 arrive in the caller's outgoing area at the entry sp + 8(k-7) (R4B); they load after every register
;; parameter has moved (value order), past the callee-saved pairs and the frame pushed since entry
(defn- t2-param-moves [M :vector-i64 v :i64] :vector-i64
  (if (> v (t2-g M t2-s-nv)) M
    (t2-param-moves (if (= (t2-op-of M v) t2-param)
                      (let [r (t2-vf M v t2-f-reg) k (t2-vf M v t2-f-a)]
                        (cond (and (>= k 7) (>= r 0))
                              (gn-emit M (enc-ldr r 31 (+ (* 8 (- k 7)) (* 16 (t2-g M t2-s-ncs)) (if (> (t2-g M t2-s-ncalls) 0) 16 0)
                                                          (t2-g M t2-s-frame))))
                              ;; a spilled register parameter: to its slot (a spilled stack parameter stays where it is)
                              (and (< k 7) (t2-spilled? M v)) (t2-stloc M k (t2-loc M v))
                              (and (>= r 0) (not= r k)) (gn-mov M r k)
                              :else M))
                      M)
                    (inc v))))
;; T2's label range [lab0, lab0 + 9 nb + 170) (t2-l-dstub and below): cleared before emission, so labels it reserves but
;; does not define read 0 like never-defined labels, and cleared again on rollback, so no position of the discarded code
;; survives in the label table (post-emission passes treat every label position as a branch target)
(defn- t2-labclear [M :vector-i64 l :i64 hi :i64] :vector-i64
  (if (>= l hi) M (t2-labclear (gn-put M (+ MM-LABEL-BASE l) 0) (inc l) hi)))
;; ---- admission of functions with descriptor refreshes ----
;; Static size is a poor proxy where T2 trades the old code's per-access handle revalidation (about 13 words: its
;; descriptor cache does not survive calls) for descriptor refreshes after calls (about 10 words each) and its own call
;; overhead (the fuel register stored before and reloaded after a call, x7 reloaded: 3 words). Over the code that runs
;; repeatedly (the blocks reaching a back edge; every block when the function does not loop): gain = 13 accesses -
;; 10 refreshes - 3 non-tail calls. A function with refreshes there needs gain >= 0; a looping one may then also keep a
;; body up to twice the old one (its extra words are inlined callees, calls removed).
;; blocks that reach a back edge (scratch: kd + maxb, free after emission)
(defn- t2-inloop [M :vector-i64 changed :i64 iter :i64] :vector-i64
  (if (or (= changed 0) (> iter 300)) M
    (let [r (loop [b 0 m M ch 0]
              (if (>= b (t2-g m t2-s-nb)) (t2-s m t2-s-last ch)
                (let [t (t2-bget m t2-a-bt b) fl (t2-bget m t2-a-bf b)
                      reach (and (= (t2-bget m t2-a-breach b) 1)
                                 (or (and (>= t 0) (or (<= t b) (= (t2-bget m (+ t2-a-kd t2-maxb) t) 1)))
                                     (and (>= fl 0) (or (<= fl b) (= (t2-bget m (+ t2-a-kd t2-maxb) fl) 1)))))]
                  (if (and reach (not= (t2-bget m (+ t2-a-kd t2-maxb) b) 1)) (recur (inc b) (t2-bset m (+ t2-a-kd t2-maxb) b 1) 1)
                    (recur (inc b) m ch)))))]
      (t2-inloop r (t2-last r) (inc iter)))))
;; refreshes after non-tail call v (as t2-e-redesc emits them)
(defn- t2-nrefresh [M :vector-i64 v :i64] :i64
  (loop [k 0 n 0]
    (if (>= k (t2-g M t2-s-nslot)) n
      (recur (inc k) (if (cond (and (= (t2-g M (+ t2-a-cls v)) (inc k)) (= (t2-alias-arg M v) 0)) (t2-dlive-after? M v v)
                               (not (t2-mcd? M (t2-vf M v t2-f-a))) false
                               :else (or (and (= (t2-g M (+ t2-a-cls v)) (inc k)) (t2-dlive-after? M v v))
                                         (> (t2-live-member M k v) 0)))
                       (inc n) n)))))
;; region counts: accesses + 4096 refreshes + 16777216 non-tail calls
(defn- t2-hstats [M :vector-i64 lp :bool] :i64
  (let [M0 (if lp (t2-inloop (t2-wzero M (+ t2-a-kd t2-maxb) 0 t2-maxb) 1 0) (t2-wfill M (+ t2-a-kd t2-maxb) 0 t2-maxb 1))]
    (loop [v 1 a 0 r 0 c 0]
      (if (> v (t2-g M0 t2-s-nv)) (+ a (* 4096 r) (* 16777216 c))
        (let [op (t2-op-of M0 v)]
          (cond (or (t2-gone? M0 v) (not= (t2-bget M0 (+ t2-a-kd t2-maxb) (t2-vf M0 v t2-f-blk)) 1)) (recur (inc v) a r c)
                (or (= op t2-vat) (= op t2-vset)) (recur (inc v) (inc a) r c)
                (and (= op t2-call) (not (t2-tailcall? M0 v (t2-bget M0 t2-a-bv1 (t2-vf M0 v t2-f-blk)))))
                (recur (inc v) a (+ r (t2-nrefresh M0 v)) (inc c))
                :else (recur (inc v) a r c)))))))
;; 1: no refresh in the region, 2: gain >= 0, 0: gain < 0
(defn- t2-hgain [M :vector-i64 lp :bool] :i64
  (if (or (= (t2-g M t2-s-hc) 0) (= (t2-g M t2-s-nslot) 0)) 1
    (let [st (t2-hstats M lp) a (bit-and st 4095) r (bit-and (i64-shift-right st 12) 4095) c (i64-shift-right st 24)]
      (cond (= r 0) 1 (>= (- (* 13 a) (+ (* 10 r) (* 3 c))) 0) 2 :else 0))))
;; keep T2's body only when it is smaller than the old body (whose words end where T2 starts) and its refreshes pay, or
;; when it is a looping function whose refreshes pay and its body is less than twice the old one; else roll back
(defn- t2-size-ok? [M :vector-i64 body :i64 old :i64 credit :i64] :bool
  (let [lp (t2-loops? M (inc (t2-g M t2-s-p))) g (t2-hgain M lp)]
    (or (and (< body (+ old credit)) (> g 0))
        (and (= g 2) lp (< body (* 2 old))))))
(defn- t2-emit [M :vector-i64 f :i64] :vector-i64
  (let [old (gn-fnf M f FF-CODE) entry0 (vector-at M MM-CODE-N) fixn (vector-at M MM-FIX-N) labn (vector-at M MM-LABEL-N)
        entry entry0
        hoffn (t2-g M t2-a-hoff)
        ;; (and the unrolled groups' labels after the descriptor / string stub labels: t2-l-ubase)
        ;; (then 16 cell-guard labels: t2-l-ucell)
        lhi (+ (t2-g M t2-s-lab0) (* 13 (t2-g M t2-s-nb)) (if (t2-has-sd? M) 332 204))
        M1 (t2-emit1 (t2-labclear M (t2-g M t2-s-lab0) lhi) f)
        ;; inlined callee code may grow the body (credit: a word per inlined op, two for a constant-argument specialization)
        body (- (t2-g M1 t2-s-bodyend) entry (t2-g M1 t2-s-vsize) (t2-g M1 t2-s-inlops))]
    ;; a kernel with (search) tight loops is replaced only by call-free T2 code, and only when it also prepays fuel (a
    ;; plain search-loop kernel may be the helper another kernel's fused code relies on)
    ;; (a self call trusted x8r from the pre-scan: the emitted tail calls must agree, else roll back)
    (if (and (t2-ok? M1) (t2-size-ok? M1 body (- entry0 old) (t2-g M1 t2-s-credit))
             (not (and (= (t2-g M1 t2-s-selfx8r) 1) (= (t2-g M1 t2-s-tailbad) 1)))
             (or (= (t2-g M1 t2-s-tight) 0) (and (= (t2-g M1 t2-s-hascall) 0) (= (t2-g M1 t2-s-weak) 1))))
      (-> M1 (t2-s (+ t2-a-st f) 1) (t2-s (+ t2-a-x8r f) (if (= (t2-g M1 t2-s-tailbad) 0) 1 0))
          ;; AUX 2 (the caller keeps the counter in x8 only) needs a callee that never grows the stack before its next
          ;; publication: no frame and no saved registers, so a host stack exhaustion never reads a stale counter
          ;; AUX 2 keeping the caller's store (3): any other callee whose +1 is its fuel load -- memory is already exact
          (t2-s (+ t2-a-hent f) (cond (and (= (t2-g M1 t2-s-hent) 1) (= (t2-g M1 t2-s-pub) 1) (= (t2-g M1 t2-s-defer) 1)
                                           (= (t2-g M1 t2-s-fuel) 1) (= (t2-g M1 t2-s-ncalls) 0) (= (t2-g M1 t2-s-ncs) 0)
                                           (= (t2-g M1 t2-s-frame) 0))
                                      2
                                      (and (= (t2-g M1 t2-s-hent) 1) (= (t2-g M1 t2-s-fuel) 1)) 3
                                      :else (t2-g M1 t2-s-hent))))
      ;; rollback: the discarded FIX records' handoff entries go too
      (-> M1 (t2-labclear (t2-g M1 t2-s-lab0) lhi) (gn-put MM-CODE-N entry0) (gn-put MM-FIX-N fixn) (gn-put MM-LABEL-N labn)
          (t2-s t2-a-hoff hoffn)
          (gn-put (+ MM-FN-BASE (* f MM-FN-W) FF-CODE) old) (t2-s (+ t2-a-st f) 2)))))
(def t2-s-bodyend 29)
(defn- t2-emit1 [M :vector-i64 f :i64] :vector-i64
  (let [nb (t2-g M t2-s-nb) entry (vector-at M MM-CODE-N)
        M1 (-> M (t2-s t2-s-nstub 0) (t2-s t2-s-ndst 0) (t2-s t2-s-selfx8r (if (t2-tails-ok? M 0) 1 2))
               (t2-s t2-s-frame (t2-frame-size M)) (t2-s t2-s-spadj 0)
               (cond-> (and (> (t2-g M t2-s-ncalls) 0) (t2-has-sd? M)) (-> (t2-wzero t2-a-sneed 0 nb) (t2-sneed 0)))
               ;; x5 is a parameter register from the sixth parameter on: the private-entry marker only below that
               ;; (from 4 parameters on the marker is x11, of T2's own handoff to such callees)
               (cond-> (<= (t2-g M t2-s-np) 3) (gn-emit (enc-movz 5 0 0)))
               (cond-> (and (> (t2-g M t2-s-np) 3) (<= (t2-g M t2-s-np) 7)) (gn-emit (enc-movz 11 0 0)))
               (cond-> (= (t2-g M t2-s-fuel) 1) (gn-emit (enc-ldr 8 7 CTX-FUEL)))
               (cond-> (> (t2-g M t2-s-ncalls) 0) (-> (gn-emit (enc-stp-pre 29 30 31 -16)) (gn-emit (enc-mov-sp 29 31))))
               (t2-save 0 (t2-g M t2-s-ncs))
               (cond-> (> (t2-frame-size M) 0) (gn-emit (enc-sub-i 31 31 (t2-frame-size M))))
               (cond-> (> (t2-g M t2-s-ncalls) 0) (gn-emit (enc-str 7 31 0)))
               (t2-e-descs 0) (t2-e-sdescs 0) (t2-e-tabs 0) (t2-param-moves 1)
               (t2-s t2-s-bchb 0) (t2-bch-plan 0) (t2-dthread 0) (t2-rgn-plan) (t2-e-blocks 0))
        M2a (-> (t2-s M1 t2-s-bodyend (vector-at M1 MM-CODE-N)) (t2-e-colds 0) (t2-e-rcolds 0) (t2-e-stubs 0) (t2-e-cdesc) (t2-e-dstubs 0))
        M2 (-> M2a (t2-e-sstubs 0 (t2-smask M2a)) (t2-e-tstubs 0))
        lu (t2-lab M2 nb)]
    (-> M2 (t2-deflab lu) (gn-emit (gn-e-udf))
        (t2-deflab (+ lu 1)) (gn-emit (enc-brk 0))
        (t2-deflab (+ lu 2)) (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))
        (gn-emit (enc-brk 1))
        (gn-put MM-LABEL-N (cond (or (> (t2-g M2 t2-s-nunr) 0) (> (t2-g M2 t2-s-ncg) 0)) (+ (t2-l-uhi M2) 16)
                                 (> (t2-g M2 t2-s-nsl) 0) (t2-l-sx M2 (t2-g M2 t2-s-nsl)) :else (t2-l-dstub M2 (t2-g M2 t2-s-ndst))))
        (gn-put (+ MM-FN-BASE (* f MM-FN-W) FF-CODE) entry))))
;; ---- driver -------------------------------------------------------------------------------------------------------------
;; T2 is a size-budgeted tier (like the post-emission passes' uqd-counts gate): programs above t2-max-sir SIR records
;; (the compiler itself) keep the existing backend only, bounding code size and compile time.
(def t2-on 1)
(def t2-spill-on 1)
;; at the FN of f (ordinary path): remember the FIX fill so t2-end can read f's own fixups
(defn- t2-fn-mark [M :vector-i64 f :i64] :vector-i64
  (let [M0 (gn-put M t2-mark-cell f)]
    (if (or (= t2-on 0) (> (vector-at M0 MM-SIR-N) t2-max-sir)) M0
      (let [M1 (t2-ready M0)] (if (> (t2-base M1) 0) (t2-s M1 t2-s-fix0 (vector-at M1 MM-FIX-N)) M1)))))
(def t2-max-sir 131072)
(def t2-mark-cell 99)   ; FN index whose ordinary gn-op-fn2 path ran last (0 = none)
;; old code words [a, b) are a STRONG certified kernel, which T2 does not replace: SIMD/FP, byte loads, a tight loop (memory
;; access without context loads: descriptors and fuel hoisted), or an unrolled run (12 memory accesses without a branch).
;; A kernel that only prepays fuel and still reloads context/fuel in its loops is weaker than T2's versioned loops.
;; A kernel can also say so outright: the keep marker HINT #127 (architecturally a NOP; place it off the hot path, e.g. after
;; an unconditional branch). T2 then neither replaces the function nor inlines it into callers (status 4).
(def t2-keepw 0xD5032FFF)
(defn- t2-keep? [M :vector-i64 a :i64 b :i64] :bool
  (and (< a b) (or (= (vector-at M (+ MM-CODE-BASE a)) t2-keepw) (t2-keep? M (inc a) b))))
(defn- t2-kword? [w :i64] :bool
  (or (= w t2-keepw) (= (bit-and (u64-shift-right w 25) 7) 7) (= (bit-and (u64-shift-right w 25) 7) 6)
      (= (bit-and w 0xFFC00000) 0x39400000) (= (bit-and w 0xFFE00C00) 0x38600800)))
;; a prepaid-fuel word (sub/subs/cmp x8|x16, #k >= 2): the old code is a (weak) certified kernel
(defn- t2-prepw? [w :i64] :bool
  (let [k (bit-and (u64-shift-right w 10) 4095) m (bit-and w 0xFF8003FF)]
    (and (>= k 2) (or (= m 0xD1000108) (= m 0xF1000108) (= m 0xD1000210) (= m 0xF1000210) (= m 0xF100011F) (= m 0xF100021F)))))
(defn- t2-prepaid? [M :vector-i64 a :i64 b :i64] :bool
  (and (< a b) (or (t2-prepw? (vector-at M (+ MM-CODE-BASE a))) (t2-prepaid? M (inc a) b))))
;; cmp x8, xm: the fuel counter against a computed need (x16 is also a scratch, so only x8): a prepaid kernel too, which
;; only refuses real calls to small loop-free helpers its fast path may have inlined (t2-s-weakr; t2-s-weak also admits
;; replacing tight kernels)
(defn- t2-prepaid-r? [M :vector-i64 a :i64 b :i64] :bool
  (and (< a b) (or (= (bit-and (vector-at M (+ MM-CODE-BASE a)) 0xFFE0FFFF) 0xEB00011F) (t2-prepaid-r? M (inc a) b))))
(def t2-s-weakr 73)
(def t2-s-weak 54)
(defn- t2-memw? [w :i64] :bool
  (let [base (bit-and (u64-shift-right w 5) 31)]
    (and (not= base 7) (not= base 31)
         (or (= (bit-and w 0x3B000000) 0x39000000) (= (bit-and w 0x3B200C00) 0x38200800) (= (bit-and w 0x3A000000) 0x28000000)))))
(defn- t2-brw? [w :i64] :bool
  (or (= (bit-and w 0xFC000000) 0x14000000) (= (bit-and w 0xFC000000) 0x94000000) (= (bit-and w 0xFF000010) 0x54000000)
      (= (bit-and w 0x7E000000) 0x34000000) (= (bit-and w 0x7E000000) 0x36000000) (= (bit-and w 0xFFFFFC1F) 0xD65F0000)))
;; signed branch displacement (words) of a b / b.cond / cbz / cbnz word, 0 when w is not one
(defn- t2-bdisp [w :i64] :i64
  (cond (= (bit-and w 0xFC000000) 0x14000000)
        (let [x (bit-and w 0x3FFFFFF)] (if (>= x 0x2000000) (- x 0x4000000) x))
        (or (= (bit-and w 0xFF000010) 0x54000000) (= (bit-and w 0x7E000000) 0x34000000))
        (let [x (bit-and (u64-shift-right w 5) 0x7FFFF)] (if (>= x 0x40000) (- x 0x80000) x))
        :else 0))
;; 64-bit ldr/str (unsigned offset or register offset) and its base register, -1 otherwise
(defn- t2-ldst-base [w :i64] :i64
  (if (or (= (bit-and w 0xFFC00000) 0xF9400000) (= (bit-and w 0xFFC00000) 0xF9000000)
          (= (bit-and w 0xFFE00C00) 0xF8600800) (= (bit-and w 0xFFE00C00) 0xF8200800))
    (bit-and (u64-shift-right w 5) 31) -1))
;; loop body [t, a] has a memory access but no context load ([x7,#..]): descriptors already hoisted by old code
(defn- t2-tight-loop? [M :vector-i64 t :i64 a :i64 mem :bool] :bool
  (if (> t a) mem
    ;; any 64-bit load/store, single or pair (ldp/stp copy loops count)
    (let [w (vector-at M (+ MM-CODE-BASE t))
          r (cond (>= (t2-ldst-base w) 0) (t2-ldst-base w)
                  (= (bit-and w 0x3A000000) 0x28000000) (bit-and (u64-shift-right w 5) 31)
                  :else -1)]
      (cond (= r 7) false
            (and (>= r 0) (not= r 31)) (t2-tight-loop? M (inc t) a true)
            :else (t2-tight-loop? M (inc t) a mem)))))
;; STRONG kernels are kept: SIMD/FP, byte loads (other than string reads), unrolled runs, or a COUNTED tight loop
;; (no context loads; T2's versioned loops do not unroll or strength-reduce yet). A kernel whose tight loops are all
;; SEARCH loops (an exit on a compare of a value loaded in the loop) is replaced only by call-free T2 code.
;; ex: F reads string code points (itself or through a direct callee). Strings are the only byte-addressed data of the
;; old code (vectors and tables hold words), so its byte loads are string reads -- the inline code point fast path, or
;; a kernel's inlined copy of it -- which T2 performs as cheaply, not a byte kernel
(defn- t2-kernel? [M :vector-i64 a :i64 b :i64 ex :bool] :bool (t2-kernel2? M a a b 0 ex))
(defn- t2-cpa-ldrb? [M :vector-i64 a :i64 w :i64] :bool
  (or (= (bit-and w 0xFFC00000) 0x39400000) (= (bit-and w 0xFFE00C00) 0x38600800)))
(defn- t2-reads-cp? [M :vector-i64 i :i64] :bool
  (let [op (gn-op M i) g (gn-sir M i IF-A)]
    (cond (or (= op OP-END) (= op 0)) false
          (and (= op OP-RT) (= g RT-STRING-CODE-POINT-AT)) true
          (and (= op OP-CALL) (> g 0) (< g (vector-at M MM-FN-N)) (> (gn-fnf M g FF-SIR) 0)
               (< (gn-fnf M g FF-SIR) (vector-at M MM-SIR-N)) (= (gn-op M (gn-fnf M g FF-SIR)) OP-FN)
               (= (bit-and (t2-str-ops M (inc (gn-fnf M g FF-SIR)) 0) 2) 2)) true
          :else (t2-reads-cp? M (inc i)))))
(defn- t2-kernel2? [M :vector-i64 s :i64 a :i64 b :i64 run :i64 ex :bool] :bool
  (if (>= a b) false
    (let [w (vector-at M (+ MM-CODE-BASE a)) d (t2-bdisp w)]
      (cond (and (t2-kword? w) (not (and ex (t2-cpa-ldrb? M a w)))) true
            (and (< d 0) (>= (+ a d) s) (t2-tight-loop? M (+ a d) a false) (not (t2-search-loop? M (+ a d) a 0))) true
            (t2-brw? w) (t2-kernel2? M s (inc a) b 0 ex)
            (t2-memw? w) (or (>= run 11) (t2-kernel2? M s (inc a) b (inc run) ex))
            :else (t2-kernel2? M s (inc a) b run ex)))))
;; F's body reads strings (string-length / pair-second, string-code-point-at): which (1, 2 bits)
(defn- t2-str-ops [M :vector-i64 i :i64 acc :i64] :i64
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) acc
          (and (= op OP-RT) (= (gn-sir M i IF-A) RT-PAIR-SECOND)) (t2-str-ops M (inc i) (bit-or acc 1))
          (and (= op OP-RT) (= (gn-sir M i IF-A) RT-STRING-CODE-POINT-AT)) (t2-str-ops M (inc i) (bit-or acc 2))
          :else (t2-str-ops M (inc i) acc))))
;; words [t, a] (a: the backward branch) hold a compare of a register loaded in the loop followed by a conditional
;; branch other than the back branch. lm: mask of registers loaded so far
(defn- t2-search-loop? [M :vector-i64 t :i64 a :i64 lm :i64] :bool
  (and (< t a)
       (let [w (vector-at M (+ MM-CODE-BASE t)) nx (vector-at M (+ MM-CODE-BASE (inc t)))
             ld (and (>= (t2-ldst-base w) 0) (not= (bit-and w 0x00400000) 0))
             ldp (and (= (bit-and w 0x3A000000) 0x28000000) (not= (bit-and w 0x00400000) 0))
             lm2 (cond ld (bit-or lm (i64-shift-left 1 (bit-and w 31)))
                       ldp (bit-or lm (bit-or (i64-shift-left 1 (bit-and w 31)) (i64-shift-left 1 (bit-and (u64-shift-right w 10) 31))))
                       :else lm)
             cmp (or (= (bit-and w 0xFF20001F) 0xEB00001F) (= (bit-and w 0xFF80001F) 0xF100001F))
             rn (bit-and (u64-shift-right w 5) 31) rm (bit-and (u64-shift-right w 16) 31)
             uses (or (not= (bit-and lm (i64-shift-left 1 rn)) 0)
                      (and (= (bit-and w 0xFF20001F) 0xEB00001F) (not= (bit-and lm (i64-shift-left 1 rm)) 0)))]
         (or (and cmp uses (< (inc t) a) (= (bit-and nx 0xFF000010) 0x54000000))
             (t2-search-loop? M (inc t) a lm2)))))
;; the old code has a (search) tight loop
(defn- t2-tight? [M :vector-i64 s :i64 a :i64 b :i64] :bool
  (and (< a b)
       (let [d (t2-bdisp (vector-at M (+ MM-CODE-BASE a)))]
         (or (and (< d 0) (>= (+ a d) s) (t2-tight-loop? M (+ a d) a false)) (t2-tight? M s (inc a) b)))))
(def t2-s-tight 63)
(defn- t2-clear-defs [M :vector-i64 var :i64 nvar :i64 nb :i64] :vector-i64
  (if (>= var nvar) M (t2-clear-defs (t2-wzero M (+ t2-a-def (* var t2-maxb)) 0 nb) (inc var) nvar nb)))
(defn- t2-ok? [M :vector-i64] :bool (= (t2-g M t2-s-fail) 0))
;; sp = 1: spill mode (part4c), a retry after running out of registers
(defn- t2-compile [M :vector-i64 p0 :i64 end0 :i64 f :i64 pub :i64 lvl :i64 sp :i64] :vector-i64
  (let [fix0 (t2-g M t2-s-fix0)
        weak (if (t2-prepaid? M (gn-fnf M f FF-CODE) (vector-at M MM-CODE-N)) 1 0)
        weakr (if (t2-prepaid-r? M (gn-fnf M f FF-CODE) (vector-at M MM-CODE-N)) 1 0)
        tight (if (t2-tight? M (gn-fnf M f FF-CODE) (gn-fnf M f FF-CODE) (vector-at M MM-CODE-N)) 1 0)
        MX (t2-expand (-> M (t2-wzero 0 0 128) (t2-wzero t2-a-sx 0 8) (t2-s t2-s-f f) (t2-s t2-s-fix0 fix0) (t2-s t2-s-weak weak) (t2-s t2-s-weakr weakr) (t2-s t2-s-tight tight) (t2-s t2-s-xlvl lvl) (t2-s t2-s-spill sp)) p0 end0 f pub)
        p (t2-g MX t2-s-p) end (t2-g MX t2-s-end)
        np (gn-fnf M f FF-NPARAMS)
        ns (t2-g MX t2-s-xnsmax)
        dp (t2-g MX t2-s-xdp)
        nvar (+ ns 1 dp)]
    (if (or (not= (t2-g MX t2-s-fail) 0) (>= nvar t2-maxvar) (> np 16)) M
      (let [M1 (-> MX (t2-s t2-s-np np) (t2-s t2-s-ns ns) (t2-s t2-s-pub pub) (t2-s t2-s-nvar nvar) (t2-wzero t2-a-pd 0 64)
                   (t2-wzero t2-a-sd 0 64) (t2-cfg))]
        (if (or (not (t2-ok? M1)) (> (t2-bget M1 t2-a-bpn 0) 0)) M
          (let [M2 (-> M1 (t2-clear-defs 0 nvar (t2-g M1 t2-s-nb)) (t2-build 0) (t2-gvn) (t2-reassoc))]
            (if (not (t2-ok? M2)) M
              (let [nv (t2-g M2 t2-s-nv)
                    M3 (-> M2 (t2-clear-x 1 nv) (t2-hcflag 1 nv) (t2-uses 1 nv) (t2-dce nv) (t2-objs nv) (t2-handles nv))]
                (if (not (t2-ok? M3)) M
                  (let [M4 (-> M3 (t2-thread-snap 0) (t2-tuse 0) (t2-chk) (t2-fuse 0) (t2-tfuse 0) (t2-sfuse 0) (t2-mfuse 1 nv) (t2-positions 0 1))]
                    (if (not (t2-ok? M4)) M
                      (let [M5 (-> M4 (t2-ue-all 0) (t2-liveness 0) (cond-> (= (t2-g M4 t2-s-hc) 1) (-> (t2-cls-interf 0) (t2-descliveness))))]
                        (if (not (t2-ok? M5)) M
                          (let [M6 (-> M5 (t2-iv-vals 1 nv) (t2-iv-blocks 0) (t2-regalloc))
                                cs (gn-max (t2-maxcs M6 1 nv 18) (t2-maxcs-fixed M6 18))
                                ncs (if (>= cs 19) (inc (quot (- cs 19) 2)) 0)
                                labels-ok (< (+ (vector-at M6 MM-LABEL-N) (* 13 (t2-g M6 t2-s-nb)) (if (t2-has-sd? M6) 332 204)) MM-LABEL-CAP)]
                            (if (or (not (t2-ok? M6)) (not labels-ok)) M
                              (t2-emit (-> M6 (t2-s t2-s-ncs ncs) (t2-s t2-s-lab0 (vector-at M6 MM-LABEL-N)) (t2-freach) (t2-fuelplan) (t2-loopplan)) f))))))))))))))))
;; F's old code branches to a label outside its own body (code shared with a twin/clone): T2 would lose that path
(defn- t2-xfn-jump? [M :vector-i64 k :i64 lo :i64 hi :i64] :bool
  (if (>= k (vector-at M MM-FIX-N)) false
    (let [b (+ MM-FIX-BASE (* k MM-FIX-W)) kind (vector-at M (+ b XF-KIND)) l (vector-at M (+ b XF-TARGET))
          pos (if (and (> l 0) (< l MM-LABEL-CAP)) (vector-at M (+ MM-LABEL-BASE l)) -1)]
      (if (and (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19) (= kind FX-ADRL19)) (or (< pos lo) (>= pos hi)))
        true
        (t2-xfn-jump? M (inc k) lo hi)))))
;; a call site the certified-private-path post-pass (cpp) specializes from F's old code: T2 would lose it
(defn- t2-cpp-site? [M :vector-i64 j :i64 end :i64] :bool
  (cond (>= j end) false
        (and (= (gn-op M j) OP-CALL) (cpp-literal M j (gn-sir M j IF-A) (gn-sir M j IF-B) (gn-sir M j IF-C))) true
        :else (t2-cpp-site? M (inc j) end)))
;; ---- interprocedural facts: semantic, so valid whichever code (old or T2) runs ----
;; MCD[g] = 1: g may change a vector descriptor or a string (it allocates, grows, copies, calls a host capability or an
;; unknown function), itself or through its calls; 0: it only reads and writes items in place. Least fixpoint from 0 over
;; the whole program's SIR, computed once when the scratch block is made.
(defn- t2-safe-rt? [a :i64] :bool
  (or (= a RT-VECTOR-AT) (= a RT-VECTOR-ASSOC-IN-PLACE) (= a RT-VECTOR-COUNT) (= a RT-PAIR-FIRST) (= a RT-PAIR-SECOND)
      (= a RT-STRING-CODE-POINT-AT)))
(defn- t2-mcd-scan [M :vector-i64 i :i64] :i64
  (let [op (gn-op M i)]
    (cond (or (= op OP-END) (= op 0)) 0
          (or (= op OP-CONST) (= op OP-LGET) (= op OP-LSET) (= op OP-BIN) (= op OP-CMP) (= op OP-UN) (= op OP-LABEL)
              (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ) (= op OP-FUEL) (= op OP-RET) (= op OP-TRAP) (= op OP-TAB))
          (t2-mcd-scan M (inc i))
          (and (= op OP-RT) (t2-safe-rt? (gn-sir M i IF-A))) (t2-mcd-scan M (inc i))
          (= op OP-CALL) (let [h (gn-sir M i IF-A)]
                           (if (and (> h 0) (< h (vector-at M MM-FN-N)) (< h MM-FN-CAP) (= (t2-g M (+ t2-a-mcd h)) 0))
                             (t2-mcd-scan M (inc i)) 1))
          :else 1)))
(defn- t2-mcd-pass [M :vector-i64 g :i64 changed :i64] :vector-i64
  (if (or (>= g (vector-at M MM-FN-N)) (>= g MM-FN-CAP)) (t2-s M t2-s-last changed)
    (if (= (t2-g M (+ t2-a-mcd g)) 1) (t2-mcd-pass M (inc g) changed)
      (let [p (gn-fnf M g FF-SIR)
            x (if (and (> p 0) (< p (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) g)) (t2-mcd-scan M (inc p)) 1)]
        (if (= x 1) (t2-mcd-pass (t2-s M (+ t2-a-mcd g) 1) (inc g) 1) (t2-mcd-pass M (inc g) changed))))))
(defn- t2-mcd-init [M :vector-i64] :vector-i64
  (let [M0 (-> M (t2-wzero t2-a-mcd 0 MM-FN-CAP) (t2-wzero t2-a-ret0 0 MM-FN-CAP) (t2-s t2-a-mcd 1))]
    (loop [m M0 i 0]
      (if (>= i 4096) (t2-wfill m t2-a-mcd 0 MM-FN-CAP 1)   ; not converged: every function may
        (let [m1 (t2-mcd-pass m 1 0)] (if (= (t2-last m1) 1) (recur m1 (inc i)) m1))))))
(defn- t2-mcd? [M :vector-i64 g :i64] :bool
  (or (<= g 0) (>= g MM-FN-CAP) (>= g (vector-at M MM-FN-N)) (not= (t2-g M (+ t2-a-mcd g)) 0)))
;; ---- least vector lengths (whole program, semantic) ----
;; No operation shortens a live vector in place (drop, assoc and conj make
;; new handles or grow). Scalar arena-scope results cannot carry a released
;; handle out. A live vector at least n long stays so. PMIN[f][k] (k < 4): the least length
;; of parameter k over every call of the private function f (0 unknown); RMIN[f]: of its result. Greatest fixpoint from
;; "no call seen" over the SIR: a call argument's length comes from its temp's definition in the straight run before
;; the call (no LABEL between): LGET of a slot (the least over the slot's parameter value and every LSET into it),
;; vector-alloc of a constant size, vector literals, the vector argument of an in-place assoc, a copy or conj (as long),
;; a call's RMIN; anything else 0.
(defn- t2-ml-def [M :vector-i64 p :i64 j :i64 t :i64] :i64   ; the op that may write temp t before j in its run, 0 none,
  (cond (<= j p) 0                                                ; -k: the run starts at the LABEL k
        (= (gn-op M j) OP-LABEL) (- 0 j)
        ;; the destination field per op (as lw-hi / the interpreter); an op not listed may write any temp it names
        (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
          (cond (or (= op OP-LSET) (= op OP-BR) (= op OP-BRZ) (= op OP-BRNZ) (= op OP-FUEL) (= op OP-RET) (= op OP-RET2)
                    (= op OP-TRAP) (= op 27)) false
                (or (= op OP-CONST) (= op OP-LGET) (= op OP-STR) (= op OP-TAB) (= op OP-FADDR) (= op OP-VECP) (= op OP-VEC)
                    (= op OP-RES2) (= op 28) (= op 30)) (= a t)
                (or (= op OP-BIN) (= op OP-CMP) (= op OP-UN) (= op OP-RT) (= op OP-CALL) (= op OP-CALLI)) (= b t)
                (= op OP-CAP) (= c t)
                :else (or (= a t) (= b t) (= c t))))
        j
        :else (t2-ml-def M p (dec j) t)))
(defn- t2-ml-val [M :vector-i64 p :i64 f :i64 j :i64 t :i64 d :i64] :i64   ; least length of temp t right before op j
  (let [k (if (> d 20) 0 (t2-ml-def M p (dec j) t)) op (if (> k 0) (gn-op M k) 0) a (if (> k 0) (gn-sir M k IF-A) 0)
        b (if (> k 0) (gn-sir M k IF-B) 0)]
    (cond (= k 0) 0
          (< k 0) (if (> d 16) 0 (t2-ml-join M p f (- 0 k) t (+ d 2) 0))
          (and (= op OP-LGET) (= a t)) (t2-ml-slot M p f b)
          (and (= op OP-VEC) (= a t)) (gn-max 0 b)
          (and (= op OP-VECP) (= a t)) (gn-max 0 (gn-sir M k IF-C))
          (not (and (or (= op OP-CALL) (= op OP-RT)) (= b t))) 0
          (= op OP-CALL) (if (and (> a 0) (< a MM-FN-CAP) (< a (vector-at M MM-FN-N))) (t2-g M (+ t2-a-rmin a)) 0)
          (and (= op OP-RT) (= a RT-VECTOR-ALLOC)) (t2-ml-kv M p f k t (inc d))
          (and (= op OP-RT) (or (= a RT-VECTOR-ASSOC-IN-PLACE) (= a RT-VECTOR-ASSOC) (= a RT-VECTOR-CONJ)))
          (t2-ml-val M p f k t (inc d))
          :else 0)))
;; the least value temp t can have right before op j when every definition reaching it is a constant (else 0, never < 0)
(defn- t2-ml-kv [M :vector-i64 p :i64 f :i64 j :i64 t :i64 d :i64] :i64
  (let [c (if (> d 20) 0 (t2-ml-def M p (dec j) t))]
    (cond (= c 0) 0
          (< c 0) (if (> d 16) 0 (t2-ml-join M p f (- 0 c) t (+ d 2) 1))
          (and (= (gn-op M c) OP-CONST) (= (gn-sir M c IF-A) t)) (gn-max 0 (gn-sir M c IF-B))
          :else 0)))
;; the value range of temp t right before op j: constants, a slot's range (scratch t2-a-hmin[256 + s]: its parameter
;; range and every LSET into it), joins, and bit-and with a constant mask m >= 0 ([0, m]); else every value. (No other
;; arithmetic: the ranges stay unions of the program's constants, so the fixpoint is finite.)
(defn- t2-mr-val [M :vector-i64 p :i64 f :i64 j :i64 t :i64 d :i64] :i64
  (let [c (if (> d 20) 0 (t2-ml-def M p (dec j) t)) op (if (> c 0) (gn-op M c) 0)
        a (if (> c 0) (gn-sir M c IF-A) 0) b (if (> c 0) (gn-sir M c IF-B) 0)]
    (cond (= c 0) t2-rg-unk
          (< c 0) (if (> d 16) t2-rg-unk (t2-ml-join M p f (- 0 c) t (+ d 2) 2))
          (and (= op OP-CONST) (= a t)) (t2-rg-k b)
          (and (= op OP-LGET) (= a t))
          (if (and (> b 0) (< b 256) (<= b (gn-sir M p IF-C))) (t2-g M (+ t2-a-hmin 256 b)) t2-rg-unk)
          (and (= op OP-BIN) (= b t) (= a BOP-AND))
          (let [kx (t2-ml-kv1 M p f c t d) ky (t2-ml-kv1 M p f c (inc t) d)]
            (cond (>= ky 0) (t2-rg 0 (gn-min ky 2147483647)) (>= kx 0) (t2-rg 0 (gn-min kx 2147483647)) :else t2-rg-unk))
          :else t2-rg-unk)))
;; temp t right before op j when it is one constant k >= 0 in its run: k, else -1
(defn- t2-ml-kv1 [M :vector-i64 p :i64 f :i64 j :i64 t :i64 d :i64] :i64
  (let [c (t2-ml-def M p (dec j) t)]
    (if (and (> c 0) (= (gn-op M c) OP-CONST) (= (gn-sir M c IF-A) t) (>= (gn-sir M c IF-B) 0)) (gn-sir M c IF-B) -1)))
;; temp t at the LABEL k: over its fall-through predecessor and every branch to it, the least (mode 0: vector length,
;; 1: constant value) or the union (mode 2: value range)
(defn- t2-ml-at [M :vector-i64 p :i64 f :i64 j :i64 t :i64 d :i64 mode :i64] :i64
  (cond (= mode 0) (t2-ml-val M p f j t d) (= mode 1) (t2-ml-kv M p f j t d) :else (t2-mr-val M p f j t d)))
(defn- t2-ml-comb [m :i64 x :i64 mode :i64] :i64 (if (= mode 2) (t2-rg-union m x) (gn-min m x)))
(defn- t2-ml-join [M :vector-i64 p :i64 f :i64 k :i64 t :i64 d :i64 mode :i64] :i64
  (let [L (gn-sir M k IF-A) po (gn-op M (dec k))
        m0 (if (or (= po OP-BR) (= po OP-RET) (= po OP-RET2) (= po OP-TRAP)) t2-mlinf (t2-ml-at M p f k t d mode))
        r (loop [q (inc p) m m0]
            (if (or (if (= mode 2) (= m t2-rg-unk) (<= m 0)) (>= q (vector-at M MM-SIR-N)) (= (gn-op M q) OP-END)) m
              (let [op (gn-op M q)]
                (recur (inc q) (if (or (and (= op OP-BR) (= (gn-sir M q IF-A) L)) (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= (gn-sir M q IF-B) L)))
                                 (t2-ml-comb m (t2-ml-at M p f q t d mode) mode) m)))))]
    r))   ; (still "no call seen" while the fixpoint runs; an unreached LABEL stays so)
;; slot s of f: its parameter value (slot k + 1 is parameter k) and every LSET into it (scratch t2-a-hmin[s])
(defn- t2-ml-slot [M :vector-i64 p :i64 f :i64 s :i64] :i64
  (if (and (> s 0) (< s 256) (<= s (gn-sir M p IF-C))) (t2-g M (+ t2-a-hmin s)) 0))
(defn- t2-ml-slots [M :vector-i64 p :i64 f :i64] :vector-i64
  (let [ns (gn-sir M p IF-C) np (gn-sir M p IF-B)
        M0 (loop [s 1 m M] (if (or (> s ns) (>= s 256)) m
                             (recur (inc s) (-> m (t2-s (+ t2-a-hmin s) (cond (> s np) t2-mlinf (<= s 4) (t2-g m (+ t2-a-pmin (* 4 f) (dec s))) :else 0))
                                                (t2-s (+ t2-a-hmin 256 s) (cond (> s np) t2-mlinf (<= s 8) (t2-g m (+ t2-a-prng (* 8 f) (dec s))) :else t2-rg-unk))))))]
    (loop [m M0 it 0]
      (if (>= it 8) (loop [s 1 mm m] (if (or (> s ns) (>= s 256)) (t2-s mm t2-s-last 0)
                                       (recur (inc s) (-> mm (t2-s (+ t2-a-hmin s) 0) (t2-s (+ t2-a-hmin 256 s) t2-rg-unk)))))
        (let [r (loop [j (inc p) mm m ch 0]
                  (if (or (>= j (vector-at mm MM-SIR-N)) (= (gn-op mm j) OP-END)) (t2-s mm t2-s-last ch)
                    (if (= (gn-op mm j) OP-LSET)
                      (let [s (gn-sir mm j IF-A) t (gn-sir mm j IF-B)]
                        (if (and (> s 0) (< s 256) (<= s ns))
                          (let [x (t2-ml-val mm p f j t 0) old (t2-g mm (+ t2-a-hmin s))
                                ro (t2-g mm (+ t2-a-hmin 256 s)) rn (t2-rg-union ro (t2-mr-val mm p f j t 0))
                                m1 (if (< x old) (t2-s mm (+ t2-a-hmin s) x) mm)
                                m2 (if (not= rn ro) (t2-s m1 (+ t2-a-hmin 256 s) rn) m1)]
                            (recur (inc j) m2 (if (or (< x old) (not= rn ro)) 1 ch)))
                          (recur (inc j) mm ch)))
                      (recur (inc j) mm ch))))]
          (if (= (t2-last r) 1) (recur r (inc it)) (t2-s r t2-s-last 0)))))))
;; one pass over every function: arguments into callees' PMIN, returns into RMIN; M[last] = 1 when something dropped
(defn- t2-ml-lower [M :vector-i64 x :i64 v :i64] :vector-i64 (if (< v (t2-g M x)) (-> M (t2-s x v) (t2-s t2-s-last 1)) M))
(defn- t2-ml-widen [M :vector-i64 x :i64 r :i64] :vector-i64   ; parameter range x joins r; M[last] = 1 when it grew
  (let [o (t2-g M x) n (t2-rg-union o r)] (if (not= n o) (-> M (t2-s x n) (t2-s t2-s-last 1)) M)))
(defn- t2-ml-unknown [M :vector-i64 g :i64] :vector-i64   ; g's parameters and result: unknown
  (let [x (+ t2-a-pmin (* 4 g))
        M1 (-> M (t2-ml-lower x 0) (t2-ml-lower (+ x 1) 0) (t2-ml-lower (+ x 2) 0) (t2-ml-lower (+ x 3) 0) (t2-ml-lower (+ t2-a-rmin g) 0))]
    (loop [k 0 m M1] (if (>= k 8) m (recur (inc k) (t2-ml-widen m (+ t2-a-prng (* 8 g) k) t2-rg-unk))))))
(defn- t2-ml-fn [M :vector-i64 f :i64] :vector-i64
  (let [p (gn-fnf M f FF-SIR)]
    (if (or (<= p 0) (>= p (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN) (not= (gn-sir M p IF-A) f))
      (t2-ml-unknown M f)
      (let [M0 (t2-ml-slots M p f)]
        (loop [j (inc p) m M0]
          (if (or (>= j (vector-at m MM-SIR-N)) (= (gn-op m j) OP-END)) m
            (let [op (gn-op m j) a (gn-sir m j IF-A) b (gn-sir m j IF-B) c (gn-sir m j IF-C)]
              (recur (inc j)
                     (cond (or (= op OP-RET) (= op OP-RET2)) (t2-ml-lower m (+ t2-a-rmin f) (t2-ml-val m p f j a 0))
                           (and (= op OP-CALL) (> a 0) (< a MM-FN-CAP) (< a (vector-at m MM-FN-N)))
                           (loop [k 0 mm m] (if (or (>= k c) (>= k 8)) mm
                                              (recur (inc k) (cond-> (t2-ml-widen mm (+ t2-a-prng (* 8 a) k) (t2-mr-val mm p f j (+ b k) 0))
                                                               (< k 4) (t2-ml-lower (+ t2-a-pmin (* 4 a) k) (t2-ml-val mm p f j (+ b k) 0))))))
                           (= op OP-FADDR) (if (and (>= b 0) (< b MM-FN-CAP)) (t2-ml-unknown m b) m)
                           :else m)))))))))
;; passes alternate ascending and descending FN order: arguments flow to callees and results to callers, so a long call
;; chain settles in one pass of each direction
(defn- t2-ml-pass [M :vector-i64 f :i64 step :i64 changed :i64] :vector-i64
  (if (or (< f 0) (>= f (gn-min (vector-at M MM-FN-N) MM-FN-CAP))) (t2-s M t2-s-last changed)
    (let [M1 (t2-ml-fn (t2-s M t2-s-last 0) f)] (t2-ml-pass M1 (+ f step) step (if (= (t2-last M1) 1) 1 changed)))))
(defn- t2-ml-init [M :vector-i64] :vector-i64
  (let [n (gn-min (vector-at M MM-FN-N) MM-FN-CAP)
        ;; private functions start at "no call seen", everything else (public, lambdas, adapters) unknown
        M0 (loop [f 0 m M] (if (>= f MM-FN-CAP) m
                             (recur (inc f) (let [v (if (and (< f n) (= (gn-fnf m f FF-KIND) FK-PRIV) (not (lw-tmpl? m f)) (not (lw-spec? m f)))
                                                      t2-mlinf 0)]
                                              (-> m (t2-wfill (+ t2-a-pmin (* 4 f)) 0 4 v) (t2-s (+ t2-a-rmin f) v)
                                                  (t2-wfill (+ t2-a-prng (* 8 f)) 0 8 (if (= v 0) t2-rg-unk t2-mlinf)))))))]
    (loop [m M0 i 0]
      (if (>= i 64) (-> m (t2-wzero t2-a-pmin 0 (* 4 MM-FN-CAP)) (t2-wzero t2-a-rmin 0 MM-FN-CAP)   ; no fixpoint: nothing known
                        (t2-wfill t2-a-prng 0 (* 8 MM-FN-CAP) t2-rg-unk))
        (let [m1 (if (= (bit-and i 1) 0) (t2-ml-pass m 0 1 0) (t2-ml-pass m (dec n) -1 0))]
          (if (= (t2-last m1) 1) (recur m1 (inc i)) m1))))))
;; ---- returns its parameter-0 vector (semantic RET0, whole program): every RET of f returns the very handle f got as
;; parameter 0 -- through slot 1 (only assigned such handles), in-place assoc results, calls of RET0 functions on it, joins.
;; Greatest fixpoint from "yes" over the SIR (any function whose code is known); T2 compiles may still prove more.
;; Slot flags in scratch t2-a-hmin[512 + s]: 1 the parameter-0 handle, 0 not known to be, 2 not assigned yet.
(defn- t2-r0-val [M :vector-i64 p :i64 f :i64 j :i64 t :i64 d :i64] :i64
  (let [c (if (> d 20) 0 (t2-ml-def M p (dec j) t)) op (if (> c 0) (gn-op M c) 0)
        a (if (> c 0) (gn-sir M c IF-A) 0) b (if (> c 0) (gn-sir M c IF-B) 0)]
    (cond (= c 0) 0
          (< c 0) (if (> d 16) 0 (t2-r0-join M p f (- 0 c) t (+ d 2)))
          (and (= op OP-LGET) (= a t)) (if (and (> b 0) (< b 256) (<= b (gn-sir M p IF-C))) (t2-g M (+ t2-a-hmin 512 b)) 0)
          (and (= op OP-RT) (= b t) (= a RT-VECTOR-ASSOC-IN-PLACE)) (t2-r0-val M p f c t (inc d))
          (and (= op OP-CALL) (= b t) (> a 0) (< a MM-FN-CAP) (< a (vector-at M MM-FN-N)) (>= (gn-sir M c IF-C) 1)
               (= (t2-g M (+ t2-a-ret0 a)) 1))
          (t2-r0-val M p f c t (inc d))
          :else 0)))
(defn- t2-r0-and [m :i64 x :i64] :i64 (cond (= m 2) x (= x 2) m (and (= m 1) (= x 1)) 1 :else 0))
(defn- t2-r0-join [M :vector-i64 p :i64 f :i64 k :i64 t :i64 d :i64] :i64
  (let [L (gn-sir M k IF-A) po (gn-op M (dec k))
        m0 (if (or (= po OP-BR) (= po OP-RET) (= po OP-RET2) (= po OP-TRAP)) 2 (t2-r0-val M p f k t d))]
    (loop [q (inc p) m m0]
      (if (or (= m 0) (>= q (vector-at M MM-SIR-N)) (= (gn-op M q) OP-END)) m
        (let [op (gn-op M q)]
          (recur (inc q) (if (or (and (= op OP-BR) (= (gn-sir M q IF-A) L)) (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= (gn-sir M q IF-B) L)))
                           (t2-r0-and m (t2-r0-val M p f q t d)) m)))))))
;; RET0 of f under the current facts (1 / 0)
(defn- t2-r0-fn [M :vector-i64 f :i64] :vector-i64
  (let [p (gn-fnf M f FF-SIR)]
    (if (or (<= p 0) (>= p (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN) (not= (gn-sir M p IF-A) f) (< (gn-sir M p IF-B) 1)
            (lw-spec? M f) (lw-tmpl? M f))
      (t2-s M t2-s-last 0)
      (let [ns (gn-sir M p IF-C)
            M0 (loop [s 1 m M] (if (or (> s ns) (>= s 256)) m (recur (inc s) (t2-s m (+ t2-a-hmin 512 s) (if (= s 1) 1 (if (<= s (gn-sir M p IF-B)) 0 2))))))
            ;; slot flags: AND over every LSET (to a fixpoint)
            M1 (loop [m M0 it 0]
                 (if (>= it 8) (loop [s 1 mm m] (if (or (> s ns) (>= s 256)) mm (recur (inc s) (t2-s mm (+ t2-a-hmin 512 s) 0))))
                   (let [r (loop [j (inc p) mm m ch 0]
                             (if (or (>= j (vector-at mm MM-SIR-N)) (= (gn-op mm j) OP-END)) (t2-s mm t2-s-last ch)
                               (if (= (gn-op mm j) OP-LSET)
                                 (let [s (gn-sir mm j IF-A)]
                                   (if (and (> s 0) (< s 256) (<= s ns))
                                     (let [o (t2-g mm (+ t2-a-hmin 512 s)) n (t2-r0-and o (t2-r0-val mm p f j (gn-sir mm j IF-B) 0))]
                                       (if (not= n o) (recur (inc j) (t2-s mm (+ t2-a-hmin 512 s) n) 1) (recur (inc j) mm ch)))
                                     (recur (inc j) mm ch)))
                                 (recur (inc j) mm ch))))]
                     (if (= (t2-last r) 1) (recur r (inc it)) r))))
            ok (loop [j (inc p) any 0]
                 (if (or (>= j (vector-at M1 MM-SIR-N)) (= (gn-op M1 j) OP-END)) any
                   (let [op (gn-op M1 j)]
                     (cond (= op OP-RET2) 0
                           (= op OP-RET) (if (= (t2-r0-val M1 p f j (gn-sir M1 j IF-A) 0) 1) (recur (inc j) 1) 0)
                           :else (recur (inc j) any)))))]
        (t2-s M1 t2-s-last ok)))))
(defn- t2-r0-pass [M :vector-i64 f :i64 step :i64 changed :i64] :vector-i64
  (if (or (< f 0) (>= f (gn-min (vector-at M MM-FN-N) MM-FN-CAP))) (t2-s M t2-s-last changed)
    (if (= (t2-g M (+ t2-a-ret0 f)) 0) (t2-r0-pass M (+ f step) step changed)
      (let [M1 (t2-r0-fn M f)]
        (if (= (t2-last M1) 1) (t2-r0-pass M1 (+ f step) step changed)
          (t2-r0-pass (t2-s M1 (+ t2-a-ret0 f) 0) (+ f step) step 1))))))
(defn- t2-r0-init [M :vector-i64] :vector-i64
  (let [n (gn-min (vector-at M MM-FN-N) MM-FN-CAP)
        M0 (-> M (t2-wzero t2-a-ret0 0 MM-FN-CAP) (t2-wfill t2-a-ret0 1 n 1) (t2-wzero t2-a-x8r 0 MM-FN-CAP))]
    (loop [m M0 i 0]
      (if (>= i 64) (t2-wzero m t2-a-ret0 0 MM-FN-CAP)
        (let [m1 (if (= (bit-and i 1) 0) (t2-r0-pass m 0 1 0) (t2-r0-pass m (dec n) -1 0))]
          (if (= (t2-last m1) 1) (recur m1 (inc i)) m1))))))
;; at the END of FN f (SIR index i): re-compile with T2 when admitted
(defn- t2-end [M :vector-i64 i :i64 f :i64] :vector-i64
  (if (or (= t2-on 0) (> (vector-at M MM-SIR-N) t2-max-sir) (<= f 0) (>= f (vector-at M MM-FN-N)) (not= (vector-at M t2-mark-cell) f)) M
    (let [p (gn-fnf M f FF-SIR) k (gn-fnf M f FF-KIND) np (gn-fnf M f FF-NPARAMS)]
      (if (and (> p 0) (< p i) (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f)
               (or (= k FK-DEFN) (= k FK-PRIV)) (not (lw-tmpl? M f)) (not (lw-spec? M f)) (not (gn-clamp-open M f))
               ;; a string-reading clone (negative export: a twin with a private return protocol) keeps its old code
               (or (>= (gn-fnf M f FF-EXPORT) 0) (= (t2-str-ops M (inc p) 0) 0))
               (not (gn-chain-target M f))   ; private-entry chain ABI targets keep the existing backend
               (or (= (cpp-plan M) 0) (not (t2-cpp-site? M (inc p) i)))
               (or (= (t2-base M) 0) (not (t2-xfn-jump? M (t2-g M t2-s-fix0) (gn-fnf M f FF-CODE) (vector-at M MM-CODE-N))))
               (or (and (= (gn-g M gn-f-leaf) 1) (or (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-fuel) 0)))
                   (= (gn-g M gn-f-leaf) 0))
               (< (- i p) t2-maxops) (<= np 16) (= (gn-sir M p IF-B) np)
               (t2-xops-ok? M (inc p))
               (not (t2-kernel? M (gn-fnf M f FF-CODE) (vector-at M MM-CODE-N) (t2-reads-cp? M (inc p)))))
        (let [M0 (t2-ready M)]
          (if (= (t2-base M0) 0) M0
            (let [lit0 (vector-at M0 MM-LIT-N) litb0 (vector-at M0 MM-LITB-N)
                  pub (if (= (gn-g M gn-f-leaf) 0) 1 0)
                  Ma (t2-compile M0 p i f pub 0 0)
                  ;; (the scratch is updated in place: read the first failure before retrying)
                  fa (t2-g Ma t2-s-fail)
                  ;; out of registers: spill mode (part4c t2-sp-alloc) with full inlining first
                  oor (and (= t2-spill-on 1) (or (= fa 13) (= fa 14)))
                  Ms (if (and oor (not= (t2-g Ma (+ t2-a-st f)) 1))
                       (t2-compile (-> Ma (gn-put MM-LIT-N lit0) (gn-put MM-LITB-N litb0)) p i f pub 0 1) Ma)
                  ;; out of expansion buffer: once more, each expansion leaving room for the rest of F
                  Mb (if (and (not= (t2-g Ma (+ t2-a-st f)) 1) (= fa 21))
                       (t2-compile (-> Ma (gn-put MM-LIT-N lit0) (gn-put MM-LITB-N litb0)) p i f pub 2 0) Ms)
                  ;; out of registers and not applied in spill mode, or the buffer retry refused too: once more, inlining only
                  ;; small callees; then that in spill mode
                  M1a (if (and (not= (t2-g Mb (+ t2-a-st f)) 1) (or (= fa 13) (= fa 14) (= fa 21)) (or oor (not= (t2-g Mb t2-s-fail) 0)))
                        (t2-compile (-> Mb (gn-put MM-LIT-N lit0) (gn-put MM-LITB-N litb0)) p i f pub 1 0)
                        Mb)
                  f1 (t2-g M1a t2-s-fail)
                  M1 (if (and oor (not= (t2-g M1a (+ t2-a-st f)) 1) (or (= f1 13) (= f1 14)))
                       (t2-compile (-> M1a (gn-put MM-LIT-N lit0) (gn-put MM-LITB-N litb0)) p i f pub 1 1)
                       M1a)
                  ;; literal tables made for a function T2 does not apply are dropped again
                  M2 (if (= (t2-g M1 (+ t2-a-st f)) 1) M1 (-> M1 (gn-put MM-LIT-N lit0) (gn-put MM-LITB-N litb0)))]
              (if (and (= (t2-g M2 (+ t2-a-st f)) 0) (not= (t2-g M2 t2-s-fail) 0))
                (t2-s M2 (+ t2-a-st f) (+ 100 (t2-g M2 t2-s-fail))) M2))))
        (cond (and (> p 0) (< p i) (t2-keep? M (gn-fnf M f FF-CODE) (vector-at M MM-CODE-N)))
              (let [M0 (t2-ready M)] (if (> (t2-base M0) 0) (t2-s M0 (+ t2-a-st f) 4) M0))
              (and (> (t2-base M) 0) (> p 0) (< p i) (t2-xops-ok? M (inc p))
                   (t2-kernel? M (gn-fnf M f FF-CODE) (vector-at M MM-CODE-N) (t2-reads-cp? M (inc p))))
              (t2-s M (+ t2-a-st f) 3)
              :else M)))))
;; ==== END T2 =========================================================================================================
