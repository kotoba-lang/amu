           (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-hs))
           (gn-dot-patch b6 end (enc-cond-hs))
           (gn-put (+ MM-CODE-BASE bf) (enc-cbnz 9 (- failed bf)))
           (gn-put (+ MM-CODE-BASE bd) (enc-b (- done bd)))))))

;; Guarded exact closed forward-copy leaf; original fallback and fuel remain.
;; General closed two-accumulator stride-two literal/vector dot recurrence.
;; Original entry paid before this hook. All guards preserve original fallback;
;; successful prepayment covers two closed table entries and one backedge per step.
(defn- d2-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
       exit (gn-sir M (+ p 24) IF-A) n (gn-sir M (+ p 4) IF-B)
       oa (gn-sir M (+ p 8) IF-B) sh (gn-sir M (+ p 12) IF-B)
       helper (gn-sir M (+ p 43) IF-A)]
  (if (= k 85) true
   (and (case k
    0 (gn-dot-at? M (+ p 0) OP-FN f 6 10)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 3 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP 1 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-CONST 1 oa 0)
    9 (gn-dot-at? M (+ p 9) OP-LGET 2 2 0)
    10 (gn-dot-at? M (+ p 10) OP-BIN 1 1 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 2 5 0)
    12 (gn-dot-at? M (+ p 12) OP-CONST 3 sh 0)
    13 (gn-dot-at? M (+ p 13) OP-BIN 10 2 0)
    14 (gn-dot-at? M (+ p 14) OP-RT 208 0 3)
    15 (gn-dot-at? M (+ p 15) OP-LSET 7 0 0)
    16 (gn-dot-at? M (+ p 16) OP-LGET 0 7 0)
    17 (gn-dot-at? M (+ p 17) OP-CONST 1 (inc oa) 0)
    18 (gn-dot-at? M (+ p 18) OP-LGET 2 2 0)
    19 (gn-dot-at? M (+ p 19) OP-BIN 1 1 0)
    20 (gn-dot-at? M (+ p 20) OP-LGET 2 6 0)
    21 (gn-dot-at? M (+ p 21) OP-CONST 3 sh 0)
    22 (gn-dot-at? M (+ p 22) OP-BIN 10 2 0)
    23 (gn-dot-at? M (+ p 23) OP-RT 208 0 3)
    24 (gn-dot-at? M (+ p 24) OP-BR exit 0 0)
    25 (gn-dot-at? M (+ p 25) OP-LABEL body 0 0)
    26 (gn-dot-at? M (+ p 26) OP-LGET 0 1 0)
    27 (gn-dot-at? M (+ p 27) OP-LGET 1 2 0)
    28 (gn-dot-at? M (+ p 28) OP-LGET 2 3 0)
    29 (gn-dot-at? M (+ p 29) OP-BIN 1 1 0)
    30 (gn-dot-at? M (+ p 30) OP-CONST 2 1 0)
    31 (gn-dot-at? M (+ p 31) OP-BIN 1 1 0)
    32 (gn-dot-at? M (+ p 32) OP-RT 176 0 2)
    33 (gn-dot-at? M (+ p 33) OP-LSET 7 0 0)
    34 (gn-dot-at? M (+ p 34) OP-LGET 0 1 0)
    35 (gn-dot-at? M (+ p 35) OP-LGET 1 2 0)
    36 (gn-dot-at? M (+ p 36) OP-LGET 2 3 0)
    37 (gn-dot-at? M (+ p 37) OP-BIN 1 1 0)
    38 (gn-dot-at? M (+ p 38) OP-CONST 2 2 0)
    39 (gn-dot-at? M (+ p 39) OP-BIN 1 1 0)
    40 (gn-dot-at? M (+ p 40) OP-RT 176 0 2)
    41 (gn-dot-at? M (+ p 41) OP-LSET 8 0 0)
    42 (gn-dot-at? M (+ p 42) OP-LGET 0 3 0)
    43 (gn-dot-at? M (+ p 43) OP-CALL helper 0 1)
    44 (gn-dot-at? M (+ p 44) OP-LSET 9 0 0)
    45 (gn-dot-at? M (+ p 45) OP-LGET 0 3 0)
    46 (gn-dot-at? M (+ p 46) OP-CONST 1 1 0)
    47 (gn-dot-at? M (+ p 47) OP-BIN 1 0 0)
    48 (gn-dot-at? M (+ p 48) OP-CALL helper 0 1)
    49 (gn-dot-at? M (+ p 49) OP-LSET 10 0 0)
    50 (gn-dot-at? M (+ p 50) OP-LGET 0 1 0)
    51 (gn-dot-at? M (+ p 51) OP-LGET 1 2 0)
    52 (gn-dot-at? M (+ p 52) OP-LGET 2 3 0)
    53 (gn-dot-at? M (+ p 53) OP-CONST 3 2 0)
    54 (gn-dot-at? M (+ p 54) OP-BIN 1 2 0)
    55 (gn-dot-at? M (+ p 55) OP-LGET 3 8 0)
    56 (gn-dot-at? M (+ p 56) OP-LGET 4 5 0)
    57 (gn-dot-at? M (+ p 57) OP-LGET 5 4 0)
    58 (gn-dot-at? M (+ p 58) OP-LGET 6 9 0)
    59 (gn-dot-at? M (+ p 59) OP-BIN 3 5 0)
    60 (gn-dot-at? M (+ p 60) OP-BIN 1 4 0)
    61 (gn-dot-at? M (+ p 61) OP-LGET 5 7 0)
    62 (gn-dot-at? M (+ p 62) OP-LGET 6 10 0)
    63 (gn-dot-at? M (+ p 63) OP-BIN 3 5 0)
    64 (gn-dot-at? M (+ p 64) OP-BIN 1 4 0)
    65 (gn-dot-at? M (+ p 65) OP-LGET 5 6 0)
    66 (gn-dot-at? M (+ p 66) OP-LGET 6 7 0)
    67 (gn-dot-at? M (+ p 67) OP-LGET 7 9 0)
    68 (gn-dot-at? M (+ p 68) OP-BIN 3 6 0)
    69 (gn-dot-at? M (+ p 69) OP-BIN 1 5 0)
    70 (gn-dot-at? M (+ p 70) OP-LGET 6 8 0)
    71 (gn-dot-at? M (+ p 71) OP-LGET 7 10 0)
    72 (gn-dot-at? M (+ p 72) OP-BIN 3 6 0)
    73 (gn-dot-at? M (+ p 73) OP-BIN 1 5 0)
    74 (gn-dot-at? M (+ p 74) OP-LSET 1 0 0)
    75 (gn-dot-at? M (+ p 75) OP-LSET 2 1 0)
    76 (gn-dot-at? M (+ p 76) OP-LSET 3 2 0)
    77 (gn-dot-at? M (+ p 77) OP-LSET 4 3 0)
    78 (gn-dot-at? M (+ p 78) OP-LSET 5 4 0)
    79 (gn-dot-at? M (+ p 79) OP-LSET 6 5 0)
    80 (gn-dot-at? M (+ p 80) OP-FUEL 0 0 0)
    81 (gn-dot-at? M (+ p 81) OP-BR head 0 0)
    82 (gn-dot-at? M (+ p 82) OP-LABEL exit 0 0)
    83 (gn-dot-at? M (+ p 83) OP-RET 0 0 0)
    84 (gn-dot-at? M (+ p 84) OP-END f 0 0)
    false) (d2-shape M p f (inc k))))))
(defn- d2-regs [M :vector-i64 s :i64] :bool
 (if (= s 7) true
  (and (>= (gn-sreg M s) 19) (<= (gn-sreg M s) 28) (d2-regs M (inc s)))))
(defn- d2-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i) f (gn-sir M p IF-A)]
  (if (or (<= p 0) (>= (+ p 84) (vector-at M MM-SIR-N))
          (not= (gn-op M p) OP-FN) (<= f 0) (>= f (vector-at M MM-FN-N))
          (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
          (not= (gn-g M gn-f-h) 0) (gn-clamp-open M f)) 0
   (let [n (gn-sir M (+ p 4) IF-B) oa (gn-sir M (+ p 8) IF-B)
         sh (gn-sir M (+ p 12) IF-B) helper (gn-sir M (+ p 43) IF-A)
         lit (tb-shape M helper) h (gn-sir M (+ p 2) IF-A)
         b (gn-sir M (+ p 6) IF-B) e (gn-sir M (+ p 24) IF-A)]
    (if (and (> lit 0) (= (gn-fnf M f FF-SIR) p)
         (= (gn-fnf M f FF-NPARAMS) 6) (= (gn-fnf M f FF-NSLOTS) 10)
         (= (gn-fnf M f FF-DEPTH) 8) (= (gn-fnf M f FF-PT0) TY-VEC)
         (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
         (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
         (= (ck-pt M f 5) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
         (> n 0) (<= n 64) (= (bit-and n 1) 0)
         (<= (* n 8) (gn-litf M lit LF-LEN))
         (>= oa 0) (< oa 4095) (>= sh 0) (<= sh 63)
         (> h 0) (< h MM-LABEL-CAP) (> b 0) (< b MM-LABEL-CAP)
         (> e 0) (< e MM-LABEL-CAP) (not= h b) (not= h e) (not= b e)
         (= (gn-lpos M h) (+ p 2)) (= (gn-lpos M b) (+ p 25))
         (= (gn-lpos M e) (+ p 82)) (d2-regs M 1) (d2-shape M p f 0)) lit 0)))))
(defn- d2-expand [M :vector-i64 j :i64 n :i64] :vector-i64 (d2-expand2 M j n 1))
;; d2-expand2 over named registers: items from base b (x[0] first in x0r, then alternating with x11), the table from
;; t, the sums in a0/a1
(defn- d2-expand-r [M :vector-i64 j :i64 n :i64 prev :i64 x0r :i64 b :i64 t :i64 a0 :i64 a1 :i64] :vector-i64
 (if (= j n) M
  (let [other (if (= prev x0r) 11 x0r)]
   (d2-expand-r (-> M (gn-emit (enc-ldp 10 other b (* 8 (inc j)))) (gn-emit (enc-ldp 12 13 t (* 8 j)))
                      (gn-emit (enc-madd a0 prev 12 a0)) (gn-emit (enc-madd a0 10 13 a0))
                      (gn-emit (enc-madd a1 10 12 a1)) (gn-emit (enc-madd a1 other 13 a1)))
                (+ j 2) n other x0r b t a0 a1))))
;; prev: the register holding item j (x1 first); the step's last item lands in the other of x1/x11 (no move)
(defn- d2-expand2 [M :vector-i64 j :i64 n :i64 prev :i64] :vector-i64
 (if (= j n) M
  (let [other (if (= prev 1) 11 1)]
   (d2-expand2 (-> M (gn-emit (enc-ldp 10 other 4 (* 8 (inc j))))
                     (gn-emit (enc-ldp 12 13 5 (* 8 j)))
                     (gn-emit (enc-madd 2 prev 12 2)) (gn-emit (enc-madd 2 10 13 2))
                     (gn-emit (enc-madd 3 10 12 3)) (gn-emit (enc-madd 3 other 13 3)))
               (+ j 2) n other))))
;; pre: before the frame (kpre-entry), parameters in x0..x5: the descriptor length lives in x6 (x0 is v), the
;; accumulator inputs move to x1..x3 only after the last guard and after the item address (which needs j in x1)
;; is formed in x6; the entry charge joins the cost; plain ret
(defn- d2-entry [M :vector-i64 i :i64] :vector-i64 (d2-entry2 M i false))
(defn- d2-entry2 [M :vector-i64 i :i64 pre :bool] :vector-i64
 (let [lit (d2-admit M i)]
  (if (= lit 0) M
   (let [p (dec i) n (gn-sir M (+ p 4) IF-B) oa (gn-sir M (+ p 8) IF-B)
         sh (gn-sir M (+ p 12) IF-B) top (if (> n (inc oa)) n (inc oa))
         cost (* 3 (quot n 2)) rv (kp M pre 1) rj (kp M pre 2)
         ri (kp M pre 3) rx (kp M pre 4) ra (kp M pre 5) rb (kp M pre 6) L (if pre 6 0)
         m0 (gn-emit M (enc-cmp-i ri 0)) b0 (vector-at m0 MM-CODE-N)
         m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0))
                    (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 (if pre (inc cost) cost)))) b1 (vector-at m1 MM-CODE-N)
         m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
                    (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
                    (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
         m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
                    (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
                    (gn-emit (enc-ldp 17 L 16 0))
                    (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r L 16))) b3 (vector-at m3 MM-CODE-N)
         m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
                    (gn-emit (enc-cmp-i L top))) b4 (vector-at m4 MM-CODE-N)
         m5 (-> m4 (gn-emit (enc-bcond 9 0))
                    (gn-emit (enc-sub-i 16 L top)) (gn-emit (enc-cmp-r rj 16))) b5 (vector-at m5 MM-CODE-N)
         ;; pre: no moves; x6 = &v[j], x1 = the table (j is dead once x6 is formed), the sums stay in x4/x5 and x[0]
         ;; in x3; the shifts take their immediate
         m6 (if pre
              (-> (gn-emit m5 (enc-bcond (enc-cond-hs) 0))
                  (gn-emit (enc-ldr 6 7 328)) (gn-emit (gn-e-addsl 6 6 17 3)) (gn-emit (gn-e-addsl 6 6 rj 3))
                  (gn-emit (enc-ldr 1 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
                  (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1)) (gn-emit (enc-add-r 1 1 16))
                  (d2-expand-r 0 n 3 3 6 1 4 5) (gn-emit (gn-e-asr 4 4 sh)) (gn-emit (gn-e-asr 5 5 sh))
                  (gn-emit (enc-sub-i 8 8 (inc cost))) (gn-emit (enc-str 8 7 CTX-FUEL))
                  (gn-emit (enc-str 4 6 (* oa 8))) (gn-emit (enc-str 5 6 (* (inc oa) 8))) (gn-emit (enc-ret)))
              (-> (gn-emit m5 (enc-bcond (enc-cond-hs) 0))
                  (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))
                  (gn-emit (gn-e-addsl 4 4 rj 3))
                  (gn-emit (enc-ldr 5 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
                  (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
                  (gn-emit (enc-add-r 5 5 16)) (gn-mov 1 rx) (gn-mov 2 ra) (gn-mov 3 rb)
                  (d2-expand 0 n) (gn-mov-imm 16 sh)
                  (gn-emit (enc-asrv 2 2 16)) (gn-emit (enc-asrv 3 3 16))
                  (gn-emit (enc-sub-i 8 8 cost)) (gn-emit (enc-str 8 7 CTX-FUEL))
                  (gn-emit (enc-str 2 4 (* oa 8))) (gn-emit (enc-str 3 4 (* (inc oa) 8)))
                  (gn-mov 0 rv) (gn-epilogue) (gn-gs gn-f-dead 0)))
         end (vector-at m6 MM-CODE-N)
         m7 (-> m6 (gn-dot-patch b0 end (enc-cond-ne)) (gn-dot-patch b1 end (enc-cond-lo))
           (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
           (gn-dot-patch b4 end 9) (gn-dot-patch b5 end (enc-cond-hs)))]
    (if pre m7 (gn-vclear m7))))))

;; ---- fir-red outer: (f s j) = (if (= j J) s (let [first (vector-at s j)] (f (g s j 0 first 0 0) (+ j S)))) with g
;; the d2 shape (fir-red-inner), the whole recursion before the frame. g's own shape, without the generator state
;; d2-admit also asks for (that state belongs to the function being emitted): its table literal, else 0
(defn- frs-inner [M :vector-i64 g :i64] :i64
 (if (or (<= g 0) (>= g (vector-at M MM-FN-N)) (gn-clamp-open M g)) 0
  (let [p (gn-fnf M g FF-SIR)]
   (if (or (<= p 0) (>= (+ p 84) (vector-at M MM-SIR-N))) 0
    (let [n (gn-sir M (+ p 4) IF-B) oa (gn-sir M (+ p 8) IF-B)
          sh (gn-sir M (+ p 12) IF-B) lit (tb-shape M (gn-sir M (+ p 43) IF-A)) h (gn-sir M (+ p 2) IF-A)
          b (gn-sir M (+ p 6) IF-B) e (gn-sir M (+ p 24) IF-A)]
     (if (and (> lit 0)
          (= (gn-fnf M g FF-NPARAMS) 6) (= (gn-fnf M g FF-NSLOTS) 10)
          (= (gn-fnf M g FF-PT0) TY-VEC) (= (gn-fnf M g (+ FF-PT0 1)) TY-I64) (= (gn-fnf M g (+ FF-PT0 2)) TY-I64)
          (= (gn-fnf M g (+ FF-PT0 3)) TY-I64) (= (gn-fnf M g (+ FF-PT0 4)) TY-I64)
          (= (ck-pt M g 5) TY-I64) (= (gn-fnf M g FF-RTYPE) TY-VEC)
          (> n 0) (<= n 64) (= (bit-and n 1) 0) (<= (* n 8) (gn-litf M lit LF-LEN))
          (>= oa 0) (< oa 4095) (>= sh 0) (<= sh 63)
          (fo-label? M h (+ p 2)) (fo-label? M b (+ p 25)) (fo-label? M e (+ p 82)) (not= h b) (not= h e) (not= b e)
          (d2-shape M p g 0)) lit 0))))))
(defn- frs-shape [M :vector-i64 p :i64 f :i64 g :i64 k :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B) exit (gn-sir M (+ p 8) IF-A)
       J (gn-sir M (+ p 4) IF-B) S (gn-sir M (+ p 22) IF-B)]
  (if (= k 31) true
   (and (case k
    0 (gn-dot-at? M p OP-FN f 2 3)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 2 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 J 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
    12 (gn-dot-at? M (+ p 12) OP-RT RT-VECTOR-AT 0 2)
    13 (gn-dot-at? M (+ p 13) OP-LSET 3 0 0)
    14 (gn-dot-at? M (+ p 14) OP-LGET 0 1 0)
    15 (gn-dot-at? M (+ p 15) OP-LGET 1 2 0)
    16 (gn-dot-at? M (+ p 16) OP-CONST 2 0 0)
    17 (gn-dot-at? M (+ p 17) OP-LGET 3 3 0)
    18 (gn-dot-at? M (+ p 18) OP-CONST 4 0 0)
    19 (gn-dot-at? M (+ p 19) OP-CONST 5 0 0)
    20 (gn-dot-at? M (+ p 20) OP-CALL g 0 6)
    21 (gn-dot-at? M (+ p 21) OP-LGET 1 2 0)
    22 (gn-dot-at? M (+ p 22) OP-CONST 2 S 0)
    23 (gn-dot-at? M (+ p 23) OP-BIN BOP-ADD 1 0)
    24 (gn-dot-at? M (+ p 24) OP-LSET 1 0 0)
    25 (gn-dot-at? M (+ p 25) OP-LSET 2 1 0)
    26 (gn-dot-at? M (+ p 26) OP-FUEL 0 0 0)
    27 (gn-dot-at? M (+ p 27) OP-BR head 0 0)
    28 (gn-dot-at? M (+ p 28) OP-LABEL exit 0 0)
    29 (gn-dot-at? M (+ p 29) OP-RET 0 0 0)
    30 (gn-dot-at? M (+ p 30) OP-END f 0 0)
    false) (frs-shape M p f g (inc k))))))
;; the inner's table literal when the whole function is the fir-red outer shape (J in 1..4095, S a power of two <= 64)
(defn- frs-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i) f (gn-sir M p IF-A)]
  (if (or (<= p 0) (>= (+ p 30) (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN)
          (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
   (let [J (gn-sir M (+ p 4) IF-B) S (gn-sir M (+ p 22) IF-B) g (gn-sir M (+ p 20) IF-A) lit (frs-inner M g)
         head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B) exit (gn-sir M (+ p 8) IF-A)]
    (if (and (> lit 0) (not= g f) (= (gn-fnf M f FF-SIR) p)
         (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-NSLOTS) 3)
         (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
         (>= J 1) (<= J 4095) (>= S 1) (<= S 64) (= (bit-and S (dec S)) 0)
         (fo-label? M head (+ p 2)) (fo-label? M body (+ p 9)) (fo-label? M exit (+ p 28))
         (not= head body) (not= head exit) (not= body exit)
         (frs-shape M p f g 0)) lit 0)))))
;; one inner call on x6 = &s[j], x3 = s[j], table x1: the sums start as products (x4, x5), the d2 order otherwise
(defn- frs-expand [M :vector-i64 j :i64 n :i64 prev :i64] :vector-i64
 (if (= j n) M
  (let [other (if (= prev 3) 11 3) z (= j 0)]
   (frs-expand (-> M (gn-emit (enc-ldp 10 other 6 (* 8 (inc j)))) (gn-emit (enc-ldp 12 13 1 (* 8 j)))
                     (gn-emit (if z (enc-mul 4 prev 12) (enc-madd 4 prev 12 4))) (gn-emit (enc-madd 4 10 13 4))
                     (gn-emit (if z (enc-mul 5 10 12) (enc-madd 5 10 12 5))) (gn-emit (enc-madd 5 other 13 5)))
               (+ j 2) n other))))
;; before the frame (kpre-entry): x0 = s (the result), x1 = j. Guards: 0 <= j < J, S divides J - j, fuel >= the
;; entry charge plus (2 + 3n/2) per call (g's entry, n/2 steps of two table reads and a back edge, the self call),
;; s live with every read (up to J - S + n) and store (up to oa + 1 + J - S) inside its length. Then one fuel
;; publication and the calls in order, x9 counting them; each call reads s[j] and its items after the previous
;; call's stores and stores its two results last, as g does.
(defn- frs-entry [M :vector-i64 i :i64] :vector-i64
 (let [lit (frs-admit M i)]
  (if (= lit 0) M
   (let [p (dec i) J (gn-sir M (+ p 4) IF-B) S (gn-sir M (+ p 22) IF-B) q (gn-fnf M (gn-sir M (+ p 20) IF-A) FF-SIR)
         n (gn-sir M (+ q 4) IF-B) oa (gn-sir M (+ q 8) IF-B) sh (gn-sir M (+ q 12) IF-B)
         per (+ 2 (* 3 (quot n 2))) r1 (+ (- J S) (inc n)) r2 (+ oa (- J S) 2) top (if (> r1 r2) r1 r2)
         G (vector-alloc 15)]
    (if (> top 4095) M
     (let [m0 (-> M (gn-emit (enc-cmp-i 1 J)) (ri-cold G (enc-cond-hs))
                (gn-mov-imm 9 J) (gn-emit (enc-sub-r 9 9 1))
                (cond-> (> S 1) (-> (gn-emit (gn-e-bf 0xf2400000 31 9 0 (dec (gn-pow2 S)))) (ri-cold G (enc-cond-ne))
                                    (gn-emit (gn-e-lsr 9 9 (gn-pow2 S)))))
                (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov-imm 16 per) (gn-emit (enc-mul 17 9 16))
                (gn-emit (enc-add-i 17 17 1)) (gn-emit (enc-cmp-r 8 17)) (ri-cold G (enc-cond-lo))
                (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
                (gn-emit (enc-sub-i 6 0 1)) (gn-emit (enc-cmp-r 6 16)) (ri-cold G (enc-cond-hs))
                (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 6 4)) (gn-emit (enc-ldp 6 4 16 0))
                (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 4 16)) (ri-cold G (enc-cond-hs))
                (gn-emit (enc-cmp-i 4 top)) (ri-cold G (enc-cond-lo))
                ;; every guard passed
                (gn-emit (enc-sub-r 8 8 17)) (gn-emit (enc-str 8 7 CTX-FUEL))
                (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 6 16 6 3)) (gn-emit (gn-e-addsl 6 6 1 3))
                (gn-emit (enc-ldr 1 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
                (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1)) (gn-emit (enc-add-r 1 1 16)))
           ;; NEON calls (both sums as two dots, interleaved) when the table is int32, n <= 32 (v16..v23) and every
           ;; store (from oa on) lies past every read (up to J - S + n); the items s[j0 .. j0 + (count - 1) S + n] checked
           neon (and (<= n 32) (>= oa r1) (nd-tab32? M lit n))
           mc (if neon (-> m0 (gn-mov 15 6) (gn-emit (enc-sub-i 14 9 1)) (cond-> (> S 1) (gn-emit (gn-e-lsl 14 14 (gn-pow2 S))))
                           (gn-emit (enc-add-i 14 14 (inc n))) (nd-check)) m0) bk (dec (vector-at mc MM-CODE-N))
           mt (if neon (nd-table mc 1 n) mc) nl (vector-at mt MM-CODE-N)
           mn (if neon (-> (loop [m (gn-emit mt (enc-add-i 11 6 8)) g 0]
                             (if (>= (* 4 g) n) m (recur (-> m (nd-g 6 g n 24 25 0) (nd-g 11 g n 26 27 5)) (inc g))))
                           (nd-sum 24 25 n 4) (nd-sum 26 27 n 5) (gn-emit (gn-e-asr 4 4 sh)) (gn-emit (gn-e-asr 5 5 sh))
                           (gn-emit (enc-str 4 6 (* 8 oa))) (gn-emit (enc-str 5 6 (* 8 (inc oa))))
                           (gn-emit (enc-add-i 6 6 (* 8 S))) (gn-emit (enc-subs-i 9 9 1))) mt) nb (vector-at mn MM-CODE-N)
           ms (if neon (-> mn (gn-emit (enc-bcond (enc-cond-ne) (- nl nb))) (gn-emit (enc-ret))) mn)
           loop (vector-at ms MM-CODE-N)
           m1 (-> (cond-> ms neon (gn-put (+ MM-CODE-BASE bk) (enc-cbnz 13 (- (vector-at ms MM-CODE-N) bk))))
                (gn-emit (enc-ldr 3 6 0)) (frs-expand 0 n 3)
                (gn-emit (gn-e-asr 4 4 sh)) (gn-emit (gn-e-asr 5 5 sh))
                (gn-emit (enc-str 4 6 (* 8 oa))) (gn-emit (enc-str 5 6 (* 8 (inc oa))))
                (gn-emit (enc-add-i 6 6 (* 8 S))) (gn-emit (enc-subs-i 9 9 1))) back (vector-at m1 MM-CODE-N)
           m2 (-> m1 (gn-emit (enc-bcond (enc-cond-ne) (- loop back))) (gn-emit (enc-ret)))
           cold (vector-at m2 MM-CODE-N)]
      (ri-patch m2 G 0 cold)))))))

;; ---- picojpeg idct pass: (f v columns i) = (if (= i 8) v (f (lane v (+ 1536 (if columns i (* i 8))) (if columns 8 1)
;; columns) columns (+ i 1))), lane the idct-lane shape: when s[1..7] of the lane are zero, the lane is filled with
;; i16(s0) (rows) or descale(s0) (columns); otherwise the 8-point IDCT with i16 wrapping, multiply-idct
;; (i16(floor((i16(x) * f + 128) / 256))) and, for columns, descale (clamp(floor((x + 64) / 128) + 128) to 0..255).
;; The whole pass runs before the frame. The SIRs of the pass, the lane and its helpers are packed patterns
;; (kpat-smatch; T[0] the function, T[k] its callees, i16's three constants as T[1..3]).
