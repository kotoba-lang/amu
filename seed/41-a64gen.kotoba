                  (kpat-match M (mmx-q M qn) [1688879924379649 18 4229300233 21474836484 12884967428 131078 4295032835 196615 277119879872523 17179869188 25769869316 131078 4295032835 196615 4228513801 276887951638539 21474836484 12884967428 131078 17179934724 25769934852 4295098374 4295098371 4295098374 131079 276982440919051 4294967300 5583457550339 8590065668 4295032838 25769934852 4295163907 8590000134 844429224378381 5858335457283 8590065668 4295032838 17180000260 844429224378381 8590000132 4295098371 4295032838 12885032964 21475033092 1125904201023501 4225105930 4226416649 4294967300 5583457550339 8590065668 4295032838 12885032964 844429224378381 5858335457283 8590065668 4295032838 21474967556 844429224378381 8590000132 4295098371 4295032838 25769934852 4295163907 8590000134 17180065796 1125904201023501 4225105929 4223533066 4224974857 21474836484 12884967428 131078 4295032835 196615 276832117063691 4294967300 8590000132 12885032964 21475033092 1125904201023501 4223598602 4224122889 4294967300 8590000132 25769934852 4295163907 8590000134 17180065796 1125904201023501 4223598601 4223533065 19 4294311938] [qn pt qr])
