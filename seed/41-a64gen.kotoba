      (gn-emit (enc-b (- head (+ leftBack 2))))) rightAt (vector-at m11 MM-CODE-N)
    m12 (ga-arm m11 b ref 6) rightBack (vector-at m12 MM-CODE-N)
    m13 (-> m12 (gn-emit (enc-cmp-i b 0)) (gn-fix FX-BC19 terminal) (gn-emit (enc-bcond (enc-cond-eq) 0))
      (gn-emit (enc-b (- head (+ rightBack 2))))) cold (vector-at m13 MM-CODE-N)]
    (-> (gp-restore m13 B)
      (gn-put (+ MM-CODE-BASE invalid) (enc-bcond (enc-cond-hs) (- cold invalid)))
      (gn-put (+ MM-CODE-BASE short) (enc-bcond (enc-cond-lo) (- cold short)))
      (gn-put (+ MM-CODE-BASE huge) (enc-bcond 8 (- cold huge)))
