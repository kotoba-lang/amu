(defn- cpp-record [M :vector-i64 i :i64 f :i64 before :i64 start :i64] :vector-i64
 (let [p (cpp-plan M)]
  (if (or (= p 0) (>= (vector-at M p) 512)
   (not= (vector-at M MM-FIX-N) (inc before))
   (<= before 0) (>= before (vector-at M MM-FIX-N))) M
   (let [at (sf-x M before XF-AT)]
    (if (and (= (sf-x M before XF-KIND) FX-BL26) (= (sf-x M before XF-TARGET) f)
      (= (sf-x M before XF-AUX) 0) (>= at start) (< at (vector-at M MM-CODE-N))
      (= (sf-word M at) (enc-bl 0))
