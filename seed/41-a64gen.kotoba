(defn- ds-admit [M :vector-i64 p :i64] :bool
 (if (or (< p 2) (>= (+ p 83) (vector-at M MM-SIR-N))
         (>= (vector-at M MM-SIR-N) 65536)
         (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
         (not= (gn-g M gn-f-vmode) 0) (not= (gn-g M gn-f-h) 0)
         (not= (gn-g M gn-f-ns) 10) (not= (gn-g M gn-f-dp) 8)
         (not= (gn-g M gn-f-out) 0) (<= (gn-g M gn-f-fb) 0)
         (> (gn-g M gn-f-fb) 32768)) false
  (let [f (gn-g M fr-owner) n (gn-sir M (+ p 3) IF-B)
        head (gn-sir M (inc p) IF-A) body (gn-sir M (+ p 5) IF-B)
        join (gn-sir M (+ p 23) IF-A) offset (gn-sir M (+ p 7) IF-B)
        shift (gn-sir M (+ p 11) IF-B) helper (gn-sir M (+ p 42) IF-A)]
   (and (> f 0) (< f (vector-at M MM-FN-N)) (< f MM-FN-CAP)
        (= (gn-fnf M f FF-SIR) (dec p)) (bd-row M (dec p) OP-FN f 6 10)
        (= (gn-fnf M f FF-NPARAMS) 6) (= (gn-fnf M f FF-NSLOTS) 10)
        (= (gn-fnf M f FF-DEPTH) 8) (= (gn-fnf M f FF-RTYPE) TY-VEC)
        (= (gn-fnf M f FF-FUEL) 1) (not (gn-clamp-open M f))
        (= (gn-fnf M f FF-PT0) TY-VEC)
        (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
        (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
        (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
        (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
        (> (gn-fnf M f FF-NODE) 0) (< (gn-fnf M f FF-NODE) (vector-at M MM-NODE-N))
        (< (gn-fnf M f FF-NODE) MM-NODE-CAP) (= (ck-pt M f 5) TY-I64)
        (ds-homes M 1 2) (>= n 2) (<= n 64) (= (bit-and n 1) 0)
        (>= offset 0) (< offset 4095) (>= shift 1) (<= shift 63)
        (> head 0) (< head MM-LABEL-CAP) (> body 0) (< body MM-LABEL-CAP)
        (> join 0) (< join MM-LABEL-CAP) (not= head body) (not= head join) (not= body join)
        (= (gn-lpos M head) (inc p)) (= (gn-lpos M body) (+ p 24))
        (= (gn-lpos M join) (+ p 81))
        (= (bd-count M 1 head 0 0) 65537) (= (bd-count M 1 body 0 0) 65537)
        (= (bd-count M 1 join 0 0) 65537)
        (= (sl-end M p f 4096) (+ p 83))
        (> helper 0) (< helper (vector-at M MM-FN-N)) (< helper MM-FN-CAP)
        (not= helper f) (= (gn-fnf M helper FF-NPARAMS) 1)
        (= (gn-fnf M helper FF-NSLOTS) 1) (= (gn-fnf M helper FF-DEPTH) 2)
        (= (gn-fnf M helper FF-RTYPE) TY-I64) (= (gn-fnf M helper FF-PT0) TY-I64)
        (= (gn-fnf M helper FF-FUEL) 1) (not (gn-clamp-open M helper))
        (ta-shape? M (gn-fnf M helper FF-SIR) helper)
        (<= n (gn-sir M (+ (gn-fnf M helper FF-SIR) 4) IF-B))
        (ds-shape M p f 0)))))
(defn- ds-emit [M :vector-i64 p :i64] :vector-i64
 (let [oldctx (gn-g M gn-f-ctx) n (gn-sir M (+ p 3) IF-B) debit (* (quot n 2) 3)
       rv (gn-sreg M 1) rb (gn-sreg M 2) ri (gn-sreg M 3)
       rx (gn-sreg M 4) rs0 (gn-sreg M 5) rs1 (gn-sreg M 6)
       helper (gn-sir M (+ p 42) IF-A) hp (gn-fnf M helper FF-SIR)
       lit (gn-sir M (+ hp 8) IF-B) head (gn-sir M (inc p) IF-A)
       m0 (-> M (gn-ctx) (gn-emit (enc-cmp-i ri 0))) b0 (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0))
                  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 debit))) b1 (vector-at m1 MM-CODE-N)
       m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
                  (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
                  (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
       m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
                  (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
                  (gn-emit (enc-ldp 17 4 16 0)) (gn-emit (enc-ldr 5 7 328))
                  (gn-emit (gn-e-addsl 5 5 17 3))
                  (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r rb 16))) b3 (vector-at m3 MM-CODE-N)
       m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
                  (gn-emit (enc-add-i 0 rb n)) (gn-emit (enc-cmp-r 0 4))) b4 (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0))
                  (gn-emit (enc-add-i 0 rb 1)) (gn-emit (gn-e-addsl 0 5 0 3))
                  (gn-emit (enc-ldr 1 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
                  (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
                  (gn-emit (enc-add-r 1 1 16))
                  (gn-mov 2 rs0) (gn-mov 3 rs1) (gn-mov-imm 4 n) (gn-mov 5 rx))
       loopcode (vector-at m5 MM-CODE-N)
       ;; i0, complete input j+1..j+N and TAB0..N-1 guards make these loads nontrapping.
       ;; x0..5,8..12,16/17 are dead at entry: all six parameters have distinct saved homes.
       m6 (-> m5 (gn-emit (enc-ldp 9 10 0 0)) (gn-emit (enc-ldp 11 12 1 0))
                  (gn-emit (enc-madd 2 5 11 2)) (gn-emit (enc-madd 2 9 12 2))
                  (gn-emit (enc-madd 3 9 11 3)) (gn-emit (enc-madd 3 10 12 3))
                  (gn-mov 5 10) (gn-emit (enc-add-i 0 0 16)) (gn-emit (enc-add-i 1 1 16))
                  (gn-emit (enc-subs-i 4 4 2)))
       at (vector-at m6 MM-CODE-N)
       m7 (-> m6 (gn-emit (enc-bcond (enc-cond-ne) (- loopcode at)))
                  (gn-emit (enc-sub-i 8 8 debit)) (gn-emit (enc-str 8 7 CTX-FUEL))
                  (gn-mov-imm ri n) (gn-mov rx 5) (gn-mov rs0 2) (gn-mov rs1 3)
                  (gn-fix FX-B26 head) (gn-emit (enc-b 0)))
       fallback (vector-at m7 MM-CODE-N)]
  (-> m7 (gn-dot-patch b0 fallback (enc-cond-ne)) (gn-dot-patch b1 fallback (enc-cond-lo))
          (gn-dot-patch b2 fallback (enc-cond-hs)) (gn-dot-patch b3 fallback (enc-cond-hs))
          (gn-dot-patch b4 fallback (enc-cond-hs)) (gn-gs gn-f-ctx oldctx))))
(defn- ds-entry [M :vector-i64 p :i64] :vector-i64
 (if (ds-admit M p) (ds-emit M p) M))

;; Whole closed reset/copy region. Owner, labels, helper, lengths and tail values are structural.
;; No workload names. All intermediate shared-fuel observations are excluded by the success-only contract.
(defn- vc-shape? [M :vector-i64 p :i64 f :i64 n :i64 helper :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
       join (gn-sir M (+ p 21) IF-A)
       v0 (gn-sir M (+ p 9) IF-B) v1 (gn-sir M (+ p 14) IF-B) v2 (gn-sir M (+ p 19) IF-B)]
  (and (> head 0) (< head MM-LABEL-CAP) (> body 0) (< body MM-LABEL-CAP)
       (> join 0) (< join MM-LABEL-CAP) (not= head body) (not= head join) (not= body join)
       (= (gn-small-label M 1 head 0) (+ p 2))
       (= (gn-small-label M 1 body 0) (+ p 22))
       (= (gn-small-label M 1 join 0) (+ p 37))
        (gn-dot-at? M (+ p 0) 1 f 2 4)
        (gn-dot-at? M (+ p 1) 18 0 0 0)
        (gn-dot-at? M (+ p 2) 9 head 0 0)
        (gn-dot-at? M (+ p 3) 4 0 2 0)
        (gn-dot-at? M (+ p 4) 3 1 n 0)
        (gn-dot-at? M (+ p 5) 7 1 0 0)
        (gn-dot-at? M (+ p 6) 11 0 body 0)
        (gn-dot-at? M (+ p 7) 4 0 1 0)
        (gn-dot-at? M (+ p 8) 3 1 (* n 2) 0)
        (gn-dot-at? M (+ p 9) 3 2 v0 0)
        (gn-dot-at? M (+ p 10) 14 208 0 3)
        (gn-dot-at? M (+ p 11) 5 3 0 0)
        (gn-dot-at? M (+ p 12) 4 0 3 0)
        (gn-dot-at? M (+ p 13) 3 1 (inc (* n 2)) 0)
        (gn-dot-at? M (+ p 14) 3 2 v1 0)
        (gn-dot-at? M (+ p 15) 14 208 0 3)
        (gn-dot-at? M (+ p 16) 5 4 0 0)
        (gn-dot-at? M (+ p 17) 4 0 4 0)
        (gn-dot-at? M (+ p 18) 3 1 (+ (* n 2) 2) 0)
        (gn-dot-at? M (+ p 19) 3 2 v2 0)
        (gn-dot-at? M (+ p 20) 14 208 0 3)
        (gn-dot-at? M (+ p 21) 10 join 0 0)
        (gn-dot-at? M (+ p 22) 9 body 0 0)
        (gn-dot-at? M (+ p 23) 4 0 1 0)
        (gn-dot-at? M (+ p 24) 4 1 2 0)
        (gn-dot-at? M (+ p 25) 4 2 2 0)
        (gn-dot-at? M (+ p 26) 13 helper 2 1)
        (gn-dot-at? M (+ p 27) 14 208 0 3)
        (gn-dot-at? M (+ p 28) 5 3 0 0)
        (gn-dot-at? M (+ p 29) 4 0 3 0)
        (gn-dot-at? M (+ p 30) 4 1 2 0)
        (gn-dot-at? M (+ p 31) 3 2 1 0)
        (gn-dot-at? M (+ p 32) 6 1 1 0)
        (gn-dot-at? M (+ p 33) 5 1 0 0)
        (gn-dot-at? M (+ p 34) 5 2 1 0)
        (gn-dot-at? M (+ p 35) 18 0 0 0)
        (gn-dot-at? M (+ p 36) 10 head 0 0)
        (gn-dot-at? M (+ p 37) 9 join 0 0)
        (gn-dot-at? M (+ p 38) 19 0 0 0)
        (gn-dot-at? M (+ p 39) 2 f 0 0))))
(defn- vc-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (>= i (- MM-SIR-CAP 38)) (>= (+ i 38) (vector-at M MM-SIR-N))
         (> (vector-at M MM-SIR-N) MM-SIR-CAP)
         (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
         (not= (gn-g M gn-f-vmode) 0) (not= (gn-g M gn-f-h) 0)
         (not= (gn-g M gn-f-ns) 4) (not= (gn-g M gn-f-dp) 3)
         (not= (gn-g M gn-f-fb) 112) (not= (gn-g M gn-f-out) 0)) false
  (let [p (dec i) f (gn-g M fr-owner) n (gn-sir M (+ p 4) IF-B)
        helper (gn-sir M (+ p 26) IF-A)]
   (and (> f 0) (< f (vector-at M MM-FN-N)) (< f MM-FN-CAP)
        (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2)
        (= (gn-fnf M f FF-NSLOTS) 4) (= (gn-fnf M f FF-DEPTH) 3)
        (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
        (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f FF-FUEL) 1)
        (not (gn-clamp-open M f))
        (= (gn-sreg M 1) 21) (= (gn-sreg M 2) 19)
        (= (gn-sreg M 3) 20) (= (gn-sreg M 4) 22)
        (> n 0) (<= n 1022) (= (bit-and n 1) 0)
        (> helper 0) (< helper (vector-at M MM-FN-N)) (< helper MM-FN-CAP)
        (not= helper f) (= (gn-fnf M helper FF-NPARAMS) 1)
        (= (gn-fnf M helper FF-NSLOTS) 1) (= (gn-fnf M helper FF-DEPTH) 2)
        (= (gn-fnf M helper FF-RTYPE) TY-I64) (= (gn-fnf M helper FF-PT0) TY-I64)
        (= (gn-fnf M helper FF-FUEL) 1) (not (gn-clamp-open M helper))
        (> (gn-fnf M helper FF-SIR) 0)
        (< (gn-fnf M helper FF-SIR) (- MM-SIR-CAP 17))
        (< (+ (gn-fnf M helper FF-SIR) 17) (vector-at M MM-SIR-N))
        (ta-shape? M (gn-fnf M helper FF-SIR) helper)
        (= (bit-and (gn-sir M (+ (gn-fnf M helper FF-SIR) 4) IF-B) 1) 0)
        (<= n (+ (gn-sir M (+ (gn-fnf M helper FF-SIR) 4) IF-B)
                  (gn-sir M (+ (gn-fnf M helper FF-SIR) 14) IF-C)))
        (vc-shape? M p f n helper)))))
;; Each pair is immutable source LDP followed by the original payload store order.
;; Literal and vector arenas are disjoint; no callback, allocation or fuel read in the guarded interval.
(defn- vc-loop [M :vector-i64 pairs :i64 source :i64] :vector-i64
 (if (= pairs 0) M
  (let [m0 (gn-mov-imm M 3 pairs) loopcode (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-ldp 9 10 source 0))
                  (gn-emit (enc-str 9 0 0)) (gn-emit (enc-str 10 0 8))
                  (gn-emit (enc-add-i source source 16)) (gn-emit (enc-add-i 0 0 16))
                  (gn-emit (enc-subs-i 3 3 1))) at (vector-at m1 MM-CODE-N)]
   (gn-emit m1 (enc-bcond (enc-cond-ne) (- loopcode at))))))
(defn- vc-emit [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) oldctx (gn-g M gn-f-ctx) n (gn-sir M (+ p 4) IF-B)
       helper (gn-sir M (+ p 26) IF-A) hp (gn-fnf M helper FF-SIR)
       k (gn-sir M (+ hp 4) IF-B) left (if (< n k) n k) right (- n left)
       a (gn-sir M (+ hp 8) IF-B) b (gn-sir M (+ hp 14) IF-B)
       m0 (-> M (gn-ctx) (gn-emit (enc-cmp-i 19 0))) b0 (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0))
                  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 (* n 2)))) b1 (vector-at m1 MM-CODE-N)
       m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
                  (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
                  (gn-emit (enc-sub-i 17 21 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
       m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
                  (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
                  (gn-emit (enc-ldp 17 4 16 0)) (gn-emit (enc-cmp-i 4 (+ (* n 2) 3)))) b3 (vector-at m3 MM-CODE-N)
       m4 (-> m3 (gn-emit (enc-bcond (enc-cond-lo) 0))
                  (gn-emit (enc-ldr 0 7 328)) (gn-emit (gn-e-addsl 0 0 17 3))
                  (gn-emit (enc-ldr 1 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 a)
                  (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
                  (gn-emit (enc-add-r 1 1 16))
                  (gn-emit (enc-ldr 2 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 b)
                  (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
                  (gn-emit (enc-add-r 2 2 16))
                  (gn-emit (enc-sub-i 8 8 (* n 2))) (gn-emit (enc-str 8 7 CTX-FUEL))
                  (vc-loop (quot left 2) 1) (vc-loop (quot right 2) 2)
                  (gn-mov-imm 19 n) (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)))
       fallback (vector-at m4 MM-CODE-N)]
  (-> m4 (gn-dot-patch b0 fallback (enc-cond-ne)) (gn-dot-patch b1 fallback (enc-cond-lo))
          (gn-dot-patch b2 fallback (enc-cond-hs)) (gn-dot-patch b3 fallback (enc-cond-lo))
          (gn-gs gn-f-ctx oldctx))))
(defn- vc-entry [M :vector-i64 i :i64] :vector-i64
 (if (vc-admit M i) (vc-emit M i) M))

;; Exact closed four-parameter strided all-zero leaf. Insert after original
;; entry private FUEL and before original loop label; all guards fail into
;; the untouched original body, and original backedges bypass this prefix.
(defn- sz-shape [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 36) true
  (let [f (gn-sir M p IF-A) head (gn-sir M (+ p 2) IF-A)
        body (gn-sir M (+ p 6) IF-B) join (gn-sir M (+ p 8) IF-A)
        short (gn-sir M (+ p 19) IF-B) n (gn-sir M (+ p 4) IF-B)]
   (and (case k
    0 (gn-dot-at? M p OP-FN f 4 4)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-CONST 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-BR join 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
    13 (gn-dot-at? M (+ p 13) OP-LGET 3 4 0)
    14 (gn-dot-at? M (+ p 14) OP-BIN BOP-MUL 2 0)
    15 (gn-dot-at? M (+ p 15) OP-BIN BOP-ADD 1 0)
    16 (gn-dot-at? M (+ p 16) OP-RT RT-VECTOR-AT 0 2)
    17 (gn-dot-at? M (+ p 17) OP-CONST 1 0 0)
    18 (gn-dot-at? M (+ p 18) OP-CMP CC-EQ 0 0)
    19 (gn-dot-at? M (+ p 19) OP-BRZ 0 short 0)
    20 (gn-dot-at? M (+ p 20) OP-LGET 0 1 0)
    21 (gn-dot-at? M (+ p 21) OP-LGET 1 2 0)
    22 (gn-dot-at? M (+ p 22) OP-LGET 2 3 0)
    23 (gn-dot-at? M (+ p 23) OP-LGET 3 4 0)
    24 (gn-dot-at? M (+ p 24) OP-CONST 4 1 0)
    25 (gn-dot-at? M (+ p 25) OP-BIN BOP-ADD 3 0)
    26 (gn-dot-at? M (+ p 26) OP-LSET 1 0 0)
    27 (gn-dot-at? M (+ p 27) OP-LSET 2 1 0)
    28 (gn-dot-at? M (+ p 28) OP-LSET 3 2 0)
    29 (gn-dot-at? M (+ p 29) OP-LSET 4 3 0)
    30 (gn-dot-at? M (+ p 30) OP-FUEL 0 0 0)
    31 (gn-dot-at? M (+ p 31) OP-BR head 0 0)
    32 (gn-dot-at? M (+ p 32) OP-LABEL short 0 0)
    33 (gn-dot-at? M (+ p 33) OP-LABEL join 0 0)
    34 (gn-dot-at? M (+ p 34) OP-RET 0 0 0)
    35 (gn-dot-at? M (+ p 35) OP-END f 0 0)
    false) (sz-shape M p (inc k))))))
(defn- sz-label [M :vector-i64 lab :i64 at :i64] :bool
 (and (> lab 0) (< lab MM-LABEL-CAP) (= (gn-small-label M 1 lab 0) at)))
(defn- sz-admit [M :vector-i64 i :i64] :bool
 (if (or (< i 2) (> i (- MM-SIR-CAP 35))
         (> (vector-at M MM-SIR-N) MM-SIR-CAP) (>= i (vector-at M MM-SIR-N))
         (not= (gn-g M gn-f-leaf) 1) (not= (gn-g M gn-f-freg) 1)
         (not= (gn-g M gn-f-fb) 0) (not= (gn-g M gn-f-out) 0)
         (not= (gn-g M gn-f-nsv) 0) (not= (gn-g M gn-f-vmode) 0)
         (not= (gn-g M gn-f-h) 0) (not= (gn-g M gn-f-ns) 4)
         (not= (gn-g M gn-f-dp) 5)
         (< (vector-at M MM-CODE-N) 0)
         (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 80))) false
  (let [f (gn-g M fr-owner) p (dec i)]
   (if (or (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))
           (> (vector-at M MM-FN-N) MM-FN-CAP)
           (> p (- (vector-at M MM-SIR-N) 36))
           (not= (gn-fnf M f FF-SIR) p) (gn-clamp-open M f)) false
    (let [n (gn-sir M (+ p 4) IF-B)]
     (and (gn-dot-at? M p OP-FN f 4 4) (>= n 1) (<= n 4095) (= (gn-fnf M f FF-NPARAMS) 4)
      (= (gn-fnf M f FF-NSLOTS) 4) (= (gn-fnf M f FF-DEPTH) 5)
      (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-RTYPE) TY-BOOL)
      (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
      (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
      (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
      (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1)
      (= (gn-sreg M 3) 2) (= (gn-sreg M 4) 3)
      (sz-shape M p 0)
      (sz-label M (gn-sir M (+ p 2) IF-A) (+ p 2))
      (sz-label M (gn-sir M (+ p 9) IF-A) (+ p 9))
      (sz-label M (gn-sir M (+ p 32) IF-A) (+ p 32))
      (sz-label M (gn-sir M (+ p 33) IF-A) (+ p 33))))))))
(defn- sz-emit [M :vector-i64 i :i64] :vector-i64
 (let [n (gn-sir M (+ i 3) IF-B)
       m0 (gn-emit M (enc-cmp-i 3 n)) empty (vector-at m0 MM-CODE-N)
       m1 (gn-emit m0 (enc-bcond (enc-cond-eq) 0))
       start (vector-at m1 MM-CODE-N) m2 (gn-emit m1 (enc-bcond (enc-cond-hs) 0))
       m3 (-> m2 (gn-emit (enc-orr-r 16 1 2)) (gn-emit (gn-e-lsr 16 16 31)))
       width (vector-at m3 MM-CODE-N) m4 (gn-emit m3 (enc-cbnz 16 0))
       zero (vector-at m4 MM-CODE-N) m5 (gn-emit m4 (enc-cbz 2 0))
       m6 (-> m5 (gn-mov-imm 16 (dec n)) (gn-emit (enc-mul 16 2 16))
                  (gn-emit (enc-add-r 16 1 16))
                  (gn-emit (enc-ldr 4 7 312)) (gn-emit (enc-ldr 4 4 0))
                  (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 4)))
       handle (vector-at m6 MM-CODE-N) m7 (gn-emit m6 (enc-bcond (enc-cond-hs) 0))
       m8 (-> m7 (gn-emit (enc-ldr 4 7 320)) (gn-emit (gn-e-addsl 4 4 17 4))
                  (gn-emit (enc-ldp 17 4 4 0)) (gn-emit (enc-cmp-r 16 4)))
       bounds (vector-at m8 MM-CODE-N) m9 (gn-emit m8 (enc-bcond (enc-cond-hs) 0))
       m10 (-> m9 (gn-emit (enc-ldr 5 7 328)) (gn-emit (gn-e-addsl 5 5 17 3))
                    (gn-emit (enc-mul 4 2 3)) (gn-emit (enc-add-r 4 1 4))
                    (gn-emit (gn-e-addsl 5 5 4 3))
                    (gn-emit (gn-e-addsl 6 31 2 3))
                    (gn-mov-imm 4 n) (gn-emit (enc-sub-r 4 4 3)))
       loop (vector-at m10 MM-CODE-N) m11 (gn-emit m10 (enc-ldr 16 5 0))
       nonzero (vector-at m11 MM-CODE-N) m12 (gn-emit m11 (enc-cbnz 16 0))
       m13 (-> m12 (gn-emit (enc-sub-i 4 4 1)) (gn-op-fuel))
       exhausted (vector-at m13 MM-CODE-N) m14 (gn-emit m13 (enc-cbz 4 0))
       m15 (gn-emit m14 (enc-add-r 5 5 6)) back (vector-at m15 MM-CODE-N)
       m16 (gn-emit m15 (enc-b (- loop back)))
       no (vector-at m16 MM-CODE-N)
       m17 (-> m16 (gn-mov-imm 0 0) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-ret)))
       yes (vector-at m17 MM-CODE-N)
       m18 (-> m17 (gn-mov-imm 0 1) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-ret)))
       fallback (vector-at m18 MM-CODE-N)]
  (-> m18 (gn-dot-patch empty yes (enc-cond-eq))
           (gn-dot-patch start fallback (enc-cond-hs))
           (gn-put (+ MM-CODE-BASE width) (enc-cbnz 16 (- fallback width)))
           (gn-put (+ MM-CODE-BASE zero) (enc-cbz 2 (- fallback zero)))
           (gn-dot-patch handle fallback (enc-cond-hs))
           (gn-dot-patch bounds fallback (enc-cond-hs))
           (gn-put (+ MM-CODE-BASE nonzero) (enc-cbnz 16 (- no nonzero)))
           (gn-put (+ MM-CODE-BASE exhausted) (enc-cbz 4 (- yes exhausted))))))
(defn- sz-entry [M :vector-i64 i :i64] :vector-i64
 (if (sz-admit M i) (sz-emit M i) M))

(defn- gn-ins-quiet [M :vector-i64 i :i64 op :i64] :vector-i64
  (let [a (gn-sir M i IF-A)
        b (gn-sir M i IF-B)
        c (gn-sir M i IF-C)]
    (if (or (and (= (gn-g M 14) 1) (not (or (= op OP-FN) (= op OP-END))))
            (and (= (gn-g M gn-f-dead) 1) (not (or (= op OP-LABEL) (= op OP-FN) (= op OP-END)))))
      M
      (case op
        OP-CONST (ar-entry M i a b)
        OP-LGET (if (gn-affine-read? M i a) (gn-affine-read M i a) (gn-def M a gn-k-local b))
        OP-LSET (gn-op-lset M a b)
        OP-BIN (gn-op-bin M i a b)
        OP-CMP (gn-op-cmp M i a b)
        OP-UN (gn-op-un M i a b)
        OP-LABEL (gn-op-label M a)
        OP-BR (gn-jump M (gn-thread M a 0 2 8))
        OP-BRZ (gn-op-brz M i a b 0)
        OP-BRNZ (gn-op-brz M i a b 1)
        OP-CALL (gn-op-call M i a b c)
        OP-CALLI (gn-op-calli M i b c)
        OP-FADDR (gn-op-faddr M i a b)
        OP-RT (gn-op-rt M i a b c)
        OP-CAP (gn-op-cap M i a b c)
        OP-STR (gn-op-str M i a b)
        OP-VEC (gn-op-vec M i a b)
        OP-TAB (gn-op-tab M i a b c)
        OP-VECP (gn-op-vecp M i a b c)
        OP-FUEL (rb-entry (qb-entry (cb-entry (mf-entry (fc-entry (sz-entry (drc-entry (pc3-entry (gn-copy-entry (gn-dot-entry (ds-entry (vc-entry (gn-op-fuel M) i) i) i) i) i) i) i) i) i) i) i) i)
        OP-RET (gn-op-ret M a)
        OP-RET2 (gn-op-ret2 M a)       ; R5B
        OP-RES2 (gn-op-res2 M i a)     ; R5B
        OP-TRAP (-> M (gn-emit (enc-brk a)) (gn-gs gn-f-dead 1))
        OP-FN (gn-op-fn M i a b)
        OP-END (-> M (gn-emit (enc-brk 1)) (gn-gs gn-f-dead 0))
        (gn-err M E-GEN-OP op)))))

;; every instruction from i (an instruction may consume the next ones: gn-f-skip)
(defn- gn-loop [M :vector-i64 i :i64] :vector-i64
  (if (and (< i (vector-at M MM-SIR-N)) (= (vector-at M MM-ERR) 0))
    (let [M1 (gn-ins M i (gn-op M i))
          k (gn-g M1 gn-f-skip)]
      (gn-loop (gn-gs M1 gn-f-skip 0) (+ i 1 k)))
    M))

;; the module entry: SIR -> CODE (+ FIX, LABEL, FF-CODE). MM-R0 = code words emitted in total.
(defn- gn-run-open [M :vector-i64 first :i64 count :i64] :vector-i64
  (let [top (vector-at M MM-HEAP-TOP)
        M0 (if (< top MM-HEAP-BASE) (gn-put M MM-HEAP-TOP MM-HEAP-BASE) M)
        M1 (mem-alloc M0 (+ gn-a-lp MM-LABEL-CAP 85 2560 513))]
    (if (and (= (vector-at M1 MM-ERR) 0) (= (vector-at M1 MM-R1) 1))
      (let [M2 (-> (gn-put M1 gn-cell (vector-at M1 MM-R0))
                   (gn-gs gn-g-open first) (gn-gs gn-g-open-n count)
                   (gn-gs di-used 0) (gn-gs di-sites 0)
                   (gn-gs fr-ln 0) (gn-gs fr-bad 0) (gn-gs fr-owner 0) (gn-gs fr-an 0))
            M3 (gn-loop M2 1)
            n (vector-at M3 MM-CODE-N)]
        (gn-put M3 MM-R0 (- n 1)))
      M1)))

;; Unity compilation has no link-time replacement of function bodies.
;; One-off novel algorithm SOURCE candidate: no product/native qualification.
;; Post-emission proof reads original decisions/words. One first bounded pair only.
(defn- sf-word [M :vector-i64 i :i64] :i64 (vector-at M (+ MM-CODE-BASE i)))
(defn- sf-x [M :vector-i64 i :i64 k :i64] :i64 (vector-at M (+ MM-FIX-BASE (* i MM-FIX-W) k)))
(defn- sf-body [M :vector-i64 f :i64] :i64
 (let [p (gn-fnf M f FF-SIR) sn (vector-at M MM-SIR-N)]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (> p 0) (<= p (- sn 16))
   (or (= (gn-fnf M f FF-KIND) FK-DEFN) (= (gn-fnf M f FF-KIND) FK-PRIV))
   (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (= (gn-fnf M f FF-NSLOTS) 1) (or (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-DEPTH) 7))
   (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f) (= (gn-sir M p IF-B) 1)
   (= (gn-op M (inc p)) OP-FUEL) (= (gn-op M (+ p 2)) OP-LABEL))
   (loop [j (+ p 3)]
    (cond (>= j (+ p 13)) 0
     (= (gn-op M j) OP-CALL)
     (let [h (gn-sir M j IF-A) n (gn-sir M j IF-C) g (gn-sir M (inc j) IF-A)]
      (if (and (or (= n 4) (= n 7)) (= (gn-sir M j IF-B) 0)
       (> h 0) (< h (vector-at M MM-FN-N))
       (or (= (gn-fnf M h FF-KIND) FK-DEFN) (= (gn-fnf M h FF-KIND) FK-PRIV))
       (> (gn-fnf M h FF-SIR) 0) (= (gn-fnf M h FF-NPARAMS) n) (= (gn-fnf M h FF-RTYPE) TY-VEC)
       (= (gn-op M (inc j)) OP-CALL) (= (gn-sir M (inc j) IF-B) 0) (= (gn-sir M (inc j) IF-C) 1)
       (> g 0) (< g (vector-at M MM-FN-N)) (not= g f)
       (= (gn-op M (+ j 2)) OP-RET) (= (gn-sir M (+ j 2) IF-A) 0)
       (= (gn-op M (+ j 3)) OP-END) (= (gn-sir M (+ j 3) IF-A) f)) j 0))
     (= (gn-op M j) OP-LGET) (if (and (= (gn-sir M j IF-B) 1) (= (gn-sir M j IF-C) 0)) (recur (inc j)) 0)
     (= (gn-op M j) OP-CONST) (if (= (gn-sir M j IF-C) 0) (recur (inc j)) 0)
     :else 0)) 0)))
;; Exact current ordinary single-x19-save/frame/context/parameter entry. No prescan rerun.
(defn- sf-frame [M :vector-i64 f :i64] :i64
 (let [at (gn-fnf M f FF-CODE) dp (gn-fnf M f FF-DEPTH) F (if (= dp 4) 80 96)]
  (if (and (> at 0) (<= at (- (vector-at M MM-CODE-N) 6))
   (= (sf-word M at) (enc-stp-pre 29 30 31 -16)) (= (sf-word M (inc at)) (enc-mov-sp 29 31))
   (= (sf-word M (+ at 2)) (enc-sub-i 31 31 F)) (= (sf-word M (+ at 3)) (enc-str 19 31 0))
   (= (sf-word M (+ at 4)) (enc-str 7 31 (- F 8))) (= (sf-word M (+ at 5)) (enc-mov-r 19 0))) F 0)))
(defn- sf-codeend [M :vector-i64 f :i64 k :i64 end :i64] :i64
 (if (>= k (vector-at M MM-FN-N)) end
  (let [p (gn-fnf M k FF-CODE) start (gn-fnf M f FF-CODE)]
   (sf-codeend M f (inc k) (if (and (> p start) (< p end)) p end)))))
;; Require exactly one BL-kind function fixup for this target inside this caller's final five-word tail.
(defn- sf-tailfix [M :vector-i64 f :i64 g :i64 k :i64 found :i64 stop :i64] :i64
 (if (>= k (vector-at M MM-FIX-N)) found
  (let [at (sf-x M k XF-AT) start (gn-fnf M f FF-CODE)]
   (if (and (>= at (+ start 6)) (< at stop) (= (sf-x M k XF-KIND) FX-BL26) (= (sf-x M k XF-TARGET) g))
    (if (or (> found 0) (not= (sf-x M k XF-AUX) 0) (< at 4)
      (not= (sf-word M (- at 4)) (enc-mov-r 0 9)) (not= (sf-word M (- at 3)) (enc-ldr 19 31 0))
      (not= (sf-word M (- at 2)) (enc-mov-sp 31 29)) (not= (sf-word M (dec at)) (enc-ldp-post 29 30 31 16))
      (not= (sf-word M at) (enc-b 0)) (not= (+ at 2) stop)
      (not= (sf-word M (inc at)) (enc-brk 1))) -1 (sf-tailfix M f g (inc k) k stop))
    (sf-tailfix M f g (inc k) found stop)))))
;; No pre-existing label or fixup can enter/patch removed restore words or header prefix.
(defn- sf-clearlabels [M :vector-i64 k :i64 a :i64 b :i64 target :i64] :bool
 (if (>= k (vector-at M MM-LABEL-N)) true
  (let [p (vector-at M (+ MM-LABEL-BASE k))]
   (and (not (and (>= p a) (<= p b))) (not (and (> p target) (<= p (+ target 5))))
    (sf-clearlabels M (inc k) a b target)))))
(defn- sf-clearfix [M :vector-i64 k :i64 a :i64 b :i64 target :i64 keep :i64] :bool
 (if (>= k (vector-at M MM-FIX-N)) true
  (let [at (sf-x M k XF-AT)]
   (and (or (= k keep) (and (not (and (>= at a) (<= at b))) (not (and (>= at target) (< at (+ target 6))))))
    (sf-clearfix M (inc k) a b target keep)))))
(defn- sf-pair [M :vector-i64 f :i64] :i64
 (let [j (sf-body M f) g (if (> j 0) (gn-sir M (inc j) IF-A) 0)
       gj (if (> g 0) (sf-body M g) 0) F (if (> gj 0) (sf-frame M f) 0)]
  (if (and (> F 0) (> gj 0) (= F (sf-frame M g)) (= (gn-fnf M f FF-DEPTH) (gn-fnf M g FF-DEPTH))
   (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M g FF-FUEL) 1)
   (< (gn-fnf M f FF-CODE) (gn-fnf M g FF-CODE)))
   (let [stop (if (> (vector-at M MM-FIX-N) 1) (sf-codeend M f 1 (vector-at M MM-CODE-N)) (vector-at M MM-CODE-N))
         k (sf-tailfix M f g 1 0 stop) at (if (> k 0) (sf-x M k XF-AT) 0) target (gn-fnf M g FF-CODE)]
    (if (and (> k 0) (sf-clearlabels M 1 (- at 4) at target)
      (sf-clearfix M 1 (- at 4) at target k)) k 0)) 0)))
;; V2 complete existing branch-FIX closure BEFORE allocating any new label.
;; Narrow initial admission excludes literal pools/FIX-LIT32 and nonzero AUX;
;; those legitimate or malformed cases keep the original generator result.
(defn- sf-old-fix [M :vector-i64 k :i64] :bool
 (if (>= k (vector-at M MM-FIX-N)) true
  (let [at (sf-x M k XF-AT) kind (sf-x M k XF-KIND) t (sf-x M k XF-TARGET)
        cn (vector-at M MM-CODE-N) ln (vector-at M MM-LABEL-N) fnn (vector-at M MM-FN-N)]
   (if (and (> at 0) (< at cn) (= (sf-x M k XF-AUX) 0))
    (let [target
      (cond (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19))
            (if (and (> t 0) (< t ln)) (vector-at M (+ MM-LABEL-BASE t)) 0)
            (or (= kind FX-BL26) (= kind FX-ADR19))
            (if (and (> t 0) (< t fnn)) (gn-fnf M t FF-CODE) 0)
            :else 0)]
     (and (> target 0) (< target cn) (>= (sf-word M at) 0) (<= (sf-word M at) 0xffffffff)
      (if (or (= kind FX-B26) (= kind FX-BL26))
       (and (>= (- target at) -33554432) (< (- target at) 33554432))
       (and (>= (- target at) -262144) (< (- target at) 262144)))
      (sf-old-fix M (inc k)))) false))))
(defn- sf-collapse [M :vector-i64] :vector-i64
 (let [fnn (vector-at M MM-FN-N) sn (vector-at M MM-SIR-N) cn (vector-at M MM-CODE-N)
       xn (vector-at M MM-FIX-N) ln (vector-at M MM-LABEL-N)]
  (if (and (= (vector-at M MM-ERR) 0) (> fnn 0) (<= fnn 512) (>= sn 16) (<= sn MM-SIR-CAP)
    (> cn 6) (<= cn MM-CODE-CAP) (= (vector-at M MM-LIT-N) 1) (> xn 0) (<= xn MM-FIX-CAP)
    (> ln 0) (< ln MM-LABEL-CAP) (sf-old-fix M 1))
   ;; Existing FN-N<=512 admission bounds scans, work and additional labels to at most 511 (physical MM-FN-CAP8192).
   (loop [f 1 used 0 current M]
    (if (or (>= f fnn) (>= used 511) (>= (vector-at current MM-LABEL-N) MM-LABEL-CAP)) current
     ;; Recheck complete current namespace closure before every mutation.
     (if (not (sf-old-fix current 1)) current
      (let [k (sf-pair current f)]
       (if (> k 0)
        (let [at (sf-x current k XF-AT) j (sf-body current f) g (gn-sir current (inc j) IF-A)
              target (+ (gn-fnf current g FF-CODE) 5) xb (+ MM-FIX-BASE (* k MM-FIX-W))
              next-label (vector-at current MM-LABEL-N)
              changed (-> current
               (gn-put (+ MM-CODE-BASE (- at 3)) (enc-ldr 30 29 8))
               (gn-put (+ MM-CODE-BASE (- at 2)) 0xd503201f)
               (gn-put (+ MM-CODE-BASE (dec at)) 0xd503201f)
               (gn-put (+ MM-LABEL-BASE next-label) target)
               (gn-put MM-LABEL-N (inc next-label))
               (gn-put (+ xb XF-KIND) FX-B26) (gn-put (+ xb XF-TARGET) next-label))]
         (recur (inc f) (inc used) changed))
        (recur (inc f) used current)))))) M)))

(defn- mp-sign [v :i64 bits :i64] :i64
 (let [top (i64-shift-left 1 (dec bits))] (if (>= v top) (- v (* top 2)) v)))

(defn- mp-sirclosed [M :vector-i64 i :i64] :bool
 (if (>= i (vector-at M MM-SIR-N)) true
  (and (not= (gn-sir M i IF-OP) OP-FADDR) (not= (gn-sir M i IF-OP) OP-CALLI) (not= (gn-sir M i IF-OP) OP-CAP)
   (mp-sirclosed M (inc i)))))

(defn- mp-labels [M :vector-i64 i :i64 target :i64] :bool
 (if (>= i (vector-at M MM-LABEL-N)) true
  (let [p (vector-at M (+ MM-LABEL-BASE i))]
   (and (>= p 0) (< p (vector-at M MM-CODE-N)) (not= p target) (mp-labels M (inc i) target)))))

(defn- mp-functions [M :vector-i64 i :i64 target :i64] :bool
 (if (>= i (vector-at M MM-FN-N)) true
  (let [p (gn-fnf M i FF-CODE)]
   (and (>= p 0) (< p (vector-at M MM-CODE-N)) (not= p target) (mp-functions M (inc i) target)))))

(defn- mp-fixes [M :vector-i64 i :i64 first :i64] :bool
 (if (>= i (vector-at M MM-FIX-N)) true
  (let [at (sf-x M i XF-AT) kind (sf-x M i XF-KIND) t (sf-x M i XF-TARGET) aux (sf-x M i XF-AUX)
        cn (vector-at M MM-CODE-N)
        dest (cond (or (= kind FX-B26) (= kind FX-BC19) (= kind FX-CB19))
              (if (and (> t 0) (< t (vector-at M MM-LABEL-N))) (vector-at M (+ MM-LABEL-BASE t)) -1)
              (or (= kind FX-BL26) (= kind FX-ADR19))
              (if (and (> t 0) (< t (vector-at M MM-FN-N))) (+ (gn-fnf M t FF-CODE) aux) -1)
              :else -1)]
   (and (> at 0) (< at cn) (not= at first) (not= at (inc first))
    (if (= kind FX-LIT32)
     (and (= aux 0) (> t 0) (< t (vector-at M MM-LIT-N)) (< (inc at) cn) (not= (inc at) first))
     (and (> dest 0) (< dest cn) (not= dest (inc first))
      (or (= aux 0) (and (= kind FX-BL26) (= aux 1)
       (= (bit-and (sf-word M at) 0xfc000000) 0x14000000)
       (= (sf-word M (dec dest)) 0xd2800005)))
      (if (or (= kind FX-B26) (= kind FX-BL26))
       (and (>= (- dest at) -33554432) (< (- dest at) 33554432))
       (and (>= (- dest at) -262144) (< (- dest at) 262144)))))
    (mp-fixes M (inc i) first)))))

(defn- mp-codeclosed [M :vector-i64 i :i64 target :i64] :bool
 (if (>= i (vector-at M MM-CODE-N)) true
  (let [w (sf-word M i)
        dest (cond (= (bit-and w 0x7c000000) 0x14000000) (+ i (mp-sign (bit-and w 0x03ffffff) 26))
              (or (= (bit-and w 0xff000010) 0x54000000) (= (bit-and w 0x7e000000) 0x34000000))
                (+ i (mp-sign (bit-and (i64-shift-right w 5) 0x7ffff) 19))
              (= (bit-and w 0x7e000000) 0x36000000) (+ i (mp-sign (bit-and (i64-shift-right w 5) 0x3fff) 14))
              :else -1)]
   (and (>= w 0) (<= w 0xffffffff) (not= dest target)
    (not= (bit-and w 0xfffffc1f) 0xd61f0000)
    ;; ADR with a FIX is still refused in this initial rule; ordinary fallback remains.
    (not= (bit-and w 0x9f000000) 0x10000000) (not= (bit-and w 0x9f000000) 0x90000000)
    (mp-codeclosed M (inc i) target)))))

(defn- mp-word [w :i64 v :i64] :i64
 (let [d (bit-and w 31) n (bit-and (i64-shift-right w 5) 31)
       m (bit-and (i64-shift-right w 16) 31)
       a (bit-and (i64-shift-right v 5) 31) b (bit-and (i64-shift-right v 16) 31)]
  (if (and (= (bit-and w 0xffe0fc00) 0x9b007c00) (= (bit-and v 0xffe0fc00) 0x8b000000)
   (not= d 31) (= (bit-and v 31) d) (or (and (= a d) (not= b d)) (and (= b d) (not= a d))))
   (enc-madd d n m (if (= a d) b a)) -1)))

(defn- mp-run [M :vector-i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) sn (vector-at M MM-SIR-N)
       fnn (vector-at M MM-FN-N) ln (vector-at M MM-LABEL-N) xn (vector-at M MM-FIX-N)
       litn (vector-at M MM-LIT-N)]
  (if (and (= (vector-at M MM-ERR) 0) (> cn 2) (<= cn 8192) (> sn 0) (<= sn 8192)
    (> fnn 0) (<= fnn 128) (> ln 0) (<= ln 4096) (> xn 0) (<= xn 4096)
    (> litn 0) (<= litn MM-LIT-CAP) (mp-sirclosed M 1))
   (loop [current M i 1 used 0]
    (if (or (>= (inc i) cn) (>= used 64)) current
     (let [word (mp-word (sf-word current i) (sf-word current (inc i)))]
      (if (and (>= word 0) (mp-labels current 1 (inc i)) (mp-functions current 1 (inc i))
         (mp-fixes current 1 i) (mp-codeclosed current 1 (inc i)))
       (recur (-> current (gn-put (+ MM-CODE-BASE i) word)
         (gn-put (+ MM-CODE-BASE (inc i)) 0xd503201f)) (+ i 2) (inc used))
       (recur current (inc i) used))))) M)))

;; SOURCE candidate FR2: published fuel reload forwarding, typed CODE only.
;; All debit/trap/publication words and code positions remain intact.
;; Strict whole-image indirect/address refusal is intentional, not a site certificate.
(defn- fr-in [p :i64 a :i64 b :i64] :bool (and (>= p a) (<= p b)))
(defn- fr-fuel [M :vector-i64 i :i64] :bool
 (and (> i 0) (< (+ i 4) (vector-at M MM-CODE-N))
  (= (sf-word M i) 0xf94004f0) (= (sf-word M (inc i)) 0xf1000610)
  (= (sf-word M (+ i 2)) 0x54000042) (= (sf-word M (+ i 3)) 0xd4200000)
  (= (sf-word M (+ i 4)) 0xf90004f0)))
(defn- fr-move [w :i64] :bool
 (let [d (bit-and w 31)]
  (and (>= w 0) (<= w 0xffffffff) (not= d 7) (not= d 16) (not= d 31)
   (or (= (bit-and w 0xffe0ffe0) 0xaa0003e0)
       (= (bit-and w 0xff800000) 0xd2800000)))))
(defn- fr-next [M :vector-i64 j :i64 left :i64] :i64
 (cond (fr-fuel M j) j
  (or (<= left 0) (>= j (vector-at M MM-CODE-N))) 0
  (fr-move (sf-word M j)) (fr-next M (inc j) (dec left))
  :else 0))
(defn- fr-labels [M :vector-i64 i :i64 a :i64 b :i64] :bool
 (if (>= i (vector-at M MM-LABEL-N)) true
  (let [p (vector-at M (+ MM-LABEL-BASE i))]
   (and (>= p 0) (< p (vector-at M MM-CODE-N))
    (fr-labels M (inc i) a b)))))
(defn- fr-functions [M :vector-i64 i :i64 a :i64 b :i64] :bool
 (if (>= i (vector-at M MM-FN-N)) true
  (let [p (gn-fnf M i FF-CODE)]
   (and (>= p 0) (< p (vector-at M MM-CODE-N)) (not (fr-in p (inc a) b))
    (fr-functions M (inc i) a b)))))
;; Every FIX kind is recognized; LIT32 patches two CODE words, never either macro.
;; SF's exact AUX1 tail branch is retained under its existing checked shape.
(defn- fr-fixes [M :vector-i64 i :i64 a :i64 b :i64] :bool
 (if (>= i (vector-at M MM-FIX-N)) true
  (let [at (sf-x M i XF-AT) k (sf-x M i XF-KIND) t (sf-x M i XF-TARGET)
        aux (sf-x M i XF-AUX) cn (vector-at M MM-CODE-N)
        dest (cond (or (= k FX-B26) (= k FX-BC19) (= k FX-CB19))
          (if (and (> t 0) (< t (vector-at M MM-LABEL-N))) (vector-at M (+ MM-LABEL-BASE t)) -1)
          (or (= k FX-BL26) (= k FX-ADR19))
          (if (and (> t 0) (< t (vector-at M MM-FN-N))) (+ (gn-fnf M t FF-CODE) aux) -1)
          :else -1)]
   (and (> at 0) (< at cn) (not (fr-in at a (+ b 4)))
    (if (= k FX-LIT32)
     (and (= aux 0) (> t 0) (< t (vector-at M MM-LIT-N)) (< (inc at) cn)
      (not (fr-in (inc at) a (+ b 4))))
     (and (> dest 0) (< dest cn) (not (fr-in dest (inc a) b)) (not= k FX-ADR19)
      (or (= aux 0) (and (= k FX-BL26) (= aux 1)
       (= (bit-and (sf-word M at) 0xfc000000) 0x14000000)
       (= (sf-word M (dec dest)) 0xd2800005)))
      (if (or (= k FX-B26) (= k FX-BL26))
       (and (>= (- dest at) -33554432) (< (- dest at) 33554432))
       (and (>= (- dest at) -262144) (< (- dest at) 262144)))))
    (fr-fixes M (inc i) a b)))))
(defn- fr-code [M :vector-i64 i :i64 a :i64 b :i64] :bool
 (if (>= i (vector-at M MM-CODE-N)) true
  (let [w (sf-word M i)
        dest (cond (= (bit-and w 0x7c000000) 0x14000000) (+ i (mp-sign (bit-and w 0x03ffffff) 26))
          (or (= (bit-and w 0xff000010) 0x54000000) (= (bit-and w 0x7e000000) 0x34000000))
          (+ i (mp-sign (bit-and (i64-shift-right w 5) 0x7ffff) 19))
          (= (bit-and w 0x7e000000) 0x36000000) (+ i (mp-sign (bit-and (i64-shift-right w 5) 0x3fff) 14))
          :else -1)]
   (and (>= w 0) (<= w 0xffffffff)
    (or (= dest -1) (and (> dest 0) (< dest (vector-at M MM-CODE-N))))
    (or (not (fr-in dest (inc a) b))
        (and (= i (+ a 2)) (= dest (+ a 4)) (= w 0x54000042)))
    (not= (bit-and w 0xfffffc1f) 0xd61f0000)
    (or (not= (bit-and w 0xfffffc1f) 0xd63f0000) (fr-certified-blr M i 0))
    (not= (bit-and w 0x9f000000) 0x10000000)
    (not= (bit-and w 0x9f000000) 0x90000000)
    (fr-code M (inc i) a b)))))
;; Exact row lookup after whole-ledger validation; no preceding-word heuristic.
(defn- fr-certified-blr [M :vector-i64 at :i64 k :i64] :bool
 (if (>= k (gn-g M fr-ln)) false
  (or (= at (dec (fr-lget M k 8))) (fr-certified-blr M at (inc k)))))
;; Every branch target into setup after its first word is refused, including FIX targets.
(defn- fr-setup-code [M :vector-i64 i :i64 a :i64 b :i64] :bool
 (if (>= i (vector-at M MM-CODE-N)) true
  (let [w (sf-word M i)
        dest (cond (= (bit-and w 0x7c000000) 0x14000000) (+ i (mp-sign (bit-and w 0x03ffffff) 26))
          (or (= (bit-and w 0xff000010) 0x54000000) (= (bit-and w 0x7e000000) 0x34000000))
          (+ i (mp-sign (bit-and (i64-shift-right w 5) 0x7ffff) 19))
          (= (bit-and w 0x7e000000) 0x36000000) (+ i (mp-sign (bit-and (i64-shift-right w 5) 0x3fff) 14))
          :else -1)]
   (and (not (fr-in dest (inc a) b)) (fr-setup-code M (inc i) a b)))))
;; Owner CODE and typed SIR intervals exclude every other function's entry.
(defn- fr-own-range [M :vector-i64 f :i64 i :i64 a :i64 end :i64 k :i64] :bool
 (if (>= k (vector-at M MM-FN-N)) true
  (let [cp (gn-fnf M k FF-CODE) sp (gn-fnf M k FF-SIR)
        fc (gn-fnf M f FF-CODE) fs (gn-fnf M f FF-SIR)]
   (and (or (= k f) (and (not (and (> cp fc) (< cp end)))
                             (not (and (> sp fs) (<= sp i)))))
    (fr-own-range M f i a end (inc k))))))
(defn- fr-source-end [M :vector-i64 j :i64 f :i64 i :i64 work :i64] :bool
 (cond (or (<= work 0) (>= j (vector-at M MM-SIR-N))) false
       (= (gn-op M j) OP-FN) false
       (= (gn-op M j) OP-END)
         (and (> j i) (= (gn-sir M j IF-A) f) (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) 0))
       :else (fr-source-end M (inc j) f i (dec work))))
(defn- fr-source-owner [M :vector-i64 f :i64 i :i64] :bool
 (let [p (gn-fnf M f FF-SIR)]
  (and (> p 0) (< p i) (< i (vector-at M MM-SIR-N))
       (or (= (gn-fnf M f FF-KIND) FK-DEFN) (= (gn-fnf M f FF-KIND) FK-PRIV))
       (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f)
       (= (gn-sir M p IF-B) (gn-fnf M f FF-NPARAMS))
       (fr-source-end M (inc p) f i 65536))))
(defn- fr-ledger-valid [M :vector-i64 k :i64 previous :i64] :bool
 (if (>= k (gn-g M fr-ln)) true
  (let [f (fr-lget M k 0) i (fr-lget M k 1) t (fr-lget M k 2) lit (fr-lget M k 3)
        n (fr-lget M k 4) mode (fr-lget M k 5) frame (fr-lget M k 6)
        a (fr-lget M k 7) end (fr-lget M k 8) op (fr-lget M k 9)]
   (and (> f 0) (< f (vector-at M MM-FN-N)) (> i 0) (< i (vector-at M MM-SIR-N))
    (fr-source-owner M f i)
    (> (gn-fnf M f FF-CODE) 0) (<= (gn-fnf M f FF-CODE) a)
    (>= a previous) (> a 0) (= end (+ a 3)) (< end (vector-at M MM-CODE-N))
    (>= t 0) (>= n 0) (<= n 4096) (>= frame 8) (<= frame 32768) (= (bit-and frame 7) 0)
    (or (and (= op OP-VEC) (= lit 0) (= (gn-op M i) OP-VEC)
             (= (gn-sir M i IF-A) t) (= (gn-sir M i IF-B) n))
        (and (= op OP-VECP) (> lit 0) (< lit (vector-at M MM-LIT-N)) (= (gn-op M i) OP-VECP)
             (= (gn-sir M i IF-A) t) (= (gn-sir M i IF-B) lit) (= (gn-sir M i IF-C) n))
        (and (= op OP-RT) (= lit RT-VECTOR-ALLOC) (= n 1) (< t (gn-fnf M f FF-DEPTH))
             (= (gn-op M i) OP-RT) (= (gn-sir M i IF-A) RT-VECTOR-ALLOC)
             (= (gn-sir M i IF-B) t) (= (gn-sir M i IF-C) 1)))
    (or (and (= mode 1) (= (sf-word M a) (enc-mov-r 0 7)))
        (and (= mode 0) (= (sf-word M a) (enc-ldr 0 31 (- frame 8)))))
    (= (sf-word M (inc a)) (enc-ldr 16 0 200)) (= (sf-word M (+ a 2)) (enc-blr 16))
    (fr-own-range M f i a end 1) (fr-labels M 1 a (+ a 2))
    (fr-functions M 1 a (+ a 2)) (fr-fixes M 1 a (+ a 2))
    (fr-setup-code M 1 a (+ a 2)) (fr-ledger-valid M (inc k) end)))))

(defn- fr-run [M :vector-i64] :vector-i64
 (let [cn (vector-at M MM-CODE-N) sn (vector-at M MM-SIR-N)
       fnn (vector-at M MM-FN-N) ln (vector-at M MM-LABEL-N) xn (vector-at M MM-FIX-N)]
  (if (and (= (vector-at M MM-ERR) 0) (> cn 10) (<= cn 32768)
    (> sn 0) (<= sn 65536) (> fnn 0) (<= fnn 1024)
    (> ln 0) (<= ln 8192) (> xn 0) (<= xn 8192)
    (> (vector-at M MM-LIT-N) 0) (<= (vector-at M MM-LIT-N) MM-LIT-CAP)
    (mp-sirclosed M 1) (= (gn-g M fr-bad) 0)
    (= (gn-g M fr-an) 0) (>= (gn-g M fr-ln) 0) (<= (gn-g M fr-ln) 256) (fr-ledger-valid M 0 0))
   ;; At most 256 full-namespace candidate checks, including refusals.
   ;; Exhaustion returns all remaining original words, never relaxed admission.
   (loop [current M i 1 tried 0]
    (if (or (>= (+ i 9) cn) (>= tried 256)) current
     (let [j (if (fr-fuel current i) (fr-next current (+ i 5) 4) 0)]
      (if (> j 0)
       (if (and (fr-labels current 1 i j) (fr-functions current 1 i j)
                (fr-fixes current 1 i j) (fr-code current 1 i j))
        (recur (gn-put (fr-site current i j) (+ MM-CODE-BASE j) 0xd503201f) (+ j 5) (inc tried))
        (recur current (inc i) (inc tried)))
       (recur current (inc i) tried))))) M)))

(defn- gn-run [M :vector-i64] :vector-i64 (fr-run (mp-run (sf-collapse (gn-run-open M 0 0)))))
