                  (kpat-match M (mmx-q M sr) [1125921381023745 18 4229300233 8589934596 12884967428 262151 277102700003339 4294967300 429496795139 12885032964 4295032838 562949964955662 4295032836 429496860675 17180065796 8590000134 562954259922958 327687 4228251657 277038275493899 4294967300 8590000132 12885032964 4295163907 8590065670 17180065796 65541 4295098373 8590131205 12885164037 18 4229300234 4227137546 4227268617 12884901892 4227137545 19 4294311938] [sr])
                  (kpat-match M (mmx-q M sw) [1407392062767105 18 4229300233 4294967300 8590000132 562949964955662 262149 4294967300 12884967428 562949964955662 327685 4294967300 8590000132 21474967556 844429224378381 12884967428 17180000260 844429224378381 19 4294311938] [sw pt])
                  (kpat-match M (mmx-q M pt) [844442109345793 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294311938] [pt]))) M
     (let [G (vector-alloc 31)
           m0 (-> M (kb-vec G rv 3 0) (gn-mov 9 (gn-sreg M 2)) (gn-mov 10 (gn-sreg M 3)) (gn-mov 11 (gn-sreg M 4))
                (gn-mov 12 (gn-sreg M 5)) (gn-mov 13 (gn-sreg M 6)) (gn-mov 14 (gn-sreg M 7)) (gn-emit (enc-ldr 4 7 CTX-FUEL))
                (kb-words G [0xD280B28F 0xEB0F007F 4 0xF1018DBF 9 0xF10191DF 9 0xEB0D01DF 14 0xEB0D013F 2 0xEB0D015F 14 0xEB0E015F 13 0xEB0D017F 12 0xEB0E017F 11 0xF100C99F 9 0xD285140F 0x8B0F0010 0xD280000F 0xEB0C01FF 0x54000140 0xF86F7A05 0xF10190BF 9 0x91080205 0xF86F78A5 0xF10190BF 9 0x910005EF 0x17FFFFF6 0xAA0D03E1 0xAA0E03E2 0xAA0C03E6 0xAA0A03E8 0xAA0B03E9 0x910C8000 0xF8617811 0xF10AF09F 0x54000E63 0xEB09011F 0x540007AA 0xD1000484 0xAA0803EA 0xEB09015F 0x540000EC 0xF86A780E 0xEB1101DF 0x5400008C 0x9100054A 0xD1000484 0x17FFFFF9 0xEB09015F 0x5400012D 0xF869780E 0xD1000C84 0xF8297811 0xF821780E 0xAA0E03F1 0xAA0903E8 0xD1000484 0x17FFFFE9 0xD1000484 0xAA0903EF 0xEB0F015F 0x540000EC 0xF86F780E 0xEB1101DF 0x5400008B 0xD10005EF 0xD1000484 0x17FFFFF9 0xEB0F015F 0x5400014D 0xF86F780E 0xD1000C84 0xF82F7811 0xF821780E 0xAA0E03F1 0xAA0F03E8 0xAA0F03E9 0xD1000484 0x17FFFFD4 0x540001E0 0xF86A780E 0xF86F7805 0xD1000C84 0xF82A7805 0xF82F780E 0x91000548 0xEB0F011F 0x9A8AB108 0x9100094E 0xD10005E9 0xEB0F01DF 0x9A8FB129 0xD1000484 0x17FFFFC5 0xAA0A03E8 0xAA0F03E9 0xD1000484 0x17FFFFC1 0xD1000484 0xCB01010A 0xCB09004E 0xF100055F 0x540002CD 0xF10005DF 0x5400024D 0xD1000884 0xD10005CE 0xEB0E015F 0x5400010A 0x9100052F 0xF8267A0F 0x91080205]) (kb-words G [0xF82678A2 0x910004C6 0xAA0803E2 0x1400000A 0xF8267A01 0x91080205 0xF82678A8 0x910004C6 0x91000521 0x14000004 0xAA0803E2 0x14000002 0x91000521 0xD1000484 0xCB01004A 0xF100095F 0x5400022C 0x54000121 0xF861780E 0xD100044F 0xF86F7805 0xEB0501DF 0x5400008D 0xD1000C84 0xF8217805 0xF82F780E 0xD1000484 0xB4000266 0xD10004C6 0xF8667A01 0x91080205 0xF86678A2 0x17FFFFED 0x91000428 0xD1000449 0xF8617811 0xD1000484 0x17FFFF8D 0xAA0903EB 0xAA0803EA 0xAA0103E9 0xAA0603EC 0xAA0103ED 0xAA0203EE 0xD2800006 0x14000002 0xD2800026])
                (gn-emit (enc-str 4 7 CTX-FUEL)) (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cbnz 6 8))
                (gn-mov (gn-sreg M 2) 9) (gn-mov (gn-sreg M 3) 10) (gn-mov (gn-sreg M 4) 11) (gn-mov (gn-sreg M 5) 12)
                (gn-mov (gn-sreg M 6) 13) (gn-mov (gn-sreg M 7) 14) (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0))
                (gn-mov 0 rv))
           m1 (-> m0 (gn-epilogue) (kb-keep) (gn-gs gn-f-dead 0))]
      (ri-patch m1 G 0 (vector-at m1 MM-CODE-N))))))))
;; tbz xt, #bit, off (words); stp q16, q16, [xn, #off] (off a multiple of 16, below 1024)
(defn- pz-tbz [t :i64 bit :i64 off :i64] :i64
 (+ 0x36000000 (i64-shift-left (u64-shift-right bit 5) 31) (i64-shift-left (bit-and bit 31) 19)
    (i64-shift-left (bit-and off 16383) 5) (bit-and t 31)))
(defn- pz-stpq [n :i64 off :i64] :i64
 (+ 0xad000000 (i64-shift-left (bit-and (u64-shift-right off 4) 127) 15) (i64-shift-left 16 10) (i64-shift-left (bit-and n 31) 5) 16))
(defn- gz-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 24) true
  (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
        exit (gn-sir M (+ p 8) IF-A) n (gn-sir M (+ p 4) IF-B)
        writer (gn-sir M (+ p 13) IF-A)]
   (and (case k
    0 (gn-dot-at? M p OP-FN f 2 2)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 2 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
    12 (gn-dot-at? M (+ p 12) OP-CONST 2 0 0)
    13 (gn-dot-at? M (+ p 13) OP-CALL writer 0 3)
    14 (gn-dot-at? M (+ p 14) OP-LGET 1 2 0)
    15 (gn-dot-at? M (+ p 15) OP-CONST 2 1 0)
    16 (gn-dot-at? M (+ p 16) OP-BIN BOP-ADD 1 0)
    17 (gn-dot-at? M (+ p 17) OP-LSET 1 0 0)
    18 (gn-dot-at? M (+ p 18) OP-LSET 2 1 0)
    19 (gn-dot-at? M (+ p 19) OP-FUEL 0 0 0)
    20 (gn-dot-at? M (+ p 20) OP-BR head 0 0)
    21 (gn-dot-at? M (+ p 21) OP-LABEL exit 0 0)
    22 (gn-dot-at? M (+ p 22) OP-RET 0 0 0)
    23 (gn-dot-at? M (+ p 23) OP-END f 0 0)
    false) (gz-shape M p f (inc k))))))
(defn- gz-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B)]
  (and (> p 0) (< (+ p 23) (vector-at M MM-SIR-N))
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2)
       (= (gn-fnf M f FF-NSLOTS) 2) (= (gn-fnf M f FF-DEPTH) 3)
       (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
       (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-g M gn-f-leaf) 1)
       (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-freg) 1)
       (= (gn-g M gn-f-h) 0) (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1)
       (>= n 1) (<= n 64)
       (> (gn-sir M (+ p 2) IF-A) 0) (> (gn-sir M (+ p 6) IF-B) 0)
       (> (gn-sir M (+ p 8) IF-A) 0)
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 6) IF-B))
       (not= (gn-sir M (+ p 2) IF-A) (gn-sir M (+ p 8) IF-A))
       (not= (gn-sir M (+ p 6) IF-B) (gn-sir M (+ p 8) IF-A))
       (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))
       (= (gn-lpos M (gn-sir M (+ p 6) IF-B)) (+ p 9))
       (= (gn-lpos M (gn-sir M (+ p 8) IF-A)) (+ p 21))
       (gn-copy-writer? M (gn-sir M (+ p 13) IF-A)) (gz-shape M p f 0))))
(defn- gz-stores [M :vector-i64 n :i64 k :i64] :vector-i64
 (cond (and (= k 0) (>= n 8) (<= n 128)) (gz-qstores (gn-emit M 0x6f00e410) n 0)
       (= k n) M
       (= (inc k) n) (gn-emit M (enc-str 31 16 (* 8 k)))
       :else (gz-stores (gn-emit M (enc-stp 31 31 16 (* 8 k))) n (+ k 2))))
;; v16 = 0: four items per stp q16, q16 (ascending), the rest as stp xzr / str xzr
(defn- gz-qstores [M :vector-i64 n :i64 k :i64] :vector-i64
 (if (> (+ k 4) n) (gz-stores M n k)
  (gz-qstores (gn-emit M (pz-stpq 16 (* 8 k))) n (+ k 4))))
(defn- gz-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (gz-admit M i)) M
  (let [n (gn-sir M (+ (dec i) 4) IF-B)
        m0 (gn-emit M (enc-cmp-i 1 0)) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 8 (* 2 n)))) b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312))
                  (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 4 16 0))
                  (gn-emit (enc-cmp-i 4 n))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 328))
                  (gn-emit (gn-e-addsl 16 16 17 3)) (gz-stores n 0)
                  (gn-emit (enc-sub-i 8 8 (* 2 n))) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at m4 MM-CODE-N)]
   (-> m4 (gn-dot-patch b0 end (enc-cond-ne)) (gn-dot-patch b1 end (enc-cond-lo))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-lo))))))

;; ldp/stp qt1, qt2, [xn, #off] (base 0xad400000 / 0xad000000, off a multiple of 16)
(defn- cp-q [base :i64 t1 :i64 t2 :i64 n :i64 off :i64] :i64
 (+ base (i64-shift-left (bit-and (u64-shift-right off 4) 127) 15) (i64-shift-left t2 10) (i64-shift-left n 5) t1))
;; r < 8 leading single items, then x2/x3 past them
(defn- cp-head [M :vector-i64 r :i64] :vector-i64
 (if (= r 0) M
  (-> (loop [m M k 0] (if (= k r) m (recur (-> m (gn-emit (enc-ldr 9 2 (* 8 k))) (gn-emit (enc-str 9 3 (* 8 k)))) (inc k))))
      (gn-emit (enc-add-i 2 2 (* 8 r))) (gn-emit (enc-add-i 3 3 (* 8 r))))))
(defn- gn-copy-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (gn-copy? M i)) M
  (let [p (dec i) n (gn-sir M (+ p 4) IF-B) dest (gn-sir M (+ p 11) IF-B)
        M0 (gn-emit M (enc-cmp-i 1 0)) b0 (vector-at M0 MM-CODE-N)
        M1 (-> M0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-emit (enc-cmp-i 8 (* 2 n)))) b1 (vector-at M1 MM-CODE-N)
        M2 (-> M1 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312))
                  (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at M2 MM-CODE-N)
        M3 (-> M2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 4 16 0))
                  (gn-mov-imm 16 (+ dest (dec n))) (gn-emit (enc-cmp-r 16 4))) b3 (vector-at M3 MM-CODE-N)
        M4 (-> M3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-i 4 n))) b4 (vector-at M4 MM-CODE-N)
        ;; a destination at least 8 items ahead (or not ahead) never feeds a read of the same 8-item chunk, so the
        ;; ascending copy may move n mod 8 single items and then 64 bytes per iteration through q0..q3
        wide (or (>= dest 8) (<= dest 0))
        M5 (-> M4 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 2 7 328))
                  (gn-emit (gn-e-addsl 2 2 17 3)) (gn-mov-imm 16 (* 8 dest))
                  (gn-emit (enc-add-r 3 2 16)) (cond-> wide (cp-head (bit-and n 7)))
                  (cond-> (or (not wide) (>= n 8)) (gn-mov-imm 4 (if wide (u64-shift-right n 3) n)))) loop (vector-at M5 MM-CODE-N)
        M6 (if wide
            (if (< n 8) M5
            (-> M5 (gn-emit (cp-q 0xad400000 0 1 2 0)) (gn-emit (cp-q 0xad400000 2 3 2 32))
                   (gn-emit (cp-q 0xad000000 0 1 3 0)) (gn-emit (cp-q 0xad000000 2 3 3 32))
                   (gn-emit (enc-add-i 2 2 64)) (gn-emit (enc-add-i 3 3 64)) (gn-emit (enc-subs-i 4 4 1))))
            (-> M5 (gn-emit (enc-ldr 9 2 0)) (gn-emit (enc-str 9 3 0))
                   (gn-emit (enc-add-i 2 2 8)) (gn-emit (enc-add-i 3 3 8))
                   (gn-emit (enc-subs-i 4 4 1)))) branch (vector-at M6 MM-CODE-N)
        M7 (-> M6 (cond-> (or (not wide) (>= n 8)) (gn-emit (enc-bcond (enc-cond-ne) (- loop branch))))
                  (gn-emit (enc-sub-i 8 8 (* 2 n))) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at M7 MM-CODE-N)]
   (-> M7 (gn-dot-patch b0 end (enc-cond-ne)) (gn-dot-patch b1 end (enc-cond-lo))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
          (gn-dot-patch b4 end (enc-cond-lo))))))

;; one SIR instruction (unreachable ones are dropped until the next LABEL / FN / END)
;; -1 means key0 OR the unchanged entry-root handle; positive slot means
;; every reaching path completed that slot's original checked access. Entry
;; does no speculative validation. Only such a positive witness crosses a tail.
(defn- gn-chain-step [M :vector-i64 i :i64 op :i64 a :i64] :vector-i64
 (if (not= (gn-g M gn-f-vmode) 2) (ve-step M i op a)
  (cond (or (= op OP-CONST) (= op OP-LGET) (= op OP-FUEL)) M
        (and (= op OP-BIN) (< a BOP-F64-ADD)) M
        (and (= op OP-CMP) (< a CC-F64-EQ)) M
        (and (= op OP-UN) (< a UOP-F64-NEG)) M
        (= op OP-LSET) (gn-vdrop M a)
        (= op OP-CALL) (let [w (gn-call-wrapper M i a (gn-sir M i IF-B) (gn-sir M i IF-C))]
          (if (or (> w 0) (and (= (gn-op M (inc i)) OP-RET) (= (gn-sir M (inc i) IF-A) (gn-sir M i IF-B)))
                  (jt-return M i (gn-sir M i IF-B))) M (gn-gs M gn-f-vslot 0)))
        (= op OP-RT) (if (or (= a RT-VECTOR-AT) (= a RT-VECTOR-ASSOC-IN-PLACE)) M (gn-gs M gn-f-vslot 0))
        :else (gn-gs M gn-f-vslot 0))))
;; Compile-time descriptor availability across a source-owned scalar call.
;; No runtime check or state. Every emitted effect must certify preservation.
(defn- dve-type [M :vector-i64 f :i64 n :i64] :bool
 (and (> f 0) (< f MM-FN-CAP) (<= (vector-at M MM-FN-N) MM-FN-CAP) (< f (vector-at M MM-FN-N)) (>= n 0) (<= n 3)
      (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-RTYPE) TY-I64)
      (loop [k 0] (or (= k n) (and (= (gn-fnf M f (+ FF-PT0 k)) TY-I64) (recur (inc k)))))))
(defn- dve-quiet [w :i64 r :i64] :bool
 (let [d (bit-and w 31)]
  (and (>= w 0) (<= w 4294967295) (not= d 3) (not= d 4) (not= d 7) (not= d r)
   (or (and (not= d 31)
        (or (= (bit-and w 0xffe0ffe0) 0xaa0003e0)
            (= (bit-and w 0xffc00000) 0xd2800000) (= (bit-and w 0xffc00000) 0xf2800000)
            (= (bit-and w 0xff000000) 0x91000000) (= (bit-and w 0xff000000) 0xd1000000) (= (bit-and w 0xffc00000) 0xf1000000)
            (= (bit-and w 0xff200000) 0x8b000000) (= (bit-and w 0xff200000) 0xcb000000)
            (= (bit-and w 0xff200000) 0x8a000000) (= (bit-and w 0xff200000) 0xaa000000)
            (= (bit-and w 0xff200000) 0xca000000)
            (= (bit-and w 0xffc00000) 0xd3400000) (= (bit-and w 0xffc00000) 0x93400000)
            (= (bit-and w 0xffe0fc00) 0x9b007c00)
            (= (bit-and w 0xffe00c00) 0x9a800000)
            (= (bit-and w 0xffc00000) 0xf9400000)
            (= (bit-and w 0xffe00c00) 0xf8600800)
            (= (bit-and w 0xffe0fc00) 0x9ac00c00)
            (= (bit-and w 0xffe0fc00) 0x9ac02000)
            (= (bit-and w 0xffe0fc00) 0x9ac02400)
            (= (bit-and w 0xffe0fc00) 0x9ac02800)
            (= (bit-and w 0xffe08000) 0x9b008000)
            (= (bit-and w 0xffe00000) 0x93c00000)
            (= (bit-and w 0x9f000000) 0x10000000)))
       (= (bit-and w 0xffe0fc1f) 0xeb00001f)
       (= (bit-and w 0xffc0001f) 0xf100001f)))))
(defn- dve-target [w :i64 at :i64] :i64
 (cond (= (bit-and w 0xfc000000) 0x14000000)
        (let [u (bit-and w 0x03ffffff)] (+ at (if (>= u 0x02000000) (- u 0x04000000) u)))
       (or (= (bit-and w 0xff000010) 0x54000000)
           (= (bit-and w 0x7e000000) 0x34000000))
        (let [u (bit-and (i64-shift-right w 5) 0x7ffff)] (+ at (if (>= u 0x40000) (- u 0x80000) u)))
       (= (bit-and w 0x7e000000) 0x36000000)
        (let [u (bit-and (i64-shift-right w 5) 0x3fff)] (+ at (if (>= u 0x2000) (- u 0x4000) u)))
       :else -1))
(defn- dve-effects [M :vector-i64 at :i64 begin :i64 end :i64 r :i64 left :i64] :bool
 (cond (= at end) true (or (<= left 0) (> at end)) false
  :else (let [w (vector-at M (+ MM-CODE-BASE at)) target (dve-target w at)
              okay (or (dve-quiet w r)
               (= w (enc-ldr 7 31 0))
               (= w (enc-str 8 7 CTX-FUEL)) (= w (enc-str 16 7 CTX-FUEL)) (= w (enc-str 31 7 CTX-FUEL))
               (= w (enc-brk 0)) (= w (enc-brk 1))
               (and (>= target begin) (<= target end)))]
   (and okay (dve-effects M (inc at) begin end r (dec left))))))
(defn- dve-fixes [M :vector-i64 j :i64 n :i64 begin :i64 end :i64 left :i64] :bool
 (cond (= j n) true (or (<= left 0) (> j n)) false
  :else (let [b (+ MM-FIX-BASE (* j MM-FIX-W)) at (vector-at M (+ b XF-AT))
              lit (vector-at M (+ b XF-TARGET))]
   (and (= (vector-at M (+ b XF-KIND)) FX-LIT32) (= (vector-at M (+ b XF-AUX)) 0)
        (> lit 0) (< lit (vector-at M MM-LIT-N))
        (>= at begin) (< (inc at) end)
        (= (bit-and (vector-at M (+ MM-CODE-BASE at)) 0xffe00000) 0xd2800000)
        (= (bit-and (vector-at M (+ MM-CODE-BASE at 1)) 0xffe00000) 0xf2a00000)
        (= (bit-and (vector-at M (+ MM-CODE-BASE at)) 31)
           (bit-and (vector-at M (+ MM-CODE-BASE at 1)) 31))
        (dve-fixes M (inc j) n begin end (dec left))))))
(defn- dve-original-ins [M :vector-i64 i :i64 op :i64] :vector-i64
 (ocb-post (gn-ins-quiet (vi-step (gn-chain-step M i op (gn-sir M i IF-A)) op (gn-sir M i IF-A)) i op) i op))
(defn- dve-domain [M :vector-i64 i :i64] :bool
 (if (< (vector-count M) MM-WORDS) false
  (let [g (vector-at M gn-cell) sn (vector-at M MM-SIR-N)]
   (and (>= g MM-HEAP-BASE) (<= (vector-at M MM-HEAP-TOP) MM-HEAP-END)
        (<= g (- (vector-at M MM-HEAP-TOP) (+ gn-a-sreg gn-cap)))
        (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)
        (> sn 0) (<= sn MM-SIR-CAP) (> i 0) (< i sn)))))
(defn- dve-owner [M :vector-i64 j :i64 left :i64] :i64
 (cond (or (<= j 0) (<= left 0)) 0
       (= (gn-op M j) OP-END) 0
       (= (gn-op M j) OP-FN)
        (let [f (gn-sir M j IF-A)]
         (if (and (> f 0) (< f MM-FN-CAP) (< f (vector-at M MM-FN-N))
                  (= (gn-fnf M f FF-SIR) j)
                  (= (gn-fnf M f FF-NPARAMS) (gn-sir M j IF-B))
                  (= (gn-fnf M f FF-NSLOTS) (gn-g M gn-f-ns))
                  (= (gn-fnf M f FF-DEPTH) (gn-g M gn-f-dp))) f 0))
       :else (dve-owner M (dec j) (dec left))))
(defn- dve-ins [M :vector-i64 i :i64 op :i64] :vector-i64
 (if (not (dve-domain M i)) (dve-original-ins M i op)
 (let [raw (gn-g M gn-f-vslot)
       slot (if (= (gn-g M gn-f-vmode) -1)
        (cond (and (< raw -1) (> raw (- -1 gn-cap))) (- -1 raw)
              (and (< raw (- -1 gn-cap)) (> raw (- -1 (* 2 gn-cap)))) (- (- -1 gn-cap) raw)
              :else raw) raw)
       ns (gn-g M gn-f-ns)
       r (if (and (> ns 0) (< ns gn-cap) (> slot 0) (<= slot ns) (< slot gn-cap)) (gn-sreg M slot) -1)
       begin (vector-at M MM-CODE-N) fix (vector-at M MM-FIX-N) labels (vector-at M MM-LABEL-N)
       eligible (and (= op OP-CALL) (= (gn-g M gn-f-vmode) -1)
        (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
        (>= r 19) (<= r 28) (> (gn-g M gn-f-fb) 0) (> (dve-owner M i 4096) 0) (dve-type M (gn-sir M i IF-A) (gn-sir M i IF-C)))
       out (dve-original-ins M i op)
       end (vector-at out MM-CODE-N)]
  (if (and eligible (= (vector-at out MM-ERR) 0)
       (= (gn-g out gn-f-vmode) -1) (= (gn-g out gn-f-leaf) 0) (= (gn-g out gn-f-dead) 0)
       (= (vector-at out MM-LABEL-N) labels) (>= fix 0) (>= (vector-at out MM-FIX-N) fix) (<= (vector-at out MM-FIX-N) MM-FIX-CAP)
       (> (vector-at out MM-LIT-N) 0) (<= (vector-at out MM-LIT-N) MM-LIT-CAP) (= (gn-g out gn-f-ns) ns) (= (gn-sreg out slot) r) (>= begin 0) (> end begin)
       (<= end MM-CODE-CAP) (<= (- end begin) 64)
       (dve-fixes out fix (vector-at out MM-FIX-N) begin end 16)
       (dve-effects out begin begin end r 64))
   (gn-gs out gn-f-vslot
    (if (and (< raw -1) (> slot 0) (<= slot ns) (< slot gn-cap))
     (- (- -1 gn-cap) slot) (- -1 slot))) out))))
(defn- gn-ins [M :vector-i64 i :i64 op :i64] :vector-i64
 (dve-ins M i op))
;; Generic exact typed two-i64 record copy. Success-only nonleaf fast path;
;; original entry charge/frame/body/invalid and insufficient-fuel fallback retained.
(defn- pc3-helper-type [M :vector-i64 f :i64 np :i64 rt :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
      (= (gn-fnf M f FF-NPARAMS) np) (= (gn-fnf M f FF-NSLOTS) np)
      (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-RTYPE) rt)
      (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
      (or (= np 2) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64))))
(defn- pc3-writer-shape [M :vector-i64 p :i64 f :i64] :bool
  (and
    (gn-dot-at? M p OP-FN f 3 3)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (and (> (gn-sir M (+ p 2) IF-A) 0) (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0) (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2)))
    (gn-dot-at? M (+ p 3) 4 0 1 0)
    (gn-dot-at? M (+ p 4) 4 1 2 0)
    (gn-dot-at? M (+ p 5) 4 2 3 0)
    (gn-dot-at? M (+ p 6) 14 208 0 3)
    (gn-dot-at? M (+ p 7) 19 0 0 0)
    (gn-dot-at? M (+ p 8) OP-END f 0 0)))
(defn- pc3-reader-shape [M :vector-i64 p :i64 f :i64] :bool
  (and
    (gn-dot-at? M p OP-FN f 2 2)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (and (> (gn-sir M (+ p 2) IF-A) 0) (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0) (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2)))
    (gn-dot-at? M (+ p 3) 4 0 1 0)
    (gn-dot-at? M (+ p 4) 4 1 2 0)
    (gn-dot-at? M (+ p 5) 3 2 2 0)
    (gn-dot-at? M (+ p 6) 6 3 1 0)
    (gn-dot-at? M (+ p 7) 14 176 0 2)
    (gn-dot-at? M (+ p 8) 19 0 0 0)
    (gn-dot-at? M (+ p 9) OP-END f 0 0)))
(defn- pc3-shape [M :vector-i64 p :i64 f :i64 reader :i64 writer :i64] :bool
  (and
    (gn-dot-at? M p OP-FN f 3 5)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (and (> (gn-sir M (+ p 2) IF-A) 0) (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0) (= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2)))
    (gn-dot-at? M (+ p 3) 4 0 1 0)
    (gn-dot-at? M (+ p 4) 4 1 3 0)
    (gn-dot-at? M (+ p 5) OP-CALL reader 0 2)
    (gn-dot-at? M (+ p 6) 5 4 0 0)
    (gn-dot-at? M (+ p 7) 4 0 1 0)
    (gn-dot-at? M (+ p 8) 4 1 3 0)
    (gn-dot-at? M (+ p 9) 3 2 2 0)
    (gn-dot-at? M (+ p 10) 6 3 1 0)
    (gn-dot-at? M (+ p 11) 3 2 1 0)
    (gn-dot-at? M (+ p 12) 6 1 1 0)
    (gn-dot-at? M (+ p 13) 14 176 0 2)
    (gn-dot-at? M (+ p 14) 5 5 0 0)
    (gn-dot-at? M (+ p 15) 4 0 1 0)
    (gn-dot-at? M (+ p 16) 4 1 2 0)
    (gn-dot-at? M (+ p 17) 3 2 2 0)
    (gn-dot-at? M (+ p 18) 6 3 1 0)
    (gn-dot-at? M (+ p 19) 4 2 4 0)
    (gn-dot-at? M (+ p 20) OP-CALL writer 0 3)
    (gn-dot-at? M (+ p 21) 4 1 2 0)
    (gn-dot-at? M (+ p 22) 3 2 2 0)
    (gn-dot-at? M (+ p 23) 6 3 1 0)
    (gn-dot-at? M (+ p 24) 3 2 1 0)
    (gn-dot-at? M (+ p 25) 6 1 1 0)
    (gn-dot-at? M (+ p 26) 4 2 5 0)
    (gn-dot-at? M (+ p 27) OP-CALL writer 0 3)
    (gn-dot-at? M (+ p 28) 19 0 0 0)
    (gn-dot-at? M (+ p 29) OP-END f 0 0)))
(defn- pc3-admit [M :vector-i64 i :i64] :bool
 (if (or (<= i 1) (>= (+ i 28) (vector-at M MM-SIR-N)) (not= (gn-op M (dec i)) OP-FN)) false
 (let [p (dec i) f (gn-sir M p IF-A) reader (gn-sir M (+ p 5) IF-A)
       writer (gn-sir M (+ p 20) IF-A) rv (gn-sreg M 1) rd (gn-sreg M 2) rs (gn-sreg M 3)]
  (and (> p 0) (< (+ p 29) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN)
       (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
       (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 3)
       (= (gn-fnf M f FF-NSLOTS) 5) (= (gn-fnf M f FF-DEPTH) 3)
       (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
       (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-ctx) 1)
       (>= rv 19) (<= rv 28) (>= rd 19) (<= rd 28) (>= rs 19) (<= rs 28)
       (not= rv rd) (not= rv rs) (not= rd rs)
       (pc3-helper-type M reader 2 TY-I64) (pc3-helper-type M writer 3 TY-VEC)
       (> (gn-fnf M reader FF-SIR) 0) (< (+ (gn-fnf M reader FF-SIR) 9) (vector-at M MM-SIR-N))
       (> (gn-fnf M writer FF-SIR) 0) (< (+ (gn-fnf M writer FF-SIR) 8) (vector-at M MM-SIR-N))
       (pc3-reader-shape M (gn-fnf M reader FF-SIR) reader)
       (pc3-writer-shape M (gn-fnf M writer FF-SIR) writer)
       (pc3-shape M p f reader writer)))))
(defn- pc3-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (pc3-admit M i)) M
  (let [rv (gn-sreg M 1) rd (gn-sreg M 2) rs (gn-sreg M 3)
        m0 (-> M (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 3))) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-mov-imm 16 4611686018427387904) (gn-emit (enc-cmp-r rs 16))) b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-cmp-r rd 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 312))
                  (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 3 4 16 0))
                  (gn-emit (gn-e-lsl 1 rs 1)) (gn-emit (gn-e-lsl 2 rd 1))
                  (gn-emit (enc-add-i 17 1 1)) (gn-emit (enc-cmp-r 17 4))) b4 (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-add-i 17 2 1)) (gn-emit (enc-cmp-r 17 4))) b5 (vector-at m5 MM-CODE-N)
        m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 6 7 328))
                  (gn-emit (enc-add-r 5 3 1)) (gn-emit (enc-add-r 17 3 2))
                  (gn-emit (gn-e-addsl 5 6 5 3)) (gn-emit (gn-e-addsl 6 6 17 3))
                  (gn-emit (enc-ldp 1 2 5 0)) (gn-emit (enc-sub-i 8 8 3))
                  (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-stp 1 2 6 0))
                  (gn-mov 0 rv) (gn-epilogue) (gn-gs gn-f-dead 0))
        end (vector-at m6 MM-CODE-N)]
   (-> m6 (gn-dot-patch b0 end (enc-cond-lo)) (gn-dot-patch b1 end (enc-cond-hs))
          (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
          (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-hs))))))

;; Bounded closed constant-index copy/write tail intervals. All original
;; charges and partial writes remain in the fallback; complete safe budget
;; and descriptor range permit exact successful aggregate charging.
(defn- cw-type [M :vector-i64 f :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
      (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f FF-RTYPE) TY-VEC)))
(defn- cw-value-end [M :vector-i64 q :i64] :i64
 (let [read (gn-dot-at? M q OP-LGET 0 1 0)
       b (if read (+ q 3) (inc q))]
  (if (and (if read
    (and (gn-dot-at? M (inc q) OP-CONST 1 (gn-sir M (inc q) IF-B) 0)
         (>= (gn-sir M (inc q) IF-B) 0) (<= (gn-sir M (inc q) IF-B) 4095)
         (gn-dot-at? M (+ q 2) OP-RT RT-VECTOR-AT 0 2))
    (gn-dot-at? M q OP-CONST 0 (gn-sir M q IF-B) 0))
   (or (= (gn-op M b) OP-LSET)
       (and (gn-dot-at? M b OP-CALL (gn-sir M b IF-A) 0 1)
            (> (gn-sign-wrapper M (gn-sir M b IF-A) 1) 0)
            (< (gn-sign-wrapper M (gn-sir M b IF-A) 1) 1536)
            (not (gn-clamp-open M (gn-sir M b IF-A))))))
   (if (= (gn-op M b) OP-CALL) (inc b) b) 0)))
(defn- cw-stage [M :vector-i64 f :i64] :i64
 (if (not (cw-type M f)) 0
  (let [p (gn-fnf M f FF-SIR) q (+ p 3)]
   (if (or (<= p 0) (>= (+ p 16) (vector-at M MM-SIR-N))
           (not= (gn-fnf M f FF-NSLOTS) 3) (not= (gn-fnf M f FF-DEPTH) 3)
           (not (gn-dot-at? M p OP-FN f 1 3))
           (not (gn-dot-at? M (inc p) OP-FUEL 0 0 0))
           (not (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0))
           (<= (gn-sir M (+ p 2) IF-A) 0) (>= (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
           (not= (gn-lpos M (gn-sir M (+ p 2) IF-A)) (+ p 2))) 0
    (let [v (cw-value-end M q) put (gn-sir M (+ v 6) IF-A)
          next (gn-sir M (+ v 7) IF-A) index (gn-sir M (inc v) IF-B)]
     (if (and (> v 0) (< (+ v 9) (vector-at M MM-SIR-N))
       (gn-dot-at? M v OP-LSET 2 0 0)
       (>= index 0) (<= index 4095) (gn-dot-at? M (inc v) OP-CONST 0 index 0)
       (gn-dot-at? M (+ v 2) OP-LSET 3 0 0)
       (gn-dot-at? M (+ v 3) OP-LGET 0 1 0)
       (gn-dot-at? M (+ v 4) OP-LGET 1 3 0)
       (gn-dot-at? M (+ v 5) OP-LGET 2 2 0)
       (gn-dot-at? M (+ v 6) OP-CALL put 0 3)
       (> put 0) (< put (vector-at M MM-FN-N)) (not (gn-clamp-open M put))
       (= (gn-wrapper M put 0 3) (+ RT-VECTOR-ASSOC-IN-PLACE 256))
       (= (gn-fnf M put FF-PT0) TY-VEC) (= (gn-fnf M put (+ FF-PT0 1)) TY-I64)
       (= (gn-fnf M put (+ FF-PT0 2)) TY-I64) (= (gn-fnf M put FF-RTYPE) TY-VEC)
       (gn-dot-at? M (+ v 7) OP-CALL next 0 1) (cw-type M next)
       (gn-dot-at? M (+ v 8) OP-RET 0 0 0)
       (gn-dot-at? M (+ v 9) OP-END f 0 0)) q 0))))))
(defn- cw-next [M :vector-i64 q :i64] :i64 (gn-sir M (+ (cw-value-end M q) 7) IF-A))
(defn- cw-sign [M :vector-i64 q :i64] :i64
 (let [v (cw-value-end M q)]
  (if (= (gn-op M (dec v)) OP-CALL) (gn-sign-wrapper M (gn-sir M (dec v) IF-A) 1) 0)))
(defn- cw-count [M :vector-i64 f :i64 left :i64] :i64
 (let [q (cw-stage M f)]
  (if (or (= left 0) (= q 0)) 0 (inc (cw-count M (cw-next M q) (dec left))))))
(defn- cw-budget [M :vector-i64 f :i64 n :i64] :i64
 (if (= n 0) 0 (let [q (cw-stage M f)]
  (+ 2 (if (>= (cw-sign M q) 1536) 1 0) (cw-budget M (cw-next M q) (dec n))))))
(defn- cw-max [M :vector-i64 f :i64 n :i64] :i64
 (if (= n 0) 0 (let [q (cw-stage M f) v (cw-value-end M q)
   index (gn-sir M (inc v) IF-B) read (if (= (gn-op M q) OP-LGET) (gn-sir M (inc q) IF-B) 0)]
  (gn-max (gn-max index read) (cw-max M (cw-next M q) (dec n))))))
(defn- cw-head [M :vector-i64 j :i64 owner :i64 f :i64] :bool
 (if (>= j (vector-at M MM-SIR-N)) false
  (let [op (gn-op M j) a (gn-sir M j IF-A)]
   (if (and (= op OP-CALL) (= a f)
       (let [q (cw-stage M owner)] (or (= q 0) (not= (cw-next M q) f)))) true
    (cw-head M (inc j) (if (= op OP-FN) a owner) f)))))
;; The admitted chain is linear, with one unchanged store per source stage.
;; x9 still holds the last stored value when the next stage reads that exact
;; item. Its sign width survives forwarding; widening sign extension is then
;; idempotent. Any other read or a constant establishes a fresh value fact.
(defn- cw-emit-available [M :vector-i64 f :i64 n :i64 last-index :i64 last-width :i64] :vector-i64
 (if (= n 0) (-> M (gn-vclear) (gn-fix FX-BL26 f) (gn-emit (enc-b 0)))
  (let [q (cw-stage M f) v (cw-value-end M q) sign (cw-sign M q)
        index (gn-sir M (inc v) IF-B) read (= (gn-op M q) OP-LGET)
        forward (and read (= (gn-sir M (inc q) IF-B) last-index))
        width (if (> sign 0) (bit-and sign 511) 0)
        narrow (and (> width 0) (not (and forward (> last-width 0) (<= last-width width))))
        next-width (if (> width 0) width (if forward last-width 0))
        off (* 8 (gn-sir M (inc q) IF-B))
        ;; items are little-endian words: the sign-extending byte/half/word load of an item's low bytes equals
        ;; ldr + sbfm #0, #(width-1)
        fused (and read (not forward) narrow (>= off 0) (cw-ldrs-ok? width off))]
   (cw-emit-available (-> M
     (cond-> fused (gn-emit (cw-ldrs width 9 10 off)))
     (cond-> (and read (not forward) (not fused)) (gn-emit (enc-ldr 9 10 off)))
     (cond-> (= (gn-op M q) OP-CONST) (gn-mov-imm 9 (gn-sir M q IF-B)))
     (cond-> (and narrow (not fused)) (gn-emit (gn-e-bf 0x93400000 9 9 0 (dec width))))
     (gn-emit (enc-str 9 10 (* 8 index)))) (cw-next M q) (dec n) index next-width))))
(defn- cw-ldrs-ok? [width :i64 off :i64] :bool
 (or (and (= width 8) (<= off 4095)) (and (= width 16) (<= off 8190)) (and (= width 32) (<= off 16380))))
;; ldrsb / ldrsh / ldrsw xt, [xn, #off] (unsigned offset, 64-bit destination)
(defn- cw-ldrs [width :i64 t :i64 n :i64 off :i64] :i64
 (+ (cond (= width 8) 0x39800000 (= width 16) 0x79800000 :else 0xb9800000)
    (i64-shift-left (cond (= width 8) off (= width 16) (u64-shift-right off 1) :else (u64-shift-right off 2)) 10)
    (i64-shift-left (bit-and n 31) 5) (bit-and t 31)))
(defn- cw-emit [M :vector-i64 f :i64 n :i64] :vector-i64
 (cw-emit-available M f n -1 0))
;; ADR0357: same-register store-to-load availability in existing CW admission.
;; No publication is removed. All preflight helpers are read-only; false keeps
;; the original explicit reload. Counts precede every variable-address lookup.
(defn- cfr-signed [v :i64 sign :i64 modulus :i64] :i64
 (if (>= v sign) (- v modulus) v))
(defn- cfr-labels [M :vector-i64 j :i64 total :i64 at :i64] :bool
 (if (= j total) true
  (let [v (vector-at M (+ MM-LABEL-BASE j))]
   (and (>= v 0) (< v MM-CODE-CAP) (not= v at)
        (cfr-labels M (inc j) total at)))))
(defn- cfr-functions [M :vector-i64 j :i64 total :i64 at :i64] :bool
 (if (= j total) true
  (let [v (gn-fnf M j FF-CODE)]
   (and (>= v 0) (< v at) (cfr-functions M (inc j) total at)))))
(defn- cfr-fixes [M :vector-i64 j :i64 total :i64 at :i64 nf :i64 ln :i64 lit :i64] :bool
 (if (= j total) true
  (let [b (+ MM-FIX-BASE (* j MM-FIX-W))
        site (vector-at M (+ b XF-AT)) kind (vector-at M (+ b XF-KIND))
        target (vector-at M (+ b XF-TARGET)) aux (vector-at M (+ b XF-AUX))]
   (if (or (<= site 0) (>= site (- at 6)) (< kind FX-B26) (> kind FX-ADRL19)) false
    (let [ok (cond (= kind FX-LIT32)
                   (and (= aux 0) (> target 0) (< target lit) (< (inc site) (- at 6)))
               (or (= kind FX-BL26) (= kind FX-ADR19))
                   (if (or (<= target 0) (>= target nf)) false
                    (let [entry (gn-fnf M target FF-CODE)]
                     (and (>= entry 0) (< entry at)
                          (if (= aux 0) true
                           (and (= kind FX-BL26) (or (= aux 1) (= aux 2))
                                (or (= entry 0) (< (+ entry aux) at)))))))
               :else (and (= aux 0) (> target 0) (< target ln)
                          (> (vector-at M (+ MM-LABEL-BASE target)) 0)
                          (< (vector-at M (+ MM-LABEL-BASE target)) at)))]
     (and ok (cfr-fixes M (inc j) total at nf ln lit)))))))
(defn- cfr-code [M :vector-i64 j :i64 at :i64] :bool
 (if (= j at) true
  (let [w (vector-at M (+ MM-CODE-BASE j))]
   (if (or (< w 0) (> w 4294967295)) false
    (let [branch26 (= (bit-and w 2080374784) 335544320)
          branch19 (or (= (bit-and w 4278190096) 1409286144)
                       (= (bit-and w 2113929216) 872415232))
          branch14 (= (bit-and w 2113929216) 905969664)
          literal (= (bit-and w 989855744) 402653184)
          adr (= (bit-and w 2667577344) 268435456)
          adrp (= (bit-and w 2667577344) 2415919104)
          delta (cond branch26 (cfr-signed (bit-and w 67108863) 33554432 67108864)
                   (or branch19 literal) (cfr-signed (bit-and (u64-shift-right w 5) 524287) 262144 524288)
                   branch14 (cfr-signed (bit-and (u64-shift-right w 5) 16383) 8192 16384)
                   :else 0)
          adelta (if adr (cfr-signed
                    (+ (* 4 (bit-and (u64-shift-right w 5) 524287))
                       (bit-and (u64-shift-right w 29) 3)) 1048576 2097152) 0)]
     (and (not adrp)
          (not (and (or branch26 branch19 branch14 literal) (= (+ j delta) at)))
          (not (and adr (= (+ (* 4 (dec j)) adelta) (* 4 (dec at)))))
          (cfr-code M (inc j) at)))))))
(defn- cfr-paid [M :vector-i64 i :i64 f :i64] :bool
 (let [sn (vector-at M MM-SIR-N) nf (vector-at M MM-FN-N)
       cn (vector-at M MM-CODE-N) ln (vector-at M MM-LABEL-N) xn (vector-at M MM-FIX-N) lit (vector-at M MM-LIT-N)]
  (if (or (<= sn 1) (> sn MM-SIR-CAP) (<= i 1) (>= i sn)
          (<= nf 1) (> nf MM-FN-CAP) (<= f 0) (>= f nf)
          (< cn 7) (>= cn MM-CODE-CAP)
          (< ln 1) (> ln MM-LABEL-CAP) (< xn 1) (> xn MM-FIX-CAP)
          (< lit 1) (> lit MM-LIT-CAP)) false
   (and (= (gn-g M gn-f-leaf) 2) (= (gn-g M gn-f-freg) 2)
        (= (gn-g M gn-f-vmode) 2) (= (gn-g M gn-f-fb) 0)
        (= (gn-g M gn-f-dead) 0) (= (gn-g M gn-f-skip) 0)
        (= (gn-fnf M f FF-SIR) (dec i)) (= (gn-fnf M f FF-CODE) (- cn 6))
        (= (gn-fnf M f FF-FUEL) 1) (= (gn-fnf M f FF-NPARAMS) 1)
        (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 3)
        (= (gn-op M (dec i)) OP-FN) (= (gn-sir M (dec i) IF-A) f)
        (= (gn-sir M (dec i) IF-B) 1) (= (gn-sir M (dec i) IF-C) 3)
        (= (gn-op M i) OP-FUEL) (= (gn-sir M i IF-A) 0)
        (= (gn-sir M i IF-B) 0) (= (gn-sir M i IF-C) 0)
        (= (vector-at M (+ MM-CODE-BASE (- cn 6))) (enc-movz 5 0 0))
        (= (vector-at M (+ MM-CODE-BASE (- cn 5))) (enc-ldr 8 7 CTX-FUEL))
        (= (vector-at M (+ MM-CODE-BASE (- cn 4))) (enc-subs-i 8 8 1))
        (= (vector-at M (+ MM-CODE-BASE (- cn 3))) (enc-bcond (enc-cond-hs) 2))
        (= (vector-at M (+ MM-CODE-BASE (- cn 2))) (enc-brk 0))
        (= (vector-at M (+ MM-CODE-BASE (dec cn))) (enc-str 8 7 CTX-FUEL))
        (cfr-labels M 1 ln cn) (cfr-functions M 1 nf cn)
        (cfr-fixes M 1 xn cn nf ln lit) (cfr-code M 1 cn)))))

;; At most 307 words cover the extended hot prefix. Reserve 512 locally;
;; below that headroom retain the original 16-stage admission and cold body.
(defn- cw-entry-work [M :vector-i64] :i64
 (if (>= (- MM-CODE-CAP (vector-at M MM-CODE-N)) 512) 48 16))
(defn- cw-entry [M :vector-i64 i :i64] :vector-i64
 (if (or (<= i 1) (not= (gn-op M (dec i)) OP-FN)
         (not= (gn-g M gn-f-leaf) 2) (not= (gn-g M gn-f-freg) 2)
         (not= (gn-g M gn-f-vmode) 2) (not= (gn-g M gn-f-fb) 0)) M
  (let [f (gn-sir M (dec i) IF-A) n (cw-count M f (cw-entry-work M))]
   ;; A bounded prefix is admitted; a longer chain keeps its original tail.
   (if (or (< n 4) (not (cw-head M 1 0 f))) M
    (let [cost (dec (cw-budget M f n)) high (cw-max M f n)
          m0 (-> M (cond-> (not (cfr-paid M i f)) (gn-emit (enc-ldr 8 7 CTX-FUEL)))
                    (gn-emit (enc-cmp-i 8 cost))) b0 (vector-at m0 MM-CODE-N)
          m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-ldr 16 7 312))
                   (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
                   (gn-emit (enc-cmp-r 17 16))) b1 (vector-at m1 MM-CODE-N)
          m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
                   (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
                   (gn-emit (enc-cmp-i 16 high))) b2 (vector-at m2 MM-CODE-N)
          m3 (-> m2 (gn-emit (enc-bcond 9 0)) (gn-emit (enc-ldr 10 7 328))
                   (gn-emit (gn-e-addsl 10 10 17 3)) (gn-emit (enc-sub-i 8 8 cost))
                   (gn-emit (enc-str 8 7 CTX-FUEL)) (cw-emit f n))
          end (vector-at m3 MM-CODE-N)]
     (-> m3 (gn-dot-patch b0 end (enc-cond-lo)) (gn-dot-patch b1 end (enc-cond-hs))
            (gn-dot-patch b2 end 9)))))))

;; Complete guarded dual affine-reader reduction interval. Exact closed shape,
;; whole bounded index envelopes and fuel proved before any changed effect.
(defn- dr-shape [M :vector-i64 i :i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
  (let [p (gn-fnf M f FF-SIR) total (vector-at M MM-SIR-N)]
   (if (or (<= p 0) (> p (- total 7))) 0
    (let [d (if (= (gn-sir M (+ p 5) IF-A) CC-GT) 2 0) lh (gn-sir M (+ p 2) IF-A) lb (gn-sir M (+ p 9) IF-A)
          le (gn-sir M (+ p 34 d) IF-A) reader (gn-sir M (+ p 20 d) IF-A)
          q (mr-reader M (+ p 20 d) reader 3)]
     (if (and (<= p (- total (+ 37 d))) (> q 0) (gn-dot-at? M (inc (gn-fnf M reader FF-SIR)) OP-FUEL 0 0 0)
       (> (gn-sir M (+ q 2) IF-B) 0) (<= (gn-sir M (+ q 2) IF-B) 4095)
       (= (gn-fnf M f FF-NPARAMS) 5) (= (gn-fnf M f FF-NSLOTS) 5)
       (= (gn-fnf M f FF-DEPTH) 9) (= (gn-fnf M f FF-RTYPE) TY-I64)
       (= (gn-fnf M f FF-PT0) TY-VEC)
       (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
       (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
       (> lh 0) (< lh MM-LABEL-CAP) (> lb 0) (< lb MM-LABEL-CAP)
       (> le 0) (< le MM-LABEL-CAP) (not= lh lb) (not= lh le) (not= lb le)
       (= (gn-lpos M lh) (+ p 2)) (= (gn-lpos M lb) (+ p 9)) (= (gn-lpos M le) (+ p 34 d))
       (if (= d 0) (and
       (gn-dot-at? M (+ p 0) OP-FN f 5 5)
       (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL lh 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
       (gn-dot-at? M (+ p 4) OP-LGET 1 3 0)
       (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
       (gn-dot-at? M (+ p 6) OP-BRZ 0 lb 0)
       (gn-dot-at? M (+ p 7) OP-LGET 0 5 0)
       (gn-dot-at? M (+ p 8) OP-BR le 0 0)
       (gn-dot-at? M (+ p 9) OP-LABEL lb 0 0)
       (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
       (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
       (gn-dot-at? M (+ p 13) OP-LGET 3 4 0)
       (gn-dot-at? M (+ p 14) OP-CONST 4 1 0)
       (gn-dot-at? M (+ p 15) OP-BIN BOP-ADD 3 0)
       (gn-dot-at? M (+ p 16) OP-LGET 4 5 0)
       (gn-dot-at? M (+ p 17) OP-LGET 5 1 0)
       (gn-dot-at? M (+ p 18) OP-LGET 6 2 0)
       (gn-dot-at? M (+ p 19) OP-LGET 7 4 0)
       (gn-dot-at? M (+ p 20) OP-CALL reader 5 3)
       (gn-dot-at? M (+ p 21) OP-LGET 6 1 0)
       (gn-dot-at? M (+ p 22) OP-LGET 7 4 0)
       (gn-dot-at? M (+ p 23) OP-LGET 8 3 0)
       (gn-dot-at? M (+ p 24) OP-CALL reader 6 3)
       (gn-dot-at? M (+ p 25) OP-BIN BOP-MUL 5 0)
       (gn-dot-at? M (+ p 26) OP-BIN BOP-SUB 4 0)
       (gn-dot-at? M (+ p 27) OP-LSET 1 0 0)
       (gn-dot-at? M (+ p 28) OP-LSET 2 1 0)
       (gn-dot-at? M (+ p 29) OP-LSET 3 2 0)
       (gn-dot-at? M (+ p 30) OP-LSET 4 3 0)
       (gn-dot-at? M (+ p 31) OP-LSET 5 4 0)
       (gn-dot-at? M (+ p 32) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 33) OP-BR lh 0 0)
       (gn-dot-at? M (+ p 34) OP-LABEL le 0 0)
       (gn-dot-at? M (+ p 35) OP-RET 0 0 0)
       (gn-dot-at? M (+ p 36) OP-END f 0 0)
        ) (and
       (gn-dot-at? M (+ p 0) OP-FN f 5 5)
       (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL lh 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
       (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 5) OP-CMP CC-GT 0 0)
       (gn-dot-at? M (+ p 6) OP-BRZ 0 lb 0)
       (gn-dot-at? M (+ p 7) OP-LGET 0 5 0)
       (gn-dot-at? M (+ p 8) OP-BR le 0 0)
       (gn-dot-at? M (+ p 9) OP-LABEL lb 0 0)
       (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
       (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
       (gn-dot-at? M (+ p 13) OP-LGET 3 4 0)
       (gn-dot-at? M (+ p 14) OP-CONST 4 1 0)
       (gn-dot-at? M (+ p 15) OP-BIN BOP-ADD 3 0)
       (gn-dot-at? M (+ p 16) OP-LGET 4 5 0)
       (gn-dot-at? M (+ p 17) OP-LGET 5 1 0)
       (gn-dot-at? M (+ p 18) OP-LGET 6 2 0)
       (gn-dot-at? M (+ p 19) OP-CONST 7 1 0)
       (gn-dot-at? M (+ p 20) OP-BIN BOP-ADD 6 0)
       (gn-dot-at? M (+ p 21) OP-LGET 7 4 0)
       (gn-dot-at? M (+ p 22) OP-CALL reader 5 3)
       (gn-dot-at? M (+ p 23) OP-LGET 6 1 0)
       (gn-dot-at? M (+ p 24) OP-LGET 7 4 0)
       (gn-dot-at? M (+ p 25) OP-LGET 8 3 0)
       (gn-dot-at? M (+ p 26) OP-CALL reader 6 3)
       (gn-dot-at? M (+ p 27) OP-BIN BOP-MUL 5 0)
       (gn-dot-at? M (+ p 28) OP-BIN BOP-SUB 4 0)
       (gn-dot-at? M (+ p 29) OP-LSET 1 0 0)
       (gn-dot-at? M (+ p 30) OP-LSET 2 1 0)
       (gn-dot-at? M (+ p 31) OP-LSET 3 2 0)
       (gn-dot-at? M (+ p 32) OP-LSET 4 3 0)
       (gn-dot-at? M (+ p 33) OP-LSET 5 4 0)
       (gn-dot-at? M (+ p 34) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 35) OP-BR lh 0 0)
       (gn-dot-at? M (+ p 36) OP-LABEL le 0 0)
       (gn-dot-at? M (+ p 37) OP-RET 0 0 0)
       (gn-dot-at? M (+ p 38) OP-END f 0 0)
        ))
      ) q 0))))))
(defn- dr-patch [M :vector-i64 branches :vector-i64 end :i64 j :i64] :vector-i64
 (if (= j (vector-count branches)) M
  (dr-patch (gn-dot-patch M (vector-at branches j) end 8) branches end (inc j))))
(defn- dr-entry [M :vector-i64 i :i64] :vector-i64
 (if (or (<= i 1) (not= (gn-op M (dec i)) OP-FN)
    (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
    (not= (gn-g M gn-f-vmode) 0)
    (or (< (gn-sreg M 1) 19) (> (gn-sreg M 1) 28)) (or (< (gn-sreg M 2) 19) (> (gn-sreg M 2) 28)) (or (< (gn-sreg M 3) 19) (> (gn-sreg M 3) 28)) (or (< (gn-sreg M 4) 19) (> (gn-sreg M 4) 28)) (or (< (gn-sreg M 5) 19) (> (gn-sreg M 5) 28))) M
  (let [f (gn-sir M (dec i) IF-A) q (dr-shape M i f)]
   (if (= q 0) M
    (let [stride (gn-sir M (+ q 2) IF-B)
      upper (= (gn-sir M (+ (gn-fnf M f FF-SIR) 5) IF-A) CC-GT)
      m0 (-> M (gn-mov 0 (gn-sreg M 1)) (gn-mov 1 (gn-sreg M 2))
               (gn-mov 2 (gn-sreg M 3)) (gn-mov 3 (gn-sreg M 4)) (gn-mov 9 (gn-sreg M 5))
               (gn-emit (enc-cmp-i 1 64))) b0 (vector-at m0 MM-CODE-N)
      m1 (-> m0 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-i 2 64))) b1 (vector-at m1 MM-CODE-N)
      m2 (-> m1 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-i 3 64))) b2 (vector-at m2 MM-CODE-N)
      m3 (-> m2 (gn-emit (enc-bcond 8 0))
                (cond-> upper (gn-emit (enc-add-i 1 1 1)))
                (gn-mov 4 (if upper 1 2)) (gn-emit (enc-cmp-r 3 4))) b3 (vector-at m3 MM-CODE-N)
      m4 (-> m3 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-sub-r 13 4 3))
                (gn-emit (enc-cmp-i 13 64))) b4 (vector-at m4 MM-CODE-N)
      m5 (-> m4 (gn-emit (enc-bcond 8 0)) (gn-mov-imm 5 stride) (gn-mov-imm 16 3)
                (gn-emit (enc-mul 15 13 16)) (gn-emit (enc-ldr 8 7 CTX-FUEL))
                (gn-emit (enc-cmp-r 15 8))) b5 (vector-at m5 MM-CODE-N)
      m6 (-> m5 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-ldr 16 7 312))
                (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
                (gn-emit (enc-cmp-r 17 16))) b6 (vector-at m6 MM-CODE-N)
      m7 (-> m6 (gn-emit (enc-bcond 2 0)) (gn-emit (enc-ldr 16 7 320))
                (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
                (gn-emit (enc-sub-i 12 4 1)) (gn-emit (enc-mul 11 1 5))
                (gn-emit (enc-add-r 11 11 12)) (gn-emit (enc-cmp-r 11 16))) b7 (vector-at m7 MM-CODE-N)
      m8 (-> m7 (gn-emit (enc-bcond 2 0)) (gn-emit (enc-mul 11 12 5))
                (gn-emit (enc-add-r 11 11 2)) (gn-emit (enc-cmp-r 11 16))) b8 (vector-at m8 MM-CODE-N)
      m9 (-> m8 (gn-emit (enc-bcond 2 0)) (gn-emit (enc-ldr 10 7 328))
                (gn-emit (gn-e-addsl 10 10 17 3)) (gn-emit (enc-sub-r 8 8 15))
                (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-mul 11 1 5))
                (gn-emit (enc-add-r 11 11 3)) (gn-emit (enc-mul 6 3 5))
                (gn-emit (enc-add-r 6 6 2)) (gn-emit (enc-cmp-i 13 0))) bz (vector-at m9 MM-CODE-N)
      m10 (gn-emit m9 (enc-bcond (enc-cond-eq) 0)) loop (vector-at m10 MM-CODE-N)
      m11 (-> m10 (gn-emit (gn-e-ldrr 12 10 11 1)) (gn-emit (gn-e-ldrr 14 10 6 1))
                 (gn-emit (enc-mul 12 12 14)) (gn-emit (enc-sub-r 9 9 12))
                 (gn-emit (enc-add-i 11 11 1)) (gn-emit (enc-add-r 6 6 5))
                 (gn-emit (enc-subs-i 13 13 1))) back (vector-at m11 MM-CODE-N)
      m12 (gn-emit m11 (enc-bcond (enc-cond-ne) (- loop back))) done (vector-at m12 MM-CODE-N)
      m13 (-> m12 (gn-mov 0 9) (gn-epilogue) (gn-gs gn-f-dead 0)) end (vector-at m13 MM-CODE-N)
      m14 (dr-patch m13 [b0 b1 b2 b3 b4 b5] end 0)]
     (-> m14 (gn-dot-patch b6 end 2) (gn-dot-patch b7 end 2)
               (gn-dot-patch b8 end 2) (gn-dot-patch bz done (enc-cond-eq))))))))

(defn- td-nf [M :vector-i64 n :i64 field :i64] :i64
 (if (and (> n 0) (< n (vector-at M MM-NODE-N)) (< n MM-NODE-CAP))
  (vector-at M (+ MM-NODE-BASE (* n MM-NODE-W) field)) 0))
(defn- td-nth [M :vector-i64 n :i64 k :i64] :i64
 (loop [c (td-nf M n NF-FIRST) j 0]
  (cond (= c 0) 0 (= j k) c :else (recur (td-nf M c NF-NEXT) (inc j)))))
(defn- td-pt [M :vector-i64 f :i64 j :i64] :i64
 (if (< j 5) (gn-fnf M f (+ FF-PT0 j))
  (td-nf M (td-nth M (td-nth M (gn-fnf M f FF-NODE) 2) (inc (* 2 j))) NF-TYPE)))
(defn- td-types [M :vector-i64 f :i64 n :i64 j :i64] :bool
 (if (= j n) true (and (= (td-pt M f j) TY-I64) (td-types M f n (inc j)))))
(defn- td-type [M :vector-i64 f :i64 n :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
      (= (gn-fnf M f FF-NPARAMS) n) (= (gn-fnf M f FF-NSLOTS) n)
      (= (gn-fnf M f FF-DEPTH) (if (= n 4) 3 n)) (= (gn-fnf M f FF-RTYPE) TY-I64)
      (td-types M f n 0)))
(defn- td-byte [M :vector-i64 f :i64] :bool
 (if (not (td-type M f 2)) false
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (inc p) IF-A)]
   (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 9)) (> l 0) (< l MM-LABEL-CAP)
    
    (gn-dot-at? M p OP-FN f 2 2) (gn-dot-at? M (inc p) OP-LABEL l 0 0)
    (gn-dot-at? M (+ p 2) OP-LGET 0 1 0) (gn-dot-at? M (+ p 3) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 4) OP-BIN BOP-USHR 0 0)
    (gn-dot-at? M (+ p 5) OP-CONST 1 255 0) (gn-dot-at? M (+ p 6) OP-BIN BOP-AND 0 0)
    (gn-dot-at? M (+ p 7) OP-RET 0 0 0) (gn-dot-at? M (+ p 8) OP-END f 0 0)))))
(defn- td-xor4 [M :vector-i64 f :i64] :bool
 (if (not (td-type M f 4)) false
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (inc p) IF-A)]
   (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 11)) (> l 0) (< l MM-LABEL-CAP)
    
    (gn-dot-at? M p OP-FN f 4 4) (gn-dot-at? M (inc p) OP-LABEL l 0 0)
    (gn-dot-at? M (+ p 2) OP-LGET 0 1 0) (gn-dot-at? M (+ p 3) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 4) OP-BIN BOP-XOR 0 0) (gn-dot-at? M (+ p 5) OP-LGET 1 3 0)
    (gn-dot-at? M (+ p 6) OP-LGET 2 4 0) (gn-dot-at? M (+ p 7) OP-BIN BOP-XOR 1 0)
    (gn-dot-at? M (+ p 8) OP-BIN BOP-XOR 0 0)
    (gn-dot-at? M (+ p 9) OP-RET 0 0 0) (gn-dot-at? M (+ p 10) OP-END f 0 0)))))
(defn- td-xor5 [M :vector-i64 f :i64] :bool
 (if (not (td-type M f 5)) false
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (+ p 2) IF-A)]
   (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 12)) (> l 0) (< l MM-LABEL-CAP)
    
    (gn-dot-at? M p OP-FN f 5 5) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL l 0 0)
    (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 5) OP-LGET 2 3 0) (gn-dot-at? M (+ p 6) OP-LGET 3 4 0)
    (gn-dot-at? M (+ p 7) OP-LGET 4 5 0)
    (gn-dot-at? M (+ p 8) OP-CALL (gn-sir M (+ p 8) IF-A) 1 4)
    (td-xor4 M (gn-sir M (+ p 8) IF-A))
    (gn-dot-at? M (+ p 9) OP-BIN BOP-XOR 0 0)
    (gn-dot-at? M (+ p 10) OP-RET 0 0 0) (gn-dot-at? M (+ p 11) OP-END f 0 0)))))
(defn- td-table [M :vector-i64 f :i64] :bool
 (let [lit (tb-shape M f)]
  (and (> lit 0)
       (>= (+ (gn-litf M lit LF-LEN) (gn-litf M (inc lit) LF-LEN)) 2048)
       (= (gn-litf M (inc lit) LF-B) (+ (gn-litf M lit LF-B) (gn-litf M lit LF-LEN))))))
(defn- td-groups [M :vector-i64 p :i64 j :i64] :bool
 (if (= j 5) true
  (let [q (+ p 4 (* (dec j) 15)) le (gn-sir M (+ q 9) IF-A)
       lx (gn-sir M (+ q 14) IF-A) sh (gn-sir M (+ q 5) IF-B)
       bf (gn-sir M (+ q 6) IF-A) tf (gn-sir M (+ q 7) IF-A)
       ff (gn-sir M (+ q 13) IF-A)]
   (and (> le 0) (< le MM-LABEL-CAP) (> lx 0) (< lx MM-LABEL-CAP) (not= le lx)
    (= (gn-lpos M le) (+ q 9)) (= (gn-lpos M lx) (+ q 14))
    (>= sh 0) (<= sh 56) (td-byte M bf) (td-table M tf) (td-table M ff)
    (gn-dot-at? M q OP-LGET j 1 0)
    (gn-dot-at? M (+ q 1) OP-CONST (inc j) (gn-sir M (+ p 5) IF-B) 0)
    (gn-dot-at? M (+ q 2) OP-CMP CC-EQ j 0) (gn-dot-at? M (+ q 3) OP-BRZ j le 0)
    (gn-dot-at? M (+ q 4) OP-LGET j (inc j) 0)
    (gn-dot-at? M (+ q 5) OP-CONST (inc j) sh 0)
    (gn-dot-at? M (+ q 6) OP-CALL bf j 2) (gn-dot-at? M (+ q 7) OP-CALL tf j 1)
    (gn-dot-at? M (+ q 8) OP-BR lx 0 0) (gn-dot-at? M (+ q 9) OP-LABEL le 0 0)
    (gn-dot-at? M (+ q 10) OP-LGET j (inc j) 0)
    (gn-dot-at? M (+ q 11) OP-CONST (inc j) sh 0)
    (gn-dot-at? M (+ q 12) OP-CALL bf j 2) (gn-dot-at? M (+ q 13) OP-CALL ff j 1)
    (gn-dot-at? M (+ q 14) OP-LABEL lx 0 0) (td-groups M p (inc j))))))
(defn- td-shape [M :vector-i64 f :i64] :i64
 (if (not (td-type M f 6)) 0
  (let [p (gn-fnf M f FF-SIR) l (gn-sir M (+ p 2) IF-A)]
   (if (and (> p 0) (<= p (- (vector-at M MM-SIR-N) 67)) (> l 0) (< l MM-LABEL-CAP)
    (= (gn-lpos M l) (+ p 2))
    (gn-dot-at? M p OP-FN f 6 6) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL l 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 6 0)
    (td-groups M p 1)
    (gn-dot-at? M (+ p 64) OP-CALL (gn-sir M (+ p 64) IF-A) 0 5)
    (td-xor5 M (gn-sir M (+ p 64) IF-A))
    (gn-dot-at? M (+ p 65) OP-RET 0 0 0) (gn-dot-at? M (+ p 66) OP-END f 0 0)) p 0))))
(defn- td-emit [M :vector-i64 p :i64 j :i64 branch :i64] :vector-i64
 (if (= j 5) M
  (let [q (+ p 4 (* (dec j) 15)) sh (gn-sir M (+ q 5) IF-B)
        f (gn-sir M (+ q (if (= branch 0) 7 13)) IF-A) lit (tb-shape M f)]
   (td-emit (-> M (gn-emit (gn-e-bf 0xd3400000 9 (gn-sreg M (inc j)) sh (+ sh 7)))
     (gn-emit (enc-ldr 17 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
     (gn-emit (enc-movz 16 0 0)) (gn-emit (enc-movk 16 0 1))
     (gn-emit (enc-add-r 17 17 16)) (gn-emit (gn-e-ldrr 9 17 9 1))
     (gn-emit (enc-eor-r 0 0 9))) p (inc j) branch))))
(defn- td-distinct [M :vector-i64 j :i64 k :i64] :bool
 (if (= k j) true (and (not= (gn-sreg M j) (gn-sreg M k)) (td-distinct M j (inc k)))))
(defn- td-regs [M :vector-i64 j :i64] :bool
 (if (= j 7) true (and (>= (gn-sreg M j) 19) (<= (gn-sreg M j) 28) (td-distinct M j 1) (td-regs M (inc j)))))
(defn- td-entry [M :vector-i64 i :i64] :vector-i64
 (if (or (<= i 1) (not= (gn-op M (dec i)) OP-FN)
   (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
   (not= (gn-g M gn-f-vmode) 0) (not= (gn-g M gn-f-ns) 6)
   (not= (gn-g M gn-f-dp) 6) (not (td-regs M 1))) M
  (let [f (gn-sir M (dec i) IF-A) p (td-shape M f)]
   (if (= p 0) M
    (let [m0 (-> M (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-i 8 5))) bf (vector-at m0 MM-CODE-N)
      m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-sub-i 8 8 5))
       (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov 0 (gn-sreg M 6))
       (gn-mov-imm 16 (gn-sir M (+ p 5) IF-B)) (gn-emit (enc-cmp-r (gn-sreg M 1) 16))) bc (vector-at m1 MM-CODE-N)
      m2 (td-emit (gn-emit m1 (enc-bcond (enc-cond-ne) 0)) p 1 0) bj (vector-at m2 MM-CODE-N)
      m3 (gn-emit m2 (enc-b 0)) alt (vector-at m3 MM-CODE-N)
      m4 (td-emit m3 p 1 1) done (vector-at m4 MM-CODE-N)
      m5 (-> m4 (gn-epilogue) (gn-gs gn-f-dead 0)) end (vector-at m5 MM-CODE-N)]
     (-> m5 (gn-dot-patch bf end (enc-cond-lo)) (gn-dot-patch bc alt (enc-cond-ne))
       (gn-put (+ MM-CODE-BASE bj) (enc-b (- done bj)))))))))
(defn- qb-rem [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) false
 (let [p (gn-fnf M f FF-SIR)]
  (and (> p 0) (< (+ p 10) (vector-at M MM-SIR-N)) (sr-types M f 2)
   (= (gn-fnf M f FF-NSLOTS) 2) (= (gn-fnf M f FF-DEPTH) 4)
   (gn-dot-at? M p OP-FN f 2 2)
   (gn-dot-at? M (+ p 1) OP-LABEL (gn-sir M (+ p 1) IF-A) 0 0)
   (> (gn-sir M (+ p 1) IF-A) 0) (< (gn-sir M (+ p 1) IF-A) MM-LABEL-CAP)
   (gn-dot-at? M (+ p 2) OP-LGET 0 1 0) (gn-dot-at? M (+ p 3) OP-LGET 1 2 0)
   (gn-dot-at? M (+ p 4) OP-LGET 2 1 0) (gn-dot-at? M (+ p 5) OP-LGET 3 2 0)
   (gn-dot-at? M (+ p 6) OP-BIN BOP-QUOT 2 0)
   (gn-dot-at? M (+ p 7) OP-BIN BOP-MUL 1 0) (gn-dot-at? M (+ p 8) OP-BIN BOP-SUB 0 0)
   (gn-dot-at? M (+ p 9) OP-RET 0 0 0) (gn-dot-at? M (+ p 10) OP-END f 0 0)))))
(defn- qb-tree [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
 (let [p (gn-fnf M f FF-SIR) first (+ p 2)]
  (if (and (> p 0) (< first (vector-at M MM-SIR-N)) (sr-types M f 1)
    (= (gn-fnf M f FF-NSLOTS) 1) (= (gn-fnf M f FF-DEPTH) 2)
    (gn-dot-at? M p OP-FN f 1 1)
    (gn-dot-at? M (+ p 1) OP-LABEL (gn-sir M (+ p 1) IF-A) 0 0)
    (> (gn-sir M (+ p 1) IF-A) 0) (< (gn-sir M (+ p 1) IF-A) MM-LABEL-CAP))
   (let [end (gn-tree-end M first 0)]
    (if (and (> end first) (gn-dot-at? M end OP-RET 0 0 0)
      (gn-dot-at? M (inc end) OP-END f 0 0)) first 0)) 0))))
(defn- qb-admit [M :vector-i64 i :i64] :i64
 (if (not= (gn-op M (dec i)) OP-FN) 0
 (let [p (dec i) f (gn-sir M p IF-A) base (gn-sir M (+ p 4) IF-B)
       divisor (gn-sir M (+ p 6) IF-B) stride (gn-sir M (+ p 10) IF-B)
       rem (gn-sir M (+ p 16) IF-A) tree (gn-sir M (+ p 17) IF-A)
       head (gn-sir M (+ p 2) IF-A) alt (gn-sir M (+ p 22) IF-B)
       exit (gn-sir M (+ p 24) IF-A)]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (< (+ p 29) (vector-at M MM-SIR-N))
    (not (gn-clamp-open M f)) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
    (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-RTYPE) TY-I64)
    (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
    (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
    (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 4)
    (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
    (loop [k 1] (or (= k 4) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
     (loop [j 1] (or (= j k) (and (not= (gn-sreg M k) (gn-sreg M j)) (recur (inc j)))))
     (recur (inc k)))))
    (>= base 0) (<= base 4095) (> divisor 1) (<= divisor 64) (> (gn-pow2 divisor) 0)
    (> stride 0) (<= stride 4095) (qb-rem M rem) (> (qb-tree M tree) 0)
    (> head 0) (< head MM-LABEL-CAP) (> alt 0) (< alt MM-LABEL-CAP)
    (> exit 0) (< exit MM-LABEL-CAP) (not= head alt) (not= head exit) (not= alt exit)
    (= (gn-lpos M head) (+ p 2)) (= (gn-lpos M alt) (+ p 25)) (= (gn-lpos M exit) (+ p 27))
    (bd-edges M 1 alt exit 0 0 0 0)
    (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M i OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL head 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
    (gn-dot-at? M (+ p 4) OP-CONST 1 base 0) (gn-dot-at? M (+ p 5) OP-LGET 2 2 0)
    (gn-dot-at? M (+ p 6) OP-CONST 3 divisor 0) (gn-dot-at? M (+ p 7) OP-BIN BOP-QUOT 2 0)
    (gn-dot-at? M (+ p 8) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 9) OP-LGET 2 3 0)
    (gn-dot-at? M (+ p 10) OP-CONST 3 stride 0) (gn-dot-at? M (+ p 11) OP-BIN BOP-MUL 2 0)
    (gn-dot-at? M (+ p 12) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 13) OP-RT RT-VECTOR-AT 0 2)
    (gn-dot-at? M (+ p 14) OP-LGET 1 2 0) (gn-dot-at? M (+ p 15) OP-CONST 2 divisor 0)
    (gn-dot-at? M (+ p 16) OP-CALL rem 1 2) (gn-dot-at? M (+ p 17) OP-CALL tree 1 1)
    (gn-dot-at? M (+ p 18) OP-BIN BOP-AND 0 0) (gn-dot-at? M (+ p 19) OP-CONST 1 0 0)
    (gn-dot-at? M (+ p 20) OP-CMP CC-EQ 0 0) (gn-dot-at? M (+ p 21) OP-UN UOP-NOT 0 0)
    (gn-dot-at? M (+ p 22) OP-BRZ 0 alt 0) (gn-dot-at? M (+ p 23) OP-CONST 0 1 0)
    (gn-dot-at? M (+ p 24) OP-BR exit 0 0) (gn-dot-at? M (+ p 25) OP-LABEL alt 0 0)
    (gn-dot-at? M (+ p 26) OP-CONST 0 0 0) (gn-dot-at? M (+ p 27) OP-LABEL exit 0 0)
    (gn-dot-at? M (+ p 28) OP-RET 0 0 0) (gn-dot-at? M (+ p 29) OP-END f 0 0))
   (qb-tree M tree) 0))))
(defn- qi-shape [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
 (let [p (gn-fnf M f FF-SIR)]
  (if (or (<= p 0) (>= (+ p 29) (vector-at M MM-SIR-N))) 0
 (let [i (inc p) base (gn-sir M (+ p 4) IF-B)
       divisor (gn-sir M (+ p 6) IF-B) stride (gn-sir M (+ p 10) IF-B)
       rem (gn-sir M (+ p 16) IF-A) tree (gn-sir M (+ p 17) IF-A)
       head (gn-sir M (+ p 2) IF-A) alt (gn-sir M (+ p 22) IF-B)
       exit (gn-sir M (+ p 24) IF-A)]
  (if (and (> f 0) (< f (vector-at M MM-FN-N)) (< (+ p 29) (vector-at M MM-SIR-N))
    (not (gn-clamp-open M f)) (= (gn-fnf M f FF-SIR) p)
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
    (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-RTYPE) TY-I64)
    (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
    (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
    (>= base 0) (<= base 4095) (> divisor 1) (<= divisor 64) (> (gn-pow2 divisor) 0)
    (> stride 0) (<= stride 4095) (qb-rem M rem) (> (qb-tree M tree) 0)
    (> head 0) (< head MM-LABEL-CAP) (> alt 0) (< alt MM-LABEL-CAP)
    (> exit 0) (< exit MM-LABEL-CAP) (not= head alt) (not= head exit) (not= alt exit)
    (= (gn-lpos M head) (+ p 2)) (= (gn-lpos M alt) (+ p 25)) (= (gn-lpos M exit) (+ p 27))
    (bd-edges M 1 alt exit 0 0 0 0)
    (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M i OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL head 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
    (gn-dot-at? M (+ p 4) OP-CONST 1 base 0) (gn-dot-at? M (+ p 5) OP-LGET 2 2 0)
    (gn-dot-at? M (+ p 6) OP-CONST 3 divisor 0) (gn-dot-at? M (+ p 7) OP-BIN BOP-QUOT 2 0)
    (gn-dot-at? M (+ p 8) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 9) OP-LGET 2 3 0)
    (gn-dot-at? M (+ p 10) OP-CONST 3 stride 0) (gn-dot-at? M (+ p 11) OP-BIN BOP-MUL 2 0)
    (gn-dot-at? M (+ p 12) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 13) OP-RT RT-VECTOR-AT 0 2)
    (gn-dot-at? M (+ p 14) OP-LGET 1 2 0) (gn-dot-at? M (+ p 15) OP-CONST 2 divisor 0)
    (gn-dot-at? M (+ p 16) OP-CALL rem 1 2) (gn-dot-at? M (+ p 17) OP-CALL tree 1 1)
    (gn-dot-at? M (+ p 18) OP-BIN BOP-AND 0 0) (gn-dot-at? M (+ p 19) OP-CONST 1 0 0)
    (gn-dot-at? M (+ p 20) OP-CMP CC-EQ 0 0) (gn-dot-at? M (+ p 21) OP-UN UOP-NOT 0 0)
    (gn-dot-at? M (+ p 22) OP-BRZ 0 alt 0) (gn-dot-at? M (+ p 23) OP-CONST 0 1 0)
    (gn-dot-at? M (+ p 24) OP-BR exit 0 0) (gn-dot-at? M (+ p 25) OP-LABEL alt 0 0)
    (gn-dot-at? M (+ p 26) OP-CONST 0 0 0) (gn-dot-at? M (+ p 27) OP-LABEL exit 0 0)
    (gn-dot-at? M (+ p 28) OP-RET 0 0 0) (gn-dot-at? M (+ p 29) OP-END f 0 0))
   (qb-tree M tree) 0))))) )
(defn- qi-admit [M :vector-i64 i :i64 f :i64 t :i64 n :i64] :i64
 (if (or (not= n 3) (< t 0) (> t 3) (not= (gn-g M gn-f-leaf) 0)
      (not= (gn-g M gn-f-freg) 0) (> t (gn-g M gn-f-h)) (> t (gn-g M gn-f-dp))
      (> 3 (- (gn-g M gn-f-h) t)) (> 3 (- (gn-g M gn-f-dp) t))) 0
  (if (or (= (gn-op M (inc i)) OP-RES2) (= (gn-op M (inc i)) OP-RET)
          (jt-return M i t) (not (di-args-safe M t 3))) 0 (qi-shape M f))))
(defn- qi-call [M :vector-i64 i :i64 f :i64 t :i64 tree :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) divisor (gn-sir M (+ p 6) IF-B)
       stride (gn-sir M (+ p 10) IF-B) offset (gn-sir M (+ p 4) IF-B)
       m0 (-> M (gn-save 0 t) (gn-args t 0 3) (gn-ctx)
         (gn-emit (enc-ldr 11 7 CTX-FUEL)) (gn-emit (enc-cmp-i 11 1))) b0 (vector-at m0 MM-CODE-N)
       m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-emit (enc-cmp-i 1 4095))) b1 (vector-at m1 MM-CODE-N)
       m2 (-> m1 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-i 2 4095))) b2 (vector-at m2 MM-CODE-N)
       m3 (-> m2 (gn-emit (enc-bcond 8 0)) (gn-emit (gn-e-lsr 9 1 (gn-pow2 divisor)))
         (gn-mov-imm 16 stride) (gn-emit (enc-mul 10 2 16)) (gn-emit (enc-add-r 9 9 10))
         (gn-emit (enc-add-i 9 9 offset)) (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
         (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
       m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
         (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
         (gn-emit (enc-cmp-r 9 16))) b4 (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 328))
         (gn-emit (enc-add-r 17 17 9)) (gn-emit (gn-e-addsl 10 16 17 3))
         ;; The complete pure read and original one-charge budget are proven.
         ;; Publish exactly that charge before the original ordered payload read.
         (gn-emit (enc-sub-i 11 11 1)) (gn-emit (enc-str 11 7 CTX-FUEL))
         (gn-emit (enc-ldr 0 10 0)) (gn-mov-imm 16 (dec divisor)) (gn-emit (enc-and-r 9 1 16))) adr (vector-at m5 MM-CODE-N)
       m6 (-> m5 (gn-emit (gn-e-adr 16)) (gn-emit (gn-e-ldrr 16 16 9 1))
         (gn-emit (enc-and-r 0 0 16)) (gn-emit (enc-cmp-i 0 0)) (gn-emit (enc-cset 0 (enc-cond-ne)))) done (vector-at m6 MM-CODE-N)
       m7 (gn-emit m6 (enc-b 0)) table (vector-at m7 MM-CODE-N) delta (* (- table adr) 4)
       m8 (gn-tree-data m7 tree 0 divisor) cold (vector-at m8 MM-CODE-N)
       m9 (-> m8 (gn-fix FX-BL26 f) (gn-emit (enc-bl 0))) end (vector-at m9 MM-CODE-N)
       m10 (-> m9 (gn-dot-patch b0 cold (enc-cond-lo)) (gn-dot-patch b1 cold 8) (gn-dot-patch b2 cold 8)
         (gn-dot-patch b3 cold (enc-cond-hs)) (gn-dot-patch b4 cold (enc-cond-hs))
         (gn-put (+ MM-CODE-BASE done) (enc-b (- end done)))
         (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 16) (i64-shift-left (bit-and delta 3) 29)
           (i64-shift-left (i64-shift-right delta 2) 5))))]
  (-> m10 (gn-vclear) (gn-gs gn-f-ctx (if (or (= (gn-g M cc-proof) 1) (>= (gn-ctx-safe M f 3 8 512) 0)) 1 0))
    (gn-take i t 0))))

(defn- qb-entry [M :vector-i64 i :i64] :vector-i64
 (let [tree (qb-admit M i)]
  (if (= tree 0) M
  (let [p (dec i) divisor (gn-sir M (+ p 6) IF-B)
        stride (gn-sir M (+ p 10) IF-B) offset (gn-sir M (+ p 4) IF-B)
        rv (gn-sreg M 1) rx (gn-sreg M 2) ry (gn-sreg M 3) B (gp-save-state M)
        m0 (gn-emit M (enc-cmp-i rx 4095)) b0 (vector-at m0 MM-CODE-N)
        m1 (-> m0 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-i ry 4095)))
        b1 (vector-at m1 MM-CODE-N)
        m2 (-> m1 (gn-emit (enc-bcond 8 0))
             (gn-emit (gn-e-lsr 9 rx (gn-pow2 divisor))) (gn-mov-imm 16 stride)
             (gn-emit (enc-mul 10 ry 16)) (gn-emit (enc-add-r 9 9 10))
             (gn-emit (enc-add-i 9 9 offset)) (gn-emit (enc-ldr 16 7 312))
             (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 rv 1))
             (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
        m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
             (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
             (gn-emit (enc-cmp-r 9 16))) b3 (vector-at m3 MM-CODE-N)
        m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 328))
             (gn-emit (enc-add-r 17 17 9)) (gn-emit (gn-e-addsl 16 16 17 3))
             (gn-emit (enc-ldr 0 16 0)) (gn-mov-imm 16 (dec divisor))
             (gn-emit (enc-and-r 9 rx 16))) adr (vector-at m4 MM-CODE-N)
        m5 (-> m4 (gn-emit (gn-e-adr 10)) (gn-emit (gn-e-ldrr 10 10 9 1))
             (gn-emit (enc-and-r 0 0 10)) (gn-emit (enc-cmp-i 0 0))
             (gn-emit (enc-cset 0 (enc-cond-ne))) (gn-epilogue))
        table (vector-at m5 MM-CODE-N) delta (* (- table adr) 4)
        m6 (gn-tree-data m5 tree 0 divisor) end (vector-at m6 MM-CODE-N)
        m7 (-> m6 (gn-dot-patch b0 end 8) (gn-dot-patch b1 end 8)
             (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
             (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 10)
               (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5))))]
   (gp-restore m7 B)))))
(defn- sw-writer [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) false
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (< (+ p 8) (vector-at M MM-SIR-N))
    (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 3)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
    (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
    (> (gn-sir M (+ p 2) IF-A) 0) (< (gn-sir M (+ p 2) IF-A) MM-LABEL-CAP)
    (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
    (gn-dot-at? M (+ p 5) OP-LGET 2 3 0)
    (gn-dot-at? M (+ p 6) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
    (gn-dot-at? M (+ p 7) OP-RET 0 0 0) (gn-dot-at? M (+ p 8) OP-END f 0 0)))))
(defn- sw-envelope [M :vector-i64 tree :i64 x :i64 n :i64] :i64
 (if (= x n) 0
  (let [v (gn-tree-value M tree x) tail (sw-envelope M tree (inc x) n)]
   (if (or (< v 0) (> v 4095) (< tail 0)) -1 (gn-max v tail)))))
(defn- sw-admit [M :vector-i64 i :i64] :i64
 (if (or (< i 1) (not= (gn-op M (dec i)) OP-FN)) 0
  (let [p (dec i) f (gn-sir M p IF-A)]
   (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)
          (>= (+ p 28) (vector-at M MM-SIR-N))) 0
    (let [head (gn-sir M (+ p 2) IF-A) alt (gn-sir M (+ p 6) IF-B)
          exit (gn-sir M (+ p 8) IF-A) base (gn-sir M (+ p 11) IF-B)
          tree (qb-tree M (gn-sir M (+ p 13) IF-A))]
     (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 3)
      (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 3)
      (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
      (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
      (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 3) (= (gn-g M gn-f-h) 0)
      (= (gn-g M gn-f-skip) 0)
      (loop [k 1] (or (= k 4) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
       (loop [j 1] (or (= j k) (and (not= (gn-sreg M k) (gn-sreg M j)) (recur (inc j)))))
       (recur (inc k)))))
      (> tree 0) (>= base 0) (<= base 4095)
      (> head 0) (< head MM-LABEL-CAP) (> alt 0) (< alt MM-LABEL-CAP)
      (> exit 0) (< exit MM-LABEL-CAP) (not= head alt) (not= head exit) (not= alt exit)
      (= (gn-small-label M 1 head 0) (+ p 2)) (= (gn-small-label M 1 alt 0) (+ p 9))
      (= (gn-small-label M 1 exit 0) (+ p 26)) (bd-edges M 1 alt exit 0 0 0 0)
      (btg-edges M (inc p) f head 0) (bd-edges M 1 head alt 0 0 0 0)
      (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M i OP-FUEL 0 0 0)
      (gn-dot-at? M (+ p 2) OP-LABEL head 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 2 0)
      (gn-dot-at? M (+ p 4) OP-LGET 1 3 0) (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
      (gn-dot-at? M (+ p 6) OP-BRZ 0 alt 0) (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
      (gn-dot-at? M (+ p 8) OP-BR exit 0 0) (gn-dot-at? M (+ p 9) OP-LABEL alt 0 0)
      (gn-dot-at? M (+ p 10) OP-LGET 0 1 0) (gn-dot-at? M (+ p 11) OP-CONST 1 base 0)
      (gn-dot-at? M (+ p 12) OP-LGET 2 2 0)
      (gn-dot-at? M (+ p 13) OP-CALL (gn-sir M (+ p 13) IF-A) 2 1)
      (gn-dot-at? M (+ p 14) OP-BIN BOP-ADD 1 0)
      (gn-dot-at? M (+ p 15) OP-CONST 2 (gn-sir M (+ p 15) IF-B) 0)
      (sw-writer M (gn-sir M (+ p 16) IF-A))
      (gn-dot-at? M (+ p 16) OP-CALL (gn-sir M (+ p 16) IF-A) 0 3)
      (gn-dot-at? M (+ p 17) OP-LGET 1 2 0) (gn-dot-at? M (+ p 18) OP-CONST 2 1 0)
      (gn-dot-at? M (+ p 19) OP-BIN BOP-ADD 1 0) (gn-dot-at? M (+ p 20) OP-LGET 2 3 0)
      (gn-dot-at? M (+ p 21) OP-LSET 1 0 0) (gn-dot-at? M (+ p 22) OP-LSET 2 1 0)
      (gn-dot-at? M (+ p 23) OP-LSET 3 2 0) (gn-dot-at? M (+ p 24) OP-FUEL 0 0 0)
      (gn-dot-at? M (+ p 25) OP-BR head 0 0) (gn-dot-at? M (+ p 26) OP-LABEL exit 0 0)
      (gn-dot-at? M (+ p 27) OP-RET 0 0 0) (gn-dot-at? M (+ p 28) OP-END f 0 0))
      (if (>= (sw-envelope M tree 0 (inc (gn-tree-high M tree))) 0) tree 0) 0))))))
;; pre: before the frame (kpre-entry), parameters in x0..x2 (only read before the last guard), the entry charge joins
;; the prepaid cost, plain ret
(defn- sw-entry [M :vector-i64 i :i64] :vector-i64 (sw-entry2 M i false))
(defn- sw-entry2 [M :vector-i64 i :i64 pre :bool] :vector-i64
 (let [tree (sw-admit M i)]
  (if (= tree 0) M
   (let [p (dec i) n (inc (gn-tree-high M tree)) base (gn-sir M (+ p 11) IF-B)
         bound (+ base (sw-envelope M tree 0 n)) value (gn-sir M (+ p 15) IF-B)
         rv (kp M pre 1) rk (kp M pre 2) re (kp M pre 3) B (gp-save-state M)
         m0 (gn-emit M (enc-cmp-i re n)) b0 (vector-at m0 MM-CODE-N)
         m1 (-> m0 (gn-emit (enc-bcond 8 0)) (gn-emit (enc-cmp-r rk re))) b1 (vector-at m1 MM-CODE-N)
         m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-sub-r 9 re rk))
              (gn-emit (enc-add-r 9 9 9)) (cond-> pre (gn-emit (enc-add-i 9 9 1))) (gn-emit (enc-ldr 8 7 CTX-FUEL))
              (gn-emit (enc-cmp-r 8 9))) b2 (vector-at m2 MM-CODE-N)
         m3 (-> m2 (gn-emit (enc-bcond (enc-cond-lo) 0))
              (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
              (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
         m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 16 7 320))
              (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 3 16 0))
              (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 3 16))) b4 (vector-at m4 MM-CODE-N)
         m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 bound)
              (gn-emit (enc-cmp-r 16 3))) b5 (vector-at m5 MM-CODE-N)
         ;; x4 = &items[base] (the table entries index from base); a zero value stores xzr
         vr (if (= value 0) 31 13)
         m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-emit (enc-ldr 4 7 328))
              (gn-emit (gn-e-addsl 4 4 17 3)) (sw-base base) (gn-mov 11 rk) (cond-> (not= value 0) (gn-mov-imm 13 value))
              ;; Complete preflight succeeded: exactly two original charges
              ;; per visited store, including the final backedge charge.
              (gn-emit (enc-sub-r 8 8 9)) (gn-emit (enc-str 8 7 CTX-FUEL)))
         adr (vector-at m6 MM-CODE-N) m7 (gn-emit m6 (gn-e-adr 10)) loop-at (vector-at m7 MM-CODE-N)
         m8 (-> m7 (gn-emit (gn-e-ldrr 12 10 11 1))
              (gn-emit (gn-e-strr3 vr 4 12)) (gn-emit (enc-add-i 11 11 1))
              (gn-emit (enc-cmp-r 11 re))) branch (vector-at m8 MM-CODE-N)
         m9 (-> m8 (gn-emit (enc-bcond (enc-cond-lo) (- loop-at branch)))
              (gn-mov 0 rv) (cond-> pre (gn-emit (enc-ret))) (cond-> (not pre) (gn-epilogue))) table (vector-at m9 MM-CODE-N)
         delta (* (- table adr) 4) m10 (gn-tree-data m9 tree 0 n) end (vector-at m10 MM-CODE-N)
         m11 (-> m10 (gn-dot-patch b0 end 8) (gn-dot-patch b1 end (enc-cond-hs))
               (gn-dot-patch b2 end (enc-cond-lo)) (gn-dot-patch b3 end (enc-cond-hs))
               (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-hs))
               (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 10)
                (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5))))]
    (gp-restore m11 B)))))
;; x4 += 8 base
(defn- sw-base [M :vector-i64 base :i64] :vector-i64
 (if (>= (enc-add-i 4 4 (* 8 base)) 0) (gn-emit M (enc-add-i 4 4 (* 8 base)))
  (-> M (gn-mov-imm 16 (* 8 base)) (gn-emit (enc-add-r 4 4 16)))))
(defn- xd-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (let [h (gn-sir M (+ p 2) IF-A) b (gn-sir M (+ p 8) IF-B)
       e (gn-sir M (+ p 18) IF-A) a (gn-sir M (+ p 50) IF-B) z (gn-sir M (+ p 52) IF-A)
       flag (gn-sir M (+ p 4) IF-B) mask (dec flag)
       leaf (gn-sir M (+ p 10) IF-B) feature (gn-sir M (+ p 21) IF-B)
       threshold (gn-sir M (+ p 29) IF-B) input (gn-sir M (+ p 37) IF-B)
       stride (gn-sir M (+ p 39) IF-B) left (gn-sir M (+ p 51) IF-B) right (gn-sir M (+ p 54) IF-B)]
  (if (= k 77) true
   (and (case k
    0 (gn-dot-at? M (+ p 0) 1 f 5 9)
    1 (gn-dot-at? M (+ p 1) 18 0 0 0)
    2 (gn-dot-at? M (+ p 2) 9 h 0 0)
    3 (gn-dot-at? M (+ p 3) 4 0 5 0)
    4 (gn-dot-at? M (+ p 4) 3 1 flag 0)
    5 (gn-dot-at? M (+ p 5) 6 5 0 0)
    6 (gn-dot-at? M (+ p 6) 3 1 flag 0)
    7 (gn-dot-at? M (+ p 7) 7 1 0 0)
    8 (gn-dot-at? M (+ p 8) 11 0 b 0)
    9 (gn-dot-at? M (+ p 9) 4 0 1 0)
    10 (gn-dot-at? M (+ p 10) 3 1 leaf 0)
    11 (gn-dot-at? M (+ p 11) 4 2 4 0)
    12 (gn-dot-at? M (+ p 12) 4 3 5 0)
    13 (gn-dot-at? M (+ p 13) 3 4 mask 0)
    14 (gn-dot-at? M (+ p 14) 6 5 3 0)
    15 (gn-dot-at? M (+ p 15) 6 1 2 0)
    16 (gn-dot-at? M (+ p 16) 6 1 1 0)
    17 (gn-dot-at? M (+ p 17) 14 176 0 2)
    18 (gn-dot-at? M (+ p 18) 10 e 0 0)
    19 (gn-dot-at? M (+ p 19) 9 b 0 0)
    20 (gn-dot-at? M (+ p 20) 4 0 1 0)
    21 (gn-dot-at? M (+ p 21) 3 1 feature 0)
    22 (gn-dot-at? M (+ p 22) 4 2 3 0)
    23 (gn-dot-at? M (+ p 23) 4 3 5 0)
    24 (gn-dot-at? M (+ p 24) 6 1 2 0)
    25 (gn-dot-at? M (+ p 25) 6 1 1 0)
    26 (gn-dot-at? M (+ p 26) 14 176 0 2)
    27 (gn-dot-at? M (+ p 27) 5 6 0 0)
    28 (gn-dot-at? M (+ p 28) 4 0 1 0)
    29 (gn-dot-at? M (+ p 29) 3 1 threshold 0)
    30 (gn-dot-at? M (+ p 30) 4 2 3 0)
    31 (gn-dot-at? M (+ p 31) 4 3 5 0)
    32 (gn-dot-at? M (+ p 32) 6 1 2 0)
    33 (gn-dot-at? M (+ p 33) 6 1 1 0)
    34 (gn-dot-at? M (+ p 34) 14 176 0 2)
    35 (gn-dot-at? M (+ p 35) 5 7 0 0)
    36 (gn-dot-at? M (+ p 36) 4 0 1 0)
    37 (gn-dot-at? M (+ p 37) 3 1 input 0)
    38 (gn-dot-at? M (+ p 38) 4 2 2 0)
    39 (gn-dot-at? M (+ p 39) 3 3 stride 0)
    40 (gn-dot-at? M (+ p 40) 6 3 2 0)
    41 (gn-dot-at? M (+ p 41) 4 3 6 0)
    42 (gn-dot-at? M (+ p 42) 6 1 2 0)
    43 (gn-dot-at? M (+ p 43) 6 1 1 0)
    44 (gn-dot-at? M (+ p 44) 14 176 0 2)
    45 (gn-dot-at? M (+ p 45) 5 8 0 0)
    46 (gn-dot-at? M (+ p 46) 4 0 1 0)
    47 (gn-dot-at? M (+ p 47) 4 1 8 0)
    48 (gn-dot-at? M (+ p 48) 4 2 7 0)
    49 (gn-dot-at? M (+ p 49) 7 2 1 0)
    50 (gn-dot-at? M (+ p 50) 11 1 a 0)
    51 (gn-dot-at? M (+ p 51) 3 1 left 0)
    52 (gn-dot-at? M (+ p 52) 10 z 0 0)
    53 (gn-dot-at? M (+ p 53) 9 a 0 0)
    54 (gn-dot-at? M (+ p 54) 3 1 right 0)
    55 (gn-dot-at? M (+ p 55) 9 z 0 0)
    56 (gn-dot-at? M (+ p 56) 4 2 3 0)
    57 (gn-dot-at? M (+ p 57) 4 3 5 0)
    58 (gn-dot-at? M (+ p 58) 6 1 2 0)
    59 (gn-dot-at? M (+ p 59) 6 1 1 0)
    60 (gn-dot-at? M (+ p 60) 14 176 0 2)
    61 (gn-dot-at? M (+ p 61) 5 9 0 0)
    62 (gn-dot-at? M (+ p 62) 4 0 1 0)
    63 (gn-dot-at? M (+ p 63) 4 1 2 0)
    64 (gn-dot-at? M (+ p 64) 4 2 3 0)
    65 (gn-dot-at? M (+ p 65) 4 3 4 0)
    66 (gn-dot-at? M (+ p 66) 4 4 9 0)
    67 (gn-dot-at? M (+ p 67) 5 1 0 0)
    68 (gn-dot-at? M (+ p 68) 5 2 1 0)
    69 (gn-dot-at? M (+ p 69) 5 3 2 0)
    70 (gn-dot-at? M (+ p 70) 5 4 3 0)
    71 (gn-dot-at? M (+ p 71) 5 5 4 0)
    72 (gn-dot-at? M (+ p 72) 18 0 0 0)
    73 (gn-dot-at? M (+ p 73) 10 h 0 0)
    74 (gn-dot-at? M (+ p 74) 9 e 0 0)
    75 (gn-dot-at? M (+ p 75) 19 0 0 0)
    76 (gn-dot-at? M (+ p 76) 2 f 0 0)
    false) (xd-shape M p f (inc k))))))

(defn- xd-constants [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 6) true
  (let [at (case k 0 10 1 21 2 29 3 37 4 51 5 54 0) n (gn-sir M (+ p at) IF-B)]
   (and (>= n 0) (<= n 1048575) (xd-constants M p (inc k))))))

(defn- xd-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 5) true
  (let [at (case k 0 2 1 19 2 53 3 55 4 74 0) l (gn-sir M (+ p at) IF-A)]
   (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p at))
    (xd-labels M p (inc k))))))

(defn- xd-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A) flag (gn-sir M (+ p 4) IF-B)
       stride (gn-sir M (+ p 39) IF-B)]
  (and (> p 0) (< (+ p 76) (vector-at M MM-SIR-N))
   (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
   (= (gn-fnf M f FF-NPARAMS) 5) (= (gn-fnf M f FF-NSLOTS) 9)
   (= (gn-fnf M f FF-DEPTH) 5) (= (gn-fnf M f FF-RTYPE) TY-I64)
   (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
   (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-vmode) 3)
   (= (gn-g M gn-f-ns) 9) (= (gn-g M gn-f-dp) 5)
   (= (gn-g M gn-f-nsv) 5) (> (gn-g M gn-f-fb) 0) (= (gn-g M 15) 1)
   (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-ctx) 1)
   (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2)
   (= (gn-sreg M 4) 3) (= (gn-sreg M 5) 4)
   (= (gn-sreg M 6) 5) (= (gn-sreg M 7) 6) (= (gn-sreg M 8) 19) (= (gn-sreg M 9) 20)
   (> flag 1) (<= flag 256) (> (gn-pow2 flag) 0)
   (> stride 1) (<= stride 256) (> (gn-pow2 stride) 0)
   (xd-labels M p 0) (xd-constants M p 0) (xd-shape M p f 0))))

(defn- xd-cold [M :vector-i64 G :vector-i64 cc :i64] :vector-i64
 (let [n (vector-at G 0) g (-> G (vector-assoc! (+ 1 (* n 2)) (vector-at M MM-CODE-N))
  (vector-assoc! (+ 2 (* n 2)) cc) (vector-assoc! 0 (inc n)))]
  (gn-emit M (enc-bcond cc 0))))

(defn- xd-patch [M :vector-i64 G :vector-i64 k :i64 end :i64] :vector-i64
 (if (= k (vector-at G 0)) M
  (xd-patch (gn-dot-patch M (vector-at G (+ 1 (* k 2))) end (vector-at G (+ 2 (* k 2)))) G (inc k) end)))

(defn- xd-range [M :vector-i64 G :vector-i64 r :i64 base :i64 span :i64] :vector-i64
 (-> M (gn-mov-imm 9 (+ base span)) (gn-emit (enc-add-r 9 r 9))
  (gn-emit (enc-cmp-r 9 21)) (xd-cold G (enc-cond-hs))))

(defn- xd-pointer [M :vector-i64 r :i64 input :i64 base :i64] :vector-i64
 (-> M (gn-mov-imm 9 base) (gn-emit (enc-add-r 9 input 9))
  (gn-emit (gn-e-addsl r 22 9 3))))

(defn- xd-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (xd-admit M i)) M
  (let [p (dec i) flag (gn-sir M (+ p 4) IF-B) mask (dec flag) stride (gn-sir M (+ p 39) IF-B)
   leaf (gn-sir M (+ p 10) IF-B) feature (gn-sir M (+ p 21) IF-B)
   threshold (gn-sir M (+ p 29) IF-B) input (gn-sir M (+ p 37) IF-B)
   left (gn-sir M (+ p 51) IF-B) right (gn-sir M (+ p 54) IF-B)
   G (vector-alloc 65)
   m0 (-> M (gn-mov-imm 9 16384) (gn-emit (enc-cmp-r 1 9)) (xd-cold G (enc-cond-hs))
    (gn-mov-imm 9 1048576) (gn-emit (enc-cmp-r 2 9)) (xd-cold G (enc-cond-hs))
    (gn-emit (enc-cmp-r 3 9)) (xd-cold G (enc-cond-hs))
    (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
    (gn-emit (enc-sub-i 17 0 1)) (gn-emit (enc-cmp-r 17 16)) (xd-cold G (enc-cond-hs))
    (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
    (gn-emit (enc-ldp 17 21 16 0)) (gn-emit (enc-ldr 22 7 328))
    (gn-emit (gn-e-addsl 22 22 17 3)) (gn-mov-imm 23 1)
    (xd-range G 3 leaf mask) (xd-range G 2 feature mask) (xd-range G 2 threshold mask)
    (xd-range G 2 left mask) (xd-range G 2 right mask)
    (gn-emit (gn-e-lsl 19 1 (gn-pow2 stride))) (xd-range G 19 input (dec stride))
    (xd-pointer 12 2 feature) (xd-pointer 13 2 threshold) (xd-pointer 14 19 input)
    (xd-pointer 15 2 left) (xd-pointer 16 2 right) (xd-pointer 17 3 leaf))
   head (vector-at m0 MM-CODE-N)
   m1 (-> m0 (gn-bin-imm BOP-AND 9 4 flag) (gn-emit (enc-cmp-i 9 flag))) terminal (vector-at m1 MM-CODE-N)
   m2 (-> m1 (gn-emit (enc-bcond (enc-cond-eq) 0))
    (gn-emit (enc-cmp-i 4 flag)) (xd-cold G (enc-cond-hs))
    (gn-emit (gn-e-ldrr 9 12 4 1)) (gn-emit (gn-e-ldrr 5 13 4 1))
    (gn-emit (enc-cmp-i 9 stride)) (xd-cold G (enc-cond-hs))
    (gn-emit (gn-e-ldrr 6 14 9 1)) (gn-emit (enc-cmp-r 6 5))) select (vector-at m2 MM-CODE-N)
   m3 (-> m2 (gn-emit (enc-bcond (enc-cond-ge) 0)) (gn-emit (gn-e-ldrr 4 15 4 1))) jump (vector-at m3 MM-CODE-N)
   m4 (gn-emit m3 (enc-b 0)) righth (vector-at m4 MM-CODE-N)
   m5 (gn-emit m4 (gn-e-ldrr 4 16 4 1)) charge (vector-at m5 MM-CODE-N)
   m6 (gn-emit m5 (enc-subs-i 8 8 1)) back (vector-at m6 MM-CODE-N)
   m7 (-> m6 (gn-emit (enc-bcond (enc-cond-hs) (- head back)))
    (gn-emit (enc-str 31 7 CTX-FUEL)) (gn-emit (enc-brk 0))) leafh (vector-at m7 MM-CODE-N)
   m8 (-> m7 (gn-bin-imm BOP-AND 9 4 mask) (gn-emit (gn-e-ldrr 0 17 9 1))
    (gn-epilogue) (gn-gs gn-f-dead 0)) cold (vector-at m8 MM-CODE-N)]
   (-> m8 (gn-dot-patch terminal leafh (enc-cond-eq)) (gn-dot-patch select righth (enc-cond-ge))
    (gn-put (+ MM-CODE-BASE jump) (enc-b (- charge jump))) (xd-patch G 0 cold)))))

(defn- ri-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 76) true (let [n (gn-sir M (+ p 4) IF-B) out (gn-sir M (+ p 15) IF-B)
  bias (gn-sir M (+ p 36) IF-B) factor (gn-sir M (+ p 44) IF-B)
  stride (gn-sir M (+ p 53) IF-B) writer (gn-sir M (+ p 19) IF-A)]
  (and (case k
    0 (gn-dot-at? M (+ p 0) 1 f 4 6)
    1 (gn-dot-at? M (+ p 1) 18 0 0 0)
    2 (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
    3 (gn-dot-at? M (+ p 3) 4 0 2 0)
    4 (gn-dot-at? M (+ p 4) 3 1 n 0)
    5 (gn-dot-at? M (+ p 5) 7 1 0 0)
    6 (gn-dot-at? M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
    7 (gn-dot-at? M (+ p 7) 4 0 1 0)
    8 (gn-dot-at? M (+ p 8) 10 (gn-sir M (+ p 73) IF-A) 0 0)
    9 (gn-dot-at? M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
    10 (gn-dot-at? M (+ p 10) 4 0 3 0)
    11 (gn-dot-at? M (+ p 11) 3 1 n 0)
    12 (gn-dot-at? M (+ p 12) 7 1 0 0)
    13 (gn-dot-at? M (+ p 13) 11 0 (gn-sir M (+ p 32) IF-A) 0)
    14 (gn-dot-at? M (+ p 14) 4 0 1 0)
    15 (gn-dot-at? M (+ p 15) 3 1 out 0)
    16 (gn-dot-at? M (+ p 16) 4 2 2 0)
    17 (gn-dot-at? M (+ p 17) 6 1 1 0)
    18 (gn-dot-at? M (+ p 18) 4 2 4 0)
    19 (gn-dot-at? M (+ p 19) 13 writer 0 3)
    20 (gn-dot-at? M (+ p 20) 4 1 2 0)
    21 (gn-dot-at? M (+ p 21) 3 2 1 0)
    22 (gn-dot-at? M (+ p 22) 6 1 1 0)
    23 (gn-dot-at? M (+ p 23) 3 2 0 0)
    24 (gn-dot-at? M (+ p 24) 3 3 0 0)
    25 (gn-dot-at? M (+ p 25) 5 1 0 0)
    26 (gn-dot-at? M (+ p 26) 5 2 1 0)
    27 (gn-dot-at? M (+ p 27) 5 3 2 0)
    28 (gn-dot-at? M (+ p 28) 5 4 3 0)
    29 (gn-dot-at? M (+ p 29) 18 0 0 0)
    30 (gn-dot-at? M (+ p 30) 10 (gn-sir M (+ p 2) IF-A) 0 0)
    31 (gn-dot-at? M (+ p 31) 10 (gn-sir M (+ p 72) IF-A) 0 0)
    32 (gn-dot-at? M (+ p 32) 9 (gn-sir M (+ p 32) IF-A) 0 0)
    33 (gn-dot-at? M (+ p 33) 4 0 2 0)
    34 (gn-dot-at? M (+ p 34) 4 1 3 0)
    35 (gn-dot-at? M (+ p 35) 6 1 0 0)
    36 (gn-dot-at? M (+ p 36) 3 1 bias 0)
    37 (gn-dot-at? M (+ p 37) 6 1 0 0)
    38 (gn-dot-at? M (+ p 38) 5 5 0 0)
    39 (gn-dot-at? M (+ p 39) 4 0 2 0)
    40 (gn-dot-at? M (+ p 40) 4 1 3 0)
    41 (gn-dot-at? M (+ p 41) 7 1 0 0)
    42 (gn-dot-at? M (+ p 42) 11 0 (gn-sir M (+ p 47) IF-A) 0)
    43 (gn-dot-at? M (+ p 43) 4 0 5 0)
    44 (gn-dot-at? M (+ p 44) 3 1 factor 0)
    45 (gn-dot-at? M (+ p 45) 6 3 0 0)
    46 (gn-dot-at? M (+ p 46) 10 (gn-sir M (+ p 49) IF-A) 0 0)
    47 (gn-dot-at? M (+ p 47) 9 (gn-sir M (+ p 47) IF-A) 0 0)
    48 (gn-dot-at? M (+ p 48) 4 0 5 0)
    49 (gn-dot-at? M (+ p 49) 9 (gn-sir M (+ p 49) IF-A) 0 0)
    50 (gn-dot-at? M (+ p 50) 5 6 0 0)
    51 (gn-dot-at? M (+ p 51) 4 0 1 0)
    52 (gn-dot-at? M (+ p 52) 4 1 2 0)
    53 (gn-dot-at? M (+ p 53) 3 2 stride 0)
    54 (gn-dot-at? M (+ p 54) 6 3 1 0)
    55 (gn-dot-at? M (+ p 55) 4 2 3 0)
    56 (gn-dot-at? M (+ p 56) 6 1 1 0)
    57 (gn-dot-at? M (+ p 57) 4 2 6 0)
    58 (gn-dot-at? M (+ p 58) 13 writer 0 3)
    59 (gn-dot-at? M (+ p 59) 4 1 2 0)
    60 (gn-dot-at? M (+ p 60) 4 2 3 0)
    61 (gn-dot-at? M (+ p 61) 3 3 1 0)
    62 (gn-dot-at? M (+ p 62) 6 1 2 0)
    63 (gn-dot-at? M (+ p 63) 4 3 4 0)
    64 (gn-dot-at? M (+ p 64) 4 4 6 0)
    65 (gn-dot-at? M (+ p 65) 6 1 3 0)
    66 (gn-dot-at? M (+ p 66) 5 1 0 0)
    67 (gn-dot-at? M (+ p 67) 5 2 1 0)
    68 (gn-dot-at? M (+ p 68) 5 3 2 0)
    69 (gn-dot-at? M (+ p 69) 5 4 3 0)
    70 (gn-dot-at? M (+ p 70) 18 0 0 0)
    71 (gn-dot-at? M (+ p 71) 10 (gn-sir M (+ p 2) IF-A) 0 0)
    72 (gn-dot-at? M (+ p 72) 9 (gn-sir M (+ p 72) IF-A) 0 0)
    73 (gn-dot-at? M (+ p 73) 9 (gn-sir M (+ p 73) IF-A) 0 0)
    74 (gn-dot-at? M (+ p 74) 19 0 0 0)
    75 (gn-dot-at? M (+ p 75) 2 f 0 0)
    false) (ri-shape M p f (inc k))))))
(defn- ri-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 7) true (let [off (case k 0 2 1 9 2 32 3 47 4 49 5 72 6 73 0)
  l (gn-sir M (+ p off) IF-A)]
  (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p off)) (ri-labels M p (inc k))))))
(defn- ri-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (>= (+ p 75) (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN)) false
  (let [f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 53) IF-B) out (gn-sir M (+ p 15) IF-B)]
   (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
    (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-NSLOTS) 6) (= (gn-fnf M f FF-DEPTH) 5)
    (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
    (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
    (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-vmode) 0)
    (= (gn-g M gn-f-ns) 6) (= (gn-g M gn-f-dp) 5) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
    (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2) (= (gn-sreg M 4) 3)
    (>= n 1) (<= n 16) (>= stride 1) (<= stride 4095) (>= out 0) (<= out 4095)
    (pz-writer M (gn-sir M (+ p 19) IF-A)) (ri-labels M p 0) (ri-shape M p f 0))))))
(defn- ri-cold [M :vector-i64 G :vector-i64 cc :i64] :vector-i64
 (let [k (vector-at G 0) marker (-> G (vector-assoc! (+ 1 (* k 2)) (vector-at M MM-CODE-N))
   (vector-assoc! (+ 2 (* k 2)) cc) (vector-assoc! 0 (inc k)))] (gn-emit M (enc-bcond cc 0))))
(defn- ri-patch [M :vector-i64 G :vector-i64 k :i64 cold :i64] :vector-i64
 (if (= k (vector-at G 0)) M (ri-patch (gn-dot-patch M (vector-at G (+ 1 (* k 2))) cold (vector-at G (+ 2 (* k 2)))) G (inc k) cold)))
(defn- ri-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (ri-admit M i)) M
 (let [p (dec i) n (gn-sir M (+ p 4) IF-B) out (gn-sir M (+ p 15) IF-B)
  bias (gn-sir M (+ p 36) IF-B) factor (gn-sir M (+ p 44) IF-B) stride (gn-sir M (+ p 53) IF-B) G (vector-alloc 33)
  m0 (-> M (gn-emit (enc-cmp-i 1 n)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-cmp-i 2 n)) (ri-cold G 8)
   (gn-mov-imm 9 n) (gn-emit (enc-sub-r 9 9 1)) (gn-mov-imm 10 (inc n)) (gn-emit (enc-mul 9 9 10))
   (gn-emit (enc-sub-r 9 9 2)) (gn-emit (gn-e-lsl 9 9 1)) (gn-emit (enc-cmp-r 8 9)) (ri-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
   (gn-emit (enc-cmp-r 17 16)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 10 16 0))
   (gn-mov-imm 11 (+ (* (dec n) stride) (dec n))) (gn-emit (enc-cmp-r 11 10)) (ri-cold G (enc-cond-hs))
   (gn-mov-imm 11 (+ out (dec n))) (gn-emit (enc-cmp-r 11 10)) (ri-cold G (enc-cond-hs))
   (gn-emit (enc-ldr 14 7 328)) (gn-emit (gn-e-addsl 14 14 17 3))
   (gn-emit (enc-sub-r 8 8 9))
   ;; x12 = &v[row stride] (items stored at [x12, col, lsl #3]), x11 = row + bias
   (gn-mov-imm 10 stride) (gn-emit (enc-mul 10 1 10)) (gn-emit (gn-e-addsl 12 14 10 3))
   (gn-mov-imm 10 out) (gn-emit (enc-add-r 10 1 10)) (gn-emit (gn-e-addsl 13 14 10 3))
   (gn-mov-imm 15 factor) (ri-rowbias bias))
  ;; Entered at col 0 (the usual call), a computed branch on row picks one straight-line block per row (the
  ;; diagonal's place known in each): the items x11 + c and, at c = row, (x11 + row) * factor, stored in the source's
  ;; order (stp pairs) and each added to the row sum; then the row's sum is stored and the next row dispatched.
  fastbr (vector-at m0 MM-CODE-N)
  mf0 (gn-emit m0 (enc-cbnz 2 0)) fast (vector-at mf0 MM-CODE-N)
  mf0b (-> mf0 (gn-emit (enc-adr 17 12)) (gn-emit (gn-e-addsl 17 17 1 2)) (gn-emit (enc-br 17))) tab (vector-at mf0b MM-CODE-N)
  mf0c (loop [m mf0b r 0] (if (= r n) m (recur (gn-emit m (enc-b 0)) (inc r))))
  R (vector-alloc (* 2 n))
  mf1 (loop [m mf0c r 0] (if (= r n) m
   (let [st (vector-at m MM-CODE-N) m1 (ri-row m n r) en (vector-at m1 MM-CODE-N)
         w1 (vector-assoc! R (* 2 r) st) w2 (vector-assoc! w1 (inc (* 2 r)) en)]
    (recur (gn-emit m1 (enc-b 0)) (inc r)))))
  rtail (vector-at mf1 MM-CODE-N)
  mf1b (loop [m mf1 r 0] (if (= r n) m
   (recur (-> m (gn-put (+ MM-CODE-BASE (+ tab r)) (enc-b (- (vector-at R (* 2 r)) (+ tab r))))
              (gn-put (+ MM-CODE-BASE (vector-at R (inc (* 2 r)))) (enc-b (- rtail (vector-at R (inc (* 2 r)))))))
          (inc r))))
  mf2 (-> mf1b
   (gn-emit (enc-str 3 13 0)) (gn-emit (enc-add-i 13 13 8)) (gn-mov-imm 10 (* stride 8))
   (gn-emit (enc-add-r 12 12 10)) (gn-emit (enc-add-i 1 1 1)) (ri-rowbias bias) (gn-mov-imm 3 0)
   (gn-emit (enc-cmp-i 1 n)))
  fback (vector-at mf2 MM-CODE-N)
  mf3 (gn-emit mf2 (enc-bcond (enc-cond-ne) (- fast fback))) fdone (vector-at mf3 MM-CODE-N)
  mf4 (gn-emit mf3 (enc-b 0)) general (vector-at mf4 MM-CODE-N)
  m1 (-> mf4 (gn-put (+ MM-CODE-BASE fastbr) (enc-cbnz 2 (- general fastbr))) (gn-emit (enc-cmp-i 2 n)))
  rowbranch (vector-at m1 MM-CODE-N)
  ;; body (bottom-tested; a row after the first starts at col 0 < n):
  ;; add x9, x11, col ; cmp row, col ; b.ne +2 ; mul x9, x9, x15 ; str x9, [x12, col, lsl #3] ; add sum ;
  ;; add col, #1 ; cmp col, #n ; b.ne body
  m2 (gn-emit m1 (enc-bcond (enc-cond-eq) 0)) body (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-add-r 9 11 2)) (gn-emit (enc-cmp-r 1 2)) (gn-emit (enc-bcond (enc-cond-ne) 2))
   (gn-emit (enc-mul 9 9 15)) (gn-emit (gn-e-strr3 9 12 2)) (gn-emit (enc-add-r 3 3 9)) (gn-emit (enc-add-i 2 2 1))
   (gn-emit (enc-cmp-i 2 n))) back (vector-at m3 MM-CODE-N)
  m4 (gn-emit m3 (enc-bcond (enc-cond-ne) (- body back))) rowhead (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-str 3 13 0)) (gn-emit (enc-add-i 13 13 8)) (gn-mov-imm 10 (* stride 8))
   (gn-emit (enc-add-r 12 12 10)) (gn-emit (enc-add-i 1 1 1)) (ri-rowbias bias) (gn-mov-imm 2 0) (gn-mov-imm 3 0)
   (gn-emit (enc-cmp-i 1 n))) rowback (vector-at m5 MM-CODE-N)
  m5e (gn-emit m5 (enc-bcond (enc-cond-ne) (- body rowback))) epi (vector-at m5e MM-CODE-N)
  m6 (-> m5e (gn-epilogue) (gn-gs gn-f-dead 0)) cold (vector-at m6 MM-CODE-N)]
  (-> m6 (gn-put (+ MM-CODE-BASE fdone) (enc-b (- epi fdone)))
   (gn-dot-patch rowbranch rowhead (enc-cond-eq)) (ri-patch G 0 cold)))))
;; item c of row r entered at col 0 into x(rd): x11 + c, times factor (x15) when c = r
(defn- ri-val [M :vector-i64 rd :i64 c :i64 r :i64] :vector-i64
 (-> M (gn-emit (if (= c 0) (enc-mov-r rd 11) (enc-add-i rd 11 c)))
     (cond-> (= c r) (gn-emit (enc-mul rd rd 15)))))
;; row r's block: the n items in order, stored by stp pairs at x12, each added to the row sum x3 (a pair's two items
;; summed first: the integer reduction reassociated, exact mod 2^64)
(defn- ri-row [M :vector-i64 n :i64 r :i64] :vector-i64
 (loop [m M c 0] (if (>= c n) m
  (recur (if (< (inc c) n)
          (-> m (ri-val 9 c r) (ri-val 10 (inc c) r) (gn-emit (enc-stp 9 10 12 (* c 8)))
              (gn-emit (enc-add-r 17 9 10)) (gn-emit (enc-add-r 3 3 17)))
          (-> m (ri-val 9 c r) (gn-emit (enc-str 9 12 (* c 8))) (gn-emit (enc-add-r 3 3 9)))) (+ c 2)))))
;; x11 := row (x1) + bias
(defn- ri-rowbias [M :vector-i64 bias :i64] :vector-i64
 (if (and (>= bias 0) (<= bias 4095)) (gn-emit M (enc-add-i 11 1 bias))
  (-> M (gn-mov-imm 11 bias) (gn-emit (enc-add-r 11 1 11)))))

(defn- ru-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 44) true (let [n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 26) IF-B)
  reader (gn-sir M (+ p 19) IF-A) dot (gn-sir M (+ p 20) IF-A) writer (gn-sir M (+ p 31) IF-A)]
 (and (case k
  0 (gn-dot-at? M (+ p 0) 1 f 3 4)
  1 (gn-dot-at? M (+ p 1) 18 0 0 0)
  2 (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (gn-dot-at? M (+ p 3) 4 0 3 0)
  4 (gn-dot-at? M (+ p 4) 3 1 n 0)
  5 (gn-dot-at? M (+ p 5) 7 1 0 0)
  6 (gn-dot-at? M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
  7 (gn-dot-at? M (+ p 7) 4 0 1 0)
  8 (gn-dot-at? M (+ p 8) 10 (gn-sir M (+ p 41) IF-A) 0 0)
  9 (gn-dot-at? M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (gn-dot-at? M (+ p 10) 4 0 1 0)
  11 (gn-dot-at? M (+ p 11) 4 1 2 0)
  12 (gn-dot-at? M (+ p 12) 4 2 3 0)
  13 (gn-dot-at? M (+ p 13) 3 3 0 0)
  14 (gn-dot-at? M (+ p 14) 4 4 1 0)
  15 (gn-dot-at? M (+ p 15) 4 5 2 0)
  16 (gn-dot-at? M (+ p 16) 3 6 1 0)
  17 (gn-dot-at? M (+ p 17) 6 1 5 0)
  18 (gn-dot-at? M (+ p 18) 4 6 3 0)
  19 (gn-dot-at? M (+ p 19) 13 reader 4 3)
  20 (gn-dot-at? M (+ p 20) 13 dot 0 5)
  21 (gn-dot-at? M (+ p 21) 5 4 0 0)
  22 (gn-dot-at? M (+ p 22) 4 0 1 0)
  23 (gn-dot-at? M (+ p 23) 4 1 2 0)
  24 (gn-dot-at? M (+ p 24) 3 2 1 0)
  25 (gn-dot-at? M (+ p 25) 6 1 1 0)
  26 (gn-dot-at? M (+ p 26) 3 2 stride 0)
  27 (gn-dot-at? M (+ p 27) 6 3 1 0)
  28 (gn-dot-at? M (+ p 28) 4 2 3 0)
  29 (gn-dot-at? M (+ p 29) 6 1 1 0)
  30 (gn-dot-at? M (+ p 30) 4 2 4 0)
  31 (gn-dot-at? M (+ p 31) 13 writer 0 3)
  32 (gn-dot-at? M (+ p 32) 4 1 2 0)
  33 (gn-dot-at? M (+ p 33) 4 2 3 0)
  34 (gn-dot-at? M (+ p 34) 3 3 1 0)
  35 (gn-dot-at? M (+ p 35) 6 1 2 0)
  36 (gn-dot-at? M (+ p 36) 5 1 0 0)
  37 (gn-dot-at? M (+ p 37) 5 2 1 0)
  38 (gn-dot-at? M (+ p 38) 5 3 2 0)
  39 (gn-dot-at? M (+ p 39) 18 0 0 0)
  40 (gn-dot-at? M (+ p 40) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  41 (gn-dot-at? M (+ p 41) 9 (gn-sir M (+ p 41) IF-A) 0 0)
  42 (gn-dot-at? M (+ p 42) 19 0 0 0)
  43 (gn-dot-at? M (+ p 43) 2 f 0 0)
 false) (ru-shape M p f (inc k))))))
(defn- ru-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 3) true (let [o (case k 0 2 1 9 2 41 0) l (gn-sir M (+ p o) IF-A)]
  (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p o)) (ru-labels M p (inc k))))))
(defn- ru-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (>= (+ p 43) (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN)) false
 (let [f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 26) IF-B)
  reader (gn-sir M (+ p 19) IF-A) dot (gn-sir M (+ p 20) IF-A) writer (gn-sir M (+ p 31) IF-A)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 4) (= (gn-fnf M f FF-DEPTH) 7)
  (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
  (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
  (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
  (= (gn-g M gn-f-ns) 4) (= (gn-g M gn-f-dp) 7) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
  (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 4)
  (>= n 1) (<= n 64) (>= stride 1) (<= stride 4095)
  (ru-shape M p f 0) (ru-labels M p 0) (pz-writer M writer)
  (> reader 0) (< reader (vector-at M MM-FN-N))
  (> dot 0) (< dot (vector-at M MM-FN-N))
  (> (gn-fnf M reader FF-SIR) 0) (< (+ (gn-fnf M reader FF-SIR) 11) (vector-at M MM-SIR-N))
  (> (gn-fnf M dot FF-SIR) 0) (< (+ (gn-fnf M dot FF-SIR) 38) (vector-at M MM-SIR-N))
  (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 5) IF-A) CC-GT)
  (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 22) IF-A) reader)
  (> (mr-reader M (+ p 19) reader 3) 0)
  (= (gn-op M (inc (gn-fnf M reader FF-SIR))) OP-FUEL)
  (= (gn-sir M (+ (mr-reader M (+ p 19) reader 3) 2) IF-B) stride)
  (> (dr-shape M (+ p 20) dot) 0)
  (let [a (gn-sreg M 1) b (gn-sreg M 2) c (gn-sreg M 3)]
   (and (>= a 19) (<= a 28) (>= b 19) (<= b 28) (>= c 19) (<= c 28)
    (not= a b) (not= a c) (not= b c))))))))
;; pre: see rv-entry2; i + 1 lives in x4 (x1 is the parameter the prologue still needs)
(defn- ru-entry [M :vector-i64 i :i64] :vector-i64 (ru-entry2 M i false))
(defn- ru-entry2 [M :vector-i64 i :i64 pre :bool] :vector-i64
 (if (not (ru-admit M i)) M
 (let [p (dec i) n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 26) IF-B) G (vector-alloc 17) r1 (if pre 4 1)
  m0 (-> M (gn-mov 0 (kp M pre 1)) (gn-mov 1 (kp M pre 2)) (gn-mov 2 (kp M pre 3))
   (gn-emit (enc-cmp-i 1 63)) (ri-cold G 8) (gn-emit (enc-cmp-i 2 n)) (ri-cold G 2)
   (gn-emit (enc-add-i r1 1 1)) (gn-mov-imm 3 n) (gn-emit (enc-sub-r 3 3 2))
   (gn-mov-imm 16 3) (gn-emit (enc-mul 11 r1 16)) (gn-emit (enc-add-i 11 11 4))
   (gn-emit (enc-mul 11 11 3)) (cond-> pre (gn-emit (enc-add-i 11 11 1)))
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 11)) (ri-cold G 3)
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
   (gn-emit (enc-cmp-r 17 16)) (ri-cold G 2) (gn-emit (enc-ldr 16 7 320))
   (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
   (gn-emit (enc-sub-i 12 r1 1)) (gn-emit (enc-cmp-i 12 (dec n)))) bm (vector-at m0 MM-CODE-N)
  m1 (gn-emit m0 (enc-bcond 2 2))
  m2 (-> m1 (gn-mov-imm 12 (dec n)) (gn-mov-imm 5 stride) (gn-emit (enc-mul 13 r1 5))
   (gn-emit (enc-add-r 13 13 12)) (gn-emit (enc-cmp-r 13 16)) (ri-cold G 2)
   (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 15 15 17 3))
   (gn-emit (enc-sub-r 8 8 11)) (gn-emit (enc-str 8 7 CTX-FUEL))
   (gn-emit (enc-mul 6 r1 5)) (gn-emit (gn-e-addsl 6 15 6 3)) (gn-mov-imm 5 (* stride 8))) outer (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (gn-e-addsl 16 6 2 3)) (gn-emit (enc-ldr 9 16 0)) (gn-mov 10 6)
   (gn-emit (gn-e-addsl 11 15 2 3)) (gn-mov 12 r1)) inner (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-ldr 13 10 0)) (gn-emit (enc-ldr 14 11 0))
   (gn-emit (+ (enc-madd 9 13 14 9) 0x8000))
   (gn-emit (enc-add-i 10 10 8)) (gn-emit (enc-add-r 11 11 5))
   (gn-emit (enc-subs-i 12 12 1))) ib (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-bcond 1 (- inner ib))) (gn-emit (gn-e-addsl 16 6 2 3)) (gn-emit (enc-str 9 16 0))
   (gn-emit (enc-add-i 2 2 1)) (gn-emit (enc-subs-i 3 3 1))) ob (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond 1 (- outer ob))) (kp-exit pre)) end (vector-at m6 MM-CODE-N)]
 (ri-patch m6 G 0 end))))

(defn- rl-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 47) true (let [n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 29) IF-B)
  reader (gn-sir M (+ p 17) IF-A) dot (gn-sir M (+ p 18) IF-A) writer (gn-sir M (+ p 34) IF-A)]
 (and (case k
  0 (gn-dot-at? M (+ p 0) 1 f 3 5)
  1 (gn-dot-at? M (+ p 1) 18 0 0 0)
  2 (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (gn-dot-at? M (+ p 3) 4 0 3 0)
  4 (gn-dot-at? M (+ p 4) 3 1 n 0)
  5 (gn-dot-at? M (+ p 5) 7 1 0 0)
  6 (gn-dot-at? M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
  7 (gn-dot-at? M (+ p 7) 4 0 1 0)
  8 (gn-dot-at? M (+ p 8) 10 (gn-sir M (+ p 44) IF-A) 0 0)
  9 (gn-dot-at? M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (gn-dot-at? M (+ p 10) 4 0 1 0)
  11 (gn-dot-at? M (+ p 11) 4 1 3 0)
  12 (gn-dot-at? M (+ p 12) 4 2 2 0)
  13 (gn-dot-at? M (+ p 13) 3 3 0 0)
  14 (gn-dot-at? M (+ p 14) 4 4 1 0)
  15 (gn-dot-at? M (+ p 15) 4 5 3 0)
  16 (gn-dot-at? M (+ p 16) 4 6 2 0)
  17 (gn-dot-at? M (+ p 17) 13 reader 4 3)
  18 (gn-dot-at? M (+ p 18) 13 dot 0 5)
  19 (gn-dot-at? M (+ p 19) 5 4 0 0)
  20 (gn-dot-at? M (+ p 20) 4 0 4 0)
  21 (gn-dot-at? M (+ p 21) 4 1 1 0)
  22 (gn-dot-at? M (+ p 22) 4 2 2 0)
  23 (gn-dot-at? M (+ p 23) 4 3 2 0)
  24 (gn-dot-at? M (+ p 24) 13 reader 1 3)
  25 (gn-dot-at? M (+ p 25) 6 4 0 0)
  26 (gn-dot-at? M (+ p 26) 5 5 0 0)
  27 (gn-dot-at? M (+ p 27) 4 0 1 0)
  28 (gn-dot-at? M (+ p 28) 4 1 3 0)
  29 (gn-dot-at? M (+ p 29) 3 2 stride 0)
  30 (gn-dot-at? M (+ p 30) 6 3 1 0)
  31 (gn-dot-at? M (+ p 31) 4 2 2 0)
  32 (gn-dot-at? M (+ p 32) 6 1 1 0)
  33 (gn-dot-at? M (+ p 33) 4 2 5 0)
  34 (gn-dot-at? M (+ p 34) 13 writer 0 3)
  35 (gn-dot-at? M (+ p 35) 4 1 2 0)
  36 (gn-dot-at? M (+ p 36) 4 2 3 0)
  37 (gn-dot-at? M (+ p 37) 3 3 1 0)
  38 (gn-dot-at? M (+ p 38) 6 1 2 0)
  39 (gn-dot-at? M (+ p 39) 5 1 0 0)
  40 (gn-dot-at? M (+ p 40) 5 2 1 0)
  41 (gn-dot-at? M (+ p 41) 5 3 2 0)
  42 (gn-dot-at? M (+ p 42) 18 0 0 0)
  43 (gn-dot-at? M (+ p 43) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  44 (gn-dot-at? M (+ p 44) 9 (gn-sir M (+ p 44) IF-A) 0 0)
  45 (gn-dot-at? M (+ p 45) 19 0 0 0)
  46 (gn-dot-at? M (+ p 46) 2 f 0 0)
 false) (rl-shape M p f (inc k))))))
(defn- rl-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 3) true (let [o (case k 0 2 1 9 2 44 0) l (gn-sir M (+ p o) IF-A)]
  (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p o)) (rl-labels M p (inc k))))))
(defn- rl-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (>= (+ p 46) (vector-at M MM-SIR-N)) (not= (gn-op M p) OP-FN)) false
 (let [f (gn-sir M p IF-A) n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 29) IF-B)
  reader (gn-sir M (+ p 17) IF-A) dot (gn-sir M (+ p 18) IF-A) writer (gn-sir M (+ p 34) IF-A)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 5) (= (gn-fnf M f FF-DEPTH) 7)
  (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
  (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
  (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
  (= (gn-g M gn-f-ns) 5) (= (gn-g M gn-f-dp) 7) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
  (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 5)
  (>= n 1) (<= n 64) (>= stride 1) (<= stride 4095)
  (rl-shape M p f 0) (rl-labels M p 0) (pz-writer M writer)
  (> reader 0) (< reader (vector-at M MM-FN-N))
  (> dot 0) (< dot (vector-at M MM-FN-N))
  (> (gn-fnf M reader FF-SIR) 0) (< (+ (gn-fnf M reader FF-SIR) 11) (vector-at M MM-SIR-N))
  (> (gn-fnf M dot FF-SIR) 0) (< (+ (gn-fnf M dot FF-SIR) 36) (vector-at M MM-SIR-N))
  (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 5) IF-A) CC-EQ)
  (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 20) IF-A) reader)
  (> (mr-reader M (+ p 17) reader 3) 0)
  (= (gn-op M (inc (gn-fnf M reader FF-SIR))) OP-FUEL)
  (= (gn-sir M (+ (mr-reader M (+ p 17) reader 3) 2) IF-B) stride)
  (> (dr-shape M (+ p 18) dot) 0)
  (let [a (gn-sreg M 1) b (gn-sreg M 2) c (gn-sreg M 3)]
   (and (>= a 19) (<= a 28) (>= b 19) (<= b 28) (>= c 19) (<= c 28)
    (not= a b) (not= a c) (not= b c))))))))
;; pre: see rv-entry2 (no parameter register is written before the last guard)
(defn- rl-entry [M :vector-i64 i :i64] :vector-i64 (rl-entry2 M i false))
(defn- rl-entry2 [M :vector-i64 i :i64 pre :bool] :vector-i64
 (if (not (rl-admit M i)) M
 (let [p (dec i) n (gn-sir M (+ p 4) IF-B) stride (gn-sir M (+ p 29) IF-B) G (vector-alloc 21)
  m0 (-> M (gn-mov 0 (kp M pre 1)) (gn-mov 1 (kp M pre 2)) (gn-mov 2 (kp M pre 3))
   (gn-emit (enc-cmp-i 1 63)) (ri-cold G 8) (gn-emit (enc-cmp-i 2 n)) (ri-cold G 2)
   (gn-emit (enc-cmp-r 2 1)) (ri-cold G 9)
   (gn-mov-imm 3 n) (gn-emit (enc-sub-r 3 3 2))
   (gn-mov-imm 16 3) (gn-emit (enc-mul 11 1 16)) (gn-emit (enc-add-i 11 11 5))
   (gn-emit (enc-mul 11 11 3)) (cond-> pre (gn-emit (enc-add-i 11 11 1)))
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 11)) (ri-cold G 3)
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
   (gn-emit (enc-cmp-r 17 16)) (ri-cold G 2) (gn-emit (enc-ldr 16 7 320))
   (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
   (gn-mov-imm 12 (* (dec n) stride)) (gn-emit (enc-add-r 12 12 1))
   (gn-emit (enc-cmp-r 12 16)) (ri-cold G 2)
   (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 15 15 17 3))
   (gn-mov-imm 5 stride) (gn-emit (enc-mul 6 1 5)) (gn-emit (enc-add-r 6 6 1))
   (gn-emit (gn-e-addsl 16 15 6 3)) (gn-emit (enc-ldr 6 16 0))
   (gn-emit (enc-cmp-i 6 0)) (ri-cold G 0) (gn-emit (enc-cmn-i 6 1)) (ri-cold G 0)
   (gn-emit (enc-sub-r 8 8 11)) (gn-emit (enc-str 8 7 CTX-FUEL))
   (gn-mov-imm 5 (* stride 8))) outer (vector-at m0 MM-CODE-N)
  m1 (-> m0 (gn-emit (enc-mul 10 2 5)) (gn-emit (enc-add-r 10 10 15))
   (gn-emit (gn-e-addsl 16 10 1 3)) (gn-emit (enc-ldr 9 16 0))
   (gn-emit (gn-e-addsl 11 15 1 3)) (gn-mov 12 1) (gn-emit (enc-cmp-i 12 0))) zero (vector-at m1 MM-CODE-N)
  m2 (gn-emit m1 (enc-bcond 0 0)) inner (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-ldr 13 10 0)) (gn-emit (enc-ldr 14 11 0))
   (gn-emit (+ (enc-madd 9 13 14 9) 0x8000))
   (gn-emit (enc-add-i 10 10 8)) (gn-emit (enc-add-r 11 11 5))
   (gn-emit (enc-subs-i 12 12 1))) ib (vector-at m3 MM-CODE-N)
  m4 (gn-emit m3 (enc-bcond 1 (- inner ib))) write (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-emit (enc-sdiv 9 9 6)) (gn-emit (enc-mul 16 2 5)) (gn-emit (enc-add-r 16 16 15))
   (gn-emit (gn-e-addsl 16 16 1 3)) (gn-emit (enc-str 9 16 0))
   (gn-emit (enc-add-i 2 2 1)) (gn-emit (enc-subs-i 3 3 1))) ob (vector-at m5 MM-CODE-N)
  m6 (-> m5 (gn-emit (enc-bcond 1 (- outer ob))) (kp-exit pre)) end (vector-at m6 MM-CODE-N)]
 (ri-patch (gn-dot-patch m6 zero write 0) G 0 end))))

;; ---- ud lu: (lu v i) = (if (= i stop) v (lu (upper (lower v i (+ i 1)) i (+ i 1)) (+ i 1))) with lower / upper the
;; rl / ru shapes (same n = stop + 1 and stride). Entered at i = 0 (the usual call) the whole factorization runs before
;; the frame as straight-line code unrolled at compile time: per step i the pivot v[i][i] is read (0 or -1: the step is
;; left to the generic code, see below), then lower's (n - 1 - i) quotients (v[j][i] - sum_k<i v[j][k] v[k][i]) / pivot
;; and upper's (n - 1 - i) row updates v[i+1][j] - sum_k<=i v[i+1][k] v[k][j], by ldr / msub / sdiv / str at fixed
;; offsets (entries of one call are independent; calls in order). Charges, all prepaid: 1, then per step lower
;; 1 + (3i + 5)(n - 1 - i), upper 1 + (3i + 7)(n - 1 - i) and the loop 1 (rl-entry2 / ru-entry2's counts). A pivot
;; 0 or -1 at step k publishes the charges of steps < k (not lu's entry), sets i = k and enters lu's own code, which
;; charges its entry (the loop charge it stands for) and runs step k generically (its trap included).
(defn- lu-lower? [M :vector-i64 f :i64 n :i64 stride :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (< (+ p 46) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f)
    (let [reader (gn-sir M (+ p 17) IF-A) dot (gn-sir M (+ p 18) IF-A) writer (gn-sir M (+ p 34) IF-A)]
     (and (= (gn-sir M (+ p 4) IF-B) n) (= (gn-sir M (+ p 29) IF-B) stride)
      (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 5) (= (gn-fnf M f FF-DEPTH) 7)
      (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
      (rl-shape M p f 0) (rl-labels M p 0) (pz-writer M writer)
      (> reader 0) (< reader (vector-at M MM-FN-N)) (> dot 0) (< dot (vector-at M MM-FN-N))
      (> (gn-fnf M reader FF-SIR) 0) (< (+ (gn-fnf M reader FF-SIR) 11) (vector-at M MM-SIR-N))
      (> (gn-fnf M dot FF-SIR) 0) (< (+ (gn-fnf M dot FF-SIR) 36) (vector-at M MM-SIR-N))
      (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 5) IF-A) CC-EQ)
      (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 20) IF-A) reader)
      (> (mr-reader M (+ p 17) reader 3) 0)
      (= (gn-op M (inc (gn-fnf M reader FF-SIR))) OP-FUEL)
      (= (gn-sir M (+ (mr-reader M (+ p 17) reader 3) 2) IF-B) stride)
      (> (dr-shape M (+ p 18) dot) 0)))))))
(defn- lu-upper? [M :vector-i64 f :i64 n :i64 stride :i64] :bool
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (let [p (gn-fnf M f FF-SIR)]
   (and (> p 0) (< (+ p 43) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (= (gn-sir M p IF-A) f)
    (let [reader (gn-sir M (+ p 19) IF-A) dot (gn-sir M (+ p 20) IF-A) writer (gn-sir M (+ p 31) IF-A)]
     (and (= (gn-sir M (+ p 4) IF-B) n) (= (gn-sir M (+ p 26) IF-B) stride)
      (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 4) (= (gn-fnf M f FF-DEPTH) 7)
      (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
      (ru-shape M p f 0) (ru-labels M p 0) (pz-writer M writer)
      (> reader 0) (< reader (vector-at M MM-FN-N)) (> dot 0) (< dot (vector-at M MM-FN-N))
      (> (gn-fnf M reader FF-SIR) 0) (< (+ (gn-fnf M reader FF-SIR) 11) (vector-at M MM-SIR-N))
      (> (gn-fnf M dot FF-SIR) 0) (< (+ (gn-fnf M dot FF-SIR) 38) (vector-at M MM-SIR-N))
      (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 5) IF-A) CC-GT)
      (= (gn-sir M (+ (gn-fnf M dot FF-SIR) 22) IF-A) reader)
      (> (mr-reader M (+ p 19) reader 3) 0)
      (= (gn-op M (inc (gn-fnf M reader FF-SIR))) OP-FUEL)
      (= (gn-sir M (+ (mr-reader M (+ p 19) reader 3) 2) IF-B) stride)
      (> (dr-shape M (+ p 20) dot) 0)))))))
;; lu's own SIR (31 ops) after FN f 2 2 / FUEL: the loop on i (slot 2) against stop, calls lower then upper
(defn- lu-shape? [M :vector-i64 p :i64 f :i64 stop :i64 lo :i64 up :i64] :bool
 (let [head (gn-sir M (+ p 2) IF-A) else (gn-sir M (+ p 9) IF-A) out (gn-sir M (+ p 28) IF-A)]
  (and (gn-dot-at? M p OP-FN f 2 2) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0) (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
   (gn-dot-at? M (+ p 3) OP-LGET 0 2 0) (gn-dot-at? M (+ p 4) OP-CONST 1 stop 0) (gn-dot-at? M (+ p 5) OP-CMP CC-EQ 0 0)
   (gn-dot-at? M (+ p 6) OP-BRZ 0 else 0) (gn-dot-at? M (+ p 7) OP-LGET 0 1 0) (gn-dot-at? M (+ p 8) OP-BR out 0 0)
   (gn-dot-at? M (+ p 9) OP-LABEL else 0 0) (gn-dot-at? M (+ p 10) OP-LGET 0 1 0) (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
   (gn-dot-at? M (+ p 12) OP-LGET 2 2 0) (gn-dot-at? M (+ p 13) OP-CONST 3 1 0) (gn-dot-at? M (+ p 14) OP-BIN BOP-ADD 2 0)
   (gn-dot-at? M (+ p 15) OP-CALL lo 0 3) (gn-dot-at? M (+ p 16) OP-LGET 1 2 0) (gn-dot-at? M (+ p 17) OP-LGET 2 2 0)
   (gn-dot-at? M (+ p 18) OP-CONST 3 1 0) (gn-dot-at? M (+ p 19) OP-BIN BOP-ADD 2 0) (gn-dot-at? M (+ p 20) OP-CALL up 0 3)
   (gn-dot-at? M (+ p 21) OP-LGET 1 2 0) (gn-dot-at? M (+ p 22) OP-CONST 2 1 0) (gn-dot-at? M (+ p 23) OP-BIN BOP-ADD 1 0)
   (gn-dot-at? M (+ p 24) OP-LSET 1 0 0) (gn-dot-at? M (+ p 25) OP-LSET 2 1 0) (gn-dot-at? M (+ p 26) OP-FUEL 0 0 0)
   (gn-dot-at? M (+ p 27) OP-BR head 0 0) (gn-dot-at? M (+ p 28) OP-LABEL out 0 0) (gn-dot-at? M (+ p 29) OP-RET 0 0 0)
   (gn-dot-at? M (+ p 30) OP-END f 0 0) (kpat-labels? M p 31))))
(defn- lu-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 31) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)
   (let [stop (gn-sir M (+ p 4) IF-B) lo (gn-sir M (+ p 15) IF-A) up (gn-sir M (+ p 20) IF-A)
         n (inc stop) q (kfn-q M lo) stride (if (> q 0) (gn-sir M (+ q 29) IF-B) 0)]
    (and (>= stop 1) (<= stop 7) (not= lo f) (not= up f) (not= lo up) (> q 0)
     (>= stride n) (< (+ (* (dec n) stride) (dec n)) 4096)
     (lu-shape? M p f stop lo up) (lu-lower? M lo n stride) (lu-upper? M up n stride))))))
(defn- lu-off [r :i64 c :i64 stride :i64] :i64 (* 8 (+ (* r stride) c)))
(defn- lu-cost [i :i64 n :i64] :i64 (+ 3 (* (+ (* 6 i) 12) (- n (inc i)))))
(defn- lu-charge [k :i64 n :i64] :i64 (loop [i 0 a 0] (if (= i k) a (recur (inc i) (+ a (lu-cost i n))))))
;; one entry: x9 = v[r][c] - sum_k<m v[a(k)][b(k)] (rows: r k; cols: k c), then / pivot when div, stored back
(defn- lu-entry1 [M :vector-i64 r :i64 c :i64 m :i64 low :bool stride :i64] :vector-i64
 (let [m0 (gn-emit M (enc-ldr 9 15 (lu-off r c stride)))
       m1 (loop [mm m0 k 0] (if (= k m) mm
            (recur (-> mm (gn-emit (enc-ldr 13 15 (lu-off r k stride))) (gn-emit (enc-ldr 14 15 (lu-off k c stride)))
                    (gn-emit (+ (enc-madd 9 13 14 9) 0x8000))) (inc k))))]
  (-> m1 (cond-> low (gn-emit (enc-sdiv 9 9 6))) (gn-emit (enc-str 9 15 (lu-off r c stride))))))
(defn- lu-step [M :vector-i64 i :i64 n :i64 stride :i64] :vector-i64
 (let [ml (loop [m M j (inc i)] (if (= j n) m (recur (lu-entry1 m j i i true stride) (inc j))))]
  (loop [m ml j (inc i)] (if (= j n) m (recur (lu-entry1 m (inc i) j (inc i) false stride) (inc j))))))
(defn- lu-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (lu-admit M i)) M
  (let [p (dec i) stop (gn-sir M (+ p 4) IF-B) n (inc stop) q (kfn-q M (gn-sir M (+ p 15) IF-A))
        stride (gn-sir M (+ q 29) IF-B) G (vector-alloc 33) S (vector-alloc 16) total (inc (lu-charge stop n))
        m0 (-> M (gn-emit (enc-cmp-i 1 0)) (ri-cold G (enc-cond-ne))
             (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov-imm 16 total) (gn-emit (enc-cmp-r 8 16)) (ri-cold G (enc-cond-lo))
             (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
             (gn-emit (enc-cmp-r 17 16)) (ri-cold G (enc-cond-hs)) (gn-emit (enc-ldr 16 7 320))
             (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
             (gn-mov-imm 12 (+ (* (dec n) stride) (dec n))) (gn-emit (enc-cmp-r 12 16)) (ri-cold G (enc-cond-hs))
             (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 15 15 17 3)))
        m1 (loop [m m0 k 0] (if (= k stop) m
             (let [ma (-> m (gn-emit (enc-ldr 6 15 (lu-off k k stride))) (gn-emit (enc-cmp-i 6 0)))
                   s0 (vector-assoc! S (* 2 k) (vector-at ma MM-CODE-N))
                   mb (-> (gn-emit ma (enc-bcond (enc-cond-eq) 0)) (gn-emit (enc-cmn-i 6 1)))
                   s1 (vector-assoc! S (inc (* 2 k)) (vector-at mb MM-CODE-N))]
              (recur (lu-step (gn-emit mb (enc-bcond (enc-cond-eq) 0)) k n stride) (inc k)))))
        m2 (-> m1 (gn-mov-imm 16 total) (gn-emit (enc-sub-r 8 8 16)) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-ret)))
        ;; stubs: charges of the finished steps, i = k, into lu's own code (patched to cold below)
        m3 (loop [m m2 k 0] (if (= k stop) m
             (let [at (vector-at m MM-CODE-N)
                   mm (-> m (gn-dot-patch (vector-at S (* 2 k)) at (enc-cond-eq)) (gn-dot-patch (vector-at S (inc (* 2 k))) at (enc-cond-eq))
                        (gn-mov-imm 16 (lu-charge k n)) (gn-emit (enc-sub-r 8 8 16)) (gn-emit (enc-str 8 7 CTX-FUEL))
                        (gn-mov-imm 1 k) (gn-emit (enc-cmp-r 31 31)))]
              (recur (ri-cold mm G (enc-cond-eq)) (inc k)))))
        cold (vector-at m3 MM-CODE-N)]
   (ri-patch m3 G 0 cold))))

;; ---- ud substitutions: (forward v i) for i < 6: v[440+i] = v[400+i] - sum_j<i at(i, j) v[440+j] (forward-sum), and
;; (backward v i) for i >= 0 down: v[420+i] = (v[440+i] - sum_j>i at(i, j) v[420+j]) quot at(i, i) (backward-sum),
;; at(r, c) = v[20 r + c]. Entered at the usual i (0 / 5) each runs before the frame as straight-line code (ldr / msub /
;; sdiv / str at fixed offsets; the products and differences wrap as the source's). Charges, prepaid: forward 1 + sum
;; (2i + 3), backward 1 + sum (2(5 - i) + 4) (entry, the sum's entry and two per term, at, put, the loop). backward reads
;; its six divisors first (backward only writes v[420..425]): any 0 or -1 leaves the whole call to the generic code.
;; The SIRs of forward, backward, their sums, at and put are packed patterns (the constants literal).
(defn- ufw-pat [] :string "")
(defn- ufs-pat [] :string "")
(defn- ubw-pat [] :string "")
(defn- ubs-pat [] :string "")
(defn- uat-pat [] :string "0001fff60003000300120000000000000009fc1600000000000400000001000000040001000200000003000200140000000600030001000000040002000300000006000100010000000e00b00000000200130000000000000002fff600000000")
(defn- ufb-head [M :vector-i64 i :i64 n :i64] :i64
 (let [p (dec i) f (gn-sir M p IF-A)]
  (if (and (> p 0) (< (+ p n) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
           (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-RTYPE) TY-VEC)
           (= (gn-fnf M f FF-PT0) TY-VEC) (= (gn-fnf M f (+ FF-PT0 1)) TY-I64)) f 0)))
(defn- uf-admit [M :vector-i64 i :i64] :bool
 (let [f (ufb-head M i 36) p (dec i)]
  (and (> f 0)
   (let [fs (gn-sir M (+ p 18) IF-A) put (gn-sir M (+ p 25) IF-A) q (kfn-q M fs) at (if (> q 0) (gn-sir M (+ q 19) IF-A) 0)]
    (and (> q 0) (not= fs f) (not= put f) (not= at f) (not= fs put) (not= fs at) (not= put at)
     (pj-fn? M f 36 (ufw-pat) [f fs put]) (pj-fn? M fs 36 (ufs-pat) [fs at]) (pj-fn? M at 12 (uat-pat) [at])
     (pj-fn? M put 9 (pj-put-pat) [put]))))))
(defn- ub-admit [M :vector-i64 i :i64] :bool
 (let [f (ufb-head M i 45) p (dec i)]
  (and (> f 0)
   (let [bs (gn-sir M (+ p 20) IF-A) at (gn-sir M (+ p 26) IF-A) put (gn-sir M (+ p 34) IF-A)]
    (and (not= bs f) (not= put f) (not= at f) (not= bs put) (not= bs at) (not= put at)
     (pj-fn? M f 45 (ubw-pat) [f bs at put]) (pj-fn? M bs 36 (ubs-pat) [bs at]) (pj-fn? M at 12 (uat-pat) [at])
     (pj-fn? M put 9 (pj-put-pat) [put]))))))
;; guards for both: i (x1) the usual entry, fuel >= total, v live with more than 445 items; x15 = &v[0]
(defn- ufb-guards [M :vector-i64 G :vector-i64 i0 :i64 total :i64] :vector-i64
 (-> M (gn-emit (enc-cmp-i 1 i0)) (ri-cold G (enc-cond-ne))
  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov-imm 16 total) (gn-emit (enc-cmp-r 8 16)) (ri-cold G (enc-cond-lo))
  (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
  (gn-emit (enc-cmp-r 17 16)) (ri-cold G (enc-cond-hs)) (gn-emit (enc-ldr 16 7 320))
  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
  (gn-mov-imm 12 445) (gn-emit (enc-cmp-r 12 16)) (ri-cold G (enc-cond-hs))
  (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 15 15 17 3))))
(defn- ufb-done [M :vector-i64 total :i64] :vector-i64
 (-> M (gn-mov-imm 16 total) (gn-emit (enc-sub-r 8 8 16)) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-ret))))
;; x9 = v[w] - sum over k of v[a(k)] v[b(k)], k in [k0, k1): forward a = 20i + k, b = 440 + k; backward b = 420 + k
(defn- ufb-sum [M :vector-i64 w :i64 i :i64 k0 :i64 k1 :i64 b :i64] :vector-i64
 (loop [m (gn-emit M (enc-ldr 9 15 (* 8 w))) k k0] (if (>= k k1) m
  (recur (-> m (gn-emit (enc-ldr 13 15 (* 8 (+ (* 20 i) k)))) (gn-emit (enc-ldr 14 15 (* 8 (+ b k))))
          (gn-emit (+ (enc-madd 9 13 14 9) 0x8000))) (inc k)))))
(defn- uf-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (uf-admit M i)) M
  (let [G (vector-alloc 9)
        m0 (ufb-guards M G 0 49)
        m1 (loop [m m0 r 0] (if (= r 6) m
             (recur (-> m (ufb-sum (+ 400 r) r 0 r 440) (gn-emit (enc-str 9 15 (* 8 (+ 440 r))))) (inc r))))
        m2 (ufb-done m1 49) cold (vector-at m2 MM-CODE-N)]
   (ri-patch m2 G 0 cold))))
(defn- ub-entry [M :vector-i64 i :i64] :vector-i64
 (if (not (ub-admit M i)) M
  (let [G (vector-alloc 33)
        m0 (loop [m (ufb-guards M G 5 55) r 0] (if (= r 6) m
             (recur (-> m (gn-emit (enc-ldr 6 15 (* 8 (* 21 r)))) (gn-emit (enc-cmp-i 6 0)) (ri-cold G (enc-cond-eq))
                     (gn-emit (enc-cmn-i 6 1)) (ri-cold G (enc-cond-eq))) (inc r))))
        m1 (loop [m m0 r 5] (if (< r 0) m
             (recur (-> m (ufb-sum (+ 440 r) r (inc r) 6 420) (gn-emit (enc-ldr 6 15 (* 8 (* 21 r))))
                     (gn-emit (enc-sdiv 9 9 6)) (gn-emit (enc-str 9 15 (* 8 (+ 420 r))))) (dec r))))
        m2 (ufb-done m1 55) cold (vector-at m2 MM-CODE-N)]
   (ri-patch m2 G 0 cold))))

(defn- shloop-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 99) true
  (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
        exit (gn-sir M (+ p 17) IF-A) n (gn-sir M (+ p 4) IF-B)
        offset (gn-sir M (+ p 49) IF-B) finish (gn-sir M (+ p 16) IF-A)
        sig1 (gn-sir M (+ p 42) IF-A) sig0 (gn-sir M (+ p 59) IF-A)
        mask (gn-sir M (+ p 56) IF-A)]
   (and (case k
    0 (gn-dot-at? M (+ p 0) OP-FN f 11 15)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 3 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP 1 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-LGET 1 4 0)
    9 (gn-dot-at? M (+ p 9) OP-LGET 2 5 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 3 6 0)
    11 (gn-dot-at? M (+ p 11) OP-LGET 4 7 0)
    12 (gn-dot-at? M (+ p 12) OP-LGET 5 8 0)
    13 (gn-dot-at? M (+ p 13) OP-LGET 6 9 0)
    14 (gn-dot-at? M (+ p 14) OP-LGET 7 10 0)
    15 (gn-dot-at? M (+ p 15) OP-LGET 8 11 0)
    16 (gn-dot-at? M (+ p 16) OP-CALL finish 0 9)
    17 (gn-dot-at? M (+ p 17) OP-BR exit 0 0)
    18 (gn-dot-at? M (+ p 18) OP-LABEL body 0 0)
    19 (gn-dot-at? M (+ p 19) OP-LGET 0 8 0)
    20 (gn-dot-at? M (+ p 20) OP-LGET 1 9 0)
    21 (gn-dot-at? M (+ p 21) OP-BIN 5 0 0)
    22 (gn-dot-at? M (+ p 22) OP-LGET 1 8 0)
    23 (gn-dot-at? M (+ p 23) OP-UN 2 1 0)
    24 (gn-dot-at? M (+ p 24) OP-LGET 2 10 0)
    25 (gn-dot-at? M (+ p 25) OP-BIN 5 1 0)
    26 (gn-dot-at? M (+ p 26) OP-BIN 7 0 0)
    27 (gn-dot-at? M (+ p 27) OP-LSET 12 0 0)
    28 (gn-dot-at? M (+ p 28) OP-LGET 0 4 0)
    29 (gn-dot-at? M (+ p 29) OP-LGET 1 5 0)
    30 (gn-dot-at? M (+ p 30) OP-BIN 5 0 0)
    31 (gn-dot-at? M (+ p 31) OP-LGET 1 4 0)
    32 (gn-dot-at? M (+ p 32) OP-LGET 2 6 0)
    33 (gn-dot-at? M (+ p 33) OP-BIN 5 1 0)
    34 (gn-dot-at? M (+ p 34) OP-BIN 7 0 0)
    35 (gn-dot-at? M (+ p 35) OP-LGET 1 5 0)
    36 (gn-dot-at? M (+ p 36) OP-LGET 2 6 0)
    37 (gn-dot-at? M (+ p 37) OP-BIN 5 1 0)
    38 (gn-dot-at? M (+ p 38) OP-BIN 7 0 0)
    39 (gn-dot-at? M (+ p 39) OP-LSET 13 0 0)
    40 (gn-dot-at? M (+ p 40) OP-LGET 0 11 0)
    41 (gn-dot-at? M (+ p 41) OP-LGET 1 8 0)
    42 (gn-dot-at? M (+ p 42) OP-CALL sig1 1 1)
    43 (gn-dot-at? M (+ p 43) OP-BIN 1 0 0)
    44 (gn-dot-at? M (+ p 44) OP-LGET 1 12 0)
    45 (gn-dot-at? M (+ p 45) OP-LGET 2 2 0)
    46 (gn-dot-at? M (+ p 46) OP-LGET 3 3 0)
    47 (gn-dot-at? M (+ p 47) OP-RT 176 2 2)
    48 (gn-dot-at? M (+ p 48) OP-LGET 3 1 0)
    49 (gn-dot-at? M (+ p 49) OP-CONST 4 offset 0)
    50 (gn-dot-at? M (+ p 50) OP-LGET 5 3 0)
    51 (gn-dot-at? M (+ p 51) OP-BIN 1 4 0)
    52 (gn-dot-at? M (+ p 52) OP-RT 176 3 2)
    53 (gn-dot-at? M (+ p 53) OP-BIN 1 2 0)
    54 (gn-dot-at? M (+ p 54) OP-BIN 1 1 0)
    55 (gn-dot-at? M (+ p 55) OP-BIN 1 0 0)
    56 (gn-dot-at? M (+ p 56) OP-CALL mask 0 1)
    57 (gn-dot-at? M (+ p 57) OP-LSET 14 0 0)
    58 (gn-dot-at? M (+ p 58) OP-LGET 0 4 0)
    59 (gn-dot-at? M (+ p 59) OP-CALL sig0 0 1)
    60 (gn-dot-at? M (+ p 60) OP-LGET 1 13 0)
    61 (gn-dot-at? M (+ p 61) OP-BIN 1 0 0)
    62 (gn-dot-at? M (+ p 62) OP-CALL mask 0 1)
    63 (gn-dot-at? M (+ p 63) OP-LSET 15 0 0)
    64 (gn-dot-at? M (+ p 64) OP-LGET 0 1 0)
    65 (gn-dot-at? M (+ p 65) OP-LGET 1 2 0)
    66 (gn-dot-at? M (+ p 66) OP-LGET 2 3 0)
    67 (gn-dot-at? M (+ p 67) OP-CONST 3 1 0)
    68 (gn-dot-at? M (+ p 68) OP-BIN 1 2 0)
    69 (gn-dot-at? M (+ p 69) OP-LGET 3 14 0)
    70 (gn-dot-at? M (+ p 70) OP-LGET 4 15 0)
    71 (gn-dot-at? M (+ p 71) OP-BIN 1 3 0)
    72 (gn-dot-at? M (+ p 72) OP-CALL mask 3 1)
    73 (gn-dot-at? M (+ p 73) OP-LGET 4 4 0)
    74 (gn-dot-at? M (+ p 74) OP-LGET 5 5 0)
    75 (gn-dot-at? M (+ p 75) OP-LGET 6 6 0)
    76 (gn-dot-at? M (+ p 76) OP-LGET 7 7 0)
    77 (gn-dot-at? M (+ p 77) OP-LGET 8 14 0)
    78 (gn-dot-at? M (+ p 78) OP-BIN 1 7 0)
    79 (gn-dot-at? M (+ p 79) OP-CALL mask 7 1)
    80 (gn-dot-at? M (+ p 80) OP-LGET 8 8 0)
    81 (gn-dot-at? M (+ p 81) OP-LGET 9 9 0)
    82 (gn-dot-at? M (+ p 82) OP-LGET 10 10 0)
    83 (gn-dot-at? M (+ p 83) OP-LSET 1 0 0)
    84 (gn-dot-at? M (+ p 84) OP-LSET 2 1 0)
    85 (gn-dot-at? M (+ p 85) OP-LSET 3 2 0)
    86 (gn-dot-at? M (+ p 86) OP-LSET 4 3 0)
    87 (gn-dot-at? M (+ p 87) OP-LSET 5 4 0)
    88 (gn-dot-at? M (+ p 88) OP-LSET 6 5 0)
    89 (gn-dot-at? M (+ p 89) OP-LSET 7 6 0)
    90 (gn-dot-at? M (+ p 90) OP-LSET 8 7 0)
    91 (gn-dot-at? M (+ p 91) OP-LSET 9 8 0)
    92 (gn-dot-at? M (+ p 92) OP-LSET 10 9 0)
    93 (gn-dot-at? M (+ p 93) OP-LSET 11 10 0)
    94 (gn-dot-at? M (+ p 94) OP-FUEL 0 0 0)
    95 (gn-dot-at? M (+ p 95) OP-BR head 0 0)
    96 (gn-dot-at? M (+ p 96) OP-LABEL exit 0 0)
    97 (gn-dot-at? M (+ p 97) OP-RET 0 0 0)
    98 (gn-dot-at? M (+ p 98) OP-END f 0 0)
    false) (shloop-shape M p f (inc k))))))
(defn- shloop-sigma [M :vector-i64 f :i64] :bool
 (let [end (sc-admit M (gn-fnf M f FF-SIR) f 1) p (gn-fnf M f FF-SIR)]
  (and (> end 0) (= (gn-fnf M f FF-DEPTH) 3)
       (= (rr-calls M (+ p 2) end 0) 3)
       (= (sc-charge-count M (+ p 2) end 1) 4))))
(defn- shloop-unique [M :vector-i64 s :i64 k :i64] :bool
 (or (= k s) (and (not= (gn-sreg M k) (gn-sreg M s)) (shloop-unique M s (inc k)))))
(defn- shloop-regs [M :vector-i64 s :i64] :bool
 (if (= s 11) (and (= (gn-sreg M 11) -1) (= (gn-sreg M 12) -1)
  (= (gn-sreg M 13) -1) (= (gn-sreg M 14) -1) (= (gn-sreg M 15) -1))
  (and (>= (gn-sreg M s) 19) (<= (gn-sreg M s) 28)
   (shloop-unique M s 1) (shloop-regs M (inc s)))))
(defn- shloop-admit [M :vector-i64 i :i64] :i64
 (if (or (<= i 1) (>= (+ i 97) (vector-at M MM-SIR-N))
         (not= (gn-op M (dec i)) OP-FN)) 0
  (let [p (dec i) f (gn-sir M p IF-A)]
   (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
    (let [n (gn-sir M (+ p 4) IF-B) off (gn-sir M (+ p 49) IF-B)
          s0 (gn-sir M (+ p 59) IF-A) s1 (gn-sir M (+ p 42) IF-A)]
     (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 11)
       (= (gn-fnf M f FF-NSLOTS) 15) (= (gn-fnf M f FF-DEPTH) 11)
       (= (gn-fnf M f FF-RTYPE) TY-VEC)
       (loop [k 0] (or (= k 11) (and (= (ck-pt M f k) (if (< k 2) TY-VEC TY-I64)) (recur (inc k)))))
       (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (<= (gn-g M gn-f-vmode) 0)
       (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-ctx) 1)
       (>= n 1) (<= n 4096) (>= off 0) (<= off 4095)
       (> s0 0) (< s0 (vector-at M MM-FN-N)) (> s1 0) (< s1 (vector-at M MM-FN-N))
       (shloop-shape M p f 0) (shloop-regs M 1) (shloop-sigma M s0) (shloop-sigma M s1)
       (= (gn-scalar-mask M (+ p 56) (gn-sir M (+ p 56) IF-A) 1) 32)) n 0))))))
(defn- shloop-get [M :vector-i64 d :i64 s :i64] :vector-i64
 (if (>= (gn-sreg M s) 0) (gn-mov M d (gn-sreg M s)) (gn-ld M d s)))
(defn- shloop-put [M :vector-i64 d :i64 s :i64] :vector-i64
 (if (>= (gn-sreg M s) 0) (gn-mov M (gn-sreg M s) d) (gn-st M d s)))
(defn- shloop-scalar [M :vector-i64 f :i64 s :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1)]
  (-> M (shloop-get 9 s) (gn-emit (+ (enc-orr-r 10 9 9) 32768))
       (rr-emit (+ p 2) (dec end)))))
(defn- shloop-body [M :vector-i64 p :i64] :vector-i64
 (let [i (gn-sreg M 3) off (gn-sir M (+ p 49) IF-B)]
  (-> M
   (shloop-get 9 8) (shloop-get 10 9) (gn-emit (enc-and-r 9 9 10))
   (shloop-get 10 8) (gn-emit (enc-mvn 10 10)) (shloop-get 11 10)
   (gn-emit (enc-and-r 10 10 11)) (gn-emit (enc-eor-r 9 9 10)) (gn-st 9 12)
   (shloop-get 9 4) (shloop-get 10 5) (gn-emit (enc-and-r 9 9 10))
   (shloop-get 10 4) (shloop-get 11 6) (gn-emit (enc-and-r 10 10 11))
   (gn-emit (enc-eor-r 9 9 10)) (shloop-get 10 5) (shloop-get 11 6)
   (gn-emit (enc-and-r 10 10 11)) (gn-emit (enc-eor-r 9 9 10)) (gn-st 9 13)
   (shloop-scalar (gn-sir M (+ p 42) IF-A) 8)
   (shloop-get 9 11) (gn-emit (enc-add-r 0 0 9))
   (gn-emit (gn-e-ldrr 1 3 i 1)) (gn-emit (enc-add-i 9 i off))
   (gn-emit (gn-e-ldrr 2 4 9 1)) (gn-emit (enc-add-r 1 1 2))
   (gn-ld 2 12) (gn-emit (enc-add-r 1 1 2)) (gn-emit (enc-add-r 0 0 1))
   (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (gn-st 0 14)
   (shloop-scalar (gn-sir M (+ p 59) IF-A) 4) (gn-ld 1 13)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (gn-st 0 15)
   ;; Capture t1/t2 before updates; descending carry order preserves all inputs.
   (shloop-get 0 10) (shloop-put 0 11) (shloop-get 0 9) (shloop-put 0 10)
   (shloop-get 0 8) (shloop-put 0 9) (shloop-get 0 7) (gn-ld 1 14)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (shloop-put 0 8)
   (shloop-get 0 6) (shloop-put 0 7) (shloop-get 0 5) (shloop-put 0 6)
   (shloop-get 0 4) (shloop-put 0 5) (gn-ld 0 14) (gn-ld 1 15)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (shloop-put 0 4)
   (gn-emit (enc-add-i i i 1)))))
(defn- shloop-entry [M :vector-i64 i :i64] :vector-i64
 (let [n (shloop-admit M i)]
  (if (= n 0) M
   (let [p (dec i) ri (gn-sreg M 3) off (gn-sir M (+ p 49) IF-B)
         rv (gn-sreg M 1) rk (gn-sreg M 2) top (+ n off)
         m0 (-> M (gn-mov-imm 9 n) (gn-emit (enc-cmp-r ri 9))) b0 (vector-at m0 MM-CODE-N)
         m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-emit (enc-sub-r 9 9 ri)) (gn-mov-imm 10 9) (gn-emit (enc-mul 9 9 10))
          (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9))) b1 (vector-at m1 MM-CODE-N)
         m2 (-> m1 (gn-emit (enc-bcond (enc-cond-lo) 0))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
          (gn-emit (enc-sub-i 17 rk 1)) (gn-emit (enc-cmp-r 17 16))) b2 (vector-at m2 MM-CODE-N)
         m3 (-> m2 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
          (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
          (gn-emit (enc-cmp-r 0 16))) b3 (vector-at m3 MM-CODE-N)
         m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-mov-imm 16 n) (gn-emit (enc-cmp-r 0 16))) b4 (vector-at m4 MM-CODE-N)
         m5 (-> m4 (gn-emit (enc-bcond (enc-cond-lo) 0))
          (gn-emit (enc-ldr 3 7 328)) (gn-emit (gn-e-addsl 3 3 17 3))
          (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
          (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b5 (vector-at m5 MM-CODE-N)
         m6 (-> m5 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
          (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
          (gn-emit (enc-cmp-r 0 16))) b6 (vector-at m6 MM-CODE-N)
         m7 (-> m6 (gn-emit (enc-bcond (enc-cond-hs) 0))
          (gn-mov-imm 16 top) (gn-emit (enc-cmp-r 0 16))) b7 (vector-at m7 MM-CODE-N)
         m8 (-> m7 (gn-emit (enc-bcond (enc-cond-lo) 0))
          (gn-emit (enc-ldr 4 7 328)) (gn-emit (gn-e-addsl 4 4 17 3))
          (gn-emit (enc-sub-r 8 8 9)) (gn-emit (enc-str 8 7 CTX-FUEL))
          (shloop32-path p n ri)) loop-at (vector-at m8 MM-CODE-N)
         m9 (-> m8 (shloop-body p) (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16))) back (vector-at m9 MM-CODE-N)
         m10 (-> m9 (gn-emit (enc-bcond (enc-cond-ne) (- loop-at back)))
          (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0))) end (vector-at m10 MM-CODE-N)]
    (-> m10 (gn-dot-patch b0 end (enc-cond-hs)) (gn-dot-patch b1 end (enc-cond-lo))
      (gn-dot-patch b2 end (enc-cond-hs)) (gn-dot-patch b3 end (enc-cond-hs))
      (gn-dot-patch b4 end (enc-cond-lo)) (gn-dot-patch b5 end (enc-cond-hs))
      (gn-dot-patch b6 end (enc-cond-hs)) (gn-dot-patch b7 end (enc-cond-lo)))))))

(defn- shloop32-emit [M :vector-i64 j :i64 end :i64] :vector-i64
 (if (= j end) M
  (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B)]
   (shloop32-emit
    (case op
     OP-LABEL M
     OP-LGET (gn-mov M a (+ 8 b))
     OP-CONST (gn-mov-imm M a b)
     OP-BIN (gn-emit M (gn-bin-word a b b (inc b)))
     OP-UN (gn-emit M (enc-mvn b b))
     OP-CALL (gn-emit M (+ (enc-rrr 0x13800000 b 9 9)
                         (* (bit-and (gn-sir M (dec j) IF-B) 31) 1024)))
     OP-RET (gn-emit M (enc-ret))
     (gn-err M E-GEN-OP op)) (inc j) end))))
(defn- shloop32-scalar [M :vector-i64 f :i64 s :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1)]
  (shloop32-emit (shloop-get M 9 s) (+ p 2) (dec end))))
(defn- shloop32-body [M :vector-i64 p :i64] :vector-i64
 (let [i (gn-sreg M 3) off (gn-sir M (+ p 49) IF-B)]
  (-> M
   (shloop-get 9 8) (shloop-get 10 9) (gn-emit (enc-and-r 9 9 10))
   (shloop-get 10 8) (gn-emit (enc-mvn 10 10)) (shloop-get 11 10)
   (gn-emit (enc-and-r 10 10 11)) (gn-emit (enc-eor-r 9 9 10)) (gn-st 9 12)
   (shloop-get 9 4) (shloop-get 10 5) (gn-emit (enc-and-r 9 9 10))
   (shloop-get 10 4) (shloop-get 11 6) (gn-emit (enc-and-r 10 10 11))
   (gn-emit (enc-eor-r 9 9 10)) (shloop-get 10 5) (shloop-get 11 6)
   (gn-emit (enc-and-r 10 10 11)) (gn-emit (enc-eor-r 9 9 10)) (gn-st 9 13)
   (shloop32-scalar (gn-sir M (+ p 42) IF-A) 8)
   (shloop-get 9 11) (gn-emit (enc-add-r 0 0 9))
   (gn-emit (gn-e-ldrr 1 3 i 1)) (gn-emit (enc-add-i 9 i off))
   (gn-emit (gn-e-ldrr 2 4 9 1)) (gn-emit (enc-add-r 1 1 2))
   (gn-ld 2 12) (gn-emit (enc-add-r 1 1 2)) (gn-emit (enc-add-r 0 0 1))
   (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (gn-st 0 14)
   (shloop32-scalar (gn-sir M (+ p 59) IF-A) 4) (gn-ld 1 13)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (gn-st 0 15)
   ;; Capture t1/t2 before updates; descending carry order preserves all inputs.
   (shloop-get 0 10) (shloop-put 0 11) (shloop-get 0 9) (shloop-put 0 10)
   (shloop-get 0 8) (shloop-put 0 9) (shloop-get 0 7) (gn-ld 1 14)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (shloop-put 0 8)
   (shloop-get 0 6) (shloop-put 0 7) (shloop-get 0 5) (shloop-put 0 6)
   (shloop-get 0 4) (shloop-put 0 5) (gn-ld 0 14) (gn-ld 1 15)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (gn-e-bf 0xd3400000 0 0 0 31)) (shloop-put 0 4)
   (gn-emit (enc-add-i i i 1)))))
(defn- sphase-counts [M :vector-i64] :bool
 (and (> (vector-at M MM-SIR-N) 0) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
      (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)
      (> (vector-at M MM-LABEL-N) 0) (< (vector-at M MM-LABEL-N) MM-LABEL-CAP)))
(defn- sphase-end [M :vector-i64 j :i64 f :i64 work :i64] :i64
 (if (or (<= work 0) (< j 0) (>= j (vector-at M MM-SIR-N))) 0
  (let [op (gn-op M j)]
   (cond (= op OP-END) (if (gn-dot-at? M j OP-END f 0 0) j 0)
         (= op OP-FN) 0
         :else (sphase-end M (inc j) f (dec work))))))
(defn- sphase-fn [M :vector-i64 f :i64] :i64
 (if (or (not (sphase-counts M)) (<= f 0) (>= f MM-FN-CAP)
         (>= f (vector-at M MM-FN-N))) 0
  (let [p (gn-fnf M f FF-SIR) np (gn-fnf M f FF-NPARAMS)]
   (if (or (<= p 0) (>= p (vector-at M MM-SIR-N))
           (>= (+ p 64) (vector-at M MM-SIR-N))
           (< np 1) (> np 2) (not= (gn-fnf M f FF-NSLOTS) np)
           (< (gn-fnf M f FF-DEPTH) 1) (> (gn-fnf M f FF-DEPTH) 5)
           (not= (gn-fnf M f FF-RTYPE) TY-I64)
           (not (gn-dot-at? M p OP-FN f np np))) 0
    (let [end (sphase-end M (inc p) f 64)]
     (if (and (> end p) (sr-types M f np) (not (gn-clamp-open M f))) end 0))))))
(defn- sphase-tree [M :vector-i64 f :i64 depth :i64] :bool
 (if (<= depth 0) false
  (let [end (sphase-fn M f)]
   (if (= end 0) false
    (let [p (gn-fnf M f FF-SIR) dp (gn-fnf M f FF-DEPTH)]
     (loop [j (inc p)]
      (if (= j end) true
       (let [op (gn-op M j) a (gn-sir M j IF-A) b (gn-sir M j IF-B) c (gn-sir M j IF-C)]
        (and (case op
         OP-FUEL (and (= j (inc p)) (= a 0) (= b 0) (= c 0))
         OP-LABEL (and (= j (+ p (if (= (gn-op M (inc p)) OP-FUEL) 2 1)))
                       (> a 0) (< a (vector-at M MM-LABEL-N)) (= b 0) (= c 0))
         OP-LGET (and (>= a 0) (< a dp) (> b 0) (<= b (gn-fnf M f FF-NPARAMS)) (= c 0))
         OP-CONST (and (>= a 0) (< a dp) (= c 0))
         OP-BIN (and (di-bin a) (not= a BOP-QUOT) (>= b 0) (< (inc b) dp) (= c 0))
         OP-UN (and (= a UOP-BITNOT) (>= b 0) (< b dp) (= c 0))
         OP-CALL (and (>= b 0) (> c 0) (<= c 2) (<= (+ b c) dp)
                      (> (sphase-fn M a) 0) (= (gn-fnf M a FF-NPARAMS) c)
                      (sphase-tree M a (dec depth)))
         OP-RET (and (= j (dec end)) (= a 0) (= b 0) (= c 0))
         false) (recur (inc j)))))))))))
(defn- sphase-admit [M :vector-i64 p :i64 n :i64 ri :i64] :bool
 (if (or (not (sphase-counts M)) (<= p 0) (>= (+ p 98) (vector-at M MM-SIR-N))
         (not= (gn-op M p) OP-FN) (< n 4) (> n 4096)
         (< (vector-at M MM-CODE-N) 0) (> (vector-at M MM-CODE-N) (- MM-CODE-CAP 4096))
         (< (vector-at M MM-FIX-N) 0) (> (vector-at M MM-FIX-N) (- MM-FIX-CAP 2))) false
  (let [f (gn-sir M p IF-A)]
   (if (or (<= f 0) (>= f MM-FN-CAP) (>= f (vector-at M MM-FN-N))) false
    (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 11)
     (= (gn-fnf M f FF-NSLOTS) 15) (= (gn-fnf M f FF-DEPTH) 11)
     (= (gn-fnf M f FF-RTYPE) TY-VEC)
     (loop [k 0] (or (= k 11) (and (= (ck-pt M f k) (if (< k 2) TY-VEC TY-I64)) (recur (inc k)))))
     (= n (gn-sir M (+ p 4) IF-B)) (= ri (gn-sreg M 3))
     (shloop-regs M 1)
     (sphase-tree M (gn-sir M (+ p 42) IF-A) 4)
     (sphase-tree M (gn-sir M (+ p 59) IF-A) 4)
     (sphase-tree M (gn-sir M (+ p 56) IF-A) 4)
     (sphase-tree M (gn-sir M (+ p 72) IF-A) 4)
     (sphase-tree M (gn-sir M (+ p 79) IF-A) 4)
     (let [h (gn-sir M (+ p 2) IF-A) b (gn-sir M (+ p 18) IF-A) e (gn-sir M (+ p 96) IF-A)]
      (and (> h 0) (< h (vector-at M MM-LABEL-N))
           (> b 0) (< b (vector-at M MM-LABEL-N))
           (> e 0) (< e (vector-at M MM-LABEL-N))
           (not= h b) (not= h e) (not= b e)))
     (shloop-shape M p f 0)
     (shloop-sigma M (gn-sir M (+ p 42) IF-A))
     (shloop-sigma M (gn-sir M (+ p 59) IF-A)))))))
(defn- sphase-reg [M :vector-i64 s :i64 phase :i64] :i64
 (let [base (if (< s 8) 4 8) slot (+ base (bit-and (- (- s base) phase) 3))]
  (if (= slot 11) 5 (gn-sreg M slot))))
(defn- foldror-mask [M :vector-i64 f :i64] :bool
 (let [end (sphase-fn M f)]
  (if (= end 0) false
   (let [p (gn-fnf M f FF-SIR) label (gn-sir M (inc p) IF-A)]
    (and (= end (+ p 6)) (= (gn-fnf M f FF-NPARAMS) 1)
     (= (gn-fnf M f FF-DEPTH) 2) (> label 0) (< label (vector-at M MM-LABEL-N))
     (gn-dot-at? M p OP-FN f 1 1) (gn-dot-at? M (inc p) OP-LABEL label 0 0)
     (gn-dot-at? M (+ p 2) OP-LGET 0 1 0)
     (gn-dot-at? M (+ p 3) OP-CONST 1 4294967295 0)
     (gn-dot-at? M (+ p 4) OP-BIN BOP-AND 0 0)
     (gn-dot-at? M (+ p 5) OP-RET 0 0 0))))))
(defn- foldror-leaf [M :vector-i64 f :i64] :bool
 (let [end (sphase-fn M f)]
  (if (= end 0) false
   (let [p (gn-fnf M f FF-SIR)]
    (if (not= end (+ p 14)) false
     (let [label (gn-sir M (+ p 2) IF-A) mask (gn-sir M (+ p 12) IF-A)]
      (and (= (gn-fnf M f FF-NPARAMS) 2) (= (gn-fnf M f FF-DEPTH) 4)
       (> label 0) (< label (vector-at M MM-LABEL-N)) (foldror-mask M mask)
       (gn-dot-at? M p OP-FN f 2 2) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL label 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0)
       (gn-dot-at? M (+ p 5) OP-BIN BOP-USHR 0 0)
       (gn-dot-at? M (+ p 6) OP-LGET 1 1 0) (gn-dot-at? M (+ p 7) OP-CONST 2 32 0)
       (gn-dot-at? M (+ p 8) OP-LGET 3 2 0) (gn-dot-at? M (+ p 9) OP-BIN BOP-SUB 2 0)
       (gn-dot-at? M (+ p 10) OP-BIN BOP-SHL 1 0) (gn-dot-at? M (+ p 11) OP-BIN BOP-OR 0 0)
       (gn-dot-at? M (+ p 12) OP-CALL mask 0 1) (gn-dot-at? M (+ p 13) OP-RET 0 0 0))))))))
(defn- foldror-tree [M :vector-i64 f :i64] :bool
 (let [end (sphase-fn M f)]
  (if (= end 0) false
   (let [p (gn-fnf M f FF-SIR)]
    (if (not= end (+ p 15)) false
     (let [label (gn-sir M (+ p 2) IF-A)
           n0 (gn-sir M (+ p 4) IF-B) n1 (gn-sir M (+ p 7) IF-B) n2 (gn-sir M (+ p 11) IF-B)
           r0 (gn-sir M (+ p 5) IF-A) r1 (gn-sir M (+ p 8) IF-A) r2 (gn-sir M (+ p 12) IF-A)]
      (and (= (gn-fnf M f FF-NPARAMS) 1) (= (gn-fnf M f FF-DEPTH) 3)
       (> label 0) (< label (vector-at M MM-LABEL-N))
       (>= n0 0) (<= n0 32) (>= n1 0) (<= n1 32) (>= n2 0) (<= n2 32)
       (foldror-leaf M r0) (foldror-leaf M r1) (foldror-leaf M r2)
       (gn-dot-at? M p OP-FN f 1 1) (gn-dot-at? M (inc p) OP-FUEL 0 0 0)
       (gn-dot-at? M (+ p 2) OP-LABEL label 0 0)
       (gn-dot-at? M (+ p 3) OP-LGET 0 1 0) (gn-dot-at? M (+ p 4) OP-CONST 1 n0 0)
       (gn-dot-at? M (+ p 5) OP-CALL r0 0 2)
       (gn-dot-at? M (+ p 6) OP-LGET 1 1 0) (gn-dot-at? M (+ p 7) OP-CONST 2 n1 0)
       (gn-dot-at? M (+ p 8) OP-CALL r1 1 2) (gn-dot-at? M (+ p 9) OP-BIN BOP-XOR 0 0)
       (gn-dot-at? M (+ p 10) OP-LGET 1 1 0) (gn-dot-at? M (+ p 11) OP-CONST 2 n2 0)
       (gn-dot-at? M (+ p 12) OP-CALL r2 1 2) (gn-dot-at? M (+ p 13) OP-BIN BOP-XOR 0 0)
       (gn-dot-at? M (+ p 14) OP-RET 0 0 0))))))))
(defn- foldror-emit [M :vector-i64 f :i64 r :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) n0 (bit-and (gn-sir M (+ p 4) IF-B) 31)
       n1 (bit-and (gn-sir M (+ p 7) IF-B) 31) n2 (bit-and (gn-sir M (+ p 11) IF-B) 31)]
  (-> M (gn-emit (+ (enc-rrr 0x13800000 0 r r) (* n0 1024)))
   (gn-emit (+ (enc-rrr 0x4ac00000 0 0 r) (* n1 1024)))
   (gn-emit (+ (enc-rrr 0x4ac00000 0 0 r) (* n2 1024))))))
(defn- sphase-scalar [M :vector-i64 f :i64 r :i64] :vector-i64
 (if (and (or (= r 5) (and (>= r 19) (<= r 28))) (foldror-tree M f))
  (foldror-emit M f r)
  (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1)]
   (shloop32-emit (gn-mov M 9 r) (+ p 2) (dec end)))))
(defn- sphase-body [M :vector-i64 p :i64 phase :i64] :vector-i64
 (let [a (sphase-reg M 4 phase) b (sphase-reg M 5 phase)
       c (sphase-reg M 6 phase) d (sphase-reg M 7 phase)
       e (sphase-reg M 8 phase) f (sphase-reg M 9 phase)
       g (sphase-reg M 10 phase) h (sphase-reg M 11 phase)
       i (gn-sreg M 3) off (gn-sir M (+ p 49) IF-B)]
  (-> M
   (gn-emit (enc-and-r 6 e f)) (gn-emit (enc-rrr 0x8a200000 9 g e))
   (gn-emit (enc-eor-r 6 6 9))
   (gn-emit (enc-and-r 12 a b)) (gn-emit (enc-eor-r 9 a b))
   (gn-emit (enc-and-r 9 9 c))
   (gn-emit (enc-eor-r 12 12 9))
   (sphase-scalar (gn-sir M (+ p 42) IF-A) e)
   (gn-emit (enc-add-r 0 0 h))
   (gn-emit (gn-e-ldrr 1 3 i 1)) (gn-emit (enc-add-i 9 i off))
   (gn-emit (gn-e-ldrr 2 4 9 1)) (gn-emit (enc-add-r 1 1 2))
   (gn-emit (enc-add-r 1 1 6)) (gn-emit (enc-add-r 0 0 1))
   (gn-emit (gn-e-bf 0xd3400000 13 0 0 31))
   ;; Old h dies after t1; old d dies only after computing new e.
   (gn-emit (enc-add-r 0 d 13)) (gn-emit (gn-e-bf 0xd3400000 h 0 0 31))
   (sphase-scalar (gn-sir M (+ p 59) IF-A) a)
   (gn-emit (enc-rrr 0x0b000000 0 0 12))
   (gn-emit (enc-add-r 0 0 13)) (gn-emit (gn-e-bf 0xd3400000 d 0 0 31))
   (gn-emit (enc-add-i i i 1)))))
(defn- sphase-away [M :vector-i64 base :i64 key :bool G :vector-i64 k :i64] :vector-i64
 (let [m0 (-> M (gn-mov 9 base) (gn-emit (enc-cmp-r 9 base)))
       g0 (vector-assoc! G k (vector-at m0 MM-CODE-N))
       limit (gn-emit m0 (enc-bcond (enc-cond-lo) 0))
       ;; Full issued key backing <=128Mi i64 items. This address-only
       ;; envelope excludes spill aliases outside the current read interval.
       m1 (-> (if key (gn-mov-imm limit 16 134217728) (gn-mov limit 16 0))
          (gn-emit (gn-e-addsl 10 base 16 3)) (gn-emit (enc-cmp-r 10 9)))
       g1 (vector-assoc! g0 (inc k) (vector-at m1 MM-CODE-N))
       m2 (-> m1 (gn-emit (enc-bcond 9 0)) (gn-emit (enc-add-i 16 31 0))
          (gn-emit (enc-cmp-r 10 16)) (gn-emit (enc-bcond 9 4))
          (gn-emit (enc-add-i 11 29 48)) (gn-emit (enc-cmp-r 9 11)))
       g2 (vector-assoc! g1 (+ k 2) (vector-at m2 MM-CODE-N))]
  (gn-emit m2 (enc-bcond (enc-cond-lo) 0))))
(defn- sphase-away-patch [M :vector-i64 G :vector-i64 k :i64 end :i64] :vector-i64
 (if (= k 6) M
  (sphase-away-patch (gn-dot-patch M (vector-at G k) end (if (= (rem k 3) 1) 9 (enc-cond-lo))) G (inc k) end)))
(defn- sphase-path [M :vector-i64 p :i64 n :i64 ri :i64] :vector-i64
 (let [m0 (shloop-get M 9 4)
       m1 (loop [v m0 s 5] (if (= s 12) v
            (recur (-> v (shloop-get 10 s) (gn-emit (enc-orr-r 9 9 10))) (inc s))))
       m2 (-> m1 (gn-emit (gn-e-bf 0xd3400000 9 9 32 63)) (gn-emit (enc-cmp-i 9 0)))
       no32 (vector-at m2 MM-CODE-N) m3 (gn-emit m2 (enc-bcond (enc-cond-ne) 0))
       ;; x0 still holds the v descriptor length from original m7 preflight.
       ;; Exclude its whole backing: terminal finish may read beyond schedule.
       G (vector-alloc 6) ranges (-> m3 (sphase-away 3 true G 0)
                         (sphase-away 4 false G 3))
       fast (sphase2-ok? M p n) hw (and fast kb-sha-hw (sphase-hw? M p))
       m4 (cond-> (gn-ld ranges 5 11) fast (sphase2-init p ri) hw (sphase-hw-state true)) chunk (vector-at m4 MM-CODE-N)
       ;; fast: 0 <= i < n here, so n - i >= 4 iff i <= n - 4 (signed)
       m5 (if fast (gn-emit m4 (enc-cmp-i ri (- n 4)))
           (-> m4 (gn-mov-imm 16 n) (gn-emit (enc-sub-r 16 16 ri)) (gn-emit (enc-cmp-i 16 4))))
       tail (vector-at m5 MM-CODE-N) m6 (gn-emit m5 (enc-bcond (if fast (enc-cond-gt) (enc-cond-lo)) 0))
       m7 (cond hw (-> m6 (gn-emit 0xACC10DC2) (gn-emit 0xACC115E4) (gn-emit 0x4E831842) (gn-emit 0x4E851884)
                     (gn-emit 0x4EA48442) (gn-emit 0x4EA01C06) (gn-emit 0x5E024020) (gn-emit 0x5E0250C1)
                     (gn-emit (enc-add-i ri ri 4)))
                fast (-> m6 (sphase2-body p 0) (sphase2-body p 1) (sphase2-body p 2) (sphase2-body p 3)
                    (gn-emit (enc-add-i 14 14 32)) (gn-emit (enc-add-i 15 15 32)) (gn-emit (enc-add-i ri ri 4)))
           :else (-> m6 (sphase-body p 0) (sphase-body p 1) (sphase-body p 2) (sphase-body p 3)))
       back (vector-at m7 MM-CODE-N) m8 (gn-emit m7 (enc-b (- chunk back)))
       tail-at (vector-at m8 MM-CODE-N)
       sync (gn-st (cond-> m8 hw (sphase-hw-state false)) 5 11) original-at (vector-at sync MM-CODE-N)
       m9 (-> sync (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16)))
       done (vector-at m9 MM-CODE-N) m10 (gn-emit m9 (enc-bcond (enc-cond-eq) 0))
       rest (vector-at m10 MM-CODE-N)
       m11 (-> m10 (shloop32-body p) (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16)))
       again (vector-at m11 MM-CODE-N)
       m12 (gn-emit m11 (enc-bcond (enc-cond-ne) (- rest again)))
       done-at (vector-at m12 MM-CODE-N)
       m13 (-> m12 (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)))
       end (vector-at m13 MM-CODE-N)]
  (-> m13 (sphase-away-patch G 0 original-at) (gn-dot-patch no32 end (enc-cond-ne))
      (gn-dot-patch tail tail-at (if fast (enc-cond-gt) (enc-cond-lo))) (gn-dot-patch done done-at (enc-cond-eq)))))
;; kb-sha-hw: the SHA-256 crypto-instruction paths (sha256h / h2 rounds, sha256su0 / su1 schedule). Off for the
;; same-algorithm round (the crypto decision is open); the scalar rounds (sphase2-body) and the carried-pair schedule
;; (srx-carry-body) run instead. true turns them back on.
(def kb-sha-hw false)
;; ror on the low 32 bits (extr w)
(defn- srx-ror32 [d :i64 n :i64 s :i64] :i64 (+ (enc-rrr 0x13800000 d n n) (* (bit-and s 31) 1024)))
;; one scalar round of the four-round chunk (see sphase2-ok? below): Sigma1 / Sigma0 as three ror32 each, ch, maj from
;; the carried a ^ b, k + w by ldp pairs from x14 / x15
(defn- sphase2-body [M :vector-i64 p :i64 phase :i64] :vector-i64
 (let [a (sphase-reg M 4 phase) b (sphase-reg M 5 phase)
       c (sphase-reg M 6 phase) d (sphase-reg M 7 phase)
       e (sphase-reg M 8 phase) f (sphase-reg M 9 phase)
       g (sphase-reg M 10 phase) h (sphase-reg M 11 phase)
       s1 (gn-sir M (+ p 42) IF-A) s0 (gn-sir M (+ p 59) IF-A)
       even (= (bit-and phase 1) 0) yo (if even 9 17) yn (if even 17 9)
       m0 (-> M (gn-emit (srx-ror32 0 e (sphase2-rot M s1 0))) (gn-emit (srx-ror32 12 e (sphase2-rot M s1 1)))
           (gn-emit (srx-ror32 13 e (sphase2-rot M s1 2)))
           (gn-emit (enc-and-r 6 e f)) (gn-emit (enc-rrr 0x8a200000 16 g e))
           (gn-emit (enc-rrr 0x4a000000 0 0 12)) (gn-emit (enc-eor-r 6 6 16)) (gn-emit (enc-rrr 0x4a000000 0 0 13)))
       m1 (if even (-> m0 (gn-emit (enc-ldp 1 10 14 (* 8 phase))) (gn-emit (enc-ldp 2 11 15 (* 8 phase)))
                    (gn-emit (enc-add-r 1 1 2)))
           (gn-emit m0 (enc-add-r 1 10 11)))]
  (-> m1 (gn-emit (enc-add-r 1 1 h)) (gn-emit (enc-add-r 2 1 d))
   (gn-emit (enc-add-r 1 1 6)) (gn-emit (enc-add-r 2 2 6))
   ;; old h dies in h + k + w, old d in the e' sum: e' into h's register, a' into d's
   (gn-emit (enc-rrr 0x0b000000 h 2 0)) (gn-emit (enc-rrr 0x0b000000 13 1 0))
   (gn-emit (enc-and-r 2 b c)) (gn-emit (enc-and-r 12 a yo)) (gn-emit (enc-eor-r yn a b))
   (gn-emit (enc-eor-r 12 12 2)) (gn-emit (enc-add-r 12 12 13))
   (gn-emit (srx-ror32 0 a (sphase2-rot M s0 0))) (gn-emit (srx-ror32 6 a (sphase2-rot M s0 1)))
   (gn-emit (srx-ror32 16 a (sphase2-rot M s0 2)))
   (gn-emit (enc-rrr 0x4a000000 0 0 6)) (gn-emit (enc-rrr 0x4a000000 0 0 16))
   (gn-emit (enc-rrr 0x0b000000 d 12 0)))))
;; SHA-256 rounds on the crypto unit (kernels B): with the shape certified above, the operands below 2^32 (no32) and
;; the big sigmas the standard rotation trees (6 11 25 and 2 13 22), each round is the FIPS 180-4 round on 32-bit words
;; with w + k taken mod 2^32 (only low words matter): sha256h / sha256h2 do four rounds on v0 = {a b c d} and
;; v1 = {e f g h} with k[i..i+3] + w[i..i+3] (uzp1 low words, x14/x15 post-incremented); the state moves into v0/v1
;; before the chunk loop and back (zero-extended) at its exit.
(defn- sphase-hw? [M :vector-i64 p :i64] :bool
 (let [s1 (gn-sir M (+ p 42) IF-A) s0 (gn-sir M (+ p 59) IF-A)]
  (and (= (sphase2-rot M s1 0) 6) (= (sphase2-rot M s1 1) 11) (= (sphase2-rot M s1 2) 25)
       (= (sphase2-rot M s0 0) 2) (= (sphase2-rot M s0 1) 13) (= (sphase2-rot M s0 2) 22))))
(defn- sphase-hw-state [M :vector-i64 in :bool] :vector-i64
 (loop [cur M k 0] (if (= k 8) cur
  (let [r (sphase-reg M (+ 4 k) 0) q (quot k 4) l (rem k 4)]
   (recur (gn-emit cur (cond (not in) (+ (case l 0 0x0E043C00 1 0x0E0C3C00 2 0x0E143C00 0x0E1C3C00) (* q 32) r)
                             (= l 0) (+ 0x1E270000 (* r 32) q)
                             :else (+ (case l 1 0x4E0C1C00 2 0x4E141C00 0x4E1C1C00) (* r 32) q))) (inc k))))))
;; ---- four-round chunk without stack or index traffic -------------------------------------------------------------------
;; Both big sigmas are certified rotate trees (they write x0 only). x14 = &k[i] and x15 = &v[i + off] advance by 32 per
;; chunk and i by 4; ldp pairs feed rounds 2j and 2j+1 (x10/x11 hold the odd round's pair). maj = ((a^b)&(b^c))^b,
;; where b^c is the previous round's a^b, carried in x9/x17 (x9 at every chunk start). Sums are masked by 32-bit adds:
;; mask32(x + y) = (w(x) + w(y)) mod 2^32. Every value stays in the registers of the original rotation.
(defn- sphase2-ok? [M :vector-i64 p :i64 n :i64] :bool
 (and (>= n 4) (<= (- n 4) 4095) (<= (gn-sir M (+ p 49) IF-B) 4095)
      (foldror-tree M (gn-sir M (+ p 42) IF-A)) (foldror-tree M (gn-sir M (+ p 59) IF-A))))
(defn- sphase2-init [M :vector-i64 p :i64 ri :i64] :vector-i64
 (let [off8 (* 8 (gn-sir M (+ p 49) IF-B))
       m0 (-> M (gn-emit (gn-e-addsl 14 3 ri 3)) (gn-emit (gn-e-addsl 15 4 ri 3)))
       m1 (if (<= off8 4095) (gn-emit m0 (enc-add-i 15 15 off8))
           (-> m0 (gn-mov-imm 16 off8) (gn-emit (enc-add-r 15 15 16))))]
  (gn-emit m1 (enc-eor-r 9 (sphase-reg M 5 0) (sphase-reg M 6 0)))))
(defn- sphase2-rot [M :vector-i64 f :i64 k :i64] :i64
 (bit-and (gn-sir M (+ (gn-fnf M f FF-SIR) (case k 0 4 1 7 11)) IF-B) 31))
(defn- shloop32-path [M :vector-i64 p :i64 n :i64 ri :i64] :vector-i64
 (if (sphase-admit M p n ri) (sphase-path M p n ri)
 (let [m0 (shloop-get M 9 4)
       m1 (loop [v m0 s 5] (if (= s 12) v
            (recur (-> v (shloop-get 10 s) (gn-emit (enc-orr-r 9 9 10))) (inc s))))
       m2 (-> m1 (gn-emit (gn-e-bf 0xd3400000 9 9 32 63)) (gn-emit (enc-cmp-i 9 0)))
       no32 (vector-at m2 MM-CODE-N)
       m3 (gn-emit m2 (enc-bcond (enc-cond-ne) 0))
       start (vector-at m3 MM-CODE-N)
       m4 (-> m3 (shloop32-body p) (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16)))
       back (vector-at m4 MM-CODE-N)
       m5 (-> m4 (gn-emit (enc-bcond (enc-cond-ne) (- start back)))
             (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0)))
       end (vector-at m5 MM-CODE-N)]
  (gn-dot-patch m5 no32 end (enc-cond-ne)))))

(defn- rv-shape [M :vector-i64 p :i64 f :i64 fixed :i64 k :i64] :bool
 (if (= k 36) true (let [limit (gn-sir M (+ p 4) IF-B) base (gn-sir M (+ p 21) IF-B)
  reader (gn-sir M (+ p 19) IF-A)]
 (and (case k
  0 (gn-dot-at? M (+ p 0) 1 f 4 4)
  1 (gn-dot-at? M (+ p 1) 18 0 0 0)
  2 (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (gn-dot-at? M (+ p 3) 4 0 3 0)
  4 (if (= fixed 1) (gn-dot-at? M (+ p 4) OP-CONST 1 limit 0) (gn-dot-at? M (+ p 4) OP-LGET 1 2 0))
  5 (gn-dot-at? M (+ p 5) 7 1 0 0)
  6 (gn-dot-at? M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
  7 (gn-dot-at? M (+ p 7) 4 0 4 0)
  8 (gn-dot-at? M (+ p 8) 10 (gn-sir M (+ p 33) IF-A) 0 0)
  9 (gn-dot-at? M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
  10 (gn-dot-at? M (+ p 10) 4 0 1 0)
  11 (gn-dot-at? M (+ p 11) 4 1 2 0)
  12 (gn-dot-at? M (+ p 12) 4 2 3 0)
  13 (gn-dot-at? M (+ p 13) 3 3 1 0)
  14 (gn-dot-at? M (+ p 14) 6 1 2 0)
  15 (gn-dot-at? M (+ p 15) 4 3 4 0)
  16 (gn-dot-at? M (+ p 16) 4 4 1 0)
  17 (gn-dot-at? M (+ p 17) 4 5 2 0)
  18 (gn-dot-at? M (+ p 18) 4 6 3 0)
  19 (gn-dot-at? M (+ p 19) 13 reader 4 3)
  20 (gn-dot-at? M (+ p 20) 4 5 1 0)
  21 (gn-dot-at? M (+ p 21) 3 6 base 0)
  22 (gn-dot-at? M (+ p 22) 4 7 3 0)
  23 (gn-dot-at? M (+ p 23) 6 1 6 0)
  24 (gn-dot-at? M (+ p 24) 14 176 5 2)
  25 (gn-dot-at? M (+ p 25) 6 3 4 0)
  26 (gn-dot-at? M (+ p 26) 6 2 3 0)
  27 (gn-dot-at? M (+ p 27) 5 1 0 0)
  28 (gn-dot-at? M (+ p 28) 5 2 1 0)
  29 (gn-dot-at? M (+ p 29) 5 3 2 0)
  30 (gn-dot-at? M (+ p 30) 5 4 3 0)
  31 (gn-dot-at? M (+ p 31) 18 0 0 0)
  32 (gn-dot-at? M (+ p 32) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  33 (gn-dot-at? M (+ p 33) 9 (gn-sir M (+ p 33) IF-A) 0 0)
  34 (gn-dot-at? M (+ p 34) 19 0 0 0)
  35 (gn-dot-at? M (+ p 35) 2 f 0 0)
 false) (rv-shape M p f fixed (inc k))))))
(defn- rv-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 3) true (let [o (case k 0 2 1 9 2 33 0) l (gn-sir M (+ p o) IF-A)]
  (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p o)) (rv-labels M p (inc k))))))
(defn- rv-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 36)) (not= (gn-op M p) OP-FN)) false
 (let [f (gn-sir M p IF-A) base (gn-sir M (+ p 21) IF-B) reader (gn-sir M (+ p 19) IF-A)
  fixed (if (= (gn-op M (+ p 4)) OP-CONST) 1 0) limit (gn-sir M (+ p 4) IF-B)]
  (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
  (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-NSLOTS) 4) (= (gn-fnf M f FF-DEPTH) 8)
  (= (gn-fnf M f FF-RTYPE) TY-I64) (= (gn-fnf M f FF-PT0) TY-VEC)
  (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
  (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
  (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
  (= (gn-g M gn-f-ns) 4) (= (gn-g M gn-f-dp) 8) (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
  (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 4)
  (>= base 0) (<= base 4095) (or (= fixed 0) (and (>= limit 1) (<= limit 64)))
  (rv-shape M p f fixed 0) (rv-labels M p 0)
  (> reader 0) (< reader (vector-at M MM-FN-N))
  (> (gn-fnf M reader FF-SIR) 0) (<= (gn-fnf M reader FF-SIR) (- (vector-at M MM-SIR-N) 12))
  (> (mr-reader M (+ p 19) reader 3) 0)
  (= (gn-op M (inc (gn-fnf M reader FF-SIR))) OP-FUEL)
  (>= (gn-sir M (+ (mr-reader M (+ p 19) reader 3) 2) IF-B) 1)
  (<= (gn-sir M (+ (mr-reader M (+ p 19) reader 3) 2) IF-B) 4095)
  (let [a (gn-sreg M 1) b (gn-sreg M 2) c (gn-sreg M 3) d (gn-sreg M 4)]
   (and (>= a 19) (<= a 28) (>= b 19) (<= b 28) (>= c 19) (<= c 28) (>= d 19) (<= d 28)
    (not= a b) (not= a c) (not= a d) (not= b c) (not= b d) (not= c d))))))))
;; pre: emitted at FF-CODE before the frame (kpre-entry): the parameters are still in x0..x3, the count lives in x6
;; (x3 is the sum parameter the prologue still needs), the entry charge is paid with the loop's, plain ret
(defn- rv-entry [M :vector-i64 i :i64] :vector-i64 (rv-entry2 M i false))
(defn- rv-entry2 [M :vector-i64 i :i64 pre :bool] :vector-i64
 (if (not (rv-admit M i)) M
 (let [p (dec i) fixed (= (gn-op M (+ p 4)) OP-CONST) limit (gn-sir M (+ p 4) IF-B)
  base (gn-sir M (+ p 21) IF-B) reader (gn-sir M (+ p 19) IF-A)
  q (mr-reader M (+ p 19) reader 3) stride (gn-sir M (+ q 2) IF-B) G (vector-alloc 19) c (if pre 6 3)
  m0 (-> M (gn-mov 0 (kp M pre 1)) (gn-mov 1 (kp M pre 2)) (gn-mov 2 (kp M pre 3))
   (gn-mov 9 (kp M pre 4)) (gn-emit (enc-cmp-i 1 64)) (ri-cold G 8))
  m1 (if fixed (gn-mov-imm m0 4 limit) (gn-mov m0 4 1))
  m2 (-> m1 (gn-emit (enc-cmp-r 2 4)) (ri-cold G 8) (gn-emit (enc-sub-r c 4 2))
   (gn-emit (enc-cmp-i c 0)) (ri-cold G 0) (gn-emit (enc-add-r 11 c c)) (cond-> pre (gn-emit (enc-add-i 11 11 1)))
   (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 11)) (ri-cold G 3)
   (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
   (gn-emit (enc-cmp-r 17 16)) (ri-cold G 2) (gn-emit (enc-ldr 16 7 320))
   (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
   (gn-emit (enc-sub-i 12 4 1)) (gn-mov-imm 5 stride) (gn-emit (enc-mul 10 1 5))
   (gn-emit (enc-add-r 13 10 12)) (gn-emit (enc-cmp-r 13 16)) (ri-cold G 2)
   (gn-emit (enc-add-i 13 12 base)) (gn-emit (enc-cmp-r 13 16)) (ri-cold G 2)
   (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 15 15 17 3))
   (gn-emit (enc-sub-r 8 8 11)) (gn-emit (enc-str 8 7 CTX-FUEL))
   (gn-emit (enc-add-r 10 10 2)) (gn-emit (gn-e-addsl 10 15 10 3))
   (gn-emit (enc-add-i 11 2 base)) (gn-emit (gn-e-addsl 11 15 11 3))) loop (vector-at m2 MM-CODE-N)
  m3 (-> m2 (gn-emit (enc-ldr 13 10 0)) (gn-emit (enc-ldr 14 11 0))
   (gn-emit (+ (enc-madd 9 13 14 9) 0x8000))
   (gn-emit (enc-add-i 10 10 8)) (gn-emit (enc-add-i 11 11 8))
   (gn-emit (enc-subs-i c c 1))) b (vector-at m3 MM-CODE-N)
  m4 (-> m3 (gn-emit (enc-bcond 1 (- loop b))) (gn-mov 0 9) (kp-exit pre)) end (vector-at m4 MM-CODE-N)]
  (ri-patch m4 G 0 end))))
;; parameter k's register: x(k-1) before the frame, its slot register after the prologue
(defn- kp [M :vector-i64 pre :bool k :i64] :i64 (if pre (dec k) (gn-sreg M k)))
;; kernel exit: plain ret before the frame (no generator state touched), else the ordinary epilogue
(defn- kp-exit [M :vector-i64 pre :bool] :vector-i64
 (if pre (gn-emit M (enc-ret)) (-> M (gn-vclear) (gn-epilogue) (gn-gs gn-f-dead 0))))
;; frameless kernels at FF-CODE (gn-op-fn2): each guard fails before anything observable into the prologue
;; that follows; i is the FN record
(defn- kpre-entry [M :vector-i64 i :i64 f :i64 np :i64] :vector-i64
 (let [j (inc i)]
  (cond (and (= np 5) (is-admit M j)) (is-entry2 M j true)
        (and (= np 4) (rv-admit M j)) (rv-entry2 M j true)
        (and (= np 3) (ru-admit M j)) (ru-entry2 M j true)
        (and (= np 3) (rl-admit M j)) (rl-entry2 M j true)
        (and (= np 3) (> (sw-admit M j) 0)) (sw-entry2 M j true)
        (and (= np 6) (> (d2-admit M j) 0)) (d2-entry2 M j true)
        (and (= np 2) (> (fo-admit M j) 0)) (fo-entry M j)
        (and (= np 5) (> (dct-admit M j) 0)) (dct-entry M j)
        (and (= np 2) (> (frs-admit M j) 0)) (frs-entry M j)
        (and (= np 3) (pjp-admit M j)) (pjp-entry M j)
        (and (= np 6) (wml-admit M j)) (wml-entry M j)
        (and (= np 4) (wins-admit M j)) (wins-entry M j)
        (and (= np 5) (wcf-admit M j)) (wcf-entry M j)
        (and (= np 2) (mdk-admit M j)) (mdk-entry M j)
        (and (= np 4) (hfc-admit M j)) (hfc-entry M j)
        (and (= np 3) (hbt-admit M j)) (hbt-entry M j)
        (and (= np 4) (acc-admit M j)) (acc-entry M j)
        (and (= np 2) (cbk-admit M j)) (cbk-entry M j)
        (and (= np 4) (ptb-admit M j)) (ptb-entry M j)
        (and (= np 4) (cin-admit M j)) (cin-entry M j)
        (and (= np 8) (slp-admit M j)) (slp-entry M j)
        (and (= np 4) (sln-admit M j)) (sln-entry M j)
        (and (= np 10) (blp-admit M j)) (blp-entry M j)
        (and (= np 3) (wfl-admit M j)) (wfl-entry M j)
        (and (= np 2) (lu-admit M j)) (lu-entry M j)
        (and (= np 2) (uf-admit M j)) (uf-entry M j)
        (and (= np 2) (ub-admit M j)) (ub-entry M j)
        (and (= np 2) (hst-admit M j)) (hst-entry M j)
        :else (kpre-ip M j np))))
;; the leaf prologue will set private fuel (freg 1) when leaf = 1 and fuel = 1: ip-admit is asked under that state,
;; which is then restored to 0 for the prologue (the pre-mode kernel itself changes no generator state)
(defn- kpre-ip [M :vector-i64 j :i64 np :i64] :vector-i64
 (if (and (= np 4) (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-fuel) 1) (= (gn-g M gn-f-freg) 0))
  (let [M1 (gn-gs M gn-f-freg 1) ok (ip-admit M1 j) M2 (if ok (ip-entry2 M1 j true) M1)]
   (gn-gs M2 gn-f-freg 0))
  M))

(defn- srloop-admit [M :vector-i64 i :i64] :i64
 (if (or (<= i 2) (>= (+ i 69) (vector-at M MM-SIR-N))
         (not= (gn-op M (- i 2)) OP-FN)) 0
  (let [p (- i 2) f (gn-sir M p IF-A)]
   (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
    (let [n (gn-sir M (+ p 4) IF-B) threshold (gn-sir M (+ p 11) IF-B)
     base (gn-sir M (+ p 21) IF-B) head (gn-sir M (+ p 2) IF-A)]
     (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 2)
      (= (gn-fnf M f FF-NSLOTS) 3) (= (gn-fnf M f FF-DEPTH) 6)
      (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (ck-pt M f 0) TY-VEC) (= (ck-pt M f 1) TY-I64)
      (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
      (= (gn-g M gn-f-ns) 3) (= (gn-g M gn-f-dp) 6)
      (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0)
      (>= n 1) (<= n 4096) (>= threshold 1) (<= threshold n) (>= base 0) (<= base 4095)
      (loop [k 0] (or (= k 4) (let [delta (gn-sir M (+ p (case k 0 23 1 31 2 39 47)) IF-B)]
       (and (>= delta 0) (<= delta threshold) (recur (inc k))))))
      (loop [k 1] (or (= k 4) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
       (loop [j 1] (or (= j k) (and (not= (gn-sreg M j) (gn-sreg M k)) (recur (inc j)))))
       (recur (inc k)))))
      (srloop-shape M p f 0) (srloop-labels M p 0)
      (srloop-sigma M (gn-sir M (+ p 27) IF-A)) (srloop-sigma M (gn-sir M (+ p 43) IF-A))
      (= (gn-scalar-mask M (+ p 53) (gn-sir M (+ p 53) IF-A) 1) 32)
      (sw-writer M (gn-sir M (+ p 61) IF-A))
      (> head 0) (< head MM-LABEL-CAP) (srloop-edges M p head 1)) n 0))))))
(defn- srloop-body [M :vector-i64 p :i64] :vector-i64
 (let [ri (gn-sreg M 2) base (gn-sir M (+ p 21) IF-B)]
  (-> M (srloop-read p (gn-sir M (+ p 23) IF-B) 0)
   (srloop-scalar (gn-sir M (+ p 27) IF-A)) (srloop-read p (gn-sir M (+ p 31) IF-B) 1)
   (gn-emit (enc-add-r 6 0 1))
   (srloop-read p (gn-sir M (+ p 39) IF-B) 0)
   (srloop-scalar (gn-sir M (+ p 43) IF-A)) (srloop-read p (gn-sir M (+ p 47) IF-B) 1)
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (enc-add-r 0 0 6))
   (gn-emit (gn-e-bf 0xd3400000 0 0 0 31))
   (gn-emit (enc-add-i 16 ri base)) (gn-emit (gn-e-strr3 0 5 16))
   (gn-emit (enc-add-i ri ri 1)))))
;; sigma x = (ror32 x a) ^ (ror32 x b) ^ (x >>u c) with certified rr calls: a + 64 b + 4096 c, else -1
(defn- srx-sigma [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N))) -1
  (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1) q (gn-skiplab M (+ p 2))]
   (if (or (<= end 0) (not= end (+ q 12))) -1
    (let [a (gn-sir M (+ q 1) IF-B) b (gn-sir M (+ q 4) IF-B) c (gn-sir M (+ q 8) IF-B)]
     (if (and (gn-dot-at? M q OP-LGET 0 1 0) (gn-dot-at? M (+ q 1) OP-CONST 1 a 0)
              (rr-call M (+ q 2)) (= (gn-sir M (+ q 2) IF-B) 0)
              (gn-dot-at? M (+ q 3) OP-LGET 1 1 0) (gn-dot-at? M (+ q 4) OP-CONST 2 b 0)
              (rr-call M (+ q 5)) (= (gn-sir M (+ q 5) IF-B) 1)
              (gn-dot-at? M (+ q 6) OP-BIN BOP-XOR 0 0)
              (gn-dot-at? M (+ q 7) OP-LGET 1 1 0) (gn-dot-at? M (+ q 8) OP-CONST 2 c 0)
              (gn-dot-at? M (+ q 9) OP-BIN BOP-USHR 1 0) (gn-dot-at? M (+ q 10) OP-BIN BOP-XOR 0 0)
              (gn-dot-at? M (+ q 11) OP-RET 0 0 0)
              (>= a 0) (<= a 32) (>= b 0) (<= b 32) (>= c 0) (<= c 63))
      (+ a (* 64 b) (* 4096 c)) -1))))))
;; x0 := sigma(x0) in its low 32 bits (x9, x10 scratch): low32(ROR64(x|(x<<32),n)) = ror32(x,n) for 0<=n<=32, so
;; the low word equals the helper's; the high word is left unspecified and the caller only consumes the low word
(defn- srx-sigma-emit [M :vector-i64 k :i64] :vector-i64
 (let [a (bit-and k 63) b (bit-and (u64-shift-right k 6) 63) c (u64-shift-right k 12)]
  (-> M (gn-emit (+ (enc-orr-r 10 0 0) 32768))
   (gn-emit (+ (enc-rrr 0x93c00000 9 10 10) (* a 1024)))
   (gn-emit (+ (enc-rrr 0xcac00000 9 9 10) (* b 1024)))
   (gn-emit (+ (enc-rrr 0xca400000 0 9 0) (* c 1024))))))
;; both sigmas in the closed shape and every read at a nonnegative offset from &v[i]
(defn- srx-ok? [M :vector-i64 p :i64] :bool
 (let [base (gn-sir M (+ p 21) IF-B)]
  (and (>= (srx-sigma M (gn-sir M (+ p 27) IF-A)) 0) (>= (srx-sigma M (gn-sir M (+ p 43) IF-A)) 0)
       (loop [k 0] (or (= k 4) (and (<= (gn-sir M (+ p (case k 0 23 1 31 2 39 47)) IF-B) base) (recur (inc k))))))))
;; dst := sigma(src) in its low word (x9, x10 scratch), as srx-sigma-emit
(defn- srx-sig [M :vector-i64 k :i64 src :i64 dst :i64] :vector-i64
 (let [a (bit-and k 63) b (bit-and (u64-shift-right k 6) 63) c (u64-shift-right k 12)]
  (-> M (gn-emit (+ (enc-orr-r 10 src src) 32768))
   (gn-emit (+ (enc-rrr 0x93c00000 9 10 10) (* a 1024)))
   (gn-emit (+ (enc-rrr 0xcac00000 9 9 10) (* b 1024)))
   (gn-emit (+ (enc-rrr 0xca400000 dst 9 src) (* c 1024))))))
;; two words per iteration: every delta >= 2 (word i + 1 never reads word i), the pairs i-d / i+1-d adjacent
(defn- srx-pair-ok? [M :vector-i64 p :i64] :bool
 (let [d0 (gn-sir M (+ p 23) IF-B) d1 (gn-sir M (+ p 31) IF-B) d2 (gn-sir M (+ p 39) IF-B) d3 (gn-sir M (+ p 47) IF-B)
       base (gn-sir M (+ p 21) IF-B) S (srx-shift M p)
       inpair (fn [d] (let [o (- (* 8 (- base d)) S)] (and (>= o -512) (<= o 496))))]
  (and (>= d0 2) (>= d1 2) (>= d2 2) (= d3 (inc d2))
       (inpair d0) (inpair d1) (inpair d3) (>= (- (* 8 (inc (- base d2))) S) 0))))
;; byte shift S of the pair pointer so that the store offset 8 base - S <= 496 (ldp/stp range)
(defn- srx-shift [M :vector-i64 p :i64] :i64
 (let [b8 (* 8 (gn-sir M (+ p 21) IF-B))] (if (> b8 496) (- b8 496) 0)))
(defn- srx-pair-body [M :vector-i64 p :i64] :vector-i64
 (let [base (gn-sir M (+ p 21) IF-B) d0 (gn-sir M (+ p 23) IF-B) d1 (gn-sir M (+ p 31) IF-B)
       d2 (gn-sir M (+ p 39) IF-B) d3 (gn-sir M (+ p 47) IF-B) S (srx-shift M p)
       k1 (srx-sigma M (gn-sir M (+ p 27) IF-A)) k0 (srx-sigma M (gn-sir M (+ p 43) IF-A))]
  (-> M (gn-emit (enc-ldp 0 1 16 (- (* 8 (- base d0)) S))) (gn-emit (enc-ldp 2 11 16 (- (* 8 (- base d1)) S)))
   (gn-emit (enc-ldp 12 13 16 (- (* 8 (- base d3)) S))) (gn-emit (enc-ldr 14 16 (- (* 8 (inc (- base d2))) S)))
   (srx-sig k1 0 0) (srx-sig k1 1 1) (srx-sig k0 13 6) (srx-sig k0 14 14)
   (gn-emit (enc-add-r 0 0 2)) (gn-emit (enc-add-r 6 6 12)) (gn-emit (enc-rrr 0x0b000000 0 0 6))
   (gn-emit (enc-add-r 1 1 11)) (gn-emit (enc-add-r 14 14 13)) (gn-emit (enc-rrr 0x0b000000 1 1 14))
   (gn-emit (enc-stp 0 1 16 (- (* 8 base) S))) (gn-emit (enc-add-i 16 16 16)))))
;; schedule on the crypto unit (kernels B): with deltas 2 7 15 16 and the standard small sigmas (17 19 >>10, 7 18 >>3),
;; when the count is a multiple of 4 and the 16 words before i are below 2^32 (their high words OR to 0), each step
;; makes w[i..i+3] = sha256su1(sha256su0(w[i-16..], w[i-12..]), w[i-8..], w[i-4..]) on 32-bit lanes (the low words of
;; the masked sums), stored zero-extended at &v[base + i]; else the scalar pairs below.
(defn- srx-hw-ok? [M :vector-i64 p :i64] :bool
 (let [base (gn-sir M (+ p 21) IF-B)]
  (and kb-sha-hw (= (gn-sir M (+ p 23) IF-B) 2) (= (gn-sir M (+ p 31) IF-B) 7) (= (gn-sir M (+ p 39) IF-B) 15)
       (= (gn-sir M (+ p 47) IF-B) 16) (>= base 16) (<= base 500)
       (= (srx-sigma M (gn-sir M (+ p 27) IF-A)) 42193) (= (srx-sigma M (gn-sir M (+ p 43) IF-A)) 13447))))
(defn- srx-hw [M :vector-i64 p :i64] :vector-i64
 (let [base (gn-sir M (+ p 21) IF-B)]
   (let [m0 (-> M (gn-emit (enc-sub-r 10 17 16)) (gn-emit 0xF240115F)) b0 (vector-at m0 MM-CODE-N)
         m1 (-> (gn-emit m0 0) (gn-emit (enc-add-i 0 16 (* 8 (- base 16))))
              (gn-emit 0xAD404410) (gn-emit 0xAD414C12) (gn-emit 0xAD425414) (gn-emit 0xAD435C16)
              (gn-emit 0x4E915A18) (gn-emit 0x4E935A59) (gn-emit 0x4E955A9A) (gn-emit 0x4E975ADB)
              (gn-emit 0x4EB91F18) (gn-emit 0x4EBB1F5A) (gn-emit 0x4EBA1F18) (gn-emit 0x6EB0AB18) (gn-emit 0x1E260309))
         b1 (vector-at m1 MM-CODE-N)
         m2 (-> (gn-emit m1 0) (gn-emit 0x4E911A10) (gn-emit 0x4E931A51) (gn-emit 0x4E951A92) (gn-emit 0x4E971AD3)
              (gn-emit (enc-add-i 1 16 (* 8 base))) (gn-emit (gn-e-lsr 9 10 5))) top (vector-at m2 MM-CODE-N)
         m3 (-> m2 (gn-emit 0x4EB01E14) (gn-emit 0x5E282A34) (gn-emit 0x5E136254) (gn-emit 0x2F20A695) (gn-emit 0x6F20A696)
              (gn-emit 0xAC815835) (gn-emit 0x4EB11E30) (gn-emit 0x4EB21E51) (gn-emit 0x4EB31E72) (gn-emit 0x4EB41E93)
              (gn-emit (enc-subs-i 9 9 1))) b2 (vector-at m3 MM-CODE-N)
         m4 (gn-emit m3 (enc-bcond (enc-cond-ne) (- top b2))) bout (vector-at m4 MM-CODE-N)
         m5 (srx-pairs0 (gn-emit m4 0) p) done (vector-at m5 MM-CODE-N)]
    (-> m5 (gn-dot-patch b0 (inc bout) (enc-cond-ne)) (gn-put (+ MM-CODE-BASE b1) (enc-cbnz 9 (- (inc bout) b1)))
     (gn-put (+ MM-CODE-BASE bout) (enc-b (- done bout)))))))
(defn- srx-pairs [M :vector-i64 p :i64] :vector-i64 (if (srx-hw-ok? M p) (srx-hw M p) (srx-pairs0 M p)))
;; carried pairs (kernels B): when sigma1 reads word i - 2 (d0 = 2) and shifts by c <= 31, every pair after the
;; first keeps words i - 2 and i - 1 in x0/x1 -- the values the previous pair just stored, below 2^32 after its
;; 32-bit adds -- so no word waits on a store-to-load round trip and sigma1 runs on the low words with plain
;; rotates: for x < 2^32, ror32 x n = ror w (n mod 32, n <= 32) and x >>u c = lsr w (c <= 31). The first pair
;; (srx-pair-body) reads both from memory and keeps the general 64-bit sigma.
(defn- srx-carry-ok? [M :vector-i64 p :i64] :bool
 (and (= (gn-sir M (+ p 23) IF-B) 2)
      (<= (u64-shift-right (srx-sigma M (gn-sir M (+ p 27) IF-A)) 12) 31)))
(defn- srx-lsr32 [d :i64 n :i64 s :i64] :i64 (+ 0x53007c00 (* (bit-and s 31) 65536) (* (bit-and n 31) 32) (bit-and d 31)))
(defn- srx-carry-body [M :vector-i64 p :i64] :vector-i64
 (let [base (gn-sir M (+ p 21) IF-B) d1 (gn-sir M (+ p 31) IF-B)
       d2 (gn-sir M (+ p 39) IF-B) d3 (gn-sir M (+ p 47) IF-B) S (srx-shift M p)
       k1 (srx-sigma M (gn-sir M (+ p 27) IF-A)) k0 (srx-sigma M (gn-sir M (+ p 43) IF-A))
       a (bit-and k1 63) b (bit-and (u64-shift-right k1 6) 63) c (u64-shift-right k1 12)]
  (-> M (gn-emit (enc-ldp 2 11 16 (- (* 8 (- base d1)) S))) (gn-emit (enc-ldp 12 13 16 (- (* 8 (- base d3)) S)))
   (gn-emit (enc-ldr 14 16 (- (* 8 (inc (- base d2))) S)))
   (gn-emit (srx-ror32 9 0 a)) (gn-emit (srx-ror32 10 0 b)) (gn-emit (srx-lsr32 0 0 c))
   (gn-emit (srx-ror32 3 1 a)) (gn-emit (srx-ror32 4 1 b)) (gn-emit (srx-lsr32 1 1 c))
   (gn-emit (enc-rrr 0x4a000000 9 9 10)) (gn-emit (enc-rrr 0x4a000000 3 3 4))
   (gn-emit (enc-rrr 0x4a000000 0 9 0)) (gn-emit (enc-rrr 0x4a000000 1 3 1))
   (srx-sig k0 13 6) (srx-sig k0 14 14)
   (gn-emit (enc-add-r 2 2 12)) (gn-emit (enc-add-r 2 2 6)) (gn-emit (enc-add-r 11 11 13)) (gn-emit (enc-add-r 11 11 14))
   (gn-emit (enc-rrr 0x0b000000 0 0 2)) (gn-emit (enc-rrr 0x0b000000 1 1 11))
   (gn-emit (enc-stp 0 1 16 (- (* 8 base) S))) (gn-emit (enc-add-i 16 16 16)))))
;; an odd count first runs one word (srx-body), then x16/x17 shift by S and the pair loop runs to x17
(defn- srx-pairs0 [M :vector-i64 p :i64] :vector-i64
 (let [S (srx-shift M p) carry (srx-carry-ok? M p)
       m0 (gn-emit M (enc-sub-r 9 17 16)) t (vector-at m0 MM-CODE-N)
       m1 (srx-body (gn-emit m0 0) p) over (vector-at m1 MM-CODE-N)
       m2 (-> m1 (gn-put (+ MM-CODE-BASE t) (pz-tbz 9 3 (- over t)))
           (cond-> (> S 0) (-> (gn-emit (enc-add-i 16 16 S)) (gn-emit (enc-add-i 17 17 S))))
           (gn-emit (enc-cmp-r 16 17))) e (vector-at m2 MM-CODE-N)
       m3 (gn-emit m2 0)
       m3a (if carry (-> m3 (srx-pair-body p) (gn-emit (enc-cmp-r 16 17))) m3) e2 (vector-at m3a MM-CODE-N)
       m3b (cond-> m3a carry (gn-emit 0)) loop (vector-at m3b MM-CODE-N)
       m4 (-> (if carry (srx-carry-body m3b p) (srx-pair-body m3b p)) (gn-emit (enc-cmp-r 16 17))) back (vector-at m4 MM-CODE-N)
       m5 (gn-emit m4 (enc-bcond (enc-cond-ne) (- loop back))) done (vector-at m5 MM-CODE-N)]
  (-> m5 (gn-put (+ MM-CODE-BASE e) (enc-bcond (enc-cond-eq) (- done e)))
   (cond-> carry (gn-put (+ MM-CODE-BASE e2) (enc-bcond (enc-cond-eq) (- done e2)))))))
;; one schedule word through x16 = &v[i]: the four reads in the original order (the last two as one ldp when
;; adjacent), the sum masked by one 32-bit add, the store, x16 += 8
(defn- srx-body [M :vector-i64 p :i64] :vector-i64
 (let [base (gn-sir M (+ p 21) IF-B) d0 (gn-sir M (+ p 23) IF-B) d1 (gn-sir M (+ p 31) IF-B)
       d2 (gn-sir M (+ p 39) IF-B) d3 (gn-sir M (+ p 47) IF-B)
       pair (and (= d3 (inc d2)) (<= (* 8 (- base d3)) 504))
       m0 (-> M (gn-emit (enc-ldr 0 16 (* 8 (- base d0)))) (srx-sigma-emit (srx-sigma M (gn-sir M (+ p 27) IF-A)))
           (gn-emit (enc-ldr 1 16 (* 8 (- base d1)))) (gn-emit (enc-add-r 6 0 1)))
       m1 (if pair (gn-emit m0 (enc-ldp 1 0 16 (* 8 (- base d3))))
           (-> m0 (gn-emit (enc-ldr 0 16 (* 8 (- base d2)))) (gn-emit (enc-ldr 1 16 (* 8 (- base d3))))))]
  (-> m1 (srx-sigma-emit (srx-sigma M (gn-sir M (+ p 43) IF-A)))
   (gn-emit (enc-add-r 0 0 1)) (gn-emit (enc-rrr 0x0b000000 0 0 6))
   (gn-emit (enc-str 0 16 (* 8 base))) (gn-emit (enc-add-i 16 16 8)))))
(defn- srloop-edges [M :vector-i64 p :i64 head :i64 j :i64] :bool
 (if (= j (vector-at M MM-SIR-N)) true
  (let [op (gn-op M j)]
   (and (not= op OP-TAB)
    (not (and (= op OP-LABEL) (= (gn-sir M j IF-A) head) (not= j (+ p 2))))
    (not (and (= op OP-BR) (= (gn-sir M j IF-A) head) (not= j (+ p 68))))
    (not (and (or (= op OP-BRZ) (= op OP-BRNZ)) (= (gn-sir M j IF-B) head)))
    (srloop-edges M p head (inc j))))))
(defn- srloop-entry [M :vector-i64 i :i64] :vector-i64
 (let [n (srloop-admit M i)]
  (if (= n 0) M
   (let [p (- i 2) ri (gn-sreg M 2) rv (gn-sreg M 1)
    threshold (gn-sir M (+ p 11) IF-B) base (gn-sir M (+ p 21) IF-B)
    ctx (gn-g M gn-f-ctx) m0 (gn-emit M (enc-cmp-i ri threshold)) b0 (vector-at m0 MM-CODE-N)
    m1 (-> m0 (gn-emit (enc-bcond (enc-cond-lo) 0)) (gn-mov-imm 9 n) (gn-emit (enc-cmp-r ri 9))) b1 (vector-at m1 MM-CODE-N)
    m2 (-> m1 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-ctx)
     (gn-emit (enc-sub-r 9 9 ri)) (gn-mov-imm 10 8) (gn-emit (enc-mul 9 9 10))
     (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9))) b2 (vector-at m2 MM-CODE-N)
    m3 (-> m2 (gn-emit (enc-bcond (enc-cond-lo) 0))
     (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
     (gn-emit (enc-sub-i 17 rv 1)) (gn-emit (enc-cmp-r 17 16))) b3 (vector-at m3 MM-CODE-N)
    m4 (-> m3 (gn-emit (enc-bcond (enc-cond-hs) 0))
     (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4))
     (gn-emit (enc-ldp 17 0 16 0)) (gn-mov-imm 16 1152921504606846976)
     (gn-emit (enc-cmp-r 0 16))) b4 (vector-at m4 MM-CODE-N)
    m5 (-> m4 (gn-emit (enc-bcond (enc-cond-hs) 0)) (gn-mov-imm 16 (+ n base))
     (gn-emit (enc-cmp-r 0 16))) b5 (vector-at m5 MM-CODE-N)
    fast (srx-ok? M p)
    m6 (-> m5 (gn-emit (enc-bcond (enc-cond-lo) 0))
     (gn-emit (enc-ldr 5 7 328)) (gn-emit (gn-e-addsl 5 5 17 3))
     (gn-emit (enc-sub-r 8 8 9)) (gn-emit (enc-str 8 7 CTX-FUEL))
     ;; fast body: x16 = &v[i] advances by 8 up to x17 = &v[n]; i := n after the loop
     (cond-> fast (gn-emit (gn-e-addsl 16 5 ri 3))) (cond-> fast (gn-mov-imm 17 n))
     (cond-> fast (gn-emit (gn-e-addsl 17 5 17 3)))) start (vector-at m6 MM-CODE-N)
    pair (and fast (srx-pair-ok? M p))
    m7 (cond pair (srx-pairs m6 p)
         fast (-> m6 (srx-body p) (gn-emit (enc-cmp-r 16 17)))
         :else (-> m6 (srloop-body p) (gn-mov-imm 16 n) (gn-emit (enc-cmp-r ri 16)))) back (vector-at m7 MM-CODE-N)
    m8 (-> m7 (cond-> (not pair) (gn-emit (enc-bcond (enc-cond-ne) (- start back)))) (cond-> fast (gn-mov-imm ri n))
     (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0))) end (vector-at m8 MM-CODE-N)]
   (-> m8 (gn-dot-patch b0 end (enc-cond-lo)) (gn-dot-patch b1 end (enc-cond-hs))
    (gn-dot-patch b2 end (enc-cond-lo)) (gn-dot-patch b3 end (enc-cond-hs))
    (gn-dot-patch b4 end (enc-cond-hs)) (gn-dot-patch b5 end (enc-cond-lo)) (gn-gs gn-f-ctx ctx))))))
(defn- srloop-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 5) true
  (let [at (+ p (case k 0 2 1 9 2 19 3 54 69)) l (gn-sir M at IF-A)]
   (and (> l 0) (< l MM-LABEL-CAP)
    (loop [j 0] (or (= j k)
     (and (not= l (gn-sir M (+ p (case j 0 2 1 9 2 19 3 54 69)) IF-A)) (recur (inc j)))))
    (srloop-labels M p (inc k))))))
(defn- srloop-read [M :vector-i64 p :i64 delta :i64 dst :i64] :vector-i64
 (let [ri (gn-sreg M 2) base (gn-sir M (+ p 21) IF-B)]
  (-> M (gn-emit (enc-add-i 16 ri base)) (gn-emit (enc-sub-i 16 16 delta))
   (gn-emit (gn-e-ldrr dst 5 16 1)))))
(defn- srloop-scalar [M :vector-i64 f :i64] :vector-i64
 (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1)]
  (-> M (gn-mov 9 0) (gn-emit (+ (enc-orr-r 10 9 9) 32768)) (rr-emit (+ p 2) (dec end)))))
(defn- srloop-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 72) true
  (let [head (gn-sir M (+ p 2) IF-A) body (gn-sir M (+ p 6) IF-B)
   exit (gn-sir M (+ p 8) IF-A) right (gn-sir M (+ p 13) IF-B) join (gn-sir M (+ p 18) IF-A)
   n (gn-sir M (+ p 4) IF-B) threshold (gn-sir M (+ p 11) IF-B) base (gn-sir M (+ p 21) IF-B)
   d0 (gn-sir M (+ p 23) IF-B) d1 (gn-sir M (+ p 31) IF-B)
   d2 (gn-sir M (+ p 39) IF-B) d3 (gn-sir M (+ p 47) IF-B)
   initial (gn-sir M (+ p 17) IF-A) sig1 (gn-sir M (+ p 27) IF-A)
   sig0 (gn-sir M (+ p 43) IF-A) mask (gn-sir M (+ p 53) IF-A) writer (gn-sir M (+ p 61) IF-A)]
   (and (case k
    0 (gn-dot-at? M (+ p 0) OP-FN f 2 3)
    1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
    2 (gn-dot-at? M (+ p 2) OP-LABEL head 0 0)
    3 (gn-dot-at? M (+ p 3) OP-LGET 0 2 0)
    4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
    5 (gn-dot-at? M (+ p 5) OP-CMP 1 0 0)
    6 (gn-dot-at? M (+ p 6) OP-BRZ 0 body 0)
    7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
    8 (gn-dot-at? M (+ p 8) OP-BR exit 0 0)
    9 (gn-dot-at? M (+ p 9) OP-LABEL body 0 0)
    10 (gn-dot-at? M (+ p 10) OP-LGET 0 2 0)
    11 (gn-dot-at? M (+ p 11) OP-CONST 1 threshold 0)
    12 (gn-dot-at? M (+ p 12) OP-CMP 2 0 0)
    13 (gn-dot-at? M (+ p 13) OP-BRZ 0 right 0)
    14 (gn-dot-at? M (+ p 14) OP-LGET 0 1 0)
    15 (gn-dot-at? M (+ p 15) OP-CONST 1 0 0)
    16 (gn-dot-at? M (+ p 16) OP-LGET 2 2 0)
    17 (gn-dot-at? M (+ p 17) OP-CALL initial 0 3)
    18 (gn-dot-at? M (+ p 18) OP-BR join 0 0)
    19 (gn-dot-at? M (+ p 19) OP-LABEL right 0 0)
    20 (gn-dot-at? M (+ p 20) OP-LGET 0 1 0)
    21 (gn-dot-at? M (+ p 21) OP-CONST 1 base 0)
    22 (gn-dot-at? M (+ p 22) OP-LGET 2 2 0)
    23 (gn-dot-at? M (+ p 23) OP-CONST 3 d0 0)
    24 (gn-dot-at? M (+ p 24) OP-BIN 2 2 0)
    25 (gn-dot-at? M (+ p 25) OP-BIN 1 1 0)
    26 (gn-dot-at? M (+ p 26) OP-RT 176 0 2)
    27 (gn-dot-at? M (+ p 27) OP-CALL sig1 0 1)
    28 (gn-dot-at? M (+ p 28) OP-LGET 1 1 0)
    29 (gn-dot-at? M (+ p 29) OP-CONST 2 base 0)
    30 (gn-dot-at? M (+ p 30) OP-LGET 3 2 0)
    31 (gn-dot-at? M (+ p 31) OP-CONST 4 d1 0)
    32 (gn-dot-at? M (+ p 32) OP-BIN 2 3 0)
    33 (gn-dot-at? M (+ p 33) OP-BIN 1 2 0)
    34 (gn-dot-at? M (+ p 34) OP-RT 176 1 2)
    35 (gn-dot-at? M (+ p 35) OP-BIN 1 0 0)
    36 (gn-dot-at? M (+ p 36) OP-LGET 1 1 0)
    37 (gn-dot-at? M (+ p 37) OP-CONST 2 base 0)
    38 (gn-dot-at? M (+ p 38) OP-LGET 3 2 0)
    39 (gn-dot-at? M (+ p 39) OP-CONST 4 d2 0)
    40 (gn-dot-at? M (+ p 40) OP-BIN 2 3 0)
    41 (gn-dot-at? M (+ p 41) OP-BIN 1 2 0)
    42 (gn-dot-at? M (+ p 42) OP-RT 176 1 2)
    43 (gn-dot-at? M (+ p 43) OP-CALL sig0 1 1)
    44 (gn-dot-at? M (+ p 44) OP-LGET 2 1 0)
    45 (gn-dot-at? M (+ p 45) OP-CONST 3 base 0)
    46 (gn-dot-at? M (+ p 46) OP-LGET 4 2 0)
    47 (gn-dot-at? M (+ p 47) OP-CONST 5 d3 0)
    48 (gn-dot-at? M (+ p 48) OP-BIN 2 4 0)
    49 (gn-dot-at? M (+ p 49) OP-BIN 1 3 0)
    50 (gn-dot-at? M (+ p 50) OP-RT 176 2 2)
    51 (gn-dot-at? M (+ p 51) OP-BIN 1 1 0)
    52 (gn-dot-at? M (+ p 52) OP-BIN 1 0 0)
    53 (gn-dot-at? M (+ p 53) OP-CALL mask 0 1)
    54 (gn-dot-at? M (+ p 54) OP-LABEL join 0 0)
    55 (gn-dot-at? M (+ p 55) OP-LSET 3 0 0)
    56 (gn-dot-at? M (+ p 56) OP-LGET 0 1 0)
    57 (gn-dot-at? M (+ p 57) OP-CONST 1 base 0)
    58 (gn-dot-at? M (+ p 58) OP-LGET 2 2 0)
    59 (gn-dot-at? M (+ p 59) OP-BIN 1 1 0)
    60 (gn-dot-at? M (+ p 60) OP-LGET 2 3 0)
    61 (gn-dot-at? M (+ p 61) OP-CALL writer 0 3)
    62 (gn-dot-at? M (+ p 62) OP-LGET 1 2 0)
    63 (gn-dot-at? M (+ p 63) OP-CONST 2 1 0)
    64 (gn-dot-at? M (+ p 64) OP-BIN 1 1 0)
    65 (gn-dot-at? M (+ p 65) OP-LSET 1 0 0)
    66 (gn-dot-at? M (+ p 66) OP-LSET 2 1 0)
    67 (gn-dot-at? M (+ p 67) OP-FUEL 0 0 0)
    68 (gn-dot-at? M (+ p 68) OP-BR head 0 0)
    69 (gn-dot-at? M (+ p 69) OP-LABEL exit 0 0)
    70 (gn-dot-at? M (+ p 70) OP-RET 0 0 0)
    71 (gn-dot-at? M (+ p 71) OP-END f 0 0)
    false) (srloop-shape M p f (inc k))))))
(defn- srloop-sigma [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N))) false
  (let [p (gn-fnf M f FF-SIR) end (sc-admit M p f 1)]
   (and (> end 0) (= (gn-fnf M f FF-DEPTH) 3)
    (= (rr-calls M (+ p 2) end 0) 2) (= (sc-charge-count M (+ p 2) end 1) 3)))))

(defn- is-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 53)) (not= (gn-op M p) OP-FN)) false
 (let [f (gn-sir M p IF-A) r (gn-sir M (+ p 12) IF-A) pc (gn-sir M (+ p 21) IF-A) w (gn-sir M (+ p 42) IF-A)]
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f)) (= (gn-fnf M f FF-SIR) p)
 (= (gn-fnf M f FF-NPARAMS) 5) (= (gn-fnf M f FF-NSLOTS) 5) (= (gn-fnf M f FF-DEPTH) 5)
 (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
 (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
 (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
 (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-vmode) 0)
 (= (gn-g M gn-f-ns) 5) (= (gn-g M gn-f-dp) 5) (= (gn-g M gn-f-h) 0)
 (= (gn-g M gn-f-skip) 0) (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 5)
 (is-shape M p f r pc w 0) (is-labels M p 0)
 (loop [k 1] (or (= k 6) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
  (loop [j 1] (or (= j k) (and (not= (gn-sreg M k) (gn-sreg M j)) (recur (inc j))))) (recur (inc k)))))
 (loop [k 0] (or (= k 3) (let [h (case k 0 r 1 pc 2 w 0)]
  (and (> h 0) (< h (vector-at M MM-FN-N)) (> (gn-fnf M h FF-SIR) 0)
   (<= (gn-fnf M h FF-SIR) (- (vector-at M MM-SIR-N) 30)) (recur (inc k))))))
 (> (pi-shape M pc) 0)
 (= (gn-sir M (+ (pi-shape M pc) 5) IF-A) r)
 (= (gn-sir M (+ (pi-shape M pc) 20) IF-A) w))))))
;; pre: see rv-entry2 (x0..x4 are only read before the last guard)
(defn- is-entry [M :vector-i64 i :i64] :vector-i64 (is-entry2 M i false))
(defn- is-entry2 [M :vector-i64 i :i64 pre :bool] :vector-i64
 (if (not (is-admit M i)) M
 (let [G (vector-alloc 19)
 m0 (-> M (gn-mov 0 (kp M pre 1)) (gn-mov 1 (kp M pre 2)) (gn-mov 2 (kp M pre 3))
  (gn-mov 3 (kp M pre 4)) (gn-mov 4 (kp M pre 5))
  (gn-emit (enc-cmp-i 2 4095)) (ri-cold G 8) (gn-emit (enc-cmp-r 1 2)) (ri-cold G 8)
  (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
  (gn-emit (enc-cmp-r 17 16)) (ri-cold G 2) (gn-emit (enc-ldr 16 7 320))
  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
  (gn-emit (enc-add-r 9 2 2)) (gn-emit (enc-add-i 9 9 1)) (gn-emit (enc-cmp-r 9 16)) (ri-cold G 2)
  (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 15 15 17 3))
  ;; c = j - start probes left (0 <= start <= j <= 4095 by the guards) as x6 = 2c; x10 = &v[2(start - 1)], so the
  ;; probe of v[2(start + c - 1)] is [x10, x6, lsl #3]
  (gn-emit (enc-sub-r 6 2 1)) (gn-emit (enc-add-r 6 6 6))
  (gn-emit (gn-e-addsl 10 15 1 4)) (gn-emit (enc-sub-i 10 10 16))) p0 (vector-at m0 MM-CODE-N)
 ;; cbz x6, done ; probe: ldr x16, [x10, x6, lsl #3] ; cmp x3, x16 ; b.ge done ; subs x6, x6, #2 ; b.ne probe
 m1 (gn-emit m0 0) probe (vector-at m1 MM-CODE-N)
 m2 (-> m1 (gn-emit (gn-e-ldrr 16 10 6 1)) (gn-emit (enc-cmp-r 3 16))) p1 (vector-at m2 MM-CODE-N)
 m3 (-> m2 (gn-emit 0) (gn-emit (enc-subs-i 6 6 2))) pb (vector-at m3 MM-CODE-N)
 m4 (gn-emit m3 (enc-bcond (enc-cond-ne) (- probe pb))) done (vector-at m4 MM-CODE-N)
 ;; final j x5 = start + c (add x5, x1, x6, lsr #1), moved items x6 = j - x5
 m5 (-> m4 (gn-put (+ MM-CODE-BASE p0) (enc-cbz 6 (- done p0))) (gn-dot-patch p1 done 10)
  (gn-emit (+ (enc-add-r 5 1 6) 0x400400)) (gn-emit (enc-sub-r 6 2 5))
  (gn-mov-imm 9 6) (gn-emit (enc-mul 11 6 9)) (gn-emit (enc-add-i 11 11 2))
  (gn-emit (enc-cmp-r 5 1))) skip (vector-at m5 MM-CODE-N)
 m6 (-> m5 (gn-emit (enc-bcond 0 2)) (gn-emit (enc-add-i 11 11 1)) (cond-> pre (gn-emit (enc-add-i 11 11 1)))
  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 11)) (ri-cold G 3)
  (gn-emit (enc-sub-r 8 8 11)) (gn-emit (enc-str 8 7 CTX-FUEL))
  (gn-emit (enc-add-r 9 2 2)) (gn-emit (gn-e-addsl 12 15 9 3))) noCopy (vector-at m6 MM-CODE-N)
 ;; cbz x6, final ; cp: ldp x9, x16, [x12, #-16] ; stp x9, x16, [x12], #-16 ; subs x6, x6, #1 ; b.ne cp
 m7 (gn-emit m6 0) cp (vector-at m7 MM-CODE-N)
 m8 (-> m7 (gn-emit (enc-ldp 9 16 12 -16)) (gn-emit (enc-ldstp 0xa8800000 9 16 12 -16))
  (gn-emit (enc-subs-i 6 6 1))) cb (vector-at m8 MM-CODE-N)
 m9 (gn-emit m8 (enc-bcond 1 (- cp cb))) final (vector-at m9 MM-CODE-N)
 m10 (-> m9 (gn-put (+ MM-CODE-BASE noCopy) (enc-cbz 6 (- final noCopy)))
  (gn-emit (enc-str 3 12 0)) (gn-emit (enc-str 4 12 8))
  (gn-mov 0 (kp M pre 1)) (kp-exit pre)) end (vector-at m10 MM-CODE-N)]
 (ri-patch m10 G 0 end))))
(defn- is-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 4) true (let [o (case k 0 2 1 14 2 36 3 50 0) l (gn-sir M (+ p o) IF-A)]
  (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p o)) (is-labels M p (inc k))))))
(defn- is-shape [M :vector-i64 p :i64 f :i64 r :i64 pc :i64 w :i64 k :i64] :bool
 (if (= k 53) true (and (case k
  0 (gn-dot-at? M (+ p 0) 1 f 5 5)
  1 (gn-dot-at? M (+ p 1) 18 0 0 0)
  2 (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (gn-dot-at? M (+ p 3) 4 0 3 0)
  4 (gn-dot-at? M (+ p 4) 4 1 2 0)
  5 (gn-dot-at? M (+ p 5) 7 3 0 0)
  6 (gn-dot-at? M (+ p 6) 11 0 (gn-sir M (+ p 14) IF-A) 0)
  7 (gn-dot-at? M (+ p 7) 4 0 4 0)
  8 (gn-dot-at? M (+ p 8) 4 1 1 0)
  9 (gn-dot-at? M (+ p 9) 4 2 3 0)
  10 (gn-dot-at? M (+ p 10) 3 3 1 0)
  11 (gn-dot-at? M (+ p 11) 6 2 2 0)
  12 (gn-dot-at? M (+ p 12) 13 r 1 2)
  13 (gn-dot-at? M (+ p 13) 7 2 0 0)
  14 (gn-dot-at? M (+ p 14) 9 (gn-sir M (+ p 14) IF-A) 0 0)
  15 (gn-dot-at? M (+ p 15) 11 0 (gn-sir M (+ p 36) IF-A) 0)
  16 (gn-dot-at? M (+ p 16) 4 0 1 0)
  17 (gn-dot-at? M (+ p 17) 4 1 3 0)
  18 (gn-dot-at? M (+ p 18) 4 2 3 0)
  19 (gn-dot-at? M (+ p 19) 3 3 1 0)
  20 (gn-dot-at? M (+ p 20) 6 2 2 0)
  21 (gn-dot-at? M (+ p 21) 13 pc 0 3)
  22 (gn-dot-at? M (+ p 22) 4 1 2 0)
  23 (gn-dot-at? M (+ p 23) 4 2 3 0)
  24 (gn-dot-at? M (+ p 24) 3 3 1 0)
  25 (gn-dot-at? M (+ p 25) 6 2 2 0)
  26 (gn-dot-at? M (+ p 26) 4 3 4 0)
  27 (gn-dot-at? M (+ p 27) 4 4 5 0)
  28 (gn-dot-at? M (+ p 28) 5 1 0 0)
  29 (gn-dot-at? M (+ p 29) 5 2 1 0)
  30 (gn-dot-at? M (+ p 30) 5 3 2 0)
  31 (gn-dot-at? M (+ p 31) 5 4 3 0)
  32 (gn-dot-at? M (+ p 32) 5 5 4 0)
  33 (gn-dot-at? M (+ p 33) 18 0 0 0)
  34 (gn-dot-at? M (+ p 34) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  35 (gn-dot-at? M (+ p 35) 10 (gn-sir M (+ p 50) IF-A) 0 0)
  36 (gn-dot-at? M (+ p 36) 9 (gn-sir M (+ p 36) IF-A) 0 0)
  37 (gn-dot-at? M (+ p 37) 4 0 1 0)
  38 (gn-dot-at? M (+ p 38) 4 1 3 0)
  39 (gn-dot-at? M (+ p 39) 3 2 2 0)
  40 (gn-dot-at? M (+ p 40) 6 3 1 0)
  41 (gn-dot-at? M (+ p 41) 4 2 4 0)
  42 (gn-dot-at? M (+ p 42) 13 w 0 3)
  43 (gn-dot-at? M (+ p 43) 4 1 3 0)
  44 (gn-dot-at? M (+ p 44) 3 2 2 0)
  45 (gn-dot-at? M (+ p 45) 6 3 1 0)
  46 (gn-dot-at? M (+ p 46) 3 2 1 0)
  47 (gn-dot-at? M (+ p 47) 6 1 1 0)
  48 (gn-dot-at? M (+ p 48) 4 2 5 0)
  49 (gn-dot-at? M (+ p 49) 13 w 0 3)
  50 (gn-dot-at? M (+ p 50) 9 (gn-sir M (+ p 50) IF-A) 0 0)
  51 (gn-dot-at? M (+ p 51) 19 0 0 0)
  52 (gn-dot-at? M (+ p 52) 2 f 0 0)
 false) (is-shape M p f r pc w (inc k)))))

(defn- ip-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i)] (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 83)) (not= (gn-op M p) OP-FN)) false
 (let [f (gn-sir M p IF-A) a (gn-sir M (+ p 8) IF-B) b (gn-sir M (+ p 13) IF-B)]
 (and (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f)) (= (gn-fnf M f FF-SIR) p)
 (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-NSLOTS) 8) (= (gn-fnf M f FF-DEPTH) 4)
 (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
 (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
 (= (gn-fnf M f (+ FF-PT0 3)) TY-I64)
 (= (gn-g M gn-f-leaf) 1) (= (gn-g M gn-f-freg) 1) (= (gn-g M gn-f-vmode) 3)
 (= (gn-g M gn-f-ns) 8) (= (gn-g M gn-f-dp) 4) (= (gn-g M gn-f-h) 0)
 (= (gn-g M gn-f-skip) 0) (> (gn-g M gn-f-fb) 0) (= (gn-g M gn-f-nsv) 4)
 (>= a 0) (<= a 4095) (>= b 0) (<= b 4095) (not= a b)
 (ip-shape M p f a b 0) (ip-labels M p 0)
 (= (gn-sreg M 1) 0) (= (gn-sreg M 2) 1) (= (gn-sreg M 3) 2) (= (gn-sreg M 4) 3))))))
;; pre: before the frame (kpre-entry). The parameters already live in x0..x3 and x8 is the leaf's private fuel:
;; the head loads it and pays the entry charge (an empty counter goes to the prologue, which traps), every guard
;; failure enters the prologue (which reloads x8), and the exit publishes x8 and returns.
(defn- ip-entry [M :vector-i64 i :i64] :vector-i64 (ip-entry2 M i false))
(defn- ip-entry2 [M :vector-i64 i :i64 pre :bool] :vector-i64
 (if (not (ip-admit M i)) M
 (let [p (dec i) a (gn-sir M (+ p 8) IF-B) b (gn-sir M (+ p 13) IF-B)
  distance (if (> a b) (- a b) (- b a)) G (vector-alloc 21)
 m0 (-> M (cond-> pre (-> (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-subs-i 8 8 1)) (ri-cold G (enc-cond-lo))))
  (gn-emit (enc-cmp-i 1 4095)) (ri-cold G 8)
  (gn-mov-imm 9 distance) (gn-emit (enc-cmp-r 1 9)) (ri-cold G 2)
  (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0)) (gn-emit (enc-sub-i 17 0 1))
  (gn-emit (enc-cmp-r 17 16)) (ri-cold G 2) (gn-emit (enc-ldr 16 7 320))
  (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 16 16 0))
  (gn-emit (enc-add-i 9 1 a)) (gn-emit (enc-cmp-r 9 16)) (ri-cold G 2)
  (gn-emit (enc-add-i 10 1 b)) (gn-emit (enc-cmp-r 10 16)) (ri-cold G 2)
  (gn-emit (enc-ldr 15 7 328)) (gn-emit (gn-e-addsl 15 15 17 3))
  (gn-emit (gn-e-addsl 12 15 9 3)) (gn-emit (gn-e-addsl 13 15 10 3))
  ;; x5 = j probes left; x10 = &a[-1] (sub x10, x12, x1, lsl #3 ; sub x10, x10, #8): the probe of a[x5 - 1] is
  ;; [x10, x5, lsl #3]
  (gn-mov 5 1) (gn-emit (+ (enc-sub-r 10 12 1) 0xc00)) (gn-emit (enc-sub-i 10 10 8)))
 ;; probe a[x5 - 1] down while it is > key (kernels B: two per step): while x5 > 1, ldp a[x5 - 2], a[x5 - 1] and
 ;; cmp/ccmp (#4: "le" when the upper one is <= key); a hit resolves which; one last single probe when x5 = 1
 m4 (-> m0 (gn-emit (enc-cmp-i 5 1)) (gn-emit (enc-bcond 9 9)) (gn-emit (gn-e-addsl 17 10 5 3)) (gn-emit 0xA97FA630)
  (gn-emit (enc-cmp-r 9 2)) (gn-emit 0xFA42C204) (gn-emit (enc-bcond 13 10)) (gn-emit (enc-sub-i 5 5 2))
  (gn-emit (enc-cmp-i 5 1)) (gn-emit (enc-bcond 8 -7)) (gn-emit (enc-cbz 5 9)) (gn-emit (gn-e-ldrr 16 10 5 1))
  (gn-emit (enc-cmp-r 16 2)) (gn-emit (enc-bcond 13 6)) (gn-emit (enc-sub-i 5 5 1)) (gn-emit (enc-b 4))
  (gn-emit (enc-cmp-r 9 2)) (gn-emit (enc-bcond 13 2)) (gn-emit (enc-sub-i 5 5 1)))
 ;; moved items x5 = j - left; then x12/x13 := the final slots a[j - x5], b[j - x5]
 m5 (-> m4
  (gn-emit (enc-sub-r 5 1 5))
  (gn-emit (enc-cmp-r 8 5)) (ri-cold G 3) (gn-emit (enc-sub-r 8 8 5))
  (gn-emit (+ (enc-sub-r 12 12 5) 0xc00)) (gn-emit (+ (enc-sub-r 13 13 5) 0xc00))) noCopy (vector-at m5 MM-CODE-N)
 ;; cbz x5, final ; the x5 moved items of each array go up by one item from the top down (kernels B): x10/x11 = one
 ;; past the top source items, x14/x15 one past the top destination; first x5 mod 4 single items (pre-decremented
 ;; ldr/str), then x5 / 4 blocks of four (ldp q / stp q, every block read before it is written; blocks never overlap
 ;; the next lower block's sources). Same values in the same cells as the original descending moves.
 m6 (-> m5 (gn-emit 0) (gn-emit (gn-e-addsl 10 12 5 3)) (gn-emit (enc-add-i 14 10 8))
  (gn-emit (gn-e-addsl 11 13 5 3)) (gn-emit (enc-add-i 15 11 8)) (gn-emit 0x924004A9) (gn-emit (enc-cbz 9 7))
  (gn-emit 0xF85F8D50) (gn-emit 0xF81F8DD0) (gn-emit 0xF85F8D70) (gn-emit 0xF81F8DF0) (gn-emit (enc-subs-i 9 9 1))
  (gn-emit (enc-bcond 1 -5)) (gn-emit (gn-e-lsr 9 5 2)) (gn-emit (enc-cbz 9 7))
  (gn-emit 0xADFF0540) (gn-emit 0xADBF05C0) (gn-emit 0xADFF0D62) (gn-emit 0xADBF0DE2) (gn-emit (enc-subs-i 9 9 1))
  (gn-emit (enc-bcond 1 -5))) final (vector-at m6 MM-CODE-N)
 m9 (-> m6 (gn-put (+ MM-CODE-BASE noCopy) (enc-cbz 5 (- final noCopy))) (gn-emit (enc-str 2 12 0)) (gn-emit (enc-str 3 13 0))
  (cond-> pre (-> (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (enc-ret))))
  (cond-> (not pre) (-> (gn-epilogue) (kb-keep) (gn-gs gn-f-dead 0)))) end (vector-at m9 MM-CODE-N)]
 (ri-patch m9 G 0 end))))
(defn- ip-labels [M :vector-i64 p :i64 k :i64] :bool
 (if (= k 5) true (let [o (case k 0 2 1 17 2 65 3 79 4 80 0) l (gn-sir M (+ p o) IF-A)]
  (and (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p o)) (ip-labels M p (inc k))))))
(defn- ip-shape [M :vector-i64 p :i64 f :i64 a :i64 b :i64 k :i64] :bool
 (if (= k 83) true (and (case k
  0 (gn-dot-at? M (+ p 0) 1 f 4 8)
  1 (gn-dot-at? M (+ p 1) 18 0 0 0)
  2 (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
  3 (gn-dot-at? M (+ p 3) 4 0 2 0)
  4 (gn-dot-at? M (+ p 4) 3 1 0 0)
  5 (gn-dot-at? M (+ p 5) 7 1 0 0)
  6 (gn-dot-at? M (+ p 6) 11 0 (gn-sir M (+ p 17) IF-A) 0)
  7 (gn-dot-at? M (+ p 7) 4 0 1 0)
  8 (gn-dot-at? M (+ p 8) 3 1 a 0)
  9 (gn-dot-at? M (+ p 9) 4 2 3 0)
  10 (gn-dot-at? M (+ p 10) 14 208 0 3)
  11 (gn-dot-at? M (+ p 11) 5 5 0 0)
  12 (gn-dot-at? M (+ p 12) 4 0 5 0)
  13 (gn-dot-at? M (+ p 13) 3 1 b 0)
  14 (gn-dot-at? M (+ p 14) 4 2 4 0)
  15 (gn-dot-at? M (+ p 15) 14 208 0 3)
  16 (gn-dot-at? M (+ p 16) 10 (gn-sir M (+ p 80) IF-A) 0 0)
  17 (gn-dot-at? M (+ p 17) 9 (gn-sir M (+ p 17) IF-A) 0 0)
  18 (gn-dot-at? M (+ p 18) 4 0 1 0)
  19 (gn-dot-at? M (+ p 19) 3 1 a 0)
  20 (gn-dot-at? M (+ p 20) 4 2 2 0)
  21 (gn-dot-at? M (+ p 21) 3 3 1 0)
  22 (gn-dot-at? M (+ p 22) 6 2 2 0)
  23 (gn-dot-at? M (+ p 23) 6 1 1 0)
  24 (gn-dot-at? M (+ p 24) 14 176 0 2)
  25 (gn-dot-at? M (+ p 25) 5 5 0 0)
  26 (gn-dot-at? M (+ p 26) 4 0 1 0)
  27 (gn-dot-at? M (+ p 27) 3 1 b 0)
  28 (gn-dot-at? M (+ p 28) 4 2 2 0)
  29 (gn-dot-at? M (+ p 29) 3 3 1 0)
  30 (gn-dot-at? M (+ p 30) 6 2 2 0)
  31 (gn-dot-at? M (+ p 31) 6 1 1 0)
  32 (gn-dot-at? M (+ p 32) 14 176 0 2)
  33 (gn-dot-at? M (+ p 33) 5 6 0 0)
  34 (gn-dot-at? M (+ p 34) 4 0 5 0)
  35 (gn-dot-at? M (+ p 35) 4 1 3 0)
  36 (gn-dot-at? M (+ p 36) 7 3 0 0)
  37 (gn-dot-at? M (+ p 37) 11 0 (gn-sir M (+ p 65) IF-A) 0)
  38 (gn-dot-at? M (+ p 38) 4 0 1 0)
  39 (gn-dot-at? M (+ p 39) 3 1 a 0)
  40 (gn-dot-at? M (+ p 40) 4 2 2 0)
  41 (gn-dot-at? M (+ p 41) 6 1 1 0)
  42 (gn-dot-at? M (+ p 42) 4 2 5 0)
  43 (gn-dot-at? M (+ p 43) 14 208 0 3)
  44 (gn-dot-at? M (+ p 44) 5 7 0 0)
  45 (gn-dot-at? M (+ p 45) 4 0 7 0)
  46 (gn-dot-at? M (+ p 46) 3 1 b 0)
  47 (gn-dot-at? M (+ p 47) 4 2 2 0)
  48 (gn-dot-at? M (+ p 48) 6 1 1 0)
  49 (gn-dot-at? M (+ p 49) 4 2 6 0)
  50 (gn-dot-at? M (+ p 50) 14 208 0 3)
  51 (gn-dot-at? M (+ p 51) 5 8 0 0)
  52 (gn-dot-at? M (+ p 52) 4 0 8 0)
  53 (gn-dot-at? M (+ p 53) 4 1 2 0)
  54 (gn-dot-at? M (+ p 54) 3 2 1 0)
  55 (gn-dot-at? M (+ p 55) 6 2 1 0)
  56 (gn-dot-at? M (+ p 56) 4 2 3 0)
  57 (gn-dot-at? M (+ p 57) 4 3 4 0)
  58 (gn-dot-at? M (+ p 58) 5 1 0 0)
  59 (gn-dot-at? M (+ p 59) 5 2 1 0)
  60 (gn-dot-at? M (+ p 60) 5 3 2 0)
  61 (gn-dot-at? M (+ p 61) 5 4 3 0)
  62 (gn-dot-at? M (+ p 62) 18 0 0 0)
  63 (gn-dot-at? M (+ p 63) 10 (gn-sir M (+ p 2) IF-A) 0 0)
  64 (gn-dot-at? M (+ p 64) 10 (gn-sir M (+ p 79) IF-A) 0 0)
  65 (gn-dot-at? M (+ p 65) 9 (gn-sir M (+ p 65) IF-A) 0 0)
  66 (gn-dot-at? M (+ p 66) 4 0 1 0)
  67 (gn-dot-at? M (+ p 67) 3 1 a 0)
  68 (gn-dot-at? M (+ p 68) 4 2 2 0)
  69 (gn-dot-at? M (+ p 69) 6 1 1 0)
  70 (gn-dot-at? M (+ p 70) 4 2 3 0)
  71 (gn-dot-at? M (+ p 71) 14 208 0 3)
  72 (gn-dot-at? M (+ p 72) 5 7 0 0)
  73 (gn-dot-at? M (+ p 73) 4 0 7 0)
  74 (gn-dot-at? M (+ p 74) 3 1 b 0)
  75 (gn-dot-at? M (+ p 75) 4 2 2 0)
  76 (gn-dot-at? M (+ p 76) 6 1 1 0)
  77 (gn-dot-at? M (+ p 77) 4 2 4 0)
  78 (gn-dot-at? M (+ p 78) 14 208 0 3)
  79 (gn-dot-at? M (+ p 79) 9 (gn-sir M (+ p 79) IF-A) 0 0)
  80 (gn-dot-at? M (+ p 80) 9 (gn-sir M (+ p 80) IF-A) 0 0)
  81 (gn-dot-at? M (+ p 81) 19 0 0 0)
  82 (gn-dot-at? M (+ p 82) 2 f 0 0)
 false) (ip-shape M p f a b (inc k)))))

(defn- rls-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i)]
  (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 106)) (not= (gn-op M p) OP-FN)) 0
   (let [f (gn-sir M p IF-A)]
    (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
     (let [n (gn-sir M (+ p 4) IF-B) base (gn-sir M (+ p 49) IF-B)
      end0 (gn-sir M (+ p 8) IF-B) end1 (gn-sir M (+ p 11) IF-B) reader (gn-sir M (+ p 23) IF-A)]
      (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 7)
       (= (gn-fnf M f FF-NSLOTS) 11) (= (gn-fnf M f FF-DEPTH) 9)
       (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (ck-pt M f 0) TY-VEC)
       (loop [k 1] (or (= k 7) (and (= (ck-pt M f k) TY-I64) (recur (inc k)))))
       (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
       (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
       (= (gn-g M gn-f-ns) 11) (= (gn-g M gn-f-dp) 9)
       (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (> (gn-g M gn-f-fb) 0)
       (>= n 1) (<= n 64) (>= base 0) (<= base 4095)
       (>= end0 0) (<= end0 4095) (>= end1 0) (<= end1 4095)
       (rls-shape M p f 0)
       (loop [k 0] (or (= k 13) (let [at (+ p (case k 0 2 1 15 2 25 3 30 4 38 5 42 6 56 7 58 8 86 9 88 10 90 11 92 103)) label (gn-sir M at IF-A)]
        (and (> label 0) (< label MM-LABEL-CAP) (= (gn-lpos M label) at) (recur (inc k))))))
       (loop [k 1] (or (= k 8) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
        (loop [j 1] (or (= j k) (and (not= (gn-sreg M k) (gn-sreg M j)) (recur (inc j))))) (recur (inc k)))))
       (> (qi-shape M reader) 0) (> (rls-writer M (gn-sir M (+ p 65) IF-A)) 0)
       (sw-writer M (gn-sir M (+ p 10) IF-A))) (qi-shape M reader) 0)))))))
;; d := n + 8 k (scratch x16 when 8 k is not an add immediate)
(defn- rls-addr [M :vector-i64 d :i64 n :i64 k :i64] :vector-i64
 (if (>= (enc-add-i d n (* 8 k)) 0) (gn-emit M (enc-add-i d n (* 8 k)))
  (-> M (gn-mov-imm 16 (* 8 k)) (gn-emit (enc-add-r d n 16)))))
(defn- rls-addk [M :vector-i64 d :i64 n :i64 k :i64] :vector-i64
 (if (>= (enc-add-i d n k) 0) (gn-emit M (enc-add-i d n k))
  (-> M (gn-mov-imm 16 k) (gn-emit (enc-add-r d n 16)))))
;; x := x & mask (an and #imm when mask + 1 is a power of two)
(defn- rls-andk [M :vector-i64 d :i64 n :i64 mask :i64] :vector-i64
 (let [b (gn-pow2 (inc mask))]
  (if (> b 0) (gn-emit M (gn-e-bf 0x92400000 d n 0 (dec b)))
   (-> M (gn-mov-imm 16 mask) (gn-emit (enc-and-r d n 16))))))
(defn- rls-reader [M :vector-i64 p :i64 k :i64] :i64
 (let [rp (gn-fnf M (gn-sir M (+ p 23) IF-A) FF-SIR)] (gn-sir M (+ rp (case k 0 6 1 10 4)) IF-B)))
;; axis 0 (x = index, y = row): x13 = &v[offset + row stride], the bit word is [x13, index >> s, lsl #3]
(defn- rls-setup0 [M :vector-i64 p :i64] :vector-i64
 (let [stride (rls-reader M p 1) offset (rls-reader M p 2)]
  (-> M (gn-mov-imm 16 stride) (gn-emit (enc-mul 10 (gn-sreg M 3) 16)) (rls-addk 10 10 offset)
   (gn-emit (gn-e-addsl 13 3 10 3)))))
;; axis 1 (x = row, y = index): x14 = the row's weight (table[row & (divisor - 1)]), x13 = &v[offset + (row >> s)],
;; x15 = 8 stride (when stride is not a power of two)
(defn- rls-setup1 [M :vector-i64 p :i64] :vector-i64
 (let [divisor (rls-reader M p 0) stride (rls-reader M p 1) offset (rls-reader M p 2) row (gn-sreg M 3)]
  (-> M (rls-andk 9 row (dec divisor)) (gn-emit (gn-e-ldrr 14 4 9 1))
   (gn-emit (gn-e-lsr 10 row (gn-pow2 divisor))) (rls-addk 10 10 offset) (gn-emit (gn-e-addsl 13 3 10 3))
   (cond-> (= (gn-pow2 stride) 0) (-> (gn-mov-imm 15 (* 8 stride)))))))
;; One element, branch-free after the bit: the run counter at h is read (in range, below the guarded top) and kept
;; when the bit repeats, else h advances and the counter restarts at 1; bw += 2 bit - 1 on axis 0.
(defn- rls-body2 [M :vector-i64 p :i64 ax :i64] :vector-i64
 (let [divisor (rls-reader M p 0) stride (rls-reader M p 1)
       index (gn-sreg M 4) h (gn-sreg M 5) previous (gn-sreg M 6) bw (gn-sreg M 7)
       mask (dec (rls-writer M (gn-sir M (+ p 65) IF-A)))
       m0 (if (= ax 0)
           (-> M (gn-emit (gn-e-lsr 11 index (gn-pow2 divisor))) (gn-emit (gn-e-ldrr 6 13 11 1))
            (rls-andk 9 index (dec divisor)) (gn-emit (gn-e-ldrr 16 4 9 1))
            (gn-emit (enc-rrr 0xea000000 31 6 16)))
           (-> M (cond-> (> (gn-pow2 stride) 0) (gn-emit (gn-e-addsl 11 13 index (+ 3 (gn-pow2 stride)))))
            (cond-> (= (gn-pow2 stride) 0) (gn-emit (enc-madd 11 index 15 13)))
            (gn-emit (enc-ldr 6 11 0)) (gn-emit (enc-rrr 0xea000000 31 6 14))))]
  ;; kernels B: with a mask 2^k - 1 (k >= 1) the current counter stays in x1 (loaded at h before the loop; the loop is the only
  ;; writer of the counters), unmasked: x1 + 1 when the bit repeats, else 1 (x5 = 1), stored as x1 & mask -- the same
  ;; stored values mod (mask + 1), with no store-to-load round trip and a one-instruction counter chain
  (-> m0 (gn-emit (enc-cset 6 (enc-cond-ne)))
   (cond-> (> (gn-pow2 (inc mask)) 0)
    (-> (gn-emit (enc-cmp-r previous 6)) (gn-emit (enc-csinc 1 5 1 (enc-cond-ne))) (gn-emit (enc-csinc h h h (enc-cond-eq)))
     (rls-andk 2 1 mask) (gn-emit (gn-e-strr3 2 12 h))))
   (cond-> (= (gn-pow2 (inc mask)) 0)
    (-> (gn-emit (gn-e-ldrr 10 12 h 1)) (gn-emit (enc-cmp-r previous 6))
     (gn-emit (enc-csel 10 10 31 (enc-cond-eq))) (gn-emit (enc-add-i 10 10 1))
     (gn-emit (enc-csinc h h h (enc-cond-eq))) (rls-andk 10 10 mask) (gn-emit (gn-e-strr3 10 12 h))))
   (cond-> (= ax 0) (-> (gn-emit (gn-e-addsl bw bw 6 1)) (gn-emit (enc-sub-i bw bw 1))))
   (gn-mov previous 6) (gn-emit (enc-add-i index index 1)))))
;; ---- rls axis 0 by bytes (kernels B, step 4): with the weights 128 >> k (divisor 8) and a 2^k - 1 counter mask, the
;; row's elements run in byte-aligned blocks of eight: the row byte is read once per block and each element's bit taken by
;; ubfx; per element as the source (and rls-body2): the bit against the previous one, the counter and h, the counter's
;; write at h, bw + 2 bit - 1. Unaligned head and tail elements use rls-body2.
(defn- rls-bytes? [M :vector-i64 p :i64 tree :i64] :bool
 (let [divisor (rls-reader M p 0) mask (dec (rls-writer M (gn-sir M (+ p 65) IF-A)))]
  (and (= divisor 8) (> (gn-pow2 (inc mask)) 0)
   (loop [k 0] (or (= k 8) (and (= (gn-tree-value M tree k) (i64-shift-right 128 k)) (recur (inc k))))))))
(defn- rls-byte-el [M :vector-i64 p :i64 k :i64] :vector-i64
 (let [h (gn-sreg M 5) previous (gn-sreg M 6) bw (gn-sreg M 7)
       mask (dec (rls-writer M (gn-sir M (+ p 65) IF-A)))
       t (if (= (bit-and k 1) 0) 6 9) prev (if (= k 0) previous (if (= (bit-and k 1) 0) 9 6))]
  (-> M (gn-emit (gn-e-bf 0xd3400000 t 10 (- 7 k) (- 7 k))) (gn-emit (enc-cmp-r prev t))
   (gn-emit (enc-csinc 1 5 1 (enc-cond-ne))) (gn-emit (enc-csinc h h h (enc-cond-eq)))
   (rls-andk 2 1 mask) (gn-emit (gn-e-strr3 2 12 h))
   (gn-emit (gn-e-addsl bw bw t 1)) (gn-emit (enc-sub-i bw bw 1)))))
(defn- rls-axis0-bytes [M :vector-i64 p :i64] :vector-i64
 (let [n (gn-sir M (+ p 4) IF-B) index (gn-sreg M 4) previous (gn-sreg M 6)
       headAt (vector-at M MM-CODE-N)
       m0 (gn-emit M (gn-e-bf 0xf2400000 31 index 0 2)) toBlock (vector-at m0 MM-CODE-N)
       m1 (-> (gn-emit m0 0) (rls-body2 p 0) (gn-emit (enc-cmp-i index n))) backH (vector-at m1 MM-CODE-N)
       m2 (gn-emit m1 (enc-bcond 1 (- headAt backH))) toDone1 (vector-at m2 MM-CODE-N)
       m3 (gn-emit m2 0) blockAt (vector-at m3 MM-CODE-N)
       m4 (-> m3 (gn-emit (enc-add-i 9 index 8)) (gn-emit (enc-cmp-i 9 n))) toTail (vector-at m4 MM-CODE-N)
       m5 (-> (gn-emit m4 0) (gn-emit (gn-e-ldrr 10 13 index 0))
           (rls-byte-el p 0) (rls-byte-el p 1) (rls-byte-el p 2) (rls-byte-el p 3)
           (rls-byte-el p 4) (rls-byte-el p 5) (rls-byte-el p 6) (rls-byte-el p 7)
           (gn-mov previous 9) (gn-emit (enc-add-i index index 8)) (gn-emit (enc-cmp-i index n))) backB (vector-at m5 MM-CODE-N)
       m6 (gn-emit m5 (enc-bcond 1 (- blockAt backB))) toDone2 (vector-at m6 MM-CODE-N)
       m7 (gn-emit m6 0) tailAt (vector-at m7 MM-CODE-N)
       m8 (-> m7 (rls-body2 p 0) (gn-emit (enc-cmp-i index n))) backT (vector-at m8 MM-CODE-N)
       m9 (gn-emit m8 (enc-bcond 1 (- tailAt backT))) done (vector-at m9 MM-CODE-N)]
  (-> m9 (gn-dot-patch toBlock blockAt (enc-cond-eq))
   (gn-put (+ MM-CODE-BASE toDone1) (enc-b (- done toDone1)))
   (gn-dot-patch toTail tailAt 8)
   (gn-put (+ MM-CODE-BASE toDone2) (enc-b (- done toDone2))))))
(defn- rls-entry [M :vector-i64 i :i64] :vector-i64
 (let [tree (rls-admit M i)] (if (= tree 0) M
  (let [p (dec i) n (gn-sir M (+ p 4) IF-B) base (gn-sir M (+ p 49) IF-B)
   end0 (gn-sir M (+ p 8) IF-B) end1 (gn-sir M (+ p 11) IF-B)
   reader (gn-sir M (+ p 23) IF-A) rp (gn-fnf M reader FF-SIR)
   divisor (gn-sir M (+ rp 6) IF-B) stride (gn-sir M (+ rp 10) IF-B) offset (gn-sir M (+ rp 4) IF-B)
   row (gn-sreg M 3) index (gn-sreg M 4) h (gn-sreg M 5) bw (gn-sreg M 7)
   G (vector-alloc 33) ctx (gn-g M gn-f-ctx)
   m0 (-> M (gn-emit (enc-cmp-i index n)) (ri-cold G 8)
    (gn-emit (enc-cmp-i row 4095)) (ri-cold G 8) (gn-emit (enc-cmp-i h 4095)) (ri-cold G 8)
    (gn-mov-imm 9 n) (gn-emit (enc-sub-r 9 9 index))
    (gn-emit (enc-add-r 11 h 9)) (gn-emit (enc-add-i 11 11 base))
    (gn-mov 10 row) (gn-emit (enc-cmp-i 10 (dec n)))) keepMax (vector-at m0 MM-CODE-N)
   m1 (-> m0 (gn-emit (enc-bcond (enc-cond-hs) 2)) (gn-mov-imm 10 (dec n))
    (gn-emit (gn-e-lsr 12 10 (gn-pow2 divisor))) (gn-mov-imm 16 stride)
    (gn-emit (enc-mul 10 10 16)) (gn-emit (enc-add-r 12 12 10)) (gn-emit (enc-add-i 12 12 offset))
    ;; This orientation certifies every counter write lies above every packed read.
    (gn-emit (enc-add-i 10 h base)) (gn-emit (enc-cmp-r 10 12)))
   m2 (-> m1 (ri-cold G 9) (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
    (gn-emit (enc-sub-i 17 (gn-sreg M 1) 1)) (gn-emit (enc-cmp-r 17 16)) (ri-cold G 2)
    (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 0 16 0))
    (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 0 16)) (ri-cold G 2)
    (gn-emit (enc-cmp-r 12 0)) (ri-cold G 2) (gn-emit (enc-cmp-r 11 0)) (ri-cold G 2)
    (gn-mov-imm 16 end0) (gn-emit (enc-cmp-r 16 0)) (ri-cold G 2)
    (gn-mov-imm 16 end1) (gn-emit (enc-cmp-r 16 0)) (ri-cold G 2)
    (gn-emit (enc-ldr 3 7 328)) (gn-emit (gn-e-addsl 3 3 17 3))
    (gn-mov-imm 16 3) (gn-emit (enc-mul 9 9 16)) (gn-emit (enc-add-i 9 9 2))
    (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9)) (ri-cold G 3)
    (gn-emit (enc-sub-r 8 8 9)) (gn-emit (enc-str 8 7 CTX-FUEL))) adr (vector-at m2 MM-CODE-N)
   m3 (-> m2 (gn-emit (gn-e-adr 4)) (gn-emit (enc-cmp-i index n))) noWork (vector-at m3 MM-CODE-N)
   ;; the axis is loop-invariant: x12 = &v[base] (run counters), one loop per orientation (cbnz axis)
   m4 (-> (gn-emit m3 0) (rls-addr 12 3 base) (gn-emit (gn-e-ldrr 1 12 h 1)) (gn-mov-imm 5 1)) axb (vector-at m4 MM-CODE-N)
   m5 (-> (gn-emit m4 0) (rls-setup0 p)) loop0 (vector-at m5 MM-CODE-N)
   m6a (if (rls-bytes? M p tree) (rls-axis0-bytes m5 p)
        (let [m6 (-> m5 (rls-body2 p 0) (gn-emit (enc-cmp-i index n))) back0 (vector-at m6 MM-CODE-N)]
         (gn-emit m6 (enc-bcond 1 (- loop0 back0))))) j0 (vector-at m6a MM-CODE-N)
   m6b (gn-emit m6a 0) ax1 (vector-at m6b MM-CODE-N)
   m6c (rls-setup1 m6b p) loop1 (vector-at m6c MM-CODE-N)
   m6d (-> m6c (rls-body2 p 1) (gn-emit (enc-cmp-i index n))) back1 (vector-at m6d MM-CODE-N)
   m6e (gn-emit m6d (enc-bcond 1 (- loop1 back1))) finish (vector-at m6e MM-CODE-N)
   m7 (-> m6e (gn-dot-patch noWork finish 0)
    (gn-put (+ MM-CODE-BASE axb) (enc-cbnz (gn-sreg M 2) (- ax1 axb)))
    (gn-put (+ MM-CODE-BASE j0) (enc-b (- finish j0)))
    (gn-mov-imm 11 end0) (gn-emit (gn-e-strr3 h 3 11))
    (gn-mov-imm 11 end1) (gn-emit (gn-e-strr3 bw 3 11))
    (gn-mov 0 (gn-sreg M 1)) (gn-vclear) (gn-epilogue) (gn-gs gn-f-dead 0)) table (vector-at m7 MM-CODE-N)
   m8 (gn-tree-data m7 tree 0 divisor) cold (vector-at m8 MM-CODE-N) delta (* (- table adr) 4)
   m9 (-> m8 (ri-patch G 0 cold)
    (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 4) (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5)))
    (gn-gs gn-f-ctx ctx))] m9))))
(defn- rls-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 106) true
  (let [n (gn-sir M (+ p 4) IF-B) end0 (gn-sir M (+ p 8) IF-B) end1 (gn-sir M (+ p 11) IF-B)
   base (gn-sir M (+ p 49) IF-B) reader (gn-sir M (+ p 23) IF-A)
   writer (gn-sir M (+ p 65) IF-A) endwriter (gn-sir M (+ p 10) IF-A)]
   (and (case k
   0 (gn-dot-at? M (+ p 0) OP-FN f 7 11)
   1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
   2 (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
   3 (gn-dot-at? M (+ p 3) OP-LGET 0 4 0)
   4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
   5 (gn-dot-at? M (+ p 5) OP-CMP 1 0 0)
   6 (gn-dot-at? M (+ p 6) OP-BRZ 0 (gn-sir M (+ p 15) IF-A) 0)
   7 (gn-dot-at? M (+ p 7) OP-LGET 0 1 0)
   8 (gn-dot-at? M (+ p 8) OP-CONST 1 end0 0)
   9 (gn-dot-at? M (+ p 9) OP-LGET 2 5 0)
   10 (gn-dot-at? M (+ p 10) OP-CALL endwriter 0 3)
   11 (gn-dot-at? M (+ p 11) OP-CONST 1 end1 0)
   12 (gn-dot-at? M (+ p 12) OP-LGET 2 7 0)
   13 (gn-dot-at? M (+ p 13) OP-CALL endwriter 0 3)
   14 (gn-dot-at? M (+ p 14) OP-BR (gn-sir M (+ p 103) IF-A) 0 0)
   15 (gn-dot-at? M (+ p 15) OP-LABEL (gn-sir M (+ p 15) IF-A) 0 0)
   16 (gn-dot-at? M (+ p 16) OP-LGET 0 2 0)
   17 (gn-dot-at? M (+ p 17) OP-CONST 1 0 0)
   18 (gn-dot-at? M (+ p 18) OP-CMP 1 0 0)
   19 (gn-dot-at? M (+ p 19) OP-BRZ 0 (gn-sir M (+ p 25) IF-A) 0)
   20 (gn-dot-at? M (+ p 20) OP-LGET 0 1 0)
   21 (gn-dot-at? M (+ p 21) OP-LGET 1 4 0)
   22 (gn-dot-at? M (+ p 22) OP-LGET 2 3 0)
   23 (gn-dot-at? M (+ p 23) OP-CALL reader 0 3)
   24 (gn-dot-at? M (+ p 24) OP-BR (gn-sir M (+ p 30) IF-A) 0 0)
   25 (gn-dot-at? M (+ p 25) OP-LABEL (gn-sir M (+ p 25) IF-A) 0 0)
   26 (gn-dot-at? M (+ p 26) OP-LGET 0 1 0)
   27 (gn-dot-at? M (+ p 27) OP-LGET 1 3 0)
   28 (gn-dot-at? M (+ p 28) OP-LGET 2 4 0)
   29 (gn-dot-at? M (+ p 29) OP-CALL reader 0 3)
   30 (gn-dot-at? M (+ p 30) OP-LABEL (gn-sir M (+ p 30) IF-A) 0 0)
   31 (gn-dot-at? M (+ p 31) OP-LSET 8 0 0)
   32 (gn-dot-at? M (+ p 32) OP-LGET 0 6 0)
   33 (gn-dot-at? M (+ p 33) OP-LGET 1 8 0)
   34 (gn-dot-at? M (+ p 34) OP-CMP 1 0 0)
   35 (gn-dot-at? M (+ p 35) OP-BRZ 0 (gn-sir M (+ p 38) IF-A) 0)
   36 (gn-dot-at? M (+ p 36) OP-LGET 0 5 0)
   37 (gn-dot-at? M (+ p 37) OP-BR (gn-sir M (+ p 42) IF-A) 0 0)
   38 (gn-dot-at? M (+ p 38) OP-LABEL (gn-sir M (+ p 38) IF-A) 0 0)
   39 (gn-dot-at? M (+ p 39) OP-LGET 0 5 0)
   40 (gn-dot-at? M (+ p 40) OP-CONST 1 1 0)
   41 (gn-dot-at? M (+ p 41) OP-BIN 1 0 0)
   42 (gn-dot-at? M (+ p 42) OP-LABEL (gn-sir M (+ p 42) IF-A) 0 0)
   43 (gn-dot-at? M (+ p 43) OP-LSET 9 0 0)
   44 (gn-dot-at? M (+ p 44) OP-LGET 0 6 0)
   45 (gn-dot-at? M (+ p 45) OP-LGET 1 8 0)
   46 (gn-dot-at? M (+ p 46) OP-CMP 1 0 0)
   47 (gn-dot-at? M (+ p 47) OP-BRZ 0 (gn-sir M (+ p 56) IF-A) 0)
   48 (gn-dot-at? M (+ p 48) OP-LGET 0 1 0)
   49 (gn-dot-at? M (+ p 49) OP-CONST 1 base 0)
   50 (gn-dot-at? M (+ p 50) OP-LGET 2 5 0)
   51 (gn-dot-at? M (+ p 51) OP-BIN 1 1 0)
   52 (gn-dot-at? M (+ p 52) OP-RT 176 0 2)
   53 (gn-dot-at? M (+ p 53) OP-CONST 1 1 0)
   54 (gn-dot-at? M (+ p 54) OP-BIN 1 0 0)
   55 (gn-dot-at? M (+ p 55) OP-BR (gn-sir M (+ p 58) IF-A) 0 0)
   56 (gn-dot-at? M (+ p 56) OP-LABEL (gn-sir M (+ p 56) IF-A) 0 0)
   57 (gn-dot-at? M (+ p 57) OP-CONST 0 1 0)
   58 (gn-dot-at? M (+ p 58) OP-LABEL (gn-sir M (+ p 58) IF-A) 0 0)
   59 (gn-dot-at? M (+ p 59) OP-LSET 10 0 0)
   60 (gn-dot-at? M (+ p 60) OP-LGET 0 1 0)
   61 (gn-dot-at? M (+ p 61) OP-CONST 1 base 0)
   62 (gn-dot-at? M (+ p 62) OP-LGET 2 9 0)
   63 (gn-dot-at? M (+ p 63) OP-BIN 1 1 0)
   64 (gn-dot-at? M (+ p 64) OP-LGET 2 10 0)
   65 (gn-dot-at? M (+ p 65) OP-CALL writer 0 3)
   66 (gn-dot-at? M (+ p 66) OP-LSET 11 0 0)
   67 (gn-dot-at? M (+ p 67) OP-LGET 0 11 0)
   68 (gn-dot-at? M (+ p 68) OP-LGET 1 2 0)
   69 (gn-dot-at? M (+ p 69) OP-LGET 2 3 0)
   70 (gn-dot-at? M (+ p 70) OP-LGET 3 4 0)
   71 (gn-dot-at? M (+ p 71) OP-CONST 4 1 0)
   72 (gn-dot-at? M (+ p 72) OP-BIN 1 3 0)
   73 (gn-dot-at? M (+ p 73) OP-LGET 4 9 0)
   74 (gn-dot-at? M (+ p 74) OP-LGET 5 8 0)
   75 (gn-dot-at? M (+ p 75) OP-LGET 6 7 0)
   76 (gn-dot-at? M (+ p 76) OP-LGET 7 2 0)
   77 (gn-dot-at? M (+ p 77) OP-CONST 8 0 0)
   78 (gn-dot-at? M (+ p 78) OP-CMP 1 7 0)
   79 (gn-dot-at? M (+ p 79) OP-BRZ 7 (gn-sir M (+ p 90) IF-A) 0)
   80 (gn-dot-at? M (+ p 80) OP-LGET 7 8 0)
   81 (gn-dot-at? M (+ p 81) OP-CONST 8 1 0)
   82 (gn-dot-at? M (+ p 82) OP-CMP 1 7 0)
   83 (gn-dot-at? M (+ p 83) OP-BRZ 7 (gn-sir M (+ p 86) IF-A) 0)
   84 (gn-dot-at? M (+ p 84) OP-CONST 7 1 0)
   85 (gn-dot-at? M (+ p 85) OP-BR (gn-sir M (+ p 88) IF-A) 0 0)
   86 (gn-dot-at? M (+ p 86) OP-LABEL (gn-sir M (+ p 86) IF-A) 0 0)
   87 (gn-dot-at? M (+ p 87) OP-CONST 7 -1 0)
   88 (gn-dot-at? M (+ p 88) OP-LABEL (gn-sir M (+ p 88) IF-A) 0 0)
   89 (gn-dot-at? M (+ p 89) OP-BR (gn-sir M (+ p 92) IF-A) 0 0)
   90 (gn-dot-at? M (+ p 90) OP-LABEL (gn-sir M (+ p 90) IF-A) 0 0)
   91 (gn-dot-at? M (+ p 91) OP-CONST 7 0 0)
   92 (gn-dot-at? M (+ p 92) OP-LABEL (gn-sir M (+ p 92) IF-A) 0 0)
   93 (gn-dot-at? M (+ p 93) OP-BIN 1 6 0)
   94 (gn-dot-at? M (+ p 94) OP-LSET 1 0 0)
   95 (gn-dot-at? M (+ p 95) OP-LSET 2 1 0)
   96 (gn-dot-at? M (+ p 96) OP-LSET 3 2 0)
   97 (gn-dot-at? M (+ p 97) OP-LSET 4 3 0)
   98 (gn-dot-at? M (+ p 98) OP-LSET 5 4 0)
   99 (gn-dot-at? M (+ p 99) OP-LSET 6 5 0)
   100 (gn-dot-at? M (+ p 100) OP-LSET 7 6 0)
   101 (gn-dot-at? M (+ p 101) OP-FUEL 0 0 0)
   102 (gn-dot-at? M (+ p 102) OP-BR (gn-sir M (+ p 2) IF-A) 0 0)
   103 (gn-dot-at? M (+ p 103) OP-LABEL (gn-sir M (+ p 103) IF-A) 0 0)
   104 (gn-dot-at? M (+ p 104) OP-RET 0 0 0)
   105 (gn-dot-at? M (+ p 105) OP-END f 0 0)
 false) (rls-shape M p f (inc k))))))
(defn- rls-writer [M :vector-i64 f :i64] :i64
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
 (let [p (gn-fnf M f FF-SIR)] (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 11))) 0
 (let [mask (gn-sir M (+ p 6) IF-B) label (gn-sir M (+ p 2) IF-A)]
  (if (and (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
   (= (gn-fnf M f FF-DEPTH) 4) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (= (ck-pt M f 0) TY-VEC) (= (ck-pt M f 1) TY-I64) (= (ck-pt M f 2) TY-I64)
   (>= mask 0) (<= mask 4294967295) (> label 0) (< label MM-LABEL-CAP) (= (gn-lpos M label) (+ p 2))
   (gn-dot-at? M p OP-FN f 3 3) (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
   (gn-dot-at? M (+ p 2) OP-LABEL label 0 0) (gn-dot-at? M (+ p 3) OP-LGET 0 1 0)
   (gn-dot-at? M (+ p 4) OP-LGET 1 2 0) (gn-dot-at? M (+ p 5) OP-LGET 2 3 0)
   (gn-dot-at? M (+ p 6) OP-CONST 3 mask 0) (gn-dot-at? M (+ p 7) OP-BIN BOP-AND 2 0)
   (gn-dot-at? M (+ p 8) OP-RT RT-VECTOR-ASSOC-IN-PLACE 0 3)
   (gn-dot-at? M (+ p 9) OP-RET 0 0 0) (gn-dot-at? M (+ p 10) OP-END f 0 0)) (inc mask) 0))))))

(defn- fourprobe-admit [M :vector-i64 i :i64] :i64
 (let [p (dec i)] (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 68)) (not= (gn-op M p) OP-FN)) 0
 (let [f (gn-sir M p IF-A)] (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (gn-clamp-open M f)) 0
 (let [n (gn-sir M (+ p 4) IF-B) reader (gn-sir M (+ p 13) IF-A)]
 (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 4) (= (gn-fnf M f FF-NSLOTS) 6)
 (= (gn-fnf M f FF-DEPTH) 5) (= (gn-fnf M f FF-RTYPE) TY-I64) (= (ck-pt M f 0) TY-VEC)
 (= (ck-pt M f 1) TY-I64) (= (ck-pt M f 2) TY-I64) (= (ck-pt M f 3) TY-I64)
 (= (gn-g M gn-f-leaf) 0) (= (gn-g M gn-f-freg) 0)
 (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))
 (= (gn-g M gn-f-ns) 6) (= (gn-g M gn-f-dp) 5) (= (gn-g M gn-f-h) 0)
 (= (gn-g M gn-f-skip) 0) (> (gn-g M gn-f-fb) 0) (>= n 1) (<= n 64)
 (fourprobe-shape M p f 0)
 (loop [k 0] (or (= k 6) (let [at (+ p (case k 0 2 1 9 2 43 3 55 4 57 65)) label (gn-sir M at IF-A)]
 (and (> label 0) (< label MM-LABEL-CAP) (= (gn-lpos M label) at) (recur (inc k))))))
 (loop [k 1] (or (= k 5) (and (>= (gn-sreg M k) 19) (<= (gn-sreg M k) 28)
 (loop [j 1] (or (= j k) (and (not= (gn-sreg M k) (gn-sreg M j)) (recur (inc j))))) (recur (inc k)))))
 (> (qi-shape M reader) 0)) (qi-shape M reader) 0)))))))
;; ---- fb2 (kernels B, step 4): blocks-row under fourprobe's admission and guards when the qr bit weights are 128 >> k
;; (divisor 8): per column as the source, b = bit (x, y), then the short-circuit chain bit (x + 1, y), bit (x, y + 1),
;; bit (x + 1, y + 1) compared with b, score + award when all hold, charges 3 + e1 + e1 e2 (the recur, two probes, one
;; per further probe evaluated). Byte-aligned blocks of eight columns read the rows' two bytes (and the next byte, the
;; one column x + 8 reads) once and take the bits by ubfx; the other columns go one by one.
(defn- fb2-bytes? [M :vector-i64 i :i64 tree :i64] :bool
 (let [p (dec i) rp (gn-fnf M (gn-sir M (+ p 13) IF-A) FF-SIR) divisor (gn-sir M (+ rp 6) IF-B)]
  (and (= divisor 8) (loop [k 0] (or (= k 8) (and (= (gn-tree-value M tree k) (i64-shift-right 128 k)) (recur (inc k))))))))
(defn- fb2-entry [M :vector-i64 i :i64 tree :i64] :vector-i64
 (let [p (dec i) n (gn-sir M (+ p 4) IF-B) award (gn-sir M (+ p 53) IF-B)
 reader (gn-sir M (+ p 13) IF-A) rp (gn-fnf M reader FF-SIR)
 divisor (gn-sir M (+ rp 6) IF-B) stride (gn-sir M (+ rp 10) IF-B) offset (gn-sir M (+ rp 4) IF-B)
 index (gn-sreg M 2) row (gn-sreg M 3) score (gn-sreg M 4)
 G (vector-alloc 33) ctx (gn-g M gn-f-ctx)
 m0 (-> M (gn-emit (enc-cmp-i index n)) (ri-cold G 8)
 (gn-emit (enc-cmp-i row 4094)) (ri-cold G 8)
 (gn-mov-imm 9 n) (gn-emit (enc-sub-r 9 9 index)) (gn-mov-imm 16 5) (gn-emit (enc-mul 9 9 16))
 (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9)) (ri-cold G 3)
 (gn-emit (enc-add-i 10 row 1)) (gn-mov-imm 16 stride) (gn-emit (enc-mul 10 10 16))
 (gn-mov-imm 11 (+ offset (quot n divisor))) (gn-emit (enc-add-r 11 11 10))
 (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
 (gn-emit (enc-sub-i 17 (gn-sreg M 1) 1)) (gn-emit (enc-cmp-r 17 16)) (ri-cold G 2)
 (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 0 16 0))
 (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 0 16)) (ri-cold G 2)
 (gn-emit (enc-cmp-r 11 0)) (ri-cold G 2)
 (gn-emit (enc-ldr 3 7 328)) (gn-emit (gn-e-addsl 3 3 17 3))
 (gn-mov-imm 12 stride) (gn-emit (enc-mul 12 row 12)) (gn-emit (enc-add-i 12 12 offset))
 (gn-emit (gn-e-addsl 14 3 12 3)) (rls-addr 15 14 stride)
 (gn-mov 2 index) (gn-mov 3 score) (gn-mov-imm 12 n) (gn-mov-imm 13 award)
 (kb-words G [0xEB0C005F 0x540016A2 0xF240085F 0x54000440 0xD343FC50 0x92400849 0xD2801011 0x9AC92631 0xF87079CA 0xF87079EB 0xEA11015F 0x9A9F07E5 0xEA11017F 0x9A9F07E6 0x91000449 0xD343FD30 0x92400929 0xD2801011 0x9AC92631 0xF87079CA 0xF87079EB 0xEA11015F 0x9A9F07E0 0xEA11017F 0x9A9F07E1 0xEB0000BF 0x9A9F17E9 0xFA4600A0 0x9A9F17EA 0xFA4100A0 0x8B0D006B 0x9A830163 0x8B0A0129 0x91000D29 0xCB090108 0x91000442 0x17FFFFDC 0x91002049 0xEB0C013F 0x54000D88 0x8B0201D0 0x8B0201F1 0xA940020A 0xA940062B 0xD2800004 0xD3471D45 0xD3471D66 0xD3461950 0xD3461971 0xEB1000BF 0x9A9F17E9 0xFA4600A0 0x9A891529 0xFA5100A0 0x8B090084 0x9A9F01A9 0x8B090063 0xAA1003E5 0xAA1103E6 0xD3451550 0xD3451571 0xEB1000BF 0x9A9F17E9 0xFA4600A0 0x9A891529 0xFA5100A0 0x8B090084 0x9A9F01A9 0x8B090063 0xAA1003E5 0xAA1103E6 0xD3441150 0xD3441171 0xEB1000BF 0x9A9F17E9 0xFA4600A0 0x9A891529 0xFA5100A0 0x8B090084 0x9A9F01A9 0x8B090063 0xAA1003E5 0xAA1103E6 0xD3430D50 0xD3430D71 0xEB1000BF 0x9A9F17E9 0xFA4600A0 0x9A891529 0xFA5100A0 0x8B090084 0x9A9F01A9 0x8B090063 0xAA1003E5 0xAA1103E6 0xD3420950 0xD3420971 0xEB1000BF 0x9A9F17E9 0xFA4600A0 0x9A891529 0xFA5100A0 0x8B090084 0x9A9F01A9 0x8B090063 0xAA1003E5 0xAA1103E6 0xD3410550 0xD3410571 0xEB1000BF 0x9A9F17E9 0xFA4600A0 0x9A891529 0xFA5100A0 0x8B090084 0x9A9F01A9 0x8B090063 0xAA1003E5 0xAA1103E6 0xD3400150]) (kb-words G [0xD3400171 0xEB1000BF 0x9A9F17E9 0xFA4600A0 0x9A891529 0xFA5100A0 0x8B090084 0x9A9F01A9 0x8B090063 0xAA1003E5 0xAA1103E6 0xD3471C10 0xD3471C31 0xEB1000BF 0x9A9F17E9 0xFA4600A0 0x9A891529 0xFA5100A0 0x8B090084 0x9A9F01A9 0x8B090063 0xAA1003E5 0xAA1103E6 0x91006084 0xCB040108 0x91002042 0x17FFFF93 0xEB0C005F 0x54000442 0xD343FC50 0x92400849 0xD2801011 0x9AC92631 0xF87079CA 0xF87079EB 0xEA11015F 0x9A9F07E5 0xEA11017F 0x9A9F07E6 0x91000449 0xD343FD30 0x92400929 0xD2801011 0x9AC92631 0xF87079CA 0xF87079EB 0xEA11015F 0x9A9F07E0 0xEA11017F 0x9A9F07E1 0xEB0000BF 0x9A9F17E9 0xFA4600A0 0x9A9F17EA 0xFA4100A0 0x8B0D006B 0x9A830163 0x8B0A0129 0x91000D29 0xCB090108 0x91000442 0x17FFFFDE])
 (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-mov 0 3) (gn-vclear) (gn-epilogue) (gn-gs gn-f-dead 0))
 cold (vector-at m0 MM-CODE-N)]
 (-> m0 (ri-patch G 0 cold) (gn-gs gn-f-ctx ctx))))
(defn- fourprobe-entry [M :vector-i64 i :i64] :vector-i64
 (let [tree (fourprobe-admit M i)] (if (= tree 0) M
 (if (fb2-bytes? M i tree) (fb2-entry M i tree)
 (let [p (dec i) n (gn-sir M (+ p 4) IF-B) award (gn-sir M (+ p 53) IF-B)
 reader (gn-sir M (+ p 13) IF-A) rp (gn-fnf M reader FF-SIR)
 divisor (gn-sir M (+ rp 6) IF-B) stride (gn-sir M (+ rp 10) IF-B) offset (gn-sir M (+ rp 4) IF-B)
 index (gn-sreg M 2) row (gn-sreg M 3) score (gn-sreg M 4)
 G (vector-alloc 33) ctx (gn-g M gn-f-ctx)
 m0 (-> M (gn-emit (enc-cmp-i index n)) (ri-cold G 8)
 (gn-emit (enc-cmp-i row 4094)) (ri-cold G 8)
 (gn-mov-imm 9 n) (gn-emit (enc-sub-r 9 9 index)) (gn-mov-imm 16 5) (gn-emit (enc-mul 9 9 16))
 (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-emit (enc-cmp-r 8 9)) (ri-cold G 3)
 (gn-emit (enc-add-i 10 row 1)) (gn-mov-imm 16 stride) (gn-emit (enc-mul 10 10 16))
 (gn-mov-imm 11 (+ offset (quot n divisor))) (gn-emit (enc-add-r 11 11 10))
 (gn-emit (enc-ldr 16 7 312)) (gn-emit (enc-ldr 16 16 0))
 (gn-emit (enc-sub-i 17 (gn-sreg M 1) 1)) (gn-emit (enc-cmp-r 17 16)) (ri-cold G 2)
 (gn-emit (enc-ldr 16 7 320)) (gn-emit (gn-e-addsl 16 16 17 4)) (gn-emit (enc-ldp 17 0 16 0))
 (gn-mov-imm 16 1152921504606846976) (gn-emit (enc-cmp-r 0 16)) (ri-cold G 2)
 (gn-emit (enc-cmp-r 11 0)) (ri-cold G 2)
 (gn-emit (enc-ldr 3 7 328)) (gn-emit (gn-e-addsl 3 3 17 3))
 ;; X12 is an invariant rowbase; complete range guards precede this physical scratch assignment.
 (gn-mov-imm 12 stride) (gn-emit (enc-mul 12 row 12)) (gn-emit (enc-add-i 12 12 offset))) adr (vector-at m0 MM-CODE-N)
 m1 (-> m0 (gn-emit (gn-e-adr 4)) (gn-emit (enc-cmp-i index n))) noWork (vector-at m1 MM-CODE-N)
 ;; Fuel8 is a private exact remaining tally of the original short-circuit: 3 per column plus one for each further
 ;; evaluated probe (3 + e1 + e1 e2). All four probes are in the guarded range, so each column reads them all,
 ;; branch-free: x14/x15 = rows y and y + 1, x5/x6 = the bits of column x, x0/x1 those of column x + 1, carried.
 m2 (-> (gn-emit m1 0) (gn-emit (gn-e-addsl 14 3 12 3)) (rls-addr 15 14 stride)
     (fourprobe-col p index 5 6)) loopAt (vector-at m2 MM-CODE-N)
 m3 (-> m2 (gn-emit (enc-add-i 2 index 1)) (fourprobe-col p 2 0 1)
     (gn-emit (enc-cmp-r 5 0)) (gn-emit (enc-cset 2 (enc-cond-eq)))
     (gn-emit (fourprobe-ccmp 5 6)) (gn-emit (enc-cset 10 (enc-cond-eq)))
     (gn-emit (fourprobe-ccmp 5 1)) (rls-addk 11 score award) (gn-emit (enc-csel score 11 score (enc-cond-eq)))
     (gn-emit (enc-add-r 2 2 10)) (gn-emit (enc-add-i 2 2 3)) (gn-emit (enc-sub-r 8 8 2))
     (gn-mov 5 0) (gn-mov 6 1)
     (gn-emit (enc-add-i index index 1)) (gn-emit (enc-cmp-i index n))) back (vector-at m3 MM-CODE-N)
 m8 (gn-emit m3 (enc-bcond 1 (- loopAt back))) finish (vector-at m8 MM-CODE-N)
 m9 (-> m8 (gn-dot-patch noWork finish 0) (gn-emit (enc-str 8 7 CTX-FUEL))
 (gn-mov 0 score) (gn-vclear) (gn-epilogue) (gn-gs gn-f-dead 0)) table (vector-at m9 MM-CODE-N)
 m10 (gn-tree-data m9 tree 0 divisor) cold (vector-at m10 MM-CODE-N) delta (* (- table adr) 4)
 m11 (-> m10 (ri-patch G 0 cold)
 (gn-put (+ MM-CODE-BASE adr) (+ (gn-e-adr 4) (i64-shift-left (bit-and delta 3) 29) (i64-shift-left (i64-shift-right delta 2) 5)))
 (gn-gs gn-f-ctx ctx))] m11)))))
;; ccmp xa, xb, #0, eq
(defn- fourprobe-ccmp [a :i64 b :i64] :i64 (+ 0xfa400000 (i64-shift-left b 16) (i64-shift-left a 5)))
;; the bits of column x (register xr) in rows y (d0) and y + 1 (d1)
(defn- fourprobe-col [M :vector-i64 p :i64 xr :i64 d0 :i64 d1 :i64] :vector-i64
 (let [rp (gn-fnf M (gn-sir M (+ p 13) IF-A) FF-SIR) divisor (gn-sir M (+ rp 6) IF-B)]
  (-> M (gn-emit (gn-e-lsr 11 xr (gn-pow2 divisor))) (rls-andk 9 xr (dec divisor)) (gn-emit (gn-e-ldrr 16 4 9 1))
   (gn-emit (gn-e-ldrr 10 14 11 1)) (gn-emit (gn-e-ldrr 17 15 11 1))
   (gn-emit (enc-rrr 0xea000000 31 10 16)) (gn-emit (enc-cset d0 (enc-cond-ne)))
   (gn-emit (enc-rrr 0xea000000 31 17 16)) (gn-emit (enc-cset d1 (enc-cond-ne))))))
(defn- fourprobe-shape [M :vector-i64 p :i64 f :i64 k :i64] :bool
 (if (= k 68) true (let [n (gn-sir M (+ p 4) IF-B) award (gn-sir M (+ p 53) IF-B) reader (gn-sir M (+ p 13) IF-A)]
 (and (case k
   0 (gn-dot-at? M (+ p 0) OP-FN f 4 6)
   1 (gn-dot-at? M (+ p 1) OP-FUEL 0 0 0)
   2 (gn-dot-at? M (+ p 2) OP-LABEL (gn-sir M (+ p 2) IF-A) 0 0)
   3 (gn-dot-at? M (+ p 3) OP-LGET 0 2 0)
   4 (gn-dot-at? M (+ p 4) OP-CONST 1 n 0)
   5 (gn-dot-at? M (+ p 5) OP-CMP 1 0 0)
   6 (gn-dot-at? M (+ p 6) OP-BRZ 0 (gn-sir M (+ p 9) IF-A) 0)
   7 (gn-dot-at? M (+ p 7) OP-LGET 0 4 0)
   8 (gn-dot-at? M (+ p 8) OP-BR (gn-sir M (+ p 65) IF-A) 0 0)
   9 (gn-dot-at? M (+ p 9) OP-LABEL (gn-sir M (+ p 9) IF-A) 0 0)
   10 (gn-dot-at? M (+ p 10) OP-LGET 0 1 0)
   11 (gn-dot-at? M (+ p 11) OP-LGET 1 2 0)
   12 (gn-dot-at? M (+ p 12) OP-LGET 2 3 0)
   13 (gn-dot-at? M (+ p 13) OP-CALL reader 0 3)
   14 (gn-dot-at? M (+ p 14) OP-LSET 5 0 0)
   15 (gn-dot-at? M (+ p 15) OP-LGET 0 5 0)
   16 (gn-dot-at? M (+ p 16) OP-LGET 1 1 0)
   17 (gn-dot-at? M (+ p 17) OP-LGET 2 2 0)
   18 (gn-dot-at? M (+ p 18) OP-CONST 3 1 0)
   19 (gn-dot-at? M (+ p 19) OP-BIN 1 2 0)
   20 (gn-dot-at? M (+ p 20) OP-LGET 3 3 0)
   21 (gn-dot-at? M (+ p 21) OP-CALL reader 1 3)
   22 (gn-dot-at? M (+ p 22) OP-CMP 1 0 0)
   23 (gn-dot-at? M (+ p 23) OP-BRZ 0 (gn-sir M (+ p 43) IF-A) 0)
   24 (gn-dot-at? M (+ p 24) OP-LGET 0 5 0)
   25 (gn-dot-at? M (+ p 25) OP-LGET 1 1 0)
   26 (gn-dot-at? M (+ p 26) OP-LGET 2 2 0)
   27 (gn-dot-at? M (+ p 27) OP-LGET 3 3 0)
   28 (gn-dot-at? M (+ p 28) OP-CONST 4 1 0)
   29 (gn-dot-at? M (+ p 29) OP-BIN 1 3 0)
   30 (gn-dot-at? M (+ p 30) OP-CALL reader 1 3)
   31 (gn-dot-at? M (+ p 31) OP-CMP 1 0 0)
   32 (gn-dot-at? M (+ p 32) OP-BRZ 0 (gn-sir M (+ p 43) IF-A) 0)
   33 (gn-dot-at? M (+ p 33) OP-LGET 0 5 0)
   34 (gn-dot-at? M (+ p 34) OP-LGET 1 1 0)
   35 (gn-dot-at? M (+ p 35) OP-LGET 2 2 0)
   36 (gn-dot-at? M (+ p 36) OP-CONST 3 1 0)
   37 (gn-dot-at? M (+ p 37) OP-BIN 1 2 0)
   38 (gn-dot-at? M (+ p 38) OP-LGET 3 3 0)
   39 (gn-dot-at? M (+ p 39) OP-CONST 4 1 0)
   40 (gn-dot-at? M (+ p 40) OP-BIN 1 3 0)
   41 (gn-dot-at? M (+ p 41) OP-CALL reader 1 3)
   42 (gn-dot-at? M (+ p 42) OP-CMP 1 0 0)
   43 (gn-dot-at? M (+ p 43) OP-LABEL (gn-sir M (+ p 43) IF-A) 0 0)
   44 (gn-dot-at? M (+ p 44) OP-LSET 6 0 0)
   45 (gn-dot-at? M (+ p 45) OP-LGET 0 1 0)
   46 (gn-dot-at? M (+ p 46) OP-LGET 1 2 0)
   47 (gn-dot-at? M (+ p 47) OP-CONST 2 1 0)
   48 (gn-dot-at? M (+ p 48) OP-BIN 1 1 0)
   49 (gn-dot-at? M (+ p 49) OP-LGET 2 3 0)
   50 (gn-dot-at? M (+ p 50) OP-LGET 3 4 0)
   51 (gn-dot-at? M (+ p 51) OP-LGET 4 6 0)
   52 (gn-dot-at? M (+ p 52) OP-BRZ 4 (gn-sir M (+ p 55) IF-A) 0)
   53 (gn-dot-at? M (+ p 53) OP-CONST 4 award 0)
   54 (gn-dot-at? M (+ p 54) OP-BR (gn-sir M (+ p 57) IF-A) 0 0)
   55 (gn-dot-at? M (+ p 55) OP-LABEL (gn-sir M (+ p 55) IF-A) 0 0)
   56 (gn-dot-at? M (+ p 56) OP-CONST 4 0 0)
   57 (gn-dot-at? M (+ p 57) OP-LABEL (gn-sir M (+ p 57) IF-A) 0 0)
   58 (gn-dot-at? M (+ p 58) OP-BIN 1 3 0)
   59 (gn-dot-at? M (+ p 59) OP-LSET 1 0 0)
   60 (gn-dot-at? M (+ p 60) OP-LSET 2 1 0)
   61 (gn-dot-at? M (+ p 61) OP-LSET 3 2 0)
   62 (gn-dot-at? M (+ p 62) OP-LSET 4 3 0)
   63 (gn-dot-at? M (+ p 63) OP-FUEL 0 0 0)
   64 (gn-dot-at? M (+ p 64) OP-BR (gn-sir M (+ p 2) IF-A) 0 0)
   65 (gn-dot-at? M (+ p 65) OP-LABEL (gn-sir M (+ p 65) IF-A) 0 0)
   66 (gn-dot-at? M (+ p 66) OP-RET 0 0 0)
   67 (gn-dot-at? M (+ p 67) OP-END f 0 0)
 false) (fourprobe-shape M p f (inc k))))))

(defn- ar-admit [M :vector-i64 i :i64] :i64
 (if (or (<= i 1) (not= (gn-op M (dec i)) OP-FN)
  (not= (gn-g M gn-f-leaf) 0) (not= (gn-g M gn-f-freg) 0)
  (not (or (= (gn-g M gn-f-vmode) 0) (= (gn-g M gn-f-vmode) -1))) (not= (gn-g M gn-f-ns) 16)
  (not= (gn-g M gn-f-dp) 8) (not= (gn-g M gn-f-nsv) 10)
  (not= (gn-g M gn-f-h) 0) (not= (gn-g M gn-f-skip) 0)) 0
  (let [p (dec i) f (gn-sir M p IF-A)]
   (if (or (<= f 0) (>= f (vector-at M MM-FN-N))
    (> p (- (vector-at M MM-SIR-N) 327))) 0
   (let [tf (gn-sir M (+ p 72) IF-A) limit (gn-sir M (+ p 18) IF-B)
    base (gn-sir M (+ p 10) IF-B)]
    (if (or (<= tf 0) (>= tf (vector-at M MM-FN-N))) 0
    (let [q (gn-fnf M tf FF-SIR)]
     (if (or (<= q 0) (> q (- (vector-at M MM-SIR-N) 67))) 0
     (let [tp (ti-shape M tf)]
    (if (and (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 7)
     (= (gn-fnf M f FF-NSLOTS) 16) (= (gn-fnf M f FF-DEPTH) 8)
     (= (gn-fnf M f FF-RTYPE) TY-VEC) (= (gn-fnf M f FF-PT0) TY-VEC)
     (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64)
     (= (gn-fnf M f (+ FF-PT0 3)) TY-I64) (= (gn-fnf M f (+ FF-PT0 4)) TY-I64)
     (= (td-pt M f 5) TY-I64) (= (td-pt M f 6) TY-I64)
     (>= limit 2) (<= limit 64) (>= base 0) (<= (+ base (* limit 4)) 4095)
     (> tp 0) (= (gn-sir M (+ tp 5) IF-B) 0) (ar-regs M 1 1) (ar-labels M p 0 0)
     (ar-part0 M p f tf limit base)
     (ar-part1 M p f tf limit base)
     (ar-part2 M p f tf limit base)
     (ar-part3 M p f tf limit base)
     (ar-part4 M p f tf limit base)
     (ar-part5 M p f tf limit base)
    ) p 0))))))))))
;; ---- AES last round in the ar kernel. ar-admit leaves the r = limit arms (four last-round calls and the output
;; through write-word) unchecked, as the kernel used to hand r = limit to the generic code. art-* check them: each
;; last-round arm mirrors its table-round arm (same ops and operands, labels at the same relative places) but calls
;; lr; the output part is exact; lr, box, byte-at, or4 and write-word are exact, the two boxes' tables cover 0..255.
(defn- art-rel [M :vector-i64 a :i64 b :i64 t :i64 e :i64] :bool
 (let [la (gn-lpos M a) lb (gn-lpos M b)]
  (and (> a 0) (< a MM-LABEL-CAP) (> b 0) (< b MM-LABEL-CAP) (= (- la t) (- lb e)))))
(defn- art-mirror [M :vector-i64 t :i64 e :i64 n :i64 lr :i64 tf :i64 k :i64] :bool
 (if (= k n) true
  (let [a (+ t k) b (+ e k) op (gn-op M a)
        ia (gn-sir M a IF-A) ib (gn-sir M b IF-A) ja (gn-sir M a IF-B) jb (gn-sir M b IF-B)
        ka (gn-sir M a IF-C) kb (gn-sir M b IF-C)]
   (and (= op (gn-op M b))
        (cond (= op OP-LABEL) (and (art-rel M ia ib t e) (= (gn-lpos M ia) a))
              (= op OP-BR) (art-rel M ia ib t e)
              (= op OP-BRZ) (and (= ia ib) (art-rel M ja jb t e) (= ka kb))
              (= op OP-CALL) (and (= ia lr) (= ib tf) (= ja jb) (= ka kb))
              (or (= op OP-LGET) (= op OP-CONST) (= op OP-CMP) (= op OP-BIN) (= op OP-RT))
               (and (= ia ib) (= ja jb) (= ka kb))
              :else false)
        (art-mirror M t e n lr tf (inc k))))))
;; the exact SIRs (packed patterns, mdc-value placeholders T[0] = the function, T[k] = its k-th callee):
;; byte-at (u64-shift-right x n) & 255 and or4 (a | b) | (c | d), no charge; box (if (= mode 0) (es i) (ds i)), one
;; charge; last-round key ^ or4(box(mode, a&255), box(mode, b>>8&255) << 8, .. c 16, .. d 24), one charge; write-word
;; (s at v): s[at + j] := byte-at(v, 8j) for j = 0..3 in order, one charge; the output part p + 265 .. p + 304 of rounds
;; (out = (if (= mode 0) 120 376) + s[634], four write-words of t0..t3)
(defn- art-bt-pat [] :string "0001fff6000200020009fc17000000000004000000010000000400010002000000060009000000000003000100ff0000000600050000000000130000000000000002fff600000000")
(defn- art-o4-pat [] :string "0001fff6000400040009fc1700000000000400000001000000040001000200000006000600000000000400010003000000040002000400000006000600010000000600060000000000130000000000000002fff600000000")
(defn- art-box-pat [] :string "0001fff60002000200120000000000000009fc1600000000000400000001000000030001000000000007000100000000000b0000fc0e00000004000000020000000dfff500000001000afc0b000000000009fc0e000000000004000000020000000dfff4000000010009fc0b0000000000130000000000000002fff600000000")
(defn- art-lr-pat [] :string "")
(defn- art-ww-pat [] :string "")
(defn- art-out-pat [] :string "")
;; g's SIR start when g is a function whose n + 1 ops fit, else 0
(defn- art-q [M :vector-i64 g :i64 n :i64] :i64
 (if (and (> g 0) (< g (vector-at M MM-FN-N)) (not (gn-clamp-open M g)) (> (gn-fnf M g FF-SIR) 0)
          (< (+ (gn-fnf M g FF-SIR) n) (vector-at M MM-SIR-N))) (gn-fnf M g FF-SIR) 0))
(defn- art-lab? [M :vector-i64 q :i64 k :i64] :bool (fo-label? M (gn-sir M (+ q k) IF-A) (+ q k)))
(defn- art-bt? [M :vector-i64 g :i64] :bool
 (let [q (art-q M g 8)]
  (and (> q 0) (= (gn-fnf M g FF-RTYPE) TY-I64) (= (gn-fnf M g FF-PT0) TY-I64) (= (gn-fnf M g (+ FF-PT0 1)) TY-I64)
       (art-lab? M q 1) (kpat-smatch M q (art-bt-pat) [g]))))
(defn- art-o4? [M :vector-i64 g :i64] :bool
 (let [q (art-q M g 10)]
  (and (> q 0) (= (gn-fnf M g FF-RTYPE) TY-I64) (art-lab? M q 1) (kpat-smatch M q (art-o4-pat) [g]))))
;; a charged table helper whose two literal parts cover 0..255
(defn- art-tab [M :vector-i64 g :i64] :i64
 (let [lit (tb-shape M g) q (+ (gn-fnf M g FF-SIR) 3)]
  (if (and (> lit 0) (>= (+ (gn-sir M (+ q 1) IF-B) (gn-sir M (+ q 11) IF-C)) 256)) lit 0)))
;; box's table literal of arm `branch` (0: es, 1: ds), else 0
(defn- art-box [M :vector-i64 g :i64 branch :i64] :i64
 (let [q (art-q M g 15) es (gn-sir M (+ q 8) IF-A) ds (gn-sir M (+ q 12) IF-A)]
  (if (and (> q 0) (= (gn-fnf M g FF-RTYPE) TY-I64) (art-lab? M q 2) (art-lab? M q 10) (art-lab? M q 13)
           (kpat-smatch M q (art-box-pat) [g es ds]))
   (art-tab M (if (= branch 0) es ds)) 0)))
;; last-round's sbox literal of arm `branch`, else 0
(defn- art-lr [M :vector-i64 g :i64 branch :i64] :i64
 (let [q (art-q M g 33) bt (gn-sir M (+ q 7) IF-A) bx (gn-sir M (+ q 8) IF-A) o4 (gn-sir M (+ q 30) IF-A)]
  (if (and (> q 0) (= (gn-fnf M g FF-RTYPE) TY-I64) (art-lab? M q 2) (not= bt g) (not= bx g) (not= o4 g)
       (kpat-smatch M q (art-lr-pat) [g bt bx o4]) (art-bt? M bt) (art-o4? M o4))
   (art-box M bx branch) 0)))
(defn- art-ww? [M :vector-i64 g :i64 bt :i64] :bool
 (let [q (art-q M g 37)]
  (and (> q 0) (= (gn-fnf M g FF-RTYPE) TY-VEC) (= (gn-fnf M g FF-PT0) TY-VEC) (art-lab? M q 2)
       (kpat-smatch M q (art-ww-pat) [g bt]))))
(defn- art-out? [M :vector-i64 p :i64 ww :i64] :bool
 (and (art-lab? M p 271) (art-lab? M p 273) (kpat-smatch M (+ p 265) (art-out-pat) [0 ww])))
;; the sbox literal of arm `branch` when the whole r = limit part is the AES last round, else 0
(defn- art-admit [M :vector-i64 p :i64 branch :i64] :i64
 (let [lr (gn-sir M (+ p 45) IF-A) tf (gn-sir M (+ p 72) IF-A) ww (gn-sir M (+ p 282) IF-A)
       lq (kfn-q M lr) bt (gn-sir M (+ lq 7) IF-A) f (gn-sir M p IF-A)]
  (if (and (> lr 0) (< lr (vector-at M MM-FN-N)) (not= lr f) (not= ww f) (> ww 0) (< ww (vector-at M MM-FN-N))
       (art-mirror M (+ p 21) (+ p 48) 25 lr tf 0) (gn-dot-at? M (+ p 46) OP-BR (gn-sir M (+ p 73) IF-A) 0 0)
       (art-mirror M (+ p 79) (+ p 108) 27 lr tf 0) (gn-dot-at? M (+ p 106) OP-BR (gn-sir M (+ p 135) IF-A) 0 0)
       (art-mirror M (+ p 141) (+ p 170) 27 lr tf 0) (gn-dot-at? M (+ p 168) OP-BR (gn-sir M (+ p 197) IF-A) 0 0)
       (art-mirror M (+ p 203) (+ p 232) 27 lr tf 0) (gn-dot-at? M (+ p 230) OP-BR (gn-sir M (+ p 259) IF-A) 0 0)
       (art-out? M p ww) (art-ww? M ww bt))
   (art-lr M lr branch) 0)))
(defn- art-orl [d :i64 n :i64 m :i64 sh :i64] :i64 (+ (enc-orr-r d n m) (* sh 1024)))
;; t_k into x(10 + k): the four sbox bytes of the arm's argument order or-ed, then ^ the round key at x4 + 8k
(defn- art-w [M :vector-i64 k :i64 j :i64] :i64 (gn-sreg M (+ 4 (rem (+ k j) 4))))
(defn- art-word [M :vector-i64 branch :i64 k :i64] :vector-i64
 (let [a (art-w M k 0) b (art-w M k (if (= branch 0) 1 3)) c (art-w M k 2) d (art-w M k (if (= branch 0) 3 1))
       t (+ 10 k)]
  (-> M (gn-emit (gn-e-bf 0xd3400000 9 a 0 7)) (gn-emit (gn-e-ldrr t 5 9 1))
   (gn-emit (gn-e-bf 0xd3400000 9 b 8 15)) (gn-emit (gn-e-ldrr 16 5 9 1)) (gn-emit (art-orl t t 16 8))
   (gn-emit (gn-e-bf 0xd3400000 9 c 16 23)) (gn-emit (gn-e-ldrr 16 5 9 1)) (gn-emit (art-orl t t 16 16))
   (gn-emit (gn-e-bf 0xd3400000 9 d 24 31)) (gn-emit (gn-e-ldrr 16 5 9 1)) (gn-emit (art-orl t t 16 24))
   (gn-emit (enc-ldr 16 4 (* 8 k))) (gn-emit (enc-eor-r t t 16)))))
;; after the arm's rounds (state in the w slots, x4 = &s[at], x8 the published fuel): guards fuel >= 40 (4 last-round
;; calls of 1 + 4 (box + its table), 4 write-words), K < length and 0 <= out = ob + s[K] <= length - 16; any failure
;; goes to `fail` (r := limit and the generic code, as before). Then 40 is paid, t0..t3 computed, the 16 byte stores
;; made in write-word order, and the function returns s.
(defn- art-tail [M :vector-i64 p :i64 branch :i64 lit :i64 G :vector-i64] :vector-i64
 (let [K (gn-sir M (+ p 275) IF-B) ob (gn-sir M (+ p (if (= branch 0) 269 272)) IF-B) rs (gn-sreg M 1)]
  (-> M (gn-emit (enc-cmp-i 8 40)) (ri-cold G (enc-cond-lo))
   (gn-emit (enc-sub-i 16 rs 1)) (gn-emit (enc-ldr 17 7 320)) (gn-emit (gn-e-addsl 17 17 16 4))
   (gn-emit (enc-ldp 9 10 17 0)) (gn-emit (enc-cmp-i 10 (inc K))) (ri-cold G (enc-cond-lo))
   (gn-emit (enc-ldr 16 7 328)) (gn-emit (gn-e-addsl 9 16 9 3)) (gn-emit (enc-ldr 16 9 (* 8 K)))
   (gn-emit (enc-add-i 16 16 ob)) (gn-emit (enc-sub-i 17 10 16)) (gn-emit (enc-cmp-r 16 17)) (ri-cold G 8)
   (gn-emit (enc-sub-i 8 8 40)) (gn-emit (enc-str 8 7 CTX-FUEL)) (gn-emit (gn-e-addsl 6 9 16 3))
   (gn-emit (enc-ldr 5 7 CTX-CODE-BASE)) (gn-fix FX-LIT32 lit)
   (gn-emit (enc-movz 17 0 0)) (gn-emit (enc-movk 17 0 1)) (gn-emit (enc-add-r 5 5 17))
   (art-word branch 0) (art-word branch 1) (art-word branch 2) (art-word branch 3)
   (art-stores 0)
   (gn-mov 0 rs) (gn-epilogue) (gn-gs gn-f-dead 0))))
(defn- art-stores [M :vector-i64 k :i64] :vector-i64
 (if (= k 16) M
  (art-stores (-> M (gn-emit (gn-e-bf 0xd3400000 9 (+ 10 (quot k 4)) (* 8 (rem k 4)) (+ 7 (* 8 (rem k 4)))))
                    (gn-emit (enc-str 9 6 (* 8 k)))) (inc k))))
(defn- ar-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (ar-admit M i)]
  (if (= p 0) M
   (let [limit (gn-sir M (+ p 18) IF-B) base (gn-sir M (+ p 10) IF-B)
    tp (ti-shape M (gn-sir M (+ p 72) IF-A)) G (vector-alloc 33)
    rs (gn-sreg M 1) rm (gn-sreg M 2) rr (gn-sreg M 3)
    m0 (-> M (gn-emit (enc-cmp-i rr 1)) (ri-cold G (enc-cond-lo))
     (gn-emit (enc-cmp-i rr limit)) (ri-cold G (enc-cond-hs))
     (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov-imm 5 limit)
     (gn-emit (enc-sub-r 5 5 rr)) (gn-mov-imm 16 25) (gn-emit (enc-mul 6 5 16))
     (gn-emit (enc-cmp-r 8 6)) (ri-cold G (enc-cond-lo))
     (gn-emit (enc-sub-i 16 rs 1)) (gn-emit (enc-ldr 17 7 312))
     (gn-emit (enc-ldr 17 17 0)) (gn-emit (enc-cmp-r 16 17)) (ri-cold G (enc-cond-hs))
     (gn-emit (enc-ldr 17 7 320)) (gn-emit (gn-e-lsl 16 16 4))
     (gn-emit (enc-add-r 17 17 16)) (gn-emit (enc-ldp 9 10 17 0))
     (gn-emit (enc-cmp-i rm 0))) mode (vector-at m0 MM-CODE-N)
    m1 (-> m0 (gn-emit (enc-bcond (enc-cond-ne) 0)) (gn-mov-imm 11 0)) bm (vector-at m1 MM-CODE-N)
    m2 (gn-emit m1 (enc-b 0)) alt (vector-at m2 MM-CODE-N)
    m3 (gn-mov-imm m2 11 base) join (vector-at m3 MM-CODE-N)
    m4 (-> m3 (gn-put (+ MM-CODE-BASE bm) (enc-b (- join bm)))
     (gn-dot-patch mode alt (enc-cond-ne))
     (gn-mov-imm 16 (* limit 4)) (gn-emit (enc-add-r 16 16 11))
     (gn-emit (enc-cmp-r 16 10)) (ri-cold G 8)
     (gn-emit (gn-e-lsl 16 rr 2)) (gn-emit (enc-add-r 16 16 11))
     (gn-emit (enc-add-r 16 16 9)) (gn-emit (enc-ldr 4 7 328))
     (gn-emit (gn-e-addsl 4 4 16 3))
     (gn-emit (enc-sub-r 8 8 6)) (gn-emit (enc-str 8 7 CTX-FUEL))
     (gn-emit (enc-cmp-i rm 0))) mb (vector-at m4 MM-CODE-N)
    ;; each arm may finish the last round itself (art-tail); its failing guards and the arms without it reach `done`
    lit0 (art-admit M p 0) lit1 (art-admit M p 1) T (vector-alloc 13)
    m5 (ar-loop (gn-emit m4 (enc-bcond (enc-cond-ne) 0)) tp 0)
    m5t (if (> lit0 0) (art-tail m5 p 0 lit0 T) m5) bj (vector-at m5t MM-CODE-N)
    m6 (gn-emit m5t (enc-b 0)) decpath (vector-at m6 MM-CODE-N)
    m7 (ar-loop m6 tp 1)
    m7t (if (> lit1 0) (art-tail m7 p 1 lit1 T) m7) done (vector-at m7t MM-CODE-N)
    m8 (-> m7t (gn-dot-patch mb decpath (enc-cond-ne))
     (gn-put (+ MM-CODE-BASE bj) (enc-b (- done bj))) (ri-patch T 0 done)
     (gn-mov-imm rr limit) (gn-jump (gn-sir M (+ p 2) IF-A))) cold (vector-at m8 MM-CODE-N)]
   (ri-patch m8 G 0 cold)))))
(defn- ar-labels [M :vector-i64 p :i64 j :i64 k :i64] :bool
 (cond (= j 327) true (= k j) (ar-labels M p (inc j) 0)
  (and (= (gn-op M (+ p j)) OP-LABEL)
   (or (<= (gn-sir M (+ p j) IF-A) 0) (>= (gn-sir M (+ p j) IF-A) MM-LABEL-CAP)
    (not= (gn-lpos M (gn-sir M (+ p j) IF-A)) (+ p j)))) false
  (and (= (gn-op M (+ p j)) OP-LABEL) (= (gn-op M (+ p k)) OP-LABEL)
   (= (gn-sir M (+ p j) IF-A) (gn-sir M (+ p k) IF-A))) false
  :else (ar-labels M p j (inc k))))
;; Two rounds per iteration without moves: round A reads the state registers (w0..w3 slots) into x10..x13, round B
;; reads x10..x13 back into the state registers; an odd count leaves after round A and moves once. Each round's
;; four key words come as two ldp pairs (the loop has no stores).
(defn- ar-loop [M :vector-i64 tp :i64 branch :i64] :vector-i64
 (let [m0 (ar-tables M tp branch 0) head (vector-at m0 MM-CODE-N)
  m1 (-> (ar-words2 m0 tp branch 0 0) (gn-emit (enc-add-i 4 4 32)) (gn-emit (enc-subs-i 5 5 1)))
  ea (vector-at m1 MM-CODE-N)
  m2 (-> (ar-words2 (gn-emit m1 (enc-bcond (enc-cond-eq) 0)) tp branch 1 0)
    (gn-emit (enc-add-i 4 4 32)) (gn-emit (enc-subs-i 5 5 1))) back (vector-at m2 MM-CODE-N)
  m3 (gn-emit m2 (enc-bcond (enc-cond-ne) (- head back))) bj (vector-at m3 MM-CODE-N)
  m4 (gn-emit m3 (enc-b 0)) exit-a (vector-at m4 MM-CODE-N)
  m5 (-> m4 (gn-mov (gn-sreg M 4) 10) (gn-mov (gn-sreg M 5) 11)
    (gn-mov (gn-sreg M 6) 12) (gn-mov (gn-sreg M 7) 13)) done (vector-at m5 MM-CODE-N)]
  (-> m5 (gn-put (+ MM-CODE-BASE ea) (enc-bcond (enc-cond-eq) (- exit-a ea)))
   (gn-put (+ MM-CODE-BASE bj) (enc-b (- done bj))))))
;; kind 0: state registers -> x10..x13, kind 1: x10..x13 -> state registers
(defn- ar-dst [M :vector-i64 kind :i64 row :i64] :i64 (if (= kind 0) (+ 10 row) (gn-sreg M (+ 4 row))))
(defn- ar-word2 [M :vector-i64 tp :i64 branch :i64 kind :i64 row :i64 col :i64] :vector-i64
 (if (= col 4) M
  (let [slot (inc (rem (+ row (if (= branch 0) col (- 4 col))) 4))
   q (+ tp 4 (* col 15)) sh (gn-sir M (+ q 5) IF-B) src (if (= kind 0) (gn-sreg M (+ slot 3)) (+ 9 slot))
   d (ar-dst M kind row)]
   (ar-word2 (-> M (gn-emit (gn-e-bf 0xd3400000 9 src sh (+ sh 7)))
    (gn-emit (gn-e-ldrr 16 col 9 1)) (gn-emit (enc-eor-r d d 16))) tp branch kind row (inc col)))))
(defn- ar-words2 [M :vector-i64 tp :i64 branch :i64 kind :i64 row :i64] :vector-i64
 (if (= row 4) M
  (ar-words2 (ar-word2 (cond-> M (= (bit-and row 1) 0)
                         (gn-emit (enc-ldp (ar-dst M kind row) (ar-dst M kind (inc row)) 4 (* row 8))))
              tp branch kind row 0) tp branch kind (inc row))))
(defn- ar-part0 [M :vector-i64 p :i64 f :i64 tf :i64 limit :i64 base :i64] :bool
 (and
    (gn-dot-at? M (+ p 0) 1 f 7 16)
    (gn-dot-at? M (+ p 1) 18 0 0 0)
    (gn-dot-at? M (+ p 2) 9 (gn-sir M (+ p 2) IF-A) 0 0)
    (gn-dot-at? M (+ p 3) 4 0 2 0)
    (gn-dot-at? M (+ p 4) 3 1 0 0)
    (gn-dot-at? M (+ p 5) 7 1 0 0)
    (gn-dot-at? M (+ p 6) 11 0 (gn-sir M (+ p 9) IF-A) 0)
    (gn-dot-at? M (+ p 7) 3 0 0 0)
    (gn-dot-at? M (+ p 8) 10 (gn-sir M (+ p 11) IF-A) 0 0)
    (gn-dot-at? M (+ p 9) 9 (gn-sir M (+ p 9) IF-A) 0 0)
    (gn-dot-at? M (+ p 10) 3 0 base 0)
    (gn-dot-at? M (+ p 11) 9 (gn-sir M (+ p 11) IF-A) 0 0)
    (gn-dot-at? M (+ p 12) 4 1 3 0)
    (gn-dot-at? M (+ p 13) 3 2 4 0)
    (gn-dot-at? M (+ p 14) 6 3 1 0)
    (gn-dot-at? M (+ p 15) 6 1 0 0)
    (gn-dot-at? M (+ p 16) 5 8 0 0)
    (gn-dot-at? M (+ p 17) 4 0 3 0)
    (gn-dot-at? M (+ p 18) 3 1 limit 0)
    (gn-dot-at? M (+ p 19) 7 1 0 0)
    (gn-dot-at? M (+ p 20) 11 0 (gn-sir M (+ p 47) IF-A) 0)
    (gn-dot-at? M (+ p 47) 9 (gn-sir M (+ p 47) IF-A) 0 0)
    (gn-dot-at? M (+ p 48) 4 0 2 0)
    (gn-dot-at? M (+ p 49) 4 1 4 0)
    (gn-dot-at? M (+ p 50) 4 2 2 0)
    (gn-dot-at? M (+ p 51) 3 3 0 0)
    (gn-dot-at? M (+ p 52) 7 1 2 0)
    (gn-dot-at? M (+ p 53) 11 2 (gn-sir M (+ p 56) IF-A) 0)
    (gn-dot-at? M (+ p 54) 4 2 5 0)
    (gn-dot-at? M (+ p 55) 10 (gn-sir M (+ p 58) IF-A) 0 0)
    (gn-dot-at? M (+ p 56) 9 (gn-sir M (+ p 56) IF-A) 0 0)
    (gn-dot-at? M (+ p 57) 4 2 7 0)))
(defn- ar-part1 [M :vector-i64 p :i64 f :i64 tf :i64 limit :i64 base :i64] :bool
 (and
    (gn-dot-at? M (+ p 58) 9 (gn-sir M (+ p 58) IF-A) 0 0)
    (gn-dot-at? M (+ p 59) 4 3 6 0)
    (gn-dot-at? M (+ p 60) 4 4 2 0)
    (gn-dot-at? M (+ p 61) 3 5 0 0)
    (gn-dot-at? M (+ p 62) 7 1 4 0)
    (gn-dot-at? M (+ p 63) 11 4 (gn-sir M (+ p 66) IF-A) 0)
    (gn-dot-at? M (+ p 64) 4 4 7 0)
    (gn-dot-at? M (+ p 65) 10 (gn-sir M (+ p 68) IF-A) 0 0)
    (gn-dot-at? M (+ p 66) 9 (gn-sir M (+ p 66) IF-A) 0 0)
    (gn-dot-at? M (+ p 67) 4 4 5 0)
    (gn-dot-at? M (+ p 68) 9 (gn-sir M (+ p 68) IF-A) 0 0)
    (gn-dot-at? M (+ p 69) 4 5 1 0)
    (gn-dot-at? M (+ p 70) 4 6 8 0)
    (gn-dot-at? M (+ p 71) 14 176 5 2)
    (gn-dot-at? M (+ p 72) 13 tf 0 6)
    (gn-dot-at? M (+ p 73) 9 (gn-sir M (+ p 73) IF-A) 0 0)
    (gn-dot-at? M (+ p 74) 5 9 0 0)
    (gn-dot-at? M (+ p 75) 4 0 3 0)
    (gn-dot-at? M (+ p 76) 3 1 limit 0)
    (gn-dot-at? M (+ p 77) 7 1 0 0)
    (gn-dot-at? M (+ p 78) 11 0 (gn-sir M (+ p 107) IF-A) 0)
    (gn-dot-at? M (+ p 107) 9 (gn-sir M (+ p 107) IF-A) 0 0)
    (gn-dot-at? M (+ p 108) 4 0 2 0)
    (gn-dot-at? M (+ p 109) 4 1 5 0)
    (gn-dot-at? M (+ p 110) 4 2 2 0)
    (gn-dot-at? M (+ p 111) 3 3 0 0)
    (gn-dot-at? M (+ p 112) 7 1 2 0)
    (gn-dot-at? M (+ p 113) 11 2 (gn-sir M (+ p 116) IF-A) 0)
    (gn-dot-at? M (+ p 114) 4 2 6 0)
    (gn-dot-at? M (+ p 115) 10 (gn-sir M (+ p 118) IF-A) 0 0)
    (gn-dot-at? M (+ p 116) 9 (gn-sir M (+ p 116) IF-A) 0 0)
    (gn-dot-at? M (+ p 117) 4 2 4 0)))
(defn- ar-part2 [M :vector-i64 p :i64 f :i64 tf :i64 limit :i64 base :i64] :bool
 (and
    (gn-dot-at? M (+ p 118) 9 (gn-sir M (+ p 118) IF-A) 0 0)
    (gn-dot-at? M (+ p 119) 4 3 7 0)
    (gn-dot-at? M (+ p 120) 4 4 2 0)
    (gn-dot-at? M (+ p 121) 3 5 0 0)
    (gn-dot-at? M (+ p 122) 7 1 4 0)
    (gn-dot-at? M (+ p 123) 11 4 (gn-sir M (+ p 126) IF-A) 0)
    (gn-dot-at? M (+ p 124) 4 4 4 0)
    (gn-dot-at? M (+ p 125) 10 (gn-sir M (+ p 128) IF-A) 0 0)
    (gn-dot-at? M (+ p 126) 9 (gn-sir M (+ p 126) IF-A) 0 0)
    (gn-dot-at? M (+ p 127) 4 4 6 0)
    (gn-dot-at? M (+ p 128) 9 (gn-sir M (+ p 128) IF-A) 0 0)
    (gn-dot-at? M (+ p 129) 4 5 1 0)
    (gn-dot-at? M (+ p 130) 4 6 8 0)
    (gn-dot-at? M (+ p 131) 3 7 1 0)
    (gn-dot-at? M (+ p 132) 6 1 6 0)
    (gn-dot-at? M (+ p 133) 14 176 5 2)
    (gn-dot-at? M (+ p 134) 13 tf 0 6)
    (gn-dot-at? M (+ p 135) 9 (gn-sir M (+ p 135) IF-A) 0 0)
    (gn-dot-at? M (+ p 136) 5 10 0 0)
    (gn-dot-at? M (+ p 137) 4 0 3 0)
    (gn-dot-at? M (+ p 138) 3 1 limit 0)
    (gn-dot-at? M (+ p 139) 7 1 0 0)
    (gn-dot-at? M (+ p 140) 11 0 (gn-sir M (+ p 169) IF-A) 0)
    (gn-dot-at? M (+ p 169) 9 (gn-sir M (+ p 169) IF-A) 0 0)
    (gn-dot-at? M (+ p 170) 4 0 2 0)
    (gn-dot-at? M (+ p 171) 4 1 6 0)
    (gn-dot-at? M (+ p 172) 4 2 2 0)
