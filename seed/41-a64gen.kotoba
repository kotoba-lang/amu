(defn- hbt-code [] :string "~d/X;'nGk`p;udDaq*:J>q*4umd/X:]lOX+^;udBeq*:VBM\\-R5WB`c^nH:$X;ud@pq*:bEM\\-Eeq*YhTq*Y\\Qq*Y8Jq*YDOWWWFcWWWFdWW<4fdXV>AnGj[r;ud%QWWN@jnGiU)RZ5e`dXVB/nGkkiRZ5/.R`utOP!D.+ZiCH5nH8kW;ud87ph>$CZiC)8nH8b4;ud6_d/X>BP!C$[OT5P6P!C$:WXo0,dXV?-b6%dInGiU)RZ5e`nGkkiRZ5/.R`utOP!D.+P'@t$W^S&Md/Y:>OT7+plO*]B;ud%nWWN@jnGiU)RZ5e`dXVB/nGkkiRZ5/.R`utOP!D.+ZiC;FnH8kW;ud+Hph>$CZiC)8nH8b4;ud)pd/X>BP!C$[OT5P6P!C$:WXo0,b6%c^nGiU)RZ5e`nGkkiRZ5/.R`utOP!D.+dXV?-b6%c_b74QJP!C!sOT6hh'EA+@b6n;[P!C!sWXAprnGiU)RZ5e`dXVB/nGkkiRZ5/.R`utOP!D.+dXVB.b5hXGdXV<MRa!#$Ra)>]q*5)HlO3e9;ucqDb7\"CWq#g`_q#gldq#h/gq#h;iq#h`#q#CQ]emANpeH7K)")
(defn- hbt-admit [M :vector-i64 i :i64] :bool
 (let [p (dec i) f (gn-sir M p IF-A)]
  (and (> p 0) (< (+ p 102) (vector-at M MM-SIR-N)) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N))
   (= (gn-fnf M f FF-SIR) p) (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-PT0) TY-VEC)
   (= (gn-fnf M f (+ FF-PT0 1)) TY-I64) (= (gn-fnf M f (+ FF-PT0 2)) TY-I64) (= (gn-fnf M f FF-RTYPE) TY-VEC)
   (let [rb (gn-sir M (+ p 23) IF-A) p8 (gn-sir M (+ p 72) IF-A) pw (gn-sir M (+ p 86) IF-A) p16 (gn-sir M (+ p 88) IF-A)
         pt (gn-sir M (+ p 99) IF-A) rq (kfn-q M rb) oc (if (> rq 0) (gn-sir M (+ rq 15) IF-A) 0)
         oq (kfn-q M oc) ch (if (> oq 0) (gn-sir M (+ oq 4) IF-A) 0) st (if (> oq 0) (gn-sir M (+ oq 34) IF-A) 0)
         cq (kfn-q M ch) rf (if (> cq 0) (gn-sir M (+ cq 10) IF-A) 0)]
    (and (> rq 0) (> oq 0) (> cq 0) (not= rb f) (not= pw f)
     (pj-fn? M f 102 (hbt-pat) [f rb p8 pw p16 pt 65280]) (pj-fn? M rb 34 (hbr-pat) [rb pw p16 oc])
     (pj-fn? M pw 133 (hbp-pat) [pw 32768 65536])
     (pj-fn? M oc 52 (hfo-pat) [oc ch st pt]) (pj-fn? M ch 73 (hfh-pat) [ch rf p8 pt])
     (pj-fn? M p8 11 (hf8-pat) [p8 pt]) (pj-fn? M p16 11 (hf16-pat) [p16 pt 65535]) (pj-fn? M pt 9 (pj-put-pat) [pt]))))))
(defn- hbt-entry [M :vector-i64 i :i64] :vector-i64 (if (hbt-admit M i) (kemit-hex M (hbt-code)) M))

;; ---- picojpeg ac-coefficients: (f v table quant k) decodes a block's AC coefficients from k: per step huff-symbol (a
;; bit, then huff-code's code-length walk), size = symbol & 15, run = symbol >> 4; size > 0: bits(size, 1), the run's
;; coefficients zeroed (zero-coefficients through zag), extend(extra, size) times v[quant + next] stored as i16 at
;; v[1536 + zag(next)], k = next + 1; size 0 and run 15: sixteen zeros; size 0 otherwise: zeros to 64 and return. The
;; whole loop runs before the frame with the bit reader's cells (v[256 257 259 260 263]) in registers (stored at the
;; end): each step is computed from a copy of them, its charges summed (huff-symbol 1 + bit 6 / 17 with a refill,
;; huff-code 1 + 7 / 18 per further bit + 2, bits 6 + 12 per large + 10 per second refill (its quotient of the 16-bit
;; result by pow(16 - size) a shift), zeros 1 + 2 each, extend 1, put 1, the loop 1) and checked against the counter
;; with one charge kept for lu-style re-entry, and only then are the zeros and the coefficient stored. Size 0's zeros to
;; 64 (the end of block) are zero-coefficients' own stores, zag(k) .. zag(63) in order: a computed branch at k into a
;; run of 64 str xzr whose offsets are written at emission from zag's table. A step needing anything else -- char's
;; refill from the input (v[257] = 0), an input offset v[256] >= 256, the marker byte 255, a run past 63 (fail) or fuel
;; short -- restores the copy, stores the cells, publishes the steps done (not the entry charge) and enters
;; ac-coefficients' own code at that k, which charges its entry (the loop charge it stands for). Guards: table 0..3, 0
;; <= k <= 64, v live past item 1599 and quant + 63 inside it. zag's table comes from its threshold tree (values checked
;; to be 0..63); the block was generated and checked, the re-entry included, against the source semantics outside the
;; compiler. The SIRs of ac-coefficients, huff-symbol, zero-coefficients, extend and the reader's functions are packed
;; patterns. The block has a counted loop over its table, a strong kernel: T2 does not replace it whether or not it
;; compiles the function.
