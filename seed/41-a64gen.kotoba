  (gn-emit (pz-tbz 10 0 2)) (gn-emit 0xF800861F) (gn-emit (pz-tbz 10 1 2)) (gn-emit 0xA8817E1F)
  (gn-emit (pz-tbz 10 2 2)) (gn-emit 0xAC814210) (gn-emit (gn-e-lsr 11 9 4)) (gn-emit (enc-cbz 11 18))
  ;; two aligned 64-byte lines per step by dc zva when DCZID_EL0 = 4 (zeroing allowed, 64-byte blocks: zeroing without
  ;; a read), else by q pairs
  (gn-emit 0xD53B00EA) (gn-emit (enc-cmp-i 10 4)) (gn-emit (enc-bcond (enc-cond-ne) 8))
  (gn-emit 0xD50B7430) (gn-emit (enc-add-i 16 16 64)) (gn-emit 0xD50B7430) (gn-emit (enc-add-i 16 16 64))
  (gn-emit (enc-subs-i 11 11 1)) (gn-emit (enc-bcond (enc-cond-ne) -5)) (gn-emit (enc-b 8))
  (gn-emit (pz-stpq 16 0)) (gn-emit (pz-stpq 16 32)) (gn-emit (pz-stpq 16 64)) (gn-emit (pz-stpq 16 96))
  (gn-emit (enc-add-i 16 16 128)) (gn-emit (enc-subs-i 11 11 1)) (gn-emit (enc-bcond (enc-cond-ne) -6))
  (gn-emit (pz-tbz 9 3 3)) (gn-emit 0xAC814210) (gn-emit 0xAC814210) (gn-emit (pz-tbz 9 2 2)) (gn-emit 0xAC814210)
  (gn-emit (pz-tbz 9 1 2)) (gn-emit 0xA8817E1F) (gn-emit (pz-tbz 9 0 2)) (gn-emit 0xF800861F)))
;; handle check of the vector in r (leaf kernels; x16/x17 scratch): cold unless valid with length below 2^60; x(len) :=
;; its length, x(base) := &items[0]
(defn- kb-vec [M :vector-i64 G :vector-i64 r :i64 len :i64 base :i64] :vector-i64
