;; ---- hp (kernels B, round 3): sglib-combined heap stage. (heap-add v i): for i .. 99, v[720 + i] := (input i), heap-up
;; (swap v[720 + i / 2], v[720 + i] while the parent is smaller); (heap-drain v n): for n .. 1, v[0] += v[720], v[720] :=
;; v[720 + n - 1], heap-down from 0 within n - 1 (the larger child, left first, swaps while it is larger). Charges: put 1,
;; swap 3, heap-up / heap-down 1 + one per further step, the recur 1. Non-leaf (slots in callee-saved registers, fuel in
;; memory, freg 0 or 2). Fast paths when v is valid with |v| >= 820 and 0 <= i (n) <= 100: an iteration runs while the fuel
;; covers 40 more (at most 7 levels); the used charges are paid and the loop head goes on from i (n).
(defn- hp-head [M :vector-i64 p :i64 f :i64 n :i64] :bool
 (and (> p 0) (= (gn-op M p) OP-FN) (> f 0) (< f (vector-at M MM-FN-N)) (not (gn-clamp-open M f))
      (= (gn-fnf M f FF-SIR) p) (< (+ p n) (vector-at M MM-SIR-N)) (= (gn-fnf M f FF-PT0) TY-VEC)
      (= (gn-g M gn-f-leaf) 0) (or (= (gn-g M gn-f-freg) 0) (= (gn-g M gn-f-freg) 2)) (= (gn-g M gn-f-ctx) 1)
      (= (gn-g M gn-f-h) 0) (= (gn-g M gn-f-skip) 0) (= (gn-g M gn-f-dead) 0) (fo-label? M (gn-sir M (+ p 2) IF-A) (+ p 2))
      (>= (gn-sreg M 1) 19) (<= (gn-sreg M 1) 28) (>= (gn-sreg M 2) 19) (<= (gn-sreg M 2) 28)))
;; the common tail: pay x5, x8 := the fuel (freg 2), the slot := x1, to the loop head; the keep marker after the branch
(defn- hp-tail [M :vector-i64 p :i64 r :i64] :vector-i64
 (-> M (gn-emit (enc-ldr 16 7 CTX-FUEL)) (gn-emit (enc-sub-r 16 16 5)) (gn-emit (enc-str 16 7 CTX-FUEL))
  (gn-emit (enc-ldr 8 7 CTX-FUEL)) (gn-mov r 1) (gn-mov-imm 5 0) (gn-fix FX-B26 (gn-sir M (+ p 2) IF-A)) (gn-emit (enc-b 0))
  (kb-keep)))
(defn- hpa-entry [M :vector-i64 i :i64] :vector-i64
 (let [p (dec i) f (gn-sir M p IF-A) rv (gn-sreg M 1) ri (gn-sreg M 2)]
  (if (not (hp-head M p f 32)) M
   (let [pt (gn-sir M (+ p 10) IF-A) inp (gn-sir M (+ p 18) IF-A) hu (gn-sir M (+ p 21) IF-A) sw (gn-sir M (+ (mmx-q M hu) 31) IF-A)]
    (if (not (and (> (mmx-q M pt) 0) (> (mmx-q M hu) 0) (> (mmx-q M sw) 0)
