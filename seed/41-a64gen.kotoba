                  (kpat-match M (mmx-q M pt) [844442109345793 18 4229300233 4294967300 8590000132 12885032964 844424943763470 19 4294311938] [pt]))) M
     (let [lin (sg-input-lit M inp)]
      (if (= lin 0) M
       (let [G (vector-alloc 13)
             m0 (-> M (gn-emit (enc-cmp-i ri 100)) (ri-cold G 8) (kb-vec G rv 10 11) (gn-mov-imm 16 1300) (gn-emit (enc-cmp-r 10 16))
                  (ri-cold G (enc-cond-lo)) (gn-mov 0 11) (gn-mov 1 ri) (ab-lit 3 lin) (gn-emit (enc-ldr 4 7 CTX-FUEL))
                  (kb-words G [0xD2800005 0x91380002 0x91380042 0xD126C3FF 0xA90013E3 0xF9400809 0xF101913F 0x54001948 0xD280000A 0x8B0A144B 0xA941356C 0xF101919F 0x540018A8 0xF10191BF 0x54001868 0x9100054A 0xF101915F 0x54FFFF09 0xF101903F 0x540017C0 0xA94013E3 0xCB050089 0xF115E13F 0x5400174B 0xF8617866 0x9100042F 0x91004010 0xF9400209 0xD2800008 0x910043F1 0xB4000329 0xEB0F013F 0x54001620 0x8B09144B 0xF940016C 0xA941396D 0xEB0C00CC 0x540001C0 0x9A8E41AA 0x9A9F47EC 0x9100098C 0xD37DF18D 0xA9002630 0xF9000A2D 0x91006231 0x8B0D0170 0xAA0A03E9 0x91000508 0xF101951F 0x54001408 0x17FFFFEC 0x8B0800A5 0x910008A5 0x91000421 0x17FFFFDC 0xAA0803EA 0x8B0800A5 0x910004A5 0x8B0F144B 0xF9000166 0xA9017D7F 0xF9400C0C 0x9100618C 0xF9000C0C 0x910010A5 0x8B0A00A5 0x910004A5 0x910043F1 0x8B0F144B 0xAA0A03E3 0xB4000263 0xA940262D 0xF9400A2E 0xF94001AC 0xEB09019F 0x54000221 0x8B09144C 0xF940018C 0xF940016D 0xEB0C01AC 0x54000180 0xD280030C 0xD280020D 0x9A8C41AC 0xEB0E019F 0x540000E1 0x91006231 0xD1000463 0x17FFFFEE 0xF940020C 0xB500004C 0x14000015 0x91004010 0x910043F1 0xF9400209 0xB4000229 0x8B09144C 0xF940018D 0xF940016E 0xEB0D01CD 0x9A9F57EE 0x9A9F17ED 0xEB0901FF 0x9A9FB1AD 0xAA0D01CE 0xD280030D 0xCB0E0DAD 0xA9002630 0xF9000A2D 0x91006231 0x8B0D0190 0x17FFFFEF 0xD280002C 0xF900056C 0xF900020F 0x910008A5 0x910043EC 0xEB0C023F 0x54000AA0 0xD1006231]) (kb-words G [0xA9402630 0xF9400A2D 0x8B09144B 0xF940056C 0xB5FFFF0C 0x910004A5 0xD280050E 0xCB0D01CE 0xF9400209 0x8B09144B 0xF86D696A 0xF86E696C 0x8B0A1448 0xF86D690F 0xF86E6906 0x910004A5 0xB40003AC 0x8B0C1443 0xF9400463 0xF100047F 0x54000321 0x910004A5 0xB4FFFCCA 0xF9400503 0xF100047F 0x54FFFC61 0x910004A5 0xB40000AF 0x8B0F1443 0xF9400463 0xF100047F 0x540000E0 0x910004A5 0xB4FFFB66 0x8B061443 0xF9400463 0xF100047F 0x54FFFAE1 0xF900051F 0x8B0C1443 0xF900047F 0xD2800023 0xF9000563 0x91000CA5 0x17FFFFD0 0x910004A5 0xB4FFF9CA 0xF9400503 0xF100047F 0x54FFF961 0x910004A5 0xB40001CF 0x8B0F1443 0xF9400463 0xF100047F 0x54000141 0xF82D6966 0xF82D6