(defn- cpp-to [w :i64 at :i64] :i64
 (of-dest w at))
(defn- cpp-cb-target [M :vector-i64 branch :i64 end :i64 pred :i64 f :i64] :i64
 ;; Before layout a source CBZ has imm0. Only its unique owned typed FIX resolves it.
 (if (not (and (>= (vector-count M) MM-WORDS)
  (> (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) MM-CODE-CAP)
  (> (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (> (vector-at M MM-LABEL-N) 0) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)
  (> (vector-at M MM-FN-N) 0) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (> (vector-at M MM-SIR-N) 0) (<= (vector-at M MM-SIR-N) MM-SIR-CAP)
  (> f 0) (< f (vector-at M MM-FN-N)) (> pred 0) (< pred 29)
  (> branch 0) (< branch end) (<= end (vector-at M MM-CODE-N)))) 0
  (let [sourceEnd (cpp-owned M f) start (gn-fnf M f FF-CODE)]
   (if (or (= sourceEnd 0) (<= start 0) (< branch start)
    (not= (sf-word M branch) (enc-cbz pred 0))) 0
    (let [k (hld-fix M branch)]
     (if (or (<= k 0) (>= k (vector-at M MM-FIX-N))) 0
      (let [label (sf-x M k XF-TARGET)]
       (if (and (= (sf-x M k XF-KIND) FX-CB19) (= (sf-x M k XF-AT) branch)
         (= (sf-x M k XF-AUX) 0) (> label 0) (< label (vector-at M MM-LABEL-N))
