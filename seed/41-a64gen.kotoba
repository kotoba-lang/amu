  (> (vector-at M MM-FN-N) 1) (<= (vector-at M MM-FN-N) 512)
  (<= (vector-at M MM-SIR-N) MM-SIR-CAP) (<= (vector-at M MM-FN-N) MM-FN-CAP)
  (> (vector-at M MM-CODE-N) 0) (<= (vector-at M MM-CODE-N) MM-CODE-CAP)
  (> (vector-at M MM-FIX-N) 0) (<= (vector-at M MM-FIX-N) MM-FIX-CAP)
  (> (vector-at M MM-LABEL-N) 0) (<= (vector-at M MM-LABEL-N) MM-LABEL-CAP)
  (let [g (vector-at M gn-cell) size (+ cpp-state 1) top (vector-at M MM-HEAP-TOP)]
