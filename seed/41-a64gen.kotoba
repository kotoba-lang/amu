  (if (and (>= v 60000) (< v 60104)) (gn-sir M (+ p (- v 60000)) IF-A) v)))
(defn- ga-writer [M :vector-i64 f :i64] :bool
 (if (or (<= f 0) (>= f (vector-at M MM-FN-N)) (>= f MM-FN-CAP)) false
  (let [p (gn-fnf M f FF-SIR)]
   (if (or (<= p 0) (> p (- (vector-at M MM-SIR-N) 9)) (gn-clamp-open M f)) false
    (let [l (gn-sir M (+ p 2) IF-A)]
     (and (= (gn-fnf M f FF-NPARAMS) 3) (= (gn-fnf M f FF-NSLOTS) 3)
      (= (gn-fnf M f FF-DEPTH) 3) (= (gn-fnf M f FF-RTYPE) TY-VEC)
      (= (ck-pt M f 0) TY-VEC) (= (ck-pt M f 1) TY-I64) (= (ck-pt M f 2) TY-I64)
      (> l 0) (< l MM-LABEL-CAP) (= (gn-lpos M l) (+ p 2))
