;; seed/tools/package.kotoba -- package a seed binary as a stand-alone command (JUN-243: the Kotoba port of
;; scripts/seed/package.sh). The pinned C loader is compiled in its KEXE_EMBEDDED form with the seed's code as a C array:
;; one Mach-O that runs `main` of the seed with the process argv as the guest's argv. It runs only cc.
;;
;;   package <repo> <seed.bin> [--offset N] [--out PATH] [--scope LIST] [--allow CSV] [--loader SRC]
;;
;;   <seed.bin>  a seed (e.g. <repo>/build/seed-boot/r6n/seed-1.bin from tools/bootstrap); its entry offset is --offset, else
;;               the number in <seed>.offset beside it
;;   --out       the command written (default <repo>/build/seed/seed); the generated header goes to <out>.pkg/
;;   --scope     the wire-35 scope baked in, colon-separated absolute directories (default <repo>:<repo>/build:/private/tmp:/tmp)
;;               -- a packaged command ignores the environment, so this IS what the seed may read and write
;;   --allow     the granted wires (default 35,37,38,39); 20 (:process/spawn) is refused
;;   --loader    the loader source (default <repo>/seed/bootstrap/seed-loader-v11.c)
;; Budgets as scripts/seed/package.sh: string pool 256 MiB, pairs 4 Mi, vectors 64 Ki, vector items 128 Mi, kgraph 1 Mi,
;; cpu and wall 120 s. Writes <out>.info (sha256 of the code and the command, scope, allow, budgets).
(ns tools.package
  (:require [tools.lib :as l])
  (:export [main]))

(defn- say [s :string] :i64 (l/out (string-concat "package: " (string-concat s "\n"))))

(defn- fail [s :string] :i64
  (let [z (l/err (string-concat "package: " (string-concat s "\n")))] 1))

(defn- opt [name :string] :string
  (loop [i 2]
    (cond (>= (+ i 1) (l/argc)) ""
          (string=? (l/arg i) name) (l/arg (+ i 1))
          :else (recur (+ i 1)))))

(defn- or-default [s :string d :string] :string (if (string=? s "") d s))

;; 1 when s is digits separated by single commas and does not grant wire 20
(defn- allow-ok [s :string] :i64
  (let [n (string-length s)
        shape (loop [i 0 prev 44]
                (cond (>= i n) (if (= prev 44) 0 1)
                      (let [c (string-code-point-at s i)] (and (>= c 48) (<= c 57))) (recur (+ i 1) 48)
                      (and (= (string-code-point-at s i) 44) (not (= prev 44))) (recur (+ i 1) 44)
                      :else 0))]
    (if (and (= shape 1) (< (string-index-of-from (string-concat "," (string-concat s ",")) ",20," 0) 0)) 1 0)))

(defn- hexd [d :i64] :string (string-substring "0123456789abcdef" d (+ d 1)))

;; line k of the `xxd -i` text of B: "  0x.., 0x..,\n", 12 bytes a line, no comma after the last byte of B
(defn- hex-line [B :bytes k :i64 n :i64] :string
  (let [e (if (< (* 12 (+ k 1)) n) (* 12 (+ k 1)) n)]
    (loop [i (* 12 k) acc " "]
      (if (>= i e)
        (string-concat acc (if (>= e n) "\n" ",\n"))
        (let [b (bytes-at B i)]
          (recur (+ i 1) (string-concat acc (string-concat (if (= i (* 12 k)) " 0x" ", 0x")
                                                           (string-concat (hexd (u64-shift-right b 4)) (hexd (bit-and b 15)))))))))))

;; append the array body one line at a time (the loader buffers consecutive appends; l/exists closes the sink)
(defn- write-array [h :string B :bytes n :i64] :i64
  (let [lines (quot (+ n 11) 12)
        z (loop [k 0] (if (>= k lines) 0 (let [w (l/append-raw h (hex-line B k n))] (recur (+ k 1)))))]
    (l/exists h)))

(defn- define [name :string value :string] :string
  (string-concat "#define " (string-concat name (string-concat " " (string-concat value "\n")))))

(defn- quoted [s :string] :string (string-concat "\"" (string-concat s "\"")))

(defn- header [bin :string off :i64 n :i64 scope :string allow :string] :string
  (let [t0 (string-concat "/* generated by seed/tools/package.kotoba from " (string-concat bin " -- do not edit */\n"))
        t1 (string-concat t0 (define "KEXE_EMBEDDED" "1"))
        t2 (string-concat t1 (define "KEXE_EMBEDDED_OFFSET" (string-concat (l/dec off) "u")))
        t3 (string-concat t2 (define "KEXE_EMBEDDED_ARITY" "0u"))
        t4 (string-concat t3 (define "KEXE_EMBEDDED_ISA" (quoted "aarch64")))
        t5 (string-concat t4 (define "KEXE_EMBEDDED_ALLOW" (quoted allow)))
        t6 (string-concat t5 (define "KEXE_EMBEDDED_SCOPE35" (quoted scope)))
        t7 (string-concat t6 (define "KEXE_EMBEDDED_SCOPE34" (quoted "")))
        t8 (string-concat t7 (define "KEXE_EMBEDDED_SPAWN_PROGRAMS" (quoted "")))
        t9 (string-concat t8 (define "KEXE_EMBEDDED_SPAWN_ENV" (quoted "")))
        t10 (string-concat t9 (define "KEXE_EMBEDDED_SPAWN_PATH_LOOKUP" "0"))
        t11 (string-concat t10 (define "KEXE_EMBEDDED_STRING_POOL" "268435456u"))
        t12 (string-concat t11 (define "KEXE_EMBEDDED_FUEL" "0u"))
        t13 (string-concat t12 (define "KEXE_EMBEDDED_PAIRS" "4194304u"))
        t14 (string-concat t13 (define "KEXE_EMBEDDED_VECTORS" "65536u"))
        t15 (string-concat t14 (define "KEXE_EMBEDDED_VECTOR_ITEMS" "134217728u"))
        t16 (string-concat t15 (define "KEXE_EMBEDDED_KGRAPH" "1048576u"))
        t17 (string-concat t16 (define "KEXE_EMBEDDED_CPU_SECONDS" "120u"))
        t18 (string-concat t17 (define "KEXE_EMBEDDED_WALL_SECONDS" "120u"))]
    (string-concat t18 (string-concat "static const unsigned char kexe_embedded_code[" (string-concat (l/dec n) "] = {\n")))))

(defn- pkg [R :string bin :string off :i64 out :string scope :string allow :string loader :string] :i64
  (let [B (typed-cap-call :fs/app-data-bytes :string :bytes bin)
        n (bytes-count B)
        D (string-concat out ".pkg")
        z0 (l/mkdirs R D)
        h (string-concat D "/kexe_embedded.h")
        head (header bin off n scope allow)
        w0 (l/write-text h head)
        w1 (write-array h B n)
        w2 (l/append-text h "};\n")
        a (l/run (string-concat "cc\t-O2\t-std=c11\t-I\t" (string-concat D (string-concat "\t-include\t" (string-concat h
                   (string-concat "\t" (string-concat loader (string-concat "\t-o\t" out))))))))]
    (if (not (= (l/exit-of a) 0))
      (fail (string-concat "cc failed: " (l/stdout-of a)))
      (let [code-sha (l/sha256-file bin)
            cmd-sha (l/sha256-file out)
            i0 (string-concat "label packaged command (KEXE_EMBEDDED build of " (string-concat loader ")\n"))
            i1 (string-concat i0 (string-concat "code " (string-concat bin (string-concat " sha256 " (string-concat code-sha
                 (string-concat " bytes " (string-concat (l/dec n) (string-concat " offset " (string-concat (l/dec off) "\n")))))))))
            i2 (string-concat i1 (string-concat "command " (string-concat out (string-concat " sha256 " (string-concat cmd-sha
                 (string-concat " bytes " (string-concat (l/dec (l/file-size out)) "\n")))))))
            i3 (string-concat i2 (string-concat "loader-source sha256 " (string-concat (l/sha256-text (l/read-text loader)) "\n")))
            i4 (string-concat i3 (string-concat "allow " (string-concat allow (string-concat "\nscope35 " (string-concat scope "\n")))))
            info (string-concat i4 "budgets string-pool 268435456 pairs 4194304 vectors 65536 vector-items 134217728 cpu-seconds 120 wall-seconds 120 kgraph 1048576\n")
            z (l/write-text (string-concat out ".info") info)
            z2 (say (string-concat out (string-concat " (" (string-concat (l/dec (l/file-size out)) (string-concat " bytes, code " (string-concat (l/dec n) (string-concat " bytes sha256 " (string-concat code-sha (string-concat ", entry " (string-concat (l/dec off) ")"))))))))))]
        0))))

(defn main [] :i64
  (if (< (l/argc) 2)
    (let [z (l/err "usage: package <repo> <seed.bin> [--offset N] [--out PATH] [--scope LIST] [--allow CSV] [--loader SRC]\n")] 2)
    (let [R (l/arg 0)
          bin (l/arg 1)
          offs (opt "--offset")
          offf (string-concat (if (and (> (string-length bin) 4) (string=? (string-substring bin (- (string-length bin) 4) (string-length bin)) ".bin"))
                                (string-substring bin 0 (- (string-length bin) 4)) bin) ".offset")
          off (cond (not (string=? offs "")) (l/parse-int offs)
                    (= (l/exists offf) 1) (l/parse-int (l/read-text offf))
                    :else -1)
          allow (or-default (opt "--allow") "35,37,38,39")
          scope (or-default (opt "--scope") (string-concat R (string-concat ":" (string-concat R "/build:/private/tmp:/tmp"))))
          out (or-default (opt "--out") (string-concat R "/build/seed/seed"))
          loader (or-default (opt "--loader") (string-concat R "/seed/bootstrap/seed-loader-v11.c"))]
      (cond (= (l/exists bin) 0) (fail (string-concat "no seed at " bin))
            (< off 0) (fail (string-concat "no entry offset: pass --offset or write " offf))
            (>= off (l/file-size bin)) (fail "the offset is not inside the code")
            (= (allow-ok allow) 0) (fail "--allow must be a comma separated list of wires, without 20 (:process/spawn)")
            (or (>= (string-index-of-from scope "\"" 0) 0) (>= (string-index-of-from scope "\\" 0) 0)) (fail "--scope must not contain a quote or backslash")
            :else (pkg R bin off out scope allow loader)))))
