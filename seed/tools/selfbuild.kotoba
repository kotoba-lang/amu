;; seed/tools/selfbuild.kotoba -- the selfbuild scan (JUN-202: the Kotoba port of scripts/seed/selfbuild.sh --no-link with
;; r6-scan.sh, selfbuild-inputs.sh, farm-from-lock.py, scripts/selfhost-wall/reach-list.py, reach-twins.py, r6_scan.py and
;; the summary of selfbuild.py). Compiled by the committed seed, run under the pinned loader; it starts only git and the
;; lineage loader running seed r6n: no shell, node, nbb, JVM or python. Entry commands: seed/README.md "Selfbuild scan".
;;
;;   selfbuild <repo> --repos DIR --stderr FILE [--gitlibs DIR] [--lock FILE] [--work DIR] [--seed FILE]
;;             [--kotoba-lang-repo DIR --kotoba-lang-rev REV | --kotoba-lang DIR] [--expect-ok N]
;;
;;   1 FARM   every :lock/entries entry of the lock (default <repo>/deps-lock.edn) whose :paths hold "src": the clone
;;            <repos>/<repo-name> (else <gitlibs>/<repo-name>) must hold the :git-sha commit; its src tree is written to
;;            <work>/cp/<repo-name>/src with `git restore --source=<sha> --worktree` (the clone's index is not touched).
;;            kotoba-lang lang/compat + lang/selfhost-compiler-grant.edn at --kotoba-lang-rev the same way (or the
;;            directory --kotoba-lang as given). Fails closed on a missing clone or commit: no network, no other revision.
;;   2 LIST   reach-list: the files reachable from <repo>/src/kotoba/compiler/nbb/*_cli.cljk (git ls-files) through the
;;            dotted `[name` tokens of their ns block, each name taken from the FIRST root that has it (roots: the farm's
;;            src roots in lock order, <repo>/src, <kotoba-lang>/lang/compat; extensions .kotoba .cljk .cljc).
;;            reach-twins: every listed module re-resolved by namespace under the loader's rule (across roots exactly one
;;            guest .kotoba stands in for .cljk/.cljc twins), then closed over the Kotoba reading of the chosen files'
;;            requires. -> <work>/reach.txt, <work>/list.txt, <work>/list.err
;;   3 FARM   the modules copied to <work>/r6/src at their namespace paths; a dependency-first order (post-order DFS over
;;            the sorted names) -> <work>/r6/order.txt ("<ns> <path> <deps..|->")
;;   4 SCAN   per module in that order: BLOCKED when a required module has no object, else
;;            `seed compile <file> --emit-module --object-dir <work>/r6/o` (separate mode) under the lineage loader:
;;            OK (exit 0 and a non-empty object), REFUSED (the seed's first `seed: E<code>` line), TRAP (anything else)
;;            -> <work>/r6/r6-scan.tsv (ns, status, lines, code, text, -)
;;   5 REPORT <work>/report.txt (counts, first-refusal histogram, the three command entries' closures) and the verdict
;;            <work>/selfbuild.edn; input provenance (lock sha256, every root's commit and git tree, kotoba-lang's, amu's
;;            commit, the seed's sha256, every module's sha256) in <work>/inputs.txt and the EDN.
;;
;; The seed writes its refusals to stderr, which a spawned child shares with this tool: run the tool with its stderr
;; redirected to FILE (inside the wire-35 scope) and name it with --stderr; the tool reads each compile's lines from it
;; (and checks the redirection with a marker first). Every compile is one spawn (the loader's budget: 10 s wall, 16 KiB
;; stdout per child; r6n compiles the largest module in about 1.5 s). The work dir must not exist yet (objects of an
;; earlier run are never reused). Exit 0 when the scan ran (and OK >= --expect-ok), 1 on a failure, 2 on usage.
(ns tools.selfbuild
  (:require [tools.lib :as l]
            [tools.scan :as sc])
  (:export [main]))

;; ---- small helpers -----------------------------------------------------------------------------------------------
(defn- c3 [a :string b :string c :string] :string (string-concat a (string-concat b c)))
(defn- c4 [a :string b :string c :string d :string] :string (string-concat a (c3 b c d)))
(defn- c5 [a :string b :string c :string d :string e :string] :string (string-concat a (c4 b c d e)))
(defn- c6 [a :string b :string c :string d :string e :string f :string] :string (string-concat a (c5 b c d e f)))

(defn- say [s :string] :i64 (l/out (c3 "selfbuild: " s "\n")))

(defn- fail [s :string] :i64
  (let [z (l/err (c3 "selfbuild: FAIL: " s "\n"))] 1))

(defn- short [s :string n :i64] :string
  (if (<= (string-length s) n)
    s
    (string-substring s 0 (loop [i 0] (let [j (sc/adv s i)] (if (> j n) i (recur j)))))))

(defn- opt [name :string] :string
  (loop [i 1]
    (cond (>= (+ i 1) (l/argc)) ""
          (string=? (l/arg i) name) (l/arg (+ i 1))
          :else (recur (+ i 1)))))

(defn- last-of [s :string x :string] :i64
  (loop [p 0 last -1]
    (let [j (string-index-of-from s x p)] (if (< j 0) last (recur (+ j 1) j)))))

;; (every offset handed to the string primitives must be a code point boundary: strings are UTF-8 bytes, see tools.scan)
(defn- ends-with [s :string x :string] :i64
  (let [j (last-of s x)]
    (if (and (>= j 0) (= (+ j (string-length x)) (string-length s))) 1 0)))

(defn- starts-with [s :string x :string] :i64
  (if (and (>= (string-length s) (string-length x)) (string=? (string-substring s 0 (string-length x)) x)) 1 0))

;; s without its trailing newlines (tools.lib trim-nl reads the code point before a newline, which is no boundary when
;; it is a non-ASCII character)
(defn- trim-nl [s :string] :string
  (loop [t s] (if (= (ends-with t "\n") 1) (recur (string-substring t 0 (- (string-length t) 1))) t)))

;; s with every occurrence of a replaced by b
(defn- replace-str [s :string a :string b :string] :string
  (loop [p 0 acc ""]
    (let [j (string-index-of-from s a p)]
      (if (< j 0)
        (string-concat acc (string-substring s p (string-length s)))
        (recur (+ j (string-length a)) (c3 acc (string-substring s p j) b))))))

;; namespace -> its relative source path without extension (r6_scan.py: . -> /, - -> _)
(defn- ns-rel [ns :string] :string (replace-str (replace-str ns "." "/") "-" "_"))

;; field k (0-based) of a TAB-separated line
(defn- tab-field [line :string k :i64] :string
  (loop [i 0 n 0]
    (let [j (string-index-of-from line "\t" i)
          e (if (< j 0) (string-length line) j)]
      (cond (= n k) (string-substring line i e)
            (< j 0) ""
            :else (recur (+ j 1) (+ n 1))))))

;; membership in a set text "\n<x>\n<y>\n..."
(defn- in-set [set :string x :string] :i64 (if (>= (string-index-of-from set (c3 "\n" x "\n") 0) 0) 1 0))

;; the value of key in a table text "\n<key>\t<value>\n..." ("" when absent); the row's whole rest after the key
(defn- tbl-get [tbl :string key :string] :string
  (let [p (c3 "\n" key "\t")
        i (string-index-of-from tbl p 0)]
    (if (< i 0)
      ""
      (let [b (+ i (string-length p))
            e (string-index-of-from tbl "\n" b)]
        (string-substring tbl b (if (< e 0) (string-length tbl) e))))))

(defn- tbl-has [tbl :string key :string] :i64 (if (>= (string-index-of-from tbl (c3 "\n" key "\t") 0) 0) 1 0))

;; the number of "\n" in s (wc -l)
(defn- count-nl [s :string] :i64
  (loop [i 0 n 0]
    (let [j (string-index-of-from s "\n" i)] (if (< j 0) n (recur (+ j 1) (+ n 1))))))

;; EDN string literal of s
(defn- edn-str [s :string] :string
  (c3 "\"" (replace-str (replace-str (replace-str s "\\" "\\\\") "\"" "\\\"") "\n" "\\n") "\""))

;; -1 / 0 / 1: code point order of s[a1,b1) against t[a2,b2) (Python's str order)
(defn- cmp-range [s :string a1 :i64 b1 :i64 t :string a2 :i64 b2 :i64] :i64
  (loop [i a1 j a2]
    (cond (and (>= i b1) (>= j b2)) 0
          (>= i b1) -1
          (>= j b2) 1
          (< (string-code-point-at s i) (string-code-point-at t j)) -1
          (> (string-code-point-at s i) (string-code-point-at t j)) 1
          :else (recur (sc/adv s i) (sc/adv t j)))))

;; the lines of text sorted (code point order), each followed by "\n"
(defn- sort-lines [text :string] :string
  (let [n (l/nlines text)
        B (vector-alloc (+ n 1))
        E (vector-alloc (+ n 1))
        f (loop [i 0 k 0]
            (if (or (>= k n) (> i (string-length text)))
              k
              (let [j (string-index-of-from text "\n" i)
                    e (if (< j 0) (string-length text) j)
                    z1 (vector-assoc! B k i)
                    z2 (vector-assoc! E k e)]
                (recur (+ e 1) (+ k 1)))))]
    (loop [k 0 acc ""]
      (if (>= k f)
        acc
        (let [m (loop [i (+ k 1) m k]
                  (cond (>= i f) m
                        (< (cmp-range text (vector-at B i) (vector-at E i) text (vector-at B m) (vector-at E m)) 0) (recur (+ i 1) i)
                        :else (recur (+ i 1) m)))
              bm (vector-at B m)
              em (vector-at E m)
              z1 (vector-assoc! B m (vector-at B k))
              z2 (vector-assoc! E m (vector-at E k))
              z3 (vector-assoc! B k bm)
              z4 (vector-assoc! E k em)]
          (recur (+ k 1) (c3 acc (string-substring text bm em) "\n")))))))

(def SEP "#SB#")

;; the last line of a non-empty "<x>\n.." text and the text without it: "<last>SEP<rest>"
(defn- pop-line [t :string] :string
  (let [t1 (string-substring t 0 (- (string-length t) 1))
        cut (+ (last-of t1 "\n") 1)]
    (c3 (string-substring t1 cut (string-length t1)) SEP (string-substring t 0 cut))))

(defn- before-sep [s :string] :string (string-substring s 0 (string-index-of-from s SEP 0)))
(defn- after-sep [s :string] :string (string-substring s (+ (string-index-of-from s SEP 0) 4) (string-length s)))

;; ---- git -----------------------------------------------------------------------------------------------------------
(defn- git [dir :string args :string] :string (l/run (c4 "git\t-C\t" dir "\t" args)))

(defn- git-ok [dir :string args :string] :i64 (if (= (l/exit-of (git dir args)) 0) 1 0))

(defn- git-out [dir :string args :string] :string
  (let [a (git dir args)] (if (= (l/exit-of a) 0) (trim-nl (l/stdout-of a)) "")))

;; write the tree `path` of commit c of the repository repo into dest/path; "" or an error
(defn- restore [repo :string c :string dest :string paths :string] :string
  (let [a (l/run (c6 "git\t-C\t" repo (c3 "\t--work-tree=" dest "\trestore\t--ignore-skip-worktree-bits\t--worktree\t--source=")
                     c "\t--\t" paths))]
    (if (= (l/exit-of a) 0) "" (c4 "git restore of " (short c 9) " failed: " (l/stdout-of a)))))

;; ---- 1 FARM --------------------------------------------------------------------------------------------------------
;; the quoted text after `key "` from p on, and the index after its closing quote: "<value>\t<next>"; "" when absent
(defn- quoted-after [text :string key :string p :i64 limit :i64] :string
  (let [i (string-index-of-from text (string-concat key " \"") p)]
    (if (or (< i 0) (>= i limit))
      ""
      (let [b (+ i (+ (string-length key) 2))
            e (string-index-of-from text "\"" b)]
        (if (< e 0) "" (string-substring text b e))))))

;; "<coordinate>\t<repo-name>\t<sha>\t<1 when :paths holds "src">" per :lock/entries entry, in lock order
(defn- lock-entries [text :string] :string
  (loop [p 0 acc ""]
    (let [i (string-index-of-from text ":coordinate \"" p)]
      (if (< i 0)
        acc
        (let [nx (string-index-of-from text ":coordinate \"" (+ i 1))
              lim (if (< nx 0) (string-length text) nx)
              coord (quoted-after text ":coordinate" i lim)
              url (quoted-after text ":git-url" i lim)
              sha (quoted-after text ":git-sha" i lim)
              pb (string-index-of-from text ":paths [" i)
              pe (if (< pb 0) -1 (string-index-of-from text "]" pb))
              paths (if (or (< pb 0) (< pe 0) (>= pb lim)) "" (string-substring text pb pe))
              u0 (if (= (ends-with url "/") 1) (string-substring url 0 (- (string-length url) 1)) url)
              u1 (string-substring u0 (+ (last-of u0 "/") 1) (string-length u0))
              name (if (= (ends-with u1 ".git") 1) (string-substring u1 0 (- (string-length u1) 4)) u1)
              src (if (>= (string-index-of-from paths "\"src\"" 0) 0) "1" "0")]
          (recur (+ i 1) (if (or (string=? coord "") (not (= (string-length sha) 40)))
                           acc
                           (string-concat acc (c6 coord "\t" name "\t" sha (c3 "\t" src "\n"))))))))))

;; the clone (repos/name, else gitlibs/name) that holds commit sha; "" when none
(defn- clone-of [repos :string gitlibs :string name :string sha :string] :string
  (let [a (c3 repos "/" name)
        b (if (string=? gitlibs "") "" (c3 gitlibs "/" name))]
    (cond (= (git-ok a (c3 "cat-file\t-e\t" sha "^{commit}")) 1) a
          (and (not (string=? b "")) (= (git-ok b (c3 "cat-file\t-e\t" sha "^{commit}")) 1)) b
          :else "")))

;; the farm: the src roots ("<root>\n" lines, lock order) or "!<error>"; writes cp.txt, farm.txt and the provenance
;; lines of inputs.txt
(defn- farm [R :string W :string repos :string gitlibs :string lock :string] :string
  (let [es (lock-entries (l/read-text lock))
        n (l/nlines es)
        z0 (l/mkdirs R (string-concat W "/cp"))]
    (if (= n 0)
      (c3 "!no lock entries read from " lock "")
      (loop [k 0 roots "" prov ""]
        (if (>= k n)
          (let [z1 (l/write-text (string-concat W "/farm.txt") prov)
                z2 (l/append-text (string-concat W "/inputs.txt") prov)
                cp (loop [i 0 acc ""]
                     (if (>= i (l/nlines roots)) acc
                       (recur (+ i 1) (c3 acc (if (= i 0) "" ":") (l/line-at roots i)))))
                z3 (l/write-text (string-concat W "/cp.txt") (string-concat cp "\n"))]
            roots)
          (let [e (l/line-at es k)
                coord (tab-field e 0)
                name (tab-field e 1)
                sha (tab-field e 2)
                clone (clone-of repos gitlibs name sha)]
            (cond (string=? clone "") (c5 "!" coord " " (short sha 8) ": no local clone has the commit (--repos / --gitlibs)")
                  (string=? (tab-field e 3) "0") (recur (+ k 1) roots prov)
                  (= (git-ok clone (c3 "cat-file\t-e\t" sha ":src")) 0) (recur (+ k 1) roots prov)
                  :else
                  (let [dest (c3 W "/cp/" name)
                        z (l/mkdirs R dest)
                        r (restore clone sha dest "src")
                        tree (git-out clone (c3 "rev-parse\t" sha ":src"))
                        kg (git-ok clone (c3 "cat-file\t-e\t" sha ":kotoba"))
                        rk (if (= kg 1) (restore clone sha dest "kotoba") "")
                        ktree (if (= kg 1) (git-out clone (c3 "rev-parse\t" sha ":kotoba")) "")]
                    (cond (not (string=? r "")) (c4 "!" coord ": " r)
                          (and (= kg 1) (not (string=? rk ""))) (c4 "!" coord ": " rk)
                          :else
                          (recur (+ k 1)
                                 (if (= kg 1) (c5 roots dest "/kotoba\n" dest "/src\n") (c3 roots dest "/src\n"))
                                 (string-concat
                                  (string-concat
                                   prov
                                   (c6 "root " coord " " sha (c4 " src tree " tree " clone " clone) (c3 " -> " dest "/src\n")))
                                  (if (= kg 1)
                                    (c6 "root " coord " " sha (c4 " kotoba tree " ktree " clone " clone) (c3 " -> " dest "/kotoba\n"))
                                    ""))))))))))))

;; the kotoba-lang root (its lang/compat is a module root) or "!<error>"
(defn- kotoba-lang [R :string W :string krepo :string krev :string kdir :string] :string
  (cond (not (string=? kdir ""))
        (let [z (l/append-text (string-concat W "/inputs.txt") (c3 "kotoba-lang dir " kdir " (as given, no commit)\n"))] kdir)
        (or (string=? krepo "") (string=? krev "")) "!name --kotoba-lang-repo and --kotoba-lang-rev (or --kotoba-lang DIR)"
        :else
        (let [c (git-out krepo (c3 "rev-parse\t--verify\t" krev "^{commit}"))
              K (string-concat W "/kotoba-lang")
              z (l/mkdirs R K)]
          (if (string=? c "")
            (c4 "!kotoba-lang " krev " is not a commit of " krepo)
            (let [r (restore krepo c K "lang/compat\tlang/selfhost-compiler-grant.edn")
                  tree (git-out krepo (c3 "rev-parse\t" c ":lang/compat"))]
              (if (not (string=? r ""))
                (string-concat "!kotoba-lang: " r)
                (let [z2 (l/append-text (string-concat W "/inputs.txt") (c6 "kotoba-lang " krepo " " c " lang/compat tree " (string-concat tree "\n")))] K)))))))

;; ---- 2 LIST --------------------------------------------------------------------------------------------------------
(def EXTS ".kotoba\n.cljk\n.cljc\n")

;; the first file of ns under root (extension order .kotoba .cljk .cljc); "" when none
(defn- in-root [root :string rel :string] :string
  (loop [k 0]
    (if (>= k 3)
      ""
      (let [p (c3 root "/" (string-concat rel (l/line-at EXTS k)))]
        (if (= (l/exists p) 1) p (recur (+ k 1)))))))

;; reach-list.py find: the first root that has ns
(defn- find-first [roots :string ns :string] :string
  (let [rel (ns-rel ns) n (l/nlines roots)]
    (loop [k 0]
      (if (>= k n)
        ""
        (let [p (in-root (l/line-at roots k) rel)]
          (if (string=? p "") (recur (+ k 1)) p))))))

;; reach-twins.py candidates: the file of ns in every root that has one, one per line
(defn- candidates [roots :string ns :string] :string
  (let [rel (ns-rel ns) n (l/nlines roots)]
    (loop [k 0 acc ""]
      (if (>= k n)
        acc
        (let [p (in-root (l/line-at roots k) rel)]
          (recur (+ k 1) (if (string=? p "") acc (c3 acc p "\n"))))))))

;; reach-twins.py resolve: "<path>\t<how>" (how: one, twin) or "\t<missing|ambiguous>"
(defn- resolve [roots :string ns :string] :string
  (let [c (candidates roots ns)
        n (l/nlines c)]
    (cond (= n 1) (string-concat (l/line-at c 0) "\tone")
          (= n 0) "\tmissing"
          :else
          (let [g (loop [k 0 acc ""]
                    (if (>= k n) acc
                      (recur (+ k 1) (if (= (ends-with (l/line-at c k) ".kotoba") 1) (c3 acc (l/line-at c k) "\n") acc))))]
            (if (= (l/nlines g) 1) (string-concat (l/line-at g 0) "\ttwin") "\tambiguous")))))

;; reach-list.py: the sorted files reachable from the nbb *_cli.cljk seeds
(defn- reach-list [R :string roots :string] :string
  (let [ls (git-out R "ls-files\t--\tsrc/kotoba/compiler/nbb")
        n0 (l/nlines ls)
        seeds (loop [k 0 acc ""]
                (if (>= k n0)
                  acc
                  (let [f (l/line-at ls k)
                        rest (string-substring f (string-length "src/kotoba/compiler/nbb/") (string-length f))]
                    (recur (+ k 1) (if (and (= (ends-with f "_cli.cljk") 1) (< (string-index-of-from rest "/" 0) 0))
                                     (c4 acc R "/" (string-concat f "\n"))
                                     acc)))))]
    ;; queue (a stack, as the Python list), seen (a set of paths), cache "\n<ns>\t<path>" of find-first
    (loop [queue seeds seen "\n" cache "\n"]
      (if (= (string-length queue) 0)
        (sort-lines (string-substring seen 1 (string-length seen)))
        (let [q1 (string-substring queue 0 (- (string-length queue) 1))
              cut (+ (last-of q1 "\n") 1)
              f (string-substring q1 cut (string-length q1))
              rest (string-substring queue 0 cut)]
          (if (= (in-set seen f) 1)
            (recur rest seen cache)
            (let [names (sc/reach-names (sc/reach-block (l/read-text f)))
                  m (l/nlines names)
                  r (loop [k 0 qq rest cc cache]
                      (if (>= k m)
                        (c3 cc SEP qq)
                        (let [nm (l/line-at names k)
                              hit (tbl-has cc nm)
                              p (if (= hit 1) (tbl-get cc nm) (find-first roots nm))
                              cc2 (if (= hit 1) cc (c4 cc nm "\t" (string-concat p "\n")))]
                          (recur (+ k 1)
                                 (if (or (string=? p "") (= (in-set (string-concat seen (string-concat f "\n")) p) 1)) qq (c3 qq p "\n"))
                                 cc2))))
                  ]
              (recur (after-sep r)
                     (c3 seen f "\n")
                     (before-sep r)))))))))

;; the module of a file: its ns form's name ("" when none)
(defn- file-ns [p :string] :string (sc/ns-name (sc/ns-form (l/read-text p))))

;; reach-twins.py: "<ns>\t<path>" rows (the input list's order, then the modules its closure added); list.err written
(defn- reach-twins [W :string list :string roots :string] :string
  (let [n (l/nlines list)
        first-pass
        (loop [k 0 mods "\n" todo "" notes "" swapped 0]
          (if (>= k n)
            (c6 mods SEP todo SEP notes (string-concat SEP (l/dec swapped)))
            (let [p (l/line-at list k)
                  nm (file-ns p)]
              (if (string=? nm "")
                (recur (+ k 1) mods todo notes swapped)
                (let [rs (resolve roots nm)
                      q0 (tab-field rs 0)
                      how (tab-field rs 1)
                      q (if (string=? q0 "") p q0)
                      note (if (string=? q0 "") (c6 "  note    " nm " " how ", kept " (string-concat p "\n")) "")
                      sw (if (and (not (string=? q p))
                                  (not (string=? (string-substring q (last-of q ".") (string-length q))
                                                 (string-substring p (last-of p ".") (string-length p)))))
                           (c6 "  swapped " nm ": " p " -> " (string-concat q "\n")) "")
                      notes2 (c3 notes sw note)
                      mods2 (if (= (tbl-has mods nm) 1) mods (c4 mods nm "\t" (string-concat q "\n")))]
                  (recur (+ k 1) mods2 (c3 todo nm "\n") notes2 (if (string=? sw "") swapped (+ swapped 1))))))))
        mods0 (before-sep first-pass)
        p1 (after-sep first-pass)
        todo0 (before-sep p1)
        p2 (after-sep p1)
        notes (before-sep p2)
        swapped (l/parse-int (after-sep p2))
        closed
        (loop [todo todo0 mods mods0 added "" nores "\n"]
          (if (= (string-length todo) 0)
            (c3 mods SEP added)
            (let [pl (pop-line todo)
                  m (before-sep pl)
                  rest (after-sep pl)
                  reqs (sc/requires (sc/ns-form (l/read-text (tbl-get mods m))))
                  rn (l/nlines reqs)
                  step (loop [i 0 tt rest mm mods aa added nn nores]
                         (if (>= i rn)
                           (c6 tt SEP mm SEP aa (string-concat SEP nn))
                           (let [r (l/line-at reqs i)]
                             (if (or (= (tbl-has mm r) 1) (= (in-set nn r) 1))
                               (recur (+ i 1) tt mm aa nn)
                               (let [q (tab-field (resolve roots r) 0)]
                                 (if (string=? q "")
                                   (recur (+ i 1) tt mm aa (c3 nn r "\n"))
                                   (recur (+ i 1) (c3 tt r "\n") (c4 mm r "\t" (string-concat q "\n"))
                                          (string-concat aa (c6 "  added   " r " (required by " m "): " (string-concat q "\n")))
                                          nn)))))))
                  s1 (after-sep step)
                  s2 (after-sep s1)]
              (recur (before-sep step) (before-sep s1) (before-sep s2) (after-sep s2)))))
        mods (before-sep closed)
        added (after-sep closed)
        nm (l/nlines (string-substring mods 1 (string-length mods)))
        z (l/write-text (string-concat W "/list.err")
                        (c6 "reach-twins: " (l/dec nm) " modules (" (l/dec n)
                            (c5 " in the input list), " (l/dec swapped) " swapped to the loader's choice (another extension), "
                                (l/dec (l/nlines added)) " added by closure\n")
                            (c3 notes added "")))]
    (string-substring mods 1 (string-length mods))))

;; ---- 3 FARM (r6_scan.py farm) -----------------------------------------------------------------------------------------
;; the extension of p as r6_scan.py names it
(defn- ext-of [p :string] :string
  (cond (= (ends-with p ".kotoba") 1) ".kotoba" (= (ends-with p ".cljk") 1) ".cljk" :else ".cljc"))

;; post-order DFS from m (r6_scan.py visit): order with m's unvisited requires and m appended
(defn- visit [F :string m :string path :string order :string] :string
  (let [deps (tab-field (tbl-get F m) 1)
        path2 (c3 path m "\n")
        n (l/nlines (replace-str deps " " "\n"))
        dl (replace-str deps " " "\n")
        o (loop [k 0 order order]
            (if (>= k n)
              order
              (let [r (l/line-at dl k)]
                (if (or (string=? r "") (= (tbl-has F r) 0) (= (in-set order r) 1) (= (in-set path2 r) 1))
                  (recur (+ k 1) order)
                  (recur (+ k 1) (visit F r path2 order))))))]
    (c3 o m "\n")))

;; copy the modules into W/r6/src; the order text ("<ns> <path> <deps|->" lines). F rows: "<ns>\t<dst>\t<requires>\t<origin>"
(defn- farm-modules [R :string W :string mods :string] :string
  (let [n (l/nlines mods)
        S (string-concat W "/r6/src")
        z0 (l/mkdirs R S)
        F (loop [k 0 F "\n"]
            (if (>= k n)
              F
              (let [row (l/line-at mods k)
                    p (tab-field row 1)
                    s (l/read-text p)
                    t (sc/ns-form s)
                    nm (sc/ns-name t)]
                (if (string=? nm "")
                  (let [z (l/err (c3 "selfbuild: no ns form in " p "\n"))] (recur (+ k 1) F))
                  (let [dst (c4 S "/" (ns-rel nm) (ext-of p))
                        z1 (l/mkdirs R (string-substring dst 0 (last-of dst "/")))
                        z2 (l/write-text dst s)
                        reqs (replace-str (trim-nl (sc/requires t)) "\n" " ")]
                    (recur (+ k 1) (if (= (tbl-has F nm) 1) F (c6 F nm "\t" dst "\t" (c4 reqs "\t" p "\n")))))))))
        names (sort-lines (loop [k 0 acc ""]
                            (let [b (string-index-of-from F "\n" k)]
                              (if (or (< b 0) (>= (+ b 1) (string-length F)))
                                acc
                                (let [e (string-index-of-from F "\t" (+ b 1))]
                                  (recur (+ b 1) (c3 acc (string-substring F (+ b 1) e) "\n")))))))
        nn (l/nlines names)
        order (loop [k 0 order "\n"]
                (if (>= k nn)
                  order
                  (let [m (l/line-at names k)]
                    (recur (+ k 1) (if (= (in-set order m) 1) order (visit F m "\n" order))))))
        on (l/nlines (string-substring order 1 (string-length order)))
        text (loop [k 0 acc ""]
               (if (>= k on)
                 acc
                 (let [m (l/line-at (string-substring order 1 (string-length order)) k)
                       row (tbl-get F m)
                       dl (replace-str (tab-field row 1) " " "\n")
                       dn (l/nlines dl)
                       ds (loop [i 0 a ""]
                            (if (>= i dn) a
                              (let [r (l/line-at dl i)]
                                (recur (+ i 1) (if (or (string=? r "") (= (tbl-has F r) 0)) a (c3 a (if (string=? a "") "" " ") r))))))]
                   (recur (+ k 1) (c6 acc m " " (tab-field row 0) " " (string-concat (if (string=? ds "") "-" ds) "\n"))))))
        z3 (l/write-text (string-concat W "/r6/order.txt") text)
        z4 (l/write-text (string-concat W "/r6/farm.tsv") (string-substring F 1 (string-length F)))]
    text))

;; ---- 4 SCAN (r6-scan.sh) --------------------------------------------------------------------------------------------
;; word k (0-based) of a space-separated line
(defn- word-at [line :string k :i64] :string (tab-field (replace-str line " " "\t") k))

;; the first line of t that starts with "seed: E", "" when none
(defn- refusal-line [t :string] :string
  (loop [i 0]
    (if (>= i (string-length t))
      ""
      (let [j (string-index-of-from t "\n" i)
            e (if (< j 0) (string-length t) j)
            line (string-substring t i e)]
        (if (= (starts-with line "seed: E") 1) line (recur (+ e 1)))))))

;; the last non-empty line of t
(defn- last-line [t :string] :string
  (let [u (trim-nl t) c (last-of (trim-nl t) "\n")]
    (string-substring u (+ c 1) (string-length u))))

(defn- digit? [c :i64] :i64 (if (and (>= c 48) (<= c 57)) 1 0))

;; the first index from i on that is not a digit
(defn- skip-digits [s :string i :i64] :i64
  (loop [j i] (if (and (< j (string-length s)) (= (digit? (string-code-point-at s j)) 1)) (recur (+ j 1)) j)))

(defn- skip-spaces [s :string i :i64] :i64
  (loop [j i] (if (and (< j (string-length s)) (= (string-code-point-at s j) 32)) (recur (+ j 1)) j)))

;; the end of the match of ":[0-9]*:[0-9]*:" at i in w, -1 when it does not match there
(defn- loc-at [w :string i :i64] :i64
  (if (not (= (string-code-point-at w i) 58))
    -1
    (let [j (skip-digits w (+ i 1))]
      (if (or (>= j (string-length w)) (not (= (string-code-point-at w j) 58)))
        -1
        (let [k (skip-digits w (+ j 1))]
          (if (or (>= k (string-length w)) (not (= (string-code-point-at w k) 58))) -1 (+ k 1)))))))

;; r6-scan.sh's text of a refusal line: sed 's/^seed: E[0-9]* *//; s/^[^ ]*:[0-9]*:[0-9]*: *//' | tr '\t' ' ' | cut -c1-200.
;; The second expression can only match inside the first space-free run; [^ ]* is greedy, so the LAST position whose rest
;; matches wins.
(defn- refusal-text [l0 :string] :string
  (let [t (string-substring l0 (skip-spaces l0 (skip-digits l0 7)) (string-length l0))
        sp (string-index-of-from t " " 0)
        w (if (< sp 0) t (string-substring t 0 sp))
        e (loop [i 0 e -1]
            (if (>= i (string-length w))
              e
              (recur (sc/adv w i) (if (>= (loc-at w i) 0) (loc-at w i) e))))
        t2 (if (< e 0) t (string-substring t (skip-spaces t e) (string-length t)))]
    (short (replace-str t2 "\t" " ") 200)))

;; scan every module of order; the r6-scan.tsv rows
(defn- scan [W :string order :string seed :string off :i64 errf :string] :string
  (let [n (l/nlines order)
        O (string-concat W "/r6/o")
        z0 (l/mkdir O)
        tsv (string-concat W "/r6/r6-scan.tsv")
        z1 (l/write-text tsv (c5 "# r6-scan (seed/tools/selfbuild.kotoba) compiler " (short (l/sha256-file seed) 16) " modules " (l/dec n) "\n"))]
    (loop [k 0 ok "\n" rows ""]
      (if (>= k n)
        rows
        (let [line (l/line-at order k)
              ns (word-at line 0)
              fp (word-at line 1)
              deps (word-at line 2)
              lines (count-nl (l/read-text fp))
              dl (if (string=? deps "-") "" (replace-str (string-substring line (+ (+ (string-length ns) (string-length fp)) 2) (string-length line)) " " "\n"))
              miss (loop [i 0] (cond (>= i (l/nlines dl)) "" (= (in-set ok (l/line-at dl i)) 0) (l/line-at dl i) :else (recur (+ i 1))))
              row (if (not (string=? miss ""))
                    (c6 ns "\tBLOCKED\t" (l/dec lines) "\t-\trequires " miss "\t0\n")
                    (let [z (l/err (c3 "selfbuild: compile " ns "\n"))
                          pos (string-length (l/read-text errf))
                          kso (c4 O "/" ns ".kso")
                          a (l/run (c6 "kexe-loader-v11\t" seed "\t" (l/dec off)
                                       "\t0\taarch64\t35,37,38,39\t--\tcompile\t"
                                       (c5 fp "\t--emit-module\t--object-dir\t" O "\t--output\t" kso)))
                          st (l/exit-of a)
                          e0 (l/read-text errf)
                          log (string-substring e0 pos (string-length e0))
                          rl (refusal-line log)]
                      (cond (and (= st 0) (= (l/exists kso) 1) (> (l/file-size kso) 0))
                            (c5 ns "\tOK\t" (l/dec lines) "\t-\t" (c3 (l/dec (l/file-size kso)) " object bytes\t-" "\n"))
                            (not (string=? rl ""))
                            (let [code (string-substring rl 6 (loop [i 7] (if (and (< i (string-length rl)) (>= (string-code-point-at rl i) 48) (<= (string-code-point-at rl i) 57)) (recur (+ i 1)) i)))]
                              (c6 ns "\tREFUSED\t" (l/dec lines) "\t" code (c4 "\t" (refusal-text rl) "\t-" "\n")))
                            :else
                            (c5 ns "\tTRAP\t" (l/dec lines) "\tTRAP\texit " (c4 (l/dec st) ": " (short (replace-str (last-line log) "\t" " ") 160) "\t-\n")))))
              z2 (l/append-text tsv row)
              st2 (tab-field row 1)
              z3 (say (c4 (l/dec (+ k 1)) "/" (l/dec n) (c4 " " ns " " st2)))]
          (recur (+ k 1) (if (string=? st2 "OK") (c3 ok ns "\n") ok) (string-concat rows row)))))))

;; ---- 5 REPORT -------------------------------------------------------------------------------------------------------
;; the require closure of m over the order text (m included), as a set text
(defn- closure [order :string m :string] :string
  (let [ox (string-concat "\n" order)]
    (loop [todo (c3 m "\n" "") seen (c3 "\n" m "\n")]
      (if (= (string-length todo) 0)
        seen
        (let [pl (pop-line todo)
              x (before-sep pl)
              rest (after-sep pl)
              i (string-index-of-from ox (c3 "\n" x " ") 0)
              line (if (< i 0) "" (string-substring ox (+ i 1) (let [e (string-index-of-from ox "\n" (+ i 1))] (if (< e 0) (string-length ox) e))))
              deps (word-at line 2)
              dl (if (or (string=? deps "-") (string=? deps "")) ""
                   (replace-str (string-substring line (+ (+ (string-length (word-at line 0)) (string-length (word-at line 1))) 2) (string-length line)) " " "\n"))
              dn (l/nlines dl)
              r (loop [k 0 tt rest ss seen]
                  (if (>= k dn)
                    (c3 tt SEP ss)
                    (let [d (l/line-at dl k)]
                      (if (= (in-set ss d) 1) (recur (+ k 1) tt ss) (recur (+ k 1) (c3 tt d "\n") (c3 ss d "\n"))))))]
          (recur (before-sep r) (after-sep r)))))))

;; the status of ns in the rows
(defn- status-of [rows :string ns :string] :string
  (tab-field (tbl-get (string-concat "\n" rows) ns) 0))

;; "<count>\t<code>\t<text>\t<modules>" groups of the REFUSED/TRAP rows by (code, text without " (byte N)", 100 chars)
(defn- norm-text [t :string] :string
  (let [i (string-index-of-from t " (byte " 0)
        u (if (and (>= i 0) (= (ends-with t ")") 1)) (string-substring t 0 i) t)]
    (short u 100)))

(defn- pct [a :i64 b :i64] :string
  (let [x (if (= b 0) 0 (quot (+ (* a 2000) b) (* 2 b)))]
    (c3 (l/dec (quot x 10)) "." (l/dec (- x (* 10 (quot x 10)))))))

(def ENTRIES "check\tkotoba.compiler.nbb.check-cli\ncompile\tkotoba.compiler.nbb.aarch64-cli\nrefactor\tkotoba.compiler.nbb.refactor-cli\n")

(defn- report [W :string order :string rows :string] :string
  (let [n (l/nlines rows)
        counts (loop [k 0 ok 0 rf 0 tr 0 bl 0 ln 0 okl 0]
                 (if (>= k n)
                   (c6 (l/dec ok) " " (l/dec rf) " " (l/dec tr) (c6 " " (l/dec bl) " " (l/dec ln) " " (l/dec okl)))
                   (let [r (l/line-at rows k) s (tab-field r 1) li (l/parse-int (tab-field r 2))]
                     (recur (+ k 1) (if (string=? s "OK") (+ ok 1) ok) (if (string=? s "REFUSED") (+ rf 1) rf)
                            (if (string=? s "TRAP") (+ tr 1) tr) (if (string=? s "BLOCKED") (+ bl 1) bl)
                            (+ ln li) (if (string=? s "OK") (+ okl li) okl)))))
        ok (l/parse-int (word-at counts 0))
        lines (l/parse-int (word-at counts 4))
        okl (l/parse-int (word-at counts 5))
        head (c5 "modules " (l/dec n) " (" (l/dec lines) (c3 " lines): seed OK "
                 (c6 (l/dec ok) " (" (l/dec okl) " lines, " (pct okl lines) "%), REFUSED ")
                 (c6 (word-at counts 1) ", TRAP " (word-at counts 2) ", BLOCKED " (word-at counts 3) "\n")))
        ;; first-refusal groups and by-code counts, in first-seen order
        groups (loop [k 0 keys "\n" acc ""]
                 (if (>= k n)
                   acc
                   (let [r (l/line-at rows k) s (tab-field r 1)]
                     (if (or (string=? s "REFUSED") (string=? s "TRAP"))
                       (let [key (c3 (tab-field r 3) "  " (norm-text (tab-field r 4)))]
                         (if (= (tbl-has keys key) 1)
                           (recur (+ k 1) keys acc)
                           (let [ms (loop [i k a ""]
                                      (if (>= i n) a
                                        (let [q (l/line-at rows i)]
                                          (recur (+ i 1) (if (and (or (string=? (tab-field q 1) "REFUSED") (string=? (tab-field q 1) "TRAP"))
                                                                  (string=? (c3 (tab-field q 3) "  " (norm-text (tab-field q 4))) key))
                                                           (c3 a (if (string=? a "") "" " ") (tab-field q 0)) a)))))]
                             (recur (+ k 1) (c3 keys key "\t\n")
                                    (c6 acc (l/dec (l/nlines (replace-str ms " " "\n"))) "  " key "  [" (string-concat ms "]\n"))))))
                       (recur (+ k 1) keys acc)))))
        entries (loop [k 0 acc ""]
                  (if (>= k 3)
                    acc
                    (let [e (l/line-at ENTRIES k)
                          cmd (tab-field e 0)
                          ns (tab-field e 1)]
                      (if (string=? (status-of rows ns) "")
                        (recur (+ k 1) (c4 acc cmd "\t" (c3 ns "\tnot in the reach list" "\n")))
                        (let [cl (closure order ns)
                              cs (string-substring cl 1 (string-length cl))
                              cn (l/nlines cs)
                              cok (loop [i 0 c 0] (if (>= i cn) c (recur (+ i 1) (if (string=? (status-of rows (l/line-at cs i)) "OK") (+ c 1) c))))
                              walls (sort-lines (loop [i 0 a ""]
                                                  (if (>= i cn) a
                                                    (let [x (l/line-at cs i) s (status-of rows x)]
                                                      (recur (+ i 1) (if (or (string=? s "REFUSED") (string=? s "TRAP")) (c3 a x "\n") a))))))]
                          (recur (+ k 1) (c6 acc cmd "\t" ns (c6 "\t" (l/dec cn) "\t" (l/dec cok) "\t" (l/dec (l/nlines walls)))
                                             (c3 ": " (trim-nl (replace-str walls "\n" " ")) "\n"))))))))
        text (c6 "# selfbuild report (seed/tools/selfbuild.kotoba)\n" head
                 "\nfirst refusals (count, code, text, modules):\n" groups
                 "\ncommand\tentry\tclosure\tseed OK\twalls in closure\n" entries)
        z (l/write-text (string-concat W "/report.txt") text)]
    (string-concat counts (string-concat SEP entries))))

;; the verdict EDN
(defn- edn [W :string seed :string seed-sha :string rung :string amu :string dirty :string counts :string entries :string
            order :string rows :string F :string] :string
  (let [f (string-concat W "/selfbuild.edn")
        n (l/nlines rows)
        z0 (l/write-text f (c6 "{:selfbuild/format 1\n :tool \"seed/tools/selfbuild.kotoba\"\n :seed {:file " (edn-str seed)
                               (c6 " :sha256 " (edn-str seed-sha) " :rung " (edn-str rung) "}\n :amu {:commit " (edn-str amu))
                               (c3 " :src-dirty " dirty "}\n")
                               (c6 " :counts {:modules " (l/dec n) " :ok " (word-at counts 0) " :refused " (word-at counts 1))
                               (c6 " :trap " (word-at counts 2) " :blocked " (word-at counts 3) " :lines " (c5 (word-at counts 4) " :ok-lines " (word-at counts 5) "}\n" " :entries ["))))
        ne (l/nlines entries)
        z1 (loop [k 0]
             (if (>= k ne) 0
               (let [e (l/line-at entries k)
                     z (l/append-raw f (c6 (if (= k 0) "{" "\n           {") ":command " (edn-str (tab-field e 0)) " :ns " (edn-str (tab-field e 1))
                                           (if (string=? (tab-field e 2) "not in the reach list") " :closure nil}"
                                             (c6 " :closure " (tab-field e 2) " :ok " (tab-field e 3) " :walls " (string-concat (l/dec (l/parse-int (tab-field e 4))) "}")))))]
                 (recur (+ k 1)))))
        z2 (l/append-raw f "]\n :inputs-file \"inputs.txt\"\n :modules [")
        z3 (loop [k 0]
             (if (>= k n) 0
               (let [r (l/line-at rows k)
                     ns (tab-field r 0)
                     st (tab-field r 1)
                     fr (tbl-get F ns)
                     src (tab-field fr 0)
                     z (l/append-raw f (c5 (c3 (if (= k 0) "{" "\n           {") ":ns " (edn-str ns))
                                           (c6 " :status :" (cond (string=? st "OK") "ok" (string=? st "REFUSED") "refused" (string=? st "TRAP") "trap" :else "blocked")
                                               " :lines " (tab-field r 2) " :file " (edn-str src))
                                           (c4 " :origin " (edn-str (tab-field fr 2)) " :sha256 " (edn-str (l/sha256-text (l/read-text src))))
                                           (cond (or (string=? st "REFUSED") (string=? st "TRAP")) (c4 " :code " (edn-str (tab-field r 3)) " :text " (edn-str (tab-field r 4)))
                                                 (string=? st "BLOCKED") (string-concat " :blocked-by " (edn-str (string-substring (tab-field r 4) 9 (string-length (tab-field r 4)))))
                                                 :else "")
                                           (string-concat "" "}")))]
                 (recur (+ k 1)))))]
    (let [z4 (l/append-text f "]}\n")] f)))

;; ---- main -----------------------------------------------------------------------------------------------------------
;; the rung whose record names this seed sha256, else "unrecorded seed"
(defn- rung-of [R :string sha :string] :string
  (let [files (git-out R "ls-files\tseed/rungs")
        n (l/nlines files)]
    (loop [k 0]
      (if (>= k n)
        "unrecorded seed"
        (let [f (l/line-at files k)]
          (if (and (= (ends-with f ".record") 1)
                   (string=? (l/field (l/read-text (c3 R "/" f)) "seed1_sha256") sha))
            (l/field (l/read-text (c3 R "/" f)) "rung")
            (recur (+ k 1))))))))

(defn- run-all [R :string W :string repos :string gitlibs :string lock :string seed :string errf :string
                krepo :string krev :string kdir :string expect :i64] :i64
  (let [mark (string-concat "selfbuild: stderr check " W)
        zm (l/err (string-concat mark "\n"))
        et (if (= (l/exists errf) 1) (l/read-text errf) "")]
    (cond (< (string-index-of-from et mark 0) 0)
          (fail (c3 "--stderr " errf " does not receive this tool's stderr (run it with 2> that file)"))
          (= (l/exists W) 1) (fail (c3 "work dir " W " exists: name a new --work (objects of an earlier run are never reused)"))
          (= (l/exists seed) 0) (fail (c3 "no seed " seed " (run seed/tools/bootstrap.kotoba first)"))
          :else
          (let [z0 (l/mkdirs R W)
                ssha (l/sha256-file seed)
                rung (rung-of R ssha)
                offp (string-concat (string-substring seed 0 (- (string-length seed) 4)) ".offset")
                off (if (and (= (ends-with seed ".bin") 1) (= (l/exists offp) 1)) (l/parse-int (l/read-text offp)) 0)
                amu (git-out R "rev-parse\tHEAD")
                dirty (l/dec (l/nlines (git-out R "status\t--porcelain\t--\tsrc")))
                z1 (l/write-text (string-concat W "/inputs.txt")
                                 (c6 "selfbuild-inputs (seed/tools/selfbuild.kotoba)\n"
                                     (c6 "amu " amu " src dirty " dirty "\n" "")
                                     (c6 "seed " seed " sha256 " ssha " (" (c3 rung ") offset " (string-concat (l/dec off) "\n")))
                                     (c5 "lock " lock " sha256 " (l/sha256-text (l/read-text lock)) "\n") "" ""))
                z2 (say (c6 "seed " (short ssha 16) " (" rung "), amu " (string-concat (short amu 10) (c3 " (" dirty " dirty in src)"))))
                roots (farm R W repos gitlibs lock)]
            (if (= (starts-with roots "!") 1)
              (fail (string-substring roots 1 (string-length roots)))
              (let [z3 (say (c3 "farm: " (l/dec (l/nlines roots)) " src roots from the lock"))
                    K (kotoba-lang R W krepo krev kdir)]
                (if (= (starts-with K "!") 1)
                  (fail (string-substring K 1 (string-length K)))
                  (let [allroots (c6 roots R "/src\n" K "/lang/compat\n" "")
                        reach (reach-list R allroots)
                        z4 (l/write-text (string-concat W "/reach.txt") reach)
                        z5 (say (c3 "reach-list: " (l/dec (l/nlines reach)) " files"))
                        mods (reach-twins W reach allroots)
                        z6 (l/write-text (string-concat W "/list.txt") mods)
                        z7 (say (trim-nl (l/line-at (l/read-text (string-concat W "/list.err")) 0)))
                        order (farm-modules R W mods)
                        z8 (say (c3 "farm: " (l/dec (l/nlines order)) " modules in dependency order"))
                        rows (scan W order seed off errf)
                        F (l/read-text (string-concat W "/r6/farm.tsv"))
                        Fx (string-concat "\n" F)
                        z9 (loop [k 0]
                             (if (>= k (l/nlines rows)) 0
                               (let [ns (tab-field (l/line-at rows k) 0)
                                     fr (tbl-get Fx ns)
                                     z (l/append-raw (string-concat W "/inputs.txt")
                                                     (c6 "module " ns " " (l/sha256-text (l/read-text (tab-field fr 0))) " " (string-concat (tab-field fr 2) "\n")))]
                                 (recur (+ k 1)))))
                        z9b (l/append-text (string-concat W "/inputs.txt") "")
                        rp (report W order rows)
                        counts (before-sep rp)
                        entries (after-sep rp)
                        e (edn W seed ssha rung amu dirty counts entries order rows Fx)
                        ok (l/parse-int (word-at counts 0))
                        z10 (say (trim-nl (l/line-at (l/read-text (string-concat W "/report.txt")) 1)))
                        z11 (say (c3 "verdict " e ""))]
                    (if (< ok expect)
                      (fail (c4 "seed OK " (l/dec ok) " < --expect-ok " (l/dec expect)))
                      (let [z (say "OK")] 0))))))))))

(defn main [] :i64
  (if (or (< (l/argc) 1) (string=? (opt "--repos") "") (string=? (opt "--stderr") ""))
    (let [z (l/err "usage: selfbuild <repo> --repos DIR --stderr FILE [--gitlibs DIR] [--lock FILE] [--work DIR] [--seed FILE] [--kotoba-lang-repo DIR --kotoba-lang-rev REV | --kotoba-lang DIR] [--expect-ok N]\n")] 2)
    (let [R (l/arg 0)
          w (opt "--work")
          lk (opt "--lock")
          sd (opt "--seed")
          ex (opt "--expect-ok")]
      (run-all R (if (string=? w "") (string-concat R "/build/selfbuild") w) (opt "--repos") (opt "--gitlibs")
               (if (string=? lk "") (string-concat R "/deps-lock.edn") lk)
               (if (string=? sd "") (string-concat R "/build/seed-boot/r6n/seed-1.bin") sd)
               (opt "--stderr") (opt "--kotoba-lang-repo") (opt "--kotoba-lang-rev") (opt "--kotoba-lang")
               (if (string=? ex "") 0 (l/parse-int ex))))))
