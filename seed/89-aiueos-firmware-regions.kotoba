;; Private metadata snapshot and stack mechanism for the closed image.
;; Firmware map classifications are not OS device ownership grants. In
;; particular EfiMemoryMappedIO is reserved for firmware runtime services.
;; OS MMIO needs a separate ACPI/PCI resource handoff, not this snapshot.
(def KR-MAP-SIZE 288)
(def KR-MAP-STRIDE 296)
(def KR-MAP-READY 304)
(def KR-MAP-DATA 512)
(def KR-MAP-MAX 16384)
(def KR-MAP-MAGIC 0x4d415031)
(def KR-STACK-FLOOR 20480)

;; Check before saving RBP or writing the callee frame. A small padding area
;; separates the immutable catalog from the stack floor. Exhaustion halts
;; directly, so a guest #UD callback cannot recursively exhaust the same stack.
(defn- kr-stack-guard [M :vector-i64 frame :i64] :vector-i64
  (let [halt (vector-at M MM-LABEL-N) end (inc halt)]
    (-> M (iv-reserve 2) (iv-hex "4989e24981ea") (xg-bytes (+ frame 8) 4) (xg-rel 0x820f 2 2 halt)
        (iv-mem 141 11 9 KR-STACK-FLOOR) (iv-hex "4d39da") (xg-rel 0x820f 2 2 halt)
        (xg-rel 0xe9 1 2 end) (xg-label halt) (iv-hex "faf4ebfd") (xg-label end))))

(defn- kr-seal-map [M :vector-i64 fail :i64] :vector-i64
  (-> M (iv-mem 139 8 1 24) (iv-hex "4d85c0") (xg-rel 0x840f 2 2 fail)
      (iv-hex "4981f800400000") (xg-rel 0x870f 2 2 fail)
      (iv-mem 139 10 1 32) (iv-hex "4983fa28") (xg-rel 0x820f 2 2 fail)
      (iv-hex "4d39c2") (xg-rel 0x870f 2 2 fail)
      (iv-hex "4c89c04831d249f7f24885d2") (xg-rel 0x850f 2 2 fail)
      (iv-hex "488db1a0000000483b7110") (xg-rel 0x850f 2 2 fail)
      (iv-mem 137 8 9 KR-MAP-SIZE) (iv-mem 137 10 9 KR-MAP-STRIDE)
      (iv-mem 141 7 9 KR-MAP-DATA) (iv-hex "4c89c1fcf3a4")
      (iv-hex "49c781") (xg-bytes KR-MAP-READY 4) (xg-bytes KR-MAP-MAGIC 4)))
