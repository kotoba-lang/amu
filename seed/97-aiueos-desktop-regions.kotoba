;; A GOP description is metadata, not a memory grant. The paired v6 loader
;; must supply a framebuffer wholly inside a sealed allocated PCI BAR.
;; Browser workspaces are disjoint from DMA, the RX snapshot, tables and FPU.
(def WG-FIRST 92)
(def WG-BASE 30416)
(def WG-SIZE 30424)
(def WG-WIDTH 30432)
(def WG-HEIGHT 30440)
(def WG-STRIDE 30448)
(def WG-FORMAT 30456)
(def WG-READY 30464)
(def WG-FONT 30472)
(def WG-MAGIC 0x31504f47)
(def WG-SURFACE 0x238000)
(def WG-CONTEXT 0x23a000)
(def WG-FONT-BYTES 524288)
(defn- wg-used? [M :vector-i64] :bool
  (and (= (xg-get M 4) 2)
    (loop [i 1]
      (cond (>= i (vector-at M MM-SIR-N)) false
            (and (= (xg-si M i IF-OP) OP-CALL)
                 (>= (km-intr M (xg-si M i IF-A)) WG-FIRST)
                 (< (km-intr M (xg-si M i IF-A)) KM-BOOT-PAYLOAD)) true
            :else (recur (inc i))))))
(defn- wg-seal [M :vector-i64 fail :i64] :vector-i64
  (let [scan (vector-at M MM-LABEL-N) next (inc scan) found (+ scan 2)]
    (-> M (iv-reserve 3)
        (iv-mem 139 1 9 80) (iv-mem 139 10 1 112) (iv-mem 139 11 1 120)
        (iv-hex "4981fa00100000") (xg-rel 0x820f 2 2 fail)
        (iv-hex "49f7c2ff0f0000") (xg-rel 0x850f 2 2 fail)
        (iv-hex "4981fb00100000") (xg-rel 0x820f 2 2 fail)
        (iv-hex "4981fb00000010") (xg-rel 0x870f 2 2 fail)
        (iv-hex "4c89d04c01d8") (xg-rel 0x820f 2 2 fail)
        (iv-hex "48ba00000000800000004839d0") (xg-rel 0x870f 2 2 fail)
        (iv-hex "8b81800000008b91840000008bb1880000008bb98c000000")
        (iv-hex "3d40010000") (xg-rel 0x820f 2 2 fail)
        (iv-hex "3d00200000") (xg-rel 0x870f 2 2 fail)
        (iv-hex "81fac8000000") (xg-rel 0x820f 2 2 fail)
        (iv-hex "81fa00200000") (xg-rel 0x870f 2 2 fail)
        (iv-hex "39c6") (xg-rel 0x820f 2 2 fail)
        (iv-hex "81fe00200000") (xg-rel 0x870f 2 2 fail)
        (iv-hex "83ff01") (xg-rel 0x870f 2 2 fail)
        (iv-mem 137 0 9 WG-WIDTH) (iv-mem 137 2 9 WG-HEIGHT)
        (iv-mem 137 6 9 WG-STRIDE) (iv-mem 137 7 9 WG-FORMAT)
        (iv-hex "4889f0480fafc248c1e0024c39d8") (xg-rel 0x870f 2 2 fail)
        (iv-mem 141 6 9 (+ KR-PCI-DATA 32)) (iv-mem 139 1 9 (+ KR-PCI-DATA 16))
        (xg-label scan) (iv-hex "4885c9") (xg-rel 0x840f 2 2 fail)
        (iv-hex "4c89d0482b06") (xg-rel 0x820f 2 2 next)
        (iv-mem 139 2 6 8) (iv-hex "4c29da") (xg-rel 0x820f 2 2 next)
        (iv-hex "4839d0") (xg-rel 0x860f 2 2 found)
        (xg-label next) (iv-hex "4883c64048ffc9") (xg-rel 0xe9 1 2 scan)
        (xg-label found) (iv-mem 137 10 9 WG-BASE) (iv-mem 137 11 9 WG-SIZE)
        ;; The paired v6 packager owns the exact payload offset and size.
        ;; Padding is emitted by a native font utility, never borrowed RAM.
        (iv-mem 139 1 9 80) (iv-mem 139 8 1 96)
        (iv-hex "488d81c06000004939c0") (xg-rel 0x850f 2 2 fail)
        (iv-hex "4881796800000800") (xg-rel 0x850f 2 2 fail)
        (iv-hex "41813841495546") (xg-rel 0x850f 2 2 fail)
        (iv-hex "4183780401") (xg-rel 0x850f 2 2 fail)
        (iv-hex "418b400883f801") (xg-rel 0x820f 2 2 fail)
        (iv-hex "3de3380000") (xg-rel 0x870f 2 2 fail)
        (iv-mem 137 8 9 WG-FONT)
        (iv-hex "49c781") (xg-bytes WG-READY 4) (xg-bytes WG-MAGIC 4))))
(defn- wg-intrinsic [M :vector-i64 k :i64 t :i64] :vector-i64
  (let [trap (vector-at M MM-LABEL-N) done (inc trap)
        guarded (-> M (iv-reserve 2) (uv-require trap)
                    (iv-hex "4981b9") (xg-bytes WG-READY 4) (xg-bytes WG-MAGIC 4)
                    (xg-rel 0x850f 2 2 trap))
        code (cond (= k 0)
                     (-> guarded (xg-load t 0x858b48) (iv-mem 139 2 9 WG-SIZE)
                         (iv-hex "48c1ea0c4839d0") (xg-rel 0x830f 2 2 trap)
                         (iv-hex "48c1e00c") (iv-mem 3 0 9 WG-BASE))
                   (< k 5) (iv-mem guarded 139 0 9 (+ WG-WIDTH (* 8 (dec k))))
                   (= k 5) (uv-context guarded WG-SURFACE 0)
                   (= k 6) (uv-context guarded WG-CONTEXT 0)
                   :else (iv-mem guarded 139 0 9 WG-FONT))]
    (-> code (xg-rel 0xe9 1 2 done) (xg-label trap) (iv-hex "faf4ebfd")
        (xg-label done) (xg-save t))))

;; A separate, fixed 512 KiB boot-payload region. The v6/PCI boot packager
;; places exactly that many bytes at boot-info + 0x60c0. The guard checks the
;; paired pointer and extent before returning a region root; the caller must
;; still validate the payload format, digest and authority before execution.
(defn- wg-boot-payload [M :vector-i64 t :i64] :vector-i64
  (let [trap (vector-at M MM-LABEL-N) done (inc trap)]
    (-> M (iv-reserve 2) (uv-require trap)
        (iv-mem 139 1 9 80) (iv-hex "4885c9") (xg-rel 0x840f 2 2 trap)
        (iv-hex "48b8") (xg-bytes 0x544f4f4245554941 8)
        (iv-hex "483901") (xg-rel 0x850f 2 2 trap)
        (iv-hex "4883790806") (xg-rel 0x850f 2 2 trap)
        (iv-mem 139 8 1 96)
        (iv-hex "488d81c06000004939c0") (xg-rel 0x850f 2 2 trap)
        (iv-hex "4881796800000800") (xg-rel 0x850f 2 2 trap)
        (iv-hex "4c89c0") (xg-rel 0xe9 1 2 done)
        (xg-label trap) (iv-hex "0f0b")
        (xg-label done) (xg-save t))))
