;; Diagnostic fixed-target Linux ARM64 launcher. It disables dumping for the
;; launcher itself, ignores SIGXFSZ, then execs /usr/bin/curl with an empty
;; environment. Exec may reset dumpability; ignored signals survive exec.
;; This diagnostic is not a host boundary.
(ns seed.linux-curl-sigxfsz-control-packager (:export [main]))
(def IMAGE-BYTES 4096)
(defn- byte-at [v :vector-i64 at :i64 x :i64] :vector-i64 (vector-assoc! v at (bit-and x 255)))
(defn- u16-at [v :vector-i64 at :i64 x :i64] :vector-i64
  (-> v (byte-at at x) (byte-at (+ at 1) (u64-shift-right x 8))))
(defn- u32-at [v :vector-i64 at :i64 x :i64] :vector-i64
  (-> v (u16-at at x) (u16-at (+ at 2) (u64-shift-right x 16))))
(defn- u64-at [v :vector-i64 at :i64 x :i64] :vector-i64
  (-> v (u32-at at x) (u32-at (+ at 4) (u64-shift-right x 32))))
(defn- text-at [v :vector-i64 at :i64 text :string] :vector-i64
  (let [b (vector-i64-from-bytes (string-to-utf8 text))]
    (loop [i 0 out v] (if (= i (vector-count b)) out (recur (+ i 1) (byte-at out (+ at i) (vector-at b i)))))))
(defn- words-at [v :vector-i64 at :i64 words :vector-i64] :vector-i64
  (loop [i 0 out v] (if (= i (vector-count words)) out (recur (+ i 1) (u32-at out (+ at (* i 4)) (vector-at words i))))))
(defn- body-at [v :vector-i64 at :i64] :vector-i64
  (-> v (byte-at at 127) (text-at (+ at 1) "ELF") (byte-at (+ at 4) 2) (byte-at (+ at 5) 1) (byte-at (+ at 6) 1)
      (u16-at (+ at 16) 2) (u16-at (+ at 18) 183) (u32-at (+ at 20) 1) (u64-at (+ at 24) 4194560)
      (u64-at (+ at 32) 64) (u16-at (+ at 52) 64) (u16-at (+ at 54) 56) (u16-at (+ at 56) 1)
      (u32-at (+ at 64) 1) (u32-at (+ at 68) 5) (u64-at (+ at 80) 4194304) (u64-at (+ at 88) 4194304)
      (u64-at (+ at 96) IMAGE-BYTES) (u64-at (+ at 104) IMAGE-BYTES) (u64-at (+ at 112) 4096)
      (words-at (+ at 256) [0x910003f3 0xd2800080 0xd2800001 0xd2800002 0xd2800003 0xd2800004
                            0xd28014e8 0xd4000001 0xf100001f 0x540002a1 0xd10083ff 0xd2800028
                            0xf90003e8 0xa900ffff 0xf9000fff 0xd2800320 0x910003e1 0xd2800002
                            0xd2800103 0xd28010c8 0xd4000001 0xf100001f 0x54000101 0xf90003ff
                            0x910003e2 0x91002261 0x100000e0 0xf9000660 0xd2801ba8
                            0xd4000001 0xd2800fe0 0xd2800ba8 0xd4000001])
      (text-at (+ at 388) "/usr/bin/curl")))
(defn- acknowledged? [request :vector-i64 offset :i64 reply :vector-i64] :bool
  (and (= (vector-count reply) (+ IMAGE-BYTES 5)) (= (vector-at reply 0) 0) (= (vector-at reply 1) 70)
       (= (vector-at reply 2) 83) (= (vector-at reply 3) 50) (= (vector-at reply 4) 0)
       (loop [i 0] (if (= i IMAGE-BYTES) true
         (if (= (vector-at reply (+ i 5)) (vector-at request (+ offset i))) (recur (+ i 1)) false)))))
(defn main [] :i64
  (let [path (typed-cap-call :cli/args :string :string "0") extra (typed-cap-call :cli/args :string :string "1")
        n (string-byte-length path) offset (+ 7 n)]
    (if (or (= n 0) (> n 255) (not (= extra ""))) 2
      (let [v (-> (vector-alloc (+ offset IMAGE-BYTES)) (byte-at 0 0) (byte-at 1 70) (byte-at 2 83)
                  (byte-at 3 50) (byte-at 4 0) (byte-at 5 66) (text-at 6 path) (byte-at (+ 6 n) 0) (body-at offset))
            reply (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 v))]
        (if (acknowledged? v offset (vector-i64-from-bytes reply)) 0 3)))))
