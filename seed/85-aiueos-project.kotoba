;; Locked x86 AIUEOS project adapter. Discovery, cached source-lock reads,
;; namespace/export/schema checks, interfaces, checking and lowering remain
;; the adopted core's owners. Only the target's byte linking differs from
;; 60-proj's AArch64 word-branch linker. No declaration is discarded.
;; This first adapter retains the bounded scalar/no-ISR image admission.
;; Full kernel intrinsics, ISR and live runtime require subsequent gates.

(def KP-ENTRY 43) ; L header: global byte offset + 1 of the image entry
(def KP-ERR-NAME-START 44)
(def KP-ERR-NAME-END 45)

;; 60-proj records AArch64 interface offsets in words. Convert only the
;; newly recorded interface addresses to this backend's byte units; retain
;; the canonical typed clauses and schema identities unchanged.
(defn- kp-iface [M :vector-i64 L :vector-i64 P :string S :string m :i64] :string
  (let [first (pj-l L pj-k-nif) base (pj-l L pj-k-base)
        result (pj-iface M L P S m)
        updated (loop [e first]
                  (if (>= e (pj-l L pj-k-nif)) 0
                    (let [clauses (loop [k 0]
                                    (if (>= k (pj-if L e pj-if-ncl)) 0
                                      (let [old (pj-if L e (+ pj-if-off0 k))
                                            w (pj-iset L e (+ pj-if-off0 k) (+ base (quot (- old base) 4)))]
                                        (recur (inc k)))))]
                      (recur (inc e)))))]
    result))

;; Calls within a module are xg's existing rel32 fixups. Its imported
;; interface stubs become rel32 tail jumps to the already compiled module.
;; Every stub keeps the same arguments, return address and hidden context.
(defn- kp-copy-link [M :vector-i64 L :vector-i64] :vector-i64
  (let [base (pj-l L pj-k-base) size (xg-pos M)
        copied (loop [i 0]
                 (if (>= i size) 0
                   (let [w (pj-ibset L (+ base i) (xg-code-byte M i))] (recur (inc i)))))
        patched (loop [k 0]
                  (if (or (>= k (pj-l L pj-k-nstub)) (not (pj-ok M))) 0
                    (let [f (+ (pj-l L pj-k-stub0) k)
                          at (+ base (dec (xg-f M f FF-CODE)))
                          target (pj-l L (+ pj-t-base k))
                          delta (- target (+ at 5))]
                      (if (or (< at base) (> (+ at 5) (+ base size)) (< target 77)
                              (>= target base) (< delta -2147483648) (> delta 2147483647))
                        (let [w (pj-err M E-PROJ-IMAGE 0)] 0)
                        (let [w (pj-ibset L at 233) w2 (pj-put32 L (inc at) delta)] (recur (inc k)))))))
        filled (pj-ls L pj-k-img (+ base size))]
    M))

(defn- kp-emit-module [M :vector-i64 L :vector-i64 G :vector-i64 S :string m :i64] :vector-i64
  (let [admitted (-> M (xg-set 0 0) (xg-set 1 0) (xg-set 4 2) (mem-set 197 0)
                    (mem-set 200 0) (mem-set 201 0) (mem-set 202 0) (mem-set 203 0)
                    (mem-set 205 0) (mem-set 206 0) (xo-check-fns S 1) (xg-check-sir 1)
                    (xk-scan-count S XK-WINDOW-N false) (km-scan S))
        entry (xg-get admitted 1)]
    (cond (not (pj-ok admitted)) admitted
          (not= (vector-at admitted MM-CAPS) 0) (xg-err admitted 7101 OP-CAP)
          (and (= m 0) (or (= entry 0) (not= (xg-f admitted entry FF-NPARAMS) 0))) (xg-err admitted 7102 entry)
          :else
          (let [code (-> admitted (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1)
                         (xg-index-labels 1) (xg-code 1) (xg-fix 1))
                size (xg-pos code)]
            (cond (not (pj-ok code)) code
                  ;; Report the required cumulative text extent, not this
                  ;; module's size, so the fixed code/data boundary is visible.
                  (> (+ (pj-l L pj-k-base) size) 1048576) (xg-err code 7104 (+ (pj-l L pj-k-base) size))
                  :else (let [linked (kp-copy-link code L)
                              proof (kg-note code L G S m)
                              marked (if (= m 0) (pj-ls L KP-ENTRY (+ (pj-l L pj-k-base) (xg-f code entry FF-CODE))) L)]
                          linked))))))

;; The project intrinsics precede the original four object intrinsic stubs
;; after the canonical import trailer. Account for both suffixes when
;; finding import stubs. The canonical checker owns parameter refinement.
(defn- kp-module-h [M :vector-i64 L :vector-i64 P :string G :vector-i64 m :i64 H :vector-i64] :string
  (let [context (pj-ls L pj-k-errmod m)
        S0 (pj-src M L P m) trailer (pj-trailer L P m)
        S1 (if (pj-ok M) (string-concat S0 (ck-r6b-lib-t S0 "")) S0)
        S (string-concat S1 (string-concat trailer (string-concat (km-lib) (xk-memory-lib))))
        base (bit-and (+ (pj-l L pj-k-img) 15) -16)
        w (-> L (pj-ls pj-k-errmod m) (pj-ls pj-k-trail (string-length S1))
              (pj-ls pj-k-base base) (pj-mset m pj-mf-base base))
        M1 (if (pj-ok M) (pj-read M S) M)
        M2 (if (pj-ok M1) (pj-refcheck (pj-qscan (pj-norm M1 L S) L P S m) L P m) M1)
        M3 (if (pj-ok M2) (pj-splice M2 L) M2)
        M4 (if (pj-ok M3) (nm-run M3 S) M3)
        stubs (if (pj-ok M4) (pj-ls L pj-k-stub0 (- (vector-at M4 MM-FN-N) (pj-l L pj-k-nstub) XK-WINDOW-N KM-INTR-N)) L)
        M5 (if (pj-ok M4) (ck-run-h M4 S H) M4)]
    (cond (and (pj-ok M5) (ck-hint-again? H M5)) (kp-module-h M5 L P G m H)
          (not (pj-ok M5)) (let [w2 (pj-err-back M5 L m (string-length S1))] P)
          :else
          (let [scanned (-> M5 (mem-set 197 0) (mem-set 200 0) (mem-set 201 0)
                            (xk-scan-count S XK-WINDOW-N false) (km-scan S))
                lowered (if (pj-ok scanned) (lw-run scanned) scanned)
                emitted (if (pj-ok lowered) (kp-emit-module lowered L G S m) lowered)]
            (cond (not (pj-ok emitted)) P
                  (not (pj-ok (pj-r5b-after emitted L P S m))) P
                  (= m 0) P
                  :else (kp-iface emitted L P S m))))))

(defn- kp-project [M :vector-i64 L :vector-i64 P :string G :vector-i64 root :i64] :string
  (let [discovered (pj-discover M L P root)
        reserved (pj-ls L pj-k-img 77)]
    (loop [k 0 P discovered]
      (if (or (>= k (pj-l L pj-k-nord)) (not (pj-ok M))) P
        (recur (inc k) (kp-module-h M L P G (pj-l L (+ pj-o-base k)) (ck-hint-new)))))))

(defn- kp-isr-target [G :vector-i64 v :i64] :i64
  (loop [f KG-FIRST]
    (cond (>= f (vector-at G 0)) -1
          (and (= (kg-f G f 1) 2) (= (kg-f G f 4) (inc v))) (kg-f G f 2)
          :else (recur (inc f)))))
(defn- kp-has-isr? [G :vector-i64] :bool
  (loop [f KG-FIRST]
    (cond (>= f (vector-at G 0)) false
          (= (kg-f G f 1) 2) true :else (recur (inc f)))))
(defn- kp-needs-isr? [M :vector-i64] :bool
  (loop [i 1]
    (cond (>= i (vector-at M MM-SIR-N)) false
          (and (= (xg-si M i IF-OP) OP-CALL)
               (= (km-intr M (xg-si M i IF-A)) (+ KM-ISR-FIRST 4))) true
          :else (recur (inc i)))))
(defn- kp-needs-owned? [M :vector-i64] :bool
  (loop [i 1]
    (cond (>= i (vector-at M MM-SIR-N)) false
          (and (= (xg-si M i IF-OP) OP-CALL)
               (let [k (km-intr M (xg-si M i IF-A))]
                 (or (= k KM-OWNED-PAGE) (= k KM-OWNED-WINDOW) (= k KM-PCI-MMIO) (>= k LV-FIRST)))) true
          :else (recur (inc i)))))
(defn- kp-pci? [M :vector-i64] :bool
  (loop [i 1]
    (cond (>= i (vector-at M MM-SIR-N)) false
          (and (= (xg-si M i IF-OP) OP-CALL)
               (let [k (km-intr M (xg-si M i IF-A))]
                 (or (= k KM-PCI-MMIO) (>= k LV-FIRST)))) true
          :else (recur (inc i)))))
;; This trusted bootstrap runs before the user's main and before any guest
;; operation can mutate public boot-info. This non-live profile reserves its
;; low20KiB for GDT/TSS, interrupt state, fuel and the sealed catalog. The live
;; ValueRuntime queue/arena layout needs a separately reconciled ABI.
(defn- kp-owned-init [M :vector-i64 L :vector-i64 at :i64 main-entry :i64 pci :bool] :vector-i64
  (let [reset (-> M (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1) (mem-set MM-LABEL-N 1) (iv-reserve 1))
        checked (-> reset (iv-hex "498b49504885c9") (xg-rel 0x840f 2 2 1)
                    (iv-hex "48b8") (xg-bytes 0x544f4f4245554941 8) (iv-hex "483901") (xg-rel 0x850f 2 2 1)
                    (iv-hex "48837908") (xg-byte (if pci 6 5)) (xg-rel 0x850f 2 2 1)
                    (iv-hex "488379580f") (xg-rel 0x850f 2 2 1)
                    (iv-hex "488b51504885d2") (xg-rel 0x840f 2 2 1)
                    (iv-hex "48f7c2ff0f0000") (xg-rel 0x850f 2 2 1)
                    (iv-hex "4889d0480500f00000") (xg-rel 0x820f 2 2 1)
                    (iv-hex "498991") (xg-bytes KM-SEALED-SCRATCH 4)
                    (iv-hex "49c781") (xg-bytes KM-SEALED-PAGES 4) (xg-bytes 15 4)
                    (kr-seal-map 1)
                    (cond-> pci (kr-seal-pci 1))
                    (cond-> (wg-used? M) (wg-seal 1)))
        delta (- (dec main-entry) (+ at (xg-pos checked) 5))
        code (if (or (< delta -2147483648) (> delta 2147483647)) (xg-err checked 7103 at)
               (-> checked (xg-byte 233) (xg-bytes delta 4) (xg-label 1)
                   (iv-hex (if (wg-used? M) "faf4ebfd" "0f0b")) (xg-fix 1)))
        copied (loop [i 0]
                 (if (or (>= i (xg-pos code)) (not (pj-ok code))) 0
                   (let [w (pj-ibset L (+ at i) (xg-code-byte code i))] (recur (inc i)))))]
    code))
(defn- kp-isr-table [M :vector-i64 L :vector-i64 G :vector-i64 at :i64 data :i64] :vector-i64
  (let [reset (-> M (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1) (mem-set MM-LABEL-N 1))
        generated (loop [v 0]
                    (if (or (>= v IV-VECTORS) (not (pj-ok M))) M
                      (let [target (kp-isr-target G v)
                            part (cond (and (or (= v 6) (= v 13) (= v 14)) (uv-used? M)) (uv-fault M at data v)
                                       (>= target 0)
                                         (iv-entry M v IV-FUEL
                                           (- (- data 4096) (+ at (* v IV-STRIDE) (iv-context-offset v) 4))
                                           (- target (+ at (* v IV-STRIDE) (iv-call-offset v) 4)))
                                       (= v 6) (iv-undefined M)
                                       :else (iv-hex M "faf4ebfd"))
                            end (* (inc v) IV-STRIDE)
                            padded (if (> (xg-pos part) end) (xg-err part 7104 v)
                                     (loop [i (xg-pos part)]
                                       (if (>= i end) part
                                         (let [w (xg-byte part 204)] (recur (inc i))))))]
                        (recur (inc v)))))
        fixed (if (pj-ok generated) (xg-fix generated 1) generated)
        copied (if (pj-ok fixed)
                 (loop [i 0]
                   (if (>= i (* IV-STRIDE IV-VECTORS)) 0
                     (let [w (pj-ibset L (+ at i) (xg-code-byte fixed i))] (recur (inc i))))) 0)]
    fixed))
(defn- kp-image [M :vector-i64 L :vector-i64 G :vector-i64 fuel :i64] :vector-i64
  (let [entry (xg-get M 1) user-main (pj-l L KP-ENTRY) raw-program (pj-l L pj-k-img)
        pci (or (kp-pci? M) (lv-used? M)) owned (or (kp-needs-owned? M) (lv-used? M)) init-at (bit-and (+ raw-program 15) -16)
        initialized (if owned (kp-owned-init M L init-at user-main pci) M)
        before-user (if owned (+ init-at (xg-pos initialized)) raw-program)
        user-at (bit-and (+ before-user 15) -16)
        program (if (uv-used? M) (+ user-at UV-SHIM-SIZE) before-user)
        global (if owned (inc init-at) user-main)
        init-gap (if owned (loop [i raw-program]
                            (if (>= i init-at) 0 (let [w (pj-ibset L i 204)] (recur (inc i))))) 0)
        table (bit-and (+ program 127) -128) has-isr (or (kp-has-isr? G) (uv-used? M))
        needs-isr (kp-needs-isr? M)
        size (if has-isr (+ table (* IV-STRIDE IV-VECTORS)) program)
        ;; Keep the v1 user virtual pages stable as kernel text grows. The
        ;; existing size cap below refuses text that reaches this boundary.
        data 1048576]
    (cond (not (pj-ok initialized)) initialized
          (and (uv-used? M) (>= (kp-isr-target G 6) 0)) (xg-err M 7102 6)
          (and (uv-used? M) (>= (kp-isr-target G 14) 0)) (xg-err M 7102 14)
          (and (uv-used? M) (>= (kp-isr-target G 13) 0)) (xg-err M 7102 13)
          (and needs-isr (not has-isr)) (xg-err M 7102 (+ KM-ISR-FIRST 4))
          (or (<= entry 0) (<= global 77) (> size 1048576)
              (>= (+ data (if pci 131072 XI-DATA-SIZE) 280) MM-OUT-CAP)) (xg-err M 7104 size)
          :else
          (let [entries (if has-isr (kp-isr-table M L G table data) M)
                user-code (if (uv-used? M) (uv-copy-handler entries L user-at data) entries)
                gap (if has-isr (loop [i program]
                                 (if (>= i table) 0
                                   (let [w (pj-ibset L i 204)] (recur (inc i))))) 0)
                prefix (-> entries (mem-set (+ MM-FN-BASE (* entry MM-FN-W) FF-CODE) global)
                           (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1)
                           (xi-shim entry) (xg-fix 1) (xi-patch-shim data (if pci 131072 XI-DATA-SIZE)))
                saved (loop [i 0]
                        (if (>= i 77) 0
                          (let [w (pj-ibset L i (xg-code-byte prefix i))] (recur (inc i)))))
                copied (loop [i 0]
                         (if (>= i size) 0
                           (let [w (xg-put-byte M i (pj-ib L i))] (recur (inc i)))))]
            (if (pj-ok prefix)
              (xi-elf (mem-set M MM-CODE-N (inc size)) data fuel (if has-isr (+ 0x101000 table) 0) pci) prefix)))))

(defn- kp-options? [i :i64] :bool
  (if (>= i (io-argc)) true
    (let [flag (io-arg i)]
      (and (< (inc i) (io-argc))
           (or (string=? flag "--artifact") (string=? flag "--output") (string=? flag "--fuel")
               (string=? flag "--source-path") (string=? flag "--source-lock") (string=? flag "--source-lock-sha256"))
           (kp-options? (+ i 2))))))
(defn- kp-command [] :i64
  (let [n (io-argc) path (io-arg 1)
        output-index (drv-pj-flag 1 n "--output") artifact-index (drv-pj-flag 1 n "--artifact")
        fuel-index (drv-pj-flag 1 n "--fuel") out (if (< output-index 0) "" (io-arg output-index))
        fuel (if (< fuel-index 0) 1000000 (xg-budget (io-arg fuel-index)))]
    (cond (or (< (drv-pj-lock-arg 1 n -1) 0) (= (drv-pj-has 1 n "--unpinned") 1)) (drv-fail0 E-PROJ-UNPINNED)
          (or (not (kp-options? 4)) (< artifact-index 0) (not (string=? (io-arg artifact-index) "image"))
              (= (string-length out) 0) (< fuel 1)
              (= (drv-pj-has 1 n "--format") 1) (= (drv-pj-has 1 n "--payload") 1)) (drv-usage)
          (= (io-exists out) 1) (drv-fail0 E-WRITE)
          :else
          (let [M (mem-new) L (pj-new-l) G (kg-new)
                P0 (drv-pj-roots L (pj-new-p L) 1 n)
                locked (drv-pj-lock M L P0 path)
                P (if (pj-ok M) (kp-project M L (pj-padd L locked path) G (dec (pj-n L))) locked)
                admitted (if (pj-ok M) (kg-check M L G P) M)
                image (if (pj-ok admitted) (kp-image admitted L G fuel) admitted)]
            (cond (>= (vector-at image MM-ERR) 7100)
                  (let [w (io-err (string-concat "kernel project in " (string-concat (pj-err-path L P) ":\n")))
                        a (pj-l L KP-ERR-NAME-START) b (pj-l L KP-ERR-NAME-END)
                        source (if (> b a) (pj-src image L P (pj-l L pj-k-errmod)) "")
                        named (if (and (> b a) (>= a 0) (<= b (string-length source)))
                                (io-err (string-concat "kernel function " (string-concat (string-substring source a b) ":\n"))) 0)]
                    (xo-report image (pj-err-path L P) out))
                  (not (pj-ok image))
                  (if (= (pj-l L pj-k-nmod) 0) (drv-fail-in image path "") (drv-pj-fail image L P))
                  :else (let [written (out-write-v image out (+ MM-OUT-BASE 1) (dec (vector-at image MM-OUT-N)))]
                          (if (= (io-exists out) 1) 0 (drv-fail0 E-WRITE))))))))
