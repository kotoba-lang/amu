;; JUN-31: native PE32+ transition loader packaging. No foreign object/linker.
;; Transcribes the ordinary two-segment transition in packaging/pe32plus:
;; firmware GOP metadata, AllocatePages/CopyMem, private scratch/map,
;; ExitBootServices, then the admitted ELF entry. Resident and K16 tender
;; modes are unsupported and must refuse, never silently substitute this mode.
;; This module packages bytes; a boot probe does not qualify the whole OS.

(defn- eb-align [n :i64 a :i64] :i64 (* a (quot (+ n (dec a)) a)))
(defn- eb-le [V :vector-i64 at :i64 n :i64] :i64
  (if (or (< at 0) (> at (vector-count V)) (> n (- (vector-count V) at))) -1
    (loop [i 0 value 0]
      (if (= i n) value
        (recur (inc i) (bit-or value (i64-shift-left (vector-at V (+ at i)) (* 8 i))))))))
(defn- eb-segment? [V :vector-i64 at :i64 flags :i64] :bool
  (let [off (eb-le V (+ at 8) 8) pa (eb-le V (+ at 24) 8)
        size (eb-le V (+ at 32) 8)]
    (and (= (eb-le V at 4) 1) (= (eb-le V (+ at 4) 4) flags)
         (>= off 0) (> size 0) (<= size 3145728) (= size (eb-le V (+ at 40) 8))
         (>= pa 1048576) (<= pa (- 1073741824 size)) (= (bit-and pa 4095) 0)
         (= (eb-le V (+ at 16) 8) pa) (= (eb-le V (+ at 48) 8) 4096)
         (<= off (vector-count V)) (<= size (- (vector-count V) off)))))
(defn- eb-admit? [V :vector-i64] :bool
  (let [n (vector-count V) ph (eb-le V 32 8) entry (eb-le V 24 8)
        rw (eb-le V (+ ph 80) 8)]
    ;; ADR-0276 Part A: the image is admitted by rule. The file is at most 4 MiB, or the RW offset plus 4 MiB from RW 0x300000 up;
    ;; both segments lie in the budget [0x100000, 0x1000000) by address, and they do not overlap by address or by file offset.
    ;; (The rung ladder 0x200000 / 0x400000 / 0x800000 is checked where a layout is paired with a payload slot, eb-dual-layout?.)
    (and (>= n 176) (<= n (if (>= rw 0x300000) (+ (- rw 0x100000) 4194304) 4194304))
         (= (eb-le V 0 8) 0x00010102464c457f)
         (= (eb-le V 8 8) 0) (= (eb-le V 16 2) 2) (= (eb-le V 18 2) 62)
         (= (eb-le V 20 4) 1) (= (eb-le V 48 4) 0)
         (= (eb-le V 52 2) 64) (= (eb-le V 54 2) 56) (= (eb-le V 56 2) 2)
         (>= ph 64) (<= ph (- n 112)) (= (bit-and ph 7) 0)
         (eb-segment? V ph 5) (eb-segment? V (+ ph 56) 6)
         (let [rx (eb-le V (+ ph 24) 8) rxn (eb-le V (+ ph 40) 8)
               rw (eb-le V (+ ph 80) 8) rwn (eb-le V (+ ph 96) 8)]
           (and (>= entry rx) (< entry (+ rx rxn))
                (>= rx 0x100000) (<= (+ rw rwn) 0x1000000)
                (<= (+ (eb-le V (+ ph 8) 8) (eb-le V (+ ph 32) 8)) (eb-le V (+ ph 64) 8))
                (or (<= (+ rx rxn) rw) (<= (+ rw rwn) rx)))))))

;; Backend state 0..8: entry, RX file/address/size, RW file/address/size,
;; kernel bytes, payload bytes. 9..14: data RVA/size/file, reloc RVA/file,
;; embedded kernel offset. CODE is the loader; OUT is the resulting PE.
(defn- eb-setup [M :vector-i64 K :vector-i64 payload :i64 pci :bool opts :i64] :vector-i64
  (let [p (eb-le K 32 8)]
    (-> M (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1)
        (xg-set 0 (eb-le K 24 8)) (xg-set 1 (eb-le K (+ p 8) 8))
        (xg-set 2 (eb-le K (+ p 24) 8)) (xg-set 3 (eb-le K (+ p 32) 8))
        (xg-set 4 (eb-le K (+ p 64) 8)) (xg-set 5 (eb-le K (+ p 80) 8))
        (xg-set 6 (eb-le K (+ p 88) 8)) (xg-set 7 (vector-count K)) (xg-set 8 payload)
        (xg-set 15 (if pci 1 0)) (xg-set 16 (bit-and opts 1))
        (xg-set 17 (bit-and (quot opts 2) 1)) (xg-set 18 (bit-and (quot opts 4) 1))
        (xg-set 14 (eb-align (+ 16560 (if pci EP-BYTES 0) payload) 16)))))
(defn- eb-rip [M :vector-i64 op :i64 n :i64 label :i64] :vector-i64 (xg-rel M op n 2 label))
(defn- eb-alloc [M :vector-i64 second :bool] :vector-i64
  (let [size (if second (xg-get M 6) (xg-get M 3)) address (if second 2 1) source (if second 23 22)]
    (-> M (xg-bytes 0x00000002b9 5) (xg-bytes 0x00000002ba 5)
        (xg-bytes 0xb841 2) (xg-bytes (quot (+ size 4095) 4096) 4)
        (eb-rip 0x0d8d4c 3 address) (xg-bytes 0x2856ff41 4)
        (xg-bytes 0xc08548 3) (eb-rip 0x850f 2 26)
        (eb-rip 0x0d8b48 3 address) (eb-rip 0x158d48 3 source)
        (xg-bytes 0xb841 2) (xg-bytes size 4) (xg-bytes 0x0000016096ff41 7))))
(defn- eb-gop [M :vector-i64] :vector-i64
  (-> M (eb-rip 0x0d8d48 3 19) (xg-bytes 0xd231 2) (eb-rip 0x058d4c 3 20)
      (xg-bytes 0x0000014096ff41 7) (xg-bytes 0xc08548 3) (eb-rip 0x850f 2 24)
      (eb-rip 0x058b48 3 20) (xg-bytes 0xc08548 3) (eb-rip 0x840f 2 24)
      (xg-bytes 0x18508b48 4) (xg-bytes 0xd28548 3) (eb-rip 0x840f 2 24)
      (xg-bytes 0x18428b48 4) (eb-rip 0x058948 3 13)
      (xg-bytes 0x20428b48 4) (eb-rip 0x058948 3 14)
      (xg-bytes 0x08428b48 4) (xg-bytes 0xc08548 3) (eb-rip 0x840f 2 24)
      (xg-bytes 0x04488b 3) (eb-rip 0x0d89 2 15)
      (xg-bytes 0x08508b 3) (eb-rip 0x1589 2 16)
      (xg-bytes 0x0c488b 3) (eb-rip 0x0d89 2 18)
      (xg-bytes 0x20508b 3) (eb-rip 0x1589 2 17) (xg-label 24)))
;; AWAI-118 opt-in loader netlog (`--netlog v1`). Without it no byte below is
;; emitted and the loader is unchanged. Every report is made under boot
;; services: ConOut->OutputString, then one Ethernet broadcast frame
;; (0.0.0.0:7799 -> 255.255.255.255:7799, UDP checksum 0) through the Simple
;; Network protocol of LoadedImage->DeviceHandle, or the first SNP instance.
;; Transmit is called with HeaderSize 0 and its three optional operands as
;; explicit zero stack arguments, then GetStatus is polled until the buffer is
;; recycled (at most 200 x Stall(1000)). No peer address is configured.
;; Text: "AIUEOS_LOADER_FAIL|OK   s=<stage> st=<EFI status> fb=<GOP base>
;; fs=<GOP size> pc=<PCI BAR count>\r\n". Stages: 1 GOP, 2 RX AllocateAddress,
;; 3 RW AllocateAddress, 4 scratch, 5 payload/PCI collector, 6 memory map and
;; ExitBootServices. A failure reports, waits Stall(10 s) and calls
;; ResetSystem(EfiResetCold) so a PXE-first board boots the next image; the
;; existing 0xE9 'F' / 0xF4 exit receipt is still written first.
;; Diagnostic transport only: it grants nothing and qualifies no hardware.
(defn- eb-stage [M :vector-i64 n :i64] :vector-i64
  (if (= (xg-get M 16) 1) (-> M (xg-byte 0xb3) (xg-byte n)) M))
(defn- eb-netlog-values [M :vector-i64] :vector-i64
  (let [V (-> M (eb-rip 0x158b48 3 13) (eb-rip 0x0d8b48 3 14))]
    (if (= (xg-get M 15) 1) (eb-rip V 0x058b4c 3 42) (iv-hex V "4531c0"))))
(defn- eb-netlog-ok [M :vector-i64] :vector-i64
  (if (= (xg-get M 16) 1)
    (let [V (-> M (eb-stage 6) (iv-hex "31f631ff") (eb-netlog-values) (eb-rip 0xe8 1 70))
          C (if (= (xg-get M 15) 1) (-> V (eb-rip 0x3d8d48 3 41) (eb-rip 0x358b48 3 42)) (iv-hex V "31ff31f6"))]
      (-> C (eb-rip 0x158d48 3 10) (eb-rip 0x0d8d48 3 5) (eb-rip 0x058d4c 3 8)
          (eb-rip 0x0d8d4c 3 6) (eb-rip 0x158d4c 3 7) (eb-rip 0xe8 1 80) (eb-netlog-boot 0))) M))
;; Then the boot-info header the kernel admits (offsets 0..152) as five BOOT
;; frames of four words; s= carries the first word's offset/8. BL returns to
;; stage 6 for the memory-map/ExitBootServices pair.
(defn- eb-netlog-boot [M :vector-i64 off :i64] :vector-i64
  (if (>= off 160) (eb-stage M 6)
    (-> M (eb-rip 0x058d48 3 3)
        (iv-hex "488bb0") (xg-bytes off 4) (iv-hex "488b90") (xg-bytes (+ off 8) 4)
        (iv-hex "488b88") (xg-bytes (+ off 16) 4) (iv-hex "4c8b80") (xg-bytes (+ off 24) 4)
        (iv-hex "bf07000000") (eb-stage (quot off 8)) (eb-rip 0xe8 1 70)
        (eb-netlog-boot (+ off 32)))))
;; A stage-5 failure is followed by three PCI frames (PCI catalog builds):
;; PCI1 st=last failing EFI status fb=handle count<<32|index
;;      fs=(bus<<16|dev<<8|fn)<<32|vendor/device pc=code<<48|BAR<<32|stored BARs
;; PCI2/PCI3 st fb fs pc / st fb: the refused descriptor's first 48 bytes as six
;; little-endian words, copied by the collector before the pool was freed.
(defn- eb-netlog-pci [M :vector-i64] :vector-i64
  (if (not= (xg-get M 15) 1) M
    (-> M (iv-hex "80fb05") (eb-rip 0x850f 2 71)
        (eb-rip 0x358b48 3 45) (iv-hex "bf02000000")
        (eb-rip 0x158b48 3 28) (iv-hex "48c1e220") (eb-rip 0x150b48 3 30)
        (eb-rip 0x0d8b48 3 34) (iv-hex "48c1e108") (eb-rip 0x0d0b48 3 35)
        (iv-hex "48c1e108") (eb-rip 0x0d0b48 3 36) (iv-hex "48c1e120")
        (eb-rip 0x058b 2 37) (iv-hex "4809c1")
        (eb-rip 0x058b4c 3 40) (iv-hex "49c1e010") (eb-rip 0x050b4c 3 38)
        (iv-hex "49c1e020") (eb-rip 0x050b4c 3 42) (eb-rip 0xe8 1 70)
        (eb-rip 0x358b48 3 73) (eb-rip 0x158b48 3 74) (eb-rip 0x0d8b48 3 75)
        (eb-rip 0x058b4c 3 76) (iv-hex "bf03000000") (eb-rip 0xe8 1 70)
        (eb-rip 0x358b48 3 77) (eb-rip 0x158b48 3 78) (iv-hex "31c94531c0bf04000000")
        (eb-rip 0xe8 1 70)
        (xg-label 71))))
(defn- eb-netlog-fail [M :vector-i64] :vector-i64
  (-> M (iv-hex "4c89febf01000000") (eb-netlog-values) (eb-rip 0xe8 1 70) (eb-netlog-pci)
      (iv-hex "b98096980041ff96f8000000498b455831c94c89fa4531c04531c9ff5068")))
;; emit(edi kind 0 OK/1 FAIL/2 PCI1/3 PCI2/4 PCI3/5 BAR/6 MAP/7 BOOT/8 CRMB/9 INST, rsi status, rdx/rcx/r8 values, bl stage); r12/r13/r14 are
;; the loader's ImageHandle/SystemTable/BootServices. Assembled from
;; awai118 emit.s (3871 bytes, sha256 cc35819ce160193ab17f76f81599e836e31a7a3a466f3e028c8c8f8869f83b9a), position independent.
;; Label 81 is crumb(rdi): CRMB frames from the previous debug kernel's 16
;; qwords in its context, left in DRAM across a watchdog reset (AWAI-119). Label 84 is wdt(): arms
;; the AMD FCH watchdog (90 s, reset), so a hung debug kernel resets itself.
;; Label 85 is install() (`--install v1`, AWAI-118): only when loaded from the
;; network, connect every controller, rebuild this exact PE file from the
;; pristine loaded image, write
;; it to \EFI\itonami\BOOTX64.EFI on the NVMe GPT FAT volume, add Boot2001
;; "Itonami OS" (only when it differs) and insert it into BootOrder after the
;; first entry. No other file, variable or partition is touched.
;; Label 80 is dump(rdi catalog, rsi count, rdx map buffer, rcx/r8/r9/r10 the
;; map size/key/descriptor size/version cells): one BAR frame per catalog
;; record (st=base fb=size fs=bus<<16|dev<<8|fn pc=BAR<<32|vendor/device),
;; then GetMemoryMap into the loader's buffer and one MAP frame per
;; descriptor (st=type fb=start fs=pages pc=attribute), so the kernel's
;; post-ExitBootServices seals can be replayed off the board.
;; The routine blob is assembled with its GUIDs 8-byte and its UTF-16
;; strings 2-byte aligned relative to its start (firmware asserts CHAR16
;; alignment), so the blob itself starts 16-byte aligned in .text.
(defn- eb-align-code [M :vector-i64] :vector-i64
  (if (= (mod (xg-pos M) 16) 0) M (eb-align-code (xg-byte M 0x90))))
(defn- eb-netlog-routine [M :vector-i64] :vector-i64
  (-> M (eb-align-code) (xg-label 70)
      (iv-hex "554889e553565741574883e4f04881ec000300004889b42480020000488994248802000048898c24900200004c898424980200004889bc24")
      (iv-hex "a00200000fb6c348898424a8020000488d353e0e0000488d7c2440b993000000fcf3a4488b8424a00200004883f809770f4c8d0db30c0000")
