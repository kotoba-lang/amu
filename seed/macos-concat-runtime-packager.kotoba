;; Package the pinned full compiler main with a bounded Darwin string pool.
;; Diagnostic only: this is an execution probe, not a compiler image.
(ns seed.macos-concat-runtime-packager (:export [main]))

(def MAX-FS2-VALUE 8388608)
(def DATA-BYTES 16384)
(def RAW-START 4096)
(def RUNTIME-START 2048)
(def POOL-SETUP-START 2048)
(def CONCAT-START 2184)
(def POOL-EQUAL-START 2556)
(def HELPER-START 1408)
(def TYPED-START 1536)

(defn- byte-at [v :vector-i64 at :i64 value :i64] :vector-i64
  (vector-assoc! v at (bit-and value 255)))

(defn- u32-at [v :vector-i64 at :i64 value :i64] :vector-i64
  (-> v
      (byte-at at value)
      (byte-at (+ at 1) (u64-shift-right value 8))
      (byte-at (+ at 2) (u64-shift-right value 16))
      (byte-at (+ at 3) (u64-shift-right value 24))))

(defn- u64-at [v :vector-i64 at :i64 value :i64] :vector-i64
  (-> v
      (u32-at at (bit-and value 4294967295))
      (u32-at (+ at 4) (u64-shift-right value 32))))

(defn- text-at [v :vector-i64 at :i64 text :string] :vector-i64
  (let [bytes (vector-i64-from-bytes (string-to-utf8 text))
        count (vector-count bytes)]
    (loop [index 0 out v]
      (if (= index count) out
        (recur (+ index 1) (byte-at out (+ at index) (vector-at bytes index)))))))

(defn- generated-at [v :vector-i64 at :i64 raw :vector-i64] :vector-i64
  (loop [i 0 out v]
    (if (= (+ i 5) (vector-count raw)) out
      (recur (+ i 1) (byte-at out (+ at i) (vector-at raw (+ i 5)))))))

(defn- words-at [v :vector-i64 at :i64 words :vector-i64] :vector-i64
  (loop [i 0 out v]
    (if (= i (vector-count words)) out
      (recur (inc i) (u32-at out (+ at (* i 4)) (vector-at words i))))))

(defn- adr8 [at :i64 target :i64] :i64
  (let [delta (- target at)]
    (bit-or 0x10000008
      (bit-or (i64-shift-left (bit-and delta 3) 29)
              (i64-shift-left (quot delta 4) 5)))))

(defn- b-ne [from :i64 target :i64] :i64
  (bit-or 0x54000001 (i64-shift-left (- target from) 5)))

(defn- b-lo [from :i64 target :i64] :i64
  (bit-or 0x54000003 (i64-shift-left (- target from) 5)))

(defn- b-cs [from :i64 target :i64] :i64
  (bit-or 0x54000002 (i64-shift-left (- target from) 5)))

(defn- wrapper-prefix [text-bytes :i64] :vector-i64
  [(data-adrp text-bytes) 0xaa0703f3 0xd2807d08 0xf9000668
   (adr8 1040 HELPER-START) 0xf9001e68
   0x91080268 0xf9009268
   ;; Darwin mmap(0, 256 MiB, PROT_READ|WRITE, MAP_PRIVATE|ANON, -1, 0).
   ;; SYS_mmap=197; x16=0x20000c5. Carry reports the syscall error.
   0xaa1f03e0 0xd2a20001 0xd2800062 0xd2820043 0x92800004
   0xaa1f03e5 0xd28018b0 0xf2a40010 0xd4001001 (b-cs 17 56)
   0xf9009660
   ;; A separate 16 MiB mark arena; all pages begin zeroed.
   0xaa1f03e0 0xd2a02001 0xd2800062 0xd2820043 0x92800004
   0xaa1f03e5 0xd28018b0 0xf2a40010 0xd4001001 (b-cs 29 56)
   0xf9009a60 0xaa1303e7 0xd503201f])

(defn- wrapper-suffix [raw-bytes :i64 grant :bool] :vector-i64
  [
   (adr8 1152 TYPED-START) 0xf9004268
   (adr8 1160 POOL-EQUAL-START) 0xf9003a68
   (adr8 1168 CONCAT-START) 0xf9003e68
   (if grant 0xd2c00408 0xd2800008) 0xf9000a68
   (adr8 1184 RAW-START) 0xf900c268
   (bit-or 0xd2800008 (i64-shift-left (bit-and raw-bytes 65535) 5))
   (bit-or 0xf2a00008 (i64-shift-left (u64-shift-right raw-bytes 16) 5))
   0xf900c668
   (bit-or 0x94000000 (quot (- POOL-SETUP-START 1204) 4))
   (bit-or 0x94000000 (quot (- RAW-START 1208) 4))
   0xf100a81f (b-ne 48 56)
   0xf9410268 0xf100051f (b-lo 51 56)
   0xd2800540 0xd2800030 0xf2a40010 0xd4001001 0xd4200000])

;; pair_new(ctx, offset, byte_length): 1-based handle. The context contains
;; a count pointer at +288, mmap pair base at +296, and mark base at +304.
;; The full runtime's 16,777,216-pair bound traps before any write.
(defn- pair-helper-words [] :vector-i64
  [0xf9409008 0xf9400109 0xd2a0200a 0xeb0a013f 0x54000043 0xd4200000
   0xf940940a 0x8b09114a 0xf9000141 0xf9000542
   0xf940980b 0x8b09016b 0x3900017f
   0x91000529 0xf9000109 0xaa0903e0 0xd65f03c0])

;; typed_cap(ctx, wire, request_kind, result_kind, handle): wire38 in this
;; no-argument probe returns an empty string pair. Wire37 still requires an
;; explicit output grant and its old bounded literal span. All other wires
;; trap. This is a diagnostic CLI fixture, not a general argument broker.
;; These fixed AArch64 words are the reviewed diagnostic control's text,
;; now emitted as Kotoba data. The Mac assembler is not in the build path.
(defn- typed-helper-words [] :vector-i64
  [0xf100983f 0x540005a0 0xf100943f 0x540006c1
   0xf100045f 0x54000681 0xf100047f 0x54000641
   0xf9400808 0xd2c00409 0xeb09011f 0x540005c1
   0xb40005a4 0xf9409008 0xf9400109 0xeb09009f
   0x54000528 0xf9409408 0xd1000484 0x8b041108
   0xf9400109 0xf940050a 0xf101015f 0x54000448
   0xb7f80429 0xf940c40b 0xeb0b013f 0x540003c8
   0xcb09016b 0xeb0b015f 0x54000368 0xf940c00b
   0x8b090161 0xaa0a03e2 0xa9bf7bf3 0xaa0a03f3
   0xd2800020 0xd2800090 0xf2a40010 0xd4001001
   0x54000222 0xeb13001f 0x540001e1 0xd2800000
   0xa8c17bf3 0xd65f03c0 0xf100045f 0x54000141
   0xf100047f 0x54000101 0xf81f0ffe 0xd2800001
   0xd2800002 0xf9401c10 0xd63f0200 0xf84107fe
   0xd65f03c0 0xd4200020])

;; Reviewed AArch64 pool setup, bounded span resolver, concat and equal.
;; The assembler was used once to derive these words; final packaging uses
;; this Kotoba source and the Amu native compiler.
(defn- append-runtime-words [out :vector-i64 start :i64 words :vector-i64] :vector-i64
  (loop [i 0 next out]
    (if (= i (vector-count words)) next
      (recur (+ i 1) (vector-assoc! next (+ start i) (vector-at words i))))))

(defn- runtime-helper-words [] :vector-i64
  (-> (vector-alloc 181)
      (append-runtime-words 0 [
       0xaa1f03e0 0xd2a20001 0xd2800062 0xd2820043 0x92800004 0xaa1f03e5
       0xd28018b0 0xf2a40010 0xd4001001 0x54001562 0xf900ca60 0xf900ce7f
       0xd65f03c0 0xb7f814e2 0xb7f80141 0xf940c408 0xeb08003f 0x54001468
       0xcb010108 0xeb08005f 0x54001408 0xf940c008 0x8b010100 0xd65f03c0
       0xaa2103e9 0xf940cc08 0xeb08013f 0x54001328 0xcb090108 0xeb08005f
       0x540012c8 0xf940c808 0x8b090100 0xd65f03c0 0xd10183ff 0xa9007bfd
       0xa90153f3 0xa9025bf5 0xa90363f7 0xa9046bf9 0xa90573fb 0xaa0003f3
       0xf100043f 0x54001123 0xf100045f 0x540010e3 0xf9409268 0xf9400108
       0xeb08003f 0x54001068 0xeb08005f 0x54001028 0xf9409669 0xd100042a
       0x8b0a112a 0xa9405955 0xd100044a 0x8b0a112a 0xa9406157 0xb7f80f36])
      (append-runtime-words 60 [
       0xb7f80f18 0xab1802d9 0x54000ec6 0xaa1303e0 0xaa1503e1 0xaa1603e2
       0x97ffffcb 0xaa0003fa 0xaa1303e0 0xaa1703e1 0xaa1803e2 0x97ffffc6
       0xaa0003fb 0xf940ce7c 0xaa1903f4 0xd280000e 0xb7f80055 0x14000007
       0xaa3503e8 0x8b160108 0xeb1c011f 0x54000061 0xaa1803f4 0xd280002e
       0xd2a20008 0xeb08039f 0x54000bc8 0xcb1c0108 0xeb08029f 0x54000b68
       0xf940ca69 0xb500020e 0x8b1c012a 0xaa1a03eb 0xaa1603ec 0xb40000ac
       0x3840156d 0x3800154d 0xd100058c 0x17fffffc 0xaa1b03eb 0xaa1803ec
       0xb400012c 0x3840156d 0x3800154d 0xd100058c 0x17fffffc 0xaa3503fc
       0x8b1c012a 0x8b16014a 0x17fffff6 0xf940ce68 0x8b140108 0xf900ce68
       0xaa1303e0 0xaa3c03e1 0xaa1903e2 0xf9401e70 0xd63f0200 0xa9407bfd])
      (append-runtime-words 120 [
       0xa94153f3 0xa9425bf5 0xa94363f7 0xa9446bf9 0xa94573fb 0x910183ff
       0xd65f03c0 0xd10143ff 0xa9007bfd 0xa90153f3 0xa9025bf5 0xa90363f7
       0xa9046bf9 0xaa0003f3 0xf100043f 0x540005a3 0xf100045f 0x54000563
       0xf9409268 0xf9400108 0xeb08003f 0x540004e8 0xeb08005f 0x540004a8
       0xf9409669 0xd100042a 0x8b0a112a 0xa9405554 0xd100044a 0x8b0a112a
       0xa9405d56 0xaa1303e0 0xaa1403e1 0xaa1503e2 0x97ffff73 0xaa0003f8
       0xaa1303e0 0xaa1603e1 0xaa1703e2 0x97ffff6e 0xaa0003f9 0xeb1702bf
       0x54000141 0xb40000f5 0x38401708 0x38401729 0x6b09011f 0x540000a1
       0xd10006b5 0x17fffffa 0xd2800020 0x14000002 0xd2800000 0xa9407bfd
       0xa94153f3 0xa9425bf5 0xa94363f7 0xa9446bf9 0x910143ff 0xd65f03c0])
      (append-runtime-words 180 [
       0xd4200000])))

;; ADRP x7, __DATA: wrapper PC is in the first 4 KiB page. The target is
;; 16 KiB-aligned, and the checked image size is far within ADRP's range.
(defn- data-adrp [text-bytes :i64] :i64
  (let [pages (quot text-bytes 4096)]
    (bit-or 0x90000007
      (bit-or (i64-shift-left (bit-and pages 3) 29)
              (i64-shift-left (quot pages 4) 5)))))

(defn- body-at [v :vector-i64 at :i64 raw :vector-i64 text-bytes :i64 grant :bool] :vector-i64
  (let [raw-bytes (- (vector-count raw) 5)
        total-bytes (+ text-bytes DATA-BYTES)]
    (-> v
      ;; mach_header_64: MH_EXECUTE, CPU_TYPE_ARM64, seven commands.
      ;; Direct-syscall launch uses NOUNDEFS|DYLDLINK|PIE (0x00200005).
      (u32-at at 4277009103) (u32-at (+ at 4) 16777228)
      (u32-at (+ at 12) 2) (u32-at (+ at 16) 7)
      (u32-at (+ at 20) 368) (u32-at (+ at 24) 2097157)
      ;; LC_SEGMENT_64 __PAGEZERO, __TEXT, __DATA and __LINKEDIT.
      (u32-at (+ at 32) 25) (u32-at (+ at 36) 72)
      (text-at (+ at 40) "__PAGEZERO")
      (u64-at (+ at 64) 4294967296)
      (u32-at (+ at 104) 25) (u32-at (+ at 108) 72)
      (text-at (+ at 112) "__TEXT")
      (u64-at (+ at 128) 4294967296)
      (u64-at (+ at 136) text-bytes)
      (u64-at (+ at 152) text-bytes)
      (u32-at (+ at 160) 5) (u32-at (+ at 164) 5)
      (u32-at (+ at 176) 25) (u32-at (+ at 180) 72)
      (text-at (+ at 184) "__DATA")
      (u64-at (+ at 200) (+ 4294967296 text-bytes))
      (u64-at (+ at 208) DATA-BYTES)
      (u64-at (+ at 216) text-bytes)
      (u64-at (+ at 224) DATA-BYTES)
      (u32-at (+ at 232) 3) (u32-at (+ at 236) 3)
      (u32-at (+ at 248) 25) (u32-at (+ at 252) 72)
      (text-at (+ at 256) "__LINKEDIT")
      (u64-at (+ at 272) (+ 4294967296 total-bytes))
      (u64-at (+ at 280) DATA-BYTES)
      (u64-at (+ at 288) total-bytes)
      (u32-at (+ at 304) 1) (u32-at (+ at 308) 1)
      ;; macOS dyld starts LC_MAIN; no C runtime or libSystem load command.
      (u32-at (+ at 320) 14) (u32-at (+ at 324) 32)
      (u32-at (+ at 328) 12) (text-at (+ at 332) "/usr/lib/dyld")
      ;; LC_MAIN enters the wrapper, which calls the extracted function.
      (u32-at (+ at 352) 2147483688) (u32-at (+ at 356) 24)
      (u64-at (+ at 360) 1024)
      ;; LC_BUILD_VERSION: macOS 13.0.0.
      (u32-at (+ at 376) 50) (u32-at (+ at 380) 24)
      (u32-at (+ at 384) 1)
      (u32-at (+ at 388) 851968) (u32-at (+ at 392) 851968)
      (words-at (+ at 1024) (wrapper-prefix text-bytes))
      (words-at (+ at 1152) (wrapper-suffix raw-bytes grant))
      (words-at (+ at HELPER-START) (pair-helper-words))
      (words-at (+ at TYPED-START) (typed-helper-words))
      (words-at (+ at RUNTIME-START) (runtime-helper-words))
      (generated-at (+ at RAW-START) raw))))

(defn- acknowledged-image? [request :vector-i64 offset :i64 reply :vector-i64 total-bytes :i64] :bool
  (if (and (= (vector-count reply) (+ total-bytes 5))
           (= (vector-at reply 0) 0) (= (vector-at reply 1) 70)
           (= (vector-at reply 2) 83) (= (vector-at reply 3) 50)
           (= (vector-at reply 4) 0))
    (loop [i 0]
      (if (= i total-bytes) true
        (if (= (vector-at reply (+ i 5)) (vector-at request (+ offset i)))
          (recur (+ i 1)) false)))
    false))

(defn main [] :i64
  (let [path (typed-cap-call :cli/args :string :string "0")
        raw-path (typed-cap-call :cli/args :string :string "1")
        mode (typed-cap-call :cli/args :string :string "2")
        admitted (or (string=? mode "allow") (string=? mode "deny"))
        grant (string=? mode "allow")
        fs2-prefix (string-from-utf8 (bytes-from-vector-i64 [0 70 83 50 0]))
        read-request (string-concat fs2-prefix (string-concat "A" (string-concat raw-path (string-from-utf8 (bytes-from-vector-i64 [0])))))
        raw (vector-i64-from-bytes
             (typed-cap-call :fs/app-data :string :bytes read-request))
        path-bytes (vector-i64-from-bytes (string-to-utf8 path))
        length (vector-count path-bytes)
        offset (+ 7 length)
        raw-bytes (- (vector-count raw) 5)
        text-bytes (* 16384 (quot (+ RAW-START raw-bytes 16383) 16384))
        total-bytes (+ text-bytes DATA-BYTES)]
    (if (or (= length 0) (> length 255) (not admitted)
            (and (not= raw-bytes 3254848) (not= raw-bytes 516) (not= raw-bytes 694))
            (> (+ offset total-bytes) MAX-FS2-VALUE)
            (> (+ total-bytes 5) MAX-FS2-VALUE)
            (not (= (vector-at raw 0) 0)) (not (= (vector-at raw 1) 70))
            (not (= (vector-at raw 2) 83)) (not (= (vector-at raw 3) 50))
            (not (= (vector-at raw 4) 0))) 2
      (let [v0 (vector-alloc (+ offset total-bytes))
            v1 (-> v0
                   (byte-at 0 0) (byte-at 1 70) (byte-at 2 83)
                   (byte-at 3 50) (byte-at 4 0) (byte-at 5 66)
                   (text-at 6 path)
                   (byte-at (+ 6 length) 0)
                   (body-at offset raw text-bytes grant))
            response (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 v1))]
        (if (acknowledged-image? v1 offset (vector-i64-from-bytes response) total-bytes) 0 3)))))
