;; x86_64 Linux runtime profile. Context v11, SysV native helper calls.
;; Guest direct calls reserve r9 for context and put arguments 6..16 on stack.
(defn- xr-call [M :vector-i64 slot :i64] :vector-i64
  (-> M (xg-bytes 0xf87d8b48 4) (xg-bytes 0x97ff 2) (xg-bytes slot 4) (xg-bytes 0xf84d8b4c 4)))
(defn- xr-args [M :vector-i64 t :i64 i :i64 n :i64] :vector-i64
  (if (= i n) M
    (xr-args (xg-load M (+ t i) (case i 0 0xb58b48 1 0x958b48 2 0x8d8b48 3 0x858b4c 4 0x8d8b4c 0)) t (inc i) n)))
;; Inline vector reads and writes: a bounds-checked load or store in place of
;; the helper call. Context v11 words: 312 = &vector-used, 320 = descriptors
;; (offset, length), 328 = items; they are fixed after the runtime's start.
;; The helpers' checks run in their order (handle 1..used, then index
;; 0..length-1) and a failure is the helpers' own ud2, so results, fuel,
;; arena counters and traps are unchanged. Nothing is cached across ops.
;; The fixed instruction runs below, one entry per instruction (bits, byte
;; count), read as constant tables (OP-TAB: no allocation, one SIR record per
;; read). xr-run emits entries [a, b): the same bytes as one xg-bytes call per
;; instruction in far fewer SIR records, since every whole-compiler build
;; (this file included) must fit MM-SIR-CAP. 0-4 xr-desc, 5-8 xr-item, 9-22 and
;; 23-31 xr-cpa, 32-37 xr-vec-base.
(defn- xr-run [M :vector-i64 a :i64 b :i64] :vector-i64
  (if (>= a b) M
    (xr-run (xg-bytes M
              (vector-at [0x128b48 0xc8ff48 0xd03948 0xb0f0272 0x4e0c148 0x8483b48 0xb0f0272 0x80348
                          0x148918b49 0x120918b49 0x128b48 0xff488d48 0xd13948 0x4373 0x4e1c148 0x128890349
                          0x118b48 0x8498b48 0xd28548 0x2c78 0xc98548 0x2778 0xb58b48 0xce3948
                          0x1b73 0xd10148 0x188893b49 0xf77 0x180910349 0x3204b60f 0xc084 0x79
                          0xc8ff48 0x4e0c148 0x140810349 0x88b48 0x148918b49 0xca148d48] a)
              (vector-at [3 3 3 4 4 4 4 3 7 7 3 4 3 2 4 7 3 4 3 2 3 2 3 3 2 3 7 2 7 4 2 2 3 4 7 3 7 4] a))
            (inc a) b)))
;; rax = handle -> rax = &descriptor, after (h - 1) <u used (u = 312 and b = u + 8
;; = 320 for vectors, u = 288 and b = 296 for pairs):
;; mov rdx,[r9+u] ; mov rdx,[rdx] ; dec rax ; cmp rax,rdx ; jb +2 ; ud2 ;
;; shl rax,4 ; add rax,[r9+b]
(defn- xr-desc [M :vector-i64 u :i64] :vector-i64
  (-> M (xg-bytes (bit-or 0x918b49 (i64-shift-left u 24)) 7)
      (xr-run 0 5)
      (xg-bytes (bit-or 0x810349 (i64-shift-left (+ u 8) 24)) 7)))
;; rcx = index temp t+1 after i <u length: mov rcx,[t+1] ; cmp rcx,[rax+8] ;
;; jb +2 ; ud2 ; add rcx,[rax] ; mov rdx,[r9+328] -- the item is [rdx+rcx*8]
(defn- xr-item [M :vector-i64 t :i64] :vector-i64
  (-> M (xg-load (inc t) 0x8d8b48) (xr-run 5 9)))
;; (string-code-point-at s i), the R4 rule (seed/HEADS; 41-a64gen gn-rt-cpa,
;; seed/SIR :a64 :r4): when the pair is valid, its offset code-relative (>= 0),
;; its length >= 0, i <u length and offset + length <= code_length ([r9+392]),
;; the byte at code_base ([r9+384]) + offset + i is the result if < 0x80; every
;; other case calls the helper, which checks, validates and refuses as before.
;;   mov rdx,[r9+288] ; mov rdx,[rdx] ; lea rcx,[rax-1] ; cmp rcx,rdx ; jae SLOW ;
;;   shl rcx,4 ; add rcx,[r9+296] ; mov rdx,[rcx] ; mov rcx,[rcx+8] ;
;;   test rdx,rdx ; js SLOW ; test rcx,rcx ; js SLOW ; mov rsi,[t+1] ; cmp rsi,rcx ;
;;   jae SLOW ; add rcx,rdx ; cmp rcx,[r9+392] ; ja SLOW ; add rdx,[r9+384] ;
;;   movzx eax,byte [rdx+rsi] ; test al,al ; jns DONE ; SLOW: the call ; DONE:
(defn- xr-cpa [M :vector-i64 t :i64] :vector-i64
  (let [F (-> M (xg-load t 0x858b48)
              (xr-run 9 23)
              (xg-bytes (xg-temp M (inc t)) 4)
              (xr-run 23 32))
        at (xg-pos F)
        S (-> F (xr-args t 0 2) (xr-call RT-STRING-CODE-POINT-AT))]
    (-> S (xg-put-byte (dec at) (- (xg-pos S) at)) (xg-save t))))
(defn- xr-rt [M :vector-i64 slot :i64 t :i64 n :i64] :vector-i64
  (cond
    ;; (vector-at v i): mov rax,[rdx+rcx*8]
    (and (= slot RT-VECTOR-AT) (= n 2))
      (-> M (xg-load t 0x858b48) (xr-desc 312) (xr-item t) (xg-bytes 0xca048b48 4) (xg-save t))
    ;; (vector-assoc! v i x): mov rax,[t+2] ; mov [rdx+rcx*8],rax; the result is
    ;; v, which temp t already holds
    (and (= slot RT-VECTOR-ASSOC-IN-PLACE) (= n 3))
      (-> M (xg-load t 0x858b48) (xr-desc 312) (xr-item t) (xg-load (+ t 2) 0x858b48)
          (xg-bytes 0xca048948 4))
    ;; one-handle reads: (count v) and pair-second / string-length mov rax,[rax+8],
    ;; pair-first mov rax,[rax]
    (and (= n 1) (or (= slot RT-VECTOR-COUNT) (= slot RT-PAIR-FIRST) (= slot RT-PAIR-SECOND)))
      (-> M (xg-load t 0x858b48) (xr-desc (if (= slot RT-VECTOR-COUNT) 312 288))
          (xg-bytes (if (= slot RT-PAIR-FIRST) 0x008b48 0x08408b48) (if (= slot RT-PAIR-FIRST) 3 4)) (xg-save t))
    (and (= slot RT-STRING-CODE-POINT-AT) (= n 2)) (xr-cpa M t)
    :else (-> M (xr-args t 0 n) (xr-call slot) (xg-save t))))
(defn- xr-cap [M :vector-i64 wire :i64 kind :i64 t :i64] :vector-i64
  (-> M (xg-load t 0x858b4c) (xg-byte 0xbe) (xg-bytes wire 4)
      (xg-byte 0xba) (xg-bytes kind 4) (xg-byte 0xb9) (xg-bytes kind 4)
      (xr-call RT-TYPED-CAP-CALL) (xg-save t)))
(defn- xr-str [M :vector-i64 t :i64 lit :i64] :vector-i64
  (-> M (xg-rel 0xbe 1 4 lit) (xg-byte 0xba)
      (xg-bytes (vector-at M (+ MM-LIT-BASE (* lit MM-LIT-W) LF-LEN)) 4)
      (xr-call RT-PAIR-NEW) (xg-save t)))
;; Two private words below the declared temps, above the outgoing stack area.
(defn- xr-scratch [M :vector-i64] :i64
  (- 0 (* 8 (+ 2 (xg-f M (xg-get M 0) FF-NSLOTS) (xg-f M (xg-get M 0) FF-DEPTH)))))
(defn- xr-alloc [M :vector-i64 n :i64] :vector-i64
  (-> M (xg-byte 0xbe) (xg-bytes n 4) (xr-call RT-VECTOR-ALLOC)
      (xg-bytes 0x858948 3) (xg-bytes (xr-scratch M) 4)))
;; The items go straight into the fresh vector (its handle is rax after
;; xr-alloc, valid by construction, so no check is due): rdx = &items[offset]
;; by dec rax ; shl rax,4 ; add rax,[r9+320] ; mov rcx,[rax] ; mov rdx,[r9+328] ;
;; lea rdx,[rdx+rcx*8]; a literal's words are read from rsi = the pool entry.
(defn- xr-vec-base [M :vector-i64 lit :i64] :vector-i64
  (-> M (xr-run 32 38)
      (cond-> (not= lit 0) (xg-rel 0x358d48 3 5 lit))))
;; mov rax,[t+k] (or mov rax,[rsi+8k]) ; mov [rdx+8k],rax
(defn- xr-vec-items [M :vector-i64 t :i64 k :i64 n :i64 lit :i64] :vector-i64
  (if (= k n) M
    (xr-vec-items
      (-> (if (= lit 0) (xg-load M (+ t k) 0x858b48)
            (-> M (xg-bytes 0x868b48 3) (xg-bytes (* 8 k) 4)))
          (xg-bytes 0x828948 3) (xg-bytes (* 8 k) 4)) t (inc k) n lit)))
(defn- xr-vec-finish [M :vector-i64 t :i64] :vector-i64
  (-> M (xg-bytes 0x858b48 3) (xg-bytes (xr-scratch M) 4) (xg-save t)))
(defn- xr-vec [M :vector-i64 t :i64 n :i64] :vector-i64
  (-> M (xr-alloc n) (cond-> (> n 0) (-> (xr-vec-base 0) (xr-vec-items t 0 n 0))) (xr-vec-finish t)))
(defn- xr-vecp [M :vector-i64 t :i64 lit :i64 n :i64] :vector-i64
  (-> M (xr-alloc n) (cond-> (> n 0) (-> (xr-vec-base lit) (xr-vec-items t 0 n lit))) (xr-vec-finish t)))
(defn- xr-tab [M :vector-i64 t :i64 lit :i64 n :i64] :vector-i64
  (-> M (xg-load t 0x858b48) (xg-bytes 0xf88148 3) (xg-bytes n 4)
      (xg-bytes 0x0272 2) (xg-bytes 0x0b0f 2)
      (xg-rel 0x0d8d48 3 5 lit) (xg-bytes 0xc1048b48 4) (xg-save t)))
(defn- xr-pool-bytes [M :vector-i64 b :i64 n :i64] :vector-i64
  (if (= n 0) M (xr-pool-bytes (xg-byte M (vector-at M (+ MM-LITB-BASE b))) (inc b) (dec n))))
(defn- xr-align [M :vector-i64] :vector-i64
  (if (or (not= (vector-at M MM-ERR) 0) (= (bit-and (xg-pos M) 7) 0)) M (xr-align (xg-byte M 0))))
(defn- xr-pool [M :vector-i64 lit :i64] :vector-i64
  (if (or (not= (vector-at M MM-ERR) 0) (= lit (vector-at M MM-LIT-N))) M
    (let [v (xr-align M) p (+ MM-LIT-BASE (* lit MM-LIT-W))
          w (mem-set v (+ p LF-POOL) (xg-pos v))]
      (xr-pool (xr-pool-bytes w (vector-at w (+ p LF-B)) (vector-at w (+ p LF-LEN))) (inc lit)))))
(defn- xr-check [M :vector-i64 i :i64] :vector-i64
  (if (or (not= (vector-at M MM-ERR) 0) (= i (vector-at M MM-SIR-N))) M
    (let [op (xg-si M i IF-OP) a (xg-si M i IF-A) c (xg-si M i IF-C)]
      (cond (and (= op OP-RT) (or (not (xr-slot a)) (< c 0) (> c 5)
                                (and (or (= a 224) (= a 232)) (not= c 0))
                                (and (= a 80) (not= c 3)) (and (= a 88) (not= c 2)))) (xg-err M 7101 a)
            (and (= op OP-CALLI) (or (< c 0) (> c 5))) (xg-err M 7101 op)
            :else (xr-check M (inc i))))))
(defn- xr-slot [slot :i64] :bool
  (case slot 48 true 56 true 64 true 72 true 80 true 88 true 96 true 104 true 112 true 120 true 128 true 136 true 144 true
    152 true 160 true 168 true 176 true 184 true 192 true 200 true 208 true 216 true
    224 true 232 true 240 true 352 true 360 true 368 true 376 true false))
(defn- xr-build [M :vector-i64 S :string] :vector-i64
  (let [a (-> M (xg-set 0 0) (xg-set 1 0) (xg-set 4 1) (xg-check-fns S 1) (xg-check-sir 1) (xr-check 1))]
    (cond (not= (vector-at a MM-ERR) 0) a
          (= (xg-get a 1) 0) (xg-err a 7102 0)
          :else (-> a (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1)
                    (xg-index-labels 1) (xg-rel 0xe9 1 1 (xg-get a 1)) (xg-code 1) (xr-pool 1) (xg-fix 1)))))
(defn- xr-copy [V :vector-i64 M :vector-i64 i :i64 n :i64 h :i64] :vector-i64
  (if (= i n) V (xr-copy (vector-assoc! V (+ h i) (xg-code-byte M i)) M (inc i) n h)))
(defn- xr-write [M :vector-i64 out :string] :i64
  (let [n (xg-pos M)
        header (string-concat "KX64V1 x86_64-linux sysv-ctx-v11 " (string-concat (mem-u2dec n) " 0\n\n"))
        h (string-length header)
        v (xr-copy (io-bput-str (vector-alloc (+ h n)) header 0 h 0) M 0 n h)
        z (out-write-v v out 0 (+ h n))
        w (io-out (string-concat "{:ok true, :target :x86_64-linux, :format :kx64-v1, :offset 0, :bytes "
                   (string-concat (mem-u2dec n) "}\n")))]
    (if (= (io-exists out) 1) 0 (drv-fail0 E-WRITE))))
(defn- xr-command [] :i64
  (let [src (io-arg 1) out (io-arg 5)]
    (cond (or (not (string=? (io-arg 4) "--output")) (= (string-length out) 0) (= (io-exists out) 1))
            (drv-fail0 E-USAGE)
          (= (io-exists src) 0) (drv-fail0 E-READ)
          :else (let [original (drv-read src) s (string-concat original (ck-r6b-lib original)) m (xr-build (xg-front s) s)]
                  (if (= (vector-at m MM-ERR) 0) (xr-write m out) (drv-fail m src))))))
