    (and (= (kn-hword (kn-request 5) (* i 8)) (kn-policy-word i))
         (= (kn-hword (kn-request 6) (* i 8)) (kn-policy-word (+ i 4))) (recur (inc i))))))
(defn- kn-cid [codec :i64 hash :i64 dst :i64] :i64
  (let [z (kxrt-store8 dst 98)]
    (loop [i 0 acc 0 bits 0 n 1]
      (cond (>= bits 5)
            (let [rest (- bits 5) d (bit-and (u64-shift-right acc rest) 31)
                  w (kxrt-store8 (+ dst n) (if (< d 26) (+ 97 d) (+ 24 d)))]
