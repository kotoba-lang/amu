    (if (or (<= n 0) (and (> n 1) (= (kxrt-load8 p) 48))) (kc-fail 4101)
      (loop [i 0 value 0]
        (if (= i n) value
          (let [digit (- (kxrt-load8 (+ p i)) 48)]
            (if (or (< digit 0) (> digit 9) (> value (quot (- maximum digit) 10))) (kc-fail 4101)
              (recur (inc i) (+ (* value 10) digit)))))))))
(defn- kn-hdigit [c :i64] :i64
