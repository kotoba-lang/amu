;; Bounded local cache host, native Linux x86_64. Reuses the reviewed CDCI
;; supervisor's hash, confined open, image sealing and scalar syscall layer.
;; This is a trusted local host role, not a remotely signed Murakumo Cell.
(defn- kn-token [i :i64] :i64 (+ (kc-g) 22000000 (* i 512)))
(defn- kn-request [i :i64] :i64 (kxrt-load64 (+ (kc-g) 22110000 (* i 8))))
(defn- kn-text? [a :i64 b :i64] :bool
