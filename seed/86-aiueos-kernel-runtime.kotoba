;; Kernel-project intrinsics. The original four object intrinsics and their
;; byte ABI stay in 74. This suffix is admitted only by the locked project
;; adapter with M[197]=0 and an independently checked first FN in M[201].
;; Static runtime builds use cells 200..255 for slots: never inspect them as
;; kernel intrinsics when M[197]>0.
(def KM-MEM-N 29)
(def KM-CPU-FIRST 33)
(def KM-BOOT-INFO 52)
(def KM-XGETBV 53)
(def KM-XSETBV 54)
(def KM-TRY-LOCK 55)
(def KM-UNLOCK 56)
(def KM-ISR-FIRST 57)
(def KM-OWNED-PAGE 73)
(def KM-OWNED-WINDOW 74)
(def KM-PCI-MMIO 75)
(def KM-BOOT-PAYLOAD 100)
(def KM-USER-SLOT 101)
(def KM-RDRAND 102)
(def KM-RDSEED 103)
(def KM-OUT16 104)
(def KM-IN16 105)
(def KM-EFFECTS 106)
(def KM-INTR-N 107)
;; v1/v2 keep their original intrinsic trailer and exact output bytes.
;; Effects/port16 belong to the v3 desktop image contract only.
(defn- km-count [] :i64
  (if (string=? (io-arg 3) "x86_64-aiueos-kernel-v3") KM-INTR-N 104))
(def KM-SEALED-SCRATCH 272)
(def KM-SEALED-PAGES 280)

;; All 32 load/store width/tier operations, excluding the three already
;; supplied by xk-lib: plain u32 load/store and the 16 KiB u32 load.
(defn- km-raw [k :i64] :i64 (+ k (cond (< k 4) 0 (< k 18) 2 :else 3)))
(defn- km-width [raw :i64] :i64 (i64-shift-left 1 (mod (quot raw 2) 4)))
(defn- km-maximum [raw :i64] :i64 (case (quot raw 8) 0 512 1 4096 2 16384 65536))
(defn- km-name [k :i64] :string
  (if (< k KM-MEM-N)
    (let [raw (km-raw k)
          kind (if (= (bit-and raw 1) 0) "kernel-load-" "kernel-store-")
          width (case (mod (quot raw 2) 4) 0 "u8" 1 "u16" 2 "u32" "u64")
          tier (case (quot raw 8) 0 "" 1 "-4k" 2 "-16k" "-64k")]
      (string-concat kind (string-concat width tier)))
    (case (- k KM-MEM-N) 0 "kernel-out-u8" 1 "kernel-out-u32" 2 "kernel-in-u8" 3 "kernel-in-u32"
      4 "kernel-cpuid-eax" 5 "kernel-cpuid-ebx" 6 "kernel-cpuid-ecx" 7 "kernel-cpuid-edx"
      8 "kernel-rdtsc" 9 "kernel-read-cr0" 10 "kernel-read-cr3" 11 "kernel-read-cr4"
      12 "kernel-write-cr0" 13 "kernel-write-cr3" 14 "kernel-write-cr4" 15 "kernel-read-cs"
      16 "kernel-cli" 17 "kernel-sti" 18 "kernel-hlt" 19 "kernel-pause"
      20 "kernel-read-msr" 21 "kernel-write-msr" 22 "kernel-invlpg" 23 "kernel-boot-info"
      24 "kernel-xgetbv" 25 "kernel-xsetbv" 26 "kernel-try-lock-u32" 27 "kernel-unlock-u32"
      28 "kernel-page-fault-handler-address" 29 "kernel-rt-timer-handler-address"
      30 "kernel-configure-page-fault-recovery" 31 "kernel-load-idt" 32 "kernel-isr-entry-address"
      33 "kernel-read-cr2" 34 "kernel-undefined-opcode-handler-address"
      35 "kernel-page-fault-recovery-handler-address" 36 "kernel-double-fault-handler-address"
      37 "kernel-configure-double-fault-ist" 38 "kernel-probe-nx-execute"
      39 "kernel-probe-guard-write" 40 "kernel-probe-text-write"
      41 "kernel-probe-recoverable-guard-write" 42 "kernel-probe-double-fault"
      43 "kernel-debug-break" 44 "kernel-owned-page" 45 "kernel-owned-window" 46 "kernel-pci-mmio"
      47 "kernel-value-provider-queue" 48 "kernel-value-runtime-cas-scratch"
      49 "kernel-value-runtime-capability-table" 50 "kernel-publish-current-domain"
      51 "kernel-publish-value-provider-status" 52 "kernel-value-provider-status"
      53 "kernel-value-runtime-arena" 54 "kernel-register-value-domain"
      55 "kernel-current-domain" 56 "kernel-value-runtime-invoke"
      57 "kernel-value-runtime-request" 58 "kernel-value-domain-request-page"
      59 "kernel-value-enable-user" 60 "kernel-value-enter-user"
      61 "kernel-value-domain-code-page" 62 "kernel-value-domain-stack-page"
      63 "kernel-framebuffer-page" 64 "kernel-framebuffer-width" 65 "kernel-framebuffer-height"
      66 "kernel-framebuffer-stride" 67 "kernel-framebuffer-format"
      68 "kernel-browser-surface" 69 "kernel-browser-context" 70 "kernel-native-font"
      71 "kernel-boot-payload" 72 "kernel-user-slot"
      73 "kernel-rdrand" 74 "kernel-rdseed"
      75 "kernel-out-u16" 76 "kernel-in-u16" 77 "kernel-desktop-effects" "")))
(defn- km-arity [k :i64] :i64
  (cond (= k KM-OUT16) 2 (= k KM-IN16) 1 (= k KM-EFFECTS) 0
        (< k KM-MEM-N) (if (= (bit-and (km-raw k) 1) 0) 3 4)
        (< k (+ KM-MEM-N 2)) 2
        (< k KM-CPU-FIRST) 1
        (= k KM-BOOT-INFO) 0
        (= k KM-XGETBV) 1
        (= k KM-XSETBV) 2
        (or (= k KM-TRY-LOCK) (= k KM-UNLOCK)) 3
        (= k KM-OWNED-PAGE) 1
        (= k KM-OWNED-WINDOW) 2
        (= k KM-PCI-MMIO) 5
        (= k LV-CALL) 6
        (>= k WG-FIRST) (if (= k WG-FIRST) 1 0)
        (>= k UV-FIRST) (if (= k UV-FIRST) 0 1)
        (>= k LV-FIRST) (if (or (= k 79) (= k 80) (= k 82) (= k 83) (= k 87)) 1 0)
        (>= k KM-ISR-FIRST)
          (let [i (- k KM-ISR-FIRST)]
            (cond (or (= i 2) (= i 3) (= i 9)) 2 (= i 4) 1 :else 0))
        :else (let [cpu (- k KM-CPU-FIRST)]
                (cond (< cpu 4) 2
                      (or (and (>= cpu 8) (<= cpu 10)) (= cpu 16) (= cpu 18)) 1
                      (= cpu 17) 2
                      :else 0))))
(defn- km-lib [] :string
  (loop [k 0 text ""]
    (if (>= k (km-count)) text
      (let [args (case (km-arity k) 0 "[]" 1 "[a :i64]" 2 "[a :i64 b :i64]"
                      3 "[a :i64 b :i64 c :i64]" 4 "[a :i64 b :i64 c :i64 d :i64]"
                      6 "[a :i64 b :i64 c :i64 d :i64 e :i64 f :i64]" "[a :i64 b :i64 c :i64 d :i64 e :i64]")]
        (recur (inc k) (string-concat text (string-concat "\n(defn- "
          (string-concat (km-name k) (string-concat " " (string-concat args " :i64 0)\n"))))))))))
(defn- km-intr [M :vector-i64 f :i64] :i64
  (let [first (vector-at M 201) k (- f first)]
    (if (and (= (vector-at M 197) 0) (> first 0) (>= k 0) (< k (km-count))) k -1)))
;; The image shim stores its loader-provided boot pointer at context+80.
;; The paired EFI packager owns a 160-byte v5 prefix plus a 16 KiB map.
;; Only this closed project/image profile can derive that ABI region; no
;; caller-selected address or length is used, and object/static profiles
;; retain their existing refusal rules. Consumers must narrow it explicitly.
(def KM-BOOT-BYTES 16544)
(defn- km-owned-region [M :vector-i64 f :i64 i :i64 t :i64] :i64
  (if (not= (xg-get M 4) 2) -1
    (cond (= (km-intr M f) KM-EFFECTS) (+ 4294967296 16384)
          (= (km-intr M f) KM-BOOT-INFO) (+ 4294967296 KM-BOOT-BYTES)
          (= (km-intr M f) KM-OWNED-PAGE) (+ 4294967296 4096)
          (= (km-intr M f) KM-OWNED-WINDOW)
            (let [n (xk-src M i (inc t) 0)] (if (= n 0) -1 n))
          (= (km-intr M f) KM-PCI-MMIO)
            (let [n (xk-src M i (+ t 4) 0)] (if (= n 0) -1 n))
          (= (km-intr M f) LV-FIRST) (+ 4294967296 512)
          (= (km-intr M f) (+ LV-FIRST 1)) (+ 4294967296 384)
          (or (= (km-intr M f) (+ LV-FIRST 2))
              (= (km-intr M f) (+ LV-FIRST 6))
              (= (km-intr M f) (+ LV-FIRST 7))) (+ 4294967296 4096)
          (= (km-intr M f) 87)
            (+ 4294967296 (if (uv-v5?) 262144 4096))
          (= (km-intr M f) 86) (+ 4294967296 96)
          (= (km-intr M f) WG-FIRST) (+ 4294967296 4096)
          (or (= (km-intr M f) (+ WG-FIRST 5)) (= (km-intr M f) (+ WG-FIRST 6))) (+ 4294967296 WG-WINDOW-BYTES)
          (= (km-intr M f) (+ WG-FIRST 7)) (+ 4294967296 WG-FONT-BYTES)
          (= (km-intr M f) KM-BOOT-PAYLOAD) (+ 4294967296 524288)
          (= (km-intr M f) KM-USER-SLOT) (+ 4294967296 524288)
          (and (>= (km-intr M f) (+ UV-FIRST 2)) (< (km-intr M f) WG-FIRST)) (+ 4294967296 4096)
          :else -1)))
(defn- km-scan [M :vector-i64 S :string] :vector-i64
  (let [first (- (vector-at M MM-FN-N) XK-WINDOW-N (km-count))]
    (if (<= first 1) (xg-err M 7102 first)
      (loop [k 0]
        (if (>= k (km-count)) (mem-set M 201 first)
          (let [f (+ first k) sym (xg-f M f FF-SYM) sb (+ MM-SYM-BASE (* sym MM-SYM-W))
                a (vector-at M (+ sb SF-START)) b (vector-at M (+ sb SF-END))]
            (if (and (string=? (string-substring S a b) (km-name k))
                     (= (xg-f M f FF-KIND) FK-PRIV) (= (xg-f M f FF-NPARAMS) (km-arity k)))
              (recur (inc k)) (xg-err M 7102 f))))))))

;; xg's normal rel32 labels own all jumps. The check subtracts index from
;; an already bounded length, avoiding index+width overflow. Every width
;; above one byte is aligned, matching the owner memwidth window ABI.
(defn- km-window [M :vector-i64 k :i64 t :i64] :vector-i64
  (let [raw (km-raw k) width (km-width raw) store (= (bit-and raw 1) 1)
        trap (vector-at M MM-LABEL-N) end (inc trap)]
    (if (>= end MM-LABEL-CAP) (xg-err M 7104 end)
      (let [v (-> M (mem-set MM-LABEL-N (inc end))
                  (xg-load t 0x958b48) (xg-load (inc t) 0x8d8b48)
                  (xg-load (+ t 2) (if store 0xbd8b48 0x858b48)))
            v1 (if store (xg-load v (+ t 3) 0x858b48) v)
            checked (-> v1
                        (xg-bytes 0xf98148 3) (xg-bytes (km-maximum raw) 4) (xg-rel 0x870f 2 2 trap)
                        (xg-bytes 0xd28548 3) (xg-rel 0x840f 2 2 trap)
                        (xg-bytes (if store 0xcf3948 0xc83948) 3) (xg-rel 0x830f 2 2 trap)
                        (xg-bytes 0xce8948 3) (xg-bytes (if store 0xfe2948 0xc62948) 3)
                        (xg-bytes 0xfe8148 3) (xg-bytes width 4) (xg-rel 0x820f 2 2 trap))
            aligned (if (= width 1) checked
                      (-> checked (xg-bytes (if store 0xc7f748 0xc0f748) 3)
                          (xg-bytes (dec width) 4) (xg-rel 0x850f 2 2 trap)))
            accessed (if store
                       (case width 1 (xg-bytes aligned 0x3a0488 3) 2 (xg-bytes aligned 0x3a048966 4)
                                   4 (xg-bytes aligned 0x3a0489 3) (xg-bytes aligned 0x3a048948 4))
                       (case width 1 (xg-bytes aligned 0x0204b60f 4) 2 (xg-bytes aligned 0x0204b70f 4)
                                   4 (xg-bytes aligned 0x02048b 3) (xg-bytes aligned 0x02048b48 4)))]
        (-> accessed (xg-rel 0xe9 1 2 end) (xg-label trap) (xg-bytes 0x0b0f 2) (xg-label end) (xg-save t))))))
(defn- km-cpu [M :vector-i64 k :i64 t :i64] :vector-i64
  (cond (< k 4)
          (let [v (-> M (xg-load t 0x858b48) (xg-load (inc t) 0x8d8b48)
                      (xg-byte 83) (xg-bytes 0xa20f 2))
                result (case k 0 v 1 (xg-bytes v 0xd889 2) 2 (xg-bytes v 0xc889 2) (xg-bytes v 0xd089 2))]
            ;; CPUID alone clobbers the nonvolatile RBX; save and restore it.
            (-> result (xg-byte 91) (xg-save t)))
        (= k 4) (-> M (xg-bytes 0x310f 2) (xg-bytes 0x20e2c148 4) (xg-bytes 0xd00948 3) (xg-save t))
        (and (>= k 5) (<= k 7))
          (-> M (xg-bytes (case k 5 0xc0200f 6 0xd8200f 0xe0200f) 3) (xg-save t))
        (and (>= k 8) (<= k 10))
          (-> M (xg-load t 0x858b48) (xg-bytes (case k 8 0xc0220f 9 0xd8220f 0xe0220f) 3) (xg-save t))
        (= k 11) (-> M (xg-bytes 0xc88c66c03148 6) (xg-save t))
        (and (>= k 12) (<= k 14))
          (-> M (xg-byte (case k 12 250 13 251 244)) (xg-bytes 0xc031 2) (xg-save t))
        (= k 15) (-> M (xg-bytes 0x90f3 2) (xg-bytes 0xc031 2) (xg-save t))
        (= k 16) (-> M (xg-load t 0x8d8b48) (xg-bytes 0x320f 2)
                     (xg-bytes 0x20e2c148 4) (xg-bytes 0xd00948 3) (xg-save t))
        (= k 17) (-> M (xg-load t 0x8d8b48) (xg-load (inc t) 0x858b48)
                     (xg-bytes 0xc28948 3) (xg-bytes 0x20eac148 4) (xg-bytes 0x300f 2) (xg-save t))
        (= k 18) (-> M (xg-load t 0x858b48) (xg-bytes 0x38010f 3) (xg-save t))
        :else (xg-err M 7101 OP-CALL)))
;; machine-ir's lock owner fixes the CAS pair: 0->1 to acquire, 1->0
;; to release, returning the swap's ZF as 1/0. Keep its 4096-byte bound
;; and lack of an alignment restriction. Never turn a store into unlock.
(defn- km-lock [M :vector-i64 release :bool t :i64] :vector-i64
  (let [trap (vector-at M MM-LABEL-N) end (inc trap)]
    (if (>= end MM-LABEL-CAP) (xg-err M 7104 end)
      (-> M (mem-set MM-LABEL-N (inc end))
          (xg-load t 0x958b48) (xg-load (inc t) 0x8d8b48) (xg-load (+ t 2) 0x858b48)
          (xg-bytes 0xf98148 3) (xg-bytes 4096 4) (xg-rel 0x870f 2 2 trap)
          (xg-bytes 0xd28548 3) (xg-rel 0x840f 2 2 trap)
          (xg-bytes 0xc83948 3) (xg-rel 0x830f 2 2 trap)
          (xg-bytes 0xce8948 3) (xg-bytes 0xc62948 3)
          (xg-bytes 0xfe8148 3) (xg-bytes 4 4) (xg-rel 0x820f 2 2 trap)
          (xg-bytes 0x021c8d4c 4)
          (xg-byte 184) (xg-bytes (if release 1 0) 4)
          (xg-byte 191) (xg-bytes (if release 0 1) 4)
          (xg-bytes 0x3bb10f41f0 5) (xg-bytes 0xc0940f 3) (xg-bytes 0xc0b60f 3)
          (xg-rel 0xe9 1 2 end) (xg-label trap) (xg-bytes 0x0b0f 2)
          (xg-label end) (xg-save t)))))
;; The image-owned bootstrap seals loader metadata before main. The guest
;; supplies only a bounded slot number, never a physical base or length.
(defn- km-page [M :vector-i64 t :i64 window :bool] :vector-i64
  (let [trap (vector-at M MM-LABEL-N) end (inc trap)
        checked (-> M (iv-reserve 2) (xg-load t 0x858b48)
        (iv-hex "4883f80f") (xg-rel 0x830f 2 2 trap)
        (iv-hex "4983b9") (xg-bytes KM-SEALED-PAGES 4) (xg-byte 15) (xg-rel 0x850f 2 2 trap))
        sized (if window
                (-> checked (xg-load (inc t) 0x8d8b48)
                    (iv-hex "4885c9") (xg-rel 0x840f 2 2 trap)
                    (iv-hex "4881f900f00000") (xg-rel 0x870f 2 2 trap)
                    (iv-hex "48f7c1ff0f0000") (xg-rel 0x850f 2 2 trap)
                    (iv-hex "be0f0000004829c648c1e60c4839f1") (xg-rel 0x870f 2 2 trap)) checked)]
    (-> sized
        (iv-hex "498b91") (xg-bytes KM-SEALED-SCRATCH 4)
        (iv-hex "4885d2") (xg-rel 0x840f 2 2 trap)
        (iv-hex "48c1e00c4801d0") (xg-rel 0x820f 2 2 trap)
        (xg-rel 0xe9 1 2 end) (xg-label trap) (iv-hex "0f0b")
        (xg-label end) (xg-save t))))
;; RDRAND/RDSEED (JUN-482): mov ecx,10; L: rdrand|rdseed rax; jc done; dec ecx;
;; jnz L; xor eax,eax; done. The result is the 64-bit value, or 0 when the
;; source reported failure ten times in a row (CF clear): callers must treat
;; 0 as "no entropy" and fail closed. Only rax and rcx are used, both scratch
;; in this runtime like the RDTSC and CPUID intrinsics.
(defn- km-entropy [M :vector-i64 opcode :i64 t :i64] :vector-i64
  (-> M (xg-bytes 0xab9 5) (xg-bytes opcode 4) (xg-bytes 0x0672 2)
        (xg-bytes 0xc9ff 2) (xg-bytes 0xf675 2) (xg-bytes 0xc031 2) (xg-save t)))
(defn- km-intrinsic [M :vector-i64 k :i64 t :i64] :vector-i64
  (cond (= k KM-OUT16)
          (-> M (xg-load t 0x958b48) (xg-load (inc t) 0x858b48)
              (xg-bytes 0xef66 2) (xg-save t))
        (= k KM-IN16)
          (-> M (xg-load t 0x958b48) (xg-bytes 0xc031 2)
              (xg-bytes 0xed66 2) (xg-save t))
        (= k KM-EFFECTS)
          ;; The existing guarded context getter proves the private desktop
          ;; host. Its adjacent, previously unused final 16KiB is disjoint
          ;; from Browser/IME, key state, crypto scratch and all user pages.
          (-> M (wg-intrinsic 6 t) (xg-load t 0x858b48)
              (iv-hex "480500200000") (xg-save t))
        (< k KM-MEM-N) (km-window M k t)
        (= k KM-BOOT-PAYLOAD) (wg-boot-payload M t)
        (= k KM-USER-SLOT) (wg-user-slot M t)
        (= k KM-RDRAND) (km-entropy M 0xf0c70f48 t)
        (= k KM-RDSEED) (km-entropy M 0xf8c70f48 t)
        (>= k WG-FIRST) (wg-intrinsic M (- k WG-FIRST) t)
        (>= k UV-FIRST) (uv-intrinsic M (- k UV-FIRST) t)
        (= k LV-CALL) (lv-call M t)
        (>= k LV-FIRST) (lv-intrinsic M (- k LV-FIRST) t)
        (= k KM-BOOT-INFO) (-> M (xg-bytes 0x50418b49 4) (xg-save t))
        (= k KM-XGETBV)
          (-> M (xg-load t 0x8d8b48) (xg-bytes 0xd0010f 3)
              (xg-bytes 0x20e2c148 4) (xg-bytes 0xd00948 3) (xg-save t))
        (= k KM-XSETBV)
          (-> M (xg-load t 0x8d8b48) (xg-load (inc t) 0x858b48)
              (xg-bytes 0xc28948 3) (xg-bytes 0x20eac148 4)
              (xg-bytes 0xd1010f 3) (xg-save t))
        (or (= k KM-TRY-LOCK) (= k KM-UNLOCK)) (km-lock M (= k KM-UNLOCK) t)
        (= k KM-OWNED-PAGE) (km-page M t false)
        (= k KM-OWNED-WINDOW) (km-page M t true)
        (= k KM-PCI-MMIO) (kr-pci-mmio M t)
        (and (>= k KM-ISR-FIRST) (< k (km-count))) (iv-intrinsic M (- k KM-ISR-FIRST) t)
        (< k (+ KM-MEM-N 2))
          (-> M (xg-load t 0x958b48) (xg-load (inc t) 0x858b48)
              (xg-byte (if (= k KM-MEM-N) 238 239)) (xg-save t))
        (= k (+ KM-MEM-N 2)) (-> M (xg-load t 0x958b48) (xg-bytes 0xc031 2) (xg-byte 236) (xg-save t))
        (= k (+ KM-MEM-N 3)) (-> M (xg-load t 0x958b48) (xg-byte 237) (xg-save t))
        (and (>= k KM-CPU-FIRST) (< k KM-BOOT-INFO)) (km-cpu M (- k KM-CPU-FIRST) t)
        :else (xg-err M 7101 OP-CALL)))
(defn- km-check [M :vector-i64 i :i64] :vector-i64
  (if (or (not= (vector-at M MM-ERR) 0) (>= i (vector-at M MM-SIR-N))) M
    (let [k (if (= (xg-si M i IF-OP) OP-CALL) (km-intr M (xg-si M i IF-A)) -1)]
      (if (or (and (>= k 0) (or (< k KM-MEM-N) (= k KM-TRY-LOCK) (= k KM-UNLOCK) (= k (+ KM-ISR-FIRST 3)))
               (let [b (xg-si M i IF-B) r (xk-region M i b 0) ln (xk-src M i (inc b) 0)]
                      (not (and (>= r 0) (not= ln 0) (xk-same-extent? M i ln r)))))
              (and (or (= k (+ KM-ISR-FIRST 2)) (= k (+ KM-ISR-FIRST 9)))
                   (let [b (xg-si M i IF-B) page (+ 4294967296 4096)]
                     (or (not= (xk-region M i b 0) page)
                         (not= (xk-region M i (inc b) 0) page)))))
        (xg-err M 7106 i) (km-check M (inc i))))))
