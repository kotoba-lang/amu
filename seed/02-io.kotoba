;; seed/02-io.kotoba -- the seed's file, argv and stream access (prefix io-). Owner: module 02-io.
;; Capabilities used (HEADS :caps), nothing else: wire 35 :fs/app-data (:string -> :string forms: read the whole file at
;; an absolute path, "<path>EXISTS_SEP", "<path>RANGE_SEP<off>:<len>", "<path>WRITE_SEP<text>"), wire 38 :cli/args,
;; wire 39 :io/write-error, wire 37 :io/write. The path must lie inside KEXE_CAP_RESOURCES_35, otherwise the loader
;; traps (SIGILL): that is not an error value, so callers print their usage line first and check io-exists.
;;
;; API (readers return :i64/:string and never touch M; writers return M and follow MEMORY-MAP rules L1/L4/L10):
;;   io-out s               -> 0       write s to stdout (wire 37)
;;   io-err s               -> 0       write s to stderr (wire 39); no "seed: " prefix, no newline added
;;   io-argc                -> i64     number of guest arguments (wire 38, "")
;;   io-arg i               -> string  argument i (0-based), "" past the end
;;   io-exists path         -> 1/0     "<path>EXISTS_SEP"
;;   io-read-file M path    -> string  the whole file (M is only there for the call shape of the design; unused)
;;   io-slice path off len  -> string  bytes off..off+len-1 of the file ("RANGE_SEP"): the substring primitive the seed
;;                                     has, because HEADS has no substring: diagnostics print {name} with it
;;   io-write-text path s   -> i64     "<path>WRITE_SEP<s>" (text, ASCII); the file content length is returned
;;   io-check-read M path   -> M       E-IO-READ (201) into MM-ERR (first error wins) unless the file exists; R0 = 1/0
;;   io-check-write M path  -> M       E-IO-WRITE (202) unless the file exists afterwards; R0 = 1/0
;;   io-write-hex M base len-> i64     M[base..base+len) (one byte per word, low 8 bits) as lowercase hex on stdout,
;;                                     64 bytes per line, each line ends in "\n"; `xxd -r -p` recovers the bytes. THE
;;                                     OUTPUT PATH OF THE STABLE STAGE-0 (the :bytes write below is refused by it)
;; Binary writes with :bytes (kind 8) are in seed/02-io-bytes.snippet.kotoba: stage-0 refuses even DEAD code that
;; contains a :bytes capability call (measured), so that function cannot live in this file until the stage-0 image
;; is rebuilt (CONTRACT-REQUESTS 2026-10-02 02-io).
;;
;; Stage-0 rules respected here (01-mem header H1-H5): if/cond only in tail position, no and/or/not, the handle only in
;; straight-line chains.

(defn- io-out [s :string] :i64
  (let [r (typed-cap-call :io/write :string :string s)] 0))

(defn- io-err [s :string] :i64
  (let [r (typed-cap-call :io/write-error :string :string s)] 0))

(defn- io-argc [] :i64
  (let [s (typed-cap-call :cli/args :string :string "")]
    (mem-parse-dec s 0 (string-length s))))

(defn- io-arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (mem-u2dec i)))

;; first byte of the answer is '1' (49)
(defn- io-first-is-one [s :string] :i64
  (cond (= (string-length s) 0) 0
        (= (string-code-point-at s 0) 49) 1
        :else 0))

(defn- io-exists [path :string] :i64
  (io-first-is-one (typed-cap-call :fs/app-data :string :string (string-concat path "EXISTS_SEP"))))

(defn- io-read-file [M :vector-i64 path :string] :string
  (typed-cap-call :fs/app-data :string :string path))

(defn- io-slice [path :string off :i64 len :i64] :string
  (typed-cap-call :fs/app-data :string :string
    (string-concat path (string-concat "RANGE_SEP" (string-concat (mem-u2dec off) (string-concat ":" (mem-u2dec len)))))))

(defn- io-write-text [path :string s :string] :i64
  (let [r (typed-cap-call :fs/app-data :string :string (string-concat path (string-concat "WRITE_SEP" s)))]
    (string-length r)))

;; error word after a check: ok = 1 keeps the recorded error; ok = 0 records `code` unless an error is already there
(defn- io-check-fin [M0 :vector-i64 ok :i64 code :i64] :vector-i64
  (let [e (vector-at M0 MM-ERR)
        p (vector-at M0 MM-ERR-POS)
        e1 (mem-sel e e code)
        p1 (mem-sel e p -1)]
    (vector-assoc! (vector-assoc! (vector-assoc! M0 MM-R0 ok) MM-ERR (mem-sel ok e e1)) MM-ERR-POS (mem-sel ok p p1))))

(defn- io-check-read [M0 :vector-i64 path :string] :vector-i64
  (io-check-fin M0 (io-exists path) E-IO-READ))

(defn- io-check-write [M0 :vector-i64 path :string] :vector-i64
  (io-check-fin M0 (io-exists path) E-IO-WRITE))

;; ---- hex on stdout ---------------------------------------------------------------------------------------
(defn- io-hexd [d :i64] :string
  (cond (= d 0) "0" (= d 1) "1" (= d 2) "2" (= d 3) "3" (= d 4) "4" (= d 5) "5" (= d 6) "6" (= d 7) "7"
        (= d 8) "8" (= d 9) "9" (= d 10) "a" (= d 11) "b" (= d 12) "c" (= d 13) "d" (= d 14) "e" :else "f"))

(defn- io-hex2 [b :i64] :string
  (string-concat (io-hexd (u64-shift-right b 4)) (io-hexd (bit-and b 15))))

;; hex of M[i..end) appended to acc
(defn- io-hex-line [M :vector-i64 i :i64 end :i64 acc :string] :string
  (cond (>= i end) acc
        :else (io-hex-line M (+ i 1) end (string-concat acc (io-hex2 (bit-and (vector-at M i) 255))))))

(defn- io-min [a :i64 b :i64] :i64 (if (< a b) a b))

(defn- io-hex-run [M :vector-i64 i :i64 end :i64] :i64
  (cond (>= i end) 0
        :else (io-hex-step M i end (io-min end (+ i 64)))))

(defn- io-hex-step [M :vector-i64 i :i64 end :i64 e :i64] :i64
  (let [w (typed-cap-call :io/write :string :string (string-concat (io-hex-line M i e "") "\n"))]
    (io-hex-run M e end)))

(defn- io-write-hex [M :vector-i64 base :i64 len :i64] :i64
  (io-hex-run M base (+ base len)))
