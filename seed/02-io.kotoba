;; seed/02-io.kotoba -- native filesystem, argv and stream access.
;; Wire 35 uses mandatory FS2 request framing and provider acknowledgement for
;; strings and bytes. Missing acknowledgement traps; there is no legacy retry.
;; :cli/args (38), :io/write (37), :io/write-error (39) retain their contracts.
;; The compiler source and binary containers stay inside the declared fs scope.
;; MEMORY-MAP handle threading and exact compiler/error behavior are retained.

(defn- io-out [s :string] :i64
  (let [r (typed-cap-call :io/write :string :string s)] 0))

(defn- io-err [s :string] :i64
  (let [r (typed-cap-call :io/write-error :string :string s)] 0))

(defn- io-argc [] :i64
  (let [s (typed-cap-call :cli/args :string :string "")]
    (mem-parse-dec s 0 (string-length s))))

(defn- io-arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (mem-u2dec i)))

;; first byte of the answer is '1' (49)
(defn- io-first-is-one [s :string] :i64
  (cond (= (string-length s) 0) 0
        (= (string-code-point-at s 0) 49) 1
        :else 0))

;; FS2 is mandatory. It frames paths and payloads independently, so compiled
;; bytes containing historical separator words do not need splitting or an old
;; provider fallback. The owner contract is compiler/filesystem_wire.kotoba.
(defn- io-frame [form :string path :string tail :string] :string
  (string-concat "\u0000FS2\u0000" (string-concat form (string-concat path (string-concat "\u0000" tail)))))

(defn- io-ack? [s :string] :bool
  (if (< (string-length s) 5) false
    (and (= (string-code-point-at s 0) 0)
      (and (= (string-code-point-at s 1) 70)
        (and (= (string-code-point-at s 2) 83)
          (and (= (string-code-point-at s 3) 50) (= (string-code-point-at s 4) 0)))))))

(defn- io-answer [s :string] :string
  (if (io-ack? s) (string-substring s 5 (string-length s))
    (string-substring s 0 (vector-at [0] 1))))

(defn- io-exists [path :string] :i64
  (io-first-is-one (io-answer (typed-cap-call :fs/app-data :string :string (io-frame "D" path "")))))

(defn- io-read-file [M :vector-i64 path :string] :string
  (io-answer (typed-cap-call :fs/app-data :string :string (io-frame "A" path ""))))

(defn- io-slice [path :string off :i64 len :i64] :string
  (io-answer (typed-cap-call :fs/app-data :string :string
    (io-frame "E" path (string-concat (mem-u2dec off) (string-concat ":" (mem-u2dec len)))))))

(defn- io-write-text [path :string s :string] :i64
  (let [r (io-answer (typed-cap-call :fs/app-data :string :string (io-frame "B" path s)))]
    (string-length r)))

;; error word after a check: ok = 1 keeps the recorded error; ok = 0 records `code` unless an error is already there
(defn- io-check-fin [M0 :vector-i64 ok :i64 code :i64] :vector-i64
  (let [e (vector-at M0 MM-ERR)
        p (vector-at M0 MM-ERR-POS)
        e1 (mem-sel e e code)
        p1 (mem-sel e p -1)]
    (vector-assoc! (vector-assoc! (vector-assoc! M0 MM-R0 ok) MM-ERR (mem-sel ok e e1)) MM-ERR-POS (mem-sel ok p p1))))

(defn- io-check-read [M0 :vector-i64 path :string] :vector-i64
  (io-check-fin M0 (io-exists path) E-IO-READ))

(defn- io-check-write [M0 :vector-i64 path :string] :vector-i64
  (io-check-fin M0 (io-exists path) E-IO-WRITE))

;; ---- hex on stdout ---------------------------------------------------------------------------------------
(defn- io-hexd [d :i64] :string
  (cond (= d 0) "0" (= d 1) "1" (= d 2) "2" (= d 3) "3" (= d 4) "4" (= d 5) "5" (= d 6) "6" (= d 7) "7"
        (= d 8) "8" (= d 9) "9" (= d 10) "a" (= d 11) "b" (= d 12) "c" (= d 13) "d" (= d 14) "e" :else "f"))

(defn- io-hex2 [b :i64] :string
  (string-concat (io-hexd (u64-shift-right b 4)) (io-hexd (bit-and b 15))))

;; hex of M[i..end) appended to acc
(defn- io-hex-line [M :vector-i64 i :i64 end :i64 acc :string] :string
  (cond (>= i end) acc
        :else (io-hex-line M (+ i 1) end (string-concat acc (io-hex2 (bit-and (vector-at M i) 255))))))

(defn- io-min [a :i64 b :i64] :i64 (if (< a b) a b))

(defn- io-hex-run [M :vector-i64 i :i64 end :i64] :i64
  (cond (>= i end) 0
        :else (io-hex-step M i end (io-min end (+ i 64)))))

(defn- io-hex-step [M :vector-i64 i :i64 end :i64 e :i64] :i64
  (let [w (typed-cap-call :io/write :string :string (string-concat (io-hex-line M i e "") "\n"))]
    (io-hex-run M e end)))

(defn- io-write-hex [M :vector-i64 base :i64 len :i64] :i64
  (io-hex-run M base (+ base len)))

;; ---- FS2 binary files (wire 35, kind 8) -------------------------------------
(defn- io-bput-str [T :vector-i64 S :string i :i64 end :i64 delta :i64] :vector-i64
  (if (>= i end) (mem-keep T)
    (io-bput-str (vector-assoc! T (+ i delta) (string-code-point-at S i)) S (+ i 1) end delta)))

(defn- io-bput-words [T :vector-i64 M :vector-i64 i :i64 end :i64 delta :i64] :vector-i64
  (if (>= i end) (mem-keep T)
    (io-bput-words (vector-assoc! T (+ i delta) (bit-and (vector-at M i) 255)) M (+ i 1) end delta)))

(defn- io-banswer [response :bytes] :bytes
  (if (< (bytes-count response) 5) (bytes-slice response 0 (vector-at [0] 1))
    (if (and (= (bytes-at response 0) 0)
          (and (= (bytes-at response 1) 70)
            (and (= (bytes-at response 2) 83)
              (and (= (bytes-at response 3) 50) (= (bytes-at response 4) 0)))))
      (bytes-slice response 5 (bytes-count response))
      (bytes-slice response 0 (vector-at [0] 1)))))

(defn- io-bsend [T :vector-i64] :i64
  (let [r (io-banswer (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 T)))] 0))

(defn- io-write-bytes [M :vector-i64 path :string base :i64 len :i64] :i64
  (let [header (string-to-utf8 (io-frame "B" path ""))
        n (bytes-count header)
        T0 (vector-alloc (+ n len))
        T1 (loop [i 0 T T0]
             (if (>= i n) T (recur (+ i 1) (vector-assoc! T i (bytes-at header i)))))
        T2 (io-bput-words T1 M base (+ base len) (- n base))
        sent (io-bsend T2)] len))

(defn- io-path-vec [path :string] :vector-i64
  (vector-i64-from-bytes (string-to-utf8 (io-frame "A" path ""))))

(defn- io-read-bytes [path :string] :vector-i64
  (vector-i64-from-bytes
    ;; C3 kind 9 is string -> bytes read/range. Kind 8 is raw write/append
    ;; only; preserving that distinction avoids widening the provider gate.
    (io-banswer (typed-cap-call :fs/app-data :string :bytes (io-frame "A" path "")))))
