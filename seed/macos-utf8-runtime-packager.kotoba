      (append-runtime-words 120 [
       0x910243ff 0xd65f03c0 0xd4200000 0xd4200020 0xd4200040])
      ;; LC_MAIN enters here with real argc/argv. Install ABI slots 144 and
      ;; 136 before running the generated program.
      (append-runtime-words 2 [(adr8 (+ CLI-RUNTIME-START 8) CODEPOINT-START)
                               0xf9004a68
                               (adr8 (+ CLI-RUNTIME-START 16) SUBSTRING-START)
                               0xf9004668 0xd65f03c0])))

