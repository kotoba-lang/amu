       0xa94363f7 0xa9446bf9 0x910183ff 0xd65f03c0 0xd4200000 0x17fffd80])))

;; string_substring(ctx, pair_handle, start, end) returns a new pair view.
;; Bounds and both UTF-8 boundaries are checked; a nonempty source is fully
;; validated by the codepoint helper before the view is minted. The three
;; final branches call the bounded resolver, codepoint helper and pair_new.
(defn- substring-helper-words [] :vector-i64
  (-> (vector-alloc 67)
      (append-runtime-words 0 [
