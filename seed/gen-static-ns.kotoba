;; Native utility unity fragment with00/01/02. The memory map is the source
;; of truth; this tool changes capacities/bases only, preserving the core.
(defn- gs-find [S :string needle :string start :i64] :i64
  (loop [i start]
    (cond (> (+ i (string-length needle)) (string-length S)) -1
          (string=? (string-substring S i (+ i (string-length needle))) needle) i
          :else (recur (inc i)))))
(defn- gs-number [S :string start :i64 end :i64] :i64
  (loop [i start n 0]
    (if (= i end) n
      (let [c (string-code-point-at S i)]
        (if (or (< c 48) (> c 57) (> n 33554432)) -1
          (recur (inc i) (+ (* n 10) (- c 48))))))))
(defn- gs-constant [S :string name :string] :i64
  (let [key (string-concat "(def " (string-concat name " ")) at (gs-find S key 0)
        start (+ at (string-length key)) end (if (< at 0) -1 (gs-find S ")" start))]
    (if (or (< at 0) (< end 0)) -1 (gs-number S start end))))
(defn- gs-override [P :string name :string] :i64
  (let [key (string-concat ";; [:s " (string-concat name " ")) at (gs-find P key 0)
        start (+ at (string-length key)) end (if (< at 0) -1 (gs-find P "]" start))]
    (if (or (< at 0) (< end 0)) -1 (gs-number P start end))))
(defn- gs-region [i :i64] :string
  (case i 0 "TOK" 1 "NODE" 2 "SYM" 3 "HASH" 4 "FN" 5 "SCOPE" 6 "SIR"
    7 "LABEL" 8 "CODE" 9 "FIX" 10 "LIT" 11 "LITB" 12 "EXP" "OUT"))
(defn- gs-key [region :string suffix :string] :string
  (string-concat "MM-" (string-concat region suffix)))
(defn- gs-cap [N :string P :string region :string] :i64
  (let [name (gs-key region "-CAP") n (gs-override P name)]
    (if (< n 0) (gs-constant N name) n)))
(defn- gs-base [N :string P :string wanted :i64] :i64
  (loop [i 0 base 256]
    (if (= i wanted) base
      (let [region (gs-region i)]
        (recur (inc i) (+ base (* (gs-constant N (gs-key region "-W")) (gs-cap N P region))))))))
(defn- gs-value [N :string P :string name :string old :i64] :i64
  (cond (or (string=? name "MM-WORDS") (string=? name "MM-HEAP-END"))
          (+ (gs-base N P 14) (- (gs-constant N "MM-HEAP-END") (gs-constant N "MM-HEAP-BASE")))
        (string=? name "MM-HEAP-BASE") (gs-base N P 14)
        :else
        (loop [i 0]
          (if (= i 14) old
            (let [region (gs-region i)]
              (cond (string=? name (gs-key region "-BASE")) (gs-base N P i)
                    (string=? name (gs-key region "-CAP")) (gs-cap N P region)
                    :else (recur (inc i))))))))
(defn- gs-render [N :string P :string] :string
  (loop [at 0 out ";; seed/00-ns-static: generated by native seed/gen-static-ns.kotoba.\n"]
    (let [next (gs-find N "(def MM-" at)]
      (if (< next 0) (string-concat out (string-substring N at (string-length N)))
        (let [key-end (gs-find N " " (+ next 5)) value-start (inc key-end) end (gs-find N ")" value-start)
              name (string-substring N (+ next 5) key-end)
              value (gs-value N P name (gs-number N value-start end))]
          (recur end (string-concat out
            (string-concat (string-substring N at value-start) (mem-u2dec value)))))))))
(defn- gs-profile? [P :string] :bool
  (and (> (gs-override P "MM-TOK-CAP") 0) (> (gs-override P "MM-NODE-CAP") 0)
       (> (gs-override P "MM-CODE-CAP") 0) (> (gs-override P "MM-FIX-CAP") 0)
       (> (gs-override P "MM-LITB-CAP") 0) (> (gs-override P "MM-OUT-CAP") 0)
       (> (gs-override P "MM-SIR-CAP") 0)
       (= (loop [at 0 count 0]
            (let [next (gs-find P ";; [:s " at)]
              (if (< next 0) count (recur (+ next 7) (inc count))))) 7)))
(defn- seed-main [] :i64
  (if (not= (io-argc) 3) 1
    (let [N (io-read-file (vector-alloc 1) (io-arg 0))
          P (io-read-file (vector-alloc 1) (io-arg 1))
          words (gs-value N P "MM-WORDS" 0)]
      (if (or (not (gs-profile? P)) (< words 1) (>= words 33554432) (= (io-exists (io-arg 2)) 1)) 1
        (let [S (gs-render N P) w (io-write-text (io-arg 2) S)
              readback (io-read-file (vector-alloc 1) (io-arg 2))]
          (if (string=? S readback) (let [w (io-out "PASS_NATIVE_STATIC_PROFILE_GENERATION\n")] 0) 1))))))
