;; Canonical native CDCI factory. The complete adopted compiler builds
;; only the two reviewed privileged roles from exact source bytes.
(defn- xc-role-hash [role :string] :string
  (cond (string=? role "controller") "319083380bf79d79d996b684a174b72cedacd7e501d26fd570eea15587c7dd85"
        (string=? role "kotoba-native") "7778adf64e83542a4d9655beea8033761691c071666b106beef2674ad9465d8f"
        :else ""))
(defn- xc-command [] :i64
  (cond (not= (io-argc) 6) (drv-usage)
        (= (string-length (xc-role-hash (io-arg 1))) 0) (drv-usage)
        (or (= (io-exists (io-arg 2)) 0) (= (io-exists (io-arg 3)) 0) (= (io-exists (io-arg 4)) 0)) (drv-fail0 E-READ)
        (= (io-exists (io-arg 5)) 1) (drv-fail0 E-WRITE)
        :else (let [guest (drv-pj-lock-text (io-read-bytes (io-arg 2))) common (drv-pj-lock-text (io-read-bytes (io-arg 3))) role (drv-pj-lock-text (io-read-bytes (io-arg 4)))]
                (if (and (string=? (sh-text guest) "a0a543a1b0ab45a017aa7abe5cc1b24737a30cd27007a52e00def46879c01d5d") (string=? (sh-text common) "80dd98a427bd22d488aad21cef0ad47fd553ef9c0f57dd32e859763f373c403c")
                         (string=? (sh-text role) (xc-role-hash (io-arg 1))))
                  (let [text (string-concat guest (string-concat common role)) m (xs-build (xg-front text) text (string-length guest) 3)]
                    (if (= (vector-at m MM-ERR) 0) (xs-write m (io-arg 5)) (xg-report m (io-arg 2) (io-arg 5))))
                  (drv-fail0 E-PROJ-UNPINNED)))))

;; Separate closed measurement factory, not a third CDCI role and not a
;; general privileged guest build mode. Both files must match reviewed bytes;
;; the runtime core and harmless guest entry are compiler-owned.
;; bench-build aarch64-linux HOST REGISTRY NEW --runtime-profile large-vectors-v1
;; x86 measurement payload admission is deliberately not qualified yet.
(defn- xb-command [] :i64
  (cond (or (not= (io-argc) 7)
            (not (string=? (io-arg 1) "aarch64-linux"))
            (not (string=? (io-arg 5) "--runtime-profile"))
            (not (string=? (io-arg 6) "large-vectors-v1"))
            (= (string-length (io-arg 4)) 0)) (drv-usage)
        (or (= (io-exists (io-arg 2)) 0) (= (io-exists (io-arg 3)) 0)) (drv-fail0 E-READ)
        (= (io-exists (io-arg 4)) 1) (drv-fail0 E-WRITE)
        :else (let [host (drv-pj-lock-text (io-read-bytes (io-arg 2)))
                    registry (drv-pj-lock-text (io-read-bytes (io-arg 3)))]
                (if (and (string=? (sh-text host) "c47c0d82e4f487211d5d679315e8126ab59fafc7e84aef80d8fc9e8bf1236ec7")
                         (string=? (sh-text registry) "c2152375e32d162c0ac340a2387818168860ab6f7a74bad4cebaaa765f371b1b"))
                  (let [guest "(ns native-bench (:export [main]))\n(defn main [] :i64 0)\n"
                        rt (string-concat (xa-rt-core-profile 1) (string-concat registry host))
                        text (string-concat guest rt)
                        m (xa-build (xg-front text) text (string-length guest) 0 (vector-alloc 1) 0 0 0)]
                    (if (= (vector-at m MM-ERR) 0) (xa-write m (io-arg 4) 1)
                      (xg-report m (io-arg 2) (io-arg 4))))
                  (drv-fail0 E-PROJ-UNPINNED)))))
