        k2 (kxrt-w b (kxrt-w b v1 0x6f6e67616964222c 8) 0x3a2263697473 6) v2 (+ k2 (kxrt-sdec (+ b k2) (kxrt-load64 (+ p 16))))
        k3 (kxrt-w b (kxrt-w b v2 0x657370616c65222c 8) 0x3a22734e64 5) v3 (+ k3 (kxrt-sdec (+ b k3) (kxrt-load64 (+ p 24))))
        k4 (kxrt-w b (kxrt-w b (kxrt-w b v3 0x6d68636e6562222c 8) 0x226c6575466b7261 8) 0x3a 1) v4 (+ k4 (kxrt-sdec (+ b k4) (kxrt-load64 (+ p 32))))
        k5 (kxrt-w b (kxrt-w b v4 0x796669726576222c 8) 0x3a226c657546 6) v5 (+ k5 (kxrt-sdec (+ b k5) (kxrt-load64 (+ p 40))))
        k6 (kxrt-w b (kxrt-w b v5 0x65536d726177222c 8) 0x3a226465 4) v6 (+ k6 (kxrt-sdec (+ b k6) (kxrt-load64 (+ p 48))))
        k7 (kxrt-w b (kxrt-w b (kxrt-w b v6 0x617768676968222c 8) 0x7265746641726574 8) 0x3a227465736552 7) v7 (+ k7 (kxrt-sdec (+ b k7) (kxrt-load64 (+ p 56))))
