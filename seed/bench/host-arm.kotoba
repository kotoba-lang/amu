
;; Receipt formatting is scalar and occurs only after successful verification.
(defn- kb-array [b :i64 i :i64 p :i64] :i64
  (let [open (kxrt-store8 (+ b i) 91)]
    (loop [k 0 at (inc i)]
      (if (= k 17) (let [close (kxrt-store8 (+ b at) 93)] (inc at))
        (let [comma (if (> k 0) (kxrt-store8 (+ b at) 44) 0) start (if (> k 0) (inc at) at)
              len (kxrt-dec (+ b start) (kxrt-load64 (+ p (* k 8))))] (recur (inc k) (+ start len)))))))
