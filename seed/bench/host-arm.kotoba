        p (+ (kxrt-g) 31000) r (kxrt-syscall 113 4 p 0 0 0 0)
        sec (kxrt-load64 p) ns (kxrt-load64 (+ p 8))]
    (if (or (< r 0) (< sec 0) (> sec 9223372035) (< ns 0) (>= ns 1000000000))
      (kb-refuse 3001) (+ (* sec 1000000000) ns))))
(defn- kb-invoke [address :i64 a :i64 b :i64] :i64
