        m2 (kxrt-gs 24 (kxrt-map KXRT-POOL)) m3 (kxrt-gs 40 (kxrt-map (* KXRT-VECTORS 16)))
        m4 (kxrt-gs 56 (kxrt-map (* KXRT-ITEMS 8))) m5 (kxrt-gs 96 (kxrt-map 65536))
        m6 (kxrt-gs 200 (kxrt-map 16384)) m7 (kxrt-gs 208 (kxrt-map 8192))
        m8 (kxrt-gs 120 (kxrt-map 4096)) m9 (kxrt-gs 136 (kxrt-map 65536))
        m10 (kxrt-gs 184 (kxrt-map 4096)) m11 (kxrt-gs 232 (kxrt-map KXRT-VALUE-MAX))
        fd (kxrt-gs 112 -1) m12 (kxrt-gs 672 (kxrt-map 16384))
        m13 (kxrt-gs 688 (kxrt-map (* 8 KXRT-VECTORS)))
        m14 (kxrt-gs 696 (kxrt-map (* 16 KXRT-REGIONS))) m15 (kxrt-gs 736 (kxrt-map 98304))
        mf2 (kxrt-f2-state) mki (kxrt-ki-init)
        v (kxrt-store64 ctx 11)
        d0 (kxrt-store64 (+ ctx 288) (+ (kxrt-g) 8)) d1 (kxrt-store64 (+ ctx 296) (kxrt-gl 0))
        d2 (kxrt-store64 (+ ctx 304) (kxrt-gl 16)) d3 (kxrt-store64 (+ ctx 312) (+ (kxrt-g) 48))
        d4 (kxrt-store64 (+ ctx 320) (kxrt-gl 40)) d5 (kxrt-store64 (+ ctx 328) (kxrt-gl 56))
        args (if (not= argc 5) (kb-refuse 1001) 0)
        id (kb-argnum 0) count (kb-argnum 2) diagnostic (kb-argnum 3)
        bounded (if (or (< id 0) (>= id 19) (> diagnostic 1)
                        (not= count (if (= diagnostic 1) 1 (kb-n id)))) (kb-refuse 1001) 0)
        payload (kb-load id (kxrt-arg 1))
        f0 (kxrt-gs 168 (kxrt-fuel (kxrt-env 0x4555465f4558454b 0x3d4c 0 10)))
        metered (if (not= (kxrt-gl 176) 1) (kb-refuse 1007) 0)
        f1 (kxrt-store64 (+ ctx 8) (kxrt-gl 168))
        act (+ (kxrt-gl 200) 8192) alt (kxrt-gs 248 (kxrt-map 65536)) ss (+ act 64)
        a0 (kxrt-store64 ss (kxrt-gl 248)) a1 (kxrt-store64 (+ ss 8) 0) a2 (kxrt-store64 (+ ss 16) 65536)
        a3 (if (< (kxrt-syscall 132 ss 0 0 0 0 0) 0) (kxrt-die) 0)
        s0 (kxrt-store64 act (kxrt-load64 (+ ctx 400))) s1 (kxrt-store64 (+ act 8) 2348810240)
        s2 (kxrt-store64 (+ act 16) (kxrt-load64 (+ ctx 400))) s3 (kxrt-store64 (+ act 24) 0)
        g1 (kxrt-signal 4 act) g2 (kxrt-signal 5 act) g3 (kxrt-signal 7 act) g4 (kxrt-signal 8 act)
        g5 (kxrt-signal 11 act) g6 (kxrt-signal 14 act) g7 (kxrt-signal 24 act) g8 (kxrt-signal 31 act)
        g9 (kxrt-signal 2 act) g10 (kxrt-signal 15 act)
        lim (kxrt-limits sp) sb (kxrt-sandbox)
        result (kb-execute id payload count diagnostic)] (kxrt-exit result)))
(defn- kb-sha [a :i64 n :i64] :i64
  (let [s (+ (kxrt-g) 30000) h s w (+ s 64) tail (+ s 576) hex (+ s 704)
        z (loop [i 0] (if (= i 8) 0 (let [v (kxrt-store64 (+ h (* i 8)) (kxrt-sha-h0 i))] (recur (+ i 1)))))
        done (loop [d 0] (if (> (+ d 64) n) d (let [v (kxrt-sha-block h w (+ a d))] (recur (+ d 64)))))
        rest (- n done) c (kxrt-copy tail (+ a done) rest) v (kxrt-store8 (+ tail rest) 128)
        padded (if (<= (+ rest 1) 56) 64 128)
        zz (loop [i (+ rest 1)] (if (= i padded) 0 (let [v (kxrt-store8 (+ tail i) 0)] (recur (+ i 1)))))
        lb (loop [i 0] (if (= i 8) 0 (let [v (kxrt-store8 (+ tail (- padded 1 i)) (bit-and (u64-shift-right (* n 8) (* i 8)) 255))] (recur (+ i 1)))))
        b1 (kxrt-sha-block h w tail) b2 (if (= padded 128) (kxrt-sha-block h w (+ tail 64)) 0)
        render (loop [i 0] (if (= i 64) 0
          (let [word (kxrt-load64 (+ h (* (quot i 8) 8))) digit (bit-and (u64-shift-right word (* (- 7 (- i (* (quot i 8) 8))) 4)) 15)
                v (kxrt-store8 (+ hex i) (+ digit (if (< digit 10) 48 87)))] (recur (+ i 1)))))
        end (kxrt-store8 (+ hex 64) 0)] hex))

