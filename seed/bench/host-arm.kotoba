        a (kxrt-w b (kxrt-w b (kxrt-w b v8 0x6d68636e6562222c 8) 0x616e6572416b7261 8) 0x3a22 2) aa (kb-array b a (+ (kxrt-g) 22000))
        z (kxrt-w b (kxrt-w b aa 0x416c616e6966222c 8) 0x3a22616e6572 6) zz (kb-array b z (+ (kxrt-g) 22200))
        tail (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b zz 0x746c75736572222c 8) 0x726177222c313a22 8) 0x6569646f4270756d 8) 0x6163222c313a2273 8) 0x222c313a22736c6c 8) 0x754f796669726576 8) 0x6d69546564697374 8) 0x7572743a22676e69 8) 0x43656d6173222c65 8) 0x6556747865746e6f 8) 0x72743a2279666972 8) 0x65736572222c6575 8) 0x6564756c636e4974 8) 0x65736c61663a2264 8) 0x726f66726570222c 8) 0x61755165636e616d 8) 0x3a2264656966696c 8) 0xa7d65736c6166 7)
        sent (kxrt-write-all 1 b tail)] (if (= sent 1) 0 1)))
;; Privileged closed ARM measurement host, never appended to ordinary guests.
;; Uses only the existing scalar runtime and exact original payload registry.
;; Command: HOST ID PAYLOAD N PROFILE, PROFILE=0 registered / 1 diagnostic-one.
;; G+20000..20127: receipt; G+22000/G+22200: 17-field snapshots;
;; G+30000..31000 SHA; mappings and offset760 are never repurposed.
(defn- kb-refuse [code :i64] :i64
  (let [b (+ (kxrt-g) 24000) i (kxrt-w b 0 0x3a4553554645524b 8)
        n (+ i (kxrt-dec (+ b i) code)) z (kxrt-store8 (+ b n) 10)
        w (kxrt-write-all 2 b (inc n))] (kxrt-exit 2)))
(defn- kb-argnum [index :i64] :i64
  (let [p (kxrt-arg index) n (kxrt-cstrlen p)]
    (if (or (> n 15) (not (kxrt-digits? p n))) (kb-refuse 1001)
      (kxrt-parse p n))))
(defn- kb-zero [p :i64 n :i64] :i64
  (loop [i 0] (if (= i n) 0 (let [v (kxrt-store8 (+ p i) 0)] (recur (inc i))))))
(defn- kb-pure [] :i64
  (if (or (not= (kxrt-load64 (kxrt-ctx)) 11) (not= (kxrt-gl 680) 0)
          (not= (kxrt-gl 216) 0) (not= (kxrt-gl 224) 0)
          (not= (kxrt-gl 104) 0) (not= (kxrt-gl 112) -1)
          (not= (kxrt-gl 744) 0) (not= (kxrt-gl 656) 0)
          ;; The current shared keyword module owns776(pointer)/784(count).
          ;; Never mistake its initialized pointer for a held FS lock.
          (<= (kxrt-gl 776) 0) (not= (kxrt-gl 784) 0) (not= (kxrt-gl 792) 0)
          (not= (kxrt-load64 (+ (kxrt-ctx) 16)) 0)
          (not= (kxrt-load64 (+ (kxrt-ctx) 24)) 0)
          (not= (kxrt-load64 (+ (kxrt-ctx) 32)) 0)
          (not= (kxrt-load64 (+ (kxrt-ctx) 40)) 0))
    (kb-refuse 2001) 0))
(defn- kb-reset [] :i64
  (let [outside (if (not= (kxrt-load64 (+ (kxrt-g) 20128)) 0) (kb-refuse 2004) 0)
        pure (kb-pure) high (kxrt-gl 760)
        bounds (if (or (< (kxrt-gl 8) 0) (> (kxrt-gl 8) KXRT-PAIRS)
                       (< (kxrt-gl 32) 0) (> (kxrt-gl 32) KXRT-POOL)
                       (< (kxrt-gl 48) 0) (> (kxrt-gl 48) KXRT-VECTORS)
                       (< (kxrt-gl 64) 0) (> (kxrt-gl 64) high) (> high KXRT-ITEMS)
                       (< (kxrt-gl 704) 0) (> (kxrt-gl 704) KXRT-REGIONS)) (kb-refuse 2002) 0)
        pairs (kb-zero (kxrt-gl 16) (kxrt-gl 8))
        regions (kb-zero (kxrt-gl 688) (* 8 (kxrt-gl 48)))
        rows (kb-zero (kxrt-gl 696) (* 16 (kxrt-gl 704)))
        marks (kb-zero (kxrt-gl 672) 16384)
        a (kxrt-gs 8 0) b (kxrt-gs 32 0) c (kxrt-gs 48 0) d (kxrt-gs 64 0)
        e (kxrt-gs 704 0) f (kxrt-gs 256 0) g (kxrt-gs 264 0) h (kxrt-gs 272 0)
        j (kxrt-gs 280 0) k (kxrt-gs 288 0) l (kxrt-gs 712 0)
        m (kxrt-gs 720 0) n (kxrt-gs 728 0)
        fuel (kxrt-store64 (+ (kxrt-ctx) 8) (kxrt-gl 168))]
    ;; No store to752/760: monotonic clock and physical item highwater persist.
    (if (or (not= high (kxrt-gl 760))
            (not= (kxrt-load64 (+ (kxrt-ctx) 8)) (kxrt-gl 168))) (kb-refuse 2003) high)))
(defn- kb-snapshot [p :i64] :i64
  (let [a (kxrt-store64 p (kxrt-gl 8)) b (kxrt-store64 (+ p 8) (kxrt-gl 32))
        c (kxrt-store64 (+ p 16) (kxrt-gl 48)) d (kxrt-store64 (+ p 24) (kxrt-gl 64))
        e (kxrt-store64 (+ p 32) (+ (* 16 (kxrt-gl 8)) (kxrt-gl 32) (* 16 (kxrt-gl 48)) (* 8 (kxrt-gl 64))))
        f (kxrt-store64 (+ p 40) (kxrt-gl 256)) g (kxrt-store64 (+ p 48) (kxrt-gl 264))
        h (kxrt-store64 (+ p 56) (kxrt-gl 712)) i (kxrt-store64 (+ p 64) (kxrt-gl 272))
        j (kxrt-store64 (+ p 72) (kxrt-gl 280)) k (kxrt-store64 (+ p 80) (kxrt-gl 720))
        l (kxrt-store64 (+ p 88) (kxrt-gl 704)) m (kxrt-store64 (+ p 96) (kxrt-gl 728))
        n (kxrt-store64 (+ p 104) 0) o (kxrt-store64 (+ p 112) 0)
        q (kxrt-store64 (+ p 120) (kxrt-gl 288)) r (kxrt-store64 (+ p 128) 0)] 0))
(defn- kb-phase [expected :i64 next :i64] :i64
  (let [p (+ (kxrt-g) 20128)]
    (if (not= (kxrt-load64 p) expected) (kb-refuse 3003)
      (kxrt-store64 p next))))
(defn- kb-now [phase :i64] :i64
