;; Optional cross closure (X86_64-LINUX-MANIFEST): no static runtime. The
;; adopted producer's LITB region cannot hold the runtime text of
;; 76-x86_64-static-rt.kotoba alongside the AArch64 closure; --format static
;; therefore refuses with E7102 here and is built by the Linux selfhost closure.
(defn- xs-rt-src [] :string "")
(defn- xs-rt-core [] :string "")
(defn- xs-rt-launch [] :string "")
(defn- xs-rt-b2 [] :string "")
