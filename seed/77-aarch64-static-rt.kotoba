(defn- kxrt-slot-208 [c :i64 h :i64 i :i64 x :i64] :i64 (kxrt-assoc-in-place h i x))
(defn- kxrt-slot-216 [c :i64 h :i64 m :i64] :i64 (kxrt-index-of h m))
