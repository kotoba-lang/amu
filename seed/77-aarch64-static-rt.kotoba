    7 (>= (kxrt-find a n 0x45535f5249444b4d 0x50 9) 0) 8 (>= (kxrt-find a n 0x535f4b4e494c4e55 0x5045 10) 0)
    9 (>= (kxrt-find a n 0x45535f5249444d52 0x50 9) 0) 10 (>= (kxrt-find a n 0x535f454d414e4552 0x5045 10) 0)
    11 (>= (kxrt-find a n 0x45535f434e595346 0x50 9) 0) 12 (>= (kxrt-find a n 0x535f504d45544b4d 0x5045 10) 0)
