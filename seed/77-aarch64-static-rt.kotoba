;; aarch64-linux-static runtime source (generated from one template with the
;; x86_64 module 76; only syscall numbers, open/alarm, O_ flags and the
;; seccomp arch/allow-lists differ).
(defn- xa-rt-src [] :string
"
;; x86_64-linux-static runtime. Scalar Kotoba plus the kxrt- intrinsics only:
;; no strings, vectors or closures (those would call back into this runtime).
;; Semantics follow the pinned loader seed/bootstrap/adopted-loader-20261012.c
;; (context ABI v11); see docs/native-seed-c-free-runner-static-image-20261022.md.
(defn- kxrt-load64 [a :i64] :i64 0)
(defn- kxrt-store64 [a :i64 v :i64] :i64 0)
(defn- kxrt-load8 [a :i64] :i64 0)
(defn- kxrt-store8 [a :i64 v :i64] :i64 0)
(defn- kxrt-syscall [n :i64 a :i64 b :i64 c :i64 d :i64 e :i64 f :i64] :i64 0)
(defn- kxrt-ctx [] :i64 0)
(defn- kxrt-call-main [ctx :i64] :i64 0)
(defn- kxrt-trap [code :i64] :i64 0)
(defn- kxrt-call-at [addr :i64 ctx :i64 argv :i64] :i64 0)

;; ---- globals: G = context + 1024 (inside the image's RW segment) ----
;; 0 pairs 8 pair-used 16 validated 24 pool 32 pool-used 40 vectors 48 vector-used
;; 56 items 64 item-used 72 argc 80 argv 88 envp 96 out-buffer 104 out-used
;; 112 append-fd 120 append-path 128 append-len 136 root 144 root-len 152 root-fd
;; 160 report 168 fuel0 176 metered 184 cwd 192 cwd-len 200 scratch 208 path
;; 216 budget 224 value-trap 232 io-buffer 240 command 248 alt-stack
;; 256 conj 264 conj-tail 272 conj-copy 280 copied-words 288 string-copied-bytes
;; 296 arena-use flag 304 gpu-request-fd 312 gpu-answer-fd 320..359 payload arguments
;; 400.. root lengths (16) 528.. root fds (16) 656 root count 664 matched root fd
;; 672 scope marks 680 depth 688 region-map 696 rows 704 region-used
;; 712 conj-region 720 reserved-words 728 scope-releases 736 graph 744 graph-used
(defn- kxrt-g [] :i64 (+ (kxrt-ctx) 1024))
(defn- kxrt-gl [k :i64] :i64 (kxrt-load64 (+ (kxrt-g) k)))
(defn- kxrt-gs [k :i64 v :i64] :i64 (kxrt-store64 (+ (kxrt-g) k) v))
(def KXRT-PAIRS 16777216)
(def KXRT-POOL 268435456)
(def KXRT-VECTORS 4194304)
(def KXRT-ITEMS 268435456)
(def KXRT-VECTOR-MAX 33554432)
(def KXRT-VALUE-MAX 8388608)

;; ---- system calls ----
(defn- kxrt-exit [code :i64] :i64 (kxrt-syscall 94 code 0 0 0 0 0))
(defn- kxrt-map [n :i64] :i64
  (let [p (kxrt-syscall 222 0 n 3 16418 -1 0)] (if (< p 0) (kxrt-exit 125) p)))
(defn- kxrt-write-all [fd :i64 a :i64 n :i64] :i64
  (loop [i 0]
    (if (>= i n) 1
      (let [w (kxrt-syscall 64 fd (+ a i) (- n i) 0 0 0)]
        (cond (= w -4) (recur i)
              (<= w 0) 0
              :else (recur (+ i w)))))))
;; exactly n bytes from fd into a; 0 on end of file or error
(defn- kxrt-read-all [fd :i64 a :i64 n :i64] :i64
  (loop [i 0]
    (if (>= i n) 1
      (let [r (kxrt-syscall 63 fd (+ a i) (- n i) 0 0 0)]
        (cond (= r -4) (recur i)
              (<= r 0) 0
              :else (recur (+ i r)))))))
;; no open/alarm on aarch64: openat(AT_FDCWD) and setitimer(ITIMER_REAL)
(defn- kxrt-open-path [p :i64 flags :i64 mode :i64] :i64 (kxrt-syscall 56 -100 p flags mode 0 0))
(defn- kxrt-alarm [s :i64] :i64
  (let [t (+ (kxrt-gl 200) 12416) a (kxrt-store64 t 0) b (kxrt-store64 (+ t 8) 0)
        c (kxrt-store64 (+ t 16) s) d (kxrt-store64 (+ t 24) 0)]
    (kxrt-syscall 103 0 t 0 0 0 0)))
(defn- kxrt-close [fd :i64] :i64 (kxrt-syscall 57 fd 0 0 0 0 0))

;; ---- bytes ----
(defn- kxrt-copy [d :i64 s :i64 n :i64] :i64
  (loop [i 0] (if (>= i n) d (let [z (kxrt-store8 (+ d i) (kxrt-load8 (+ s i)))] (recur (inc i))))))
(defn- kxrt-same [a :i64 b :i64 n :i64] :bool
  (loop [i 0] (cond (>= i n) true (not= (kxrt-load8 (+ a i)) (kxrt-load8 (+ b i))) false :else (recur (inc i)))))
(defn- kxrt-cstrlen [a :i64] :i64 (loop [i 0] (if (= (kxrt-load8 (+ a i)) 0) i (recur (inc i)))))
;; n (<= 8) bytes of the little-endian word w at b+i; returns i+n. Runtime text
;; (trap lines, report keys, wire-35 tokens, environment names) is spelled as
;; nested kxrt-w calls whose words hold ASCII in little-endian order.
(defn- kxrt-w [b :i64 i :i64 w :i64 n :i64] :i64
  (loop [k 0 v w] (if (= k n) (+ i n) (let [z (kxrt-store8 (+ b i k) (bit-and v 255))] (recur (inc k) (u64-shift-right v 8))))))
;; first offset of the token (w0 w1, tl <= 16 bytes) in [a, a+n), or -1
(defn- kxrt-tok-at [a :i64 w0 :i64 w1 :i64 tl :i64] :bool
  (loop [k 0]
    (cond (= k tl) true
          (not= (kxrt-load8 (+ a k)) (bit-and (u64-shift-right (if (< k 8) w0 w1) (* 8 (if (< k 8) k (- k 8)))) 255)) false
          :else (recur (inc k)))))
(defn- kxrt-find [a :i64 n :i64 w0 :i64 w1 :i64 tl :i64] :i64
  (loop [i 0] (cond (> (+ i tl) n) -1 (kxrt-tok-at (+ a i) w0 w1 tl) i :else (recur (inc i)))))
;; number of non-overlapping occurrences, capped at 2
(defn- kxrt-count2 [a :i64 n :i64 w0 :i64 w1 :i64 tl :i64] :i64
  (let [i (kxrt-find a n w0 w1 tl)]
    (if (< i 0) 0
      (if (< (kxrt-find (+ a i tl) (- n (+ i tl)) w0 w1 tl) 0) 1 2))))
;; unsigned decimal of v at b; returns its length
(defn- kxrt-dec [b :i64 v :i64] :i64
  (let [n (loop [k 1 x v] (if (< x 10) k (recur (inc k) (quot x 10))))]
    (loop [k n x v]
      (if (= k 0) n
        (let [q (quot x 10) z (kxrt-store8 (+ b (dec k)) (+ 48 (- x (* q 10))))] (recur (dec k) q))))))
(defn- kxrt-sdec [b :i64 v :i64] :i64
  (if (< v 0)
    (if (= v -9223372036854775808) (kxrt-w b (kxrt-w b (kxrt-w b 0 0x323733333232392d 8) 0x3737343538363330 8) 0x38303835 4)
      (let [z (kxrt-store8 b 45)] (inc (kxrt-dec (inc b) (- 0 v)))))
    (kxrt-dec b v)))
;; decimal digits only, at most 19; -1 otherwise
(defn- kxrt-parse [a :i64 n :i64] :i64
  (if (or (= n 0) (> n 19)) -1
    (loop [i 0 v 0]
      (if (= i n) v
        (let [c (kxrt-load8 (+ a i))]
          (if (or (< c 48) (> c 57)) -1 (recur (inc i) (+ (* v 10) (- c 48)))))))))

;; ---- traps ----
(defn- kxrt-flush [] :i64
  (let [n (kxrt-gl 104) z (kxrt-gs 104 0)] (if (= n 0) 1 (kxrt-write-all 1 (kxrt-gl 96) n))))
(defn- kxrt-err-text [b :i64 n :i64] :i64 (kxrt-write-all 2 b n))
(defn- kxrt-fuel-text [b :i64 i :i64] :i64
  (let [ctx (kxrt-ctx)
        c (kxrt-w b (kxrt-w b (kxrt-w b i 0x7b206c6575663a20 8) 0x6c616974696e693a 8) 0x20 1)
        d (+ c (kxrt-dec (+ b c) (kxrt-gl 168)))
        e (kxrt-w b (kxrt-w b d 0x6e69616d65723a20 8) 0x20676e69 4)
        f (+ e (kxrt-dec (+ b e) (kxrt-load64 (+ ctx 8))))
        g (if (= (kxrt-gl 176) 0) (kxrt-w b (kxrt-w b f 0x65726574656d3a20 8) 0x65736c61662064 7) f)]
    (kxrt-w b g 0x7d 1)))
(defn- kxrt-sig-name [b :i64 i :i64 sig :i64] :i64
  (case sig
    4 (kxrt-w b i 0x4c4c49 3)
    5 (kxrt-w b i 0x50415254 4)
    7 (kxrt-w b i 0x535542 3)
    8 (kxrt-w b i 0x455046 3)
    11 (kxrt-w b i 0x56474553 4)
    14 (kxrt-w b i 0x4d524c41 4)
    24 (kxrt-w b i 0x55504358 4)
    (kxrt-w b i 0x535953 3)))
(defn- kxrt-budget-text [b :i64 code :i64] :i64
  (let [i (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b 0 0x4152545f4558454b 8) 0x646e696b3a7b2050 8) 0x7465676475623a20 8) 0x6e6f736165723a20 8) 0x7465676475623a20 8) 0x2f 1)]
    (case code
      1 (kxrt-w b (kxrt-w b (kxrt-w b i 0x613a20736c6c6563 8) 0x61703a20616e6572 8) 0xa7d737269 5)
      2 (kxrt-w b (kxrt-w b (kxrt-w b i 0x613a20736c6c6563 8) 0x65763a20616e6572 8) 0xa7d73726f7463 7)
      3 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x613a20736c6c6563 8) 0x65763a20616e6572 8) 0x6574692d726f7463 8) 0xa7d736d 4)
      4 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x613a207365747962 8) 0x74733a20616e6572 8) 0x6f6f702d676e6972 8) 0xa7d6c 3)
      (kxrt-w b i 0xa7d6c657566 6))))
(defn- kxrt-value-name [b :i64 i :i64 r :i64] :i64
  (case r
    1 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x656e752f38667475 8) 0x2d64657463657078 8) 0x61756e69746e6f63 8) 0x6e6f6974 4)
    2 (kxrt-w b (kxrt-w b i 0x65766f2f38667475 8) 0x676e6f6c72 5)
    3 (kxrt-w b (kxrt-w b (kxrt-w b i 0x766e692f38667475 8) 0x7479622d64696c61 8) 0x65 1)
    4 (kxrt-w b (kxrt-w b i 0x7572742f38667475 8) 0x64657461636e 6)
    5 (kxrt-w b (kxrt-w b (kxrt-w b i 0x6461622f38667475 8) 0x756e69746e6f632d 8) 0x6e6f697461 5)
    6 (kxrt-w b (kxrt-w b i 0x7275732f38667475 8) 0x657461676f72 6)
    7 (kxrt-w b (kxrt-w b i 0x6f62612f38667475 8) 0x78616d2d6576 6)
    8 (kxrt-w b (kxrt-w b i 0x742f676e69727473 8) 0x656772616c2d6f6f 8)
    9 (kxrt-w b (kxrt-w b (kxrt-w b i 0x74692f7365747962 8) 0x6f2d74756f2d6d65 8) 0x65676e61722d66 7)
    10 (kxrt-w b (kxrt-w b i 0x6f742f7365747962 8) 0x656772616c2d6f 7)
    (kxrt-w b (kxrt-w b (kxrt-w b i 0x6c732f7365747962 8) 0x6e756f622d656369 8) 0x7364 2)))
;; Signal handler (kxrt-slot-400): the loader's trap_handler plus the parent's
;; budget/value lines and structured report, in one process.
(defn- kxrt-slot-400 [sig :i64] :i64
  (let [b (kxrt-gl 200) z (kxrt-flush)
        i (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b 0 0x4152545f4558454b 8) 0x646e696b3a7b2050 8) 0x6c616e6769733a20 8) 0x6c616e6769733a20 8) 0x4749533a20 5)
        i2 (kxrt-sig-name b i sig)
        j (kxrt-w b i2 0xa7d 2)
        y (kxrt-err-text b j)
        bud (kxrt-gl 216)
        fuel0 (and (= bud 0) (= (kxrt-gl 176) 1) (= (kxrt-load64 (+ (kxrt-ctx) 8)) 0))
        y1 (if (or (> bud 0) fuel0) (kxrt-err-text b (kxrt-budget-text b bud)) 0)
        v (kxrt-gl 224)
        v0 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b 0 0x4152545f4558454b 8) 0x646e696b3a7b2050 8) 0x2065756c61763a20 8) 0x206e6f736165723a 8) 0x3a 1)
        v1 (kxrt-value-name b v0 v)
        y2 (if (> v 0) (kxrt-err-text b (kxrt-w b v1 0xa7d 2)) 0)
        t0 (kxrt-w b (kxrt-w b (kxrt-w b 0 0x7375746174733a7b 8) 0x3a20706172743a20 8) 0x3032312074697865 8)
        t1 (kxrt-fuel-text b t0)
        y3 (if (= (kxrt-gl 160) 1) (kxrt-write-all 1 b (kxrt-w b t1 0xa7d 2)) 0)
        y4 (kxrt-arena-use)]
    (kxrt-exit 120)))
(defn- kxrt-fail [] :i64 (kxrt-trap 0))
(defn- kxrt-budget [code :i64] :i64
  (let [z (if (= (kxrt-gl 216) 0) (kxrt-gs 216 code) 0)] (kxrt-fail)))
(defn- kxrt-arena [code :i64] :i64
  (let [b (kxrt-gl 200)
        i (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b 0 0x4152545f4558454b 8) 0x646e696b3a7b2050 8) 0x20616e6572613a20 8) 0x206e6f736165723a 8) 0x2d726f746365763a 8)
        j (if (= code 2) (kxrt-w b (kxrt-w b (kxrt-w b i 0x78652d656c626174 8) 0x7d64657473756168 8) 0xa 1) (kxrt-w b (kxrt-w b (kxrt-w b i 0x78652d736d657469 8) 0x7d64657473756168 8) 0xa 1))
        z (kxrt-flush) y (kxrt-err-text b j)]
    (kxrt-budget code)))
(defn- kxrt-value [r :i64] :i64 (let [z (if (= (kxrt-gl 224) 0) (kxrt-gs 224 r) 0)] (kxrt-fail)))

;; ---- pairs and strings ----
(defn- kxrt-pair-new [a :i64 b :i64] :i64
  (let [u (kxrt-gl 8)]
    (if (>= u KXRT-PAIRS) (kxrt-budget 1)
      (let [p (+ (kxrt-gl 0) (* u 16)) x (kxrt-store64 p a) y (kxrt-store64 (+ p 8) b)
            z (kxrt-store8 (+ (kxrt-gl 16) u) 0) w (kxrt-gs 8 (inc u))]
        (inc u)))))
(defn- kxrt-pair [h :i64] :i64
  (if (or (<= h 0) (> h (kxrt-gl 8))) (kxrt-fail) (+ (kxrt-gl 0) (* (dec h) 16))))
(defn- kxrt-pf [h :i64] :i64 (kxrt-load64 (kxrt-pair h)))
(defn- kxrt-ps [h :i64] :i64 (kxrt-load64 (+ (kxrt-pair h) 8)))
(defn- kxrt-mark [h :i64] :i64 (let [z (kxrt-store8 (+ (kxrt-gl 16) (dec h)) 1)] h))
;; address of n bytes at string offset off, or -1
(defn- kxrt-span [off :i64 n :i64] :i64
  (cond (< n 0) -1
        (>= off 0) (if (or (> n (kxrt-load64 (+ (kxrt-ctx) 392))) (> off (- (kxrt-load64 (+ (kxrt-ctx) 392)) n))) -1 (+ (kxrt-load64 (+ (kxrt-ctx) 384)) off))
        :else (let [p (- -1 off)] (if (or (> n (kxrt-gl 32)) (> p (- (kxrt-gl 32) n))) -1 (+ (kxrt-gl 24) p)))))
(defn- kxrt-saddr [h :i64] :i64
  (let [a (kxrt-span (kxrt-pf h) (kxrt-ps h))] (if (< a 0) (kxrt-fail) a)))
;; 0 = canonical UTF-8, else the loader's utf8_invalid_reason
(defn- kxrt-utf8 [a :i64 n :i64] :i64
  (loop [i 0]
    (if (>= i n) 0
      (let [b0 (kxrt-load8 (+ a i))]
        (cond (< b0 128) (recur (inc i))
              (< b0 192) 1 (< b0 194) 2 (> b0 244) 3 (>= (inc i) n) 4
              :else
              (let [b1 (kxrt-load8 (+ a i 1)) k (cond (< b0 224) 1 (< b0 240) 2 :else 3)]
                (cond (not= (bit-and b1 192) 128) 5
                      (and (= b0 224) (< b1 160)) 2 (and (= b0 240) (< b1 144)) 2
                      (and (= b0 237) (>= b1 160)) 6 (and (= b0 244) (>= b1 144)) 7
                      :else (let [r (loop [j 2] (cond (> j k) 0 (>= (+ i j) n) 4
                                                      (not= (bit-and (kxrt-load8 (+ a i j)) 192) 128) 5
                                                      :else (recur (inc j))))]
                              (if (= r 0) (recur (+ i k 1)) r)))))))))
(defn- kxrt-valid? [h :i64] :bool
  (if (= (kxrt-load8 (+ (kxrt-gl 16) (dec h))) 1) true
    (let [a (kxrt-span (kxrt-pf h) (kxrt-ps h))]
      (if (and (>= a 0) (= (kxrt-utf8 a (kxrt-ps h)) 0)) (= (kxrt-mark h) h) false))))
(defn- kxrt-valid [h :i64] :i64 (if (kxrt-valid? h) h (kxrt-fail)))
;; copy n bytes into the pool; the pair is not marked validated (intern_utf8)
(defn- kxrt-intern [a :i64 n :i64] :i64
  (let [u (kxrt-gl 32)]
    (if (> n (- KXRT-POOL u)) (kxrt-budget 4)
      (let [z (kxrt-copy (+ (kxrt-gl 24) u) a n) w (kxrt-gs 32 (+ u n))] (kxrt-pair-new (- -1 u) n)))))
(defn- kxrt-intern-dec [v :i64] :i64 (let [b (kxrt-gl 200)] (kxrt-intern b (kxrt-dec b v))))
(defn- kxrt-equal [a :i64 b :i64] :i64
  (let [oa (kxrt-pf a) la (kxrt-ps a) ob (kxrt-pf b) lb (kxrt-ps b)]
    (if (not= la lb) 0
      (let [x (kxrt-span oa la) y (kxrt-span ob lb)]
        (cond (or (< x 0) (< y 0)) (kxrt-fail) (kxrt-same x y la) 1 :else 0)))))
(defn- kxrt-concat [a :i64 b :i64] :i64
  (let [oa (kxrt-pf a) la (kxrt-ps a) ob (kxrt-pf b) lb (kxrt-ps b)]
    (if (or (< la 0) (< lb 0) (> la (- 9223372036854775807 lb))) (kxrt-fail)
      (let [x (kxrt-saddr a) y (kxrt-saddr b) v1 (kxrt-valid a) v2 (kxrt-valid b) u (kxrt-gl 32)]
        (if (and (< oa 0) (= (+ (- -1 oa) la) u))
          (if (> lb (- KXRT-POOL u)) (kxrt-budget 4)
            (let [z (kxrt-copy (+ (kxrt-gl 24) u) y lb) w (kxrt-gs 32 (+ u lb))] (kxrt-mark (kxrt-pair-new oa (+ la lb)))))
          (if (> (+ la lb) (- KXRT-POOL u)) (kxrt-budget 4)
            (let [p (+ (kxrt-gl 24) u) z (kxrt-copy p x la) z2 (kxrt-copy (+ p la) y lb) w (kxrt-gs 32 (+ u la lb))
                  t (kxrt-count 288 (+ la lb))]
              (kxrt-mark (kxrt-pair-new (- -1 u) (+ la lb))))))))))
(defn- kxrt-cont? [a :i64 i :i64 n :i64] :bool (and (< i n) (= (bit-and (kxrt-load8 (+ a i)) 192) 128)))
(defn- kxrt-substring [h :i64 s :i64 e :i64] :i64
  (let [off (kxrt-pf h) n (kxrt-ps h)]
    (if (or (< n 0) (< s 0) (< e s) (> e n)) (kxrt-fail)
      (let [a (kxrt-saddr h) v (kxrt-valid h)]
        (if (or (kxrt-cont? a s n) (kxrt-cont? a e n)) (kxrt-fail)
          (kxrt-mark (kxrt-pair-new (if (>= off 0) (+ off s) (- off s)) (- e s))))))))
(defn- kxrt-code-point-at [h :i64 i :i64] :i64
  (let [n (kxrt-ps h)]
    (if (or (< n 0) (< i 0) (>= i n)) (kxrt-fail)
      (let [a (kxrt-saddr h) v (kxrt-valid h) b0 (kxrt-load8 (+ a i))]
        (cond (< b0 128) b0
              (< b0 192) (kxrt-fail)
              (< b0 224) (bit-or (i64-shift-left (bit-and b0 31) 6) (bit-and (kxrt-load8 (+ a i 1)) 63))
              (< b0 240) (bit-or (i64-shift-left (bit-and b0 15) 12)
                                 (bit-or (i64-shift-left (bit-and (kxrt-load8 (+ a i 1)) 63) 6) (bit-and (kxrt-load8 (+ a i 2)) 63)))
              :else (bit-or (i64-shift-left (bit-and b0 7) 18)
                            (bit-or (i64-shift-left (bit-and (kxrt-load8 (+ a i 1)) 63) 12)
                                    (bit-or (i64-shift-left (bit-and (kxrt-load8 (+ a i 2)) 63) 6) (bit-and (kxrt-load8 (+ a i 3)) 63)))))))))
(defn- kxrt-index-of [h :i64 m :i64] :i64
  (let [nh (kxrt-ps h) nm (kxrt-ps m)]
    (if (or (< nh 0) (<= nm 0)) (kxrt-fail)
      (let [a (kxrt-saddr h) b (kxrt-saddr m) v1 (kxrt-valid h) v2 (kxrt-valid m)]
        (if (> nm nh) -1
          (loop [i 0] (cond (> (+ i nm) nh) -1 (kxrt-same (+ a i) b nm) i :else (recur (inc i)))))))))
(defn- kxrt-compare [x :i64 y :i64] :i64
  (let [nx (kxrt-ps x) ny (kxrt-ps y)]
    (if (or (< nx 0) (< ny 0)) (kxrt-fail)
      (let [a (kxrt-saddr x) b (kxrt-saddr y) v1 (kxrt-valid x) v2 (kxrt-valid y) n (if (< nx ny) nx ny)]
        (loop [i 0]
          (if (= i n) (cond (< nx ny) -1 (> nx ny) 1 :else 0)
            (let [c (kxrt-load8 (+ a i)) d (kxrt-load8 (+ b i))]
              (cond (< c d) -1 (> c d) 1 :else (recur (inc i))))))))))

