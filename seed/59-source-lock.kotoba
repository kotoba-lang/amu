;; KSL1 exact source manifest. Canonical absolute ASCII paths, ordered roots,
;; sorted unique .kotoba files and full SHA-256 bytes. No path normalization,
;; implicit root, mutable source substitution or unpinned admission.
(defn- ksl-end [text :string start :i64] :i64
  (loop [index start]
    (cond (>= index (string-length text)) index
          (= (string-code-point-at text index) 10) index
          :else (recur (+ index 1)))))
(defn- ksl-prefix? [text :string start :i64 end :i64 prefix :string] :bool
  (and (>= (- end start) (string-length prefix))
       (string=? (string-substring text start (+ start (string-length prefix))) prefix)))
(defn- ksl-path? [path :string] :bool
  (let [length (string-length path)]
    (and (> length 0) (<= length 4096) (= (string-code-point-at path 0) 47)
         (or (= length 1) (not= (string-code-point-at path (- length 1)) 47))
         (loop [index 1 segment 1]
           (cond (= index length)
                 (let [part (string-substring path segment index)]
                   (and (not (string=? part ".")) (not (string=? part ".."))))
                 (= (string-code-point-at path index) 47)
                 (let [part (string-substring path segment index)]
                   (and (> index segment) (not (string=? part ".")) (not (string=? part ".."))
                        (recur (+ index 1) (+ index 1))))
                 (or (< (string-code-point-at path index) 32) (> (string-code-point-at path index) 126)) false
                 :else (recur (+ index 1) segment))))))
(defn- ksl-hex? [text :string start :i64] :bool
  (loop [index 0]
    (if (= index 64) true
      (let [code (string-code-point-at text (+ start index))]
        (and (or (and (>= code 48) (<= code 57)) (and (>= code 97) (<= code 102)))
             (recur (+ index 1)))))))
(defn- ksl-source-path? [path :string] :bool
  (and (ksl-path? path) (>= (string-length path) 8)
       (string=? (string-substring path (- (string-length path) 7) (string-length path)) ".kotoba")))
(defn- ksl-file? [text :string start :i64 end :i64] :bool
  (and (> (- end start) 70) (ksl-prefix? text start end "file ")
       (= (string-code-point-at text (+ start 69)) 32) (ksl-hex? text (+ start 5))
       (ksl-source-path? (string-substring text (+ start 70) end))))
(defn- ksl-root-seen? [text :string start :i64 stop :i64 path :string] :bool
  (loop [index start]
    (if (>= index stop) false
      (let [end (ksl-end text index)]
        (if (and (ksl-prefix? text index end "root ") (string=? (string-substring text (+ index 5) end) path))
          true (recur (+ end 1)))))))
(defn- ksl-valid? [text :string] :bool
  (let [length (string-length text) entry-end (ksl-end text 5)]
    (and (>= length 12) (<= length 1048576) (= (string-code-point-at text (- length 1)) 10)
         (ksl-prefix? text 0 length "KSL1\n") (ksl-prefix? text 5 entry-end "entry ")
         (ksl-source-path? (string-substring text 11 entry-end))
         (loop [index (+ entry-end 1) roots 0 files 0 previous ""]
           (if (>= index length) (> files 0)
             (let [end (ksl-end text index)]
               (cond (ksl-prefix? text index end "root ")
                     (let [path (string-substring text (+ index 5) end)]
                       (and (= files 0) (< roots 16) (ksl-path? path)
                            (not (ksl-root-seen? text (+ entry-end 1) index path))
                            (recur (+ end 1) (+ roots 1) files previous)))
                     (ksl-file? text index end)
                     (let [path (string-substring text (+ index 70) end)]
                       (and (< files 256) (> (string-compare path previous) 0)
                            (recur (+ end 1) roots (+ files 1) path)))
                     :else false)))))))
(defn- ksl-entry [text :string] :string (string-substring text 11 (ksl-end text 5)))
(defn- ksl-root-count [text :string] :i64
  (loop [index (+ (ksl-end text 5) 1) count 0]
    (let [end (ksl-end text index)]
      (if (ksl-prefix? text index end "root ") (recur (+ end 1) (+ count 1)) count))))
(defn- ksl-root [text :string wanted :i64] :string
  (loop [index (+ (ksl-end text 5) 1) count 0]
    (let [end (ksl-end text index)]
      (cond (not (ksl-prefix? text index end "root ")) ""
            (= count wanted) (string-substring text (+ index 5) end)
            :else (recur (+ end 1) (+ count 1))))))
(defn- ksl-file-count [text :string] :i64
  (loop [index (+ (ksl-end text 5) 1) count 0]
    (if (>= index (string-length text)) count
      (let [end (ksl-end text index)]
        (recur (+ end 1) (if (ksl-prefix? text index end "file ") (+ count 1) count))))))
(defn- ksl-hash [text :string path :string] :string
  (loop [index (+ (ksl-end text 5) 1)]
    (if (>= index (string-length text)) ""
      (let [end (ksl-end text index)]
        (if (and (ksl-prefix? text index end "file ") (string=? (string-substring text (+ index 70) end) path))
          (string-substring text (+ index 5) (+ index 69)) (recur (+ end 1)))))))
(defn- ksl-check-bytes? [text :string path :string bytes :vector-i64] :bool
  (let [expected (ksl-hash text path)]
    (and (= (string-length expected) 64) (string=? expected (sh-bytes bytes)))))
