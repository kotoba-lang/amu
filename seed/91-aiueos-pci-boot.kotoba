;; Native EFI PCI resource collector. Boot-info v6 is explicit opt-in.
;; PCI_IO GetLocation + GetBarAttributes supply ACPI QWORD memory resources;
;; this catalog is raw platform input, not yet an OS ownership grant.
;; No config/BAR writes, device reset, host compiler or foreign object.
;; Bounded identity profile: segment0, <=256 handles, <=128 memory BARs,
;; identity address translation, host addresses below512GiB. Unsupported
;; translation/malformed/incomplete enumeration refuses, never truncates.
;; Layout facts: UEFI PCI I/O protocol / EDK2 PciIo.h + Acpi10.h (BSD2).
;; PE scratch labels27..40; catalog41/count42/public fields43..44.
;; All successful resource pools, protocol opens and handle buffers are
;; released before the final memory map / ExitBootServices pair.
(def EP-CATALOG 16560)
(def EP-CAPACITY 128)
(def EP-BYTES (+ 32 (* EP-CAPACITY 64)))
(def EP-MAGIC 0x31494350534f4941)
(defn- ep-load [M :vector-i64 reg :i64 label :i64] :vector-i64
  (eb-rip M (case reg 0 0x058b48 1 0x0d8b48 2 0x158b48 6 0x358b48 7 0x3d8b48 8 0x058b4c 9 0x0d8b4c 15 0x3d8b4c 0) 3 label))
(defn- ep-store [M :vector-i64 reg :i64 label :i64] :vector-i64
  (eb-rip M (case reg 0 0x058948 1 0x0d8948 2 0x158948 6 0x358948 7 0x3d8948 15 0x3d894c 0) 3 label))
(defn- ep-zero [M :vector-i64 label :i64] :vector-i64
  (-> M (iv-hex "31c0") (ep-store 0 label)))
;; The failure flag is 1. With the AWAI-118 `--netlog v1` loader it is the
;; failing site's label instead (60 descriptor, 63 location/BAR call,
;; 65 CloseProtocol, 67 handle/OpenProtocol), and 63/67 first keep the EFI
;; status in cell45, so the loader's PCI1 report names the refusing check.
;; Site 60 also copies the first 48 descriptor bytes to cells73..78 before
;; the pool is freed; PCI2/PCI3 report those raw words.
(defn- ep-failed [M :vector-i64 site :i64] :vector-i64
  (-> M (iv-hex "b8") (xg-bytes (if (= (xg-get M 16) 1) site 1) 4) (ep-store 0 40)))
(defn- ep-keep-status [M :vector-i64] :vector-i64
  (if (= (xg-get M 16) 1) (ep-store M 0 45) M))
(defn- ep-keep-descriptor [M :vector-i64] :vector-i64
  (if (not= (xg-get M 16) 1) M
    (let [V (-> M (ep-load 6 39) (iv-hex "4885f6") (eb-rip 0x840f 2 72))
          copied (loop [k 0 W V]
                   (if (>= k 6) W
                     (recur (inc k) (-> W (iv-hex "488b46") (xg-byte (* k 8)) (ep-store 0 (+ 73 k))))))]
      (xg-label copied 72))))
(defn- ep-fail-jump [M :vector-i64 label :i64] :vector-i64
  (-> M (ep-failed label) (eb-rip 0xe9 1 label)))
(defn- ep-check [M :vector-i64 failure :i64] :vector-i64
  (-> M (iv-hex "4885c0") (eb-rip 0x850f 2 failure)))
(defn- ep-save-field [M :vector-i64 label :i64 offset :i64] :vector-i64
  (-> M (ep-load 0 label) (iv-mem 137 0 7 offset)))
(defn- ep-resource [M :vector-i64] :vector-i64
  (-> M (ep-load 6 39) (iv-hex "4885f6") (eb-rip 0x840f 2 60)
      ;; A list holding only the end tag is the firmware's "no resources"
      ;; answer for an unimplemented BAR (AMD 6600H host bridge 00:00.0
      ;; BAR0, AWAI-118); skip it like EFI_UNSUPPORTED. Anything else that
      ;; is not one QWORD memory descriptor plus end tag still refuses.
      (iv-hex "803e79") (eb-rip 0x840f 2 61)
      (iv-hex "803e8a") (eb-rip 0x850f 2 60)
      (iv-hex "66837e012b") (eb-rip 0x850f 2 60)
      (iv-hex "807e2e79") (eb-rip 0x850f 2 60)
      (iv-hex "807e0301") (eb-rip 0x840f 2 61) (eb-rip 0x870f 2 60)
      (iv-hex "48837e1e00") (eb-rip 0x850f 2 60)
      (iv-mem 139 0 6 14) (iv-mem 139 2 6 38)
      (iv-hex "4885c0") (eb-rip 0x840f 2 60)
      (iv-hex "4885d2") (eb-rip 0x840f 2 60)
      (iv-hex "4801c2") (eb-rip 0x820f 2 60)
      (iv-hex "49b800000000800000004c39c2") (eb-rip 0x870f 2 60)
      (ep-load 0 42) (iv-hex "4883f87f") (eb-rip 0x870f 2 60)
      (iv-hex "48c1e006") (eb-rip 0x3d8d48 3 41) (iv-hex "488d7c0720")
      (iv-mem 139 0 6 14) (iv-mem 137 0 7 0)
      (iv-mem 139 0 6 38) (iv-mem 137 0 7 8)
      (ep-save-field 33 16) (ep-save-field 34 24) (ep-save-field 35 32)
      (ep-save-field 36 40) (ep-save-field 38 48) (ep-save-field 37 56)
      (ep-load 0 42) (iv-hex "48ffc0") (ep-store 0 42)
      (eb-rip 0xe9 1 61) (xg-label 60) (ep-keep-descriptor) (ep-failed 60)
      ;; Successful GetBarAttributes owns a non-null pool even on bad data.
      (xg-label 61) (ep-load 1 39) (iv-hex "4885c9") (eb-rip 0x840f 2 63)
      (iv-hex "41ff5648") (ep-check 63)
      (ep-load 0 40) (iv-hex "4885c0") (eb-rip 0x850f 2 65)
      (eb-rip 0xe9 1 62)))
(defn- ep-bars [M :vector-i64] :vector-i64
  (-> M (ep-zero 38) (xg-label 58)
      (ep-load 0 38) (iv-hex "4883f806") (eb-rip 0x830f 2 65)
      (ep-zero 39) (iv-hex "4c89f9") (ep-load 2 38) (iv-hex "4531c0")
      (eb-rip 0x0d8d4c 3 39) (iv-hex "41ff97800000004885c0")
      (eb-rip 0x840f 2 59)
      (iv-hex "48ba03000000000000804839d0") (eb-rip 0x850f 2 63)
      (eb-rip 0xe9 1 62)
      (xg-label 59) (ep-resource)
      (xg-label 62) (ep-load 0 38) (iv-hex "48ffc0") (ep-store 0 38)
      (eb-rip 0xe9 1 58)))
(defn- ep-location [M :vector-i64] :vector-i64
  (-> M (iv-hex "4c89f9") (eb-rip 0x158d48 3 33)
      (eb-rip 0x058d4c 3 34) (eb-rip 0x0d8d4c 3 35)
      (eb-rip 0x058d48 3 36) (iv-hex "488944242041ff5770") (ep-check 63)
      (ep-load 0 33) (iv-hex "4885c0") (eb-rip 0x850f 2 63)
      (ep-load 0 34) (iv-hex "483dff000000") (eb-rip 0x870f 2 63)
      (ep-load 0 35) (iv-hex "4883f81f") (eb-rip 0x870f 2 63)
      (ep-load 0 36) (iv-hex "4883f807") (eb-rip 0x870f 2 63)
      (ep-zero 37) (iv-hex "4c89f9ba020000004531c041b901000000")
      (eb-rip 0x058d48 3 37) (iv-hex "488944242041ff5730") (ep-check 63)
      (ep-load 0 37) (iv-hex "663dffff") (eb-rip 0x840f 2 63)))
(defn- ep-code [M :vector-i64] :vector-i64
  (-> M (ep-zero 40) (ep-zero 28) (ep-zero 29) (ep-zero 30)
      ;; LocateHandleBuffer(ByProtocol, &guid, NULL, &count, &handles).
      (iv-hex "b902000000") (eb-rip 0x158d48 3 27) (iv-hex "4531c0")
      (eb-rip 0x0d8d4c 3 28) (eb-rip 0x058d48 3 29)
      (iv-hex "488944242041ff96380100004885c0") (eb-rip 0x840f 2 50)
      (iv-hex "48ba0e000000000000804839d0") (eb-rip 0x850f 2 26)
      (eb-rip 0xe9 1 69)
      (xg-label 50) (ep-load 0 28) (iv-hex "483d00010000") (eb-rip 0x870f 2 67)
      (ep-load 6 29) (iv-hex "4885f6") (eb-rip 0x840f 2 67)
      (xg-label 51) (ep-load 0 30) (ep-load 1 28) (iv-hex "4839c8") (eb-rip 0x830f 2 68)
      (ep-load 6 29) (iv-hex "488b0cc6") (ep-store 1 31) (ep-zero 32)
      ;; OpenProtocol(GET_PROTOCOL), image is the agent, no controller.
      (ep-load 1 31) (eb-rip 0x158d48 3 27) (eb-rip 0x058d4c 3 32)
      (iv-hex "4d89e148c74424200000000048c74424280200000041ff9618010000") (ep-check 67)
      (ep-load 15 32) (iv-hex "4d85ff") (eb-rip 0x840f 2 63)
      (ep-location) (ep-bars)
      (xg-label 63) (ep-keep-status) (ep-failed 63)
      (xg-label 65) (ep-load 1 31) (eb-rip 0x158d48 3 27)
      (iv-hex "4d89e04531c941ff96200100004885c0") (eb-rip 0x840f 2 66)
      (ep-failed 65) (xg-label 66) (ep-load 0 40) (iv-hex "4885c0") (eb-rip 0x850f 2 68)
      (ep-load 0 30) (iv-hex "48ffc0") (ep-store 0 30) (eb-rip 0xe9 1 51)
      (xg-label 67) (ep-keep-status) (ep-failed 67)
      (xg-label 68) (ep-load 1 29) (iv-hex "4885c9") (eb-rip 0x840f 2 69)
      (iv-hex "41ff5648") (ep-check 26)
      (xg-label 69) (ep-load 0 40) (ep-check 26)
      ;; Publish only after complete enumeration and cleanup. No authority bit.
      (eb-rip 0x058d48 3 41) (ep-store 0 43)
      (ep-load 0 42) (iv-hex "48c1e0064883c020") (ep-store 0 44)))
(defn- ep-labels [M :vector-i64 guid :i64] :vector-i64
  (let [data (eb-external M 27 (+ guid 24))
        cells (loop [k 0]
                (if (>= k 13) data
                  (let [w (eb-external data (+ 28 k) (+ guid 40 (* k 8)))] (recur (inc k)))))]
    (-> cells (eb-external 41 EP-CATALOG) (eb-external 42 (+ EP-CATALOG 16))
        (eb-external 43 160) (eb-external 44 168)
        (cond-> (= (xg-get M 16) 1)
          (-> (eb-external 45 (+ guid 144)) (eb-external 73 (+ guid 152)) (eb-external 74 (+ guid 160))
              (eb-external 75 (+ guid 168)) (eb-external 76 (+ guid 176)) (eb-external 77 (+ guid 184))
              (eb-external 78 (+ guid 192)))))))
(defn- ep-data [M :vector-i64] :vector-i64
  (-> M (xg-out 0x4ca568b84cf5b200 8) (xg-out 0x3eb2ec9e 4) (xg-out 0x9a02503f 4)
      (xg-out 0 8) (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)
      (xg-out 0 8) (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)
      (xg-out 0 8) (xg-out 0 8) (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)
      (cond-> (= (xg-get M 16) 1) (-> (xg-out 0 8) (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)
                                      (xg-out 0 8) (xg-out 0 8) (xg-out 0 8)))))
