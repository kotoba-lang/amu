(defn- kc-core-pins [] :i64
  (let [
        h0_0 (kc-word (+ (kc-g) 20100000) 0x3866313134336138 8)
        h0_8 (kc-word (+ (kc-g) 20100008) 0x3237613437346561 8)
        h0_16 (kc-word (+ (kc-g) 20100016) 0x3331323033343136 8)
        h0_24 (kc-word (+ (kc-g) 20100024) 0x3239353366313231 8)
        h0_32 (kc-word (+ (kc-g) 20100032) 0x6232343335326335 8)
        h0_40 (kc-word (+ (kc-g) 20100040) 0x3233383133336564 8)
        h0_48 (kc-word (+ (kc-g) 20100048) 0x3136656635303833 8)
        h0_56 (kc-word (+ (kc-g) 20100056) 0x6335316666663334 8)
        h1_0 (kc-word (+ (kc-g) 20100064) 0x3630303732363933 8)
        h1_8 (kc-word (+ (kc-g) 20100072) 0x3332656165383438 8)
        h1_16 (kc-word (+ (kc-g) 20100080) 0x6533636331313931 8)
        h1_24 (kc-word (+ (kc-g) 20100088) 0x3934363337393035 8)
        h1_32 (kc-word (+ (kc-g) 20100096) 0x3033376335393338 8)
        h1_40 (kc-word (+ (kc-g) 20100104) 0x3866323336356566 8)
        h1_48 (kc-word (+ (kc-g) 20100112) 0x6465646631306561 8)
        h1_56 (kc-word (+ (kc-g) 20100120) 0x6466326364656533 8)
        h2_0 (kc-word (+ (kc-g) 20100128) 0x3133643866633536 8)
        h2_8 (kc-word (+ (kc-g) 20100136) 0x3239623462373563 8)
        h2_16 (kc-word (+ (kc-g) 20100144) 0x6366363038626563 8)
        h2_24 (kc-word (+ (kc-g) 20100152) 0x6663613532306362 8)
        h2_32 (kc-word (+ (kc-g) 20100160) 0x6339303564386361 8)
        h2_40 (kc-word (+ (kc-g) 20100168) 0x6135653864623237 8)
        h2_48 (kc-word (+ (kc-g) 20100176) 0x6436346161393334 8)
        h2_56 (kc-word (+ (kc-g) 20100184) 0x6432393538373837 8)
        h3_0 (kc-word (+ (kc-g) 20100192) 0x3738336335313065 8)
        h3_8 (kc-word (+ (kc-g) 20100200) 0x3034316237386363 8)
        h3_16 (kc-word (+ (kc-g) 20100208) 0x3439633138373232 8)
        h3_24 (kc-word (+ (kc-g) 20100216) 0x6666343031343734 8)
        h3_32 (kc-word (+ (kc-g) 20100224) 0x6133313166663065 8)
        h3_40 (kc-word (+ (kc-g) 20100232) 0x3835656133323632 8)
        h3_48 (kc-word (+ (kc-g) 20100240) 0x3665633237613238 8)
        h3_56 (kc-word (+ (kc-g) 20100248) 0x3038623231323363 8)
        h4_0 (kc-word (+ (kc-g) 20100256) 0x3839623735343337 8)
        h4_8 (kc-word (+ (kc-g) 20100264) 0x3166343037323333 8)
        h4_16 (kc-word (+ (kc-g) 20100272) 0x3765663837306130 8)
        h4_24 (kc-word (+ (kc-g) 20100280) 0x3165393963393162 8)
        h4_32 (kc-word (+ (kc-g) 20100288) 0x3363613931383339 8)
        h4_40 (kc-word (+ (kc-g) 20100296) 0x3264313132353439 8)
        h4_48 (kc-word (+ (kc-g) 20100304) 0x3130396161663363 8)
        h4_56 (kc-word (+ (kc-g) 20100312) 0x3235643238653138 8)
        end 0] 0))
(defn- kc-receipt [] :i64
  (let [p (+ (kc-g) 65536) h (kc-copy p (kc-token 11) 8) nl (kxrt-store8 (+ p 8) 10)
        i0 (kc-hash-line p 9 (+ (kc-g) 512))
        i1 (kc-hash-line p i0 (kc-line 2))
        i2 (loop [i 3 at i1] (if (= i 8) at (recur (+ i 1) (kc-hash-line p at (kc-line i)))))
        i3a (kc-hash-line p i2 (kc-line 13)) i3b (kc-hash-line p i3a (kc-line 15))
        i3 (kc-hash-line p i3b (kc-line 17))
        i4 (loop [i 0 at i3] (if (= i 4) at (recur (+ i 1) (kc-hash-line p at (+ (kc-g) 576 (* i 64))))))
        ;; Explicit ordered zero exit results, included in the verdict digest.
        z0 (kc-word (+ p i4) 0x666c65732d756d61 8) z1 (kc-word (+ p i4 8) 0x74736f68 4)
        z2 (kc-word (+ p i4 12) 0xa3020 3)
        z3 (kc-word (+ p i4 15) 0x6e2d61626f746f6b 8) z4 (kc-word (+ p i4 23) 0x6576697461 5)
        z5 (kc-word (+ p i4 28) 0xa3020 3)
        digest (kc-sha p (+ i4 31)) end (kc-hash-line p (+ i4 31) digest)
        fd (kc-newfile (kc-token 9)) result (kc-write fd p end)]
    (if (< result 0) (kc-fail 1007)
      (let [sync (kc-sync-close fd) dir (kxrt-syscall 74 (kc-get 8) 0 0 0 0 0)]
        (if (< dir 0) (kc-fail 1007) (let [out (kc-write 1 p end)] (kxrt-syscall 60 0 0 0 0 0 0)))))))
(defn- kc-selfhost-lock [] :i64
  (let [source (kc-absolute 9 32768) n (kc-len source 4097) p (+ (kc-g) 18016000)
        a (kc-copy p (kc-token 29) 11) b (kc-copy (+ p 11) source n)
        c (kc-copy (+ p 11 n) (kc-token 30) 6) d (kc-copy (+ p 17 n) (kc-line 4) 64)
        e (kxrt-store8 (+ p 81 n) 32) f (kc-copy (+ p 82 n) source n)
        g (kxrt-store8 (+ p 82 n n) 10)]
    (if (kc-equal (kc-sha p (+ 83 n n)) (kc-line 5) 64) 0 (kc-fail 2001))))
(defn- kc-execute [] :i64
  (let [args (kc-prepare-args) env (kc-prepare-env 0)
        output (kc-open (kc-line 11) 655360 0)
        absent (cond (>= output 0) (kc-fail 1006) (= output -2) 0 :else (kc-fail 1006))
        aout (kc-newfile (kc-token 5)) aerr (kc-newfile (kc-token 6))
        first (kc-job (kc-get 16) args aout aerr 10800 0)
        ac0 (kc-sync-close aout) ac1 (kc-sync-close aerr)
        pin (kc-pin (kc-line 11) (kc-line 6))
        kout (kc-newfile (kc-token 7)) kerr (kc-newfile (kc-token 8))
        k0 (kxrt-store64 args (kc-absolute 12 57344)) k1 (kxrt-store64 (+ args 8) (kc-absolute 18 18000000))
        k2 (kxrt-store64 (+ args 16) (kc-line 17)) k3 (kxrt-store64 (+ args 24) 0)
        second (kc-job (kc-get 24) args kout kerr 120 0)
        kc0 (kc-sync-close kout) kc1 (kc-sync-close kerr)
        l0 (kc-log-pin 5 (+ (kc-g) 576)) l1 (kc-log-pin 6 (+ (kc-g) 640))
        l2 (kc-log-pin 7 (+ (kc-g) 704)) l3 (kc-log-pin 8 (+ (kc-g) 768))]
    (kc-receipt)))
(defn- kxrt-start [sp :i64] :i64
  (let [base (kxrt-syscall 9 0 33554432 3 34 -1 0)]
    (if (< base 0) (kxrt-syscall 60 2 0 0 0 0 0)
      (let [init (kxrt-store64 (+ (kxrt-ctx) 512) base) tokens (kc-tokens) fixed-core (kc-core-pins)
            argc (kxrt-load64 sp) argv (+ sp 8)
            valid (if (not= argc 3) (kc-fail 1001) 0)
            path (kxrt-load64 (+ argv 8)) expected (kxrt-load64 (+ argv 16))
            paths (if (and (kc-path? path true) (kc-hex? expected)) 0 (kc-fail 1001))
            fd (kc-absolute-open path 655360)
            readable (if (< fd 0) (kc-fail 1003) 0)
            n (kc-readfd fd 32768) close (kc-close fd)
            hash (kc-sha (+ base 131072) n)
            pinned (if (kc-equal hash expected 64) (kc-copy (+ base 512) hash 64) (kc-fail 2001))
            copy (kc-copy (+ base 73728) (+ base 131072) n) parsed (kc-parse (+ base 73728) n 19)
            header (if (and (= (kc-len (kc-line 0) 7) 6) (= (bit-and (kxrt-load64 (kc-line 0)) 281474976710655) 0x31494344434b)) 0 (kc-fail 1002))
            rootok (if (kc-path? (kc-line 1) true) 0 (kc-fail 1002))
            hashes (loop [i 2] (if (= i 8) 0 (if (kc-hex? (kc-line i)) (recur (+ i 1)) (kc-fail 1002))))
            files (loop [i 8] (if (= i 13) 0 (if (kc-path? (kc-line i) false) (recur (+ i 1)) (kc-fail 1002))))
            provenance (if (and (kc-hex? (kc-line 13)) (kc-path? (kc-line 14) false)
                               (kc-hex? (kc-line 15)) (kc-path? (kc-line 16) false)
                               (kc-hex? (kc-line 17)) (kc-path? (kc-line 18) false)) 0 (kc-fail 1002))
            root (kc-absolute-open (kc-line 1) 720896)
            rooted (if (< root 0) (kc-fail 1003) (kc-private-root root))
            self (kxrt-syscall 257 -100 (kc-token 10) 524288 0 0 0)
            selfok (if (< self 0) (kc-fail 1003) 0)
            selfn (kc-readfd self 16777216) selfclose (kc-close self)
            selfpin (if (kc-equal (kc-sha (+ base 131072) selfn) (kc-line 2) 64) 0 (kc-fail 2001))
            core-bound (if (and (kc-equal (kc-line 4) (+ base 20100000) 64)
                               (kc-equal (kc-line 6) (+ base 20100064) 64)
                               (kc-equal (kc-line 3) (+ base 20100128) 64)
                               (kc-equal (kc-line 7) (+ base 20100192) 64)
                               (kc-equal (kc-line 15) (+ base 20100256) 64)) 0 (kc-fail 2001))
            src (kc-pin (kc-line 9) (kc-line 4)) lock (kc-pin (kc-line 10) (kc-line 5))
            canonical-lock (kc-selfhost-lock)
            proof (kc-pin (kc-line 14) (kc-line 13))
            gate-source (kc-pin (kc-line 16) (kc-line 15)) cases (kc-pin (kc-line 18) (kc-line 17))
            compiler (kc-set 16 (kc-image (kc-line 8) (kc-line 3)))
            gate (kc-set 24 (kc-image (kc-line 12) (kc-line 7)))
            parent (kc-set 32 (kxrt-syscall 39 0 0 0 0 0 0))]
        (kc-execute)))))
