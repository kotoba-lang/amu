            fd (kc-absolute-open path 655360) readable (if (< fd 0) (kc-fail 1003) 0)
            n (kc-readfd fd 32768) close (kc-close fd) hash (kc-sha (+ base 131072) n)
            pinned (if (kc-equal hash expected 64) (kc-copy (+ base 512) hash 64) (kc-fail 2001))
