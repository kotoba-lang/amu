;; The Kotoba native gate consumes the exact 24-case source/image ledger.
;; Every source and loaderless ELF is pinned; native exit/result/fuel is
;; checked here. No host interpreter decides the verdict.
(defn- kg-value [p :i64 n :i64] :i64
  (if (or (< n 1) (> n 16)) (kc-fail 4002)
    (loop [i 0 value 0]
      (if (= i n) value
        (let [c (kxrt-load8 (+ p i))]
          (if (or (< c 48) (> c 57) (> value 900719925474098)) (kc-fail 4002)
            (recur (+ i 1) (+ (* value 10) (- c 48)))))))))
(defn- kg-line-value [line :i64] :i64
  (let [p (kc-line line)] (kg-value p (kc-len p 17))))
(defn- kg-number [data :i64 n :i64 token :i64 length :i64] :i64
  (let [found (loop [i 0 result -1]
                (if (> (+ i length) n) result
                  (if (kc-equal (+ data i) token length)
                    (if (>= result 0) (kc-fail 4003) (recur (+ i 1) (+ i length)))
                    (recur (+ i 1) result))))]
    (if (< found 0) (kc-fail 4003)
      (let [end (loop [i found]
                  (if (>= i n) i
                    (let [c (kxrt-load8 (+ data i))]
                      (if (and (>= c 48) (<= c 57)) (recur (+ i 1)) i))))]
        (if (or (>= end n) (not (or (= (kxrt-load8 (+ data end)) 32) (= (kxrt-load8 (+ data end)) 125) (= (kxrt-load8 (+ data end)) 10))))
          (kc-fail 4003) (kg-value (+ data found) (- end found)))))))
