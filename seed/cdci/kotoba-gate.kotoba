        h0 (if (and (kc-hex? (kc-line base)) (kc-hex? (kc-line (+ base 1)))
                    (kc-path? (kc-line (+ base 2)) false) (kc-path? (kc-line (+ base 3)) false)) 0 (kc-fail 4002))
        canonical (+ (kc-g) 20000000 (* index 160))
        source-bound (if (and (kc-equal (kc-line base) canonical 64) (kc-equal (kc-line (+ base 1)) (+ canonical 64) 64)) 0 (kc-fail 4002))
        source (kc-pin (kc-line (+ base 2)) (kc-line base))
        image (kc-image (kc-line (+ base 3)) (kc-line (+ base 1)))
        result (kg-line-value (+ base 4)) expected-exit (kg-line-value (+ base 5)) fuel (kg-line-value (+ base 6))
        bounds (if (and (= result (kxrt-load64 (+ canonical 128))) (= expected-exit (kxrt-load64 (+ canonical 136))) (= fuel (kxrt-load64 (+ canonical 144)))) 0 (kc-fail 4002))
        outname (kg-name index 20 18008000) errname (kg-name index 21 18008128)
        outfd (kc-newfile outname) errfd (kc-newfile errname)
        argv (+ (kc-g) 8192) a0 (kxrt-store64 argv (kc-absolute (+ base 3) 24576)) a1 (kxrt-store64 (+ argv 8) 0)
        env (kc-prepare-env 1) run (kc-job image argv outfd errfd 15 expected-exit)
        c0 (kc-sync-close outfd) c1 (kc-sync-close errfd) c2 (kc-close image)
        n (kc-file outname) observed-fuel (kg-number (+ (kc-g) 131072) n (kc-token 24) 11)
        observed-result (if (= expected-exit 0) (kg-number (+ (kc-g) 131072) n (kc-token 25) 8) 0)
        valid (if (and (= fuel observed-fuel) (or (= expected-exit 120) (= result observed-result))) 0 (kc-fail 4004))
        oh (kc-copy (+ (kc-g) 576) (kc-sha (+ (kc-g) 131072) n) 64)
