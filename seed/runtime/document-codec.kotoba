        negative (= first 45)
        signed (or negative (= first 43))]
    (loop [point (if signed (__kr_drtake text state) first) value 0 digits 0]
      (if (= point separator)
        (cond (= digits 0) (__kr_dtrap)
              negative value
              (= value -9223372036854775808) (__kr_dtrap)
              :else (- 0 value))
        (if (or (< point 48) (> point 57)
                (< value -922337203685477580)
                (and (= value -922337203685477580) (> point 56)))
          (__kr_dtrap)
          (recur (__kr_drtake text state)
                 (- (* value 10) (- point 48)) (+ digits 1)))))))

