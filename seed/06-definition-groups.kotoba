;; Native checked KIR entry and scc-v1. No generated address or execution
;; verdict is cached. Oversized SCCs refuse; names never order the sealed
;; payload except the authority's tie-breaking enumeration of equal bytes.
(defn- dcs-empty-effects? [M :vector-i64 S :string map :i64] :bool
  (let [row (dcp-field M S map ":effects")]
    (or (= row 0) (and (= (kr-kind M row) ND-SET) (= (kr-count M row) 0)))))
(defn- dcs-shape? [M :vector-i64 S :string map :i64 function :bool] :bool
  (and (= (kr-kind M map) ND-MAP)
    (loop [p (kr-first M map) seen (typed-list-new [:list :string])]
      (if (= p 0) true
        (let [v (kr-next M p) name (dcp-text M S p)
              allowed (if function
                (or (= name ":name") (= name ":params") (= name ":param-types") (= name ":body")
                    (= name ":result") (= name ":effects"))
                (or (= name ":format") (= name ":entry") (= name ":exports") (= name ":signature")
                    (= name ":effects") (= name ":functions") (= name ":schemas")))]
          (and (not= v 0) (= (kr-kind M p) ND-KW) allowed (not (dcp-contains seen name))
            (recur (kr-next M v) (typed-list-conj [:list :string] seen name))))))))
(defn- dcs-init-resource [M :vector-i64 S :string doc :i64 functions :i64 resource :i64] :vector-i64
  (let [n (kr-count M functions) cap (loop [v 2] (if (>= v (* 2 n)) v (recur (* v 2))))
        edges (vector-at M MM-NODE-N)
        a (-> (vector-alloc (+ 16 (* n dcp-fwidth) (* edges 3) cap (* dc-nodes 2) (* n 3) 65))
              (vector-assoc! 3 n) (vector-assoc! 6 cap) (vector-assoc! 11 edges))
        allocated (dgg-init a n edges (+ (dcp-env a) (* 2 dc-nodes)))
        A (if (dip-valid? resource)
            (vector-assoc! allocated (+ (dcp-effects-base allocated) n) resource)
            (vector-assoc! allocated 0 10))]
    (loop [p (kr-first M functions) i 0 state A]
      (if (or (= p 0) (not= (vector-at state 0) 0)) state
        (let [name (dcp-field M S p ":name") text (if (> name 0) (dcp-text M S name) "")
              params (dcp-field M S p ":params") body (dcp-field M S p ":body")]
          (if (or (not (dcs-shape? M S p true)) (< (dcp-effect-mask M S p) 0)
                  (not= (kr-kind M name) ND-SYM) (not= (kr-kind M params) ND-VEC) (= body 0)
                  (dcp-primitive-op? text) (= text "typed-cap-call") (= text "let") (= text "fn") (= text "nil") (= text "true") (= text "false")
                  (not= (dcp-lookup M S state name) -1))
            (vector-assoc! state 0 (if (< (dcp-effect-mask M S p) 0) 4 1))
            (let [a (dcp-put (dcp-put state i 0 p) i 1 name)
                  slot (loop [j (bit-and (dcp-name-hash M S name) (dec cap))]
                    (if (= (vector-at a (+ (dcp-hash a) j)) 0) j (recur (bit-and (inc j) (dec cap)))))
                  b (vector-assoc! a (+ (dcp-hash a) slot) (inc i))]
              (recur (kr-next M p) (inc i) b))))))))
(defn- dcs-init [M :vector-i64 S :string doc :i64 functions :i64] :vector-i64
  (dcs-init-resource M S doc functions 0))
(defn- dcs-components [A :vector-i64] :vector-i64 (dgg-components A))
(defn- dcs-members [M :vector-i64 S :string A :vector-i64 component :i64] :vector-i64
  (let [head (dgg-member-head A component)
        count (loop [cursor head n 0]
                (if (= cursor 0) n (recur (dgg-f A (dec cursor) 9) (inc n))))
        C (vector-alloc count)]
    (loop [cursor head at 0 out C]
      (if (= cursor 0) out
        (let [f (dec cursor)
              next (loop [j at v out]
                     (if (and (> j 0) (> (string-compare (dcp-text M S (dcp-f A (vector-at v (dec j)) 1))
                                                                       (dcp-text M S (dcp-f A f 1))) 0))
                       (recur (dec j) (vector-assoc! v j (vector-at v (dec j))))
                       (vector-assoc! v j f)))]
          (recur (dgg-f A f 9) (inc at) next))))))
(defn- dcs-factorial [n :i64] :i64
  (loop [i 2 value 1] (if (> i n) value (recur (inc i) (* value i)))))
(defn- dcs-permutation [A :vector-i64 C :vector-i64 rank :i64] :vector-i64
  (let [n (vector-count C)]
    (loop [i 0 remaining rank used 0 state A]
      (if (= i n) state
        (let [factor (dcs-factorial (- n i 1)) choice (quot remaining factor)
              pos (loop [j 0 left choice]
                (if (= (bit-and used (i64-shift-left 1 j)) 0)
                  (if (= left 0) j (recur (inc j) (dec left))) (recur (inc j) left)))
              f (vector-at C pos)]
          (recur (inc i) (rem remaining factor) (bit-or used (i64-shift-left 1 pos))
            (dcp-put state f 3 (inc i))))))))
(defn- dcs-at-index [A :vector-i64 C :vector-i64 index :i64] :i64
  (loop [i 0] (if (= (dcp-f A (vector-at C i) 3) (inc index)) (vector-at C i) (recur (inc i)))))
(defn- dcs-group-payload [M :vector-i64 S :string A :vector-i64 C :vector-i64 R [:list :string] rank :i64] :string
  (let [perm (dcs-permutation A C rank) clear (dcp-clear-deps A)
        members (loop [i 0 out (typed-list-new [:list :string])]
          (if (= i (vector-count C)) out
            (let [f (dcs-at-index A C i) params (dcp-params M S A f)
                  body (dcp-form M S A (dcp-field M S (dcp-f A f 0) ":body") R 0)
                  interface (dcp-interface M S A f)]
              (recur (inc i) (typed-list-conj [:list :string] out
                (dcp-map (typed-list-new [:list :string] (dc-entry "body" body)
                  (dc-entry "interface" interface) (dc-entry "params" params))))))))]
    (dcp-payload-effects (dcp-map (typed-list-new [:list :string] (dc-entry "members" (dcp-vec members))
      (dc-entry "op" (dc-kw "kotoba.definition/recursive-group"))))
      (dcp-map (typed-list-new [:list :string] (dc-entry "arity" (dc-int (mem-u2dec (vector-count C))))
        (dc-entry "result" (dc-kw "kotoba.definition/group")))) (dcp-deps A R) (dcp-group-effects A C))))
(defn- dcs-best [M :vector-i64 S :string A :vector-i64 C :vector-i64 R [:list :string]] :i64
  (loop [rank 1 best 0]
    (if (or (= rank (dcs-factorial (vector-count C))) (not= (vector-at A 0) 0)) best
      (let [chosen (arena-scope
              (let [candidate (dcs-group-payload M S A C R rank)
                    previous (dcs-group-payload M S A C R best)]
                (if (< (string-compare candidate previous) 0) rank best)))]
        (recur (inc rank) chosen)))))
(defn- dcs-member-payload [M :vector-i64 S :string A :vector-i64 f :i64 group :string index :i64] :string
  (dcp-payload-effects (dcp-map (typed-list-new [:list :string] (dc-entry "index" (dc-int (mem-u2dec index)))
    (dc-entry "op" (dc-kw "kotoba.definition/group-member")))) (dcp-interface M S A f)
    (dcp-vec (typed-list-new [:list :string] (dc-str group))) (dcp-fx A f)))
;; Prepare immutable member bytes once. Only native-created group-reference
;; integer leaves may change under a permutation. Source-authored reference
;; tags are refused in 05, so literal data cannot masquerade as these holes.
(defn- dcs-hole-base [member :i64 count :i64] :i64 (+ count (* member dc-nodes 2)))
(defn- dcs-holes [A :vector-i64 template :string H :vector-i64 member :i64 count :i64] :bool
  (let [V (dc-unhex template)]
    (if (= (vector-count V) 0) false
      (let [D (dc-read (-> (vector-alloc (+ 8 (* dc-nodes 5)))
                    (vector-assoc! 2 1) (vector-assoc! 3 (vector-count V)) (vector-assoc! 5 (dcp-resource A))) V 0)]
        (if (or (not= (vector-at D 1) 0) (not= (vector-at D 0) (vector-count V)) (not (dc-normal? D V 1))) false
          (loop [node 1 holes 0 previous -1]
            (if (= node (vector-at D 2)) (let [save (vector-assoc! H member holes)] true)
              (let [items (dc-child D node 1)]
                (if (and (dc-tag? D V node "vec") (dc-array? D items 2)
                         (dc-key? D V (dc-child D items 0) "kotoba.definition/group"))
                  (let [index (dc-child D items 1) text-node (dc-child D index 1)
                        at (dc-at D text-node 1) length (dc-at D text-node 2)
                        original (if (and (= (dc-at D text-node 0) 1) (= length 1)) (- (vector-at V at) 48) -1)]
                    (if (or (not (dc-tag? D V index "int")) (< original 0) (>= original count)
                            (<= at previous) (>= holes dc-nodes)) false
                      (let [p (+ (dcs-hole-base member count) (* holes 2))
                            a (vector-assoc! H p at) b (vector-assoc! H (inc p) original)]
                        (recur (inc node) (inc holes) at))))
                  (recur (inc node) holes previous))))))))))
(defn- dcs-templates [M :vector-i64 S :string A :vector-i64 C :vector-i64 R [:list :string] H :vector-i64] [:list :string]
  (let [initial (dcs-permutation A C 0) clear (dcp-clear-deps A) count (vector-count C)]
    (loop [i 0 out (typed-list-new [:list :string])]
      (if (or (= i count) (not= (vector-at A 0) 0))
        (typed-list-conj [:list :string] out (dcp-deps A R))
        (let [f (vector-at C i) params (dcp-params M S A f)
              body (dcp-form M S A (dcp-field M S (dcp-f A f 0) ":body") R 0)
              interface (dcp-interface M S A f)
              template (dcp-map (typed-list-new [:list :string] (dc-entry "body" body)
                (dc-entry "interface" interface) (dc-entry "params" params)))
              valid (arena-scope (dcs-holes A template H i count))]
          (if valid (recur (inc i) (typed-list-conj [:list :string] out template))
            (let [bad (dcp-fail A 7)] out)))))))
(defn- dcs-render [A :vector-i64 C :vector-i64 template :string H :vector-i64 member :i64] :string
  (loop [i 0 cursor 0 out ""]
    (if (= i (vector-at H member)) (string-concat out (string-substring template cursor (string-length template)))
      (let [p (+ (dcs-hole-base member (vector-count C)) (* i 2)) at (* 2 (vector-at H p))
            original (vector-at H (inc p)) f (vector-at C original) index (dec (dcp-f A f 3))]
        (if (or (< at cursor) (> (+ at 2) (string-length template)) (< index 0) (>= index (vector-count C)))
          (dcp-bad A)
          (recur (inc i) (+ at 2) (string-concat out
            (string-concat (string-substring template cursor at) (dc-byte-hex (+ 48 index))))))))))
(defn- dcs-fast-payload [A :vector-i64 C :vector-i64 T [:list :string] H :vector-i64 rank :i64] :string
  (let [permutation (dcs-permutation A C rank) count (vector-count C)
        members (loop [i 0 out (typed-list-new [:list :string])]
          (if (= i count) out
            (let [f (dcs-at-index A C i) original (loop [j 0]
                    (if (= (vector-at C j) f) j (recur (inc j))))]
              (recur (inc i) (typed-list-conj [:list :string] out
                (dcs-render A C (typed-list-nth [:list :string] T original) H original))))))]
    (dcp-payload-effects (dcp-map (typed-list-new [:list :string] (dc-entry "members" (dcp-vec members))
      (dc-entry "op" (dc-kw "kotoba.definition/recursive-group"))))
      (dcp-map (typed-list-new [:list :string] (dc-entry "arity" (dc-int (mem-u2dec count)))
        (dc-entry "result" (dc-kw "kotoba.definition/group")))) (typed-list-nth [:list :string] T count) (dcp-group-effects A C))))
(defn- dcs-best-fast [A :vector-i64 C :vector-i64 T [:list :string] H :vector-i64] :i64
  (loop [rank 1 best 0]
    (if (or (= rank (dcs-factorial (vector-count C))) (not= (vector-at A 0) 0)) best
      (let [chosen (arena-scope
              (let [candidate (dcs-fast-payload A C T H rank) previous (dcs-fast-payload A C T H best)]
                (if (< (string-compare candidate previous) 0) rank best)))]
        (recur (inc rank) chosen)))))
;; Canonical CBOR member values are self-delimiting: two complete member
;; encodings cannot be a proper prefix of one another. The group wrapper,
;; interface and external dependencies are invariant across permutations.
;; Compare only through the first differing member, without rebuilding the
;; common wrapper or the remaining members. Still visit every permutation.
(defn- dcs-mapping [A :vector-i64 C :vector-i64 rank :i64] :vector-i64
  (let [set (dcs-permutation A C rank) n (vector-count C)]
    (loop [i 0 out (vector-alloc (* 2 n))]
      (if (= i n) out
        (let [index (dec (dcp-f A (vector-at C i) 3))
              a (vector-assoc! out index i)]
          (recur (inc i) (vector-assoc! a (+ n i) index)))))))
(defn- dcs-render-mapping [A :vector-i64 template :string H :vector-i64 member :i64 P :vector-i64] :string
  (let [n (quot (vector-count P) 2)]
    (loop [i 0 cursor 0 out ""]
      (if (= i (vector-at H member)) (string-concat out (string-substring template cursor (string-length template)))
        (let [p (+ (dcs-hole-base member n) (* i 2)) at (* 2 (vector-at H p))
              original (vector-at H (inc p)) index (vector-at P (+ n original))]
          (if (or (< at cursor) (> (+ at 2) (string-length template)) (< index 0) (>= index n))
            (dcp-bad A)
            (recur (inc i) (+ at 2) (string-concat out
              (string-concat (string-substring template cursor at) (dc-byte-hex (+ 48 index)))))))))))
(defn- dcs-rank-compare [A :vector-i64 C :vector-i64 T [:list :string] H :vector-i64 left :i64 right :i64] :i64
  (let [L (dcs-mapping A C left) R (dcs-mapping A C right)]
    (loop [i 0]
      (if (= i (vector-count C)) 0
        (let [l (vector-at L i) r (vector-at R i)
              x (dcs-render-mapping A (typed-list-nth [:list :string] T l) H l L)
              y (dcs-render-mapping A (typed-list-nth [:list :string] T r) H r R)
              compared (string-compare x y)]
          (if (= compared 0) (recur (inc i)) compared))))))
(defn- dcs-best-prefix [A :vector-i64 C :vector-i64 T [:list :string] H :vector-i64] :i64
  (loop [rank 1 best 0]
    (if (or (= rank (dcs-factorial (vector-count C))) (not= (vector-at A 0) 0)) best
      (let [chosen (arena-scope (if (< (dcs-rank-compare A C T H rank best) 0) rank best))]
        (recur (inc rank) chosen)))))
;; For a fixed first member, assign the least unused index at each first
;; reference in canonical hole order. Every other assignment first differs
;; with a larger encoded index. Strong connectivity keeps the member queue
;; nonempty until all members are assigned. Therefore the minimum over roots
;; is the exhaustive scc-v1 minimum. Retain its least factoradic rank on ties.
;; The producer's existing n<=8 admission remains authoritative; indices0..7
;; have ordered one-byte decimal encodings. The old exhaustive search remains
;; the independent native test oracle. This is not a larger-SCC profile.
(defn- dcs-order-rank [P :vector-i64 n :i64] :i64
 (loop [i 0 used 0 rank 0]
  (if (= i n) rank
   (let [original (vector-at P i)
         digit (loop [j 0 count 0]
                 (if (= j original) count
                   (recur (inc j) (+ count (if (= (bit-and used (i64-shift-left 1 j)) 0) 1 0)))))]
    (recur (inc i) (bit-or used (i64-shift-left 1 original))
      (+ rank (* digit (dcs-factorial (- n i 1)))))))))
(defn- dcs-root-order [C :vector-i64 H :vector-i64 root :i64] :i64
 (let [n (vector-count C) P (-> (vector-alloc (inc (* 2 n)))
                            (vector-assoc! 0 root) (vector-assoc! (+ n root) 1) (vector-assoc! (* 2 n) 1))]
  (loop [i 0]
   (cond (= i n) (dcs-order-rank P n)
     (>= i (vector-at P (* 2 n))) -1
     :else
     (let [original (vector-at P i)
           assigned (loop [j 0]
            (if (= j (vector-at H original)) 0
             (let [target (vector-at H (+ (dcs-hole-base original n) (* 2 j) 1))]
              (if (or (< target 0) (>= target n)) -1
               (let [count (vector-at P (* 2 n))
                     next (if (= (vector-at P (+ n target)) 0)
                            (-> P (vector-assoc! count target)
                                  (vector-assoc! (+ n target) (inc count)) (vector-assoc! (* 2 n) (inc count))) P)]
                (recur (inc j)))))))]
      (if (< assigned 0) -1 (recur (inc i))))))))
(defn- dcs-best-root [A :vector-i64 C :vector-i64 T [:list :string] H :vector-i64] :i64
 (loop [root 0 best -1]
  (if (= root (vector-count C)) best
   (let [chosen (arena-scope
          (let [rank (dcs-root-order C H root)
                compared (if (or (< best 0) (< rank 0)) 0 (dcs-rank-compare A C T H rank best))]
           (cond (< rank 0) -1
             (or (< best 0) (< compared 0) (and (= compared 0) (< rank best))) rank
             :else best)))]
    (if (< chosen 0) -1 (recur (inc root) chosen))))))

(defn- dcs-resolve-group [M :vector-i64 S :string A :vector-i64 C :vector-i64 R [:list :string]] [:list :string]
  (let [H (vector-alloc (+ (vector-count C) (* 2 dc-nodes (vector-count C))))
        T (dcs-templates M S A C R H)]
    (if (not= (vector-at A 0) 0) R
      (let [best (dcs-best-root A C T H)
            ok (if (< best 0) (let [bad (dcp-fail A 7)] false)
                 (arena-scope (dcp-keep-cid A (dcs-fast-payload A C T H best))))]
      (if (not ok) R
      (let [group (dcp-saved-cid A) group-slot (inc (vector-count R))
            with-group (typed-list-conj [:list :string] R group)]
        (loop [i 0 out with-group]
          (if (or (= i (vector-count C)) (not= (vector-at A 0) 0)) out
            (let [f (vector-at C i) index (dec (dcp-f A f 3))
                  member-ok (arena-scope (dcp-keep-cid A (dcs-member-payload M S A f group index)))]
              (if (not member-ok) out
                (let [slot (dcp-put A f 2 (inc (vector-count out)))
                      metadata (-> A (dcp-put f 12 group-slot) (dcp-put f 13 index))]
                  (recur (inc i) (typed-list-conj [:list :string] out (dcp-saved-cid A))))))))))))))
(defn- dcs-resolve-component [M :vector-i64 S :string A :vector-i64 C :vector-i64 R [:list :string]] [:list :string]
  (let [n (vector-count C) f (vector-at C 0)
        recursive (or (> n 1) (dgg-has? A f f))
        next (if recursive (dcs-resolve-group M S A C R)
          (if (arena-scope (dcp-keep-cid A (dcp-function-payload M S A f R)))
            (let [slot (dcp-put A f 2 (inc (vector-count R)))]
              (typed-list-conj [:list :string] R (dcp-saved-cid A))) R))
        clear (loop [i 0 state A] (if (= i n) state
          (recur (inc i) (dcp-put state (vector-at C i) 3 0))))]
    next))
(defn- dcs-resolve [M :vector-i64 S :string A :vector-i64] [:list :string]
  (let [phase (vector-assoc! A 5 1)]
    (loop [component 1 R (typed-list-new [:list :string])]
      (if (or (> component (vector-at A 9)) (not= (vector-at A 0) 0)) R
        (let [C (dcs-members M S A component) n (vector-count C)]
          (if (> n 8) (let [bad (dcp-fail A 6)] R)
            (recur (inc component) (dcs-resolve-component M S A C R))))))))
;; Per-definition refusal (ADR 0300 report, JUN-584), the reference's `definitions` loop: X[f] = 1 when f's
;; component is above the scc-v1 bound (recursive-group-too-large), 2 when f calls a refused definition
;; (dependency-unavailable). Components arrive dependencies-first, so every callee outside C is already resolved or
;; refused; a blocked component is never hashed, and nothing is hashed for a hole. Every other component is
;; identified by exactly the dcs-resolve path. Any other failure is still a whole-module refusal (A[0]).
(defn- dcs-refusal-name [code :i64] :string
  (case code 1 "recursive-group-too-large" 2 "dependency-unavailable" ""))
(defn- dcs-blocked? [A :vector-i64 X :vector-i64 C :vector-i64] :bool
  (loop [i 0]
    (if (= i (vector-count C)) false
      (or (loop [edge (dgg-f A (vector-at C i) 14)]
            (cond (= edge 0) false
                  (> (vector-at X (dgg-edge A edge 0)) 0) true
                  :else (recur (dgg-edge A edge 1))))
          (recur (inc i))))))
(defn- dcs-resolve-each [M :vector-i64 S :string A :vector-i64 X :vector-i64] [:list :string]
  (let [phase (vector-assoc! A 5 1)]
    (loop [component 1 R (typed-list-new [:list :string])]
      (if (or (> component (vector-at A 9)) (not= (vector-at A 0) 0)) R
        (let [C (dcs-members M S A component) n (vector-count C)
              code (cond (dcs-blocked? A X C) 2 (> n 8) 1 :else 0)]
          (if (= code 0) (recur (inc component) (dcs-resolve-component M S A C R))
            (let [marked (loop [i 0] (if (= i n) 0
                           (let [save (vector-assoc! X (vector-at C i) code)] (recur (inc i)))))]
              (recur (inc component) R))))))))
(defn- dcs-native-checked? [S :string] :bool
  (arena-scope
    (let [text (string-concat S (kr-prelude))
          parsed (rd-run (kr-lex (mem-set (mem-new) MM-SRC-LEN (string-length text)) text) text)
          lowered (kr-run parsed text) named (nm-run lowered text) checked (ck-run named text)]
      (= (vector-at checked MM-ERR) 0))))
(defn- dcs-input-status [M :vector-i64 S :string doc :i64] :i64
  (let [functions (dcp-field M S doc ":functions") schemas (dcp-field M S doc ":schemas")
        format (dcp-text M S (dcp-field M S doc ":format")) count (kr-count M functions)]
    (cond (or (not (dcs-shape? M S doc false))
            (not (or (= format ":kotoba.kir/v3") (= format ":kotoba.kir/v4")))
            (not= (kr-kind M functions) ND-VEC) (= count 0) (>= count MM-FN-CAP)) 1
      (< (dcp-effect-mask M S doc) 0) 4
      (and (> schemas 0) (or (not= (kr-kind M schemas) ND-MAP) (> (kr-count M schemas) 0))) 5
      (not (dcs-native-checked? S)) 8
      :else 0)))
;; Structured, freshly checked graph for native build consumers. It produces
;; neither output nor authority. Callers must refuse an error before resolving
;; CIDs; the same guard is used by the original line-oriented producer.
(defn- dcs-plan-resource [M :vector-i64 S :string doc :i64 resource :i64] :vector-i64
  (let [status (if (dip-valid? resource) (dcs-input-status M S doc) 10) functions (dcp-field M S doc ":functions")
        count (kr-count M functions)]
    (if (not= status 0) (vector-assoc! (vector-alloc 16) 0 status)
      (let [A (dcs-init-resource M S doc functions resource)
            graph (loop [f 0 state A]
              (if (or (= f count) (not= (vector-at state 0) 0)) state
                (let [walked (arena-scope
                        (let [params (dcp-params M S state f)
                              body (dcp-form M S state (dcp-field M S (dcp-f state f 0) ":body")
                                      (typed-list-new [:list :string]) 0)]
                          (and (> (string-length params) 0) (> (string-length body) 0))))]
                  (if walked (recur (inc f) state) (vector-assoc! state 0 1)))))
            components (if (= (vector-at graph 0) 0) (dcs-components graph) graph)
            effects (if (= (vector-at components 0) 0) (dcp-effects M S components doc) components)]
        effects))))
(defn- dcs-plan [M :vector-i64 S :string doc :i64] :vector-i64 (dcs-plan-resource M S doc 0))
;; Row format: 0 = legacy `DCP1 6 2` header + `name cid group index` rows (the qualified test gates);
;; 1 = ADR 0300 `name<TAB>cid` rows + `SCANNED<TAB>n/n`; 2 = format 1 plus `<TAB>group<TAB>index`.
;; Any unresolved definition refuses the whole module before output, so SCANNED is always n/n here.
;; The `definition-cids` report no longer uses formats 1/2 of this printer: it takes dcs-rows (per-definition
;; refusal) through 05-definition-report's dsr-source-report.
(defn- dcs-produce-format [M :vector-i64 S :string doc :i64 resource :i64 format :i64] :i64
  (let [A (dcs-plan-resource M S doc resource) count (vector-at A 3)
        R (if (= (vector-at A 0) 0) (dcs-resolve M S A) (typed-list-new [:list :string]))]
        (cond (not= (vector-at A 0) 0) (vector-at A 0)
          (loop [f 0] (if (= f count) false (or (= (dcp-f A f 2) 0) (recur (inc f))))) 3
          :else
          (let [header (if (= format 0) (io-out "DCP1 6 2\n") 0)]
            (loop [f 0]
              (if (= f count) (if (= format 0) 0
                                (let [tail (io-out (string-concat "SCANNED\t"
                                             (string-concat (mem-u2dec count) (string-concat "/" (string-concat (mem-u2dec count) "\n")))))] 0))
                (let [cid (typed-list-nth [:list :string] R (dec (dcp-f A f 2)))
                      group (if (> (dcp-f A f 12) 0)
                              (typed-list-nth [:list :string] R (dec (dcp-f A f 12))) "-")
                      sep (if (= format 0) " " "\t")
                      name-part (string-concat (dcp-text M S (dcp-f A f 1)) sep)
                      index (mem-u2dec (if (> (dcp-f A f 12) 0) (dcp-f A f 13) -1))
                      row (if (= format 1) (string-concat name-part (string-concat cid "\n"))
                            (string-concat name-part (string-concat cid (string-concat sep
                              (string-concat group (string-concat sep (string-concat index "\n")))))))
                      write (io-out row)]
                  (recur (inc f)))))))))
;; ADR 0300 rows (format 1, or 2 with `<TAB>group<TAB>index`) for the report, nothing printed. A refused definition
;; is a row `name<TAB>REFUSED:<marker>` (format 2 adds `<TAB>-<TAB>-1`). Z[0] = whole-module status (0 = rows),
;; Z[1] = identified rows. A whole-module refusal returns no rows.
(defn- dcs-rows [M :vector-i64 S :string doc :i64 resource :i64 format :i64 Z :vector-i64] [:list :string]
  (let [A (dcs-plan-resource M S doc resource) count (vector-at A 3)
        X (vector-alloc (if (> count 0) count 1))
        R (if (= (vector-at A 0) 0) (dcs-resolve-each M S A X) (typed-list-new [:list :string]))]
    (cond (not= (vector-at A 0) 0) (let [save (vector-assoc! Z 0 (vector-at A 0))] (typed-list-new [:list :string]))
      (loop [f 0] (if (= f count) false
                    (or (and (= (dcp-f A f 2) 0) (= (vector-at X f) 0)) (recur (inc f)))))
        (let [save (vector-assoc! Z 0 3)] (typed-list-new [:list :string]))
      :else
      (loop [f 0 out (typed-list-new [:list :string])]
        (if (= f count) out
          (let [name (dcp-text M S (dcp-f A f 1)) refused (vector-at X f)
                row (if (> refused 0)
                      (string-concat name (string-concat "\tREFUSED:" (string-concat (dcs-refusal-name refused)
                        (if (= format 2) "\t-\t-1" ""))))
                      (let [cid (typed-list-nth [:list :string] R (dec (dcp-f A f 2)))
                            group (if (> (dcp-f A f 12) 0)
                                    (typed-list-nth [:list :string] R (dec (dcp-f A f 12))) "-")
                            index (mem-u2dec (if (> (dcp-f A f 12) 0) (dcp-f A f 13) -1))]
                        (if (= format 2)
                          (string-concat name (string-concat "\t" (string-concat cid (string-concat "\t"
                            (string-concat group (string-concat "\t" index))))))
                          (string-concat name (string-concat "\t" cid)))))
                counted (if (= refused 0) (vector-assoc! Z 1 (inc (vector-at Z 1))) Z)]
            (recur (inc f) (typed-list-conj [:list :string] out row))))))))
(defn- dcs-rows-text [K :string resource :i64 format :i64 Z :vector-i64] [:list :string]
  (let [M (rd-run (lx-run (mem-set (mem-new) MM-SRC-LEN (string-length K)) K) K)
        root (vector-at M MM-ROOT)]
    (if (or (not= (vector-at M MM-ERR) 0) (not= (kr-count M root) 1))
      (let [save (vector-assoc! Z 0 1)] (typed-list-new [:list :string]))
      (dcs-rows M K (kr-first M root) resource format Z))))
(defn- dcs-produce-resource [M :vector-i64 S :string doc :i64 resource :i64] :i64
  (dcs-produce-format M S doc resource 0))
(defn- dcs-produce [M :vector-i64 S :string doc :i64] :i64 (dcs-produce-resource M S doc 0))
(defn- dcs-run-format [S :string resource :i64 format :i64] :i64
  (let [M (rd-run (lx-run (mem-set (mem-new) MM-SRC-LEN (string-length S)) S) S)
        root (vector-at M MM-ROOT)]
    (if (or (not= (vector-at M MM-ERR) 0) (not= (kr-count M root) 1)) 1
      (dcs-produce-format M S (kr-first M root) resource format))))
(defn- dcs-run-resource [S :string resource :i64] :i64 (dcs-run-format S resource 0))
(defn- dcs-run [S :string] :i64 (dcs-run-resource S 0))
