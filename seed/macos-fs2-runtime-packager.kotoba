    (mh-label 74) (mh-mov 0 24) (mh-sys 6)
    (mh-cmpi 25 0) (mh-b 0x5400000b 75)
    (mh-mov 0 25) (mh-imm 1 1) (mh-sys 90) (mh-b 0x54000002 89)
    (mh-mov 0 25) (mh-sys 6)
