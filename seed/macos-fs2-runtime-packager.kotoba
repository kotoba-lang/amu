    (mh-ldr 8 23 512) (mh-b (bit-or 0xb4000000 8) 77)
    (mh-cmpi 8 1) (mh-b 0x54000000 78) (mh-imm 8 30) (mh-b 0x14000000 79)
    (mh-label 77) (mh-imm 8 5) (mh-b 0x14000000 79)
    (mh-label 78) (mh-imm 8 120)
    (mh-label 79) (mh-str 8 23 688)
    (mh-imm 0 0) (mh-add 1 23 672) (mh-imm 2 0) (mh-sys 83) (mh-b 0x54000002 89)
    (mh-ldr 0 23 544) (mh-add 1 23 1024) (mh-add 2 23 768) (mh-sys 59)
    (mh-label 89) (mh-imm 0 2) (mh-b (bit-or 0x10000000 1) 114)
    (mh-imm 2 (string-length "amu: EHOST child setup/exec failed\n")) (mh-sys 4) (mh-imm 0 127) (mh-sys 1) (mh-i 0xd4200000)
    ;; Error paths keep errno, close any live file, and return a typed reply.
    (mh-label 94) (mh-imm 0 22)
    (mh-label 93) (mh-str 0 23 256) (mh-mov 0 24) (mh-sys 6) (mh-ldr 0 23 256)
    (mh-b 0x14000000 92)
    (mh-label 90) (mh-imm 0 22) (mh-b 0x14000000 92)
    (mh-label 91) (mh-imm 0 13)
    (mh-label 92) (mh-sb 0 22 1) (mh-imm 8 1) (mh-sb 8 22 0) (mh-sb 31 22 2) (mh-imm 25 3)
    ;; Copy the bounded reply to a freshly minted native vector handle.
    (mh-label 95) (mh-cmpi 28 20) (mh-b 0x54000000 80)
    (mh-mov 0 19) (mh-mov 1 25) (mh-ldr 16 19 200) (mh-i 0xd63f0200)
    (mh-b (bit-or 0xb4000000 0) 98) (mh-mov 27 0)
    (mh-ldr 8 19 16000) (mh-sub 9 0 1) (mh-ar 8 8 9 4) (mh-ldr 9 8 0)
    (mh-ldr 10 19 16016) (mh-ar 26 10 9 3) (mh-imm 9 0)
    (mh-label 96) (mh-cmp 9 25) (mh-b 0x54000002 97)
    (mh-ar 10 22 9 0) (mh-lb 8 10 0) (mh-ar 10 26 9 3) (mh-str 8 10 0)
    (mh-add 9 9 1) (mh-b 0x14000000 96)
    (mh-label 80) (mh-lb 8 22 0) (mh-lb 9 22 1) (mh-lb 10 22 2)
    (mh-add 8 8 48) (mh-sb 8 22 0)
    (mh-hex-byte 9 1) (mh-hex-byte 10 3)
    (mh-ldr 26 19 408) (mh-imm 8 268435451) (mh-cmp 26 8) (mh-b 0x54000008 98)
    (mh-ldr 8 19 400) (mh-ar 8 8 26 0) (mh-imm 9 0)
    (mh-label 81) (mh-ar 10 22 9 0) (mh-lb 11 10 0)
    (mh-ar 10 8 9 0) (mh-sb 11 10 0) (mh-add 9 9 1)
    (mh-cmpi 9 5) (mh-b 0x54000003 81)
    (mh-add 9 26 5) (mh-str 9 19 408)
    (mh-mov 0 19) (mh-i 0xaa3a03e1) (mh-imm 2 5) (mh-ldr 16 19 56) (mh-i 0xd63f0200)
    (mh-mov 27 0)
    (mh-label 97) (mh-mov 0 27)
    (mh-i 0xa94573fb) (mh-i 0xa9446bf9) (mh-i 0xa94363f7)
    (mh-i 0xa9425bf5) (mh-i 0xa94153f3) (mh-i 0xa9407bfd)
    (mh-add 31 31 128) (mh-i 0xd65f03c0)
    (mh-label 98) (mh-imm 0 2) (mh-b (bit-or 0x10000000 1) 115)
    (mh-imm 2 (string-length "amu: EHOST invalid host ABI or exhausted buffer\n"))
    (mh-sys 4) (mh-imm 0 70) (mh-sys 1) (mh-i 0xd4200000)
    (mh-label 110) (mh-text ".")
    (mh-label 111) (mh-text "PATH=/usr/bin:/bin")
    (mh-label 112) (mh-text "LANG=C")
    (mh-label 114) (mh-text "amu: EHOST child setup/exec failed\n")
    (mh-label 115) (mh-text "amu: EHOST invalid host ABI or exhausted buffer\n"))]
    (mh-finish s)))

;; Public programs print the complete signed i64 main result and exit zero.
;; No file/process grant is added. Unsigned division also handles INT64_MIN.
(defn- mh-result-words [base :i64] :vector-i64
  (mh-finish (-> (mh-new base)
    (mh-sub 31 31 64) (mh-mov 20 0) (mh-cmpi 0 0) (mh-b 0x5400000a 1)
    (mh-i 0xcb0003e0) (mh-label 1)
    (mh-add 1 31 63) (mh-imm 8 10) (mh-sb 8 1 0) (mh-imm 3 10)
    (mh-label 2) (mh-i 0x9ac30804) (mh-i 0x9b038085)
    (mh-add 5 5 48) (mh-sub 1 1 1) (mh-sb 5 1 0)
    (mh-mov 0 4) (mh-b (bit-or 0xb5000000 0) 2)
    (mh-cmpi 20 0) (mh-b 0x5400000a 3)
    (mh-sub 1 1 1) (mh-imm 8 45) (mh-sb 8 1 0)
    (mh-label 3) (mh-add 2 31 64) (mh-i 0xcb010042)
    (mh-label 4) (mh-imm 0 1) (mh-sys 4) (mh-b 0x54000002 5)
    (mh-b (bit-or 0xb4000000 0) 6) (mh-ar 1 1 0 0)
    (mh-i 0xcb000042) (mh-b (bit-or 0xb5000000 2) 4)
    (mh-imm 0 0) (mh-sys 1) (mh-i 0xd4200000)
    (mh-label 5) (mh-cmpi 0 4) (mh-b 0x54000000 4)
    (mh-label 6) (mh-imm 0 74) (mh-sys 1) (mh-i 0xd4200000))))
