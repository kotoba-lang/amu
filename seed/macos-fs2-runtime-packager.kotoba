      (vector-assoc! 33 (bl-direct (+ start 132) (+ RUNTIME-START 52)))
      (vector-assoc! 439 (b-direct (+ start 1756) chain))))

;; ADRP x7, __DATA: wrapper PC is in the first 4 KiB page. The target is
;; 16 KiB-aligned, and the checked image size is far within ADRP's range.
(defn- data-adrp [text-bytes :i64] :i64
  (let [pages (quot text-bytes 4096)]
    (bit-or 0x90000007
      (bit-or (i64-shift-left (bit-and pages 3) 29)
              (i64-shift-left (quot pages 4) 5)))))

(defn- body-at [v :vector-i64 at :i64 raw :vector-i64 text-bytes :i64 mode :string entry-offset :i64 general :bool source :vector-i64] :vector-i64
  (let [raw-bytes (- (vector-count raw) 5)
        fs2-start (+ RAW-START (* 4 (quot (+ raw-bytes 3) 4)))
        total-bytes (+ text-bytes (mh-data-bytes mode))
        host (string=? mode "amu-cli-host")
        fs35 (or (string=? mode "fs2-cli-stdio-general") (amu-program-fs35? mode))
        extra (mh-extra-start raw-bytes)
        fs35-start (if (amu-program-fs35? mode)
          (+ extra 512 (* 4 (quot (+ (- (vector-count source) 5) 3) 4))) extra)
        result (-> v
      ;; mach_header_64: MH_EXECUTE, CPU_TYPE_ARM64, nine commands.
      ;; Direct-syscall launch uses NOUNDEFS|DYLDLINK|PIE (0x00200005).
      (u32-at at 4277009103) (u32-at (+ at 4) 16777228)
      (u32-at (+ at 12) 2) (u32-at (+ at 16) (if (amu-program-mode? mode) 10 9))
      (u32-at (+ at 20) (if (amu-program-mode? mode) 512 472)) (u32-at (+ at 24) 2097157)
      ;; LC_SEGMENT_64 __PAGEZERO, __TEXT, __DATA and __LINKEDIT.
      (u32-at (+ at 32) 25) (u32-at (+ at 36) 72)
      (text-at (+ at 40) "__PAGEZERO")
      (u64-at (+ at 64) 4294967296)
      (u32-at (+ at 104) 25) (u32-at (+ at 108) 72)
      (text-at (+ at 112) "__TEXT")
      (u64-at (+ at 128) 4294967296)
      (u64-at (+ at 136) text-bytes)
      (u64-at (+ at 152) text-bytes)
      (u32-at (+ at 160) 5) (u32-at (+ at 164) 5)
      (u32-at (+ at 176) 25) (u32-at (+ at 180) 72)
      (text-at (+ at 184) "__DATA")
      (u64-at (+ at 200) (+ 4294967296 text-bytes))
      (u64-at (+ at 208) (mh-data-bytes mode))
      (u64-at (+ at 216) text-bytes)
      (u64-at (+ at 224) (mh-data-bytes mode))
      (u32-at (+ at 232) 3) (u32-at (+ at 236) 3)
      (u32-at (+ at 248) 25) (u32-at (+ at 252) 72)
      (text-at (+ at 256) "__LINKEDIT")
      (u64-at (+ at 272) (+ 4294967296 total-bytes))
      (u64-at (+ at 280) DATA-BYTES)
      (u64-at (+ at 288) total-bytes)
      (u32-at (+ at 304) 1) (u32-at (+ at 308) 1)
      ;; macOS dyld starts LC_MAIN; no C runtime or libSystem load command.
      (u32-at (+ at 320) 14) (u32-at (+ at 324) 32)
      (u32-at (+ at 328) 12) (text-at (+ at 332) "/usr/lib/dyld")
      ;; LC_MAIN enters the wrapper, which calls the extracted function.
      (u32-at (+ at 352) 2147483688) (u32-at (+ at 356) 24)
      (u64-at (+ at 360) 1024)
      ;; LC_BUILD_VERSION: macOS 13.0.0.
      (u32-at (+ at 376) 50) (u32-at (+ at 380) 24)
      (u32-at (+ at 384) 1)
      (u32-at (+ at 388) 851968) (u32-at (+ at 392) 851968)
      ;; Empty LC_DYSYMTAB and LC_SYMTAB. The macOS 15 dyld relocation
      ;; fallback dereferences DYSYMTAB even when there are no relocations.
      ;; All offsets and counts remain zero in the freshly allocated vector.
      (u32-at (+ at 400) 11) (u32-at (+ at 404) 80)
      (u32-at (+ at 480) 2) (u32-at (+ at 484) 24)
      (words-at (+ at 1024) (wrapper-prefix text-bytes))
      (words-at (+ at 1152) (wrapper-suffix raw-bytes mode entry-offset general))
      (words-at (+ at SLICE-SETUP-START) (slice-setup-words))
      (words-at (+ at REFUSE-START) (refuse-words))
      (words-at (+ at SCOPE-START) (scope-words))
      (words-at (+ at KG-START)
                (vector-assoc! (kg-words) 79 (adr-x1 (+ KG-START 316) KG-MSG-START)))
      (text-at (+ at KG-MSG-START) KG-MSG)
      (text-at (+ at REFUSE-MSG-START) REFUSE-MSG)
      (words-at (+ at HELPER-START) (pair-helper-words))
      (words-at (+ at LEGACY-TYPED-START) (typed-helper-words))
      (words-at (+ at STDERR-TYPED-START) (stderr-helper-words))
      (words-at (+ at STDOUT-TYPED-START) (stdout-helper-words))
      (words-at (+ at BYTES-CONCAT-START) (bytes-concat-helper-words))
      (words-at (+ at CLI-RUNTIME-START)
                (vector-assoc!
                  (vector-assoc! (cli-helper-words CODEPOINT-FAST-START) 6
                    (b-direct (+ CLI-RUNTIME-START 24) VECTOR-RUNTIME-START))
                  8 (b-direct TYPED-START (cond host (+ extra 64) fs35 fs35-start
                                           :else (+ fs2-start FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES)))))
      (words-at (+ at RUNTIME-START)
                (vector-assoc! (runtime-helper-words) 12
                  (b-direct (+ RUNTIME-START 48) (+ VECTOR-RUNTIME-START 80))))
      (words-at (+ at CODEPOINT-START) (codepoint-helper-words))
      (words-at (+ at SUBSTRING-START)
                (vector-assoc! (substring-helper-words) 65
                  (b-direct (+ SUBSTRING-START 260) CODEPOINT-FAST-START)))
      (words-at (+ at VECTOR-RUNTIME-START) (vector-helper-words))
      (words-at (+ at PURE-RUNTIME-START) (pure-helper-words))
      (words-at (+ at CODEPOINT-FAST-START)
                (codepoint-fast-words CODEPOINT-FAST-START))
      (words-at (+ at BYTES-SLICE-START) (bytes-slice-helper-words))
      (words-at (+ at fs2-start) (fs2-da-helper-words fs2-start))
      (words-at (+ at fs2-start FS2-DA-BYTES)
                (fs2-bc-helper-words (+ fs2-start FS2-DA-BYTES) fs2-start))
      (words-at (+ at fs2-start FS2-DA-BYTES FS2-BC-BYTES)
                (fs2-kind9-shim-words (+ fs2-start FS2-DA-BYTES FS2-BC-BYTES)
                  (+ fs2-start FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES FS2-LOCK-BYTES)))
      (words-at (+ at fs2-start FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES)
                (fs2-lock-helper-words (+ fs2-start FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES)
                  (+ fs2-start FS2-DA-BYTES)))
      (words-at (+ at fs2-start FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES FS2-LOCK-BYTES)
                (fs2-ef-helper-words
                  (+ fs2-start FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES FS2-LOCK-BYTES)
                  fs2-start))
      (generated-at (+ at RAW-START) raw))]
    (if host
      (-> result
          (words-at (+ at extra) (mh-startup-words extra))
          (words-at (+ at extra 64)
            (mh-service-words (+ extra 64) (+ fs2-start FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES))))
      (if (amu-program-mode? mode)
        (let [start (+ extra 512)]
          (let [program (-> result
                       (u32-at (+ at 504) 49) (u32-at (+ at 508) 40)
                       (text-at (+ at 512) "AMU-SOURCE-V1")
                       (u64-at (+ at 528) start) (u64-at (+ at 536) (- (vector-count source) 5))
                       (words-at (+ at extra) (mh-result-words extra))
                       (generated-at (+ at start) source))]
            (if fs35
              (words-at program (+ at fs35-start)
                (fs35-helper-words fs35-start
                  (+ fs2-start FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES)))
              program)))
        (if fs35
          (words-at result (+ at extra)
            (fs35-helper-words extra (+ fs2-start FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES)))
          result)))))

(defn- acknowledged-image? [request :vector-i64 offset :i64 reply :vector-i64 total-bytes :i64] :bool
  (if (and (= (vector-count reply) (+ total-bytes 5))
           (= (vector-at reply 0) 0) (= (vector-at reply 1) 70)
           (= (vector-at reply 2) 83) (= (vector-at reply 3) 50)
           (= (vector-at reply 4) 0))
    (loop [i 0]
      (if (= i total-bytes) true
        (if (= (vector-at reply (+ i 5)) (vector-at request (+ offset i)))
          (recur (+ i 1)) false)))
    false))

(defn main [] :i64
  (let [path (typed-cap-call :cli/args :string :string "0")
        raw-path (typed-cap-call :cli/args :string :string "1")
        mode (typed-cap-call :cli/args :string :string "2")
        general (or (string=? mode "fs2-cli-stdio-general")
                    (string=? mode "fs2-cli-stdio-general-command")
                    (string=? mode "amu-cli-host") (amu-program-mode? mode))
        entry-text (if general (typed-cap-call :cli/args :string :string "3") "")
        selected-entry (if general (decimal-entry entry-text) 0)
        admitted (or (string=? mode "stdout")
                     (string=? mode "stderr")
                     (string=? mode "cli")
                     (string=? mode "cli-stderr")
                     (string=? mode "fs2-cli-stdio")
                     general
                     (string=? mode "deny"))
        fs2-prefix (string-from-utf8 (bytes-from-vector-i64 [0 70 83 50 0]))
        read-request (string-concat fs2-prefix (string-concat "A" (string-concat raw-path (string-from-utf8 (bytes-from-vector-i64 [0])))))
        raw (vector-i64-from-bytes
             (typed-cap-call :fs/app-data :string :bytes read-request))
        path-bytes (vector-i64-from-bytes (string-to-utf8 path))
        length (vector-count path-bytes)
        offset (+ 7 length)
        raw-bytes (- (vector-count raw) 5)
        entry-offset (if general selected-entry
                       (if (= raw-bytes MAC-PACKAGER-RAW-BYTES)
                         MAC-PACKAGER-ENTRY-OFFSET 0))
        source (if (amu-program-mode? mode)
          (vector-i64-from-bytes (typed-cap-call :fs/app-data :string :bytes
            (string-concat fs2-prefix (string-concat "A" (string-concat
              (typed-cap-call :cli/args :string :string "4") (string-from-utf8 (bytes-from-vector-i64 [0])))))))
          [0 70 83 50 0])
        fs2-end (+ (mh-extra-start raw-bytes) (if (string=? mode "amu-cli-host") 8192
          (if (amu-program-mode? mode)
            (+ 512 (* 4 (quot (+ (- (vector-count source) 5) 3) 4))
              (if (amu-program-fs35? mode) FS35-BYTES 0))
            (if (string=? mode "fs2-cli-stdio-general") FS35-BYTES 0))))
        text-bytes (* 16384 (quot (+ fs2-end 16383) 16384))
        total-bytes (+ text-bytes (mh-data-bytes mode))]
    (if (or (= length 0) (> length 255) (not admitted)
            (and (string=? mode "amu-cli-host")
              (let [words (vector-count (mh-service-words (+ (mh-extra-start raw-bytes) 64) 0))]
                (or (= words 0) (> (+ 64 (* words 4)) 8192))))
            (and (amu-program-mode? mode)
              (let [words (vector-count (mh-result-words (mh-extra-start raw-bytes)))]
                (or (= words 0) (> (* words 4) 512))))
            (if general
              (or (< raw-bytes 4) (> raw-bytes 4194304)
                  (< entry-offset 0) (not= (bit-and entry-offset 3) 0)
                  (> (+ entry-offset 4) raw-bytes))
              (and (not= raw-bytes 3254848) (not= raw-bytes 3250952)
                 (not= raw-bytes MAC-PACKAGER-RAW-BYTES)
                 (not= raw-bytes 516)
                 (not= raw-bytes 694) (not= raw-bytes 210)
                 (not= raw-bytes 135) (not= raw-bytes 608)
                 (not= raw-bytes 610) (not= raw-bytes 202)
                 (not= raw-bytes 1056) (not= raw-bytes 158)
                 (not= raw-bytes 340) (not= raw-bytes 124)
                 (not= raw-bytes 700) (not= raw-bytes 220)
                 (not= raw-bytes 714) (not= raw-bytes 200)
                 (not= raw-bytes 1545) (not= raw-bytes 152)
                 (not= raw-bytes 172)))
            (> (+ offset total-bytes) MAX-FS2-VALUE)
            (> (+ total-bytes 5) MAX-FS2-VALUE)
            (and (amu-program-mode? mode)
              (or (< (vector-count source) 6) (> (vector-count source) 1048581)
                  (not= (vector-at source 0) 0) (not= (vector-at source 1) 70)
                  (not= (vector-at source 2) 83) (not= (vector-at source 3) 50) (not= (vector-at source 4) 0)))
            (> fs2-end text-bytes)
            (not (= (vector-at raw 0) 0)) (not (= (vector-at raw 1) 70))
            (not (= (vector-at raw 2) 83)) (not (= (vector-at raw 3) 50))
            (not (= (vector-at raw 4) 0))) 2
      (let [v0 (vector-alloc (+ offset total-bytes))
            v1 (-> v0
                   (byte-at 0 0) (byte-at 1 70) (byte-at 2 83)
                   (byte-at 3 50) (byte-at 4 0) (byte-at 5 66)
                   (text-at 6 path)
                   (byte-at (+ 6 length) 0)
                   (body-at offset raw text-bytes mode entry-offset general source))
            response (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 v1))]
        (if (acknowledged-image? v1 offset (vector-i64-from-bytes response) total-bytes) 0 3)))))

;; Small fixed-instruction builder for the Darwin host adapter. This emits
;; only the code below; it is not an assembler dependency or compiler route.
;; Labels and branches are resolved by this Amu-built Kotoba packager.
(defn- mh-new [base :i64] :vector-i64
  (vector-assoc! (vector-alloc 4096) 2 base))
(defn- mh-i [s :vector-i64 word :i64] :vector-i64
  (let [n (vector-at s 0)]
    (if (>= n 2816) (vector-assoc! s 3 1)
      (-> s (vector-assoc! (+ 256 n) word) (vector-assoc! 0 (+ n 1))))))
(defn- mh-label [s :vector-i64 label :i64] :vector-i64
  (if (or (< label 1) (> label 127) (not= (vector-at s (+ 8 label)) 0))
    (vector-assoc! s 3 1) (vector-assoc! s (+ 8 label) (+ 1 (vector-at s 0)))))
(defn- mh-b [s :vector-i64 opcode :i64 label :i64] :vector-i64
  (let [n (vector-at s 0) f (vector-at s 1) at (+ 3072 (* f 3))]
    (if (or (>= f 341) (< label 1) (> label 127)) (vector-assoc! s 3 1)
      (-> s (vector-assoc! at n) (vector-assoc! (+ at 1) opcode)
            (vector-assoc! (+ at 2) label) (vector-assoc! 1 (+ f 1))
            (mh-i opcode)))))
(defn- mh-imm [s :vector-i64 rd :i64 value :i64] :vector-i64
  (let [low (-> s
      (mh-i (bit-or 0xd2800000 (bit-or rd (i64-shift-left (bit-and value 65535) 5))))
      (mh-i (bit-or 0xf2a00000 (bit-or rd (i64-shift-left (bit-and (u64-shift-right value 16) 65535) 5)))))]
    (if (> value 4294967295)
      (-> low
          (mh-i (bit-or 0xf2c00000 (bit-or rd (i64-shift-left (bit-and (u64-shift-right value 32) 65535) 5))))
          (mh-i (bit-or 0xf2e00000 (bit-or rd (i64-shift-left (bit-and (u64-shift-right value 48) 65535) 5)))))
      low)))
(defn- mh-mov [s :vector-i64 rd :i64 rn :i64] :vector-i64
  (mh-i s (bit-or 0xaa0003e0 (bit-or rd (i64-shift-left rn 16)))))
(defn- mh-add [s :vector-i64 rd :i64 rn :i64 value :i64] :vector-i64
  (mh-i s (bit-or 0x91000000 (bit-or rd (bit-or (i64-shift-left rn 5) (i64-shift-left value 10))))))
(defn- mh-sub [s :vector-i64 rd :i64 rn :i64 value :i64] :vector-i64
  (mh-i s (bit-or 0xd1000000 (bit-or rd (bit-or (i64-shift-left rn 5) (i64-shift-left value 10))))))
(defn- mh-ar [s :vector-i64 rd :i64 rn :i64 rm :i64 shift :i64] :vector-i64
  (mh-i s (bit-or 0x8b000000 (bit-or rd (bit-or (i64-shift-left rn 5)
         (bit-or (i64-shift-left rm 16) (i64-shift-left shift 10)))))))
(defn- mh-ldr [s :vector-i64 rd :i64 rn :i64 offset :i64] :vector-i64
  (mh-i s (bit-or 0xf9400000 (bit-or rd (bit-or (i64-shift-left rn 5) (i64-shift-left (quot offset 8) 10))))))
(defn- mh-str [s :vector-i64 rd :i64 rn :i64 offset :i64] :vector-i64
  (mh-i s (bit-or 0xf9000000 (bit-or rd (bit-or (i64-shift-left rn 5) (i64-shift-left (quot offset 8) 10))))))
(defn- mh-lb [s :vector-i64 rd :i64 rn :i64 offset :i64] :vector-i64
  (mh-i s (bit-or 0x39400000 (bit-or rd (bit-or (i64-shift-left rn 5) (i64-shift-left offset 10))))))
(defn- mh-sb [s :vector-i64 rd :i64 rn :i64 offset :i64] :vector-i64
  (mh-i s (bit-or 0x39000000 (bit-or rd (bit-or (i64-shift-left rn 5) (i64-shift-left offset 10))))))
(defn- mh-cmpi [s :vector-i64 rn :i64 value :i64] :vector-i64
  (mh-i s (bit-or 0xf100001f (bit-or (i64-shift-left rn 5) (i64-shift-left value 10)))))
(defn- mh-cmp [s :vector-i64 rn :i64 rm :i64] :vector-i64
  (mh-i s (bit-or 0xeb00001f (bit-or (i64-shift-left rn 5) (i64-shift-left rm 16)))))
(defn- mh-sys [s :vector-i64 number :i64] :vector-i64
  (-> s (mh-imm 16 (+ 33554432 number)) (mh-i 0xd4001001)))
(defn- mh-jump [s :vector-i64 target :i64] :vector-i64
  (mh-i s (b-direct (+ (vector-at s 2) (* 4 (vector-at s 0))) target)))
(defn- mh-call [s :vector-i64 target :i64] :vector-i64
  (mh-i s (bl-direct (+ (vector-at s 2) (* 4 (vector-at s 0))) target)))
(defn- mh-hex-byte [s :vector-i64 value :i64 offset :i64] :vector-i64
  (let [one (-> s
    (mh-i (bit-or 0xd344fc0b (i64-shift-left value 5)))
    (mh-add 11 11 48) (mh-cmpi 11 57) (mh-add 12 11 7)
    (mh-i 0x9a8b818b) (mh-sb 11 22 offset))]
    (-> one (mh-imm 12 15)
        (mh-i (bit-or 0x8a0c000b (i64-shift-left value 5)))
        (mh-add 11 11 48) (mh-cmpi 11 57) (mh-add 12 11 7)
        (mh-i 0x9a8b818b) (mh-sb 11 22 (+ offset 1)))))
(defn- mh-text [s :vector-i64 text :string] :vector-i64
  (let [b (vector-i64-from-bytes (string-to-utf8 text)) n (vector-count b)]
    (loop [i 0 out s]
      (if (> i n) out
        (let [word (loop [j 0 value 0]
                     (if (= j 4) value
                       (recur (+ j 1) (bit-or value
                         (i64-shift-left (if (< (+ i j) n) (vector-at b (+ i j)) 0) (* j 8))))))]
          (recur (+ i 4) (mh-i out word)))))))
(defn- mh-finish [s :vector-i64] :vector-i64
  (let [words (vector-at s 0)
        valid (and (= (vector-at s 3) 0)
          (loop [i 0] (if (= i (vector-at s 1)) true
            (if (= (vector-at s (+ 8 (vector-at s (+ 3074 (* i 3)))) ) 0) false (recur (+ i 1))))))
        base (loop [i 0 out (vector-alloc words)]
               (if (= i words) out
                 (recur (+ i 1) (vector-assoc! out i (vector-at s (+ 256 i))))))]
    (if (not valid) [] (loop [i 0 out base]
      (if (= i (vector-at s 1)) out
        (let [at (+ 3072 (* i 3)) pc (vector-at s at)
              op (vector-at s (+ at 1))
              delta (- (- (vector-at s (+ 8 (vector-at s (+ at 2)))) 1) pc)
              mask (if (= (bit-and op 0x7c000000) 0x14000000) 0x03ffffff 0x0007ffff)
              bits (bit-and delta mask)
              word (bit-or op (if (= mask 0x03ffffff) bits (i64-shift-left bits 5)))]
          (recur (+ i 1) (vector-assoc! out pc word))))))))

(defn- mh-startup-words [start :i64] :vector-i64
  [0xa9bf7bfd (bl-direct (+ start 4) SLICE-SETUP-START)
   0xf9400a68 0xd2a00209 0xaa090108 0xf9000a68 0xa8c17bfd 0xd65f03c0])

;; AMUH1: NUL AMUH 1 op, then bounded UTF-8/NUL fields or binary tail.
;; Reply: status byte (0 success), payload; errors are [1, Darwin errno, 0].
;; wire35 owns file/host-info operations, wire20 owns only child execution.
;; Scratch is private to this host image at ctx+16384, outside the old ABI.
(defn- mh-service-words [base :i64 fallback :i64] :vector-i64
  (let [s (-> (mh-new base)
    ;; Other capabilities retain the existing CLI/stdio dispatch.
    (mh-cmpi 1 35) (mh-b 0x54000000 1)
    (mh-cmpi 1 20) (mh-b 0x54000000 1) (mh-jump fallback)
    (mh-label 1)
    (mh-sub 31 31 128)
    (mh-i 0xa9007bfd) (mh-i 0xa90153f3) (mh-i 0xa9025bf5)
    (mh-i 0xa90363f7) (mh-i 0xa9046bf9) (mh-i 0xa90573fb)
    (mh-mov 19 0) (mh-mov 28 1) (mh-mov 27 4)
    (mh-str 2 31 96) (mh-str 3 31 104)
    ;; Initialize the bounded 20MiB native byte scratch before any request.
    (mh-ldr 21 19 16384) (mh-b (bit-or 0xb5000000 21) 2)
    (mh-imm 0 0) (mh-imm 1 20971520) (mh-imm 2 3) (mh-imm 3 4098)
    (mh-i 0x92800004) (mh-imm 5 0) (mh-sys 197) (mh-b 0x54000002 98)
    (mh-mov 21 0) (mh-str 21 19 16384)
    (mh-label 2) (mh-ldr 2 31 96) (mh-ldr 3 31 104)
    (mh-imm 8 8388608) (mh-ar 22 21 8 0)
    (mh-imm 8 16777216) (mh-ar 23 21 8 0)
    (mh-cmpi 28 20) (mh-b 0x54000000 8)
    (mh-cmpi 2 8) (mh-b 0x54000001 98)
    (mh-cmpi 3 8) (mh-b 0x54000001 98)
    ;; Validate the complete vector descriptor and every byte before use.
    (mh-b (bit-or 0xb4000000 27) 90)
    (mh-ldr 8 19 16008) (mh-cmp 27 8) (mh-b 0x54000008 90)
    (mh-ldr 8 19 16000) (mh-sub 9 27 1) (mh-ar 8 8 9 4)
    (mh-ldr 9 8 0) (mh-ldr 20 8 8)
    (mh-cmpi 20 7) (mh-b 0x54000003 90)
    (mh-imm 10 8388608) (mh-cmp 20 10) (mh-b 0x54000008 90)
    (mh-ldr 10 19 16024) (mh-cmp 9 10) (mh-b 0x54000008 90)
    (mh-ar 11 9 20 0) (mh-cmp 11 10) (mh-b 0x54000008 90)
    (mh-ldr 10 19 16016) (mh-ar 10 10 9 3)
    (mh-imm 9 0) (mh-label 3)
    (mh-cmp 9 20) (mh-b 0x54000002 4)
    (mh-ar 11 10 9 3) (mh-ldr 8 11 0) (mh-cmpi 8 255) (mh-b 0x54000008 90)
    (mh-ar 11 21 9 0) (mh-sb 8 11 0) (mh-add 9 9 1) (mh-b 0x14000000 3)
    ;; Wire20 retains its existing string->string catalogue contract.
    (mh-label 8) (mh-cmpi 2 1) (mh-b 0x54000001 98)
    (mh-cmpi 3 1) (mh-b 0x54000001 98)
    (mh-b (bit-or 0xb4000000 27) 90)
    (mh-ldr 8 19 288) (mh-ldr 8 8 0) (mh-cmp 27 8) (mh-b 0x54000008 90)
    (mh-ldr 8 19 296) (mh-sub 9 27 1) (mh-ar 8 8 9 4) (mh-ldr 20 8 8) (mh-ldr 26 8 0)
    (mh-cmpi 20 7) (mh-b 0x54000003 90)
    (mh-imm 8 65536) (mh-cmp 20 8) (mh-b 0x54000008 90)
    (mh-mov 0 19) (mh-mov 1 26) (mh-mov 2 20) (mh-call (+ RUNTIME-START 52))
    (mh-mov 26 0) (mh-imm 9 0)
    (mh-label 9) (mh-cmp 9 20) (mh-b 0x54000002 4)
    (mh-ar 10 26 9 0) (mh-lb 8 10 0) (mh-ar 10 21 9 0) (mh-sb 8 10 0)
    (mh-add 9 9 1) (mh-b 0x14000000 9)
    (mh-label 4)
    (mh-lb 8 21 0) (mh-b (bit-or 0xb5000000 8) 90)
    (mh-lb 8 21 1) (mh-cmpi 8 65) (mh-b 0x54000001 90)
    (mh-lb 8 21 2) (mh-cmpi 8 77) (mh-b 0x54000001 90)
    (mh-lb 8 21 3) (mh-cmpi 8 85) (mh-b 0x54000001 90)
    (mh-lb 8 21 4) (mh-cmpi 8 72) (mh-b 0x54000001 90)
    (mh-lb 8 21 5) (mh-cmpi 8 1) (mh-b 0x54000001 90)
    ;; Independently check the effective grant, not a caller's opcode.
    (mh-cmpi 28 20) (mh-b 0x54000000 5)
    (mh-imm 9 34359738368) (mh-b 0x14000000 6)
    (mh-label 5) (mh-imm 9 1048576)
    (mh-label 6) (mh-ldr 8 19 16) (mh-i 0x8a090108)
    (mh-b (bit-or 0xb4000000 8) 91)
    (mh-sb 31 22 0) (mh-lb 8 21 6)
    (mh-cmpi 28 20) (mh-b 0x54000001 7)
    (mh-cmpi 8 9) (mh-b 0x54000001 91) (mh-b 0x14000000 60)
    (mh-label 7) (mh-cmpi 8 9) (mh-b 0x54000000 91)
    (mh-cmpi 8 0) (mh-b 0x54000000 10)
    (mh-cmpi 8 1) (mh-b 0x54000000 30)
    (mh-cmpi 8 2) (mh-b 0x54000000 40)
    (mh-cmpi 8 3) (mh-b 0x54000000 50)
    (mh-cmpi 8 4) (mh-b 0x54000000 51)
    (mh-cmpi 8 5) (mh-b 0x54000000 52)
    (mh-cmpi 8 6) (mh-b 0x54000000 53)
    (mh-cmpi 8 7) (mh-b 0x54000000 54)
    (mh-cmpi 8 8) (mh-b 0x54000000 55)
    (mh-cmpi 8 10) (mh-b 0x54000000 57) (mh-b 0x14000000 90)
    ;; INFO: actual executable vnode path, cwd and 128 bits of kernel entropy.
    (mh-label 10) (mh-cmpi 20 7) (mh-b 0x54000001 90)
    (mh-sys 20) (mh-mov 1 0) (mh-imm 0 2) (mh-imm 2 11)
    (mh-imm 3 0) (mh-add 4 22 1) (mh-imm 5 4096)
    (mh-sys 336) (mh-b 0x54000002 92)
    (mh-imm 25 1) (mh-label 11)
    (mh-cmpi 25 4095) (mh-b 0x54000002 90)
    (mh-ar 8 22 25 0) (mh-lb 9 8 0) (mh-add 25 25 1)
    (mh-b (bit-or 0xb5000000 9) 11)
    (mh-b (bit-or 0x10000000 0) 110) (mh-imm 1 1048576) (mh-imm 2 0)
    (mh-sys 5) (mh-b 0x54000002 92) (mh-mov 24 0)
    (mh-imm 1 50) (mh-ar 2 22 25 0) (mh-sys 92)
    (mh-b 0x54000002 93) (mh-mov 0 24) (mh-sys 6)
    (mh-imm 26 0) (mh-label 12)
    (mh-cmpi 26 4095) (mh-b 0x54000002 90)
    (mh-ar 8 22 25 0) (mh-ar 8 8 26 0) (mh-lb 9 8 0)
    (mh-add 26 26 1) (mh-b (bit-or 0xb5000000 9) 12)
    (mh-ar 25 25 26 0) (mh-ar 0 22 25 0) (mh-imm 1 16)
    (mh-sys 500) (mh-b 0x54000002 92) (mh-add 25 25 16)
    (mh-b 0x14000000 95)
    ;; Path parser subroutine: X26 path, X27 first byte after NUL.
    (mh-label 20) (mh-add 26 21 7) (mh-mov 27 26)
    (mh-imm 9 0) (mh-label 21)
    (mh-add 10 9 7) (mh-cmp 10 20) (mh-b 0x54000002 90)
    (mh-cmpi 9 4095) (mh-b 0x54000002 90)
    (mh-lb 8 27 0) (mh-add 27 27 1)
    (mh-b (bit-or 0xb4000000 8) 22)
    (mh-cmpi 8 32) (mh-b 0x54000003 90)
    (mh-add 9 9 1) (mh-b 0x14000000 21)
    (mh-label 22) (mh-cmpi 9 0) (mh-b 0x54000000 90) (mh-i 0xd65f03c0)
    ;; General bounded NUL-field parser, including empty argv fields.
    (mh-label 23) (mh-mov 27 26) (mh-imm 9 0)
    (mh-label 24) (mh-ar 10 21 20 0) (mh-cmp 27 10) (mh-b 0x54000002 90)
    (mh-cmpi 9 4095) (mh-b 0x54000002 90)
    (mh-lb 8 27 0) (mh-add 27 27 1) (mh-b (bit-or 0xb4000000 8) 25)
    (mh-add 9 9 1) (mh-b 0x14000000 24)
    (mh-label 25) (mh-i 0xd65f03c0)
    ;; READ: open no-follow/nonblocking, regular file, bounded exact bytes.
    (mh-label 30) (mh-b 0x94000000 20)
    (mh-ar 8 21 20 0) (mh-cmp 27 8) (mh-b 0x54000001 90)
    (mh-mov 0 26) (mh-imm 1 16777476) (mh-imm 2 0) (mh-sys 5)
    (mh-b 0x54000002 92) (mh-mov 24 0)
    (mh-mov 1 23) (mh-sys 339) (mh-b 0x54000002 93)
    (mh-i 0x79400ae8) (mh-imm 9 61440) (mh-i 0x8a090108)
    (mh-imm 9 32768) (mh-cmp 8 9) (mh-b 0x54000001 94)
    (mh-ldr 26 23 96) (mh-imm 8 8388607) (mh-cmp 26 8) (mh-b 0x54000008 94)
    (mh-imm 25 0) (mh-label 31)
    (mh-cmp 25 26) (mh-b 0x54000002 32)
    (mh-mov 0 24) (mh-add 1 22 1) (mh-ar 1 1 25 0)
    (mh-i 0xcb190342) (mh-sys 3) (mh-b 0x54000002 33)
    (mh-b (bit-or 0xb4000000 0) 94) (mh-ar 25 25 0 0) (mh-b 0x14000000 31)
    (mh-label 33) (mh-cmpi 0 4) (mh-b 0x54000000 31) (mh-b 0x14000000 93)
    (mh-label 32) (mh-mov 0 24) (mh-add 1 23 1024) (mh-imm 2 1) (mh-sys 3)
    (mh-b 0x54000003 34) (mh-cmpi 0 4) (mh-b 0x54000000 32) (mh-b 0x14000000 93)
    (mh-label 34) (mh-b (bit-or 0xb5000000 0) 94)
    (mh-mov 0 24) (mh-sys 6) (mh-add 25 26 1) (mh-b 0x14000000 95)
    ;; WRITE (exclusive): path/NUL then exact binary tail.
    (mh-label 40) (mh-b 0x94000000 20)
    (mh-str 26 23 272)
    (mh-mov 0 26) (mh-imm 1 16780037) (mh-imm 2 384) (mh-sys 5)
    (mh-b 0x54000002 92) (mh-mov 24 0)
    (mh-imm 1 384) (mh-sys 124) (mh-b 0x54000002 45)
    (mh-ar 26 21 20 0) (mh-imm 25 0) (mh-label 41)
    (mh-cmp 27 26) (mh-b 0x54000002 42)
    (mh-mov 0 24) (mh-mov 1 27) (mh-i 0xcb1b0342)
    (mh-sys 4) (mh-b 0x54000002 43) (mh-b (bit-or 0xb4000000 0) 44)
    (mh-ar 27 27 0 0) (mh-b 0x14000000 41)
    (mh-label 43) (mh-cmpi 0 4) (mh-b 0x54000000 41) (mh-b 0x14000000 45)
    (mh-label 42) (mh-mov 0 24) (mh-sys 6) (mh-b 0x54000002 46)
    (mh-imm 25 1) (mh-b 0x14000000 95)
    ;; Only a successful O_EXCL open owns the path. Preserve errno across
    ;; close/unlink, including short/zero writes and close failures.
    (mh-label 44) (mh-imm 0 5)
    (mh-label 45) (mh-str 0 23 256) (mh-mov 0 24) (mh-sys 6) (mh-b 0x14000000 47)
    (mh-label 46) (mh-str 0 23 256)
    (mh-label 47) (mh-ldr 0 23 272) (mh-sys 10) (mh-ldr 0 23 256) (mh-b 0x14000000 92)
    ;; mkdir(0700), unlink, rmdir, chmod(0700), rename, stat via open/fstat.
    (mh-label 50) (mh-b 0x94000000 20) (mh-ar 8 21 20 0) (mh-cmp 27 8) (mh-b 0x54000001 90) (mh-mov 0 26) (mh-imm 1 448)
    (mh-sys 136) (mh-b 0x54000002 92)
    (mh-mov 0 26) (mh-imm 1 448) (mh-sys 15) (mh-b 0x54000002 92) (mh-b 0x14000000 56)
    (mh-label 51) (mh-b 0x94000000 20) (mh-ar 8 21 20 0) (mh-cmp 27 8) (mh-b 0x54000001 90) (mh-mov 0 26)
    (mh-sys 10) (mh-b 0x54000002 92) (mh-b 0x14000000 56)
    (mh-label 52) (mh-b 0x94000000 20) (mh-ar 8 21 20 0) (mh-cmp 27 8) (mh-b 0x54000001 90) (mh-mov 0 26)
    (mh-sys 137) (mh-b 0x54000002 92) (mh-b 0x14000000 56)
    (mh-label 53) (mh-b 0x94000000 20) (mh-ar 8 21 20 0) (mh-cmp 27 8) (mh-b 0x54000001 90) (mh-mov 0 26) (mh-imm 1 448)
    (mh-sys 15) (mh-b 0x54000002 92) (mh-b 0x14000000 56)
    (mh-label 54) (mh-b 0x94000000 20) (mh-mov 24 26)
    (mh-mov 26 27) (mh-b 0x94000000 23) (mh-cmpi 9 0) (mh-b 0x54000000 90)
    (mh-ar 8 21 20 0) (mh-cmp 27 8) (mh-b 0x54000001 90)
    (mh-mov 0 24) (mh-mov 1 26)
    (mh-sys 128) (mh-b 0x54000002 92) (mh-b 0x14000000 56)
    (mh-label 55) (mh-b 0x94000000 20) (mh-ar 8 21 20 0) (mh-cmp 27 8) (mh-b 0x54000001 90) (mh-mov 0 26)
    (mh-imm 1 16777476) (mh-imm 2 0) (mh-sys 5) (mh-b 0x54000002 92)
    (mh-mov 24 0) (mh-mov 1 23) (mh-sys 339) (mh-b 0x54000002 93)
    (mh-mov 0 24) (mh-sys 6)
    (mh-str 31 22 0) (mh-i 0x79400ae8) (mh-str 8 22 8) (mh-ldr 8 23 96) (mh-str 8 22 16)
    (mh-imm 25 24) (mh-b 0x14000000 95)
    (mh-label 56) (mh-imm 25 1) (mh-b 0x14000000 95)
    ;; Self FD metadata supports native child-isolation audits (no contents).
    (mh-label 57) (mh-cmpi 20 9) (mh-b 0x54000001 90)
    (mh-lb 0 21 7) (mh-lb 8 21 8) (mh-ar 0 0 8 8)
    (mh-imm 1 1) (mh-imm 2 0) (mh-sys 92) (mh-b 0x54000002 92)
    (mh-sb 0 22 1) (mh-imm 25 2) (mh-b 0x14000000 95)
    ;; EXEC: mode (0 guest, 1 compiler FD3, 2 signing), argc (1..64),
    ;; cwd, capture-output-or-empty, executable, exactly argc argv fields.
    (mh-label 60) (mh-cmpi 20 10) (mh-b 0x54000003 90)
    (mh-imm 8 65536) (mh-cmp 20 8) (mh-b 0x54000008 90)
    (mh-lb 8 21 7) (mh-cmpi 8 2) (mh-b 0x54000008 91) (mh-str 8 23 512)
    (mh-lb 8 21 8) (mh-cmpi 8 1) (mh-b 0x54000003 90)
    (mh-cmpi 8 64) (mh-b 0x54000008 90) (mh-str 8 23 520)
    (mh-add 26 21 9) (mh-b 0x94000000 23)
    (mh-cmpi 9 0) (mh-b 0x54000000 90) (mh-str 26 23 528)
    (mh-mov 26 27) (mh-b 0x94000000 23) (mh-str 26 23 536)
    (mh-mov 26 27) (mh-b 0x94000000 23)
    (mh-cmpi 9 0) (mh-b 0x54000000 90) (mh-str 26 23 544)
    (mh-imm 25 0) (mh-label 61)
    (mh-ldr 8 23 520) (mh-cmp 25 8) (mh-b 0x54000002 62)
    (mh-mov 26 27) (mh-b 0x94000000 23)
    (mh-add 8 23 1024) (mh-ar 8 8 25 3) (mh-str 26 8 0)
    (mh-add 25 25 1) (mh-b 0x14000000 61)
    (mh-label 62) (mh-add 8 23 1024) (mh-ar 8 8 25 3) (mh-str 31 8 0)
    (mh-ar 8 21 20 0) (mh-cmp 27 8) (mh-b 0x54000001 90)
    ;; Relocate internal descriptors above stdio/FD3 before forking.
    (mh-ldr 0 23 528) (mh-imm 1 17826048) (mh-imm 2 0) (mh-sys 5)
    (mh-b 0x54000002 92) (mh-mov 24 0)
    (mh-imm 1 67) (mh-imm 2 64) (mh-sys 92) (mh-b 0x54000002 93)
    (mh-mov 26 0) (mh-mov 0 24) (mh-sys 6) (mh-mov 24 26)
    (mh-i 0x92800019) (mh-str 25 23 560)
    (mh-ldr 26 23 536) (mh-lb 8 26 0) (mh-b (bit-or 0xb4000000 8) 63)
    (mh-mov 0 26) (mh-imm 1 16780037) (mh-imm 2 384) (mh-sys 5)
    (mh-b 0x54000002 93) (mh-mov 25 0)
    (mh-imm 1 67) (mh-imm 2 64) (mh-sys 92) (mh-b 0x54000002 68)
    (mh-mov 26 0) (mh-mov 0 25) (mh-sys 6) (mh-mov 25 26)
    (mh-mov 0 25) (mh-imm 1 384) (mh-sys 124) (mh-b 0x54000002 68)
    (mh-str 25 23 560)
    (mh-label 63) (mh-sys 2) (mh-b 0x54000002 68)
    ;; XNU arm64 returns x1=1 in the child, x1=0 in the parent.
    (mh-b (bit-or 0xb5000000 1) 70) (mh-mov 26 0)
    (mh-mov 0 24) (mh-sys 6)
    (mh-cmpi 25 0) (mh-b 0x5400000b 64)
    (mh-mov 0 25) (mh-sys 6)
    (mh-label 64) (mh-mov 0 26) (mh-add 1 23 576)
    (mh-imm 2 0) (mh-imm 3 0) (mh-sys 7) (mh-b 0x54000003 65)
    (mh-cmpi 0 4) (mh-b 0x54000000 64) (mh-b 0x14000000 92)
    (mh-label 65) (mh-ldr 8 23 576) (mh-imm 9 127) (mh-i 0x8a090109)
    (mh-b (bit-or 0xb4000000 9) 66)
    (mh-cmpi 9 14) (mh-b 0x54000000 67) (mh-add 8 9 128) (mh-b 0x14000000 69)
    (mh-label 66) (mh-i 0xd3483d08) (mh-b 0x14000000 69)
    (mh-label 67) (mh-imm 8 124)
    (mh-label 69) (mh-sb 31 22 0) (mh-sb 8 22 1) (mh-sb 9 22 2)
    (mh-imm 25 3) (mh-b 0x14000000 95)
    (mh-label 68) (mh-str 0 23 256)
    (mh-cmpi 25 0) (mh-b 0x5400000b 26) (mh-mov 0 25) (mh-sys 6)
    (mh-label 26) (mh-ldr 0 23 256) (mh-b 0x14000000 93)
