;; Diagnostic full Mac compiler packager with scoped FS2 D/A/B/C/E/F callbacks.
;; The full wire-35 provider and Mac selfhost closure are still incomplete.
(ns seed.macos-fs2-runtime-packager (:export [main]))

(def MAX-FS2-VALUE 8388608)
(def DATA-BYTES 16384)
(def RAW-START 8192)
(def RUNTIME-START 2048)
(def SLICE-SETUP-START 1264)
(def SCOPE-START 1768)
(def SCOPE-LEAVE-START 1848)
(def KG-START 3720)
(def KG-MSG-START 4944)
(def KG-MSG "seed: keyword table failed (Mac runtime)\n")
(def REFUSE-START 1312)
(def REFUSE-MSG-START 1360)
(def REFUSE-MSG "seed: arena-scope failed (Mac runtime)\n")
(def POOL-SETUP-START 2048)
(def CONCAT-START 2184)
(def POOL-EQUAL-START 2556)
(def HELPER-START 1408)
(def LEGACY-TYPED-START 1536)
(def STDERR-TYPED-START 2816)
(def CLI-RUNTIME-START 3216)
(def TYPED-START 3248)
(def CODEPOINT-START 4096)
(def SUBSTRING-START 4672)
(def VECTOR-RUNTIME-START 5000)
(def PURE-RUNTIME-START 6256)
(def CODEPOINT-FAST-START 7104)
(def BYTES-SLICE-START 7296)
(def STDOUT-TYPED-START 7488)
(def BYTES-CONCAT-START 7872)
(def FS2-DA-BYTES 736)
(def FS2-BC-BYTES 776)
(def FS2-KIND9-BYTES 256)
(def FS2-LOCK-BYTES 792)
(def FS2-EF-BYTES 1172)
(def FS35-BYTES 1768)
(def MAC-PACKAGER-RAW-BYTES 49680)
(def MAC-PACKAGER-ENTRY-OFFSET 44880)

(defn- amu-program-mode? [mode :string] :bool
  (or (string=? mode "amu-program") (string=? mode "amu-program-fs35")))
(defn- amu-program-fs35? [mode :string] :bool
  (string=? mode "amu-program-fs35"))

;; Only the public host CLI receives this service. Bootstrap/guest modes do not.
(defn- mh-extra-start [raw-bytes :i64] :i64
  (+ RAW-START (* 4 (quot (+ raw-bytes 3) 4))
     FS2-DA-BYTES FS2-BC-BYTES FS2-KIND9-BYTES FS2-LOCK-BYTES FS2-EF-BYTES))
(defn- mh-data-bytes [mode :string] :i64
  (if (string=? mode "amu-cli-host") 32768 DATA-BYTES))

;; The general build mode accepts an explicit extracted main offset. It is
;; bounded by the image size and the scoped FS2 output limit; admission and
;; signing of the produced executable are separate release decisions.
(defn- decimal-entry [s :string] :i64
  (let [n (string-length s)]
    (if (or (= n 0) (> n 8)) -1
      (loop [i 0 value 0]
        (if (= i n) value
          (let [digit (- (string-code-point-at s i) 48)]
            (if (or (< digit 0) (> digit 9)) -1
              (recur (+ i 1) (+ (* value 10) digit)))))))))

(defn- byte-at [v :vector-i64 at :i64 value :i64] :vector-i64
  (vector-assoc! v at (bit-and value 255)))

(defn- u32-at [v :vector-i64 at :i64 value :i64] :vector-i64
  (-> v
      (byte-at at value)
      (byte-at (+ at 1) (u64-shift-right value 8))
      (byte-at (+ at 2) (u64-shift-right value 16))
      (byte-at (+ at 3) (u64-shift-right value 24))))

(defn- u64-at [v :vector-i64 at :i64 value :i64] :vector-i64
  (-> v
      (u32-at at (bit-and value 4294967295))
      (u32-at (+ at 4) (u64-shift-right value 32))))

(defn- text-at [v :vector-i64 at :i64 text :string] :vector-i64
  (let [bytes (vector-i64-from-bytes (string-to-utf8 text))
        count (vector-count bytes)]
    (loop [index 0 out v]
      (if (= index count) out
        (recur (+ index 1) (byte-at out (+ at index) (vector-at bytes index)))))))

(defn- generated-at [v :vector-i64 at :i64 raw :vector-i64] :vector-i64
  (loop [i 0 out v]
    (if (= (+ i 5) (vector-count raw)) out
      (recur (+ i 1) (byte-at out (+ at i) (vector-at raw (+ i 5)))))))

(defn- words-at [v :vector-i64 at :i64 words :vector-i64] :vector-i64
  (loop [i 0 out v]
    (if (= i (vector-count words)) out
      (recur (inc i) (u32-at out (+ at (* i 4)) (vector-at words i))))))

(defn- adr8 [at :i64 target :i64] :i64
  (let [delta (- target at)]
    (bit-or 0x10000008
      (bit-or (i64-shift-left (bit-and delta 3) 29)
              (i64-shift-left (quot delta 4) 5)))))

(defn- b-direct [from :i64 target :i64] :i64
  (bit-or 0x14000000 (bit-and 0x03ffffff (quot (- target from) 4))))

(defn- bl-direct [from :i64 target :i64] :i64
  (bit-or 0x94000000 (bit-and 0x03ffffff (quot (- target from) 4))))

(defn- b-ne [from :i64 target :i64] :i64
  (bit-or 0x54000001 (i64-shift-left (- target from) 5)))

(defn- b-lo [from :i64 target :i64] :i64
  (bit-or 0x54000003 (i64-shift-left (- target from) 5)))

(defn- b-cs [from :i64 target :i64] :i64
  (bit-or 0x54000002 (i64-shift-left (- target from) 5)))

(defn- wrapper-prefix [text-bytes :i64] :vector-i64
  [(data-adrp text-bytes) 0xaa0703f3
   (bit-or 0x94000000 (quot (- CLI-RUNTIME-START 1032) 4))
   0xd2e00208 0xf9000668
   (adr8 1044 HELPER-START) 0xf9001e68
   0x91080268 0xf9009268
   ;; Darwin mmap(0, 512 MiB, PROT_READ|WRITE, MAP_PRIVATE|ANON, -1, 0).
   ;; SYS_mmap=197; x16=0x20000c5. Carry reports the syscall error.
   0xaa1f03e0 0xd2a40001 0xd2800062 0xd2820043 0x92800004
   0xaa1f03e5 0xd28018b0 0xf2a40010 0xd4001001 (b-cs 18 56)
   0xf9009660
   ;; A separate 32 MiB mark arena; all pages begin zeroed.
   0xaa1f03e0 0xd2a04001 0xd2800062 0xd2820043 0x92800004
   0xaa1f03e5 0xd28018b0 0xf2a40010 0xd4001001 (b-cs 29 56)
   0xf9009a60 0xaa1303e7])

(defn- full-compiler-raw? [raw-bytes :i64] :bool
  (or (= raw-bytes 3254848) (= raw-bytes 3250952)
      (= raw-bytes MAC-PACKAGER-RAW-BYTES)))

(defn- wrapper-suffix [raw-bytes :i64 mode :string entry-offset :i64 general :bool] :vector-i64
  (let [cli-image (or (full-compiler-raw? raw-bytes) general)]
  [
   (adr8 1152 TYPED-START) 0xf9004268
   (adr8 1160 POOL-EQUAL-START) 0xf9003a68
   (adr8 1168 CONCAT-START) 0xf9003e68
   (if (string=? mode "amu-program") 0xd2c01c08
     (if (or (string=? mode "fs2-cli-stdio") general) 0xd2c01d08
     (if (string=? mode "stdout") 0xd2c00408
     (if (string=? mode "stderr") 0xd2c01008
       (if (string=? mode "cli") 0xd2c00808
         (if (string=? mode "cli-stderr") 0xd2c01808 0xd2800008)))))) 0xf9000a68
   (adr8 1184 RAW-START) 0xf900c268
   (bit-or 0xd2800008 (i64-shift-left (bit-and raw-bytes 65535) 5))
   (bit-or 0xf2a00008 (i64-shift-left (u64-shift-right raw-bytes 16) 5))
   0xf900c668
   ;; The pure helper setup installs four additional ABI callbacks and then
   ;; invokes the existing bounded pool setup at 2048.
   (bl-direct 1204 (if (string=? mode "amu-cli-host") (mh-extra-start raw-bytes) SLICE-SETUP-START))
   (bl-direct 1208 (+ RAW-START entry-offset))
   ;; The full compiler is a CLI: propagate its actual exit status after
   ;; check/compile. Short fixed fixtures keep their expected-result check.
   (if (amu-program-mode? mode) (b-direct 1212 (mh-extra-start raw-bytes))
     (if cli-image 0xd2800030 0xf100a81f))
   (if cli-image 0xf2a40010 (b-ne 48 56))
   ;; Earlier string fixtures require a pair; vector fixtures instead prove
   ;; that at least one checked vector handle was minted.
   (if cli-image 0xd4001001
     (if (or (= raw-bytes 340) (= raw-bytes 124)
             (= raw-bytes 700) (= raw-bytes 220)
             (= raw-bytes 714) (= raw-bytes 200)) 0xf95f4668 0xf9410268))
   (if cli-image 0xd4200000 0xf100051f)
   (if cli-image 0xd503201f (b-lo 51 56))
   (if cli-image 0xd503201f 0xd2800540)
   0xd2800030 0xf2a40010 0xd4001001 0xd4200000]))

;; The wrapper's setup stub preserves LR, runs the existing pure helper
;; installer, then installs the bytes-slice callback in runtime slot 368.
;; JUN-546: the generated code calls context ABI slots 224 and 232, the scalar
;; arena-scope enter and leave routines (docs/native-source-lock-and-scalar-scopes.md).
;; Slot 224 pushes the runtime's four allocator counters on a bounded LIFO and
;; slot 232 pops them, mirroring seed/76-x86_64-static-rt.kotoba: depth 256, a
;; context tag check, and every saved counter validated against the live one
;; before any restore. Any failure goes to the refusal below, which writes
;; REFUSE-MSG to stderr and exits 70, the status the Linux runtimes use for a
;; scope failure. Linux saves pairs, pool, vector handles and vector items; here
;; those are the pair count behind ctx+0x120, the pool use at ctx+0x198, the
;; vector handle count at ctx+0x3e88 and the vector item use at ctx+0x3e98. The
;; LIFO is ctx+0x1000 (depth) and ctx+0x1010 + 32*depth (four words per entry),
;; DATA space no other routine of this image touches. Leave also zeroes the
;; vector items it releases, because the Mac item arena is a bump allocator that
;; assumes everything above its use is zero (the Linux runtime zeroes up to a
;; high-water mark at allocation instead). The routines clobber only x8-x15.
(defn- slice-setup-words [] :vector-i64
  [0xa9bf7bfd
   (bl-direct (+ SLICE-SETUP-START 4) PURE-RUNTIME-START)
   (adr8 (+ SLICE-SETUP-START 8) BYTES-SLICE-START)
   0xf900ba68
   (adr8 (+ SLICE-SETUP-START 16) SCOPE-START)
   0xf9007268
   (adr8 (+ SLICE-SETUP-START 24) SCOPE-LEAVE-START)
   0xf9007668
   (b-direct (+ SLICE-SETUP-START 32) KG-START)
   0xd503201f])

;; JUN-707 / JUN-710: the generated code calls context ABI slots 80/88 (the
;; public keyword graph behind __r6-kgput / __r6-kgget) and 96/104 (the private
;; keyword intern rows behind keyword-from-string, document-keyword-value and
;; every other prelude path through __r6-kwreg); seed/77 and
;; seed/73-keyword-intern.kotoba are the Linux runtimes. The wrapper installed
;; none of them, so those calls landed on address 0 (SIGSEGV, exit 139). The
;; setup stub above now branches here to install all four before returning.
;; Both tables share one put and one get, parameterized by the table's context
;; offset (x15: base at ctx+x15, count at ctx+x15+8) and row limit (x14): the
;; graph is ctx+1760, 4096 rows; the intern rows ctx+1800, 262144 rows -- the
;; Linux G+736/G+744 and G+776/G+784. Put appends (entity, attribute, value)
;; rows to a private anonymous mapping of limit*24 bytes made on first use,
;; outside every arena, so arena-scope rollback never changes either table and
;; the two never share rows. Get returns the newest matching value or
;; INT64_MIN. A wrong context tag, a failed mapping or a full table writes
;; KG-MSG to stderr and exits 70. The routines clobber only x8-x16, and x16 (the
;; syscall number) is saved and restored around the mapping.
;; The 89 words were derived once with the system assembler and checked against
;; it; no assembler is in the build. Everything is PC-relative inside this
;; block except word 79, the refusal's adr of KG-MSG, which the layout below
;; patches (adr-x1). KG-START sits in the free span after the CLI helper
;; (3716..4096) and KG-MSG-START in the one before the vector runtime
;; (4940..5000), in every mode.
(defn- kg-words [] :vector-i64
  [0x10000148 0xf9002a68 0x100001c8 0xf9002e68 0x10000128 0xf9003268 0x10000188 0xf9003668
   0xa8c17bfd 0xd65f03c0 0xd280dc0f 0xd282000e 0x1400001a 0xd280e10f 0xd2a0008e 0x14000017
   0xd280dc0f 0x14000002 0xd280e10f 0xf9400008 0xf1002d1f 0x54000721 0x8b0f000d 0xf94001a9
   0xf94005aa 0xb400012a 0xd100054a 0x8b0a054c 0x8b0c0d2c 0xa9402d88 0xeb01011f 0xfa420160
   0x54000080 0xb5ffff2a 0xd2f00000 0xd65f03c0 0xf9400980 0xd65f03c0 0xf9400008 0xf1002d1f
   0x540004c1 0x8b0f000d 0xf94001a9 0xb5000309 0xa9bc07e0 0xa9010fe2 0xa90217e4 0xa90337f0
   0x8b0e05c1 0xd37df021 0xd2800000 0xd2800062 0xd2820043 0x92800004 0xd2800005 0xd28018b0
   0xf2a40010 0xd4001001 0x9a9f37e8 0xaa0003e9 0xa94337f0 0xa94217e4 0xa9410fe2 0xa8c407e0
   0xb50001c8 0xb40001a9 0xf90001a9 0xf94005aa 0xeb0e015f 0x54000122 0x8b0a054c 0x8b0c0d2c
   0xa9000981 0xf9000983 0x9100054a 0xf90005aa 0xd2800020 0xd65f03c0 0xd2800040 0x10ffffe1
   0xd2800522 0xd2800090 0xf2a40010 0xd4001001 0xd28008c0 0xd2800030 0xf2a40010 0xd4001001
   0xd4200000])

;; adr x1, target (adr8's encoding with Rd = 1 instead of 8)
(defn- adr-x1 [at :i64 target :i64] :i64
  (bit-or (- (adr8 at target) 8) 1))

;; Enter (20 words) then leave (41 words), assembled once with the system
;; assembler against a failure target at REFUSE-START; no assembler is in the build.
;; The conditional branches to the refusal are position bound: SCOPE-START minus
;; REFUSE-START is 456 bytes, and moving either constant requires re-deriving them.
(defn- scope-words [] :vector-i64
  [0xf9400008 0xf1002d1f 0x54fff181 0x9140040f 0xf94001e9 0xf104013f 0x54fff102 0x910041ea
   0x8b09154a 0xf940900b 0xf940016b 0xf940cc0c 0xf95f440d 0xf95f4c0e 0xa900314b 0xa901394d
   0x91000529 0xf90001e9 0xd2800000 0xd65f03c0
   0xf9400008 0xf1002d1f 0x54ffef01 0x9140040f 0xf94001e9 0xb4ffeea9 0xf104013f 0x54ffee68
   0xd1000529 0x910041ea 0x8b09154a 0xa940314b 0xa941394d 0xf9409008 0xf9400108 0xeb08017f
   0x54ffed48 0xf940cc08 0xeb08019f 0x54ffece8 0xf95f4408 0xeb0801bf 0x54ffec88 0xf95f4c08
   0xeb0801df 0x54ffec28 0xf95f480a 0x8b0e0d4a 0xcb0e0108 0xb4000088 0xf800855f 0xd1000508
   0x17fffffd 0xf9409008 0xf900010b 0xf900cc0c 0xf91f440d 0xf91f4c0e 0xf90001e9 0xd2800000
   0xd65f03c0])

;; write(2, REFUSE-MSG, length) then exit(70); the words were derived once with
;; the system assembler and checked against it, and no assembler is in the build.
(defn- refuse-words [] :vector-i64
  [0xd2800040
   (adr8 (+ REFUSE-START 4) REFUSE-MSG-START)
   0xaa0803e1
   (bit-or 0xd2800002 (i64-shift-left (string-length REFUSE-MSG) 5))
   0xd2800090 0xf2a40010 0xd4001001
   0xd28008c0
   0xd2800030 0xf2a40010 0xd4001001
   0xd4200000])

;; pair_new(ctx, offset, byte_length): 1-based handle. The context contains
;; a count pointer at +288, mmap pair base at +296, and mark base at +304.
;; The full runtime's 33,554,432-pair bound traps before any write.
(defn- pair-helper-words [] :vector-i64
  [0xf9409008 0xf9400109 0xd2a0400a 0xeb0a013f 0x54000043 0xd4200000
   0xf940940a 0x8b09114a 0xf9000141 0xf9000542
   0xf940980b 0x8b09016b 0x3900017f
   0x91000529 0xf9000109 0xaa0903e0 0xd65f03c0])

;; The inherited typed helper handles the earlier wire 37 output diagnostic;
;; wire 38 is dispatched by cli-helper-words below. The wire-37 grant
;; is checked as a bit because the full compiler also needs FS2 and CLI.
;; Other wires trap.
;; These fixed AArch64 words are the reviewed diagnostic control's text,
;; now emitted as Kotoba data. The Mac assembler is not in the build path.
(defn- typed-helper-words [] :vector-i64
  [0xf100983f 0x540005a0 0xf100943f 0x540006c1
   0xf100045f 0x54000681 0xf100047f 0x54000641
   0xf9400808 0xd2c00409 0xea09011f 0x540005c0
   0xb40005a4 0xf9409008 0xf9400109 0xeb09009f
   0x54000528 0xf9409408 0xd1000484 0x8b041108
   0xf9400109 0xf940050a 0xf101015f 0x54000448
   0xb7f80429 0xf940c40b 0xeb0b013f 0x540003c8
   0xcb09016b 0xeb0b015f 0x54000368 0xf940c00b
   0x8b090161 0xaa0a03e2 0xa9bf7bf3 0xaa0a03f3
   0xd2800020 0xd2800090 0xf2a40010 0xd4001001
   0x54000222 0xeb13001f 0x540001e1 0xd2800000
   0xa8c17bf3 0xd65f03c0 0xf100045f 0x54000141
   0xf100047f 0x54000101 0xf81f0ffe 0xd2800001
   0xd2800002 0xf9401c10 0xd63f0200 0xf84107fe
   0xd65f03c0 0xd4200020])

;; Reviewed AArch64 pool setup, bounded span resolver, concat and equal.
;; The assembler was used once to derive these words; final packaging uses
;; this Kotoba source and the Amu native compiler.
(defn- append-runtime-words [out :vector-i64 start :i64 words :vector-i64] :vector-i64
  (loop [i 0 next out]
    (if (= i (vector-count words)) next
      (recur (+ i 1) (vector-assoc! next (+ start i) (vector-at words i))))))

(defn- runtime-helper-words [] :vector-i64
  (-> (vector-alloc 181)
      (append-runtime-words 0 [
       0xaa1f03e0 0xd2a20001 0xd2800062 0xd2820043 0x92800004 0xaa1f03e5
       0xd28018b0 0xf2a40010 0xd4001001 0x54001562 0xf900ca60 0xf900ce7f
       0xd65f03c0 0xb7f814e2 0xb7f80141 0xf940c408 0xeb08003f 0x54001468
       0xcb010108 0xeb08005f 0x54001408 0xf940c008 0x8b010100 0xd65f03c0
       0xaa2103e9 0xf940cc08 0xeb08013f 0x54001328 0xcb090108 0xeb08005f
