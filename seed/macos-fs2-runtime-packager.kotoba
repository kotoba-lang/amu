    (mh-label 75) (mh-b (bit-or 0x10000000 8) 111) (mh-str 8 23 768)
    (mh-b (bit-or 0x10000000 8) 112) (mh-str 8 23 776)
    (mh-imm 8 2097152) (mh-ar 27 23 8 0) (mh-str 27 23 784) (mh-str 31 23 792)
