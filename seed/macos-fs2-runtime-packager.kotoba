    (mh-sys 20) (mh-mov 28 0) (mh-mov 1 28) (mh-imm 0 2)
    (mh-imm 2 1) (mh-imm 3 0) (mh-imm 4 0) (mh-imm 5 0)
    (mh-sys 336) (mh-b 0x54000002 89)
    (mh-imm 8 1048576) (mh-cmp 0 8) (mh-b 0x54000008 89)
    (mh-mov 5 0) (mh-mov 1 28) (mh-imm 0 2) (mh-imm 2 1)
    (mh-imm 3 0) (mh-add 4 23 4095) (mh-add 4 4 1)
    (mh-sys 336) (mh-b 0x54000002 89) (mh-mov 26 0) (mh-imm 27 0)
