(ns amu.main
  {:kotoba/export [main]}
  (:require [amu.cli :as cli]
            [amu.check :as check]
            [amu.compile :as compile]
            [amu.refactor :as refactor]
            [seed.main :as seed]))

;; seed/frontsrc/amu/main.kotoba -- seed/amu-main/src/amu/main.kotoba (agent MAINS) plus the three build commands an amu
;; image needs to rebuild ITSELF with no seed binary beside it (agent FRONTSRC, 2026-10-04): `link`, `modules` and
;; `extract-native` go to the seed driver linked into the image (seed.main reads argv itself, as amu.compile's call does).
;; Requested for seed/amu-main/src/amu/main.kotoba in seed/CONTRACT-REQUESTS.md (2026-10-04 FRONTSRC); until it is
;; adopted, scripts/seed/frontsrc/build-one-src.sh builds amu-one-src with this entry (labelled in amu-one-src.info).
;; These names are not stage-0 commands: stage-0 answers them with its usage refusal (64); everything else is unchanged.
;;
;;   amu check <file> ..          -> amu.check/run      (stage-0 `amu check`)
;;   amu compile <file> --target aarch64-macos --output X ..
;;                                -> amu.compile/run    (stage-0 `amu compile`)
;;   amu refactor <sub> ..        -> amu.refactor/run   (bin/amu -> nbb refactor_cli)
;;   amu link | modules | extract-native ..  -> seed.main (the seed driver's own commands, BUILD use)
;;   anything else                -> stage-0's usage refusal, exit 64

(defn main [] :i64
  (if (< (cli/argc) 1)
    (cli/usage-error ":kotoba/invalid-usage" "unknown or missing kotoba command" ", :details {:phase :usage}")
    (let [c (cli/arg 0)]
      (cond (string=? c "check") (check/run)
            (string=? c "compile") (compile/run)
            (string=? c "refactor") (refactor/run)
            (string=? c "link") (seed/main)
            (string=? c "modules") (seed/main)
            (string=? c "extract-native") (seed/main)
            :else (cli/usage-error ":kotoba/invalid-usage" "unknown or missing kotoba command" ", :details {:phase :usage}")))))
