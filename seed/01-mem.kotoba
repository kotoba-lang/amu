;; seed/01-mem.kotoba -- memory model of the seed compiler (prefix mem-). Owner: module 01-mem.
;; Contract: seed/MEMORY-MAP (heap M, header slots, return registers, rules L1-L13), seed/HEADS (the 41 heads: this
;; file uses nothing else, so the seed can compile it). Design: docs/selfhost-seed-design-20261002.md 2.1/2.3.
;;
;; Conventions (MEMORY-MAP rules):
;;   * Writers take M0 first and RETURN the new handle (L1). A writer that also yields an i64 stores it in
;;     M[MM-R0] and the caller reads it right after the call (L4). Readers take M and return :i64 (L2).
;;   * Every function is defn- (L3), at most 5 parameters (L7), no `do`, no shadowing (L6).
;;   * Failures: mem-fail stores the code in MM-ERR only while it is 0 (first writer wins), MM-ERR-POS = -1,
;;     returns M; the caller of a failed writer must look at MM-ERR (L10). A failed mem-alloc returns R0 = 240
;;     (scratch words M[240..255], reserved here), R1 = 0 and the other 01-mem writers then write only into the scratch
;;     area (no trap): the error is reported by the driver after the phase, like every other module's.
;;   * Heap words: mem-alloc hands out blocks of MM-HEAP-BASE..MM-HEAP-END-1 by bumping MM-HEAP-TOP. Nothing is
;;     ever freed (no collector, design 2.1). Fresh words are zero (vector-alloc zero fills; blocks are never reused).
;;
;; API (all names top-level, all private):
;;   mem-set M i x                -> M            vector-assoc! for handles returned by calls (see the note above it)
;;   mem-new                      -> M            the heap: version, fill counters, heap top
;;   mem-fail M code              -> M            record an error (first wins)
;;   mem-alloc M words            -> M, R0=addr R1=ok   bump allocation, E-HEAP-FULL when out of words (R0=240, R1=0)
;;   mem-fill M dst n v           -> M            M[dst..dst+n) = v
;;   mem-copy M dst src n         -> M            memmove inside M (overlap safe)
;;   mem-put-bytes M S a b dst    -> M            M[dst+k] = byte (a+k) of S for a <= a+k < b (one byte per word)
;;   mem-sel f a b                -> i64          a when f /= 0 else b (value selection: the only branching on handle paths)
;;   mem-keep M                   -> M            identity that is a write (loop base case)
;;   mem-vec-new M cap            -> M, R0=h      growable i64 array (header of 3 words in the heap)
;;   mem-vec-push M h x           -> M            append, doubling the data block when full (old block is wasted)
;;   mem-vec-len M h / mem-vec-at M h i / mem-vec-set M h i x   (at/set are unchecked beyond len)
;;   mem-hash-str S a b           -> i64          FNV-1a 64 over bytes a..b-1 of S (signed i64, wraps)
;;   mem-hash-words M addr n      -> i64          the same over n words holding one byte each
;;   mem-span-eq S a b n          -> 1/0          bytes a..a+n-1 of S equal bytes b..b+n-1
;;   mem-words-eq M a b n         -> 1/0          the same over words of M
;;   mem-slot h cap               -> i64          hash to table slot: (bit-and h (- cap 1)); cap a power of two
;;   mem-u2dec n                  -> :string      signed decimal text (also MIN); named u2dec in the design
;;   mem-parse-dec S a b          -> i64          decimal of bytes a..b-1, or -1 when empty/non-digit
;;   mem-ceil-pow2 n              -> i64          least power of two >= n (n >= 1)

;; ------------------------------------------------------------------------------------------------------------
;; STAGE-0 LINEARITY DISCIPLINE (measured 2026-10-02 against build/native-image/amu-native; every rule below was
;; found by a one-line probe, see seed/CONTRACT-REQUESTS.md). The handle M is linear and the checker is far stricter
;; than "use once":
;;   H1  vector-assoc! directly on a handle that came out of a user-function call is refused; write it with mem-set.
;;   H2  `if`/`cond` ONLY in tail position, and never and/or/not: both answer 'internal compiler error'.
;;   H3  Do not branch on the handle. Arms of one if/cond that carry the handle are accepted only when they are the
;;       same kind of thing (measured: (if c (mem-set M ..) (mem-set M ..)) is refused, mixing calls with direct
;;       vector-assoc! is refused). Handle code is therefore STRAIGHT-LINE: decisions are taken on i64 values with
;;       the helper mem-sel (value selection), and the handle is written unconditionally.
;;   H4  A loop (self-recursive writer) ends in (mem-keep M0), a call that writes, never in a bare M0: a bare
;;       return makes its result an alias of its argument and the next call on that result is refused.
;;   H5  Read M BEFORE handing it on (a let initializer `(vector-at M ..)`), never inside the argument list of the
;;       call that consumes M.
;;   Consequence for failures: mem-alloc cannot return early. On failure it records E-HEAP-FULL (first error wins),
;;   returns the handle unchanged, sets R0 = 240 (a 16-word scratch area M[240..255], reserved for this) and
;;   R1 = 0. R1 = 1 on success. Callers look at MM-ERR (rule L10) before they use what they allocated.
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-sel [f :i64 a :i64 b :i64] :i64 (if (= f 0) b a))

;; mem-set: write for a handle that came out of a call (H1)
(defn- mem-set [M0 :vector-i64 i :i64 x :i64] :vector-i64
  (vector-assoc! M0 i x))

;; identity on M that is a WRITE (stores the constant layout version, already there): the base case of loops (H4)
(defn- mem-keep [M0 :vector-i64] :vector-i64
  (vector-assoc! M0 MM-VERSION MM-LAYOUT-VERSION))

;; ------------------------------------------------------------------------------------------------------------
;; errors. R0 = 0 afterwards.
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-fail [M0 :vector-i64 code :i64] :vector-i64
  (let [e (vector-at M0 MM-ERR)
        p (vector-at M0 MM-ERR-POS)]
    (vector-assoc! (vector-assoc! (vector-assoc! M0 MM-R0 0) MM-ERR (mem-sel e e code)) MM-ERR-POS (mem-sel e p -1))))

;; ------------------------------------------------------------------------------------------------------------
;; the heap
;; ------------------------------------------------------------------------------------------------------------
;; every fill counter M[MM-TOK-N .. MM-OUT-N] starts at 1 (index 0 of each table is the null record)
(defn- mem-init-fills [M0 :vector-i64 i :i64] :vector-i64
  (if (> i MM-OUT-N)
    (mem-keep M0)
    (mem-init-fills (vector-assoc! M0 i 1) (+ i 1))))

(defn- mem-new [] :vector-i64
  (let [M0 (vector-alloc MM-WORDS)
        M1 (vector-assoc! M0 MM-VERSION MM-LAYOUT-VERSION)
        M2 (mem-init-fills M1 MM-TOK-N)
        M3 (mem-set M2 MM-HASH-N 0)
        M4 (mem-set M3 MM-HEAP-TOP MM-HEAP-BASE)]
    (mem-set M4 MM-ERR-POS -1)))

;; 1 when a block of `words` words fits at top (end = top + words), else 0
(defn- mem-fits [top :i64 end :i64 words :i64] :i64
  (cond (< words 0) 0
        (< end top) 0
        (> end MM-HEAP-END) 0
        :else 1))

;; the error words after an allocation: ok = 1 leaves them, ok = 0 sets E-HEAP-FULL / pos -1 if no error is recorded
(defn- mem-alloc-fin [M0 :vector-i64 ok :i64 newtop :i64 r0 :i64] :vector-i64
  (let [e (vector-at M0 MM-ERR)
        p (vector-at M0 MM-ERR-POS)
        e1 (mem-sel e e E-HEAP-FULL)
        p1 (mem-sel e p -1)]
    (vector-assoc! (vector-assoc! (vector-assoc! (vector-assoc! (vector-assoc! M0 MM-HEAP-TOP newtop) MM-R0 r0) MM-R1 ok)
                                  MM-ERR (mem-sel ok e e1))
                   MM-ERR-POS (mem-sel ok p p1))))

;; R0 = first word of the block (240 on failure), R1 = 1 / 0
(defn- mem-alloc [M0 :vector-i64 words :i64] :vector-i64
  (let [top (vector-at M0 MM-HEAP-TOP)
        end (+ top words)
        ok (mem-fits top end words)]
    (mem-alloc-fin M0 ok (mem-sel ok end top) (mem-sel ok top 240))))

;; ------------------------------------------------------------------------------------------------------------
;; word and byte helpers
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-fill [M0 :vector-i64 dst :i64 n :i64 v :i64] :vector-i64
  (if (<= n 0)
    (mem-keep M0)
    (mem-fill (vector-assoc! M0 dst v) (+ dst 1) (- n 1) v)))

;; one loop for both directions: a = current source index, step = +1 or -1, delta = dst - src
(defn- mem-copy-run [M0 :vector-i64 a :i64 last :i64 step :i64 delta :i64] :vector-i64
  (if (= a last)
    (mem-keep M0)
    (let [x (vector-at M0 a)
          M1 (vector-assoc! M0 (+ a delta) x)]
      (mem-copy-run M1 (+ a step) last step delta))))

;; direction 1 = ascending (dst < src or equal), 0 = descending
(defn- mem-pos [n :i64] :i64 (if (< n 0) 0 n))

(defn- mem-up [dst :i64 src :i64] :i64 (if (> dst src) 0 1))

;; memmove inside M, overlap safe
(defn- mem-copy [M0 :vector-i64 dst :i64 src :i64 n :i64] :vector-i64
  (let [m (mem-pos n)
        up (mem-up dst src)]
    (mem-copy-run M0 (mem-sel up src (+ src (- m 1))) (mem-sel up (+ src m) (- src 1)) (mem-sel up 1 -1) (- dst src))))

;; bytes a .. b-1 of S into M[dst ...], one byte per word. delta = dst - a.
(defn- mem-put-run [M0 :vector-i64 S :string i :i64 end :i64 delta :i64] :vector-i64
  (if (>= i end)
    (mem-keep M0)
    (let [c (string-code-point-at S i)
          M1 (vector-assoc! M0 (+ i delta) c)]
      (mem-put-run M1 S (+ i 1) end delta))))

(defn- mem-put-bytes [M0 :vector-i64 S :string a :i64 b :i64 dst :i64] :vector-i64
  (mem-put-run M0 S a b (- dst a)))

;; ------------------------------------------------------------------------------------------------------------
;; growable arrays in the heap. Handle h = heap address of a 3-word header: [len, cap, data address].
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-vec-len [M :vector-i64 h :i64] :i64 (vector-at M h))
(defn- mem-vec-cap [M :vector-i64 h :i64] :i64 (vector-at M (+ h 1)))
(defn- mem-vec-at [M :vector-i64 h :i64 i :i64] :i64 (vector-at M (+ (vector-at M (+ h 2)) i)))

(defn- mem-vec-set [M0 :vector-i64 h :i64 i :i64 x :i64] :vector-i64
  (let [d (vector-at M0 (+ h 2))]
    (vector-assoc! M0 (+ d i) x)))

(defn- mem-max1 [n :i64] :i64 (if (< n 1) 1 n))

(defn- mem-vec-new2 [M2 :vector-i64 h :i64 cap :i64] :vector-i64
  (let [d (vector-at M2 MM-R0)]
    (vector-assoc! (vector-assoc! (vector-assoc! (vector-assoc! M2 h 0) (+ h 1) cap) (+ h 2) d) MM-R0 h)))

;; R0 = header address (240 after an allocation failure: look at MM-ERR)
(defn- mem-vec-new [M0 :vector-i64 cap :i64] :vector-i64
  (let [c (mem-max1 cap)
        M1 (mem-alloc M0 3)
        h (vector-at M1 MM-R0)]
    (mem-vec-new2 (mem-alloc M1 c) h c)))

;; make room for one more item: when len = cap, move the data to a block of twice the capacity (the old block is
;; left behind). Straight-line: need = 1/0 scales the allocation, the copy count and the header update.
(defn- mem-need [len :i64 cap :i64] :i64 (if (< len cap) 0 1))

(defn- mem-vec-grow2 [M1 :vector-i64 h :i64 n :i64 old :i64 newcap :i64] :vector-i64
  (let [d (vector-at M1 MM-R0)
        ok (vector-at M1 MM-R1)
        take (* n ok)
        len (vector-at M1 h)
        cap (vector-at M1 (+ h 1))]
    (mem-vec-grow3 (mem-copy M1 d old (* take len)) h (mem-sel (* n ok) newcap cap) (mem-sel (* n ok) d old))))

(defn- mem-vec-grow3 [M2 :vector-i64 h :i64 cap :i64 d :i64] :vector-i64
  (mem-set (mem-set M2 (+ h 1) cap) (+ h 2) d))

(defn- mem-vec-grow [M0 :vector-i64 h :i64] :vector-i64
  (let [len (vector-at M0 h)
        cap (vector-at M0 (+ h 1))
        old (vector-at M0 (+ h 2))
        need (mem-need len cap)]
    (mem-vec-grow2 (mem-alloc M0 (* need (* cap 2))) h need old (* cap 2))))

;; store x at the end; while an error is recorded the store goes to the scratch area instead
(defn- mem-vec-store [M0 :vector-i64 h :i64 x :i64] :vector-i64
  (let [len (vector-at M0 h)
        d (vector-at M0 (+ h 2))
        e (vector-at M0 MM-ERR)
        at (mem-sel e 245 (+ d len))
        M1 (vector-assoc! M0 at x)]
    (vector-assoc! M1 h (+ len (mem-sel e 0 1)))))

(defn- mem-vec-push [M0 :vector-i64 h :i64 x :i64] :vector-i64
  (mem-vec-store (mem-vec-grow M0 h) h x))

;; ------------------------------------------------------------------------------------------------------------
;; hashing and comparison. FNV-1a 64: h = 14695981039346656037 (as signed -3750763034362895579); for each
;; byte h = (h xor byte) * 1099511628211, wrapping. Deterministic, no tables (rule L11).
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-hash-run [S :string i :i64 end :i64 h :i64] :i64
  (if (>= i end)
    h
    (mem-hash-run S (+ i 1) end (* (bit-xor h (string-code-point-at S i)) 1099511628211))))

(defn- mem-hash-str [S :string a :i64 b :i64] :i64
  (mem-hash-run S a b -3750763034362895579))

(defn- mem-hash-wrun [M :vector-i64 i :i64 end :i64 h :i64] :i64
  (if (>= i end)
    h
    (mem-hash-wrun M (+ i 1) end (* (bit-xor h (bit-and (vector-at M i) 255)) 1099511628211))))

(defn- mem-hash-words [M :vector-i64 addr :i64 n :i64] :i64
  (mem-hash-wrun M addr (+ addr n) -3750763034362895579))

(defn- mem-slot [h :i64 cap :i64] :i64 (bit-and h (- cap 1)))

(defn- mem-span-eq-run [S :string a :i64 b :i64 n :i64] :i64
  (cond
    (<= n 0) 1
    (= (string-code-point-at S a) (string-code-point-at S b)) (mem-span-eq-run S (+ a 1) (+ b 1) (- n 1))
    :else 0))

(defn- mem-span-eq [S :string a :i64 b :i64 n :i64] :i64 (mem-span-eq-run S a b n))

(defn- mem-words-eq-run [M :vector-i64 a :i64 b :i64 n :i64] :i64
  (cond
    (<= n 0) 1
    (= (vector-at M a) (vector-at M b)) (mem-words-eq-run M (+ a 1) (+ b 1) (- n 1))
    :else 0))

(defn- mem-words-eq [M :vector-i64 a :i64 b :i64 n :i64] :i64 (mem-words-eq-run M a b n))

(defn- mem-ceil-pow2-run [p :i64 n :i64] :i64
  (if (>= p n) p (mem-ceil-pow2-run (* p 2) n)))

(defn- mem-ceil-pow2 [n :i64] :i64 (mem-ceil-pow2-run 1 n))

;; ------------------------------------------------------------------------------------------------------------
;; decimal
;; ------------------------------------------------------------------------------------------------------------
(defn- mem-digit [d :i64] :string
  (cond (= d 0) "0" (= d 1) "1" (= d 2) "2" (= d 3) "3" (= d 4) "4"
        (= d 5) "5" (= d 6) "6" (= d 7) "7" (= d 8) "8" :else "9"))

;; prints |n| for n <= 0 (so that MIN needs no negation of itself): quot truncates toward 0, the remainder
;; n - 10*q is in -9..0
(defn- mem-dec-neg [n :i64] :string
  (let [q (quot n 10)
        d (- 0 (- n (* q 10)))]
    (if (= q 0)
      (mem-digit d)
      (string-concat (mem-dec-neg q) (mem-digit d)))))

(defn- mem-u2dec [n :i64] :string
  (if (< n 0)
    (string-concat "-" (mem-dec-neg n))
    (mem-dec-neg (- 0 n))))

(defn- mem-parse-run [S :string i :i64 end :i64 acc :i64] :i64
  (if (>= i end)
    acc
    (let [c (string-code-point-at S i)]
      (cond
        (< c 48) -1
        (> c 57) -1
        :else (mem-parse-run S (+ i 1) end (+ (* acc 10) (- c 48)))))))

(defn- mem-parse-dec [S :string a :i64 b :i64] :i64
  (if (>= a b) -1 (mem-parse-run S a b 0)))
