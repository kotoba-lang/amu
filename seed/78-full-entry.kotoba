;; seed/78-full-entry.kotoba -- the entry of the combined compiler (seed/FULL-MANIFEST, JUN-331): the adopted core
;; (ADR 0370) plus the loaderless Linux targets in one image. An explicit --target aarch64-linux, x86_64-linux,
;; x86_64-aiueos-kernel-v1, x86_64-aiueos-user-v1/v2, wasm32-browser or js-browser goes to its emitter; `definition-cids` goes to the
;; native definition-identity layer (04-09); every other command (check, the core's aarch64-macos compile, project
;; compile, extract-native, compile-kir) is the core driver, unchanged.
(defn- full-target? [t :string] :i64
  (if (and (>= (io-argc) 4) (string=? (io-arg 0) "compile") (string=? (io-arg 2) "--target") (string=? (io-arg 3) t)) 1 0))
;; The public entry must never silently ignore an unsupported lock, profile,
;; seal or format. The original core driver remains unchanged; this boundary
;; checks every flag before dispatching to it or a native emitter.
(defn- full-native? [] :bool
  (or (= (full-target? "aarch64-linux") 1) (= (full-target? "x86_64-linux") 1)
      (= (full-target? "x86_64-aiueos-kernel-v1") 1)
      (= (full-target? "x86_64-aiueos-kernel-v2") 1)
      (= (full-target? "x86_64-aiueos-kernel-v3") 1)
      (= (full-target? "x86_64-aiueos-user-v1") 1)
      (= (full-target? "x86_64-aiueos-user-v2") 1)
      (= (full-target? "x86_64-aiueos-user-v3") 1)
      (= (full-target? "x86_64-aiueos-user-v4") 1)
      (= (full-target? "x86_64-aiueos-user-v5") 1)
      (= (full-target? "x86_64-aiueos-user-plc-v1") 1)))
(defn- full-value-flag? [flag :string] :bool
  (let [command (io-arg 0) module (= (drv-pj-has 1 (io-argc) "--emit-module") 1)]
    (cond (full-native?)
          (or (string=? flag "--target") (string=? flag "--output") (string=? flag "--format")
              (string=? flag "--payload") (string=? flag "--fuel")
              (and (or (= (full-target? "x86_64-linux") 1) (= (full-target? "aarch64-linux") 1))
                   (string=? flag "--runtime-profile"))
              ;; KOTOBA-175 (ADR 0402): the declared capability set of the PLC user target
              (and (= (full-target? "x86_64-aiueos-user-plc-v1") 1) (string=? flag "--capabilities"))
              (and (or (= (full-target? "x86_64-aiueos-kernel-v1") 1)
                       (= (full-target? "x86_64-aiueos-kernel-v2") 1)
                       (= (full-target? "x86_64-aiueos-kernel-v3") 1))
                   (string=? flag "--artifact"))
              (and (or (= (full-target? "x86_64-aiueos-kernel-v1") 1)
                       (= (full-target? "x86_64-aiueos-kernel-v2") 1)
                       (= (full-target? "x86_64-aiueos-kernel-v3") 1)
                       (= (full-target? "x86_64-linux") 1))
                   (or (string=? flag "--source-path") (string=? flag "--source-lock")
                       (string=? flag "--source-lock-sha256"))))
          (or (string=? command "compile") (string=? command "check"))
          (or (string=? flag "--source-path") (string=? flag "--source-lock") (string=? flag "--source-lock-sha256")
              (string=? flag "--policy")
              (and (string=? command "compile") (or (string=? flag "--target") (string=? flag "--output")
                   (and module (string=? flag "--object-dir")))))
          (string=? command "extract-native") (or (string=? flag "--symbol") (string=? flag "--output"))
          (string=? command "bench-build") (string=? flag "--runtime-profile")
          (string=? command "compile-kir") (or (string=? flag "--output") (and module (string=? flag "--ns")))
          (string=? command "link") (or (string=? flag "--object-dir") (string=? flag "--output"))
          (string=? command "modules") (string=? flag "--source-path")
          (string=? command "package-aiueos-boot") (or (string=? flag "--output") (string=? flag "--payload") (string=? flag "--font") (string=? flag "--user-slot") (string=? flag "--pci-resources") (string=? flag "--netlog") (string=? flag "--watchdog") (string=? flag "--install"))
          (string=? command "package-aiueos-user-payload") (or (string=? flag "--output") (string=? flag "--version"))
          :else false)))
(defn- full-word-flag? [flag :string] :bool
  (let [command (io-arg 0) module (= (drv-pj-has 1 (io-argc) "--emit-module") 1)]
    (or (string=? flag "--unpinned")
        (and (string=? command "compile") (string=? flag "--no-crypto-hw"))
        (and (or (string=? command "compile") (string=? command "compile-kir")) (string=? flag "--emit-module"))
        (and (string=? command "compile") module (string=? flag "--entry"))
        (and (string=? command "compile-kir") (not module) (string=? flag "--metered")))))
(defn- full-seen? [flag :string stop :i64] :bool
  (loop [index 1]
    (cond (>= index stop) false (string=? (io-arg index) flag) true
          (full-value-flag? (io-arg index)) (recur (+ index 2))
          :else (recur (+ index 1)))))
(defn- full-is-flag? [word :string] :bool
  (and (>= (string-length word) 2) (= (string-code-point-at word 0) 45) (= (string-code-point-at word 1) 45)))
(defn- full-argv-ok? [index :i64] :bool
  (if (>= index (io-argc)) true
    (let [word (io-arg index)]
      (cond (full-value-flag? word)
            (and (or (string=? word "--source-path") (not (full-seen? word index)))
                 (< (+ index 1) (io-argc)) (> (string-length (io-arg (+ index 1))) 0)
                 (not (full-is-flag? (io-arg (+ index 1)))) (full-argv-ok? (+ index 2)))
            (full-word-flag? word) (full-argv-ok? (+ index 1))
            (full-is-flag? word) false
            :else (full-argv-ok? (+ index 1))))))
(defn- full-mapped-source? [source :string] :bool
  (let [index (drv-pj-flag 1 (io-argc) "--source-lock")]
    (and (not (full-native?)) (>= index 0)
      (let [text (drv-pj-lock-text (io-read-source-lock (io-arg index)))]
        (and (ksl-mapped? text) (ksl-valid? text) (string=? source (ksl-entry text))
             (drv-pj-lock-digest? text))))))
(defn- full-source-ok? [] :bool
  (if (or (string=? (io-arg 0) "check") (string=? (io-arg 0) "compile"))
    (let [index (if (full-native?) 1 (drv-pos 1 (io-argc) 0)) source (drv-arg index) length (string-length source)]
      (or (full-canonical-source? source)
          (full-mapped-source? source))) true))
(defn- full-canonical-source? [source :string] :bool
  (let [length (string-length source)]
    (if (< length 7) false
      (loop [i 0]
        (cond (> i (- length 7)) false
              (= i (- length 7)) (string=? (string-substring source i length) ".kotoba")
              :else (recur (+ i (mem-cpw (string-code-point-at source i)))))))))
(defn- full-lock-ok? [] :bool
  (let [index (drv-pj-flag 1 (io-argc) "--source-lock")]
    (or (< index 0) (> (vector-count (io-read-source-lock (io-arg index))) 0))))
(defn- full-c-linked? [] :bool
  (let [index (drv-pj-flag 1 (io-argc) "--format")]
    (and (>= index 0) (string=? (io-arg index) "platform-linked"))))
;; malformed x86_64-linux arguments (70's xg-main) are a usage error, as in 73
(defn- xg-default [] :i64 (drv-fail0 E-USAGE))
;; `definition-cids <file.kotoba> [--groups]` (ADR 0300, JUN-584): one row per top-level definition in declaration
;; order, `name<TAB>CID` or `name<TAB>REFUSED:<marker>`, then `SCANNED<TAB><identified>/<total>`. No admission runs
;; and nothing is granted: a CID is identity, never authority. Exit 0 = report, 66 = no identity could be computed
;; (stdout empty, a DSB:* line on stderr), 2 = usage. Identity: payload-v2, profile 6 / desugar 2.
(defn- full-definition-cids [format :i64] :i64
  (if (= (dsr-source-report (io-fs2-text 65 (io-arg 1) "") 0 format) 0) 0 66))
(defn- seed-main [] :i64
  (cond (> (io-argc) 256) (drv-usage)
        (string=? (io-arg 0) "kototama-cache-host-build") (k3-host-command)
        (string=? (io-arg 0) "compile-kototama-cache") (k3-command)
        (string=? (io-arg 0) "compile-kototama")
          (if (string=? (io-arg 9) "kototama.pure-i64-receipt/v2") (k2-command) (kt-command))
        (string=? (io-arg 0) "definition-cids")
          (cond (= (io-argc) 2) (full-definition-cids 1)
                (and (= (io-argc) 3) (string=? (io-arg 2) "--groups")) (full-definition-cids 2)
                :else (drv-usage))
        (= (drv-pj-has 1 (io-argc) "--module-lock") 1) (drv-fail0 E-PROJ-UNPINNED)
        (not (full-argv-ok? 1)) (drv-usage)
        (not (full-lock-ok?)) (drv-fail0 E-PROJ-UNPINNED)
        (not (full-source-ok?)) (drv-usage)
        ;; The engine-neutral default is not implemented in this native
        ;; closure. Refuse it rather than substituting an AArch64 target.
        (and (string=? (io-arg 0) "compile") (= (drv-pj-has 1 (io-argc) "--target") 0)) (drv-fail0 E-TARGET)
        ;; Native product/CDCI have no C dynamic-loader/runtime prerequisite.
        (and (string=? (io-arg 0) "compile") (full-c-linked?)) (drv-fail0 E-TARGET)
        (string=? (io-arg 0) "cdci-build") (xc-command)
        (string=? (io-arg 0) "bench-build") (xb-command)
        (string=? (io-arg 0) "package-aiueos-boot") (eb-command)
        (string=? (io-arg 0) "package-aiueos-user-payload") (eu-command)
        (= (full-target? "x86_64-aiueos-kernel-v1") 1)
          (if (or (= (drv-pj-has 1 (io-argc) "--source-path") 1)
                  (= (drv-pj-has 1 (io-argc) "--source-lock") 1)) (kp-command) (xo-command))
        (= (full-target? "x86_64-aiueos-kernel-v2") 1) (kp-command)
        (= (full-target? "x86_64-aiueos-kernel-v3") 1) (kp-command)
        (= (full-target? "x86_64-aiueos-user-v1") 1) (xu-command)
        (= (full-target? "x86_64-aiueos-user-v2") 1) (xu-command)
        (= (full-target? "x86_64-aiueos-user-v3") 1) (xu-command)
        (= (full-target? "x86_64-aiueos-user-v4") 1) (xu-command)
        (= (full-target? "x86_64-aiueos-user-v5") 1) (xu-command)
        (= (full-target? "x86_64-aiueos-user-plc-v1") 1) (xpl-command)
        (= (full-target? "aarch64-linux") 1) (xa-command)
        ;; JUN-353: guest and runtime in a browser Wasm module.
        (= (full-target? "wasm32-browser") 1) (xw-command)
        ;; ADR 0397 (JUN-706): the same SIR as one restricted ES module.
        (= (full-target? "js-browser") 1) (xj-command)
        ;; KOTOBA-174 (ADR 0396): build the public Linux x86_64 host entry, the
        ;; --format static image whose start names x86_64-linux for a compile
        ;; that omits --target. This entry's own omitted target still refuses E2.
        (and (= (full-target? "x86_64-linux") 1) (= (io-argc) 8)
             (string=? (io-arg 6) "--format") (string=? (io-arg 7) "host-entry")) (xs-command 6)
        (= (full-target? "x86_64-linux") 1)
          (if (or (= (drv-pj-has 1 (io-argc) "--source-path") 1)
                  (= (drv-pj-has 1 (io-argc) "--source-lock") 1)) (xpj-command) (xg-main))
        :else (drv-main)))
