;; seed/tests/check/spellings.kotoba -- every head spelling and meaningful keyword of seed/HEADS, plus near misses.
;; Read by scripts/seed/ck-gate.sh in mode "s" (symbol table dump); the program itself is refused (E2003).
(ns spell (:export [x]))
(x ns defn defn- def let loop recur if and or not = < > <= >= + - * quot bit-and bit-or bit-xor bit-not
   u64-shift-right i64-shift-left i64-shift-right vector-at vector-conj vector-assoc vector-assoc! vector-alloc
   string-code-point-at string-length typed-cap-call bytes-from-vector-i64 string-concat cond vector-i64-from-bytes
   :i64 :bool :string :vector-i64 :export :else :bytes :fs/app-data :cli/args :io/write-error :io/write :fs/app-data-bytes
   main true false nil fn do defn-- conds vector-at! string-code-point-at? bytes-from-vector-i32 vector-i64-from-byte ns2 :i32 :elsewhere
   u64-shift-righ i64-shift-lefts == -> :io/writ :fs/app-data-byte)
