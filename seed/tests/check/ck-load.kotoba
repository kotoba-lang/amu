;; seed/tests/check/ck-load.kotoba -- 20-names/21-check test driver WITHOUT 10-lex/11-read (owner 20-names/21-check).
;; Assembled by scripts/seed/ck-gate.sh --ref-front: 00-ns 20-names 21-check ck-common.kotoba ck-load.kotoba.
;; Guest argv: <mode> <source path> <table path>. The table file (made by scripts/seed/ck_ref.py --tables, from the
;; Python reference lexer/reader) is decimal text: "<ntok> <nnode>" then 4 words per token (TF-* fields) and 8 words
;; per node (NF-* fields, 0 beyond NF-AUX), in index order from 1. They are loaded into the TOK and NODE regions, so
;; names and check run on exactly the layout 10-lex/11-read are specified to produce.
(defn- t-digit-at [T :string i :i64] :i64 (- (string-code-point-at T i) 48))
(defn- t-is-digit [c :i64] :i64 (if (< c 48) 0 (if (> c 57) 0 1)))
;; position of the next byte at or after i that is a digit or '-'
(defn- t-skip [T :string i :i64] :i64
  (loop [k i]
    (cond (>= k (string-length T)) k
          (= (string-code-point-at T k) 45) k
          (= (t-is-digit (string-code-point-at T k)) 1) k
          :else (recur (+ k 1)))))
;; the magnitude of the digit run at i (wrapping), and the position after it, packed as two calls
(defn- t-num-end [T :string i :i64] :i64
  (loop [k i]
    (cond (>= k (string-length T)) k
          (= (t-is-digit (string-code-point-at T k)) 1) (recur (+ k 1))
          :else k)))
(defn- t-num-val [T :string i :i64 e :i64] :i64
  (loop [k i v 0]
    (if (< k e) (recur (+ k 1) (+ (* v 10) (t-digit-at T k))) v)))
(defn- t-sign [T :string i :i64] :i64 (if (= (string-code-point-at T i) 45) -1 1))
(defn- t-digits-at [T :string i :i64] :i64 (if (= (string-code-point-at T i) 45) (+ i 1) i))
;; the number whose text starts at i (after t-skip)
(defn- t-value [T :string i :i64] :i64
  (let [d (t-digits-at T i)] (* (t-sign T i) (t-num-val T d (t-num-end T d)))))
(defn- t-after [T :string i :i64] :i64 (t-num-end T (t-digits-at T i)))
(defn- t-put [M :vector-i64 a :i64 v :i64] :vector-i64 (vector-assoc! M a v))
;; load cnt numbers starting at text position i into M[addr ..]; R0 = the text position after the last one
(defn- t-load [M :vector-i64 T :string i :i64 addr :i64 cnt :i64] :vector-i64
  (if (= cnt 0)
    (t-put M MM-R0 i)
    (let [j (t-skip T i)
          v (t-value T j)
          M1 (t-put M addr v)]
      (t-load M1 T (t-after T j) (+ addr 1) (- cnt 1)))))
(defn- t-tables [M :vector-i64 T :string] :vector-i64
  (let [j0 (t-skip T 0)
        ntok (t-value T j0)
        j1 (t-skip T (t-after T j0))
        nnode (t-value T j1)
        M1 (t-load M T (t-after T j1) (+ MM-TOK-BASE MM-TOK-W) (* ntok MM-TOK-W))
        i2 (vector-at M1 MM-R0)
        M2 (t-load M1 T i2 (+ MM-NODE-BASE MM-NODE-W) (* nnode MM-NODE-W))
        M3 (t-put M2 MM-TOK-N (+ ntok 1))
        M4 (t-put M3 MM-NODE-N (+ nnode 1))]
    (t-put M4 MM-ROOT 1)))
(defn- seed-main [] :i64
  (let [mode (typed-cap-call :cli/args :string :string "0")
        path (typed-cap-call :cli/args :string :string "1")
        tpath (typed-cap-call :cli/args :string :string "2")
        S (typed-cap-call :fs/app-data :string :string path)
        T (typed-cap-call :fs/app-data :string :string tpath)
        r (t-names (t-tables (t-mem) T) S (string-code-point-at mode 0))]
    0))
