;; R6D regression: a library that turns keywords into text; the keywords are made in its importer (and one in a second
;; library), never spelled here
(ns r6dp.lib (:export [klen kfull]))
(defn klen [k :keyword] :i64 (string-length (keyword-name k)))
(defn kfull [k :keyword] :i64 (string-length (str (keyword-name k) "/")))
