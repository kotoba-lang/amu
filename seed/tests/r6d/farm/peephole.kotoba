(ns r6d.pp (:require [kotoba.native.peephole :as p]) (:export [main]))
(defn- v [o :option-i64] :i64 (if (option-some? o) (+ 1 (* 2 (option-value o 0))) 0))
(defn main [] :i64
  (+ (v (p/constant-operand (document-i64 41)))
     (* 1000 (v (p/constant-operand (document-bool true))))
     (* 100000 (v (p/constant-operand (document-bool false))))
     (* 10000000 (v (p/constant-operand (document-string "x"))))))
