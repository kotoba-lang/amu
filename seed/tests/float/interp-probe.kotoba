;; seed/tests/float/interp-probe.kotoba -- FLOAT (rung r6j): kotoba.kir.interp (the KIR reference interpreter, Kotoba
;; reading), compiled FROM SOURCE by the seed, evaluates float KIR forms. main = the number of failed checks (exit status).
;; Expected values: IEEE-754 binary64/binary32 (round to nearest even), the same patterns stage-0's native code answers for
;; these operations (scripts/seed/float-diff.sh); trap names from kir.interp's host reading. scripts/seed/float-interp.sh.
(ns flprobe
  {:kotoba/export [main]}
  (:require [kotoba.form :as form]
            [kotoba.kir.interp :as ki]
            [kotoba.kir.kvalue :as kv]))

(defn- fb [bits :i64] [:ref :form/r] (form/call1 "f64-from-bits" (form/int-form bits)))
(defn- sb [bits :i64] [:ref :form/r] (form/call1 "f32-from-bits" (form/int-form bits)))
(defn- ev [f [:ref :form/r]] [:ref :kir.interp/res] (ki/eval-form f 1000 16))
;; 0 when f evaluates to a value of tag tg whose :n is n, else 1
(defn- is [f [:ref :form/r] tg :i64 n :i64] :i64
  (let [r (ev f)]
    (if (and (ki/res-ok? r) (= (kv/tag-of (ki/res-value r)) tg) (= (kv/n-of (ki/res-value r)) n)) 0 1)))
;; 0 when f traps with name t
(defn- traps [f [:ref :form/r] t :string] :i64
  (let [r (ev f)] (if (and (= (ki/res-kind r) 1) (string=? (ki/res-trap r) t)) 0 1)))

(defn main [] :i64
  (+ (is (form/call2 "f64-add" (fb 4607182418800017408) (fb 4602678819172646912)) 3 4609434218613702656)   ; 1 + 0.5
     (is (form/call1 "f64-sqrt" (fb 4611686018427387904)) 3 4609047870845172685)                          ; sqrt 2
     (is (form/call2 "f64-div" (fb 4607182418800017408) (fb 4613937818241073152)) 3 4599676419421066581)   ; 1 / 3
     (is (form/call2 "f64-lt" (fb 4607182418800017408) (fb 4611686018427387904)) 1 1)                     ; 1 < 2
     (is (form/call2 "f64-unordered" (fb 9221120237041090560) (fb 0)) 1 1)                                 ; NaN
     (is (form/call2 "f64-min" (fb -9223372036854775808) (fb 0)) 3 -9223372036854775808)                  ; min(-0, +0) = -0
     (is (form/call1 "f64-to-i64-truncating" (fb 4612811918334230528)) 2 2)                               ; 2.5 -> 2
     (traps (form/call1 "f64-to-i64-checked" (fb 4612811918334230528)) "f64-not-integral")
     (traps (form/call1 "f64-to-i64-truncating" (fb 9221120237041090560)) "f64-conversion-out-of-range")
     (is (form/call1 "i64-to-f64-rounded" (form/int-form 9007199254740993)) 3 4845873199050653696)         ; 2^53 + 1 -> 2^53
     (traps (form/call1 "i64-to-f64-checked" (form/int-form 9007199254740993)) "i64-not-exact-f64")
     (is (form/call2 "f32-add" (sb 1065353216) (sb 1056964608)) 3 1069547520)                              ; 1f + 0.5f
     (is (form/call1 "f64-to-f32-rounded" (fb 4591870180066957722)) 3 1036831949)                          ; 0.1 -> 0.1f
     (is (form/call1 "f32-to-f64-exact" (sb 1036831949)) 3 4591870180174331904)))                          ; 0.1f widened
