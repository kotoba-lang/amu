(ns f64.parse (:export [t]))
(defn chk [s :string want :i64 some :bool i :i64] :i64
  (let [o (decimal-f64-parse s)] (if some (if (option-some?-of [:option :f64] o) (if (= (f64-to-bits (option-value-of [:option :f64] o (f64-from-bits 0))) want) 0 (+ 1000 i)) (+ 1000 i)) (if (option-some?-of [:option :f64] o) (+ 1000 i) 0))))
(defn pick [a :i64 b :i64] :i64 (if (= a 0) b a))
