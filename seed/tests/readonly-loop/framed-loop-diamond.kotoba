(ns cfg.framed-loop-diamond (:export [run walk]))
(defn- walk [v :vector-i64 n :i64 a :i64 b :i64 c :i64] :i64 (loop [i 0 s c x a y b] (if (= i n) (+ s (vector-at v 0)) (let [q (vector-at v 1) r (vector-at v 2) z (vector-at v (if (< x y) 1 2))] (recur (+ i 1) (+ s q r z) (+ x 1) (+ y 2))))))
(defn run [n :i64] :i64 (walk [11 13 17] n 1 2 0))
