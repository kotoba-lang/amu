(ns embench.wikisort (:export [run test-wikisort]))
(defn- next-seed [seed :i64] :i64 (bit-and (+ (* seed 1103515245) 12345) 2147483647))
(defn- advance-seed [count :i64] :i64 (loop [seed 0 i 0] (if (= i count) seed (recur (next-seed seed) (+ i 1)))))
(defn- draw-start [case :i64] :i64 (if (= case 0) 0 (if (= case 1) 0 (if (= case 2) 400 (if (= case 3) 800 (if (< case 8) 1200 1600))))))
(defn- random-case [case :i64] :i64 (if (or (= case 1) (= case 2) (= case 3) (= case 7) (= case 8)) 1 0))
(defn- item-value [case :i64 index :i64 random :i64] :i64 (if (= case 0) (if (= index 0) 10 (if (< index 200) 11 (if (= index 399) 10 9))) (if (= case 1) random (if (= case 2) (- (+ (- 400 index) (* random 6553)) 2) (if (= case 3) (- (+ index (* random 6553)) 2) (if (= case 4) index (if (= case 5) (- 400 index) (if (= case 6) 1000 (if (= case 7) (if (<= (quot random 29491) 1) index (- index 2)) (+ 1000 (- random (* (quot random 4) 4))))))))))))
(defn- fill-items [items :vector-i64 index :i64 seed :i64 case :i64] :vector-i64 (if (= index 400) items (let [next (if (= (random-case case) 1) (next-seed seed) seed) random (u64-shift-right next 16) value (item-value case index random) written (vector-assoc! items index (+ (* value 512) index))] (fill-items written (+ index 1) next case))))
(defn- items-for [case :i64] :vector-i64 (fill-items (vector-alloc 400) 0 (advance-seed (draw-start case)) case))
(defn- shift-item [items :vector-i64 j :i64 item :i64 value :i64] :vector-i64 (if (= j 0) (vector-assoc! items j item) (let [previous (vector-at items (- j 1))] (if (<= (quot previous 512) value) (vector-assoc! items j item) (let [shifted (vector-assoc! items j previous)] (shift-item shifted (- j 1) item value))))))
(defn- insert-one [items :vector-i64 position :i64] :vector-i64 (let [item (vector-at items position)] (shift-item items position item (quot item 512))))
(defn- stable-sort-from [items :vector-i64 position :i64] :vector-i64 (if (= position 400) items (stable-sort-from (insert-one items position) (+ position 1))))
(defn- stable-sort [items :vector-i64] :vector-i64 (stable-sort-from items 1))
(defn- fingerprint [items :vector-i64] :i64 (loop [i 0 hash -3750763034362895579] (if (= i 400) hash (let [item (vector-at items i) value (quot item 512) index (- item (* value 512)) with-value (* (bit-xor hash value) 1099511628211) with-index (* (bit-xor with-value index) 1099511628211)] (recur (+ i 1) with-index)))))
(defn- expected [case :i64] :i64 (vector-at [3621418258322588527 -8288716862839773640 -3323926433876842061 -1236216023619741356 2141893828648330949 -4591863356032321883 2621070482352064837 2141893828648330949 4937014939410958146] case))
(defn- check-case [case :i64] :i64 (let [items (items-for case) sorted (stable-sort items)] (if (= (fingerprint sorted) (expected case)) 1 0)))
(defn run [token :i64] :i64 (if (= token 1) (loop [case 0 passed 0] (if (= case 9) passed (recur (+ case 1) (+ passed (check-case case))))) 0))
(defn test-wikisort [] :i64 (if (= (run 1) 9) 1 0))
