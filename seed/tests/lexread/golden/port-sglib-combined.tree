(ns embench.sglib-combined (:export [run test-sglib-combined]))
(defn- fill [values :vector-i64 i :i64] :vector-i64 (if (= i 100) values (fill (vector-assoc! values i (- 99 i)) (+ i 1))))
(defn- shuffled [] :vector-i64 (fill (vector-alloc 100) 0))
(defn- shift [values :vector-i64 j :i64 item :i64] :vector-i64 (if (= j 0) (vector-assoc! values j item) (let [previous (vector-at values (- j 1))] (if (<= previous item) (vector-assoc! values j item) (shift (vector-assoc! values j previous) (- j 1) item)))))
(defn- insertion [values :vector-i64 position :i64] :vector-i64 (if (= position 100) values (let [item (vector-at values position)] (insertion (shift values position item) (+ position 1)))))
(defn- sum [values :vector-i64] :i64 (loop [i 0 total 0] (if (= i 100) total (recur (+ i 1) (+ total (vector-at values i))))))
(defn- ordered [values :vector-i64] :i64 (loop [i 0] (if (= i 100) 1 (if (= (vector-at values i) i) (recur (+ i 1)) 0))))
(defn run [token :i64] :i64 (if (= token 1) (let [sorted (insertion (shuffled) 1) total (sum sorted)] (if (= (ordered sorted) 1) (+ 200 total total total) 0)) 0))
(defn test-sglib-combined [] :i64 (if (= (run 1) 15050) 1 0))
