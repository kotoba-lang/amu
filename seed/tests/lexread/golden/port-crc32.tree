(defn- step-seed [seed :i64] :i64 (bit-and (+ (* seed 1103515245) 12345) 2147483647))
(defn- compute [] :i64 (loop [i 0 seed 0 crc 4294967295] (if (= i 1024) (bit-and (bit-not crc) 4294967295) (let [next (step-seed seed) byte (u64-shift-right next 16) index (bit-and (bit-xor crc byte) 255) updated (bit-xor (table-at index) (u64-shift-right crc 8))] (recur (+ i 1) next updated)))))
(defn run [token :i64] :i64 (if (= token 1) (bit-and (compute) 32767) 0))
(defn test-crc32 [] :i64 (if (= (run 1) 11433) 1 0))
