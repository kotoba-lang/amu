(ns embench.nettle-aes (:export [run test-nettle-aes]))
(defn- xtime [x :i64] :i64 (bit-and (bit-xor (* x 2) (if (> x 127) 27 0)) 255))
(defn- gf-mul [a :i64 b :i64] :i64 (loop [x a y b result 0] (if (= y 0) result (recur (xtime x) (u64-shift-right y 1) (if (= (bit-and y 1) 1) (bit-xor result x) result)))))
(defn- gf-pow [a :i64 n :i64] :i64 (loop [base a exponent n result 1] (if (= exponent 0) result (recur (gf-mul base base) (u64-shift-right exponent 1) (if (= (bit-and exponent 1) 1) (gf-mul result base) result)))))
(defn- rot8 [x :i64 n :i64] :i64 (bit-and (bit-or (* x (vector-at [1 2 4 8 16] n)) (u64-shift-right x (- 8 n))) 255))
(defn- xor4 [a :i64 b :i64 c :i64 d :i64] :i64 (bit-xor (bit-xor a b) (bit-xor c d)))
(defn- sbox [x :i64] :i64 (let [inverse (if (= x 0) 0 (gf-pow x 254))] (bit-and (bit-xor (xor4 inverse (rot8 inverse 1) (rot8 inverse 2) (rot8 inverse 3)) (bit-xor (rot8 inverse 4) 99)) 255)))
(defn- mix-word [a :i64 b :i64 c :i64 d :i64] :i64 (+ (* (xor4 (gf-mul a 2) (gf-mul b 3) c d) 16777216) (* (xor4 a (gf-mul b 2) (gf-mul c 3) d) 65536) (* (xor4 a b (gf-mul c 2) (gf-mul d 3)) 256) (xor4 (gf-mul a 3) b c (gf-mul d 2))))
(defn run [token :i64] :i64 (if (= token 1) (mix-word (sbox 201) (sbox 149) (sbox 85) (sbox 49)) 0))
(defn test-nettle-aes [] :i64 (if (= (run 1) 3830531647) 1 0))
