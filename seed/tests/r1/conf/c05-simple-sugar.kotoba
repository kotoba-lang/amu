;; R1 conf from lang/conformance control/simple_sugar.kotoba (26): if-not/when-not/cond->>/as-> (not R1) written with cond/when/->>/let
(ns seed.r1 (:export [test]))
(defn- subtract [a :i64 b :i64] :i64 (- a b))
(defn test [] :i64
  (+ (cond (= 0 0) 4 :else (quot 1 0)) (when (= 0 0) (+ 2 3)) (->> 3 (subtract 10)) (let [x 2] (let [x (+ x 3)] (* x 2)))))
