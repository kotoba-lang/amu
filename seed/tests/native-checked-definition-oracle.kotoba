;; Independent hand-authored payloads through 04's generic canonical encoder.
;; This oracle does not call 05/06 or normalize the supplied test programs.
(defn- dco-map [xs [:list :string]] :string (dc-collection "map" xs true))
(defn- dco-list [xs [:list :string]] :string (dc-collection "list" xs false))
(defn- dco-vec [xs [:list :string]] :string (dc-collection "vec" xs false))
(defn- dco-sym [name :string] :string (dc-atom "sym" name))
(defn- dco-interface [params [:list :string]] :string
  (dco-map (typed-list-new [:list :string] (dc-entry "arity" (dc-int (mem-u2dec (vector-count params))))
    (dc-entry "params" (dco-vec params)) (dc-entry "result" (dc-kw "i64")))))
(defn- dco-payload [params [:list :string] types [:list :string] body :string deps [:list :string]] :string
  (dc-payload "6" "2" (dco-map (typed-list-new [:list :string]
      (dc-entry "op" (dc-kw "kotoba.definition/function")) (dc-entry "params" (dco-vec params)) (dc-entry "body" body)))
    (dc-collection "set" (typed-list-new [:list :string]) true) (dco-interface types)
    (dc-collection "vec" deps true)))
(defn- dco-leaf [constant :i64] :string
  (dco-payload (typed-list-new [:list :string] (dco-sym "k0"))
    (typed-list-new [:list :string] (dc-kw "i64"))
    (dco-list (typed-list-new [:list :string] (dco-sym "+") (dco-sym "k0") (dc-int (mem-u2dec constant))))
    (typed-list-new [:list :string])))
(defn- dco-ref [cid :string] :string
  (dco-vec (typed-list-new [:list :string] (dc-kw "kotoba.definition/ref") (dc-str cid))))
(defn- dco-caller [constant :i64] :string
  (let [cid (dc-definition-cid (dco-leaf constant))]
    (dco-payload (typed-list-new [:list :string] (dco-sym "k0"))
      (typed-list-new [:list :string] (dc-kw "i64"))
      (dco-list (typed-list-new [:list :string] (dco-ref cid) (dco-sym "k0")))
      (typed-list-new [:list :string] (dc-str cid)))))
(defn- dco-group-ref [index :i64] :string
  (dco-vec (typed-list-new [:list :string] (dc-kw "kotoba.definition/group") (dc-int (mem-u2dec index)))))
(defn- dco-cycle-body [index :i64 count :i64] :string
  (dco-list (typed-list-new [:list :string] (dco-sym "if")
    (dco-list (typed-list-new [:list :string] (dco-sym "=") (dco-sym "k0") (dc-int "0")))
    (dc-int (mem-u2dec (inc index)))
    (dco-list (typed-list-new [:list :string] (dco-group-ref (rem (inc index) count))
      (dco-list (typed-list-new [:list :string] (dco-sym "-") (dco-sym "k0") (dc-int "1"))))))))
(defn- dco-cycle [count :i64] :string
  (let [members (loop [i 0 xs (typed-list-new [:list :string])]
    (if (= i count) xs (recur (inc i) (typed-list-conj [:list :string] xs
      (dco-map (typed-list-new [:list :string]
        (dc-entry "params" (dco-vec (typed-list-new [:list :string] (dco-sym "k0"))))
        (dc-entry "body" (dco-cycle-body i count))
        (dc-entry "interface" (dco-interface (typed-list-new [:list :string] (dc-kw "i64"))))))))))]
    (dc-payload "6" "2" (dco-map (typed-list-new [:list :string]
        (dc-entry "op" (dc-kw "kotoba.definition/recursive-group")) (dc-entry "members" (dco-vec members))))
      (dc-collection "set" (typed-list-new [:list :string]) true)
      (dco-map (typed-list-new [:list :string] (dc-entry "arity" (dc-int (mem-u2dec count)))
        (dc-entry "result" (dc-kw "kotoba.definition/group"))))
      (dco-vec (typed-list-new [:list :string])))))
(defn- dco-member [count :i64 index :i64] :string
  (let [group (dc-definition-cid (dco-cycle count))]
    (dc-payload "6" "2" (dco-map (typed-list-new [:list :string]
        (dc-entry "op" (dc-kw "kotoba.definition/group-member")) (dc-entry "index" (dc-int (mem-u2dec index)))))
      (dc-collection "set" (typed-list-new [:list :string]) true)
      (dco-interface (typed-list-new [:list :string] (dc-kw "i64")))
      (dco-vec (typed-list-new [:list :string] (dc-str group))))))
(defn- dco-let [binder :string value :string body :string] :string
  (dco-list (typed-list-new [:list :string] (dco-sym "let")
    (dco-vec (typed-list-new [:list :string] (dco-sym binder) value)) body)))
(defn- dco-binders [] :string
  (dco-payload (typed-list-new [:list :string] (dco-sym "k0"))
    (typed-list-new [:list :string] (dc-kw "i64"))
    (dco-list (typed-list-new [:list :string] (dco-sym "+")
      (dco-let "k1" (dco-sym "k0") (dco-sym "k1"))
      (dco-let "k2" (dco-sym "k0") (dco-sym "k2")))) (typed-list-new [:list :string])))
(defn- dco-result [] :string
  (let [type (dco-vec (typed-list-new [:list :string] (dc-kw "result") (dc-kw "i64") (dc-kw "i64")))
        body (dco-list (typed-list-new [:list :string] (dco-sym "result-match-of") type
          (dco-list (typed-list-new [:list :string] (dco-sym "result-ok-of") type (dco-sym "k0")))
          (dco-sym "k1") (dco-list (typed-list-new [:list :string] (dco-sym "+") (dco-sym "k1") (dco-sym "k0")))
          (dco-sym "k2") (dco-list (typed-list-new [:list :string] (dco-sym "-") (dco-sym "k2") (dco-sym "k0")))))]
    (dco-payload (typed-list-new [:list :string] (dco-sym "k0"))
      (typed-list-new [:list :string] (dc-kw "i64")) body (typed-list-new [:list :string]))))
(defn- dco-option [] :string
  (let [type (dco-vec (typed-list-new [:list :string] (dc-kw "option") (dc-kw "i64")))
        body (dco-list (typed-list-new [:list :string] (dco-sym "option-match") type
          (dco-list (typed-list-new [:list :string] (dco-sym "option-some-of") type (dco-sym "k0")))
          (dc-int "0") (dco-sym "k1")
          (dco-list (typed-list-new [:list :string] (dco-sym "+") (dco-sym "k1") (dco-sym "k0")))))]
    (dco-payload (typed-list-new [:list :string] (dco-sym "k0"))
      (typed-list-new [:list :string] (dc-kw "i64")) body (typed-list-new [:list :string]))))
(defn- dco-external-body [index :i64 leaf :string] :string
  (dco-list (typed-list-new [:list :string] (dco-sym "if")
    (dco-list (typed-list-new [:list :string] (dco-sym "=") (dco-sym "k0") (dc-int "0")))
    (dco-list (typed-list-new [:list :string] (dco-sym "+")
      (dco-list (typed-list-new [:list :string] (dco-ref leaf) (dco-sym "k0"))) (dc-int (mem-u2dec (inc index)))))
    (dco-list (typed-list-new [:list :string] (dco-group-ref (rem (inc index) 2))
      (dco-list (typed-list-new [:list :string] (dco-sym "-") (dco-sym "k0") (dc-int "1"))))))))
(defn- dco-external-member [constant :i64 index :i64] :string
  (let [leaf (dc-definition-cid (dco-leaf constant))
        members (loop [i 0 xs (typed-list-new [:list :string])]
          (if (= i 2) xs (recur (inc i) (typed-list-conj [:list :string] xs
            (dco-map (typed-list-new [:list :string]
              (dc-entry "params" (dco-vec (typed-list-new [:list :string] (dco-sym "k0"))))
              (dc-entry "body" (dco-external-body i leaf))
              (dc-entry "interface" (dco-interface (typed-list-new [:list :string] (dc-kw "i64"))))))))))
        payload (dc-payload "6" "2" (dco-map (typed-list-new [:list :string]
            (dc-entry "op" (dc-kw "kotoba.definition/recursive-group")) (dc-entry "members" (dco-vec members))))
          (dc-collection "set" (typed-list-new [:list :string]) true)
          (dco-map (typed-list-new [:list :string] (dc-entry "arity" (dc-int "2"))
            (dc-entry "result" (dc-kw "kotoba.definition/group"))))
          (dco-vec (typed-list-new [:list :string] (dc-str leaf))))
        group (dc-definition-cid payload)]
    (dc-payload "6" "2" (dco-map (typed-list-new [:list :string]
        (dc-entry "op" (dc-kw "kotoba.definition/group-member")) (dc-entry "index" (dc-int (mem-u2dec index)))))
      (dc-collection "set" (typed-list-new [:list :string]) true)
      (dco-interface (typed-list-new [:list :string] (dc-kw "i64")))
      (dco-vec (typed-list-new [:list :string] (dc-str group))))))
(defn- dco-expected [name :string] :string
  (cond (= name "const") (dco-payload (typed-list-new [:list :string]) (typed-list-new [:list :string])
                          (dc-int "42") (typed-list-new [:list :string]))
        (= name "leaf") (dco-leaf 1) (= name "leaf2") (dco-leaf 2)
        (= name "caller") (dco-caller 1) (= name "caller2") (dco-caller 2)
        (= name "binders") (dco-binders) (= name "result") (dco-result) (= name "option") (dco-option)
        (= name "external-first") (dco-external-member 1 0) (= name "external-second") (dco-external-member 1 1)
        (= name "external2-first") (dco-external-member 2 0) (= name "external2-second") (dco-external-member 2 1)
        (= name "self") (dco-member 1 0)
        (= name "cycle2-first") (dco-member 2 0) (= name "cycle2-second") (dco-member 2 1)
        (= name "cycle8-group") (dco-cycle 8)
        (and (= (string-length name) 4) (= (string-substring name 0 3) "c8-"))
          (dco-member 8 (mem-parse-dec name 3 4))
        :else ""))
(defn- seed-main [] :i64
  (if (not= (io-argc) 1) 2
    (let [cid (dc-definition-cid (dco-expected (io-arg 0)))]
      (if (= cid "") 1 (let [out (io-out (string-concat cid "\n"))] 0)))))
