(ns scoped-read.probe (:export [main]))
(defn arg [i :i64] :string (typed-cap-call 38 :string :string (string-from-i64 i)))
(defn main [] :i64
  (let [nul (string-from-utf8 (bytes-from-vector-i64 (vector-alloc 1)))
        frame (str nul "KFR1" nul (arg 0))
        answer (vector-i64-from-bytes (typed-cap-call 35 :bytes :bytes (string-to-utf8 frame)))
        n (vector-count answer) status (if (> n 0) (vector-at answer 0) -1)
        text (if (= status 1) (string-from-utf8 (bytes-from-vector-i64 (vector-drop answer 1))) "")
        printed (typed-cap-call 37 :string :string (str status " " n " " text "\n"))]
    (if (= status 1) 0 2)))
