(ns direct-mask-controls (:export [run]))
(defn- put [v :vector-i64 i :i64 x :i64] :vector-i64 (vector-assoc! v i x))
(defn- put8 [v :vector-i64 i :i64 x :i64] :vector-i64 (put v i (bit-and x 255)))
(defn- put16 [v :vector-i64 i :i64 x :i64] :vector-i64 (put v i (bit-and x 65535)))
(defn- plain [v :vector-i64 x :i64] :i64 (let [a (put8 v 0 x)] (vector-at a 0)))
(defn- expression [v :vector-i64 x :i64] :i64 (let [a (put8 v 0 (+ x 1))] (vector-at a 0)))
(defn- zero [v :vector-i64] :i64 (let [a (put8 v 0 0)] (vector-at a 0)))
(defn- constant [v :vector-i64] :i64 (let [a (put8 v 0 257)] (vector-at a 0)))
(defn- twice [v :vector-i64 x :i64] :i64 (let [a (put8 v 0 x) b (put8 a 1 (+ x 256))] (+ (vector-at b 0) (vector-at b 1))))
(defn- calculated [v :vector-i64 x :i64] :i64 (let [a (put8 v 0 (bit-xor x 42))] (vector-at a 0)))
(defn- near-miss [v :vector-i64 x :i64] :i64 (let [a (put16 v 0 x)] (vector-at a 0)))
(defn- invalid [v :vector-i64 x :i64] :i64 (let [a (put8 v -1 x)] (vector-at a 0)))
(defn run [mode :i64 x :i64] :i64 (let [v (vector-alloc 4)] (case mode 0 (plain v x) 1 (expression v x) 2 (zero v) 3 (constant v) 4 (twice v x) 5 (calculated v x) 6 (near-miss v x) 7 (invalid v x) 0)))
