(ns native.x86-float-test (:export [main]))

(defn- f [x :f64] :f32 (f64-to-f32-rounded x))
(defn- nan64 [] :f64 (f64-from-bits 9221120237041090561))
(defn- nan32 [] :f32 (f32-from-bits 2143289345))
(defn- snan64 [] :f64 (f64-from-bits 9218868437227405313))
(defn- snan32 [] :f32 (f32-from-bits 2139095041))
(defn- negzero64 [] :f64 (f64-from-bits -9223372036854775808))
(defn- negzero32 [] :f32 (f32-from-bits -2147483648))
(defn- isnan64 [x :f64] :bool (f64-unordered x x))
(defn- isnan32 [x :f32] :bool (f32-unordered x x))

(defn- conversions [] :bool
  (and (= (f64-to-bits (i64-to-f64-rounded 9007199254740993)) 0x4340000000000000)
       (= (f64-to-bits (i64-to-f64-rounded 9007199254740995)) 0x4340000000000002)
       (= (f32-to-bits (i64-to-f32-rounded 16777217)) 0x4b800000)
       (= (f32-to-bits (i64-to-f32-rounded 16777219)) 0x4b800002)
       (= (f32-to-bits (f64-to-f32-rounded (f64-from-bits 0x3ff0000010000000))) 0x3f800000)
       (= (f32-to-bits (f64-to-f32-rounded (f64-from-bits 0x3ff0000010000001))) 0x3f800001)
       (= (f64-to-bits (f32-to-f64-exact (f32-from-bits 1))) 0x36a0000000000000)
       (f64-eq (f32-to-f64-exact (f 2.25)) 2.25)
       (= (f64-to-i64-truncating 3.75) 3) (= (f64-to-i64-truncating -3.75) -3)
       (= (f32-to-i64-truncating (f 3.75)) 3) (= (f32-to-i64-truncating (f -3.75)) -3)))
(defn- saturation [] :bool
  (and (= (f64-to-i64-truncating (nan64)) 0)
       (= (f64-to-i64-truncating (snan64)) 0)
       (= (f64-to-i64-truncating (f64-from-bits 0x7ff0000000000000)) 9223372036854775807)
       (= (f64-to-i64-truncating (f64-from-bits -4503599627370496)) -9223372036854775808)
       (= (f64-to-i64-truncating (f64-from-bits 0x43e0000000000000)) 9223372036854775807)
       (= (f64-to-i64-truncating (f64-from-bits 0x43dfffffffffffff)) 9223372036854774784)
       (= (f64-to-i64-truncating (f64-neg (f64-from-bits 0x43e0000000000000))) -9223372036854775808)
       (= (f32-to-i64-truncating (nan32)) 0)
       (= (f32-to-i64-truncating (snan32)) 0)
       (= (f32-to-i64-truncating (f32-from-bits 0x7f800000)) 9223372036854775807)
       (= (f32-to-i64-truncating (f32-from-bits -8388608)) -9223372036854775808)
       (= (f32-to-i64-truncating (f32-from-bits 0x5f000000)) 9223372036854775807)
       (= (f32-to-i64-truncating (f32-from-bits 0x5effffff)) 9223371487098961920)
       (= (f32-to-i64-truncating (f32-from-bits -553648127)) -9223372036854775808)))
(defn main [] :i64 (+ (if (conversions) 1 0) (if (saturation) 2 0)))
