;; R3 neg: verbatim copy of lang/conformance/abort/negative/two_error_types.kotoba (kotoba-lang 919232de)
(ns kotoba.lang.conformance.abort-negative (:export [main]))
;; refused: function f throws two different error types: string and i64
(defn- f [x :i64] :i64 (if (= x 0) (throw "s") (throw 1)))
(defn main [] :i64 (try (f 1) (catch e 0)))
