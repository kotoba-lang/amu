;; R3 feat: maps of maps, keyword keys through typed-map-new
(ns seed.r3 (:export [test]))
(defn test [] :i64 (let [n (typed-map-assoc [:map :i64 [:map :keyword :i64]] (typed-map-new [:map :i64 [:map :keyword :i64]]) 4 (typed-map-new [:map :keyword :i64] :x 7 :y 8))] (get (option-value-of [:option [:map :keyword :i64]] (typed-map-get [:map :i64 [:map :keyword :i64]] n 4) (typed-map-new [:map :keyword :i64])) :y 0)))
