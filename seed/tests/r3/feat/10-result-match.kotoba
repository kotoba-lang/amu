;; R3 feat: result-match-of on both arms
(ns seed.r3 (:export [test]))
(defn- f [r [:result :i64 :string]] :i64 (result-match-of [:result :i64 :string] r v (+ v 1) e (* 100 (string-length e))))
(defn test [] :i64 (+ (f (result-ok-of [:result :i64 :string] 4)) (f (result-err-of [:result :i64 :string] "abcd"))))
