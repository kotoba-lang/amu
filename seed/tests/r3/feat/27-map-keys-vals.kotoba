;; R3 feat: keys / vals in key order
(ns seed.r3 (:export [test]))
(defn test [] :i64 (let [m (typed-map-assoc [:map :i64 :i64] (typed-map-new [:map :i64 :i64] 3 30 1 10) 3 31)] (+ (typed-list-nth [:list :i64] (keys m) 0) (* 10 (typed-list-nth [:list :i64] (vals m) 1)) (* 1000 (count (typed-map-vals [:map :i64 :i64] m))))))
