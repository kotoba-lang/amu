;; R3 feat: a list of options
(ns seed.r3 (:export [test]))
(defn test [] :i64 (let [l (typed-list-new [:list [:option :i64]] (option-some-of [:option :i64] 4) (option-none-of [:option :i64]))] (+ (option-value-of [:option :i64] (typed-list-nth [:list [:option :i64]] l 0) 0) (option-value-of [:option :i64] (typed-list-nth [:list [:option :i64]] l 1) 50))))
