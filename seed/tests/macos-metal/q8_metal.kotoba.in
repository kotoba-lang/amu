(ns q8-metal (:export [main]))

;; One Q8_0 x Q8_0 matrix-vector product on the Apple GPU through Metal, from
;; Amu selfhost (ADR 0375 route B on macOS; JUN-819). Packaged with the
;; amu-program-metal profile: dyld binds dlsym, wire 42 returns the runtime's
;; boot fn value, and every Metal call below is ordinary Kotoba calling C.
;; Same LCG, packing and checksum as q8_cpu.kotoba.in and q8_matvec.c, so all
;; three return the same number. The gate substitutes @ROWS@ @COLS@ @REPS@.

(defn- rows [] :i64 @ROWS@)
(defn- cols [] :i64 @COLS@)
(defn- reps [] :i64 @REPS@)
(defn- blocks [] :i64 (quot (cols) 32))
(defn- mask48 [] :i64 281474976710655)

;; ---- the kernel ---------------------------------------------------------
;; One thread per row. Rows are independent and the arithmetic is integer, so
;; the result does not depend on the GPU's execution order.
(defn- kernel-source [] :string
  "#include <metal_stdlib>
using namespace metal;
kernel void q8_matvec(device const char *W [[buffer(0)]],
                      device const int *SW [[buffer(1)]],
                      device const char *X [[buffer(2)]],
                      device const int *SX [[buffer(3)]],
                      device long *O [[buffer(4)]],
                      uint r [[thread_position_in_grid]]) {
  long acc = 0;
  for (uint k = 0; k < @BLOCKS@u; k++) {
    device const char *w = W + (r * @BLOCKS@u + k) * 32u;
    device const char *x = X + k * 32u;
    int sumi = 0;
    for (uint j = 0; j < 32u; j++) sumi @OP@ int(w[j]) * int(x[j]);
    acc += long(sumi) * long(SW[r * @BLOCKS@u + k] * SX[k]);
  }
  O[r] = acc;
}
")

;; ---- boot(op, a, b): 0 load, 1 store, 2 store byte, 3 call, 4 scratch ------
(defn- peek [f [:fn [[:i64 :i64 :i64] :i64]] p :i64] :i64 (f 0 p 0))
(defn- poke [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 1 p v))
(defn- poke8 [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 v :i64] :i64 (f 2 p v))
(defn- scratch [f [:fn [[:i64 :i64 :i64] :i64]]] :i64 (f 4 0 0))

;; A C call with up to six integer arguments, through the words at scratch + 64.
(defn- cc [f [:fn [[:i64 :i64 :i64] :i64]] fn :i64 a :i64 b :i64 c :i64 d :i64 e :i64] :i64
  (let [s (+ (scratch f) 64)
        u0 (poke f s a) u1 (poke f (+ s 8) b) u2 (poke f (+ s 16) c)
        u3 (poke f (+ s 24) d) u4 (poke f (+ s 32) e)]
    (f 3 fn s)))

;; The NUL-terminated bytes of s at p.
(defn- put-text [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 s :string] :i64
  (let [v (vector-i64-from-bytes (string-to-utf8 s)) n (vector-count v)]
    (loop [i 0]
      (if (= i n) (poke8 f (+ p n) 0)
        (let [u (poke8 f (+ p i) (vector-at v i))] (recur (+ i 1)))))))

;; dlsym before malloc exists: the name goes in the scratch page.
(defn- sym [f [:fn [[:i64 :i64 :i64] :i64]] name :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) name)
        p (cc f (peek f base) -2 (+ base 256) 0 0 0)]
    (if (= p 0) (vector-at [0] 1) p)))

(defn- cstr [f [:fn [[:i64 :i64 :i64] :i64]] malloc :i64 s :string] :i64
  (let [p (cc f malloc (+ (string-length s) 1) 0 0 0 0)
        u (put-text f p s)]
    p))

(defn- open-framework [f [:fn [[:i64 :i64 :i64] :i64]] dlopen :i64 path :string] :i64
  (let [base (scratch f)
        u (put-text f (+ base 256) path)
        h (cc f dlopen (+ base 256) 2 0 0 0)]
    (if (= h 0) (vector-at [0] 1) h)))

;; ---- Objective-C: a selector call is objc_msgSend(self, sel, a, b, c) -------
;; R: 0 objc_msgSend, 1 sel_registerName, 2 objc_getClass, 3 malloc
(defn- sel [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 name :string] :i64
  (cc f (vector-at R 1) (cstr f (vector-at R 3) name) 0 0 0 0))
(defn- msg [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 self :i64 name :string a :i64 b :i64 c :i64] :i64
  (cc f (vector-at R 0) self (sel f R name) a b c))
(defn- nsstring [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 s :string] :i64
  (msg f R (cc f (vector-at R 2) (cstr f (vector-at R 3) "NSString") 0 0 0 0)
       "stringWithUTF8String:" (cstr f (vector-at R 3) s) 0 0))

;; The text of an NSError on stderr, then a trap: a refused kernel is never a
;; silent wrong answer.
(defn- refuse [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 err :i64] :i64
  (let [d (msg f R err "localizedDescription" 0 0 0)
        t (msg f R d "UTF8String" 0 0 0)
        strlen (sym f "strlen")
        n (cc f strlen t 0 0 0 0)
        w (cc f (sym f "write") 2 t n 0 0)]
    (vector-at [0] 1)))

;; ---- the same inputs as q8_cpu.kotoba.in ------------------------------------
(defn- lcg [s :i64] :i64
  (bit-and (+ (* s 1103515245) 12345) 2147483647))

;; Weights: eight signed bytes per word, stored as they would be in a GGUF row.
;; No vector per word: a matrix of millions of words must not spend vector handles.
(defn- fill-weights [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 seed :i64] :i64
  (loop [i 0 j 0 w 0 s seed]
    (cond (= i n) s
          (= j 8) (let [u (poke f (+ p (* i 8)) w)] (recur (+ i 1) 0 0 s))
          :else (let [m (lcg s)]
                  (recur i (+ j 1)
                         (bit-or w (i64-shift-left (bit-and (i64-shift-right m 16) 255) (* 8 j)))
                         m)))))

;; Block scales as 32-bit integers, two per word.
(defn- fill-scales [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 seed :i64] :i64
  (loop [i 0 s seed w 0]
    (if (= i n)
      (let [u (if (= (bit-and n 1) 1) (poke f (+ p (* (quot n 2) 8)) w) 0)] s)
      (let [t (lcg s)
            v (+ 1 (bit-and (i64-shift-right t 8) 1023))]
        (if (= (bit-and i 1) 0)
          (recur (+ i 1) t v)
          (let [u (poke f (+ p (* (quot i 2) 8)) (bit-or w (i64-shift-left v 32)))]
            (recur (+ i 1) t 0)))))))

;; Activations as signed bytes, eight per word.
(defn- fill-x [f [:fn [[:i64 :i64 :i64] :i64]] p :i64 n :i64 seed :i64] :i64
  (loop [i 0 s seed]
    (if (= i n) s
      (let [t (lcg s)
            u (poke8 f (+ p i) (- (bit-and (i64-shift-right t 16) 255) 128))]
        (recur (+ i 1) t)))))

(defn- new-buffer [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 device :i64 n :i64] :i64
  (let [b (msg f R device "newBufferWithLength:options:" n 0 0)]
    (if (= b 0) (vector-at [0] 1) b)))
(defn- contents [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 b :i64] :i64
  (msg f R b "contents" 0 0 0))

;; ---- one dispatch: (rows, 1, 1) threads, width threads per threadgroup ------
(defn- run-once [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 queue :i64 pso :i64 B :vector-i64 width :i64] :i64
  (let [base (scratch f)
        grid (+ base 128)
        group (+ base 152)
        u0 (poke f grid (rows)) u1 (poke f (+ grid 8) 1) u2 (poke f (+ grid 16) 1)
        u3 (poke f group width) u4 (poke f (+ group 8) 1) u5 (poke f (+ group 16) 1)
        cb (msg f R queue "commandBuffer" 0 0 0)
        en (msg f R cb "computeCommandEncoder" 0 0 0)
        u6 (msg f R en "setComputePipelineState:" pso 0 0)
        u7 (loop [i 0]
             (if (= i (vector-count B)) 0
               (let [u (msg f R en "setBuffer:offset:atIndex:" (vector-at B i) 0 i)] (recur (+ i 1)))))
        u8 (msg f R en "dispatchThreads:threadsPerThreadgroup:" grid group 0)
        u9 (msg f R en "endEncoding" 0 0 0)
        u10 (msg f R cb "commit" 0 0 0)
        u11 (msg f R cb "waitUntilCompleted" 0 0 0)
        st (msg f R cb "status" 0 0 0)]
    (if (= st 4) 0 (refuse f R (msg f R cb "error" 0 0 0)))))

(defn- fold-rows [f [:fn [[:i64 :i64 :i64] :i64]] out :i64 c0 :i64] :i64
  (let [n (rows)]
    (loop [r 0 c c0]
      (if (= r n) c
        (recur (+ r 1) (bit-and (+ (* c 31) (peek f (+ out (* r 8)))) (mask48)))))))

;; The fastest and the total GPU time of the dispatches, in mach ticks, on stderr as decimal.
(defn- report [f [:fn [[:i64 :i64 :i64] :i64]] R :vector-i64 best :i64 total :i64] :i64
  (let [base (scratch f)
        tb (+ base 192)
        u (cc f (sym f "mach_timebase_info") tb 0 0 0 0)
        w (peek f tb)
        numer (bit-and w 4294967295)
        denom (u64-shift-right w 32)
        text (string-concat "metal-dispatch-ns best " (string-concat (string-from-i64 (quot (* best numer) denom))
             (string-concat " total " (string-concat (string-from-i64 (quot (* total numer) denom)) "\n"))))
        p (cstr f (vector-at R 3) text)]
    (cc f (sym f "write") 2 p (string-length text) 0 0)))

(defn main [] :i64
  (let [f (__r6-as [:fn [[:i64 :i64 :i64] :i64]] (typed-cap-call :gpu/compute :string :string ""))
        dlopen (sym f "dlopen")
        h1 (open-framework f dlopen "/System/Library/Frameworks/Foundation.framework/Foundation")
        h2 (open-framework f dlopen "/System/Library/Frameworks/Metal.framework/Metal")
        now (sym f "mach_absolute_time")
        R (vector-i64 (sym f "objc_msgSend") (sym f "sel_registerName") (sym f "objc_getClass") (sym f "malloc"))
        device (cc f (sym f "MTLCreateSystemDefaultDevice") 0 0 0 0 0)
        dev (if (= device 0) (vector-at [0] 1) device)
        queue (msg f R dev "newCommandQueue" 0 0 0)
        base (scratch f)
        errp (+ base 184)
        u0 (poke f errp 0)
        lib (msg f R dev "newLibraryWithSource:options:error:" (nsstring f R (kernel-source)) 0 errp)
        u1 (if (= lib 0) (refuse f R (peek f errp)) 0)
        kfn (msg f R lib "newFunctionWithName:" (nsstring f R "q8_matvec") 0 0)
        u2 (if (= kfn 0) (vector-at [0] 1) 0)
        pso (msg f R dev "newComputePipelineStateWithFunction:error:" kfn errp 0)
        u3 (if (= pso 0) (refuse f R (peek f errp)) 0)
        width (msg f R pso "threadExecutionWidth" 0 0 0)
        nb (blocks)
        nw (quot (* (rows) (cols)) 8)
        bw (new-buffer f R dev (* nw 8))
        bs (new-buffer f R dev (* (+ (* (rows) nb) 1) 4))
        bx (new-buffer f R dev (cols))
        bq (new-buffer f R dev (* (+ nb 1) 4))
        bo (new-buffer f R dev (* (rows) 8))
        s1 (fill-weights f (contents f R bw) nw 12345)
        s2 (fill-scales f (contents f R bs) (* (rows) nb) s1)
        s3 (fill-x f (contents f R bx) (cols) s2)
        s4 (fill-scales f (contents f R bq) nb s3)
        out (contents f R bo)
        B (vector-i64 bw bs bx bq bo)]
    (loop [i 0 c (bit-and s4 (mask48)) best 9223372036854775807 total 0]
      (if (= i (reps))
        (let [u (report f R best total)] c)
        (let [t0 (cc f now 0 0 0 0 0)
              u (run-once f R queue pso B width)
              t1 (cc f now 0 0 0 0 0)
              d (- t1 t0)]
          (recur (+ i 1) (fold-rows f out c) (if (< d best) d best) (+ total d)))))))
