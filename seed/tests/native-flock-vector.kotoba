(ns seed.flock-vector (:export [main]))
(defn- request [path :string op :string] :bool
 (= (typed-cap-call :fs/app-data :string :string (string-concat path op)) "1"))
(defn- dirty [] :bool
 (arena-scope (let [v (vector-assoc! (vector-alloc 4096) 4095 71)]
   (= (vector-at v 4095) 71))))
(defn- clean [] :bool
 (arena-scope (let [v (vector-alloc 8192)]
   (loop [i 0] (if (= i 8192) true
     (and (= (vector-at v i) 0) (recur (inc i))))))))
(defn main [] :i64
 (let [path (typed-cap-call :cli/args :string :string "0")
       normalized (typed-cap-call :cli/args :string :string "1")
       link (typed-cap-call :cli/args :string :string "2")
       outside (typed-cap-call :cli/args :string :string "3")
       outer (vector-assoc! (vector-alloc 64) 63 93)
       acquired (request path "FLOCK_SEP")
       reentry (request path "FLOCK_SEP")
       wrong-unlock (request (string-concat path ".wrong") "UNLOCK_SEP")
       reused (and (dirty) (clean))
       released (request normalized "UNLOCK_SEP")
       double-unlock (request path "UNLOCK_SEP")
       clean-after-release (and (dirty) (clean))
       again (request path "FLOCK_SEP")
       final (request path "UNLOCK_SEP")
       escaped (request outside "FLOCK_SEP")
       linked (request link "FLOCK_SEP")]
  (if (and acquired (not reentry) (not wrong-unlock) reused released
           (not double-unlock) clean-after-release again final
           (not escaped) (not linked) (= (vector-at outer 63) 93)) 0 1)))
