(ns x86-project-fs.io
  (:export [roundtrip emit-stdout emit-stderr entropy-valid])
  (:capabilities [:fs/app-data :io/write :io/write-error :entropy/draw]))
(defn- fs [request :string] :string
  (typed-cap-call :fs/app-data :string :string request))
(defn roundtrip [base :string] :bool
  (let [lock (string-concat base "/lock") pending (string-concat base "/pending")
        final (string-concat base "/final")]
    (and (= (fs (string-concat lock "FLOCK_SEP")) "1")
         (= (fs (string-concat pending "WRITE_SEPnative")) "native")
         (= (fs (string-concat pending "FSYNC_SEP")) "1")
         (= (fs (string-concat pending (string-concat "RENAME_SEP" final))) "1")
         (= (fs (string-concat base "FSYNC_SEP")) "1")
         (= (fs final) "native")
         (= (fs (string-concat lock "UNLOCK_SEP")) "1"))))
(defn emit-stdout [] :bool
  (= (typed-cap-call :io/write :string :string "kotoba-stdout-marker")
     "kotoba-stdout-marker"))
(defn emit-stderr [] :bool
  (= (typed-cap-call :io/write-error :string :string "kotoba-stderr-marker")
     "kotoba-stderr-marker"))
(defn- hex? [value :string index :i64] :bool
  (if (= index (string-length value)) true
    (let [c (string-code-point-at value index)]
      (and (or (and (>= c 48) (<= c 57))
               (and (>= c 97) (<= c 102)))
           (hex? value (inc index))))))
(defn entropy-valid [] :bool
  (let [bytes (typed-cap-call :entropy/draw :string :string "32")]
    (and (= (string-length bytes) 64) (hex? bytes 0))))
