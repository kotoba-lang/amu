;; R6M: string-join (two or more items) and string-replace-all
(ns r6m.p05 (:export [main]))
(defn main [] :i64
  (+ (string-length (string-join "-" "a" "bc" "def"))
     (+ (* 100 (string-length (string-replace-all "a.b.c." "." "::")))
        (* 10000 (string-length (string-replace-all "xyz" "q" "--"))))))
