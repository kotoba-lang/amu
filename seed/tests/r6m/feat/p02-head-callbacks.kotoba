;; R6M: an operation head as the callback of reduce / map / filter (the heads stage-0 admits as values: + * bit-and bit-or
;; bit-xor inc dec)
(ns r6m.p02 (:export [main]))
(defn main [] :i64
  (+ (reduce + 0 [1 2 3 4])
     (+ (* 100 (reduce * 1 (map inc [1 2 3])))
        (+ (* 10000 (reduce bit-xor 0 [5 6]))
           (+ (reduce bit-or 0 [8 16])
              (reduce + 0 (map dec [10 20])))))))
