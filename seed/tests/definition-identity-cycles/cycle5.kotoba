;; seed/tests/definition-identity-cycles/cycle5.kotoba -- a recursive group for kotoba.compiler.definition-identity's ordering choice
;; (best-candidate). Compare the Kotoba route with the host: seed/tests/compile-cli/run.sh <objects> <work> <list of these>.
(defn p1 [n] (if (<= n 0) 1 (+ (p2 (- n 1)) (p5 (- n 2)))))
(defn p2 [n] (if (<= n 0) 2 (+ (p3 (- n 1)) (p1 (- n 3)))))
(defn p3 [n] (if (<= n 0) 3 (* 2 (p4 (- n 1)))))
(defn p4 [n] (if (<= n 0) 4 (+ (p5 (- n 1)) (p2 (- n 2)) (p3 (- n 4)))))
(defn p5 [n] (if (<= n 0) 5 (- (p1 (- n 1)) 1)))
(defn main [] (p1 6))
