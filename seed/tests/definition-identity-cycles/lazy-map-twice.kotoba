;; seed/tests/definition-identity-cycles/lazy-map-twice.kotoba -- a recursive group for kotoba.compiler.definition-identity's ordering choice
;; (best-candidate). Compare the Kotoba route with the host: seed/tests/compile-cli/run.sh <objects> <work> <list of these>.
(defn naturals [n]
  (lazy-cons n (naturals (+ n 1))))

(defn main []
  (let [inc1 (fn [x] (+ x 1))] (lazy-first (lazy-map inc1 (lazy-map inc1 (naturals 37))))))
