(ns t (:export [f]))
(defn- a0 [w :i64 n :i64] :i64 (kernel-load-u32 w n 0))
(defn- a1 [w :i64 n :i64] :i64 (+ (a0 w n) (a0 w n) (a0 w n) (a0 w n)))
(defn- a2 [w :i64 n :i64] :i64 (+ (a1 w n) (a1 w n) (a1 w n) (a1 w n)))
(defn- a3 [w :i64 n :i64] :i64 (+ (a2 w n) (a2 w n) (a2 w n) (a2 w n)))
(defn- a4 [w :i64 n :i64] :i64 (+ (a3 w n) (a3 w n) (a3 w n) (a3 w n)))
(defn- a5 [w :i64 n :i64] :i64 (+ (a4 w n) (a4 w n) (a4 w n) (a4 w n)))
(defn- a6 [w :i64 n :i64] :i64 (+ (a5 w n) (a5 w n) (a5 w n) (a5 w n)))
(defn- a7 [w :i64 n :i64] :i64 (+ (a6 w n) (a6 w n) (a6 w n) (a6 w n)))
(defn- bad [w :i64 n :i64] :i64 (a3 (+ w 8) n))
(defn f [b :i64 n :i64 i :i64] :i64 (+ (a7 b n) (bad b n)))
