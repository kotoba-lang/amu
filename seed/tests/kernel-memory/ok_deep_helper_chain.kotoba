(ns t (:export [f]))
(defn- a [w :i64 i :i64] :i64 (kernel-load-u32 (kernel-subregion w 64 (* i 4) 4) 4 0))
(defn- b [w :i64] :i64 (a w 1))
(defn- c [w :i64] :i64 (b w))
(defn- d [w :i64] :i64 (c w))
(defn- e [w :i64] :i64 (d w))
(defn- g [w :i64] :i64 (e w))
(defn- h [w :i64] :i64 (g w))
(defn f [b0 :i64 n :i64 i :i64] :i64 (let [w (kernel-subregion b0 n 0 64)] (h w)))
