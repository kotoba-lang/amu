;; deps: 10-lex 11-read 12-kirread 20-names 21-check 30-lower 40-a64enc 41-a64gen 42-layout 50-out
;; seed/tests/unit/90-drv_t.kotoba -- the driver with the unit argv (<repo> <scratch>: no command) answers usage with
;; status 2 (and E1 on stderr). The compile path itself is gate G1 (scripts/seed/g1.sh).
(defn- t-verdict [r :i64] :string
  (if (= r 2) "drv-main usage status 2\n" "drv-main WRONG status\n"))
(defn- seed-main [] :i64
  (let [r (drv-main)
        o (typed-cap-call :io/write :string :string (t-verdict r))]
    0))
