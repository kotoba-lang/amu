        g3 (vector-at M1 MM-POOL-OFF)
        C0 (t-chk M1 "pool-nolit ERR" g0 0)
        C1 (t-chk C0 "nolit R0" g1 8)
        C2 (t-chk C1 "nolit CODE-BYTES" g2 8)
        C3 (t-chk C2 "nolit POOL-OFF" g3 8)]
    C3))
(defn- t-pool-odd [M0 :vector-i64] :vector-i64
  (let [W1 (vector-assoc! M0 MM-CODE-N 4)
        W2 (vector-assoc! W1 MM-FIX-N 1)
        W3 (vector-assoc! W2 MM-LIT-N 3)
        W4 (vector-assoc! W3 MM-FN-N 1)
        W5 (vector-assoc! W4 MM-EXP-N 1)
        W6 (vector-assoc! W5 MM-ERR 0)
        W7 (vector-assoc! W6 MM-ERR-POS 0)
        W8 (vector-assoc! W7 MM-ERR-N 0)
        W9 (vector-assoc! W8 MM-R0 0)
        W10 (vector-assoc! W9 MM-POOL-OFF 0)
        W11 (vector-assoc! W10 MM-CODE-BYTES 0)
        W12 (vector-assoc! W11 (+ (+ MM-LIT-BASE (* 1 MM-LIT-W)) LF-LEN) 1)
        W13 (vector-assoc! W12 (+ (+ MM-LIT-BASE (* 2 MM-LIT-W)) LF-LEN) 9)
        M1 (ly-run W13)
        g0 (vector-at M1 MM-ERR)
        g1 (vector-at M1 MM-R0)
        g2 (vector-at M1 MM-POOL-OFF)
        g3 (vector-at M1 (+ (+ MM-LIT-BASE (* 1 MM-LIT-W)) LF-POOL))
        g4 (vector-at M1 (+ (+ MM-LIT-BASE (* 2 MM-LIT-W)) LF-POOL))
        C0 (t-chk M1 "pool-odd ERR" g0 0)
        C1 (t-chk C0 "odd R0" g1 33)
        C2 (t-chk C1 "odd POOL-OFF" g2 16)
        C3 (t-chk C2 "odd pool1" g3 16)
        C4 (t-chk C3 "odd pool2" g4 24)]
    C4))
(defn- t-lit32-hi16 [M0 :vector-i64] :vector-i64
  (let [W1 (vector-assoc! M0 MM-CODE-N 100)
        W2 (vector-assoc! W1 MM-FIX-N 2)
        W3 (vector-assoc! W2 MM-LIT-N 3)
        W4 (vector-assoc! W3 MM-FN-N 1)
        W5 (vector-assoc! W4 MM-EXP-N 1)
        W6 (vector-assoc! W5 MM-ERR 0)
        W7 (vector-assoc! W6 MM-ERR-POS 0)
        W8 (vector-assoc! W7 MM-ERR-N 0)
        W9 (vector-assoc! W8 MM-R0 0)
        W10 (vector-assoc! W9 MM-POOL-OFF 0)
        W11 (vector-assoc! W10 MM-CODE-BYTES 0)
        W12 (vector-assoc! W11 (+ (+ MM-FIX-BASE (* 1 MM-FIX-W)) XF-AT) 10)
        W13 (vector-assoc! W12 (+ (+ MM-FIX-BASE (* 1 MM-FIX-W)) XF-KIND) FX-LIT32)
        W14 (vector-assoc! W13 (+ (+ MM-FIX-BASE (* 1 MM-FIX-W)) XF-TARGET) 2)
        W15 (vector-assoc! W14 (+ MM-CODE-BASE 10) 3531603969)
        W16 (vector-assoc! W15 (+ MM-CODE-BASE 11) 4070572033)
        W17 (vector-assoc! W16 (+ (+ MM-LIT-BASE (* 1 MM-LIT-W)) LF-LEN) 70000)
        W18 (vector-assoc! W17 (+ (+ MM-LIT-BASE (* 2 MM-LIT-W)) LF-LEN) 3)
        M1 (ly-run W18)
        g0 (vector-at M1 MM-ERR)
        g1 (vector-at M1 (+ MM-CODE-BASE 10))
        g2 (vector-at M1 (+ MM-CODE-BASE 11))
        C0 (t-chk M1 "lit32-hi16 ERR" g0 0)
        C1 (t-chk C0 "hi movz" g1 3531759617)
        C2 (t-chk C1 "hi movk" g2 4070572065)]
    C2))
(defn- t-all [A0 :vector-i64] :i64
  (let [A1 (t-s1 A0)
        A2 (t-e-b26-range A1)
        A3 (t-e-b26-far-in-range A2)
        A4 (t-e-bc19-range A3)
        A5 (t-e-bc19-range-neg A4)
        A6 (t-e-cb19-range A5)
        A7 (t-e-undef-label A6)
        A8 (t-e-label-beyond A7)
        A9 (t-e-lit-not-movz A8)
        A10 (t-e-lit-bad-index A9)
        A11 (t-e-bad-kind A10)
        A12 (t-e-bl-bad-fn A11)
        A13 (t-e-first-wins A12)
        A14 (t-e-export-no-code A13)
        A15 (t-ok-bc19-max A14)
        A16 (t-ok-bc19-min A15)
        A17 (t-ok-b26-self A16)
        A18 (t-ok-bl-backward A17)
        A19 (t-ok-label-at-end A18)
        A20 (t-pool-empty A19)
        A21 (t-pool-nolit A20)
        A22 (t-pool-odd A21)
        A23 (t-lit32-hi16 A22)
        fails (vector-at A23 200)]
    fails))
(defn- seed-main [] :i64
  (let [o (t-say "42-layout unit test\n")
        p (t-pures)
        n (t-all (t-init))
        o2 (t-say (string-concat "pure failures " (string-concat (t-dec p) (string-concat ", scenario failures " (string-concat (t-dec n) "\n")))))]
    (+ p n)))
