;; deps: 10-lex 11-read 20-names 21-check
;; seed/tests/unit/30-lower_t.kotoba -- unit test of 30-lower: SIR dump goldens and the SIR interpreter gate.
;; Owner: 30-lower. Guest argv: 0 = repo root, 1 = scratch dir (unit.sh), 2 = optional program path relative to
;; the repo (default seed/tests/unit/30-lower-in.kotoba), 3 = "dump" to print the SIR (the default program is
;; always dumped). scripts/seed/lw-gate.sh runs the 19 ports and the corpus through argv 2.
;; For every exported arity-0 function it prints `<name> = <result> status <s> fuel <f>` from lw-interp.
;;
;; The front end is the real one (lx-run rd-run nm-run ck-run). scripts/seed/lw-gate.sh can swap ck-run for the
;; stand-in checker seed/tests/unit/30-lower-stubck.kotoba (LW_CHECK=0) while 21-check is not buildable.

;; ---------------------------------------------------------------------------------------------------------
;; output helpers
;; ---------------------------------------------------------------------------------------------------------
(defn- t-out [s :string] :i64
  (let [o (typed-cap-call :io/write :string :string s)] 0))
(defn- t-ch [c :i64] :string
  (cond (= c 97) "a" (= c 98) "b" (= c 99) "c" (= c 100) "d" (= c 101) "e" (= c 102) "f" (= c 103) "g" (= c 104) "h" (= c 105) "i" (= c 106) "j" (= c 107) "k" (= c 108) "l" (= c 109) "m" (= c 110) "n" (= c 111) "o" (= c 112) "p" (= c 113) "q" (= c 114) "r" (= c 115) "s" (= c 116) "t" (= c 117) "u" (= c 118) "v" (= c 119) "w" (= c 120) "x" (= c 121) "y" (= c 122) "z" (= c 65) "A" (= c 66) "B" (= c 67) "C" (= c 68) "D" (= c 69) "E" (= c 70) "F" (= c 71) "G" (= c 72) "H" (= c 73) "I" (= c 74) "J" (= c 75) "K" (= c 76) "L" (= c 77) "M" (= c 78) "N" (= c 79) "O" (= c 80) "P" (= c 81) "Q" (= c 82) "R" (= c 83) "S" (= c 84) "T" (= c 85) "U" (= c 86) "V" (= c 87) "W" (= c 88) "X" (= c 89) "Y" (= c 90) "Z" (= c 48) "0" (= c 49) "1" (= c 50) "2" (= c 51) "3" (= c 52) "4" (= c 53) "5" (= c 54) "6" (= c 55) "7" (= c 56) "8" (= c 57) "9" (= c 45) "-" (= c 33) "!" (= c 63) "?" (= c 42) "*" (= c 43) "+" (= c 60) "<" (= c 62) ">" (= c 61) "=" (= c 47) "/" (= c 46) "." (= c 95) "_" :else "~"))
(defn- t-span [S :string a :i64 b :i64] :string
  (if (>= a b) "" (string-concat (t-ch (string-code-point-at S a)) (t-span S (+ a 1) b))))
(defn- t-symname [M :vector-i64 S :string s :i64] :string
  (t-span S (vector-at M (+ MM-SYM-BASE (+ (* s MM-SYM-W) SF-START)))
          (vector-at M (+ MM-SYM-BASE (+ (* s MM-SYM-W) SF-END)))))
(defn- t-opname [op :i64] :string
  (cond (= op OP-FN) "FN" (= op OP-END) "END" (= op OP-CONST) "CONST" (= op OP-LGET) "LGET"
        (= op OP-LSET) "LSET" (= op OP-BIN) "BIN" (= op OP-CMP) "CMP" (= op OP-UN) "UN" (= op OP-LABEL) "LABEL"
        (= op OP-BR) "BR" (= op OP-BRZ) "BRZ" (= op OP-BRNZ) "BRNZ" (= op OP-CALL) "CALL" (= op OP-RT) "RT"
        (= op OP-CAP) "CAP" (= op OP-STR) "STR" (= op OP-VEC) "VEC" (= op OP-FUEL) "FUEL" (= op OP-RET) "RET"
        (= op OP-TRAP) "TRAP" (= op OP-TAB) "TAB" :else "?"))
(defn- t-digit [d :i64] :string
  (cond (= d 0) "0" (= d 1) "1" (= d 2) "2" (= d 3) "3" (= d 4) "4"
        (= d 5) "5" (= d 6) "6" (= d 7) "7" (= d 8) "8" :else "9"))
(defn- t-dpos [n :i64] :string
  (if (< n 10) (t-digit n) (string-concat (t-dpos (quot n 10)) (t-digit (- n (* 10 (quot n 10)))))))
(defn- t-d [n :i64] :string
  (if (< n 0)
    (if (= n (i64-shift-left 1 63)) "-9223372036854775808" (string-concat "-" (t-dpos (- 0 n))))
    (t-dpos n)))

;; the heap as 01-mem's mem-new makes it (own copy: this test does not depend on 01-mem)
(defn- t-fills [M0 :vector-i64 i :i64] :vector-i64
  (if (> i MM-OUT-N) M0 (t-fills (lw-put M0 i 1) (+ i 1))))
(defn- t-new [] :vector-i64
  (let [M0 (vector-alloc MM-WORDS)
        M1 (lw-put M0 MM-VERSION MM-LAYOUT-VERSION)
        M2 (t-fills M1 MM-TOK-N)
        M3 (lw-put M2 MM-HASH-N 0)
        M4 (lw-put M3 MM-HEAP-TOP MM-HEAP-BASE)]
    (lw-put M4 MM-ERR-POS -1)))

;; ---------------------------------------------------------------------------------------------------------
;; SIR dump and the interpreter runs
;; ---------------------------------------------------------------------------------------------------------
(defn- t-dump [M :vector-i64 i :i64] :i64
  (if (>= i (vector-at M MM-SIR-N))
    0
    (let [o (t-out (string-concat (t-d i) (string-concat " " (string-concat (t-opname (lw-sir M i IF-OP))
              (string-concat " " (string-concat (t-d (lw-sir M i IF-A)) (string-concat " "
              (string-concat (t-d (lw-sir M i IF-B)) (string-concat " " (string-concat (t-d (lw-sir M i IF-C)) "\n"))))))))))]
      (t-dump M (+ i 1)))))

(defn- t-fninfo [M :vector-i64 S :string f :i64] :i64
  (t-out (string-concat "fn " (string-concat (t-symname M S (lw-ff M f FF-SYM)) (string-concat " nslots "
    (string-concat (t-d (lw-ff M f FF-NSLOTS)) (string-concat " depth " (string-concat (t-d (lw-ff M f FF-DEPTH))
    (string-concat " fuel " (string-concat (t-d (lw-ff M f FF-FUEL)) "\n"))))))))))

(defn- t-fninfos [M :vector-i64 S :string f :i64] :i64
  (if (>= f (vector-at M MM-FN-N))
    0
    (+ (t-fninfo1 M S f) (t-fninfos M S (+ f 1)))))
(defn- t-fninfo1 [M :vector-i64 S :string f :i64] :i64
  (if (= (lw-ff M f FF-KIND) FK-DEF) 0 (t-fninfo M S f)))

(defn- t-hsize [] :i64 6000000)
(defn- t-runnable [M :vector-i64 f :i64] :i64
  (if (= (lw-ff M f FF-EXPORT) 1) (if (= (lw-ff M f FF-NPARAMS) 0) 1 0) 0))
(defn- t-bad [st :i64 r :i64] :i64 (if (= st 0) (if (= r 1) 0 1) 1))
(defn- t-maybe-dump [M :vector-i64 S :string dump :i64] :i64
  (if (= dump 1) (+ (t-fninfos M S 1) (t-dump M 1)) 0))
(defn- t-status [bad :i64] :i64 (if (= bad 0) 0 1))

;; run every exported arity-0 function; returns the number whose result is not 1 or whose status is not 0
(defn- t-runs [M :vector-i64 S :string H0 :vector-i64 f :i64 bad :i64] :i64
  (if (>= f (vector-at M MM-FN-N))
    bad
    (if (= (t-runnable M f) 1)
      (let [H1 (lw-interp M H0 (t-hsize) f 0)
            st (vector-at H1 0)
            r (vector-at H1 1)
            fu (vector-at H1 4)
            o (t-out (string-concat (t-symname M S (lw-ff M f FF-SYM)) (string-concat " = " (string-concat (t-d r)
                (string-concat " status " (string-concat (t-d st) (string-concat " fuel " (string-concat (t-d fu) "\n"))))))))
            b2 (+ bad (t-bad st r))]
        (t-runs M S H1 (+ f 1) b2))
      (t-runs M S H0 (+ f 1) bad))))

(defn- t-err [M :vector-i64 phase :string] :i64
  (t-out (string-concat phase (string-concat " error E" (string-concat (t-d (vector-at M MM-ERR))
    (string-concat " pos " (string-concat (t-d (vector-at M MM-ERR-POS)) (string-concat " n "
    (string-concat (t-d (vector-at M MM-ERR-N)) "\n")))))))))

(defn- t-default-prog [a :string] :string
  (if (= (string-length a) 0) "seed/tests/unit/30-lower-in.kotoba" a))
(defn- t-dump-flag [a :string prog :string] :i64
  (if (= (string-length prog) 0) 1 (if (= (string-length a) 4) 1 0)))

(defn- t-main2 [M0 :vector-i64 S :string dump :i64] :i64
  (let [M1 (lx-run M0 S)
        M2 (rd-run M1 S)
        M3 (nm-run M2 S)]
    (if (> (vector-at M3 MM-ERR) 0)
      (+ 2 (t-err M3 "frontend"))
      (let [M4 (ck-run M3 S)
            M5 (lw-run M4)
            nsir (vector-at M5 MM-R0)]
        (if (> (vector-at M5 MM-ERR) 0)
          (+ 2 (t-err M5 "check/lower"))
          (let [o1 (t-out (string-concat "sir " (string-concat (t-d nsir) (string-concat " labels "
                     (string-concat (t-d (- (vector-at M5 MM-LABEL-N) 1)) (string-concat " maxdepth "
                     (string-concat (t-d (vector-at M5 MM-MAX-DEPTH)) "\n")))))))
                o2 (t-maybe-dump M5 S dump)
                bad (t-runs M5 S (vector-alloc (t-hsize)) 1 0)
                o4 (t-out (string-concat "not-1 " (string-concat (t-d bad) "\n")))]
            (t-status bad)))))))

(defn- seed-main [] :i64
  (let [root (typed-cap-call :cli/args :string :string "0")
        a2 (typed-cap-call :cli/args :string :string "2")
        a3 (typed-cap-call :cli/args :string :string "3")
        prog (t-default-prog a2)
        dump (t-dump-flag a3 a2)
        S (typed-cap-call :fs/app-data :string :string (string-concat root (string-concat "/" prog)))
        o (t-out (string-concat "program " (string-concat prog (string-concat " bytes " (string-concat (t-d (string-length S)) "\n")))))]
    (t-main2 (t-new) S dump)))
