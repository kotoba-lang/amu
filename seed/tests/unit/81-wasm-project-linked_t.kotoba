;; Compile two independently checked function sets, link their Wasm indices,
;; and emit a module; the second calls the first through an imported stub.
(defn- xg-default [] :i64 2)
(defn- seed-main [] :i64
  (let [S1 "(ns dep (:export [dep]))\n(defn dep [x :i64] :i64 (+ x 1))\n"
        L (pj-new-l) V (vector-alloc 2)
        P (pj-padd L (pj-padd L (pj-new-p L) "dep") "/dep.kotoba")
        registered (pj-add-mod L 0 1)
        M1 (xg-front S1)
        a1 (mem-set M1 197 (string-length S1))
        refused (xw-project-compile-library a1 L V P S1 1 0 4 0)
        failure (vector-at M1 MM-ERR) no-iface (pj-l L pj-k-nif) no-image (pj-l L pj-k-img)
        clear (mem-set M1 MM-ERR 0)
        iface (xw-project-compile-library clear L V P S1 1 0 5 0)]
    (if (or (= failure 0) (not= no-iface 0) (not= no-image 0)) 19
      (if (not (pj-ok M1)) 11
      (let [trailer (pj-stub L iface 0 "dep" 0)
            S2 (string-concat "(ns app (:export [main]))\n(defn main [] :i64 (dep 41))\n" trailer)
            M2 (xg-front S2) stub (pj-fn-named M2 S2 "dep") main (pj-fn-named M2 S2 "main")
            a2 (mem-set M2 197 (string-length S2))
            save2 (xw-project-compile-unit a2 L V S2 stub 1 6)
            entry (xw-idx M2 main)]
        (cond (not (pj-ok M1)) 15 (not= (pj-l L pj-k-nif) 1) 16
              (not= (pj-l L pj-k-nstub) 1) 17 (not= (pj-l L pj-t-base) 5) 18
              (not (pj-ok save2)) 12 (not= entry 6) 13
              :else (let [wasm (xw-project-module M2 L V 2 entry)]
                      (if (not (pj-ok wasm)) 14
                        (let [start (io-out "LINKED-BEGIN\n")
                              bytes (io-write-hex M2 (+ MM-OUT-BASE 1) (- (vector-at M2 MM-OUT-N) 1))
                              end (io-out "LINKED-END\n")]
                          0)))))))))
