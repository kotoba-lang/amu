;; Project stub index binding and emitted call controls.
(defn- xg-default [] :i64 2)
(defn- t-bound-call? [M :vector-i64 i :i64] :bool
  (if (>= (+ i 1) (xg-pos M)) false
    (if (and (or (= (xg-code-byte M i) 16) (= (xg-code-byte M i) 18))
             (= (xg-code-byte M (+ i 1)) 5)) true
      (t-bound-call? M (+ i 1)))))
(defn- t-archive-equal? [M :vector-i64 L :vector-i64 src :i64 end :i64 dst :i64] :bool
  (if (>= src end) true
    (and (= (xg-code-byte M src) (pj-ib L dst)) (t-archive-equal? M L (+ src 1) end (+ dst 1)))))
(defn- t-archive-u32 [L :vector-i64 at :i64] :i64
  (bit-or (bit-or (pj-ib L at) (i64-shift-left (pj-ib L (+ at 1)) 8))
          (bit-or (i64-shift-left (pj-ib L (+ at 2)) 16) (i64-shift-left (pj-ib L (+ at 3)) 24))))
(defn- t-uleb-end [M :vector-i64 at :i64] :i64
  (if (< (xg-code-byte M at) 128) (+ at 1) (t-uleb-end M (+ at 1))))
(defn- t-uleb-value [M :vector-i64 at :i64 shift :i64] :i64
  (let [b (xg-code-byte M at) part (i64-shift-left (bit-and b 127) shift)]
    (if (< b 128) part (bit-or part (t-uleb-value M (+ at 1) (+ shift 7))))))
(defn- t-archive-payload [M :vector-i64 L :vector-i64 size :i64] :i64
  (let [ready (-> M (mem-set MM-ERR 0) (mem-set MM-CODE-N 1))
        types (xw-project-archive-types ready L 6 2)]
    (cond (not (pj-ok types)) 62
          (not= (xg-pos M) 3) 63
          (or (not= (xg-code-byte M 0) 2) (not= (xg-code-byte M 1) 0)
              (not= (xg-code-byte M 2) 0)) 64
          :else (let [reset (mem-set M MM-CODE-N 1)
                      bodies (xw-project-archive-bodies reset L 6 2)
                      len1 (t-archive-u32 L 5) len2 (t-archive-u32 L (+ size 5))
                      p1 (t-uleb-end M 1) p2 (+ p1 len1) p3 (t-uleb-end M p2)]
                  (cond (not (pj-ok bodies)) 65
                        (not= (xg-code-byte M 0) 2) 66
                        (not= (t-uleb-value M 1 0) len1) 67
                        (not= (t-uleb-value M p2 0) len2) 68
                        (not (t-archive-equal? M L p1 p2 9)) 69
                        (not (t-archive-equal? M L p3 (+ p3 len2) (+ size 9))) 70
                        (not= (xg-pos M) (+ p3 len2)) 71
                        :else (let [bad (pj-ibset L size 99)
                                    reset2 (mem-set M MM-CODE-N 1)
                                    rejected (xw-project-archive-bodies reset2 bad 6 2)]
                                (cond (pj-ok rejected) 72
                                      (not= (xg-pos M) 0) 73
                                      :else (let [clear (mem-set M MM-ERR 0)
                                                  rejected-types (xw-project-archive-types clear bad 6 2)]
                                              (cond (pj-ok rejected-types) 74
                                                    (not= (xg-pos M) 0) 75
                                                    :else 0)))))))))
(defn- t-project-stubs [] :i64
  (let [S "(ns app (:export [main]))\n(defn main [] :i64 (dep 41))\n(defn- dep [x :i64] :i64 0)\n"
        M (xg-front S) L (pj-new-l)
        main-f (pj-fn-named M S "main") stub (pj-fn-named M S "dep")
        target (pj-ls L pj-t-base 5)
        assigned (xw-project-assign M L S stub 1 6)
        prepared (-> assigned (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1))
        code (xw-project-code prepared 1 stub 1)
        begin (xw-fix code 1 0) end (xw-fix code 1 3)
        archive (xw-project-archive code L 6) size (pj-l L pj-k-img)]
    (cond (not (pj-ok code)) 31
          (= main-f 0) 32
          (not= stub (- (vector-at M MM-FN-N) 1)) 33
          (not= (xw-idx M main-f) 6) 34
          (not= (xw-idx M stub) 5) 35
          (not= (xg-get M 3) 2) 36
          (not= (vector-at M MM-FIX-N) 2) 37
          (not (t-bound-call? M 1)) 38
          (not= (t-archive-u32 L 0) 6) 46
          (not= (pj-ib L 4) 0) 47
          (not= (t-archive-u32 L 5) (- end begin)) 48
          (not= size (+ 9 (- end begin))) 49
          (not (t-archive-equal? M L begin end 9)) 50
          :else (let [invalid (xg-front S) bad-target (pj-ls L pj-t-base 6)
                      rejected (xw-project-assign invalid L S stub 1 6)]
                  (cond (pj-ok rejected) 39
                        (not= (xw-code-of rejected main-f) 0) 40
                        (not= (xw-code-of rejected stub) 0) 41
                        :else (let [valid-target (pj-ls L pj-t-base 5)
                                    cleared (mem-set invalid MM-ERR 0)
                                    second (xw-project-assign cleared L S stub 1 7)
                                    second-ready (-> second (mem-set MM-CODE-N 1) (mem-set MM-FIX-N 1))
                                    second-code (xw-project-code second-ready 1 stub 1)
                                    second-begin (xw-fix second-code 1 0) second-end (xw-fix second-code 1 3)
                                    second-archive (xw-project-archive second-code L 7)
                                    size2 (pj-l L pj-k-img)
                                    stub-at (loop [i 1] (if (>= i (vector-at M MM-SIR-N)) 0
                                      (if (and (= (xg-si M i IF-OP) OP-FN) (= (xg-si M i IF-A) stub)) i (recur (+ i 1)))))
                                    main-at (loop [i 1] (if (>= i (vector-at M MM-SIR-N)) 0
                                      (if (and (= (xg-si M i IF-OP) OP-FN) (= (xg-si M i IF-A) main-f)) i (recur (+ i 1)))))
                                    removed (mem-set M (+ MM-SIR-BASE (* stub-at MM-SIR-W) IF-OP) 0)
                                    missing (xw-project-stubs-valid? removed L stub 1 6)
                                    restored (mem-set M (+ MM-SIR-BASE (* stub-at MM-SIR-W) IF-OP) OP-FN)
                                    duplicated (mem-set M (+ MM-SIR-BASE (* main-at MM-SIR-W) IF-A) stub)
                                    duplicate (xw-project-stubs-valid? duplicated L stub 1 6)]
                                (cond (not (pj-ok second-archive)) 54
                                      (not= (t-archive-u32 L size) 7) 55
                                      (not= (t-archive-u32 L (+ size 5)) (- second-end second-begin)) 56
                                      (not (t-archive-equal? second-code L second-begin second-end (+ size 9))) 57
                                      (not= (t-archive-u32 L 0) 6) 58
                                      (or (= stub-at 0) (= main-at 0)) 42
                                      missing 43 duplicate 44
                                      (xw-project-stubs-valid? M L 9223372036854775807 1 6) 45
                                      :else (let [bad-archive (xw-project-archive M L 5)]
                                              (cond (pj-ok bad-archive) 51
                                                    (not= (pj-l L pj-k-img) size2) 52
                                                    (not= (t-archive-u32 L 0) 6) 53
                                                    :else (let [clear (mem-set M MM-ERR 0)
                                                                thunk (xw-rec clear 0 31 0 0)
                                                                denied (xw-project-archive thunk L 6)]
                                                            (cond (pj-ok denied) 60
                                                                  (not= (pj-l L pj-k-img) size2) 61
                                                                  :else (t-archive-payload M L size))))))))))))
(defn- seed-main [] :i64 (t-project-stubs))
