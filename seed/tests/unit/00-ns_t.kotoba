(defn- t-one [k :i64] :i64
  (cond
    (< k 40) (t-chunk0 k)
    (< k 80) (t-chunk1 k)
    (< k 120) (t-chunk2 k)
    (< k 160) (t-chunk3 k)
    (< k 200) (t-chunk4 k)
    (< k 240) (t-chunk5 k)
    (< k 280) (t-chunk6 k)
    (< k 320) (t-chunk7 k)
    (< k 360) (t-chunk8 k)
    (< k 400) (t-chunk9 k)
    :else 0))
(defn- t-all [k :i64] :i64
  (if (= k 386) 0
    (let [r (t-one k)] (t-all (+ k 1)))))
(defn- seed-main [] :i64
  (let [o (typed-cap-call :io/write :string :string "00-ns constants 386\n")
        r (t-all 0)]
    r))
