(defn- t-chunk16 [k :i64] :i64
  (cond
    (= k 640) (t-line "UOP-F32-TO-F64" UOP-F32-TO-F64)
    (= k 641) (t-line "UOP-I64-TO-F32" UOP-I64-TO-F32)
