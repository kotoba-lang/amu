(defn- t-reader-types [M :vector-i64 f :i64] :vector-i64
  (if (>= f (vector-at M MM-FN-N)) M
    (t-reader-types (-> M (t-put (+ MM-FN-BASE (* f MM-FN-W) FF-PT0) (if (or (= f 320) (= f 323) (= f 326) (= f 329) (= f 332) (= f 335) (= f 337) (= f 339) (= f 341)) TY-VEC TY-I64))
                         (t-put (+ MM-FN-BASE (* f MM-FN-W) (+ FF-PT0 1)) TY-I64)
                         (t-put (+ MM-FN-BASE (* f MM-FN-W) FF-RTYPE) TY-I64)) (inc f))))
(defn- t-mask-types [M :vector-i64 f :i64] :vector-i64
  (if (>= f (vector-at M MM-FN-N)) M
    (t-mask-types (-> M (t-put (+ MM-FN-BASE (* f MM-FN-W) FF-PT0) TY-I64)
                       (t-put (+ MM-FN-BASE (* f MM-FN-W) FF-RTYPE) TY-I64)) (inc f))))
(defn- seed-main [] :i64
  (let [a (typed-cap-call :cli/args :string :string "")
        MT (t-mask-types (t-load (t-init)) 158)
        MR (t-reader-types MT 320)
        M0 (t-put MR (+ MM-FN-BASE (* 335 MM-FN-W) FF-PT0) TY-I64)
        reader_closed (gn-affine-reader M0 10315 320 2)
        reader_wrong (gn-affine-reader M0 10583 335 2)
        MI (-> M0 (gn-gs gn-g-open 320) (gn-gs gn-g-open-n 1))
        reader_open (gn-affine-reader MI 10315 320 2)
        mask_shared (gn-mask-reused M0 158 1 0 16384)
        mask_single (gn-mask-reused M0 188 1 0 16384)
        mask_limit (gn-mask-reused M0 158 1 0 0)
        M1 (gn-run M0)
        hot_guard (gn-high-loop M1 10702)
        cold_guard (gn-high-loop M1 14723)
        hot_limit (gn-high-loop-scan M1 10702 10703 10666 0)
        start_limit (gn-high-start M1 10702 0)
        MH (gn-gs M1 (+ gn-a-lp 1567) 10667)
        bad_label_guard (gn-high-loop MH 10702)
        MF (gn-gs MH (+ gn-a-lp 1567) 14703)
        foreign_guard (gn-high-loop MF 10702)
        closed (gn-ctx-safe M1 239 1 8 512)
        nw (vector-at M1 MM-R0)
        e1 (vector-at M1 MM-ERR)
        o1 (t-out (string-concat (string-concat (string-concat "gen err " (t-dec e1)) " words ")
                                 (string-concat (t-dec nw) "\n")))
        M2 (t-pool M1 1 (t-a8 (* 4 nw)))
        M3 (t-fix M2 1)
        e3 (vector-at M3 MM-ERR)
        o2 (t-out (string-concat (string-concat "layout err " (t-dec e3)) "\n"))
        o3 (t-pf M3 1)
        o4 (t-pw M3 1 (+ nw 1))
        o5 (t-pl M3 1)
        o6 (t-out (string-concat (string-concat "end " (t-dec (vector-at M3 MM-CODE-BYTES))) "\n"))
        MC (gn-run-open (t-put (t-put M3 MM-CODE-N 1) MM-FIX-N 1) 239 1)
        direct (gn-ctx-safe MC 239 1 8 512)
        transitive (gn-ctx-safe MC 246 1 8 512)
        independent (gn-ctx-safe MC 240 2 8 512)
        clamp_closed (gn-clamp MC 9317 279 1)
        MO (-> MC (gn-gs gn-g-open 279) (gn-gs gn-g-open-n 1))
        clamp_open (gn-clamp MO 9317 279 1)
        MS (gn-gs MO gn-g-open 278)
        sign_open (gn-clamp MS 9317 279 1)]
    (if (and mask_shared (not mask_single) (not mask_limit)
             hot_guard (not cold_guard) (not hot_limit) (= start_limit 0) (not bad_label_guard) (not foreign_guard)
             (> reader_closed 0) (= reader_wrong 0) (= reader_open 0)
             (= e3 0) (>= closed 0) (= direct -1) (= transitive -1) (>= independent 0)
             (> clamp_closed 0) (= clamp_open 0) (= sign_open 0)) 0 1)))
