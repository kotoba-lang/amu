(defn- ccf-label-reference [M :vector-i64 j :i64 l :i64 i :i64 found :i64] :bool
 (if (= j (vector-at M MM-SIR-N)) (= found 1)
  (let [hit (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) l))]
   (and (or (not hit) (and (or (< j (- i 2)) (> j i))
                               (= (gn-sir M j IF-B) 0) (= (gn-sir M j IF-C) 0)))
    (<= (+ found (if hit 1 0)) 1)
    (ccf-label-reference M (inc j) l i (+ found (if hit 1 0)))))))
(defn- glx-reference [M :vector-i64 j :i64 l :i64 found :i64] :i64
 (cond (or (<= l 0) (>= l MM-LABEL-CAP)) 0
       (>= j (vector-at M MM-SIR-N)) found
       (and (= (gn-op M j) OP-LABEL) (= (gn-sir M j IF-A) l))
       (if (> found 0) 0 (glx-reference M (inc j) l j))
       :else (glx-reference M (inc j) l found)))

;; The full production prefix is retained. The independent oracle above is
;; byte-identical to the old scan except its private symbol. Test-only entry.
(defn- glx-op [M :vector-i64 at :i64 label :i64] :vector-i64
 (-> M (mem-set (+ MM-SIR-BASE (* at MM-SIR-W)) OP-LABEL)
  (mem-set (+ MM-SIR-BASE (* at MM-SIR-W) IF-A) label)))
(defn- glx-setup [] :vector-i64
 (let [m (mem-alloc (mem-new) (+ gn-a-lp MM-LABEL-CAP 91))
       base (vector-at m MM-R0)]
  (-> m (mem-set gn-cell base) (mem-set MM-SIR-N (+ t2-max-sir 5))
   (glx-op 2 1) (glx-op 5 2) (glx-op 7 2)
   (glx-op t2-max-sir 3) (glx-op (inc t2-max-sir) (dec MM-LABEL-CAP))
   (glx-op (+ t2-max-sir 2) 0) (glx-op (+ t2-max-sir 3) MM-LABEL-CAP))))
(defn- glx-anchor [M :vector-i64 j :i64 l :i64 found :i64 expected :i64] :bool
 (and (= (gn-small-label M j l found) expected) (= (glx-reference M j l found) expected)))
(defn- glx-grid [M :vector-i64] :bool
 (loop [l -1]
  (if (= l 8) true
   (if (and (glx-anchor M 1 l 0 (glx-reference M 1 l 0))
            (glx-anchor M 3 l 0 (glx-reference M 3 l 0))
            (glx-anchor M 6 l 0 (glx-reference M 6 l 0))
            (glx-anchor M 1 l 8 (glx-reference M 1 l 8))
            (glx-anchor M 1 l -2 (glx-reference M 1 l -2)))
     (recur (inc l)) false))))

(defn- ccf-label-grid [M :vector-i64] :bool
 (loop [l 0]
  (if (= l 5) true
   (if (and
    (= (ccf-label-source M 1 l 4 0) (ccf-label-reference M 1 l 4 0))
    (= (ccf-label-source M 1 l 1 0) (ccf-label-reference M 1 l 1 0))
    (= (ccf-label-source M 3 l 4 0) (ccf-label-reference M 3 l 4 0))
    (= (ccf-label-source M 6 l 9 0) (ccf-label-reference M 6 l 9 0))
    (= (ccf-label-source M 1 l 4 1) (ccf-label-reference M 1 l 4 1))
    (= (ccf-label-source M 1 l 4 -1) (ccf-label-reference M 1 l 4 -1)))
    (recur (inc l)) false))))
(defn- ccf-label-check [M :vector-i64] :bool
 (let [ordinary (and (ccf-label-grid M)
   (ccf-label-source M 1 1 1 0) (not (ccf-label-source M 1 1 2 0))
   (not (ccf-label-source M 1 1 3 0)) (not (ccf-label-source M 1 1 4 0))
   (ccf-label-source M 1 1 5 0) (not (ccf-label-source M 1 2 1 0))
   ;; A suffix can remove the first duplicate, or remove the only hit.
   (ccf-label-source M 6 2 1 0) (not (ccf-label-source M 3 1 1 0)))
       bad-b (mem-set M (+ MM-SIR-BASE (* 2 MM-SIR-W) IF-B) 7)
       b-ok (and (not (ccf-label-source bad-b 1 1 1 0)) (ccf-label-grid bad-b))
       bad-c (-> bad-b (mem-set (+ MM-SIR-BASE (* 2 MM-SIR-W) IF-B) 0)
                (mem-set (+ MM-SIR-BASE (* 2 MM-SIR-W) IF-C) 7))
       c-ok (and (not (ccf-label-source bad-c 1 1 1 0)) (ccf-label-grid bad-c))
       restored (mem-set bad-c (+ MM-SIR-BASE (* 2 MM-SIR-W) IF-C) 0)]
  (and ordinary b-ok c-ok (ccf-label-source restored 1 1 1 0))))

(defn- glx-check [] :bool
 (let [plain (glx-setup) fallback (and (= (glx-base plain) 0) (glx-grid plain))
       indexed (glx-prepare plain)
       anchors (and (> (glx-base indexed) 0) (glx-grid indexed) (ccf-label-check indexed)
        (glx-anchor indexed 1 1 0 2) (glx-anchor indexed 1 2 0 0)
        (glx-anchor indexed 1 3 0 t2-max-sir)
        (glx-anchor indexed 1 (dec MM-LABEL-CAP) 0 (inc t2-max-sir))
        (glx-anchor indexed 1 MM-LABEL-CAP 0 0)
        (glx-anchor indexed 1 -9223372036854775808 0 0)
        (glx-anchor indexed 1 9223372036854775807 0 0)
        (glx-anchor indexed 1 4 -1 -1)
        (glx-anchor indexed (+ t2-max-sir 5) 1 8 8)
        (glx-anchor indexed 6 2 0 7))
       original-top (- (vector-at indexed MM-HEAP-TOP) MM-LABEL-CAP)
       later (mem-alloc indexed 3) later-base (vector-at later MM-R0)
       sentinel (mem-set later later-base 314159)
       held (glx-release sentinel)
       held-ok (and (= (vector-at held MM-HEAP-TOP) (+ later-base 3))
         (= (vector-at held later-base) 314159) (= (glx-base held) original-top))
       ;; The fixture owns the later allocation; restore it before releasing
       ;; the table. Production release must never discard somebody else's.
       rewound (mem-set (mem-fill held later-base 3 0) MM-HEAP-TOP later-base)
       released (glx-release rewound)
       release-ok (and (= (glx-base released) 0) (= (gn-g released glx-state) 0)
         (= (vector-at released MM-HEAP-TOP) original-top)
         (loop [k 0] (or (= k MM-LABEL-CAP)
          (and (= (vector-at released (+ original-top k)) 0) (recur (inc k))))))
       reindexed (glx-prepare released)
       no-room (-> reindexed (gn-gs glx-state 0)
         (mem-set MM-HEAP-TOP (inc (- MM-HEAP-END MM-LABEL-CAP))))
       optional (glx-prepare no-room)
       optional-ok (and (= (glx-base optional) 0) (= (vector-at optional MM-ERR) 0)
         (= (vector-at optional MM-HEAP-TOP) (inc (- MM-HEAP-END MM-LABEL-CAP)))
         (glx-anchor optional 1 1 0 2) (ccf-label-grid optional))
       restored (-> optional (mem-set MM-HEAP-TOP (+ original-top MM-LABEL-CAP))
           (gn-gs glx-state original-top))
       ;; Invalidate by SIR extent; suffix scans still see the changed source.
       stale (mem-set restored MM-SIR-N (inc t2-max-sir))
       stale-ok (and (= (glx-base stale) 0) (glx-anchor stale 1 (dec MM-LABEL-CAP) 0 0))
       small (-> stale (mem-set MM-SIR-N 9) (gn-gs glx-state 0))
       small-index (glx-prepare small)
       small-ok (and (= (glx-base small-index) 0) (glx-anchor small-index 1 2 0 0))
       bad (gn-gs small-index glx-state -1)]
  (and fallback anchors held-ok release-ok optional-ok stale-ok small-ok (= (glx-base bad) 0))))
(defn- seed-main [] :i64
 (if (= (io-argc) 0) (if (glx-check) 0 1) 1))
