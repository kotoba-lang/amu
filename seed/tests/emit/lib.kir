{:format :kotoba.kir/v4, :entry nil, :exports [add3 greet slen], :signature nil, :effects #{}, :functions [{:name helper, :params [a b], :result :i64, :effects #{}, :body (+ (* a 10) b), :param-types [:i64 :i64]} {:name add3, :params [a b c], :result :i64, :effects #{}, :body (+ (helper a b) c), :param-types [:i64 :i64 :i64]} {:name greet, :params [s], :result :string, :effects #{}, :body (string-concat "hello, " s), :param-types [:string]} {:name slen, :params [s], :result :i64, :effects #{}, :body (string-byte-length (greet s)), :param-types [:string]}]}
