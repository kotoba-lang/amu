;; H36: fresh private working state and separate constants are owned by sh-bytes.
;; Keep the eight SHA working words as parallel scalar loop bindings; publish
;; the same final words once after all64 rounds. Schedule/padding are unchanged.
(defn- sh-rounds-scalar [state :vector-i64 constants :vector-i64] :vector-i64
  (loop [index 0 a (vector-at state 8) b (vector-at state 9)
         c (vector-at state 10) d (vector-at state 11) e (vector-at state 12)
         f (vector-at state 13) g (vector-at state 14) h (vector-at state 15)]
    (if (= index 64)
      (-> state (vector-assoc! 8 a) (vector-assoc! 9 b) (vector-assoc! 10 c) (vector-assoc! 11 d)
                (vector-assoc! 12 e) (vector-assoc! 13 f) (vector-assoc! 14 g) (vector-assoc! 15 h))
      (let [choose (bit-xor (bit-and e f) (bit-and (bit-not e) g))
            majority (bit-xor (bit-xor (bit-and a b) (bit-and a c)) (bit-and b c))
            one (sh-mask (+ (+ h (sh-large1 e)) (+ choose (+ (vector-at constants index) (vector-at state (+ 16 index))))))
            two (sh-mask (+ (sh-large0 a) majority))]
        (recur (+ index 1) (sh-mask (+ one two)) a b c (sh-mask (+ d one)) e f g)))))
(defn- sha-bytes-scalar [bytes :vector-i64] :string
  (if (> (vector-count bytes) 1152921504606846975) ""
    (let [total (* (quot (+ (vector-count bytes) 72) 64) 64) constants (sh-round-constants)]
      (loop [start 0 state (sh-new)]
        (if (>= start total) (sh-render state)
          (recur (+ start 64) (sh-accumulate (sh-rounds-scalar (sh-working (sh-expand (sh-load state bytes start total))) constants))))))))
(defn- sha-size [i :i64] :i64 (case i 0 0 1 3 2 1 3 55 4 56 5 63 6 64 7 65 8 127 9 128 10 129 11 1024 12 65536 13 1000000 0))
(defn- sha-expected [i :i64] :string (case i 0 "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" 1 "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" 2 "ab897fbdedfa502b2d839b6a56100887dccdc507555c282e59589e06300a62e2" 3 "0c43a30970ee9525a6603d5656803c325bded148fa65bbd363df54cb3ac3dee5" 4 "f4dcdc09c846d1b3621701516b300055c1e7875e216ba019dd4423f5a420f2d0" 5 "ba3bb62c4369fe74e7b94392d0f04ed284a7b5d7295bfa48fabdb25c01d85ab7" 6 "cb6862268ca7c02e7b6af558f0e3d236ce9ec7ff41cc746b2848c04c582da94e" 7 "b68af55df9ce8ee60870e45d10e36b2e8363c9896f6e62478dcb6f593a4d7133" 8 "a8365b6e6ed1daf56c41bae89ab089c03b671240ae103070480a7f271bdbad57" 9 "d399f065c9f21e2fd51e2aeadb7768eab7e6e45e5150f31227c9711934a4d1d3" 10 "d672408e0571636ea21092304eb31ba8fc1fbffc5d5ea6531d62b072714599db" 11 "e051d1007607de494c073da3c29903d6c0abfee7a4c0609f560a340a1947b470" 12 "0bca3b5b2577c1341e7c61a10d9b664333ab04ed8976c8b594a75353dc2fb0ef" 13 "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0" ""))
(defn- sha-input [which :i64] :vector-i64
 (let [n (sha-size which)]
  (loop [i 0 out (vector-alloc n)]
   (if (= i n) out
    (recur (inc i) (vector-assoc! out i (if (= which 1) (+ 97 i) (if (= n 1000000) 97 (rem (+ (* i 73) 19) 256)))))))))
(defn- sha-case [which :i64] :bool
 (arena-scope
  (let [input (sha-input which) expected (sha-expected which)
        baseline (sh-bytes input) candidate (sha-bytes-scalar input)]
   (and (= baseline expected) (= candidate expected)))))
(defn- seed-main [] :i64
 (if (not= (io-argc) 0) 1
  (if (loop [i 0] (if (= i 14) true (and (sha-case i) (recur (inc i))))) 0 1)))
