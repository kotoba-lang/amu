;; Source cases only; these do not run the watcher or authenticate its caller.
(defn- dwr-case-request [] :vector-i64
  [87 80 48 49 210 4 0 0 0 241 83 101 0 0 0 0 42 0 0 0 0 0 0 0 46 22 0 0 5 0 0 0])
(defn- dwr-case-ready [] :vector-i64
  [87 82 48 49 0 0 0 0 87 80 48 49 210 4 0 0 0 241 83 101 0 0 0 0 42 0 0 0 0 0 0 0 46 22 0 0 5 0 0 0])
(defn- dwr-case-reply [] :vector-i64
  [87 82 48 49 0 0 0 0 87 80 48 49 210 4 0 0 0 241 83 101 0 0 0 0 42 0 0 0 0 0 0 0 46 22 0 0 5 0 0 0
   87 79 48 49 0 0 0 0 87 80 48 49 210 4 0 0 0 241 83 101 0 0 0 0 42 0 0 0 0 0 0 0 46 22 0 0 5 0 0 0])
(defn- dwr-case-reply-for [r :vector-i64] :vector-i64
  (loop [i 0 out (dwr-case-reply)]
    (if (= i 32) out (recur (+ i 1) (vector-assoc! (vector-assoc! out (+ i 8) (vector-at r i)) (+ i 48) (vector-at r i))))))
(defn- dwr-case-frame [r :vector-i64 kind :i64 sequence :i64] :vector-i64
  (let [v (-> (vector-alloc 40) (vector-assoc! 0 87) (vector-assoc! 1 kind)
              (vector-assoc! 2 48) (vector-assoc! 3 49) (vector-assoc! 4 sequence))]
    (loop [i 0 out v] (if (= i 32) out
      (recur (+ i 1) (vector-assoc! out (+ i 8) (vector-at r i)))))))
(defn test-darwin-watch-monitor [] :bool
  (let [r (vector-assoc! (dwr-case-request) 3 50) init (darwin-watch-monitor-start r 100 20)
        other (-> (dwr-case-request) (vector-assoc! 3 50) (vector-assoc! 24 47))
        other-hb (dwr-case-frame other 72 1) other-final (dwr-case-frame other 79 0)
        ready (dwr-case-frame r 82 0) hb (dwr-case-frame r 72 1)
        final (dwr-case-frame r 79 0) empty (vector-alloc 0)
        s1 (darwin-watch-monitor-step r init "ready" ready -1 false 110 true)
        s2 (darwin-watch-monitor-step r s1 "heartbeat" hb -1 false 120 true)
        polled (darwin-watch-monitor-step r s2 "poll" empty -1 false 130 true)
        done (darwin-watch-monitor-step r polled "exit" final 0 true 140 false)
        r4 (vector-assoc! (dwr-case-request) 3 52)
        r4-other (-> (dwr-case-request) (vector-assoc! 3 52) (vector-assoc! 24 47))
        r4-ready (dwr-case-frame r4 82 0) r4-hb (dwr-case-frame r4 72 1) r4-exit (dwr-case-frame r4 83 9)
        r4-init (darwin-watch-monitor-start r4 100 20)
        r4-s1 (darwin-watch-monitor-step r4 r4-init "ready" r4-ready -1 false 110 true)
        r4-s2 (darwin-watch-monitor-step r4 r4-s1 "heartbeat" r4-hb -1 false 120 true)
        r4-done (darwin-watch-monitor-step r4 r4-s2 "exit" r4-exit 0 true 130 false)]
    (and (= (vector-at s1 0) 1) (= (vector-at s1 2) 110)
         (= (vector-at s2 0) 1) (= (vector-at s2 1) 2) (= (vector-at s2 2) 120)
         (= (vector-at (darwin-watch-monitor-step r s1 "heartbeat" hb -1 false 130 true) 0) 1)
         (= (vector-at (darwin-watch-monitor-step r s1 "heartbeat" hb -1 false 131 true) 0) 3)
         (= (vector-at polled 2) 120) (= (vector-at done 0) 2)
         (= (vector-at polled 4) 130)
         (= (vector-at (darwin-watch-monitor-step r polled "poll" empty -1 false 125 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r polled "exit" final 0 true 125 false) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r s2 "heartbeat" hb -1 false 121 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r s2 "poll" empty -1 false 141 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r s2 "poll" empty -1 false 119 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r s2 "poll" empty -1 false 130 false) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r init "heartbeat" hb -1 false 110 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r s2 "exit" final 0 false 130 false) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r s2 "exit" final 1 true 130 false) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r done "poll" empty -1 false 141 true) 0) 3)
         (= (vector-count r4-init) 38) (= (vector-at r4-init 37) -1)
         (= (vector-at r4-s2 1) 2) (= (vector-at r4-s2 37) -1)
         (= (vector-at r4-done 0) 2) (= (vector-at r4-done 37) 9)
         (= (vector-at (darwin-watch-monitor-step r4 r4-s1 "exit" r4-exit 0 false 120 false) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r4 r4-s2 "heartbeat" r4-hb -1 false 121 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r4-other r4-s2 "heartbeat" (dwr-case-frame r4-other 72 2) -1 false 121 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r4 r4-s2 "poll" empty -1 false 141 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r4 (vector-assoc! r4-s2 37 0) "exit" r4-exit 0 true 130 false) 0) 3)
         (= (vector-at (darwin-watch-monitor-step other s1 "heartbeat" other-hb -1 false 120 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step other s1 "poll" empty -1 false 120 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step other s1 "exit" other-final 0 true 120 false) 0) 3)
         (= (vector-at (darwin-watch-monitor-start (dwr-case-request) 100 20) 0) 3)
         (= (vector-at (darwin-watch-monitor-start r 0 20) 0) 3)
         (= (vector-at (darwin-watch-monitor-start r 100 0) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r [0 1 0 20 0] "ready" ready -1 false 1 true) 0) 3)
         (= (vector-at (darwin-watch-monitor-step r [0 1 100 20] "ready" ready -1 false 110 true) 0) 3))))
(defn test-darwin-watch-reply [] :bool
  (let [r (dwr-case-request) out (dwr-case-reply)
        r2 (vector-assoc! (dwr-case-request) 3 50)
        r3 (vector-assoc! (dwr-case-request) 3 51)
        status0 (dwr-case-frame r3 83 0) status7 (vector-assoc! (dwr-case-frame r3 83 0) 5 7)
        status9 (dwr-case-frame r3 83 9) stopped (dwr-case-frame r3 83 127)
        heartbeat (dwr-case-frame r2 72 1) final (dwr-case-frame r2 79 0)
        last (-> (dwr-case-frame r2 72 255) (vector-assoc! 5 255) (vector-assoc! 6 255) (vector-assoc! 7 255))
        bad-usec (vector-assoc! (dwr-case-request) 20 1)
        bad-timeout (vector-assoc! (dwr-case-request) 28 0)]
    (and (darwin-watch-ready? r (dwr-case-ready))
         (darwin-watch-ready? r2 (dwr-case-frame r2 82 0))
         (darwin-watch-ready? r3 (dwr-case-frame r3 82 0))
         (= (darwin-watch-status r3 status0 0 true) 0)
         (= (darwin-watch-status r3 status7 0 true) 1792)
         (= (darwin-watch-status r3 status9 0 true) 9)
         (= (darwin-watch-status r3 stopped 0 true) -1)
         (= (darwin-watch-status r3 status0 1 true) -1)
         (= (darwin-watch-status r3 status0 0 false) -1)
         (= (darwin-watch-status r2 status0 0 true) -1)
         (= (darwin-watch-status r3 (vector-assoc! (dwr-case-frame r3 83 0) 8 0) 0 true) -1)
         (= (darwin-watch-status r3 (vector-assoc! (dwr-case-frame r3 83 0) 6 1) 0 true) -1)
         (darwin-watch-heartbeat? r2 heartbeat 1)
         (darwin-watch-heartbeat? r2 last 4294967295)
         (not (darwin-watch-heartbeat? r2 last 4294967296))
         (not (darwin-watch-heartbeat? r2 heartbeat 2))
         (not (darwin-watch-heartbeat? r2 heartbeat 0))
         (not (darwin-watch-heartbeat? r heartbeat 1))
         (not (darwin-watch-heartbeat? r2 (vector-assoc! heartbeat 8 0) 1))
         (not (darwin-watch-heartbeat? r2 (vector-alloc 39) 1))
         (= (darwin-watch-exit-class r2 final 0 true) "observer/bound-exit-observed")
         (= (darwin-watch-exit-class r2 final 0 false) "observer/unknown")
         (= (darwin-watch-exit-class r2 final 1 true) "observer/unknown")
         (= (darwin-watch-reply-class r2 (dwr-case-reply-for r2) 0 true) "observer/unknown")
         (not (darwin-watch-ready? r (vector-alloc 39)))
         (not (darwin-watch-ready? r (vector-assoc! (dwr-case-ready) 32 47)))
         (= (darwin-watch-reply-class r out 0 true) "observer/bound-exit-observed")
         (= (darwin-watch-reply-class r out 133 true) "observer/unknown")
         (= (darwin-watch-reply-class r out 0 false) "observer/unknown")
         (= (darwin-watch-reply-class r (vector-alloc 39) 0 true) "observer/unknown")
         (= (darwin-watch-reply-class r (vector-alloc 81) 0 true) "observer/unknown")
         (= (darwin-watch-reply-class r (vector-assoc! (dwr-case-reply) 4 1) 0 true) "observer/unknown")
         (= (darwin-watch-reply-class r (vector-assoc! (dwr-case-reply) 32 47) 0 true) "observer/unknown")
         (= (darwin-watch-reply-class r (vector-assoc! (dwr-case-reply) 72 47) 0 true) "observer/unknown")
         (= (darwin-watch-reply-class bad-usec (dwr-case-reply-for bad-usec) 0 true) "observer/unknown")
         (= (darwin-watch-reply-class bad-timeout (dwr-case-reply-for bad-timeout) 0 true) "observer/unknown")
         (= (darwin-watch-reply-class r (vector-assoc! (dwr-case-reply) 0 256) 0 true) "observer/unknown"))))
