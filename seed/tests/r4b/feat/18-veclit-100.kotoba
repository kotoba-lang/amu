;; R4B feat: a 100-item vector literal of integer literals as an expression (pooled table, OP-VECP)
(ns seed.r4b (:export [test]))
(defn- tab [] :vector-i64 [53485 16269 2729 79817 50152 48669 41072 35059 23236 66573 63703 2137 60495 19628 19424 74208 99026 87070 61446 14715 2535 15616 65293 17621 22571 43157 14887 21471 93080 30159 89249 73667 86602 81473 29632 57401 7000 34950 43100 -470 40807 21050 66730 43070 87092 45603 78585 50711 51904 41050 95763 39244 20988 44136 77816 72368 62554 34121 56756 9321 93839 61682 32632 20895 79120 20767 35915 61987 35402 10067 12304 94329 48533 55420 86282 60135 60870 28992 63814 28369 12712 80343 57573 53379 70299 54206 28030 31528 46836 92599 27338 68302 49165 10056 39575 6923 69051 27333 12276 54505])
(defn test [] :i64
  (let [v (tab)]
    (loop [i 0 acc 0] (if (< i (vector-count v)) (recur (inc i) (+ (* acc 3) (vector-at v i))) (+ acc (vector-count v))))))
