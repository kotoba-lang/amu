(ns dd (:export [t]))
(defn- dn [o [:option :document]] :document (option-value-of [:option :document] o (document-null)))
(defn- p [d :document] :string (document-edn-print d))
(defn- bit [ok :bool k :i64] :i64 (if ok 0 k))
(defn t [] :i64
  (let [m (document-map :b (document-i64 2) :a (document-string "x\"y\\z\n\t\u0001é") :c (document-vector))
        v (document-vector (document-i64 -9223372036854775808) (document-keyword :k/q) m (document-list (document-null) (document-bool false)))
        s (document-set (document-i64 10) (document-string "a") (document-keyword :z) (document-i64 -3) (document-vector (document-i64 1)))
        m2 (document-merge m (document-map :a (document-i64 1) :d (document-set)))
        w (document-vector-conj (document-vector-assoc v 0 (document-i64 7)) (document-keyword :sym))
        srt (document-vector-sort (document-vector (document-string "b") (document-i64 3) (document-keyword :a) (document-i64 -1) (document-null)))]
    (+ 1 (bit (string=? (p m) "{:a \"x\\\"y\\\\z\\n\\t\\u0001é\" :b 2 :c []}") 1)
       (bit (string=? (p v) (string-concat "[-9223372036854775808 :k/q " (string-concat (p m) " (nil false)]"))) 2)
       (bit (string=? (p s) "#{-3 10 :z \"a\" [1]}") 4)
       (bit (string=? (p m2) "{:a 1 :b 2 :c [] :d #{}}") 8)
       (bit (string=? (p w) (string-concat "[7 :k/q " (string-concat (p m) " (nil false) :sym]"))) 16)
       (bit (string=? (p srt) "[-1 3 :a nil \"b\"]") 32)
       (bit (= (document-count v) 4) 64)
       (bit (= (option-value-of [:option :i64] (document-i64-value (dn (document-vector-at v 0))) 0) -9223372036854775808) 128)
       (bit (string=? (option-value-of [:option :string] (document-string-value (dn (document-get m :a))) "") "x\"y\\z\n\t\u0001é") 256)
       (bit (string=? (p (dn (document-map-entry-at m 1))) "[:b 2]") 512)
       (bit (string=? (p (dn (document-list-at (dn (document-vector-at v 3)) 1))) "false") 1024)
       (bit (string=? (p (document-vector-remove w 1)) (string-concat "[7 " (string-concat (p m) " (nil false) :sym]"))) 2048)
       (bit (string=? (p (document-vector-drop w 3)) "[(nil false) :sym]") 4096)
       (bit (document-contains m :c) 8192)
       (bit (not (document-contains m :e)) 16384)
       (bit (document-set-contains? s (document-vector (document-i64 1))) 32768)
       (bit (string=? (p (document-dissoc m :b)) "{:a \"x\\\"y\\\\z\\n\\t\\u0001é\" :c []}") 65536)
       (bit (= (document-kind (document-edn-read "#{1 2}")) :set) 131072)
       (bit (document-equal? (document-assoc m :b (document-i64 2)) m) 262144)
       (bit (option-value-of [:option :bool] (document-bool-value (document-bool true)) false) 524288)
       (bit (option-some?-of [:option :document] (document-get (document-map (document-i64 1) (document-i64 2) (document-string "k") (document-null)) (document-i64 1))) 1048576)
       (bit (string=? (p (document-map (document-string "k") (document-null) (document-i64 1) (document-i64 2) :x (document-i64 3))) "{1 2 :x 3 \"k\" nil}") 2097152))))
