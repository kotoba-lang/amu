(defn __kr_deq [a :string b :string] :bool (string=? a b))
(defn __kr_dcontains [m :string k :string] :bool (>= (__kr_dmapfind (__kr_dreq m 10 10) k 1) 0))
(defn __kr_dassocop [m :string k :string v :string] :string (__kr_dassoc (__kr_dreq m 10 10) k v))
(defn __kr_ddissocop [m :string k :string] :string (__kr_ddissoc (__kr_dreq m 10 10) k))
(defn __kr_dstrval [d :string] [:option :string] (if (= (__kr_dkindn d) 4) (option-some-of [:option :string] (__kr_dunesc d)) (option-none-of [:option :string])))
(defn __kr_dboolval [d :string] [:option :bool] (if (= (__kr_dkindn d) 1) (option-some-of [:option :bool] (string=? d "true")) (option-none-of [:option :bool])))
(defn __kr_di64val [d :string] [:option :i64] (if (= (__kr_dkindn d) 2) (option-some-of [:option :i64] (__kr_dparse d)) (option-none-of [:option :i64])))
(defn __kr_did [d :string] :string d)
;; keyword text (KIR5; was KIR4's per-program keyword tables, which trapped on a text the program never spells, e.g. every
;; keyword kotoba.form/edn-form reads from its input): on the KIR route a keyword IS its text ":k" (a :string), exactly
;; stage-0's native representation (kotoba-native machine_ir: a keyword literal is a string literal, keyword-from-string
;; is (string-concat ":" s), keyword-name the text after the first "/" or the ":"). 12-kirread retypes :keyword as
;; :string, turns keyword literals in value positions into string literals and keyword `=` into string=?.
(defn __kr_kwtext [k :string] :string k)
(defn __kr_dkwval [d :string] [:option :string] (if (= (__kr_dkindn d) 5) (option-some-of [:option :string] d) (option-none-of [:option :string])))
(defn __kr_dfindslash [s :string i :i64] :i64 (cond (>= i (string-length s)) -1 (= (string-code-point-at s i) 47) i :else (__kr_dfindslash s (+ i (__kr_dw (string-code-point-at s i))))))
(defn __kr_kwname [k :string] :string (let [sl (__kr_dfindslash k 1)] (string-substring k (cond (< sl 0) 1 (= (string-length k) 2) 1 :else (+ sl 1)) (string-length k))))
(defn __kr_kwfromstr [s :string] :string (string-concat ":" s))
