;; merge-test guest (agent KIR3): kotoba.compiler.posix-path (the big compiler's node:path reading) over a corpus file.
;; Input (file named by argument 0): one case per line, "<op><path>" or "j<a>\t<b>" (op b basename, d dirname,
;; n normalize, j join). Output: one answer per line, written per case.
(ns probe.posix-merge
  {:kotoba/export [main]}
  (:require [kotoba.compiler.posix-path :as p]))

(defn line-end [s :string i :i64] :i64
  (loop [j i]
    (if (>= j (string-byte-length s))
      j
      (let [c (string-code-point-at s j)]
        (if (= c 10) j (recur (+ j (if (< c 128) 1 (if (< c 2048) 2 (if (< c 65536) 3 4))))))))))

(defn tab-at [s :string i :i64 e :i64] :i64
  (loop [j i]
    (if (>= j e)
      e
      (let [c (string-code-point-at s j)]
        (if (= c 9) j (recur (+ j (if (< c 128) 1 (if (< c 2048) 2 (if (< c 65536) 3 4))))))))))

(defn answer [s :string i :i64 e :i64] :string
  (let [op (string-code-point-at s i)
        x (string-substring s (+ i 1) e)]
    (if (= op 98) (p/basename x)
      (if (= op 100) (p/dirname x)
        (if (= op 110) (p/normalize x)
          (let [t (tab-at s (+ i 1) e)]
            (p/join (string-substring s (+ i 1) t) (string-substring s (min e (+ t 1)) e))))))))

(defn main [] :i64
  (let [path (typed-cap-call :cli/args :string :string "0")
        s (typed-cap-call :fs/app-data :string :string path)
        n (string-byte-length s)]
    (loop [i 0 k 0]
      (if (>= i n)
        k
        (let [e (line-end s i)
              w (typed-cap-call :io/write :string :string (string-concat (answer s i e) "\n"))]
          (recur (+ e 1) (+ k 1)))))))
