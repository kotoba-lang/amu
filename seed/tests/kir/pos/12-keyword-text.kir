{:format :kotoba.kir/v4, :entry nil, :exports [t], :signature nil, :effects #{}, :functions [{:name kt, :params [k], :result :document, :effects #{}, :body (document-keyword k), :param-types [:keyword]} {:name bit, :params [ok k], :result :i64, :effects #{}, :body (if ok 0 k), :param-types [:bool :i64]} {:name kv, :params [d], :result :keyword, :effects #{}, :body (option-value-of [:option :keyword] (document-keyword-value d) :none), :param-types [:document]} {:name t, :params [], :result :i64, :effects #{}, :body (+ 1 (bit (string=? (document-edn-print (kt :a/b)) ":a/b") 2) (bit (= (kv (document-edn-read ":zz")) :zz) 4) (bit (string=? (keyword-name :a/b) "b") 8) (bit (string=? (keyword-name :x) "x") 16) (bit (string=? (keyword-name (keyword-from-string "p/q")) "q") 32) (bit (= (keyword-from-string "zz") :zz) 64) (bit (string=? (keyword-name (document-kind (document-null))) "null") 128) (bit (= (kv (document-i64 3)) :none) 256) (bit (string=? (document-edn-print (document-map (kt :k) (kt :v))) "{:k :v}") 512) (bit (= (kv (option-value-of [:option :document] (document-get (document-map :q (kt :p/q)) :q) (document-null))) :p/q) 1024)), :param-types []} {:name __kotoba_doc_nth, :params [d i], :result :document, :effects #{}, :body (if (= (document-kind d) :vector) (option-value-of [:option :document] (document-vector-at d i) (document-null)) (if (= (document-kind d) :list) (option-value-of [:option :document] (document-list-at d i) (document-null)) (if (= (document-kind d) :map) (option-value-of [:option :document] (document-map-entry-at d i) (document-null)) (document-null)))), :param-types [:document :i64]} {:name __kotoba_doc_rest_from, :params [d i acc], :result :document, :effects #{}, :body (if (< i (document-count d)) (__kotoba_doc_rest_from d (+ i 1) (document-vector-conj acc (__kotoba_doc_nth d i))) acc), :param-types [:document :i64 :document]} {:name __kotoba_doc_rest, :params [d], :result :document, :effects #{}, :body (__kotoba_doc_rest_from d 1 (document-