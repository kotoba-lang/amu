    (cond (= k :map) 1 (= k :vector) 2 (= k :keyword) 3 (= k :string) 4 (= k :i64) 5 (= k :null) 6 (= k :set) 7 (= k :list) 8 (= k :bool) 9 :else 0)))
(defn main [] :i64
