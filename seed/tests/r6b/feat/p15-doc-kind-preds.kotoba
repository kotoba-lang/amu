  (+ (w (coll? v) 1) (w (coll? l) 2) (w (coll? s) 4) (w (coll? m) 8) (w (coll? i) 16) (w (coll? z) 32)
     (w (seq? v) 64) (w (seq? l) 128) (w (seq? s) 256) (w (seq? m) 512)
     (w (integer? i) 1024) (w (integer? t) 2048) (w (boolean? b) 4096) (w (boolean? z) 8192) (w (string? k) 16384) (w (keyword? k) 32768) (w (nil? z) 65536) (w (some? i) 131072) (w (map? m) 262144) (w (set? m) 524288))))
