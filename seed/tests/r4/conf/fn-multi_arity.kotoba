(ns seed.r4.multiarity (:export [main]))
(defn choose
  ([x] x)
  ([x y] (+ x y)))

(defn tally
  ([x] x)
  ([x & more] (+ x (count more))))

(defn add
  ([] 40)
  ([a b] (+ a b)))

(defn main []
  (+ (+ (choose 3) (choose 4 5))
     (+ (tally 5 8 9) (reduce add [1 2 3]))))
