(ns seed.native-keyword-intern (:export [main graph-full-main graph-overflow-main]))
(defn- many-keywords [] :i64
  (loop [i 0]
    (if (= i 1800) 0
      (let [name (string-concat "kw-test/名-" (string-from-i64 i))
            key (keyword-from-string name) again (keyword-from-string name)]
        (if (and (= key again) (string=? (keyword-name key) (string-concat "名-" (string-from-i64 i))))
          (recur (+ i 1)) 1)))))
(defn- public-graph [] :i64
  (loop [i 0]
    (if (= i 4096) 0 (let [put (__r6-kgput i 17 (+ i 23))] (recur (+ i 1))))))
(defn main [] :i64
  (let [keys (many-keywords) public (__r6-kgget 1001 17)
        key (keyword-from-string "isolated/名")
        poison (__r6-kgput (__r6-as :i64 key) 1897424841649887629 0)
        scoped (arena-scope (__r6-as :i64 (keyword-from-string "scoped/persistent")))]
    (if (and (= keys 0) (= public -9223372036854775808)
             (string=? (keyword-name key) "名") (string=? (keyword-name (__r6-as :keyword scoped)) "persistent")) 0 1)))
(defn graph-full-main [] :i64
  (let [keys (many-keywords) graph (public-graph)]
    (if (and (= keys 0) (= graph 0) (= (__r6-kgget 4095 17) 4118)) 0 2)))
(defn graph-overflow-main [] :i64
