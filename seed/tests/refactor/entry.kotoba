(ns refactor-entry
  {:kotoba/export [main]}
  (:require [amu.refactor-cli :as refactor]))

;; seed/tests/refactor/entry.kotoba -- the `amu refactor` dispatcher alone, as a test entry (agent REFAC, 2026-10-04).
;; argv as amu's: arg 0 "refactor", arg 1 the sub-command. scripts/seed/refactor/diff.sh compiles it with the seed and
;; compares it with bin/amu (nbb) byte for byte.
(defn main [] :i64 (refactor/run))
