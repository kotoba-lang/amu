(ns prepaid-fuel-controls (:export [run]))
(defn- put [v :vector-i64 i :i64 x :i64] :vector-i64 (vector-assoc! v i x))
(defn- put8 [v :vector-i64 i :i64 x :i64] :vector-i64 (put v i (bit-and x 255)))
(defn- signed16 [x :i64] :i64 (let [y (bit-and x 65535)] (if (>= y 32768) (- y 65536) y)))
(defn- clip [x :i64] :i64 (let [y (signed16 x)] (if (< y 0) 0 (if (> y 255) 255 y))))
(defn- initial [v :vector-i64 x :i64 i :i64] :vector-i64 (if (= i (vector-count v)) v (initial (put v i x) x (+ i 1))))
(defn- sweep [v :vector-i64 phase :i64 i :i64] :vector-i64 (if (= i 8) v (let [x (vector-at v (+ 8 i)) a (if (= phase 0) (put8 v (+ 0 i) (clip x)) (if (= phase 1) (put8 v (+ 0 i) (clip (+ x 1))) (put8 v (+ 0 i) (clip (- x 1)))))] (sweep a phase (+ i 1)))))
(defn- checksum [v :vector-i64 i :i64] :i64 (if (= i 8) 0 (+ (vector-at v i) (checksum v (+ i 1)))))
(defn run [mode :i64 x :i64] :i64 (let [v (initial (vector-alloc (if (= mode 3) 8 16)) x 0) a (sweep v (case mode 0 0 1 1 2 -1 3 0 0) 0)] (checksum a 0)))
