(ns seed.tests.macos-fs35 (:export [main]) (:capabilities [:fs/app-data :cli/args]))
;; JUN-593: legacy wire-35 text requests on the Mac fs2-cli-stdio-general runtime.
;; One case per process (argument 0). 0 = the expected answers, n > 0 names the
;; first wrong answer. Trap cases (bad read/write, unknown token) are observed by
;; the caller as a signal, not here.
(defn- fs [request :string] :string (typed-cap-call :fs/app-data :string :string request))
(defn- yes? [request :string] :bool (= (fs request) "1"))
(defn- no? [request :string] :bool (= (fs request) "0"))
(defn main [] :i64
  (let [c (typed-cap-call :cli/args :string :string "0")]
    (cond
      (= c "roundtrip")
      (cond (not (= (fs "/d/aWRITE_SEPhello") "hello")) 1
            (not (= (fs "/d/a") "hello")) 2
            (not (yes? "/d/aEXISTS_SEP")) 3
            (not (no? "/d/missingEXISTS_SEP")) 4
            (not (= (fs "/d/aWRITE_SEP") "")) 5
            (not (= (fs "/d/a") "")) 6
            :else 0)
      (= c "durable")
      (cond (not (= (fs "/d/tmpWRITE_SEPv2") "v2")) 1
            (not (yes? "/d/tmpFSYNC_SEP")) 2
            (not (yes? "/d/tmpRENAME_SEP/d/final")) 3
            (not (yes? "/dFSYNC_SEP")) 4
            (not (= (fs "/d/final") "v2")) 5
            (not (no? "/d/tmpEXISTS_SEP")) 6
            (not (no? "/d/absentFSYNC_SEP")) 7
            (not (no? "/d/absentRENAME_SEP/d/other")) 8
            :else 0)
      (= c "lock")
      (cond (not (yes? "/d/xFLOCK_SEP")) 1
            (not (no? "/d/xFLOCK_SEP")) 2
            (not (no? "/d/yFLOCK_SEP")) 3
            (not (no? "/d/yUNLOCK_SEP")) 4
            (not (yes? "/d/xUNLOCK_SEP")) 5
            (not (no? "/d/xUNLOCK_SEP")) 6
            (not (yes? "/d/yFLOCK_SEP")) 7
            (not (yes? "/d/yUNLOCK_SEP")) 8
            :else 0)
      (= c "hold")
      (if (yes? "/d/heldFLOCK_SEP") (if (= (fs "/d/readyWRITE_SEPready") "ready")
                                      (loop [i 0] (if (= i 9223372036854775807) 2 (recur (+ i 1)))) 3) 1)
      (= c "contended") (if (no? "/d/heldFLOCK_SEP") 0 1)
      (= c "paths")
      (cond (not (no? "/d/../escapeEXISTS_SEP")) 1
            (not (no? "/d/./aEXISTS_SEP")) 2
            (not (no? "/d//aEXISTS_SEP")) 3
            (not (no? "d/aEXISTS_SEP")) 4
            (not (no? "/d/EXISTS_SEP")) 5
            (not (no? "/EXISTS_SEP")) 6
            (not (no? "/linkEXISTS_SEP")) 7
            (not (no? "/link/fileEXISTS_SEP")) 8
            (not (no? "/d/aRENAME_SEP/../outside")) 9
            (not (no? "/d/aRENAME_SEP/link/moved")) 10
            (not (no? "/../xFLOCK_SEP")) 11
            (not (no? "/d/../xFSYNC_SEP")) 12
            :else 0)
      (= c "trap-read-missing") (string-length (fs "/d/missing"))
      (= c "trap-read-link") (string-length (fs "/link/file"))
      (= c "trap-write-dotdot") (string-length (fs "/d/../xWRITE_SEPdata"))
      (= c "trap-unknown") (string-length (fs "/d/aAPPEND_SEPdata"))
      (= c "trap-trailing") (string-length (fs "/d/aEXISTS_SEPextra"))
      :else 99)))
