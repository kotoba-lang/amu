;; Darwin Mach bootstrap-port diagnostic emitted by Amu.
;; This is not a block-device provider and must not be exposed as one.
;; The one-time assembly derivation is inert reference data; native builds
;; and tests consume the Kotoba words below and require no assembler.
(ns seed.macos-da-queue-packager (:export [main]))

(def IMAGE-BYTES 16384)

(defn- byte-at [v :vector-i64 at :i64 value :i64] :vector-i64
  (vector-assoc! v at (bit-and value 255)))

(defn- u32-at [v :vector-i64 at :i64 value :i64] :vector-i64
  (-> v
      (byte-at at value)
      (byte-at (+ at 1) (u64-shift-right value 8))
      (byte-at (+ at 2) (u64-shift-right value 16))
      (byte-at (+ at 3) (u64-shift-right value 24))))

(defn- u64-at [v :vector-i64 at :i64 value :i64] :vector-i64
  (-> v
      (u32-at at (bit-and value 4294967295))
      (u32-at (+ at 4) (u64-shift-right value 32))))

(defn- text-at [v :vector-i64 at :i64 text :string] :vector-i64
  (let [bytes (vector-i64-from-bytes (string-to-utf8 text))]
    (loop [i 0 out v]
      (if (= i (vector-count bytes)) out
        (recur (inc i) (byte-at out (+ at i) (vector-at bytes i)))))))

(defn- words-at [v :vector-i64 at :i64 words :vector-i64] :vector-i64
  (loop [i 0 out v]
    (if (= i (vector-count words)) out
      (recur (inc i) (u32-at out (+ at (* i 4)) (vector-at words i))))))

(defn- copy-words [out :vector-i64 at :i64 words :vector-i64] :vector-i64
  (loop [i 0 v out]
    (if (= i (vector-count words)) v
      (recur (inc i) (vector-assoc! v (+ at i) (vector-at words i))))))

;; Read the callback queue of a fresh Disk Arbitration session.
(defn- offset-words [mode :string] :vector-i64
  (let [v (-> (vector-alloc 287)
      (copy-words 0 [
       0xd10803ff 0x92800370 0xd4001001 0x34002120 0x2a0003f3 0x92800330
       0xd4001001 0x340020a0 0x2a0003f4 0x5282a268 0xb90003e8 0x52800488
       0xb90007e8 0xb9000bf3 0xb9000ff4 0xb90013ff 0x5281aa28 0xb90017e8
       0xb9001bff 0x52800028 0xb9001fe8 0x52800088 0xb90023e8 0x910003e0
       0xd2802061 0xf2c00041 0xd282a262 0xf2c00482 0xd3607e83 0xaa130063
       0xd281aa24 0xd3607c84 0xd3607e85 0xd2802006 0xd2807d07 0x928005d0
       0xd4001001 0x35001ce0 0xb94017e8 0x5281b6a9 0x6b09011f 0x54001c61
       0xb94003e8 0x36f81c28 0xb94007e8 0x7100a11f 0x54001bc1 0xb9401be8
       0x7100051f 0x54001b61])
      (copy-words 50 [
       0xb9401fe8 0x34001b28 0x2a0803f3 0xd2800009 0xf8296bff 0x91002129
       0xf108013f 0x54ffffa1 0x5282a268 0xb90003e8 0x52801788 0xb90007e8
       0xb9000bf3 0xb9000ff4 0x52803288 0xb90017e8 0x52800028 0xb9001fe8
       0x100019a9 0x910083ea 0x38401528 0x38001548 0x35ffffc8 0xd2800108
       0xf80b43e8 0x910003e0 0xd2802061 0xf2a06001 0xf2c00081 0xd282a262
       0xf2c01782 0xd3607e83 0xaa130063 0xd2803284 0xd3607c84 0xd3607e85
       0xd2802006 0xd2807d07 0x928005d0 0xd4001001 0x35001640 0xb94017e8
       0x7107e11f 0x540015e1 0xb94003e8 0x36f815a8 0xb94007e8 0x7100a11f
       0x54001541 0xb9401be8])
      (copy-words 100 [
       0x7100051f 0x540014e1 0xb9401fe8 0x340014a8 0xb9402be8 0x35001468
       0xb9402fe8 0x7100d11f 0x54001403 0xb94043e8 0x350013c8 0xb9401ff3
       0x92800630 0xd4001001 0x34001340 0x2a0003f4 0xd2800009 0xf8296bff
       0x91002129 0xf108013f 0x54ffffa1 0x5282a268 0xb90003e8 0x52800688
       0xb90007e8 0xb9000bf3 0xb9000ff4 0x52800108 0xb90017e8 0x52800028
       0xb9001fe8 0x52800168 0xb90027e8 0x100012e9 0x9100a3ea 0x38401528
       0x38001548 0x35ffffc8 0x910003e0 0xd2882061 0xf2a00601 0xf2c00081
       0xd282a262 0xf2c00682 0xd3607e83 0xaa130063 0xd2800104 0xd3607c84
       0xd3607e85 0xd2802006])
      (copy-words 150 [
       0xd2807d07 0x928005d0 0xd4001001 0x35000e60 0xb94017e8 0x7101b11f
       0x54000e01 0xb94003e8 0x36f80dc8 0xb94007e8 0x7100a11f 0x54000d61
       0xb9401be8 0x7100051f 0x54000d01 0xb9401ff3 0x34000cd3 0x92800630
       0xd4001001 0x34000c60 0x2a0003f4 0xd2800009 0xf8296bff 0x91002129
       0xf108013f 0x54ffffa1 0x5282a268 0xb90003e8 0x52800308 0xb90007e8
       0xb9000bf3 0xb9000ff4 0x528000e8 0xb90017e8 0x910003e0 0xd2882061
       0xf2a00601 0xf2c00081 0xd282a262 0xf2c00302 0xd3607e83 0xaa130063
       0xd28000e4 0xd3607c84 0xd3607e85 0xd2802006 0xd2807d07 0x928005d0
       0xd4001001 0x350008a0])
      (copy-words 200 [
       0xb94017e8 0x7101ad1f 0x54000841 0xb94003e8 0x36f80808 0xb94007e8
       0x7100e11f 0x540007a1 0xb9401be8 0x7100051f 0x54000741 0x39409fe8
       0x7100051f 0x540006e1 0xf841c3f8 0xb40006b8 0xb9402bf9 0xb94037e8
       0x6b08033f 0x54000621 0x34000619 0x7140073f 0x540005c8 0xd2800020
       0xaa1803e1 0xaa1903e2 0xd2800090 0xf2a04010 0xd4001001 0x540004e2
       0xeb19001f 0x540004a1 0x92800370 0xd4001001 0x34000440 0xaa1803e1
       0xaa1903e2 0x92800170 0xd4001001 0x350003a0 0xd2800009 0xf8296bff
       0x91002129 0xf108013f 0x54ffffa1 0x52800268 0xb90003e8 0x52800308
       0xb90007e8 0xb9000bf3])
      (copy-words 250 [
       0x528001a8 0xb90017e8 0x910003e0 0xd2800021 0xf2c00081 0xd2800262
       0xf2c00302 0xaa1303e3 0xd28001a4 0xd3607c84 0xd2800005 0xd2800006
       0xd2800007 0x928005d0 0xd4001001 0x35000060 0xd2800000 0x14000002
       0xd2800020 0xd2800030 0xf2a04010 0xd4001001 0xd4200000 0x2e6d6f63
       0x6c707061 0x69442e65 0x72416b73 0x72746962 0x6f697461 0x69642e6e
       0x72616b73 0x72746962 0x6f697461 0x0000646e 0x2d756d61 0x376e756a
       0x00003736]))]
    (if (string=? mode "invalid") (vector-assoc! v 273 0x2e6d6f78) v)))

(defn- body-at [v :vector-i64 at :i64 mode :string] :vector-i64
  (-> v
      ;; MH_EXECUTE CPU_TYPE_ARM64; no libSystem load command.
      (u32-at at 4277009103) (u32-at (+ at 4) 16777228)
      (u32-at (+ at 12) 2) (u32-at (+ at 16) 6)
      (u32-at (+ at 20) 296) (u32-at (+ at 24) 2097157)
      (u32-at (+ at 32) 25) (u32-at (+ at 36) 72)
      (text-at (+ at 40) "__PAGEZERO")
      (u64-at (+ at 64) 4294967296)
      (u32-at (+ at 104) 25) (u32-at (+ at 108) 72)
      (text-at (+ at 112) "__TEXT")
      (u64-at (+ at 128) 4294967296)
      (u64-at (+ at 136) IMAGE-BYTES)
      (u64-at (+ at 152) IMAGE-BYTES)
      (u32-at (+ at 160) 5) (u32-at (+ at 164) 5)
      (u32-at (+ at 176) 25) (u32-at (+ at 180) 72)
      (text-at (+ at 184) "__LINKEDIT")
      (u64-at (+ at 200) 4294983680)
      (u64-at (+ at 208) IMAGE-BYTES)
      (u64-at (+ at 216) IMAGE-BYTES)
      (u32-at (+ at 232) 1) (u32-at (+ at 236) 1)
      (u32-at (+ at 248) 14) (u32-at (+ at 252) 32)
      (u32-at (+ at 256) 12) (text-at (+ at 260) "/usr/lib/dyld")
      (u32-at (+ at 280) 2147483688) (u32-at (+ at 284) 24)
      (u64-at (+ at 288) 1024)
      (u32-at (+ at 304) 50) (u32-at (+ at 308) 24)
      (u32-at (+ at 312) 1)
      (u32-at (+ at 316) 851968) (u32-at (+ at 320) 851968)
      (words-at (+ at 1024) (offset-words mode))))

(defn- acknowledged-image? [request :vector-i64 offset :i64 reply :vector-i64] :bool
  (if (and (= (vector-count reply) (+ IMAGE-BYTES 5))
           (= (vector-at reply 0) 0) (= (vector-at reply 1) 70)
           (= (vector-at reply 2) 83) (= (vector-at reply 3) 50)
           (= (vector-at reply 4) 0))
    (loop [i 0]
      (if (= i IMAGE-BYTES) true
        (if (= (vector-at reply (+ i 5)) (vector-at request (+ offset i)))
          (recur (inc i)) false)))
    false))

(defn main [] :i64
  (let [path (typed-cap-call :cli/args :string :string "0")
        mode (typed-cap-call :cli/args :string :string "1")
        path-bytes (vector-i64-from-bytes (string-to-utf8 path))
        length (vector-count path-bytes)
        offset (+ 7 length)]
    (if (or (= length 0) (> length 255)
            (not (or (string=? mode "strict") (string=? mode "invalid")))) 2
      (let [v0 (vector-alloc (+ offset IMAGE-BYTES))
            v1 (-> v0
                   (byte-at 0 0) (byte-at 1 70) (byte-at 2 83)
                   (byte-at 3 50) (byte-at 4 0) (byte-at 5 66)
                   (text-at 6 path)
                   (byte-at (+ 6 length) 0)
                   (body-at offset mode))
            response (typed-cap-call :fs/app-data-bytes :bytes :bytes (bytes-from-vector-i64 v1))]
        (if (acknowledged-image? v1 offset (vector-i64-from-bytes response)) 0 3)))))
