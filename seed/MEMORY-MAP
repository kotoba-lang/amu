;; seed/MEMORY-MAP -- the memory contract of the seed compiler (R0). EDN.
;; Owner: contracts (strong agent). Design: docs/selfhost-seed-design-20261002.md sections 2.3 and 4.1.
;;
;; SINGLE SOURCE OF TRUTH FOR CONSTANTS. Every line of the form
;;     [:c NAME VALUE "doc"]
;; in seed/MEMORY-MAP, seed/HEADS and seed/SIR is a named i64 constant. scripts/seed/gen-ns.sh copies them, in
;; file order, as `(def NAME VALUE)` into the generated block of seed/00-ns.kotoba, and the 00-ns unit test
;; (scripts/seed/unit.sh 00-ns) checks the compiled values against this list. Modules use the NAMES, never
;; the numbers. To change a constant: edit here, run scripts/seed/gen-ns.sh, run unit.sh 00-ns, commit both.
;; Names are unique across the three files.

{:format :seed.memory-map/v1

 ;; ---------------------------------------------------------------------------------------------------------
 ;; 1. The heap M
 ;; ---------------------------------------------------------------------------------------------------------
 ;; One :vector-i64 of MM-WORDS words, allocated once by `mem-new` (01-mem) and threaded through every
 ;; function as its FIRST parameter. The source text is a separate :string S (second parameter where needed).
 ;; No other vector is long-lived. Every table below is a fixed region of M: address = BASE + index * W.
 ;; Index 0 of every table is the NULL record: it is never written, fills start at 1, and a field value 0
 ;; means "none" (no child, no symbol, no function, no label ...). `mem-new` sets every *-N fill to 1.
 :constants
 [[:c MM-WORDS 16646144 "words in M (127 MiB); below the loader's 16M-item per-vector limit"]
  [:c MM-NULL 0 "the null index of every table"]
  [:c MM-LAYOUT-VERSION 1 "value of M[MM-VERSION] after mem-new"]

  ;; --- 1.1 header slots M[0..255] ---------------------------------------------------------------------
  [:c MM-VERSION 0 "layout version, = MM-LAYOUT-VERSION (01-mem)"]
  [:c MM-R0 1 "return register 0: a writer's i64 result (see rule L4). Read it immediately after the call"]
  [:c MM-R1 2 "return register 1"]
  [:c MM-R2 3 "return register 2"]
  [:c MM-R3 4 "return register 3"]
  [:c MM-ERR 5 "first error code (E table in seed/HEADS), 0 = ok. First writer wins: never overwrite non-zero"]
  [:c MM-ERR-POS 6 "byte offset in S of the error, -1 when none applies"]
  [:c MM-ERR-A 7 "start byte of the span printed for {name}"]
  [:c MM-ERR-B 8 "end byte (exclusive) of the span printed for {name}"]
  [:c MM-ERR-N 9 "number printed for {n}; type code printed for {t}"]
  [:c MM-SRC-LEN 10 "byte length of S (driver, before lex)"]
  ;; R6C (2026-10-03): unannotated parameters (21-check; the driver re-runs a module with the refinements, see 21-check ck-hint-*)
  [:c MM-CK-LAST 11 "R6C: node of the last checked expression when it is a use of a provisional (KW-PINFER) parameter, else 0"]
  [:c MM-CK-REFINE 12 "R6C: the refinement the first type error asks for (f * 2^28 + k * 2^24 + type), 0 = none"]
  [:c MM-CK-HINTS 13 "R6C: HEAP address of the refinements in force for this compile ([n, packed ..]), 0 = none"]
  [:c MM-TOK-N 16 "TOK fill = next free token index (10-lex)"]
  [:c MM-NODE-N 17 "NODE fill (11-read)"]
  [:c MM-SYM-N 18 "SYM fill (20-names)"]
  [:c MM-HASH-N 19 "occupied HASH slots (20-names)"]
  [:c MM-FN-N 20 "FN fill (20-names)"]
  [:c MM-SCOPE-N 21 "SCOPE stack height (20-names)"]
  [:c MM-SIR-N 22 "SIR fill (30-lower)"]
  [:c MM-LABEL-N 23 "next label number; labels are global and allocated by 30-lower"]
  [:c MM-CODE-N 24 "CODE fill in 32-bit words (41-a64gen)"]
  [:c MM-FIX-N 25 "FIX fill (41-a64gen)"]
  [:c MM-LIT-N 26 "LIT fill (10-lex)"]
  [:c MM-LITB-N 27 "LITB fill in bytes (10-lex)"]
  [:c MM-EXP-N 28 "EXP fill (42-layout)"]
  [:c MM-OUT-N 29 "OUT fill in bytes (50-out)"]
  [:c MM-HEAP-TOP 30 "next free word of the HEAP region (01-mem mem-alloc)"]
  [:c MM-ROOT 32 "root node index (11-read). Its children are the top-level forms in source order"]
  [:c MM-NS-NODE 33 "node of the (ns ...) form (20-names)"]
  [:c MM-POOL-OFF 34 "byte offset of the literal pool from the code start (42-layout)"]
  [:c MM-CODE-BYTES 35 "total code length in bytes including the pool (42-layout)"]
  [:c MM-MAX-DEPTH 36 "deepest SIR temporary seen (30-lower), for statistics"]
  [:c MM-QUIET 37 "R6L (FOLD, CMD request): 1 = the driver writes no ok line for the compiled file (drv-compile-file = drv-run mode 3); 0 after mem-new"]
  [:c MM-STAT-BASE 64 "M[64..127]: free-form statistics, one slot per module: 64 + 4*k for MANIFEST position k"]
  ;; R3 (2026-10-03): two of 21-check's cells (88..91: 88 touch, 89 gensym cache) carry contract values
  [:c MM-CK-STATE 90 "R3: HEAP address of 21-check's current check-state block (private layout, see 21-check)"]
  [:c MM-CT 91 "R3: HEAP address of the composite type table CT (21-check writes it; 30-lower and the driver read it)"]
  ;; R5B (2026-10-03): two cells of the stat range of 40-a64enc (a pure module that writes none)
  [:c MM-FN2 96 "R5B: HEAP address of the FN side table FN2 (MM-FN-CAP records of FN2-W words; 21-check writes, 30-lower and 60-proj read)"]
  [:c MM-CAPS 97 "R5B: capability mask (wire w < 47 = bit w; wire 47 = extension bit 48; state bit 47 unchanged)"]

  ;; --- 1.2 regions: BASE (word address), W (words per record), CAP (records incl. the null record) ------
  ;; R6B (2026-10-03): the seed's own unity (14k lines) filled TOK to 129,234 of 131,072 (measured with a stats build of the R6A
  ;; seed: NODE 108,833, SIR 83,419, FIX 18,400, LITB 30,855, HEAP 243,318 words used), so TOK grows to 262,144 and NODE to
  ;; 196,608 records, paid by SIR 262,144 -> 196,608, FIX 131,072 -> 65,536, LITB 524,288 -> 262,144 and the HEAP (-262,144
  ;; words). M stays 8,388,608 words (the loader budgets are unchanged).
  ;; Integrated optimizer unity exceeded TOK262144 (E101 region1). Grow only TOK;
  ;; downstream bases move by1048576 words, other capacities and heap size remain.
  ;; Token/node growth (2026-10-15, Claude cosci): the compiler's own source (T2 + certified kernels) outgrew TOK
  ;; (E101 region 1): TOK +131072 tokens (+524288 words), NODE +65536 records (+524288 words); every later base +1048576;
  ;; MM-OUT-CAP 4 MiB -> 3 MiB (the image is about 2.1 MB) so MM-HEAP-BASE, MM-HEAP-END and MM-WORDS stay as they are.
  [:c MM-TOK-BASE 256] [:c MM-TOK-W 4] [:c MM-TOK-CAP 655360]
  ;; Compiler NODE reserve: previous +32768, plus32768 for continued optimizer
  ;; selfhost growth after observed E101 region4; +262144 words (2 MiB).
  ;; Reader/checker both use region4; failure does not identify phase or peak.
  ;; All following bases move equally; heap capacity and all other CAP/W stay fixed.
  [:c MM-NODE-BASE 2621696] [:c MM-NODE-W 8] [:c MM-NODE-CAP 589824]
  [:c MM-SYM-BASE 7340288] [:c MM-SYM-W 8] [:c MM-SYM-CAP 65536]
  [:c MM-HASH-BASE 7864576] [:c MM-HASH-W 1] [:c MM-HASH-CAP 131072]
  [:c MM-FN-BASE 7995648] [:c MM-FN-W 16] [:c MM-FN-CAP 8192]
  [:c MM-SCOPE-BASE 8126720] [:c MM-SCOPE-W 2] [:c MM-SCOPE-CAP 65536]
  ;; Prior compiler SIR expansion: +65536 records / 262144 words (2 MiB).
  ;; Additional SIR reserve: +32768 records / 131072 words (1 MiB).
  ;; Resource-only response to E3001; no measured high-water/reserve claim.
  ;; All later bases shift equally; heap capacity and every other CAP/W stay fixed.
  ;; T2 tier (Claude cosci 2026-10-14): SIR +98304 records / +393216 words; all later bases shift equally, MM-WORDS stays
  ;; below the loader's 16M-item vector limit; other capacities and the heap size are unchanged.
  ;; T2 code growth (2026-10-14): CODE +131072 words, FIX +32768 records; later bases, MM-HEAP-END and MM-WORDS +262144
  ;; (heap size unchanged, MM-WORDS still below the 16M-item vector limit).
  ;; T2 node growth (2026-10-14): NODE +131072 records (+1048576 words; the compiler's own source outgrew the node table);
  ;; every later base, MM-HEAP-END and MM-WORDS +1048576 (heap size unchanged; MM-WORDS 14155776 < 16M).
  ;; x86_64 cross closure (2026-10-15): seed/X86_64-LINUX-MANIFEST (this compiler plus the x86 backend) outgrew SIR
  ;; (E3001); SIR +98304 records / +393216 words; every later base, MM-HEAP-END and MM-WORDS +393216 (heap size
  ;; unchanged; MM-WORDS 16646144 < 16M items). Capacity only: guest images are byte-identical (see
  ;; docs/evidence/same-algo-m104-20261015).
  [:c MM-SIR-BASE 8257792] [:c MM-SIR-W 4] [:c MM-SIR-CAP 491520]
  [:c MM-LABEL-BASE 10223872] [:c MM-LABEL-W 1] [:c MM-LABEL-CAP 131072]
  [:c MM-CODE-BASE 10354944] [:c MM-CODE-W 1] [:c MM-CODE-CAP 655360]
  [:c MM-FIX-BASE 11010304] [:c MM-FIX-W 4] [:c MM-FIX-CAP 98304]
  [:c MM-LIT-BASE 11403520] [:c MM-LIT-W 4] [:c MM-LIT-CAP 16384]
  [:c MM-LITB-BASE 11469056] [:c MM-LITB-W 1] [:c MM-LITB-CAP 262144]
  [:c MM-EXP-BASE 11731200] [:c MM-EXP-W 4] [:c MM-EXP-CAP 1024]
  ;; OUT growth (2026-10-15): the compiler's own image neared 2 MiB (T2 + certified kernels); MM-OUT-CAP +2097152 bytes,
  ;; MM-HEAP-BASE, MM-HEAP-END and MM-WORDS +2097152 (heap size unchanged; MM-WORDS 16252928 < 16M items).
  [:c MM-OUT-BASE 11735296] [:c MM-OUT-W 1] [:c MM-OUT-CAP 3145728]
  [:c MM-HEAP-BASE 14881024] [:c MM-HEAP-END 16646144]
;; Static profile (2026-10-22, JUN-29 / M2): seed/00-ns-static.kotoba, used by the loaderless static closures, is this
;; block with MM-CODE-CAP 2097152, MM-FIX-CAP 262144, MM-LITB-CAP 1048576 and MM-OUT-CAP 12582912 (every later base, MM-HEAP-END
;; and MM-WORDS shifted by 12320768; MM-WORDS 28966912, heap size unchanged). The stack-machine static
;; emitter turns the complete core into a native static image beyond the AArch64 core's 3 MiB OUT.
;; 2026-10-23: complete26 plus adopted TCP/spawn needs 8,433,664 bytes before context;
;; the old 8 MiB OUT refused E7104. 12 MiB OUT preserves all modules and existing checks. The core (seed/MANIFEST) keeps
;; this block, so its payload identity is unchanged. The static runtime's per-vector limit is 2^25 items (KXRT-VECTOR-MAX).
;; LITB growth (2026-10-23, JUN-353): the combined compiler (seed/FULL-MANIFEST) reached 523 KiB of literal bytes and
;; vector-literal tables (lowering adds the tables to the same region); MM-LITB-CAP 1048576 (+524288), every later base,
;; MM-HEAP-END and MM-WORDS +524288 (MM-WORDS 24772608, heap size unchanged).

  ;; --- 1.3 record fields (offset inside a record) -------------------------------------------------------
  ;; TOK: one per token, source order. Written by 10-lex only.
  [:c TF-KIND 0 "token kind TK-* (seed/HEADS)"]
  [:c TF-START 1 "first byte offset in S"]
  [:c TF-END 2 "byte offset after the token (exclusive). A string token spans both quotes"]
  [:c TF-VAL 3 "TK-INT: the i64 value (wrapped from the decimal digits, '-' applied); TK-STR: its LIT index; else 0"]

  ;; NODE: the read tree. Children are a linked list: FIRST child, then NEXT siblings, 0 terminates.
  [:c NF-KIND 0 "node kind ND-* (11-read)"]
  [:c NF-FIRST 1 "first child node or 0 (11-read)"]
  [:c NF-NEXT 2 "next sibling node or 0 (11-read)"]
  [:c NF-TOK 3 "token index of the atom, or of the opening bracket (11-read)"]
  [:c NF-AUX 4 "11-read: ND-INT value; ND-STR LIT index; ND-LIST/ND-VEC/ND-MAP child count; else 0"]
  [:c NF-SYM 5 "20-names: symbol index of an ND-SYM or ND-KW node; else 0"]
  [:c NF-TYPE 6 "21-check: type code TY-* of the expression; 0 for non-expressions"]
  [:c NF-RES 7 "21-check: resolution, see RES-* (seed/HEADS). ND-LIST: head code HD-*; ND-SYM: RES-* encoded"]

  ;; SYM: one per distinct spelling (symbols AND keywords; a keyword's span includes the ':').
  ;; Ids follow first occurrence in S (determinism); the HASH table is only a lookup index.
  [:c SF-START 0 "first byte of the first occurrence in S"]
  [:c SF-END 1 "end byte (exclusive)"]
  [:c SF-HASH 2 "the hash nm-hash gave the spelling (FNV-1a 64 over the bytes, see 20-names)"]
  [:c SF-HEAD 3 "symbol: head code HD-* if the spelling is a builtin head, else 0; keyword: KW-* code or 0"]
  [:c SF-FN 4 "FN index of the top-level def/defn/defn- with this name, else 0 (20-names)"]
  [:c SF-BIND 5 "current local binding: frame slot + 1, 0 = not bound (20-names scope API only)"]
  [:c SF-REC 6 "R1: HEAP address of the record schema block of a record name (defrecord symbol or the keyword of an
                  inline [:record :ns/name ..] schema), else 0 (21-check). Block: RB-* below"]
  [:c SF-ABORT 7 "R3 (21-check): 0 = the defn does not abort; -1 = it aborts, error type not known yet; else the error
                  type E of the defn (its interface is [:result T E], seed/HEADS HD-THROW)"]

  ;; HASH: open addressing, linear probing, MM-HASH-CAP slots (a power of two). Slot = symbol index, 0 = empty.

  ;; FN: one per top-level (def ...), (defn ...), (defn- ...), source order (index 1 = first def form).
  [:c FF-SYM 0 "symbol of the name (20-names)"]
  [:c FF-NODE 1 "the ND-LIST node of the whole def form (20-names)"]
  [:c FF-KIND 2 "FK-DEFN / FK-PRIV / FK-DEF (20-names)"]
  [:c FF-NPARAMS 3 "parameter count, 0 for FK-DEF (20-names)"]
  [:c FF-RTYPE 4 "result type TY-* (21-check); for FK-DEF the constant's type"]
  [:c FF-PT0 5 "type of parameter 0 (21-check); FF-PT0+i for parameter i, i < 5"]
  [:c FF-PT4 9 "type of parameter 4. R4B: the type of parameter k >= 5 (a clause takes up to 16) is NF-TYPE of its type-form
               node in the clause's parameter vector (21-check, pass A)"]
  [:c FF-NSLOTS 10 "frame slots used by params + lets + loop vars, after slot reuse (21-check)"]
  [:c FF-EXPORT 11 "1 when named in (:export [...]) (20-names)"]
  [:c FF-SIR 12 "SIR index of this function's FN instruction (30-lower)"]
  [:c FF-CODE 13 "code word index of the entry (41-a64gen)"]
  [:c FF-FUEL 14 "1 when the body contains a call, runtime call or capability call (21-check), see SIR fuel rule"]
  [:c FF-DEPTH 15 "max SIR temp depth + 1 used by the function (30-lower)"]
  [:c FK-DEFN 1] [:c FK-PRIV 2 "defn-"] [:c FK-DEF 3]
  ;; R4: FN records 21-check appends while it checks a body (FF-EXPORT 0, never a definition of a name; FF-SYM a gensym):
  [:c FK-LAMBDA 4 "a lifted fn literal: FF-NODE = the (fn [..] body) node, FF-NPARAMS = parameters + captures"]
  [:c FK-ADAPTER 5 "the closure entry of a lambda with 2 or more captures: FF-NODE = the fn node, FF-NPARAMS = parameters + 1"]
  ;; R4 multi-arity defns: 20-names adds one FN record per clause, consecutively, all with the name's FF-SYM (SF-FN = the first);
  ;; 21-check gives each clause a synthetic (defn[-] NAME [params] :R body) node as FF-NODE. FF-NPARAMS of a variadic clause
  ;; counts the rest parameter once (the `&` symbol is not counted).
  ;; R1: FF-EXPORT = 2 marks an IMPLICIT export (no (:export ..) clause: every defn); 21-check turns it into 1 when the
  ;; signature is exportable (params i64, result i64/bool) and 0 otherwise.

  ;; Record schema block (R1, in HEAP via mem-alloc, written by 21-check): [n id (kwsym type) * n]
  [:c RB-N 0 "field count 1..32"] [:c RB-ID 1 "identity symbol: the record type is TY-REC-BASE + id"]
  [:c RB-F0 2 "first field pair: the SYM of the keyword :f (0 when the file never spells it: then no accessor can
               name the field), the field type"] [:c RB-FW 2]

  ;; CT (R3): the composite type table, in HEAP (mem-alloc by 21-check at ck-run), CT-CAP records of CT-W words; record 0 is
  ;; unused, M[MM-CT] = the base, CT-N of the base record = the fill. Type code TY-COMP-BASE + i names record i.
  [:c CT-CTOR 0 "TC-* constructor (seed/HEADS)"] [:c CT-A 1 "first type argument (T, K)"] [:c CT-B 2 "second (E, V), else 0"]
  [:c CT-N 3 "in record 0 only: the fill"] [:c CT-W 4] [:c CT-CAP 4096]

  ;; FN2 (R5B): one record per FN index, in HEAP at M[MM-FN2] (allocated by 21-check at ck-run; fresh words are zero)
  [:c FN2-W 8]
  [:c FN2-FLAGS 0 "bit 0: a stateful defn (a TEMPLATE: never checked or lowered itself; its specializations are); bit 1: a
                   specialization; bit 2: a handler's get clause; bit 3: a handler's put clause"]
  [:c FN2-ORIGIN 1 "a specialization: its template FN; a handler clause: the handler's name symbol"]
  [:c FN2-HAND 2 "a specialization: the handler (its get clause FN; put = get + 1); a handler clause: the get clause FN"]
  [:c FN2-CAPS 3 "direct effect mask (wire w < 47 = bit w; :state = bit 47; wire 47 = bit 48)"]
  [:c FN2-S 4 "a handler clause: the handler's state type S"]
  [:c FN2-FX 5 "21-check scratch: the inferred effect mask (effect ceilings)"]
  [:c FN2-NODE 6 "a handler clause: the defhandler form"]
  [:c FN2-SPARE 7]
  ;; SCOPE: the shadow stack of 20-names' scope API: [symbol, previous SF-BIND of that symbol].
  [:c CF-SYM 0] [:c CF-PREV 1]

  ;; SIR: [op a b c], see seed/SIR. Written by 30-lower only.
  [:c IF-OP 0] [:c IF-A 1] [:c IF-B 2] [:c IF-C 3]

  ;; LABEL: label number -> code word index where the label sits (41-a64gen writes it at the LABEL op).

  ;; CODE: one 32-bit instruction per word, value 0..2^32-1 (41-a64gen appends, 42-layout patches fixups).
  ;; FIX: a code word whose immediate is resolved by 42-layout.
  [:c XF-AT 0 "code word index of the instruction to patch"]
  [:c XF-KIND 1 "FX-* (seed/SIR)"]
  [:c XF-TARGET 2 "label number (FX-B26/FX-BC19/FX-CB19/FX-ADRL19), FN index (FX-BL26) or LIT index (FX-LIT32)"]
  [:c XF-AUX 3 "0 = public entry; 1 only for FX-BL26 terminal B to the proved private vector entry (FF-CODE + 1 word), checked by 42-layout"]

  ;; LIT: one per string literal token, in source order (10-lex). Bytes are the DECODED bytes (escapes applied).
  [:c LF-B 0 "first byte index in LITB"]
  [:c LF-LEN 1 "byte length"]
  [:c LF-POOL 2 "byte offset of the bytes from the code start (42-layout)"]
  [:c LF-TOK 3 "token index"]
  ;; LITB: one byte per word (0..127 in R0; R3: any byte, a string literal's UTF-8 bytes).

  ;; EXP: one per exported FN, in (:export [...]) order (42-layout).
  [:c EF-FN 0] [:c EF-OFFSET 1 "byte offset of the entry from the code start"] [:c EF-ARITY 2] [:c EF-SPARE 3]
  ;; OUT: one byte (0..255) per word: the kseed container being written (50-out).
  ;; HEAP: words MM-HEAP-BASE..MM-HEAP-END-1, bump-allocated by `mem-alloc`, never freed.
  ]

 ;; ---------------------------------------------------------------------------------------------------------
 ;; 2. Write rights. A module writes ONLY the cells listed for it. Everyone may read everything.
 ;; ---------------------------------------------------------------------------------------------------------
 :write-rights
 {"00-ns/90-drv/99-entry" [:MM-SRC-LEN :MM-ERR* "(only when it detects a usage/io error itself)"]
  "01-mem"   [:MM-VERSION :all-*-N "(initial value 1 in mem-new only)" :MM-HEAP-TOP :HEAP "(on behalf of callers)" :MM-R0..R3]
  "02-io"    [:MM-R0..R3 :MM-ERR* "(E02nn)" "HEAP blocks it allocated"]
  "10-lex"   [:TOK :MM-TOK-N :LIT "(LF-B LF-LEN LF-TOK)" :LITB :MM-LIT-N :MM-LITB-N :MM-ERR* "(E10nn)"]
  "11-read"  [:NODE "fields NF-KIND NF-FIRST NF-NEXT NF-TOK NF-AUX" :MM-NODE-N :MM-ROOT :MM-ERR* "(E11nn)"]
  "20-names" [:SYM :HASH :MM-SYM-N :MM-HASH-N :FN "(FF-SYM FF-NODE FF-KIND FF-NPARAMS FF-EXPORT; R4: one per clause)" :MM-FN-N
              :SCOPE :MM-SCOPE-N "NODE field NF-SYM" :MM-NS-NODE :MM-ERR* "(E20nn)"]
  "21-check" ["NODE fields NF-TYPE NF-RES" "FN fields FF-RTYPE FF-PT0..FF-PT4 FF-NSLOTS FF-FUEL" :MM-ERR* "(E21nn)"
              "SF-BIND only through the 20-names scope API"
              "R1: appends NODE records and relinks NF-FIRST/NF-NEXT when desugaring, SF-REC, FF-EXPORT 2 -> 1/0, gensyms"
              "R3: SF-ABORT, MM-CK-STATE, MM-CT and the CT block, NF-SYM of an ND-SET/ND-MAP expression and NF-TYPE of the
               head symbol node of an R3 head or aborting call (the first hidden slot)"
              "R4: appends FN records (FK-LAMBDA, FK-ADAPTER: all FF-* fields, MM-FN-N), FF-NODE of multi-arity clauses, NF-TYPE
               of a fn literal's head symbol (its FN) and parameter vector (its capture block), of a defn clause's parameter
               vector (1 = variadic), capture blocks in HEAP"]
  "R5B"      ["21-check: FN2 and M[MM-FN2] M[MM-CAPS]; FN records of handler clauses (FK-LAMBDA, body = 3rd child) and of
               specializations (FK-PRIV, a clone of the template's defn form); NF-TYPE of a handle head (the state slot), of a perform
               head (the state slot) and its keyword (the handler), of a stateful call's head (the state slot), of a defn's name node
               (its {:effects ..} ceiling map, unlinked from the form at desugaring)"
              "60-proj: reads M[MM-CAPS] and FN2 after a module's compile (namespace :capabilities, stateful library exports)"]
  "30-lower" [:SIR :MM-SIR-N :MM-LABEL-N :MM-MAX-DEPTH "FN fields FF-SIR FF-DEPTH" :MM-ERR* "(E30nn)"]
  "40-a64enc" ["nothing: pure functions i64 -> i64"]
  "41-a64gen" [:CODE "(append)" :MM-CODE-N :FIX :MM-FIX-N :LABEL "FN field FF-CODE" :MM-ERR* "(E41nn)"]
  "42-layout" [:CODE "(patch fixups in place)" "LIT field LF-POOL" :EXP :MM-EXP-N :MM-POOL-OFF :MM-CODE-BYTES :MM-ERR* "(E42nn)"]
  "50-out"   [:OUT :MM-OUT-N :MM-ERR* "(E50nn)"]
  "every module" ["MM-R0..MM-R3 as return registers (rule L4)" "its own MM-STAT slots"]}

 ;; ---------------------------------------------------------------------------------------------------------
 ;; 3. Rules for writing seed code against M. These are forced by stage-0 (measured 2026-10-02 against
 ;;    build/native-image/amu-native, probes in the commit message) and by the seed's own R0 subset.
 ;; ---------------------------------------------------------------------------------------------------------
 :rules
 [[:L1 "M is a LINEAR handle. A function that writes M (vector-assoc!, or calls a writer) RETURNS :vector-i64,
        the new handle, and the caller rebinds it: (let [M1 (lx-push M0 ..) M2 (lx-push M1 ..)] ..). After a
        handle is passed to a writer it is DEAD: never mention it again (stage-0 refuses some violations with
        'vector-assoc! requires a linear handle', and the reference semantics is a COPY, so a surviving alias
        reads stale data -- the compile-time oracle reports 'native artifact oracle inconclusive')."]
  [:L2 "Readers take M and return :i64; they only use (vector-at M i) and call other readers. A reader call
        does not kill M: (let [x (rd M 3) M1 (wr M 4 x)] ..) is fine."]
  [:L3 "Every function except `main` is defn- . A public defn with a :vector-i64 parameter is refused by
        stage-0's linearity check whenever a branch returns the handle unchanged."]
  [:L4 "A writer that also produces an i64 stores it in M[MM-R0] (and MM-R1..R3 for more) and returns M.
        The caller reads (vector-at M1 MM-R0) right after the call, before any other writer runs."]
  [:L5 "Loops that WRITE M are self-recursive defn- functions with the write in tail position
        (stage-0 turns the self tail call into a jump: 7M iterations measured, no stack growth). A `loop`
        whose loop variable is a vector handle written with vector-assoc! is refused by stage-0. Read-only
        loops may use loop/recur over i64 variables."]
  [:L6 "No shadowing: let names are unique within a let ('duplicate let binding'), so number them M0 M1 M2 ..
        and _0 _1 for discarded results. Prefer unique names in the whole function."]
