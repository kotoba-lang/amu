(ns amu.main
  {:kotoba/export [main]}
  (:require [amu.cli :as cli]
            [amu.check :as check]
            [amu.compile :as compile]
            [amu.refactor :as refactor]))

;; seed/amu-main/src/amu/main.kotoba -- the `amu` command as ONE Kotoba entry (agent MAINS, 2026-10-04).
;;
;;   amu check <file> ..          -> amu.check/run      (stage-0 `amu check`)
;;   amu compile <file> --target aarch64-macos --output X ..
;;                                -> amu.compile/run    (stage-0 `amu compile`)
;;   amu refactor <sub> ..        -> amu.refactor/run   (bin/amu -> nbb refactor_cli)
;;   anything else                -> stage-0's usage refusal, exit 64
;;
;; The routing is bin/amu's for these three commands; the usage refusal is stage-0's in-process CLI text. Each command
;; namespace exists in one or two build routes (seed/amu-main/README.md): s/ (the seed compiles everything from source)
;; and k/ (the KIR route); a command that a route cannot build is a declared stub (amu.cli/not-available, exit 69)
;; that names exactly what is missing. Arity-0 `main`, argv through wire 38, the exit status is the result.

(defn main [] :i64
  (if (< (cli/argc) 1)
    (cli/usage-error ":kotoba/invalid-usage" "unknown or missing kotoba command" ", :details {:phase :usage}")
    (let [c (cli/arg 0)]
      (cond (string=? c "check") (check/run)
            (string=? c "compile") (compile/run)
            (string=? c "refactor") (refactor/run)
            :else (cli/usage-error ":kotoba/invalid-usage" "unknown or missing kotoba command" ", :details {:phase :usage}")))))
