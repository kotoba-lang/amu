(ns amu.check
  {:kotoba/export [run]}
  (:require [amu.check-full :as full]))

;; seed/amu-main/k/amu/check.kotoba -- `amu check` of the native launcher (agent MAINS, 2026-10-04; CHECKFULL, 2026-10-04).
;;
;; The command is amu.check-full (seed/amu-main/src/amu/check_full.kotoba): stage-0's argument order and texts, the
;; frontend's analyze (kotoba.compiler.frontend.analyze, compiled from source by the seed: FRONTSRC), --policy (bounded
;; EDN, wire-policy, the capability half of admission) and --profile; --source-path / --module-lock / --package-lock /
;; --json are declared stubs (exit 69) naming what is missing. Before CHECKFULL this module ran seed/amu-front/check.cljk's
;; main (default policy only, --policy ignored). The KIR route (build-k.sh, JVM kir-dump) is superseded and does not
;; build this module.

(defn run [] :i64 (full/run))
