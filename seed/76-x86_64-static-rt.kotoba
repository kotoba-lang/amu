;; the guest side: frame the request, read the answer; a request over 65536
;; bytes, a malformed one (M) or a helper that is gone traps
(defn- kxrt-spawn [h :i64] :i64
  (let [rq (kxrt-gl 2088) an (kxrt-gl 2096) a (kxrt-saddr h) n (kxrt-ps h) b (kxrt-gl 200)]
    (if (or (> n 65536) (< rq 3) (< an 3)) (kxrt-fail)
      (let [s (if (and (= (kxrt-write-all rq b (kxrt-w b 0 n 4)) 1) (= (kxrt-write-all rq a n) 1)) 1 (kxrt-fail))
            g (if (= (kxrt-read-all an b 4) 1) 1 (kxrt-fail))
            m (kxrt-le32 b) u (kxrt-gl 32) p (+ (kxrt-gl 24) u)]
        (cond (or (< m 1) (> m 32768)) (kxrt-fail)
              (> m (- KXRT-POOL u)) (kxrt-budget 4)
              (= (kxrt-read-all an p m) 0) (kxrt-fail)
              (= (kxrt-load8 p) 65) (let [w (kxrt-gs 32 (+ u m))] (kxrt-pair-new (- -1 (inc u)) (dec m)))
              (and (= (kxrt-load8 p) 82) (= m 2)) (kxrt-spawn-refuse (kxrt-load8 (inc p)))
              :else (kxrt-fail))))))
;; a request longer than 65536 bytes is not refused by name: it traps
(defn- kxrt-net [id :i64 h :i64] :i64
  (let [a (kxrt-saddr h) n (kxrt-ps h)]
    (cond (> n 65536) (kxrt-fail)
          (or (= id 43) (= id 45)) (kxrt-net-open id a n)
          :else (kxrt-net-handle id a n))))
(defn- kxrt-typed-cap-call [id :i64 rk :i64 sk :i64 req :i64] :i64
  (cond (not (kxrt-admitted? id)) (kxrt-fail)
        (not= rk sk) (kxrt-fail)
        (= rk 1)
          (let [v (kxrt-valid req)
                r (case id 3 (kxrt-sha256 req) 20 (kxrt-spawn req) 35 (kxrt-fs req) 37 (kxrt-io-write req) 38 (kxrt-args req) 39 (kxrt-io-error req) 42 (kxrt-gpu req)
