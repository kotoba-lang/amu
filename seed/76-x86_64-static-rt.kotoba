    1 (kxrt-w b (kxrt-w b (kxrt-w b i 0x666c616d2f74656e 8) 0x65722d64656d726f 8) 0x7473657571 5)
    2 (kxrt-w b (kxrt-w b (kxrt-w b i 0x726464612f74656e 8) 0x2d746f6e2d737365 8) 0x6465746e617267 7)
    3 (kxrt-w b (kxrt-w b (kxrt-w b i 0x646e61682f74656e 8) 0x6f2d74756f2d656c 8) 0x65676e61722d66 7)
    4 (kxrt-w b (kxrt-w b (kxrt-w b i 0x646e61682f74656e 8) 0x6f2d746f6e2d656c 8) 0x6e6570 3)
    5 (kxrt-w b (kxrt-w b (kxrt-w b i 0x646e61682f74656e 8) 0x65676475622d656c 8) 0x74 1)
    6 (kxrt-w b (kxrt-w b i 0x657479622f74656e 8) 0x7465676475622d 7)
    7 (kxrt-w b (kxrt-w b (kxrt-w b i 0x656d69742f74656e 8) 0x676475622d74756f 8) 0x7465 2)
    8 (kxrt-w b (kxrt-w b (kxrt-w b i 0x7473696c2f74656e 8) 0x656c6961662d6e65 8) 0x64 1)
    (kxrt-w b (kxrt-w b i 0x757465732f74656e 8) 0x64656c6961662d70 8)))
