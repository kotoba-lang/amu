        i (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b 0 0x4152545f4558454b 8) 0x646e696b3a7b2050 8) 0x6962617061633a20 8) 0x69773a207974696c 8) 0x723a203234206572 8) 0x3a206c6173756665 8)
        m (loop [k 1] (cond (>= k n) k (> k 64) k (kxrt-name-byte? (kxrt-load8 (+ a k))) (recur (inc k)) :else k))
        j (if (> m 1) (let [z (kxrt-copy (+ b i) (+ a 1) (dec m))] (+ i (dec m))) (kxrt-w b i 0x64656d616e6e75 7))
