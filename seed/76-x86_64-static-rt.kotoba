        gk (kxrt-gpu-fds (kxrt-env 0x5041435f4558454b 0x4352554f5345525f 0x3d32345f5345 22))
        nk (kxrt-net-grants)
        ;; wire 20: the spawn helper is forked here, before the limits and the filter
        sk (kxrt-spawn-start)
        ;; struct sigaction: handler, SA_RESTORER|SA_RESETHAND, restorer, mask
        act (+ (kxrt-gl 200) 8192)
        alt (kxrt-gs 248 (kxrt-map 65536)) ss (+ act 64)
        a0 (kxrt-store64 ss (kxrt-gl 248)) a1 (kxrt-store64 (+ ss 8) 0) a2 (kxrt-store64 (+ ss 16) 65536)
        a3 (if (< (kxrt-syscall 131 ss 0 0 0 0 0) 0) (kxrt-die) 0)
        ;; SA_RESTORER | SA_RESETHAND | SA_ONSTACK
        s0 (kxrt-store64 act (kxrt-load64 (+ ctx 400))) s1 (kxrt-store64 (+ act 8) 2348810240)
        s2 (kxrt-store64 (+ act 16) (kxrt-load64 (+ ctx 400))) s3 (kxrt-store64 (+ act 24) 0)
        g1 (kxrt-signal 4 act) g2 (kxrt-signal 5 act) g3 (kxrt-signal 7 act) g4 (kxrt-signal 8 act) g5 (kxrt-signal 11 act)
        g6 (kxrt-signal 14 act) g7 (kxrt-signal 24 act) g8 (kxrt-signal 31 act)
        g9 (kxrt-signal 2 act) g10 (kxrt-signal 15 act)
        lim (kxrt-limits sp)
        sb (kxrt-sandbox)
        ;; diagnostic: a syscall outside the filter must trap (SIGSYS, exit 120)
        pr (if (= (kxrt-env 0x4e41535f4558454b 0x4f52505f584f4244 0x3d4542 19) 0) 0 (kxrt-syscall 41 2 1 0 0 0 0))
        au (kxrt-gs 296 (if (= (kxrt-env 0x4552415f4558454b 0x3d4553555f414e 0 15) 0) 0 1))
        r (if (= mode 1) (kxrt-call-at (+ pl off) ctx (+ (kxrt-g) 320)) (kxrt-call-main ctx))
        e1 (if (= (kxrt-sink-close) 1) 0 (kxrt-fail))
        e2 (if (= (kxrt-flush) 1) 0 (kxrt-fail))
        e3 (kxrt-arena-use)]
    (cond (= (kxrt-gl 160) 1) (let [z (kxrt-report r)] (kxrt-exit 0))
          (= (kxrt-gl 240) 1) (kxrt-exit (bit-and r 255))
          :else (let [b (kxrt-gl 200) n (kxrt-sdec b r) z (kxrt-store8 (+ b n) 10) w (kxrt-write-all 1 b (inc n))] (kxrt-exit 0)))))
")
;; ---- host entry: --format host-entry (KOTOBA-174, ADR 0396) ----
;; The public Linux x86_64 entry names its own host, as the Mac CLI names
;; aarch64-macos. Its image is the --format static compiler with one change:
;; the standard kxrt-start sets the argument vector through kxrt-host-argv.
;; A `compile` command line with no `--target` word anywhere is read as if
;; `--target x86_64-linux` had been written as arguments 2 and 3; every other
;; command line (check, an explicit --target, every other command) is the
;; process's own. Context word 408 stays 0, so the image behaves as --format
;; static in everything else. The roots never contain this start.
(defn- xs-rt-host-argv [] :string
";; any argument 1..n-1 that is exactly --target
(defn- kxrt-host-has-target? [sp :i64 n :i64] :bool
  (loop [i 1]
    (cond (>= i n) false
          (kxrt-cstr= (kxrt-load64 (+ sp (* 8 (+ i 2)))) 0x7465677261742d2d 0 8) true
          :else (recur (inc i)))))
(defn- kxrt-host-copy [a :i64 sp :i64 n :i64] :i64
  (loop [i 2]
    (if (>= i n) 0
      (let [z (kxrt-store64 (+ a (* 8 (+ i 2))) (kxrt-load64 (+ sp (* 8 (+ i 2)))))] (recur (inc i))))))
;; argument i is at sp + 8 (i + 2); the new vector is n + 2 words, then the
;; two strings --target and x86_64-linux, NUL-terminated, at word n + 4
(defn- kxrt-host-argv [sp :i64 argc :i64] :i64
  (let [n (if (> argc 0) (dec argc) 0)]
    (if (and (>= n 2) (kxrt-cstr= (kxrt-load64 (+ sp 16)) 0x656c69706d6f63 0 7)
             (not (kxrt-host-has-target? sp n)))
      (let [a (kxrt-map (* 8 (+ n 8))) s (+ a (* 8 (+ n 4)))
            w0 (kxrt-store64 s 0x7465677261742d2d) w1 (kxrt-store64 (+ s 8) 0)
            w2 (kxrt-store64 (+ s 16) 0x6c2d34365f363878) w3 (kxrt-store64 (+ s 24) 0x78756e69)
            c0 (kxrt-store64 a (kxrt-load64 (+ sp 16))) c1 (kxrt-store64 (+ a 8) (kxrt-load64 (+ sp 24)))
            c2 (kxrt-store64 (+ a 16) s) c3 (kxrt-store64 (+ a 24) (+ s 16))
            c4 (kxrt-host-copy a sp n) g (kxrt-gs 72 (+ n 2))]
        (kxrt-gs 80 a))
      (kxrt-gs 80 (+ sp 16)))))
")
(defn- xs-rt-host-at [] :string "b (kxrt-gs 80 (+ sp 16))")
;; "" (no kxrt-start, so seed/75 refuses with E7102) unless the standard
;; start sets the vector exactly once, at the expected place
(defn- xs-rt-host-start [] :string
  (let [T (xs-rt-start) A (xs-rt-host-at) i (string-index-of T A) k (string-length A)]
    (if (or (< i 0) (>= (string-index-of (string-substring T (+ i k) (string-length T)) A) 0)) ""
      (string-concat (xs-rt-host-argv)
        (string-concat (string-substring T 0 i)
          (string-concat "b (kxrt-host-argv sp argc)" (string-substring T (+ i k) (string-length T))))))))
(defn- xs-rt-launch [] :string
"
;; ---- launcher: --format launcher, context word 408 = 4 (ADR 0371 step 4) ----
;; Appended after the runtime in place of the standard kxrt-start, in this
;; format only, so static and runner images do not change. Command line:
;;   LAUNCHER WALL ALLOW GRANT PROVIDER [ARG ...] -- GUEST [ARG ...]
;; GRANT and PROVIDER are both - (no provider) or both paths; ALLOW is the
;; guest's KEXE_ALLOW and names wire 42 exactly when a provider is given.
;; The launcher reads each input once into a sealed memfd while hashing it,
;; and executes or passes on that copy. It starts the provider, then the
;; guest, each with fixed descriptors and nothing else open:
;;   provider: 0 requests, 1 answers, 2 stderr, 3 the grant, 4 its report
;;   guest:    0 stdin, 1 a pipe to the launcher, 2 stderr, 3 requests, 4 answers
;; The guest environment is built, not inherited: KEXE_ALLOW,
;; KEXE_STRUCTURED_REPORT=1, KEXE_WALL_SECONDS, KEXE_CAP_RESOURCES_42=3,4 with a
;; provider, and the launcher own KEXE_FUEL, KEXE_STACK_BYTES, KEXE_CPU_SECONDS,
;; KEXE_SECCOMP, KEXE_CAP_RESOURCES_35, KEXE_ARENA_USE, KEXE_SANDBOX_PROBE when
;; set. The provider environment is fixed: MESA_SHADER_CACHE_DISABLE=true and
;; VK_LOADER_LAYERS_DISABLE=~all~ (kxrt-l-penv). The grant is opaque here: hashed and
;; passed on; the provider reads and enforces it. Once both have executed, the
;; launcher limits and seals itself, relays the guest stdout, and waits until
;; both exit. At WALL seconds it kills the guest; the provider gets 5 seconds
;; after the guest exits, then it is killed too. The run facts then reach main
;; as wire-38 arguments 0..19 (tools/static_launcher.kotoba), which writes the
;; receipt; the launcher exits with main result and 255.
;; Syscall numbers (kxrt-nr): 0 read 1 openat 2 close 3 fstat 4 lseek 5 clone
;; 6 wait4 7 kill 8 fcntl 9 prctl 10 getppid 11 clock_gettime 12 ppoll 13 dup3
;; 14 memfd_create 15 execveat 16 pidfd_open 17 close_range 18 rt_sigprocmask
;; 19 getpid 20 seccomp 21 pipe2 22 sigaltstack; anything else: the seccomp
;; audit arch.
(defn- kxrt-nr [k :i64] :i64
  (case k 0 0 1 257 2 3 3 5 4 8 5 56 6 61 7 62 8 72 9 157 10 110 11 228 12 271 13 292
          14 319 15 322 16 434 17 436 18 14 19 39 20 317 21 293 22 131 3221225534))
;; Globals (G+16384.., reserved in the runtime's global map): 16384 scratch L, 16392/16416 guest/provider pid, 16400/16424 pidfd,
;; 16408/16432 wait status (-1 until reaped), 16440 guest stdout fd, 16448 provider
;; report fd, 16456 tail bytes, 16464 report bytes, 16472 report overflow, 16480 timed
;; out, 16488 provider killed, 16496 start ns, 16504 wall deadline, 16512 provider
;; deadline, 16520 relay ok, 16528 launcher pid, 16536 drain deadline, 16544 provider
;; given, 16560 stdout bytes; pipes (read, write): 16576 stdout 16592 requests
;; 16608 answers 16624 report 16640 status; memfds: 16656 guest 16664 provider 16672 grant.
;; Scratch (L+): 0 environment text, 8192 guest envp, 8448 empty envp,
;; 8456 empty string, 8460 1, 8464 kexe, 8472 3,4, 8480 /proc/self/exe,
;; 8512 pollfds, 8576 timespec, 8592 wait status, 8600 pipe fds, 8608 empty
;; signal set, 8616 status byte, 8704 input hash, 9600.. digests (launcher,
;; guest, provider, grant, stdout; 80 bytes apart), 10240 provider fd pairs,
;; 10304 guest fd pairs, 10368 provider environment text, 10432 provider
;; envp, 10496 stdout hash, 12288 stdout tail, 20480 fact
;; text, 36864 fact pointers, 40960 read buffer, 106496 provider report.
(defn- kxrt-l [] :i64 (kxrt-gl 16384))
(defn- kxrt-l-fail [code :i64 who :i64] :i64
  (let [b (kxrt-gl 200) g (kxrt-l-reap 16392) p (kxrt-l-reap 16416)
        i (kxrt-w b (kxrt-w b 0 0x75616c2d6578656b 8) 0x203a726568636e 7)
        j (case code
            1 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x57203a6567617375 8) 0x4f4c4c41204c4c41 8) 0x20544e4152472057 8) 0x52454449564f5250 8) 0x2e2e204752415b20 8) 0x5547202d2d205d2e 8) 0x4752415b20545345 8) 0x5d2e2e2e20 5)
            2 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x73756d204c4c4157 8) 0x2e2e312065622074 8) 0x6573203030343638 8) 0x73646e6f63 5)
            3 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x756d20574f4c4c41 8) 0x6977206562207473 8) 0x3020736469206572 8) 0x726f203535322e2e 8) 0x68746977202c2d20 8) 0x6361786520323420 8) 0x6e65687720796c74 8) 0x69766f7270206120 8) 0x6720736920726564 8) 0x6e657669 4)
            4 (kxrt-w b (kxrt-w b (kxrt-w b i 0x7220746f6e6e6163 8) 0x69206e6120646165 8) 0x7475706e 4)
            5 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x7475706e69206e61 8) 0x74706d6520736920 8) 0x6f6f7420726f2079 8) 0x656772616c20 6)
            6 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x7320746f6e6e6163 8) 0x6f632061206c6165 8) 0x6e6120666f207970 8) 0x7475706e6920 6)
            7 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x6320746f6e6e6163 8) 0x2061206574616572 8) 0x20726f2065706970 8) 0x7365636f72702061 8) 0x73 1)
            8 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x20646c6968632061 8) 0x6f6e20646c756f63 8) 0x6174732065622074 8) 0x64657472 4)
            9 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x73202c6e69647473 8) 0x726f2074756f6474 8) 0x2072726564747320 8) 0x6f20746f6e207369 8) 0x6e6570 3)
            10 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x6920746f6e6e6163 8) 0x74206c6c6174736e 8) 0x636e75616c206568 8) 0x746c696620726568 8) 0x7265 2)
            11 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i 0x7720746f6e6e6163 8) 0x20726f6620746961 8) 0x6c69686320656874 8) 0x6e657264 4)
            i)
        k (case who
            1 (kxrt-w b j 0x7473657567203a 7)
            2 (kxrt-w b (kxrt-w b j 0x6469766f7270203a 8) 0x7265 2)
            3 (kxrt-w b j 0x746e617267203a 7)
            4 (kxrt-w b (kxrt-w b j 0x68636e75616c203a 8) 0x6567616d69207265 8)
            j)
        z (kxrt-err-text b (kxrt-w b k 0xa 1))]
    (kxrt-exit (if (<= code 3) 2 1))))
;; a started child that is not reaped yet: SIGKILL, then reap it
(defn- kxrt-l-reap [k :i64] :i64
  (if (not (kxrt-l-live? k)) 0
    (let [s (+ (kxrt-l) 8592) x (kxrt-l-kill k) z (kxrt-store64 s 0)
          y (kxrt-syscall (kxrt-nr 6) (kxrt-gl k) s 0 0 0 0)]
      (kxrt-gs (+ k 16) (bit-and (kxrt-load64 s) 4294967295)))))
(defn- kxrt-l-live? [k :i64] :bool (and (> (kxrt-gl k) 0) (= (kxrt-gl (+ k 16)) -1)))
(defn- kxrt-l-kill [k :i64] :i64 (kxrt-syscall (kxrt-nr 7) (kxrt-gl k) 9 0 0 0 0))
(defn- kxrt-l-now [] :i64
  (let [t (+ (kxrt-l) 8576) r (kxrt-syscall (kxrt-nr 11) 1 t 0 0 0 0)]
    (+ (* (kxrt-load64 t) 1000000000) (kxrt-load64 (+ t 8)))))

;; incremental SHA-256 (kxrt-sha-block) at c: h @0, w @64, carry @576 (64
;; bytes), carry length @640, total @648, final blocks @656 (128 bytes)
(defn- kxrt-l-sha-init [c :i64] :i64
  (let [z (loop [i 0] (if (= i 8) 0 (let [y (kxrt-store64 (+ c (* 8 i)) (kxrt-sha-h0 i))] (recur (inc i)))))
        a (kxrt-store64 (+ c 640) 0)]
    (kxrt-store64 (+ c 648) 0)))
(defn- kxrt-l-sha-update [c :i64 a :i64 n :i64] :i64
  (let [t (kxrt-store64 (+ c 648) (+ (kxrt-load64 (+ c 648)) n))]
    (loop [i 0]
      (if (>= i n) 0
        (let [cl (kxrt-load64 (+ c 640))]
          (if (and (= cl 0) (>= (- n i) 64))
            (let [z (kxrt-sha-block c (+ c 64) (+ a i))] (recur (+ i 64)))
            (let [k (if (< (- 64 cl) (- n i)) (- 64 cl) (- n i))
                  z (kxrt-copy (+ c 576 cl) (+ a i) k)
                  y (if (= (+ cl k) 64)
                      (let [x (kxrt-sha-block c (+ c 64) (+ c 576))] (kxrt-store64 (+ c 640) 0))
                      (kxrt-store64 (+ c 640) (+ cl k)))]
              (recur (+ i k)))))))))
;; 64 lowercase hex digits and a NUL at hex
(defn- kxrt-l-sha-final [c :i64 hex :i64] :i64
  (let [cl (kxrt-load64 (+ c 640)) n (kxrt-load64 (+ c 648)) tail (+ c 656)
        a (kxrt-copy tail (+ c 576) cl)
        p (kxrt-store8 (+ tail cl) 128)
        padded (if (<= (inc cl) 56) 64 128)
        zz (loop [i (inc cl)] (if (>= i padded) 0 (let [y (kxrt-store8 (+ tail i) 0)] (recur (inc i)))))
        bits (* n 8)
        lb (loop [i 0] (if (= i 8) 0 (let [y (kxrt-store8 (+ tail (- padded 1 i)) (bit-and (u64-shift-right bits (* 8 i)) 255))] (recur (inc i)))))
        b1 (kxrt-sha-block c (+ c 64) tail)
        b2 (if (= padded 128) (kxrt-sha-block c (+ c 64) (+ tail 64)) 0)]
    (loop [i 0]
      (if (= i 32) (kxrt-store8 (+ hex 64) 0)
        (let [word (kxrt-load64 (+ c (* 8 (quot i 4)))) byte (bit-and (u64-shift-right word (* 8 (- 3 (- i (* 4 (quot i 4)))))) 255)
              hi (u64-shift-right byte 4) lo (bit-and byte 15)
              y1 (kxrt-store8 (+ hex (* 2 i)) (if (< hi 10) (+ 48 hi) (+ 87 hi)))
              y2 (kxrt-store8 (+ hex (inc (* 2 i))) (if (< lo 10) (+ 48 lo) (+ 87 lo)))]
          (recur (inc i)))))))

;; Read path once (at most max bytes, not empty), hashing it into hex. With
;; copy, the bytes also go to a memfd, sealed against every change and rewound;
;; that memfd is the answer. Failures name who.
(defn- kxrt-l-take [path :i64 who :i64 hex :i64 max :i64 copy :bool] :i64
  (let [b (kxrt-l) fd (kxrt-open-path path 524288 0)
        u (if (< fd 0) (kxrt-l-fail 4 who) 0)
        mf (if copy (kxrt-syscall (kxrt-nr 14) (+ b 8464) 3 0 0 0 0) 0)
        v (if (or (< mf 0) (> mf 99)) (kxrt-l-fail 6 who) 0)
        c (+ b 8704) buf (+ b 40960) s (kxrt-l-sha-init c)
        n (loop [total 0]
            (let [r (kxrt-syscall (kxrt-nr 0) fd buf 65536 0 0 0)]
              (cond (= r -4) (recur total)
                    (< r 0) -1
                    (= r 0) total
                    (> (+ total r) max) -2
                    :else (let [w (if copy (kxrt-write-all mf buf r) 1)]
                            (if (= w 0) -3 (let [h (kxrt-l-sha-update c buf r)] (recur (+ total r))))))))
        x (kxrt-close fd)]
    (cond (= n -1) (kxrt-l-fail 4 who)
          (= n -3) (kxrt-l-fail 6 who)
          (<= n 0) (kxrt-l-fail 5 who)
          :else (let [h (kxrt-l-sha-final c hex)]
                  (cond (not copy) 0
                        (or (< (kxrt-syscall (kxrt-nr 8) mf 1033 15 0 0 0) 0)
                            (< (kxrt-syscall (kxrt-nr 4) mf 0 0 0 0 0) 0)) (kxrt-l-fail 6 who)
                        :else mf)))))

;; pipe2(O_CLOEXEC): read end at G+k, write end at G+k+8, both below 100
(defn- kxrt-l-pipe [k :i64] :i64
  (let [p (+ (kxrt-l) 8600) z (kxrt-store64 p 0) r (kxrt-syscall (kxrt-nr 21) p 524288 0 0 0 0)
        v (kxrt-load64 p) a (bit-and v 4294967295) w (u64-shift-right v 32)]
    (if (or (< r 0) (> a 99) (> w 99)) (kxrt-l-fail 7 0)
      (let [x (kxrt-gs k a)] (kxrt-gs (+ k 8) w)))))
(defn- kxrt-l-pair [m :i64 k :i64 src :i64 dst :i64] :i64
  (let [z (kxrt-store64 (+ m (* 16 k)) src)] (kxrt-store64 (+ m (* 16 k) 8) dst)))

;; ---- the child, between fork and exec ----
;; The parent-death signal is SIGKILL. The status pipe goes to 110 and the
;; image to 111, the n (source, target) pairs at m through 100.., all
;; close-on-exec; everything else from 3 up is closed; then each source lands
;; on its target, the signal mask is cleared and no_new_privs is set before
;; execveat(111, empty, AT_EMPTY_PATH). A failure writes its stage (1 dup,
;; 2 target, 3 no_new_privs, 4 exec) on the status pipe, which otherwise closes
;; on exec.
(defn- kxrt-l-stage [fd :i64 k :i64] :i64
  (let [b (+ (kxrt-l) 8616) z (kxrt-store8 b k) w (kxrt-write-all fd b 1)] (kxrt-exit 127)))
(defn- kxrt-l-dup [a :i64 t :i64 fl :i64] :bool (>= (kxrt-syscall (kxrt-nr 13) a t fl 0 0 0) 0))
(defn- kxrt-l-closefrom [a :i64 z :i64] :i64
  (if (>= (kxrt-syscall (kxrt-nr 17) a z 0 0 0 0) 0) 0
    (loop [fd a] (if (or (> fd z) (> fd 1023)) 0 (let [x (kxrt-close fd)] (recur (inc fd)))))))
(defn- kxrt-l-child [m :i64 n :i64 exe :i64 argv :i64 envp :i64] :i64
  (let [b (kxrt-l)
        d (kxrt-syscall (kxrt-nr 9) 1 9 0 0 0 0)
        p (if (not= (kxrt-syscall (kxrt-nr 10) 0 0 0 0 0 0) (kxrt-gl 16528)) (kxrt-exit 127) 0)
        s (if (kxrt-l-dup (kxrt-gl 16648) 110 524288) 0 (kxrt-l-stage (kxrt-gl 16648) 1))
        x (if (kxrt-l-dup exe 111 524288) 0 (kxrt-l-stage 110 1))
        a (loop [k 0] (cond (= k n) 0 (kxrt-l-dup (kxrt-load64 (+ m (* 16 k))) (+ 100 k) 524288) (recur (inc k)) :else (kxrt-l-stage 110 1)))
        c (let [y (kxrt-l-closefrom 3 99)] (kxrt-l-closefrom 112 4294967295))
        t (loop [k 0] (cond (= k n) 0 (kxrt-l-dup (+ 100 k) (kxrt-load64 (+ m (* 16 k) 8)) 0) (recur (inc k)) :else (kxrt-l-stage 110 2)))
        u (kxrt-syscall (kxrt-nr 18) 2 (+ b 8608) 0 8 0 0)
        v (if (< (kxrt-syscall (kxrt-nr 9) 38 1 0 0 0 0) 0) (kxrt-l-stage 110 3) 0)
        e (kxrt-syscall (kxrt-nr 15) 111 (+ b 8456) argv envp 4096 0)]
    (kxrt-l-stage 110 4)))
;; fork who (1 guest, 2 provider) and wait until it has executed; its pid
;; and pidfd go to G+16392/16400 or G+16416/16424
(defn- kxrt-l-spawn [who :i64 m :i64 n :i64 exe :i64 argv :i64 envp :i64] :i64
  (let [k (if (= who 1) 16392 16416) s (kxrt-l-pipe 16640)
        pid (kxrt-syscall (kxrt-nr 5) 17 0 0 0 0 0)
        c (if (= pid 0) (kxrt-l-child m n exe argv envp) 0)
        f (if (< pid 0) (kxrt-l-fail 7 who) (kxrt-gs k pid))
        pf (kxrt-gs (+ k 8) (kxrt-syscall (kxrt-nr 16) pid 0 0 0 0 0))
        x (kxrt-close (kxrt-gl 16648))
        b (+ (kxrt-l) 8616)
        r (loop [t 0] (let [r (kxrt-syscall (kxrt-nr 0) (kxrt-gl 16640) b 1 0 0 0)] (if (= r -4) (recur t) r)))
        y (kxrt-close (kxrt-gl 16640))]
    (cond (not= r 0) (kxrt-l-fail 8 who)
          (< (kxrt-gl (+ k 8)) 0) (kxrt-l-fail 7 who)
          :else pid)))

;; ---- the guest environment ----
;; n bytes of a name packed in w0 w1 w2 (as kxrt-env takes it) at b+i
(defn- kxrt-l-name [b :i64 i :i64 w0 :i64 w1 :i64 w2 :i64 n :i64] :i64
  (let [j (kxrt-w b i w0 (if (> n 8) 8 n))
        k (if (> n 8) (kxrt-w b j w1 (if (> n 16) 8 (- n 8))) j)]
    (if (> n 16) (kxrt-w b k w2 (- n 16)) k)))
;; NAME=VALUE (value: the C string v) at L+i; envp slot e points at it
