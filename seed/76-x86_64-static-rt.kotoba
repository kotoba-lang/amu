;; ---- wires 43..47 native TCP: :net/listen :net/accept :net/dial :net/read :net/write ----
;; The removed loader's knet_serve_one, in this process: the runtime decides
;; every request (tools/kexe_loader_decisions.kotoba ops 10-18, the names of
;; tools/kexe_loader_names.kotoba) and makes the system calls; the guest
;; cannot reach them itself. IPv4 only, exact granted addresses, at most 16
;; handles, 16384 bytes per read or write, timeouts up to 30000 ms.
;; State at G+1024: 16 slots of (kind, fd) words, kind 0 free 1 listener
;; 2 connection; G+1280 the listen scope (count, then 16 entries), G+1552 the
;; dial scope. An entry or address is ip*65536+port.
;; Scratch: S+14336 sockaddr_in, S+14400 pollfd, S+14432 timespec, S+14464
;; clock, S+14496 socket option and its length.
(defn- kxrt-net-kind [s :i64] :i64 (kxrt-gl (+ 1024 (* 16 s))))
(defn- kxrt-net-fd [s :i64] :i64 (kxrt-gl (+ 1032 (* 16 s))))
