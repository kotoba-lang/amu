        (let [n (kxrt-le32 b)]
          (if (or (> n 65536) (= (kxrt-read-all rq (+ b 8) n) 0)) (kxrt-exit 0)
            (let [z (kxrt-sp-one (+ b 8) n an)] (recur (inc k)))))))))
;; at start, before the limits and the filter: the grant, then the helper
(defn- kxrt-spawn-start [] :i64
  (if (not (kxrt-admitted? 20)) 0
    (let [m1 (kxrt-gs 2048 (kxrt-map 65536)) m2 (kxrt-gs 2056 (kxrt-map 4096))
          a (kxrt-sp-list (kxrt-env 0x5041435f4558454b 0x4352554f5345525f 0x3d30325f5345 22) false)
          b (kxrt-sp-list (kxrt-env 0x4150535f4558454b 0x3d564e455f4e57 0 15) true)
          c (kxrt-gs 2080 (kxrt-sp-lookup (kxrt-env 0x4150535f4558454b 0x5f485441505f4e57 0x3d50554b4f4f4c 23)))
          d (if (and (= (kxrt-gl 2080) 1) (not (kxrt-sp-bases-distinct?))) (kxrt-exit 2) 0)
          fds (+ (kxrt-gl 200) 14528)
          p1 (kxrt-syscall 293 fds 524288 0 0 0 0) p2 (kxrt-syscall 293 (+ fds 8) 524288 0 0 0 0)
          w (kxrt-load64 fds) x (kxrt-load64 (+ fds 8))
          rq-r (bit-and w 4294967295) rq-w (u64-shift-right w 32)
          an-r (bit-and x 4294967295) an-w (u64-shift-right x 32)]
