;; op 45: with lookup, the programs' last segments must differ
(defn- kxrt-sp-bases-distinct? [] :bool
  (let [c (kxrt-gl 2064)]
    (loop [i 0 j 1]
      (cond (>= i c) true
            (>= j c) (recur (inc i) (+ i 2))
            :else (let [bi (kxrt-sp-base i) bj (kxrt-sp-base j) ni (- (kxrt-sp-plen i) bi) nj (- (kxrt-sp-plen j) bj)]
                    (if (and (= ni nj) (kxrt-same (+ (kxrt-sp-prog i) bi) (+ (kxrt-sp-prog j) bj) ni)) false (recur i (inc j))))))))
(defn- kxrt-sp-lookup [s :i64] :i64
