                    s (+ io 4194304)
                    f (loop [i 0] (let [r (kxrt-syscall 0 st-r s 8 0 0 0)] (if (= r -4) (recur (inc i)) r)))
                    v (kxrt-load64 s) z (kxrt-close st-r)]
