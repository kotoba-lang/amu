(defn- kxrt-now-ms [] :i64
  (let [t (+ (kxrt-gl 200) 14464) r (kxrt-syscall 228 1 t 0 0 0 0)]
    (+ (* (kxrt-load64 t) 1000) (quot (kxrt-load64 (+ t 8)) 1000000))))
