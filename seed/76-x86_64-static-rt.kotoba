;; ---- wire 20 :process/spawn: a helper forked before the sandbox ----
;; The removed loader ran programs from its unsandboxed supervisor. This
;; runtime has no supervisor, and a child of the sandboxed process would
;; inherit its seccomp filter and its 64 MiB address-space limit. So when
;; wire 20 is granted, kxrt-start forks one helper before the limits and the
;; filter. The helper keeps its own copy of the grant and decides every
;; request itself (tools/linux_static_handlers.kotoba ops 33..42), then forks
;; and executes the program; the sandboxed guest only frames a request on one
;; pipe and reads one answer on another (a u32 little-endian length, then a
;; kind byte and the bytes: A an answer, R a refusal index, M a malformed
;; request). The helper runs no guest code and ends at end of file.
;; Grant: KEXE_CAP_RESOURCES_20 (programs, colon-separated canonical absolute
;; paths, 1..16 distinct), KEXE_SPAWN_ENV (names, colon-separated, 0..16),
;; KEXE_SPAWN_PATH_LOOKUP (1, or 0 / absent). A malformed grant exits 2; an
;; absent or empty program list grants nothing.
;; State at G+2048: 2048 program map (16 x 4096), 2056 name map (16 x 256),
;; 2064 programs, 2072 names, 2080 lookup, 2088 the request fd and 2096 the
;; answer fd (guest side), 2104 the helper's pid, 2112.. program lengths,
;; 2240.. name lengths.
;; Helper buffers in the io buffer: +1 MiB request, +2 MiB argv strings,
;; +2 MiB+4096 argv, +2 MiB+8192 envp, +3 MiB output, +4 MiB status and
;; times, +5 MiB the answer frame.
(defn- kxrt-le32 [b :i64] :i64
  (bit-or (kxrt-load8 b) (bit-or (i64-shift-left (kxrt-load8 (+ b 1)) 8)
                                 (bit-or (i64-shift-left (kxrt-load8 (+ b 2)) 16) (i64-shift-left (kxrt-load8 (+ b 3)) 24)))))
(defn- kxrt-sp-prog [k :i64] :i64 (+ (kxrt-gl 2048) (* 4096 k)))
(defn- kxrt-sp-plen [k :i64] :i64 (kxrt-gl (+ 2112 (* 8 k))))
(defn- kxrt-sp-name [k :i64] :i64 (+ (kxrt-gl 2056) (* 256 k)))
(defn- kxrt-sp-nlen [k :i64] :i64 (kxrt-gl (+ 2240 (* 8 k))))
;; op 44 for a program: a slash first, 2..4095 bytes, no empty, . or .. segment
(defn- kxrt-sp-path-ok? [a :i64 n :i64] :bool
  (and (>= n 2) (<= n 4095) (= (kxrt-load8 a) 47)
       (loop [s 1 i 1]
         (cond (> i n) true
               (or (= i n) (= (kxrt-load8 (+ a i)) 47))
                 (let [m (- i s)]
                   (cond (= m 0) false
                         (and (= m 1) (= (kxrt-load8 (+ a s)) 46)) false
                         (and (= m 2) (= (kxrt-load8 (+ a s)) 46) (= (kxrt-load8 (+ a s 1)) 46)) false
                         :else (recur (inc i) (inc i))))
               :else (recur s (inc i))))))
;; the offset of the last segment of program k
(defn- kxrt-sp-base [k :i64] :i64
  (let [a (kxrt-sp-prog k)] (loop [i (dec (kxrt-sp-plen k))] (cond (< i 0) 0 (= (kxrt-load8 (+ a i)) 47) (inc i) :else (recur (dec i))))))
(defn- kxrt-sp-dup? [a :i64 n :i64 c :i64] :bool
  (loop [k 0] (cond (>= k c) false (and (= (kxrt-sp-plen k) n) (kxrt-same (kxrt-sp-prog k) a n)) true :else (recur (inc k)))))
(defn- kxrt-sp-add-prog [a :i64 n :i64] :i64
  (let [c (kxrt-gl 2064)]
    (if (or (>= c 16) (not (kxrt-sp-path-ok? a n)) (kxrt-sp-dup? a n c)) (kxrt-exit 2)
      (let [z (kxrt-copy (kxrt-sp-prog c) a n) y (kxrt-store8 (+ (kxrt-sp-prog c) n) 0)
            x (kxrt-gs (+ 2112 (* 8 c)) n)]
        (kxrt-gs 2064 (inc c))))))
;; op 44 for a name: 1..255 bytes, no =
(defn- kxrt-sp-add-name [a :i64 n :i64] :i64
  (let [c (kxrt-gl 2072)]
    (if (or (>= c 16) (< n 1) (> n 255) (< (kxrt-net-until a n 0 61) n)) (kxrt-exit 2)
      (let [z (kxrt-copy (kxrt-sp-name c) a n) x (kxrt-gs (+ 2240 (* 8 c)) n)] (kxrt-gs 2072 (inc c))))))
;; split the C string s at colons, calling add on each entry
(defn- kxrt-sp-list [s :i64 names :bool] :i64
  (if (or (= s 0) (= (kxrt-load8 s) 0)) 0
    (let [n (kxrt-cstrlen s)]
      (loop [st 0]
        (let [e (kxrt-net-until s n st 58)
              z (if names (kxrt-sp-add-name (+ s st) (- e st)) (kxrt-sp-add-prog (+ s st) (- e st)))]
          (if (>= e n) 0 (recur (inc e))))))))
;; op 45: with lookup, the programs' last segments must differ
(defn- kxrt-sp-bases-distinct? [] :bool
  (let [c (kxrt-gl 2064)]
    (loop [i 0 j 1]
      (cond (>= i c) true
            (>= j c) (recur (inc i) (+ i 2))
            :else (let [bi (kxrt-sp-base i) bj (kxrt-sp-base j) ni (- (kxrt-sp-plen i) bi) nj (- (kxrt-sp-plen j) bj)]
                    (if (and (= ni nj) (kxrt-same (+ (kxrt-sp-prog i) bi) (+ (kxrt-sp-prog j) bj) ni)) false (recur i (inc j))))))))
(defn- kxrt-sp-lookup [s :i64] :i64
  (cond (= s 0) 0
        (and (= (kxrt-load8 s) 49) (= (kxrt-load8 (inc s)) 0)) 1
        (and (= (kxrt-load8 s) 48) (= (kxrt-load8 (inc s)) 0)) 0
        :else (kxrt-exit 2)))
(defn- kxrt-now-ns [] :i64
  (let [t (+ (kxrt-gl 200) 14464) r (kxrt-syscall 228 1 t 0 0 0 0)]
    (+ (* (kxrt-load64 t) 1000000000) (kxrt-load64 (+ t 8)))))
;; ppoll on fd (or on nothing when fd < 0) for at most ns
(defn- kxrt-sp-poll [fd :i64 ns :i64] :i64
  (let [st (+ (kxrt-gl 232) 4194304) p (+ st 64) ts (+ st 96)
        a (kxrt-store64 p (bit-or (bit-and fd 4294967295) (i64-shift-left 1 32)))
        b (kxrt-store64 ts (quot ns 1000000000)) c (kxrt-store64 (+ ts 8) (- ns (* 1000000000 (quot ns 1000000000))))]
    (kxrt-syscall 271 (if (< fd 0) 0 p) (if (< fd 0) 0 1) ts 0 0 0)))
;; the answer frame: kind and payload [a, a+n)
(defn- kxrt-sp-reply [an :i64 kind :i64 a :i64 n :i64] :i64
  (let [f (+ (kxrt-gl 232) 5242880) z (kxrt-w f 0 (inc n) 4) y (kxrt-store8 (+ f 4) kind)
        x (kxrt-copy (+ f 5) a n)]
    (kxrt-write-all an f (+ n 5))))
(defn- kxrt-sp-refused [an :i64 idx :i64] :i64
  (let [b (+ (kxrt-gl 232) 4194304) z (kxrt-store8 b idx)] (kxrt-sp-reply an 82 b 1)))
(defn- kxrt-sp-close4 [a :i64 b :i64 c :i64 d :i64] :i64
  (let [w (kxrt-close a) x (kxrt-close b) y (kxrt-close c)] (kxrt-close d)))
;; wait4 until the child is reaped; its raw status
(defn- kxrt-sp-reap [pid :i64] :i64
  (let [st (+ (kxrt-gl 232) 4194304)]
    (loop [k 0] (let [r (kxrt-syscall 61 pid (+ st 8) 0 0 0 0)] (if (= r -4) (recur (inc k)) (bit-and (kxrt-load64 (+ st 8)) 4294967295))))))
(defn- kxrt-sp-kill [pid :i64] :i64 (let [z (kxrt-syscall 62 pid 9 0 0 0 0)] (kxrt-sp-reap pid)))
;; the child: stdio, every other descriptor close-on-exec, no new privileges,
;; the scope root as its directory, execve. A failure goes to the status
;; pipe as step * 4096 + errno (op 42), then exit 127.
(defn- kxrt-sp-child [in-r :i64 out-w :i64 st-w :i64 prog :i64 argv :i64 envp :i64] :i64
  (let [s (+ (kxrt-gl 232) 4194304)
        step (cond (< (kxrt-syscall 292 in-r 0 0 0 0 0) 0) 0
                   (< (kxrt-syscall 292 out-w 1 0 0 0 0) 0) 0
                   (< (kxrt-syscall 436 3 4294967295 4 0 0 0) 0) 1
                   (< (kxrt-syscall 157 38 1 0 0 0 0) 0) 2
                   (and (> (kxrt-gl 656) 0) (< (kxrt-syscall 81 (kxrt-gl 528) 0 0 0 0 0) 0)) 3
                   :else 4)
        e (if (= step 4) (kxrt-syscall 59 prog argv envp 0 0 0) -1)
        z (kxrt-store64 s (+ (* step 4096) (if (< e 0) (- 0 e) 0)))
        y (kxrt-write-all st-w s 8)]
    (kxrt-exit 127)))
;; which granted program the request's program [a, a+n) runs (op 34), or -1
(defn- kxrt-sp-choose [a :i64 n :i64] :i64
  (let [slash (< (kxrt-net-until a n 0 47) n) lookup (= (kxrt-gl 2080) 1)]
    (loop [k 0]
      (if (>= k (kxrt-gl 2064)) -1
        (let [p (kxrt-sp-prog k) pl (kxrt-sp-plen k) bs (kxrt-sp-base k)
              exact (and (= pl n) (kxrt-same p a n))
              base (and (= (- pl bs) n) (kxrt-same (+ p bs) a n))]
          (if (if slash exact (and lookup base)) k (recur (inc k))))))))
;; envp: the host entries whose name the grant lists (op 36, at most 64)
(defn- kxrt-sp-env-ok? [s :i64] :bool
  (let [n (loop [i 0] (let [c (kxrt-load8 (+ s i))] (if (or (= c 0) (= c 61)) i (recur (inc i)))))]
    (and (= (kxrt-load8 (+ s n)) 61)
         (loop [k 0] (cond (>= k (kxrt-gl 2072)) false
                           (and (= (kxrt-sp-nlen k) n) (kxrt-same (kxrt-sp-name k) s n)) true
                           :else (recur (inc k)))))))
(defn- kxrt-sp-envp [ep :i64] :i64
  (loop [p (kxrt-gl 88) c 0]
    (let [s (kxrt-load64 p)]
      (if (= s 0) (kxrt-store64 (+ ep (* 8 c)) 0)
        (if (and (< c 64) (kxrt-sp-env-ok? s))
          (let [z (kxrt-store64 (+ ep (* 8 c)) s)] (recur (+ p 8) (inc c)))
          (recur (+ p 8) c))))))
;; argv strings and pointers from [a, a+n), split at ARG_SEP
(defn- kxrt-sp-argv [a :i64 n :i64 as :i64 ap :i64] :i64
  (loop [st 0 d 0 c 0]
    (let [k (kxrt-find (+ a st) (- n st) 0x5045535f475241 0 7)
          e (if (< k 0) n (+ st k))
          z (kxrt-copy (+ as d) (+ a st) (- e st)) y (kxrt-store8 (+ as d (- e st)) 0)
          x (kxrt-store64 (+ ap (* 8 c)) (+ as d))]
      (if (< k 0) (kxrt-store64 (+ ap (* 8 (inc c))) 0)
        (recur (+ e 7) (+ d (inc (- e st))) (inc c))))))
;; the output, until end of file, within the deadline and the budget:
;; got >= 0, -4 the deadline, -3 the budget
(defn- kxrt-sp-output [fd :i64 o :i64 dl :i64] :i64
  (loop [got 0]
    (let [left (- dl (kxrt-now-ns))]
      (if (<= left 0) -4
        (let [r (kxrt-sp-poll fd left)]
          (cond (= r -4) (recur got)
                (< r 0) -4
                (= r 0) (recur got)
                :else (let [m (kxrt-syscall 0 fd (+ o got) (- 16385 got) 0 0 0)]
                        (cond (= m -4) (recur got)
                              (<= m 0) got
                              (> (+ got m) 16384) -3
                              :else (recur (+ got m))))))))))
;; wait for the exit within the deadline (10 ms slices, op 40): raw status, or -1
(defn- kxrt-sp-wait [pid :i64 dl :i64] :i64
  (let [st (+ (kxrt-gl 232) 4194304)]
    (loop [k 0]
      (let [r (kxrt-syscall 61 pid (+ st 8) 1 0 0 0)]
        (cond (= r pid) (bit-and (kxrt-load64 (+ st 8)) 4294967295)
              (= r -4) (recur (inc k))
              (< r 0) -1
              :else (let [left (- dl (kxrt-now-ns))]
                      (if (<= left 0) -1 (let [z (kxrt-sp-poll -1 (if (< left 10000000) left 10000000))] (recur (inc k))))))))))
(defn- kxrt-sp-run [an :i64 k :i64 argv :i64 envp :i64] :i64
