;; the number of ARG_SEP in [a, a+n)
(defn- kxrt-count-tok [a :i64 n :i64] :i64
  (loop [st 0 c 0]
    (let [k (kxrt-find (+ a st) (- n st) 0x5045535f475241 0 7)]
      (if (< k 0) c (recur (+ st k 7) (inc c))))))
(defn- kxrt-sp-serve [rq :i64 an :i64] :i64
  (let [b (+ (kxrt-gl 232) 1048576)]
    (loop [k 0]
