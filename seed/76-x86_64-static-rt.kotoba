        c (kxrt-count-tok a n)
        e0 (let [k (kxrt-find a n 0x5045535f475241 0 7)] (if (< k 0) n k))
        bytes (+ (- n (* 7 c)) (inc c))]
    (cond nul (kxrt-sp-reply an 77 a 0)
          (or (< e0 1) (> e0 4095)) (kxrt-sp-reply an 77 a 0)
          (or (> c 32) (> bytes 4096)) (kxrt-sp-refused an 0)
          :else (let [k (kxrt-sp-choose a e0)]
                  (if (< k 0)
                    (kxrt-sp-refused an (if (or (< (kxrt-net-until a e0 0 47) e0) (= (kxrt-gl 2080) 1)) 1 2))
                    (let [io (kxrt-gl 232) as (+ io 2097152) ap (+ io 2101248) ep (+ io 2105344)
