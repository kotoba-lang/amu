    44 (kxrt-w b (kxrt-w b i 0x656363612f74656e 8) 0x7470 2)
    45 (kxrt-w b i 0x6c6169642f74656e 8)
    46 (kxrt-w b i 0x646165722f74656e 8)
    (kxrt-w b (kxrt-w b i 0x746972772f74656e 8) 0x65 1)))
(defn- kxrt-net-reason [b :i64 i :i64 k :i64] :i64
