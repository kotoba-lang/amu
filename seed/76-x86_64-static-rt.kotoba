                :else (let [z (kxrt-close rq-r) y (kxrt-close an-w)
                            u (kxrt-gs 2088 rq-w) v (kxrt-gs 2096 an-r) t (kxrt-gs 2104 pid)
                            act (+ (kxrt-gl 200) 8192)
                            a0 (kxrt-store64 act 1) a1 (kxrt-store64 (+ act 8) 0) a2 (kxrt-store64 (+ act 16) 0) a3 (kxrt-store64 (+ act 24) 0)]
                        (if (< (kxrt-signal 13 act) 0) (kxrt-die) 0))))))))
(defn- kxrt-spawn-refuse [idx :i64] :i64
  (let [b (kxrt-gl 200)
        i0 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b 0 0x4152545f4558454b 8) 0x646e696b3a7b2050 8) 0x6962617061633a20 8) 0x61633a207974696c 8) 0x7974696c69626170 8) 0x3a20 2)
        i1 (kxrt-w b (kxrt-w b i0 0x2f737365636f7270 8) 0x6e77617073 5)
        i2 (kxrt-w b (kxrt-w b i1 0x6e6f736165723a20 8) 0x3a20 2)
        i3 (case idx
             0 (kxrt-w b (kxrt-w b (kxrt-w b i2 0x72612f6e77617073 8) 0x65676475622d7667 8) 0x74 1)
             1 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i2 0x72702f6e77617073 8) 0x6f6e2d6d6172676f 8) 0x65746e6172672d74 8) 0x64 1)
             2 (kxrt-w b (kxrt-w b (kxrt-w b i2 0x61702f6e77617073 8) 0x756b6f6f6c2d6874 8) 0x6465696e65642d70 8)
             3 (kxrt-w b (kxrt-w b (kxrt-w b i2 0x756f2f6e77617073 8) 0x6475622d74757074 8) 0x746567 3)
             4 (kxrt-w b (kxrt-w b i2 0x69742f6e77617073 8) 0x74756f656d 5)
             5 (kxrt-w b (kxrt-w b (kxrt-w b i2 0x78652f6e77617073 8) 0x656c6961662d6365 8) 0x64 1)
             6 (kxrt-w b (kxrt-w b (kxrt-w b (kxrt-w b i2 0x73692f6e77617073 8) 0x2d6e6f6974616c6f 8) 0x616c696176616e75 8) 0x656c62 3)
             (kxrt-w b (kxrt-w b (kxrt-w b i2 0x65732f6e77617073 8) 0x6c6961662d707574 8) 0x6465 2))
