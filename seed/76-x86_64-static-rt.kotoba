;; ---- clock/now (wire 7) and entropy/draw (wire 23) ----
;; Private scratch S+15360..16127, separate from SHA / TCP / BPF scratch.
;; G+752 stores the last monotonic reading. Kernel time is not caller input.
(defn- kxrt-request= [h :i64 lo :i64 hi :i64 want :i64] :bool
