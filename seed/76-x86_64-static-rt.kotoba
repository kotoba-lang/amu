(defn- kxrt-sp-prog [k :i64] :i64 (+ (kxrt-gl 2048) (* 4096 k)))
(defn- kxrt-sp-plen [k :i64] :i64 (kxrt-gl (+ 2112 (* 8 k))))
(defn- kxrt-sp-name [k :i64] :i64 (+ (kxrt-gl 2056) (* 256 k)))
(defn- kxrt-sp-nlen [k :i64] :i64 (kxrt-gl (+ 2240 (* 8 k))))
;; op 44 for a program: a slash first, 2..4095 bytes, no empty, . or .. segment
(defn- kxrt-sp-path-ok? [a :i64 n :i64] :bool
  (and (>= n 2) (<= n 4095) (= (kxrt-load8 a) 47)
       (loop [s 1 i 1]
         (cond (> i n) true
               (or (= i n) (= (kxrt-load8 (+ a i)) 47))
                 (let [m (- i s)]
                   (cond (= m 0) false
                         (and (= m 1) (= (kxrt-load8 (+ a s)) 46)) false
                         (and (= m 2) (= (kxrt-load8 (+ a s)) 46) (= (kxrt-load8 (+ a s 1)) 46)) false
                         :else (recur (inc i) (inc i))))
               :else (recur s (inc i))))))
;; the offset of the last segment of program k
(defn- kxrt-sp-base [k :i64] :i64
