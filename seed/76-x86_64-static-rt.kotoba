        w (kxrt-load64 fds) x (kxrt-load64 (+ fds 8)) y (kxrt-load64 (+ fds 16))
        in-r (bit-and w 4294967295) in-w (u64-shift-right w 32)
        out-r (bit-and x 4294967295) out-w (u64-shift-right x 32)
        st-r (bit-and y 4294967295) st-w (u64-shift-right y 32)]
    (if (or (< p1 0) (< p2 0) (< p3 0)) (kxrt-sp-refused an 7)
