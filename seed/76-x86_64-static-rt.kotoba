                (> v (quot (- 9223372036854775807 (- c 48)) 10)) (recur (inc i) 9223372036854775807)
                :else (recur (inc i) (+ (* v 10) (- c 48)))))))))
(defn- kxrt-net-count [a :i64 n :i64 ch :i64] :i64
  (loop [i 0 k 0] (if (= i n) k (recur (inc i) (if (= (kxrt-load8 (+ a i)) ch) (inc k) k)))))
;; the first ch at or after st, or n
(defn- kxrt-net-until [a :i64 n :i64 st :i64 ch :i64] :i64
