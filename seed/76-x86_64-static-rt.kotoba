;; ---- wire 42 :gpu/compute: a transport to the GPU provider (ADR 0371) ----
;; The provider is another process. The launcher passes two inherited fds,
;; KEXE_CAP_RESOURCES_42=REQUEST,ANSWER (checked at start, kxrt-gpu-fds). A
;; frame is a u32 little-endian length, then the bytes, both ways; the grammar
;; is tools/gpu_compute_protocol.kotoba. The runtime only carries frames: an
;; answer that starts with ! is a refusal, reported by name, then a trap.
(defn- kxrt-name-byte? [c :i64] :bool
  (or (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57)) (= c 47) (= c 45)))
