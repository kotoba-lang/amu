;; socket(AF_INET, SOCK_STREAM|SOCK_NONBLOCK|SOCK_CLOEXEC, 0), the only form the filter admits
(defn- kxrt-net-socket [] :i64 (kxrt-syscall 41 2 526337 0 0 0 0))
(defn- kxrt-net-keep [s :i64 kind :i64 fd :i64] :i64 (let [z (kxrt-net-set s kind fd)] (kxrt-intern-dec (inc s))))
(defn- kxrt-net-listen [s :i64 v :i64] :i64
