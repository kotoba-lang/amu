        c (kxrt-store8 sa 2) d (kxrt-store8 (+ sa 2) (u64-shift-right port 8)) e (kxrt-store8 (+ sa 3) (bit-and port 255))
        f (kxrt-store8 (+ sa 4) (bit-and (u64-shift-right ip 24) 255)) g (kxrt-store8 (+ sa 5) (bit-and (u64-shift-right ip 16) 255))
        h (kxrt-store8 (+ sa 6) (bit-and (u64-shift-right ip 8) 255)) k (kxrt-store8 (+ sa 7) (bit-and ip 255))]
