;; Stack budget: KEXE_STACK_BYTES (1 MiB, the loader's limit, when absent;
;; at most 256 MiB). RLIMIT_STACK is set to it first, the stack is pre-touched
;; (RLIMIT_AS forbids later growth), then: core 0, cpu (KEXE_CPU_SECONDS, soft
;; s / hard s+1), address space 64 MiB, and alarm(wall-1) for KEXE_WALL_SECONDS.
;; No cpu/wall budget given = no cpu/wall limit.
(defn- kxrt-stack-bytes [s :i64] :i64
