(defn- kxrt-net-any? [] :bool
  (or (kxrt-admitted? 43) (kxrt-admitted? 44) (kxrt-admitted? 45) (kxrt-admitted? 46) (kxrt-admitted? 47)))
;; 1..19 decimal digits, saturating at i64 max (decimal-step); -1 otherwise
