(ns probe.decide
  (:export [route-key builtin-kind outcome answer? status-for]))

(defn route-key
  [method :string path :string]
  :string
  (string-concat method (string-concat " " path)))

(defn builtin-kind
  [method :string path :string]
  :keyword
  (if (string=? method "GET")
    (if (string=? path "/healthz")
      :health
      (if (string=? path "/metrics")
        :metrics
        :route))
    :route))

(defn outcome
  [kind :keyword bound? :bool answered? :bool]
  :keyword
  (if (= kind :health)
    :health-ok
    (if (= kind :metrics)
      :metrics-ok
      (if bound?
        (if answered? :answer :no-answer)
        :route-not-bound))))

(defn answer?
  [written :i64]
  :bool
  (if (> written 0) true false))

(defn status-for
  [outcome :keyword]
  :i64
  (if (= outcome :no-answer)
    204
    (if (= outcome :route-not-bound)
      404
      200)))
