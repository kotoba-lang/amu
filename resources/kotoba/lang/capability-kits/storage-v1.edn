{:kotoba.capability-kit/name :storage
 :kotoba.capability-kit/version 1
 :capability {:name :storage/transact :id 12}
 :semantics {:ownership :host
             :namespace :host-fixed-per-provider
             :durability :transport-commit-before-result
             :concurrency :conditional-version
             :ambient-filesystem false
             :backend-handles false
             :operations [:get :put :delete]}
 :limits {:key :bounded-keyword :value-bytes 65536
          :namespace-quota :host-provider-required}
 :request
 [:variant :kotoba.storage/request
  [[:get [:record :kotoba.storage/get [[:key :keyword]]]]
   [:put [:record :kotoba.storage/put
          [[:key :keyword] [:value :string]
           [:expected-version [:option :i64]]]]]
   [:delete [:record :kotoba.storage/delete
             [[:key :keyword] [:expected-version [:option :i64]]]]]]]
 :result
 [:variant :kotoba.storage/result
  [[:found [:record :kotoba.storage/entry
             [[:key :keyword] [:value :string] [:version :i64]]]]
   [:missing :bool]
   [:written [:record :kotoba.storage/entry
               [[:key :keyword] [:value :string] [:version :i64]]]]
   [:deleted :bool]
   [:conflict [:record :kotoba.storage/conflict
                [[:key :keyword] [:current-version [:option :i64]]]]]
   [:error [:record :kotoba.storage/error
             [[:code :keyword] [:message :string] [:retryable :bool]]]]]]
 :qualification {:reference :implemented
                 :wasm-aot :implemented
                 :wasm32-kotoba-v1 :pending
                 :native-aot :pending
                 :jit :implemented}
 ;; Typed kit ABI on the browser wasm host (kotoba:typed/cap-call, id 12).
 ;; Distinct from clock's i64 kotoba:cap/call surface, which is what
 ;; :wasm32-kotoba-v1 names -- this guest does compile to that target, but
 ;; compiling to a target is not the same claim as running on its host-time
 ;; surface, so that key stays :pending.
 ;;
 ;; What crosses whole is this kit's own :request / :result, named below:
 ;; variants over records carrying :keyword, :string, :i64 and an
 ;; [:option :i64] (put/delete expected-version, conflict current-version).
 ;; The option is the part no earlier kit exercised here.
 ;;
 ;; :native-aot is :pending because the native targets REFUSE this ABI --
 ;; "typed values currently require the kotoba-script web target, typed
 ;; Wasm/CLJS target, or the qualified native one-word ... slice" at
 ;; :phase :target -- not because nobody tried. See
 ;; storage-wasm-aot-test/native-aot-refuses-the-storage-kit-abi.
 :wasm-aot-surface {:import ["kotoba:typed" "cap-call"]
                    :capability-id 12
                    :grant :storage/transact
                    :target :wasm32-browser-kotoba-v1
                    :request-schema :kotoba.storage/request
                    :result-schema :kotoba.storage/result
                    :elaboration "(typed-cap-call :storage/transact request-type result-type request)"}}
