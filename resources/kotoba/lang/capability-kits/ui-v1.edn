{:kotoba.capability-kit/name :ui
 :kotoba.capability-kit/version 1
 :capabilities [{:name :ui/commit :id 9}
                {:name :ui/next-event :id 10}]
 :semantics {:render-model :declarative-flat-tree
             :host-object-access false
             :ordering :revision-linearized
             :event-delivery :bounded-pull
             :ambient-dom false}
 :limits {:nodes 32 :queued-events 64 :text :bounded-string}
 :node [:record :kotoba.ui/node
        [[:id :keyword] [:parent [:option :keyword]]
         [:kind :keyword] [:text :string]]]
 :commit {:request [:record :kotoba.ui/commit-request
                    [[:base-revision :i64]
                     [:nodes [:set [:record :kotoba.ui/node
                                    [[:id :keyword] [:parent [:option :keyword]]
                                     [:kind :keyword] [:text :string]]]]]]]
          :result [:record :kotoba.ui/commit-result
                   [[:revision :i64] [:node-count :i64]]]}
 :event {:request [:record :kotoba.ui/event-request [[:after-revision :i64]]]
         :result [:option [:record :kotoba.ui/event
                           [[:revision :i64] [:target :keyword]
                            [:kind :keyword] [:value :string]]]]}

 :qualification {:reference :implemented, :wasm-aot :implemented, :wasm32-kotoba-v1 :pending, :native-aot :implemented, :jit :implemented}
 ;; Typed kit ABI on the browser wasm host (kotoba:typed/cap-call),
 ;; ids 9 and 10 -- the same seam log and dataspace were qualified on.
 ;; Measured 2026-08-18: the compiled browser module imports
 ;; kotoba:typed/cap-call and no kotoba:cap/call at all, which is why
 ;; :wasm32-kotoba-v1 (clock i64 surface) stays :pending.
 ;;
 ;; This kit's second wire answers with an [:option record], so the host
 ;; carries a present/absent discriminant and not just a payload. poll
 ;; (some) and pending (none) are asserted separately on both backends;
 ;; an inject stuck on either answer fails one of them.
 ;;
 ;; :native-aot follows dataspace: a hosted kexe process proof
 ;; (kotoba.compiler.ui-native-aot-test), not clock's host-authority block
 ;; and not ADR 0270's remaining application-kit list. Production C-free
 ;; aiueos is still not claimed (ADR 0272). Measured 2026-08-26: packed
 ;; result 15 from executor/execute.
 :wasm-aot-surface {:import ["kotoba:typed" "cap-call"]
                    :target :wasm32-browser-kotoba-v1
                    :grants [{:capability-id 9 :grant :ui/commit
                              :elaboration "(typed-cap-call :ui/commit request-type result-type request)"}
                             {:capability-id 10 :grant :ui/next-event
                              :elaboration "(typed-cap-call :ui/next-event request-type result-type request)"}]}}
