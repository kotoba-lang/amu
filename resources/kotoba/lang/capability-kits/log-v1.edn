{:kotoba.capability-kit/name :log
 :kotoba.capability-kit/version 1
 :capabilities [{:name :log/read :id 5}
                {:name :log/append :id 6}]
 :semantics {:format :structured
             :sequence :provider-linearized
             :retention :bounded-oldest-drop-with-truncation-signal
             :sink-handles false
             :ambient-stdout false
             :read-scope :same-provider-instance}
 :limits {:fields-per-entry 4 :read-entries 8 :retained-entries 256
          :after-sequence :non-negative-i64
          :message :bounded-string :field-value :bounded-string}
 :field [:record :kotoba.log/field [[:key :keyword] [:value :string]]]
 :append
 {:request [:record :kotoba.log/append-request
            [[:level :keyword] [:event :keyword] [:message :string]
             [:fields [:set [:record :kotoba.log/field
                             [[:key :keyword] [:value :string]]]]]]]
  :result [:record :kotoba.log/append-result [[:sequence :i64]]]}
 :read
 {:request [:record :kotoba.log/read-request
            [[:after-sequence :i64] [:limit :i64]]]
  :result [:record :kotoba.log/read-result
           [[:oldest-sequence :i64] [:latest-sequence :i64] [:truncated :bool]
            [:entries
             [:set
              [:record :kotoba.log/entry
               [[:sequence :i64]
                [:level :keyword]
                [:event :keyword]
                [:message :string]
                [:fields
                 [:set
                  [:record :kotoba.log/field
                   [[:key :keyword] [:value :string]]]]]]]]]]]}
 :qualification {:reference :implemented :wasm-aot :implemented
                 :wasm32-kotoba-v1 :pending
                 :native-aot :pending :jit :implemented}
 ;; Typed kit ABI on the browser wasm host (kotoba:typed/cap-call), same seam
 ;; dataspace's :wasm-aot names. Measured 2026-08-18: the compiled module's
 ;; only capability import is kotoba:typed/cap-call. kotoba:cap/call -- clock's
 ;; i64 host-time surface -- is absent, which is why :wasm32-kotoba-v1 stays
 ;; :pending here rather than following :wasm-aot.
 ;;
 ;; Two capabilities, so the surface is per grant; clock and dataspace each
 ;; carry exactly one. `request-type`/`result-type` in each elaboration are
 ;; this kit's own :append / :read :request and :result, unmodified.
 ;;
 ;; :native-aot stays :pending on a measured rejection, not an untried guess.
 ;; Compiling the same guest to :aarch64-kotoba-v1 fails at {:phase :target
 ;; :value-profile :kotoba.value/typed-v1} with "typed values currently
 ;; require the kotoba-script web target, typed Wasm/CLJS target, or the
 ;; qualified native one-word string/record/variant/option/result slice".
 ;; :fields is [:set [:record ...]] and :entries is [:set [:record ...]];
 ;; neither is a one-word value, so this kit cannot reach the native slice
 ;; without narrowing its own schema.
 :wasm-aot-surface {:import ["kotoba:typed" "cap-call"]
                    :target :wasm32-browser-kotoba-v1
                    :grants [{:capability-id 6 :grant :log/append
                              :elaboration
                              "(typed-cap-call :log/append request-type result-type request)"}
                             {:capability-id 5 :grant :log/read
                              :elaboration
                              "(typed-cap-call :log/read request-type result-type request)"}]}}
