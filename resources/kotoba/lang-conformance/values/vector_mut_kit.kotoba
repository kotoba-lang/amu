(ns kotoba.lang.conformance.vector-mut-kit (:export [main]))
;; T4.5 / T1.3: vector-assoc / vector-drop / vector-get dual-backend.
(defn main [] :i64
  (+ (vector-at (vector-assoc (vector-i64 1 2 3) 1 99) 1)
     (vector-count (vector-drop (vector-i64 1 2 3 4) 2))
     (vector-get (vector-i64 1 2 3) 5 7)))
