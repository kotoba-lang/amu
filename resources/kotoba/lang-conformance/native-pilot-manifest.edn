{:kotoba.lang.conformance/version 2
 :kotoba.lang.conformance/wbs "T1.4"
 :kotoba.lang.conformance/profile :pure-native-v1
 :kotoba.lang.conformance/note
 "Pure-native-v1 pilot: i64/string subset on host native ISA via signed kexe + loader.
  Optional when tender-native is not on the classpath."

 :backends
 {:native-host {:id :native-host
                :status :required-for-pure-native
                :resolves-to #{:x86_64-kotoba-v1 :aarch64-kotoba-v1}}}

 :cases
 [{:id :native-f64-add
   :kind :run
   :entry "native/f64_add.kotoba"
   :function "main"
   :args []
   ;; 2.0 + 3.5 = 5.5, as its bit pattern
   :expect {:kotoba 4617878467915022336}}
  {:id :native-f64-mixed
   :kind :run
   :entry "native/f64_mixed.kotoba"
   :function "main"
   :args []
   ;; sqrt(abs(neg(4.0))) * 1.5 = 3.0
   :expect {:kotoba 4613937818241073152}}
  {:id :native-i32-probe
   :kind :run
   :entry "native/i32_probe.kotoba"
   :function "main"
   :args []
   ;; i32 wrapping: 2147483647 + 1 wraps to -2147483648
   :expect {:kotoba -2147483648}}
  {:id :native-i64-add
   :kind :run
   :entry "native/i64_add.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 7}}
  {:id :native-i64-nested
   :kind :run
   :entry "native/i64_nested.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 12}}
  {:id :native-string-length
   :kind :run
   :entry "native/string_length.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 4}}
  {:id :native-string-concat-len
   :kind :run
   :entry "native/string_concat_len.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 4}}
  {:id :native-control-if
   :kind :run
   :entry "native/option_if_some.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 9}}]}
