{:kotoba.lang.conformance/version 2
 :kotoba.lang.conformance/wbs "T1.4"
 :kotoba.lang.conformance/profile :pure-native-v1
 :kotoba.lang.conformance/note
 "Pure-native-v1 pilot: scalar, string, and bounded vector subset on the host native ISA via signed kexe + loader.
  Optional when tender-native is not on the classpath."

 :backends
 {:native-host {:id :native-host
                :status :required-for-pure-native
                :resolves-to #{:x86_64-kotoba-v1 :aarch64-kotoba-v1}}}

 :cases
 [{:id :native-f64-add
   :kind :run
   :entry "native/f64_add.kotoba"
   :function "main"
   :args []
   ;; 2.0 + 3.5 = 5.5, as its bit pattern
   :expect {:kotoba 4617878467915022336}}
  {:id :native-f64-mixed
   :kind :run
   :entry "native/f64_mixed.kotoba"
   :function "main"
   :args []
   ;; sqrt(abs(neg(4.0))) * 1.5 = 3.0
   :expect {:kotoba 4613937818241073152}}
  {:id :native-i32-probe
   :kind :run
   :entry "native/i32_probe.kotoba"
   :function "main"
   :args []
   ;; i32 wrapping: 2147483647 + 1 wraps to -2147483648
   :expect {:kotoba -2147483648}}
  {:id :native-i64-add
   :kind :run
   :entry "native/i64_add.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 7}}
  {:id :native-i64-nested
   :kind :run
   :entry "native/i64_nested.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 12}}
  {:id :native-string-length
   :kind :run
   :entry "native/string_length.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 4}}
  {:id :native-string-concat-len
   :kind :run
   :entry "native/string_concat_len.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 4}}
  {:id :native-control-if
   :kind :run
   :entry "native/option_if_some.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 9}}
  ;; vector-i64 (ADR-2608030300). These run the real host table in
  ;; tools/kexe_loader.c through a signed kexe, so they are the only place the
  ;; arena, the bounds checks and the copy-free append are executed rather
  ;; than merely emitted.
  {:id :native-vector-count
   :kind :run
   :entry "native/vector_count.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 3}}
  {:id :native-vector-at
   :kind :run
   :entry "native/vector_at.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 20}}
  {:id :native-vector-conj-at
   :kind :run
   :entry "native/vector_conj_at.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 3}}
  {:id :native-vector-assoc-at
   :kind :run
   :entry "native/vector_assoc_at.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 99}}
  ;; 0 iff assoc left its source alone: source[1] is 2, changed[1] is 99, so
  ;; the expression is (2 - (99 - 97)). A host that wrote through the shared
  ;; arena would make source[1] read 99 and this return 97.
  {:id :native-vector-assoc-preserves-source
   :kind :run
   :entry "native/vector_assoc_preserves_source.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 0}}
  ;; drop 2 of [5 6 7 8] leaves [7 8]: length 2 plus first element 7.
  {:id :native-vector-drop-count
   :kind :run
   :entry "native/vector_drop_count.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 9}}
  ;; 40 (index past the end) + 200 (negative index) + 2 (in range) = 242.
  {:id :native-vector-get-fallback
   :kind :run
   :entry "native/vector_get_fallback.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 242}}
  ;; f64 values use the same host word arena as i64 values. This composed case
  ;; exercises construction, append, suffix view, indexed read, and the
  ;; f64-to-bits boundary without depending on host floating-point formatting.
  {:id :native-vector-f64-composed
   :kind :run
   :entry "native/vector_f64_composed.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 4615063718147915776}}]}
