(ns kotoba.lang.conformance.native.vector-drop-count)
;; Dropping a prefix is a VIEW over the same elements, so this reads the
;; remaining length and the first surviving element together.
(defn main [] :i64
  (let [rest (vector-drop (vector-new 5 6 7 8) 2)]
    (+ (vector-count rest) (vector-at rest 0))))
