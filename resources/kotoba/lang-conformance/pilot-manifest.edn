{:kotoba.lang.conformance/version 2
 :kotoba.lang.conformance/wbs "T1.3"
 :kotoba.lang.conformance/note
 "T1.3 dual-backend pilot (string + record kit). Control fixtures + full pure-product
  string-ops surface + sealed record-new/get (T4.4). Full kotoba-lang matrix still
  progressive as admission grows."

 :backends
 {:kir {:id :kir :status :required-for-pure-product}
  :wasm32-kotoba-v1 {:id :wasm32-kotoba-v1 :status :required-for-pure-product}}

 :case-classes
 {:pure-product-run
  {:required-backends #{:kir :wasm32-kotoba-v1}
   :profile :pure-product
   :kinds #{:run}}}

 :cases
 [{:id :portable-negative-and-advanced-threading-sugar
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "control/simple_sugar.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 26}}
  {:id :portable-bounded-dotimes
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "control/dotimes.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 7}}
  {:id :portable-guest-assert
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "control/assert.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 7}}
  {:id :portable-closed-world-multimethod
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "control/multimethod.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 121}}
  {:id :portable-static-predicate-condp
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "control/condp.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 50}}
  {:id :string-join-kit
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "control/string_join_kit.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 5}
   :note "T4.2 string-join dual-backend"}
  {:id :string-from-i64-kit
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "values/string_from_i64_kit.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 4}
   :note "PVA string-from-i64 + concat dual-backend"}
  {:id :string-contains-kit
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "values/string_contains_kit.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 1}
   :note "string-contains? hit+miss sum"}
  {:id :string-eq-kit
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "values/string_eq_kit.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 2}
   :note "string=? true+false branches"}
  {:id :string-substring-kit
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "values/string_substring_kit.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 3}
   :note "dynamic string-substring length"}
  {:id :string-fold-case-kit
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "values/string_fold_case_kit.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 1}
   :note "string-fold-case + contains"}
  {:id :string-code-point-kit
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "values/string_code_point_kit.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 65}
   :note "string-code-point-at ASCII"}
  {:id :record-kit
   :class :pure-product-run
   :required-backends #{:kir :wasm32-kotoba-v1}
   :kind :run
   :entry "values/record_kit.kotoba"
   :function "main"
   :args []
   :expect {:kotoba 7}
   :note "T4.4 sealed record-new/get dual-backend"}]}
