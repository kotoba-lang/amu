  ;; The canonical list ACCESSOR, added 2026-09-08. Until then a [:list T]
  ;; could be constructed (typed-list-new) and counted (vector-count) and
  ;; nothing read an element back out of it: `typed-list-nth` type-checked --
  ;; kotoba-sema has carried it since 2026-09-03 and rewrites `nth` on a list
  ;; to it -- and neither backend lowered it, so `amu check` returned 0 and
  ;; `amu compile` returned 70 on both targets, for the whole module whether
  ;; the function was reached or not. Both arms are here because they are
  ;; different lowerings on wasm32: an i64 item calls the `list-nth-i64`
  ;; intrinsic and a reference item calls `list-nth-ref`, and a test that only
  ;; covered one would pass with the two swapped.
  {:id :typed-list-nth-i64
   :source "(defn main [] (typed-list-nth [:list :i64] (typed-list-new [:list :i64] 4 5 6) 2))"
   :expect 6}
  {:id :typed-list-nth-reference
   :source "(defn main [] (string-byte-length (typed-list-nth [:list :string] (typed-list-new [:list :string] \"a\" \"bb\" \"ccc\") 1)))"
   :expect 2}
  ;; In-place vector update. Present here because a lowering to a STORE is
  ;; only indistinguishable from a copy when the handle is dead afterwards,
  ;; and "indistinguishable" is a claim about three runtimes agreeing rather
  ;; than about one of them working.
  {:id :linear-vector-in-place
   :source "(defn main [] (let [v (vector-alloc 4) a (vector-assoc! v 0 7) b (vector-assoc! a 1 9)] (+ (vector-at b 0) (vector-at b 1))))"
   :expect 16}
  ;; Large values built INSIDE the program (adr-2609242100 P2/P3). Until
  ;; 2026-09-24 every target re-validated a typed value in full on every
  ;; construction and call against adt-node-limit 64 / adt-depth-limit 12, so
  ;; a cons list stopped at about 5 cells and building one was O(n^2). A value
  ;; is now walked only at a trust boundary; these two are never walked at all.
  ;; `:fuel` is the run's budget on every target (and the oracle's): tens of
  ;; thousands of function entries, far past the default 512.
  ;; `total` reads through helpers because a match-variant binder is not in
  ;; scope inside a `recur` of an enclosing `loop` (kotoba-sema, 2026-09-24).
  ;; `kons` is load-bearing on Wasm: with the two constructors spelled inline
  ;; in the `recur`, the 10,000-cell build exhausted the JS stack inside
  ;; wasm-function frames (RangeError, measured 2026-09-24) -- the loop was
  ;; emitted as recursion. A call-depth question for P4, not value validation.
  {:id :internal-list-10000
   :source "(ns conformance.list (:export [main]) (:schemas {:conformance/list [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] :conformance/cell [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]]})) (defn cells [l [:ref :conformance/list]] :i64 (match-variant l [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] (:empty e 0) (:cons c 1))) (defn head-of [l [:ref :conformance/list]] :i64 (match-variant l [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] (:empty e 0) (:cons c (record-get [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]] c :head)))) (defn tail-of [l [:ref :conformance/list]] [:ref :conformance/list] (match-variant l [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] (:empty e l) (:cons c (record-get [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]] c :tail)))) (defn kons [h :i64 t [:ref :conformance/list]] [:ref :conformance/list] (variant-new [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] :cons (record-new [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]] h t))) (defn build [count :i64] [:ref :conformance/list] (loop [n count acc (variant-new [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] :empty 0)] (if (= n 0) acc (recur (- n 1) (kons n acc))))) (defn total [list [:ref :conformance/list]] :i64 (loop [l list acc 0] (if (= (cells l) 0) acc (recur (tail-of l) (+ acc (head-of l)))))) (defn main [] :i64 (total (build 10000)))"
   :fuel 1000000
   :expect 50005000}
  ;; A balanced tree of 2,000 values (depth 11), built and summed by ordinary
  ;; non-tail recursion.
  {:id :internal-tree-2000
   :source "(ns conformance.tree (:export [main]) (:schemas {:conformance/tree [:variant :conformance/tree [[:leaf :i64] [:node [:ref :conformance/branch]]]] :conformance/branch [:record :conformance/branch [[:left [:ref :conformance/tree]] [:value :i64] [:right [:ref :conformance/tree]]]]})) (defn grow [lo :i64 hi :i64] [:ref :conformance/tree] (if (> lo hi) (variant-new [:variant :conformance/tree [[:leaf :i64] [:node [:ref :conformance/branch]]]] :leaf 0) (let [mid (quot (+ lo hi) 2)] (variant-new [:variant :conformance/tree [[:leaf :i64] [:node [:ref :conformance/branch]]]] :node (record-new [:record :conformance/branch [[:left [:ref :conformance/tree]] [:value :i64] [:right [:ref :conformance/tree]]]] (grow lo (- mid 1)) mid (grow (+ mid 1) hi)))))) (defn sum [t [:ref :conformance/tree]] :i64 (match-variant t [:variant :conformance/tree [[:leaf :i64] [:node [:ref :conformance/branch]]]] (:leaf x x) (:node b (+ (sum (record-get [:record :conformance/branch [[:left [:ref :conformance/tree]] [:value :i64] [:right [:ref :conformance/tree]]]] b :left)) (+ (record-get [:record :conformance/branch [[:left [:ref :conformance/tree]] [:value :i64] [:right [:ref :conformance/tree]]]] b :value) (sum (record-get [:record :conformance/branch [[:left [:ref :conformance/tree]] [:value :i64] [:right [:ref :conformance/tree]]]] b :right))))))) (defn main [] :i64 (sum (grow 1 2000)))"
   :fuel 1000000
   :expect 2001000}]
 :negative
 [;; The same program with one name un-threaded: `v` is written twice, so the
  ;; second store would land on what the first consumed. Refused at check
  ;; time, which is what makes the positive case above a lowering choice
  ;; rather than a hazard.
  {:id :non-linear-in-place-write
   :source "(defn main [] (let [v (vector-alloc 4) a (vector-assoc! v 0 7) b (vector-assoc! v 1 9)] (vector-at b 0)))"}
