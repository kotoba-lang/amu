  ;; These two were :floating-literal and :floating-descriptor, as if this value
  ;; profile excluded floating point. It does not -- `(defn main [] :f64 1.5)` is
  ;; accepted and there is an extensive f64 suite. Measured 2026-07-31, what they
  ;; actually reject is:
  ;;
  ;;   (defn main [] :i64 1.5)               a result type mismatch
  ;;   (defn main [value :f64] :f64 value)   "main must take zero arguments"
  ;;                                         -- identical for :i64, so the :f64
  ;;                                         in it is doing no work
  ;;
  ;; The first was `(defn main [] 1.5)` until profile 5 began inferring
  ;; unannotated results and it stopped failing closed; annotating it kept the
  ;; corpus green but left the id describing something the case never tested.
  ;; Renamed to the rule each really exercises, and the float exclusion that DOES
  ;; exist is now covered for the first time.
  {:id :result-type-mismatch
   :source "(defn main [] :i64 1.5)"}
  {:id :entry-point-takes-arguments
   :source "(defn main [value :i64] :i64 value)"}
  {:id :floating-set-item
   :source "(defn main [] (typed-set-count [:set :f64] (typed-set [:set :f64] 1.5)))"}]
 ;; Values that arrive from OUTSIDE: the one place a typed value is walked in
 ;; full (adr-2609242100 P2/P3), once, by an iterative walk, against the
 ;; boundary traversal budget (kotoba-lang lang/limits.edn :language/boundary:
 ;; 65,536 nodes, 1 MiB). The corpus had no vectors asserting a refusal at node
 ;; 65 or depth 13 to move here -- those limits were never pinned by a vector
 ;; -- so these are new. `:input {:list-cells n}` is a host-built
 ;; [:ref :conformance/list] of n cells (3 nodes per cell + the empty tail)
 ;; passed as `:export`'s one argument; `:expect-trap` names the trap.
 ;; Run on the reference interpreter and the ESM target; the Wasm instance's
 ;; boundary is a typed capability result (exported functions accept only
 ;; host-admitted values), pinned in scripts/test-browser-host-typed-ops.cljk
 ;; fixture cap-list-result with the same numbers.
 :boundary
 [{:id :host-list-deep-admitted
   :source "(ns conformance.list (:export [main sum]) (:schemas {:conformance/list [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] :conformance/cell [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]]})) (defn cells [l [:ref :conformance/list]] :i64 (match-variant l [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] (:empty e 0) (:cons c 1))) (defn head-of [l [:ref :conformance/list]] :i64 (match-variant l [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] (:empty e 0) (:cons c (record-get [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]] c :head)))) (defn tail-of [l [:ref :conformance/list]] [:ref :conformance/list] (match-variant l [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] (:empty e l) (:cons c (record-get [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]] c :tail)))) (defn kons [h :i64 t [:ref :conformance/list]] [:ref :conformance/list] (variant-new [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] :cons (record-new [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]] h t))) (defn build [count :i64] [:ref :conformance/list] (loop [n count acc (variant-new [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] :empty 0)] (if (= n 0) acc (recur (- n 1) (kons n acc))))) (defn total [list [:ref :conformance/list]] :i64 (loop [l list acc 0] (if (= (cells l) 0) acc (recur (tail-of l) (+ acc (head-of l)))))) (defn sum [l [:ref :conformance/list]] :i64 (total l)) (defn main [] :i64 0)"
   :export sum
   :input {:list-cells 20000}
   :fuel 1000000
   :expect 200010000}
  {:id :host-list-over-node-budget
   :source "(ns conformance.list (:export [main sum]) (:schemas {:conformance/list [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] :conformance/cell [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]]})) (defn cells [l [:ref :conformance/list]] :i64 (match-variant l [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] (:empty e 0) (:cons c 1))) (defn head-of [l [:ref :conformance/list]] :i64 (match-variant l [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] (:empty e 0) (:cons c (record-get [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]] c :head)))) (defn tail-of [l [:ref :conformance/list]] [:ref :conformance/list] (match-variant l [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] (:empty e l) (:cons c (record-get [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]] c :tail)))) (defn kons [h :i64 t [:ref :conformance/list]] [:ref :conformance/list] (variant-new [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] :cons (record-new [:record :conformance/cell [[:head :i64] [:tail [:ref :conformance/list]]]] h t))) (defn build [count :i64] [:ref :conformance/list] (loop [n count acc (variant-new [:variant :conformance/list [[:empty :i64] [:cons [:ref :conformance/cell]]]] :empty 0)] (if (= n 0) acc (recur (- n 1) (kons n acc))))) (defn total [list [:ref :conformance/list]] :i64 (loop [l list acc 0] (if (= (cells l) 0) acc (recur (tail-of l) (+ acc (head-of l)))))) (defn sum [l [:ref :conformance/list]] :i64 (total l)) (defn main [] :i64 0)"
   :export sum
