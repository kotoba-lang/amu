{:kotoba.typed-value-conformance/version 1
 :abi :kotoba.typed-value/canonical-v1
 :positive
 [{:id :generic-option
   :source "(defn main [] (match-option (option-some-of [:option :i64] 7) [:option :i64] (none 0) (some value (+ value 1))))"
   :expect 8}
  {:id :parametric-result
   :source "(defn main [] (match-result (result-ok-of [:result :i64 :string] 7) [:result :i64 :string] (ok value (+ value 2)) (err message (string-byte-length message))))"
   :expect 9}
  {:id :closed-variant
   :source "(defn main [] (match-variant (variant-new [:variant :conformance/status [[:ready :i64] [:failed :string]]] :ready 7) [:variant :conformance/status [[:ready :i64] [:failed :string]]] (:ready value (+ value 3)) (:failed message (string-byte-length message))))"
   :expect 10}
  {:id :heterogeneous-vector
   :source "(defn main [] (hetero-vector-at [:vector [:i64 :string :bool]] (hetero-vector [:vector [:i64 :string :bool]] 7 \"safe\" true) 0))"
   :expect 7}
  {:id :typed-set
   :source "(defn main [] (typed-set-count [:set :i64] (typed-set [:set :i64] 3 1 2)))"
   :expect 3}
  {:id :typed-map
   :source "(defn main [] (option-value-of [:option :i64] (typed-map-get [:map :keyword :i64] (typed-map-new [:map :keyword :i64] :b 7 :a 1) :b) 0))"
   :expect 7}
  {:id :typed-map-entry-iteration
   :source "(defn main [] (match-option (typed-map-entry-at [:map :keyword :i64] (typed-map-new [:map :keyword :i64] :b 7 :a 1) 0) [:option [:vector [:keyword :i64]]] (none 0) (some entry (hetero-vector-at [:vector [:keyword :i64]] entry 1))))"
   :expect 1}
  {:id :nominal-record
   :source "(defn main [] (record-get [:record :conformance/person [[:name :string] [:age :i64]]] (record [:record :conformance/person [[:name :string] [:age :i64]]] \"Kotoba\" 7) :age))"
   :expect 7}
  ;; In-place vector update. Present here because a lowering to a STORE is
  ;; only indistinguishable from a copy when the handle is dead afterwards,
  ;; and "indistinguishable" is a claim about three runtimes agreeing rather
  ;; than about one of them working.
  {:id :linear-vector-in-place
   :source "(defn main [] (let [v (vector-alloc 4) a (vector-assoc! v 0 7) b (vector-assoc! a 1 9)] (+ (vector-at b 0) (vector-at b 1))))"
   :expect 16}]
 :negative
 [;; The same program with one name un-threaded: `v` is written twice, so the
  ;; second store would land on what the first consumed. Refused at check
  ;; time, which is what makes the positive case above a lowering choice
  ;; rather than a hazard.
  {:id :non-linear-in-place-write
   :source "(defn main [] (let [v (vector-alloc 4) a (vector-assoc! v 0 7) b (vector-assoc! v 1 9)] (vector-at b 0)))"}
  {:id :option-payload-mismatch
   :source "(defn main [] [:option :string] (option-some-of [:option :string] 7))"}
  {:id :result-non-exhaustive
   :source "(defn main [value [:result :i64 :string]] (match-result value [:result :i64 :string] (ok x x)))"}
  {:id :variant-non-exhaustive
   :source "(defn main [value [:variant :conformance/status [[:ready :i64] [:failed :string]]]] (match-variant value [:variant :conformance/status [[:ready :i64] [:failed :string]]] (:ready x x)))"}
  {:id :vector-wrong-position
   :source "(defn main [] [:vector [:i64 :string]] (hetero-vector [:vector [:i64 :string]] \"wrong\" \"ok\"))"}
  {:id :set-duplicate
   :source "(defn main [] [:set :i64] (typed-set [:set :i64] 1 1))"
   :phase :runtime}
  {:id :map-duplicate-key
   :source "(defn main [] [:map :keyword :i64] (typed-map-new [:map :keyword :i64] :a 1 :a 2))"
   :phase :runtime}
  {:id :record-unknown-field
   :source "(defn main [value [:record :conformance/person [[:age :i64]]]] (record-get [:record :conformance/person [[:age :i64]]] value :missing))"}
  ;; These two were :floating-literal and :floating-descriptor, as if this value
  ;; profile excluded floating point. It does not -- `(defn main [] :f64 1.5)` is
  ;; accepted and there is an extensive f64 suite. Measured 2026-07-31, what they
  ;; actually reject is:
  ;;
  ;;   (defn main [] :i64 1.5)               a result type mismatch
  ;;   (defn main [value :f64] :f64 value)   "main must take zero arguments"
  ;;                                         -- identical for :i64, so the :f64
  ;;                                         in it is doing no work
  ;;
  ;; The first was `(defn main [] 1.5)` until profile 5 began inferring
  ;; unannotated results and it stopped failing closed; annotating it kept the
  ;; corpus green but left the id describing something the case never tested.
  ;; Renamed to the rule each really exercises, and the float exclusion that DOES
  ;; exist is now covered for the first time.
  {:id :result-type-mismatch
   :source "(defn main [] :i64 1.5)"}
  {:id :entry-point-takes-arguments
   :source "(defn main [value :i64] :i64 value)"}
  {:id :floating-set-item
   :source "(defn main [] (typed-set-count [:set :f64] (typed-set [:set :f64] 1.5)))"}]}
