(defn- g0exp [i :i64] :i64 (if (< i 128) (if (< i 64) (if (< i 32) (if (< i 16) (if (< i 8) (if (< i 4) (if (< i 2) (if (< i 1) 1 2) (if (< i 3) 4 8)) (if (< i 6) (if (< i 5) 16 32) (if (< i 7) 64 128))) (if (< i 12) (if (< i 10) (if (< i 9) 29 58) (if (< i 11) 116 232)) (if (< i 14) (if (< i 13) 205 135) (if (< i 15) 19 38)))) (if (< i 24) (if (< i 20) (if (< i 18) (if (< i 17) 76 152) (if (< i 19) 45 90)) (if (< i 22) (if (< i 21) 180 117) (if (< i 23) 234 201))) (if (< i 28) (if (< i 26) (if (< i 25) 143 3) (if (< i 27) 6 12)) (if (< i 30) (if (< i 29) 24 48) (if (< i 31) 96 192))))) (if (< i 48) (if (< i 40) (if (< i 36) (if (< i 34) (if (< i 33) 157 39) (if (< i 35) 78 156)) (if (< i 38) (if (< i 37) 37 74) (if (< i 39) 148 53))) (if (< i 44) (if (< i 42) (if (< i 41) 106 212) (if (< i 43) 181 119)) (if (< i 46) (if (< i 45) 238 193) (if (< i 47) 159 35)))) (if (< i 56) (if (< i 52) (if (< i 50) (if (< i 49) 70 140) (if (< i 51) 5 10)) (if (< i 54) (if (< i 53) 20 40) (if (< i 55) 80 160))) (if (< i 60) (if (< i 58) (if (< i 57) 93 186) (if (< i 59) 105 210)) (if (< i 62) (if (< i 61) 185 111) (if (< i 63) 222 161)))))) (if (< i 96) (if (< i 80) (if (< i 72) (if (< i 68) (if (< i 66) (if (< i 65) 95 190) (if (< i 67) 97 194)) (if (< i 70) (if (< i 69) 153 47) (if (< i 71) 94 188))) (if (< i 76) (if (< i 74) (if (< i 73) 101 202) (if (< i 75) 137 15)) (if (< i 78) (if (< i 77) 30 60) (if (< i 79) 120 240)))) (if (< i 88) (if (< i 84) (if (< i 82) (if (< i 81) 253 231) (if (< i 83) 211 187)) (if (< i 86) (if (< i 85) 107 214) (if (< i 87) 177 127))) (if (< i 92) (if (< i 90) (if (< i 89) 254 225) (if (< i 91) 223 163)) (if (< i 94) (if (< i 93) 91 182) (if (< i 95) 113 226))))) (if (< i 112) (if (< i 104) (if (< i 100) (if (< i 98) (if (< i 97) 217 175) (if (< i 99) 67 134)) (if (< i 102) (if (< i 101) 17 34) (if (< i 103) 68 136))) (if (< i 108) (if (< i 106) (if (< i 105) 13 26) (if (< i 107) 52 104)) (if (< i 110) (if (< i 109) 208 189) (if (< i 111) 103 206))