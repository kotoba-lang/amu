(ns embench.nettle-sha256 (:export [run test-nettle-sha256]))

;; Correctness port of Embench 2.0rc2 src/nettle-sha256/nettle-sha256.c,
;; one benchmark_body iteration. SPDX-License-Identifier: GPL-3.0-or-later.

(defn- mask32 [n :i64] :i64 (bit-and n 4294967295))

(defn- constants [] :vector-i64
  [1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221 3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580 3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986 2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895 666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037 2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344 430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779 1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298])

(defn- padded-message [] :vector-i64
  (let [source [97 98 99 100 98 99 100 101 99 100 101 102 100 101 102 103 101 102 103 104 102 103 104 105 103 104 105 106 104 105 106 107 105 106 107 108 106 107 108 109 107 108 109 110 108 109 110 111 109 110 111 112 110 111 112 113]]
    (loop [bytes [] i 0]
    (if (= i 128) bytes
      (let [value (if (< i 56)
                    (vector-at source i)
                    (if (= i 56) 128
                      (if (= i 126) 1
                        (if (= i 127) 192 0))))]
        (recur (vector-conj bytes value) (+ i 1)))))))

(defn- word-at [bytes :vector-i64 offset :i64 word :i64] :i64
  (let [start (+ offset (* 4 word))]
    (+ (i64-shift-left (vector-at bytes start) 24)
       (i64-shift-left (vector-at bytes (+ start 1)) 16)
       (i64-shift-left (vector-at bytes (+ start 2)) 8)
       (vector-at bytes (+ start 3)))))

(defn- ror32 [x :i64 n :i64] :i64
  (mask32 (bit-or (u64-shift-right x n)
                  (i64-shift-left x (- 32 n)))))

(defn- small0 [x :i64] :i64
  (bit-xor (bit-xor (ror32 x 7) (ror32 x 18)) (u64-shift-right x 3)))

(defn- small1 [x :i64] :i64
  (bit-xor (bit-xor (ror32 x 17) (ror32 x 19)) (u64-shift-right x 10)))

(defn- big0 [x :i64] :i64
  (bit-xor (bit-xor (ror32 x 2) (ror32 x 13)) (ror32 x 22)))

(defn- big1 [x :i64] :i64
  (bit-xor (bit-xor (ror32 x 6) (ror32 x 11)) (ror32 x 25)))

(defn- words [bytes :vector-i64 offset :i64] :vector-i64
  (loop [w [] i 0]
    (if (= i 64) w
      (if (< i 16)
        (recur (vector-conj w (word-at bytes offset i)) (+ i 1))
        (let [value (mask32 (+ (+ (small1 (vector-at w (- i 2)))
                                  (vector-at w (- i 7)))
                               (+ (small0 (vector-at w (- i 15)))
                                  (vector-at w (- i 16)))))]
          (recur (vector-conj w value) (+ i 1)))))))

(defn- add-states [h :vector-i64 state :vector-i64] :vector-i64
  (loop [out [] i 0]
    (if (= i 8) out
      (recur (vector-conj out
                          (mask32 (+ (vector-at h i)
                                     (vector-at state i))))
             (+ i 1)))))

(defn- compress [h :vector-i64 w :vector-i64 k :vector-i64] :vector-i64
  (let [state (loop [i 0 state h]
                (if (= i 64) state
                  (let [a (vector-at state 0)
                        b (vector-at state 1)
                        c (vector-at state 2)
                        d (vector-at state 3)
                        e (vector-at state 4)
                        f (vector-at state 5)
                        g (vector-at state 6)
                        hh (vector-at state 7)
                        choice (bit-xor (bit-and e f)
                                        (bit-and (bit-not e) g))
                        majority (bit-xor (bit-xor (bit-and a b)
                                                    (bit-and a c))
                                          (bit-and b c))
                        t1 (mask32 (+ (+ hh (big1 e))
                                      (+ choice (+ (vector-at k i)
                                                     (vector-at w i)))))
                        t2 (mask32 (+ (big0 a) majority))]
                    (recur (+ i 1)
                           [(mask32 (+ t1 t2)) a b c
                            (mask32 (+ d t1)) e f g]))))]
    (add-states h state)))

(defn- digest [] :vector-i64
  (let [bytes (padded-message)
        k (constants)
        h [1779033703 3144134277 1013904242 2773480762
           1359893119 2600822924 528734635 1541459225]
        first (compress h (words bytes 0) k)]
    (compress first (words bytes 64) k)))

(defn run [token :i64] :i64
  (if (= token 1)
    (let [h (digest)]
      (if (and (= (vector-at h 0) 613247585)
               (= (vector-at h 1) 3523623096)
               (= (vector-at h 2) 3854575251)
               (= (vector-at h 3) 205414457)
               (= (vector-at h 4) 2738676825)
               (= (vector-at h 5) 1694441831)
               (= (vector-at h 6) 4142722516)
               (= (vector-at h 7) 433784513)) 1 0))
    0))

(defn test-nettle-sha256 [] :i64 (run 1))
