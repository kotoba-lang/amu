;; DIAGNOSTIC ONLY -- not a claim fixture. kernel_deep with each lane's
;; input derived from the previous by one add instead of materialising a
;; fresh constant: (n+i)*48271+1 == ((n+i-1)*48271+1) + 48271, so every
;; lane result is bit-identical to kernel_deep's. What changes is the
;; dependency structure -- 24 independent materialisations become a serial
;; chain of adds. Tests induction-variable strength reduction across lanes.
(ns kernel-deep-incremental (:export [kernel]))

(defn kernel [n :i64] :i64
  (let [
        v_a (+ (* (+ n 0) 48271) 1)
        a (- v_a (* (quot v_a 2147483647) 2147483647))
        v_b (+ v_a 48271)
        b (- v_b (* (quot v_b 2147483647) 2147483647))
        v_c (+ v_b 48271)
        c (- v_c (* (quot v_c 2147483647) 2147483647))
        v_d (+ v_c 48271)
        d (- v_d (* (quot v_d 2147483647) 2147483647))
        v_e (+ v_d 48271)
        e (- v_e (* (quot v_e 2147483647) 2147483647))
        v_f (+ v_e 48271)
        f (- v_f (* (quot v_f 2147483647) 2147483647))
        v_g (+ v_f 48271)
        g (- v_g (* (quot v_g 2147483647) 2147483647))
        v_h (+ v_g 48271)
        h (- v_h (* (quot v_h 2147483647) 2147483647))
        v_i (+ v_h 48271)
        i (- v_i (* (quot v_i 2147483647) 2147483647))
        v_j (+ v_i 48271)
        j (- v_j (* (quot v_j 2147483647) 2147483647))
        v_k (+ v_j 48271)
        k (- v_k (* (quot v_k 2147483647) 2147483647))
        v_l (+ v_k 48271)
        l (- v_l (* (quot v_l 2147483647) 2147483647))
        v_m (+ v_l 48271)
        m (- v_m (* (quot v_m 2147483647) 2147483647))
        v_n (+ v_m 48271)
        n (- v_n (* (quot v_n 2147483647) 2147483647))
        v_o (+ (* (+ n 14) 48271) 1)
        o (- v_o (* (quot v_o 2147483647) 2147483647))
        v_p (+ v_o 48271)
        p (- v_p (* (quot v_p 2147483647) 2147483647))
        v_q (+ v_p 48271)
        q (- v_q (* (quot v_q 2147483647) 2147483647))
        v_r (+ v_q 48271)
        r (- v_r (* (quot v_r 2147483647) 2147483647))
        v_s (+ v_r 48271)
        s (- v_s (* (quot v_s 2147483647) 2147483647))
        v_t (+ v_s 48271)
