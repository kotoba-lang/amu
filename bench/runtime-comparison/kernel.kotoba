(ns bench.runtime-kernel)

(defn kernel [n]
  (let [v1 (+ (* n 48271) 1)
        x1 (- v1 (* (quot v1 2147483647) 2147483647))
        v2 (+ (* x1 48271) 1)
        x2 (- v2 (* (quot v2 2147483647) 2147483647))
        v3 (+ (* x2 48271) 1)
        x3 (- v3 (* (quot v3 2147483647) 2147483647))
        v4 (+ (* x3 48271) 1)
        x4 (- v4 (* (quot v4 2147483647) 2147483647))
        v5 (+ (* x4 48271) 1)
        x5 (- v5 (* (quot v5 2147483647) 2147483647))
        v6 (+ (* x5 48271) 1)
        x6 (- v6 (* (quot v6 2147483647) 2147483647))
        v7 (+ (* x6 48271) 1)
        x7 (- v7 (* (quot v7 2147483647) 2147483647))
        v8 (+ (* x7 48271) 1)]
    (- v8 (* (quot v8 2147483647) 2147483647))))

;; Measured experiment, not the timed export. Putting the eight rounds in a
;; `loop` keeps `n`/`left`/`last` live and the helper spills (82 LDR / 72 STR,
;; 71 ns vs 13 ns for the 1-arg `kernel` leaf). Default harness still extracts
;; `kernel`. Each iteration starts from `n`, same as 100k calls of `kernel`.
(defn bench [n remaining]
  (loop [left remaining last 0]
    (if (= left 0)
      last
      (let [v1 (+ (* n 48271) 1)
            x1 (- v1 (* (quot v1 2147483647) 2147483647))
            v2 (+ (* x1 48271) 1)
            x2 (- v2 (* (quot v2 2147483647) 2147483647))
            v3 (+ (* x2 48271) 1)
            x3 (- v3 (* (quot v3 2147483647) 2147483647))
            v4 (+ (* x3 48271) 1)
            x4 (- v4 (* (quot v4 2147483647) 2147483647))
            v5 (+ (* x4 48271) 1)
            x5 (- v5 (* (quot v5 2147483647) 2147483647))
            v6 (+ (* x5 48271) 1)
            x6 (- v6 (* (quot v6 2147483647) 2147483647))
            v7 (+ (* x6 48271) 1)
            x7 (- v7 (* (quot v7 2147483647) 2147483647))
            v8 (+ (* x7 48271) 1)
            x8 (- v8 (* (quot v8 2147483647) 2147483647))]
        (recur (- left 1) x8)))))

(defn main []
  (kernel 200))
