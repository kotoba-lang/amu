;; Twenty-four independent lanes, all live until a final sum. Above the pool on
;; both targets -- x86-64 offers eleven registers to a leaf and AArch64
;; nineteen -- so this is the workload that lands on the far side of the
;; allocator's cliff rather than inside the pool.
(ns kernel-deep (:export [kernel]))

(defn kernel [n :i64] :i64
  (let [
        v_a (+ (* (+ n 0) 48271) 1)
        a (- v_a (* (quot v_a 2147483647) 2147483647))
        v_b (+ (* (+ n 1) 48271) 1)
        b (- v_b (* (quot v_b 2147483647) 2147483647))
        v_c (+ (* (+ n 2) 48271) 1)
        c (- v_c (* (quot v_c 2147483647) 2147483647))
