;; DIAGNOSTIC ONLY -- not a claim fixture. kernel_deep with the final sum
;; interleaved into the lanes instead of taken at the end. Same lanes, same
;; arithmetic, same result (i64 addition is associative, so reassociating
;; the 24-term sum is exact); what changes is LIVENESS -- peak live lane
;; values drops from 24 to about 2, which is the pressure this fixture
;; exists to create. Tests whether sum reassociation to reduce register
;; pressure is worth building, against the serial accumulator chain it costs.
(ns kernel-deep-accum (:export [kernel]))

(defn kernel [n :i64] :i64
  (let [
        v_a (+ (* (+ n 0) 48271) 1)
        a (- v_a (* (quot v_a 2147483647) 2147483647))
        s_a a
        v_b (+ (* (+ n 1) 48271) 1)
        b (- v_b (* (quot v_b 2147483647) 2147483647))
        s_b (+ s_a b)
        v_c (+ (* (+ n 2) 48271) 1)
        c (- v_c (* (quot v_c 2147483647) 2147483647))
        s_c (+ s_b c)
        v_d (+ (* (+ n 3) 48271) 1)
        d (- v_d (* (quot v_d 2147483647) 2147483647))
        s_d (+ s_c d)
        v_e (+ (* (+ n 4) 48271) 1)
        e (- v_e (* (quot v_e 2147483647) 2147483647))
        s_e (+ s_d e)
        v_f (+ (* (+ n 5) 48271) 1)
        f (- v_f (* (quot v_f 2147483647) 2147483647))
        s_f (+ s_e f)
        v_g (+ (* (+ n 6) 48271) 1)
        g (- v_g (* (quot v_g 2147483647) 2147483647))
        s_g (+ s_f g)
        v_h (+ (* (+ n 7) 48271) 1)
        h (- v_h (* (quot v_h 2147483647) 2147483647))
        s_h (+ s_g h)
        v_i (+ (* (+ n 8) 48271) 1)
        i (- v_i (* (quot v_i 2147483647) 2147483647))
        s_i (+ s_h i)
        v_j (+ (* (+ n 9) 48271) 1)
        j (- v_j (* (quot v_j 2147483647) 2147483647))
        s_j (+ s_i j)
        v_k (+ (* (+ n 10) 48271) 1)
        k (- v_k (* (quot v_k 2147483647) 2147483647))
        s_k (+ s_j k)
        v_l (+ (* (+ n 11) 48271) 1)
        l (- v_l (* (quot v_l 2147483647) 2147483647))
        s_l (+ s_k l)
        v_m (+ (* (+ n 12) 48271) 1)
        m (- v_m (* (quot v_m 2147483647) 2147483647))
        s_m (+ s_l m)
        v_n (+ (* (+ n 13) 48271) 1)
        n (- v_n (* (quot v_n 2147483647) 2147483647))
        s_n (+ s_m n)
        v_o (+ (* (+ n 14) 48271) 1)
        o (- v_o (* (quot v_o 2147483647) 2147483647))
        s_o (+ s_n o)
        v_p (+ (* (+ n 15) 48271) 1)
        p (- v_p (* (quot v_p 2147483647) 2147483647))
        s_p (+ s_o p)
        v_q (+ (* (+ n 16) 48271) 1)
        q (- v_q (* (quot v_q 2147483647) 2147483647))
        s_q (+ s_p q)
        v_r (+ (* (+ n 17) 48271) 1)
        r (- v_r (* (quot v_r 2147483647) 2147483647))
        s_r (+ s_q r)
        v_s (+ (* (+ n 18) 48271) 1)
        s (- v_s (* (quot v_s 2147483647) 2147483647))
        s_s (+ s_r s)
        v_t (+ (* (+ n 19) 48271) 1)
        t (- v_t (* (quot v_t 2147483647) 2147483647))
        s_t (+ s_s t)
        v_u (+ (* (+ n 20) 48271) 1)
        u (- v_u (* (quot v_u 2147483647) 2147483647))
        s_u (+ s_t u)
        v_v (+ (* (+ n 21) 48271) 1)
        v (- v_v (* (quot v_v 2147483647) 2147483647))
        s_v (+ s_u v)
        v_w (+ (* (+ n 22) 48271) 1)
        w (- v_w (* (quot v_w 2147483647) 2147483647))
        s_w (+ s_v w)
        v_x (+ (* (+ n 23) 48271) 1)
        x (- v_x (* (quot v_x 2147483647) 2147483647))
        s_x (+ s_w x)]
    s_x))
