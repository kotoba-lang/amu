;; Branch-dense state machine: a five-state DFA driven by a Lehmer stream's
;; low two bits. Every transition is a data-dependent branch tree, so unlike
;; the six existing domains the branch predictor faces real entropy. Pure
;; word-typed i64, no calls, no memory: runs on today's native admission.
(ns kernel-state (:export [kernel]))

(defn kernel [n :i64] :i64
  (let [r0 (+ n 1)]
    (loop [x r0 state 0 acc 0 left 64]
      (if (= left 0)
        (+ acc (+ x (* state 1000003)))
        (let [v (+ (* x 48271) 1)
              x2 (- v (* (quot v 2147483647) 2147483647))
              sym (- x2 (* (quot x2 4) 4))
              s2 (if (= state 0)
                   (if (= sym 0) 1 (if (= sym 1) 2 (if (= sym 2) 0 3)))
                   (if (= state 1)
                     (if (= sym 0) 2 (if (= sym 1) 4 (if (= sym 2) 1 0)))
                     (if (= state 2)
                       (if (= sym 0) 3 (if (= sym 1) 0 (if (= sym 2) 4 2)))
                       (if (= state 3)
                         (if (= sym 0) 4 (if (= sym 1) 3 (if (= sym 2) 2 1)))
                         (if (= sym 0) 0 (if (= sym 1) 1 (if (= sym 2) 3 4)))))))
              acc2 (+ acc (+ s2 sym))]
          (recur x2 s2 acc2 (- left 1)))))))
