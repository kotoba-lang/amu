 :loader-source-sha256 "ef9b2dffdc87249d73e4d0fb7afcd31815ac484e83ffee0161559a72458a22eb"
 :profiles {:x64 {:min-cov 60 :min-features 100 :min-corpus 20}
            :arm64 {:min-cov 60 :min-features 100 :min-corpus 18}}}
