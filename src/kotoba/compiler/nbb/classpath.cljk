(ns kotoba.compiler.nbb.classpath
  "JVM-free dependency-closure resolution for `bin/kotoba`'s nbb fast path.

  The fast path's *compile* code has never touched the JVM. Its *classpath*
  did: `bin/kotoba` shelled out to `kbb -Spath` purely to locate the
  pinned git dependencies in `~/.gitlibs`. That one call is what made the
  whole path need a JDK — measured directly by stubbing `clojure` out on a
  cold cache, which produced `Could not find namespace: kotoba.artifact.core`
  rather than a resolution error, because the failure returned an empty
  classpath and the caller carried on with a truncated one.

  This resolves the same closure from a checked-in lock and `git`, which is
  all a set of `:git/sha` pins actually needs. A commit id is a content
  address, so the resolution is reproducible without re-deriving it; that is
  also why the lock exists at all rather than a resolver that re-implements
  `tools.deps`. Transitive pins genuinely conflict here — the root pins
  `kotoba-kir` at one commit and three siblings pin three others — and
  choosing between them is `tools.deps`' job, done once at authoring time by
  `scripts/lock-classpath.cljk`. The lock records the answer, not the
  algorithm.

  Maven jars are deliberately absent from the lock. nbb cannot load a `.jar`,
  so they were never part of what this path resolves; recording machine-local
  `~/.m2` paths would make the lock unreproducible for no gain.

  Fail-closed throughout: a lock that does not match `deps.edn`, a checkout at
  the wrong commit, or a missing dependency directory is an error, never a
  shorter classpath."
  {:kotoba/export [-main checkout-dir deps-digest gitlibs-root head-sha lock-file-name lock-version materialize! read-lock resolve-alias-directories resolve-directories sha256-hex subdir-tree]}
  (:require [clojure.edn :as edn]
            [kotoba.compiler.nbb.fs-tree :as fs-tree]
            [kotoba.compiler.posix-path :as posix-path]
            [kotoba.compiler.process-wire :as process-wire]
            [kotoba.lang.text :as str]
            ;; Abilities (superproject adr-2609242330 S5): hash/sha256,
            ;; fs/app-data, process/spawn, env/read, io/write and
            ;; io/write-error; `sys` holds the host facts no ability carries.
            #?(:cljs [kotoba.compiler.nbb.host.env :as env])
            #?(:cljs [kotoba.compiler.nbb.host.fs :as fs])
            #?(:cljs [kotoba.compiler.nbb.host.hash :as hash])
            #?(:cljs [kotoba.compiler.nbb.host.io :as io])
            #?(:cljs [kotoba.compiler.nbb.host.process :as process])
            #?(:cljs [kotoba.compiler.nbb.host.sys :as sys])))

(def lock-version 2)
(def lock-file-name "deps-lock.edn")

(defn sha256-hex [buffer]
  (hash/sha256 buffer))

(defn- exists? [p] (fs-tree/exists? p))

(defn deps-digest
  "The digest of `deps.edn`'s bytes. The lock is bound to it, so editing a pin
  without regenerating the lock is an error rather than a silently stale
  closure."
  [root]
  (sha256-hex (fs/app-data-bytes (posix-path/join root "deps.edn"))))

(defn gitlibs-root []
  (let [configured (env/read "GITLIBS")]
    (if (seq configured)
      configured
      (posix-path/join #?(:cljs (sys/homedir) :default (env/read "HOME")) ".gitlibs"))))

(defn checkout-dir
  "The directory `tools.deps` uses for COORDINATE at SHA. Shared on purpose:
  when a JVM run has already fetched a dependency, this resolves with no
  network at all, and when this path fetches one first, a later JVM run finds
  it already present."
  [coordinate sha]
  (let [[group artifact] (str/split coordinate #"/")]
    (posix-path/join (posix-path/join (posix-path/join (posix-path/join (gitlibs-root) "libs") group)
                                      (or artifact group))
                     sha)))

(defn- git!
  "Run git with ARGS through process/spawn: {:exit n :out stdout}, or
  {:exit -1 :out \"\"} when git cannot be started. git's stderr is this
  process's own (the wire captures stdout only)."
  [args]
  (try
    (let [answer (process/spawn (process-wire/request "git" args))]
      {:exit (process-wire/answer-exit answer) :out (process-wire/answer-out answer)})
    (catch :default _ {:exit -1 :out ""})))

(defn- git-ok? [result]
  (zero? (:exit result)))

(defn head-sha
  "The commit a checkout is actually at, or nil when it is not a git
  checkout. This is the content-address check: a directory named after a
  commit is not evidence that it holds that commit."
  [dir]
  (let [result (git! ["-C" dir "rev-parse" "HEAD"])]
    (when (git-ok? result) (str/trim (:out result)))))

(defn materialize!
  "Fetch COORDINATE at SHA into its checkout directory. Full history, per the
  workspace's no-shallow rule -- a graft boundary would make the very
  ancestry check below unreliable."
  [{:keys [coordinate git-url git-sha git-subdir]}]
  (let [dir (checkout-dir coordinate git-sha)]
    (when-not (exists? dir)
      (fs-tree/make-directories! dir)
      (let [complete? (atom false)]
        (try
          ;; git's own stderr reaches this process's stderr directly
          ;; (process/spawn captures stdout only), ahead of the EDN error.
          (let [clone (git! ["clone" "--quiet" "--no-checkout" git-url dir])]
            (when-not (git-ok? clone)
              (throw (ex-info "git clone failed"
                              {:phase :fetch :coordinate coordinate :url git-url}))))
          ;; A monorepo checkout is sparse (cone mode): only the lib/<id>
          ;; directories the lock names are written, which keeps unrelated
          ;; deep paths elsewhere in the monorepo off disk (Windows MAX_PATH).
          (when git-subdir
            (when-not (git-ok? (git! ["-C" dir "sparse-checkout" "set" "--cone"]))
              (throw (ex-info "git sparse-checkout failed"
                              {:phase :fetch :coordinate coordinate}))))
          (let [checkout (git! ["-C" dir "checkout" "--quiet" git-sha])]
            (when-not (git-ok? checkout)
              (throw (ex-info "git checkout of the pinned commit failed"
                              {:phase :fetch :coordinate coordinate :sha git-sha}))))
          (reset! complete? true)
          (finally
            ;; `git clone` leaves its destination behind on transport failure.
            ;; Remove only the fresh, exact content-addressed directory we
            ;; created so the launcher's bounded retry can actually retry.
            (when-not @complete?
              (fs-tree/remove-tree! dir))))))
    ;; Each further library of a sparse monorepo checkout is added on first
    ;; use. A full checkout (made by another tool) already has it.
    (when (and git-subdir (not (exists? (posix-path/join dir git-subdir))))
      (when-not (git-ok? (git! ["-C" dir "sparse-checkout" "add" git-subdir]))
        (throw (ex-info "git sparse-checkout of the locked subdirectory failed"
                        {:phase :fetch :coordinate coordinate :subdir git-subdir}))))
    dir))

(defn- checkout-coordinate
  "The checkout an entry lives in. A monorepo entry names its library with
  `:coordinate` and the repository holding it with `:git-repo`, so every
  library pinned at one monorepo commit shares one checkout instead of
  cloning the whole repository once per library."
  [{:keys [coordinate git-repo]}]
  (or git-repo coordinate))

(defn subdir-tree
  "The git tree id of SUBDIR at the checkout's HEAD, or nil."
  [dir subdir]
  (let [result (git! ["-C" dir "rev-parse" (str "HEAD:" subdir)])]
    (when (git-ok? result) (str/trim (:out result)))))

(defn- entry-directories [{:keys [coordinate git-sha git-subdir git-tree paths] :as entry}]
  (let [dir (materialize! (assoc entry :coordinate (checkout-coordinate entry)))
        actual (head-sha dir)]
    (when-not (= git-sha actual)
      (throw (ex-info "dependency checkout is not at its pinned commit"
                      {:phase :verify :coordinate coordinate
                       :expected git-sha :actual actual :dir dir})))
    (when git-subdir
      ;; A monorepo library is the tree at :git-subdir. The commit already
      ;; content-addresses it; the tree id is checked as well so a lock that
      ;; names the wrong directory fails here rather than as a missing
      ;; namespace later.
      (let [tree (subdir-tree dir git-subdir)]
        (when-not (and git-tree (= git-tree tree))
          (throw (ex-info "dependency subdirectory is not at its pinned tree"
                          {:phase :verify :coordinate coordinate :subdir git-subdir
                           :expected git-tree :actual tree :dir dir})))))
    (let [base (if git-subdir (posix-path/join dir git-subdir) dir)
          resolved (mapv #(posix-path/join base %) paths)
          missing (vec (remove exists? resolved))]
      (when (seq missing)
        (throw (ex-info "dependency path recorded in the lock does not exist"
                        {:phase :verify :coordinate coordinate :missing missing})))
      resolved)))

(defn read-lock [root]
  (let [file (posix-path/join root lock-file-name)]
    (when (exists? file)
      (edn/read-string (fs/app-data file)))))

(defn resolve-directories
  "Every source directory the nbb fast path needs, from the lock. Throws with
  a `:phase` on any disagreement."
  [root]
  (let [lock (read-lock root)]
    (when-not lock
      (throw (ex-info "no dependency lock; run scripts/lock-classpath.cljk"
                      {:phase :lock :expected (posix-path/join root lock-file-name)})))
    (when-not (= lock-version (:lock/version lock))
      (throw (ex-info "unsupported dependency lock version"
                      {:phase :lock :actual (:lock/version lock)})))
    (let [digest (deps-digest root)]
      (when-not (= digest (:lock/deps-digest lock))
        (throw (ex-info "deps.edn changed since the lock was generated; run scripts/lock-classpath.cljk"
                        {:phase :lock :expected (:lock/deps-digest lock) :actual digest}))))
    (when (empty? (:lock/entries lock))
      (throw (ex-info "dependency lock has no entries" {:phase :lock})))
    (into [] (mapcat entry-directories) (:lock/entries lock))))

(defn resolve-alias-directories
  "The directories an alias ADDS (recorded under `:lock/alias-entries` by
  `scripts/lock-classpath.cljk`). An alias the lock does not carry is a
  refusal, not an empty vector: an nbb test runner that asked for `:test`
  and got nothing would load its namespaces from wherever else they happened
  to be, or fail on the first require with no hint of why."
  [root alias]
  (let [lock (read-lock root)
        entries (get-in lock [:lock/alias-entries (keyword alias)])]
    (when-not (contains? (or (:lock/alias-entries lock) {}) (keyword alias))
      (throw (ex-info (str "the dependency lock carries no entries for alias " alias
                           "; run scripts/lock-classpath.cljk")
                      {:phase :lock :alias alias
                       :locked (vec (keys (:lock/alias-entries lock)))})))
    (into [] (mapcat entry-directories) entries)))

(defn -main
  "Print the resolved dependency directories, one per line, or an EDN error on
  STDERR and a non-zero exit. `bin/kotoba` joins them with the platform
  separator; keeping the output one-per-line means a path containing the
  separator cannot be mistaken for two entries."
  [& args]
  (let [aliases (->> (partition 2 1 args)
                     (filter #(= "--alias" (first %)))
                     (map second))
        positional (->> (partition-all 2 1 (concat [nil] args))
                        (remove (fn [[before a]] (or (= a "--alias") (= before "--alias"))))
                        (map second)
                        (remove nil?))
        root (or (first positional) (sys/cwd ""))]
    (try
      (doseq [dir (concat (resolve-directories root)
                          (mapcat #(resolve-alias-directories root %) aliases))]
        (io/write (str dir "\n")))
      0
      (catch :default error
        (io/write-error (str (pr-str (merge {:format :kotoba.classpath-error/v1 :ok false
                                              :message (ex-message error)}
                                             (ex-data error)))
                             "\n"))
        1))))
