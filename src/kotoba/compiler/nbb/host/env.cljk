(ns kotoba.compiler.nbb.host.env
  "MECHANISM LAYER -- the nbb/Node handler of the env/read ability
  (catalog wire 33; superproject adr-2609242330 S5, section 1 (c)). Not
  Kotoba source: a compiler module writes `(env/read name)` and requires
  this namespace only under `#?(:cljs ...)`. The answer is the variable's
  value, or the empty string when it is unset -- the catalog's shape, the
  kexe loader's env_read_provider and the static ELF handler all answer
  so. See kotoba.compiler.nbb.host.io for the layer's contract."
  {:kotoba/export []}
  (:refer-clojure :exclude [read]))

;; R6QW3: the Kotoba reading (W3 re-port). This is the MECHANISM LAYER of the env/read
;; ability (catalog wire 33): the handler answers the variable's value or "" when unset.
;; It is a host ability -- the guest has no environment (the kexe capability model), so the
;; :kotoba reading is the fail-closed refusal (the same shape as kotoba.kir.js-operations'
;; require-js-host!). The host reading is byte-for-byte. :kotoba/export [] (the guest does
;; not consume this handler).
#?(:kotoba
   (defn read
     "env/read 33: a host ability; the guest has no environment."
     [name :string] :string
     (throw (ex-info "env/read is a host ability" {:phase :value :trap :env-read-host})))
   :default
(defn read
  "env/read 33: the value of the environment variable NAME, \"\" when unset."
  [name]
  (let [value (aget js/process.env name)]
    (if (string? value) value ""))))
