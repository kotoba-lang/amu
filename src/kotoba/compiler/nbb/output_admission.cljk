(ns kotoba.compiler.nbb.output-admission
  "Integrity admission for a committed primary artifact/provenance pair.

  This deliberately does not authenticate a publisher.  It proves that the
  sealed provenance is structurally closed and names the exact verified
  artifact selected by the output-set commit marker."
  {:kotoba/export [admit! format]}
  (:require #?(:cljs [kotoba.lang.coll :as coll])
            [kotoba.artifact.core :as artifact]
            [kotoba.kir.compatibility :as compatibility]
            #?(:cljs [kotoba.lang.edn :as edn])
            #?(:cljs [kotoba.compiler.nbb.cli-support :as support])
            #?(:cljs [kotoba.compiler.nbb.compile-cache :as digest]
               :kotoba [kotoba.compiler.nbb.compile-cache :as digest])
            #?(:cljs [kotoba.kir.cljs-i64 :as i64])
            #?(:cljs [kotoba.verifier :as verifier])))

;; Kotoba reading (a project-route compile of this module). The provenance
;; record is checked structurally over a document, exactly as the host does,
;; and for a primary Wasm output the artifact's IDENTITY is checked too: the
;; target is a wasm target, the primary record is the closed
;; {:format :sha256 :size} map, :size is the byte count of the artifact and
;; :sha256 is the SHA-256 of its bytes (the pure sha2 reading of
;; `compile-cache/sha256-bytes`, byte-identical to node:crypto).
;;
;; What is still missing is named, not hidden. An artifact whose identity
;; checks all pass is STILL refused, because admission also requires that the
;; module validates, and there is no Wasm validator on the Kotoba route:
;;   wasm-validator-unavailable    `WebAssembly.validate` is a host engine;
;;                                 kotoba-wasm emits modules and checks them
;;                                 only through that engine (its self-validate!)
;;                                 -- it has no section/type/function-body
;;                                 validator of its own
;;   native-verifier-unavailable   the UTF-8 decode + EDN read of the kexe
;;                                 artifact keeps the host reader's integer
;;                                 representation (bigint leaves) that the
;;                                 independent native verifier consumes, and
;;                                 that representation does not exist here
;; A refusal is the only answer: this module never says `committed true` for
;; bytes it did not fully check. A wasm artifact whose size or digest does not
;; match its provenance is refused as `wasm-identity-mismatch`, the host's own
;; reason. The host reading is unchanged.
#?(:kotoba
   (defn format [] :keyword :kotoba.output-admission/v1)
   :default nil)

#?(:kotoba
   (defn- reject! [reason :string] :document
     (throw (ex-info (string-concat "output-set provenance rejected: " reason) {:phase :verify})))
   :default nil)

#?(:kotoba
   (defn- field [m :document k :keyword] :document
     (option-value-of [:option :document] (document-get m k) (document-null)))
   :default nil)

#?(:kotoba
   (defn- present? [m :document k :keyword] :bool
     (document-contains m (document-keyword k)))
   :default nil)

#?(:kotoba
   (defn- hex-byte? [b :i64] :bool
     (or (and (>= b 48) (<= b 57)) (and (>= b 97) (<= b 102))))
   :default nil)

#?(:kotoba
   (defn- digest? [d :document] :bool
     (if (= :string (document-kind d))
       (let [bs (string-to-utf8 (option-value-of [:option :string] (document-string-value d) ""))]
         (if (= 64 (bytes-count bs))
           (loop [i 0]
             (if (>= i 64)
               true
               (if (hex-byte? (bytes-at bs i)) (recur (+ i 1)) false)))
           false))
       false))
   :default nil)

#?(:kotoba
   (defn- keys-closed? [m :document] :bool
     (and (= :map (document-kind m))
          (= 15 (document-count m))
          (present? m :format) (present? m :builder) (present? m :compiler)
          (present? m :language) (present? m :source-sha256) (present? m :policy-sha256)
          (present? m :build-metadata-sha256) (present? m :hir-sha256) (present? m :kir-sha256)
          (present? m :target) (present? m :target-profile-sha256)
          (present? m :compatibility-sha256) (present? m :definitions)
          (present? m :outputs) (present? m :sha256)))
   :default nil)

#?(:kotoba
   (defn- digests? [m :document] :bool
     (and (digest? (field m :source-sha256)) (digest? (field m :policy-sha256))
          (digest? (field m :build-metadata-sha256)) (digest? (field m :hir-sha256))
          (digest? (field m :kir-sha256)) (digest? (field m :target-profile-sha256))
          (digest? (field m :compatibility-sha256))))
   :default nil)

#?(:kotoba
   (defn- provenance? [d :document] :bool
     (and (keys-closed? d)
          (document-equal? (field d :format) (document-keyword :kotoba.provenance/v1))
          (document-equal? (field d :builder) (document-keyword :kotoba-compiler/v1))
          (document-equal? (field d :compiler) (document-string (compatibility/compiler-version)))
          (document-equal? (field d :language) (document-keyword (compatibility/language-version)))
          (artifact/valid-seal? d)
          (digests? d)
          (= 1 (document-count (field d :outputs)))
          (present? (field d :outputs) :primary)
          ;; The definition graph must be present and speak its contract (a
          ;; record without it predates ADR 0300 and is not admitted).
          (= :map (document-kind (field d :definitions)))
          (document-equal? (field (field d :definitions) :contract)
                           (document-keyword :kotoba.definition-identity/v1))
          (= :map (document-kind (field (field d :outputs) :primary)))))
   :default nil)

#?(:kotoba
   (defn- wasm-target? [t :document] :bool
     (or (document-equal? t (document-keyword :wasm32-kotoba-v1))
         (document-equal? t (document-keyword :wasm32-browser-kotoba-v1))
         (document-equal? t (document-keyword :wasm32-wasi-kotoba-v1))))
   :default nil)

#?(:kotoba
   (defn- wasm-identity? [artifact-bytes :bytes provenance :document] :bool
     (let [primary (field (field provenance :outputs) :primary)]
       (and (wasm-target? (field provenance :target))
            (= 3 (document-count primary))
            (present? primary :format) (present? primary :sha256) (present? primary :size)
            (digest? (field primary :sha256))
            (match-option (document-i64-value (field primary :size)) [:option :i64]
              (none false)
              (some size (= size (bytes-count artifact-bytes))))
            (document-equal? (field primary :sha256)
                             (document-string (digest/sha256-bytes artifact-bytes))))))
   :default nil)

#?(:kotoba
   (defn admit! [artifact-bytes :bytes provenance :document] :document
     (if (provenance? provenance)
       (if (document-equal? (field (field (field provenance :outputs) :primary) :format) (document-keyword :wasm))
         (if (wasm-identity? artifact-bytes provenance)
           (reject! "wasm-validator-unavailable: identity (target, size, sha256) verified, but the Kotoba route has no WebAssembly validator (kotoba-wasm validates only through the host engine)")
           (reject! "wasm-identity-mismatch"))
         (if (document-equal? (field (field (field provenance :outputs) :primary) :format)
                              (document-keyword :kotoba.kexe/v1))
           (reject! "native-verifier-unavailable: the kexe artifact needs the host reader's integer representation and the independent native verifier")
           (reject! "unsupported-primary-format")))
       (reject! "malformed-provenance")))
   :default nil)

#?(:kotoba
   nil
   :default
   (do
(def format :kotoba.output-admission/v1)

(def ^:private provenance-keys
  "The CLOSED set of keys a sealed provenance record may carry. Closed on
  purpose: a record with an extra key is a record this verifier does not
  understand, and admitting it would mean admitting whatever the extra key
  said. `:definitions` joined the set when the compiler began sealing the
  definition graph (ADR 0300) -- and this line is where that change was
  caught, by a verifier that refused rather than by a test that noticed."
  #{:format :builder :compiler :language :source-sha256 :policy-sha256
    :build-metadata-sha256 :hir-sha256 :kir-sha256 :target
    :target-profile-sha256 :compatibility-sha256 :definitions :outputs :sha256})

(def ^:private wasm-targets
  #{:wasm32-kotoba-v1 :wasm32-browser-kotoba-v1 :wasm32-wasi-kotoba-v1})

(defn- reject! [reason]
  (throw (ex-info "output-set provenance rejected"
                  {:phase :verify :reason reason})))

(defn- digest? [value]
  (and (string? value) (boolean (re-matches #"[0-9a-f]{64}" value))))

(defn- provenance! [decoded]
  (let [primary (get-in decoded [:outputs :primary])]
    (when-not (and (map? decoded)
                   (= provenance-keys (set (keys decoded)))
                   (= :kotoba.provenance/v1 (:format decoded))
                   (= :kotoba-compiler/v1 (:builder decoded))
                   (= compatibility/compiler-version (:compiler decoded))
                   (= compatibility/language-version (:language decoded))
                   (artifact/valid-seal? decoded)
                   (every? digest? ((juxt :source-sha256 :policy-sha256
                                          :build-metadata-sha256 :hir-sha256
                                          :kir-sha256 :target-profile-sha256
                                          :compatibility-sha256) decoded))
                   (= #{:primary} (set (keys (:outputs decoded))))
                   ;; The definition graph must be PRESENT and must say which
                   ;; contract it speaks. An absent key would mean an artifact
                   ;; built before ADR 0300 -- or one whose identity step was
                   ;; skipped -- and those must not verify as though they had
                   ;; been measured.
                   (map? (:definitions decoded))
                   (= :kotoba.definition-identity/v1
                      (:contract (:definitions decoded)))
                   (map? primary))
      (reject! :malformed-provenance))
    decoded))

(defn- wasm-size [value]
  (cond
    (i64/bigint-value? value) (js/Number value)
    (number? value) value
    :else -1))

(defn- admit-wasm! [artifact-bytes provenance]
  (let [primary (get-in provenance [:outputs :primary])
        size (wasm-size (:size primary))]
    (when-not (and (contains? wasm-targets (:target provenance))
                   (= #{:format :sha256 :size} (set (keys primary)))
                   (= :wasm (:format primary))
                   (digest? (:sha256 primary))
                   (js/Number.isSafeInteger size)
                   (= (.-length artifact-bytes) size)
                   (= (digest/sha256 artifact-bytes) (:sha256 primary))
                   (.validate js/WebAssembly artifact-bytes))
      (reject! :wasm-identity-mismatch))))

(defn- admit-native! [artifact-bytes provenance]
  ;; The bounded reader has already admitted this exact text before this
  ;; second decode, which preserves the JS integer representation the
  ;; independent native verifier expects. The second decode is
  ;; kotoba.lang.edn (cljs.reader until 2026-09-25, superproject
  ;; adr-2609242330): the same values for every artifact cljs.reader read
  ;; exactly. The one input it answers differently is an integer beyond
  ;; 2^53-1 (`:value` of examples/i64-beyond-double.kotoba): cljs.reader
  ;; rounded it and the verifier then refused the artifact as an integrity
  ;; mismatch; kotoba.lang.edn refuses the token itself, named here as
  ;; :native-decode. Both refuse the output set; neither admits it.
  (let [artifact-text (try
                        (.decode (js/TextDecoder. "utf-8" #js {:fatal true})
                                 artifact-bytes)
                        (catch :default _ (reject! :native-decode)))
        _ (support/parse-policy-material {:present? true :text artifact-text})
        native (-> (try (edn/read-string artifact-text)
                        (catch :default _ (reject! :native-decode)))
                   (update :value
                           #(coll/postwalk (fn [x]
                                             (if (integer? x)
                                               (i64/->bigint x) x))
                                           %)))
        primary (get-in provenance [:outputs :primary])]
    (when-not (and (= #{:format :sha256} (set (keys primary)))
                   (= :kotoba.kexe/v1 (:format primary))
                   (digest? (:sha256 primary))
                   (= :kotoba.kexe/v1 (:format native))
                   (= (:target provenance) (:target native))
                   (= (:sha256 primary) (:sha256 native)))
      (reject! :native-identity-mismatch))
    (verifier/verify-artifact! native)))

(defn admit!
  [artifact-bytes provenance]
  (let [provenance (provenance! provenance)
        primary-format (get-in provenance [:outputs :primary :format])]
    (case primary-format
      :wasm (admit-wasm! artifact-bytes provenance)
      :kotoba.kexe/v1 (admit-native! artifact-bytes provenance)
      (reject! :unsupported-primary-format))
    {:format format
     :target (:target provenance)
     :committed true
     :provenance-sealed true
     :artifact-identity-verified true
     :target-verification (case primary-format
                            :wasm :webassembly-validate
                            :kotoba.kexe/v1 :independent-native-verifier)
     :publisher-authenticated false}))))
