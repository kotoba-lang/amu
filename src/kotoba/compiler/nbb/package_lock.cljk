(ns kotoba.compiler.nbb.package-lock
  "Resolve a Kotoba package lock (`kotoba.lock.edn`,
  `:kotoba.lock/version 1`) into source roots the project linker can read,
  without a JVM and without the network.

  WHAT THIS IS FOR. `ADR-kotoba-package-cid-lock` (accepted 2026-06-30)
  specified the lock, `kotoba.lang.package-contract` validates it, and the
  conformance corpus exercises it -- but its own maturity list has recorded
  M5, \"`kotoba-lang/registry` or `kotoba-cli` consumes the same suite\", as
  outstanding since the day it was written. Nothing read a lock. A package
  could be published, signed and pinned, and no compiler would look at it, so
  the only way to depend on Kotoba code was to hand `--source-path` a
  directory and hope. This namespace is that missing consumer.

  THE DIVISION OF LABOUR, because two locks now exist and they are not
  competing:

    kotoba.lock.edn      WHO and WHAT MAY IT DO -- package name and version,
    (this file)          repo identity, the commit it came from, the signer
                         DIDs, and the capability grant. Authority.

    kotoba.modules.edn   WHICH BYTES -- every module in the closed graph by
    (module_lock.cljs)   CID, read from a content-addressed block directory.
                         Integrity.

  They compose in that order: a package lock resolves to source roots, the
  linker walks them, and `module-lock` pins the result. Neither subsumes the
  other. A module lock says nothing about who signed the code; a package lock
  says nothing about the bytes of an individual module.

  NO NETWORK, ON PURPOSE. This does not fetch. Dependency trees are read from
  `--packages <dir>`, the way locked module bytes are read from `--blocks`.
  Fetching is the authoring side's job, and keeping it there is what lets a
  build be reproduced on a machine with no credentials and no route out.

  WHAT IS STRICTER HERE THAN IN THE CONTRACT. `:dep/definition-cids` is
  optional in `kotoba.lang.package-contract` -- deliberately, because
  effectful code stays component-addressed until its capability interface is
  in the typed KIR. It is REQUIRED here. The reason is that without it this
  namespace has nothing to check the materialised tree against: the lock's
  `:dep/tree-cid` pins a codebase head this route never computes, and
  `:dep/repo-rid` is a commitment to a URL, not a locator. Admitting a
  directory because it sits at the right path, under a name the lock
  mentions, would be a lock in name only -- the same failure `module_lock`
  refuses when it declines to fall back to a path search. A dep without
  definition CIDs is refused with the command that produces them."
  {:kotoba/export [dependency-root lock-schema manifest-file-name normalize-numbers package-dir-name report resolve-lock tree-bytes tree-serialization trust-context verify-definitions]}
  (:require [kotoba.compiler.decimal-text :as decimal-text]
            [kotoba.compiler.host-integer :as host-integer]
            [kotoba.compiler.posix-path :as posix-path]
            [kotoba.compiler.process-wire :as process-wire]
            [kotoba.compiler.text-bytes :as text-bytes]
            ;; Abilities (superproject adr-2609242330 S5): fs/app-data,
            ;; fs/browse, hash/sha256 and process/spawn.
            #?(:cljs [kotoba.compiler.nbb.host.fs :as fs])
            #?(:cljs [kotoba.compiler.nbb.host.hash :as hash])
            #?(:cljs [kotoba.compiler.nbb.host.process :as process])
            ;; Kotoba: the same abilities, the directory helpers, the Form record
            ;; (a lock and a manifest are EDN of unknown shape) and the pure
            ;; digest of file bytes.
            #?@(:kotoba [[kotoba.compiler.nbb.host.fs :as fs]
                         [kotoba.compiler.nbb.host.process :as process]
                         [kotoba.compiler.nbb.fs-tree :as fs-tree]
                         [kotoba.form :as form]
                         [kotoba.bytes :as kbytes]
                         [multiformats.core :as mf]])
            [kotoba.lang.coll :as coll]
            [kotoba.lang.text :as str]
            [kotoba.lang.package-contract :as contract]
            [kotoba.compiler.nbb.cli-support :as support])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

;; ── the Kotoba reading of this file ─────────────────────────────────────────
;; `#?(:kotoba A :default B)`: the Kotoba reader takes A, the JVM and
;; ClojureScript readers take B, so every host body below is what it was. A lock
;; and a manifest are the recursive `:form/r` record of kotoba.form (EDN of
;; unknown shape); a host `nil` is `(form/nil-form)`; a host constant that is
;; exported is a zero-argument function; `reject!` is a `throw` of an `ex-info`
;; whose data is a flat map of strings (the host's data map is not a document:
;; it holds nested values). Where the Kotoba reading differs from the host's,
;; the function says so:
;;   * a lock or manifest that is not readable EDN aborts with the bounded
;;     reader's own error, where the host catches it and refuses with
;;     "... does not read as EDN" (a capability call cannot be wrapped);
;;   * `git` that cannot be started aborts where the host takes it as "no git
;;     metadata" (same reason);
;;   * a refusal's data carries the dependency and the figures it can state as
;;     strings, not the host's nested maps;
;;   * every function that can refuse is called only from a tail position or a
;;     `let` binding (the abort ability's rule), and a loop that can refuse is a
;;     recursion.
;; The set operations (`sort`, `distinct`, `set-difference`) are restated over
;; Form lists in byte order, the order the host's `sort` gives these strings and
;; keywords.

#?(:kotoba
(defn- kf [k :keyword] [:ref :form/r] (form/keyword-form k)))

;; A function of ANOTHER module that can abort is seen here as returning its
;; lowered interface `[:result T E]` (abort slice 2 propagates inside one module,
;; not across a module boundary): these unwrap it and abort again with the same
;; error, the pattern cli_support's `read-edn-file!` uses for `bounded-edn`.
#?(:kotoba
(defn- unwrap-form [r [:result [:ref :form/r] :document]] [:ref :form/r]
  (if (result-ok?-of [:result [:ref :form/r] :document] r)
    (result-value-of [:result [:ref :form/r] :document] r (form/nil-form))
    (throw (result-error-of [:result [:ref :form/r] :document] r (document-null))))))

#?(:kotoba
(defn- unwrap-string [r [:result :string :document]] :string
  (if (result-ok?-of [:result :string :document] r)
    (result-value-of [:result :string :document] r "")
    (throw (result-error-of [:result :string :document] r (document-null))))))

#?(:kotoba
(defn- unwrap-i64 [r [:result :i64 :document]] :i64
  (if (result-ok?-of [:result :i64 :document] r)
    (result-value-of [:result :i64 :document] r 0)
    (throw (result-error-of [:result :i64 :document] r (document-null))))))

#?(:kotoba
(defn- gk [m [:ref :form/r] k :keyword] [:ref :form/r]
  (if (form/is-map? m) (form/form-get m (form/keyword-form k)) (form/nil-form))))

;; the string at K of M, "" when it is not a string
#?(:kotoba
(defn- gs [m [:ref :form/r] k :keyword] :string
  (let [v (gk m k)] (if (form/is-string? v) (form/string-value v) ""))))

#?(:kotoba
(defn- truthy? [x [:ref :form/r]] :bool
  (not (or (form/is-nil? x) (and (form/is-bool? x) (not (form/bool-value x)))))))

#?(:kotoba
(defn- map2 [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r]] [:ref :form/r]
  (form/form-map (typed-list-new [:list [:ref :form/r]] (kf k1) v1 (kf k2) v2))))

#?(:kotoba
(defn- map3 [k1 :keyword v1 [:ref :form/r] k2 :keyword v2 [:ref :form/r] k3 :keyword v3 [:ref :form/r]] [:ref :form/r]
  (form/form-map (typed-list-new [:list [:ref :form/r]] (kf k1) v1 (kf k2) v2 (kf k3) v3))))

;; the message of a contract error value
#?(:kotoba
(defn- message-of [e [:ref :form/r]] :string (gs e :message)))

;; ---- sorted, deduplicated Form lists (the host's `(vec (sort (set xs)))`) ------

;; -1, 0, 1: strings by byte order; keywords by namespace, then name; strings
;; before keywords; anything else equal.
#?(:kotoba
(defn- kind-rank [x [:ref :form/r]] :i64
  (cond (form/is-string? x) 0 (form/is-keyword? x) 1 :else 2)))

#?(:kotoba
(defn- keyword-parts [k [:ref :form/r]] :string
  (let [s (document-edn-print (document-keyword (form/keyword-value k)))]
    (string-substring s 1 (string-byte-length s)))))

#?(:kotoba
(defn- compare-keywords [a :string b :string] :i64
  (let [ia (string-find-byte a 47 0)
        ib (string-find-byte b 47 0)]
    (cond
      (and (< ia 0) (< ib 0)) (string-compare a b)
      (< ia 0) -1
      (< ib 0) 1
      :else (let [c (string-compare (string-substring a 0 ia) (string-substring b 0 ib))]
              (if (= c 0)
                (string-compare (string-substring a (+ ia 1) (string-byte-length a))
                                (string-substring b (+ ib 1) (string-byte-length b)))
                c))))))

#?(:kotoba
(defn- form-compare [a [:ref :form/r] b [:ref :form/r]] :i64
  (let [ra (kind-rank a) rb (kind-rank b)]
    (cond
      (< ra rb) -1
      (> ra rb) 1
      (= ra 0) (string-compare (form/string-value a) (form/string-value b))
      (= ra 1) (compare-keywords (keyword-parts a) (keyword-parts b))
      :else 0))))

;; XS with X inserted before the first item that sorts after it, unless an equal item is there
#?(:kotoba
(defn- insert-sorted [xs [:list [:ref :form/r]] x [:ref :form/r]] [:list [:ref :form/r]]
  (let [n (vector-count xs)]
    (loop [i 0]
      (cond
        (>= i n) (form/append-form xs x)
        (= 0 (form-compare (typed-list-nth [:list [:ref :form/r]] xs i) x)) xs
        (> (form-compare (typed-list-nth [:list [:ref :form/r]] xs i) x) 0)
        (form/append-many (form/append-form (take-forms xs i) x) (drop-forms xs i))
        :else (recur (+ i 1)))))))

#?(:kotoba
(defn- take-forms [xs [:list [:ref :form/r]] n :i64] [:list [:ref :form/r]]
  (loop [i 0 acc (form/no-forms)]
    (if (>= i n) acc (recur (+ i 1) (form/append-form acc (typed-list-nth [:list [:ref :form/r]] xs i)))))))

#?(:kotoba
(defn- drop-forms [xs [:list [:ref :form/r]] n :i64] [:list [:ref :form/r]]
  (let [len (vector-count xs)]
    (loop [i n acc (form/no-forms)]
      (if (>= i len) acc (recur (+ i 1) (form/append-form acc (typed-list-nth [:list [:ref :form/r]] xs i))))))))

;; the items of the Form list / vector / set XS, sorted and each once
#?(:kotoba
(defn- sorted-items [xs [:ref :form/r]] [:list [:ref :form/r]]
  (let [n (form/count-of xs)]
    (loop [i 0 acc (form/no-forms)]
      (if (>= i n)
        acc
        (recur (+ i 1) (insert-sorted acc (form/nth-of xs i))))))))

#?(:kotoba
(defn- has-item? [xs [:list [:ref :form/r]] x [:ref :form/r]] :bool
  (let [n (vector-count xs)]
    (loop [i 0]
      (if (>= i n)
        false
        (if (form/eq (typed-list-nth [:list [:ref :form/r]] xs i) x) true (recur (+ i 1))))))))

;; the sorted items of A that B does not hold
#?(:kotoba
(defn- sorted-difference [a [:ref :form/r] b [:ref :form/r]] [:list [:ref :form/r]]
  (let [items (sorted-items a)
        n (vector-count items)]
    (loop [i 0 acc (form/no-forms)]
      (if (>= i n)
        acc
        (let [x (typed-list-nth [:list [:ref :form/r]] items i)]
          (recur (+ i 1) (if (has-item? (form/kids-of b) x) acc (form/append-form acc x)))))))))


#?(:kotoba
(defn lock-schema [] :keyword :kotoba.lock/version)
   :default
(def lock-schema :kotoba.lock/version))

#?(:kotoba
nil
   :default
(defn- reject! [message data]
  (throw (ex-info message (assoc data :phase :package-lock)))))

#?(:kotoba
(defn normalize-numbers
  "The bounded reader's integers are i64 already on this route: there is no
  BigInt to narrow, so the value is the answer."
  [value [:ref :form/r]] [:ref :form/r]
  value)
   :default
(defn normalize-numbers
  "Turn the bounded reader's BigInt integers back into JS numbers.

  Amu's EDN reader is the guest-source reader, whose numeric model is
  Kotoba's: an integer literal reads as i64, which on this host is a BigInt.
  That is right for source and wrong for a lock, because
  `kotoba.lang.package-contract` is portable `.cljc` written against Clojure
  numbers and asks `(= 1 (:kotoba.lock/version m))`. `1n` is not `1`.

  Measured 2026-09-06 before this existed: a lock this CLI had just WRITTEN
  and validated was refused on the way back in with \"package lock version 1
  required\", naming a version that was, in every sense a reader of the file
  would care about, 1. Producer and consumer disagreed about nothing except
  which host type an integer lands in.

  Values outside the safe-integer range are left as BigInt rather than
  silently rounded -- a lock does not carry any, and quietly losing precision
  to make a comparison succeed is the failure this function exists to stop,
  not a smaller version of it."
  [value]
  (cond
    (host-integer/bigint? value)
    (host-integer/narrow-below-max-safe value)

    (map? value) (into (empty value)
                       (map (fn [[k v]] [(normalize-numbers k)
                                         (normalize-numbers v)]))
                       value)
    (set? value) (into (empty value) (map normalize-numbers) value)
    (vector? value) (mapv normalize-numbers value)
    (seq? value) (mapv normalize-numbers value)
    :else value)))
;; ── the package directory ────────────────────────────────────────────────────

#?(:kotoba
(defn package-dir-name
  "One path segment for a package name (`/` becomes `+`)."
  [package-name :string] :string
  (str/replace package-name "/" "+"))
   :default
(defn package-dir-name
  "One path segment for a package name. `/` is the only character package
  names carry that a path segment cannot, and `+` is not legal in a package
  name, so the mapping is injective -- two different packages cannot land in
  one directory."
  [package-name]
  (str/replace package-name "/" "+")))
#?(:kotoba
(defn dependency-root
  "Where `<packages>/` holds this dependency's tree, addressed by commit."
  [packages-dir :string dep [:ref :form/r]] :string
  (posix-path/join (posix-path/join packages-dir (package-dir-name (gs dep :dep/name)))
                   (gs dep :dep/commit)))
   :default
(defn dependency-root
  "Where `<packages>/` holds this dependency's tree. Addressed by commit, not
  by version: two locks pinning the same name at different commits coexist,
  and a re-tagged version cannot silently reuse the other's directory."
  [packages-dir dep]
  (posix-path/join (posix-path/join packages-dir (package-dir-name (:dep/name dep)))
                   (:dep/commit dep))))
#?(:kotoba
(defn- directory? [p :string] :bool (fs-tree/directory? p))
   :default
(do
(defn- stat-fields [p]
  (let [answer (fs/app-data (str p "STAT_SEP"))]
    (when (seq answer) (decimal-text/fields answer))))

(defn- directory? [p]
  (= 1 (nth (stat-fields p) 3 nil)))

(defn- exists? [p]
  (some? (stat-fields p)))))

#?(:kotoba
(defn- exists? [p :string] :bool (fs-tree/exists? p)))
;; ── provenance: is this checkout at the commit the lock names ────────────────

#?(:kotoba
(defn- git-head-sha
  "The commit a materialised dependency is actually at, or none when it is not a
  git checkout at all. process/spawn: git's stderr is this process's own."
  [dir :string] [:option :string]
  (let [request (unwrap-string (process-wire/request "git" (typed-list-new [:list :string] "-C" dir "rev-parse" "HEAD")))
        answer (process/spawn request)
        code (unwrap-i64 (process-wire/answer-exit answer))]
    (if (= 0 code)
      (option-some-of [:option :string] (str/trim (unwrap-string (process-wire/answer-out answer))))
      (option-none-of [:option :string]))))
   :default
(do
(defn- git-head-sha
  "The commit a materialised dependency is actually at, or nil when it is not
  a git checkout at all. A directory NAMED after a commit is not evidence it
  holds that commit -- the same check `kotoba.compiler.nbb.classpath` makes
  for Amu's own pinned dependencies."
  [dir]
  ;; process/spawn: git's stderr is this process's own.
  (let [answer (try (process/spawn (process-wire/request "git" ["-C" dir "rev-parse" "HEAD"]))
                    (catch :default _ nil))]
    (when (and answer (zero? (process-wire/answer-exit answer)))
      (str/trim (process-wire/answer-out answer)))))

(defn- commit-verdict
  "Three outcomes, and the third is not the second. A tree with no git
  metadata was not checked, and saying so in the report is the difference
  between `git-commit verified` and `git-commit UNVERIFIED` on the line the
  caller prints. Collapsing them would let an exported tarball read exactly
  like a checkout that matched."
  [dir dep]
  (if-let [head (git-head-sha dir)]
    (if (= head (:dep/commit dep))
      {:check :git-commit :outcome :verified :head head}
      (reject! "dependency checkout is not at the commit the lock pins"
               {:dependency (:dep/name dep)
                :pinned (:dep/commit dep) :actual head :root dir}))
    {:check :git-commit :outcome :unverified
     :reason "no git metadata in the materialised tree"}))))

#?(:kotoba
(defn- commit-verdict
  "Three outcomes, and the third is not the second (see the host body)."
  [dir :string dep [:ref :form/r]] [:ref :form/r]
  (let [found (git-head-sha dir)]
    (if (option-some?-of [:option :string] found)
      (let [head (option-value-of [:option :string] found "")]
        (if (string=? head (gs dep :dep/commit))
          (form/form-map (typed-list-new [:list [:ref :form/r]]
                                         (kf :check) (kf :git-commit) (kf :outcome) (kf :verified)
                                         (kf :head) (form/string-form head)))
          (throw (ex-info "dependency checkout is not at the commit the lock pins"
                          {:phase :package-lock :dependency (gs dep :dep/name)
                           :pinned (gs dep :dep/commit) :actual head :root dir}))))
      (form/form-map (typed-list-new [:list [:ref :form/r]]
                                     (kf :check) (kf :git-commit) (kf :outcome) (kf :unverified)
                                     (kf :reason) (form/string-form "no git metadata in the materialised tree")))))))
;; ── development-only shapes the lock must not carry ─────────────────────────

#?(:kotoba
(defn- local-root-key [i :i64] :keyword
  (cond (= i 0) :package/local-root
        (= i 1) :dep/local-root
        (= i 2) :dep/local-path
        (= i 3) :dep/path
        :else :dep/root))
   :default
(do
(def ^:private local-root-keys
  [:package/local-root :dep/local-root :dep/local-path :dep/path :dep/root])

(defn- local-path-error
  "`docs/lang/package-rules.md`: \"Local path dependencies are development-only
  unless the same content is locked by tree CID before safe-build.\" A lock
  reaching a compiler is past that point.

  Mirrors `kotoba.security.package-admission/local-path-error`, which is
  `.clj` and therefore unreachable from this route."
  [dep]
  (when-let [k (some #(when (contains? dep %) %) local-root-keys)]
    (reject! "local-path dependency not allowed in a consumed lock"
             {:dependency (:dep/name dep) :field k :value (get dep k)})))))

#?(:kotoba
(defn- local-root-found [dep [:ref :form/r] i :i64] :i64
  (cond (> i 4) -1
        (form/form-has? dep (kf (local-root-key i))) i
        :else (local-root-found dep (+ i 1)))))

#?(:kotoba
(defn- local-path-error
  "A lock reaching a compiler is past the development-only stage: a local-path
  dependency is refused. Answers 0 when there is none."
  [dep [:ref :form/r]] :i64
  (let [at (if (form/is-map? dep) (local-root-found dep 0) -1)]
    (if (>= at 0)
      (throw (ex-info "local-path dependency not allowed in a consumed lock"
                      {:phase :package-lock :dependency (gs dep :dep/name)
                       :field (local-root-key at)}))
      0))))
#?(:kotoba
(defn tree-serialization [] :keyword :kotoba.package-tree/v1)
   :default
(def tree-serialization :kotoba.package-tree/v1))

#?(:kotoba
(defn manifest-file-name [] :string "package-manifest.edn")
   :default
(def manifest-file-name "package-manifest.edn"))

#?(:kotoba
(defn- ignored-tree-entry? [name :string] :bool
  (or (string=? name ".git") (string=? name "node_modules") (string=? name ".DS_Store")
      (string=? name (manifest-file-name))))
   :default
(do
(def ^:private ignored-tree-entries
  ;; `package-manifest.edn` is EXCLUDED for the same reason a manifest's
  ;; `:manifest-cid` is excluded from its own hash: it is a statement ABOUT
  ;; this tree, written into it, and its own `:tree-cid` field is one of the
  ;; things it states. Including it makes the fixed point unreachable --
  ;; measured 2026-09-06, the first generated manifest hashed the tree, was
  ;; written into that tree, and the consumer then refused it with `tree cid
  ;; does not match tree content` against a manifest that had been correct one
  ;; file-write earlier.
  ;;
  ;; Nothing is left uncovered by the exclusion: the manifest's own bytes are
  ;; pinned by `:manifest-cid`, which the signature is over and
  ;; `manifest-integrity-error` recomputes.
  ;;
  ;; `.git` is excluded because it is not the package -- two checkouts of the
  ;; same commit differ inside it (packed vs loose objects, reflogs, remote
  ;; names), so a tree hash covering it would never match twice.
  #{".git" "node_modules" ".DS_Store" manifest-file-name})

(defn- tree-files
  "Every regular file under ROOT, as repository-relative POSIX paths, sorted.

  What is skipped, and why, is `ignored-tree-entries`."
  ([root] (vec (sort (tree-files root ""))))
  ([root prefix]
   (let [dir (if (str/blank? prefix) root (posix-path/join root prefix))
         listing (fs/browse dir)]
     (mapcat
      (fn [line]
        (let [name (first (str/split line "\t"))
              rel (if (str/blank? prefix) name (str prefix "/" name))
              kind (let [answer (fs/app-data (str dir "/" name "NOFOLLOW_SEP"))]
                     (when (seq answer) (nth (decimal-text/fields answer) 3)))]
          (cond
            (contains? ignored-tree-entries name) nil
            (= 1 kind) (tree-files root rel)
            (= 0 kind) [rel]
            :else nil)))
      (if (= "" listing) [] (str/split listing "\n"))))))))

#?(:kotoba
(defn- tree-names [root :string prefix :string acc [:set :string]] [:set :string]
  (let [dir (if (str/blank? prefix) root (posix-path/join root prefix))]
    (tree-members root prefix dir (fs-tree/entries dir) 0 acc))))

#?(:kotoba
(defn- tree-members [root :string prefix :string dir :string names [:list :string] i :i64 acc [:set :string]] [:set :string]
  (if (>= i (vector-count names))
    acc
    (let [name (typed-list-nth [:list :string] names i)
          rel (if (str/blank? prefix) name (str prefix "/" name))
          kind (option-value-of [:option :i64] (fs-tree/kind (str dir "/" name)) -1)
          next (cond
                 (ignored-tree-entry? name) acc
                 (= 1 kind) (tree-names root rel acc)
                 (= 0 kind) (conj acc rel)
                 :else acc)]
      (tree-members root prefix dir names (+ i 1) next)))))
#?(:kotoba
(defn- file-digest-hex [path :string] :string
  (kbytes/hex (mf/sha256 (vector-i64-from-bytes (fs/app-data-bytes path)))))
   :default
(defn tree-bytes
  "The bytes `:tree-cid` is the CIDv1-raw of, for a package tree on disk.

  `kotoba.lang.package-contract/tree-cid-error` takes tree bytes from its
  caller and says why in its own docstring: a source tree is not part of the
  data that kernel receives, so it cannot define what hashing one means. This
  is that definition, and it lives here because this is the layer that has a
  filesystem.

  The serialization is a sorted listing of `<relative path>\t<sha256 hex>`,
  one per line, UTF-8. Deliberately NOT a tar or a zip: those carry mtimes,
  uids, and ordering that differ between two materialisations of the same
  content, so hashing one would answer \"was this archive built the same
  way\" rather than \"is this the same code\". Sorting is by the path bytes,
  so it does not depend on a locale.

  Versioned by `tree-serialization`: if this ever changes, tree CIDs computed
  under the old rule stop matching, and that must be a visible break rather
  than a silent one."
  [root]
  (let [lines (mapv (fn [rel]
                      (let [digest (hash/sha256 (fs/app-data-bytes (posix-path/join root rel)))]
                        (str rel "\t" digest)))
                    (tree-files root))]
    (when (empty? lines)
      (reject! "package tree is empty" {:root root}))
    (text-bytes/utf8-bytes (str/join "\n" lines)))))

#?(:kotoba
(defn- tree-lines [root :string files [:set :string] i :i64 acc [:list :string]] [:list :string]
  (if (>= i (count files))
    acc
    (let [rel (typed-set-nth [:set :string] files i)
          digest (file-digest-hex (posix-path/join root rel))]
      (tree-lines root files (+ i 1) (conj acc (str rel "\t" digest)))))))

#?(:kotoba
(defn tree-bytes
  "The bytes `:tree-cid` is the CIDv1-raw of, for a package tree on disk: a
  sorted listing of `<relative path>\t<sha256 hex>`, one per line, UTF-8, as
  the vector of its bytes (`tree-serialization` versions the rule)."
  [root :string] :vector-i64
  (let [files (tree-names root "" (typed-set-new [:set :string]))
        lines (tree-lines root files 0 (typed-list-new [:list :string]))]
    (if (= 0 (vector-count lines))
      (throw (ex-info "package tree is empty" {:phase :package-lock :root root}))
      (kbytes/utf8-encode (str/join "\n" lines))))))
#?(:kotoba
(defn- read-manifest
  [root :string dep [:ref :form/r]] [:ref :form/r]
  (let [path (posix-path/join root (manifest-file-name))]
    (if (not (exists? path))
      (throw (ex-info "dependency tree carries no package manifest"
                      {:phase :package-lock :dependency (gs dep :dep/name) :expected path}))
      (let [manifest (unwrap-form (support/read-edn-file! path))]
        (normalize-numbers manifest)))))
   :default
(defn- read-manifest! [root dep]
  (let [path (posix-path/join root manifest-file-name)]
    (when-not (exists? path)
      (reject! "dependency tree carries no package manifest"
               {:dependency (:dep/name dep) :expected path
                :note (str "the lock names signers for this dependency; "
                           "without the manifest they signed, nothing binds "
                           "those DIDs to this code")}))
    (try
      (normalize-numbers (support/read-edn-file! path))
      (catch :default e
        (reject! "package manifest does not read as EDN"
                 {:dependency (:dep/name dep) :path path
                  :error (.-message e)}))))))
#?(:kotoba
(defn- signature-dids [manifest [:ref :form/r]] [:ref :form/r]
  (let [sigs (gk manifest :kotoba.package/signatures)
        n (form/count-of sigs)]
    (form/form-vec
     (loop [i 0 acc (form/no-forms)]
       (if (>= i n)
         acc
         (let [d (gk (form/nth-of sigs i) :did)]
           (recur (+ i 1) (if (form/is-nil? d) acc (form/append-form acc d)))))))))
   :default
(defn- manifest-verdicts!
  "Bind the lock entry to the manifest the signers actually signed.

  Four checks, and they are four because each is unbinding on its own:

    package-manifest-error   shape, and a REAL Ed25519 signature -- but over
                             the manifest's own self-declared cid
    manifest-integrity-error that self-declared cid is what the content
                             hashes to. Without this, every field except the
                             cid can be edited after signing
    identity                 the manifest is this package at this version.
                             A valid, self-consistent manifest for a
                             DIFFERENT package is still a valid manifest
    signers / capabilities   the DIDs the lock claims actually appear among
                             the manifest's signatures, and the grant does
                             not exceed what the package declares it may
                             request

  Both contract functions are portable as of kotoba-core-contracts 2ebe7461;
  before that they were `:clj`-only and this whole sequence was unreachable
  from a Node compiler."
  [manifest dep]
  (when-let [e (contract/package-manifest-error manifest)]
    (reject! (str "package manifest rejected: " (:message e))
             (assoc (:data e) :dependency (:dep/name dep))))
  (when-let [e (contract/manifest-integrity-error manifest)]
    (reject! (str "package manifest rejected: " (:message e))
             (assoc (:data e) :dependency (:dep/name dep))))
  (when-not (= (:kotoba.package/name manifest) (:dep/name dep))
    (reject! "package manifest is for a different package"
             {:dependency (:dep/name dep)
              :manifest-name (:kotoba.package/name manifest)}))
  (when-not (= (:kotoba.package/version manifest) (:dep/version dep))
    (reject! "package manifest is for a different version"
             {:dependency (:dep/name dep)
              :locked (:dep/version dep)
              :manifest-version (:kotoba.package/version manifest)}))
  (let [declared-cid (get-in manifest [:kotoba.package/source :manifest-cid])]
    (when-not (= declared-cid (:dep/manifest-cid dep))
      (reject! "manifest cid in the lock is not this manifest's cid"
               {:dependency (:dep/name dep)
                :locked (:dep/manifest-cid dep)
                :manifest declared-cid})))
  (let [signed-by (set (map :did (:kotoba.package/signatures manifest)))
        claimed (set (:dep/signers dep))]
    (when-let [absent (seq (coll/set-difference claimed signed-by))]
      (reject! "the lock names signers who did not sign this manifest"
               {:dependency (:dep/name dep) :missing (vec (sort absent))})))
  (let [requested (set (:kotoba.package/capabilities manifest))
        granted (set (:dep/capabilities dep))]
    (when-let [over (seq (coll/set-difference granted requested))]
      (reject! "lock grants capabilities the package does not declare"
               {:dependency (:dep/name dep) :granted (vec (sort over))
                :declared (vec (sort requested))})))
  [{:check :manifest-signature :outcome :verified
    :signers (vec (sort (map :did (:kotoba.package/signatures manifest))))}
   {:check :manifest-integrity :outcome :verified
    :manifest-cid (:dep/manifest-cid dep)}]))

#?(:kotoba
(defn- manifest-verdicts-rest [manifest [:ref :form/r] dep [:ref :form/r]] [:ref :form/r]
  (let [dname (gs dep :dep/name)]
    (if (not (form/eq (gk manifest :kotoba.package/name) (gk dep :dep/name)))
      (throw (ex-info "package manifest is for a different package"
                      {:phase :package-lock :dependency dname :manifest-name (gs manifest :kotoba.package/name)}))
      (if (not (form/eq (gk manifest :kotoba.package/version) (gk dep :dep/version)))
        (throw (ex-info "package manifest is for a different version"
                        {:phase :package-lock :dependency dname :locked (gs dep :dep/version)
                         :manifest-version (gs manifest :kotoba.package/version)}))
        (let [declared-cid (gk (gk manifest :kotoba.package/source) :manifest-cid)]
          (if (not (form/eq declared-cid (gk dep :dep/manifest-cid)))
            (throw (ex-info "manifest cid in the lock is not this manifest's cid"
                            {:phase :package-lock :dependency dname :locked (gs dep :dep/manifest-cid)}))
            (let [signed-by (signature-dids manifest)
                  absent (sorted-difference (gk dep :dep/signers) signed-by)]
              (if (> (vector-count absent) 0)
                (throw (ex-info "the lock names signers who did not sign this manifest"
                                {:phase :package-lock :dependency dname}))
                (let [over (sorted-difference (gk dep :dep/capabilities)
                                              (gk manifest :kotoba.package/capabilities))]
                  (if (> (vector-count over) 0)
                    (throw (ex-info "lock grants capabilities the package does not declare"
                                    {:phase :package-lock :dependency dname}))
                    (form/form-vec
                     (typed-list-new [:list [:ref :form/r]]
                                     (map3 :check (kf :manifest-signature) :outcome (kf :verified)
                                           :signers (form/form-vec (sorted-items signed-by)))
                                     (map3 :check (kf :manifest-integrity) :outcome (kf :verified)
                                           :manifest-cid (gk dep :dep/manifest-cid)))))))))))))))

#?(:kotoba
(defn- manifest-verdicts
  "Bind the lock entry to the manifest the signers actually signed (shape and a
  real Ed25519 signature, the cid the content hashes to, identity, signers and
  capabilities)."
  [manifest [:ref :form/r] dep [:ref :form/r]] [:ref :form/r]
  (let [dname (gs dep :dep/name)
        e1 (contract/package-manifest-error manifest)]
    (if (not (form/is-nil? e1))
      (throw (ex-info (str "package manifest rejected: " (message-of e1))
                      {:phase :package-lock :dependency dname}))
      (let [e2 (contract/manifest-integrity-error manifest)]
        (if (not (form/is-nil? e2))
          (throw (ex-info (str "package manifest rejected: " (message-of e2))
                          {:phase :package-lock :dependency dname}))
          (manifest-verdicts-rest manifest dep)))))))
;; ── the source roots a dependency contributes ───────────────────────────────

#?(:kotoba
(defn- dependency-source-roots
  "`<root>/src` when it exists, else `<root>`."
  [root :string] [:ref :form/r]
  (let [src (posix-path/join root "src")]
    (if (directory? src)
      (form/form-vec (form/one-form (form/string-form src)))
      (form/form-vec (form/one-form (form/string-form root))))))
   :default
(do
(def ^:private default-source-subdirs ["src"])

(defn- dependency-source-roots
  "`<root>/src` when it exists, else `<root>`. A package that keeps its
  modules at the top of its tree is not malformed, and a package that uses
  `src/` must not also expose its `test/` or `scripts/` to the consumer's
  namespace search -- two modules claiming one namespace is an error the
  linker raises, and it should not be reachable by depending on a package
  that happens to have a test fixture with a colliding name."
  [root]
  (let [subdirs (filterv #(directory? (posix-path/join root %))
                         default-source-subdirs)]
    (if (seq subdirs)
      (mapv #(posix-path/join root %) subdirs)
      [root])))))
;; ── the trust context the contract validates against ────────────────────────

#?(:kotoba
(defn- honoured-trust-key? [k [:ref :form/r]] :bool
  (or (form/eq k (kf :declared-capabilities)) (form/eq k (kf :revoked-signers))
      (form/eq k (kf :expired-signers)) (form/eq k (kf :compromised-signers))))
   :default
(do
(def ^:private honoured-trust-keys
  #{:declared-capabilities :revoked-signers :expired-signers :compromised-signers})

(def ^:private known-unhonoured-trust-keys
  "Keys `kotoba.security.package-admission/trust-context` acts on and this one
  does not. Named rather than lumped in with typos, so the refusal can say
  which behaviour is missing instead of only that something is."
  {:key-register (str "a key register maps signer DIDs to statuses, and blocked "
                      "statuses are merged into the revoked set. Not implemented "
                      "here: expand it into :revoked-signers before passing the "
                      "trust file to this route")
   :keys (str "an inline key register. Same as :key-register -- expand it into "
              ":revoked-signers")})

(defn trust-context
  "What the caller grants and whom it no longer trusts, as
  `kotoba.lang.package-contract/lockfile-error` wants it.

  The file shape is `kotoba.security.package-admission`'s: `:declared-capabilities`,
  `:revoked-signers`, `:expired-signers`, `:compromised-signers`. Deliberately
  the same file, so one trust document serves both routes.

  TWO DIFFERENCES, both stated because a trust file that behaves differently
  depending on which tool reads it is worse than two file formats:

  1. A key that this route does not act on is REFUSED, not ignored. The JVM
     route honours `:key-register` / `:keys`, folding blocked statuses into the
     revoked set; this one does not. Ignoring such a file would apply a
     STRICTLY WEAKER check while looking like it had applied the caller's --
     the trust document would name revoked signers and the build would accept
     them.

  2. Absent `:declared-capabilities`, this route grants NOTHING, where the JVM
     route falls back to the manifest's own declared capabilities. That is not
     a gap: `manifest-verdicts!` already checks the grant against the
     manifest's declaration, so folding the same comparison in here would
     answer one question twice and leave the caller's own ceiling unasked.
     The ADR's rule -- dependencies receive no host capability by default --
     is expressed as the default rather than as prose."
  [trust]
  (when trust
    (doseq [[k why] known-unhonoured-trust-keys]
      (when (contains? trust k)
        (reject! (str "this route does not honour " k " in a trust file")
                 {:key k :reason why})))
    (when-let [unknown (seq (remove honoured-trust-keys (keys trust)))]
      (reject! "unrecognised keys in the trust file"
               {:keys (vec (sort unknown))
                :honoured (vec (sort honoured-trust-keys))
                :reason (str "a misspelled key would otherwise be silently "
                             "empty, which reads exactly like a caller that "
                             "granted nothing")})))
  {:declared-capabilities (vec (:declared-capabilities trust))
   :revoked-signers (vec (:revoked-signers trust))
   :expired-signers (vec (:expired-signers trust))
   :compromised-signers (vec (:compromised-signers trust))})))

#?(:kotoba
(defn- first-unknown-key [trust [:ref :form/r] i :i64] [:ref :form/r]
  (let [ks (form/kids-of trust)]
    (cond (>= i (vector-count ks)) (form/nil-form)
          (honoured-trust-key? (typed-list-nth [:list [:ref :form/r]] ks i)) (first-unknown-key trust (+ i 2))
          :else (typed-list-nth [:list [:ref :form/r]] ks i)))))

#?(:kotoba
(defn- vec-of [trust [:ref :form/r] k :keyword] [:ref :form/r]
  (let [v (gk trust k)]
    (form/form-vec (if (form/is-nil? v) (form/no-forms) (form/kids-of v))))))

#?(:kotoba
(defn trust-context
  "What the caller grants and whom it no longer trusts, as
  `kotoba.lang.package-contract/lockfile-error` wants it. A key this route does
  not act on is REFUSED, not ignored; absent `:declared-capabilities` this route
  grants nothing. (A nil trust is the nil Form.)"
  [trust [:ref :form/r]] [:ref :form/r]
  (cond
    (and (form/is-map? trust) (form/form-has? trust (kf :key-register)))
    (throw (ex-info "this route does not honour :key-register in a trust file" {:phase :package-lock}))
    (and (form/is-map? trust) (form/form-has? trust (kf :keys)))
    (throw (ex-info "this route does not honour :keys in a trust file" {:phase :package-lock}))
    (and (form/is-map? trust) (not (form/is-nil? (first-unknown-key trust 0))))
    (throw (ex-info "unrecognised keys in the trust file" {:phase :package-lock}))
    :else
    (form/form-map (typed-list-new [:list [:ref :form/r]]
                                   (kf :declared-capabilities) (vec-of trust :declared-capabilities)
                                   (kf :revoked-signers) (vec-of trust :revoked-signers)
                                   (kf :expired-signers) (vec-of trust :expired-signers)
                                   (kf :compromised-signers) (vec-of trust :compromised-signers))))))
#?(:kotoba
(defn- tree-verdict
  "The materialised tree hashes to the `:dep/tree-cid` the lock pins."
  [root :string dep [:ref :form/r]] [:ref :form/r]
  (let [bytes (tree-bytes root)
        e (contract/tree-cid-error (gk dep :dep/tree-cid) (option-some-of [:option :vector-i64] bytes))]
    (if (not (form/is-nil? e))
      (throw (ex-info (str "package tree rejected: " (message-of e))
                      {:phase :package-lock :dependency (gs dep :dep/name) :root root}))
      (form/form-map (typed-list-new [:list [:ref :form/r]]
                                     (kf :check) (kf :tree-cid) (kf :outcome) (kf :verified)
                                     (kf :serialization) (kf (tree-serialization))
                                     (kf :tree-cid) (gk dep :dep/tree-cid))))))
   :default
(defn- tree-verdict!
  "The materialised tree hashes to the `:dep/tree-cid` the lock pins.

  This is the check that makes `--packages` safe to point at a directory
  somebody else populated. Without it the only thing tying the tree to the
  lock is its path."
  [root dep]
  (if-let [e (contract/tree-cid-error (:dep/tree-cid dep) (tree-bytes root))]
    (reject! (str "package tree rejected: " (:message e))
             (assoc (:data e) :dependency (:dep/name dep) :root root
                    :serialization tree-serialization))
    {:check :tree-cid :outcome :verified
     :serialization tree-serialization
     :tree-cid (:dep/tree-cid dep)})))
;; ── resolution ──────────────────────────────────────────────────────────────

#?(:kotoba
(defn- validate-lock [lock [:ref :form/r] trust [:ref :form/r]] :i64
  (let [version (gk lock :kotoba.lock/version)]
    (if (not (form/eq version (form/int-form 1)))
      (throw (ex-info "package lock version 1 required" {:phase :package-lock}))
      (let [tc (trust-context trust)
            error (contract/lockfile-error lock tc (form/form-map (form/no-forms)))]
        (if (not (form/is-nil? error))
          (throw (ex-info (message-of error) {:phase :package-lock :contract true}))
          0)))))
   :default
(do
(defn- validate-lock! [lock trust]
  (when-not (= 1 (:kotoba.lock/version lock))
    (reject! "package lock version 1 required"
             {:value (:kotoba.lock/version lock)}))
  (when-let [error (contract/lockfile-error lock (trust-context trust))]
    (reject! (:message error) (assoc (:data error) :contract true))))

(defn- definition-cids! [dep]
  (let [cids (:dep/definition-cids dep)]
    (when-not (and (vector? cids) (seq cids))
      (reject! (str "dependency does not pin its definitions, so the "
                    "materialised tree cannot be checked against the lock")
               {:dependency (:dep/name dep)
                :field :dep/definition-cids
                :remedy (str "amu definition-cids <entry> --source-path <dir> "
                             "-- add the CIDs it prints to this dep entry")}))
    (set cids)))

(defn resolve-lock
  "LOCK-PATH and PACKAGES-DIR to `{:source-paths [...] :dependencies [...]}`.

  Every dependency is refused rather than skipped: a lock this route cannot
  satisfy must not produce a shorter source path, because a shorter source
  path fails later as `namespace not found`, which reads like the guest's
  mistake."
  [lock-path packages-dir trust]
  (when-not (exists? lock-path)
    (reject! "package lock not found" {:path lock-path}))
  (when-not (directory? packages-dir)
    (reject! "--packages must name an existing directory" {:path packages-dir}))
  ;; Same bounded reader the module lock and `--policy` get. A lock arrives
  ;; from the caller and is supposed to make a build MORE constrained, so it
  ;; must not be the one input read without limits.
  (let [lock (try (normalize-numbers (support/read-edn-file! lock-path))
                  (catch :default e
                    (reject! "package lock does not read as EDN"
                             {:path lock-path :error (.-message e)})))
        _ (validate-lock! lock trust)
        deps (:deps lock)]
    (let [resolved
          (mapv (fn [dep]
                  (local-path-error dep)
                  (let [root (dependency-root packages-dir dep)]
                    (when-not (directory? root)
                      (reject! "dependency tree is not materialised"
                               {:dependency (:dep/name dep)
                                :commit (:dep/commit dep)
                                :expected root
                                :remedy (str "amu package-fetch --lock "
                                             lock-path " --packages "
                                             packages-dir)}))
                    {:name (:dep/name dep)
                     :version (:dep/version dep)
                     :commit (:dep/commit dep)
                     :signers (vec (:dep/signers dep))
                     :capabilities (vec (:dep/capabilities dep))
                     :definition-cids (definition-cids! dep)
                     :root root
                     :source-paths (dependency-source-roots root)
                     :checks (into [(commit-verdict root dep)
                                    (tree-verdict! root dep)]
                                   (manifest-verdicts! (read-manifest! root dep)
                                                       dep))}))
                deps)]
      {:lock lock-path
       :packages packages-dir
       :dependencies resolved
       :source-paths (into [] (mapcat :source-paths) resolved)})))))

#?(:kotoba
(defn- definition-cids [dep [:ref :form/r]] [:ref :form/r]
  (let [cids (gk dep :dep/definition-cids)]
    (if (and (form/is-vec? cids) (> (form/count-of cids) 0))
      (form/form-set (sorted-items cids))
      (throw (ex-info "dependency does not pin its definitions, so the materialised tree cannot be checked against the lock"
                      {:phase :package-lock :dependency (gs dep :dep/name) :field :dep/definition-cids}))))))

#?(:kotoba
(defn- resolve-dep [dep [:ref :form/r] lock-path :string packages-dir :string] [:ref :form/r]
  (let [_ (local-path-error dep)
        root (dependency-root packages-dir dep)]
    (if (not (directory? root))
      (throw (ex-info "dependency tree is not materialised"
                      {:phase :package-lock :dependency (gs dep :dep/name) :commit (gs dep :dep/commit)
                       :expected root}))
      (let [cids (definition-cids dep)
            roots (dependency-source-roots root)
            commit-check (commit-verdict root dep)
            tree-check (tree-verdict root dep)
            manifest (read-manifest root dep)
            manifest-checks (manifest-verdicts manifest dep)]
        (form/form-map
         (typed-list-new [:list [:ref :form/r]]
                         (kf :name) (gk dep :dep/name)
                         (kf :version) (gk dep :dep/version)
                         (kf :commit) (gk dep :dep/commit)
                         (kf :signers) (gk dep :dep/signers)
                         (kf :capabilities) (gk dep :dep/capabilities)
                         (kf :definition-cids) cids
                         (kf :root) (form/string-form root)
                         (kf :source-paths) roots
                         (kf :checks) (form/form-vec
                                       (form/append-many
                                        (typed-list-new [:list [:ref :form/r]] commit-check tree-check)
                                        (form/kids-of manifest-checks))))))))))

#?(:kotoba
(defn- resolve-deps [deps [:ref :form/r] i :i64 lock-path :string packages-dir :string acc [:list [:ref :form/r]]]
  [:list [:ref :form/r]]
  (if (>= i (form/count-of deps))
    acc
    (let [r (resolve-dep (form/nth-of deps i) lock-path packages-dir)]
      (resolve-deps deps (+ i 1) lock-path packages-dir (form/append-form acc r))))))

#?(:kotoba
(defn- all-source-paths [resolved [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (vector-count resolved))
    acc
    (all-source-paths resolved (+ i 1)
                      (form/append-many acc (form/kids-of (gk (typed-list-nth [:list [:ref :form/r]] resolved i) :source-paths)))))))

#?(:kotoba
(defn resolve-lock
  "LOCK-PATH and PACKAGES-DIR to `{:lock :packages :dependencies :source-paths}`.
  Every dependency is refused rather than skipped."
  [lock-path :string packages-dir :string trust [:ref :form/r]] [:ref :form/r]
  (cond
    (not (exists? lock-path)) (throw (ex-info "package lock not found" {:phase :package-lock :path lock-path}))
    (not (directory? packages-dir)) (throw (ex-info "--packages must name an existing directory" {:phase :package-lock :path packages-dir}))
    :else
    (let [raw (unwrap-form (support/read-edn-file! lock-path))
          lock (normalize-numbers raw)
          _ (validate-lock lock trust)
          resolved (resolve-deps (gk lock :deps) 0 lock-path packages-dir (form/no-forms))]
      (form/form-map
       (typed-list-new [:list [:ref :form/r]]
                       (kf :lock) (form/string-form lock-path)
                       (kf :packages) (form/string-form packages-dir)
                       (kf :dependencies) (form/form-vec resolved)
                       (kf :source-paths) (form/form-vec (all-source-paths resolved 0 (form/no-forms)))))))))
;; ── the check that binds the tree to the lock ───────────────────────────────

#?(:kotoba
(defn- missing-for [dep [:ref :form/r] have [:ref :form/r]] [:list [:ref :form/r]]
  (sorted-difference (gk dep :definition-cids) have))
   :default
(defn verify-definitions
  "Every definition CID the lock pins must be present in the CIDs the
  compiler computed for the linked project.

  This is the step that makes the lock mean something. Definition CIDs are
  context-independent -- measured 2026-09-06: `double-it` hashes to
  `bafyreihmm4hh…` compiled alone and again as a dependency of another
  module -- so a CID the lock names either appears in the built graph or the
  bytes are not the bytes that were signed.

  Superset, not equality: the consumer's own definitions are in COMPUTED too,
  and a package may export more than a given consumer binds."
  [dependencies computed]
  (let [have (set computed)
        missing (keep (fn [dep]
                        (let [gone (coll/set-difference (:definition-cids dep) have)]
                          (when (seq gone)
                            {:dependency (:name dep)
                             :missing (vec (sort gone))})))
                      dependencies)]
    (if (seq missing)
      (reject! "definitions the package lock pins are not in the built graph"
               {:dependencies (vec missing)
                :note (str "the materialised tree does not contain the code "
                           "this lock was signed over")})
      {:check :definition-cids
       :outcome :verified
       :pinned (reduce + 0 (map #(count (:definition-cids %)) dependencies))
       :computed (count have)}))))

#?(:kotoba
(defn- first-missing [dependencies [:ref :form/r] i :i64 have [:ref :form/r]] :i64
  (cond (>= i (form/count-of dependencies)) -1
        (> (vector-count (missing-for (form/nth-of dependencies i) have)) 0) i
        :else (first-missing dependencies (+ i 1) have))))

#?(:kotoba
(defn- pinned-count [dependencies [:ref :form/r] i :i64 acc :i64] :i64
  (if (>= i (form/count-of dependencies))
    acc
    (pinned-count dependencies (+ i 1) (+ acc (form/count-of (gk (form/nth-of dependencies i) :definition-cids)))))))

#?(:kotoba
(defn verify-definitions
  "Every definition CID the lock pins must be present in the CIDs the compiler
  computed for the linked project (superset, not equality). DEPENDENCIES is the
  `:dependencies` of `resolve-lock`; COMPUTED a Form list of CID strings."
  [dependencies [:ref :form/r] computed [:ref :form/r]] [:ref :form/r]
  (let [have (form/form-vec (sorted-items computed))
        bad (first-missing dependencies 0 have)]
    (if (>= bad 0)
      (throw (ex-info "definitions the package lock pins are not in the built graph"
                      {:phase :package-lock
                       :dependency (gs (form/nth-of dependencies bad) :name)}))
      (let [pinned (pinned-count dependencies 0 0)
            computed-count (form/count-of have)]
        (form/form-map (typed-list-new [:list [:ref :form/r]]
                                       (kf :check) (kf :definition-cids) (kf :outcome) (kf :verified)
                                       (kf :pinned) (form/int-form pinned)
                                       (kf :computed) (form/int-form computed-count))))))))
#?(:kotoba
(defn- report-entry [d [:ref :form/r]] [:ref :form/r]
  (form/form-map (typed-list-new [:list [:ref :form/r]]
                                 (kf :name) (gk d :name) (kf :version) (gk d :version)
                                 (kf :commit) (gk d :commit) (kf :signers) (gk d :signers)
                                 (kf :capabilities) (gk d :capabilities)
                                 (kf :definitions) (form/int-form (form/count-of (gk d :definition-cids)))
                                 (kf :checks) (gk d :checks))))
   :default
(defn report
  "What was checked, per dependency, in the command's own answer. A caller
  reading only `:ok true` cannot tell a verified commit from an unverifiable
  one; this makes the difference printable."
  [resolved definition-check]
  {:kotoba.package-lock/version 1
   :lock (:lock resolved)
   :packages (:packages resolved)
   :dependencies (mapv (fn [d]
                         {:name (:name d) :version (:version d)
                          :commit (:commit d)
                          :signers (:signers d)
                          :capabilities (:capabilities d)
                          :definitions (count (:definition-cids d))
                          :checks (:checks d)})
                       (:dependencies resolved))
   :definition-check definition-check
   :scanned (str "SCANNED\t" (count (:dependencies resolved)) " dependencies")}))

#?(:kotoba
(defn- report-entries [ds [:ref :form/r] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
  (if (>= i (form/count-of ds))
    acc
    (report-entries ds (+ i 1) (form/append-form acc (report-entry (form/nth-of ds i)))))))

#?(:kotoba
(defn report
  "What was checked, per dependency, in the command's own answer."
  [resolved [:ref :form/r] definition-check [:ref :form/r]] [:ref :form/r]
  (let [deps (gk resolved :dependencies)
        n (form/count-of deps)]
    (form/form-map
     (typed-list-new [:list [:ref :form/r]]
                     (kf :kotoba.package-lock/version) (form/int-form 1)
                     (kf :lock) (gk resolved :lock)
                     (kf :packages) (gk resolved :packages)
                     (kf :dependencies) (form/form-vec (report-entries deps 0 (form/no-forms)))
                     (kf :definition-check) definition-check
                     (kf :scanned) (form/string-form (str "SCANNED\t" (string-from-i64 n) " dependencies")))))))
