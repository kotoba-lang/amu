(ns kotoba.compiler.nbb.cli-support
  "Shared, backend-free support for the split nbb compiler entrypoints.

  Keeping policy decoding and the CLI error contract here is important: the
  Wasm/native split may reduce namespace load time, but must not create two
  subtly different admission boundaries."
  {:kotoba/export #?(:kotoba [capability-policy command-line-args emit-metadata error-phase execute! exit-code oracle-fuel option options parse-policy-material read-artifact-file! read-edn-file! read-policy read-policy-material refusal-text serve! source! timed usage-error!] :default [analyze-options capability-policy command-line-args emit-metadata execute! invoke option options oracle-fuel parse-policy-material read-artifact-file! read-artifact-text! read-edn-file! read-policy read-policy-material refusal serve! source! timed usage-error!])}
  (:require [kotoba.compiler.diagnostic :as diagnostic]
            [kotoba.compiler.kotoba-reader :as kr]
            [kotoba.compiler.posix-path :as posix-path]
            [kotoba.compiler.text-bytes :as text-bytes]
            [kotoba.compiler.host-integer :as host-integer]
            #?(:kotoba [kotoba.compiler.decimal-text :as decimal-text])
            #?(:kotoba [kotoba.compiler.bounded-edn :as bounded-edn])
            #?(:kotoba [kotoba.form :as form])
            [kotoba.compiler.json-text :as json-text]
            [kotoba.compiler.nbb.io :as nbb-io]
            [kotoba.compiler.source-path :as source-path]
            ;; Abilities (superproject adr-2609242330 S5). Under Kotoba
            ;; `env/read`, `clock/now`, `cli/args`, `io/write` and
            ;; `io/write-error` are catalog operations (wires 33, 7, 38, 37,
            ;; 39) whose handlers come from the target profile; under nbb
            ;; these aliases name the mechanism-layer handlers, the only
            ;; place a host module is required by string.
            #?(:cljs [kotoba.compiler.nbb.host.cli :as cli])
            #?(:cljs [kotoba.compiler.nbb.host.clock :as clock])
            #?(:cljs [kotoba.compiler.nbb.host.env :as env])
            #?(:cljs [kotoba.compiler.nbb.host.io :as io])
            ;; Not an ability: loading, the event loop and handing the exit
            ;; status to the OS (adr-2609242330 section 1 (c)(2)).
            #?(:cljs [kotoba.compiler.nbb.host.entry :as host-entry]))
  ;; Kotoba: an EDN value is the recursive `:form/r` record (kotoba.form), the
  ;; same schema `kotoba.compiler.bounded-edn` answers with.
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

;; Opt-in phase timings go to stderr behind a stable marker. Normal stdout and
;; artifact bytes remain unchanged.
;;
;; Under Kotoba a def value cannot perform a capability call and module state
;; is absent, so the flag is a function of the environment and the timing
;; state does not exist: `timed` runs its thunk, and the timing helpers have no Kotoba reading
;; (only the host `execute!` reads them). One arity and one type per name: the
;; Kotoba thunk answers a Form, the dynamic value every phase of the route has.
;; A thunk that can abort cannot be a fn literal on Kotoba (E2135), so a phase
;; whose body can refuse calls the body directly instead of through `timed`.
#?(:kotoba nil
   :default
   (defn- timing-enabled? []
     (= "1" (env/read "KOTOBA_COMPILER_TIMING"))))

;; The monotonic clock in milliseconds. clock/now answers nanoseconds as
;; decimal text; phases are differences of two readings, so the clock's
;; origin does not matter (performance.now's did not either).
#?(:kotoba nil
   :default
   (defn- monotonic-ms []
     (/ (parse-double (clock/now "monotonic")) 1000000)))

#?(:kotoba nil
   :default
   (do
     (def ^:private timing-origin-ms (volatile! (monotonic-ms)))
     (def ^:private timing-phases (volatile! []))
     (defn- reset-timing! []
       (vreset! timing-origin-ms (monotonic-ms))
       (vreset! timing-phases []))))

#?(:kotoba
   (defn timed [phase :string f [:fn [[] [:ref :form/r]]]] [:ref :form/r]
     (f))
   :default
   (defn timed [phase f]
     (if-not (timing-enabled?)
       (f)
       (let [started (monotonic-ms)]
         (try
           (f)
           (finally
             (vswap! timing-phases conj
                     {:phase phase :milliseconds (- (monotonic-ms) started)})))))))

#?(:kotoba nil
   :default
   (defn- timing-report []
     (when (timing-enabled?)
       {:format "kotoba.compiler-timing/v1"
        :totalMilliseconds (- (monotonic-ms) @timing-origin-ms)
        :phases @timing-phases})))

#?(:kotoba nil
   :default
   (defn- emit-timing! [report]
     (when report
       (io/write-error (str "KOTOBA_TIMING " (json-text/encode-value report) "\n")))))

#?(:kotoba
   (defn- option-at [args [:list :string] flag :string i :i64] [:option :string]
     (if (>= i (vector-count args))
       (option-none-of [:option :string])
       (if (= flag (typed-list-nth [:list :string] args i))
         (if (< (+ i 1) (vector-count args))
           (option-some-of [:option :string] (typed-list-nth [:list :string] args (+ i 1)))
           (option-none-of [:option :string]))
         (option-at args flag (+ i 1)))))
   :default nil)

(defn option [#?@(:kotoba [args [:list :string] flag :string] :default [args flag])]
  #?@(:kotoba [[:option :string]])
  #?(:kotoba (option-at args flag 0)
     :default (second (drop-while #(not= flag %) args))))

;; Repeated flags. `--source-path` may appear more than once and each
;; occurrence is a separate package root, so taking only the first would
;; silently compile against a subset of the roots the caller named -- the
;; graph would still link if the missing root happened to be unused, which is
;; the failure that looks like a pass.
#?(:kotoba
   (defn- options-from [args [:list :string] flag :string i :i64 acc [:list :string]] [:list :string]
     (if (>= (+ i 1) (vector-count args))
       acc
       (options-from args flag (+ i 1)
                     (if (= flag (typed-list-nth [:list :string] args i))
                       (conj acc (typed-list-nth [:list :string] args (+ i 1)))
                       acc)))))

(defn options [#?@(:kotoba [args [:list :string] flag :string] :default [args flag])]
  #?@(:kotoba [[:list :string]])
  #?(:kotoba (options-from args flag 0 (typed-list-new [:list :string]))
     :default (vec (keep (fn [pair] (when (= (first pair) flag) (second pair)))
                         (partition 2 1 args)))))

(defn usage-error! [#?@(:kotoba [message :string] :default [message])] #?@(:kotoba [:string])
  (throw (ex-info message {:phase :usage})))

(defn source! [path] (source-path/admit! path))

;; Kotoba: the host's reading below (`read-edn-form!` over nbb-io's
;; `read-text-file`): the file through nbb-io's Kotoba read (refusals by name,
;; no trap), read by the kotoba reader with the policy bounds (200000 nodes,
;; 4096-char tokens, 128 depth, 1 MiB strings) and no dispatch preflight
;; (`bounded-edn/read-reader-text-limits`), and the answer is the Form. Until
;; 2026-10-10 this was `bounded-edn/read-file` (its own READ, which trapped on
;; a path it cannot serve, and its preflight). The host definition stays where
;; it was, in the host-only region.
#?(:kotoba
   (defn read-edn-file! [path :string] [:ref :form/r]
     ;; the reads abort, and across the module boundary their abort is this
     ;; function's (ADR 0363)
     (bounded-edn/read-reader-text-limits (nbb-io/read-text-file path) (cs-max-policy-nodes) (cs-max-policy-depth))))

;; Everything from here to `command-line-args` decodes, narrows and reports on
;; host values: EDN maps, BigInts, `ex-info` data and `catch :default`. A
;; Kotoba module has no open map and no catchable raise, so this region is
;; the host route's alone; the Kotoba surface is the argument helpers above
;; and the entry contract below.
#?(:kotoba nil
   :default
   (do
;; These bounds mirror `kotoba.compiler.bounded-edn`. Policy files are the one
;; untrusted-ish EDN side channel on this fast path; source has its own reader
;; and admission contract.
(def ^:private max-policy-depth 128)
(def ^:private max-policy-token-chars 4096)
(def ^:private max-policy-nodes 200000)
(def ^:private max-policy-string-chars (* 1024 1024))

;; A sealed artifact is a different input class from a policy file, and its
;; size is set by a contract rather than by taste: `kotoba.verifier` admits up
;; to 1 MiB of code bytes, and every byte is one node here. A node bound below
;; that would refuse artifacts the verifier accepts -- a decode error standing
;; in for a verification decision, which is the worse of the two failures
;; because it names the reader instead of the artifact. Four times the code
;; ceiling leaves the program, exports and metadata room above it.
;;
;; Measured 2026-09-08, the largest artifact in this tree: SHA-512 compiled to
;; aarch64-macos, 46,498 characters, 12,520 nodes, depth 12, longest string 64.
(def ^:private max-artifact-nodes (* 4 1024 1024))
;; The depth of an artifact is likewise set by what it embeds, not by what a policy
;; file plausibly is: the sealed program is the KIR of source that may read at depth
;; 512 (`:max-reader-depth`, lang/guest-grammar.edn), and desugaring nests deeper
;; than the source (a `cond` of N arms is N nested `if`s). Measured 2026-10-02: the
;; desugar port (944 functions, `scripts/selfhost-wall/guests`) seals a 134-deep
;; dispatch chain, which the 128 policy bound refused as "EDN nesting exceeds limit"
;; in `extract-native` after the compiler and the native verifier had accepted it.
;; The verifier's own expression-depth ceiling still decides what runs.
(def ^:private max-artifact-depth 512)

(defn- walk-edn-nodes
  "Visits X and everything under it, answering the running node count. The
  count is threaded rather than held in a volatile: a Kotoba module has no
  mutable cell, and the visit order (key before value) is unchanged."
  [limit nodes x]
  (let [nodes (inc nodes)]
    (when (> nodes limit)
      (throw (ex-info "EDN value contains too many nodes"
                      {:phase :decode :limit limit})))
    (when (and (string? x) (> (count x) max-policy-string-chars))
      (throw (ex-info "EDN string exceeds limit"
                      {:phase :decode :limit max-policy-string-chars})))
    (cond
      (map? x) (reduce (fn [acc entry]
                         (walk-edn-nodes limit (walk-edn-nodes limit acc (key entry)) (val entry)))
                       nodes x)
      (coll? x) (reduce (fn [acc item] (walk-edn-nodes limit acc item)) nodes x)
      :else nodes)))

(defn- validate-edn-shape! [limit value]
  (walk-edn-nodes limit 0 value)
  value)

(defn- read-edn-form! [node-limit depth-limit text]
  (let [forms (kr/read-forms text {:max-depth depth-limit
                                   :max-token-chars max-policy-token-chars})]
    (when (empty? forms)
      (throw (ex-info "EDN input is empty" {:phase :decode})))
    (when (> (count forms) 1)
      (throw (ex-info "EDN input contains trailing forms" {:phase :decode})))
    (validate-edn-shape! node-limit (first forms))))

;; The module lock is the other EDN file this route is handed. Same reader and
;; same bounds as `--policy`: it arrives from the caller, and a lock is
;; supposed to make a build MORE constrained, so it must not be the one input
;; read without limits.
(defn read-edn-file! [path]
  (read-edn-form! max-policy-nodes max-policy-depth (nbb-io/read-text-file path)))

(def ^:private structural-index-keys
  "KIR function metadata whose integers are HOST indexes into `:params`, not
  guest i64 values: `kotoba.kir/validated-closure-param-indexes` and its
  `i64-pair-chain` sibling check them with `integer?` and use them with
  `nth`. `kir/lower` writes them as host numbers; the artifact reader below
  hands back a BigInt for every integer token, which is right for a value
  and wrong for an index -- `(integer? BigInt)` is false under nbb, so a
  read-back artifact with ANY closure was refused by the verifier's oracle
  re-execution as `closure parameter indexes are malformed` (measured
  2026-09-15: `extract-native` on the first native program passing a
  `(fn [s] ...)` to a `[:fn [[<record>] <record>]]` parameter; every fixture
  that had reached the command before was closure-free). Narrowing exactly
  these keys, at the boundary that produced the BigInts, is the same move
  `extract-native` makes for `:code`."
  [:closure-param-indexes :i64-pair-chain-param-indexes])

(defn- narrow-structural-indexes [artifact]
  (if (and (map? artifact) (vector? (get-in artifact [:program :functions])))
    (update-in artifact [:program :functions]
               (fn [functions]
                 (mapv (fn [function]
                         (reduce (fn [function key]
                                   (if (contains? function key)
                                     (update function key #(mapv host-integer/narrow %))
                                     function))
                                 function structural-index-keys))
                       functions)))
    artifact))

(defn read-artifact-file!
  "A sealed `.kexe` read with the reader the rest of this compiler uses.

  `kr/read-forms` returns a BigInt for every integer token, which is what an
  i64 IS on this host. `cljs.reader`, which `extract-native` called until
  2026-09-08, returns a `js/Number` -- and a Number cannot hold an i64.
  Measured on SHA-512 compiled to aarch64-macos: 347 integer literals, 106 of
  them past 2^53, the first round constant coming back
  4794697086780616226 -> 4794697086780617000. The seal is over the exact
  values, so the command refused its own compiler's output as \"artifact
  integrity mismatch\" while the file on disk was intact.

  Same depth and token bounds as a policy file; a larger node bound, because
  an artifact's size is set by the verifier's own code ceiling rather than by
  what a hand-written EDN file plausibly is.

  One narrowing, after the read: `structural-index-keys` above -- host
  indexes, not values."
  [path]
  (narrow-structural-indexes (read-edn-form! max-artifact-nodes max-artifact-depth (nbb-io/read-artifact-text-file path))))

(defn read-artifact-text!
  "`read-artifact-file!` over text already in hand: the sealed handler
  artifacts a linux-static image carries are compiled into this compiler as
  text (`kotoba.compiler.linux-static-handlers`), and are read exactly --
  every integer a BigInt -- for the same reason a `.kexe` file is."
  [text]
  (narrow-structural-indexes (read-edn-form! max-artifact-nodes max-artifact-depth text)))

(defn read-policy-material [args]
  (if-let [path (option args "--policy")]
    {:present? true :text (nbb-io/read-text-file path)}
    {:present? false :text ""}))

(defn parse-policy-material
  "Decode policy EDN. This is decoding only: a `:allow` grant written with a
  catalog NAME (`[:cap/call :hash/sha256]`) is canonicalised to its wire id by
  `kotoba.compiler.capability-names/wire-policy`, which the source-consuming
  entrypoints apply immediately around this call.

  Why not here, where the single decode boundary is. `capability-names` reads
  the catalog through `kotoba.sema`, and requiring `kotoba.sema` from this
  namespace would pull the whole frontend into the load closure of every
  entrypoint that requires this one -- including `output-set-cli`, which never
  reads Kotoba source. Measured 2026-09-01 under nbb on this workstation:
  loading `kotoba.compiler.diagnostic` alone took 2.1s wall, loading
  `kotoba.sema` took 15.8s. `verify-output-set` would have paid that to gain
  nothing."
  [material]
  (if (:present? material)
    (read-edn-form! max-policy-nodes max-policy-depth (:text material))
    {}))

(defn read-policy [args]
  (parse-policy-material (read-policy-material args)))

(defn emit-metadata
  "Build metadata carried outside capability policy, matching the JVM CLI's
  compile-source call. Keep the integer as BigInt so provenance hashes and
  Wasm i64 emission stay exact beyond JavaScript's safe-integer range."
  [args]
  (if (seq (filter (fn [a] (= "--fuel" a)) args))
    (let [text (option args "--fuel")]
      (when-not (and text
                     #?(:kotoba (and (decimal-text/decimal? text)
                                     (not= "-" (subs text 0 1)))
                        :default (re-matches #"[0-9]+" text)))
        (throw (ex-info "--fuel must be a positive decimal integer"
                        {:phase :usage :fuel text})))
      (let [fuel (host-integer/exact text)]
        (when (zero? fuel)
          (throw (ex-info "--fuel must be a positive decimal integer"
                          {:phase :usage :fuel text})))
        {:fuel fuel}))
    {}))

(defn oracle-fuel
  "The declared budget as a HOST number, for `kotoba.kir/lower`'s
  `:oracle-fuel`.

  `emit-metadata` keeps `--fuel` as a BigInt on purpose, so provenance hashes
  and Wasm i64 emission stay exact past 2^53. The interpreter that seals a
  pure entry's value counts in host integers and refuses a BigInt outright
  (`fuel must be a positive integer within the admitted ceiling`), so the
  narrowing happens here -- once, at the boundary, rather than at each of the
  three routes that lower. Every admitted budget is at most 2^53-1
  (`kotoba.kir/max-fuel`), which is exactly the range a host number holds.

  Returns nil when the caller declared nothing, and that is the whole
  contract: `lower` then uses its own default. Substituting the RUNTIME
  default here instead would be a silent regression -- the runtime default is
  512 and the oracle's is 100,000, so every program between those two sizes
  would stop compiling for callers who named no budget at all."
  [emit-metadata policy]
  (when-let [declared (or (:fuel emit-metadata) (get-in policy [:budgets :fuel]))]
    (host-integer/narrow declared)))

(def ^:private declarative-policy-keys
  "Policy controls consumed by the compiler rather than capability admission.
  Keep this aligned with `kotoba.compiler.core/capability-policy`: admission is
  deliberately closed over its own key set and must not reject known compiler
  controls as malformed grants."
  #{:language-profile :budgets})

(defn capability-policy [policy]
  (apply dissoc policy declarative-policy-keys))

(defn analyze-options [policy]
  (cond-> {}
    (:language-profile policy)
    (assoc :language-profile (:language-profile policy))))

(defn- exit-code [phase]
  (case phase
    :usage 64
    ;; :project-link joined this list when the linker became reachable from
    ;; here. The JVM CLI has always mapped it to 65; without it a rejected
    ;; graph exited 70 (internal), so "your source paths are wrong" and "the
    ;; compiler broke" were the same answer on this route and a different
    ;; answer than the JVM gave for the same input.
    ;; :module-lock joins for the same reason :project-link did. A lock that
    ;; does not pin a dependency, or a block that does not hash to its name,
    ;; is a caller telling the compiler something wrong -- not the compiler
    ;; breaking. Without this both answered 70, which is the code reserved for
    ;; "internal compiler error", so a CI job could not tell the two apart.
    ;; `kotoba.compiler.cli/exit-code` carries the same entry, so the JVM and
    ;; Node routes still answer identically.
    ;; `:coverage` joined with the coverage commands (ADR 0348 iteration 2);
    ;; the JVM table has carried it all along.
    ;; `:test` -- a source with no exported test-* definitions, or a test
    ;; that is not a zero-arity export -- joined with `amu test` on this
    ;; route (ADR 0348 iteration 7); it answered 70 on both routes before.
    (:decode :read :subset :admission :verify :coverage :project-link :module-lock :test) 65
    ;; `kotoba.compiler.cli/exit-code` carries this entry too. Neither 0 nor
    ;; 65: a REFUSED definition is an answer (listed with its marker, exit 0),
    ;; and this is the other thing -- no identity could be computed at all.
    :definition-identity 66
    ;; `:runtime-identity` and `:receipt` joined when the trust-plane
    ;; commands (`kotoba.compiler.nbb.trust-cli`) started answering here;
    ;; `kotoba.compiler.cli/exit-code` has carried both all along.
    ;; `:sign` is what `kotoba.verifier.signing` names a malformed key or an
    ;; invalid validity interval at signing time. It was in neither table, so
    ;; `amu public-key <not-a-key>` exited 70 -- "internal compiler error" --
    ;; for a caller's bad input (measured 2026-09-11 by the first negative
    ;; case of scripts/test-nbb-trust.cljk). Same code as the signature
    ;; plane's other refusals, on both routes.
    (:signature :sign :trust :runtime-identity) 77
    :output 74
    ;; `:execute` -- the executor refused the run (input arity, an untrusted
    ;; artifact at execution time) -- and `:native-executor` -- the executor
    ;; is not on this route's classpath -- joined with `amu run` here (ADR
    ;; 0348 iteration 8). EX_UNAVAILABLE, as the JVM table has for :execute.
    (:execute :native-executor) 69
    :receipt 76
    70))

(defn- error-report [error source-name]
  (let [data (ex-data error)
        phase (or (:phase data) :internal)
        ;; Same refinement the JVM CLI applies (kotoba.compiler.diagnostic).
        ;; This path links a project when `--source-path` is given, so a
        ;; module rejected here for declaring `(:require ...)` is a caller who
        ;; did NOT name their source roots -- still exactly the caller who
        ;; needs to be told which invocation does.
        refined (when (not= phase :internal) (diagnostic/refine error))]
    (cond-> {:format :kotoba.cli-error/v1
             :ok false
             :error phase
             :diagnostic (diagnostic/from-error error source-name)
             :message (if (= phase :internal)
                        "internal compiler error"
                        (diagnostic/refined-message error (ex-message error)))}
      (:details refined) (assoc :details (:details refined)))))

(defn- invoke* [run! args reset?]
  (when reset? (reset-timing!))
  (try
    (let [value (timed "command" #(run! (vec args)))]
      {:status 0
       :stdout (str (pr-str value) "\n")
       :stderr ""
       :timing (timing-report)})
    (catch :default error
      (let [source (second args)
            source-name (when (source-path/source-kind source)
                          (posix-path/basename source))
            report (error-report error source-name)]
        {:status (exit-code (:error report))
         :stdout ""
         :stderr (str (pr-str report) "\n")
         :timing (timing-report)}))))

(defn invoke
  "Runs one already-loaded compiler command without terminating the process."
  [run! args]
  (invoke* run! args true))

(defn refusal
  "The error contract for an entrypoint that prints its own success output
  (`amu test` prints text, not EDN): the same `:kotoba.cli-error/v1` report
  and the same exit code `invoke` would have produced for ERROR."
  [error source]
  (let [source-name (when (source-path/source-kind source)
                      (posix-path/basename source))
        report (error-report error source-name)]
    {:status (exit-code (:error report))
     :stderr (str (pr-str report) "\n")}))))

;; Kotoba readings of the policy, build-metadata and artifact helpers above.
;; Every value is the `:form/r` Form (the host's maps), so the host keys are
;; Form keywords. Named differences from the host route:
;;   - the policy is read by `bounded-edn/read-edn-text` (the host walks the
;;     kotoba reader's forms with the same bounds; a dispatch form other than a
;;     set is refused here by bounded-edn's preflight);
;;   - `--fuel` admits at most 18 digits (`decimal-text/decimal?`), the host any
;;     length; past 2^53-1 both are refused later by `kotoba.kir`;
;;   - there is no BigInt, so an artifact needs no index narrowing and
;;     `oracle-fuel` answers the i64 itself; a policy `:budgets :fuel` that is not
;;     an integer is refused here, where the host hands it to `kir/lower`.
#?(:kotoba
   (defn- cs-kw [k :keyword] [:ref :form/r] (form/keyword-form k)))

#?(:kotoba
   (defn- cs-get [m [:ref :form/r] k :keyword] [:ref :form/r] (form/form-get m (cs-kw k))))

#?(:kotoba
   (defn- cs-put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r] (form/assoc-form m (cs-kw k) v)))

#?(:kotoba
   (defn- cs-empty [] [:ref :form/r] (form/form-map (form/no-forms))))

;; A policy file's and a module lock's bounds (the host's max-policy-nodes / -depth).
#?(:kotoba
   (defn- cs-max-policy-nodes [] :i64 200000))

#?(:kotoba
   (defn- cs-max-policy-depth [] :i64 128))

;; `read-artifact-file!`'s bounds (the host's max-artifact-nodes / -depth).
#?(:kotoba
   (defn- cs-max-artifact-nodes [] :i64 4194304))

#?(:kotoba
   (defn- cs-max-artifact-depth [] :i64 512))

#?(:kotoba
   ;; The host's `read-artifact-file!`: `read-edn-form!` (the kotoba reader, no
   ;; dispatch preflight; 2026-10-10, was bounded-edn's preflighted reading).
   (defn read-artifact-file! [path :string] [:ref :form/r]
     (bounded-edn/read-reader-text-limits (nbb-io/read-artifact-text-file path)
                                          (cs-max-artifact-nodes) (cs-max-artifact-depth))))

#?(:kotoba
   (defn read-policy-material [args [:list :string]] [:ref :form/r]
     (let [path (option args "--policy")]
       (if (option-some?-of [:option :string] path)
         (cs-put (cs-put (cs-empty) :present? (form/bool-form true))
                 :text (form/string-form (nbb-io/read-text-file (option-value-of [:option :string] path ""))))
         (cs-put (cs-put (cs-empty) :present? (form/bool-form false)) :text (form/string-form ""))))))

#?(:kotoba
   ;; The host's `parse-policy-material`: `read-edn-form!` with the policy
   ;; bounds, i.e. the kotoba reader with no dispatch preflight, so a `#_`
   ;; discard in a policy is read as on the host (2026-10-10; bounded-edn's
   ;; `read-edn-text` refused it "EDN dispatch forms are forbidden", exit 65,
   ;; where bin/amu admitted the policy: fixture p20).
   (defn parse-policy-material [material [:ref :form/r]] [:ref :form/r]
     (if (form/bool-value (cs-get material :present?))
       (bounded-edn/read-reader-text-limits (form/string-value (cs-get material :text))
                                            (cs-max-policy-nodes) (cs-max-policy-depth))
       (cs-empty))))

#?(:kotoba
   (defn read-policy [args [:list :string]] [:ref :form/r]
     (parse-policy-material (read-policy-material args))))

#?(:kotoba
   (defn- cs-flag? [args [:list :string] flag :string i :i64] :bool
     (if (>= i (vector-count args))
       false
       (if (= flag (typed-list-nth [:list :string] args i))
         true
         (cs-flag? args flag (+ i 1))))))

#?(:kotoba
   (defn- cs-fuel-refusal [] [:ref :form/r]
     (throw (ex-info "--fuel must be a positive decimal integer" {:phase :usage}))))

#?(:kotoba
   (defn emit-metadata [args [:list :string]] [:ref :form/r]
     (if (cs-flag? args "--fuel" 0)
       (let [o (option args "--fuel")
             text (option-value-of [:option :string] o "")]
         (if (option-some?-of [:option :string] o)
           ;; a signed decimal whose value is not positive is what the host's
           ;; [0-9]+ refuses plus its zero check (\"-0\" and \"-5\" included)
           (if (decimal-text/decimal? text)
             (let [fuel (decimal-text/parse text)]
               (if (> fuel 0)
                 (cs-put (cs-empty) :fuel (form/int-form fuel))
                 (cs-fuel-refusal)))
             (cs-fuel-refusal))
           (cs-fuel-refusal)))
       (cs-empty))))

#?(:kotoba
   (defn- cs-declared-fuel [declared [:ref :form/r]] [:option :i64]
     (if (form/is-int? declared)
       (option-some-of [:option :i64] (form/int-value declared))
       (throw (ex-info "the declared fuel budget must be an integer" {:phase :decode})))))

#?(:kotoba
   (defn oracle-fuel [metadata [:ref :form/r] policy [:ref :form/r]] [:option :i64]
     (let [declared (cs-get metadata :fuel)]
       (if (form/is-nil? declared)
         (let [budget (cs-get (cs-get policy :budgets) :fuel)]
           (if (form/is-nil? budget)
             (option-none-of [:option :i64])
             (cs-declared-fuel budget)))
         (cs-declared-fuel declared)))))

#?(:kotoba
   ;; The host's `(dissoc policy :language-profile :budgets)`: a policy that is
   ;; not a map is handed on as it is (2026-10-10). kotoba.form's `dissoc-form`
   ;; answers a MAP of any Form's kids, so a `nil` policy became `{}` and was
   ;; admitted where the host's `(dissoc nil ..)` is nil, which admission
   ;; refuses "malformed capability policy" (fixture p27).
   (defn capability-policy [policy [:ref :form/r]] [:ref :form/r]
     (if (form/is-map? policy)
       (form/dissoc-form (form/dissoc-form policy (cs-kw :language-profile)) (cs-kw :budgets))
       policy)))

#?(:kotoba
   (defn- arguments-from [count :i64 i :i64 acc [:list :string]] [:list :string]
     (if (>= i count)
       acc
       (arguments-from count (+ i 1) (conj acc (cli/args (str i)))))))

(defn command-line-args
  "The arguments this entrypoint was invoked with, through the cli/args
  ability: the empty request answers the count, a decimal the argument."
  [] #?@(:kotoba [[:list :string]])
  #?(:kotoba (arguments-from (decimal-text/parse (cli/args "")) 0 (typed-list-new [:list :string]))
     :default (mapv #(cli/args (str %)) (range (parse-long (cli/args ""))))))

#?(:kotoba
   ;; Kotoba: the command is a function from the argument list to the text
   ;; the host route would print (`pr-str` of its value), and the status is
   ;; 0. A refusal is not caught here: an abort ends the entry with the
   ;; handler's own status.
   (defn execute!
     [run! [:fn [[[:list :string]] :string]]] :i64
     (let [stdout (run! (command-line-args))]
       (when (> (string-byte-length stdout) 0) (io/write stdout))
       0))
   :default
(defn execute!
  "Run one command and answer its exit status. The status is the entry's
  RESULT (adr-2609242330 section 1 (a): exit is not an ability); on nbb the
  mechanism layer hands a non-zero one to the OS."
  [run!]
  (let [{:keys [status stdout stderr timing]}
        (invoke* run! (command-line-args) false)]
    (emit-timing! timing)
    (when (seq stdout) (io/write stdout))
    (when (seq stderr) (io/write-error stderr))
    #?(:cljs (when-not (zero? status) (host-entry/exit! status)))
    status)))

;; Kotoba reading of the error contract for an entry's `main` (the host's `invoke*`, `error-report` and
;; `exit-code` in the region above): the phase of a caught refusal (`:phase` of its ex-info data, `:internal`
;; without one), the host's exit-code table entry for entry, and a REDUCED `:kotoba.cli-error/v1` report (format,
;; ok, error, message; no `:diagnostic`/`:details`, the message is not refined by kotoba.compiler.diagnostic).
#?(:kotoba
   (defn error-phase [e :document] :keyword
     (option-or (document-keyword-value (option-or (document-get (ex-data e) (document-keyword :phase)) (document-null)))
                :internal)))

#?(:kotoba
   (defn exit-code [phase :keyword] :i64
     (cond
       (= phase :usage) 64
       (or (= phase :decode) (= phase :read) (= phase :subset) (= phase :admission) (= phase :verify)
           (= phase :coverage) (= phase :project-link) (= phase :module-lock) (= phase :test)) 65
       (= phase :definition-identity) 66
       (or (= phase :signature) (= phase :sign) (= phase :trust) (= phase :runtime-identity)) 77
       (= phase :output) 74
       (or (= phase :execute) (= phase :native-executor)) 69
       (= phase :receipt) 76
       :else 70)))

#?(:kotoba
   (defn refusal-text [phase :keyword message :string] :string
     (string-concat "{:format :kotoba.cli-error/v1, :ok false, :error "
      (string-concat (document-edn-print (document-keyword phase))
       (string-concat ", :message "
        (string-concat (document-edn-print (document-string (if (= phase :internal) "internal compiler error" message)))
                       "}\n"))))))

#?(:kotoba
   ;; The NDJSON worker is a long-lived host process (stdin events, module
   ;; state); there is no such entry on the Kotoba route, so asking for it is
   ;; a usage error rather than an absent export.
   (defn serve! [run! target]
     (usage-error! "worker mode is not available on the Kotoba route"))
   :default
   (do
(def ^:private max-worker-line-bytes (* 64 1024))
(def ^:private max-worker-args 64)
(def ^:private max-worker-arg-chars 4096)

(defn- configured-max-requests []
  (let [text (let [t (env/read "KOTOBA_WORKER_MAX_REQUESTS")] (if (seq t) t "1000"))
        value (host-integer/decimal-count text)]
    (if (and value (<= 1 value 100000))
      value
      1000)))

(defn- write-worker-response! [response]
  (io/write (str (json-text/encode-value response) "\n")))

(defn- request! [line]
  (when (> (text-bytes/utf8-length line) max-worker-line-bytes)
    (usage-error! "worker request exceeds byte limit"))
  (let [request (json-text/decode-object line)
        args (:args request)]
    (when-not (map? request)
      (usage-error! "worker request must be a JSON object"))
    (when-not (or (nil? (:id request))
                  (string? (:id request))
                  (number? (:id request)))
      (usage-error! "worker request id must be a string, number, or null"))
    (when-not (and (vector? args)
                   (<= (count args) max-worker-args)
                   (every? #(and (string? %) (<= (count %) max-worker-arg-chars)) args))
      (usage-error! "worker args must be a bounded array of strings"))
    request))

(defn serve!
  "Serves bounded, sequential NDJSON requests until shutdown or the request
  ceiling. Each response contains the ordinary CLI stdout/stderr contract, so
  callers do not need a second error decoder."
  [run! target]
  (let [requests (volatile! 0)
        maximum (configured-max-requests)
        pending (volatile! (text-bytes/empty-bytes))
        closed? (volatile! false)
        close! (fn []
                 (when-not @closed?
                   (vreset! closed? true)
                   #?(:cljs (host-entry/pause-stdin!))
                   #?(:cljs (host-entry/exit-soon! 0))))
        handle-line!
        (fn [line]
          (let [count (vswap! requests inc)]
            (if (> count maximum)
              (do
                (write-worker-response! {:format "kotoba.compiler-worker/v1"
                                         :type "result" :id nil :status 64
                                         :stdout ""
                                         :stderr "worker request limit exceeded\n"})
                (close!))
              (try
                (let [request (request! line)
                      id (:id request)]
                  (if (= "shutdown" (:op request))
                    (do
                      (write-worker-response! {:format "kotoba.compiler-worker/v1"
                                               :type "shutdown" :id id :status 0})
                      (close!))
                    (let [result (invoke run! (:args request))]
                      (write-worker-response!
                       (assoc result :format "kotoba.compiler-worker/v1"
                                     :type "result" :id id))
                      ;; Recover from bounded caller errors, but fail-stop after
                      ;; an internal compiler failure that may have tainted state.
                      (when (= 70 (:status result)) (close!)))))
                (catch :default error
                  (write-worker-response! {:format "kotoba.compiler-worker/v1"
                                           :type "result" :id nil :status 64
                                           :stdout ""
                                           :stderr (str (ex-message error) "\n")}))))))]
    (write-worker-response! {:format "kotoba.compiler-worker/v1"
                             :type "ready" :target (name target)
                             :maxRequests maximum})
    #?(:cljs (host-entry/on-stdin-data!
         (fn [chunk]
           (when-not @closed?
             (vreset! pending (text-bytes/concat-bytes @pending chunk))
             (loop []
               (let [newline (text-bytes/index-of-byte @pending 10)]
                 (if (neg? newline)
                   (when (> (text-bytes/bytes-length @pending) max-worker-line-bytes)
                     (write-worker-response! {:format "kotoba.compiler-worker/v1"
                                              :type "result" :id nil :status 64
                                              :stdout ""
                                              :stderr "worker request exceeds byte limit\n"})
                     (close!))
                   (let [line-buffer (text-bytes/slice-bytes @pending 0 newline)
                         line-length (text-bytes/bytes-length line-buffer)
                         line-buffer (if (and (pos? line-length)
                                              (= 13 (text-bytes/byte-at line-buffer (dec line-length))))
                                       (text-bytes/slice-bytes line-buffer 0 (dec line-length))
                                       line-buffer)]
                     (vreset! pending (text-bytes/slice-bytes @pending (inc newline)
                                                             (text-bytes/bytes-length @pending)))
                     (if (> (text-bytes/bytes-length line-buffer) max-worker-line-bytes)
                       (do
                         (write-worker-response! {:format "kotoba.compiler-worker/v1"
                                                  :type "result" :id nil :status 64
                                                  :stdout ""
                                                  :stderr "worker request exceeds byte limit\n"})
                         (close!))
                       (do
                         (handle-line! (text-bytes/utf8-text-lossy line-buffer))
                         (when-not @closed? (recur))))))))))))
    #?(:cljs (host-entry/on-stdin-end!
         (fn []
           (when-not @closed?
             (when (pos? (text-bytes/bytes-length @pending))
               (write-worker-response! {:format "kotoba.compiler-worker/v1"
                                        :type "result" :id nil :status 64
                                        :stdout ""
                                        :stderr "unterminated worker request\n"}))
             (close!)))))))))
