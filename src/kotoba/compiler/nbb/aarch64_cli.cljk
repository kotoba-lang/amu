(ns kotoba.compiler.nbb.aarch64-cli
  "AArch64-only nbb native compiler entrypoint, without the artifact packagers.

  The ELF64 / PE32+ / linux-static packagers (`kotoba.compiler.nbb.native-package`)
  serve only `aarch64-aiueos-kernel-v1` and `aarch64-linux-static`; those two
  targets are routed to `kotoba.compiler.nbb.x86-64-cli`, the packaged native
  entry (ADR 0366). Everything
  else (aarch64-macos included) has no packaged form, so this entry's closure
  does not load them. A packaged target that reaches this entry anyway is
  refused by name, never written as artifact EDN under an executable's name."
  {:kotoba/export #?(:kotoba [main] :default [])}
  (:require #?@(:kotoba [[kotoba.compiler.nbb.cli :as native-cli]
                         [kotoba.compiler.nbb.cli-support :as support]]
                :default [[kotoba.compiler.nbb.cli :as native-cli]
            [kotoba.compiler.nbb.cli-support :as support]
            [kotoba.compiler.nbb.compile-cache :as compile-cache]
            [kotoba.kir.target :as target-profile]
            [kotoba.native.aarch64 :as aarch64]])))

#?(:kotoba
   ;; Kotoba: the entry's `main`, in check-cli's style (the host's top-level form has no Kotoba reading: a module has
   ;; no top-level effects). `worker` is refused by name (no NDJSON worker on this route); everything else is
   ;; nbb.cli's Kotoba `run!` (`compile`, aarch64-macos, kotoba.native.aarch64 chosen by the backend rather than
   ;; injected, no packager). Success: the host's stdout, status 0. Refusal: cli-support's reduced
   ;; `:kotoba.cli-error/v1` report on stderr and the host's exit code for the refusal's phase.
   (defn main [] :i64
     (let [args (support/command-line-args)]
       (if (and (> (vector-count args) 0) (string=? (typed-list-nth [:list :string] args 0) "worker"))
         (let [w (io/write-error (support/refusal-text :usage "error: worker mode is not available on the Kotoba route"))]
           64)
         (try (let [w (io/write (native-cli/run! args))] 0)
              (catch e (let [phase (support/error-phase e)
                             w (io/write-error (support/refusal-text phase (ex-message e)))]
                         (support/exit-code phase)))))))
   :default
   ;; Host reading (Clojure / nbb), unchanged.
   (do

(def ^:private packaged-targets
  #{:aarch64-aiueos-kernel-v1 :aarch64-linux-static-kotoba-v1})

(defn- package
  "The packager slot of `native-cli/run!`: nil for the targets that have no
  packaged form (what `native-package/package` answers for them), a refusal
  for the two that do."
  [target artifact artifact-kind policy]
  (when (contains? packaged-targets target)
    (throw (ex-info (str "target " (name target) " packages its artifact; this entry is built without the packagers, "
                         "route it through kotoba.compiler.nbb.x86-64-cli (the packaged native entry)")
                    {:phase :artifact-target :target target :reason :packager-not-loaded})))
  nil)

(defn- run! [args context]
  (native-cli/run! args :aarch64-kotoba-v1 aarch64/emit-program
                   package context))

(let [args (support/command-line-args)]
 (if (= "worker" (first args))
  (let [target-name (support/option args "--target")
        target (get native-cli/targets target-name)
        _ (when-not (= :aarch64-kotoba-v1 (some-> target target-profile/backend))
            (support/usage-error!
             (str "error: AArch64 worker does not cover target " target-name)))
        context (assoc (compile-cache/create-context) :target target)]
    (support/serve! (fn [x] (run! x context)) target))
  (support/execute! (fn [x] (run! x nil)))))))
