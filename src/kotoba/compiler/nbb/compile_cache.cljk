(ns kotoba.compiler.nbb.compile-cache
  "Bounded in-memory content-addressed cache for one target-locked worker.

  Only fully admitted/emitted (and for native, independently verified)
  artifacts are inserted. Values never cross worker processes."
  {:kotoba/export #?(:kotoba [key-for key-for-kind lookup lookup-stage put! put-stage! remove! sha256 sha256-bytes stage-key-for stats store-dir]
                     :default [create create-context key-for lookup! lookup-stage! put! put-stage! remove! resolve-stage! sha256 stage-key-for stats])}
  (:require [kotoba.compiler.json-text :as json-text]
            [kotoba.compiler.text-bytes :as text-bytes]
            #?@(:kotoba [[kotoba.bytes :as kbytes]
                         [sha2.core :as sha2]
                         [kotoba.compiler.decimal-text :as decimal-text]
                         [kotoba.compiler.nbb.io :as nbb-io]])
            ;; Abilities (superproject adr-2609242330 S5): under Kotoba
            ;; `env/read` and `hash/sha256` are catalog operations whose
            ;; handler comes from the target profile; under nbb the aliases
            ;; name the mechanism-layer handlers.
            #?(:cljs [kotoba.compiler.nbb.host.env :as env])
            #?(:cljs [kotoba.compiler.nbb.host.hash :as hash])))

;; Kotoba reading: A CONTENT-ADDRESSED STORE ON DISK. A cache is mutable
;; per-process state (volatiles) and Kotoba modules carry none, so the Kotoba
;; cache is not a map in memory but a directory: one `<key>.bin` per entry
;; plus `<key>.sha256`, the digest of the bytes, written AFTER the bytes (the
;; digest file is the commit marker). The identity is byte-identical to the
;; host reading (`key-for` hashes the same JSON text, so a Kotoba-built key
;; names the artifact a host-built key does).
;;
;; The store is OPT-IN and fail-closed: its directory is named by
;; KOTOBA_COMPILE_CACHE_DIR, and an unset variable, a directory that is not
;; ours (owner) or is group/world writable, a missing or short entry, or a
;; digest mismatch is a MISS, never a hit. No entry is served that was not
;; read back with the digest it was written with. Writes go through
;; `nbb.io/write-bytes!` (0600 temporary + fsync + rename), so a reader sees
;; the whole entry or none. Bounds (LRU, entries, bytes) and the in-memory
;; stage cache with its closures remain host-only.
#?(:kotoba
   nil
   :default
   (do
(defn- configured-integer [name default maximum]
  (let [text (env/read name)
        value (when (seq text) (js/Number text))]
    (if (and value (js/Number.isSafeInteger value) (<= 1 value maximum))
      value
      default)))

(defn create
  ([] (create "KOTOBA_WORKER_CACHE" 128 (* 64 1024 1024)))
  ([environment-prefix default-entries default-bytes]
   {:entries (volatile! {})
    :order (volatile! [])
    :bytes (volatile! 0)
    :max-entries (configured-integer (str environment-prefix "_ENTRIES")
                                     default-entries 4096)
    :max-bytes (configured-integer (str environment-prefix "_BYTES")
                                   default-bytes (* 1024 1024 1024))}))

(defn create-context []
  {:artifacts (create)
   :stages (create "KOTOBA_WORKER_STAGE_CACHE" 128 (* 64 1024 1024))})))

#?(:kotoba
   (defn sha256-bytes
     "SHA-256 of a byte buffer as 64 lowercase hex characters (the pure
     library; byte-identical to the host's node:crypto reading)."
     [data :bytes] :string
     (kbytes/hex (sha2/sha256 (vector-i64-from-bytes data)))))

(defn sha256
  "SHA-256 of VALUE (text, hashed as UTF-8, or bytes) as 64 lowercase hex
  characters: the hash/sha256 ability (catalog wire 3). Under Kotoba the
  ability hashes a string."
  [#?@(:kotoba [value :string] :default [value])]
  #?@(:kotoba [:string])
  (hash/sha256 value))

#?(:kotoba
   (defn key-for-kind
     "The artifact key: exactly the host's six-argument `key-for` over the same
     JSON text. EMIT-METADATA is the caller's `pr-str` of the metadata map.
     HAS-KIND false is the host's nil `artifact-kind`."
     [target :string source :string policy-present :bool policy-text :string
      emit-metadata :string linked :bool artifact-kind :string has-kind :bool] :string
     (sha256
      (json-text/encode-array
       (document-vector (document-string "kotoba.compile-cache/v4")
                        (document-string target)
                        (document-string source)
                        (document-bool policy-present)
                        (document-string policy-text)
                        (document-string emit-metadata)
                        (document-bool linked)
                        (if has-kind (document-string artifact-kind) (document-null)))))))

#?(:kotoba
   (defn key-for
     "The host's one-to-five-argument `key-for` (no artifact kind)."
     [target :string source :string policy-present :bool policy-text :string
      emit-metadata :string linked :bool] :string
     (key-for-kind target source policy-present policy-text emit-metadata linked "" false)))

#?(:kotoba
   (defn stage-key-for [stage :string material :string] :string
     (sha256
      (json-text/encode-array
       (document-vector (document-string "kotoba.stage-cache/v1")
                        (document-string stage)
                        (document-string material))))))

#?(:kotoba
   nil
   :default
   (do
(defn key-for
  ;; `linked?` is in the key because it changes what the frontend ADMITS, not
  ;; how it is spelled: a linked project carries :admit-linked-synthetics?.
  ;; The rest of the frontend options are a function of the policy text, which
  ;; is already here. Version tag raised to v3, so entries written under the
  ;; old key miss rather than being read under the new meaning.
  ([target source policy-material]
   (key-for target source policy-material {} false))
  ([target source policy-material emit-metadata]
   (key-for target source policy-material emit-metadata false))
  ([target source policy-material emit-metadata linked?]
   (key-for target source policy-material emit-metadata linked? nil))
  ;; `artifact-kind` selects WHICH packaged form `--output` receives for the
  ;; aiueos targets, so two invocations differing only in `--artifact` produce
  ;; different bytes from identical source, policy and metadata. It is not part
  ;; of provenance -- packaging is not a compile input, and the JVM does not
  ;; seal it either -- but it must be part of the cache key, or the second
  ;; invocation is served the first one's answer. Version tag raised to v4 so
  ;; entries written under v3 miss rather than being read under the new meaning.
  ([target source policy-material emit-metadata linked? artifact-kind]
   (sha256
    (json-text/encode-array ["kotoba.compile-cache/v4"
                       (name target)
                       source
                       (boolean (:present? policy-material))
                       (:text policy-material)
                       (pr-str emit-metadata)
                       (boolean linked?)
                       artifact-kind]))))

(defn stage-key-for [stage material]
  (sha256
   (json-text/encode-array ["kotoba.stage-cache/v1" (name stage) material])))

(defn- without [items value]
  (into [] (remove #(= value %)) items))

(defn lookup! [cache key]
  (when-let [entry (get @(:entries cache) key)]
    (vreset! (:order cache) (conj (without @(:order cache) key) key))
    (:value entry)))

(defn remove! [cache key]
  (when-let [entry (get @(:entries cache) key)]
    (vswap! (:entries cache) dissoc key)
    (vreset! (:order cache) (without @(:order cache) key))
    (vswap! (:bytes cache) - (:size entry)))
  nil)

(defn- evict! [cache]
  (loop []
    (when (or (> (count @(:entries cache)) (:max-entries cache))
              (> @(:bytes cache) (:max-bytes cache)))
      (when-let [oldest (first @(:order cache))]
        (remove! cache oldest)
        (recur)))))

(defn put! [cache key value size]
  (when (and (nat-int? size) (<= size (:max-bytes cache)))
    (remove! cache key)
    (vswap! (:entries cache) assoc key {:value value :size size})
    (vswap! (:order cache) conj key)
    (vswap! (:bytes cache) + size)
    (evict! cache))
  value)

(defn lookup-stage! [cache key]
  (when-let [entry (lookup! cache key)]
    (let [serialized (pr-str (:value entry))]
      (if (= (:sha256 entry) (sha256 serialized))
        (:value entry)
        (do
          (remove! cache key)
          (throw (ex-info "compiler stage cache integrity mismatch"
                          {:cache-key key})))))))

(defn put-stage! [cache key value]
  (let [serialized (pr-str value)]
    (put! cache key
          {:value value :sha256 (sha256 serialized)}
          (text-bytes/utf8-length serialized)))
  value)

(defn resolve-stage! [cache stage material compute]
  (if-not cache
    {:value (compute) :cache nil}
    (let [key (stage-key-for stage material)]
      (if-let [value (lookup-stage! cache key)]
        {:value value :cache :hit :cache-key key}
        (let [value (compute)]
          (put-stage! cache key value)
          {:value value :cache :miss :cache-key key})))))

(defn stats [cache]
  {:entries (count @(:entries cache))
   :bytes @(:bytes cache)
   :max-entries (:max-entries cache)
   :max-bytes (:max-bytes cache)})))

;; ---------------------------------------------------------------------------
;; Kotoba: the on-disk store (see the reading above)

#?(:kotoba (defrecord Found [hit :bool data :bytes]))

#?(:kotoba
   (defn store-dir
     "The store directory (KOTOBA_COMPILE_CACHE_DIR), or \"\" when the store is
     off. An empty value is unset, as on the host."
     [] :string
     (env/read "KOTOBA_COMPILE_CACHE_DIR")))

#?(:kotoba
   (defn- numbers [answer :string] :vector-i64
     (if (= 0 (string-byte-length answer))
       (vector-i64)
       (decimal-text/fields answer))))

#?(:kotoba
   (defn- usable-dir?
     "DIR is a directory (not followed), owned by this process's euid, and not
     group/world writable: the verdict cache's rule. Anything else disables
     the store."
     [dir :string] :bool
     (if (= 0 (string-byte-length dir))
       false
       (let [st (numbers (fs/app-data (str dir "NOFOLLOW_SEP")))
             who (numbers (fs/app-data (str dir "OWNER_SEP")))]
         (if (< (vector-count st) 4)
           false
           (if (< (vector-count who) 2)
             false
             (if (= 1 (vector-at st 3))
               ;; mode & 0o022 = 0: bits 1 (world write) and 4 (group write).
               (if (= 0 (rem (quot (vector-at st 0) 2) 2))
                 (if (= 0 (rem (quot (vector-at st 0) 16) 2))
                   (= (vector-at who 0) (vector-at who 1))
                   false)
                 false)
               false)))))))

#?(:kotoba
   (defn- data-path [dir :string key :string] :string (str dir "/" key ".bin")))

#?(:kotoba
   (defn- digest-path [dir :string key :string] :string (str dir "/" key ".sha256")))

#?(:kotoba
   (defn- key-name? [key :string] :bool
     ;; A key is the 64 lowercase hex characters `key-for` answers; anything
     ;; else (a path separator, a dot) is never joined into a path.
     (if (= 64 (string-byte-length key))
       (loop [i 0]
         (if (>= i 64)
           true
           (let [c (string-code-point-at key i)]
             (if (or (and (>= c 48) (<= c 57)) (and (>= c 97) (<= c 102)))
               (recur (+ i 1))
               false))))
       false)))

#?(:kotoba
   (defn lookup
     "The entry for KEY in DIR, or a miss. A hit is returned only when the
     bytes read back hash to the digest written with them; every other
     condition (store off, foreign directory, bad key, absent or unreadable
     entry, digest mismatch) is a miss."
     [dir :string key :string maximum :i64]
     [:record :kotoba.compiler.nbb.compile-cache/Found [[:hit :bool] [:data :bytes]]]
     (if (key-name? key)
       (if (usable-dir? dir)
         (if (= "1" (fs/app-data (str (digest-path dir key) "EXISTS_SEP")))
           (if (= "1" (fs/app-data (str (data-path dir key) "EXISTS_SEP")))
             (let [st (numbers (fs/app-data (str (data-path dir key) "NOFOLLOW_SEP")))]
               ;; A regular file (kind 0) within the bound; RANGE reads exactly
               ;; the observed size without following a symlink.
               (if (< (vector-count st) 4)
                 (->Found false (bytes-empty))
                 (if (= 0 (vector-at st 3))
                   (if (> (vector-at st 1) maximum)
                     (->Found false (bytes-empty))
                     (let [data (fs/app-data-bytes (str (data-path dir key) "RANGE_SEP0:" (vector-at st 1)))
                           want (fs/app-data (digest-path dir key))]
                       (if (= want (sha256-bytes data))
                         (->Found true data)
                         (->Found false (bytes-empty)))))
                   (->Found false (bytes-empty)))))
             (->Found false (bytes-empty)))
           (->Found false (bytes-empty)))
         (->Found false (bytes-empty)))
       (->Found false (bytes-empty)))))

#?(:kotoba
   (defn put!
     "Store DATA under KEY: the bytes first, then the digest that commits
     them. Answers 1 when stored, 0 when the store is off (never an error:
     the cache is an optimization, the artifact is already built)."
     [dir :string key :string data :bytes] :i64
     (if (key-name? key)
       (if (usable-dir? dir)
         (do (nbb-io/write-bytes! (data-path dir key) data 384)
             (nbb-io/write-text! (digest-path dir key) (sha256-bytes data))
             1)
         0)
       0)))

#?(:kotoba
   (defn remove!
     "Drop KEY: the digest first, so a half-removed entry is a miss."
     [dir :string key :string] :i64
     (if (key-name? key)
       (if (usable-dir? dir)
         (do (fs/app-data (str (digest-path dir key) "UNLINK_SEP"))
             (fs/app-data (str (data-path dir key) "UNLINK_SEP"))
             1)
         0)
       0)))

#?(:kotoba
   (defn- count-lines
     ;; fs/browse joins its NAME<TAB>D rows with a single newline and no
     ;; trailing one: an empty answer is no rows, otherwise newlines + 1.
     [listing :string] :i64
     (loop [i 0 n (if (= 0 (string-byte-length listing)) 0 1)]
       (if (>= i (string-byte-length listing))
         n
         (recur (+ i 1)
                (if (= 10 (string-code-point-at listing i)) (+ n 1) n))))))

#?(:kotoba
   (defn stats
     "The number of files (`.bin` and `.sha256` each count) in DIR: the raw
     listing line count; 0 when the store is off."
     [dir :string] :i64
     (if (usable-dir? dir)
       (count-lines (fs/browse dir))
       0)))

;; The stage cache's disk analogues. The host's stages hold Clojure values and
;; a compute closure (`resolve-stage!`); a Kotoba module has neither, so a
;; stage is the SERIALIZED text the host would `pr-str` for its integrity
;; digest, stored as UTF-8 bytes through the same committed-entry protocol.
;; The caller computes on a miss and calls `put-stage!`; \"\" is a miss (a
;; serialized stage is never empty).
#?(:kotoba
   (defn put-stage! [dir :string key :string serialized :string] :i64
     (put! dir key (string-to-utf8 serialized))))

#?(:kotoba
   (defn lookup-stage [dir :string key :string maximum :i64] :string
     (let [found (lookup dir key maximum)]
       (if (:hit found)
         (string-from-utf8 (:data found))
         ""))))
