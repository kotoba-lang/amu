(ns kotoba.compiler.nbb.run-cli
  "Node entrypoint for `amu measure-runtime` and `amu run`. The commands are
  `kotoba.compiler.run-cli`; this file prints the value and exits with the
  status the command decided (120 for a trapped execution, as the JVM CLI
  answered). `bin/amu` puts the `:native-run` alias closure on this
  entrypoint's classpath and no other's."
  (:require [kotoba.artifact.core :as artifact]
            [kotoba.compiler.nbb.cli-support :as support]
            [kotoba.compiler.run-cli :as run-cli]
            ;; static, not `requiring-resolve`: on nbb a require inside a
            ;; function is a promise, and the executor must be loaded before
            ;; the synchronous call below (run-cli/executor-fn says why)
            [kototama.native.executor :as executor]))

(let [args (vec *command-line-args*)
      outcome (try (run-cli/dispatch! {:measure-runtime executor/measure-runtime
                                       :execute executor/execute}
                                      args)
                   (catch :default error
                     (let [{:keys [status stderr]} (support/refusal error (second args))]
                       (.write js/process.stderr stderr)
                       (.exit js/process status))))]
  (when outcome
    (println (pr-str (artifact/edn-safe (:value outcome))))
    (when-not (zero? (:exit outcome)) (.exit js/process (:exit outcome)))))
