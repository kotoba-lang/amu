(ns kotoba.compiler.ios-aot
  {:kotoba/export [package]}
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.verifier.seal :as seal]]
                :default [[kotoba.artifact.core :as artifact]
                          [kotoba.lang.coll :as coll]])
            [kotoba.object.macho64 :as macho]
            [kotoba.verifier :as verifier])
  #?(:clj (:import [java.nio.charset StandardCharsets]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba nil
   :default
   (do

;; ASCII text as bytes. `.getBytes` is JVM-only; the string this is applied to
;; is the fixed target-profile label, so the two agree byte for byte. Mirrors
;; the `utf8-bytes` helpers in kotoba.native.aarch64 and .elf64.
(defn- ascii-bytes [^String s]
  #?(:clj (.getBytes s StandardCharsets/US_ASCII)
     :cljs (js/Array.from (.encode (js/TextEncoder.) s))))

(def ^:private targets
  {:ios :aarch64-ios-kotoba-v1
   :ios-simulator :aarch64-ios-kotoba-v1
   :macos :aarch64-macos-kotoba-v1})

(def ^:private host-profiles
  {:ios :kotoba.ios.static-host/v1
   :ios-simulator :kotoba.ios.static-host/v1
   :macos :kotoba.macos.static-host/v1})

(def ^:private host-target-profiles
  {:ios "aarch64-ios-kotoba-v1"
   :ios-simulator "aarch64-ios-kotoba-v1"
   ;; This is the target identity checked by the bounded in-process macOS
   ;; host. It is distinct from the full supervisor target used to compile the
   ;; KEXE and is granted only after the operation subset below is verified.
   :macos "aarch64-macos-static-kotoba-v1"})

;; `runtime/ios/kotoba_ios_host.c` implements scalar instructions, pair and
;; string equality/concat calls, and the inline pair ABI. The shared C host's
;; typed-capability callback is only a validation/echo stub, not a provider, so
;; the macOS profile refuses every capability call. Every other heap-call slot
;; in kotoba-native's context ABI is NULL (and vector bases are deliberately
;; empty), so a call through one would fault in the embedding app instead of
;; returning a supervised guest failure. Keep this set aligned with
;; `kotoba.native.x86-64/heap-call-offsets` and the v11/v12 context layout;
;; inspect the verified KIR program before emitting.
(def ^:private unsupported-macos-static-host-ops
  '#{kgraph-assert! kgraph-get kgraph-count kgraph-entity-at
     string-substring string-code-point-at
     typed-list-new typed-list-nth typed-list-conj
     typed-set-new typed-set-count typed-set-contains typed-set-conj
     typed-set-disj typed-set-equal typed-set-nth
     typed-map-new typed-map-count typed-map-contains typed-map-get
     typed-map-entry-at typed-map-assoc typed-map-dissoc typed-map-equal
     typed-map-keys typed-map-vals
     hetero-vector-new hetero-vector-count hetero-vector-at
     hetero-vector-assoc hetero-vector-equal
     vector-new vector-new-empty vector-conj vector-count vector-at
     vector-assoc vector-drop vector-take vector-alloc vector-assoc!
     vector-get vector-f64-new vector-f64-conj vector-f64-count
     vector-f64-at vector-f64-assoc vector-f64-drop vector-f64-get
     vector-f64-take
     bytes-empty bytes-count bytes-at bytes-from-vector bytes-from-vector-i64
     vector-i64-from-bytes bytes-slice bytes-concat
     string-contains? string-replace-all
     string-index-of arena-enter arena-leave arena-scope
     string-compare string-fold-ascii string-find-blank string-skip-blank
     string-index-of-from string-compare-lines
     string-find-byte string-append-range string-from-utf8})

;; The bounded macOS host has no capability provider; do not admit calls just
;; because their request/result descriptors happen to be supported.
(def ^:private macos-static-host-capability-ops
  '#{cap-call typed-cap-call})

(def ^:private macos-static-host-entry-types #{:i64 :bool})
(def ^:private macos-static-host-fuel 512)
;; Keep aligned with KOTOBA_IOS_MAX_CODE_BYTES in kotoba_ios_host.h.
(def ^:private macos-static-host-max-code-bytes (* 1024 1024))

(defn- host-integer-equals? [value expected]
  #?(:clj (and (integer? value) (= value expected))
     :cljs (if (identical? js/BigInt (type value))
             (= value (js/BigInt expected))
             (and (number? value) (js/Number.isSafeInteger value)
                  (= value expected)))))

(defn- reject! [message data]
  (throw (ex-info message (merge {:phase :verify} data))))

(defn- unsupported-macos-static-host-op? [op]
  (or (contains? unsupported-macos-static-host-ops op)
      ;; Native document operations can lower onto string ABI slots, most of
      ;; which the bounded host leaves NULL. Refuse the whole family so a new
      ;; document head cannot bypass the explicit primitive denylist.
      (and (symbol? op)
           (let [op-name (name op)]
             (and (<= 9 (count op-name))
                  (= "document-" (subs op-name 0 9)))))))

(defn- macos-static-host-unsupported-ops [kexe]
  (let [used (volatile! #{})]
    (coll/postwalk
     (fn [form]
       (when (and (seq? form)
                  (unsupported-macos-static-host-op? (first form)))
         (vswap! used conj (first form)))
       form)
     (get-in kexe [:program :functions]))
    @used))

(defn- macos-static-host-unsupported-capability-calls [kexe]
  (let [unsupported (volatile! #{})]
    (coll/postwalk
     (fn [form]
       (when (and (seq? form)
                  (contains? macos-static-host-capability-ops (first form)))
         ;; Keep diagnostics bounded to operation and capability id; arguments
         ;; may contain caller data and are not needed to explain refusal.
         (vswap! unsupported conj [(str (first form)) (str (nth form 1 nil))]))
       form)
     (get-in kexe [:program :functions]))
    (vec (sort-by pr-str @unsupported))))

(defn- supported-macos-static-host-effect? [effect]
  ;; Local state is implemented by the bounded context. Abort is lowered to
  ;; result values and does not need a host callback; external capabilities are
  ;; not supported regardless of their serialized request/result types.
  (contains? #{:state :abort} effect))

(defn- context-abi-v11? [version]
  (host-integer-equals? version 11))

(defn- macos-static-host-bounded-fuel? [kexe]
  ;; The host has no request field for a caller-selected budget and does not
  ;; isolate guest stack use. Accept only the metered 512-word profile; this
  ;; refuses the ordinary macOS target's unmetered default as well.
  (and (not= :off (get-in kexe [:limits :fuel-metering]))
       (host-integer-equals? (get-in kexe [:fuel-abi :initial])
                             macos-static-host-fuel)
       (host-integer-equals? (get-in kexe [:limits :fuel])
                             macos-static-host-fuel)))

(defn- macos-static-host-entry-signature [kexe entry arity]
  (some (fn [function]
          (let [params (:params function)
                param-types (or (:param-types function)
                                (vec (repeat (count params) :i64)))
                result (or (:result function) :i64)]
            (when (and (or (= entry (:name function))
                           (= entry (:source-name function)))
                       (host-integer-equals? arity (count params)))
              {:param-types param-types
               :result result
               :callable-param-contracts? (boolean (seq (:callable-param-contracts function)))
               :callable-result-contract? (some? (:callable-result-contract function))})))
        (get-in kexe [:program :functions])))

(defn- supported-macos-static-host-entry-signature? [signature]
  (and signature
       (vector? (:param-types signature))
       (every? macos-static-host-entry-types (:param-types signature))
       (contains? macos-static-host-entry-types (:result signature))
       (not (:callable-param-contracts? signature))
       (not (:callable-result-contract? signature))))

(defn- reject-unsupported-macos-static-host! [kexe]
  (let [operations (macos-static-host-unsupported-ops kexe)
        capability-calls (macos-static-host-unsupported-capability-calls kexe)
        effects (set (remove supported-macos-static-host-effect? (:effects kexe)))
        context-version (get-in kexe [:context-abi :version])
        gas-scheduled? (contains? (:program kexe) :gas-schedule)
        bounded-fuel? (macos-static-host-bounded-fuel? kexe)
        code-bytes (count (:code kexe))
        code-size-supported? (<= code-bytes macos-static-host-max-code-bytes)]
    (when (or (seq operations) (seq capability-calls) (seq effects)
              (not (context-abi-v11? context-version)) gas-scheduled?
              (not bounded-fuel?) (not code-size-supported?))
      (let [details {:host-profile :kotoba.macos.static-host/v1
                     :operations (vec (sort operations))
                     :capability-calls capability-calls
                     :effects (vec (sort-by pr-str effects))
                     :context-abi-version context-version
                     :gas-scheduled? gas-scheduled?
                     :fuel-abi-initial (get-in kexe [:fuel-abi :initial])
                     :fuel-limit (get-in kexe [:limits :fuel])
                     :fuel-metering (get-in kexe [:limits :fuel-metering])
                     :code-bytes code-bytes
                     :max-code-bytes macos-static-host-max-code-bytes}]
        (reject! (str "macOS static host cannot serve this KEXE operation or ABI profile: "
                      (pr-str details))
                 details)))))

(def ^:private minimum-os
  {:ios [15 0 0]
   :ios-simulator [15 0 0]
   :macos [13 0 0]})

(defn package
  "Verify an Apple arm64 KEXE and return a canonical static Mach-O object and manifest."
  ([kexe entry] (package kexe entry {:platform :ios}))
  ([kexe entry {:keys [platform] :or {platform :ios}}]
   (verifier/verify-artifact! kexe)
   (when-not (symbol? entry)
     (reject! "Apple AOT entry must be a symbol" {:entry entry}))
   (when-not (contains? targets platform)
     (reject! "Apple AOT platform is unsupported" {:platform platform}))
   (when-not (= (get targets platform) (:target kexe))
     (reject! "Apple AOT packaging requires the matching arm64 target"
              {:platform platform :target (:target kexe)
               :expected-target (get targets platform)}))
   (when (= platform :macos)
     (reject-unsupported-macos-static-host! kexe))
   (let [export (get (:exports kexe) entry)]
     (when-not export
       (reject! "Apple AOT entry is not exported" {:entry entry}))
     (let [entry-signature (when (= platform :macos)
                             (macos-static-host-entry-signature kexe entry (:arity export)))]
       (when (and (= platform :macos)
                  (not (supported-macos-static-host-entry-signature? entry-signature)))
         (reject! "macOS static host requires an i64/bool entry boundary"
                  {:entry entry :entry-signature entry-signature
                   :supported-types (vec (sort macos-static-host-entry-types))})))
     (when (and (= platform :macos)
                #?(:clj (> (:arity export) 5)
                   :cljs (if (identical? js/BigInt (type (:arity export)))
                           (> (:arity export) (js/BigInt 5))
                           (> (:arity export) 5))))
       (reject! "macOS static host cannot serve entry arity above five"
                {:entry entry :arity (:arity export) :max-arity 5}))
     (let [;; On the Node host an artifact read back through the kotoba reader
           ;; carries its bytes and offsets as bigint (every integer token is
           ;; one), and `kotoba.object.macho64` asks `integer?` of each byte,
           ;; which says false to a bigint. Narrow them to host numbers here:
           ;; a byte and a code offset are far below 2^53, so this is exact.
           ;; Measured 2026-09-11, the first `package-ios` on the nbb route:
           ;; "invalid Mach-O byte region" on a valid aarch64-ios artifact.
           host-int #?(:clj identity
                       :cljs (fn [x] (if (identical? js/BigInt (type x)) (js/Number x) x)))
           code (mapv host-int (:code kexe))
           offset (host-int (:offset export))
           target-profile (ascii-bytes (get host-target-profiles platform))
           object-vector (macho/encode-object
                          {:machine :aarch64
                           :platform platform
                           :minimum-os (get minimum-os platform)
                           :sections [{:segment "__TEXT" :name "__text" :align 2
                                       :flags 0x80000000 :bytes code}
                                      {:segment "__TEXT" :name "__const" :align 0
                                       :flags 0
                                       :bytes (conj (mapv #(bit-and (int %) 0xff)
                                                          target-profile)
                                                    0)}]
                           :symbols [{:name "_kotoba_ios_code_start" :section 1
                                      :value 0 :external? true :description 0x20}
                                     {:name "_kotoba_ios_code_end" :section 1
                                      :value (count code) :external? true
                                      :description 0x20}
                                     {:name "_kotoba_ios_entry" :section 1
                                      :value offset :external? true :description 0x20}
                                     {:name "_kotoba_ios_target_profile" :section 2
                                      :value 0 :external? true :description 0x20}]})
           ;; The JVM shape is unchanged on purpose: `cli` writes `:object`
           ;; straight to a file and the existing tests read it as bytes, so
           ;; making it portable must not alter what a JVM caller receives.
           ;; `byte-array`/`unchecked-byte` have no ClojureScript equivalent,
           ;; and `object-vector` -- already unsigned ints, and already what
           ;; `:object-sha256` below is computed from -- is the natural peer.
           object #?(:clj (byte-array (map unchecked-byte object-vector))
                     :cljs object-vector)
           manifest {:format (if (= platform :macos)
                               :kotoba.apple-aot/v1
                               :kotoba.ios-aot/v2)
                     :target (get targets platform)
                     :platform platform
                     :host-profile (get host-profiles platform)
                     :host-target-profile (keyword (get host-target-profiles platform))
                     :minimum-os (get minimum-os platform)
                     :target-profile (:target-profile kexe)
                     :artifact-sha256 (:sha256 kexe)
                     :code-sha256 (artifact/sha256 code)
                     :entry {:name entry :offset offset :arity (:arity export)}
                     :object-sha256 (artifact/sha256 object-vector)}]
       {:object object :manifest manifest}))))
))

;; ---------------------------------------------------------------------------
;; THE KOTOBA READING. The KEXE is a `:form/r` (kotoba.form; a `:document` holds
;; 32 items per container, a code vector is thousands), the entry is its symbol
;; name and the platform a keyword. The Mach-O encoder takes its two large
;; sections beside the option document as blobs (`encode-object-blobs`), for the
;; same reason. A rejected artifact TRAPS (`assert`): an export cannot abort
;; with a value a caller sees, as kotoba.verifier/verify-artifact! does not.
;; The object comes back as a `:bytes` leaf of the result Form.

#?(:kotoba
   (defn- trap-form [] [:ref :form/r]
     (let [refused (assert (= 1 0))] (form/nil-form))))

#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k))))

#?(:kotoba
   (defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v)))

#?(:kotoba
   (defn- empty-map [] [:ref :form/r] (form/form-map (form/no-forms))))

;; the code vector (ints 0..255) of the artifact
#?(:kotoba
   (defn- code-from [f [:ref :form/r] i :i64 out :vector-i64] :vector-i64
     (if (>= i (form/count-of f))
       out
       (code-from f (+ i 1) (vector-conj out (form/int-value (form/nth-of f i)))))))

;; the target profile label plus its terminating zero, as bytes
#?(:kotoba
   (defn- profile-bytes [] :vector-i64
     (let [b (string-to-utf8 "aarch64-ios-kotoba-v1")]
       (vector-conj (vector-i64-from-bytes b) 0))))

#?(:kotoba
   (defn- section-spec [name :string align :i64 flags :i64 blob :i64] :document
     (document-map :segment (document-string "__TEXT")
                   :name (document-string name)
                   :align (document-i64 align)
                   :flags (document-i64 flags)
                   :blob (document-i64 blob))))

#?(:kotoba
   (defn- symbol-spec [name :string section :i64 value :i64] :document
     (document-map :name (document-string name)
                   :section (document-i64 section)
                   :value (document-i64 value)
                   :external? (document-bool true)
                   :description (document-i64 32))))

#?(:kotoba
   ;; the encoder aborts on a malformed option document (it cannot here: the
   ;; document is built from validated parts); `-or-empty` answers the empty
   ;; object then, which `package` traps on
   (defn- object-vector [platform :keyword code :vector-i64 offset :i64] :vector-i64
     (macho/encode-object-blobs-or-empty
      (document-map :machine (document-keyword :aarch64)
                    :platform (document-keyword platform)
                    :minimum-os (document-vector (document-i64 15) (document-i64 0) (document-i64 0))
                    :sections (document-vector (section-spec "__text" 2 2147483648 0)
                                               (section-spec "__const" 0 0 1))
                    :symbols (document-vector (symbol-spec "_kotoba_ios_code_start" 1 0)
                                              (symbol-spec "_kotoba_ios_code_end" 1 (vector-count code))
                                              (symbol-spec "_kotoba_ios_entry" 1 offset)
                                              (symbol-spec "_kotoba_ios_target_profile" 2 0)))
      code (profile-bytes))))

;; a vector Form of ints, for the digest the host takes of the same vector
#?(:kotoba
   (defn- ints-form [v :vector-i64 i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count v))
       acc
       (ints-form v (+ i 1) (form/append-form acc (form/int-form (vector-at v i)))))))

#?(:kotoba
   (defn- manifest-of [kexe [:ref :form/r] entry :string platform :keyword export [:ref :form/r]
                       obj :vector-i64] [:ref :form/r]
     (let [offset (fget export :offset)
           entry-form (put (put (put (empty-map) :name (form/symbol-form entry))
                                :offset offset)
                           :arity (fget export :arity))]
       (put (put (put (put (put (put (put (put (put (empty-map)
              :format (form/keyword-form :kotoba.ios-aot/v2))
              :target (form/keyword-form :aarch64-ios-kotoba-v1))
              :platform (form/keyword-form platform))
              :minimum-os (form/form-vec (form/three-forms (form/int-form 15) (form/int-form 0) (form/int-form 0))))
              :target-profile (fget kexe :target-profile))
              :artifact-sha256 (fget kexe :sha256))
              :code-sha256 (form/string-form (seal/sha256-form (fget kexe :code))))
              :entry entry-form)
              :object-sha256 (form/string-form (seal/sha256-form (form/form-vec (ints-form obj 0 (form/no-forms)))))))))

#?(:kotoba
   (defn- platform-ok? [platform :keyword] :bool
     (or (= platform :ios) (= platform :ios-simulator))))

;; {:object :manifest} of a verified artifact; PLATFORM is :ios or :ios-simulator
#?(:kotoba
   (defn package [kexe [:ref :form/r] entry :string platform :keyword] [:ref :form/r]
     (let [verified (verifier/verify-artifact! kexe)]
       (if (form/eq (fget kexe :target) (form/keyword-form :aarch64-ios-kotoba-v1))
         (if (platform-ok? platform)
           (let [export (form/form-get (fget kexe :exports) (form/symbol-form entry))]
             (if (form/is-map? export)
               (let [code (code-from (fget kexe :code) 0 (vector-i64))
                     obj (object-vector platform code (form/int-value (fget export :offset)))]
                 (if (= 0 (vector-count obj))
                   (trap-form)
                   (put (put (empty-map) :object (form/bytes-form (bytes-from-vector-i64 obj)))
                        :manifest (manifest-of kexe entry platform export obj))))
               (trap-form)))
           (trap-form))
         (trap-form)))))
