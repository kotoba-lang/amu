(ns kotoba.compiler.ios-aot
  {:kotoba/export [package]}
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.verifier.seal :as seal]]
                :default [[kotoba.artifact.core :as artifact]])
            [kotoba.object.macho64 :as macho]
            [kotoba.verifier :as verifier])
  #?(:clj (:import [java.nio.charset StandardCharsets]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

;; ASCII text as bytes. `.getBytes` is JVM-only; the string this is applied to
;; is the fixed target-profile label, so the two agree byte for byte. Mirrors
;; the `utf8-bytes` helpers in kotoba.native.aarch64 and .elf64.
#?(:kotoba nil :default (defn- ascii-bytes [^String s]
  #?(:clj (.getBytes s StandardCharsets/US_ASCII)
     :cljs (js/Array.from (.encode (js/TextEncoder.) s)))))

#?(:kotoba nil :default (def ^:private ios-target :aarch64-ios-kotoba-v1))

#?(:kotoba nil :default (defn- reject! [message data]
  (throw (ex-info message (merge {:phase :verify} data)))))

#?(:kotoba nil :default (def ^:private platforms #{:ios :ios-simulator}))
#?(:kotoba nil :default (def ^:private minimum-os [15 0 0]))

#?(:kotoba nil :default (defn package
  "Verify an iOS KEXE and return a canonical static Mach-O object plus manifest."
  ([kexe entry] (package kexe entry {:platform :ios}))
  ([kexe entry {:keys [platform] :or {platform :ios}}]
   (verifier/verify-artifact! kexe)
   (when-not (= ios-target (:target kexe))
     (reject! "iOS AOT packaging requires the explicit iOS target"
              {:target (:target kexe)}))
   (when-not (symbol? entry)
     (reject! "iOS AOT entry must be a symbol" {:entry entry}))
   (when-not (contains? platforms platform)
     (reject! "iOS AOT platform is unsupported" {:platform platform}))
   (let [export (get (:exports kexe) entry)]
     (when-not export
       (reject! "iOS AOT entry is not exported" {:entry entry}))
     (let [;; On the Node host an artifact read back through the kotoba reader
           ;; carries its bytes and offsets as bigint (every integer token is
           ;; one), and `kotoba.object.macho64` asks `integer?` of each byte,
           ;; which says false to a bigint. Narrow them to host numbers here:
           ;; a byte and a code offset are far below 2^53, so this is exact.
           ;; Measured 2026-09-11, the first `package-ios` on the nbb route:
           ;; "invalid Mach-O byte region" on a valid aarch64-ios artifact.
           host-int #?(:clj identity
                       :cljs (fn [x] (if (identical? js/BigInt (type x)) (js/Number x) x)))
           code (mapv host-int (:code kexe))
           offset (host-int (:offset export))
           target-profile (ascii-bytes "aarch64-ios-kotoba-v1")
           object-vector (macho/encode-object
                          {:machine :aarch64
                           :platform platform
                           :minimum-os minimum-os
                           :sections [{:segment "__TEXT" :name "__text" :align 2
                                       :flags 0x80000000 :bytes code}
                                      {:segment "__TEXT" :name "__const" :align 0
                                       :flags 0
                                       :bytes (conj (mapv #(bit-and (int %) 0xff)
                                                          target-profile)
                                                    0)}]
                           :symbols [{:name "_kotoba_ios_code_start" :section 1
                                      :value 0 :external? true :description 0x20}
                                     {:name "_kotoba_ios_code_end" :section 1
                                      :value (count code) :external? true
                                      :description 0x20}
                                     {:name "_kotoba_ios_entry" :section 1
                                      :value offset :external? true :description 0x20}
                                     {:name "_kotoba_ios_target_profile" :section 2
                                      :value 0 :external? true :description 0x20}]})
           ;; The JVM shape is unchanged on purpose: `cli` writes `:object`
           ;; straight to a file and the existing tests read it as bytes, so
           ;; making it portable must not alter what a JVM caller receives.
           ;; `byte-array`/`unchecked-byte` have no ClojureScript equivalent,
           ;; and `object-vector` -- already unsigned ints, and already what
           ;; `:object-sha256` below is computed from -- is the natural peer.
           object #?(:clj (byte-array (map unchecked-byte object-vector))
                     :cljs object-vector)
           manifest {:format :kotoba.ios-aot/v2
                     :target ios-target
                     :platform platform
                     :minimum-os minimum-os
                     :target-profile (:target-profile kexe)
                     :artifact-sha256 (:sha256 kexe)
                     :code-sha256 (artifact/sha256 code)
                     :entry {:name entry :offset offset :arity (:arity export)}
                     :object-sha256 (artifact/sha256 object-vector)}]
       {:object object :manifest manifest})))))

;; ---------------------------------------------------------------------------
;; THE KOTOBA READING. The KEXE is a `:form/r` (kotoba.form; a `:document` holds
;; 32 items per container, a code vector is thousands), the entry is its symbol
;; name and the platform a keyword. The Mach-O encoder takes its two large
;; sections beside the option document as blobs (`encode-object-blobs`), for the
;; same reason. A rejected artifact TRAPS (`assert`): an export cannot abort
;; with a value a caller sees, as kotoba.verifier/verify-artifact! does not.
;; The object comes back as a `:bytes` leaf of the result Form.

#?(:kotoba
   (defn- trap-form [] [:ref :form/r]
     (let [refused (assert (= 1 0))] (form/nil-form))))

#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k))))

#?(:kotoba
   (defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v)))

#?(:kotoba
   (defn- empty-map [] [:ref :form/r] (form/form-map (form/no-forms))))

;; the code vector (ints 0..255) of the artifact
#?(:kotoba
   (defn- code-from [f [:ref :form/r] i :i64 out :vector-i64] :vector-i64
     (if (>= i (form/count-of f))
       out
       (code-from f (+ i 1) (vector-conj out (form/int-value (form/nth-of f i)))))))

;; the target profile label plus its terminating zero, as bytes
#?(:kotoba
   (defn- profile-bytes [] :vector-i64
     (let [b (string-to-utf8 "aarch64-ios-kotoba-v1")]
       (vector-conj (vector-i64-from-bytes b) 0))))

#?(:kotoba
   (defn- section-spec [name :string align :i64 flags :i64 blob :i64] :document
     (document-map :segment (document-string "__TEXT")
                   :name (document-string name)
                   :align (document-i64 align)
                   :flags (document-i64 flags)
                   :blob (document-i64 blob))))

#?(:kotoba
   (defn- symbol-spec [name :string section :i64 value :i64] :document
     (document-map :name (document-string name)
                   :section (document-i64 section)
                   :value (document-i64 value)
                   :external? (document-bool true)
                   :description (document-i64 32))))

#?(:kotoba
   ;; the encoder aborts on a malformed option document (it cannot here: the
   ;; document is built from validated parts); `-or-empty` answers the empty
   ;; object then, which `package` traps on
   (defn- object-vector [platform :keyword code :vector-i64 offset :i64] :vector-i64
     (macho/encode-object-blobs-or-empty
      (document-map :machine (document-keyword :aarch64)
                    :platform (document-keyword platform)
                    :minimum-os (document-vector (document-i64 15) (document-i64 0) (document-i64 0))
                    :sections (document-vector (section-spec "__text" 2 2147483648 0)
                                               (section-spec "__const" 0 0 1))
                    :symbols (document-vector (symbol-spec "_kotoba_ios_code_start" 1 0)
                                              (symbol-spec "_kotoba_ios_code_end" 1 (vector-count code))
                                              (symbol-spec "_kotoba_ios_entry" 1 offset)
                                              (symbol-spec "_kotoba_ios_target_profile" 2 0)))
      code (profile-bytes))))

;; a vector Form of ints, for the digest the host takes of the same vector
#?(:kotoba
   (defn- ints-form [v :vector-i64 i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count v))
       acc
       (ints-form v (+ i 1) (form/append-form acc (form/int-form (vector-at v i)))))))

#?(:kotoba
   (defn- manifest-of [kexe [:ref :form/r] entry :string platform :keyword export [:ref :form/r]
                       obj :vector-i64] [:ref :form/r]
     (let [offset (fget export :offset)
           entry-form (put (put (put (empty-map) :name (form/symbol-form entry))
                                :offset offset)
                           :arity (fget export :arity))]
       (put (put (put (put (put (put (put (put (put (empty-map)
              :format (form/keyword-form :kotoba.ios-aot/v2))
              :target (form/keyword-form :aarch64-ios-kotoba-v1))
              :platform (form/keyword-form platform))
              :minimum-os (form/form-vec (form/three-forms (form/int-form 15) (form/int-form 0) (form/int-form 0))))
              :target-profile (fget kexe :target-profile))
              :artifact-sha256 (fget kexe :sha256))
              :code-sha256 (form/string-form (seal/sha256-form (fget kexe :code))))
              :entry entry-form)
              :object-sha256 (form/string-form (seal/sha256-form (form/form-vec (ints-form obj 0 (form/no-forms)))))))))

#?(:kotoba
   (defn- platform-ok? [platform :keyword] :bool
     (or (= platform :ios) (= platform :ios-simulator))))

;; {:object :manifest} of a verified artifact; PLATFORM is :ios or :ios-simulator
#?(:kotoba
   (defn package [kexe [:ref :form/r] entry :string platform :keyword] [:ref :form/r]
     (let [verified (verifier/verify-artifact! kexe)]
       (if (form/eq (fget kexe :target) (form/keyword-form :aarch64-ios-kotoba-v1))
         (if (platform-ok? platform)
           (let [export (form/form-get (fget kexe :exports) (form/symbol-form entry))]
             (if (form/is-map? export)
               (let [code (code-from (fget kexe :code) 0 (vector-i64))
                     obj (object-vector platform code (form/int-value (fget export :offset)))]
                 (if (= 0 (vector-count obj))
                   (trap-form)
                   (put (put (empty-map) :object (form/bytes-form (bytes-from-vector-i64 obj)))
                        :manifest (manifest-of kexe entry platform export obj))))
               (trap-form)))
           (trap-form))
         (trap-form)))))
