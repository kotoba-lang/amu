(ns kotoba.compiler.packaging.aiueos-disk
  "Amu-owned deterministic GPT/FAT32 packaging for the Kotoba desktop image.

  This is the host-side half of the AIUEOS image path. It replaces the Python
  image writer with the same Nbb-hosted packaging code that builds the PE
  loader, and checks the GPT and FAT chain before returning the image bytes."
  {:kotoba/export [package]}
  #?(:cljs (:require ["node:crypto" :as crypto])))

#?(:cljs
(do
(def ^:private sector 512)
(def ^:private disk-sectors 131072)
(def ^:private esp-first 2048)
(def ^:private entry-count 128)
(def ^:private entry-size 128)
(def ^:private entry-sectors 32)
(def ^:private backup-entries (- disk-sectors 1 entry-sectors))
(def ^:private esp-last (dec backup-entries))
(def ^:private esp-sectors (inc (- esp-last esp-first)))
(def ^:private disk-bytes (* disk-sectors sector))
(def ^:private esp-type [40 115 42 193 31 248 210 17 186 75 0 160 201 62 201 59])
(def ^:private desktop-disk-guid [59 191 125 100 206 80 121 88 135 108 101 100 178 180 231 176])
(def ^:private desktop-esp-guid [40 195 36 125 18 251 74 85 161 220 252 199 160 135 13 70])

(defn- buffer [size] (js/Buffer.alloc size))

(defn- u8! [out offset value]
  (.writeUInt8 out (bit-and value 255) offset))

(defn- u16! [out offset value]
  (.writeUInt16LE out (bit-and value 65535) offset))

(defn- u32! [out offset value]
  (.writeUInt32LE out value offset))

(defn- u64! [out offset value]
  (.writeUInt32LE out (mod value 4294967296) offset)
  (.writeUInt32LE out (quot value 4294967296) (+ offset 4)))

(defn- copy! [source start end target offset]
  (.copy source target offset start end))

(defn- bytes! [target offset values]
  (doseq [[index value] (map-indexed vector values)]
    (u8! target (+ offset index) value)))

(defn- ascii! [target offset text]
  (doseq [index (range (count text))]
    (u8! target (+ offset index) (.charCodeAt text index))))

(defn- crc32 [data start length]
  (loop [index 0 crc 0xffffffff]
    (if (= index length)
      (unsigned-bit-shift-right (bit-xor crc 0xffffffff) 0)
      (let [next (bit-xor crc (.readUInt8 data (+ start index)))
            final (loop [bit 0 value next]
                    (if (= bit 8)
                      value
                      (recur (inc bit)
                             (if (= (bit-and value 1) 1)
                               (bit-xor (unsigned-bit-shift-right value 1) 0xedb88320)
                               (unsigned-bit-shift-right value 1)))))
            signed (if (> final 2147483647) (- final 4294967296) final)]
        (recur (inc index) signed)))))

(defn- dos-name [name]
  (if (or (= name ".") (= name ".."))
    (str name (apply str (repeat (- 11 (count name)) " ")))
    (let [parts (.split (.toUpperCase name) #"\.")
          stem (first parts)
          suffix (or (second parts) "")]
      (str (.substring (str stem "        ") 0 8)
           (.substring (str suffix "   ") 0 3)))))

(defn- dirent! [target offset name attr cluster size]
  (ascii! target offset (dos-name name))
  (u8! target (+ offset 11) attr)
  (doseq [date-offset [16 18 24]]
    (u16! target (+ offset date-offset) 0x21))
  (u16! target (+ offset 20) (quot cluster 65536))
  (u16! target (+ offset 26) (mod cluster 65536))
  (u32! target (+ offset 28) size))

(defn- fat32 [efi]
  (let [reserved 32
        fats 2
        denominator (+ sector (* fats 4))
        fat-sectors (quot (+ (* (+ (- esp-sectors reserved) 2) 4)
                             (dec denominator))
                          denominator)
        data-start (+ reserved (* fats fat-sectors))
        clusters (- esp-sectors data-start)
        result (buffer (* esp-sectors sector))
        boot (buffer sector)
        fsinfo (buffer sector)
        fat (buffer (* fat-sectors sector))
        root 2
        efi-dir 3
        boot-dir 4
        file-count (max 1 (quot (+ (.-length efi) (dec sector)) sector))
        first-file 5]
    (when (< clusters 65525)
      (throw (ex-info "ESP is too small for FAT32" {:phase :artifact-target})))
    (when (> (+ first-file file-count) (+ clusters 2))
      (throw (ex-info "BOOTX64.EFI does not fit in ESP" {:phase :artifact-target})))
    (bytes! boot 0 [0xeb 0x58 0x90])
    (ascii! boot 3 "AIUEHWP ")
    (u16! boot 11 sector)
    (u8! boot 13 1)
    (u16! boot 14 reserved)
    (u8! boot 16 fats)
    (u16! boot 17 0)
    (u16! boot 19 0)
    (u8! boot 21 0xf8)
    (u16! boot 22 0)
    (u16! boot 24 63)
    (u16! boot 26 255)
    (u32! boot 28 esp-first)
    (u32! boot 32 esp-sectors)
    (u32! boot 36 fat-sectors)
    (u16! boot 40 0)
    (u16! boot 42 0)
    (u32! boot 44 root)
    (u16! boot 48 1)
    (u16! boot 50 6)
    (u8! boot 64 0x80)
    (u8! boot 66 0x29)
    (u32! boot 67 0x48575052)
    (ascii! boot 71 "AIUE KOTOB ")
    (ascii! boot 82 "FAT32   ")
    (bytes! boot 510 [0x55 0xaa])
    (copy! boot 0 sector result 0)
    (copy! boot 0 sector result (* 6 sector))
    (u32! fsinfo 0 0x41615252)
    (u32! fsinfo 484 0x61417272)
    (u32! fsinfo 488 0xffffffff)
    (u32! fsinfo 492 0xffffffff)
    (u32! fsinfo 508 0xaa550000)
    (copy! fsinfo 0 sector result sector)
    (copy! fsinfo 0 sector result (* 7 sector))
    (u32! fat 0 0x0ffffff8)
    (u32! fat 4 0x0fffffff)
    (doseq [cluster [root efi-dir boot-dir]]
      (u32! fat (* cluster 4) 0x0fffffff))
    (doseq [index (range file-count)]
      (let [cluster (+ first-file index)
            next (if (= index (dec file-count)) 0x0fffffff (inc cluster))
            start (* index sector)
            end (min (.-length efi) (+ start sector))
            target-offset (* (+ data-start (- cluster 2)) sector)]
        (u32! fat (* cluster 4) next)
        (copy! efi start end result target-offset)))
    (let [root-offset (* (+ data-start (- root 2)) sector)
          efi-offset (* (+ data-start (- efi-dir 2)) sector)
          boot-offset (* (+ data-start (- boot-dir 2)) sector)]
      (dirent! result root-offset "EFI" 0x10 efi-dir 0)
      (dirent! result efi-offset "." 0x10 efi-dir 0)
      (dirent! result (+ efi-offset 32) ".." 0x10 root 0)
      (dirent! result (+ efi-offset 64) "BOOT" 0x10 boot-dir 0)
      (dirent! result boot-offset "." 0x10 boot-dir 0)
      (dirent! result (+ boot-offset 32) ".." 0x10 efi-dir 0)
      (dirent! result (+ boot-offset 64) "BOOTX64.EFI" 0x20 first-file (.-length efi)))
    (doseq [copy [0 1]]
      (copy! fat 0 (.-length fat) result (* (+ reserved (* copy fat-sectors)) sector)))
    result))

(defn- gpt-header [current backup entries-lba entries-crc]
  (let [header (buffer sector)]
    (ascii! header 0 "EFI PART")
    (u32! header 8 0x00010000)
    (u32! header 12 92)
    (u32! header 16 0)
    (u32! header 20 0)
    (u64! header 24 current)
    (u64! header 32 backup)
    (u64! header 40 esp-first)
    (u64! header 48 esp-last)
    (bytes! header 56 desktop-disk-guid)
    (u64! header 72 entries-lba)
    (u32! header 80 entry-count)
    (u32! header 84 entry-size)
    (u32! header 88 entries-crc)
    (u32! header 16 (crc32 header 0 92))
    header))

(defn- gpt-entries []
  (let [entries (buffer (* entry-sectors sector))]
    (bytes! entries 0 esp-type)
    (bytes! entries 16 desktop-esp-guid)
    (u64! entries 32 esp-first)
    (u64! entries 40 esp-last)
    (u64! entries 48 0)
    (doseq [index (range (count "AIUEOS KOTOBA DESKTOP"))]
      (u16! entries (+ 56 (* index 2))
            (.charCodeAt "AIUEOS KOTOBA DESKTOP" index)))
    entries))

(defn- image [efi]
  ;; /EFI/BOOT/BOOTX6.EFI on a UEFI machine boots only an x86-64 PE32+ EFI
  ;; application: check the PE signature at e_lfanew, the machine, the
  ;; optional-header magic and the subsystem rather than trusting `MZ`.
  (let [length (.-length efi)]
    (when (or (< length 64)
              (not= (.toString (.subarray efi 0 2) "ascii") "MZ"))
      (throw (ex-info "bootloader is not PE/COFF" {:phase :artifact-target})))
    (let [pe-offset (.readUInt32LE efi 0x3c)]
      (when (or (< pe-offset 0x40)
                (> (+ pe-offset 94) length)
                (not= 0x00004550 (.readUInt32LE efi pe-offset)))
        (throw (ex-info "bootloader is not PE32+" {:phase :artifact-target})))
      (when (not= 0x8664 (.readUInt16LE efi (+ pe-offset 4)))
        (throw (ex-info "bootloader is not x86-64" {:phase :artifact-target})))
      (when (or (< (.readUInt16LE efi (+ pe-offset 20)) 70)
                (not= 0x20b (.readUInt16LE efi (+ pe-offset 24))))
        (throw (ex-info "bootloader is not PE32+" {:phase :artifact-target})))
      (when (not= 10 (.readUInt16LE efi (+ pe-offset 92)))
        (throw (ex-info "bootloader is not an EFI application" {:phase :artifact-target})))))
  (let [disk (buffer disk-bytes)
        entries (gpt-entries)
        entries-crc (crc32 entries 0 (.-length entries))
        primary (gpt-header 1 (dec disk-sectors) 2 entries-crc)
        backup (gpt-header (dec disk-sectors) 1 backup-entries entries-crc)
        esp (fat32 efi)]
    (bytes! disk 446 [0 0 2 0 0xee 0xff 0xff 0xff])
    (u32! disk 454 1)
    (u32! disk 458 (dec disk-sectors))
    (bytes! disk 510 [0x55 0xaa])
    (copy! primary 0 sector disk sector)
    (copy! entries 0 (.-length entries) disk (* 2 sector))
    (copy! entries 0 (.-length entries) disk (* backup-entries sector))
    (copy! backup 0 sector disk (* (dec disk-sectors) sector))
    (copy! esp 0 (.-length esp) disk (* esp-first sector))
    disk))

(defn- find-entry [disk esp-offset data-start directory name]
  (let [offset (+ esp-offset (* (+ data-start (- directory 2)) sector))
        wanted (dos-name name)]
    (loop [index 0]
      (when (= index 16)
        (throw (ex-info (str "missing " name) {:phase :artifact-target})))
      (let [at (+ offset (* index 32))
            first (.readUInt8 disk at)]
        (if (zero? first)
          (throw (ex-info (str "missing " name) {:phase :artifact-target}))
          (if (= (.toString (.subarray disk at (+ at 11)) "ascii") wanted)
            {:cluster (+ (* (.readUInt16LE disk (+ at 20)) 65536)
                         (.readUInt16LE disk (+ at 26)))
             :size (.readUInt32LE disk (+ at 28))}
            (recur (inc index))))))))

(defn- verify! [disk expected]
  (when (or (not= (.-length disk) disk-bytes)
            (not= (.toString (.subarray disk sector (+ sector 8)) "ascii") "EFI PART"))
    (throw (ex-info "invalid GPT disk image" {:phase :artifact-target})))
  (let [header (js/Buffer.from (.subarray disk sector (+ sector 92)))
        stored (.readUInt32LE header 16)
        _ (u32! header 16 0)
        backup-offset (- disk-bytes sector)
        backup-header (js/Buffer.from (.subarray disk backup-offset (+ backup-offset 92)))
        backup-stored (.readUInt32LE backup-header 16)
        _ (u32! backup-header 16 0)
        entries (.subarray disk (* 2 sector) (* (+ 2 entry-sectors) sector))
        entries-crc (crc32 entries 0 (.-length entries))]
    (when (or (not= (crc32 header 0 92) stored)
              (not= entries-crc (.readUInt32LE header 88))
              (not= (.toString (.subarray backup-header 0 8) "ascii") "EFI PART")
              (not= (crc32 backup-header 0 92) backup-stored)
              (not= (.compare entries
                              (.subarray disk (* backup-entries sector)
                                         (* (+ backup-entries entry-sectors) sector)))
                    0)
              (not= (.toString (.subarray entries 0 16) "hex")
                    (.toString (js/Buffer.from (clj->js esp-type)) "hex")))
      (throw (ex-info "invalid primary GPT metadata" {:phase :artifact-target}))))
  (let [esp-offset (* esp-first sector)
        fat-sectors (.readUInt32LE disk (+ esp-offset 36))
        reserved (.readUInt16LE disk (+ esp-offset 14))
        data-start (+ reserved (* 2 fat-sectors))
        fat (.subarray disk (+ esp-offset (* reserved sector))
                       (+ esp-offset (* (+ reserved fat-sectors) sector)))
        fat-entry (fn [cluster] (bit-and (.readUInt32LE fat (* cluster 4)) 0x0fffffff))
        efi-dir (:cluster (find-entry disk esp-offset data-start 2 "EFI"))
        boot-dir (:cluster (find-entry disk esp-offset data-start efi-dir "BOOT"))
        file (find-entry disk esp-offset data-start boot-dir "BOOTX64.EFI")
        payload (buffer (:size file))]
    (when (not= (.toString (.subarray disk (+ esp-offset 82) (+ esp-offset 90)) "ascii")
                "FAT32   ")
      (throw (ex-info "missing FAT32 ESP" {:phase :artifact-target})))
    (loop [cluster (:cluster file) copied 0 visited #{}]
      (when (< copied (:size file))
        (when (or (< cluster 2) (>= cluster 0x0ffffff8) (contains? visited cluster))
          (throw (ex-info "invalid BOOTX64.EFI cluster chain" {:phase :artifact-target})))
        (let [from (* (+ esp-offset (* (+ data-start (- cluster 2)) sector)) 1)
              amount (min sector (- (:size file) copied))]
          (copy! disk from (+ from amount) payload copied)
          (recur (fat-entry cluster) (+ copied amount) (conj visited cluster)))))
    (when (or (not= (.compare payload expected) 0)
              (not= (.toString (.subarray disk (- disk-bytes sector)
                                           (+ (- disk-bytes sector) 8)) "ascii") "EFI PART"))
      (throw (ex-info "BOOTX64.EFI or backup GPT mismatch" {:phase :artifact-target}))))
  true)

(defn- sha256 [bytes]
  (let [digest (.createHash crypto "sha256")]
    (.update digest bytes)
    (.digest digest "hex")))

(defn package
  "Build, validate, and describe the deterministic Kotoba desktop GPT image."
  [efi]
  (let [disk (image efi)]
    (verify! disk efi)
    {:bytes disk
     :receipt {"schema" "aiueos.kotoba-desktop-build-receipt/v1"
               "created" "1970-01-01T00:00:00Z"
               "profile" "aiueos-native-desktop-disk"
               "packager_route" "amu-nbb"
               "disk" {"bytes" (.-length disk) "sha256" (sha256 disk)}
               "artifacts" {"EFI/BOOT/BOOTX64.EFI"
                            {"bytes" (.-length efi) "sha256" (sha256 efi)}}}}))))

#?(:clj
(defn package [_]
  (throw (ex-info "AIUEOS disk packaging requires the Amu/Nbb host"
                  {:phase :host-implementation}))))
