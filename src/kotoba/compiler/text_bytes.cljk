(ns kotoba.compiler.text-bytes
  "Text and bytes, measured and converted -- leaves with two readings
  (superproject adr-2609242330 section 1 (b), the S1 leaf pattern).

  The Kotoba reader delegates to `text_bytes_core.kotoba`, where strings and
  bytes use Kotoba's native types and primitives. Under nbb a string is UTF-16 and bytes are a
  Uint8Array, and each leaf is the Node call the compiler used before
  (Buffer.byteLength, .length, a fatal TextDecoder). Not abilities:
  measuring or decoding a value observes nothing.

  `utf8-text` refuses what is not canonical UTF-8 in both readings: the
  fatal decoder throws, `string-from-utf8` traps by name."
  {:kotoba/export #?(:kotoba [byte-at bytes-from-ints bytes-length concat-bytes empty-bytes index-of-byte slice-bytes utf8-bytes utf8-length utf8-text utf8-text-lossy utf8-valid?]
                     :default [byte-at bytes-from-ints bytes-length concat-bytes empty-bytes index-of-byte slice-bytes utf8-bytes utf8-length utf8-text utf8-text-lossy])}
  (:require #?(:kotoba [kotoba.compiler.text-bytes-core :as text-core])))

(defn utf8-length
  "The number of bytes TEXT occupies in UTF-8."
  [#?@(:kotoba [text :string] :default [text])] #?@(:kotoba [:i64])
  #?(:kotoba (text-core/utf8-length text)
     :cljs (.byteLength js/Buffer text "utf8")
     :default (string-byte-length text)))

(defn bytes-length
  "The number of bytes in BYTES."
  [#?@(:kotoba [bytes :bytes] :default [bytes])] #?@(:kotoba [:i64])
  #?(:kotoba (text-core/bytes-length bytes)
     :cljs (.-length bytes)
     :default (bytes-count bytes)))

(defn utf8-text
  "BYTES decoded as UTF-8; refused when they are not canonical UTF-8."
  [#?@(:kotoba [bytes :bytes] :default [bytes])] #?@(:kotoba [:string])
  #?(:kotoba (text-core/utf8-text bytes)
     :cljs (.decode (js/TextDecoder. "utf-8" #js {:fatal true}) bytes)
     :default (string-from-utf8 bytes)))

(defn bytes-from-ints
  "Bytes holding the integers of INTS in order, each already 0..255."
  [#?@(:kotoba [ints :vector-i64] :default [ints])] #?@(:kotoba [:bytes])
  #?(:kotoba (text-core/bytes-from-ints ints)
     :cljs (if (every? (fn [value] (and (<= 0 value) (<= value 255))) ints)
             (js/Buffer.from (clj->js (vec ints)))
             (throw (js/RangeError. "bytes/item-out-of-range")))
     :default (bytes-from-vector-i64 ints)))

(defn utf8-bytes
  "TEXT's UTF-8 bytes. The Kotoba primitive preserves every UTF-8 byte,
  including continuation bytes above 127."
  [#?@(:kotoba [text :string] :default [text])] #?@(:kotoba [:bytes])
  #?(:kotoba (text-core/utf8-bytes text)
     :cljs (.from js/Buffer text "utf8")
     :default (string-to-utf8 text)))

;; Host-only compatibility helper. Kotoba's admitted decoder is strict; keep
;; this out of the native module export until a lossy core operation exists.
(defn utf8-text-lossy
  "BYTES decoded as UTF-8, an invalid sequence read as U+FFFD -- what
  Buffer#toString(\"utf8\") answers. Kotoba has no lossy decoder, so its
  reading refuses such bytes by name (string-from-utf8)."
  [#?@(:kotoba [bytes :bytes] :default [bytes])] #?@(:kotoba [:string])
  #?(:kotoba (text-core/utf8-text bytes)
     :cljs (.toString bytes "utf8")
     :default (string-from-utf8 bytes)))

(defn empty-bytes
  "Bytes of length 0."
  [] #?@(:kotoba [:bytes])
  #?(:kotoba (text-core/empty-bytes)
     :cljs (.alloc js/Buffer 0)
     :default (bytes-empty)))

(defn concat-bytes
  "A followed by B."
  [#?@(:kotoba [a :bytes b :bytes] :default [a b])] #?@(:kotoba [:bytes])
  #?(:kotoba (text-core/concat-bytes a b)
     :cljs (.concat js/Buffer #js [a b])
     :default (bytes-concat a b)))

(defn byte-at
  "The byte at offset I of BYTES, 0..255."
  [#?@(:kotoba [bytes :bytes i :i64] :default [bytes i])] #?@(:kotoba [:i64])
  #?(:kotoba (text-core/byte-at bytes i)
     :cljs (if (and (<= 0 i) (< i (.-length bytes)))
             (aget bytes i)
             (throw (js/RangeError. "bytes/index-out-of-range")))
     :default (bytes-at bytes i)))

(defn slice-bytes
  "BYTES from START (inclusive) to END (exclusive). Under nbb a view that
  shares the buffer (subarray), as the callers used before."
  [#?@(:kotoba [bytes :bytes start :i64 end :i64] :default [bytes start end])] #?@(:kotoba [:bytes])
  #?(:kotoba (text-core/slice-bytes bytes start end)
     :cljs (if (and (<= 0 start) (<= start end) (<= end (.-length bytes)))
             (.subarray bytes start end)
             (throw (js/RangeError. "bytes/slice-bounds")))
     :default (bytes-slice bytes start end)))

(defn index-of-byte
  "The first offset of the byte B in BYTES, or -1."
  [#?@(:kotoba [bytes :bytes b :i64] :default [bytes b])] #?@(:kotoba [:i64])
  #?(:kotoba (text-core/index-of-byte bytes b)
     :cljs (if (and (<= 0 b) (<= b 255))
             (.indexOf bytes b)
             -1)
     :default (loop [i 0]
                (cond (>= i (bytes-count bytes)) -1
                      (= b (bytes-at bytes i)) i
                      :else (recur (inc i))))))

;; Kotoba only (2026-10-10): whether BYTES are canonical UTF-8, so a reader can
;; refuse malformed input BY NAME before `string-from-utf8`, which traps (the
;; loader's value trap :utf8/invalid-byte, exit 120) and leaves nothing to
;; catch. The walk is the loader's utf8_invalid_reason (tools/kexe_loader.c,
;; = osaho kotoba.kir.value/utf8-invalid-at): no stray continuation byte, no
;; overlong lead (C0 C1, E0 below A0, F0 below 90), no surrogate (ED A0..),
;; nothing above U+10FFFF (F4 90.., F5..), no truncated sequence. It accepts
;; exactly what `string-from-utf8` accepts, and what the host's fatal
;; TextDecoder accepts. The host readings keep their decoder's own refusal.
#?(:kotoba
   (defn- utf8-continuation? [b :i64] :bool
     (= 128 (bit-and b 192))))

#?(:kotoba
   (defn utf8-valid? [bytes :bytes] :bool
     (let [n (bytes-count bytes)]
       (loop [i 0]
         (if (>= i n)
           true
           (let [b0 (bytes-at bytes i)]
             (cond
               (< b0 128) (recur (+ i 1))
               (or (< b0 194) (> b0 244)) false
               (>= (+ i 1) n) false
               :else
               (let [b1 (bytes-at bytes (+ i 1))
                     k (if (< b0 224) 1 (if (< b0 240) 2 3))]
                 (if (or (not (utf8-continuation? b1))
                         (and (= b0 224) (< b1 160))
                         (and (= b0 240) (< b1 144))
                         (and (= b0 237) (>= b1 160))
                         (and (= b0 244) (>= b1 144))
                         (>= (+ i k) n)
                         (and (>= k 2) (not (utf8-continuation? (bytes-at bytes (+ i 2)))))
                         (and (>= k 3) (not (utf8-continuation? (bytes-at bytes (+ i 3))))))
                   false
                   (recur (+ i (+ k 1))))))))))))
