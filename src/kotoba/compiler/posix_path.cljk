(ns kotoba.compiler.posix-path
  "POSIX path strings, computed -- node:path's posix `basename` / `dirname` /
  `join` / `normalize`, the algorithm and not a call.

  superproject adr-2609242330 section 1 (b): joining and splitting a path
  string observes nothing and changes nothing, so it is a pure function and
  not an fs ability. The compiler used node:path for these four; this module
  answers the same strings (scripts/test-posix-path.cljk compares it with
  node:path over the compiler's own paths and a seeded random corpus).

  Why not kotoba.lang.fs: its `join` does not resolve `.` / `..` and drops a
  trailing slash, and its `basename` of \"/a/b/\" differs -- the compiler's
  output paths and diagnostics are spelled by node:path today, and a path
  written differently is a different artifact location.

  Only `/` is a separator, and the algorithm only ever compares a position
  with `/` and cuts at such positions. That is why the three leaves below may
  count in different units per host -- bytes under Kotoba, UTF-16 units
  under ClojureScript -- and still give the same answer: a cut at a `/` is a
  cut between the same two characters in either unit."
  {:kotoba/export [basename dirname join normalize]})

;; ---- leaves: the only host-specific lines, one per primitive ----

(defn- len [#?@(:kotoba [s :string] :default [s])] #?@(:kotoba [:i64])
  #?(:kotoba (string-byte-length s) :default (count s)))

(defn- slash-at? [#?@(:kotoba [s :string i :i64] :default [s i])] #?@(:kotoba [:bool])
  #?(:kotoba (= i (string-find-byte s 47 i))
     :default (= "/" (subs s i (inc i)))))

(defn- dot-at? [#?@(:kotoba [s :string i :i64] :default [s i])] #?@(:kotoba [:bool])
  #?(:kotoba (= i (string-find-byte s 46 i))
     :default (= "." (subs s i (inc i)))))

(defn- cut [#?@(:kotoba [s :string start :i64 end :i64] :default [s start end])] #?@(:kotoba [:string])
  #?(:kotoba (string-substring s start end) :default (subs s start end)))

(defn- cat2 [#?@(:kotoba [a :string b :string] :default [a b])] #?@(:kotoba [:string])
  #?(:kotoba (string-concat a b) :default (str a b)))

;; ---- node:path posix, lib/path.js ----

(defn basename
  "The last segment of P, trailing slashes ignored; \"\" for \"\" and \"/\"."
  [#?@(:kotoba [p :string] :default [p])] #?@(:kotoba [:string])
  (loop [i (dec (len p)) end -1]
    (cond
      (< i 0) (if (= end -1) "" (cut p 0 end))
      (slash-at? p i) (if (= end -1) (recur (dec i) end) (cut p (inc i) end))
      :else (recur (dec i) (if (= end -1) (inc i) end)))))

(defn dirname
  "Everything before the last segment of P: \".\" when there is no slash,
  \"/\" for a root child, \"//\" for the one node:path spelling of that."
  [#?@(:kotoba [p :string] :default [p])] #?@(:kotoba [:string])
  (let [n (len p)]
    (if (= n 0)
      "."
      (let [root? (slash-at? p 0)
            end (loop [i (dec n) matched-slash true]
                  (cond
                    (< i 1) -1
                    (slash-at? p i) (if matched-slash (recur (dec i) true) i)
                    :else (recur (dec i) false)))]
        (cond
          (= end -1) (if root? "/" ".")
          (and root? (= end 1)) "//"
          :else (cut p 0 end))))))

(defn- ends-dot-dot? [#?@(:kotoba [res :string] :default [res])] #?@(:kotoba [:bool])
  (let [n (len res)]
    (and (>= n 2) (dot-at? res (- n 2)) (dot-at? res (- n 1)))))

(defn- last-slash [#?@(:kotoba [res :string] :default [res])] #?@(:kotoba [:i64])
  (loop [i (dec (len res))]
    (cond (< i 0) -1
          (slash-at? res i) i
          :else (recur (dec i)))))

(defn- normalize-string
  "node:path normalizeString: resolve `.` and `..` segments of P; `..` above
  the start is kept when ALLOW-ABOVE-ROOT."
  [#?@(:kotoba [p :string allow-above-root :bool] :default [p allow-above-root])] #?@(:kotoba [:string])
  (let [n (len p)]
    (loop [i 0 res "" last-segment-length 0 last-slash-at -1 dots 0]
      (if (> i n)
        res
        (let [slash? (or (= i n) (slash-at? p i))]
          (if slash?
            (cond
              (or (= last-slash-at (dec i)) (= dots 1))
              (recur (inc i) res last-segment-length i 0)

              (= dots 2)
              (if (or (< (len res) 2) (not= last-segment-length 2) (not (ends-dot-dot? res)))
                (cond
                  (> (len res) 2)
                  (let [at (last-slash res)]
                    (if (= at -1)
                      (recur (inc i) "" 0 i 0)
                      (let [kept (cut res 0 at)]
                        (recur (inc i) kept (- (len kept) 1 (last-slash kept)) i 0))))

                  (not= (len res) 0)
                  (recur (inc i) "" 0 i 0)

                  allow-above-root
                  (recur (inc i) (if (> (len res) 0) (cat2 res "/..") "..") 2 i 0)

                  :else (recur (inc i) res last-segment-length i 0))
                (if allow-above-root
                  (recur (inc i) (if (> (len res) 0) (cat2 res "/..") "..") 2 i 0)
                  (recur (inc i) res last-segment-length i 0)))

              :else
              (let [segment (cut p (inc last-slash-at) i)]
                (recur (inc i)
                       (if (> (len res) 0) (cat2 (cat2 res "/") segment) segment)
                       (- i last-slash-at 1)
                       i 0)))
            (recur (inc i) res last-segment-length last-slash-at
                   (cond (and (dot-at? p i) (not= dots -1)) (inc dots)
                         :else -1))))))))

(defn normalize
  "node:path posix normalize: resolve `.` / `..`, collapse repeated slashes,
  keep one trailing slash if P had one; \".\" for \"\"."
  [#?@(:kotoba [p :string] :default [p])] #?@(:kotoba [:string])
  (let [n (len p)]
    (if (= n 0)
      "."
      (let [absolute? (slash-at? p 0)
            trailing? (slash-at? p (dec n))
            body (normalize-string p (not absolute?))
            spelled (cond
                      (and (= 0 (len body)) absolute?) ""
                      (= 0 (len body)) (if trailing? "./" ".")
                      trailing? (cat2 body "/")
                      :else body)]
        (cond
          (and absolute? (= 0 (len spelled))) "/"
          absolute? (cat2 "/" spelled)
          :else spelled)))))

(defn join
  "node:path posix join of A and B: the non-empty parts joined by `/`, then
  normalized; \".\" when both are empty."
  [#?@(:kotoba [a :string b :string] :default [a b])] #?@(:kotoba [:string])
  (let [joined (cond (and (= 0 (len a)) (= 0 (len b))) ""
                     (= 0 (len a)) b
                     (= 0 (len b)) a
                     :else (cat2 (cat2 a "/") b))]
    (if (= 0 (len joined)) "." (normalize joined))))
