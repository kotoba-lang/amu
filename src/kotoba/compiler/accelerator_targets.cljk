(ns kotoba.compiler.accelerator-targets
  "Deterministic GPU vendor classification, accelerator target dispatch and
  provisional per-vendor workgroup defaults (ADR-0355).

  One decision table, and no measurement in it yet: the workgroup sizes below
  are PROVISIONAL design defaults chosen as powers of two that are multiples
  of each vendor's published execution width. `recommend` marks every answer
  :measured? false; nothing here may be reported as optimization evidence
  until hardware measurement replaces a row.

  The functions are TOTAL. An unknown vendor or api answers the documented
  fallback instead of throwing -- dispatch time is where a refusal costs the
  most, and a portable default is honest about what it is."
  {:kotoba/export [classify-vendor default-target device-class device-classes name-vendor-fragments recommend target-for vendor-ids vendors workgroup-default workgroup-defaults]}
  (:require [kotoba.lang.text :as str]
            #?(:cljs [kotoba.kir.cljs-i64 :as i64])))

(def vendors
  "The vendors the dispatch table names. :unknown is the deterministic
  fallback for everything else and is deliberately not a refusal."
  #{:nvidia :apple :intel :arm :amd :unknown})

(def device-classes
  "The device-class vocabulary: one keyword per word of the wire-42 DEVCLASS
  answer (tools/kexe_gpu_vulkan.c reports the chosen device's
  VkPhysicalDeviceType as discrete|integrated|virtual|cpu|other), plus
  :unknown for anything that is not one of those words. Reserved: the v1
  table does not branch on device class yet; when a row needs it (discrete vs
  integrated memory behavior), it lands with the measurement that justifies
  the branch."
  #{:discrete-gpu :integrated-gpu :virtual-gpu :cpu :other :unknown})

(def ^:private device-class-tokens
  "The DEVCLASS wire words -> device-classes keywords. The loader emits
  exactly these five lower-case words, so the map is the whole vocabulary and
  nothing is case-folded: a word the loader cannot emit is not a class fact."
  {"discrete" :discrete-gpu
   "integrated" :integrated-gpu
   "virtual" :virtual-gpu
   "cpu" :cpu
   "other" :other})

(defn device-class
  "Map one wire-42 DEVCLASS token into `device-classes`. TOTAL: a token
  outside the loader's five words (nil, blank, a case variant, a keyword)
  answers :unknown -- a non-fact must not become a specific class. Lossless
  in the other direction: every loader word keeps its own class. `recommend`
  does not branch on this; it is the reporting half of device class for the
  dispatch layers that will (JUN-57..60)."
  [token]
  (get device-class-tokens token :unknown))

(def vendor-ids
  "PCI vendor ids, as VkPhysicalDeviceProperties.vendorID reports them and as
  the gpu/compute (wire 42) INFO answer carries them. Decimal on purpose:
  hex literals are a reader hazard on some hosts."
  {4318 :nvidia   ;; 0x10DE
   4203 :apple    ;; 0x106B
   32902 :intel   ;; 0x8086
   5045 :arm      ;; 0x13B5 (Mali)
   4098 :amd})    ;; 0x1002

(def name-vendor-fragments
  "Lower-case substrings matched against a lower-cased device name, in order.
  First hit wins, so a compound name always classifies the same way."
  [["nvidia" :nvidia]
   ["geforce" :nvidia]
   ["quadro" :nvidia]
   ["apple" :apple]
   ["intel" :intel]
   ["iris" :intel]
   ["mali" :arm]
   ["radeon" :amd]
   ["amd" :amd]])

(defn classify-vendor
  "Classify a device descriptor map ({:vendor-id <int>} or {:vendor <name>})
  to a keyword in `vendors`. A :vendor-id match wins over name matching; no
  match answers :unknown.

  The id may arrive as the kotoba reader's BigInt (every integer token is one
  on the nbb route -- i64 exactness, cli_support), and a BigInt is not `=` to
  the plain number key, so it is normalised to a compiler-host integer first
  (capability_names/wire-int pattern). A non-integer id (a string like
  \"4318\") is NOT coerced: it falls through to name matching or :unknown."
  [device]
  (let [id (let [v (:vendor-id device)]
             #?(:clj v
                :cljs (if (i64/bigint-value? v) (js/Number v) v)))
        nm (:vendor device)]
    (or (get vendor-ids id)
        (when (string? nm)
          (let [lower-name (str/lower nm)]
            (some (fn [[fragment vendor]]
                    (when (str/includes? lower-name fragment) vendor))
                  name-vendor-fragments)))
        :unknown)))

(def ^:private vendor-default-target
  {:nvidia :cuda-v1
   :apple :msl-v1
   :intel :wgsl-v1
   :arm :wgsl-v1
   :amd :wgsl-v1
   :unknown :wgsl-v1})

(defn default-target
  "The emission target a vendor falls back to when no api names one. Always
  one of ADR-0002's three targets; SPIR-V and PTX stay future KIR extensions."
  [vendor]
  (get vendor-default-target vendor :wgsl-v1))

(defn target-for
  "The emission target for an (api, vendor) pair. An api that names its
  shading language decides outright (:cuda -> :cuda-v1, :metal -> :msl-v1,
  :vulkan/:webgpu -> :wgsl-v1); a missing or unknown api falls back to the
  vendor default."
  [api vendor]
  (cond
    (= api :cuda) :cuda-v1
    (= api :metal) :msl-v1
    (#{:vulkan :webgpu} api) :wgsl-v1
    :else (default-target vendor)))

(def workgroup-defaults
  "Per-vendor workgroup rows (ADR-0355). The rows hardware answered for are
  MEASURED (2026-10-19, ADR-0358) and carry :measured? true; :arm and
  :unknown stay provisional. :measured? says a hardware measurement chose
  this size -- nothing more. The measurements are one workload shape
  (2^20-thread f32 ewise FMA, 256 FMAs per thread, submit->fence host clock,
  paired runs) and are not a claim of optimality for every kernel."
  {:nvidia {:size 256 :execution-width 32 :measured? true
            :basis "warp width 32; 256 is 8 warps per workgroup"
            :evidence "2026-10-19 Xavier nvgpu, 6 paired runs: 128-1024 flat within 2%, 32 is 22% slower; 256 kept inside the flat band"}
   :apple {:size 256 :execution-width 32 :measured? true
           :basis "SIMD-group width 32"
           :evidence "2026-10-19 Apple M1 Max / MoltenVK, 16 paired runs: 32-1024 medians within ~5% and no size won more than 6/16; 256 kept as the most frequent paired winner"}
   :intel {:size 128 :execution-width 32 :measured? true
           :basis "subgroup width 8/16/32; 128 is a multiple of all three"
           :evidence "2026-10-19 BMG G31 / ANV, 6 paired runs: 32-256 flat within 2% (64 won 4/6 on noise-level margins), 512/1024 marginally slower; 128 kept as the subgroup-safe row inside the flat band"}
   :arm {:size 128 :execution-width 16 :measured? false
         :basis "Mali execution widths 4-32 all divide 128"}
   :amd {:size 1024 :execution-width 64 :measured? true
         :basis "wavefront width 64; measurement chose the top of the bound"
         :evidence "2026-10-19 Radeon 680M / RADV, 6 paired runs: 1024 won 5/6 and is 28% faster than the provisional 256 (median 334,528 vs 467,981 ns); 32 slowest"}
   :unknown {:size 256 :execution-width 32 :measured? false
             :basis "portable fallback"}})

(defn workgroup-default
  "The provisional workgroup size for a vendor (a power of two in [32, 1024]).
  Total: a vendor outside `vendors` takes the :unknown row."
  [vendor]
  (get-in workgroup-defaults [vendor :size] 256))

(defn device-from-info
  "Parse one wire-42 INFO answer -- \"<device>|<api>|<maxWgX>|<unified>\" as
  tools/kexe_gpu_vulkan.c answers it (deviceName, apiVersion major.minor.patch,
  limits.maxComputeWorkGroupSize[0], deviceType==INTEGRATED_GPU) -- into a
  device descriptor for `recommend`. The device class is NOT in this answer:
  it rides the separate DEVCLASS request, and `device-class` maps its word:
  {:vendor <deviceName> :api :vulkan :api-version <string>
   :max-workgroup-x <int> :unified-memory? <bool> :measured? true}.

  :measured? true covers THESE FACTS: they are hardware answers read through
  the Vulkan loader on the machine that ran the probe. It does NOT make any
  workgroup row measured -- `recommend` on this descriptor still answers
  :measured? false, because the INFO probe reports a limit, not a tuning
  result. The wire is Vulkan-only, so :api is always :vulkan here.

  Total: an answer that is not exactly four well-formed fields answers nil
  (a wrong parse must not become a wrong dispatch decision)."
  [answer]
  (when (string? answer)
    (let [fields (str/split answer #"\|")]
      (when (= 4 (count fields))
        (let [[device api-version max-wg-x unified] fields
              wg (when (re-matches #"[0-9]+" max-wg-x) (parse-long max-wg-x))]
          (when (and (not (str/blank? device))
                     (re-matches #"[0-9]+\.[0-9]+\.[0-9]+" api-version)
                     (pos? (or wg 0))
                     (contains? #{"0" "1"} unified))
            {:vendor device
             :api :vulkan
             :api-version api-version
             :max-workgroup-x wg
             :unified-memory? (= unified "1")
             :measured? true}))))))


(defn recommend
  "A deterministic dispatch decision for one device descriptor
  ({:vendor-id | :vendor, optional :api, optional :device-class}). Answers
  {:vendor :target :workgroup-size :execution-width :basis :measured?}.
  Same descriptor in, same map out, forever. :measured? is the row's: true
  where a hardware measurement (ADR-0358) chose the size, false while the
  row is still the provisional design default."
  [device]
  (let [vendor (classify-vendor device)
        row (get workgroup-defaults vendor (workgroup-defaults :unknown))
        ;; qNpA: a probed device limit bounds the recommendation (the row is
        ;; a default, not a licence to exceed the device). The largest power
        ;; of two at or below the limit.
        probed (when-let [lim (:max-workgroup-x device)]
                 (when (and (number? lim) (pos? lim))
                   (loop [sz (:size row)]
                     (if (and (<= sz lim) (pos? sz)) sz (recur (quot sz 2))))))
        ;; uB5G: the measured flag is scoped to the measured device (one M1
        ;; Max configuration, ADR-0358), not to the vendor class.
        device-name (str (:device device) (:name device))
        named-device? (not (clojure.string/blank? device-name))
        measured-device? (boolean (re-find #"(?i)m1 max" device-name))]
    {:vendor vendor
     :target (target-for (:api device) vendor)
     :workgroup-size (or probed (:size row))
     :execution-width (:execution-width row)
     :basis (cond-> (:basis row) probed (str " (bounded by probed device limit " (:max-workgroup-x device) ")"))
     ;; uB5G: a NAMED device must be the measured device for the row's
     ;; measured flag to apply; an unnamed (vendor-class) descriptor keeps
     ;; the row-level flag as the only available signal.
     ;; An INFO-derived descriptor (:max-workgroup-x present, from
     ;; device-from-info) reports a LIMIT, not a tuning result, and never
     ;; transfers the row's measured flag (the device-from-info contract).
     :measured? (and (boolean (:measured? row))
                     (nil? (:max-workgroup-x device))
                     (or (not named-device?) measured-device?))}))
