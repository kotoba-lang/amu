(ns kotoba.compiler.accelerator-targets
  "Deterministic GPU vendor classification, accelerator target dispatch and
  per-vendor workgroup defaults (ADR-0355).

  One decision table, and exactly ONE measured fact in it: the apple row's
  execution width (subgroup size) is MEASURED on hardware -- gl_SubgroupSize
  = 32 on Apple M1 Max via MoltenVK, three verified processes
  (docs/evidence/gpu-subgroup-measured-row-m1max-20261019). Every workgroup
  SIZE is still a PROVISIONAL design default chosen as a power of two that is
  a multiple of the row's execution width; no tuning result exists for any
  vendor.

  Measurement is per fact. Each row carries :size-measured? and
  :execution-width-measured? with a :basis apiece, and `recommend` answers
  both flags plus a top-level :measured? that is true only when every fact in
  the answer is measured -- so it stays false everywhere today. Nothing here
  may be reported as optimization evidence beyond the one measured fact and
  its basis.

  The functions are TOTAL. An unknown vendor or api answers the documented
  fallback instead of throwing -- dispatch time is where a refusal costs the
  most, and a portable default is honest about what it is."
  {:kotoba/export [classify-vendor default-target device-classes name-vendor-fragments recommend target-for vendor-ids vendors workgroup-default workgroup-defaults]}
  (:require [kotoba.lang.text :as str]))

(def vendors
  "The vendors the dispatch table names. :unknown is the deterministic
  fallback for everything else and is deliberately not a refusal."
  #{:nvidia :apple :intel :arm :amd :unknown})

(def device-classes
  "Reserved. The v1 table does not branch on device class yet; when a row
  needs it (discrete vs integrated memory behavior), it lands with the
  measurement that justifies the branch."
  #{:discrete-gpu :integrated-gpu :unknown})

(def vendor-ids
  "PCI vendor ids, as VkPhysicalDeviceProperties.vendorID reports them and as
  the gpu/compute (wire 42) INFO answer carries them. Decimal on purpose:
  hex literals are a reader hazard on some hosts."
  {4318 :nvidia   ;; 0x10DE
   4203 :apple    ;; 0x106B
   32902 :intel   ;; 0x8086
   5045 :arm      ;; 0x13B5 (Mali)
   4098 :amd})    ;; 0x1002

(def name-vendor-fragments
  "Lower-case substrings matched against a lower-cased device name, in order.
  First hit wins, so a compound name always classifies the same way."
  [["nvidia" :nvidia]
   ["geforce" :nvidia]
   ["quadro" :nvidia]
   ["apple" :apple]
   ["intel" :intel]
   ["iris" :intel]
   ["mali" :arm]
   ["radeon" :amd]
   ["amd" :amd]])

(defn classify-vendor
  "Classify a device descriptor map ({:vendor-id <int>} or {:vendor <name>})
  to a keyword in `vendors`. A :vendor-id match wins over name matching; no
  match answers :unknown."
  [device]
  (let [id (:vendor-id device)
        nm (:vendor device)]
    (or (get vendor-ids id)
        (when (string? nm)
          (let [lower-name (str/lower nm)]
            (some (fn [[fragment vendor]]
                    (when (str/includes? lower-name fragment) vendor))
                  name-vendor-fragments)))
        :unknown)))

(def ^:private vendor-default-target
  {:nvidia :cuda-v1
   :apple :msl-v1
   :intel :wgsl-v1
   :arm :wgsl-v1
   :amd :wgsl-v1
   :unknown :wgsl-v1})

(defn default-target
  "The emission target a vendor falls back to when no api names one. Always
  one of ADR-0002's three targets; SPIR-V and PTX stay future KIR extensions."
  [vendor]
  (get vendor-default-target vendor :wgsl-v1))

(defn target-for
  "The emission target for an (api, vendor) pair. An api that names its
  shading language decides outright (:cuda -> :cuda-v1, :metal -> :msl-v1,
  :vulkan/:webgpu -> :wgsl-v1); a missing or unknown api falls back to the
  vendor default."
  [api vendor]
  (cond
    (= api :cuda) :cuda-v1
    (= api :metal) :msl-v1
    (#{:vulkan :webgpu} api) :wgsl-v1
    :else (default-target vendor)))

(def workgroup-defaults
  "One row per vendor, every fact provenanced separately. A fact whose
  :measured? is true has hardware evidence named in its :basis; a fact whose
  :measured? is false is a PROVISIONAL DESIGN DEFAULT (ADR-0355) that no
  caller may cite as optimization evidence.

  Workgroup sizes stay unmeasured as TUNING for every vendor -- no row claims
  256 or 128 is optimal anywhere. The apple execution width is the one
  measured fact in this table (JUN-58, first row flip 2026-10-19)."
  {:nvidia {:size 256
            :size-basis "PROVISIONAL: warp width 32; 256 is 8 warps per workgroup"
            :size-measured? false
            :execution-width 32
            :execution-width-basis "warp width 32 (published); UNMEASURED on hardware"
            :execution-width-measured? false}
   :apple {:size 256
           :size-basis "PROVISIONAL: 8 SIMD-groups of the measured width 32; not a tuning result"
           :size-measured? false
           :execution-width 32
           :execution-width-basis "MEASURED: gl_SubgroupSize = 32 on Apple M1 Max via MoltenVK (Vulkan 1.3.357), 3 verified processes; docs/evidence/gpu-subgroup-measured-row-m1max-20261019"
           :execution-width-measured? true}
   :intel {:size 128
           :size-basis "PROVISIONAL: subgroup width 8/16/32; 128 is a multiple of all three"
           :size-measured? false
           :execution-width 32
           :execution-width-basis "subgroup width 8/16/32 (published); UNMEASURED on hardware"
           :execution-width-measured? false}
   :arm {:size 128
         :size-basis "PROVISIONAL: Mali execution widths 4-32 all divide 128"
         :size-measured? false
         :execution-width 16
         :execution-width-basis "Mali execution widths 4-32 (published); UNMEASURED on hardware"
         :execution-width-measured? false}
   :amd {:size 256
         :size-basis "PROVISIONAL: wavefront width 64"
         :size-measured? false
         :execution-width 64
         :execution-width-basis "wavefront width 64 (published); UNMEASURED on hardware"
         :execution-width-measured? false}
   :unknown {:size 256
             :size-basis "portable fallback"
             :size-measured? false
             :execution-width 32
             :execution-width-basis "portable fallback"
             :execution-width-measured? false}})

(defn workgroup-default
  "The provisional workgroup size for a vendor (a power of two in [32, 1024]).
  Total: a vendor outside `vendors` takes the :unknown row."
  [vendor]
  (get-in workgroup-defaults [vendor :size] 256))

(defn recommend
  "A deterministic dispatch decision for one device descriptor
  ({:vendor-id | :vendor, optional :api, optional :device-class}). Answers
  {:vendor :target
   :workgroup-size :size-basis :size-measured?
   :execution-width :execution-width-basis :execution-width-measured?
   :measured?}. The top-level :measured? is true only when every fact in the
  answer is measured; with every workgroup size still provisional it stays
  false, while :execution-width-measured? names the one fact hardware has
  actually answered (the apple row). Same descriptor in, same map out,
  forever -- until hardware measurement replaces a provisional fact and
  flips that fact's flag for that vendor only."
  [device]
  (let [vendor (classify-vendor device)
        row (get workgroup-defaults vendor (workgroup-defaults :unknown))]
    {:vendor vendor
     :target (target-for (:api device) vendor)
     :workgroup-size (:size row)
     :size-basis (:size-basis row)
     :size-measured? (:size-measured? row)
     :execution-width (:execution-width row)
     :execution-width-basis (:execution-width-basis row)
     :execution-width-measured? (:execution-width-measured? row)
     :measured? (boolean (and (:size-measured? row)
                              (:execution-width-measured? row)))}))
