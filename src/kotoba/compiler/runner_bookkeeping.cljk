(ns kotoba.compiler.runner-bookkeeping
  "The bookkeeping the C-free x86-64 seed runner performs around its entry
  call (Linear JUN-29, kernel-profile slice shared with JUN-30/JUN-102).

  WHERE THIS SITS. `kotoba.compiler.runner-slice` decides (admit!) and
  seals (create/verify) -- it binds digests it is handed. This namespace
  computes those digests from the bytes in hand and drives the decision in
  the runner's order: `pre-entry!` after the arenas are mapped and before
  the guest entry is called (fail-closed: nothing runs if it refuses), and
  `post-run!` after the guest returns (seal the run receipt and re-verify
  it before anyone quotes it).

  WHY PURE SHA-256. The runner contains no C and no trusted loader, and
  the acceptance path must not depend on NBB/Node, JVM or GraalVM host
  crypto. Byte digests here are `sha2.core` (org-nist-sha2, pure .cljc,
  no dependencies) over raw bytes -- the same digests Python hashlib and
  the measurement harness' node:crypto compute, cross-checked on the
  2026-10-19 chain (21-entry source-graph manifest, both paths identical).
  The receipt body itself is sealed with `kotoba.artifact.core/sha256` by
  `runner-slice`, unchanged.

  FAIL-CLOSED INPUT SHAPES. `artifact-digest` refuses strings outright: a
  string is not bytes, and silently UTF-8-encoding one is how two sides
  end up hashing different things. Each artifact slot in `pre-entry!` /
  `post-run!` offers exactly one of raw `:bytes` (or `:entries` for the
  source graph) or a precomputed `:sha256` -- offering both is refused,
  because a digest that shadows the bytes was computed somewhere else.

  MEASURED CONSTANTS (2026-10-19 x86-64 G1->G2 chain): 21-entry canonical
  manifest `8935d969ae4665c63baaf4f3dd42c0f192d388d397ced7b5c335561a2f1f5700`
  (entries sorted by PATH; sorting by sha256 gives the different recorded
  trap value `ed7839d5380385af71d536cd0c9b1ae060b6a414a4b2893bb6ddad31d563fc8f`),
  receipt `b16d1d533ae420ca648cd0c695311b8de04f046eb113c08eaf6399d11b863965`,
  admission `73c7761f9a191d721e6e4a8d5b0323253d5a35d54d4fee8e8fec65dea75ae95c`.
  The test suite reproduces them from this code; do not 'fix' a constant
  to match a refactoring -- a changed digest is the refactoring failing."
  {:kotoba/export [artifact-digest source-graph-digest pre-entry! post-run!]}
  (:require [kotoba.compiler.runner-slice :as runner-slice]
            [kotoba.verifier :as verifier]
            [sha2.core :as sha2]))

;; `verifier/guest-integer?`, not `integer?`: on the Node host the reader
;; hands back bigints and cljs `integer?` is false for them (same trap as
;; `runner-slice`, measured 2026-09-11).
(defn- an-integer? [x] (verifier/guest-integer? x))

(defn- reject!
  [message data]
  (throw (ex-info message (assoc data :phase :runner-bookkeeping))))

(defn- byte-vector!
  "The input as a vector of unsigned bytes 0..255, or refuse. Strings are
  refused (an encoding decision disguised as bytes); so is anything whose
  elements are not integers in range. Host indexed byte containers
  (Buffer / Uint8Array / Array) are accepted element-wise; collections of
  ints are accepted directly."
  [value]
  (when (string? value)
    (reject! "strings are not bytes: hash the encoding you mean explicitly"
             {:value "string"}))
  (let [bs (cond
             (coll? value) (vec value)
             ;; indexed host byte container: length + indexed read, no host
             ;; hash module involved
             (some? (and value (.-length value)))
             (mapv #(aget value %) (range (.-length value)))
             :else (reject! "artifact bytes are not a byte vector"
                            {:value (pr-str value)}))]
    (doseq [b bs]
      (when-not (and (an-integer? b) (<= 0 b 255))
        (reject! "artifact byte vector element is not an unsigned byte"
                 {:element (pr-str b)})))
    bs))

(defn artifact-digest
  "Raw-byte SHA-256 of `bytes` (pure `sha2.core`, no host crypto) as 64
  lowercase hex characters. Refuses strings and non-byte elements --
  fail-closed, nothing normalised."
  [bytes]
  (sha2/sha256-hex (byte-vector! bytes)))

(defn- utf8-code-point
  "OUT with the UTF-8 encoding of the scalar value CP appended."
  [out cp]
  (cond
    (< cp 0x80) (conj out cp)
    (< cp 0x800) (conj out (+ 0xC0 (quot cp 64)) (+ 0x80 (bit-and cp 0x3F)))
    (< cp 0x10000) (conj out (+ 0xE0 (quot cp 4096))
                         (+ 0x80 (bit-and (quot cp 64) 0x3F))
                         (+ 0x80 (bit-and cp 0x3F)))
    :else (conj out (+ 0xF0 (quot cp 262144))
                (+ 0x80 (bit-and (quot cp 4096) 0x3F))
                (+ 0x80 (bit-and (quot cp 64) 0x3F))
                (+ 0x80 (bit-and cp 0x3F)))))

(defn- utf8-bytes
  "The UTF-8 bytes of S as a vector of ints 0..255 (code points read from
  the string, never `(map int s)` -- on cljs that answers `[0 0 0 ...]`)."
  [s]
  (let [n (count s)]
    (loop [i 0 out []]
      (if (< i n)
        (let [cp (.codePointAt s i)]
          (recur (+ i (if (>= cp 0x10000) 2 1)) (utf8-code-point out cp)))
        out))))

(defn source-graph-digest
  "SHA-256 over the UTF-8 bytes of the canonical source-graph manifest
  (`runner-slice/source-graph-manifest`: `sha256  path` lines, two spaces,
  LF terminated, entries sorted BY PATH). The recorded 21-entry value is
  `8935d969ae4665c63baaf4f3dd42c0f192d388d397ced7b5c335561a2f1f5700`;
  the same entries sorted by sha256 instead answer the different trap
  value `ed7839d5380385af71d536cd0c9b1ae060b6a414a4b2893bb6ddad31d563fc8f`."
  [entries]
  (artifact-digest (utf8-bytes (runner-slice/source-graph-manifest entries))))

(defn- slot-digest!
  "`slot` offers exactly one form: `:bytes` (raw artifact bytes), `:entries`
  (source-graph entries, when `entries-allowed?`), or `:sha256` (a digest
  computed by whoever read the bytes). Both bytes and a digest at once is
  refused: a digest that shadows the bytes is a digest computed elsewhere,
  and the runner must know which side it is trusting. Returns the digest."
  [label {:keys [bytes sha256 entries]} entries-allowed?]
  (let [given (cond-> []
                (some? bytes) (conj :bytes)
                (some? sha256) (conj :sha256)
                (some? entries) (conj :entries))
        allowed (cond-> [:bytes :sha256] entries-allowed? (conj :entries))]
    (when-not (= 1 (count given))
      (reject! (str label " must offer exactly one of " (pr-str allowed))
               {:label label :given given}))
    (cond
      (some? bytes) (artifact-digest bytes)
      (some? entries)
      (if entries-allowed?
        (source-graph-digest entries)
        (reject! (str label " does not take entries") {:label label}))
      :else (do (when-not (runner-slice/valid-digest? sha256)
                  (reject! (str label " digest is not a raw-byte SHA-256")
                           {:label label :sha256 (pr-str sha256)}))
                sha256))))

(defn pre-entry!
  "The runner's fail-closed pre-entry bookkeeping: resolve the four
  artifact digests (runner / compiler / source-graph / container, each
  offered as bytes/entries or a digest -- never both) and take the
  admission decision of `runner-slice/admit!` against the launched pins.
  Runs after arenas are mapped and before the guest entry is called; any
  refusal throws `{:phase :runner-admission}` or `{:phase :runner-bookkeeping}`
  and nothing executes.

  Returns `{:admitted? true :admission-sha256 ... :digests {...}}` where
  `:digests` feeds `post-run!` unchanged."
  [{:keys [runner compiler source-graph container
           pinned-source-graph-sha256 expected-container-sha256
           call-site-contract]
    :or {call-site-contract runner-slice/call-site-contract}}]
  (let [digests {:runner-sha256 (slot-digest! "runner" runner false)
                 :compiler-sha256 (slot-digest! "compiler" compiler false)
                 :source-graph-sha256 (slot-digest! "source-graph" source-graph true)
                 :container-sha256 (slot-digest! "container" container false)}
        admission (runner-slice/admit!
                   (merge digests
                          {:pinned-source-graph-sha256 pinned-source-graph-sha256
                           :expected-container-sha256 expected-container-sha256
                           :call-site-contract call-site-contract}))]
    (assoc admission :digests digests)))

(defn post-run!
  "The runner's post-run bookkeeping: resolve the output digest (bytes or
  digest), seal the `:kotoba.runner-receipt/v1` receipt over the digests
  `pre-entry!` returned, and re-verify the sealed receipt against the same
  evidence before answering. `:status` is one of `:ok`/`:trap`/`:denied`;
  `:started-at`/`:finished-at` are the run's integer time interval.

  Returns `{:receipt receipt :verified? true}`; seal or verification
  refusal throws `{:phase :runner-receipt}`."
  [{:keys [digests output call-site-contract status started-at finished-at]
    :or {call-site-contract runner-slice/call-site-contract}}]
  (let [run (merge digests
                   {:output-sha256 (slot-digest! "output" output false)
                    :call-site-contract call-site-contract
                    :status status
                    :started-at started-at
                    :finished-at finished-at})
        receipt (runner-slice/create run)
        verified (runner-slice/verify receipt run)]
    {:receipt receipt :verified? (:verified? verified)}))
