(ns kotoba.compiler.provenance
  {:kotoba/export [attach descriptor schema verify!]}
  #?(:clj (:require [kotoba.artifact.core :as artifact]
                    [kotoba.compiler.definition-identity :as definition-identity]
                    [kotoba.kir.compatibility :as compatibility])
     :cljs (:require [kotoba.artifact.core :as artifact]
                     [kotoba.compiler.definition-identity :as definition-identity]
                     [kotoba.kir.compatibility :as compatibility]
                     ["node:crypto" :as crypto])
     ;; Kotoba (adr-2609242330 S1): SHA-256 is the pure org-nist-sha2, which is
     ;; on this classpath (8e38c43f); no host module. Compiler data is the
     ;; recursive `:form/r` record (kotoba.form), and the seal over it is
     ;; kotoba.verifier.seal, not the bounded `:document` of kotoba.artifact.core.
     :kotoba (:require [kotoba.form :as form]
                       [kotoba.bytes :as kbytes]
                       [kotoba.verifier.seal :as seal]
                       [kotoba.kir.compatibility :as compatibility]
                       [sha2.core :as sha2])
     :default (:require [kotoba.artifact.core :as artifact]
                        [kotoba.compiler.definition-identity :as definition-identity]
                        [kotoba.kir.compatibility :as compatibility]
                        [sha2.core :as sha2]))
  #?(:clj (:import (java.nio.charset StandardCharsets)
                   (java.security MessageDigest)))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba
   (defn schema [] :keyword :kotoba.provenance/v1)
   :default
   (def schema :kotoba.provenance/v1))

;; Same JVM `MessageDigest`/Node `node:crypto` split
;; `kotoba.artifact.core/sha256` uses -- see that namespace's own
;; comment for why. `hex` uses `clojure.core/format`, which doesn't exist
;; in cljs at all (not just "throws" -- `format`'s cljs branch is
;; ITSELF unused, `node:crypto`'s `.digest "hex"` already returns a hex
;; string), so it's behind the reader-conditional too, not just its call
;; site.
#?(:clj (defn- hex [bytes]
         (apply str (map #(format "%02x" (bit-and (int %) 0xff)) bytes))))

;; ── the pure path (adr-2609242330 S1) ─────────────────────────────────────
;; What every `:default` below is built from. Bytes are a vector of ints
;; 0..255; text is UTF-8 already in Kotoba, so its bytes are its code points
;; re-encoded, read at byte offsets. The host branches must answer the same
;; strings -- test/kotoba/compiler/provenance_pure_test.cljk runs these
;; functions on nbb against node:crypto / Buffer.

#?(:kotoba nil :default (defn- utf8-code-point
  "OUT with the UTF-8 encoding of the scalar value CP appended."
  [out cp]
  (cond
    (< cp 0x80) (conj out cp)
    (< cp 0x800) (conj out (+ 0xC0 (quot cp 64)) (+ 0x80 (bit-and cp 0x3F)))
    (< cp 0x10000) (conj out (+ 0xE0 (quot cp 4096))
                         (+ 0x80 (bit-and (quot cp 64) 0x3F))
                         (+ 0x80 (bit-and cp 0x3F)))
    :else (conj out (+ 0xF0 (quot cp 262144))
                (+ 0x80 (bit-and (quot cp 4096) 0x3F))
                (+ 0x80 (bit-and (quot cp 64) 0x3F))
                (+ 0x80 (bit-and cp 0x3F))))))

#?(:kotoba nil :default (defn- hex-digit [d]
  (let [digits "0123456789abcdef"]
    #?(:clj (subs digits d (inc d))
       :cljs (subs digits d (inc d))
       :default (string-substring digits d (inc d))))))

#?(:kotoba nil
   :default
(defn- pure-hex
  "Lowercase hex of a vector of ints 0..255."
  [bytes]
  (reduce (fn [acc b]
            (str acc (hex-digit (quot (bit-and b 0xff) 16)) (hex-digit (bit-and b 15))))
          "" bytes)))

(defn- raw-sha256 [#?@(:kotoba [bytes :vector-i64] :default [bytes])] #?@(:kotoba [:string])
  #?(:clj (hex (.digest (MessageDigest/getInstance "SHA-256") ^bytes bytes))
     :cljs (-> (crypto/createHash "sha256") (.update bytes) (.digest "hex"))
     :kotoba (kbytes/hex (sha2/sha256 bytes))
     :default (pure-hex (sha2/sha256 bytes))))
#?(:kotoba nil :default (defn- utf8-vector
  "The UTF-8 bytes of VALUE as a vector of ints (the Kotoba text walk)."
  [value]
  #?(:clj (mapv #(bit-and % 0xff) (.getBytes ^String value StandardCharsets/UTF_8))
     :cljs (vec (js/Array.from (js/Buffer.from value "utf8")))
     ;; Kotoba: a string is UTF-8 already; its bytes are the answer's.
     :default (vector-i64-from-bytes (string-to-utf8 value)))))
(defn- text-sha256 [#?@(:kotoba [value :string] :default [value])] #?@(:kotoba [:string])
  #?(:clj (raw-sha256 (.getBytes ^String value StandardCharsets/UTF_8))
     :cljs (raw-sha256 (js/Buffer.from value "utf8"))
     ;; Kotoba: the hash/sha256 ability hashes a string as its UTF-8 bytes
     :kotoba (hash/sha256 value)
     :default (raw-sha256 (utf8-vector value))))
#?(:kotoba nil :default (defn- byte-size [value]
  #?(:clj (alength (.getBytes ^String value StandardCharsets/UTF_8))
     :cljs (.-length (js/Buffer.from value "utf8"))
     ;; a Kotoba string is UTF-8: its byte length is the answer
     :default (string-byte-length value))))
#?(:kotoba nil :default (defn- vector-sha256
  "SHA-256 hex of a vector of ints (each masked to a byte, as the host
  byte containers do)."
  [bytes]
  #?(:clj (raw-sha256 (byte-array (map unchecked-byte bytes)))
     :cljs (raw-sha256 (js/Buffer.from (clj->js bytes)))
     :default (raw-sha256 (mapv #(bit-and % 0xff) bytes)))))
#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k))))

#?(:kotoba
   (defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v)))

#?(:kotoba
   (defn- empty-map [] [:ref :form/r] (form/form-map (form/no-forms))))

;; The host's truthiness: neither nil nor false.
#?(:kotoba
   (defn- present? [f [:ref :form/r]] :bool
     (if (form/is-nil? f)
       false
       (if (form/is-bool? f) (form/bool-value f) true))))

;; A byte string (a bytes leaf, or a vector of ints) as ints 0..255.
#?(:kotoba
   (defn- form-bytes [f [:ref :form/r]] :vector-i64
     (if (form/is-bytes? f)
       (vector-i64-from-bytes (form/bytes-of f))
       (let [n (form/count-of f)]
         (loop [i 0 out (vector-i64)]
           (if (>= i n)
             out
             (recur (+ i 1) (vector-conj out (bit-and (form/int-value (form/nth-of f i)) 255)))))))))

#?(:kotoba
   (defn- bytes-identity [format [:ref :form/r] bytes [:ref :form/r]] [:ref :form/r]
     (let [v (form-bytes bytes)]
       (put (put (put (empty-map) :format format)
                 :sha256 (form/string-form (raw-sha256 v)))
            :size (form/int-form (vector-count v)))))
   :default
(defn- bytes-identity [format bytes]
  #?(:clj (let [value (byte-array (map unchecked-byte bytes))]
           {:format format :sha256 (raw-sha256 value) :size (alength value)})
     :cljs (let [value (js/Buffer.from (clj->js bytes))]
            {:format format :sha256 (raw-sha256 value) :size (.-length value)})
     :default {:format format :sha256 (vector-sha256 bytes) :size (count bytes)})))

#?(:kotoba
   (defn- outputs [result [:ref :form/r]] [:ref :form/r]
     (let [fmt (fget result :format)
           m0 (empty-map)
           m1 (if (form/eq fmt (form/keyword-form :wasm/v1))
                (put m0 :primary (bytes-identity (form/keyword-form :wasm) (fget result :bytes)))
                m0)
           m2 (if (form/eq fmt (form/keyword-form :wasm-component/v1))
                (put m1 :primary (bytes-identity (form/keyword-form :wasm-component) (fget result :bytes)))
                m1)
           m3 (if (form/eq fmt (form/keyword-form :cljs/v1))
                (put m2 :primary (put (put (put (empty-map) :format (form/keyword-form :cljs-source))
                                           :sha256 (form/string-form (text-sha256 (form/string-value (fget result :source)))))
                                      :size (form/int-form (string-byte-length (form/string-value (fget result :source))))))
                m2)
           m4 (if (form/eq fmt (form/keyword-form :javascript/v1))
                (put m3 :primary (put (put (put (empty-map) :format (form/keyword-form :javascript-source))
                                           :sha256 (form/string-form (text-sha256 (form/string-value (fget result :source)))))
                                      :size (form/int-form (string-byte-length (form/string-value (fget result :source))))))
                m3)
           m5 (if (form/eq fmt (form/keyword-form :kexe/v1))
                (put m4 :primary (put (put (empty-map) :format (form/keyword-form :kotoba.kexe/v1))
                                      :sha256 (fget (fget result :artifact) :sha256)))
                m4)
           creation (fget result :creation-bytes)
           m6 (if (form/eq fmt (form/keyword-form :evm/v1))
                (put m5 :primary
                     (put (put (put (empty-map) :format (form/keyword-form :evm-creation-bytes))
                               :sha256 (if (present? (fget result :creation-sha256))
                                         (fget result :creation-sha256)
                                         (form/string-form (raw-sha256 (form-bytes creation)))))
                          :size (form/int-form (form/count-of creation))))
                m5)
           binary (fget result :binary)
           m7 (if (present? binary)
                (put m6 :binary (bytes-identity (fget binary :format) (fget binary :bytes)))
                m6)
           object (fget result :object)]
       (if (present? object)
         (put m7 :object (bytes-identity (fget object :format) (fget object :bytes)))
         m7)))
   :default
(defn- outputs [result]
  (cond-> (sorted-map)
    (= :wasm/v1 (:format result))
    (assoc :primary (bytes-identity :wasm (:bytes result)))
    (= :wasm-component/v1 (:format result))
    (assoc :primary (bytes-identity :wasm-component (:bytes result)))
    (= :cljs/v1 (:format result))
    (assoc :primary {:format :cljs-source :sha256 (text-sha256 (:source result))
                     :size (byte-size (:source result))})
    (= :javascript/v1 (:format result))
    (assoc :primary {:format :javascript-source :sha256 (text-sha256 (:source result))
                     :size (byte-size (:source result))})
    (= :kexe/v1 (:format result))
    (assoc :primary {:format :kotoba.kexe/v1 :sha256 (get-in result [:artifact :sha256])})
    ;; The EVM backend's own artifact already carries byte vectors plus their
    ;; digests (evm/emit computes :runtime-sha256/:creation-sha256 itself), so
    ;; the primary output identity reuses those digests rather than re-hashing
    ;; the vectors here. Before this branch an `:evm/v1` result proved nothing
    ;; about its emitted bytes: `:outputs` came out `{}` on BOTH runtimes --
    ;; this file is .cljc and both share it -- so the provenance seal bound
    ;; only the source, HIR and KIR. The same gap every other backend closed
    ;; when this map grew its first branches.
    (= :evm/v1 (:format result))
    (assoc :primary {:format :evm-creation-bytes
                     :sha256 (or (:creation-sha256 result)
                                 (vector-sha256 (:creation-bytes result)))
                     :size (count (:creation-bytes result))})
    (:binary result) (assoc :binary (bytes-identity (:format (:binary result)) (:bytes (:binary result))))
    (:object result) (assoc :object (bytes-identity (:format (:object result)) (:bytes (:object result)))))))

;; Kotoba: the definition graph (`definition-identity/describe`) needs the
;; capability catalog, which no Kotoba module can read yet, so a result that
;; does not already carry its `:definitions` report gets the named marker the
;; host uses for "unavailable" rather than an empty report.
#?(:kotoba
   (defn- definitions-of [result [:ref :form/r]] [:ref :form/r]
     (let [defs (fget result :definitions)]
       (if (form/eq (fget defs :contract) (form/keyword-form :kotoba.definition-identity/v1))
         defs
         (put (put (put (empty-map) :contract (form/keyword-form :kotoba.definition-identity/v1))
                   :entries (form/keyword-form :unavailable))
              :reason (form/keyword-form :no-capability-catalog))))))

;; Kotoba: one arity (source policy build-metadata result); the host's
;; three-argument form supplies `{}` for the metadata.
#?(:kotoba
   (defn descriptor [source :string policy [:ref :form/r] build-metadata [:ref :form/r] result [:ref :form/r]]
     [:ref :form/r]
     (let [profile (fget result :target-profile)
           payload0
        (put (put (put (put (put (put (put (put (put (put (put (put (put (put (empty-map)
              :format (form/keyword-form (schema)))
              :builder (form/keyword-form :kotoba-compiler/v1))
              :compiler (form/string-form (compatibility/compiler-version)))
              :language (form/keyword-form (compatibility/language-version)))
              :source-sha256 (form/string-form (text-sha256 source)))
              :policy-sha256 (form/string-form (seal/sha256-form policy)))
              :build-metadata-sha256 (form/string-form (seal/sha256-form build-metadata)))
              :hir-sha256 (form/string-form (seal/sha256-form (fget result :hir))))
              :kir-sha256 (form/string-form (seal/sha256-form (fget result :kir))))
              :target (fget result :target))
              :target-profile-sha256 (form/string-form
                                      (seal/sha256-form (if (present? profile)
                                                          profile
                                                          (fget (fget result :artifact) :target-profile)))))
              :compatibility-sha256 (form/string-form (seal/sha256-form (fget result :compatibility))))
              :definitions (definitions-of result))
              :outputs (outputs result))
           ;; ADR 0365: the emitting backend, present only when it is not
           ;; the built-in emitter (as on the host reading below)
           emitter (fget result :emitter)
           ;; one binding per name (the Kotoba subset refuses a duplicate let binding)
           payload (if (present? emitter) (put payload0 :emitter emitter) payload0)]
       (put payload :sha256 (form/string-form (seal/sha256-form payload)))))
   :default
(defn descriptor
  ([source policy result] (descriptor source policy {} result))
  ([source policy build-metadata result]
   (artifact/seal
    (cond->
    {:format schema
    :builder :kotoba-compiler/v1
    :compiler compatibility/compiler-version
    :language compatibility/language-version
    :source-sha256 (text-sha256 source)
    :policy-sha256 (artifact/sha256 policy)
    :build-metadata-sha256 (artifact/sha256 build-metadata)
    :hir-sha256 (artifact/sha256 (:hir result))
    :kir-sha256 (artifact/sha256 (:kir result))
    :target (:target result)
    :target-profile-sha256 (artifact/sha256 (or (:target-profile result)
                                                (get-in result [:artifact :target-profile])))
    :compatibility-sha256 (artifact/sha256 (:compatibility result))
    ;; ADR 0300. The definition graph, addressed by content: one CID per
    ;; top-level function, its direct dependencies as CIDs, and the effect row
    ;; that CID seals. `:hir-sha256` and `:kir-sha256` above are hashes of one
    ;; whole-module value, so they answer "is this the same build?" and nothing
    ;; smaller; this answers "which of these definitions are the same code",
    ;; which is the question a rename asks and the one a cache has to key on.
    ;; A backend whose result carries no typed KIR gets a named reason rather
    ;; than an empty map -- see `definition-identity/describe`.
    :definitions (definition-identity/describe result)
    :outputs (outputs result)}
     ;; ADR 0365: the backend that emitted the native code, when it is not the
     ;; built-in machine_ir emitter: `{:name :kotoba-seed :sha256 <the seed
     ;; command> :route :bootstrap-process}`, the artifact's own `:emitter`.
     ;; Absent otherwise, so every other provenance record keeps its shape and
     ;; its seal.
     (:emitter result) (assoc :emitter (:emitter result)))))))

#?(:kotoba
   (defn attach [source :string policy [:ref :form/r] build-metadata [:ref :form/r] result [:ref :form/r]]
     [:ref :form/r]
     (let [provenance (descriptor source policy build-metadata result)
           attached (put result :provenance provenance)
           manifest (fget result :manifest)]
       (if (present? manifest)
         (put attached :manifest (put manifest :kotoba.artifact/provenance provenance))
         attached)))
   :default
(defn attach [source policy build-metadata result]
  (let [provenance (descriptor source policy build-metadata result)]
    (cond-> (assoc result :provenance provenance)
      (:manifest result) (assoc-in [:manifest :kotoba.artifact/provenance] provenance)))))

(defn- sha256-equal? [#?@(:kotoba [a :string b :string] :default [a b])] #?@(:kotoba [:bool])
  #?(:clj (MessageDigest/isEqual
           (.getBytes ^String a StandardCharsets/US_ASCII)
           (.getBytes ^String b StandardCharsets/US_ASCII))
     :cljs (and (= (count a) (count b))
               (crypto/timingSafeEqual (js/Buffer.from a "ascii") (js/Buffer.from b "ascii")))
     ;; Every byte is compared whatever the earlier ones were; the answer is
     ;; the OR of the differences. A digest here is ASCII hex, so byte
     ;; offsets and code points coincide.
     :default (let [n (string-byte-length a)]
                (and (= n (string-byte-length b))
                     (zero? (loop [i 0 acc 0]
                              (if (< i n)
                                (recur (inc i) (bit-or acc (bit-xor (string-code-point-at a i)
                                                                    (string-code-point-at b i))))
                                acc)))))))

;; Kotoba: an export cannot abort with a value a caller sees, so a rejected
;; provenance TRAPS (`assert`), as kotoba.verifier/verify-artifact! does; the
;; host throws ex-info "compilation provenance rejected".
#?(:kotoba
   (defn- reject! [] [:ref :form/r]
     (let [refused (assert (= 1 0))] (form/nil-form))))

#?(:kotoba
   (defn verify! [source :string policy [:ref :form/r] build-metadata [:ref :form/r] result [:ref :form/r]]
     [:ref :form/r]
     (let [actual (fget result :provenance)
           expected (descriptor source policy build-metadata (form/dissoc-form result (form/keyword-form :provenance)))]
       (if (and (form/is-map? actual)
                (form/eq (form/keys-of expected) (form/keys-of actual))
                (seal/valid-seal? actual)
                (sha256-equal? (form/string-value (fget actual :sha256))
                               (form/string-value (fget expected :sha256))))
         actual
         (reject!))))
   :default
(defn verify!
  ([source policy result] (verify! source policy {} result))
  ([source policy build-metadata result]
   (let [actual (:provenance result)
        expected (descriptor source policy build-metadata (dissoc result :provenance))]
    (when-not (and (map? actual)
                   (= (set (keys expected)) (set (keys actual)))
                   (artifact/valid-seal? actual)
                   (sha256-equal? (:sha256 actual) (:sha256 expected)))
      (throw (ex-info "compilation provenance rejected"
                      {:phase :provenance :reason :identity-mismatch})))
     actual))))
