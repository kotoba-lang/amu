;; Top-level form inventory and reference graph of a .cljk/.cljc namespace (amu refactor graph / partition / split).
;;
;; Units are TOP-LEVEL FORMS (chunks).  A chunk may define several names when a reader conditional gives each platform
;; its own def; every branch is analysed.  References are scope aware (let / loop / fn / defn / for / doseq /
;; destructuring / binding / case ... shadowing), so a local named like a top-level function is not an edge.
;;
;; Ported from scripts/selfhost-split/{sourcegraph,analyze}.py onto the lossless CST (kotoba.compiler.refactor.cst).
(ns kotoba.compiler.refactor.graph
  {:kotoba/export #?(:kotoba [analysis line-of count-newlines chunk-label pattern-syms tarjan a-chunks a-src a-comps
                             a-top-count a-dc-names a-dc-hashed a-dc-of a-adj chunk-count chunk-at chunk-idx
                             chunk-node chunk-s chunk-e chunk-lead-s chunk-lines chunk-declares chunk-is-ns?
                             chunk-kotoba? chunk-defs chunk-refs chunk-refs-hashed? chunk-binds chunk-names chunk-kind
                             chunk-private? chunk-dynamic? chunk-any-private? chunk-heads chunk-refs-in-map-order
                             chunk-refers? chunk-binds? def-name def-head def-node def-plat def-has-plat? def-private?
                             def-dynamic? def-doc defs-count defs-at adj-targets adj-weights adj-hashed? adj-at
                             adj-keys-in-order comps-count comps-at]
                     :default [def-heads let-like skip-syms pattern-syms analyze line-of build tarjan chunk-label
                              graph-data analysis])}
  (:require #?@(:kotoba [[kotoba.compiler.refactor.cst :as cst]
                         [kotoba.compiler.refactor.cljs-order :as ord]]
                :default [[clojure.string :as str]
                          [clojure.set :as set]
                          [kotoba.compiler.refactor.cst :as cst]]))
  #?(:kotoba (:schemas {:graph/def [:record :graph/def
                                    [[:name :string] [:head :string] [:node [:ref :cst/node]] [:plat :string] [:has-plat :bool]
                                     [:private :bool] [:dynamic :bool] [:doc :string]]]
                        :graph/chunk [:record :graph/chunk
                                      [[:idx :i64] [:node [:ref :cst/node]] [:s :i64] [:e :i64] [:lead-s :i64] [:lines :i64]
                                       [:declares [:list :string]] [:is-ns :bool] [:kotoba :bool]
                                       [:defs [:list [:ref :graph/def]]]
                                       [:refs [:list :string]] [:refs-hashed :bool] [:binds [:list :string]]]]
                        :graph/adj [:record :graph/adj [[:targets :vector-i64] [:weights :vector-i64] [:hashed :bool]]]
                        :graph/st [:record :graph/st
                                   [[:refs [:list :string]] [:seen [:list :string]] [:binds [:list :string]] [:bseen [:list :string]]]]
                        :graph/top [:record :graph/top [[:xs [:list :string]] [:tab :vector-i64]]]
                        :graph/benv [:record :graph/benv [[:st [:ref :graph/st]] [:env [:list :string]]]]
                        :graph/a [:record :graph/a
                                  [[:src :string] [:chunks [:list [:ref :graph/chunk]]]
                                   [:dc-names [:list :string]] [:dc-hashed :bool] [:dc-tab :vector-i64] [:dc-vals [:list :vector-i64]]
                                   [:adj [:list [:ref :graph/adj]]] [:comps [:list :vector-i64]]]]})))

;; ---------------------------------------------------------------------------
;; Kotoba reading: the forms of the guest twin kotoba-lang lang/compat/kotoba/compiler/refactor/graph.kotoba
;; (claude/refactor-twins-parity 1c7260f), moved verbatim, each in a #?(:kotoba ...) form; the last one carries the
;; host reading (the whole host program, unchanged) as its :default arm.  The twin's header follows.
;; kotoba.compiler.refactor.graph -- the GUEST-ROUTE twin of amu's `src/kotoba/compiler/refactor/graph.cljk`: the
;; top-level form inventory and scope-aware reference graph of a .cljk/.cljc namespace (amu refactor graph / partition /
;; split).
;;
;; WHY A TWIN. The host module is dynamic Clojure over the host CST maps: chunks are maps of maps, the reference walk
;; is a `letfn` of closures over `volatile!`s, Tarjan loops over maps and sets. The guest route gets typed records over
;; the cst twin (kotoba.compiler.refactor.cst). Host behaviour is untouched.
;;
;; ORDER. The host's answers depend on cljs map iteration order in three places: the order `build` bumps adjacency
;; entries (`(keys (:refs c))`, then `doseq` over def-chunks), and Tarjan's successor order `(keys (get adj v))`, which
;; fixes the order of the SCC list. The twin keeps every such map as its insertion-ordered keys plus a HASHED flag (the
;; map passed 8 entries and became a PersistentHashMap) and iterates them with kotoba.compiler.refactor.cljs-order.
;;
;; THE CONTRACT (host -> twin)
;;   chunk map           -> :graph/chunk  idx node s e lead-s lines declares is-ns kotoba (has-kotoba-branch) defs refs
;;                          refs-hashed binds; NAMES / KINDS / PRIVATE / DYNAMIC / PLATS / DEFNODES / DOC are derived from
;;                          DEFS (find-defs' rows in order, declares excluded): chunk-names (distinct, in order),
;;                          chunk-kind / chunk-private? / chunk-dynamic? (the LAST def of the name wins, as assoc-in),
;;                          REFS = keys of the host :refs in first-reference order, own names removed (:ref-order);
;;                          the host's per-role counts are not kept (no answer reads them).
;;   (analysis src)      -> :graph/a  chunks, def-chunks (dc-names in insertion order, dc-hashed, dc-of name ->
;;                          :vector-i64), adj (per chunk: targets in insertion order, weights, hashed), comps
;;                          (Tarjan, dependencies first, each sorted), top-names count
;;   (graph-data a)      -> the payload as typed parts (nodes-*, edges, sccs, dynamic-vars), see amu.refactor-graph
;;   (line-of src off) (chunk-label c) (tarjan n adj skip) (pattern-syms node) as the host.
;; OFFSETS are the cst twin's (UTF-8 bytes); line numbers agree with the host's.


;; ---------------------------------------------------------------------------
;; small helpers

#?(:kotoba
(defn- strs [] [:list :string] (typed-list-new [:list :string])))
#?(:kotoba
(defn- sconj [xs [:list :string] s :string] [:list :string] (typed-list-conj [:list :string] xs s)))
#?(:kotoba
(defn- snth [xs [:list :string] i :i64] :string (typed-list-nth [:list :string] xs i)))
#?(:kotoba
(defn- sset [] [:list :string] (typed-list-new [:list :string])))
#?(:kotoba
(defn- in? [s [:list :string] x :string] :bool (ord/member? s x)))
#?(:kotoba
(defn- sadd [s [:list :string] x :string] [:list :string] (typed-list-conj [:list :string] s x)))
#?(:kotoba
(defn- top? [t [:ref :graph/top] x :string] :bool
  (>= (ord/tab-find (record-get [:ref :graph/top] t :tab) (record-get [:ref :graph/top] t :xs) x) 0)))
#?(:kotoba
(defn- nodes-nth [xs [:list [:ref :cst/node]] i :i64] [:ref :cst/node] (typed-list-nth [:list [:ref :cst/node]] xs i)))
#?(:kotoba
(defn- kid [n [:ref :cst/node] i :i64] [:ref :cst/node]
  (let [ks (cst/node-kids n)] (if (< i (vector-count ks)) (nodes-nth ks i) (cst/nil-node)))))
#?(:kotoba
(defn- nkids [n [:ref :cst/node]] :i64 (vector-count (cst/node-kids n))))
#?(:kotoba
(defn- ty [n [:ref :cst/node]] :keyword (cst/node-type n)))

#?(:kotoba
(defn- includes? [s :string t :string] :bool (>= (string-index-of s t) 0)))

#?(:kotoba
(defn- def-head? [h :string] :bool
  (or (string=? h "def") (string=? h "defn") (string=? h "defn-") (string=? h "defonce") (string=? h "defmacro")
      (string=? h "defmulti") (string=? h "defrecord") (string=? h "deftype") (string=? h "defprotocol"))))

#?(:kotoba
(defn- let-like? [h :string] :bool
  (or (string=? h "let") (string=? h "loop") (string=? h "when-let") (string=? h "if-let") (string=? h "when-some")
      (string=? h "if-some") (string=? h "with-open") (string=? h "let*") (string=? h "binding") (string=? h "doseq")
      (string=? h "for") (string=? h "dotimes"))))

;; the symbol text under meta, "" when not a symbol (host nil)
#?(:kotoba
(defn- sym-text [n [:ref :cst/node]] :string
  (let [m (cst/strip-meta n)] (if (= :sym (ty m)) (cst/node-text m) ""))))

;; ---------------------------------------------------------------------------
;; pattern-syms: all binder symbols of a destructuring pattern, as a list (a set on the host; callers only add them)

#?(:kotoba
(defn- cpw [p :i64] :i64 (if (< p 128) 1 (if (< p 2048) 2 (if (< p 65536) 3 4)))))

#?(:kotoba
(defn- last-slash-part [t :string] :string
  (let [n (string-byte-length t)
        k (loop [i 0 k -1] (if (>= i n) k (let [p (string-code-point-at t i)] (recur (+ i (cpw p)) (if (= p 47) i k)))))]
    (if (< k 0) t (string-substring t (+ k 1) n)))))

#?(:kotoba
(defn- pattern-into [out [:list :string] n [:ref :cst/node]] [:list :string]
  (let [t (ty n)]
    (cond
      (= t :sym) (let [x (cst/node-text n)]
                   (if (and (not (string=? x "&")) (not (string=? x "_")) (not (includes? x "/"))) (sconj out x) out))
      (= t :meta) (pattern-into out (kid n 1))
      (= t :map)
      (let [m (nkids n)]
        (loop [i 0 acc out]
          (if (>= i m)
            acc
            (let [k (kid n i)
                  has-v (< (+ i 1) m)
                  v (kid n (+ i 1))
                  kt (if (cst/kw? k) (cst/node-text k) "")]
              (recur (+ i 2)
                     (cond
                       (and (cst/kw? k) (or (string=? kt ":keys") (string=? kt ":strs") (string=? kt ":syms")) has-v)
                       (let [vm (nkids v)]
                         (loop [j 0 a acc]
                           (if (>= j vm) a
                               (recur (+ j 1) (if (cst/sym? (kid v j)) (sconj a (last-slash-part (cst/node-text (kid v j)))) a)))))
                       (and (cst/kw? k) (string=? kt ":as") has-v) (pattern-into acc v)
                       (and (cst/kw? k) (string=? kt ":or")) acc
                       (not (cst/kw? k)) (pattern-into acc k)
                       :else acc))))))
      (or (= t :vec) (= t :rc) (= t :list))
      (let [m (nkids n)] (loop [i 0 acc out] (if (>= i m) acc (recur (+ i 1) (pattern-into acc (kid n i))))))
      :else out))))

#?(:kotoba
(defn pattern-syms [n [:ref :cst/node]] [:list :string] (pattern-into (strs) n)))

#?(:kotoba
(defn- env-plus [env [:list :string] xs [:list :string]] [:list :string]
  (let [m (vector-count xs)] (loop [i 0 e env] (if (>= i m) e (recur (+ i 1) (sadd e (snth xs i))))))))

;; ---------------------------------------------------------------------------
;; find-defs / classify

#?(:kotoba
(defn def-name [d [:ref :graph/def]] :string (record-get [:ref :graph/def] d :name)))
#?(:kotoba
(defn def-head [d [:ref :graph/def]] :string (record-get [:ref :graph/def] d :head)))
#?(:kotoba
(defn def-node [d [:ref :graph/def]] [:ref :cst/node] (record-get [:ref :graph/def] d :node)))
#?(:kotoba
(defn def-plat [d [:ref :graph/def]] :string (record-get [:ref :graph/def] d :plat)))
#?(:kotoba
(defn def-has-plat? [d [:ref :graph/def]] :bool (record-get [:ref :graph/def] d :has-plat)))
#?(:kotoba
(defn def-private? [d [:ref :graph/def]] :bool (record-get [:ref :graph/def] d :private)))
#?(:kotoba
(defn def-dynamic? [d [:ref :graph/def]] :bool (record-get [:ref :graph/def] d :dynamic)))
#?(:kotoba
(defn def-doc [d [:ref :graph/def]] :string (record-get [:ref :graph/def] d :doc)))
#?(:kotoba
(defn defs-count [xs [:list [:ref :graph/def]]] :i64 (vector-count xs)))
#?(:kotoba
(defn defs-at [xs [:list [:ref :graph/def]] i :i64] [:ref :graph/def] (typed-list-nth [:list [:ref :graph/def]] xs i)))
#?(:kotoba
(defn- dconj [xs [:list [:ref :graph/def]] d [:ref :graph/def]] [:list [:ref :graph/def]]
  (typed-list-conj [:list [:ref :graph/def]] xs d)))

;; rows of find-defs: name ("*declare*" for a declare), head, node, plat; private/dynamic/doc filled by classify
#?(:kotoba
(defn- row [name :string head :string n [:ref :cst/node] plat :string hp :bool] [:ref :graph/def]
  (record-new [:ref :graph/def] name head n plat hp false false "")))

#?(:kotoba
(defn- find-defs-into [out [:list [:ref :graph/def]] node [:ref :cst/node] plat :string hp :bool] [:list [:ref :graph/def]]
  (let [n (cst/strip-meta node)]
    (cond
      (and (cst/lst? n) (> (nkids n) 0) (cst/sym? (kid n 0)))
      (let [h (cst/node-text (kid n 0))]
        (cond
          (and (def-head? h) (> (nkids n) 1))
          (let [nm (cst/strip-meta (kid n 1))]
            (if (cst/sym? nm) (dconj out (row (cst/node-text nm) h n plat hp)) out))
          (string=? h "declare") (dconj out (row "*declare*" h n plat hp))
          (string=? h "do") (let [m (nkids n)] (loop [i 1 acc out] (if (>= i m) acc (recur (+ i 1) (find-defs-into acc (kid n i) plat hp)))))
          :else out))
      (= :rc (ty n))
      (let [m (nkids n)]
        (loop [i 0 acc out]
          (if (>= (+ i 1) m) acc (recur (+ i 2) (find-defs-into acc (kid n (+ i 1)) (cst/node-text (kid n i)) true)))))
      :else out))))

;; the meta nodes attached in front of node (meta-exprs)
#?(:kotoba
(defn- meta-texts [src :string node [:ref :cst/node]] :string
  (loop [n node acc "" first true]
    (if (= :meta (ty n))
      (let [m (kid n 0)
            t (string-substring src (cst/node-s m) (cst/node-e m))]
        (recur (kid n 1) (if first t (string-concat acc (string-concat " " t))) false))
      acc))))

#?(:kotoba
(defn- doc-of [d [:ref :cst/node]] :string
  (let [a (kid d 2) b (kid d 3)]
    (cond (= :str (ty a)) (cst/node-text a)
          (= :str (ty b)) (cst/node-text b)
          :else ""))))

#?(:kotoba
(defn chunk-idx [c [:ref :graph/chunk]] :i64 (record-get [:ref :graph/chunk] c :idx)))
#?(:kotoba
(defn chunk-node [c [:ref :graph/chunk]] [:ref :cst/node] (record-get [:ref :graph/chunk] c :node)))
#?(:kotoba
(defn chunk-s [c [:ref :graph/chunk]] :i64 (record-get [:ref :graph/chunk] c :s)))
#?(:kotoba
(defn chunk-e [c [:ref :graph/chunk]] :i64 (record-get [:ref :graph/chunk] c :e)))
#?(:kotoba
(defn chunk-lead-s [c [:ref :graph/chunk]] :i64 (record-get [:ref :graph/chunk] c :lead-s)))
#?(:kotoba
(defn chunk-lines [c [:ref :graph/chunk]] :i64 (record-get [:ref :graph/chunk] c :lines)))
#?(:kotoba
(defn chunk-declares [c [:ref :graph/chunk]] [:list :string] (record-get [:ref :graph/chunk] c :declares)))
#?(:kotoba
(defn chunk-is-ns? [c [:ref :graph/chunk]] :bool (record-get [:ref :graph/chunk] c :is-ns)))
#?(:kotoba
(defn chunk-kotoba? [c [:ref :graph/chunk]] :bool (record-get [:ref :graph/chunk] c :kotoba)))
#?(:kotoba
(defn chunk-defs [c [:ref :graph/chunk]] [:list [:ref :graph/def]] (record-get [:ref :graph/chunk] c :defs)))
#?(:kotoba
(defn chunk-refs [c [:ref :graph/chunk]] [:list :string] (record-get [:ref :graph/chunk] c :refs)))
#?(:kotoba
(defn chunk-refs-hashed? [c [:ref :graph/chunk]] :bool (record-get [:ref :graph/chunk] c :refs-hashed)))
#?(:kotoba
(defn chunk-binds [c [:ref :graph/chunk]] [:list :string] (record-get [:ref :graph/chunk] c :binds)))

#?(:kotoba
(defn- mk-chunk [idx :i64 node [:ref :cst/node] s :i64 e :i64 lead :i64 lines :i64 declares [:list :string]
                 is-ns :bool kot :bool defs [:list [:ref :graph/def]]] [:ref :graph/chunk]
  (record-new [:ref :graph/chunk] idx node s e lead lines declares is-ns kot defs (strs) false (strs))))

#?(:kotoba
(defn- with-refs [c [:ref :graph/chunk] refs [:list :string] hashed :bool binds [:list :string]] [:ref :graph/chunk]
  (record-new [:ref :graph/chunk] (chunk-idx c) (chunk-node c) (chunk-s c) (chunk-e c) (chunk-lead-s c) (chunk-lines c)
              (chunk-declares c) (chunk-is-ns? c) (chunk-kotoba? c) (chunk-defs c) refs hashed binds)))

;; distinct names in order of first definition
#?(:kotoba
(defn chunk-names [c [:ref :graph/chunk]] [:list :string]
  (let [ds (chunk-defs c) m (defs-count ds)]
    (loop [i 0 seen (sset) acc (strs)]
      (if (>= i m)
        acc
        (let [nm (def-name (defs-at ds i))]
          (if (in? seen nm) (recur (+ i 1) seen acc) (recur (+ i 1) (sadd seen nm) (sconj acc nm)))))))))

#?(:kotoba
(defn- last-def [c [:ref :graph/chunk] nm :string] :i64
  (let [ds (chunk-defs c) m (defs-count ds)]
    (loop [i 0 k -1] (if (>= i m) k (recur (+ i 1) (if (string=? (def-name (defs-at ds i)) nm) i k)))))))

#?(:kotoba
(defn chunk-kind [c [:ref :graph/chunk] nm :string] :string
  (let [k (last-def c nm)] (if (< k 0) "" (def-head (defs-at (chunk-defs c) k))))))
#?(:kotoba
(defn chunk-private? [c [:ref :graph/chunk] nm :string] :bool
  (let [k (last-def c nm)] (and (>= k 0) (def-private? (defs-at (chunk-defs c) k))))))
#?(:kotoba
(defn chunk-dynamic? [c [:ref :graph/chunk] nm :string] :bool
  (let [k (last-def c nm)] (and (>= k 0) (def-dynamic? (defs-at (chunk-defs c) k))))))

;; (some true? (vals (:private c)))
#?(:kotoba
(defn chunk-any-private? [c [:ref :graph/chunk]] :bool
  (let [ns (chunk-names c) m (vector-count ns)]
    (loop [i 0] (cond (>= i m) false (chunk-private? c (snth ns i)) true :else (recur (+ i 1)))))))

;; (vec (sort (set (vals (:kinds c)))))
#?(:kotoba
(defn chunk-heads [c [:ref :graph/chunk]] [:list :string]
  (let [ns (chunk-names c) m (vector-count ns)]
    (ord/sort-strs (loop [i 0 seen (sset) acc (strs)]
                     (if (>= i m)
                       acc
                       (let [h (chunk-kind c (snth ns i))]
                         (if (in? seen h) (recur (+ i 1) seen acc) (recur (+ i 1) (sadd seen h) (sconj acc h))))))))))

#?(:kotoba
(defn count-newlines [src :string s :i64 e :i64] :i64
  (loop [i s k 0] (if (>= i e) k (let [p (string-code-point-at src i)] (recur (+ i (cpw p)) (if (= p 10) (+ k 1) k)))))))

#?(:kotoba
(defn- classify [src :string idx :i64 node [:ref :cst/node] lead :i64] [:ref :graph/chunk]
  (let [n (cst/strip-meta node)
        s (cst/node-s node)
        e (cst/node-e node)
        lines (+ 1 (count-newlines src s e))
        kot (includes? (string-substring src s e) ":kotoba")]
    (if (and (cst/lst? n) (> (nkids n) 0) (cst/sym-named? (kid n 0) "ns"))
      (mk-chunk idx node s e lead lines (strs) true kot (typed-list-new [:list [:ref :graph/def]]))
      (let [rows (find-defs-into (typed-list-new [:list [:ref :graph/def]]) node "" false)
            m (defs-count rows)]
        (loop [i 0 declares (strs) defs (typed-list-new [:list [:ref :graph/def]])]
          (if (>= i m)
            (mk-chunk idx node s e lead lines declares false kot defs)
            (let [r (defs-at rows i)
                  d (def-node r)]
              (if (string=? (def-name r) "*declare*")
                (recur (+ i 1)
                       (let [dm (nkids d)]
                         (loop [j 1 acc declares]
                           (if (>= j dm) acc
                               (recur (+ j 1) (let [t (sym-text (kid d j))] (if (> (string-byte-length t) 0) (sconj acc t) acc))))))
                       defs)
                (let [txt (meta-texts src (kid d 1))
                      h (def-head r)]
                  (recur (+ i 1) declares
                         (dconj defs (record-new [:ref :graph/def] (def-name r) h d (def-plat r) (def-has-plat? r)
                                                 (or (string=? h "defn-") (includes? txt ":private"))
                                                 (includes? txt ":dynamic")
                                                 (doc-of d))))))))))))))

;; ---------------------------------------------------------------------------
;; the scoped reference walk (refs-of)

#?(:kotoba
(defn- st-refs [st [:ref :graph/st]] [:list :string] (record-get [:ref :graph/st] st :refs)))
#?(:kotoba
(defn- st-seen [st [:ref :graph/st]] [:list :string] (record-get [:ref :graph/st] st :seen)))
#?(:kotoba
(defn- st-binds [st [:ref :graph/st]] [:list :string] (record-get [:ref :graph/st] st :binds)))
#?(:kotoba
(defn- st-bseen [st [:ref :graph/st]] [:list :string] (record-get [:ref :graph/st] st :bseen)))

#?(:kotoba
(defn- add-ref [st [:ref :graph/st] t :string] [:ref :graph/st]
  (if (in? (st-seen st) t)
    st
    (record-new [:ref :graph/st] (sconj (st-refs st) t) (sadd (st-seen st) t) (st-binds st) (st-bseen st)))))

#?(:kotoba
(defn- add-bind [st [:ref :graph/st] t :string] [:ref :graph/st]
  (if (in? (st-bseen st) t)
    st
    (record-new [:ref :graph/st] (st-refs st) (st-seen st) (sconj (st-binds st) t) (sadd (st-bseen st) t)))))

#?(:kotoba
(defn- sym-ref [st [:ref :graph/st] n [:ref :cst/node] env [:list :string] names [:ref :graph/top]] [:ref :graph/st]
  (let [t (cst/node-text n)]
    (if (and (top? names t) (not (in? env t))) (add-ref st t) st))))

;; visit the kids of n from index i on
#?(:kotoba
(defn- body-from [st [:ref :graph/st] n [:ref :cst/node] i :i64 env [:list :string] names [:ref :graph/top]] [:ref :graph/st]
  (let [m (nkids n)]
    (loop [j i s st] (if (>= j m) s (recur (+ j 1) (visit s (kid n j) env names)))))))

;; bindings that answer the extended env too: a pair record
#?(:kotoba
(defn- benv [st [:ref :graph/st] env [:list :string]] [:ref :graph/benv] (record-new [:ref :graph/benv] st env)))
#?(:kotoba
(defn- benv-st [b [:ref :graph/benv]] [:ref :graph/st] (record-get [:ref :graph/benv] b :st)))
#?(:kotoba
(defn- benv-env [b [:ref :graph/benv]] [:list :string] (record-get [:ref :graph/benv] b :env)))

#?(:kotoba
(defn- bindings-env [st0 [:ref :graph/st] v [:ref :cst/node] env0 [:list :string] names [:ref :graph/top]] [:ref :graph/benv]
  (let [m (nkids v)]
    (loop [i 0 st st0 env env0]
      (if (>= i m)
        (benv st env)
        (let [pat (kid v i)
              has-val (< (+ i 1) m)
              val (kid v (+ i 1))]
          (if (cst/kw? pat)
            (let [let-vec (and (string=? ":let" (cst/node-text pat)) has-val (= :vec (ty val)))]
              (if let-vec
                (let [b (bindings-env st val env names)] (recur (+ i 2) (benv-st b) (benv-env b)))
                (recur (+ i 2) (if has-val (visit st val env names) st) env)))
            (recur (+ i 2) (if has-val (visit st val env names) st) (env-plus env (pattern-syms pat))))))))))

;; fn-arity: params vector p, body = kids of n from index i
#?(:kotoba
(defn- fn-arity [st [:ref :graph/st] p [:ref :cst/node] n [:ref :cst/node] i :i64 env [:list :string] names [:ref :graph/top]] [:ref :graph/st]
  (body-from st n i (env-plus env (pattern-syms p)) names)))

;; arities over the kids of n from index i
#?(:kotoba
(defn- arities [st [:ref :graph/st] n [:ref :cst/node] i :i64 env [:list :string] names [:ref :graph/top]] [:ref :graph/st]
  (let [m (nkids n)]
    (if (and (< i m) (= :vec (ty (kid n i))))
      (fn-arity st (kid n i) n (+ i 1) env names)
      (loop [j i s st]
        (if (>= j m)
          s
          (let [a (kid n j)]
            (recur (+ j 1)
                   (if (and (= :list (ty a)) (> (nkids a) 0) (= :vec (ty (kid a 0))))
                     (fn-arity s (kid a 0) a 1 env names)
                     (visit s a env names))))))))))

#?(:kotoba
(defn- visit [st [:ref :graph/st] n [:ref :cst/node] env [:list :string] names [:ref :graph/top]] [:ref :graph/st]
  (let [t (ty n)]
    (cond
      (= t :sym) (sym-ref st n env names)
      (or (= t :kw) (= t :str) (= t :num) (= t :char) (= t :regex) (= t :nil)) st
      (= t :meta) (visit (visit st (kid n 0) env names) (kid n 1) env names)
      (= t :prefix) (if (string=? "'" (cst/node-prefix n)) st (visit st (kid n 0) env names))
      (= t :list) (visit-list st n env names)
      :else (body-from st n 0 env names)))))

#?(:kotoba
(defn- visit-call [st [:ref :graph/st] n [:ref :cst/node] env [:list :string] names [:ref :graph/top]] [:ref :graph/st]
  ;; the head in :call role: only a symbol head is a reference, which visit-list handles; any other head is visited
  (visit st n env names)))

#?(:kotoba
(defn- visit-list [st [:ref :graph/st] n [:ref :cst/node] env [:list :string] names [:ref :graph/top]] [:ref :graph/st]
  (let [m (nkids n)]
    (if (= m 0)
      st
      (let [h (kid n 0)
            ht (if (= :sym (ty h)) (cst/node-text h) "")
            is-sym (= :sym (ty h))
            r0 (kid n 1)
            nr (- m 1)]
        (cond
          (not is-sym) (body-from (visit-call st h env names) n 1 env names)
          (string=? ht "quote") st
          (or (string=? ht "declare") (string=? ht "ns")) st
          (or (string=? ht "def") (string=? ht "defonce")) (body-from st n 2 env names)
          (and (let-like? ht) (> nr 0) (= :vec (ty r0)))
          (if (string=? ht "binding")
            (let [bm (nkids r0)
                  st2 (loop [i 0 s st]
                        (if (>= i (- bm 1))
                          s
                          (let [tt (sym-text (kid r0 i))
                                s1 (if (and (> (string-byte-length tt) 0) (top? names tt)) (add-ref (add-bind s tt) tt) s)]
                            (recur (+ i 2) (visit s1 (kid r0 (+ i 1)) env names)))))]
              (body-from st2 n 2 env names))
            (let [b (bindings-env st r0 env names)]
              (body-from (benv-st b) n 2 (benv-env b) names)))
          (or (string=? ht "fn") (string=? ht "fn*"))
          (if (and (> nr 0) (= :sym (ty r0)))
            (arities st n 2 (sadd env (cst/node-text r0)) names)
            (arities st n 1 env names))
          (or (string=? ht "defn") (string=? ht "defn-"))
          (let [start (loop [i 2 s st]
                        (if (and (< i m) (let [tt (ty (kid n i))] (or (= tt :str) (= tt :map) (= tt :meta))))
                          (recur (+ i 1) s)
                          i))
                st2 (loop [i 2 s st]
                      (if (>= i start) s (recur (+ i 1) (if (= :map (ty (kid n i))) (visit s (kid n i) env names) s))))]
            (arities st2 n start env names))
          (and (string=? ht "letfn") (> nr 0) (= :vec (ty r0)))
          (let [fm (nkids r0)
                env2 (loop [i 0 e env]
                       (if (>= i fm) e
                           (recur (+ i 1) (let [f (kid r0 i)]
                                            (if (and (cst/lst? f) (> (nkids f) 0) (= :sym (ty (kid f 0))))
                                              (sadd e (cst/node-text (kid f 0))) e)))))
                st2 (loop [i 0 s st]
                      (if (>= i fm) s
                          (recur (+ i 1) (let [f (kid r0 i)]
                                           (if (and (cst/lst? f) (> (nkids f) 2) (= :vec (ty (kid f 1))))
                                             (fn-arity s (kid f 1) f 2 env2 names) s)))))]
            (body-from st2 n 2 env2 names))
          (and (string=? ht "catch") (>= nr 2))
          (let [tt (sym-text (kid n 2))]
            (body-from st n 3 (if (> (string-byte-length tt) 0) (sadd env tt) env) names))
          (and (string=? ht "as->") (>= nr 2))
          (let [tt (sym-text (kid n 2))]
            (body-from (visit st r0 env names) n 3 (if (> (string-byte-length tt) 0) (sadd env tt) env) names))
          (and (string=? ht "case") (> nr 0))
          (let [ncl (- nr 1)
                st1 (visit st r0 env names)
                ;; clauses are kids 2.. ; (range 0 (dec ncl) 2) visits clause i+1
                st2 (loop [i 0 s st1] (if (>= i (- ncl 1)) s (recur (+ i 2) (visit s (kid n (+ 2 (+ i 1))) env names))))]
            (if (= (bit-and ncl 1) 1) (visit st2 (kid n (+ 2 (- ncl 1))) env names) st2))
          (and (string=? ht "condp") (> nr 0)) (body-from st n 1 env names)
          :else (body-from (if (and (top? names ht) (not (in? env ht))) (add-ref st ht) st) n 1 env names)))))))

#?(:kotoba
(defn- refs-of [c [:ref :graph/chunk] names [:ref :graph/top]] [:ref :graph/chunk]
  (let [st (visit (record-new [:ref :graph/st] (strs) (sset) (strs) (sset)) (chunk-node c) (sset) names)
        own (chunk-names c)
        oset (env-plus (sset) own)
        all (st-refs st)
        m (vector-count all)
        kept (loop [i 0 acc (strs)] (if (>= i m) acc (recur (+ i 1) (if (in? oset (snth all i)) acc (sconj acc (snth all i))))))]
    ;; the host's refs map passed 8 keys (own names included) -> a hash map, its keys in HAMT order
    (with-refs c kept (> m 8) (st-binds st)))))

;; ---------------------------------------------------------------------------
;; analysis, adjacency, Tarjan

#?(:kotoba
(defn a-src [a [:ref :graph/a]] :string (record-get [:ref :graph/a] a :src)))
#?(:kotoba
(defn a-chunks [a [:ref :graph/a]] [:list [:ref :graph/chunk]] (record-get [:ref :graph/a] a :chunks)))
#?(:kotoba
(defn a-dc-names [a [:ref :graph/a]] [:list :string] (record-get [:ref :graph/a] a :dc-names)))
#?(:kotoba
(defn a-dc-hashed [a [:ref :graph/a]] :bool (record-get [:ref :graph/a] a :dc-hashed)))
#?(:kotoba
(defn- a-dc-tab [a [:ref :graph/a]] :vector-i64 (record-get [:ref :graph/a] a :dc-tab)))
#?(:kotoba
(defn- a-dc-vals [a [:ref :graph/a]] [:list :vector-i64] (record-get [:ref :graph/a] a :dc-vals)))
#?(:kotoba
(defn- dc-lookup [names [:list :string] tab :vector-i64 vals [:list :vector-i64] nm :string] :vector-i64
  (let [k (ord/tab-find tab names nm)] (if (< k 0) (vector-alloc 0) (typed-list-nth [:list :vector-i64] vals k)))))
#?(:kotoba
(defn a-adj [a [:ref :graph/a]] [:list [:ref :graph/adj]] (record-get [:ref :graph/a] a :adj)))
#?(:kotoba
(defn a-comps [a [:ref :graph/a]] [:list :vector-i64] (record-get [:ref :graph/a] a :comps)))
#?(:kotoba
(defn a-top-count [a [:ref :graph/a]] :i64 (vector-count (a-dc-names a))))
#?(:kotoba
(defn a-dc-of [a [:ref :graph/a] nm :string] :vector-i64
  (dc-lookup (a-dc-names a) (a-dc-tab a) (a-dc-vals a) nm)))
#?(:kotoba
(defn chunk-count [xs [:list [:ref :graph/chunk]]] :i64 (vector-count xs)))
#?(:kotoba
(defn chunk-at [xs [:list [:ref :graph/chunk]] i :i64] [:ref :graph/chunk] (typed-list-nth [:list [:ref :graph/chunk]] xs i)))
#?(:kotoba
(defn comps-count [xs [:list :vector-i64]] :i64 (vector-count xs)))
#?(:kotoba
(defn comps-at [xs [:list :vector-i64] i :i64] :vector-i64 (typed-list-nth [:list :vector-i64] xs i)))

#?(:kotoba
(defn adj-targets [x [:ref :graph/adj]] :vector-i64 (record-get [:ref :graph/adj] x :targets)))
#?(:kotoba
(defn adj-weights [x [:ref :graph/adj]] :vector-i64 (record-get [:ref :graph/adj] x :weights)))
#?(:kotoba
(defn adj-hashed? [x [:ref :graph/adj]] :bool (record-get [:ref :graph/adj] x :hashed)))
#?(:kotoba
(defn adj-at [xs [:list [:ref :graph/adj]] i :i64] [:ref :graph/adj] (typed-list-nth [:list [:ref :graph/adj]] xs i)))

;; (keys (get adj u)) in cljs order
#?(:kotoba
(defn adj-keys-in-order [x [:ref :graph/adj]] :vector-i64
  (let [ts (adj-targets x)
        o (ord/map-order-ints ts (adj-hashed? x))
        n (vector-count o)]
    (loop [i 0 acc (vector-alloc 0)] (if (>= i n) acc (recur (+ i 1) (vector-conj acc (vector-at ts (vector-at o i)))))))))

;; (keys (:refs c)) in cljs order
#?(:kotoba
(defn chunk-refs-in-map-order [c [:ref :graph/chunk]] [:list :string]
  (let [rs (chunk-refs c)
        o (ord/map-order-strs rs (chunk-refs-hashed? c))
        n (vector-count o)]
    (loop [i 0 acc (strs)] (if (>= i n) acc (recur (+ i 1) (sconj acc (snth rs (vector-at o i)))))))))

#?(:kotoba
(defn chunk-refers? [c [:ref :graph/chunk] nm :string] :bool
  (let [rs (chunk-refs c) n (vector-count rs)]
    (loop [i 0] (cond (>= i n) false (string=? (snth rs i) nm) true :else (recur (+ i 1)))))))

#?(:kotoba
(defn chunk-binds? [c [:ref :graph/chunk] nm :string] :bool
  (let [rs (chunk-binds c) n (vector-count rs)]
    (loop [i 0] (cond (>= i n) false (string=? (snth rs i) nm) true :else (recur (+ i 1)))))))

#?(:kotoba
(defn- vindex [v :vector-i64 x :i64] :i64
  (let [n (vector-count v)] (loop [i 0] (cond (>= i n) -1 (= (vector-at v i) x) i :else (recur (+ i 1)))))))

;; adjacency rows are mutable while built: a :vector-i64 per row inside a list rebuilt per bump is O(n) per bump, so
;; bumps go to a flat log first and rows are made once.
#?(:kotoba
(defn- bump-row [x [:ref :graph/adj] v :i64] [:ref :graph/adj]
  (let [ts (adj-targets x) k (vindex ts v)]
    (if (< k 0)
      (let [ts2 (vector-conj ts v)]
        (record-new [:ref :graph/adj] ts2 (vector-conj (adj-weights x) 1) (or (adj-hashed? x) (> (vector-count ts2) 8))))
      (record-new [:ref :graph/adj] ts (vector-assoc (adj-weights x) k (+ 1 (vector-at (adj-weights x) k))) (adj-hashed? x))))))

#?(:kotoba
(defn- empty-adj [] [:ref :graph/adj] (record-new [:ref :graph/adj] (vector-alloc 0) (vector-alloc 0) false)))

;; bumps (u v pairs flattened, in order) -> adjacency rows
#?(:kotoba
(defn- rows-of [n :i64 log :vector-i64] [:list [:ref :graph/adj]]
  (let [lm (quot (vector-count log) 2)
        ;; per u, the list of v in bump order: counting sort by u (stable)
        cnt (vector-alloc (+ n 1))
        _c (loop [i 0] (if (>= i lm) 0 (let [u (vector-at log (* 2 i)) _ (vector-assoc! cnt (+ u 1) (+ 1 (vector-at cnt (+ u 1))))] (recur (+ i 1)))))
        _p (loop [u 0] (if (>= u n) 0 (let [_ (vector-assoc! cnt (+ u 1) (+ (vector-at cnt (+ u 1)) (vector-at cnt u)))] (recur (+ u 1)))))
        start (loop [u 0 acc (vector-alloc 0)] (if (> u n) acc (recur (+ u 1) (vector-conj acc (vector-at cnt u)))))
        pos (loop [u 0 acc (vector-alloc 0)] (if (> u n) acc (recur (+ u 1) (vector-conj acc (vector-at cnt u)))))
        sorted (vector-alloc lm)
        _s (loop [i 0] (if (>= i lm) 0
                           (let [u (vector-at log (* 2 i))
                                 p (vector-at pos u)
                                 _a (vector-assoc! sorted p (vector-at log (+ (* 2 i) 1)))
                                 _b (vector-assoc! pos u (+ p 1))]
                             (recur (+ i 1)))))]
    (loop [u 0 acc (typed-list-new [:list [:ref :graph/adj]])]
      (if (>= u n)
        acc
        (let [row (loop [k (vector-at start u) x (empty-adj)]
                    (if (>= k (vector-at start (+ u 1))) x (recur (+ k 1) (bump-row x (vector-at sorted k)))))]
          (recur (+ u 1) (typed-list-conj [:list [:ref :graph/adj]] acc row))))))))

#?(:kotoba
(defn- push2 [log :vector-i64 u :i64 v :i64] :vector-i64 (vector-conj (vector-conj log u) v)))

#?(:kotoba
(defn- build-adj [chunks [:list [:ref :graph/chunk]] dc-names [:list :string] dc-hashed :bool dc-tab :vector-i64 dc-vals [:list :vector-i64]]
  [:list [:ref :graph/adj]]
  (let [n (chunk-count chunks)
        log1 (loop [ci 0 log (vector-alloc 0)]
               (if (>= ci n)
                 log
                 (let [c (chunk-at chunks ci)
                       rs (chunk-refs-in-map-order c)
                       rm (vector-count rs)
                       idx (chunk-idx c)]
                   (recur (+ ci 1)
                          (loop [ri 0 lg log]
                            (if (>= ri rm)
                              lg
                              (let [ts (dc-lookup dc-names dc-tab dc-vals (snth rs ri))
                                    tm (vector-count ts)]
                                (recur (+ ri 1)
                                       (loop [ti 0 l lg]
                                         (if (>= ti tm) l
                                             (recur (+ ti 1) (if (= (vector-at ts ti) idx) l (push2 l idx (vector-at ts ti))))))))))))))
        o (ord/map-order-strs dc-names dc-hashed)
        om (vector-count o)
        log2 (loop [k 0 log log1]
               (if (>= k om)
                 log
                 (let [idxs (typed-list-nth [:list :vector-i64] dc-vals (vector-at o k))
                       im (vector-count idxs)]
                   (recur (+ k 1)
                          (loop [i 0 l log]
                            (if (>= i im) l
                                (recur (+ i 1)
                                       (loop [j 0 l2 l]
                                         (if (>= j im) l2
                                             (recur (+ j 1) (if (= i j) l2 (push2 l2 (vector-at idxs i) (vector-at idxs j)))))))))))))]
    (rows-of n log2))))

;; Tarjan (the host's iterative version: same visiting order, so the same SCC order). adjacency: per vertex its
;; successors in cljs key order; skip: vertices left out (a 0/1 vector).
#?(:kotoba
(defn- succ-of [succ [:list :vector-i64] v :i64] :vector-i64 (typed-list-nth [:list :vector-i64] succ v)))

#?(:kotoba
(defn tarjan [n :i64 succ [:list :vector-i64] skip :vector-i64] [:list :vector-i64]
  (let [idx (loop [i 0 acc (vector-alloc 0)] (if (>= i n) acc (recur (+ i 1) (vector-conj acc -1))))
        low (vector-alloc n)
        on (vector-alloc n)
        ;; frames: vertex and the position in its successor list
        fv (vector-alloc (+ n 1))
        fp (vector-alloc (+ n 1))
        stack (vector-alloc (+ n 1))]
    (loop [root 0 nf 0 ns 0 counter 0 comps (typed-list-new [:list :vector-i64])]
      (cond
        (> nf 0)
        (let [v (vector-at fv (- nf 1))
              p (vector-at fp (- nf 1))
              ws (succ-of succ v)]
          (if (< p (vector-count ws))
            (let [w (vector-at ws p)
                  _a (vector-assoc! fp (- nf 1) (+ p 1))]
              (cond
                (< (vector-at idx w) 0)
                (let [_1 (vector-assoc! idx w counter) _2 (vector-assoc! low w counter)
                      _3 (vector-assoc! stack ns w) _4 (vector-assoc! on w 1)
                      _5 (vector-assoc! fv nf w) _6 (vector-assoc! fp nf 0)]
                  (recur root (+ nf 1) (+ ns 1) (+ counter 1) comps))
                (= (vector-at on w) 1)
                (let [_1 (if (< (vector-at idx w) (vector-at low v)) (vector-assoc! low v (vector-at idx w)) low)]
                  (recur root nf ns counter comps))
                :else (recur root nf ns counter comps)))
            ;; v done
            (let [nf2 (- nf 1)
                  _1 (if (> nf2 0)
                       (let [pv (vector-at fv (- nf2 1))]
                         (if (< (vector-at low v) (vector-at low pv)) (vector-assoc! low pv (vector-at low v)) low))
                       low)]
              (if (= (vector-at low v) (vector-at idx v))
                (let [r (loop [k ns comp (vector-alloc 0)]
                          (let [w (vector-at stack (- k 1))
                                _ (vector-assoc! on w 0)]
                            (if (= w v) (+ (* (- k 1) 1) 0) (recur (- k 1) comp))))
                      comp (loop [k r acc (vector-alloc 0)] (if (>= k ns) acc (recur (+ k 1) (vector-conj acc (vector-at stack k)))))]
                  (recur root nf2 r counter (typed-list-conj [:list :vector-i64] comps (ord/sort-ints comp))))
                (recur root nf2 ns counter comps)))))
        (< root n)
        (if (or (= (vector-at skip root) 1) (>= (vector-at idx root) 0))
          (recur (+ root 1) nf ns counter comps)
          (let [_1 (vector-assoc! idx root counter) _2 (vector-assoc! low root counter)
                _3 (vector-assoc! stack ns root) _4 (vector-assoc! on root 1)
                _5 (vector-assoc! fv 0 root) _6 (vector-assoc! fp 0 0)]
            (recur (+ root 1) 1 (+ ns 1) (+ counter 1) comps)))
        :else comps)))))

#?(:kotoba
(defn analysis [src :string] [:ref :graph/a]
  (let [tops (cst/out-nodes (cst/parse src))
        tn (vector-count tops)
        chunks0 (loop [i 0 prev 0 acc (typed-list-new [:list [:ref :graph/chunk]])]
                  (if (>= i tn)
                    acc
                    (let [t (nodes-nth tops i)]
                      (recur (+ i 1) (cst/node-e t) (typed-list-conj [:list [:ref :graph/chunk]] acc (classify src i t prev))))))
        n (chunk-count chunks0)
        ;; def-chunks: name -> [idx..] in insertion order of names
        dcr (loop [ci 0 names (strs) tab (ord/tab-new) vals (typed-list-new [:list :vector-i64])]
              (if (>= ci n)
                (record-new [:ref :graph/a] src chunks0 names false tab vals
                            (typed-list-new [:list [:ref :graph/adj]]) (typed-list-new [:list :vector-i64]))
                (let [c (chunk-at chunks0 ci)
                      ns (chunk-names c)
                      nm (vector-count ns)
                      r (loop [k 0 names2 names tab2 tab vals2 vals]
                          (if (>= k nm)
                            (record-new [:ref :graph/a] src chunks0 names2 false tab2 vals2
                                        (typed-list-new [:list [:ref :graph/adj]]) (typed-list-new [:list :vector-i64]))
                            (let [x (snth ns k)
                                  at (ord/tab-find tab2 names2 x)]
                              (if (< at 0)
                                (let [names3 (sconj names2 x)]
                                  (recur (+ k 1) names3 (ord/tab-add tab2 names3 (- (vector-count names3) 1))
                                         (typed-list-conj [:list :vector-i64] vals2 (vector-conj (vector-alloc 0) (chunk-idx c)))))
                                (let [v (typed-list-nth [:list :vector-i64] vals2 at)]
                                  (if (>= (vindex v (chunk-idx c)) 0)
                                    (recur (+ k 1) names2 tab2 vals2)
                                    ;; a name defined in a second chunk: rebuild the value list (rare)
                                    (recur (+ k 1) names2 tab2
                                           (let [vm (vector-count vals2)]
                                             (loop [j 0 acc (typed-list-new [:list :vector-i64])]
                                               (if (>= j vm) acc
                                                   (recur (+ j 1) (typed-list-conj [:list :vector-i64] acc
                                                                                   (if (= j at) (vector-conj v (chunk-idx c))
                                                                                       (typed-list-nth [:list :vector-i64] vals2 j))))))))))))))]
                  (recur (+ ci 1) (a-dc-names r) (a-dc-tab r) (a-dc-vals r)))))
        dc-names (a-dc-names dcr)
        dc-tab (a-dc-tab dcr)
        dc-vals (a-dc-vals dcr)
        topset (record-new [:ref :graph/top] dc-names dc-tab)
        chunks (loop [ci 0 acc (typed-list-new [:list [:ref :graph/chunk]])]
                 (if (>= ci n)
                   acc
                   (let [c (chunk-at chunks0 ci)]
                     (recur (+ ci 1) (typed-list-conj [:list [:ref :graph/chunk]] acc (if (chunk-is-ns? c) c (refs-of c topset)))))))
        hashed (> (vector-count dc-names) 8)
        adj (build-adj chunks dc-names hashed dc-tab dc-vals)
        succ (loop [u 0 acc (typed-list-new [:list :vector-i64])]
               (if (>= u n) acc (recur (+ u 1) (typed-list-conj [:list :vector-i64] acc (adj-keys-in-order (adj-at adj u))))))
        skip (loop [u 0 acc (vector-alloc 0)]
               (if (>= u n) acc (recur (+ u 1) (vector-conj acc (if (chunk-is-ns? (chunk-at chunks u)) 1 0)))))
        comps (tarjan n succ skip)]
    (record-new [:ref :graph/a] src chunks dc-names hashed dc-tab dc-vals adj comps))))

#?(:kotoba
(defn line-of [src :string off :i64] :i64 (+ 1 (count-newlines src 0 off))))

#?(:kotoba
(defn chunk-label [c [:ref :graph/chunk]] :string
  (let [ns (chunk-names c)]
    (cond (> (vector-count ns) 0) (snth ns 0)
          (> (vector-count (chunk-declares c)) 0) (string-concat "declare:" (snth (chunk-declares c) 0))
          (chunk-is-ns? c) "ns"
          :else (string-concat "form#" (string-from-i64 (chunk-idx c))))))
   :default
   (do
(def def-heads #{"def" "defn" "defn-" "defonce" "defmacro" "defmulti" "defrecord" "deftype" "defprotocol"})
(def let-like #{"let" "loop" "when-let" "if-let" "when-some" "if-some" "with-open" "let*" "binding" "doseq" "for" "dotimes"})
(def skip-syms #{"&" "_"})

(defn- sym-text [n]
  (let [n (cst/strip-meta n)] (when (= :sym (:type n)) (:text n))))

(defn- rc? [n] (= :rc (:type n)))

(defn pattern-syms
  "All binder symbols in a destructuring pattern (vectors, maps, reader conditionals)."
  [n]
  (case (:type n)
    :sym (if (and (not (contains? skip-syms (:text n))) (not (str/includes? (:text n) "/"))) #{(:text n)} #{})
    :meta (pattern-syms (second (:kids n)))
    :map (let [kids (vec (:kids n))]
           (loop [i 0 out #{}]
             (if (>= i (count kids))
               out
               (let [k (nth kids i) v (get kids (inc i))]
                 (recur (+ i 2)
                        (cond
                          (and (cst/kw? k) (contains? #{":keys" ":strs" ":syms"} (:text k)) v)
                          (into out (for [s (:kids v) :when (cst/sym? s)] (last (str/split (:text s) #"/"))))
                          (and (cst/kw? k) (= ":as" (:text k)) v) (into out (pattern-syms v))
                          (and (cst/kw? k) (= ":or" (:text k))) out
                          (not (cst/kw? k)) (into out (pattern-syms k))
                          :else out))))))
    (:vec :rc :list) (reduce into #{} (map pattern-syms (:kids n)))
    #{}))

(defn- meta-exprs
  "Meta nodes attached in front of node."
  [node]
  (loop [n node out []]
    (if (= :meta (:type n)) (recur (second (:kids n)) (conj out (first (:kids n)))) out)))

(defn- find-defs
  "[[name head defnode platform-key] ...] for def forms at the chunk's top, descending through reader conditionals/do.
  platform-key is the reader-conditional feature the def sits under (nil = all)."
  ([node] (find-defs node nil))
  ([node plat]
   (let [n (cst/strip-meta node)]
     (cond
       (and (cst/lst? n) (seq (:kids n)) (cst/sym? (first (:kids n))))
       (let [h (:text (first (:kids n)))]
         (cond
           (and (contains? def-heads h) (> (count (:kids n)) 1))
           (let [nm (cst/strip-meta (second (:kids n)))]
             (if (cst/sym? nm) [[(:text nm) h n plat]] []))
           (= h "declare") [["*declare*" h n plat]]
           (= h "do") (vec (mapcat #(find-defs % plat) (rest (:kids n))))
           :else []))
       (rc? n) (vec (mapcat (fn [[k v]] (find-defs v (:text k))) (partition 2 (:kids n))))
       :else []))))

(defn- classify [src idx node lead-s]
  (let [n (cst/strip-meta node)
        base {:idx idx :node node :s (:s node) :e (:e node) :lead-s lead-s :text (subs src (:s node) (:e node))
              :lines (inc (count (filter #(= \newline %) (subs src (:s node) (:e node))))) :names [] :kinds {} :plats {} :defnodes {} :private {} :dynamic {} :declares [] :doc {} :refs {}
              :binds #{} :is-ns false :has-kotoba-branch (boolean (str/includes? (subs src (:s node) (:e node)) ":kotoba"))}]
    (if (and (cst/lst? n) (seq (:kids n)) (cst/sym? (first (:kids n)) "ns"))
      (assoc base :is-ns true)
      (reduce
       (fn [ch [name head d plat]]
         (if (= name "*declare*")
           (update ch :declares into (keep sym-text (rest (:kids d))))
           (let [txt (str/join " " (map #(subs src (:s %) (:e %)) (meta-exprs (second (:kids d)))))
                 doc (some #(when (= :str (:type %)) (:text %)) (take 2 (drop 2 (:kids d))))]
             (-> ch
                 (update :names #(if (some #{name} %) % (conj % name)))
                 (assoc-in [:kinds name] head)
                 (update-in [:plats name] (fnil conj #{}) plat)
                 (update-in [:defnodes name] (fnil conj []) d)
                 (assoc-in [:private name] (boolean (or (= head "defn-") (str/includes? txt ":private"))))
                 (assoc-in [:dynamic name] (boolean (str/includes? txt ":dynamic")))
                 (cond-> doc (assoc-in [:doc name] doc))))))
       base (find-defs node)))))

;; ---- scoped reference walk ------------------------------------------------------------------------------------------

(defn- refs-of
  "-> {:refs {name {:call n :value n}} :ref-order [names in order of first reference] :binds #{names rebound with `binding`}}
  for one chunk."
  [ch names]
  (let [refs (volatile! {}) binds (volatile! #{}) order (volatile! [])
        add (fn [name role]
              (when-not (contains? @refs name) (vswap! order conj name))
              (vswap! refs update-in [name role] (fnil inc 0)))]
    (letfn [(sym* [n env role] (let [t (:text n)] (when (and (contains? names t) (not (contains? env t))) (add t role))))
            (body [forms env] (doseq [f forms] (visit f env :value)))
            (bindings [vec-node env]
              (let [kids (vec (:kids vec-node))]
                (loop [i 0 env env]
                  (if (>= i (count kids))
                    env
                    (let [pat (nth kids i) val (get kids (inc i))]
                      (if (cst/kw? pat)
                        (do (cond (and (= ":let" (:text pat)) val (= :vec (:type val))) nil
                                  val (visit val env :value))
                            (recur (+ i 2) (if (and (= ":let" (:text pat)) val (= :vec (:type val))) (bindings val env) env)))
                        (do (when val (visit val env :value))
                            (recur (+ i 2) (into env (pattern-syms pat))))))))))
            (fn-arity [params rest-forms env] (body rest-forms (into env (pattern-syms params))))
            (arities [r env]
              (if (and (seq r) (= :vec (:type (first r))))
                (fn-arity (first r) (rest r) env)
                (doseq [a r]
                  (if (and (= :list (:type a)) (seq (:kids a)) (= :vec (:type (first (:kids a)))))
                    (fn-arity (first (:kids a)) (rest (:kids a)) env)
                    (visit a env :value)))))
            (visit [n env role]
              (case (:type n)
                :sym (sym* n env role)
                (:kw :str :num :char :regex) nil
                :meta (do (visit (first (:kids n)) env :value) (visit (second (:kids n)) env role))
                :prefix (when-not (= "'" (:prefix n)) (visit (first (:kids n)) env :value))
                :list (visit-list n env)
                (doseq [c (:kids n)] (visit c env :value))))
            (visit-list [n env]
              (when (seq (:kids n))
                (let [h (first (:kids n))
                      ht (when (= :sym (:type h)) (:text h))
                      rest* (vec (rest (:kids n)))]
                  (cond
                    (nil? ht) (do (visit h env :call) (body rest* env))
                    (= ht "quote") nil
                    (contains? #{"declare" "ns"} ht) nil
                    (contains? #{"def" "defonce"} ht) (body (rest rest*) env)
                    (and (contains? let-like ht) (seq rest*) (= :vec (:type (first rest*))))
                    (if (= ht "binding")
                      (let [kids (vec (:kids (first rest*)))]
                        (doseq [i (range 0 (dec (count kids)) 2)]
                          (let [t (sym-text (nth kids i))]
                            (when (and t (contains? names t))
                              (vswap! binds conj t)
                              (add t :value))
                            (visit (nth kids (inc i)) env :value)))
                        (body (rest rest*) env))
                      (body (rest rest*) (bindings (first rest*) env)))
                    (contains? #{"fn" "fn*"} ht)
                    (let [r rest*
                          [env r] (if (and (seq r) (= :sym (:type (first r)))) [(conj env (:text (first r))) (rest r)] [env r])]
                      (arities (vec r) env))
                    (contains? #{"defn" "defn-"} ht)
                    (let [r (vec (rest rest*))                       ; drop the name
                          r (loop [r r]
                              (if (and (seq r) (contains? #{:str :map :meta} (:type (first r))))
                                (do (when (= :map (:type (first r))) (visit (first r) env :value)) (recur (vec (rest r))))
                                r))]
                      (arities r env))
                    (and (= ht "letfn") (seq rest*) (= :vec (:type (first rest*))))
                    (let [fns (:kids (first rest*))
                          env2 (into env (for [f fns :when (and (cst/lst? f) (seq (:kids f)) (= :sym (:type (first (:kids f)))))]
                                           (:text (first (:kids f)))))]
                      (doseq [f fns]
                        (when (and (cst/lst? f) (> (count (:kids f)) 2) (= :vec (:type (second (:kids f)))))
                          (fn-arity (second (:kids f)) (drop 2 (:kids f)) env2)))
                      (body (rest rest*) env2))
                    (and (= ht "catch") (>= (count rest*) 2))
                    (body (drop 2 rest*) (if-let [t (sym-text (second rest*))] (conj env t) env))
                    (and (= ht "as->") (>= (count rest*) 2))
                    (do (visit (first rest*) env :value)
                        (body (drop 2 rest*) (if-let [t (sym-text (second rest*))] (conj env t) env)))
                    (and (= ht "case") (seq rest*))
                    (let [cl (vec (rest rest*))]
                      (visit (first rest*) env :value)
                      (doseq [i (range 0 (dec (count cl)) 2)] (visit (nth cl (inc i)) env :value))
                      (when (odd? (count cl)) (visit (peek cl) env :value)))
                    (and (= ht "condp") (seq rest*)) (body rest* env)
                    :else (do (when (and (contains? names ht) (not (contains? env ht))) (add ht :call))
                              (body rest* env))))))]
      (visit (:node ch) #{} :value))
    {:refs (apply dissoc @refs (:names ch)) :binds @binds
     :ref-order (vec (remove (set (:names ch)) @order))}))

(defn analyze
  "-> {:chunks [..] :def-chunks {name [idx]} :top-names #{..}} for the source text."
  [src]
  (let [tops (cst/parse src)
        chunks (loop [i 0 prev 0 ts tops out []]
                 (if-let [t (first ts)]
                   (recur (inc i) (:e t) (rest ts) (conj out (classify src i t prev)))
                   out))
        def-chunks (reduce (fn [m ch] (reduce (fn [m nm] (update m nm (fnil (fn [v] (if (some #{(:idx ch)} v) v (conj v (:idx ch)))) []))) m (:names ch)))
                           {} chunks)
        names (set (keys def-chunks))
        chunks (mapv (fn [ch] (if (:is-ns ch) ch (merge ch (refs-of ch names)))) chunks)]
    {:chunks chunks :def-chunks def-chunks :top-names names :src src}))

(defn line-of [src off]
  (loop [i 0 n 1] (let [j (str/index-of src "\n" i)] (if (and j (< j off)) (recur (inc j) (inc n)) n))))

(defn- lines-of [ch] (:lines ch))

;; ---- graph ----------------------------------------------------------------------------------------------------------

(defn build
  "-> [analysis adj]; adj is a vector (per chunk) of {target weight}: weight = distinct referenced names."
  [src]
  (let [a (analyze src)
        n (count (:chunks a))
        adj (volatile! (vec (repeat n {})))
        bump (fn [u v] (vswap! adj update u update v (fnil inc 0)))]
    (doseq [c (:chunks a) r (keys (:refs c)) t (get (:def-chunks a) r) :when (not= t (:idx c))] (bump (:idx c) t))
    (doseq [[_ idxs] (:def-chunks a) i idxs j idxs :when (not= i j)] (bump i j))      ; one name in several chunks: keep together
    [a @adj]))

(defn tarjan
  "Strongly connected components (iterative), dependencies first; skip is a set of vertices left out."
  [n adj skip]
  (let [adj (vec adj)]
    (loop [roots (remove skip (range n)) idx {} low {} stack [] on #{} comps [] counter 0 frames []]
      (cond
        (seq frames)
        (let [[v ws] (peek frames) frames (pop frames)]
          (if-let [w (first ws)]
            (let [frames (conj frames [v (rest ws)])]
              (cond
                (not (contains? idx w))
                (recur roots (assoc idx w counter) (assoc low w counter) (conj stack w) (conj on w) comps (inc counter)
                       (conj frames [w (keys (get adj w))]))
                (contains? on w) (recur roots idx (update low v min (get idx w)) stack on comps counter frames)
                :else (recur roots idx low stack on comps counter frames)))
            ;; v done
            (let [low (if-let [[p _] (peek frames)] (update low p min (get low v)) low)
                  [stack on comps]
                  (if (= (get low v) (get idx v))
                    (loop [stack stack on on comp []]
                      (let [w (peek stack) stack (pop stack) on (disj on w) comp (conj comp w)]
                        (if (= w v) [stack on (conj comps (vec (sort comp)))] (recur stack on comp))))
                    [stack on comps])]
              (recur roots idx low stack on comps counter frames))))
        (seq roots)
        (let [v (first roots)]
          (if (contains? idx v)
            (recur (rest roots) idx low stack on comps counter frames)
            (recur (rest roots) (assoc idx v counter) (assoc low v counter) (conj stack v) (conj on v) comps (inc counter)
                   [[v (keys (get adj v))]])))
        :else comps))))

(defn chunk-label [c]
  (cond (seq (:names c)) (first (:names c))
        (seq (:declares c)) (str "declare:" (first (:declares c)))
        (:is-ns c) "ns"
        :else (str "form#" (:idx c))))

(defn graph-data
  "The graph.edn payload: nodes, weighted edges, cyclic SCCs, dynamic vars (defined in / read by / bound by)."
  [a adj comps src]
  (let [chunks (:chunks a)
        edges (vec (for [u (range (count adj)) [v w] (sort (get adj u))] [u v w]))
        scc (filter #(> (count %) 1) comps)]
    {:format :kotoba.refactor/v1
     :kind :graph
     :source-forms (count chunks)
     :names (count (:top-names a))
     :edges (count edges)
     :nodes (vec (for [c chunks]
                   {:id (:idx c) :names (:names c) :head (vec (sort (set (vals (:kinds c)))))
                    :line (line-of src (:s c)) :lines (lines-of c)
                    :private (boolean (and (seq (:names c)) (some true? (vals (:private c)))))
                    :dynamic (vec (filter #(get (:dynamic c) %) (:names c)))
                    :declares (:declares c)
                    :kotoba-branch (:has-kotoba-branch c)
                    :binds-dynamic (vec (sort (:binds c)))}))
     :edge-list edges
     :sccs (vec (for [c scc] {:size (count c) :lines (reduce + (map #(lines-of (nth chunks %)) c)) :members c}))
     :dynamic-vars (into (sorted-map)
                         (for [c chunks x (:names c) :when (get (:dynamic c) x)]
                           [x {:defined-in (:idx c)
                               :read-by (vec (sort (for [d chunks :when (and (contains? (:refs d) x) (not (contains? (:binds d) x)))] (:idx d))))
                               :bound-by (vec (sort (for [d chunks :when (contains? (:binds d) x)] (:idx d))))}]))}))

(defn analysis
  "Everything graph/partition/split need: the analysis, the adjacency, the SCCs (dependencies first)."
  [src]
  (let [[a adj] (build src)
        skip (set (for [c (:chunks a) :when (:is-ns c)] (:idx c)))
        comps (tarjan (count (:chunks a)) adj skip)]
    (assoc a :adj adj :comps comps)))
))
