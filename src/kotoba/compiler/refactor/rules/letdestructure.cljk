;; Rule (e) (extension of (a)): destructuring in `let` binding vectors, flattened in place.
;;
;;   (let [[a b] (f x) m 1] ...)   ->   (let [dd__N_1 (f x) a (fe-nth dd__N_1 0) b (fe-nth dd__N_1 1) m 1] ...)
;;
;; Same expansion as Clojure's own `let` destructuring (nth with nil not-found, get, nthnext), so the host result is the
;; same.  The body is untouched.  `loop` / `doseq` / `for` / `when-let` / `if-let` are not rewritten: their binding forms
;; carry a test or a recur target, which is a restructuring and not a flattening.
(ns kotoba.compiler.refactor.rules.letdestructure
  {:kotoba/export #?(:kotoba [find-all]
                     :default [find-all rule])}
  (:require #?@(:kotoba [[kotoba.compiler.refactor.cst :as cst]
                         [kotoba.compiler.refactor.edit :as edit]
                         [kotoba.compiler.refactor.finding :as fd]
                         [kotoba.compiler.refactor.rules.destructure :as d]]
                :default [[clojure.string :as str]
                          [kotoba.compiler.refactor.cst :as cst]
                          [kotoba.compiler.refactor.edit :as edit]
                          [kotoba.compiler.refactor.rules.destructure :as d]]))
  #?(:kotoba (:schemas {:let/r [:record :let/r [[:human :string] [:edits [:list [:ref :edit/e]]]]]})))

;; ---------------------------------------------------------------------------
;; Kotoba reading: the forms of the guest twin kotoba-lang lang/compat/kotoba/compiler/refactor/rules/letdestructure.kotoba
;; (claude/refactor-twins-parity 1c7260f), moved verbatim, each in a #?(:kotoba ...) form; the last one carries the
;; host reading (the whole host program, unchanged) as its :default arm.  The twin's header follows.
;; kotoba.compiler.refactor.rules.letdestructure -- the GUEST-ROUTE twin of amu's
;; `src/kotoba/compiler/refactor/rules/letdestructure.cljk`, rule (e): destructuring in `let` binding vectors,
;; flattened in place with the expansion of rule (a) (kotoba.compiler.refactor.rules.destructure twin).
;;   (find-all src nodes) -> [:list :finding/f]   in the host's order


#?(:kotoba
(defn- kid [n [:ref :cst/node] i :i64] [:ref :cst/node]
  (let [ks (cst/node-kids n)] (if (< i (vector-count ks)) (typed-list-nth [:list [:ref :cst/node]] ks i) (cst/nil-node)))))
#?(:kotoba
(defn- nkids [n [:ref :cst/node]] :i64 (vector-count (cst/node-kids n))))
#?(:kotoba
(defn- sconj [xs [:list :string] s :string] [:list :string] (typed-list-conj [:list :string] xs s)))
#?(:kotoba
(defn- snth [xs [:list :string] i :i64] :string (typed-list-nth [:list :string] xs i)))

#?(:kotoba
(defn- join [xs [:list :string] sep :string] :string
  (let [n (vector-count xs)]
    (loop [i 0 acc ""] (if (>= i n) acc (recur (+ i 1) (if (= i 0) (snth xs 0) (string-concat acc (string-concat sep (snth xs i))))))))))

#?(:kotoba
(defn- any-pat? [bv [:ref :cst/node]] :bool
  (let [m (nkids bv)] (loop [k 0] (cond (>= (+ k 1) m) false (d/pat? (kid bv k)) true :else (recur (+ k 2)))))))

#?(:kotoba
(defn- line-start [starts [:list :i64] off :i64] :i64
  (typed-list-nth [:list :i64] starts (- (edit/offset->line starts off) 1))))

#?(:kotoba
(defn find-all [src :string nodes [:list [:ref :cst/node]]] [:list [:ref :finding/f]]
  (let [vs (cst/walk-visits nodes)
        nv (vector-count vs)
        starts (edit/line-starts src)
        ix (fd/u16-index src)]
    (loop [i 0 out (fd/fs-new)]
      (if (>= i nv)
        out
        (let [v (typed-list-nth [:list [:ref :cst/visit]] vs i)
              n (cst/visit-node v)
              bv (kid n 1)]
          (if (not (and (cst/lst? n) (string=? "let" (cst/head-text n)) (cst/vec? bv) (any-pat? bv)))
            (recur (+ i 1) out)
            (let [m (nkids bv)
                  base (fd/u16-off ix (cst/node-s n))
                  line (edit/offset->line starts (cst/node-s n))
                  region (cst/visit-region v)
                  ;; per pattern pair: an edit or the first human reason (the counter runs over the pairs in order)
                  r (loop [k 0 c 0 es (edit/edits-new)]
                      (if (>= (+ k 1) m)
                        (record-new [:ref :let/r] "" es)
                        (let [p (kid bv k) vn (kid bv (+ k 1))]
                          (if (not (d/pat? p))
                            (recur (+ k 2) c es)
                            (let [vt (cst/text src vn)
                                  plain (d/plain-text? vt true)
                                  g (if plain vt (string-concat "dd__" (string-concat (string-from-i64 base) (string-concat "_" (string-from-i64 (+ c 1))))))
                                  c1 (if plain c (+ c 1))
                                  x (d/expand src p g c1 base)]
                              (if (d/x-human? x)
                                (record-new [:ref :let/r] (d/x-human x) es)
                                (let [names0 (if plain (typed-list-new [:list :string]) (sconj (typed-list-new [:list :string]) g))
                                      exprs0 (if plain (typed-list-new [:list :string]) (sconj (typed-list-new [:list :string]) vt))
                                      xn (vector-count (d/x-names x))
                                      flat (loop [j 0 acc (loop [q 0 a (typed-list-new [:list :string])]
                                                            (if (>= q (vector-count names0)) a
                                                                (recur (+ q 1) (sconj a (string-concat (snth names0 q) (string-concat " " (snth exprs0 q)))))))]
                                             (if (>= j xn) acc
                                                 (recur (+ j 1) (sconj acc (string-concat (snth (d/x-names x) j) (string-concat " " (snth (d/x-exprs x) j)))))))
                                      col (d/u16-count (string-substring src (line-start starts (cst/node-s p)) (cst/node-s p)))
                                      one (join flat " ")
                                      txt (if (< (+ col (d/u16-count one)) 100) one (join flat (string-concat "\n" (d/spaces col))))]
                                  (recur (+ k 2) (d/x-ctr x)
                                         (edit/edits-conj es (edit/replace-range (cst/node-s p) (cst/node-e vn) txt "let"))))))))))
                  hr (record-get [:ref :let/r] r :human)]
              (recur (+ i 1)
                     (fd/fs-conj out
                                 (if (> (string-byte-length hr) 0)
                                   (fd/human "let" (cst/node-s n) (cst/node-e n) region line "" hr "" false)
                                   (fd/auto "let" (cst/node-s n) (cst/node-e n) region line "" "let" false (record-get [:ref :let/r] r :edits))))))))))))
   :default
   (do
(defn find-all [{:keys [src nodes]}]
  (let [out (atom []) starts (edit/line-starts src)]
    (cst/walk
     (fn [n {:keys [region]}]
       (when (and (cst/lst? n) (= "let" (cst/head-text n)) (cst/vec? (second (:kids n))))
         (let [bv (second (:kids n)) pairs (partition 2 (:kids bv))]
           (when (some (fn [[p _]] (d/pat? p)) pairs)
             (let [counter (atom 0)
                   gen (fn [] (str "dd__" (:s n) "_" (swap! counter inc)))
                   res (for [[p v] pairs :when (d/pat? p)]
                         (let [vt (cst/text src v)
                               plain? (re-matches #"[^\s()\[\]{}]+" vt)
                               g (if plain? vt (gen))
                               r (d/expand src p g gen false)]
                           (if (:human r) r
                               {:p p :v v :binds (into (if plain? [] [[g vt]]) (:binds r))})))
                   line (edit/offset->line starts (:s n))]
               (if-let [h (some :human res)]
                 (swap! out conj {:rule :let :s (:s n) :e (:e n) :region region :status :human :reason h :line line})
                 (swap! out conj
                        {:rule :let :s (:s n) :e (:e n) :region region :status :auto :line line :kind "let"
                         :edits (vec (for [{:keys [p v binds]} res
                                           :let [col (- (:s p) (nth starts (dec (edit/offset->line starts (:s p)))))
                                                 flat (map (fn [[nm e]] (str nm " " e)) binds)
                                                 one (str/join " " flat)
                                                 txt (if (< (+ col (count one)) 100) one
                                                         (str/join (str "\n" (apply str (repeat col " "))) flat))]]
                                       (edit/replace-node {:s (:s p) :e (:e v)} txt :let)))}))))))
       nil)
     nodes)
    @out))

(def rule {:id :let :find find-all})
))
