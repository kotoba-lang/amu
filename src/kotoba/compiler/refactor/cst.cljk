;; Lossless concrete syntax tree for .cljk/.cljc/.clj source (amu refactor).
;;
;; Why not the repo reader (kotoba.compiler.kotoba-reader / kr/read-forms)?  It reads the `.kotoba` grammar only
;; (no regex literals, `^:dynamic`, `'x`, `@x`, `#()`, character literals ...), so it cannot read frontend.cljk, and it
;; drops comments.  This parser keeps what a rewrite needs: EVERY node has absolute character offsets [:s :e) into the
;; source text (the same contract as the reader's :end-offset), comments and whitespace are never nodes, so a rewrite is a
;; list of text edits over those offsets and everything it does not touch stays byte-identical, comments included.
;;
;; Node = {:type T :s start :e end :kids [nodes] :text atom-text}.  Types:
;;   :list :vec :map :set :fnlit        collections (kids = forms, no trivia)
;;   :rc                                #?( ... ) / #?@( ... ); :splice? ; kids alternate feature-key, form
;;   :prefix                            ' ` ~ ~@ @ #' #:ns #tag  (:prefix "text"), kids = [form]
;;   :meta                              ^meta form, kids = [meta form]
;;   :sym :kw :num :str :char :regex    atoms (:text = exact source text)
;; `#_ form` is discarded (it stays inside the parent's text, untouched).
;;
;; The scanner is character based (no regex objects), so the same file runs on every host that loads .cljk.
(ns kotoba.compiler.refactor.cst
  (:refer-clojure :exclude [vec? map?]))

(defn- ch
  "The one-character string at i, or nil past the end."
  [^String src i]
  (when (< i (count src))
    #?(:cljs (.charAt src i) :default (str (.charAt src (int i))))))

(def ^:private ws-chars #{" " "\t" "\n" "\r" "\f" "\u000B" "," " " " " " " "﻿"})
(def ^:private delim-chars #{" " "\t" "\n" "\r" "\f" "\u000B" "," " " " " " " "﻿" "(" ")" "[" "]" "{" "}" "\"" ";"})
(def ^:private closers {"(" ")" "[" "]" "{" "}"})
(def ^:private hex-chars (set "0123456789abcdefABCDEF"))

(defn- skip-ws
  "Index of the first non-trivia character at or after i (whitespace, commas, `;` comments are trivia)."
  [src i]
  (loop [i i]
    (let [c (ch src i)]
      (cond
        (nil? c) i
        (contains? ws-chars c) (recur (inc i))
        (= c ";") (recur (loop [j i] (let [d (ch src j)] (if (or (nil? d) (= d "\n")) j (recur (inc j))))))
        :else i))))

(defn- atom-end
  "End of the atom starting at i (the first delimiter, or the end of the text)."
  [src i]
  (loop [j i]
    (let [c (ch src j)]
      (if (or (nil? c) (contains? delim-chars c)) j (recur (inc j))))))

(defn- string-end
  "End (exclusive) of the string literal whose opening quote is at i, or nil when it is not terminated."
  [src i]
  (loop [j (inc i)]
    (let [c (ch src j)]
      (cond
        (nil? c) nil
        (= c "\"") (inc j)
        (= c "\\") (if (ch src (inc j)) (recur (+ j 2)) nil)
        :else (recur (inc j))))))

(defn- alpha? [c] (and c (or (and (>= (compare c "a") 0) (<= (compare c "z") 0))
                             (and (>= (compare c "A") 0) (<= (compare c "Z") 0)))))
(defn- octal? [c] (and c (>= (compare c "0") 0) (<= (compare c "7") 0)))

(defn- char-end
  "End of the character literal whose backslash is at i: \\uXXXX, \\oNNN, a word (\\space), or one character."
  [src i]
  (let [c1 (ch src (inc i))]
    (cond
      (nil? c1) (inc i)
      (and (= c1 "u") (every? (fn [k] (contains? hex-chars (ch src (+ i 2 k)))) (range 4))) (+ i 6)
      (and (= c1 "o") (octal? (ch src (+ i 2)))) (loop [j (+ i 2) n 0] (if (and (< n 3) (octal? (ch src j))) (recur (inc j) (inc n)) j))
      (alpha? c1) (loop [j (+ i 2)] (if (alpha? (ch src j)) (recur (inc j)) j))
      :else (+ i 2))))

(defn- parse-error [msg data] (ex-info msg (assoc data :phase :refactor-parse)))

(declare read-form)

(defn- read-until-close [src i close]
  ;; i is just after the opener; returns [kids end]
  (loop [i i kids []]
    (let [i (skip-ws src i)
          c (ch src i)]
      (cond
        (nil? c) (throw (parse-error "unterminated collection" {:at i :close close}))
        (= c close) [kids (inc i)]
        (contains? #{")" "]" "}"} c) (throw (parse-error (str "mismatched " c) {:at i}))
        :else (let [[n e] (read-form src i)]
                (recur e (if n (conj kids n) kids)))))))

(defn- number-start? [t]
  (let [c (subs t 0 1)
        d (when (> (count t) 1) (subs t 1 2))
        digit? (fn [x] (and x (>= (compare x "0") 0) (<= (compare x "9") 0)))]
    (or (digit? c) (and (contains? #{"+" "-"} c) (digit? d)))))

(defn- atom-type [t]
  (cond (= ":" (subs t 0 1)) :kw
        (number-start? t) :num
        :else :sym))

(defn read-form
  "Read one form at i (after whitespace).  Returns [node end]; node is nil for a `#_` discard."
  [src i]
  (let [c (ch src i)]
    (cond
      (contains? #{"(" "[" "{"} c)
      (let [[kids e] (read-until-close src (inc i) (closers c))]
        [{:type (case c "(" :list "[" :vec "{" :map) :s i :e e :kids kids} e])

      (= c "\"") (let [e (string-end src i)]
                   (when-not e (throw (parse-error "bad string" {:at i})))
                   [{:type :str :s i :e e :text (subs src i e)} e])

      (= c "\\") (let [e (char-end src i)]
                   [{:type :char :s i :e e :text (subs src i e)} e])

      (= c "^") (let [i1 (skip-ws src (inc i))
                      [m e1] (read-form src i1)
                      i2 (skip-ws src e1)
                      [f e2] (read-form src i2)]
                  [{:type :meta :s i :e e2 :kids [m f]} e2])

      (contains? #{"'" "`" "@"} c)
      (let [[f e] (read-form src (skip-ws src (inc i)))]
        [{:type :prefix :prefix c :s i :e e :kids [f]} e])

      (= c "~") (let [p (if (= "@" (ch src (inc i))) "~@" "~")
                      [f e] (read-form src (skip-ws src (+ i (count p))))]
                  [{:type :prefix :prefix p :s i :e e :kids [f]} e])

      (= c "#")
      (let [c2 (ch src (inc i))]
        (cond
          (= c2 "(") (let [[kids e] (read-until-close src (+ i 2) ")")]
                       [{:type :fnlit :s i :e e :kids kids} e])
          (= c2 "{") (let [[kids e] (read-until-close src (+ i 2) "}")]
                       [{:type :set :s i :e e :kids kids} e])
          (= c2 "\"") (let [e (string-end src (inc i))]
                        (when-not e (throw (parse-error "bad regex" {:at i})))
                        [{:type :regex :s i :e e :text (subs src i e)} e])
          (= c2 "_") (let [[_ e] (read-form src (skip-ws src (+ i 2)))] [nil e])
          (= c2 "?") (let [splice? (= "@" (ch src (+ i 2)))
                           o (+ i 2 (if splice? 1 0))
                           _ (when-not (= "(" (ch src o)) (throw (parse-error "bad reader conditional" {:at i})))
                           [kids e] (read-until-close src (inc o) ")")]
                       [{:type :rc :splice? splice? :s i :e e :kids kids} e])
          (= c2 "#") (let [e (atom-end src (+ i 2))]
                       [{:type :sym :s i :e e :text (subs src i e)} e])
          (= c2 "'") (let [[f e] (read-form src (skip-ws src (+ i 2)))]
                       [{:type :prefix :prefix "#'" :s i :e e :kids [f]} e])
          :else ;; #tag form  /  #:ns{...}
          (let [pe (atom-end src (inc i))
                p (subs src i pe)
                [f e] (read-form src (skip-ws src pe))]
            [{:type :prefix :prefix p :s i :e e :kids [f]} e])))

      :else (let [e (atom-end src i)]
              (when (= e i) (throw (parse-error "unreadable" {:at i :char c})))
              (let [t (subs src i e)]
                [{:type (atom-type t) :s i :e e :text t} e])))))

(defn parse
  "All top-level forms of src (discards dropped)."
  [src]
  (loop [i 0 out []]
    (let [i (skip-ws src i)]
      (if (>= i (count src))
        out
        (let [[n e] (read-form src i)]
          (recur e (if n (conj out n) out)))))))

;; ---- node helpers ------------------------------------------------------------------------------------------------

(defn text [src n] (subs src (:s n) (:e n)))
(defn sym? ([n] (= :sym (:type n))) ([n s] (and (= :sym (:type n)) (= s (:text n)))))
(defn kw? ([n] (= :kw (:type n))) ([n s] (and (= :kw (:type n)) (= s (:text n)))))
(defn lst? [n] (= :list (:type n)))
(defn vec? [n] (= :vec (:type n)))
(defn map? [n] (= :map (:type n)))
(defn head [n] (when (lst? n) (first (:kids n))))
(defn head-text [n] (let [h (head n)] (when (and h (sym? h)) (:text h))))
(defn call-node?
  "A list or a #( ) literal: something whose first kid is the callee."
  [n] (contains? #{:list :fnlit} (:type n)))
(defn call-head-text [n]
  (when (call-node? n) (let [h (first (:kids n))] (when (and h (sym? h)) (:text h)))))
(defn call? [n s] (and (lst? n) (= s (head-text n))))
(defn args [n] (vec (rest (:kids n))))
(defn strip-meta
  "The form under ^meta wrappers."
  [n] (if (= :meta (:type n)) (recur (second (:kids n))) n))

(defn rc-branches
  "[[feature-key-text form-node] ...] of a #?( ) node."
  [n]
  (mapv (fn [[k f]] [(:text k) f]) (partition 2 (:kids n))))

(defn region-of-feature [k] (if (= k ":kotoba") :kotoba :default))

(defn walk
  "Pre-order walk.  (f node ctx) is called for every node; ctx = {:region R :path [ancestors...] :index i-in-parent}.
  Returning :skip prevents descending."
  [f nodes]
  (letfn [(go [n region path idx]
            (let [r (f n {:region region :path path :index idx})]
              (when-not (= r :skip)
                (let [path-next (conj path n)]
                  (if (= :rc (:type n))
                    (doseq [[i [k form]] (map-indexed vector (partition 2 (:kids n)))]
                      (go form (region-of-feature (:text k)) (conj path-next k) (inc (* 2 i))))
                    (doseq [[i k] (map-indexed vector (:kids n))]
                      (go k region path-next i)))))))]
    (doseq [[i n] (map-indexed vector nodes)] (go n :shared [] i))))

(defn ->fn-view
  "A (defn name doc? params body) node seen as (fn params body): drops the name and docstring/attr-map so the
  fn-shaped helpers apply to it."
  [n]
  (let [kids (:kids n)
        rest-kids (drop 2 kids)
        rest-kids (drop-while (fn [k] (or (= :str (:type k)) (= :map (:type k)))) rest-kids)]
    {:type :list :kids (vec (cons (first kids) rest-kids)) :s (:s n) :e (:e n)}))
