;; The rule library of `amu refactor`: id -> rule, with the documentation `refactor list-rules` prints.
;;
;; A rule is a map {:id :find (fn [{:src :nodes :opts}] findings)}; a finding is {:status :auto|:human :reason :edits ...}.
;; See kotoba.compiler.refactor.core for the driver and each rules/*.cljk for the rewrite.  Rules a-f are the shapes the
;; Kotoba-route port (`amu check`) of the selfhost frontend needs; none of them changes host behaviour: a rewrite either
;; produces host-equivalent code or keeps the host text byte-for-byte as the `:default` arm of `#?(:kotoba NEW :default OLD)`.
(ns kotoba.compiler.refactor.rules
  {:kotoba/export #?(:kotoba [library standard-order lookup resolve-rules entry-id entry-name entry-summary
                             entry-host-effect entry-needs-target? entry-unknown entry-unknown? entries-count
                             entries-nth]
                     :default [library standard-order lookup resolve-rules])}
  (:require #?@(:kotoba []
                :default [[kotoba.compiler.refactor.rules.destructure :as a]
                          [kotoba.compiler.refactor.rules.reject :as b]
                          [kotoba.compiler.refactor.rules.dynvars :as c]
                          [kotoba.compiler.refactor.rules.kwcallback :as d]
                          [kotoba.compiler.refactor.rules.letdestructure :as e]
                          [kotoba.compiler.refactor.rules.lowerloops :as f]
                          [kotoba.compiler.refactor.rules.fnlit :as g]]))
  #?(:kotoba (:schemas {:rules/entry [:record :rules/entry
                                      [[:id :string] [:name :string] [:summary :string] [:host-effect :string]
                                       [:needs-target :bool] [:unknown :string]]]})))

;; ---------------------------------------------------------------------------
;; Kotoba reading: the forms of the guest twin kotoba-lang lang/compat/kotoba/compiler/refactor/rules.kotoba
;; (claude/refactor-twins-parity 1c7260f), moved verbatim, each in a #?(:kotoba ...) form; the last one carries the
;; host reading (the whole host program, unchanged) as its :default arm.  The twin's header follows.
;; kotoba.compiler.refactor.rules -- the GUEST-ROUTE twin of amu's `src/kotoba/compiler/refactor/rules.cljk`, the rule
;; library of `amu refactor` (id -> rule, with the documentation `refactor list-rules` prints).
;;
;; WHY A TWIN. The host library is a vector of maps holding the rule functions (`:rule a/rule`), looked up with
;; `filter` over a predicate closure, and `resolve-rules` answers a map `{:unknown id}` in place of an entry. The guest
;; route gets typed records; the rule FUNCTION is not a field: kotoba.compiler.refactor.core (twin) dispatches on the
;; entry's id. Host behaviour is untouched.
;;
;; THE CONTRACT
;;   :rules/entry = [id :string] [name :string] [summary :string] [host-effect :string] [needs-target :bool]
;;                  [unknown :string]  -- "" for a library entry; the unknown spelling for resolve-rules' {:unknown id}
;;   (library)            -> [:list :rules/entry]   the host's `library`, in order
;;   (standard-order)     -> [:list :string]        ["a" "b" "d" "e" "f"]
;;   (lookup s)           -> :rules/entry           by id or name; the entry with unknown = s when none (host nil)
;;   (resolve-rules spec) -> [:list :rules/entry]   "all" = standard-order, else the comma-split non-empty ids in order
;;   accessors entry-id entry-name entry-summary entry-host-effect entry-needs-target? entry-unknown entries-count
;;   entries-nth.


#?(:kotoba
(defn- mk [id :string name :string summary :string effect :string nt :bool] [:ref :rules/entry]
  (record-new [:ref :rules/entry] id name summary effect nt "")))

#?(:kotoba
(defn entry-id [r [:ref :rules/entry]] :string (record-get [:ref :rules/entry] r :id)))
#?(:kotoba
(defn entry-name [r [:ref :rules/entry]] :string (record-get [:ref :rules/entry] r :name)))
#?(:kotoba
(defn entry-summary [r [:ref :rules/entry]] :string (record-get [:ref :rules/entry] r :summary)))
#?(:kotoba
(defn entry-host-effect [r [:ref :rules/entry]] :string (record-get [:ref :rules/entry] r :host-effect)))
#?(:kotoba
(defn entry-needs-target? [r [:ref :rules/entry]] :bool (record-get [:ref :rules/entry] r :needs-target)))
#?(:kotoba
(defn entry-unknown [r [:ref :rules/entry]] :string (record-get [:ref :rules/entry] r :unknown)))
#?(:kotoba
(defn entry-unknown? [r [:ref :rules/entry]] :bool (> (string-byte-length (entry-unknown r)) 0)))
#?(:kotoba
(defn entries-count [xs [:list [:ref :rules/entry]]] :i64 (vector-count xs)))
#?(:kotoba
(defn entries-nth [xs [:list [:ref :rules/entry]] i :i64] [:ref :rules/entry]
  (typed-list-nth [:list [:ref :rules/entry]] xs i)))

#?(:kotoba
(defn- add [xs [:list [:ref :rules/entry]] r [:ref :rules/entry]] [:list [:ref :rules/entry]]
  (typed-list-conj [:list [:ref :rules/entry]] xs r)))

;; Ordered; the id is what the command line takes. The texts are the host's, byte for byte.
#?(:kotoba
(defn library [] [:list [:ref :rules/entry]]
  (add (add (add (add (add (add (add (typed-list-new [:list [:ref :rules/entry]])
    (mk "a" "destructure"
        "destructuring lambda parameters (fn [[k v]] ..) / {:keys ..} -> plain parameter + (let [k (fe-nth p 0) ..] ..)"
        "none: fe-nth is (nth c i nil), fe-get is get, fe-nthnext is nthnext -- what Clojure's destructuring expands to"
        false))
    (mk "b" "reject"
        "reject! -> the :fe/err typed abort (statement -> require-k, tail / let value -> throw fe-error)"
        "none: the original call stays as the :default arm"
        false))
    (mk "c" "dynvars"
        "dynamic vars -> explicit env threading (--target dual: #?(:kotoba <threaded defn> :default <original>); --target host-env: in place, host-valid)"
        "none for dual; host-env is the differential experiment"
        true))
    (mk "d" "kwcallback"
        "keyword callbacks (map :k xs) -> (map (fn [e] (:k e)) xs); (juxt :a :b)"
        "none"
        false))
    (mk "e" "let"
        "destructuring in let binding vectors, flattened in place"
        "none"
        false))
    (mk "f" "lowerloops"
        "mapv/map/filter/filterv/reduce with a one-lambda callback -> a loop over kotoba.form as the :kotoba arm"
        "none: the :default arm is the original call"
        false))
    (mk "g" "fnlit"
        "anonymous-function literals #(f % y) -> (fn [x] (f x y)), the form the reader expands them to (seed/Kotoba reader E1005)"
        "none: the Clojure reader reads #(BODY) as (fn* [p1 .. & rest] (BODY))"
        false))))

#?(:kotoba
(defn standard-order [] [:list :string]
  (typed-list-conj [:list :string]
    (typed-list-conj [:list :string]
      (typed-list-conj [:list :string]
        (typed-list-conj [:list :string]
          (typed-list-conj [:list :string] (typed-list-new [:list :string]) "a") "b") "d") "e") "f")))

#?(:kotoba
(defn lookup [s :string] [:ref :rules/entry]
  (let [lib (library)
        n (vector-count lib)]
    (loop [i 0]
      (cond (>= i n) (record-new [:ref :rules/entry] "" "" "" "" false s)
            (or (string=? s (entry-id (entries-nth lib i))) (string=? s (entry-name (entries-nth lib i)))) (entries-nth lib i)
            :else (recur (+ i 1)))))))

;; clojure.string/split on "," then remove empty: the non-empty pieces in order
#?(:kotoba
(defn- comma-pieces [spec :string] [:list :string]
  (let [n (string-byte-length spec)]
    (loop [i 0 from 0 acc (typed-list-new [:list :string])]
      (cond (>= i n)
            (if (> n from) (typed-list-conj [:list :string] acc (string-substring spec from n)) acc)
            (= (string-code-point-at spec i) 44)
            (recur (+ i 1) (+ i 1) (if (> i from) (typed-list-conj [:list :string] acc (string-substring spec from i)) acc))
            :else (let [p (string-code-point-at spec i)]
                    (recur (+ i (if (< p 128) 1 (if (< p 2048) 2 (if (< p 65536) 3 4)))) from acc)))))))

#?(:kotoba
(defn resolve-rules [spec :string] [:list [:ref :rules/entry]]
  (let [ids (if (string=? spec "all") (standard-order) (comma-pieces spec))
        n (vector-count ids)]
    (loop [i 0 acc (typed-list-new [:list [:ref :rules/entry]])]
      (if (>= i n) acc (recur (+ i 1) (add acc (lookup (typed-list-nth [:list :string] ids i))))))))
   :default
   (do
(def library
  "Ordered; the id is what the command line takes."
  [{:id "a" :name "destructure" :rule a/rule
    :summary "destructuring lambda parameters (fn [[k v]] ..) / {:keys ..} -> plain parameter + (let [k (fe-nth p 0) ..] ..)"
    :host-effect "none: fe-nth is (nth c i nil), fe-get is get, fe-nthnext is nthnext -- what Clojure's destructuring expands to"}
   {:id "b" :name "reject" :rule b/rule
    :summary "reject! -> the :fe/err typed abort (statement -> require-k, tail / let value -> throw fe-error)"
    :host-effect "none: the original call stays as the :default arm"}
   {:id "c" :name "dynvars" :rule c/rule :needs-target true
    :summary "dynamic vars -> explicit env threading (--target dual: #?(:kotoba <threaded defn> :default <original>); --target host-env: in place, host-valid)"
    :host-effect "none for dual; host-env is the differential experiment"}
   {:id "d" :name "kwcallback" :rule d/rule
    :summary "keyword callbacks (map :k xs) -> (map (fn [e] (:k e)) xs); (juxt :a :b)"
    :host-effect "none"}
   {:id "e" :name "let" :rule e/rule
    :summary "destructuring in let binding vectors, flattened in place"
    :host-effect "none"}
   {:id "f" :name "lowerloops" :rule f/rule
    :summary "mapv/map/filter/filterv/reduce with a one-lambda callback -> a loop over kotoba.form as the :kotoba arm"
    :host-effect "none: the :default arm is the original call"}
   {:id "g" :name "fnlit" :rule g/rule
    :summary "anonymous-function literals #(f % y) -> (fn [x] (f x y)), the form the reader expands them to (seed/Kotoba reader E1005)"
    :host-effect "none: the Clojure reader reads #(BODY) as (fn* [p1 .. & rest] (BODY))"}])

(def standard-order
  "A full run: these on the source (in this order), then `c` on that output (it replaces whole defns and runs once)."
  ["a" "b" "d" "e" "f"])

(defn lookup
  "Rule by id or name; nil when unknown."
  [s]
  (first (filter #(or (= s (:id %)) (= s (:name %))) library)))

(defn resolve-rules
  "\"a,b,d\" / \"all\" -> [library entries]; nil entries are reported by the caller."
  [spec]
  (let [ids (if (= spec "all") standard-order (vec (remove empty? (clojure.string/split spec #","))))]
    (mapv (fn [id] (or (lookup id) {:unknown id})) ids)))
))
