(ns kotoba.compiler.test-cli
  "`amu test <file.kotoba>` -- run a source's exported `test-*` definitions
  on every semantic target and report. One implementation on both hosts
  (ADR 0348 iteration 7): `kotoba.compiler.cli` delegates here on the JVM,
  `kotoba.compiler.nbb.test-cli` is the Node entrypoint.

  `run` returns the report and the lines to print; the entrypoint prints and
  exits. A report whose `:ok` is false is a non-zero exit (1) on both hosts
  -- a failing test must not look like a passing run to a caller that only
  reads the status."
  {:kotoba/export [run]}
  (:require [kotoba.compiler.bounded-edn :as bounded-edn]
            [kotoba.compiler.project :as project]
            [kotoba.compiler.project-files :as project-files]
            [kotoba.compiler.source-path :as source-path]
            [kotoba.compiler.test-profile :as test-profile]))

(defn- source-paths
  "Every `--source-path <dir>` in ARGS, in order."
  [args]
  (loop [args args acc []]
    (cond (empty? args) acc
          (= "--source-path" (first args)) (recur (nnext args) (conj acc (second args)))
          :else (recur (next args) acc))))

(defn- flat-results [report]
  (mapcat (fn [[target rows]] (map #(assoc % :target target) rows))
          (or (:results report) {})))

(defn human-lines
  "The `kotoba test:` summary line and one ` FAIL` line per failing case
  (the latter go to stderr on both routes)."
  [report]
  (let [flat (flat-results report)
        passed (count (filter :ok flat))]
    {:out [(str "kotoba test: " passed "/" (count flat)
                (if (:ok report) " passed" " FAILED")
                " tests=" (pr-str (or (:tests report) []))
                " targets=" (pr-str (or (:targets report) [])))]
     :err (vec (for [r flat :when (not (:ok r))]
                 (str " FAIL " (:test r) " target=" (:target r) " " (or (:error r) ""))))}))

(defn run
  "ARGS as `bin/amu` hands them: `test <file> [--json] [--fuel <n>]
  [--source-path <dir> ...]`.
  Returns `{:report r :json? bool}`; the report's `:ok` decides the exit
  status. `--fuel` is the per-test budget (each test runs on a fresh
  instance); a value that is not a positive decimal integer is refused by
  name, as `amu compile --fuel` refuses it.

  `--source-path` (2026-09-16): the tests of a module that `(:require ...)`s
  others -- a template module's tests in particular, which can only exist
  in an importer that binds its `:params` -- are the exported `test-*` of
  the LINKED unit, the same closed graph `compile --source-path` links
  through `project/link-source`. Without this flag such a file was refused
  as a malformed `:export` / unresolved namespace, so a project's tests
  could be compiled but never run."
  [args]
  (let [input (source-path/admit! (second args))
        roots (source-paths args)
        linked (when (seq roots)
                 (let [graph (project-files/load-closed-graph input roots)]
                   (project/link-source (:sources graph) (:root graph))))
        json? (boolean (some #{"--json"} args))
        fuel (when (some #{"--fuel"} args)
               (let [text (second (drop-while #(not= "--fuel" %) args))]
                 (when-not (and text (re-matches #"[1-9][0-9]*" text))
                   (throw (ex-info "--fuel must be a positive decimal integer"
                                   {:phase :usage :fuel text})))
                 #?(:clj (Long/parseLong text) :cljs (js/parseInt text 10))))
        report (test-profile/run-source (if linked (:source linked) (bounded-edn/read-text-file input))
                                        (cond-> {}
                                          fuel (assoc :fuel fuel)
                                          linked (assoc :admit-linked-synthetics? true)))]
    {:report report :json? json?}))
