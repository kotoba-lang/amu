(ns kotoba.compiler.kexe-indexes
  "The host indexes inside a sealed `.kexe`, narrowed after a read.

  KIR function metadata `:closure-param-indexes` and
  `:i64-pair-chain-param-indexes` are HOST indexes into `:params`, not guest
  i64 values: `kotoba.kir/validated-closure-param-indexes` and its
  `i64-pair-chain` sibling check them with `integer?` and use them with
  `nth`. `kir/lower` writes them as host numbers; the bounded artifact
  readers hand back a BigInt for every integer token on nbb, which is right
  for a value and wrong for an index -- `(integer? BigInt)` is false there.

  So an artifact with ANY closure verified at compile time (the in-memory map
  holds Numbers) and was refused by the verifier's oracle re-execution after
  a read-back, as `native artifact oracle evaluation rejected` (cause:
  `closure parameter indexes are malformed`). `extract-native` met it first
  (2026-09-15) and narrowed in `cli-support/read-artifact-file!`; `amu sign`,
  `verify` and `verify-signed` read through `bounded-edn` and kept refusing
  every closure program compile had reported `:oracle {:status :verified}`
  for (2026-10-09, nine kotoba-lang conformance cases). One function, used by
  every reader that hands an artifact to the verifier.

  The seal and a signature statement are over canonical bytes in which a
  BigInt and a Number of the same value print identically, so narrowing
  changes neither."
  {:kotoba/export [narrow-artifact narrow-envelope structural-index-keys]}
  (:require [kotoba.compiler.host-integer :as host-integer]))

;; R6QW3: the Kotoba reading (W3: the scan refused this module E2101 at get-in). The
;; exported constant is a 0-argument function (the export surface names functions only);
;; the artifact/envelope are :document maps and the narrowing is a document walk
;; (the walk contract). host-integer/narrow's result is wrapped as a document.
#?(:kotoba
   (defn- dgk [d :document k :keyword] :document
     (option-value-of [:option :document] (document-get d k) (document-null))))
#?(:kotoba
   (defn- map-doc? [d :document] :bool (= (document-kind d) :map)))
;; the narrow of one index list (the host's (mapv host-integer/narrow %))
#?(:kotoba
   (defn- narrow-list [l :document i :i64 n :i64 out :document] :document
     (if (>= i n)
       out
       (narrow-list l (+ i 1) n
                    (document-vector-conj out (host-narrow (option-value-of [:option :document] (document-list-at l i) (document-null))))))))
;; the per-function narrowing over the two structural keys (the host's reduce over keys)
#?(:kotoba
   (defn- narrow-fn [function :document ki :i64] :document
     (if (>= ki 2)
       function
       (let [k (option-value-of [:option :document] (document-list-at (structural-index-keys) ki) (document-null))
             v (dgk function (option-value-of [:option :keyword] (document-keyword-value k) :none))]
         (narrow-fn (if (and (map-doc? function) (seq-doc? v))
                      (document-assoc function k (narrow-list v 0 (document-count v) (document-vector)))
                      function)
                    (+ ki 1))))))
;; the sequential?/vector? shape checks (the host's get-in [:program :functions])
#?(:kotoba
   (defn- seq-doc? [d :document] :bool
     (or (= (document-kind d) :list) (= (document-kind d) :vector))))
;; the functions list walk (the host's mapv over functions)
#?(:kotoba
   (defn- narrow-functions [fns :document i :i64 n :i64 out :document] :document
     (if (>= i n)
       out
       (narrow-functions fns (+ i 1) n
                         (document-vector-conj out (narrow-fn (option-value-of [:option :document] (document-list-at fns i) (document-null)) 0))))))
;; the host-integer narrowing call (kotoba.compiler.host-integer's narrow)
#?(:kotoba
   (defn- host-narrow [x :document] :document (document-i64 (host-integer/narrow (option-value-of [:option :i64] (document-i64-value x) 0)))))

#?(:kotoba
   (defn structural-index-keys [] :document
     (document-vector (document-keyword :closure-param-indexes)
                      (document-keyword :i64-pair-chain-param-indexes)))
   :default
(def structural-index-keys
  [:closure-param-indexes :i64-pair-chain-param-indexes]))
#?(:kotoba
   (defn narrow-artifact [artifact :document] :document
     (if (and (map-doc? artifact) (seq-doc? (dgk (dgk artifact :program) :functions)))
       (document-assoc artifact (document-keyword :program)
                       (document-assoc (dgk artifact :program) (document-keyword :functions)
                                       (narrow-functions (dgk (dgk artifact :program) :functions) 0
                                                         (document-count (dgk (dgk artifact :program) :functions))
                                                         (document-vector))))
       artifact))
   :default
(defn narrow-artifact
  "ARTIFACT with every function's structural indexes as host numbers; any
  value that is not an artifact-shaped map is returned as is, for the
  verifier to refuse by name."
  [artifact]
  (if (and (map? artifact) (vector? (get-in artifact [:program :functions])))
    (update-in artifact [:program :functions]
               (fn [functions]
                 (mapv (fn [function]
                         (reduce (fn [function key]
                                   (if (and (map? function) (sequential? (get function key)))
                                     (update function key #(mapv host-integer/narrow %))
                                     function))
                                 function structural-index-keys))
                       functions)))
    artifact)))
#?(:kotoba
   (defn narrow-envelope [envelope :document] :document
     (if (and (map-doc? envelope) (document-contains envelope (document-keyword :artifact)))
       (document-assoc envelope (document-keyword :artifact) (narrow-artifact (dgk envelope :artifact)))
       envelope))
   :default
(defn narrow-envelope
  "A signed envelope (`:kotoba.signed-kexe/v1`) with its `:artifact`
  narrowed; the envelope's key set is unchanged."
  [envelope]
  (if (and (map? envelope) (contains? envelope :artifact))
    (update envelope :artifact narrow-artifact)
    envelope)))
