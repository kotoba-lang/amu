(ns kotoba.compiler.refactor-cli
  "`amu refactor` -- AST-based refactoring, the default way to change the compiler's own sources.

    amu refactor list-rules
    amu refactor plan <rules> <path>...  [--no-diff] [--patch-out FILE] [rule options]
    amu refactor apply <rules> <path>... [--check] [--out FILE] [rule options]
    amu refactor graph <path> [--summary] [--out FILE]
    amu refactor partition <path> [--modules N] [--driver FORM] [--names FILE] [--out FILE]
    amu refactor split <path> --partition FILE --out DIR [--ns NAME]
    amu refactor verify --runner FILE --classpath CP [--classpath-file FILE]
                        [--base-first DIR] [--candidate-first DIR] [--nbb PATH] [--stack-size N]
    amu refactor to-kotoba <path>... [--out FILE] [--check] [--data-name NAME] [--ns NAME]

  <rules> is `a,b,d,e,f`, a rule name, or `all` (= a,b,d,e,f). A <path> is a source file or a directory searched for
  .cljk / .cljc / .clj / .cljs files; `to-kotoba` also takes `.edn` data files (exactly one top-level value). Rule
  options: --target dual|host-env (rule c), --include-ported, --lower-accessor,
  --regions shared,default,kotoba, --observable-from DIR[,DIR], --max-passes N.

  Every answer is one EDN map with `:format :kotoba.refactor/v1`, printed to stdout. `plan` and `--check` never write.
  `apply` writes through a temporary file and a rename, only after the rewritten text has been re-parsed. A refusal is
  the usual `:kotoba.cli-error/v1` report on stderr whose `:diagnostic :code` is one of:

    :refactor/usage                  bad flags or arguments               (exit 64)
    :refactor/unknown-rule           a rule id/name the library lacks     (64)
    :refactor/target-required        rule c without --target              (64)
    :refactor/unreadable             a file could not be read             (65)
    :refactor/parse-error            a source is not readable Clojure     (65)
    :refactor/no-paths               the paths hold no source file        (65)
    :refactor/output-unparsable      a rewrite produced unreadable text   (65)  nothing was written
    :refactor/no-driver              partition found no pass driver       (65)
    :refactor/partition-incomplete   the partition omits defining forms   (65)
    :refactor/roundtrip-failed       a split lost or duplicated a form    (65)  nothing was written
    :refactor/write-failed           a file could not be written          (74)

  Exit 1 (not a refusal) means the answer is `:ok false`: `apply --check` or `to-kotoba --check` found pending
  changes, or `verify` found differing per-test outcomes. `to-kotoba` is the mechanical .cljk/.edn -> .kotoba
  conversion: reader conditionals resolve to their :kotoba arm (else :default, else nothing) and every other byte is
  copied verbatim; an .edn file becomes a data module (`--data-name`, default `data`).

  One implementation, no JVM and no Python: the command is a function from arguments and an I/O record to a value
  (`run`), the Node entrypoint is `kotoba.compiler.nbb.refactor-cli`. The host route's alone, as `amu test` is."
  {:kotoba/export [run]}
  (:require #?@(:kotoba [[kotoba.compiler.refactor.rules :as rules]]
                :default [[clojure.string :as str]
                          [clojure.walk :as walk]
                          [kotoba.compiler.host-integer :as host-integer]
                          [kotoba.compiler.refactor.core :as core]
                          [kotoba.compiler.refactor.cst :as cst]
                          [kotoba.compiler.refactor.diff :as diff]
                          [kotoba.compiler.refactor.extract :as extract]
                          [kotoba.compiler.refactor.graph :as graph]
                          [kotoba.compiler.refactor.partition :as partition]
                          [kotoba.compiler.refactor.rules :as rules]
                          [kotoba.compiler.refactor.verify :as verify]])))

;; ---- the :kotoba reading of `run` (selfhost S6.1) -------------------------------------------------------------------
;;
;; The guest route answers; it never throws (an unhandled abort at the export boundary is refused
;; "unhandled abort at export boundary; catch it with try: run", measured), so every refusal is a
;; :kotoba.cli-error/v1 report string like the host entry prints. `list-rules` is real over the rules
;; twin; the I/O subcommands name their own absence instead of pretending (S6.1: the I/O record is the
;; remaining host surface).

#?(:kotoba
   (defn- g-edn-str [s :string] :string
     ;; S as an EDN string literal: a byte walk (string-substring counts UTF-8 bytes; a mid-character
     ;; continuation byte is never 34 or 92, so slicing here is byte-preserving), escaping " and \.
     (let [n (string-byte-length s)]
       (loop [i 0 acc "\""]
         (if (>= i n)
           (string-concat acc "\"")
           (let [c (string-code-point-at s i)]
             (recur (+ i 1)
                    (cond
                      (= c 34) (string-concat acc "\\\"")
                      (= c 92) (string-concat acc "\\\\")
                      :else (string-concat acc (string-substring s i (+ i 1)))))))))))

#?(:kotoba
   (defn- g-kw [s :string] :string (string-concat ":" s)))

#?(:kotoba
   (defn- g-rule [i :i64] :string
     (let [r (rules/entries-nth (rules/library) i)
           s1 (string-concat "{:id " (g-kw (rules/entry-id r)))
           s2 (string-concat s1 (string-concat " :name " (g-kw (rules/entry-name r))))
           s3 (string-concat s2 (string-concat " :summary " (g-edn-str (rules/entry-summary r))))
           base (string-concat s3 (string-concat " :host-effect " (g-edn-str (rules/entry-host-effect r))))]
       (string-concat base (if (rules/entry-needs-target? r) " :needs-target true}" "}")))))

#?(:kotoba
   (defn- g-joined [xs [:list :string] sep :string] :string
     (let [n (vector-count xs)]
       (loop [i 0 acc ""]
         (if (>= i n)
           acc
           (recur (+ i 1)
                  (if (= i 0)
                    (typed-list-nth [:list :string] xs i)
                    (string-concat acc (string-concat sep (typed-list-nth [:list :string] xs i))))))))))

#?(:kotoba
   (defn- g-list-rules [] :string
     (let [lib (rules/library)
           n (rules/entries-count lib)]
       (loop [i 0 acc "["]
         (if (>= i n)
           (string-concat acc "]")
           (recur (+ i 1)
                  (string-concat acc (if (= i 0) (g-rule i) (string-concat " " (g-rule i))))))))))

#?(:kotoba
   (defn- g-standard-order [] :string
     (string-concat "[" (string-concat (g-joined (rules/standard-order) ":") "]")))) ;; placeholder, fixed below
#?(:kotoba
   (defn- g-kw-list [xs [:list :string]] :string
     (let [n (vector-count xs)]
       (loop [i 0 acc "["]
         (if (>= i n)
           (string-concat acc "]")
           (recur (+ i 1)
                  (string-concat acc (if (= i 0)
                                       (g-kw (typed-list-nth [:list :string] xs i))
                                       (string-concat " " (g-kw (typed-list-nth [:list :string] xs i)))))))))))

#?(:kotoba
   (defn- g-list-rules-answer [] :string
     (string-concat "{:format :kotoba.refactor/v1 :command :list-rules :ok true :standard-order "
              (string-concat (g-kw-list (rules/standard-order))
              (string-concat " :rules "
              (string-concat (g-list-rules)
              " :commands [:list-rules :plan :apply :graph :partition :split :verify :to-kotoba]}"))))))

#?(:kotoba
   (defn- g-refusal [code :string message :string] :string
     (string-concat "{:format :kotoba.cli-error/v1 :ok false :error :usage :diagnostic {:format :kotoba.diagnostic/v1 :code "
              (string-concat (g-kw code)
              (string-concat " :severity :error :message " (string-concat (g-edn-str message) "}}"))))))

#?(:kotoba
   (defn- g-on-route [sub :string] :bool
     (or (string=? sub "plan") (string=? sub "apply") (string=? sub "graph") (string=? sub "partition")
         (string=? sub "split") (string=? sub "verify") (string=? sub "to-kotoba"))))

#?(:kotoba
   (defn run [args [:list :string]] :string
     (let [sub (if (> (vector-count args) 0) (typed-list-nth [:list :string] args 0) "")]
       (cond
         (string=? sub "list-rules") (g-list-rules-answer)
         (= (string-byte-length sub) 0)
         (g-refusal "refactor/usage" "usage: amu refactor <list-rules|plan|apply|graph|partition|split|verify|to-kotoba> ...")
         (g-on-route sub)
         (g-refusal "refactor/not-on-kotoba-route"
                    (string-concat "refactor " (string-concat sub " is not on the Kotoba route yet (selfhost S6.1); use the nbb bootstrap route")))
         :else
         (g-refusal "refactor/usage" (string-concat "unknown refactor command " (string-concat sub "; one of list-rules plan apply graph partition split verify to-kotoba"))))))
   :default
   nil)

#?(:kotoba nil
   :default
   (do

(def format-tag :kotoba.refactor/v1)

(defn- refuse
  ([phase code message] (refuse phase code message {}))
  ([phase code message data]
   (ex-info message (merge data {:phase phase :kotoba.error/code code}))))

(defn- usage! [message] (throw (refuse :usage :refactor/usage message)))

;; ---- arguments ------------------------------------------------------------------------------------------------------

(def ^:private value-flags
  #{"--out" "--partition" "--ns" "--data-name" "--modules" "--driver" "--names" "--target" "--regions" "--observable-from"
    "--max-passes" "--runner" "--classpath" "--classpath-file" "--base-first" "--candidate-first" "--nbb"
    "--stack-size" "--patch-out"})

(def ^:private switch-flags
  #{"--check" "--include-ported" "--lower-accessor" "--no-diff" "--summary"})

(defn- parse-args
  "-> {:positional [..] :flags {\"--x\" v|true}}"
  [args]
  (loop [as args positional [] flags {}]
    (if-let [a (first as)]
      (cond
        (contains? value-flags a)
        (if (next as)
          (recur (nnext as) positional (assoc flags a (second as)))
          (usage! (str a " needs a value")))
        (contains? switch-flags a) (recur (rest as) positional (assoc flags a true))
        (str/starts-with? a "--") (usage! (str "unknown flag " a))
        :else (recur (rest as) (conj positional a) flags))
      {:positional positional :flags flags})))

(defn- int-flag [flags k default]
  (if-let [v (get flags k)]
    (or (host-integer/decimal-count v) (usage! (str k " must be a decimal integer")))
    default))

;; ---- files ----------------------------------------------------------------------------------------------------------

(def ^:private source-extensions [".cljk" ".cljc" ".clj" ".cljs"])

(def ^:private edn-extensions [".edn"])

(defn- name-with? [name exts] (some #(str/ends-with? name %) exts))

(defn- files-under [io dir exts]
  (mapcat (fn [{:keys [name dir?]}]
            (let [p (str dir "/" name)]
              (cond (str/starts-with? name ".") nil
                    (= name "node_modules") nil
                    dir? (files-under io p exts)
                    (name-with? name exts) [p])))
          ((:list io) dir)))

(defn- expand-paths [io paths exts]
  (let [files (vec (distinct (mapcat (fn [p]
                                       (case ((:kind io) p)
                                         :dir (files-under io (str/replace p #"/+$" "") exts)
                                         :file [p]
                                         (throw (refuse :decode :refactor/unreadable (str "no such file or directory: " p) {:path p}))))
                                     paths)))]
    (when (empty? files)
      (throw (refuse :decode :refactor/no-paths "the paths hold no .cljk/.cljc/.clj/.cljs/.edn file" {:paths (vec paths)})))
    files))

(defn- read-source [io path]
  (try ((:read io) path)
       (catch :default e
         (throw (refuse :decode :refactor/unreadable (str "cannot read " path ": " (ex-message e)) {:path path})))))

(defn- parse-checked [path src]
  (try (cst/parse src)
       (catch :default e
         (throw (refuse :decode :refactor/parse-error (str path ": " (ex-message e)) (merge {:path path} (select-keys (ex-data e) [:at])))))))

(defn- write-file! [io path text]
  (try ((:write io) path text)
       (catch :default e
         (throw (refuse :output :refactor/write-failed (str "cannot write " path ": " (ex-message e)) {:path path})))))

;; ---- rules ----------------------------------------------------------------------------------------------------------

(defn- resolve-rule-spec [spec flags]
  (let [entries (rules/resolve-rules spec)]
    (when (empty? entries) (usage! "no rule named"))
    (doseq [e entries]
      (when (:unknown e)
        (throw (refuse :usage :refactor/unknown-rule (str "unknown rule " (:unknown e) "; see `amu refactor list-rules`")
                       {:rule (:unknown e)}))))
    (when (and (some :needs-target entries) (not (get flags "--target")))
      (throw (refuse :usage :refactor/target-required "rule c needs --target dual|host-env" {})))
    entries))

(defn- observable-names [io dirs]
  (set (for [d dirs f (files-under io d source-extensions)
             m (re-seq #"(?:#')?(?:kotoba\.compiler\.frontend|frontend|fe)/([^\s()\[\]{}\"]+)" (read-source io f))]
         (second m))))

(defn- core-opts [io flags]
  (cond-> {}
    (get flags "--include-ported") (assoc :include-ported true)
    (get flags "--lower-accessor") (assoc :lower-accessor true)
    (get flags "--target") (assoc :target (keyword (get flags "--target")))
    (get flags "--regions") (assoc :regions (set (map keyword (str/split (get flags "--regions") #","))))
    (get flags "--max-passes") (assoc :max-passes (int-flag flags "--max-passes" 8))
    (get flags "--observable-from") (assoc :observable (observable-names io (str/split (get flags "--observable-from") #",")))))

(defn- rewrite-file
  "Run the rules over one file. -> {:path :before :after :res :human-sites ...}; refuses when the result cannot be re-read."
  [io path entries opts]
  (let [src (read-source io path)
        _ (parse-checked path src)
        res (try (core/run src (mapv :rule entries) opts)
                 (catch :default e
                   ;; the source itself parsed above, so a parse failure inside the driver is a rewrite pass producing
                   ;; text the reader rejects
                   (if (= :refactor-parse (:phase (ex-data e)))
                     (throw (refuse :decode :refactor/output-unparsable
                                    (str path ": a rewrite produced text that is not readable (" (ex-message e) "); nothing was written")
                                    {:path path}))
                     (throw e))))
        out (:src res)
        _ (when (not= out src)
            (try (cst/parse out)
                 (catch :default e
                   (throw (refuse :decode :refactor/output-unparsable
                                  (str path ": the rewritten text is not readable (" (ex-message e) "); nothing was written")
                                  {:path path})))))]
    {:path path :before src :after out :res res}))

(def ^:private max-sites 200)

(defn- file-report [{:keys [path before after res]} with-diff?]
  (let [summary (core/summarize (:first res) (:applied res))
        humans (vec (for [f (:first res) :when (= :human (:status f))] (select-keys f [:rule :line :region :reason :context :kind])))]
    (cond-> {:path path
             :changed (not= before after)
             :chars-before (count before) :chars-after (count after)
             :passes (:passes res)
             :summary summary
             :human-sites (vec (take max-sites humans))
             :human-sites-total (count humans)}
      (not= before after) (assoc :lines (diff/changed-lines before after))
      (and with-diff? (not= before after)) (assoc :diff (diff/unified path before after))
      (seq (filter #(= :inventory (:kind %)) (:first res)))
      (assoc :inventory (vec (for [i (:first res) :when (= :inventory (:kind i))] {:rule (:rule i) :data (:data i)}))))))

(defn- sum-summaries [reports]
  (reduce (fn [acc r]
            (reduce (fn [acc [rule m]]
                      (update acc rule (fn [t] (merge-with + (or t {}) (select-keys m [:patterns :ported :actionable :auto :human :applied])))))
                    acc (:summary r)))
          {} reports))

(defn- rules-answer [entries]
  (mapv (comp keyword :id) entries))

(defn- plan [io {:keys [positional flags]}]
  (when (< (count positional) 2) (usage! "usage: amu refactor plan <rules> <path>..."))
  (let [entries (resolve-rule-spec (first positional) flags)
        files (expand-paths io (rest positional) source-extensions)
        opts (core-opts io flags)
        results (mapv #(rewrite-file io % entries opts) files)
        reports (mapv #(file-report % (not (get flags "--no-diff"))) results)]
    (when-let [p (get flags "--patch-out")]
      (write-file! io p (apply str (map #(or (:diff %) "") reports))))
    {:value {:format format-tag :command :plan :ok true :rules (rules-answer entries)
             :files reports
             :totals {:files (count reports) :changed (count (filter :changed reports))
                      :summary (sum-summaries reports)}}
     :status 0}))

(defn- apply-rules [io {:keys [positional flags]}]
  (when (< (count positional) 2) (usage! "usage: amu refactor apply <rules> <path>... [--check]"))
  (let [entries (resolve-rule-spec (first positional) flags)
        files (expand-paths io (rest positional) source-extensions)
        out (get flags "--out")
        _ (when (and out (> (count files) 1)) (usage! "--out names one file; give one path"))
        check? (get flags "--check")
        opts (core-opts io flags)
        results (mapv #(rewrite-file io % entries opts) files)       ; every file is rewritten and re-read before any write
        reports (mapv #(file-report % false) results)
        changed (filter #(not= (:before %) (:after %)) results)]
    (when-not check?
      (doseq [r (if out results changed)]
        (when (or out (not= (:before r) (:after r)))
          (let [target (or out (:path r))]
            (write-file! io (str target ".amu-refactor.tmp") (:after r))
            (try ((:rename io) (str target ".amu-refactor.tmp") target)
                 (catch :default e
                   (throw (refuse :output :refactor/write-failed (str "cannot replace " target ": " (ex-message e)) {:path target}))))))))
    (let [pending (count changed)]
      {:value {:format format-tag :command :apply :ok (or (not check?) (zero? pending)) :check (boolean check?)
               :written (if (or check? out) 0 pending)
               :rules (rules-answer entries)
               :files (mapv #(select-keys % [:path :changed :chars-before :chars-after :passes :summary :human-sites-total :lines]) reports)
               :totals {:files (count reports) :changed pending
                        :summary (sum-summaries reports)}}
       :status (if (and check? (pos? pending)) 1 0)})))

;; ---- graph / partition / split --------------------------------------------------------------------------------------

(defn- one-path [io positional usage]
  (when-not (= 1 (count positional)) (usage! usage))
  (let [p (first positional)]
    (when-not (= :file ((:kind io) p)) (throw (refuse :decode :refactor/unreadable (str "not a file: " p) {:path p})))
    p))

(defn- analyse [io path]
  (let [src (read-source io path)]
    (parse-checked path src)
    [src (graph/analysis src)]))

(defn- edn-out [io flags value summary]
  (if-let [out (get flags "--out")]
    (do (write-file! io out (str (pr-str value) "\n"))
        {:value (assoc summary :out out) :status 0})
    {:value value :status 0}))

(defn- graph-cmd [io {:keys [positional flags]}]
  (let [path (one-path io positional "usage: amu refactor graph <path> [--summary] [--out FILE]")
        [src a] (analyse io path)
        g (assoc (graph/graph-data a (:adj a) (:comps a) src) :command :graph :path path :ok true)
        summary (select-keys g [:format :kind :command :path :ok :source-forms :names :edges])
        summary (assoc summary :sccs (mapv #(select-keys % [:size :lines]) (:sccs g)) :dynamic-vars (count (:dynamic-vars g)))]
    (if (get flags "--summary")
      {:value summary :status 0}
      (edn-out io flags g summary))))

(defn- read-edn [io path]
  (try (walk/postwalk host-integer/narrow ((:read-edn io) path))
       (catch :default e
         (throw (refuse :decode :refactor/unreadable (str "cannot read " path ": " (ex-message e)) {:path path})))))

(defn- partition-cmd [io {:keys [positional flags]}]
  (let [path (one-path io positional "usage: amu refactor partition <path> [--modules N] [--driver FORM] [--names FILE] [--out FILE]")
        [_ a] (analyse io path)
        names (when-let [f (get flags "--names")] (read-edn io f))
        p (partition/partition-data a (int-flag flags "--modules" 12)
                                    (cond-> {} (get flags "--driver") (assoc :driver-name (get flags "--driver")) names (assoc :names names)))
        p (assoc p :command :partition :path path :ok true)
        summary {:format format-tag :kind :partition :command :partition :path path :ok true
                 :modules (mapv #(select-keys % [:module :order :forms :lines :requires]) (:modules p))
                 :edges-total (:edges-total p) :edges-cross-module (:edges-cross-module p)
                 :edges-backward-blocking (:edges-backward-blocking p)}]
    (if (get flags "--summary")
      {:value summary :status 0}
      (edn-out io flags p summary))))

(defn- split-cmd [io {:keys [positional flags]}]
  (let [path (one-path io positional "usage: amu refactor split <path> --partition FILE --out DIR [--ns NAME]")
        pfile (or (get flags "--partition") (usage! "split needs --partition FILE (from `amu refactor partition --out FILE`)"))
        out (or (get flags "--out") (usage! "split needs --out DIR"))
        src (read-source io path)
        _ (parse-checked path src)
        part (read-edn io pfile)
        _ (when-not (and (map? part) (vector? (:modules part)) (every? #(and (:module %) (vector? (:chunks %))) (:modules part)))
            (throw (refuse :decode :refactor/partition-incomplete (str pfile " is not a partition (expected {:modules [{:module .. :order .. :chunks [..]}]})") {:path pfile})))
        ex (extract/extract src part {:ns-name (get flags "--ns")})
        rt (extract/roundtrip src ex)
        _ (when-not (:ok rt)
            (throw (refuse :decode :refactor/roundtrip-failed "the split lost or duplicated a form; nothing was written" {:roundtrip rt})))]
    (doseq [[p text] (sort (:files ex))]
      ((:mkdirs io) (str out "/" (second (re-find #"^(.*)/[^/]*$" p))))
      (write-file! io (str out "/" p) text))
    {:value (assoc (:report ex) :command :split :ok true :out out :roundtrip rt :files (vec (sort (keys (:files ex)))))
     :status 0}))

;; ---- verify ---------------------------------------------------------------------------------------------------------

(defn- verify-cmd [io {:keys [positional flags]}]
  (when (seq positional) (usage! "usage: amu refactor verify --runner FILE --classpath CP [options]"))
  (let [runner (or (get flags "--runner") (usage! "verify needs --runner FILE (a script that prints cljs.test reports)"))
        cp (or (get flags "--classpath")
               (when-let [f (get flags "--classpath-file")] (str/trim (read-source io f)))
               (usage! "verify needs --classpath CP or --classpath-file FILE"))
        nbb (or (get flags "--nbb") (:nbb-cli io) (usage! "verify needs --nbb PATH (the nbb cli.js to run the tests with)"))
        stack (int-flag flags "--stack-size" 4096)
        run! (fn [first-root]
               (let [{:keys [status stdout]} ((:spawn io) (verify/run-argv {:nbb-cli nbb :stack-size stack :classpath cp
                                                                           :first-root first-root :runner runner}))]
                 {:status status :out stdout}))
        base (run! (get flags "--base-first"))
        cand (run! (get flags "--candidate-first"))
        cmp (verify/compare-runs (:out base) (:out cand))]
    (when-not (:ran cmp)
      (throw (refuse :decode :refactor/verify-no-result
                     "a test run printed no `nbb: N tests` summary (it crashed or the runner is not a cljs.test runner)"
                     {:baseline (:summary (:baseline cmp)) :candidate (:summary (:candidate cmp))
                      :baseline-status (:status base) :candidate-status (:status cand)})))
    {:value (assoc cmp :format format-tag :command :verify :runner runner
                   :baseline (assoc (:baseline cmp) :status (:status base))
                   :candidate (assoc (:candidate cmp) :status (:status cand)))
     :status (if (:ok cmp) 0 1)}))

;; ---- to-kotoba (mechanical .cljk / .edn -> .kotoba over the CST) ----------------------------------------------------
;;
;; The conversion is mechanical and byte-accounted: a #?( ) reader conditional becomes its :kotoba arm (else its
;; :default arm, else nothing -- the Kotoba reader reads NOTHING when no arm names its feature), a #?@( ) splices the
;; arm collection's children in place, and every other byte -- comments, whitespace, `#_` discards -- is copied
;; verbatim, so a file with no conditional comes back byte-identical. What this does NOT do is stated, not hidden:
;; type annotations, throw removal and host-boundary work are rules and ports (:human findings of `plan`), never part
;; of the mechanical conversion. An .edn file (exactly one top-level value) becomes a data module whose `def` value is
;; the original bytes, so the round trip is checkable by span equality.

(defn- rc-arm
  "The arm node a .kotoba reading keeps from a #?( ) node: the arm whose feature KEY TEXT is \":kotoba\", else the one
  named \":default\", else nil. Feature text, not region-of-feature: that function classifies regions and maps every
  non-:kotoba feature (including :clj) to :default, which would keep an arm the Kotoba reader drops."
  [n]
  (let [branches (cst/rc-branches n)]
    (or (some (fn [[k f]] (when (= ":kotoba" k) f)) branches)
        (some (fn [[k f]] (when (= ":default" k) f)) branches))))

(defn- rc-kept?
  "Whether a #?( ) node keeps the :kotoba arm. Used to classify the arm actually emitted."
  [n]
  (some (fn [[k _]] (= ":kotoba" k)) (cst/rc-branches n)))

(declare resolve-node)

(defn- resolve-kids
  "SRC's bytes between S and E with every node of KIDS replaced by its .kotoba reading; interstitial bytes are copied
  verbatim."
  [src kids s e]
  (loop [cursor s ks kids acc []]
    (if-let [k (first ks)]
      (recur (:e k) (next ks) (conj acc (subs src cursor (:s k)) (resolve-node src k)))
      (apply str (conj acc (subs src cursor e))))))

(defn- splice-arm?
  [arm] (contains? #{:list :vec :map :set :fnlit} (:type arm)))

(defn- resolve-node
  "The .kotoba reading of NODE's span of SRC."
  [src n]
  (if (= :rc (:type n))
    (let [arm (rc-arm n)]
      (cond
        (nil? arm) ""
        (:splice? n) (if (splice-arm? arm)
                       ;; the arm's INTERIOR spans: brackets dropped, every byte between them (comments, whitespace,
                       ;; `#_` discards) kept and the child nodes resolved in place
                       (resolve-kids src (:kids arm) (inc (:s arm)) (dec (:e arm)))
                       (resolve-node src arm))
        :else (resolve-node src arm)))
    (resolve-kids src (:kids n) (:s n) (:e n))))

(defn- rc-inventory
  "Outcomes of the reader conditionals that the .kotoba reading actually keeps, and findings for the two shapes that
  need a person's eye (a dropped form, a splice). Counts only KEPT arms: a conditional nested in a dropped arm never
  reaches the output and is not counted."
  [nodes]
  (let [outcomes (atom {:kotoba-arm 0 :default-arm 0 :dropped 0 :spliced 0})
        findings (atom [])]
    (letfn [(go [n]
              (if (= :rc (:type n))
                (let [arm (rc-arm n)]
                  (cond
                    (nil? arm)
                    (do (swap! outcomes update :dropped inc)
                        (swap! findings conj {:kind :rc-no-arm :offset (:s n)
                                              :reason "no #?( ) arm names :kotoba or :default; the Kotoba reader reads nothing here"}))
                    (:splice? n)
                    (do (swap! outcomes update :spliced inc)
                        (swap! findings conj {:kind :rc-splice :offset (:s n)
                                              :reason "a #?@( ) splice emits the arm collection's children in place"})
                        (go arm))
                    :else
                    (do (swap! outcomes update (if (rc-kept? n) :kotoba-arm :default-arm) inc)
                        (go arm))))
                (doseq [k (:kids n)] (go k))))]
      (doseq [n nodes] (go n)))
    {:outcomes @outcomes :findings @findings}))

(def ^:private data-literal-limit
  "The admission limit on one data literal, measured on maps in kotoba-sema's desugar
  (\"map entry count exceeds admission limit\", (<= n 128)). A literal over it is a port decision
  (chunked tables, the aiueos topic.kotoba pattern) -- never something the mechanical conversion invents."
  128)

(def ^:private map-literal-limits
  "Per-key-kind map literal entry limits, measured on `amu check --jvm-free` with the compiler naming each wall:
  keyword keys lower to a closed record (\"exceeds the record field limit: 40 entries, at most 32\"), string and i64
  keys are typed maps (\"exceeds the typed map entry limit\", typed-map-entry-limit 31, osaho kotoba.kir.value), and
  any kind also carries map-entry-limit 128 (the entry-count check)."
  {:keyword 32 :string 31 :i64 31 :default 31})

(defn- map-chunk-size
  "The literal entry budget for a map whose KEYS are the given node types."
  [key-nodes]
  (let [ks (map :type key-nodes)]
    (if (every? #(= :kw %) ks)
      (:keyword map-literal-limits)
      (:default map-literal-limits))))

(defn- data-limit-findings
  "Findings for data literals the admission limit refuses. A MAP over the limit is chunked mechanically (merge chain,
  no finding); a sequence over it has no admitted mechanical spelling yet (into/vec are not builtins -- measured), so
  it is named instead."
  [nodes]
  (let [out (atom [])]
    (letfn [(go [n]
              (let [k (:type n)
                    lim (if (= :set k) 32 data-literal-limit)] ;; typed-set-item-limit 32 / vector-literal-item-limit 128 (osaho kotoba.kir.value)]
                (when (= :map k)
                  (let [pairs (partition 2 (:kids n))
                        cnt (count pairs)
                        lim (map-chunk-size (map first pairs))
                        kw? (every? #(= :kw (:type (first %))) pairs)]
                    (when (> cnt lim)
                      (swap! out conj (if kw?
                                        {:kind :record-type-node-wall
                                         :offset (:s n) :count cnt :limit lim
                                         :reason "chunked into a merge chain mechanically, but the merged record's value type exceeds the node limit already at 40 entries (measured: 40-entry keyword map -> \"value type exceeds node limit\", adt-node-limit 512) -- a type-accounting wall (ADR 0354), named not guessed"}
                                        {:kind :typed-map-over-limit
                                         :offset (:s n) :count cnt :limit lim
                                         :reason "a typed map (string/i64 keys) over its literal limit has no admitted spelling -- merge is a row operation on a record (:row-operation-receiver, measured) and typed-map-new is capped at the same entry limit (measured): a language wall (ADR 0354), named not guessed"})))))
                (when (and (contains? #{:list :vec :set :fnlit} k) (> (count (:kids n)) lim))
                  (swap! out conj {:kind :items-over-limit
                                   :offset (:s n) :count (count (:kids n)) :limit lim
                                   :reason (if (= :set k)
                                             "set item count exceeds typed-set-item-limit (32, measured); a set has no admitted mechanical chunking -- chunking is a port decision"
                                             "item count exceeds the literal limit (128, measured); a sequence has no admitted mechanical chunking (into/vec are not builtins, measured) -- chunking is a port decision")}))
                (doseq [ch (:kids n)] (go ch))))]
      (doseq [n nodes] (go n)))
    @out))

(defn- to-kotoba-output-name [path]
  (str (str/replace path #"\.(cljk|cljc|clj|cljs|edn)$" "") ".kotoba"))

(defn- valid-module-name?
  "A module name the project parser accepts: a symbol, so not starting with a digit and holding no whitespace or
  delimiter. `2026.edn` would generate (ns 2026 ...) which parses as a NUMBER, not a namespace (measured wall)."
  [n]
  (boolean (re-matches #"[A-Za-z_*+!?<>='][A-Za-z0-9._*+!?<>=-]*" n)))

(defn- edn-module-name [path]
  (-> (second (re-find #"([^/]+)$" path))
      (str/replace #"\.edn$" "")
      (str/replace #"[^A-Za-z0-9._-]" "_")))

(declare emit-value)

(defn- emit-kids
  [src kids s e]
  (loop [cursor s ks kids acc []]
    (if-let [k (first ks)]
      (recur (:e k) (next ks) (conj acc (subs src cursor (:s k)) (emit-value src k)))
      (apply str (conj acc (subs src cursor e))))))

(defn- merge-groups
  "A merge call over chunk texts, nested when the call itself would exceed the item limit: (merge A B ...) up to
  128 arguments, else (merge (merge ...) (merge ...)). `merge` is admitted and associative over disjoint keys
  (measured: (defn data [] (merge {:a 1} {:b 2} {:c 3})) is admitted)."
  [texts]
  (loop [ts texts]
    (let [groups (mapv (fn [g]
                         (if (= 1 (count g))
                           (first g)
                           (str "(merge " (str/join " " g) ")")))
                       (partition-all data-literal-limit ts))]
      (if (= 1 (count groups))
        (first groups)
        (recur groups)))))

(defn- map-chunk-text
  "One literal map of PAIRS (key/value nodes). Entry bytes are the original; the layout between entries is re-spaced
  because the chunk is rebuilt."
  [src pairs]
  (str "{" (str/join " " (mapcat (fn [[k v]] [(emit-value src k) (emit-value src v)]) pairs)) "}"))

(defn- literal-atom?
  "EDN `true` / `false` / `nil` -- the CST classes every non-keyword non-number atom as :sym (measured in
  kotoba.compiler.refactor.cst/atom-type), but these three are data literals, not symbols."
  [n]
  (and (= :sym (:type n)) (contains? #{"true" "false" "nil"} (:text n))))

(defn- emit-value
  "One EDN value as kotoba data. A bare symbol is a constant alias in kotoba (\"constant alias must name a declared
  constant\", measured), so a data symbol is spelled (symbol \"name\") -- which `amu check` admits in a data value
  (measured: (defn data [] {:a (symbol \"x\")}) is admitted); true/false/nil stay literal. An EDN LIST is a call form
  in kotoba expression position (measured: (defn data [] (1 2)) is a call of 1), so it is spelled (list ...) --
  which `amu check` admits (measured). A map over its literal limit is mechanically chunked into a merge chain
  instead of refused. Everything else keeps its bytes."
  [src n]
  (cond
    (literal-atom? n) (cst/text src n)
    (= :sym (:type n)) (str "(symbol \"" (:text n) "\")")
    (= :list (:type n)) (if (empty? (:kids n))
                          "(list)"
                          (str "(list " (str/join " " (map #(emit-value src %) (:kids n))) ")"))
    (= :map (:type n))
    ;; Chunking is mechanical for KEYWORD keys only: those lower to closed records and `merge` is a row operation on
    ;; a record (measured admitted). A typed map (string/i64 keys) over its limit has NO admitted spelling -- `merge`
    ;; refuses it ("merge is a row operation on a record", :row-operation-receiver) and `typed-map-new` is capped at
    ;; the same entry limit (measured) -- so it stays one literal plus a named finding, a language wall (ADR 0354).
    (let [pairs (partition 2 (:kids n))
          keys* (map first pairs)
          size (map-chunk-size keys*)]
      (if (and (> (count pairs) size) (every? #(= :kw (:type %)) keys*))
        (merge-groups (mapv #(map-chunk-text src %) (partition-all size pairs)))
        (map-chunk-text src pairs)))
    (empty? (:kids n)) (cst/text src n)
    :else (emit-kids src (:kids n) (:s n) (:e n))))

(defn- data-shape
  "The data of a value node, normalized for comparison. SOURCE nodes fold structurally; EMITTED nodes also fold the
  three call spellings the emitter produces back to the data they carry: (symbol \"name\") to a symbol, (list ...) to
  a list of its items (the head is dropped), and a merge chain to one map (entries in order). The fold is
  asymmetric on purpose: on the source side a literal (symbol \"x\") is a 2-item LIST, and it emits as
  (list (symbol \"symbol\") \"x\"), so both sides fold to the same list shape with no collision."
  [n emitted?]
  (cond
    (= :sym (:type n)) [:sym (:text n)]
    (and emitted? (cst/lst? n) (= "symbol" (cst/head-text n)) (= 2 (count (:kids n)))
         (= :str (:type (second (:kids n)))))
    [:sym (let [t (:text (second (:kids n)))] (subs t 1 (dec (count t))))]
    (and emitted? (cst/lst? n) (= "list" (cst/head-text n)) (seq (:kids n)))
    (into [:list nil] (map #(data-shape % true) (rest (:kids n))))
    (and emitted? (cst/lst? n) (= "merge" (cst/head-text n)) (seq (:kids n))
         (every? #(= :map (:type %)) (rest (:kids n))))
    (into [:map nil] (mapcat (fn [m] (map #(data-shape % true) (:kids m))) (rest (:kids n))))
    :else (into [(:type n) (:text n)] (map #(data-shape % emitted?) (:kids n)))))

(defn- data-key-node?
  "A map key that is a symbol, bare or already spelled (symbol \"name\")."
  [n]
  (or (= :sym (:type n))
      (and (cst/lst? n) (= "symbol" (cst/head-text n)) (= 2 (count (:kids n))))))

(defn- data-spelling-findings
  "Data spellings the mechanical conversion does not invent, named instead of guessed. Measured on `amu check`:
  a symbol map key is refused \"map literal keys must be keywords, integers or strings; this literal has a key of
  kind: expression\" -- keywordizing or restructuring is a port decision. Character literals and tagged/quoted forms
  have no admitted data spelling at all."
  [nodes]
  (let [out (atom [])]
    (letfn [(go [n]
              (case (:type n)
                :char (swap! out conj {:kind :char-literal :offset (:s n)
                                       :reason "a character literal has no admitted data spelling in the conversion; spell the data differently"})
                :prefix (swap! out conj {:kind :tagged-or-quoted :offset (:s n) :prefix (:prefix n)
                                         :reason "a tagged/quoted form is not plain data; spell the data differently"})
                :map (do
                       (doseq [[i v] (map-indexed vector (:kids n))]
                         (when (and (odd? i) (literal-atom? v) (= "nil" (:text v)))
                           (swap! out conj {:kind :nil-map-value :offset (:s v)
                                            :reason "a nil map value makes the field an absent [:option T] with no T (\"map literal value at key :b is nil ... nothing here says T\", measured) -- give the field a value or a declared type (a port decision)"})))
                       (doseq [[i k] (map-indexed vector (:kids n))]
                       (when (and (even? i) (data-key-node? k))
                         (swap! out conj {:kind :symbol-key :offset (:s k)
                                          :reason "map literal keys must be keywords, integers or strings (amu check, measured), and assoc refuses a symbol key by type (\"expression type mismatch: expected keyword, got symbol\", measured) -- keywordize or restructure (a port decision)"}))))
                :set (when (some #(contains? #{:list :vec :map :set :fnlit} (:type %)) (:kids n))
                       (swap! out conj {:kind :set-of-collections :offset (:s n)
                                        :reason "a set whose items are collections is \"value type is outside the safe profile\" (amu check, measured; a set of scalars is admitted) -- spell the items as a vector, a port decision"}))
                nil)
              (doseq [ch (:kids n)] (go ch)))]
      (doseq [n nodes] (go n)))
    @out))

(defn- convert-file
  "One file's .kotoba text. -> {:path :kind :text :chars-before :rc :findings} (:kind :source|:edn; :edn carries
  :value)."
  [path src flags]
  (let [nodes (parse-checked path src)]
    (if (str/ends-with? path ".edn")
      (do
        (when-not (= 1 (count nodes))
          (throw (refuse :decode :refactor/parse-error
                         (str path ": an .edn file must hold exactly one top-level value; found " (count nodes))
                         {:path path})))
        (let [value-node (first nodes)
              value (emit-value src value-node)
              data-name (or (get flags "--data-name") "data")
              n (or (get flags "--ns") (edn-module-name path))
              _ (when-not (valid-module-name? n)
                  (throw (refuse :usage :refactor/usage
                                 (str path ": the generated namespace name \"" n "\" is not a symbol the project parser accepts; pass --ns NAME")
                                 {:path path :ns n})))
              _ (when-not (valid-module-name? data-name)
                  (throw (refuse :usage :refactor/usage
                                 (str path ": --data-name \"" data-name "\" is not a valid function name")
                                 {:path path :data-name data-name})))
              text (str "(ns " n "\n  (:export [" data-name "]))\n\n"
                        ";; mechanical .edn -> .kotoba (`amu refactor to-kotoba`); source: " path "\n"
                        "(defn " data-name " [] " value ")\n")]
          {:path path :kind :edn :text text :value-node value-node :chars-before (count src)
           :rc nil :findings (into (data-limit-findings nodes) (data-spelling-findings nodes))}))
      (let [text (resolve-kids src nodes 0 (count src))
            {:keys [outcomes findings]} (rc-inventory nodes)]
        {:path path :kind :source :text text :value nil :chars-before (count src)
         :rc outcomes :findings findings}))))

(defn- roundtrip-check
  "Consistency of one conversion: the emitted text re-parses; an .edn data module's `defn` body carries the same data
  (a source symbol and its (symbol \"name\") spelling compare equal); a source reading is idempotent (resolving it
  again changes nothing)."
  [{:keys [kind text value-node]}]
  (let [nodes (try (cst/parse text) (catch :default e e))]
    (if-not (vector? nodes)
      {:parse false :error (ex-message nodes)}
      (if (= kind :edn)
      (let [d (first (filter #(and (cst/lst? %) (= "defn" (cst/head-text %))) nodes))
            body (when (and d (= 4 (count (:kids d)))) (nth (:kids d) 3))]
        {:parse true :value-equivalent (boolean (and body (= (data-shape value-node false) (data-shape body true))))})
        {:parse true
         :idempotent (= text (resolve-kids text nodes 0 (count text)))}))))

(defn- to-kotoba-cmd [io {:keys [positional flags]}]
  (when (empty? positional)
    (usage! "usage: amu refactor to-kotoba <path>... [--out FILE] [--check] [--data-name NAME] [--ns NAME]"))
  (let [files (expand-paths io positional (into source-extensions edn-extensions))
        out (get flags "--out")
        _ (when (and out (> (count files) 1)) (usage! "--out names one file; give one path"))
        check? (get flags "--check")
        results (mapv (fn [p] (convert-file p (read-source io p) flags)) files)
        checks (mapv roundtrip-check results)
        _ (doseq [[r c] (map vector results checks)]
            (when-not (:parse c)
              (throw (refuse :decode :refactor/output-unparsable
                             (str (:path r) ": the converted text is not readable (" (:error c) "); nothing was written")
                             {:path (:path r)}))))
        rows (mapv (fn [r c]
                     (let [target (or out (to-kotoba-output-name (:path r)))
                           existing (when (= :file ((:kind io) target)) ((:read io) target))]
                       {:path (:path r) :out target :kind (:kind r)
                        :chars-before (:chars-before r) :chars-after (count (:text r))
                        :pending (not= (:text r) existing)
                        :rc (:rc r)
                        :findings (vec (take max-sites (:findings r)))
                        :findings-total (count (:findings r))
                        :roundtrip c}))
                   results checks)
        _ (doseq [[r row] (map vector results rows)]
            (let [c (:roundtrip row)
                  bad (or (not (:parse c))
                          (and (= :edn (:kind row)) (not (:value-equivalent c)))
                          (and (= :source (:kind row)) (not (:idempotent c))))]
              (when bad
                (throw (refuse :decode :refactor/roundtrip-failed
                               (str (:path r) ": the conversion does not round-trip (" (pr-str c) "); nothing was written")
                               {:path (:path r) :roundtrip c})))))
        _ (let [dupes (->> rows (group-by :out) (filter #(> (count (val %)) 1)))]
            (when (seq dupes)
              (throw (refuse :usage :refactor/usage
                             (str "inputs map to the same output: "
                                  (str/join ", " (map (fn [[o rs]] (str o " <- " (str/join " " (map :path rs)))) dupes))
                                  "; pass --out for one file or rename")
                             {:collisions (mapv (fn [[o rs]] {:out o :paths (mapv :path rs)}) dupes)}))))
        pending (filter :pending rows)]
    (when-not check?
      (doseq [[r row] (map vector results rows) :when (:pending row)]
        (write-file! io (str (:out row) ".amu-refactor.tmp") (:text r))
        (try ((:rename io) (str (:out row) ".amu-refactor.tmp") (:out row))
             (catch :default e
               (throw (refuse :output :refactor/write-failed (str "cannot write " (:out row) ": " (ex-message e))
                              {:path (:out row)}))))))
    {:value {:format format-tag :command :to-kotoba :ok (if check? (empty? pending) true) :check (boolean check?)
             :files rows
             :totals {:files (count rows) :pending (count pending)
                      :source (count (filter #(= :source (:kind %)) rows))
                      :edn (count (filter #(= :edn (:kind %)) rows))}}
     :status (if (and check? (seq pending)) 1 0)}))

;; ---- list-rules -----------------------------------------------------------------------------------------------------

(defn- list-rules []
  {:value {:format format-tag :command :list-rules :ok true
           :standard-order (mapv keyword rules/standard-order)
           :rules (mapv (fn [r] (cond-> {:id (keyword (:id r)) :name (keyword (:name r)) :summary (:summary r)
                                         :host-effect (:host-effect r)}
                                  (:needs-target r) (assoc :needs-target true)))
                        rules/library)
           :commands [:list-rules :plan :apply :graph :partition :split :verify :to-kotoba]}
   :status 0})

(defn run
  "Run `amu refactor` over ARGS (the words after `refactor`). IO is the host record: :read :write :rename :kind :list
  :mkdirs :read-edn :spawn (and :nbb-cli). -> {:value <EDN map> :status 0|1}; a refusal is thrown as ex-info."
  [args io]
  (let [[sub & more] args
        parsed (parse-args more)]
    (case sub
      "list-rules" (list-rules)
      "plan" (plan io parsed)
      "apply" (apply-rules io parsed)
      "graph" (graph-cmd io parsed)
      "partition" (partition-cmd io parsed)
      "split" (split-cmd io parsed)
      "verify" (verify-cmd io parsed)
      "to-kotoba" (to-kotoba-cmd io parsed)
      nil (usage! "usage: amu refactor <list-rules|plan|apply|graph|partition|split|verify|to-kotoba> ...")
      (usage! (str "unknown refactor command " sub "; one of list-rules plan apply graph partition split verify to-kotoba")))))

))
