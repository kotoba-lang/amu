(ns kotoba.compiler.bounded-edn
  "Bounded reading of EDN and source text, on both compiler hosts.

  This was `.clj` until 2026-09-11, and it was the first leaf in the
  reverse-topological order of what still forces `bin/amu` onto the JVM
  (`docs/jvm-route-topology.edn`): every JVM-only command reads its input
  through here, and nothing here is about the JVM -- it is a byte ceiling, a
  UTF-8 decode that refuses malformed input, a preflight over the text, and
  a walk over the value. The bounds are the contract; the host is not.

  On `:clj` the implementation is the one that was here, byte for byte
  inside the reader conditionals. On `:cljs` the bytes come through
  `kotoba.compiler.nbb.io`'s bounded, no-follow, growth-detecting read, and
  the EDN is read with `kotoba.compiler.kotoba-reader` -- the reader the rest
  of this compiler uses on that host, which returns a bigint for every integer
  token. That is deliberate and it is the same choice
  `kotoba.compiler.nbb.cli-support/read-artifact-file!` records: `cljs.reader`
  returns a Number, and a Number cannot hold an i64 (the first SHA-512 round
  constant came back off by 774 through it). The two hosts therefore hand
  back different representations of the same integer, and every consumer
  that compares one has to say so with `kotoba.verifier/guest-integer?`
  rather than `integer?` -- `kotoba.verifier.signing` learned that on
  2026-09-11 (kotoba-verifier f1efb423)."
  {:kotoba/export #?(:kotoba [max-edn-bytes max-source-bytes read-edn-text read-edn-text-limits read-file read-reader-text-limits read-text-file]
                     :default [max-edn-bytes max-source-bytes read-file read-string read-text-file])}
  (:refer-clojure :exclude [read-string])
  (:require #?@(:clj [[clojure.edn :as edn]
                      [kotoba.io :as io]]
                :cljs [[kotoba.compiler.kotoba-reader :as kr]
                       [kotoba.compiler.nbb.io :as nbb-io]]
                :kotoba [[kotoba.compiler.kotoba-reader :as kr]
                         [kotoba.compiler.decimal-text :as decimal-text]
                         [kotoba.compiler.text-bytes :as text-bytes]]))
  ;; Kotoba: an EDN value is the recursive `:form/r` record of kotoba.form
  ;; (the same schema, so the same type), and the reader's answer is the
  ;; twin's `:kotoba.reader/out`. Nothing here needs kotoba.form's functions.
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
                        :kotoba.reader/out [:record :kotoba.reader/out
                                            [[:forms [:list [:ref :form/r]]]
                                             [:err :string]
                                             [:at :i64]]]}))
  #?(:clj (:import [java.io ByteArrayOutputStream PushbackReader]
                   [java.nio ByteBuffer]
                   [java.nio.charset CodingErrorAction StandardCharsets]
                   [java.nio.file Files LinkOption Paths])))

;; Kotoba: an exported constant is a function returning it, and the bounds are
;; constants of the module, so all six are functions here.
#?(:kotoba
   (defn max-edn-bytes [] :i64 8388608)
   :default
   (def max-edn-bytes (* 8 1024 1024)))
#?(:kotoba
   (defn max-source-bytes [] :i64 1048576)
   :default
   (def max-source-bytes (* 1024 1024)))
#?(:kotoba
   (defn- max-depth [] :i64 128)
   :default
   (def ^:private max-depth 128))
#?(:kotoba
   (defn- max-token-chars [] :i64 4096)
   :default
   (def ^:private max-token-chars 4096))
#?(:kotoba
   (defn- max-nodes [] :i64 200000)
   :default
   (def ^:private max-nodes 200000))
#?(:kotoba
   (defn- max-string-chars [] :i64 1048576)
   :default
   (def ^:private max-string-chars (* 1024 1024)))

;; Kotoba: the refusal carries its phase only. The data map of the host
;; (kind, limit, path) is an open map merged at run time; a Kotoba raise takes
;; a keyword-keyed literal.
#?(:kotoba
   (defn- reject! [message :string] :string
     (throw (ex-info message {:phase :decode})))
   :default
   (defn- reject! [message data]
     (throw (ex-info message (merge {:phase :decode} data)))))

;; A Kotoba raise has the type its position needs, and an `if` needs equal
;; branch types, so a refusal is spelled once per result type it stands in.
#?(:kotoba
   (defn- reject-bytes! [message :string] :bytes
     (throw (ex-info message {:phase :decode})))
   :default nil)
#?(:kotoba
   (defn- reject-form! [message :string] [:ref :form/r]
     (throw (ex-info message {:phase :decode})))
   :default nil)
;; The reader's own refusals keep the phase the host reader gives them.
#?(:kotoba
   (defn- reject-read! [message :string] [:ref :form/r]
     (throw (ex-info message {:phase :read})))
   :default nil)

#?(:kotoba
   ;; Kotoba: the bytes come through the app-data scope, whose READ answers a
   ;; regular file inside the granted root and TRAPS on anything else, and so
   ;; does STAT on a path outside the scope. So the path is asked first
   ;; (2026-10-10), and refused by name as the host refuses it: EXISTS answers
   ;; "0" (never a trap) for an absent, unreadable, symlinked or out-of-scope
   ;; path ("input could not be read", the host's answer for a path it cannot
   ;; open); STAT's fourth field is 1 for a directory ("input must be a regular
   ;; file"). The byte ceiling is checked on the answer; the host's
   ;; growth-while-reading race does not exist here because the answer is one
   ;; read.
   (defn- read-bytes [path :string limit :i64 kind :keyword] :bytes
     (if (= 0 (string-byte-length path))
       (reject-bytes! "input path is required")
       (if (not (= "1" (fs/app-data (str path "EXISTS_SEP"))))
         (reject-bytes! "input could not be read")
         (let [stat (fs/app-data (str path "STAT_SEP"))
               fields (if (= 0 (string-byte-length stat)) (vector-i64) (decimal-text/fields stat))]
           (if (or (< (vector-count fields) 4) (not (= 0 (vector-at fields 3))))
             (reject-bytes! "input must be a regular file")
             (let [data (fs/app-data-bytes path)]
               (if (> (bytes-count data) limit)
                 (reject-bytes! "input exceeds byte limit")
                 data)))))))
   :clj
   (defn- read-bytes [path limit kind]
     (when-not (and (string? path) (seq path))
       (reject! "input path is required" {:kind kind}))
     (try
       (when-not (Files/isRegularFile (Paths/get path (make-array String 0))
                                      (make-array LinkOption 0))
         (reject! "input must be a regular file" {:kind kind :path path}))
       (with-open [input (io/input-stream path)
                   output (ByteArrayOutputStream.)]
         (let [buffer (byte-array 8192)]
           (loop [total 0]
             (let [read (.read input buffer)]
               (if (neg? read)
                 (.toByteArray output)
                 (let [next-total (+ total read)]
                   (when (> next-total limit)
                     (reject! "input exceeds byte limit"
                              {:kind kind :limit limit :path path}))
                   (.write output buffer 0 read)
                   (recur next-total)))))))
       (catch clojure.lang.ExceptionInfo error (throw error))
       (catch Exception error
         (throw (ex-info "input could not be read"
                         {:phase :decode :kind kind :path path} error)))))
   :cljs
   (defn- read-bytes [path limit kind]
     (when-not (and (string? path) (seq path))
       (reject! "input path is required" {:kind kind}))
     ;; `nbb-io/read-bounded-bytes-file` refuses symlinks, non-regular files,
     ;; files over the limit and files that grow while read -- the same
     ;; refusals as the `:clj` branch plus one -- but it names its data with
     ;; the verifier's vocabulary. Re-key them so a caller sees the same
     ;; {:phase :decode :kind ...} on either host.
     (try
       (nbb-io/read-bounded-bytes-file path limit)
       (catch :default error
         (let [message (ex-message error)]
           (cond
             (= message "output-set member exceeds byte limit")
             (reject! "input exceeds byte limit" {:kind kind :limit limit :path path})
             (or (= message "output-set member is not a regular file")
                 (= message "output-set member must not be a symbolic link"))
             (reject! "input must be a regular file" {:kind kind :path path})
             :else
             (throw (ex-info "input could not be read"
                             {:phase :decode :kind kind :path path} error))))))))

#?(:kotoba
   ;; `string-from-utf8` accepts canonical UTF-8 only and TRAPS on anything
   ;; else (exit 120, nothing to catch). So the bytes are checked first with
   ;; the same walk (`text-bytes/utf8-valid?`) and refused by the host's name,
   ;; "input is not valid UTF-8" (2026-10-10; was the trap).
   (defn- decode-utf8 [bytes :bytes kind :keyword] :string
     (if (text-bytes/utf8-valid? bytes)
       (string-from-utf8 bytes)
       (throw (ex-info "input is not valid UTF-8" {:phase :decode}))))
   :default
(defn- decode-utf8 [bytes kind]
  (try
    #?(:clj (str (.decode (doto (.newDecoder StandardCharsets/UTF_8)
                            (.onMalformedInput CodingErrorAction/REPORT)
                            (.onUnmappableCharacter CodingErrorAction/REPORT))
                          (ByteBuffer/wrap bytes)))
       ;; Kotoba: `string-from-utf8` accepts canonical UTF-8 only and traps
       ;; by name on anything else, so malformed input still cannot pass.
       :kotoba (string-from-utf8 bytes)
       :cljs (.decode (js/TextDecoder. "utf-8" #js {:fatal true}) bytes))
    (catch #?(:clj Exception :cljs :default) error
      ;; No cause on Kotoba: a cause is another Throwable and Kotoba has
      ;; none (kotoba-lang lang/abort-ability.edn). The host keeps it.
      (throw #?(:kotoba (ex-info "input is not valid UTF-8" {:phase :decode :kind kind})
                :default (ex-info "input is not valid UTF-8" {:phase :decode :kind kind} error)))))))

(defn read-bytes-file
  "The raw bytes of a regular file under LIMIT -- a `byte[]` on the JVM, a
  `Buffer` on Node, `:bytes` on Kotoba -- with this namespace's refusals (path
  required, regular file, byte limit). For inputs that are bytes and not text: a
  kernel object handed to `package-aiueos-boot`."
  [#?@(:kotoba [path :string limit :i64] :default [path limit])]
  #?@(:kotoba [:bytes])
  (read-bytes path limit :bytes))

;; Kotoba has one arity per name: the bounded form is `read-text-file-limit`.
#?(:kotoba
   (defn read-text-file-limit [path :string limit :i64] :string
     (decode-utf8 (read-bytes path limit :source) :source))
   :default
   nil)

#?(:kotoba
   (defn read-text-file [path :string] :string
     (read-text-file-limit path (max-source-bytes)))
   :default
   (defn read-text-file
     ([path] (read-text-file path max-source-bytes))
     ([path limit] (decode-utf8 (read-bytes path limit :source) :source))))

#?(:kotoba
   ;; ASCII whitespace by byte: space, tab, newline, vertical tab, form feed,
   ;; carriage return and the four separators FS GS RS US, which is what
   ;; Character/isWhitespace answers below 128. Non-ASCII whitespace (U+2028,
   ;; U+3000 ...) is a token byte here, not a separator; the reader twin makes
   ;; the same call.
   (defn- whitespace? [b :i64] :bool
     (or (= b 32) (and (>= b 9) (<= b 13)) (and (>= b 28) (<= b 31))))
   :default
   (defn- whitespace? [ch]
     #?(:clj (Character/isWhitespace ^char ch)
        :cljs (boolean (re-matches #"\s" ch)))))

#?(:kotoba
   ;; Kotoba: the scan answers a CODE and the caller refuses, because a call
   ;; that can abort may not precede `recur`. 0 clean, 1 dispatch form, 2
   ;; nesting, 3 token. Positions are bytes: a multi-byte character is
   ;; several token bytes, so the token ceiling is reached earlier on
   ;; non-ASCII text (the reader twin counts the same way).
   (defn- preflight-code [text :string depth-limit :i64] :i64
     (let [raw (string-to-utf8 text)
           n (bytes-count raw)]
       (loop [index 0 depth 0 token 0 in-string 0 escaped 0 in-comment 0]
         (if (>= index n)
           0
           (let [ch (bytes-at raw index)]
             (cond
               (= in-comment 1)
               (recur (+ index 1) depth 0 0 0 (if (= ch 10) 0 1))

               (and (= in-string 1) (= escaped 1))
               (recur (+ index 1) depth 0 1 0 0)

               (and (= in-string 1) (= ch 92))
               (recur (+ index 1) depth 0 1 1 0)

               (= ch 10)
               (recur (+ index 1) depth 0 in-string 0 0)

               (and (= in-string 0) (= ch 59))
               (recur (+ index 1) depth 0 0 0 1)

               (= ch 34)
               (recur (+ index 1) depth 0 (if (= in-string 1) 0 1) 0 0)

               (= in-string 1)
               (recur (+ index 1) depth 0 1 0 0)

               (and (= ch 35)
                    (or (= (+ index 1) n)
                        (not (= (bytes-at raw (+ index 1)) 123))))
               1

               (or (= ch 40) (= ch 91) (= ch 123))
               (if (> (+ depth 1) depth-limit)
                 2
                 (recur (+ index 1) (+ depth 1) 0 0 0 0))

               (or (= ch 41) (= ch 93) (= ch 125))
               (recur (+ index 1) (if (> depth 0) (- depth 1) 0) 0 0 0 0)

               (or (whitespace? ch) (= ch 44))
               (recur (+ index 1) depth 0 0 0 0)

               :else
               (if (> (+ token 1) (max-token-chars))
                 3
                 (recur (+ index 1) depth (+ token 1) 0 0 0))))))))
   :default
   nil)

#?(:kotoba
   nil
   :default
(defn- preflight! [text]
  (let [n (count text)]
    (loop [index 0 depth 0 token-length 0 in-string? false escaped? false in-comment? false]
      (when (< index n)
        (let [ch (.charAt ^String text index)]
          (cond
            in-comment?
            (recur (inc index) depth 0 false false (not= ch \newline))

            (and in-string? escaped?)
            (recur (inc index) depth 0 true false false)

            (and in-string? (= ch \\))
            (recur (inc index) depth 0 true true false)

            (= ch \newline)
            (recur (inc index) depth 0 in-string? false false)

            (and (not in-string?) (= ch \;))
            (recur (inc index) depth 0 false false true)

            (= ch \")
            (recur (inc index) depth 0 (not in-string?) false false)

            in-string?
            (recur (inc index) depth 0 true false false)

            (and (= ch \#)
                 (or (= (inc index) n)
                     (not= (.charAt ^String text (inc index)) \{)))
            (reject! "EDN dispatch forms are forbidden" {})

            (#{\( \[ \{} ch)
            (let [next-depth (inc depth)]
              (when (> next-depth max-depth)
                (reject! "EDN nesting exceeds limit" {:limit max-depth}))
              (recur (inc index) next-depth 0 false false false))

            (#{\) \] \}} ch)
            (recur (inc index) (max 0 (dec depth)) 0 false false false)

            (or (whitespace? ch) (= ch \,))
            (recur (inc index) depth 0 false false false)

            :else
            (let [next-length (inc token-length)]
              (when (> next-length max-token-chars)
                (reject! "EDN token exceeds limit" {:limit max-token-chars}))
              (recur (inc index) depth next-length false false false)))))))))

#?(:kotoba
   ;; Kotoba: the walk over a Form answers the running node count, or a
   ;; negative code (-1 depth, -2 nodes, -3 string) the caller refuses on.
   ;; A node's children are its kids, which for a map are k v k v ...; key
   ;; before value, each one level down, as on the host.
   (defn- shape-walk [x [:ref :form/r] depth :i64 nodes :i64 depth-limit :i64 node-limit :i64] :i64
     (if (> depth depth-limit)
       -1
       (let [nodes (+ nodes 1)]
         (if (> nodes node-limit)
           -2
           (if (and (= 3 (record-get [:ref :form/r] x :tag))
                    (> (string-byte-length (record-get [:ref :form/r] x :s)) (max-string-chars)))
             -3
             (shape-walk-kids (record-get [:ref :form/r] x :kids) 0 (+ depth 1) nodes depth-limit node-limit))))))
   :default
   nil)

#?(:kotoba
   (defn- shape-walk-kids [kids [:list [:ref :form/r]] i :i64 depth :i64 nodes :i64 depth-limit :i64 node-limit :i64] :i64
     (if (>= i (vector-count kids))
       nodes
       (let [r (shape-walk (typed-list-nth [:list [:ref :form/r]] kids i) depth nodes depth-limit node-limit)]
         (if (< r 0)
           r
           (shape-walk-kids kids (+ i 1) depth r depth-limit node-limit)))))
   :default
   nil)

#?(:kotoba
   nil
   :default
(defn- validate-shape! [value]
  (let [nodes (volatile! 0)]
    (letfn [(walk [x depth]
              (when (> depth max-depth)
                (reject! "EDN value nesting exceeds limit" {:limit max-depth}))
              (when (> (vswap! nodes inc) max-nodes)
                (reject! "EDN value contains too many nodes" {:limit max-nodes}))
              (when (and (string? x) (> (count x) max-string-chars))
                (reject! "EDN string exceeds limit" {:limit max-string-chars}))
              (cond
                (map? x) (doseq [[k v] x] (walk k (inc depth)) (walk v (inc depth)))
                (coll? x) (doseq [item x] (walk item (inc depth))))) ]
      (walk value 0)
      value))))

#?(:kotoba
   (defn- read-one! [text :string depth-limit :i64] [:ref :form/r]
     (let [out (kr/read-forms-bounded text depth-limit (max-token-chars))
           err (record-get [:ref :kotoba.reader/out] out :err)
           forms (record-get [:ref :kotoba.reader/out] out :forms)
           n (vector-count forms)]
       (if (> (string-byte-length err) 0)
         (reject-read! err)
         (if (= n 0)
           (reject-form! "EDN input is empty")
           (if (> n 1)
             (reject-form! "EDN input contains trailing forms")
             (typed-list-nth [:list [:ref :form/r]] forms 0))))))
   :clj
   (defn- read-one! [text]
     (with-open [reader (PushbackReader. (java.io.StringReader. text))]
       (let [eof (Object.)
             value (edn/read {:eof eof} reader)]
         (when (identical? eof value)
           (reject! "EDN input is empty" {}))
         (when-not (identical? eof (edn/read {:eof eof} reader))
           (reject! "EDN input contains trailing forms" {}))
         value)))
   :cljs
   (defn- read-one! [text]
     (let [forms (kr/read-forms text {:max-depth max-depth
                                      :max-token-chars max-token-chars})]
       (when (empty? forms)
         (reject! "EDN input is empty" {}))
       (when (> (count forms) 1)
         (reject! "EDN input contains trailing forms" {}))
       (first forms))))

#?(:kotoba
   ;; The reading of `kotoba.compiler.nbb.cli-support`'s host `read-edn-form!`
   ;; (2026-10-10): `kr/read-forms` under the depth and token ceilings, one
   ;; form, then the node and string walk -- and NO dispatch preflight. That
   ;; host reading reads `--policy`, `.kexe` artifacts and module locks with
   ;; the kotoba reader, which admits what it reads (`#_` discard, `#{}` sets,
   ;; `#?` ...), so the policy `{:allow #{..}, #_ :x}` is a policy there.
   ;; cli-support's Kotoba reading used `read-edn-text` above, whose preflight
   ;; refuses every dispatch but `#{` (this namespace's own contract, kept for
   ;; its own readers): the image refused that policy "EDN dispatch forms are
   ;; forbidden" where bin/amu admitted it. The ceilings' refusals keep their
   ;; texts (the reader's "EDN nesting exceeds limit" / "EDN token exceeds
   ;; limit" are the preflight's).
   (defn read-reader-text-limits [text :string node-limit :i64 depth-limit :i64] [:ref :form/r]
     (let [value (read-one! text depth-limit)
           walked (shape-walk value 0 0 depth-limit node-limit)]
       (if (= walked -1)
         (reject-form! "EDN value nesting exceeds limit")
         (if (= walked -2)
           (reject-form! "EDN value contains too many nodes")
           (if (= walked -3)
             (reject-form! "EDN string exceeds limit")
             value))))))

#?(:kotoba
   ;; Kotoba: `read-string` is a reserved function name, so the reading is
   ;; `read-edn-text`, and its value is a Form.
   (defn read-edn-text [text :string] [:ref :form/r]
     (read-edn-text-limits text (max-nodes) (max-depth)))
   :default
   nil)

#?(:kotoba
   ;; The same reading under caller-chosen node and depth ceilings (token and
   ;; string ceilings unchanged): a sealed artifact is a larger input class than
   ;; a policy file (`kotoba.compiler.nbb.cli-support/read-artifact-file!`).
   (defn read-edn-text-limits [text :string node-limit :i64 depth-limit :i64] [:ref :form/r]
     (let [code (preflight-code text depth-limit)]
       (if (= code 1)
         (reject-form! "EDN dispatch forms are forbidden")
         (if (= code 2)
           (reject-form! "EDN nesting exceeds limit")
           (if (= code 3)
             (reject-form! "EDN token exceeds limit")
             (let [value (read-one! text depth-limit)
                   walked (shape-walk value 0 0 depth-limit node-limit)]
               (if (= walked -1)
                 (reject-form! "EDN value nesting exceeds limit")
                 (if (= walked -2)
                   (reject-form! "EDN value contains too many nodes")
                   (if (= walked -3)
                     (reject-form! "EDN string exceeds limit")
                     value)))))))))
   :default
(defn read-string [text]
  (when-not (string? text)
    (reject! "EDN input must be text" {}))
  (preflight! text)
  ;; Kotoba: there is no host Exception, so the second clause cannot fire;
  ;; what the body throws (reject!, the kotoba reader) is ex-info, which the
  ;; first clause rethrows unchanged -- so the whole try is the body
  ;; (a Kotoba try admits one body and one catch; lang/abort-ability.edn).
  ;; The host keeps both clauses as they were.
  #?(:kotoba
     (validate-shape! (read-one! text))
     :default
  (try
    (validate-shape! (read-one! text))
    (catch #?(:clj clojure.lang.ExceptionInfo :cljs ExceptionInfo) error
      ;; The kotoba reader's own refusals carry {:phase :read}; every other
      ;; ex-info here is one of this namespace's. Both are already named.
      (throw error))
    (catch #?(:clj Exception :cljs :default) error
      (throw (ex-info "EDN input was rejected" {:phase :decode} error)))))))

#?(:kotoba
   (defn read-file [path :string] [:ref :form/r]
     (read-edn-text (decode-utf8 (read-bytes path (max-edn-bytes) :edn) :edn)))
   :default
   (defn read-file [path]
     (read-string (decode-utf8 (read-bytes path max-edn-bytes :edn) :edn))))
