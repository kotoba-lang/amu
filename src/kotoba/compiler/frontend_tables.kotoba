(ns kotoba.compiler.frontend-tables
  (:export [capability-registry-cljs-fallback named-operation-default-results arithmetic i32-operations i64-operations comparisons heap-operations kgraph-operations kernel-memory-operations slice-value-operations slice-constructor-elements kernel-base-positions kernel-privileged-operations rodata-literal-operations image-symbol-operations rodata-literal-encodings list-operations predicate-operations logical-operations map-operations map-presence-operations set-operations collection-count-operations vector-end-operations map-projection-operations typed-map-operations typed-safe-value-operations parametric-result-operations variant-operations generic-option-operations canonical-list-operations bytes-operations heterogeneous-vector-operations typed-set-operations canonical-typed-map-operations record-operations typed-vector-operations contextual-string-argument-indexes contextual-document-argument-indexes contextual-f64-argument-indexes contextual-f32-argument-indexes contextual-vector-f64-argument-types typed-f64-vector-operations compact-graph-operations document-fixed-operations document-variadic-operations sequencing-operations region-operations lazy-sequence-operations string-operations xml-operations decimal-operations f64-operations f32-operations type-directed-numeric-heads float-division-heads float-arithmetic-resolution float-negation-resolution explicit-numeric-conversions definition-heads pure-product-disallowed-heads non-shadowable-special-heads str-integer-heads intrinsic-helper-heads intrinsic-helper-order map-literal-value-constructors document-returning-heads document-constructor-heads document-head-set i64-answer-predicates local-state-write-heads local-state-scope-heads local-state-conditional-heads local-state-effect-heads row-operation-heads library-predicate-heads library-predicate-document-kinds document-of-constructors row-binding-heads state-perform-heads state-handle-heads stateful-def-heads effectful-def-heads structural-heads protocol-declaration-heads grammar-declared-heads forbidden-heads capability-catalog-fallback source-operation-registry-fallback capability-id->name-fallback table-get table-has? arm-specs specs])
  (:require [kotoba.form :as form])
  (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                      [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]
             :form/rd [:record :form/rd [[:form [:ref :form/r]] [:pos :i64]]]}))

;; Pure Kotoba route copied from frontend_tables.cljk. Keep the exported
;; operation and policy tables in sync with the shared host namespace.

(defn- set-member-from [kids [:list [:ref :form/r]] k [:ref :form/r] i :i64] :bool
     (if (>= i (vector-count kids))
       false
       (if (form/eq (typed-list-nth [:list [:ref :form/r]] kids i) k)
         true
         (set-member-from kids k (+ i 1)))))

(defn table-has? [t [:ref :form/r] k [:ref :form/r]] :bool
     (if (form/is-map? t)
       (form/form-has? t k)
       (set-member-from (form/kids-of t) k 0)))

(defn table-get [t [:ref :form/r] k [:ref :form/r]] [:ref :form/r]
     (form/form-get t k))

(defn capability-registry-cljs-fallback [] [:ref :form/r]
     (form/edn-form "{:identity/sign 1 :identity/verify 2 :hash/sha256 3 :http/post 4 :log/read 5 :log/append 6 :clock/now 7 :state/transact 8 :ui/commit 9 :ui/next-event 10 :llm/generate 11 :storage/transact 12 :http/get-stream 13 :object/get-stream 14 :object/put-block 15 :object/compare-and-set-ref 16 :http/accept 17 :http/reply 18 :fs/transact 19 :process/spawn 20 :secret/get 21 :git/run 22 :entropy/draw 23 :dataspace/transact 24 :stream/accept 25 :stream/send 26 :net/datagram 27 :link/frame 28 :can/frame 29 :code/eval 30 :screen/observe 31 :screen/act 32 :env/read 33 :fs/browse 34 :fs/browse-dir 36 :fs/app-data 35 :fs/app-data-bytes 35 :io/write 37 :cli/args 38 :io/write-error 39 :sys/cwd 40 :io/read 41 :gpu/compute 42 :net/listen 43 :net/accept 44 :net/dial 45 :net/read 46 :net/write 47}"))

(defn named-operation-default-results [] [:ref :form/r]
     (form/edn-form "{fs/app-data :string fs/app-data-bytes :bytes env/read :string clock/now :string cli/args :string io/write :string io/write-error :string sys/cwd :string io/read :string process/spawn :string entropy/draw :string}"))

