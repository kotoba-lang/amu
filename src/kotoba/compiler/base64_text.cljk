(ns kotoba.compiler.base64-text
  "base64 (RFC 4648, padded) of bytes -- a leaf with two readings
  (superproject adr-2609242330 section 1 (b), the S1 leaf pattern; the S2
  item \"Buffer base64\"). Kept out of kotoba.compiler.text-bytes so that
  module's Kotoba reading needs no library.

  Under nbb this is Buffer's, because the pure kotoba-lang/bytes codec runs
  interpreted there -- measured 2026-09-25 on this workstation, per call:
  encode 100 KB 50 ms and 1 MB 647 ms, decode 100 KB 145 ms and 1 MB
  1,381 ms, against 0.04-0.22 ms for Buffer; the worker cache round-trips
  compiled binaries of that size through here. The two readings give the same
  text (test/nbb/host_abilities.cljk, lengths 0-69, 1000, 4097, 65536). Under
  Kotoba the reading is kotoba.bytes."
  {:kotoba/export [decode encode]}
  (:require #?(:kotoba [kotoba.bytes :as pure-bytes])))

;; R6QW3: the Kotoba reading (W3 re-port). The pure codec (kotoba.bytes) is the shared
;; reading; its Kotoba return is [:option :vector-i64] where the hosts answer a bare
;; vector, so the :kotoba arms unwrap the option (the empty vector where the host's
;; Buffer answers empty). The host reading is byte-for-byte.
#?(:kotoba
   (defn encode
     "BYTES as padded base64 text."
     [bs :vector-i64] :string
     (pure-bytes/base64-encode bs))
   :default
(defn encode
  "BYTES as padded base64 text."
  [bytes]
  #?(:cljs (.toString bytes "base64")
     :default (pure-bytes/base64-encode (vector-i64-from-bytes bytes)))))
#?(:kotoba
   (defn decode
     "Padded base64 TEXT as bytes."
     [text :string] :vector-i64
     (option-value-of [:option :vector-i64] (pure-bytes/base64-decode text) []))
   :default
(defn decode
  "Padded base64 TEXT as bytes."
  [text]
  #?(:cljs (.from js/Buffer text "base64")
     :default (bytes-from-vector-i64 (pure-bytes/base64-decode text)))))
