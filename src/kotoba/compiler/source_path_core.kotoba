(ns kotoba.compiler.source-path-core
  {:kotoba/export [source-kind source-kind-present? admit! admit-native-artifact!]})

(defn- suffix? [path :string suffix :string] :bool
  (let [size (string-byte-length path)
        tail (string-byte-length suffix)]
    (and (>= size tail)
         (string=? (string-substring path (- size tail) size) suffix))))

(defn- retired-source-path? [path :string] :bool
  (or (suffix? path ".cljk") (suffix? path ".cljc")
      (suffix? path ".cljs") (suffix? path ".clj")))

(defn- error-document [message :string data :document] :document
  (document-map (document-keyword :message) (document-string message)
                (document-keyword :data) data))

(defn source-kind
  "Recognize canonical Kotoba source for discovery and admission."
  [path :string] [:option :keyword]
  (if (suffix? path ".kotoba")
    (option-some-of [:option :keyword] :kotoba)
    (option-none-of [:option :keyword])))

(defn source-kind-present? [path :string] :bool
  (option-some?-of [:option :keyword] (source-kind path)))

(defn admit! [path :string] [:result :string :document]
  (if (source-kind-present? path)
    (result-ok-of [:result :string :document] path)
    (result-err-of
     [:result :string :document]
     (error-document
      "source input must use .kotoba"
      (document-map (document-keyword :phase) (document-keyword :usage)
                    (document-keyword :path) (document-string path)
                    (document-keyword :extensions)
                    (document-vector (document-string ".kotoba")))))))

(defn- missing-artifact-keys [value :document] :document
  (let [out (document-vector)]
    (let [with-exports (if (document-contains value (document-keyword :exports))
                         out
                         (document-vector-conj out (document-keyword :exports)))]
      (if (document-contains value (document-keyword :code))
        with-exports
        (document-vector-conj with-exports (document-keyword :code))))))

(defn- present-artifact-keys [value :document] :document
  (let [n (document-count value)]
    (loop [i 0 out (document-vector)]
      (if (>= i n)
        (document-vector-sort out)
        (let [entry (option-value-of [:option :document]
                                     (document-map-entry-at value i)
                                     (document-vector))
              key (option-value-of [:option :document]
                                   (document-vector-at entry 0)
                                   (document-null))]
          (recur (inc i) (document-vector-conj out key)))))))

(defn admit-native-artifact! [value :document path :string]
  [:result :document :document]
  (if (or (source-kind-present? path) (retired-source-path? path))
    (result-err-of
     [:result :document :document]
     (error-document
      "extract-native reads a compiled artifact, not a source file"
      (document-map (document-keyword :phase) (document-keyword :decode)
                    (document-keyword :path) (document-string path)
                    (document-keyword :source-kind) (document-keyword
                                  (option-value-of [:option :keyword]
                                                   (source-kind path)
                                                   :retired-source))
                    (document-keyword :expected)
                    (document-string "the EDN artifact written by `compile --output`"))))
    (if (not= (document-kind value) :map)
      (result-err-of
       [:result :document :document]
       (error-document
        "extract-native input did not read as a native artifact"
        (document-map (document-keyword :phase) (document-keyword :decode)
                      (document-keyword :path) (document-string path)
                      (document-keyword :expected)
                      (document-string "the EDN artifact written by `compile --output`"))))
      (let [missing (missing-artifact-keys value)]
        (if (> (document-count missing) 0)
          (result-err-of
           [:result :document :document]
           (error-document
            "extract-native input is missing native artifact keys"
            (document-map (document-keyword :phase) (document-keyword :decode)
                          (document-keyword :path) (document-string path)
                          (document-keyword :missing) missing
                          (document-keyword :present) (present-artifact-keys value))))
          (result-ok-of [:result :document :document] value))))))
