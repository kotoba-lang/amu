(ns kotoba.compiler.release
  "Release attestation: an SPDX 2.3 SBOM that is a pure function of the
  artifact bytes, and an Ed25519 statement over {artifact, sbom, target}.

  Portable since 2026-09-11 (ADR 0347): the file walk that was
  `java.nio.file` + `MessageDigest` has a `:cljs` branch on `node:fs` and
  `node:crypto` with the same refusals (regular file, no symlink, byte
  limit, SPDX-safe name). The statement, the signature and the verdicts are
  host-independent. Integers read back on the Node host are bigint, so the
  validity bounds and the recorded sizes are admitted through
  `verifier/guest-integer?` and compared through a normalizing equality."
  {:kotoba/export [attest file-identity sbom-bytes verify!]}
  (:require [kotoba.bytes :as kbytes] [kotoba.lang.coll :as coll]
            [kotoba.verifier :as verifier]
            [kotoba.verifier.signing :as signing]
            [kotoba.kir.target :as target]
            #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.verifier.seal :as seal]
                         [sha2.core :as sha2]])
            #?@(:cljs [["node:crypto" :as crypto]
                       ["node:fs" :as fs]
                       ["node:path" :as node-path]]))
  #?(:clj (:import [java.io FileInputStream]
                   [java.nio.file Files LinkOption Path Paths]
                   [java.security MessageDigest]))
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba nil :default (def ^:private max-file-bytes (* 1024 1024 1024)))
#?(:kotoba nil :default (defn- reject! [message data]
  (throw (ex-info message (merge {:phase :signature} data)))))
#?(:kotoba nil :default (defn- an-integer? [x] (verifier/guest-integer? x)))
#?(:kotoba nil :default (defn- as-number
  "A bigint that fits a double, as a number; anything else unchanged. Sizes
  and epochs are far below 2^53, so this is exact for every value that
  reaches it -- and it is applied only after `an-integer?` admitted it."
  [x]
  #?(:clj x
     :cljs (if (identical? js/BigInt (type x)) (js/Number x) x))))
#?(:kotoba nil :default (defn- guest= [a b]
  #?(:clj (= a b)
     :cljs (= (coll/postwalk as-number a) (coll/postwalk as-number b)))))

#?(:clj
   (defn- hex [bytes]
     (apply str (map #(format "%02x" (bit-and (int %) 0xff)) bytes))))

#?(:clj
   (defn- regular-path [value]
     (when-not (and (string? value) (seq value)) (reject! "release file path is required" {}))
     (let [path (.toAbsolutePath (Paths/get value (make-array String 0)))]
       (when-not (and (Files/isRegularFile path (make-array LinkOption 0))
                      (not (Files/isSymbolicLink path)))
         (reject! "release file must be a non-symlink regular file" {:path value}))
       (when (> (Files/size path) max-file-bytes)
         (reject! "release file exceeds byte limit" {:limit max-file-bytes}))
       path))
   :cljs
   (defn- regular-path [value]
     (when-not (and (string? value) (seq value)) (reject! "release file path is required" {}))
     (let [path (.resolve node-path value)
           stat (try (.lstatSync fs path) (catch :default _ nil))]
       (when-not (and stat (.isFile stat) (not (.isSymbolicLink stat)))
         (reject! "release file must be a non-symlink regular file" {:path value}))
       (when (> (.-size stat) max-file-bytes)
         (reject! "release file exceeds byte limit" {:limit max-file-bytes}))
       path)))

#?(:kotoba nil :default (defn- spdx-safe-name! [name]
  (when (or (> (count name) 255)
            (some #(let [c #?(:clj (int %) :cljs (.charCodeAt % 0))]
                     (or (< c 32) (<= 127 c 159)))
                  name))
    (reject! "release filename is not SPDX-safe" {}))))

#?(:kotoba nil :default (defn file-identity [value]
  #?(:clj
     (let [^Path path (regular-path value)
           digest (MessageDigest/getInstance "SHA-256")
           buffer (byte-array 65536)]
       (with-open [input (FileInputStream. (.toFile path))]
         (loop []
           (let [read (.read input buffer)]
             (when (pos? read) (.update digest buffer 0 read) (recur)))))
       (let [name (str (.getFileName path))]
         (spdx-safe-name! name)
         {:name name :sha256 (hex (.digest digest)) :size (Files/size path)}))
     :cljs
     (let [path (regular-path value)
           bytes (.readFileSync fs path)
           name (.basename node-path path)]
       (spdx-safe-name! name)
       {:name name
        :sha256 (-> (.createHash crypto "sha256") (.update bytes) (.digest "hex"))
        :size (.-length bytes)}))))

#?(:kotoba nil :default (defn- spdx-id [sha] (str "SPDXRef-File-" (subs sha 0 16))))
#?(:kotoba nil :default (defn- sbom-text [artifact-path]
  (let [{:keys [name sha256 size]} (file-identity artifact-path)
        file-id (spdx-id sha256)]
    (str "SPDXVersion: SPDX-2.3\n"
         "DataLicense: CC0-1.0\n"
         "SPDXID: SPDXRef-DOCUMENT\n"
         "DocumentName: kotoba-release-" (subs sha256 0 16) "\n"
         "DocumentNamespace: https://kotoba-lang.org/spdx/" sha256 "\n"
         "Creator: Tool: kotoba-compiler\n"
         "Created: 1970-01-01T00:00:00Z\n\n"
         "FileName: ./" name "\n"
         "SPDXID: " file-id "\n"
         "FileChecksum: SHA256: " sha256 "\n"
         "FileSize: " size "\n"
         "LicenseConcluded: NOASSERTION\n"
         "CopyrightText: NOASSERTION\n\n"
         "Relationship: SPDXRef-DOCUMENT DESCRIBES " file-id "\n"))))
#?(:kotoba nil :default (defn sbom-bytes [artifact-path]
  (let [text (sbom-text artifact-path)]
    #?(:clj (kbytes/utf8-bytes text)
       :cljs (js/Buffer.from text "utf8")))))
#?(:kotoba nil :default (defn- canonical-sbom! [artifact-path sbom-path]
  (let [path (regular-path sbom-path)
        size #?(:clj (Files/size ^Path path) :cljs (.-size (.statSync fs path)))]
    (when (> size (* 1024 1024))
      (reject! "release SBOM exceeds byte limit" {:limit (* 1024 1024)}))
    (when-not #?(:clj (MessageDigest/isEqual (sbom-bytes artifact-path) (Files/readAllBytes ^Path path))
                 :cljs (let [expected (sbom-bytes artifact-path)
                             actual (.readFileSync fs path)]
                         (and (= (.-length expected) (.-length actual))
                              (crypto/timingSafeEqual expected actual))))
      (reject! "release SBOM is not canonical for artifact" {})))))
#?(:kotoba nil :default (defn- sha256? [value] (and (string? value) (boolean (re-matches #"[0-9a-f]{64}" value)))))
#?(:kotoba nil :default (defn attest [artifact-path sbom-path target-name key not-before expires]
  (when-not (contains? target/profiles target-name)
    (reject! "release target is unsupported" {:target target-name}))
  (when-not (and (an-integer? not-before) (an-integer? expires) (< not-before expires))
    (reject! "release validity interval rejected" {}))
  (when-not (signing/valid-key? key) (reject! "release signing key rejected" {}))
  (canonical-sbom! artifact-path sbom-path)
  (let [statement {:format :kotoba.release-statement/v1
                   :subject (file-identity artifact-path)
                   :sbom (file-identity sbom-path)
                   :target target-name :target-profile (target/profile target-name)
                   :builder :kotoba-compiler/v1 :signer (:signer key)
                   :public-key (:public-key key)
                   :not-before not-before :expires expires}]
    {:format :kotoba.release-attestation/v1 :statement statement
     :signature (signing/sign-value key statement)})))
#?(:kotoba nil :default (defn verify! [envelope artifact-path sbom-path trust now]
  (signing/validate-trust! trust)
  (let [statement (:statement envelope)
        expected-fields #{:format :subject :sbom :target :target-profile :builder
                          :signer :public-key :not-before :expires}
        {:keys [subject sbom target target-profile signer public-key not-before expires]} statement]
    (when-not (and (= #{:format :statement :signature} (set (keys envelope)))
                   (= :kotoba.release-attestation/v1 (:format envelope))
                   (= expected-fields (set (keys statement)))
                   (= :kotoba.release-statement/v1 (:format statement))
                   (= :kotoba-compiler/v1 (:builder statement))
                   (contains? target/profiles target)
                   (guest= target-profile (target/profile target))
                   (= #{:name :sha256 :size} (set (keys subject)))
                   (= #{:name :sha256 :size} (set (keys sbom)))
                   (every? sha256? [(:sha256 subject) (:sha256 sbom)])
                   (every? #(and (an-integer? %) (<= 0 % max-file-bytes)) [(:size subject) (:size sbom)])
                   (= signer (signing/signer-id public-key))
                   (an-integer? not-before) (an-integer? expires) (< not-before expires)
                   (string? (:signature envelope)))
      (reject! "release attestation schema rejected" {}))
    (when-not (signing/verify-value public-key statement (:signature envelope))
      (reject! "release attestation signature rejected" {}))
    (when-not (contains? (:trusted-signers trust) signer) (reject! "release signer is not trusted" {}))
    (when (contains? (:revoked-signers trust) signer) (reject! "release signer is revoked" {}))
    (when (contains? (:revoked-artifacts trust) (:sha256 subject))
      (reject! "release artifact is revoked" {}))
    (when (or (< now not-before) (>= now expires)) (reject! "release attestation is outside validity" {:now now}))
    (when-not (guest= subject (file-identity artifact-path)) (reject! "release artifact identity mismatch" {}))
    (when-not (guest= sbom (file-identity sbom-path)) (reject! "release SBOM identity mismatch" {}))
    (canonical-sbom! artifact-path sbom-path)
    {:verified? true :target target :subject subject :sbom sbom :signer signer})))

;; ---------------------------------------------------------------------------
;; THE KOTOBA READING. Same checks, same order, over Forms; a file is read
;; through the app-data scope, which answers a regular file inside the granted
;; root and traps on anything else (no symlink, directory or missing file gets
;; through), so `regular-path`'s refusals are that trap. A host `throw`
;; (ex-info) is a TRAP (`assert`): an export cannot abort with a value a
;; caller sees. The target profile is the `:document` of kotoba.kir.target,
;; read into a Form for the statement; SHA-256 of a file is the pure
;; org-nist-sha2. `now` and the validity bounds are i64.

#?(:kotoba
   (defn- max-file-bytes [] :i64 1073741824))

#?(:kotoba
   (defn- trap-form [] [:ref :form/r]
     (let [refused (assert (= 1 0))] (form/nil-form))))

#?(:kotoba
   (defn- trap-bytes [] :bytes
     (let [refused (assert (= 1 0))] (bytes-empty))))

#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k))))

#?(:kotoba
   (defn- has? [m [:ref :form/r] k :keyword] :bool
     (form/form-has? m (form/keyword-form k))))

#?(:kotoba
   (defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v)))

#?(:kotoba
   (defn- empty-map [] [:ref :form/r] (form/form-map (form/no-forms))))

#?(:kotoba
   (defn- member-from [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] :bool
     (if (>= i (vector-count xs))
       false
       (if (form/eq (typed-list-nth [:list [:ref :form/r]] xs i) x)
         true
         (member-from xs x (+ i 1))))))

#?(:kotoba
   (defn- member? [s [:ref :form/r] x [:ref :form/r]] :bool
     (member-from (form/kids-of s) x 0)))

#?(:kotoba
   (defn- lower-hex? [c :i64] :bool
     (if (>= c 48) (if (<= c 57) true (if (>= c 97) (<= c 102) false)) false)))

#?(:kotoba
   (defn- hex64-from [s :string i :i64] :bool
     (if (>= i 64)
       true
       (if (lower-hex? (string-code-point-at s i)) (hex64-from s (+ i 1)) false))))

#?(:kotoba
   (defn- sha256? [f [:ref :form/r]] :bool
     (if (form/is-string? f)
       (if (= 64 (string-byte-length (form/string-value f)))
         (hex64-from (form/string-value f) 0)
         false)
       false)))

;; the bytes of a regular file under the byte limit
#?(:kotoba
   (defn- file-bytes [path :string] :bytes
     (if (= 0 (string-byte-length path))
       (trap-bytes)
       (let [data (fs/app-data-bytes path)]
         (if (> (bytes-count data) (max-file-bytes)) (trap-bytes) data)))))

;; the text after the last "/" of a path
#?(:kotoba
   (defn- base-from [path :string i :i64] :string
     (if (< i 0)
       path
       (if (= 47 (string-code-point-at path i))
         (string-substring path (+ i 1) (string-byte-length path))
         (base-from path (- i 1))))))

#?(:kotoba
   (defn- basename [path :string] :string
     (base-from path (- (string-byte-length path) 1))))

;; a code point of the name below 32 or in 127..159 is not SPDX-safe; the walk
;; advances by the UTF-8 width of each code point
#?(:kotoba
   (defn- name-safe-from? [name :string i :i64 n :i64] :bool
     (if (>= i n)
       true
       (let [c (string-code-point-at name i)]
         (if (< c 32)
           false
           (if (>= c 127)
             (if (<= c 159)
               false
               (name-safe-from? name (+ i (if (< c 2048) 2 (if (< c 65536) 3 4))) n))
             (name-safe-from? name (+ i 1) n)))))))

#?(:kotoba
   (defn- spdx-safe? [name :string] :bool
     (if (> (string-length name) 255)
       false
       (name-safe-from? name 0 (string-byte-length name)))))

#?(:kotoba
   (defn- sha256-hex [data :bytes] :string
     (kbytes/hex (sha2/sha256 (vector-i64-from-bytes data)))))

;; {:name :sha256 :size} of a regular file; a name that is not SPDX-safe traps
#?(:kotoba
   (defn file-identity [path :string] [:ref :form/r]
     (let [data (file-bytes path)
           name (basename path)]
       (if (spdx-safe? name)
         (put (put (put (empty-map) :name (form/string-form name))
                   :sha256 (form/string-form (sha256-hex data)))
              :size (form/int-form (bytes-count data)))
         (trap-form)))))

#?(:kotoba
   (defn- sbom-text-of [name :string sha256 :string size :i64] :string
     (let [file-id (string-concat "SPDXRef-File-" (string-substring sha256 0 16))]
       (string-concat
        "SPDXVersion: SPDX-2.3\nDataLicense: CC0-1.0\nSPDXID: SPDXRef-DOCUMENT\nDocumentName: kotoba-release-"
        (string-concat (string-substring sha256 0 16)
        (string-concat "\nDocumentNamespace: https://kotoba-lang.org/spdx/"
        (string-concat sha256
        (string-concat "\nCreator: Tool: kotoba-compiler\nCreated: 1970-01-01T00:00:00Z\n\nFileName: ./"
        (string-concat name
        (string-concat "\nSPDXID: "
        (string-concat file-id
        (string-concat "\nFileChecksum: SHA256: "
        (string-concat sha256
        (string-concat "\nFileSize: "
        (string-concat (string-from-i64 size)
        (string-concat "\nLicenseConcluded: NOASSERTION\nCopyrightText: NOASSERTION\n\nRelationship: SPDXRef-DOCUMENT DESCRIBES "
        (string-concat file-id "\n")))))))))))))))))

#?(:kotoba
   (defn- sbom-text [artifact-path :string] :string
     (let [identity (file-identity artifact-path)]
       (sbom-text-of (form/string-value (fget identity :name))
                     (form/string-value (fget identity :sha256))
                     (form/int-value (fget identity :size))))))

#?(:kotoba
   (defn sbom-bytes [artifact-path :string] :bytes
     (string-to-utf8 (sbom-text artifact-path))))

;; constant-time equality of two byte strings: every byte is read
#?(:kotoba
   (defn- bytes-diff-from [a :bytes b :bytes i :i64 diff :i64] :i64
     (if (>= i (bytes-count a))
       diff
       (bytes-diff-from a b (+ i 1) (bit-or diff (bit-xor (bytes-at a i) (bytes-at b i)))))))

#?(:kotoba
   (defn- bytes-equal? [a :bytes b :bytes] :bool
     (if (= (bytes-count a) (bytes-count b))
       (= 0 (bytes-diff-from a b 0 0))
       false)))

#?(:kotoba
   (defn- canonical-sbom? [artifact-path :string sbom-path :string] :bool
     (let [actual (file-bytes sbom-path)]
       (if (> (bytes-count actual) 1048576)
         false
         (bytes-equal? (sbom-bytes artifact-path) actual)))))

#?(:kotoba
   (defn- profile-of [target-name :keyword] :document
     (target/profile target-name)))

#?(:kotoba
   (defn- known-target? [target-name :keyword] :bool
     (= :map (document-kind (profile-of target-name)))))

#?(:kotoba
   (defn attest [artifact-path :string sbom-path :string target-name :keyword
                 signing-key [:ref :form/r] not-before :i64 expires :i64]
     [:ref :form/r]
     (if (known-target? target-name)
       (if (< not-before expires)
         (if (signing/valid-key? signing-key)
           (if (canonical-sbom? artifact-path sbom-path)
             (let [statement (put (put (put (put (put (put (put (put (put (put (empty-map)
                               :format (form/keyword-form :kotoba.release-statement/v1))
                               :subject (file-identity artifact-path))
                               :sbom (file-identity sbom-path))
                               :target (form/keyword-form target-name))
                               :target-profile (form/from-document (profile-of target-name)))
                               :builder (form/keyword-form :kotoba-compiler/v1))
                               :signer (fget signing-key :signer))
                               :public-key (fget signing-key :public-key))
                               :not-before (form/int-form not-before))
                               :expires (form/int-form expires))]
               (put (put (put (empty-map) :format (form/keyword-form :kotoba.release-attestation/v1))
                         :statement statement)
                    :signature (form/string-form (signing/sign-value signing-key statement))))
             (trap-form))
           (trap-form))
         (trap-form))
       (trap-form))))

;; {:name :sha256 :size} with a valid digest and a size in 0..max
#?(:kotoba
   (defn- identity-shape? [f [:ref :form/r]] :bool
     (if (form/is-map? f)
       (if (= 6 (form/count-of f))
         (if (has? f :name)
           (if (has? f :sha256)
             (if (has? f :size)
               (if (sha256? (fget f :sha256))
                 (if (verifier/guest-integer? (fget f :size))
                   (if (>= (form/int-value (fget f :size)) 0)
                     (<= (form/int-value (fget f :size)) (max-file-bytes))
                     false)
                   false)
                 false)
               false)
             false)
           false)
         false)
       false)))

#?(:kotoba
   (defn- statement-shape? [st [:ref :form/r]] :bool
     (if (form/is-map? st)
       (if (= 20 (form/count-of st))
         (if (has? st :format)
           (if (has? st :subject)
             (if (has? st :sbom)
               (if (has? st :target)
                 (if (has? st :target-profile)
                   (if (has? st :builder)
                     (if (has? st :signer)
                       (if (has? st :public-key)
                         (if (has? st :not-before) (has? st :expires) false)
                         false)
                       false)
                     false)
                   false)
                 false)
               false)
             false)
           false)
         false)
       false)))

#?(:kotoba
   (defn- target-matches? [st [:ref :form/r]] :bool
     (if (form/is-keyword? (fget st :target))
       (if (known-target? (form/keyword-value (fget st :target)))
         (form/eq (fget st :target-profile)
                  (form/from-document (profile-of (form/keyword-value (fget st :target)))))
         false)
       false)))

#?(:kotoba
   (defn- interval? [st [:ref :form/r]] :bool
     (if (verifier/guest-integer? (fget st :not-before))
       (if (verifier/guest-integer? (fget st :expires))
         (< (form/int-value (fget st :not-before)) (form/int-value (fget st :expires)))
         false)
       false)))

#?(:kotoba
   (defn- schema-ok? [envelope [:ref :form/r]] :bool
     (if (form/is-map? envelope)
       (if (= 6 (form/count-of envelope))
         (if (has? envelope :format)
           (if (has? envelope :statement)
             (if (has? envelope :signature)
               (let [st (fget envelope :statement)]
                 (if (form/eq (fget envelope :format) (form/keyword-form :kotoba.release-attestation/v1))
                   (if (statement-shape? st)
                     (if (form/eq (fget st :format) (form/keyword-form :kotoba.release-statement/v1))
                       (if (form/eq (fget st :builder) (form/keyword-form :kotoba-compiler/v1))
                         (if (target-matches? st)
                           (if (identity-shape? (fget st :subject))
                             (if (identity-shape? (fget st :sbom))
                               (if (form/is-string? (fget st :public-key))
                                 (if (form/eq (fget st :signer)
                                              (form/string-form (signing/signer-id (form/string-value (fget st :public-key)))))
                                   (if (interval? st)
                                     (form/is-string? (fget envelope :signature))
                                     false)
                                   false)
                                 false)
                               false)
                             false)
                           false)
                         false)
                       false)
                     false)
                   false))
               false)
             false)
           false)
         false)
       false)))

#?(:kotoba
   (defn- standing-ok? [trust [:ref :form/r] st [:ref :form/r] now :i64] :bool
     (let [signer (fget st :signer)]
       (if (member? (fget trust :trusted-signers) signer)
         (if (member? (fget trust :revoked-signers) signer)
           false
           (if (member? (fget trust :revoked-artifacts) (fget (fget st :subject) :sha256))
             false
             (if (< now (form/int-value (fget st :not-before)))
               false
               (< now (form/int-value (fget st :expires))))))
         false))))

#?(:kotoba
   (defn verify! [envelope [:ref :form/r] artifact-path :string sbom-path :string
                  trust [:ref :form/r] now :i64]
     [:ref :form/r]
     (let [checked (signing/validate-trust! trust)]
       (if (schema-ok? envelope)
         (let [st (fget envelope :statement)]
           (if (signing/verify-value (form/string-value (fget st :public-key)) st
                                     (form/string-value (fget envelope :signature)))
             (if (standing-ok? trust st now)
               (if (form/eq (fget st :subject) (file-identity artifact-path))
                 (if (form/eq (fget st :sbom) (file-identity sbom-path))
                   (if (canonical-sbom? artifact-path sbom-path)
                     (put (put (put (put (put (empty-map) :verified? (form/bool-form true))
                                         :target (fget st :target))
                                    :subject (fget st :subject))
                               :sbom (fget st :sbom))
                          :signer (fget st :signer))
                     (trap-form))
                   (trap-form))
                 (trap-form))
               (trap-form))
             (trap-form)))
         (trap-form)))))
