;; Native Seed command entry. It resolves bounded source graphs and analyzes
;; modules in dependency order through the Kotoba-native interface linker.
(ns kotoba.compiler.native-cli
  {:kotoba/export [main]}
  (:require [kotoba.compiler.native-frontend :as frontend]
            [kotoba.compiler.native-project-files :as project-files]
            [kotoba.form :as form])
  (:capabilities #{:cli/args :io/write :io/write-error})
  (:schemas {:native.cli/options
             [:record :native.cli/options
              [[:roots :string] [:lock :string] [:blocks :string]
               [:unpinned :bool] [:err :string]]]}))

(defn- options-result [roots :string lock :string blocks :string
                       unpinned :bool error :string]
  [:ref :native.cli/options]
  (record-new [:ref :native.cli/options] roots lock blocks unpinned error))

(defn- cli-arg [index :i64] :string
  (typed-cap-call :cli/args :string :string (string-from-i64 index)))

(defn- collect-source-path-options
  [index :i64 argc :i64 roots :string root-count :i64 lock :string
   blocks :string unpinned :bool]
  [:ref :native.cli/options]
  (if (>= index argc)
    (options-result roots lock blocks unpinned "")
    (let [argument (cli-arg index)]
      (cond
        (string=? argument "--unpinned")
        (collect-source-path-options (+ index 1) argc roots root-count
                                     lock blocks true)

        (string=? argument "--source-path")
        (if (>= (+ index 1) argc)
          (options-result roots lock blocks unpinned
                          "--source-path requires a directory")
          (let [path (cli-arg (+ index 1))]
            (cond
              (or (= (string-length path) 0)
                  (> (string-byte-length path) 4096)
                  (not (string=? (string-substring path 0 1) "/"))
                  (>= (string-index-of path "\n") 0))
              (options-result roots lock blocks unpinned
                              "source-path directories must be absolute paths up to 4096 bytes")

              (>= root-count 16)
              (options-result roots lock blocks unpinned
                              "source-path root count exceeds 16")

              :else
              (collect-source-path-options
               (+ index 2) argc
               (if (= root-count 0)
                 path
                 (string-concat roots (string-concat "\n" path)))
               (+ root-count 1) lock blocks unpinned))))

        (string=? argument "--module-lock")
        (if (>= (+ index 1) argc)
          (options-result roots lock blocks unpinned
                          "--module-lock requires a lock file")
          (let [path (cli-arg (+ index 1))]
            (if (or (= (string-byte-length path) 0)
                    (> (string-byte-length path) 4096)
                    (not (string=? (string-substring path 0 1) "/"))
                    (>= (string-index-of path "\n") 0))
              (options-result roots lock blocks unpinned
                              "module-lock path must be absolute up to 4096 bytes")
              (collect-source-path-options (+ index 2) argc roots root-count
                                           path blocks unpinned))))

        (string=? argument "--blocks")
        (if (>= (+ index 1) argc)
          (options-result roots lock blocks unpinned
                          "--blocks requires a directory")
          (let [path (cli-arg (+ index 1))]
            (if (or (= (string-byte-length path) 0)
                    (> (string-byte-length path) 4096)
                    (not (string=? (string-substring path 0 1) "/"))
                    (>= (string-index-of path "\n") 0))
              (options-result roots lock blocks unpinned
                              "block-store path must be absolute up to 4096 bytes")
              (collect-source-path-options (+ index 2) argc roots root-count
                                           lock path unpinned))))

        :else
        (options-result roots lock blocks unpinned
                        (string-concat "unknown project option: " argument))))))

(defn- suffix? [path :string suffix :string] :bool
  (let [n (string-byte-length path)
        m (string-byte-length suffix)]
    (and (>= n m)
         (string=? (string-substring path (- n m) n) suffix))))

(defn- error-message [result [:ref :ana/ir]] :string
  (record-get [:ref :fe/err] (record-get [:ref :ana/ir] result :err) :msg))

(defn- analyze-project-module [modules [:list [:ref :native.project/source]] index :i64]
  [:ref :ana/ir]
  (let [module (typed-list-nth [:list [:ref :native.project/source]] modules index)
        source (record-get [:ref :native.project/source] module :text)
        surface? (record-get [:ref :native.project/source] module :surface)
        dependency-packet
        (project-files/direct-dependency-source-packet modules index)]
    (frontend/analyze-project-source source surface? dependency-packet)))

(defn- check-project-module [modules [:list [:ref :native.project/source]] index :i64]
  :i64
  (arena-scope
    (let [module (typed-list-nth [:list [:ref :native.project/source]] modules index)
          namespace (record-get [:ref :native.project/source] module :namespace)
          result (analyze-project-module modules index)]
      (if (record-get [:ref :ana/ir] result :ok)
        0
        (do
          (typed-cap-call :io/write-error :string :string
                          (string-concat "kotoba: "
                                         (string-concat namespace
                                           (string-concat ": "
                                             (string-concat (error-message result) "\n")))))
          65)))))

(defn- compare-analysis-results
  [left-label :string left [:ref :ana/ir]
   right-label :string right [:ref :ana/ir]] :i64
  (cond
    (not (record-get [:ref :ana/ir] left :ok))
    (do
      (typed-cap-call :io/write-error :string :string
                      (string-concat "kotoba: "
                        (string-concat left-label
                          (string-concat " semantic error: "
                            (string-concat (error-message left) "\n")))))
      65)

    (not (record-get [:ref :ana/ir] right :ok))
    (do
      (typed-cap-call :io/write-error :string :string
                      (string-concat "kotoba: "
                        (string-concat right-label
                          (string-concat " semantic error: "
                            (string-concat (error-message right) "\n")))))
      65)

    (form/eq (record-get [:ref :ana/ir] left :val)
             (record-get [:ref :ana/ir] right :val))
    (do
      (typed-cap-call :io/write :string :string
                      "semantic equivalent: HIR equal (.cljk -> .kotoba)\n")
      0)

    :else
    (do
      (typed-cap-call :io/write-error :string :string
                      "kotoba: semantic mismatch: HIR differs after .cljk lowering\n")
      65)))

(defn- compare-project-modules
  [left [:list [:ref :native.project/source]]
   right [:list [:ref :native.project/source]]] :i64
  (let [left-count (vector-count left)
        right-count (vector-count right)]
    (if (or (= left-count 0) (= right-count 0))
      (do
        (typed-cap-call :io/write-error :string :string
                        "kotoba: compared project has no entry module\n")
        65)
      (let [left-index (- left-count 1)
            right-index (- right-count 1)
            left-result (analyze-project-module left left-index)
            right-result (analyze-project-module right right-index)]
        (compare-analysis-results ".cljk" left-result ".kotoba" right-result)))))

(defn- compare-cljk-kotoba [cljk-path :string kotoba-path :string roots :string]
  :i64
  (arena-scope
    (let [cljk-graph (project-files/resolve-project cljk-path roots)
          cljk-error (record-get [:ref :native.project/graph] cljk-graph :err)]
      (if (not (string=? cljk-error ""))
        (do
          (typed-cap-call :io/write-error :string :string
                          (string-concat "kotoba: .cljk project graph: "
                                         (string-concat cljk-error "\n")))
          65)
        (let [kotoba-graph (project-files/resolve-project kotoba-path roots)
              kotoba-error (record-get [:ref :native.project/graph] kotoba-graph :err)]
          (if (not (string=? kotoba-error ""))
            (do
              (typed-cap-call :io/write-error :string :string
                              (string-concat "kotoba: .kotoba project graph: "
                                             (string-concat kotoba-error "\n")))
              65)
            (compare-project-modules
             (record-get [:ref :native.project/graph] cljk-graph :modules)
             (record-get [:ref :native.project/graph] kotoba-graph :modules))))))))

(defn- check-project-modules [modules [:list [:ref :native.project/source]]
                              index :i64 count :i64] :i64
  (if (>= index count)
    (do
      (typed-cap-call :io/write :string :string
                      (string-concat "semantic ok: modules="
                                     (string-concat (string-from-i64 count)
                                                    "\n")))
      0)
    (let [status (check-project-module modules index)]
      (if (= status 0)
        (check-project-modules modules (+ index 1) count)
        status))))

(defn- check-project [path :string roots :string] :i64
  (check-project-mode path roots "" "" false))

(defn- check-project-entry [path :string roots :string] :i64
  (check-project-mode path roots "" "" true))

(defn- check-project-mode [path :string roots :string lock :string blocks :string
                           entry-only? :bool] :i64
  (let [graph (if (string=? lock "")
                (project-files/resolve-project path roots)
                (project-files/resolve-locked-project lock blocks))
        graph-error (record-get [:ref :native.project/graph] graph :err)]
    (if (not (string=? graph-error ""))
      (do
        (typed-cap-call :io/write-error :string :string
                        (string-concat "kotoba: " (string-concat graph-error "\n")))
        65)
      (let [modules (record-get [:ref :native.project/graph] graph :modules)
            count (vector-count modules)]
        (if (= count 0)
          (do
            (typed-cap-call :io/write-error :string :string
                            "kotoba: resolved project has no entry module\n")
            65)
          (if entry-only?
            (let [index (- count 1)
                  module (typed-list-nth [:list [:ref :native.project/source]] modules index)
                  namespace (record-get [:ref :native.project/source] module :namespace)
                  status (check-project-module modules index)]
              (if (= status 0)
                (do
                  (typed-cap-call :io/write :string :string
                                  (string-concat
                                   "semantic ok: entry="
                                   (string-concat namespace
                                     (string-concat " dependency-sources="
                                       (string-concat (string-from-i64 index) "\n")))))
                  0)
                status))
            (check-project-modules modules 0 count)))))))

(defn- write-project-module-names
  [modules [:list [:ref :native.project/source]] index :i64 count :i64] :i64
  (if (>= index count)
    0
    (let [module (typed-list-nth [:list [:ref :native.project/source]] modules index)
          namespace (record-get [:ref :native.project/source] module :namespace)]
      (do
        (typed-cap-call :io/write :string :string
                        (string-concat "module=" (string-concat namespace "\n")))
        (write-project-module-names modules (+ index 1) count)))))

(defn- list-project-modules [path :string roots :string lock :string blocks :string] :i64
  (let [graph (if (string=? lock "")
                (project-files/resolve-project path roots)
                (project-files/resolve-locked-project lock blocks))
        graph-error (record-get [:ref :native.project/graph] graph :err)]
    (if (not (string=? graph-error ""))
      (do
        (typed-cap-call :io/write-error :string :string
                        (string-concat "kotoba: " (string-concat graph-error "\n")))
        65)
      (let [modules (record-get [:ref :native.project/graph] graph :modules)
            count (vector-count modules)]
        (if (= count 0)
          (do
            (typed-cap-call :io/write-error :string :string
                            "kotoba: resolved project has no entry module\n")
            65)
          (do
            (typed-cap-call :io/write :string :string
                            (string-concat "project modules="
                                           (string-concat (string-from-i64 count) "\n")))
            (write-project-module-names modules 0 count)))))))

(defn main [] :i64
  (let [command (typed-cap-call :cli/args :string :string "0")
        first-argument (typed-cap-call :cli/args :string :string "1")
        second-argument (typed-cap-call :cli/args :string :string "2")
        argc-text (typed-cap-call :cli/args :string :string "")
        argc-result (parse-long argc-text)
        argc (option-value-of [:option :i64] argc-result 0)
        compare-mode? (string=? command "compare-hir")
        entry-path? (and (not (string=? first-argument ""))
                         (not (string=? (string-substring first-argument 0 1) "-")))
        path (if entry-path? first-argument "")
        options (collect-source-path-options (if entry-path?
                                               (if compare-mode? 3 2)
                                               1)
                                             argc "" 0 "" "" false)
        options-error (record-get [:ref :native.cli/options] options :err)
        roots (record-get [:ref :native.cli/options] options :roots)
        lock (record-get [:ref :native.cli/options] options :lock)
        blocks (record-get [:ref :native.cli/options] options :blocks)
        unpinned (record-get [:ref :native.cli/options] options :unpinned)
        compare-valid? (and compare-mode?
                            (option-some?-of [:option :i64] argc-result)
                            (>= argc 3)
                            entry-path?
                            (suffix? path ".cljk")
                            (suffix? second-argument ".kotoba"))
        single-valid? (and (or (string=? command "check")
                               (string=? command "check-entry")
                               (string=? command "modules"))
                           (option-some?-of [:option :i64] argc-result)
                           (or (not (string=? lock ""))
                               (and (not (string=? path ""))
                                    (or (suffix? path ".kotoba")
                                        (suffix? path ".cljk")
                                        ;; the resolver discovers and accepts
                                        ;; .cljc entries; the entry guard must
                                        ;; not make that route unreachable
                                        ;; (review T2).
                                        (suffix? path ".cljc")))))]
    (cond
      (not (or compare-valid? single-valid?))
      (do
        (typed-cap-call :io/write-error :string :string
                        "usage: amu-native check|check-entry|modules <source.cljk|source.cljc|source.kotoba> [--module-lock LOCK --blocks DIR | --unpinned [--source-path DIR ...]] | compare-hir <surface.cljk> <core.kotoba> --unpinned [--source-path DIR ...]\n")
        64)

      (not (string=? options-error ""))
      (do
        (typed-cap-call :io/write-error :string :string
                        (string-concat "kotoba: " (string-concat options-error "\n")))
        64)

      (and compare-mode? (or (not (string=? lock ""))
                             (not (string=? blocks ""))))
      (do
        (typed-cap-call :io/write-error :string :string
                        "kotoba: compare-hir uses --unpinned source-path resolution, not --module-lock\n")
        64)

      (and (not (string=? blocks "")) (string=? lock ""))
      (do
        (typed-cap-call :io/write-error :string :string
                        "kotoba: --blocks requires --module-lock\n")
        64)

      (and (not (string=? lock "")) (string=? blocks ""))
      (do
        (typed-cap-call :io/write-error :string :string
                        "kotoba: --module-lock requires --blocks <dir>\n")
        64)

      (and (string=? lock "") (not unpinned))
      (do
        (typed-cap-call :io/write-error :string :string
                        "kotoba: path-based project resolution requires --unpinned\n")
        64)

      compare-mode?
      (compare-cljk-kotoba path second-argument roots)

      (string=? command "check-entry")
      (check-project-mode path roots lock blocks true)

      (string=? command "modules")
      (list-project-modules path roots lock blocks)

      :else
      (check-project-mode path roots lock blocks false))))
