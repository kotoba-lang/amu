(ns kotoba.compiler.posix-path
  "Public POSIX path module; its implementation lives in Kotoba core."
  {:kotoba/export [basename dirname join normalize]}
  (:require [kotoba.compiler.posix-path-core :as posix-core]))

(defn basename [p :string] :string
  (posix-core/basename p))

(defn dirname [p :string] :string
  (posix-core/dirname p))

(defn join [a :string b :string] :string
  (posix-core/join a b))

(defn normalize [p :string] :string
  (posix-core/normalize p))
