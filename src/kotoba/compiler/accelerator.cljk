(ns kotoba.compiler.accelerator
  "Typed, bounded accelerator KIR and deterministic WGSL/CUDA/MSL/GLSL
  lowering."
  {:kotoba/export [artifact-format compile-kernel dtypes ewise-operators kernel kernel-variants kir-format lower max-static-elements max-workgroup-size reduction-operators targets validate! validation-errors verify-artifact!]}
  (:require [kotoba.artifact.core :as artifact]
            [kotoba.compiler.accelerator-kir :as kir]
            [kotoba.compiler.accelerator-subgroup-reduce :as subgroup-reduce]))

;; The KIR model and its validation live in the leaf
;; kotoba.compiler.accelerator-kir so the Vulkan/GLSL arm can validate and
;; emit without requiring this namespace back (a require cycle); the ADR-0002
;; surface keeps answering the same names from here.
(def kir-format kir/kir-format)
(def dtypes kir/dtypes)
(def ewise-operators kir/ewise-operators)
(def reduction-operators kir/reduction-operators)
(def max-workgroup-size kir/max-workgroup-size)
(def max-static-elements kir/max-static-elements)
(def kernel kir/kernel)
(def validation-errors kir/validation-errors)
(def validate! kir/validate!)

(def artifact-format :kotoba.gpu-artifact/v1)
(def targets
  "The emission targets this compiler admits (ADR-0002 as amended by
  ADR-0359 decision 1): three shading languages plus :glsl-v1, the GLSL 450
  compute arm the Vulkan wire-42 path compiles. A target is a SOURCE text
  contract; the SPIR-V compilation is a separate sealed build step."
  #{:wgsl-v1 :cuda-v1 :msl-v1 :glsl-v1})
(def kernel-variants
  "The emitted-code variants this compiler admits. :baseline is the ADR-0002
  v1 emission, byte-identical before and after variants existed;
  :warp-shuffle-reduce is the NVIDIA reduction variant (ADR-0356), UNMEASURED
  and with no execution path -- the runtime :gpu/compute (wire 42) runs
  Vulkan only. :subgroup-reduce is the Vulkan/GLSL reduction variant
  (ADR-0356's Intel row; ADR-0357's ARM row reuses it), emitted by
  kotoba.compiler.accelerator-subgroup-reduce and UNMEASURED as an
  optimization claim -- its emission has executed on Apple M1 Max hardware
  through wire 42 (a TOOLCHAIN fact of what compiles and runs, not
  optimization evidence). A variant is a different grouping of the same
  admitted reduction, never a different meaning. Admission is per target: a
  variant the target's emitter does not admit is refused, never silently
  answered as :baseline."
  #{:baseline :warp-shuffle-reduce :subgroup-reduce})

(def ^:private expression
  {:add ["x[i] + y[i]" "x[i] + y[i]"] :sub ["x[i] - y[i]" "x[i] - y[i]"]
   :mul ["x[i] * y[i]" "x[i] * y[i]"] :div ["x[i] / y[i]" "x[i] / y[i]"]})

(def ^:private glsl-identity
  ;; The padded lanes (i >= n) fold the identity. For extrema the identity
  ;; must be the INFINITE neutral: a finite bound is corrupted by an input
  ;; that legitimately contains +Inf (:min) or -Inf (:max). GLSL has no
  ;; infinity literal; uintBitsToFloat of the IEEE-754 sign/exponent bits is
  ;; exact. These are kotoba.compiler.accelerator-subgroup-reduce's values:
  ;; one GLSL arm, one meaning per operator, across both variants.
  {:sum "0.0"
   :max "uintBitsToFloat(0xFF800000u)"
   :min "uintBitsToFloat(0x7F800000u)"})

(def ^:private glsl-combine
  {:sum "a+b" :max "max(a,b)" :min "min(a,b)"})

(defn- emit-wgsl [kir]
  (let [wg (:kernel/workgroup-size kir) op (:kernel/op kir) operator (:kernel/operator kir)]
    (case op
      :ewise
      (str "struct N { value: u32 };\n@group(0) @binding(0) var<storage,read> x: array<f32>;\n"
           "@group(0) @binding(1) var<storage,read> y: array<f32>;\n"
           "@group(0) @binding(2) var<storage,read_write> z: array<f32>;\n"
           "@group(0) @binding(3) var<uniform> n: N;\n"
           "@compute @workgroup_size(" wg ") fn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n"
           "  let i=gid.x; if(i<n.value){ z[i]=" (first (expression operator)) "; }\n}\n")
      :reduce
      (let [identity ({:sum "0.0" :max "-3.402823466e+38" :min "3.402823466e+38"} operator)
            combine ({:sum "a+b" :max "max(a,b)" :min "min(a,b)"} operator)]
        (str "struct N { value: u32 };\n@group(0) @binding(0) var<storage,read> x: array<f32>;\n"
             "@group(0) @binding(1) var<storage,read_write> parts: array<f32>;\n"
             "@group(0) @binding(2) var<uniform> n: N;\nvar<workgroup> scratch: array<f32," wg ">;\n"
             "fn combine(a:f32,b:f32)->f32{return " combine ";}\n"
             "@compute @workgroup_size(" wg ") fn main(@builtin(global_invocation_id) gid:vec3<u32>,"
             "@builtin(local_invocation_id) lid:vec3<u32>,@builtin(workgroup_id) wid:vec3<u32>){\n"
             " let i=gid.x; scratch[lid.x]=select(" identity ",x[i],i<n.value); workgroupBarrier();\n"
             " var stride:u32=" (/ wg 2) "u; loop { if(stride==0u){break;} if(lid.x<stride){scratch[lid.x]=combine(scratch[lid.x],scratch[lid.x+stride]);} workgroupBarrier(); stride=stride/2u;}\n"
             " if(lid.x==0u){parts[wid.x]=scratch[0];}\n}\n")))))

(defn- emit-cuda-shuffle-reduce [kir]
  ;; ADR-0356: NVIDIA warp-shuffle reduction. UNMEASURED -- this emitter has
  ;; no execution path (wire 42 runs Vulkan only) and nothing here has run on
  ;; NVIDIA hardware. Assumes a full-warp launch (workgroup-size >= 32, the
  ;; only shape `select-variant` answers this variant for); every warp is
  ;; then full and the 0xffffffff masks are honest. sm_70+ for
  ;; __shfl_down_sync. The reduction groups the same elements as the
  ;; :baseline tree, in a different order -- f32 :sum may differ in the low
  ;; bits across variants; :max/:min are order-independent.
  (let [operator (:kernel/operator kir) name (:kernel/name kir)
        identity ({:sum "0.0f" :max "-3.402823466e+38f" :min "3.402823466e+38f"} operator)
        combine ({:sum "a+b" :max "fmaxf(a,b)" :min "fminf(a,b)"} operator)]
    (str "__device__ float combine(float a,float b){return " combine ";}\n"
         "extern \"C\" __global__ void " name "(const float* x,float* parts,unsigned int n){\n"
         " extern __shared__ float s[]; unsigned int i=blockIdx.x*blockDim.x+threadIdx.x; unsigned int l=threadIdx.x; unsigned int lane=l%32, warp=l/32;\n"
         " float v=i<n?x[i]:" identity ";\n"
         " for(unsigned int d=16;d>0;d>>=1){v=combine(v,__shfl_down_sync(0xffffffffu,v,d,32));}\n"
         " if(lane==0)s[warp]=v; __syncthreads();\n"
         " unsigned int warps=blockDim.x/32;\n"
         " if(warp==0){float a=lane<warps?s[lane]:" identity ";\n"
         "  for(unsigned int d=warps/2;d>0;d>>=1){a=combine(a,__shfl_down_sync(0xffffffffu,a,d,warps));}\n"
         "  if(lane==0)parts[blockIdx.x]=a;}\n}\n")))

(defn- emit-cuda [kir variant]
  (let [op (:kernel/op kir) operator (:kernel/operator kir) name (:kernel/name kir)]
    (when (and (= :warp-shuffle-reduce variant)
               (not (and (= :reduce op)
                         (let [wg (:kernel/workgroup-size kir)]
                           (and (int? wg) (>= wg 32))))))
      (throw (ex-info "kernel variant not applicable"
                      {:variant variant :op op :workgroup-size (:kernel/workgroup-size kir)})))
    (when-not (contains? #{:baseline :warp-shuffle-reduce} variant)
      ;; :subgroup-reduce is the Vulkan/GLSL arm; the CUDA emitter does not
      ;; admit it. Rule 3: a variant the target's emitter does not admit is
      ;; refused here, never silently answered as :baseline.
      (throw (ex-info "kernel variant not applicable" {:variant variant :target :cuda-v1})))
    (case op
      :ewise
      (str "extern \"C\" __global__ void " name "(const float* x,const float* y,float* z,unsigned int n){\n"
           " unsigned int i=blockIdx.x*blockDim.x+threadIdx.x; if(i<n) z[i]=" (second (expression operator)) ";\n}\n")
      :reduce
      (if (= :warp-shuffle-reduce variant)
        (emit-cuda-shuffle-reduce kir)
        (let [identity ({:sum "0.0f" :max "-3.402823466e+38f" :min "3.402823466e+38f"} operator)
              combine ({:sum "a+b" :max "fmaxf(a,b)" :min "fminf(a,b)"} operator)]
          (str "extern \"C\" __global__ void " name "(const float* x,float* parts,unsigned int n){\n"
               " extern __shared__ float s[]; unsigned int i=blockIdx.x*blockDim.x+threadIdx.x; unsigned int l=threadIdx.x;\n"
               " s[l]=i<n?x[i]:" identity "; __syncthreads();\n"
               " for(unsigned int d=blockDim.x/2;d>0;d>>=1){if(l<d){float a=s[l],b=s[l+d];s[l]=" combine ";}__syncthreads();}\n"
               " if(l==0)parts[blockIdx.x]=s[0];\n}\n"))))))

(defn- emit-msl [kir]
  (let [op (:kernel/op kir) operator (:kernel/operator kir) name (:kernel/name kir)]
    (case op
      :ewise
      (str "#include <metal_stdlib>\nusing namespace metal;\n"
           "kernel void " name "(device const float* x [[buffer(0)]],device const float* y [[buffer(1)]],"
           "device float* z [[buffer(2)]],constant uint& n [[buffer(3)]],uint i [[thread_position_in_grid]]){\n"
           " if(i<n) z[i]=" (second (expression operator)) ";\n}\n")
      :reduce
      (let [identity ({:sum "0.0f" :max "-3.402823466e+38f" :min "3.402823466e+38f"} operator)
            combine ({:sum "a+b" :max "max(a,b)" :min "min(a,b)"} operator)]
        (str "#include <metal_stdlib>\nusing namespace metal;\n"
             "kernel void " name "(device const float* x [[buffer(0)]],device float* parts [[buffer(1)]],"
             "constant uint& n [[buffer(2)]],threadgroup float* s [[threadgroup(0)]],"
             "uint i [[thread_position_in_grid]],uint l [[thread_index_in_threadgroup]],"
             "uint g [[threadgroup_position_in_grid]],uint width [[threads_per_threadgroup]]){\n"
             " s[l]=i<n?x[i]:" identity "; threadgroup_barrier(mem_flags::mem_threadgroup);\n"
             " for(uint d=width/2;d>0;d>>=1){if(l<d){float a=s[l],b=s[l+d];s[l]=" combine ";}threadgroup_barrier(mem_flags::mem_threadgroup);}\n"
             " if(l==0)parts[g]=s[0];\n}\n")))))

(defn- emit-glsl-baseline
  "The :glsl-v1 :baseline emission: GLSL 450 compute over the ADR-0002
  baseline shapes (elementwise and the workgroup tree reduction) for the
  Vulkan arm. UNMEASURED as an optimization claim -- this is the portable
  baseline, byte-identical before and after any variant existed. ABI: the
  wire-42 (:gpu/compute) path binds storage buffers only
  (tools/kexe_gpu_vulkan.c), so `n` rides a read-only storage buffer exactly
  where the WGSL arm uses a uniform -- the same choice
  kotoba.compiler.accelerator-subgroup-reduce/emit-glsl made for the same
  reason -- and the reduce bindings (x 0, parts 1, n 2) are emit-glsl's, so
  both variants of one reduction bind the same buffers. Entry point is
  `main` (the wire-42 PIPELINE op enters \"main\"); :kernel/name does not
  appear, as in the WGSL arm. The extrema identities are the INFINITE
  neutrals shared with emit-glsl (see glsl-identity): one GLSL arm, one
  meaning per operator."
  [kir]
  (let [wg (:kernel/workgroup-size kir) op (:kernel/op kir) operator (:kernel/operator kir)]
    (case op
      :ewise
      (str "#version 450\n"
           "layout(local_size_x = " wg ") in;\n"
           "layout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\n"
           "layout(set = 0, binding = 1, std430) readonly buffer Y { float y[]; };\n"
           "layout(set = 0, binding = 2, std430) writeonly buffer Z { float z[]; };\n"
           "layout(set = 0, binding = 3, std430) readonly buffer N { uint n; };\n"
           "void main() {\n"
           "  uint i = gl_GlobalInvocationID.x;\n"
           "  if (i < n) { z[i] = " (first (expression operator)) "; }\n"
           "}\n")
      :reduce
      (let [identity (glsl-identity operator)
            combine (glsl-combine operator)]
        (str "#version 450\n"
             "layout(local_size_x = " wg ") in;\n"
             "layout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\n"
             "layout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };\n"
             "layout(set = 0, binding = 2, std430) readonly buffer N { uint n; };\n"
             "shared float scratch[" wg "];\n"
             "float combine(float a, float b) { return " combine "; }\n"
             "void main() {\n"
             "  uint i = gl_GlobalInvocationID.x;\n"
             "  uint lid = gl_LocalInvocationID.x;\n"
             "  scratch[lid] = i < n ? x[i] : " identity ";\n"
             "  barrier();\n"
             "  for (uint d = " (/ wg 2) "u; d > 0u; d >>= 1u) {\n"
             "    if (lid < d) { scratch[lid] = combine(scratch[lid], scratch[lid + d]); }\n"
             "    barrier();\n"
             "  }\n"
             "  if (lid == 0u) { parts[gl_WorkGroupID.x] = scratch[0]; }\n"
             "}\n")))))

(defn lower
  "Lower one validated KIR to `target`'s source text. `variant` defaults to
  :baseline, the byte-identical ADR-0002 emission. A non-baseline variant is
  admitted only where it computes the same admitted reduction; elsewhere
  this refuses rather than silently answering baseline."
  ([kir target] (lower kir target :baseline))
  ([kir target variant]
   (validate! kir)
   (when-not (targets target)
     (throw (ex-info "unsupported accelerator target" {:target target :supported targets})))
   (when-not (kernel-variants variant)
     (throw (ex-info "unsupported kernel variant" {:variant variant :supported kernel-variants})))
   (case target
     :wgsl-v1 (do (when-not (= :baseline variant)
                    (throw (ex-info "kernel variant not applicable" {:variant variant :target target})))
                  (emit-wgsl kir))
     :msl-v1 (do (when-not (= :baseline variant)
                   (throw (ex-info "kernel variant not applicable" {:variant variant :target target})))
                 (emit-msl kir))
     :cuda-v1 (emit-cuda kir variant)
     :glsl-v1 (case variant
                :baseline (emit-glsl-baseline kir)
                :subgroup-reduce (subgroup-reduce/emit-glsl kir)
                (throw (ex-info "kernel variant not applicable" {:variant variant :target target}))))))

(defn compile-kernel
  ([kir target] (compile-kernel kir target :baseline))
  ([kir target variant]
   (let [code (lower kir target variant)
         payload {:format artifact-format :target target :kir kir
                  :kir-sha256 (artifact/sha256 kir) :code code
                  :code-sha256 (artifact/sha256 code) :variant variant
                  :limits {:max-elements max-static-elements
                           :workgroup-size (:kernel/workgroup-size kir)}}]
     (artifact/seal payload))))

(defn verify-artifact! [compiled]
  (when-not (and (= artifact-format (:format compiled)) (artifact/valid-seal? compiled)
                 (targets (:target compiled)))
    (throw (ex-info "invalid accelerator artifact envelope" {})))
  (validate! (:kir compiled))
  ;; A sealed artifact that predates variants carries no :variant; that is
  ;; :baseline by definition, and re-lowering must still match exactly.
  (let [variant (if (contains? compiled :variant) (:variant compiled) :baseline)
        _ (when-not (contains? kernel-variants variant)
            ;; One concept, one refusal phrase: `lower` refuses an unknown
            ;; variant as "unsupported kernel variant", and the artifact
            ;; verifier refuses an unknown :variant label with the same
            ;; vocabulary plus its own context (test pin:
            ;; variant-artifacts-seal-and-verify). The vocabulary is
            ;; `kernel-variants` itself (ADR-0359 decision 1): the verifier
            ;; and `lower`'s admission converge on the same set.
            (throw (ex-info "accelerator artifact carries an unsupported kernel variant"
                            {:variant variant})))
        expected-code (lower (:kir compiled) (:target compiled) variant)]
    (when-not (and (= (:kir-sha256 compiled) (artifact/sha256 (:kir compiled)))
                   (= (:code-sha256 compiled) (artifact/sha256 expected-code))
                   (= (:code compiled) expected-code))
      (throw (ex-info "accelerator artifact regeneration mismatch" {}))))
  compiled)
