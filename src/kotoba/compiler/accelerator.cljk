(defn- emit-cuda-shuffle-reduce [kir]
  ;; ADR-0356: NVIDIA warp-shuffle reduction. UNMEASURED -- this emitter has
  ;; no execution path (wire 42 runs Vulkan only) and nothing here has run on
  ;; NVIDIA hardware. Assumes a full-warp launch (workgroup-size >= 32, the
  ;; only shape `select-variant` answers this variant for); every warp is
  ;; then full and the 0xffffffff masks are honest. sm_70+ for
  ;; __shfl_down_sync. The reduction groups the same elements as the
  ;; :baseline tree, in a different order -- f32 :sum may differ in the low
  ;; bits across variants; :max/:min are order-independent.
  (let [operator (:kernel/operator kir) name (:kernel/name kir)
        identity (cuda-identity operator)
        combine ({:sum "a+b" :max "fmaxf(a,b)" :min "fminf(a,b)"} operator)]
    (str "__device__ float combine(float a,float b){return " combine ";}\n"
         "extern \"C\" __global__ void " name "(const float* x,float* parts,unsigned int n){\n"
         " extern __shared__ float s[]; unsigned int i=blockIdx.x*blockDim.x+threadIdx.x; unsigned int l=threadIdx.x; unsigned int lane=l%32, warp=l/32;\n"
         " float v=i<n?x[i]:" identity ";\n"
         " for(unsigned int d=16;d>0;d>>=1){v=combine(v,__shfl_down_sync(0xffffffffu,v,d,32));}\n"
         " if(lane==0)s[warp]=v; __syncthreads();\n"
         " unsigned int warps=blockDim.x/32;\n"
         " if(warp==0){float a=lane<warps?s[lane]:" identity ";\n"
         "  for(unsigned int d=warps/2;d>0;d>>=1){a=combine(a,__shfl_down_sync(0xffffffffu,a,d,warps));}\n"
         "  if(lane==0)parts[blockIdx.x]=a;}\n}\n"))))
#?(:kotoba
   (defn- emit-cuda [kir :document variant :keyword] :string
     (let [op (dgk kir :kernel/op)
           operator (dgk kir :kernel/operator)
           name (option-value-of [:option :string] (document-string-value (dgk kir :kernel/name)) "")
           wg (option-value-of [:option :i64] (document-i64-value (dgk kir :kernel/workgroup-size)) 256)]
       (if (not (or (document-equal? (document-keyword variant) (document-keyword :baseline))
                    (document-equal? (document-keyword variant) (document-keyword :warp-shuffle-reduce))))
         ;; :subgroup-reduce has its own CUDA arm (subgroup-reduce's
         ;; emit-cuda, routed by `lower`); this emitter answers :baseline
         ;; and :warp-shuffle-reduce only. Rule 3's fail-closed contract is
         ;; unchanged: a variant this emitter does not carry is refused
         ;; here, never silently answered as :baseline.
         (throw (ex-info "kernel variant not applicable" {:variant variant :target :cuda-v1}))
       (if (document-equal? (document-keyword variant) (document-keyword :warp-shuffle-reduce))
         (if (and (document-equal? op (document-keyword :reduce)) (and (= (document-kind (dgk kir :kernel/workgroup-size)) :i64) (<= 32 wg)))
           (emit-cuda-shuffle-reduce kir)
           (throw (ex-info "kernel variant not applicable" {:variant variant :op op :workgroup-size (dgk kir :kernel/workgroup-size)})))
         (if (document-equal? op (document-keyword :ewise))
           (let [s1 (string-concat (string-concat "extern \"C\" __global__ void " name) "(const float* x,const float* y,float* z,unsigned int n){\n")
                 s2 (string-concat s1 " unsigned int i=blockIdx.x*blockDim.x+threadIdx.x; if(i<n) z[i]=")]
             (string-concat s2 (string-concat (expr-second operator) "; }\n}\n")))
           (let [identity (cuda-identity operator)
                 combine (cuda-combine operator)
                 s1 (string-concat (string-concat "extern \"C\" __global__ void " name) "(const float* x,float* parts,unsigned int n){\n")
                 s2 (string-concat s1 " extern __shared__ float s[]; unsigned int i=blockIdx.x*blockDim.x+threadIdx.x; unsigned int l=threadIdx.x;\n")
                 s3 (string-concat s2 (string-concat " s[l]=i<n?x[i]:" (string-concat identity "; __syncthreads();\n")))
                 s4 (string-concat s3 (string-concat " for(unsigned int d=blockDim.x/2;d>0;d>>=1){if(l<d){float a=s[l],b=s[l+d];s[l]=" (string-concat combine ";}__syncthreads();}\n")))]
             (string-concat s4 " if(l==0)parts[blockIdx.x]=s[0];}\n")))))))
