                                 (string-concat (string-concat "kernel void " name) "(device const float* x [[buffer(0)]],device const float* y [[buffer(1)]],"))
               s2 (string-concat s1 "device float* z [[buffer(2)]],constant uint& n [[buffer(3)]],uint i [[thread_position_in_grid]]){\n")]
           (string-concat s2 (string-concat " if(i<n) z[i]=" (string-concat (expr-second operator) ";}\n"))))
         (let [identity (msl-identity operator)
               combine (msl-combine operator)
               s1 (string-concat "#include <metal_stdlib>\nusing namespace metal;\n"
                                 (string-concat (string-concat "kernel void " name) "(device const float* x [[buffer(0)]],device float* parts [[buffer(1)]],"))
               s2 (string-concat s1 "constant uint& n [[buffer(2)]],threadgroup float* s [[threadgroup(0)]],")
               s3 (string-concat s2 "uint i [[thread_position_in_grid]],uint l [[thread_index_in_threadgroup]],")
               s4 (string-concat s3 "uint g [[threadgroup_position_in_grid]],uint width [[threads_per_threadgroup]]){\n")
               s5 (string-concat s4 (string-concat " s[l]=i<n?x[i]:" (string-concat identity "; threadgroup_barrier(mem_flags::mem_threadgroup);\n")))
               s6 (string-concat s5 (string-concat " for(uint d=width/2;d>0;d>>=1){if(l<d){float a=s[l],b=s[l+d];s[l]=" (string-concat combine ";}threadgroup_barrier(mem_flags::mem_threadgroup);}\n")))]
           (string-concat s6 " if(l==0)parts[g]=s[0];}\n")))))
