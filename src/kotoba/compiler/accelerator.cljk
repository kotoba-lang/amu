(defn- emit-msl [kir]
  (let [op (:kernel/op kir) operator (:kernel/operator kir) name (:kernel/name kir)]
    (case op
      :ewise
      (str "#include <metal_stdlib>\nusing namespace metal;\n"
           "kernel void " name "(device const float* x [[buffer(0)]],device const float* y [[buffer(1)]],"
           "device float* z [[buffer(2)]],constant uint& n [[buffer(3)]],uint i [[thread_position_in_grid]]){\n"
           " if(i<n) z[i]=" (second (expression operator)) ";\n}\n")
      :reduce
      (let [identity (msl-identity operator)
            combine ({:sum "a+b" :max "max(a,b)" :min "min(a,b)"} operator)]
        (str "#include <metal_stdlib>\nusing namespace metal;\n"
             "kernel void " name "(device const float* x [[buffer(0)]],device float* parts [[buffer(1)]],"
             "constant uint& n [[buffer(2)]],threadgroup float* s [[threadgroup(0)]],"
             "uint i [[thread_position_in_grid]],uint l [[thread_index_in_threadgroup]],"
             "uint g [[threadgroup_position_in_grid]],uint width [[threads_per_threadgroup]]){\n"
             " s[l]=i<n?x[i]:" identity "; threadgroup_barrier(mem_flags::mem_threadgroup);\n"
             " for(uint d=width/2;d>0;d>>=1){if(l<d){float a=s[l],b=s[l+d];s[l]=" combine ";}threadgroup_barrier(mem_flags::mem_threadgroup);}\n"
             " if(l==0)parts[g]=s[0];\n}\n"))))))
#?(:kotoba
   (defn- emit-glsl-baseline [kir :document] :string
     (let [wg (option-value-of [:option :i64] (document-i64-value (dgk kir :kernel/workgroup-size)) 256)
           op (dgk kir :kernel/op)
           operator (dgk kir :kernel/operator)]
       (if (document-equal? op (document-keyword :ewise))
         (let [s1 (string-concat "#version 450\n" (string-concat (string-concat "layout(local_size_x = " (string-from-i64 wg)) ") in;\n"))
               s2 (string-concat s1 "layout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\nlayout(set = 0, binding = 1, std430) readonly buffer Y { float y[]; };\n")
               s3 (string-concat s2 "layout(set = 0, binding = 2, std430) writeonly buffer Z { float z[]; };\nlayout(set = 0, binding = 3, std430) readonly buffer N { uint n; };\n")
               s4 (string-concat s3 "void main() {\n  uint i = gl_GlobalInvocationID.x;\n  if (i < n) { z[i] = ")]
           (string-concat s4 (string-concat (expr-first operator) "; }\n}\n")))
         (let [identity (glsl-identity operator)
               combine (glsl-combine operator)
               s1 (string-concat "#version 450\n" (string-concat (string-concat "layout(local_size_x = " (string-from-i64 wg)) ") in;\n"))
               s2 (string-concat s1 "layout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\nlayout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };\n")
               s3 (string-concat s2 "layout(set = 0, binding = 2, std430) readonly buffer N { uint n; };\n")
               s4 (string-concat s3 (string-concat (string-concat "shared float scratch[" (string-from-i64 wg)) "];\n"))
               s5 (string-concat s4 (string-concat "float combine(float a, float b) { return " (string-concat combine "; }\n")))
               s6 (string-concat s5 "void main() {\n  uint i = gl_GlobalInvocationID.x;\n  uint lid = gl_LocalInvocationID.x;\n  scratch[lid] = i < n ? x[i] : ")
               s7 (string-concat s6 (string-concat identity ";\n  barrier();\n"))
               s8 (string-concat s7 (string-concat (string-concat "  for (uint d = " (string-from-i64 (quot wg 2))) "u; d > 0u; d >>= 1u) {\n"))
               s9 (string-concat s8 "    if (lid < d) { scratch[lid] = combine(scratch[lid], scratch[lid + d]); }\n    barrier();\n  }\n")]
           (string-concat s9 "  if (lid == 0u) { parts[gl_WorkGroupID.x] = scratch[0]; }\n}\n")))))
   :default
(defn- emit-glsl-baseline
  "The :glsl-v1 :baseline emission: GLSL 450 compute over the ADR-0002
  baseline shapes (elementwise and the workgroup tree reduction) for the
  Vulkan arm. UNMEASURED as an optimization claim -- this is the portable
  baseline, byte-identical before and after any variant existed. ABI: the
  wire-42 (:gpu/compute) path binds storage buffers only
  (tools/kexe_gpu_vulkan.c), so `n` rides a read-only storage buffer exactly
  where the WGSL arm uses a uniform -- the same choice
  kotoba.compiler.accelerator-subgroup-reduce/emit-glsl made for the same
  reason -- and the reduce bindings (x 0, parts 1, n 2) are emit-glsl's, so
  both variants of one reduction bind the same buffers. Entry point is
  `main` (the wire-42 PIPELINE op enters \"main\"); :kernel/name does not
  appear, as in the WGSL arm. The extrema identities are the INFINITE
  neutrals shared with emit-glsl (see glsl-identity): one GLSL arm, one
  meaning per operator."
  [kir]
  (let [wg (:kernel/workgroup-size kir) op (:kernel/op kir) operator (:kernel/operator kir)]
    (case op
      :ewise
      (str "#version 450\n"
           "layout(local_size_x = " wg ") in;\n"
           "layout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\n"
           "layout(set = 0, binding = 1, std430) readonly buffer Y { float y[]; };\n"
           "layout(set = 0, binding = 2, std430) writeonly buffer Z { float z[]; };\n"
           "layout(set = 0, binding = 3, std430) readonly buffer N { uint n; };\n"
           "void main() {\n"
           "  uint i = gl_GlobalInvocationID.x;\n"
           "  if (i < n) { z[i] = " (first (expression operator)) "; }\n"
           "}\n")
      :reduce
      (let [identity (glsl-identity operator)
            combine (glsl-combine operator)]
        (str "#version 450\n"
             "layout(local_size_x = " wg ") in;\n"
             "layout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };\n"
             "layout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };\n"
             "layout(set = 0, binding = 2, std430) readonly buffer N { uint n; };\n"
             "shared float scratch[" wg "];\n"
             "float combine(float a, float b) { return " combine "; }\n"
             "void main() {\n"
             "  uint i = gl_GlobalInvocationID.x;\n"
             "  uint lid = gl_LocalInvocationID.x;\n"
             "  scratch[lid] = i < n ? x[i] : " identity ";\n"
             "  barrier();\n"
             "  for (uint d = " (/ wg 2) "u; d > 0u; d >>= 1u) {\n"
             "    if (lid < d) { scratch[lid] = combine(scratch[lid], scratch[lid + d]); }\n"
             "    barrier();\n"
             "  }\n"
             "  if (lid == 0u) { parts[gl_WorkGroupID.x] = scratch[0]; }\n"
             "}\n"))))))
#?(:kotoba
   (defn lower [kir :document target :keyword variant :keyword] :string
     (let [checked (validate! kir)]
       (if (not (in-kset? (targets) (document-keyword target)))
         (throw (ex-info "unsupported accelerator target" {:target target :supported (document-set (document-keyword :wgsl-v1) (document-keyword :cuda-v1) (document-keyword :msl-v1) (document-keyword :glsl-v1))}))
         (if (not (in-kset? (kernel-variants) (document-keyword variant)))
           (throw (ex-info "unsupported kernel variant" {:variant variant :supported (document-set (document-keyword :baseline) (document-keyword :warp-shuffle-reduce) (document-keyword :subgroup-reduce))}))
           (if (document-equal? (document-keyword target) (document-keyword :cuda-v1))
             (if (document-equal? (document-keyword variant) (document-keyword :subgroup-reduce))
               (subgroup-emit-cuda kir)
               (emit-cuda kir variant))
             (if (document-equal? (document-keyword target) (document-keyword :glsl-v1))
               (if (document-equal? (document-keyword variant) (document-keyword :baseline))
                 (emit-glsl-baseline kir)
                 (if (document-equal? (document-keyword variant) (document-keyword :subgroup-reduce))
                   (subgroup-emit-glsl kir)
                   (throw (ex-info "kernel variant not applicable" {:variant variant :target target}))))
               (if (document-equal? (document-keyword target) (document-keyword :wgsl-v1))
                 (if (document-equal? (document-keyword variant) (document-keyword :baseline))
                   (emit-wgsl kir)
                   (if (document-equal? (document-keyword variant) (document-keyword :subgroup-reduce))
                     (subgroup-emit-wgsl kir)
                     (throw (ex-info "kernel variant not applicable" {:variant variant :target target}))))
                 (if (document-equal? (document-keyword variant) (document-keyword :baseline))
                   (emit-msl kir)
                   (if (document-equal? (document-keyword variant) (document-keyword :subgroup-reduce))
                     (subgroup-emit-msl kir)
                     (throw (ex-info "kernel variant not applicable" {:variant variant :target target})))))))))))
   :default
(defn lower
  "Lower one validated KIR to `target`'s source text. `variant` defaults to
  :baseline, the byte-identical ADR-0002 emission. A non-baseline variant is
  admitted only where it computes the same admitted reduction; elsewhere
  this refuses rather than silently answering baseline."
  ([kir target] (lower kir target :baseline))
  ([kir target variant]
   (validate! kir)
   (when-not (targets target)
     (throw (ex-info "unsupported accelerator target" {:target target :supported targets})))
   (when-not (kernel-variants variant)
     (throw (ex-info "unsupported kernel variant" {:variant variant :supported kernel-variants})))
   (case target
     :wgsl-v1 (case variant
                :baseline (emit-wgsl kir)
                :subgroup-reduce (subgroup-reduce/emit-wgsl kir)
                (throw (ex-info "kernel variant not applicable" {:variant variant :target target})))
     :msl-v1 (case variant
               :baseline (emit-msl kir)
               :subgroup-reduce (subgroup-reduce/emit-msl kir)
               (throw (ex-info "kernel variant not applicable" {:variant variant :target target})))
     :cuda-v1 (case variant
               :subgroup-reduce (subgroup-reduce/emit-cuda kir)
               (emit-cuda kir variant))
     :glsl-v1 (case variant
                :baseline (emit-glsl-baseline kir)
                :subgroup-reduce (subgroup-reduce/emit-glsl kir)
                (throw (ex-info "kernel variant not applicable" {:variant variant :target target})))))))
#?(:kotoba
   (defn compile-kernel [kir :document target :keyword variant :keyword] :document
     (let [code (lower kir target variant)
           payload (document-map (document-keyword :format) (document-keyword :kotoba.gpu-artifact/v1)
                                 (document-keyword :target) (document-keyword target)
                                 (document-keyword :kir) kir
                                 (document-keyword :kir-sha256) (document-string (artifact-sha256 kir))
                                 (document-keyword :code) (document-string code)
                                 (document-keyword :code-sha256) (document-string (artifact-sha256 (document-string code)))
                                 (document-keyword :variant) (document-keyword variant)
                                 (document-keyword :limits)
                                 (document-map (document-keyword :max-elements) (document-i64 1073741824)
                                               (document-keyword :workgroup-size) (dgk kir :kernel/workgroup-size)))]
       (artifact-seal payload)))
   :default
(defn compile-kernel
  ([kir target] (compile-kernel kir target :baseline))
  ([kir target variant]
   (let [code (lower kir target variant)
         payload {:format artifact-format :target target :kir kir
                  :kir-sha256 (artifact/sha256 kir) :code code
                  :code-sha256 (artifact/sha256 code) :variant variant
                  :limits {:max-elements max-static-elements
                           :workgroup-size (:kernel/workgroup-size kir)}}]
     (artifact/seal payload)))))
#?(:kotoba
   (defn verify-artifact! [compiled :document] :document
     (if (not (and (document-equal? (dgk compiled :format) (document-keyword :kotoba.gpu-artifact/v1))
                   (artifact-valid-seal? compiled)
                   (in-kset? (targets) (dgk compiled :target))))
       (throw (ex-info "invalid accelerator artifact envelope" {}))
       (let [checked (validate! (dgk compiled :kir))
             variant (if (document-contains compiled (document-keyword :variant)) (dgk compiled :variant) (document-keyword :baseline))]
         (if (not (or (document-equal? variant (document-keyword :baseline))
                      (document-equal? variant (document-keyword :warp-shuffle-reduce))
                      (document-equal? variant (document-keyword :subgroup-reduce))))
           (throw (ex-info "accelerator artifact carries an unsupported kernel variant" {:variant variant}))
           (let [expected-code (lower (dgk compiled :kir) (option-value-of [:option :keyword] (document-keyword-value (dgk compiled :target)) :wgsl-v1) (option-value-of [:option :keyword] (document-keyword-value variant) :baseline))]
             (if (not (and (document-equal? (dgk compiled :kir-sha256) (document-string (artifact-sha256 (dgk compiled :kir))))
                           (document-equal? (dgk compiled :code-sha256) (document-string (artifact-sha256 (document-string expected-code))))
                           (document-equal? (dgk compiled :code) (document-string expected-code))))
               (throw (ex-info "accelerator artifact regeneration mismatch" {}))
               compiled))))))
   :default
(defn verify-artifact! [compiled]
  (when-not (and (= artifact-format (:format compiled)) (artifact/valid-seal? compiled)
                 (targets (:target compiled)))
    (throw (ex-info "invalid accelerator artifact envelope" {})))
  (validate! (:kir compiled))
  ;; A sealed artifact that predates variants carries no :variant; that is
  ;; :baseline by definition, and re-lowering must still match exactly.
  (let [variant (if (contains? compiled :variant) (:variant compiled) :baseline)
        _ (when-not (contains? #{:baseline :warp-shuffle-reduce :subgroup-reduce} variant)
            (throw (ex-info "accelerator artifact carries an unsupported kernel variant"
                            {:variant variant})))
        expected-code (lower (:kir compiled) (:target compiled) variant)]
    (when-not (and (= (:kir-sha256 compiled) (artifact/sha256 (:kir compiled)))
                   (= (:code-sha256 compiled) (artifact/sha256 expected-code))
                   (= (:code compiled) expected-code))
      (throw (ex-info "accelerator artifact regeneration mismatch" {}))))
  compiled))
