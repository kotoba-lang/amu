(ns kotoba.compiler.runner-entry
  "Route B (supervisor + OP-CAP) entry for the C-free x86-64 seed runner
  (Linear JUN-29, entry slice of the kernel-profile work shared with
  JUN-30/JUN-31). `runner-slice` decides and seals; `runner-bookkeeping`
  hashes; `runner-seed` wires the phase order. THIS namespace implements
  the entry itself as the pinned Route B decision made it: the supervisor
  calls guest `main` under the measured `:sysv-ctx-v11` discipline, guest
  services ride `OP-CAP` vtable dispatch at 29 B per 2-arg cap call, and
  SIR admission runs the pinned profile-2 set with the capability wires
  `#{35 37 38 39}`.

  WHY ROUTE B (measured 2026-10-20,
  docs/native-seed-c-free-runner-entry-route-20261020.md, independent
  llvm-objdump decode of `docs/evidence/entry_route_encoding_probe-20261020.py`
  blob sha256 e419f130...428c2, syscall numbers 437/302/157/317/60
  verified): Route A (a third `xg-start` entry-stub variant) costs a
  >=749 B inline delta per emitted ELF (277 B measured setup-syscall
  sites + >=472 B computed seccomp filter lower bound) plus containment
  logic, emitted into a fixed stub region SIR admission never sees.
  Route B costs 0 new emission constructs: 29 B per 2-arg cap call
  (vtable slot 128 = `typed_cap_call`, ctx reload + r9 restore included),
  admission stays exactly at the pinned profile-2 set, wires
  `#{35 37 38 39}`. The seccomp BPF emission and `openat2`
  `RESOLVE_BENEATH` containment stay in the runner artifact, where they
  are audited once — they are non-goals of the emission slice.

  WHAT THIS IS AND IS NOT. Host-portable pure data + fail-closed
  cross-checking: the same entry contract the compiler-emitted runner
  (vehicle (a)) or the hand-audited raw-ELF runner (vehicle (b)) must
  perform. It claims no x86-64 emission. Nothing here grants a
  capability; it only refuses — a wire outside `#{35 37 38 39}` is
  refused at admission, before any hook runs and before the guest is
  entered.

  THE GUEST CALL. Entry = the runner calls guest `main` under ctx-v11:
  ctx in `r9` for guest calls, `mov rdi,[rbp-8]` reloaded before every
  host dispatch, `r9` reloaded before the guest call and restored after
  every host call (call-abi 20261019, 25 payloads, anomaly 0). The
  guest is called exactly once, and only after admission."
  {:kotoba/export [admission-profile-2 admit! admit-sir! admit-wires!
                   cap-call-site! cap-call-site-bytes cap-call-shape
                   cap-call-vtable-slot call-guest-under-ctx! ctx-v11-plan
                   entry-route profile-2-ops]}
  (:require [kotoba.artifact.core :as artifact]
            [kotoba.verifier :as verifier]))

;; `verifier/guest-integer?`, not `integer?`: on the Node host the reader
;; hands back bigints and cljs `integer?` is false for them (same trap as
;; `runner-slice` / `runner-bookkeeping` / `runner-seed`, measured
;; 2026-09-11).
(defn- an-integer? [x] (verifier/guest-integer? x))

(defn- reject!
  [message data]
  (throw (ex-info message (assoc data :phase :runner-entry))))

;; ── the pinned entry decision (entry-route doc §4) ──────────────────────────

(def entry-route
  "The pinned kernel-profile entry route. `:supervisor-op-cap` (Route B)
  is the decision; `:entry-stub` (Route A) survives only as the
  documented fallback whose single trigger is a MEASURED runner
  construct needing a wire outside `#{35 37 38 39}` — no such
  measurement exists today (wires 20/42/43-47 stay refused)."
  {:format :kotoba.runner-entry-route/v1
   :decision :supervisor-op-cap
   :fallback :entry-stub
   :fallback-trigger :measured-wire-outside-pinned-set
   :guest-emission-delta 0
   :cap-call-site-bytes 29
   :cap-call-vtable-slot 128
   :wires #{35 37 38 39}
   :guest {:entry :main :under :kexe-context-v11 :abi :sysv-ctx-v11}
   :probe {:path "docs/evidence/entry_route_encoding_probe-20261020.py"
           :blob-sha256
           "e419f130221463631ceb79dbfc05fba2246e639ba263238dec3b32eaebb428c2"
           :decoded-syscall-numbers [437 302 157 317 60]}})

;; ── measured OP-CAP dispatch: 29 B per 2-arg cap call (entry-route doc §2) ──

(def cap-call-vtable-slot
  "vtable slot 128 = `typed_cap_call`, reached as `callq *0x80(%rdi)`
  over the ctx-v11 struct (surface doc §1, static-asserted offset 128)."
  128)

(def cap-call-shape
  "The measured 2-arg OP-CAP call site (p4-cap.kx64-v1, wire 35,
  llvm-objdump decode). Byte counts are the measured encoding sizes,
  discipline reloads included. Same shape for the pair vtable slots
  56/64/72 (`callq *0x38/0x40/0x48(%rdi)`); `OP-CALLI` is `jmp rax`;
  the fuel charge site is 18 B."
  [{:mnemonic "movl imm32,%esi" :bytes 5 :role :wire-id}
   {:mnemonic "movl imm32,%edx" :bytes 5 :role :arg1}
   {:mnemonic "movl imm32,%ecx" :bytes 5 :role :arg2}
   {:mnemonic "movq -0x8(%rbp),%rdi" :bytes 4 :role :ctx-reload}
   {:mnemonic "callq *0x80(%rdi)" :bytes 6 :role :vtable-dispatch
    :slot cap-call-vtable-slot}
   {:mnemonic "movq -0x8(%rbp),%r9" :bytes 4 :role :r9-restore}])

(def cap-call-site-bytes
  "29 bytes per 2-arg cap call, measured. A site that does not total
  this is not the measured site."
  29)

(def compiler-command-wires
  "The pinned capability wire set of the compiler command path: exactly
  `#{35 37 38 39}` (`:fs/app-data`, `:io/write`, `:cli/args`,
  `:io/write-error`)."
  #{35 37 38 39})

(defn cap-call-site!
  "Build the cap-call site record for a 2-arg `OP-CAP` dispatch on
  `wire`, refusing anything that is not the measured site: the wire must
  be one of `#{35 37 38 39}`, the shape must total exactly 29 bytes,
  and the dispatch must go through vtable slot 128 with the
  `:sysv-ctx-v11` discipline reloads (ctx reload before the call, r9
  restore after). `shape` defaults to the measured `cap-call-shape` and
  exists so tests (and only tests) can prove the byte-sum check is
  load-bearing.

  FAIL-CLOSED. Nothing is normalised: a 28-byte shape is refused, not
  rounded."
  ([wire] (cap-call-site! wire cap-call-shape))
  ([wire shape]
   (when-not (contains? compiler-command-wires wire)
     (reject! "cap call on a wire outside the pinned set refused"
              {:wire wire :wires (vec (sort compiler-command-wires))}))
   (when-not (and (vector? shape) (every? #(and (map? %)
                                                (an-integer? (:bytes %))
                                                (pos? (:bytes %)))
                                          shape))
     (reject! "cap call shape malformed" {:shape (pr-str shape)}))
   (let [total (apply + (map :bytes shape))
         dispatch (first (filter #(= :vtable-dispatch (:role %)) shape))
         reloads (set (map :role shape))]
     (when-not (= cap-call-site-bytes total)
       (reject! "cap call site is not the measured 29 bytes"
                {:bytes total :expected cap-call-site-bytes}))
     (when-not (= cap-call-vtable-slot (:slot dispatch))
       (reject! "cap call does not dispatch through vtable slot 128"
                {:slot (:slot dispatch) :expected cap-call-vtable-slot}))
     (when-not (and (contains? reloads :ctx-reload)
                    (contains? reloads :r9-restore))
       (reject! "cap call site misses a :sysv-ctx-v11 discipline reload"
                {:roles (vec (sort (map :role shape)))}))
     {:format :kotoba.cap-call-site/v1
      :abi :sysv-ctx-v11
      :wire wire
      :bytes total
      :vtable-slot cap-call-vtable-slot
      :discipline {:ctx-reloaded-before-call true
                   :r9-restored-after-call true}
      :shape shape})))

;; ── admission profile 2: the kernel profile (kernel-profile slice §3) ───────

(def profile-2-ops
  "The pinned profile-2 op set: profile 1's whole table (OP-FN(1) ..
  OP-COUNT(26)) minus `OP-RES2(25)` / `OP-RET2(26)` — no measured runner
  construct needs two-register results today. Profile 0's refusals stay
  load-bearing in profile 0; this set is admitted ONLY under profile 2."
  (set (range 1 25)))

(def admission-profile-2
  "The kernel profile (:aiueos-c-free-bare-metal-v1, ADR 0271) as data.
  A third admission profile — profile 0 is not widened, because the
  G1->G3 fixed-point chain is admitted under exactly profile 0's subset
  and widening it silently would retire the scalar route's proof."
  {:format :kotoba.admission-profile/v1
   :profile 2
   :name :kernel
   :ops profile-2-ops
   :refused-ops #{25 26}
   :fn-kinds #{:FK-DEFN :FK-PRIV :FK-LAMBDA :FK-ADAPTER}
   :adapter-nparams-max 5
   :adapter-immediately-after-lambda true
   :nparams-max 16
   :types {:refused #{:TY-F64 :TY-F32} :positive-integers-only true}
   :operand-checks {:bin-bop (set (range 1 11))
                    :cmp-cc (set (range 1 6))
                    :un #{:UOP-NOT :UOP-BITNOT}
                    :call-nparams-max 16}
   :wires compiler-command-wires
   :walks-unreachable-functions true})

(defn- check-fn!
  "One SIR function against profile 2. Every rule is the pinned bound;
  a function that breaks any of them is refused even if unreachable —
  both admission layers walk ALL SIR (kernel-profile slice §1).
  `prev-kind` is the previous function's kind, for the adapter rule
  (an adapter is ≤ 5 params and sits immediately after its lambda)."
  [f prev-kind]
  (when-not (map? f)
    (reject! "SIR function malformed" {:function (pr-str f)}))
  (let [{:keys [kind nparams params ret ops]} f]
    (when-not (contains? (:fn-kinds admission-profile-2) kind)
      (reject! "function kind refused by profile 2" {:kind kind}))
    (when (and (= :FK-ADAPTER kind)
               (not= :FK-LAMBDA prev-kind))
      (reject! "adapter does not immediately follow its lambda"
               {:kind kind :prev-kind prev-kind}))
    (when-not (and (an-integer? nparams) (<= 0 nparams)
                   (<= nparams (:nparams-max admission-profile-2)))
      (reject! "function nparams outside the profile 2 bound"
               {:nparams nparams :max (:nparams-max admission-profile-2)}))
    (when (and (= :FK-ADAPTER kind)
               (> nparams (:adapter-nparams-max admission-profile-2)))
      (reject! "adapter nparams outside the profile 2 bound"
               {:nparams nparams
                :max (:adapter-nparams-max admission-profile-2)}))
    (doseq [t (concat params [ret])]
      (when-not t
        (reject! "function type missing" {:function (pr-str f)}))
      (when (contains? (get-in admission-profile-2 [:types :refused]) t)
        (reject! "function type refused by profile 2" {:type t}))
      (when (and (an-integer? t) (not (pos? t)))
        (reject! "function type is not a positive type id" {:type t})))
    (when-let [bad (seq (remove (:ops admission-profile-2) ops))]
      (reject! "op refused by profile 2"
               {:ops (vec (sort bad))
                :refused-ops (vec (sort (:refused-ops admission-profile-2)))}))))

(defn admit-sir!
  "Admit a SIR description under profile 2. `sir` is
  `{:functions [{:kind :FK-DEFN :nparams 2 :params [...] :ret ...
  :ops #{...}} ...]}`. Every function is checked — reachable or not.
  Returns `{:admitted? true :profile 2}`; any refusal throws
  `{:phase :runner-entry}`."
  [sir]
  (let [fns (:functions sir)]
    (when-not (and (sequential? fns) (seq fns))
      (reject! "SIR has no functions" {:sir (pr-str sir)}))
    (doseq [[prev f] (map vector (cons nil (butlast fns)) fns)]
      (check-fn! f (:kind prev))))
  {:admitted? true :profile 2})

(defn admit-wires!
  "Admit the capability wire grant. The entry admits EXACTLY the pinned
  compiler command path set `#{35 37 38 39}`: a subset is not the
  measured command path and a superset carries a broker wire
  (20/42/43-47) the command path never grants. Anything else fails
  closed before any hook runs."
  [wires]
  (when-not (= compiler-command-wires (set wires))
    (reject! "capability wires are not the pinned set"
             {:wires (pr-str wires)
              :pinned (vec (sort compiler-command-wires))}))
  {:admitted? true :wires (vec (sort compiler-command-wires))})

(defn admit!
  "The Route B entry's fail-closed admission: SIR under profile 2 and
  the wire grant, together. Returns
  `{:admitted? true :profile 2 :wires [...] :admission-sha256 ...}`
  where the digest seals the decision (profile digest + SIR digest +
  wire set), so a receipt can bind which admission it passed. Any
  refusal throws `{:phase :runner-entry}`; nothing is normalised,
  nothing falls back."
  [{:keys [sir wires]}]
  (admit-sir! sir)
  (admit-wires! wires)
  {:admitted? true
   :profile 2
   :wires (vec (sort compiler-command-wires))
   :admission-sha256
   (artifact/sha256 {:format :kotoba.runner-entry-admission/v1
                     :profile 2
                     :profile-sha256 (artifact/sha256 admission-profile-2)
                     :sir-sha256 (artifact/sha256 sir)
                     :wires (vec (sort compiler-command-wires))})})

;; ── ctx-v11: the supervisor's layout obligation (surface doc §1) ────────────

(def ^:private measured-ctx-offsets
  {:fuel 8 :allow 16 :cap-call 48 :pair-new 56 :pair-first 64
   :pair-second 72 :kgraph-assert 80 :kgraph-get 88 :kgraph-count 96
   :kgraph-entity-at 104 :string-equal 112 :string-concat 120
   :typed-cap-call 128 :string-substring 136})

(def ^:private measured-data-slots
  "ABI v9 data slots written once before the guest starts; v10 adds
  range operations (surface doc §1)."
  [:pair-used-pointer :pairs-base :pair-validated-base
   :vector-used-pointer :vectors-base :vector-items-base])

(defn ctx-v11-plan
  "The ctx-v11 layout the supervisor must produce before the guest is
  entered: 36 function-pointer slots (the measured static-asserted
  offsets, `typed-cap-call` at 128 = the cap-call vtable slot), plus the
  v9 data slots written once before the guest starts.

  Optional `{:keys [offsets data-slots function-pointer-slots]}` exists
  so tests can prove the validation is load-bearing; the defaults are
  the measured values. FAIL-CLOSED: offsets must be distinct positive
  multiples of 8, `:typed-cap-call` must sit at the cap-call slot, and
  the declared function-pointer slot count must be 36."
  ([] (ctx-v11-plan {}))
  ([{:keys [offsets data-slots function-pointer-slots]
     :or {offsets measured-ctx-offsets
          data-slots measured-data-slots
          function-pointer-slots 36}}]
   (let [vals (vals offsets)]
     (when-not (and (map? offsets)
                    (every? an-integer? vals)
                    (every? #(and (pos? %) (zero? (mod % 8))) vals)
                    (= (count vals) (count (set vals))))
       (reject! "ctx-v11 offsets are not distinct positive multiples of 8"
                {:offsets (pr-str offsets)}))
     (when-not (= cap-call-vtable-slot (:typed-cap-call offsets))
       (reject! "ctx-v11 typed-cap-call slot is not the cap-call slot"
                {:slot (:typed-cap-call offsets)
                 :expected cap-call-vtable-slot}))
     (when-not (and (an-integer? function-pointer-slots)
                    (= 36 function-pointer-slots))
       (reject! "ctx-v11 function-pointer slot count is not the measured 36"
                {:function-pointer-slots function-pointer-slots}))
     (when-not (and (vector? data-slots) (every? keyword? data-slots)
                    (= (count data-slots) (count (set data-slots))))
       (reject! "ctx-v11 data slots malformed" {:data-slots (pr-str data-slots)}))
     {:format :kotoba.runner-ctx-plan/v1
      :struct :kexe-context-v11
      :function-pointer-slots function-pointer-slots
      :offsets offsets
      :data-slots data-slots
      :data-slots-written-before-guest true})))

;; ── the guest call (entry-route doc §4) ─────────────────────────────────────

(defn call-guest-under-ctx!
  "The Route B entry: the runner calls guest `main` under ctx-v11, once,
  under the measured `:sysv-ctx-v11` discipline.

  Arguments:
  * `:guest-entry` -- a 1-arg callable of the ctx answering
    `{:status <ok|trap|denied> :output <bytes|{:sha256 ...}>}`. This is
    the guest; it is called exactly once.
  * `:ctx` -- the supervisor-laid-out `:kexe-context-v11` (see
    `ctx-v11-plan`).
  * `:cap-dispatch` -- optional host hook receiving the cap-call site
    records this entry pre-builds for the pinned wires (one 29-byte
    `:sysv-ctx-v11` site per wire). On the host it observes; in the
    emitted runner these are the measured vtable calls.

  FAIL-CLOSED. `guest-entry` must be callable (`fn?` -- a keyword is
  `ifn?` and would be 'called' as the guest), the ctx must be the
  planned struct, and a hook that throws aborts before the guest runs.
  The guest is never entered twice: the call is direct, here."
  [{:keys [guest-entry ctx cap-dispatch]}]
  (when-not (fn? guest-entry)
    (reject! "guest-entry must be callable" {:guest-entry (pr-str guest-entry)}))
  (let [plan (ctx-v11-plan)
        sites (mapv cap-call-site! (sort compiler-command-wires))]
    (when-not (and (map? ctx) (= :kexe-context-v11 (:struct ctx)))
      (reject! "ctx is not the planned :kexe-context-v11"
               {:ctx (pr-str ctx)}))
    (when cap-dispatch (cap-dispatch sites))
    (let [out (guest-entry ctx)]
      (when-not (map? out)
        (reject! "guest-entry must answer {:status ... :output ...}"
                 {:guest-entry (pr-str out)}))
      {:entry-route (:decision entry-route)
       :abi :sysv-ctx-v11
       :ctx-plan plan
       :cap-call-sites sites
       :guest-called 1
       :status (:status out)
       :output (:output out)})))
