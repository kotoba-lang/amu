(ns kotoba.compiler.cache
  {:kotoba/export [admit! entry-schema statement-schema store]}
  (:require #?@(:kotoba [[kotoba.form :as form]
                         [kotoba.verifier.seal :as seal]]
                :default [[kotoba.artifact.core :as artifact]])
            [kotoba.compiler.provenance :as provenance]
            [kotoba.verifier.signing :as signing]
            [kotoba.verifier :as verifier])
  #?(:kotoba (:schemas {:form/r [:record :form/r [[:tag :i64] [:s :string] [:n :i64] [:k :keyword]
                                                  [:kids [:list [:ref :form/r]]] [:span :i64] [:data :bytes]]]})))

#?(:kotoba nil :default (def entry-schema :kotoba.incremental-cache/v1))
#?(:kotoba nil :default (def statement-schema :kotoba.incremental-cache-statement/v1))
#?(:kotoba nil :default (defn- host-bytes?
  "A value that is the host's byte container: byte[] on the JVM, a Buffer or
  Uint8Array on Node -- and the SIGNED Int8Array that a Java-shaped byte[]
  (`byte-array`, `.getBytes`, `.digest`) is on the kbb engine since its
  JVM-compatibility round 2 (2026-09-24); without it such bytes were not
  recognised and went into the cache payload raw. `Class/forName \"[B\"` was
  the JVM spelling, and it was the whole reason this namespace refused to
  load on Node (ADR 0348 iteration 7)."
  [value]
  #?(:clj (= (Class/forName "[B") (class value))
     :cljs (or (instance? js/Uint8Array value) (instance? js/Buffer value)
               (instance? js/Int8Array value)))))
#?(:kotoba nil :default (def ^:private max-canonical-bytes (* 64 1024 1024)))

#?(:kotoba nil :default (defn- reject [reason message]
  (throw (ex-info message {:phase :cache :reason reason}))))
#?(:kotoba nil :default (defn- sha256? [value]
  (and (string? value) (boolean (re-matches #"[0-9a-f]{64}" value)))))

#?(:kotoba nil :default (defn- freeze [value]
  (cond
    (host-bytes? value)
    {:kotoba.cache/format :bytes-v1
     ;; 2026-09-12, adr-2609111900: the `:default` clause below exists so the
     ;; Kotoba reader, whose only feature is `:kotoba`, reads this file. A
     ;; `#?(:clj a :cljs b)` with no matching feature reads as NOTHING, which in a
     ;; map-value position leaves the map with an odd number of forms, so the whole
     ;; file was refused at read time ("map literal must contain an even number of
     ;; forms") -- in a dependency, so every dependant stopped here. With `:default`
     ;; the reader reads the file and refuses the `:cljs` form by NAME later, in the
     ;; module that uses it. It changes nothing on clj/cljs: Clojure still picks
     ;; `:clj`, ClojureScript/nbb still picks `:cljs` (first match).
     ;; masked on every host: an Int8Array reads 0xff as -1, and thaw admits
     ;; only 0..255
     :kotoba.cache/value #?(:clj (mapv #(bit-and (int %) 0xff) value)
                            :cljs (mapv #(bit-and % 0xff) (js/Array.from value))
                            :default (mapv #(bit-and % 0xff) (js/Array.from value)))}
    (map? value) (into (empty value) (map (fn [[k v]] [(freeze k) (freeze v)])) value)
    (vector? value) (mapv freeze value)
    (set? value) (set (map freeze value))
    (sequential? value) {:kotoba.cache/format :list-v1
                         :kotoba.cache/value (mapv freeze value)}
    :else value)))

#?(:kotoba nil :default (defn- thaw [value]
  (cond
    (and (map? value)
         (= #{:kotoba.cache/format :kotoba.cache/value} (set (keys value)))
         (= :bytes-v1 (:kotoba.cache/format value))
         (vector? (:kotoba.cache/value value))
         (every? #(and (integer? %) (<= 0 % 255)) (:kotoba.cache/value value)))
    #?(:clj (byte-array (map unchecked-byte (:kotoba.cache/value value)))
       :cljs (js/Buffer.from (clj->js (:kotoba.cache/value value))))
    (and (map? value)
         (= #{:kotoba.cache/format :kotoba.cache/value} (set (keys value)))
         (= :list-v1 (:kotoba.cache/format value))
         (vector? (:kotoba.cache/value value)))
    (apply list (map thaw (:kotoba.cache/value value)))
    (map? value) (into (empty value) (map (fn [[k v]] [(thaw k) (thaw v)])) value)
    (vector? value) (mapv thaw value)
    (set? value) (set (map thaw value))
    :else value)))

#?(:kotoba nil :default (defn store [source policy build-metadata result key not-before expires]
  (when-not (and (signing/valid-key? key) (integer? not-before) (integer? expires)
                 (< not-before expires))
    (reject :invalid-signer "cache signer or validity interval rejected"))
  (provenance/verify! source policy build-metadata result)
  (let [payload (freeze result)
        payload-bytes (artifact/canonical-bytes payload)]
    (when (> (alength payload-bytes) max-canonical-bytes)
      (reject :oversized "cache payload exceeds canonical byte limit"))
    (let [statement {:format statement-schema
                     :compiler "kotoba-compiler/1"
                     :target (:target result)
                     :provenance-sha256 (get-in result [:provenance :sha256])
                     :payload-sha256 (artifact/sha256 payload)
                     :signer (:signer key) :public-key (:public-key key)
                     :not-before not-before :expires expires}]
      {:format entry-schema :statement statement :payload payload
       :signature (signing/sign-value key statement)}))))

#?(:kotoba nil :default (defn admit! [source target policy build-metadata envelope trust now]
  (signing/validate-trust! trust)
  (let [statement (:statement envelope)
        expected-statement-fields
        #{:format :compiler :target :provenance-sha256 :payload-sha256
          :signer :public-key :not-before :expires}]
    (when-not (and (= #{:format :statement :payload :signature} (set (keys envelope)))
                   (= entry-schema (:format envelope))
                   (map? statement)
                   (= expected-statement-fields (set (keys statement)))
                   (= statement-schema (:format statement))
                   (= "kotoba-compiler/1" (:compiler statement))
                   (= target (:target statement))
                   (every? sha256? [(:provenance-sha256 statement) (:payload-sha256 statement)])
                   (= (:payload-sha256 statement) (artifact/sha256 (:payload envelope)))
                   (= (:signer statement) (signing/signer-id (:public-key statement)))
                   (integer? (:not-before statement)) (integer? (:expires statement))
                   (< (:not-before statement) (:expires statement))
                   (string? (:signature envelope)))
      (reject :schema "cache envelope schema or identity rejected"))
    (when-not (signing/verify-value (:public-key statement) statement (:signature envelope))
      (reject :signature "cache signature rejected"))
    (when-not (contains? (:trusted-signers trust) (:signer statement))
      (reject :untrusted "cache signer is not trusted"))
    (when (contains? (:revoked-signers trust) (:signer statement))
      (reject :revoked "cache signer is revoked"))
    (when (or (contains? (:revoked-artifacts trust) (:payload-sha256 statement))
              (contains? (:revoked-artifacts trust) (:provenance-sha256 statement)))
      (reject :revoked "cache payload or provenance is revoked"))
    (when (or (< now (:not-before statement)) (>= now (:expires statement)))
      (reject :expired "cache entry is outside its validity interval"))
    (let [result (thaw (:payload envelope))]
      (when-not (= (:provenance-sha256 statement) (get-in result [:provenance :sha256]))
        (reject :identity "cache provenance identity rejected"))
      (provenance/verify! source policy build-metadata result)
      (when (= :kexe/v1 (:format result)) (verifier/verify-artifact! (:artifact result)))
      {:hit? true :signer (:signer statement) :result result}))))

;; ---------------------------------------------------------------------------
;; THE KOTOBA READING. A compile result and an envelope are `:form/r` records
;; (kotoba.form): a `:document` holds 32 items per container and a result holds
;; a code vector. Host bytes are the Form's `:bytes` leaf; `freeze`/`thaw` are
;; the same wrapping over Forms. `now` and the validity bounds are i64, the
;; target a keyword. A rejected store/admit TRAPS (`assert`): an export cannot
;; abort with a value a caller sees (host: ex-info {:phase :cache :reason ..}).

#?(:kotoba
   (defn entry-schema [] :keyword :kotoba.incremental-cache/v1))

#?(:kotoba
   (defn statement-schema [] :keyword :kotoba.incremental-cache-statement/v1))

#?(:kotoba
   (defn- trap-form [] [:ref :form/r]
     (let [refused (assert (= 1 0))] (form/nil-form))))

#?(:kotoba
   (defn- fget [m [:ref :form/r] k :keyword] [:ref :form/r]
     (form/form-get m (form/keyword-form k))))

#?(:kotoba
   (defn- has? [m [:ref :form/r] k :keyword] :bool
     (form/form-has? m (form/keyword-form k))))

#?(:kotoba
   (defn- put [m [:ref :form/r] k :keyword v [:ref :form/r]] [:ref :form/r]
     (form/assoc-form m (form/keyword-form k) v)))

#?(:kotoba
   (defn- empty-map [] [:ref :form/r] (form/form-map (form/no-forms))))

#?(:kotoba
   (defn- member-from [xs [:list [:ref :form/r]] x [:ref :form/r] i :i64] :bool
     (if (>= i (vector-count xs))
       false
       (if (form/eq (typed-list-nth [:list [:ref :form/r]] xs i) x)
         true
         (member-from xs x (+ i 1))))))

#?(:kotoba
   (defn- member? [s [:ref :form/r] x [:ref :form/r]] :bool
     (member-from (form/kids-of s) x 0)))

;; bytes <-> a Form vector of ints
#?(:kotoba
   (defn- ints-from-bytes [data :bytes i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (bytes-count data))
       acc
       (ints-from-bytes data (+ i 1) (form/append-form acc (form/int-form (bytes-at data i)))))))

#?(:kotoba
   (defn- ints-to-vector [f [:ref :form/r] i :i64 out :vector-i64] :vector-i64
     (if (>= i (form/count-of f))
       out
       (ints-to-vector f (+ i 1) (vector-conj out (form/int-value (form/nth-of f i)))))))

#?(:kotoba
   (defn- bytes-ints? [f [:ref :form/r] i :i64] :bool
     (if (>= i (form/count-of f))
       true
       (let [x (form/nth-of f i)]
         (if (form/is-int? x)
           (if (>= (form/int-value x) 0)
             (if (<= (form/int-value x) 255) (bytes-ints? f (+ i 1)) false)
             false)
           false)))))

#?(:kotoba
   (defn- wrapper [format :keyword value [:ref :form/r]] [:ref :form/r]
     (put (put (empty-map) :kotoba.cache/format (form/keyword-form format))
          :kotoba.cache/value value)))

;; the frozen kids of a container, in order (map kids are k v k v ..)
#?(:kotoba
   (defn- freeze-kids [kids [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count kids))
       acc
       (freeze-kids kids (+ i 1) (form/append-form acc (freeze (typed-list-nth [:list [:ref :form/r]] kids i)))))))

#?(:kotoba
   (defn- freeze [value [:ref :form/r]] [:ref :form/r]
     (if (form/is-bytes? value)
       (wrapper :bytes-v1 (form/form-vec (ints-from-bytes (form/bytes-of value) 0 (form/no-forms))))
       (if (form/is-map? value)
         (form/form-map (freeze-kids (form/kids-of value) 0 (form/no-forms)))
         (if (form/is-vec? value)
           (form/form-vec (freeze-kids (form/kids-of value) 0 (form/no-forms)))
           (if (form/is-set? value)
             (form/form-set (freeze-kids (form/kids-of value) 0 (form/no-forms)))
             (if (form/is-seq? value)
               (wrapper :list-v1 (form/form-vec (freeze-kids (form/kids-of value) 0 (form/no-forms))))
               value)))))))

#?(:kotoba
   (defn- wrapper-shape? [f [:ref :form/r] format :keyword] :bool
     (if (form/is-map? f)
       (if (= 4 (form/count-of f))
         (if (has? f :kotoba.cache/format)
           (if (has? f :kotoba.cache/value)
             (form/eq (fget f :kotoba.cache/format) (form/keyword-form format))
             false)
           false)
         false)
       false)))

#?(:kotoba
   (defn- thaw-kids [kids [:list [:ref :form/r]] i :i64 acc [:list [:ref :form/r]]] [:list [:ref :form/r]]
     (if (>= i (vector-count kids))
       acc
       (thaw-kids kids (+ i 1) (form/append-form acc (thaw (typed-list-nth [:list [:ref :form/r]] kids i)))))))

#?(:kotoba
   (defn- thaw [value [:ref :form/r]] [:ref :form/r]
     (if (wrapper-shape? value :bytes-v1)
       (if (form/is-vec? (fget value :kotoba.cache/value))
         (if (bytes-ints? (fget value :kotoba.cache/value) 0)
           (form/bytes-form (bytes-from-vector-i64 (ints-to-vector (fget value :kotoba.cache/value) 0 (vector-i64))))
           (thaw-map value))
         (thaw-map value))
       (if (wrapper-shape? value :list-v1)
         (if (form/is-vec? (fget value :kotoba.cache/value))
           (form/form-seq (thaw-kids (form/kids-of (fget value :kotoba.cache/value)) 0 (form/no-forms)))
           (thaw-map value))
         (thaw-map value)))))

#?(:kotoba
   (defn- thaw-map [value [:ref :form/r]] [:ref :form/r]
     (if (form/is-map? value)
       (form/form-map (thaw-kids (form/kids-of value) 0 (form/no-forms)))
       (if (form/is-vec? value)
         (form/form-vec (thaw-kids (form/kids-of value) 0 (form/no-forms)))
         (if (form/is-set? value)
           (form/form-set (thaw-kids (form/kids-of value) 0 (form/no-forms)))
           value)))))

#?(:kotoba
   (defn store [source :string policy [:ref :form/r] build-metadata [:ref :form/r] result [:ref :form/r]
                signing-key [:ref :form/r] not-before :i64 expires :i64]
     [:ref :form/r]
     (if (signing/valid-key? signing-key)
       (if (< not-before expires)
         (let [verified (provenance/verify! source policy build-metadata result)
               payload (freeze result)]
           (if (> (string-byte-length (seal/canonical-text payload)) 67108864)
             (trap-form)
             (let [statement (put (put (put (put (put (put (put (put (empty-map)
                                :format (form/keyword-form (statement-schema)))
                                :compiler (form/string-form "kotoba-compiler/1"))
                                :target (fget result :target))
                                :provenance-sha256 (fget (fget result :provenance) :sha256))
                                :payload-sha256 (form/string-form (seal/sha256-form payload)))
                                :signer (fget signing-key :signer))
                                :public-key (fget signing-key :public-key))
                                :not-before (form/int-form not-before))]
               (put (put (put (put (empty-map) :format (form/keyword-form (entry-schema)))
                              :statement (put statement :expires (form/int-form expires)))
                         :payload payload)
                    :signature (form/string-form
                                (signing/sign-value signing-key
                                                    (put statement :expires (form/int-form expires))))))))
         (trap-form))
       (trap-form))))

#?(:kotoba
   (defn- envelope-shape? [envelope [:ref :form/r]] :bool
     (if (form/is-map? envelope)
       (if (= 8 (form/count-of envelope))
         (if (has? envelope :format)
           (if (has? envelope :statement)
             (if (has? envelope :payload)
               (if (has? envelope :signature)
                 (form/eq (fget envelope :format) (form/keyword-form (entry-schema)))
                 false)
               false)
             false)
           false)
         false)
       false)))

#?(:kotoba
   (defn- statement-shape? [st [:ref :form/r]] :bool
     (if (form/is-map? st)
       (if (= 18 (form/count-of st))
         (if (has? st :format)
           (if (has? st :compiler)
             (if (has? st :target)
               (if (has? st :provenance-sha256)
                 (if (has? st :payload-sha256)
                   (if (has? st :signer)
                     (if (has? st :public-key)
                       (if (has? st :not-before) (has? st :expires) false)
                       false)
                     false)
                   false)
                 false)
               false)
             false)
           false)
         false)
       false)))

#?(:kotoba
   (defn- statement-ok? [st [:ref :form/r] target :keyword envelope [:ref :form/r]] :bool
     (if (statement-shape? st)
       (if (form/eq (fget st :format) (form/keyword-form (statement-schema)))
         (if (form/eq (fget st :compiler) (form/string-form "kotoba-compiler/1"))
           (if (form/eq (fget st :target) (form/keyword-form target))
             ;; the digests need no shape check of their own: :payload-sha256 must
             ;; equal the recomputed digest, and :provenance-sha256 the sealed
             ;; result's, which `provenance/verify!` recomputes
             (if (form/is-string? (fget st :provenance-sha256))
               (if (form/eq (fget st :payload-sha256) (form/string-form (seal/sha256-form (fget envelope :payload))))
                 (if (form/is-string? (fget st :public-key))
                   (if (form/eq (fget st :signer)
                                (form/string-form (signing/signer-id (form/string-value (fget st :public-key)))))
                     (if (form/is-int? (fget st :not-before))
                       (if (form/is-int? (fget st :expires))
                         (if (< (form/int-value (fget st :not-before)) (form/int-value (fget st :expires)))
                           (form/is-string? (fget envelope :signature))
                           false)
                         false)
                       false)
                     false)
                   false)
                 false)
               false)
             false)
           false)
         false)
       false)))

#?(:kotoba
   (defn- standing-ok? [trust [:ref :form/r] st [:ref :form/r] now :i64] :bool
     (let [signer (fget st :signer)]
       (if (member? (fget trust :trusted-signers) signer)
         (if (member? (fget trust :revoked-signers) signer)
           false
           (if (member? (fget trust :revoked-artifacts) (fget st :payload-sha256))
             false
             (if (member? (fget trust :revoked-artifacts) (fget st :provenance-sha256))
               false
               (if (< now (form/int-value (fget st :not-before)))
                 false
                 (< now (form/int-value (fget st :expires)))))))
         false))))

#?(:kotoba
   (defn- admit-payload [source :string policy [:ref :form/r] build-metadata [:ref :form/r]
                         envelope [:ref :form/r]] [:ref :form/r]
     (let [st (fget envelope :statement)
           result (thaw (fget envelope :payload))]
       (if (form/eq (fget st :provenance-sha256) (fget (fget result :provenance) :sha256))
         (let [verified (provenance/verify! source policy build-metadata result)
               artifact-ok (if (form/eq (fget result :format) (form/keyword-form :kexe/v1))
                             (verifier/verify-artifact! (fget result :artifact))
                             result)]
           (put (put (put (empty-map) :hit? (form/bool-form true))
                     :signer (fget st :signer))
                :result result))
         (trap-form)))))

#?(:kotoba
   (defn admit! [source :string target :keyword policy [:ref :form/r] build-metadata [:ref :form/r]
                 envelope [:ref :form/r] trust [:ref :form/r] now :i64]
     [:ref :form/r]
     (let [checked (signing/validate-trust! trust)]
       (if (envelope-shape? envelope)
         (let [st (fget envelope :statement)]
           (if (statement-ok? st target envelope)
             (if (signing/verify-value (form/string-value (fget st :public-key)) st
                                       (form/string-value (fget envelope :signature)))
               (if (standing-ok? trust st now)
                 (admit-payload source policy build-metadata envelope)
                 (trap-form))
               (trap-form))
             (trap-form)))
         (trap-form)))))
