(ns kotoba.compiler.decimal-text-core
  "Canonical Kotoba implementation of decimal text helpers."
  {:kotoba/export [decimal? fields parse]})

(defn len [s :string] :i64
  (string-byte-length s))

(defn byte-is? [s :string i :i64 b :i64] :bool
  (= i (string-find-byte s b i)))

(defn next-space [s :string from :i64] :i64
  (string-find-byte s 32 from))

(defn cut [s :string start :i64 end :i64] :string
  (string-substring s start end))

(defn push [v :vector-i64 x :i64] :vector-i64
  (vector-conj v x))

(defn digit-at [s :string i :i64] :i64
  (loop [d 0]
    (if (> d 9)
      -1
      (if (byte-is? s i (+ 48 d)) d (recur (inc d))))))

(defn start [s :string] :i64
  (if (and (> (len s) 0) (byte-is? s 0 45)) 1 0))

(defn decimal? [s :string] :bool
  (let [from (start s)
        n (len s)]
    (and (> n from)
         (<= (- n from) 18)
         (loop [i from]
           (if (>= i n)
             true
             (if (< (digit-at s i) 0) false (recur (inc i))))))))

(defn parse [s :string] :i64
  (if (decimal? s)
    (let [from (start s)
          n (len s)
          magnitude (loop [i from acc 0]
                      (if (>= i n)
                        acc
                        (recur (inc i) (+ (* acc 10) (digit-at s i)))))]
      (if (= from 1) (- 0 magnitude) magnitude))
    0))

(defn fields [s :string] :vector-i64
  (let [n (len s)]
    (loop [i 0 acc (vector-i64)]
      (if (>= i n)
        acc
        (let [j (next-space s i)]
          (if (< j 0)
            (push acc (parse (cut s i n)))
            (recur (inc j) (push acc (parse (cut s i j))))))))))
