(ns kotoba.compiler.accelerator-pipeline
  "Connect the accelerator pipeline (JUN-85 emit stage): one kernel SPEC plus
  one device descriptor become one sealed GPU artifact through
  kotoba.compiler.accelerator-targets' deterministic vendor dispatch and
  kotoba.compiler.accelerator's deterministic emitters. Before this namespace
  the emitters were library-only: KIR reached them, but nothing carried a
  device descriptor through dispatch to a sealed artifact.

  The workgroup size is the PROVISIONAL dispatch default (ADR-0355,
  `:measured? false`) unless the SPEC names one. Neither answer is
  optimization evidence until a measured row replaces the provisional one.

  KERNEL VARIANT SELECTION (JUN-56's dispatch seam, this slice): the same
  device descriptor now also decides the kernel variant through
  kotoba.compiler.accelerator-variants' `select-variant` (ADR-0356's rows).
  Before this seam the rows were library-only too: `select-variant` answered
  :subgroup-reduce / :warp-shuffle-reduce for capable descriptors, but every
  caller of this pipeline compiled :baseline regardless. Now the selected
  variant rides into `compile-kernel`, the sealed artifact carries it in its
  own :variant field, and the dispatch report names it. Selection is
  fail-closed like the rows themselves: a descriptor that
  reports no rule-6 subgroup facts gets :baseline (the facts' producer -- the
  ADR 0371 GPU provider's SUBGROUP reply -- does not exist yet, so no live
  device descriptor carries them today), and `:variant-measured?` is false
  except the measured cells ADR-0360 question (1)'s 2026-10-23 decision
  unlocks (the narrowed :baseline answers of the measured device, Apple M1
  Max at subgroup size 32, on the MSL route at W = 256/512/1024) --
  outside those cells it is NOT optimization evidence, and neither the
  variant nor its basis may be reported as one."
  {:kotoba/export [compile-spec]}
  (:require [kotoba.compiler.accelerator :as accelerator]
            [kotoba.compiler.accelerator-targets :as accelerator-targets]
            [kotoba.compiler.accelerator-variants :as accelerator-variants]
            #?(:cljs [kotoba.kir.cljs-i64 :as i64])))

(defn- host-int
  "A spec integer as a compiler-host integer, or nil when `x` is not one
  (capability_names/wire-int pattern: the kotoba reader hands back a BigInt
  for every integer token, and `pos-int?` does not recognise those)."
  [x]
  #?(:clj (when (integer? x) (long x))
     :cljs (cond
             (i64/bigint-value? x) (js/Number x)
             (and (number? x) (integer? x)) x
             :else nil)))

(defn compile-spec
  "SPEC is a kernel description map: :kernel/name, :kernel/op, :kernel/operator
  and an optional :kernel/workgroup-size. DEVICE is an
  accelerator-targets device descriptor ({:vendor-id <int>} or {:vendor <name>},
  optional :api, and -- when a producer exists for them -- the rule-6 subgroup
  facts :subgroup-size/:subgroup-ops and :compute-capability).
  Answers {:artifact <sealed GPU artifact>
  :dispatch {:vendor :target :workgroup-size :workgroup-source :measured?
             :variant :variant-measured?}}.
  Same SPEC and DEVICE in, byte-identical artifact out -- the emitters, the
  dispatch table and the variant rows are all deterministic. The variant is
  the one `accelerator-variants/select-variant` answers for the classified
  vendor, the dispatched target and the same DEVICE (fail-closed :baseline
  off the rows); `:variant-measured?` is that answer's honesty lock -- false
  except the measured cells of the Apple row's narrowing on the MSL route
  (ADR-0360 question (1)'s 2026-10-23 decision)."
  [spec device]
  (let [dispatch (accelerator-targets/recommend device)
        declared (:kernel/workgroup-size spec)
        size (if (some? declared)
               ;; An explicit size must be an integer; a malformed one is an
               ;; input error, never a silent fall back to the dispatch row.
               (or (host-int declared)
                   (throw (ex-info "invalid kernel spec: workgroup size is not an integer"
                                   {:phase :usage :problem :invalid-workgroup-size})))
               (:workgroup-size dispatch))
        source (if (some? declared) :spec :dispatch)
        kir (accelerator/kernel (:kernel/name spec) (:kernel/op spec)
                                (:kernel/operator spec) {:workgroup-size size})
        ;; Validate before emitting so a malformed SPEC is reported as an
        ;; input error (:phase :usage) rather than escaping as an internal
        ;; compiler error at the CLI boundary.
        errors (accelerator/validation-errors kir)]
    (when (seq errors)
      (throw (ex-info "invalid kernel spec" {:phase :usage :errors errors})))
    (let [;; JUN-56's dispatch seam: the vendor rows decide the kernel
          ;; variant from the same DEVICE the workgroup row saw. The vendor
          ;; is the dispatch table's own classification (recommend answers
          ;; it), the target its own route -- one dispatch, two answers.
          selection (accelerator-variants/select-variant
                      (:vendor dispatch) kir (:target dispatch) device)
          variant (:variant selection)
          artifact (accelerator/verify-artifact!
                     (accelerator/compile-kernel kir (:target dispatch) variant))]
      {:artifact artifact
       :dispatch {:vendor (:vendor dispatch)
                  :target (:target dispatch)
                  :workgroup-size size
                  :workgroup-source source
                  :measured? (and (:measured? dispatch) (= source :dispatch))
                  :variant variant
                  ;; The variant rows' honesty lock (ADR-0356): false
                  ;; until a hardware measurement replaces the row's basis
                  ;; -- today only the measured cells of the Apple row's
                  ;; narrowing on the MSL route (ADR-0360 question (1)'s
                  ;; decision). Never merge this with the workgroup row's
                  ;; :measured? -- they are evidence about different things.
                  :variant-measured? (boolean (:measured? selection))}})))
