(ns kotoba.compiler.atomic-output
  "Atomic publication of a compiler output, on both compiler hosts.

  This was `.clj` until 2026-09-11; with `kotoba.compiler.bounded-edn` it is
  the other leaf every JVM-only `bin/amu` command stands on
  (`docs/jvm-route-topology.edn`): `keygen` writes a private key through it,
  `sign` an envelope, `sbom` bytes. The contract is the same on either host --
  a private temporary in the target's own directory, the bytes, a flush, an
  atomic rename -- and the `:clj` implementation is the one that was here,
  unchanged inside its reader conditional.

  On `:cljs` the write goes through `kotoba.compiler.nbb.io/write-set!`, the
  Node route's existing fsync-before-rename boundary, which creates the
  temporary 0600 (`:private?` is therefore the default posture there, as it
  is for the JVM temporary) and sets `:executable?` as 0700 on the descriptor
  before a byte lands. Owner-only Windows ACLs are a `:clj`-only claim; the
  Node branch names that rather than pretending a `chmod` is one."
  #?(:clj (:import [java.nio ByteBuffer]
                   [java.nio.channels FileChannel]
                   [java.nio.charset StandardCharsets]
                   [java.nio.file CopyOption Files OpenOption Path Paths StandardCopyOption StandardOpenOption]
                   [java.nio.file.attribute AclEntry AclEntryPermission AclEntryType
                    AclFileAttributeView FileAttribute PosixFilePermissions]
                   [java.util Collections EnumSet])
     :cljs (:require [kotoba.artifact.core :as artifact]
                     [kotoba.compiler.nbb.io :as nbb-io]
                     ["node:fs" :as fs]
                     ["node:os" :as os]
                     ["node:path" :as path])))

(defn temp-file!
  "Create a temporary file under the host's temporary directory and return
  it -- a `java.io.File` registered for deletion on JVM exit on `:clj`, a
  path string on `:cljs` (Node has no exit hook that survives a crash; the
  caller that wants it gone removes it). This is the compiler's one temp-file
  constructor: call sites spell a prefix and a suffix, not host statics. The
  `:clj` half is backed by `Files/createTempFile` so the permissions model
  stays nio's; the `:cljs` half creates the file itself, exclusively, 0600."
  ([prefix] (temp-file! prefix ".tmp"))
  ([prefix suffix]
   #?(:clj (doto (.. (Files/createTempFile (str prefix) (str suffix)
                                           (make-array FileAttribute 0))
                     toFile)
             (.deleteOnExit))
      :cljs (let [dir (.mkdtempSync fs (.join path (.tmpdir os) (str prefix)))
                  file (.join path dir (str "file" suffix))
                  constants (.-constants fs)
                  fd (.openSync fs file (bit-or (.-O_CREAT constants)
                                                (.-O_EXCL constants)
                                                (.-O_WRONLY constants)) 384)]
              (.closeSync fs fd)
              file))))

(defn- reject! [message data cause]
  (throw (ex-info message (merge {:phase :output} data) cause)))

#?(:clj
(do
(defn- target-path [path]
  (when-not (and (string? path) (seq path))
    (reject! "output path is required" {} nil))
  (let [target (.normalize (.toAbsolutePath (Paths/get path (make-array String 0))))
        parent (.getParent target)]
    (when-not (and parent (Files/isDirectory parent (make-array java.nio.file.LinkOption 0)))
      (reject! "output parent must be a directory" {:path path} nil))
    target))

(defn- set-owner-acl! [^Path path executable?]
  (let [view (Files/getFileAttributeView path AclFileAttributeView
                                         (make-array java.nio.file.LinkOption 0))
        lookup (.getUserPrincipalLookupService (.getFileSystem path))
        owner (.lookupPrincipalByName lookup (System/getProperty "user.name"))
        ;; Windows checks additional generic-right mappings while a file is
        ;; written and atomically renamed.  Full control for exactly one SID is
        ;; the Windows equivalent of an owner-private file: it adds no reader
        ;; or writer, and the owner could change its ACL in either model.
        permissions (EnumSet/allOf AclEntryPermission)
        entry (-> (AclEntry/newBuilder)
                  (.setType AclEntryType/ALLOW)
                  (.setPrincipal owner)
                  (.setPermissions permissions)
                  (.build))]
    (when-not view
      (reject! "Windows ACL output permissions are unsupported" {:path (str path)} nil))
    ;; Windows runners can create a file owned by the Administrators group even
    ;; while the process uses a filtered, non-elevated user token.  Restricting
    ;; that inherited owner would lock the writer out of its own temporary file.
    ;; Make the actual process user the owner before replacing the inherited ACL.
    (.setOwner view owner)
    (.setAcl view (Collections/singletonList entry))
    (let [actual (.getAcl view)]
      (when-not (and (= 1 (count actual))
                     (= owner (Files/getOwner path (make-array java.nio.file.LinkOption 0)))
                     (= owner (.principal ^AclEntry (first actual)))
                     (= AclEntryType/ALLOW (.type ^AclEntry (first actual)))
                     (= permissions (.permissions ^AclEntry (first actual))))
        (reject! "owner-only Windows ACL could not be verified" {:path (str path)} nil)))))

(defn- set-private-permissions! [^Path path]
  (try
    (Files/setPosixFilePermissions path (PosixFilePermissions/fromString "rw-------"))
    (catch UnsupportedOperationException error
      (try (set-owner-acl! path false)
           (catch clojure.lang.ExceptionInfo nested (throw nested))
           (catch Exception nested
             (reject! "private output permissions are unsupported" {:path (str path)} nested))))))

(defn- set-executable-permissions! [^Path path]
  (try
    (Files/setPosixFilePermissions path (PosixFilePermissions/fromString "rwx------"))
    (catch UnsupportedOperationException error
      (try (set-owner-acl! path true)
           (catch clojure.lang.ExceptionInfo nested (throw nested))
           (catch Exception nested
             (reject! "executable output permissions are unsupported" {:path (str path)} nested))))))))

#?(:cljs
   (defn- byte-source? [bytes]
     (or (instance? js/Uint8Array bytes) (instance? js/Buffer bytes))))

#?(:cljs
   (defn- write-bytes-node! [output-path bytes {:keys [executable?]}]
     ;; `write-set!` creates the temporary 0600 and renames it, so an output
     ;; is owner-private on this host without asking; `:private?` adds
     ;; nothing and `:executable?` is the one mode that differs. Its errors
     ;; are already {:phase :output ...}; `target!` there refuses a missing
     ;; parent with the same message the `:clj` branch uses.
     (nbb-io/write-bytes! output-path bytes (if executable? 448 nil))
     (.resolve path output-path)))

(defn write-bytes!
  ([path bytes] (write-bytes! path bytes {}))
  ([path bytes {:keys [private? executable?] :or {private? false executable? false} :as options}]
   #?(:cljs
      (do
        (when-not (byte-source? bytes)
          (reject! "output must be a byte array" {:path path} nil))
        (write-bytes-node! path bytes options))
      :clj
   (do
   (when-not (instance? (Class/forName "[B") bytes)
     (reject! "output must be a byte array" {:path path} nil))
   (let [target (target-path path)
         parent (.getParent target)
         temporary (Files/createTempFile parent ".kotoba-" ".tmp"
                                         (make-array FileAttribute 0))
         operation (volatile! :permissions)]
     (try
       (cond executable? (set-executable-permissions! temporary)
             private? (set-private-permissions! temporary))
       (vreset! operation :write)
       (with-open [channel (FileChannel/open
                            temporary
                            (into-array OpenOption
                                        [StandardOpenOption/WRITE
                                         StandardOpenOption/TRUNCATE_EXISTING]))]
         (let [buffer (ByteBuffer/wrap bytes)]
           (while (.hasRemaining buffer) (.write channel buffer)))
         (.force channel true))
       (vreset! operation :move)
       (Files/move temporary target
                   (into-array CopyOption [StandardCopyOption/ATOMIC_MOVE
                                           StandardCopyOption/REPLACE_EXISTING]))
       (str target)
       (catch clojure.lang.ExceptionInfo error (throw error))
       (catch Exception error
         (reject! "atomic output failed" {:path path :reason @operation} error))
       (finally (Files/deleteIfExists temporary))))))))

(defn- utf8-bytes [^String text]
  #?(:clj (.getBytes text StandardCharsets/UTF_8)
     :cljs (js/Buffer.from text "utf8")))

(defn write-edn!
  "`pr-str` the value and publish it. On `:cljs` the value goes through
  `artifact/edn-safe` first: a guest integer is a bigint there, and `pr-str`
  renders a bigint as `#object[BigInt 7]`, which no reader takes back. The
  JVM prints a long as its digits already, so the two hosts write the same
  token for the same integer."
  ([path value] (write-edn! path value {}))
  ([path value options]
   (write-bytes! path (utf8-bytes (pr-str #?(:clj value
                                             :cljs (artifact/edn-safe value))))
                 options)))

(defn write-text!
  "Like write-edn! but for a value that is ALREADY a string meant to be read
  verbatim (e.g. emitted ClojureScript source) -- write-edn! would pr-str it
  into a quoted/escaped EDN string literal, corrupting source text that must
  stay directly readable by a cljs host."
  ([path value] (write-text! path value {}))
  ([path value options]
   (when-not (string? value)
     (reject! "output must be a string" {:path path} nil))
   (write-bytes! path (utf8-bytes value) options)))
