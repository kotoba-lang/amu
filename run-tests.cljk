;; kbb --backend sci --classpath "src:test:$(kbb -Spath -M:test)" run-tests.cljk
;;
;; The ClojureScript half of this repository's suite. THE COMPILER HAD NONE.
;;
;; That is the sentence worth sitting with: `bin/amu`'s Wasm targets
;; (`wasm32-browser` and friends; the default for an omitted --target was
;; wasm32 until ADR 0351 made it the host's native target) run on nbb, and
;; until 2026-09-08 no test in this
;; repository had ever executed there through a runner. The nbb path was
;; exercised only incidentally, by scripts that compile a fixture and check the
;; bytes.
;;
;; It is not a hypothetical gap. Advancing the kotoba-sema pin across the
;; reader unification this same day turned THIS suite red three times, and each
;; red was a language feature that did not work on nbb: f32 decimal literals
;; refused, `0x` hex literals read as SYMBOLS (79 `.kotoba` files use them),
;; and `(def k 1.5)` refused as not-closed. All three were older than the pin
;; that surfaced them and invisible while the JVM had `clojure.tools.reader`
;; to handle those forms for free.
;;
;; Four namespaces, chosen because their sources are `.cljc` and their tests
;; needed nothing but `clojure.lang.ExceptionInfo` conditionalised. TWO of the
;; seven one-host sources are deliberately absent and are NOT oversights:
;;
;;   definition-identity-test  uses `clojure.java.io`, `slurp` and `format`.
;;                             `clojure.core/format` does not exist on
;;                             ClojureScript at all.
;;   fuel-estimate-test        reads fixtures through `clojure.java.io`/`slurp`.
;;   uefi-target-gate-test     requires `kotoba.compiler.core`, which is a
;;                             `.clj` namespace -- JVM-only by construction, not
;;                             by omission. Ported, measured, and reverted: nbb
;;                             refused it with `Unable to resolve classname:
;;                             java.nio.charset.StandardCharsets`, reached
;;                             through that require. A test cannot be more
;;                             portable than the namespaces it pulls in.
;;
;; UPDATE 2026-09-08: the two `format`/fixture-reading namespaces above are no
;; longer wholesale absent. Their file-free assertions moved to
;; `kotoba.compiler.definition-identity-portable-test` and
;; `kotoba.compiler.fuel-estimate-portable-test` (`.cljc` siblings, following
;; the pattern in kotoba-lang/kotoba's `*-portable-test.cljc` files); the
;; fixture-reading and `kotoba.compiler.core`-requiring remainder stayed in the
;; original `.clj` files. `uefi-target-gate-test` is still wholesale absent --
;; its whole namespace requires `kotoba.compiler.core`.
;;
;; Both are genuinely JVM-only as written. Splitting their file-free assertions
;; into portable siblings is real follow-on work, not a rename.
;;
;; UPDATE 2026-09-25: the engine pin moved to org-babashka-nbb 95ff779 (the
;; superproject west pin), whose `nbb.jvm.*` compatibility layer loads far more
;; of the JVM runner's namespaces. Each of the 173 namespaces that
;; `test/kotoba/compiler/test_runner.cljk` ran and this file did not was loaded
;; and run on kbb one at a time; the 35 that loaded AND passed with zero
;; failures/errors were added (value-bounds-agreement-test among them), taking
;; this suite from 73 to 221 tests. The other 138 either did not load (61) or
;; loaded with failures/errors -- they stay JVM-only until that changes, and
;; are not listed here so a pass here does not claim them.
;;
;; Anything added to `test/` as `*_test.cljk` belongs in BOTH lists below if it
;; passes on kbb, else in both lists of test/kotoba/compiler/test_runner.cljk
;; (the ledger of namespaces executed nowhere). test-runner-completeness-test,
;; which runs HERE since 2026-09-25, fails on a namespace in neither and on
;; the two lists below disagreeing. Being
;; required is not being run -- and neither is being NAMED: a namespace placed
;; just above the `(t/run-tests ...)` form instead of inside it is a bare
;; symbol, evaluated and discarded, and the suite reports the unchanged count
;; without erroring. Verify by the count MOVING and by a literal `Testing <ns>`
;; line, never by grepping this file.
(ns run-tests
  (:require [cljs.test :as t]
            [kotoba.compiler.accelerator-test]
            [kotoba.compiler.backend-cljs-portable-test]
            [kotoba.compiler.backend-evm-test]
            [kotoba.compiler.backend-qualification-test]
            [kotoba.compiler.bounded-edn-portable-test]
            [kotoba.compiler.coverage-evidence-test]
            [kotoba.compiler.coverage-test]
            [kotoba.compiler.definition-identity-portable-test]
            [kotoba.compiler.definition-identity-test]
            [kotoba.compiler.document-dom-reconcile-test]
            [kotoba.compiler.document-sha256-test]
            [kotoba.compiler.dom-app-repaint-test]
            [kotoba.compiler.effect-classification-test]
            [kotoba.compiler.error-code-contract-test]
            [kotoba.compiler.frontend-equality-diagnostic-test]
            [kotoba.compiler.fuel-estimate-portable-test]
            [kotoba.compiler.fuel64-ceiling-test]
            [kotoba.compiler.fuel64-efi-budget-test]
            [kotoba.compiler.granted-region-test]
            [kotoba.compiler.host-bytes-portable-test]
            [kotoba.compiler.host-profile-test]
            [kotoba.compiler.ios-aot-test]
            [kotoba.compiler.kexe-fs-forms-test]
            [kotoba.compiler.kexe-loader-forms-test]
            [kotoba.compiler.linux-static-target-test]
            [kotoba.compiler.logic-manifest-test]
            [kotoba.compiler.namespace-reachability-test]
            [kotoba.compiler.native-aot-qualification-test]
            [kotoba.compiler.native-device-io-test]
            [kotoba.compiler.nbb.verdict-cache-test]
            [kotoba.compiler.plan-test]
            [kotoba.compiler.policy-grant-count-test]
            [kotoba.compiler.portable-surface-test]
            [kotoba.compiler.provenance-portable-test]
            [kotoba.compiler.receipt-test]
            [kotoba.compiler.schema-test]
            [kotoba.compiler.signing-test]
            [kotoba.compiler.slice-carrier-test]
            [kotoba.compiler.slice-value-test]
            [kotoba.compiler.source-path-test]
            [kotoba.compiler.string-simd-loader-test]
            [kotoba.compiler.surface-convergence-portable-test]
            [kotoba.compiler.symbol-operation-test]
            [kotoba.compiler.test-profile-test]
            [kotoba.compiler.test-runner-completeness-test]
            [kotoba.compiler.typed-set-nth-test]
            [kotoba.compiler.uefi-operations-portable-test]
            [kotoba.compiler.uefi-target-gate-test]
            [kotoba.compiler.export-publicity-test]
            [kotoba.compiler.absence-test]
            [kotoba.compiler.bool-predicates-test]
            [kotoba.compiler.row-records-test]
            [kotoba.compiler.row-operations-test]
            [kotoba.compiler.value-bounds-agreement-test]
            [kotoba.compiler.embedded-resources-test]
            [kotoba.compiler.value-codec-iterative-test]
            [kotoba.compiler.wasm32-kotoba-v1-qualification-test]))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (println (str "\nnbb: " (:test m) " tests, " (:pass m) " passed, "
                (:fail m) " failed, " (:error m) " errors"))
  (when (pos? (+ (or (:fail m) 0) (or (:error m) 0)))
    (set! (.-exitCode js/process) 1)))

(t/run-tests 'kotoba.compiler.accelerator-test
             'kotoba.compiler.backend-cljs-portable-test
             'kotoba.compiler.backend-evm-test
             'kotoba.compiler.backend-qualification-test
             'kotoba.compiler.bounded-edn-portable-test
             'kotoba.compiler.coverage-evidence-test
             'kotoba.compiler.coverage-test
             'kotoba.compiler.definition-identity-portable-test
             'kotoba.compiler.definition-identity-test
             'kotoba.compiler.document-dom-reconcile-test
             'kotoba.compiler.document-sha256-test
             'kotoba.compiler.dom-app-repaint-test
             'kotoba.compiler.effect-classification-test
             'kotoba.compiler.error-code-contract-test
             'kotoba.compiler.frontend-equality-diagnostic-test
             'kotoba.compiler.fuel-estimate-portable-test
             'kotoba.compiler.fuel64-ceiling-test
             'kotoba.compiler.fuel64-efi-budget-test
             'kotoba.compiler.granted-region-test
             'kotoba.compiler.host-bytes-portable-test
             'kotoba.compiler.host-profile-test
             'kotoba.compiler.ios-aot-test
             'kotoba.compiler.kexe-fs-forms-test
             'kotoba.compiler.kexe-loader-forms-test
             'kotoba.compiler.linux-static-target-test
             'kotoba.compiler.logic-manifest-test
             'kotoba.compiler.namespace-reachability-test
             'kotoba.compiler.native-aot-qualification-test
             'kotoba.compiler.native-device-io-test
             'kotoba.compiler.nbb.verdict-cache-test
             'kotoba.compiler.plan-test
             'kotoba.compiler.policy-grant-count-test
             'kotoba.compiler.portable-surface-test
             'kotoba.compiler.provenance-portable-test
             'kotoba.compiler.receipt-test
             'kotoba.compiler.schema-test
             'kotoba.compiler.signing-test
             'kotoba.compiler.slice-carrier-test
             'kotoba.compiler.slice-value-test
             'kotoba.compiler.source-path-test
             'kotoba.compiler.string-simd-loader-test
             'kotoba.compiler.surface-convergence-portable-test
             'kotoba.compiler.symbol-operation-test
             'kotoba.compiler.test-profile-test
             'kotoba.compiler.test-runner-completeness-test
             'kotoba.compiler.typed-set-nth-test
             'kotoba.compiler.uefi-operations-portable-test
             'kotoba.compiler.uefi-target-gate-test
             'kotoba.compiler.export-publicity-test
             'kotoba.compiler.absence-test
             'kotoba.compiler.bool-predicates-test
             'kotoba.compiler.row-records-test
             'kotoba.compiler.row-operations-test
             'kotoba.compiler.value-bounds-agreement-test
             'kotoba.compiler.embedded-resources-test
             'kotoba.compiler.value-codec-iterative-test
             'kotoba.compiler.wasm32-kotoba-v1-qualification-test)
