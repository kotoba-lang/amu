;; ⚠ Changing anything below means regenerating `deps-lock.edn` IN THE SAME
;; COMMIT:
;;
;;     nbb scripts/lock-classpath.cljs
;;
;; The lock is what lets `bin/kotoba` resolve this closure without a JDK
;; (ADR-0202). A stale one is not an error you find later -- it silently sends
;; the compiler back to `clojure -Spath`, and the JDK-free property is gone
;; with nobody notified.
;;
;; This is not hypothetical: the lock went stale three times in one afternoon
;; (two pin advances and one new dependency, each landing while a lock refresh
;; was in review). The murakumo fleet gate `compiler-jdk-free` refuses a
;; mismatch, so the signal is visible -- but the frequency is the reason
;; ADR-0202's follow-up is to derive the closure from git and stop needing a
;; lock on the common path at all.
{:paths ["src" "resources" "tools"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/abi {:git/url "https://github.com/kotoba-lang/abi.git"
                                   :git/sha "32ee84b2efc92478c846629c8d8319280eed506c"}
        org.clojure/tools.reader {:mvn/version "1.5.2"}
        ;; Advanced 2026-09-03 (ADR 0330) with kotoba-lang/provider f040fc0,
        ;; which retires org.clojure/data.json for this namespace and needs
        ;; d5137c7's kwargs surface to be a drop-in.
        io.github.kotoba-lang/json
        {:git/url "https://github.com/kotoba-lang/json.git"
         :git/sha "d5137c7bbd029e4c09964e8241899d2c286302bf"}
        io.github.kotoba-lang/kotoba-script
        {:git/url "https://github.com/kotoba-lang/kotoba-script.git"
         :git/sha "69f65b33bfe52493e4d7634a533b1cb4d70f7874"}
        ;; ADR-0222: source reading and semantic analysis live behind the
        ;; kotoba-sema repository boundary and public semantic-analysis API.
        ;;
        ;; THIS REPOSITORY SHIPS NO COPY OF THE GRAMMAR (2026-09-03).
        ;; It reads kotoba-sema's, across this pin.
        ;;
        ;; It used to ship one at `resources/kotoba/lang/guest-grammar.edn`.
        ;; `:paths` precedes the dependency closure, so that copy SHADOWED
        ;; kotoba-sema's -- and kotoba-sema owns `kotoba.compiler.frontend`,
        ;; whose `load-catalog-forbidden` is the production reader. The
        ;; frontend's refusal set was therefore decided by a file in a
        ;; different repository, updated in a different commit (ADR 0327).
        ;;
        ;; ADR 0330's postscript recorded the cost: the pin and the vendored
        ;; grammar had to move in ONE commit, and on 2026-09-03 #762 landed the
        ;; pair at 3e3f9748 while #761 landed the next resync of the copy alone
        ;; minutes apart -- each green on its own base, the merge red, and
        ;; nothing ran the comparing test on the combination until it was main.
        ;;
        ;; Nothing under `src/` ever read the resource (measured 2026-09-03),
        ;; and the `bin/amu` JDK-free route has no classpath reader at all --
        ;; which is why `definition-identity/profile-version` repeats the
        ;; number as a constant. So the copy's only effect was deciding which
        ;; grammar the frontend read. With it deleted, THE GRAMMAR AND THE
        ;; FRONTEND TRAVEL IN ONE PIN: a pin left behind is an older language
        ;; compiled coherently, not a frontend reading a grammar it was not
        ;; built against.
        ;;
        ;; Pin held at df383ba0 across that deletion: kotoba-sema @df383ba0's
        ;; grammar is byte-identical to the copy that was deleted, so the
        ;; digest below did not move and the deletion changed no bytes the
        ;; compiler reads.
        ;;
        ;; THE GRAMMAR, MEASURED -- these two lines are PARSED by
        ;; `guest_grammar_vendor_test/deps-edn-claim`, which recomputes the
        ;; digest of the copy on the classpath and refuses if this comment and
        ;; the file disagree. Before that test existed this comment drifted: it
        ;; read 3e3f9748 while the file on disk hashed to 67561e57, and nothing
        ;; said so.
        ;;
        ;;   grammar-sha256    871f3873ae30a33ba7461c8664094b42396c0c4d79612668d11b0b29a2c0172f
        ;;   kotoba-sema-pin   63d76616e35347dacc8db57a81a6d58cca4ff633
        ;;
        ;; `guest_grammar_vendor_test/authority-digest-history` ends with the
        ;; same digest, so the pin, the prose and the history move in one
        ;; commit or the suite goes red.
        ;;
        ;; Advanced 2026-09-03, df383ba0 -> 63d76616, and the grammar moved with
        ;; it (6e1202fd -> 871f3873) -- which is the case the history vector was
        ;; written for, so 871f3873 is APPENDED there rather than substituted.
        ;; What the advance buys, and why it is not optional:
        ;;
        ;;  - 72c2577 gives `peek`, `pop`, `keys` and `vals` primitives. Without
        ;;    it the frontend answers all four with `operation has no admitted
        ;;    lowering`, measured on the old pin at exit 65.
        ;;  - c0dfa84 refuses a malformed top-level declaration instead of
        ;;    crashing on its name. `(defn 42 [] 0)` was an exit-70 internal
        ;;    compiler error on the old pin, measured; it is a diagnostic now.
        ;;  - b43d3fb refuses a declaration that compiled and was then silently
        ;;    dropped.
        ;;  - 63d76616 resyncs kotoba-sema's copy of
        ;;    `lang/capability-catalog.edn` from the authority. THIS
        ;;    REPOSITORY'S copy of that same authority, at
        ;;    `resources/kotoba/lang/capability-catalog.edn`, SHADOWS
        ;;    kotoba-sema's on this classpath, so it is resynced in this commit
        ;;    too -- FROM THE AUTHORITY, not from kotoba-sema. It carries
        ;;    `:screen/observe` (31) and `:screen/act` (32), which kotoba-sema
        ;;    c823461 had added to its own vendored copy while the authority
        ;;    named neither; resyncing the shadowing copy from the copy it
        ;;    shadows would have carried that misplacement into a third
        ;;    repository (kotoba-lang 5b54e5e3, ADR-2609031100).
        io.github.kotoba-lang/kotoba-sema
        {:git/url "https://github.com/kotoba-lang/kotoba-sema.git"
         :git/sha "63d76616e35347dacc8db57a81a6d58cca4ff633"}
        ;; ADR-2607266000 Phase B: these responsibilities moved out of this repo.
        ;;
        ;; The slice-value stream held this pin on purpose (ADR 0314), because
        ;; kotoba-kir 984a507 ("control effects bridge through as keywords, so
        ;; `:abort` reaches the sealed row") and this repository's
        ;; `definition_identity_test` (ADR 0300, "`:abort` names no authority,
        ;; so the bridge has no catalog keyword for it and refuses") decided the
        ;; same question in opposite directions on 2026-09-02, and it said the
        ;; pin waits for that adjudication rather than forcing it.
        ;;
        ;; ADJUDICATED 2026-09-02, in kotoba-kir's favour, and this advance is
        ;; that adjudication rather than a stream forcing past it. Three reasons:
        ;;
        ;;  - kotoba-lang lang/code-identity.edn names
        ;;    :kotoba.kir/definition-identity the :authority for what a sealed
        ;;    row contains. ADR 0300 described that authority's behaviour; it did
        ;;    not own it.
        ;;  - the row is part of the sealed INTERFACE, and a function that can
        ;;    leave its caller by aborting has interface `[:result T E]` where
        ;;    one that cannot has `T`. Those are two definitions. Refusing to
        ;;    identify either is not neutral between them.
        ;;  - the refusal identified NOTHING in an aborting module, so every
        ;;    such module was unidentified and uncacheable. Identifying them
        ;;    differently is strictly more information than identifying neither.
        ;;
        ;; The 8 assertions ADR 0314 measured are not deleted. Four now state
        ;; what is true of `:abort`, and the refusal path they used to reach --
        ;; :unbridged-effect, :dependency-unavailable, SCANNED 0/2, the REFUSED
        ;; listing -- is reached by a synthetic module carrying a wire id no
        ;; catalog entry names, which is the only remaining unbridgeable row.
        ;;
        ;; The advance itself is required by this stream and not optional:
        ;; kotoba.kir.alpha-normalization, the single five-binder walk that
        ;; kotoba-lang lang/code-identity.edn :ci8 named as the fix for the walk
        ;; being implemented twice, exists only at afd117d2 and later.
        ;;
        ;; Advanced again 2026-09-03 (ADR 0330) to b2e5d9c. d809f28 adds the
        ;; four codebook dequant formats and their six grid tables and 268e28b
        ;; the fused dequantize-and-dot oracle -- that oracle is the answer the
        ;; QEMU K-quant smoke compares its eight digits against, so without this
        ;; pin `AIUEOS_DEQUANT_KQUANT_QEMU_OK` has nothing to disagree with.
        ;; 18f7c3a makes the sealed control-effect vocabulary this repository's
        ;; export rather than something the compiler re-derives.
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         ;; fuel64: 233bd6bb exports `max-fuel` (kotoba-kir ADR 0268), the fuel
         ;; ceiling `kotoba.compiler.nbb.cli` and `kotoba.verifier` now read.
         ;; Advanced by this stream and independently adopted by #767, so the
         ;; SHA below is main's as well as this branch's -- only the reason was
         ;; missing from main.
         ;;
         ;; Advanced 2026-09-03, 233bd6bb -> b021a0d1, for 41341bd: the five
         ;; collection primitives. THIS PIN IS NOT OPTIONAL WHEN THE KOTOBA-SEMA
         ;; PIN MOVES, and the failure is specific enough to be worth naming --
         ;; measured with the kotoba-sema pin advanced and this one left behind,
         ;; the frontend ADMITS `pop` and KIR then traps `:unknown-function`.
         ;; A frontend that admits a head its lowering has never heard of is a
         ;; worse state than either pin alone: the refusal moves from compile
         ;; time to run time. The two pins move in one commit.
         :git/sha "b021a0d179fb983e8ad7da702252cfa764cd2fc2"}
        ;; The frontend is an HIR producer and KIR lowering is its consumer;
        ;; both validate the same checked envelope.
        io.github.kotoba-lang/kotoba-hir
        {:git/url "https://github.com/kotoba-lang/kotoba-hir.git"
         :git/sha "ac8e70514ee3c9b87ae71324e6e714447acc971c"}
        io.github.kotoba-lang/kotoba-object
        {:git/url "https://github.com/kotoba-lang/kotoba-object.git"
         :git/sha "9b53a444cfe5550af6b76eef494b4190b5e4e461"}
        ;; 9007989 pins the context ABI v4 loader identity for both hosts.
        ;; A loader source hash is what binds an artifact to the host that can
        ;; run it, so this pin and tools/kexe_loader.c move in the same commit
        ;; or execution refuses before the guest starts.
        io.github.kotoba-lang/artifact
        {:git/url "https://github.com/kotoba-lang/artifact.git"
         :git/sha "912ca0d60f4a9b5d3617a43d1d42560477d7894f"}
        ;; HELD at 1a2e10c on 2026-09-03 (ADR 0331), 28 commits behind its main,
        ;; while every other pin in this file moved to the tip. The reason, so
        ;; that a lagging pin and a pin with an argument behind it stay
        ;; distinguishable from the outside:
        ;;
        ;; io-ipld 01b6453 makes the DAG-CBOR DECODER enforce canonical form.
        ;; `ipld-adl-test/guest-output-must-be-canonical-dag-cbor` proves the
        ;; opposite layering -- that a guest can emit bytes which decode cleanly
        ;; and are STILL refused, because only re-encoding shows the codec would
        ;; have written something shorter. Its fixture is `18 05`, a non-minimal
        ;; encoding of 5. Measured at 48ba404 that fixture stops reaching the
        ;; ADL check at all: the decoder refuses first, so the case answers
        ;; `:adl-output-not-a-node` and `:adl-output-not-canonical` is left with
        ;; no input that can produce it.
        ;;
        ;; Making the test expect the new code would leave this repository with
        ;; a refusal nothing can trigger -- a check that cannot fire, which is
        ;; the shape ADR-2608136000 exists to refuse. Deciding whether the ADL
        ;; canonicality check is genuinely subsumed by the decoder, or whether a
        ;; non-canonical form still exists that decodes at 48ba404, is a
        ;; question for io-ipld's owner and not for a pin-consolidation commit.
        ;; Nothing in the K16 native programme depends on this advance.
        io.github.kotoba-lang/io-ipld
        {:git/url "https://github.com/kotoba-lang/io-ipld.git"
         :git/sha "1a2e10cf8038155de210357e637eac4102de89cb"}
        io.github.kotoba-lang/kotoba-wasm
        {:git/url "https://github.com/kotoba-lang/kotoba-wasm.git"
         :git/sha "cc23ea35bc284d08cf5fc2f57dfcc10ce431a23b"}
        ;; Production KIR routes exclusively through whole-module
        ;; GMIR/MIR/allocated-MC, including word/f64/memory/runtime/capability,
        ;; literal-data, scalar variant, word-field record, and x86 privileged
        ;; operations. Aggregate ABI v7 carries recursively nested record
        ;; handles, record-payload variants, sealed ordinal callable dispatch,
        ;; bounded apply, and closed linkage evidence. Multiple exports share
        ;; one selected layout; IR rejection has no production legacy-emitter
        ;; fallback.
        ;; Terminal local calls release the current frame and branch without
        ;; linking on both native ISAs; kernel ELF contexts preserve the
        ;; artifact's sealed fuel bound.
        ;; ADR-0278: kotoba-native 704d02e carries allocator-explicit AArch64
        ;; self reentry on top of merged virtual MIR branch fusion and
        ;; post-allocation per-basic-block scheduling with WAR/WAW dependency
        ;; edges, preserved-register reuse, and the NBB BigInt immediate guard.
        ;; Eligible AArch64 self-tail edges simultaneously update their exact
        ;; allocated parameter homes and re-enter after one-time argument
        ;; materialization. Backed/incomplete sites retain the public ABI path;
        ;; every recur still recharges fuel. x86 retains its independently
        ;; qualified teardown path.
        ;; Call-crossing loop parameters stay in preserved registers instead of
        ;; storing and loading them on every iteration on both targets. A
        ;; proven adjacent AArch64 zero-equality branch is fused while virtual
        ;; SSA identity is available, removing both definitions before RA and
        ;; emitting one direct CBNZ. A unique-use integer producer in one closed
        ;; self-recur suffix may write an interference-free parameter home
        ;; directly; call-crossing and ambiguous sites keep the parallel-copy
        ;; fallback. x86 retains its canonical TEST/JZ path. A profitable
        ;; AArch64 constant may use one logical-immediate seed plus one MOVK;
        ;; the closed selector has no global index and probes at most the four
        ;; lanes under each of the zero/full replacement hypotheses.
        ;; cdf7b45 adds AArch64 quotient/remainder MSUB fusion; ADR-0280
        ;; measures that pin through the common native artifact ABI. 1281ec5
        ;; bulk-precharges exact counted recurrences containing only proven
        ;; pure nontrapping leaf calls, retaining a charged negative copy, and
        ;; rotates their direct recur latch to a bottom conditional branch.
        ;; effaba5 hoists an exact invariant identity argument on that hot edge;
        ;; instrumented and otherwise unproven paths retain materialization.
        ;; 7eb4072 adds a measured latency arm to the Mersenne decision: one
        ;; serial remainder chain takes the shifted SUB+ADD form (+2.6%
        ;; measured); independent lanes keep MSUB (-5.1% measured the other
        ;; way). The chain test is order-independent value reachability with
        ;; occurrences named by position. 8b78230 reads the constant-divisor
        ;; quotient's sign correction from the unshifted value, in parallel
        ;; with the shift (+4.2% measured on the narrow chain, parity with
        ;; Clang's emission of the semantic twin).
        ;; 1fd9c22 (via kotoba-mir 8a2bc4d) sends straight-line call
        ;; functions through the linear scanner: call-crossing values live in
        ;; preserved registers instead of stable slots (+6.66% measured on
        ;; the qualified call fixture).
        ;; 689757a parks an AArch64 leaf's spill slots in caller-saved SIMD
        ;; registers (+3.21% measured on the deep-spill fixture; fail-closed
        ;; to the stack shape for calls, >16 slots, or non-AArch64).
        ;; 5b5d0d5 ports the parallel sign correction to x86 (RDX copy of the
        ;; unshifted value before SAR, so SAR and SHR run in parallel).
        ;; a59b8b2 elides a quotient's RAX/RDX saves when provably dead
        ;; (straight-line scan, fail-closed).
        ;; 0daafbf brings the two `elf64` twins into agreement about FUEL, not
        ;; just about the entry table db7b711 settled. The `.clj` the JVM loads
        ;; was missing `ecdsa-fuel?` and `dhcp-fuel?`, so it under-fuelled three
        ;; shipping aiueos objects -- ecdsa by 8.6x and both DHCP objects by 64x
        ;; -- and the shipped bytes prove the portable file was the right one.
        ;; Found only by comparing the two routes' output, because no single
        ;; runtime can load both files.
        ;; 4a4c4c3 lowers `vector-alloc` (context slot 200) and
        ;; `vector-assoc!` (slot 208) on both ISAs, via kotoba-gmir 682a0d5
        ;; (the arities) and kotoba-mir 9b3a42e (the offsets). Superproject
        ;; ADR-2609010200.
        ;;
        ;; Advanced 2026-09-03 (ADR 0330) past 44 commits that had accumulated
        ;; behind this one pin while every K16 stream was told the amu bump was
        ;; batched. Containment was checked with `compare` per stream, not
        ;; assumed:
        ;;   279fbc3  a bounded store answers with the word it STORED, not with
        ;;            the incoming base (x86) or a register nothing wrote
        ;;            (aarch64).
        ;;   da3593b5 kernel-read-cr4 / kernel-write-cr4 / kernel-xsetbv.
        ;;            Without these `AIUEOS_DOT_F32_QEMU_OK` was
        ;;            `COULD-NOT-RUN compile-failed ... aggregate ABI rejected:
        ;;            call-abi-not-admitted` against this repository's main,
        ;;            and reproduced only against an unlanded branch.
        ;;   a727bf7  six RTL8125 driver symbols and the FIFO-drain fuel tier.
        ;;   1baa450  three SHA-256 symbols for a message arriving in pieces.
        ;;   70984ea / 2c4d6c3 / 449792d  the Qwen3.5 export names and the
        ;;            measured fuel tiers for the second and third tranches.
        ;;   1072816 / bbeed36 / a63faa6  Q4_K and Q6_K EMIT (thirty-two groups
        ;;            unrolled) and the four codebook formats refused BY NAME.
        ;;            This is what `AIUEOS_DEQUANT_KQUANT_QEMU_OK` needs.
        ;;   91033a9  the writable region is an lea, a function's address is a
        ;;            label.
        ;;   d710558  a reentry parameter's home is stored inside the loop.
        ;; The advance carries kotoba-gmir fe23816 -> 323bfc0, kotoba-mir
        ;; e266a86 -> 0bb174c and kotoba-codegen 68d409f -> 3a7d7fc with it;
        ;; those three are transitive here and only deps-lock.edn names them.
        io.github.kotoba-lang/kotoba-native
        {:git/url "https://github.com/kotoba-lang/kotoba-native.git"
         ;; fuel64: c31cf87b widens the object replenish to a 64-bit budget
         ;; (kotoba-native ADR 0078) and exports `max-object-fuel`. No shipped
         ;; object's bytes move -- 108 digests taken before the change are
         ;; re-derived by that repo's suite; and ADR 0079, where `package-user`
         ;; read the constant 512 instead of the declared budget -- the same
         ;; defect this repo's PE32+ packager had. Fast-forward from the pin
         ;; main now carries (452422f): ahead 5, behind 0.
         ;;
         ;; fwstore: and adeb1b0f, which is kotoba-native's MAIN and contains
         ;; fuel64's 95361f3f -- the `:uefi-alloc-region` lowering landed on
         ;; top of it (kotoba-native ADR-0080). Taking 95361f3f here would
         ;; leave this compiler admitting a head in the frontend with no
         ;; encoding behind it, which is the gap AMU-PINS measured and which
         ;; aiueos main now has a CONSUMER for.
         :git/sha "adeb1b0fa5bcd2dd18a657c7e3bd3c4acbd630ae"}
        io.github.kotoba-lang/kotoba-component
        {:git/url "https://github.com/kotoba-lang/kotoba-component.git"
         :git/sha "68acc7237aec7b24b683304db8e87d14ec1be745"}
