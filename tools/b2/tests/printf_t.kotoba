;; ---- refusal runs ----------------------------------------------------------------------------------------------------
(defn- t-refuse [m :i64 which :i64] :i64
  (let [z (t-fill m)
        fp (t-fmt m 0 (case which
                        2 "%d %f"
                        3 "%d%n"
                        4 "%1$d"
                        5 "%ls"
