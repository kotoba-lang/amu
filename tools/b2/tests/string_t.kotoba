;; ---- the fortified variants that must not refuse ----
(defn- ts-chk [] :i64
  (let [d (ts-buf 7168) s (ts-buf 6144)
        a (ts-seq s 10 1)
        b (ts-set d 24 0x5a)
        r1 (cx-__memcpy_chk-GLIBC_2.3.4 d s 10 10)
        t1 (ts-int "memcpy_chk-ret" r1 d)
        t2 (ts-int "memcpy_chk-exact-data" (ts-diff d s 10) 0)
