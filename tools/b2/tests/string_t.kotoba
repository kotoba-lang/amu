;; ---- ctype ----
(defn- ts-tolower-model [i :i64] :i64
  (let [c (bit-and i 255)] (if (and (>= c 65) (<= c 90)) (+ c 32) c)))
(defn- ts-ctype-bad [tab :i64] :i64
  (loop [i -128 bad 0]
    (if (> i 255) bad
      (recur (inc i) (if (= (l32 (+ tab (* 4 i))) (ts-tolower-model i)) bad (inc bad))))))
(defn- ts-ctype [] :i64
  (let [t0 (ts-int "ctype-lazy-before" (st str-ST-CTYPE-FLAG) 0)
        loc (cx-__ctype_tolower_loc-GLIBC_2.3)
        t1 (ts-int "ctype-lazy-after" (st str-ST-CTYPE-FLAG) 1)
        t2 (ts-int "ctype-cell-in-state" (- loc (kxrt-b-state)) 5632)
        tab (l64 loc)
        t3 (ts-int "ctype-table-middle" (- tab (kxrt-b-state)) 4608)
        loc2 (cx-__ctype_tolower_loc-GLIBC_2.3)
        t4 (ts-int "ctype-stable-cell" loc2 loc)
        t5 (ts-int "ctype-stable-table" (l64 loc2) tab)
        t6 (ts-int "ctype-A" (l32 (+ tab (* 4 65))) 97)
        t7 (ts-int "ctype-Z" (l32 (+ tab (* 4 90))) 122)
        t8 (ts-int "ctype-at" (l32 (+ tab (* 4 64))) 64)
        t9 (ts-int "ctype-bracket" (l32 (+ tab (* 4 91))) 91)
        t10 (ts-int "ctype-a" (l32 (+ tab (* 4 97))) 97)
        t11 (ts-int "ctype-nul" (l32 tab) 0)
        t12 (ts-int "ctype-127" (l32 (+ tab (* 4 127))) 127)
        t13 (ts-int "ctype-128" (l32 (+ tab (* 4 128))) 128)
        t14 (ts-int "ctype-255" (l32 (+ tab (* 4 255))) 255)
        t15 (ts-int "ctype-minus-1" (l32 (- tab 4)) 255)
        t16 (ts-int "ctype-minus-128" (l32 (- tab 512)) 128)
        t17 (ts-int "ctype-minus-61" (l32 (- tab 244)) 195)
        t18 (ts-int "ctype-minus-127" (l32 (- tab 508)) 129)
        t19 (ts-int "ctype-all-384-entries" (ts-ctype-bad tab) 0)]
    0))

;; ---- strtol ----
(def ts-MAX 0x7FFFFFFFFFFFFFFF)
(defn- ts-min [] :i64 (- (- 0 ts-MAX) 1))

;; value want, end offset wend
(defn- ts-tol [tag :string s :string base :i64 want :i64 wend :i64] :i64
  (let [p (ts-str 8192 s)
        e (ts-buf 8000)
        z (s64 e 12345)
        v (cx-__isoc23_strtol-GLIBC_2.38 p e base)
        name (string-concat "strtol-" tag)
        t1 (ts-int (string-concat name "-val") v want)
        t2 (ts-int (string-concat name "-end") (- (l64 e) p) wend)]
    0))
;; the whole string is consumed
(defn- ts-tola [tag :string s :string base :i64 want :i64] :i64
  (ts-tol tag s base want (string-length s)))

(defn- ts-strtol-a [] :i64
  (let [t1 (ts-tola "dec" "123" 10 123)
        t2 (ts-tola "auto-dec" "123" 0 123)
        t3 (ts-tola "neg" "-123" 10 -123)
        t4 (ts-tola "plus" "+123" 10 123)
        t5 (ts-tol "trailing" "  42xyz" 10 42 4)
        t6 (ts-tola "hex0" "0x1f" 0 31)
        t7 (ts-tola "hex16" "0x1f" 16 31)
        t8 (ts-tola "hex-upper-prefix" "0X1F" 16 31)
        t9 (ts-tola "hex-no-prefix" "1f" 16 31)
        t10 (ts-tola "oct0" "017" 0 15)
        t11 (ts-tola "oct8" "017" 8 15)
        t12 (ts-tola "dec10-leading-zero" "017" 10 17)
        t13 (ts-tol "oct-bad-digit" "0189" 0 1 2)
        t14 (ts-tola "bin0" "0b101" 0 5)
        t15 (ts-tola "bin2" "0b101" 2 5)
        t16 (ts-tola "bin-upper" "0B11" 0 3)
        t17 (ts-tol "bin-prefix-no-digit" "0b" 0 0 1)
        t18 (ts-tol "hex-prefix-no-digit" "0x" 0 0 1)
        t19 (ts-tol "hex16-prefix-no-digit" "0x" 16 0 1)
        t20 (ts-tol "hex-prefix-g" "0xg" 16 0 1)
        t21 (ts-tol "x-in-dec" "0x" 10 0 1)
        t22 (ts-tol "neg-hex-prefix-no-digit" "-0x" 0 0 2)
        t23 (ts-tol "bin-prefix-bad-digit" "0b2" 2 0 1)
        t24 (ts-tola "b-is-a-hex-digit" "0b1" 16 177)
        t25 (ts-tol "b-in-dec" "0b1" 10 0 1)
        t26 (ts-tola "z36" "zz" 36 1295)
        t27 (ts-tola "Z36" "ZZ" 36 1295)
        t28 (ts-tola "mixed-case-36" "Zz" 36 1295)
        t29 (ts-tol "base2-stops" "12" 2 1 1)
        t30 (ts-tola "neg-hex" "-0x1f" 0 -31)
        t31 (ts-tola "hex-upper-x-base0" "0XFF" 0 255)]
    0))

(defn- ts-strtol-b [] :i64
  (let [t1 (ts-tol "no-digit-base8" "9" 8 0 0)
        t2 (ts-tol "empty" "" 10 0 0)
        t3 (ts-tol "only-spaces" "   " 10 0 0)
        t4 (ts-tol "sign-only" "  -" 10 0 0)
        t5 (ts-tol "alpha" "abc" 10 0 0)
        t6 (ts-tola "neg-zero" "-0" 10 0)
        t7 (ts-tola "zero-base0" "0" 0 0)
        t8 (ts-tol "08-base0" "08" 0 0 1)
        t9 (ts-tol "underscore" "1_000" 10 1 1)
        t10 (ts-tol "plus-minus" "+-5" 10 0 0)
        t11 (ts-tol "sign-space" "- 5" 10 0 0)
        t12 (ts-tola "leading-zeros" "00000000000000000000123" 10 123)
        t13 (ts-tola "neg-max" "-9223372036854775807" 10 (+ (ts-min) 1))
        t14 (ts-tola "max" "9223372036854775807" 10 ts-MAX)
        t15 (ts-tola "max-plus-1" "9223372036854775808" 10 ts-MAX)
        t16 (ts-tola "min" "-9223372036854775808" 10 (ts-min))
        t17 (ts-tola "min-minus-1" "-9223372036854775809" 10 (ts-min))
        t18 (ts-tol "huge-skips-all-digits" "99999999999999999999999xyz" 10 ts-MAX 23)
        t19 (ts-tola "neg-huge" "-99999999999999999999999" 10 (ts-min))
        t20 (ts-tola "hex-max" "0x7fffffffffffffff" 0 ts-MAX)
        t21 (ts-tola "hex-max-plus-1" "0x8000000000000000" 0 ts-MAX)
        t22 (ts-tola "hex-min" "-0x8000000000000000" 0 (ts-min))
        t23 (ts-tola "hex-huge" (string-concat "0x" (ts-rep "f" 18)) 16 ts-MAX)
        t24 (ts-tola "bin-62-ones" (ts-rep "1" 62) 2 (- (i64-shift-left 1 62) 1))
        t25 (ts-tola "bin-63-ones" (ts-rep "1" 63) 2 ts-MAX)
        t26 (ts-tola "bin-64-ones" (ts-rep "1" 64) 2 ts-MAX)
        t27 (ts-tola "bin-2-pow-63" (string-concat "1" (ts-rep "0" 63)) 2 ts-MAX)
        t28 (ts-tola "bin-neg-2-pow-63" (string-concat "-1" (ts-rep "0" 63)) 2 (ts-min))
        t29 (ts-tola "base36-huge" (ts-rep "z" 14) 36 ts-MAX)
        t30 (ts-tola "bin-prefix-62-ones" (string-concat "0b" (ts-rep "1" 62)) 0 (- (i64-shift-left 1 62) 1))
        t31 (ts-tola "oct-max" (string-concat "0" (ts-rep "7" 21)) 0 ts-MAX)
        t32 (ts-tola "oct-over" (string-concat "01" (ts-rep "0" 21)) 0 ts-MAX)]
    0))

(defn- ts-strtol-c [] :i64
  (let [p (ts-buf 8192)
        e (ts-buf 8000)
        a (ts-set p 16 0)
        b0 (s8 p 32)
        b1 (s8 (+ p 1) 9)
        b2 (s8 (+ p 2) 10)
        b3 (s8 (+ p 3) 11)
