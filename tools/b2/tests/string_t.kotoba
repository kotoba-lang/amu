        v (cx-__isoc23_strtol-GLIBC_2.38 p e 10)
        t1 (ts-int "strtol-whitespace-set-val" v 7)
        t2 (ts-int "strtol-whitespace-set-end" (- (l64 e) p) 8)
        c1 (s8 p 14)
        v2 (cx-__isoc23_strtol-GLIBC_2.38 p e 10)
        t3 (ts-int "strtol-0x0e-not-space-val" v2 0)
        t4 (ts-int "strtol-0x0e-not-space-end" (- (l64 e) p) 0)
        c2 (s8 p 8)
        v3 (cx-__isoc23_strtol-GLIBC_2.38 p e 10)
        t5 (ts-int "strtol-0x08-not-space-end" (- (l64 e) p) 0)
        c3 (s8 p 160)
        v4 (cx-__isoc23_strtol-GLIBC_2.38 p e 10)
        t6 (ts-int "strtol-0xa0-not-space-end" (- (l64 e) p) 0)
        n (ts-str 8192 "  77")
        v5 (cx-__isoc23_strtol-GLIBC_2.38 n 0 10)
        t7 (ts-int "strtol-endptr-null" v5 77)
        v6 (cx-__isoc23_strtol-GLIBC_2.38 (ts-str 8192 "0x1f") 0 0)
        t8 (ts-int "strtol-endptr-null-hex" v6 31)
        v7 (cx-__isoc23_strtol-GLIBC_2.38 (ts-str 8192 "ff") e 4294967312)
        t9 (ts-int "strtol-base-high-bits-val" v7 255)
        t10 (ts-int "strtol-base-high-bits-end" (- (l64 e) (ts-buf 8192)) 2)
        v8 (cx-__isoc23_strtol-GLIBC_2.38 (ts-str 8192 "z") e 4294967332)
        t11 (ts-int "strtol-base-36-high-bits" v8 35)
        v9 (cx-__isoc23_strtol-GLIBC_2.38 (ts-str 8192 "11") e 4294967296)
        t12 (ts-int "strtol-base-0-high-bits" v9 11)]
    0))

;; ---- driver ----
(defn- ts-unknown [a :i64] :i64
  (let [w (warn (string-concat "args FAIL unknown argument " (c-str a)))]
    (sys1 SYS-EXIT-GROUP 2)))
;; one call that must be refused; the program exits inside it
(defn- ts-refusal-call [a :i64] :i64
  (let [p (ts-buf 0) q (ts-buf 1024)
        z (ts-set p 64 0x5a)
        y (ts-set q 64 0x5a)]
    (cond (c-eq? a "overflow-memcpy") (cx-__memcpy_chk-GLIBC_2.3.4 p q 11 10)
          (c-eq? a "overflow-memset") (cx-__memset_chk-GLIBC_2.3.4 p 0 9 8)
          (c-eq? a "overflow-strncpy") (cx-__strncpy_chk-GLIBC_2.3.4 p (ts-str 2048 "a") 9 8)
          (c-eq? a "overflow-strcat") (cx-__strcat_chk-GLIBC_2.3.4 (ts-str 3072 "ab") (ts-str 4096 "cd") 4)
          (c-eq? a "overflow-strncat") (cx-__strncat_chk-GLIBC_2.3.4 (ts-str 3072 "ab") (ts-str 4096 "cdef") 3 5)
          (c-eq? a "invalid-base") (cx-__isoc23_strtol-GLIBC_2.38 (ts-str 3072 "12") 0 37)
          (c-eq? a "invalid-base-1") (cx-__isoc23_strtol-GLIBC_2.38 (ts-str 3072 "12") 0 1)
          (c-eq? a "memcpy-huge") (cx-memcpy-GLIBC_2.14 p q (- 0 1))
          (c-eq? a "strtok-null") (cx-strtok_r-GLIBC_2.2.5 0 (ts-str 3072 ",") (ts-buf 7000))
          :else (ts-unknown a))))
(defn- ts-refusal [a :i64] :i64
  (let [r (ts-refusal-call a)
        w (say (string-concat (c-str a) " FAIL returned without a refusal"))]
    1))

(defn- ts-all [] :i64
  (let [a (ts-memset) b (ts-memcpy) c (ts-memmove) d (ts-strlen) e (ts-strcmp) f (ts-strncmp)
        g (ts-strchr) h (ts-strrchr) i (ts-strstr) j (ts-strncpy) k (ts-strncat) l (ts-strcspn)
        m (ts-strtok) n (ts-strtok2) o (ts-chk) p (ts-chk2) q (ts-ctype)
        r (ts-strtol-a) s (ts-strtol-b) t (ts-strtol-c)
        fails (st ts-FAILS)
        u (if (= fails 0) (ts-ok "all") (ts-fail "all" (string-concat "failures=" (dec-str fails))))]
    (if (= fails 0) 0 1)))

(defn main [] :i64
  (let [m (st! ts-BUFP (kxrt-b-alloc 16384))]
    (if (> (kxrt-b-argc) 0)
      (ts-refusal (l64 (kxrt-b-argv)))
      (ts-all))))
