        c (ts-set d 24 0x5a)
        r2 (cx-__memcpy_chk-GLIBC_2.3.4 d s 10 (- 0 1))
        t4 (ts-int "memcpy_chk-unknown-size" (ts-diff d s 10) 0)
        r3 (cx-__memcpy_chk-GLIBC_2.3.4 d s 0 0)
        t5 (ts-int "memcpy_chk-zero" r3 d)
        e (ts-set d 24 0x5a)
        r4 (cx-__memset_chk-GLIBC_2.3.4 d 113 8 8)
        t6 (ts-int "memset_chk-ret" r4 d)
        t7 (ts-mem "memset_chk-exact" d 12 (ts-cat3 (ts-rep "71" 8) (ts-rep "5a" 4) ""))
        r5 (cx-__memset_chk-GLIBC_2.3.4 d 114 3 (- 0 1))
        t8 (ts-mem "memset_chk-unknown-size" d 5 "7272727171")
        f (ts-set d 24 0x5a)
        g (ts-str 6656 "abc")
        r6 (cx-__strncpy_chk-GLIBC_2.3.4 d g 6 6)
        t9 (ts-int "strncpy_chk-ret" r6 d)
        t10 (ts-mem "strncpy_chk-pad" d 8 (string-concat "616263000000" "5a5a"))
        h (ts-set d 24 0x5a)
        r7 (cx-__strncpy_chk-GLIBC_2.3.4 d g 4 (- 0 1))
        t11 (ts-mem "strncpy_chk-unknown-size" d 6 (string-concat "61626300" "5a5a"))]
    0))
(defn- ts-chk2 [] :i64
  (let [d (ts-buf 7168)
        a (ts-set d 24 0x5a)
        b (put-str d "ab")
        s (ts-str 6144 "cd")
