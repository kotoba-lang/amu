(ns kexe-loader-names
  {:kotoba/export [trap-line value-trap-name result-type-name boundary-kind-name boundary-reason-name]})

;; The fixed text of every trap the POSIX kexe loader names, and the result
;; type names it admits (superproject adr-2609251400 C1, kind (a): DATA).
;; scripts/gen-loader-decisions.cljk evaluates these natively and writes the
;; answers into the generated region of tools/kexe_loader.c, where signal
;; handlers and the supervisor index them. A separate module from
;; kexe_loader_decisions.kotoba so the machine code the loader EXECUTES
;; (that module's) does not carry these strings as dead weight.

;; ---------------------------------------------------------------------
;; Trap names. Every KEXE_TRAP line the loader prints whose text is
;; fixed. The index is the generator's (KEXE_TRAP_LINE_* in C).

(defn trap-line [k] :string
  (cond
    (= k 0) "KEXE_TRAP {:kind :signal :signal :SIGILL}\n"
    (= k 1) "KEXE_TRAP {:kind :signal :signal :SIGTRAP}\n"
    (= k 2) "KEXE_TRAP {:kind :signal :signal :SIGFPE}\n"
    (= k 3) "KEXE_TRAP {:kind :signal :signal :SIGBUS}\n"
    (= k 4) "KEXE_TRAP {:kind :signal :signal :SIGSEGV}\n"
    (= k 5) "KEXE_TRAP {:kind :signal :signal :SIGXCPU}\n"
    (= k 6) "KEXE_TRAP {:kind :signal :signal :SIGALRM}\n"
    (= k 7) "KEXE_TRAP {:kind :signal :signal :SIGSYS}\n"
    (= k 8) "KEXE_TRAP {:kind :signal :signal :unknown}\n"
    (= k 9) "KEXE_TRAP {:kind :host :reason :host/stack-exhausted}\n"
    (= k 10) "KEXE_TRAP {:kind :supervisor :reason :wall-timeout}\n"
    (= k 11) "KEXE_TRAP {:kind :supervisor :reason :unhandled-child-signal}\n"
    (= k 12) "KEXE_TRAP {:kind :budget :reason :budget/cells :arena :pairs}\n"
    (= k 13) "KEXE_TRAP {:kind :budget :reason :budget/cells :arena :vectors}\n"
    (= k 14) "KEXE_TRAP {:kind :budget :reason :budget/cells :arena :vector-items}\n"
    (= k 15) "KEXE_TRAP {:kind :budget :reason :budget/bytes :arena :string-pool}\n"
    (= k 16) "KEXE_TRAP {:kind :budget :reason :budget/cells :arena :kgraph}\n"
    (= k 17) "KEXE_TRAP {:kind :budget :reason :budget/fuel}\n"
    (= k 18) "KEXE_TRAP {:kind :result :reason :invalid-string-handle}\n"
    (= k 19) "KEXE_TRAP {:kind :result :reason :invalid-record-chain}\n"
    (= k 20) "KEXE_TRAP {:kind :result :reason :invalid-option-i64}\n"
    (= k 21) "KEXE_TRAP {:kind :result :reason :invalid-result-i64}\n"
    (= k 22) "KEXE_TRAP {:kind :result :reason :invalid-variant}\n"
    (= k 23) "KEXE_TRAP {:kind :arena :reason :vector-table-exhausted}\n"
    (= k 24) "KEXE_TRAP {:kind :arena :reason :vector-items-exhausted}\n"
    (= k 25) "KEXE_TRAP {:kind :sandbox :reason :filesystem-denied}\n"
    (= k 26) "KEXE_TRAP {:kind :sandbox :reason :network-denied}\n"
    (= k 27) "KEXE_TRAP {:kind :sandbox :reason :process-denied}\n"
    (= k 28) "KEXE_TRAP {:kind :value :reason :"
    ;; Capabilities refused BY NAME (exit :capability/refused, 126), the
    ;; same lines the Linux static image prints. 29..36 are kotoba-lang
    ;; lang/capability-catalog.edn :process/spawn :refusals :names in that
    ;; order (tools/linux_static_handlers.kotoba op 47 answers the index).
    (= k 29) "KEXE_TRAP {:kind :capability :capability :process/spawn :reason :spawn/argv-budget}\n"
    (= k 30) "KEXE_TRAP {:kind :capability :capability :process/spawn :reason :spawn/program-not-granted}\n"
    (= k 31) "KEXE_TRAP {:kind :capability :capability :process/spawn :reason :spawn/path-lookup-denied}\n"
    (= k 32) "KEXE_TRAP {:kind :capability :capability :process/spawn :reason :spawn/output-budget}\n"
    (= k 33) "KEXE_TRAP {:kind :capability :capability :process/spawn :reason :spawn/timeout}\n"
    (= k 34) "KEXE_TRAP {:kind :capability :capability :process/spawn :reason :spawn/exec-failed}\n"
    (= k 35) "KEXE_TRAP {:kind :capability :capability :process/spawn :reason :spawn/isolation-unavailable}\n"
    (= k 36) "KEXE_TRAP {:kind :capability :capability :process/spawn :reason :spawn/setup-failed}\n"
    (= k 37) "KEXE_TRAP {:kind :capability :capability :entropy/draw :reason :entropy/unavailable}\n"
    ;; The export boundary codec (tools/kexe_loader_boundary.kotoba): the
    ;; three result decodings it added, and the prefix of a refused argument
    ;; (the loader appends the reason name and ` :arg <i>}`).
    (= k 38) "KEXE_TRAP {:kind :result :reason :invalid-vector-i64}\n"
    (= k 39) "KEXE_TRAP {:kind :result :reason :invalid-bytes}\n"
    (= k 40) "KEXE_TRAP {:kind :result :reason :invalid-option-string}\n"
    (= k 41) "KEXE_TRAP {:kind :boundary :reason :"
    :else ""))

;; ABI v11 value traps: the index a refusing host call records, the name
;; osaho's reference interpreter and the ESM prelude give the same refusal.
;; 0 is "none recorded".
(defn value-trap-name [k] :string
  (cond
    (= k 1) "utf8/unexpected-continuation"
    (= k 2) "utf8/overlong"
    (= k 3) "utf8/invalid-byte"
    (= k 4) "utf8/truncated"
    (= k 5) "utf8/bad-continuation"
    (= k 6) "utf8/surrogate"
    (= k 7) "utf8/above-max"
    (= k 8) "string/too-large"
    (= k 9) "bytes/item-out-of-range"
    (= k 10) "bytes/too-large"
    (= k 11) "bytes/slice-bounds"
    :else ""))

;; The plain KEXE_RESULT_TYPE names a run may ask for (the `record:<n>` and
;; `variant:<n>:<mask>` forms are admitted by `decide` ops 3 and 4).
(defn result-type-name [k] :string
  (cond
    (= k 0) "i64"
    (= k 1) "string"
    (= k 2) "option-i64"
    (= k 3) "result-i64"
    ;; The export boundary codec's results (tools/kexe_loader_boundary.kotoba).
    (= k 4) "vector-i64"
    (= k 5) "bytes"
    (= k 6) "option-string"
    :else ""))

;; The declared argument kinds KEXE_ARG_TYPES may name, by the index
;; tools/kexe_loader_boundary.kotoba numbers them (0, undeclared, has no
;; spelling). A name not in this table is refused as
;; :boundary/unsupported-kind -- :vector-f64, maps, sets, :document and
;; handle-carrying records have no wire form.
(defn boundary-kind-name [k] :string
  (cond
    (= k 1) "i64"
    (= k 2) "bool"
    (= k 3) "string"
    (= k 4) "option-i64"
    (= k 5) "result-i64"
    (= k 6) "vector-i64"
    (= k 7) "bytes"
    (= k 8) "option-string"
    (= k 9) "record"
    (= k 10) "variant"
    :else ""))

;; A refused boundary argument's reason, by tools/kexe_loader_boundary.kotoba's
;; index (0 is admitted and has no name). The two budget names are the
;; reference interpreter's and the ESM prelude's.
(defn boundary-reason-name [k] :string
  (cond
    (= k 1) "boundary/forged-handle"
    (= k 2) "boundary/type-mismatch"
    (= k 3) "boundary/signature"
    (= k 4) "boundary/malformed"
    (= k 5) "boundary/value-too-large"
    (= k 6) "boundary/invalid-utf8"
    (= k 7) "boundary/not-a-bool"
    (= k 8) "boundary/arena"
    (= k 9) "budget/boundary-nodes"
    (= k 10) "budget/boundary-bytes"
    (= k 11) "boundary/unsupported-kind"
    :else ""))

