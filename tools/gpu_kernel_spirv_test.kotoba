(ns gpu-kernel-spirv-test (:export [main]))

;; Tests for tools/spirv_encode.kotoba, tools/spirv_check.kotoba and
;; tools/gpu_kernel_kir1.kotoba (ADR 0372 step 1). No GPU and no C++ tool:
;; scripts/seed/check-gpu-kernel-spirv.py builds the unit (this ns line, then
;; the three modules without their ns lines, then the rest of this file),
;; compiles it with an Amu-produced static compiler, runs it with a writable
;; :fs/app-data scope, and afterwards runs spirv-val and spirv-dis on the
;; written modules as oracles.
;;
;; main answers the number of failed cases and prints a FAIL line for each.
;; CASES equals the expect calls below (the script counts them). CONTROL 1
;; makes exactly one expectation wrong; the script requires one failure then.

(def CASES 33)
(def CONTROL 0)

(defn- say [s :string] :i64
  (let [x (typed-cap-call :io/write :string :string (string-concat s "\n"))] 0))

(defn- fail [what :string got :i64 want :i64] :i64
  (let [x (say (string-concat "FAIL " (string-concat what (string-concat " => " (string-concat (string-from-i64 got) (string-concat " ; want " (string-from-i64 want)))))))] 1))

(defn- expect [what :string got :i64 want :i64] :i64
  (if (= got want) 0 (fail what got want)))

;; a copy of M with word k (0-based) replaced by w
(defn- with-word [M :vector-i64 k :i64 w :i64] :vector-i64
  (let [n (vector-at M 0) C (vector-alloc (+ n 1))
        C1 (loop [i 0 V C] (if (> i n) V (recur (inc i) (vector-assoc! V i (vector-at M i)))))]
    (vector-assoc! C1 (+ k 1) w)))

;; a copy of M that keeps only its first c words
(defn- with-count [M :vector-i64 c :i64] :vector-i64
  (let [n (vector-at M 0) C (vector-alloc (+ n 1))
        C1 (loop [i 0 V C] (if (> i n) V (recur (inc i) (vector-assoc! V i (vector-at M i)))))]
    (vector-assoc! C1 0 c)))

(defn- same-words? [A :vector-i64 B :vector-i64] :bool
  (and (= (vector-at A 0) (vector-at B 0))
       (loop [i 1] (cond (> i (vector-at A 0)) true (not= (vector-at A i) (vector-at B i)) false :else (recur (inc i))))))

;; ---------------------------------------------------------------------
;; The module.

(defn- module-shape [] :i64
  (let [M (kir1-ewise 1 256)]
    (+ (expect "add wg256 checks" (spc-check M) 0)
       (expect "word count" (spv-count M) 251)
       (expect "magic" (spv-word M 0) 119734787)
       (expect "version 1.3" (spv-word M 1) 66304)
       (expect "bound" (spv-word M 3) 38)
       (expect "first instruction is Capability Shader" (spv-word M 6) 1)
       (expect "LocalSize x" (spv-word M 19) 256)
       (expect "the operator instruction is OpFAdd" (bit-and (spv-word M 231) 65535) 129)
       (expect "OpFDiv for div" (bit-and (spv-word (kir1-ewise 4 64) 231) 65535) 136)
       (expect "same input, same words" (if (same-words? M (kir1-ewise 1 256)) 1 0) 1)
       (expect "different operator, different words" (if (same-words? M (kir1-ewise 3 256)) 1 0) 0))))

;; every operator at two workgroup sizes, written into the scope
(defn- written [] :i64
  (loop [o 1 bad 0]
    (if (> o 4) bad
      (let [a (kir1-ewise o 64) b (kir1-ewise o 256)
            pa (string-concat "kir1-ewise-" (string-concat (kir1-operator-name o) "-wg64.spv"))
            pb (string-concat "kir1-ewise-" (string-concat (kir1-operator-name o) "-wg256.spv"))]
        (recur (inc o)
               (+ bad (+ (expect pa (spc-check a) 0) (+ (expect pb (spc-check b) 0)
                      (+ (expect (string-concat "write " pa) (spv-write a pa) 1004)
                         (expect (string-concat "write " pb) (spv-write b pb) 1004))))))))))

(defn- invalid-parameters [] :i64
  (+ (expect "operator 5" (kir1-ewise-error 5 256) 1)
     (expect "workgroup 3" (kir1-ewise-error 1 3) 2)
     (expect "workgroup 2048" (kir1-ewise-error 1 2048) 2)
     (expect "invalid gives an empty module" (spv-count (kir1-ewise 5 256)) 0)))

;; ---------------------------------------------------------------------
;; The checker refuses each problem by name. Word offsets are those of the
;; add/wg256 module (gpu_kernel_kir1.kotoba).

(defn- refusals [] :i64
  (let [M (kir1-ewise 1 256)]
    (+ (expect "short" (spc-check (with-count M 3)) 1)
       (expect "magic" (spc-check (with-word M 0 119734788)) 2)
       (expect "version 2.0" (spc-check (with-word M 1 131072)) 3)
       (expect "schema" (spc-check (with-word M 4 1)) 4)
       (expect "word count 0" (spc-check (with-word M 5 17)) 6)
       (expect "type after functions' rank" (spc-check (with-word M 170 131089)) 7)
       (expect "no capability" (spc-check (with-word M 5 131082)) 9)
       (expect "id at the bound" (spc-check (with-word M 3 37)) 11)
       (expect "id defined twice" (spc-check (with-word M 134 12)) 12)
       (expect "function without end" (spc-check (with-count M 250)) 13)
       (expect "label inside an open block" (spc-check (with-word M 245 131320)) (if (= CONTROL 1) 14 15))
       (expect "merge not before its branch" (spc-check (with-word M 205 262209)) 16)
       (expect "entry point names a type" (spc-check (with-word M 12 2)) 17)
       (expect "GLCompute without Shader" (spc-check (with-word M 6 2)) 18))))

(defn main [] :i64
  (let [failed (+ (module-shape) (written) (invalid-parameters) (refusals))
        x (say (string-concat "CASES " (string-from-i64 CASES)))
        y (say (string-concat "FAILED " (string-from-i64 failed)))]
    failed))
