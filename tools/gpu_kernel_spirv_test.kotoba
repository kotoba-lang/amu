(ns gpu-kernel-spirv-test (:export [main]))

;; Tests for tools/spirv_encode.kotoba, tools/spirv_check.kotoba and
;; tools/gpu_kernel_kir1.kotoba (ADR 0372 steps 1 and 2). No GPU and no C++ tool:
;; scripts/seed/check-gpu-kernel-spirv.py builds the unit (this ns line, then
;; the three modules without their ns lines, then the rest of this file),
;; compiles it with an Amu-produced static compiler, runs it with a writable
;; :fs/app-data scope, and afterwards runs spirv-val and spirv-dis on the
;; written modules as oracles. Before the run the script puts glslang's
;; modules of tools/gpu_kernel_refs/*.comp into the scope (ref-*.spv); the
;; checker must accept them too.
;;
;; main answers the number of failed cases and prints a FAIL line for each.
;; CASES equals the expect calls below (the script counts them). CONTROL 1
;; makes exactly one expectation wrong; the script requires one failure then.

(def CASES 75)
(def CONTROL 0)

(defn- say [s :string] :i64
  (let [x (typed-cap-call :io/write :string :string (string-concat s "\n"))] 0))

(defn- fail [what :string got :i64 want :i64] :i64
  (let [x (say (string-concat "FAIL " (string-concat what (string-concat " => " (string-concat (string-from-i64 got) (string-concat " ; want " (string-from-i64 want)))))))] 1))

(defn- expect [what :string got :i64 want :i64] :i64
  (if (= got want) 0 (fail what got want)))

;; a copy of M with word k (0-based) replaced by w
(defn- with-word [M :vector-i64 k :i64 w :i64] :vector-i64
  (let [n (vector-at M 0) C (vector-alloc (+ n 1))
        C1 (loop [i 0 V C] (if (> i n) V (recur (inc i) (vector-assoc! V i (vector-at M i)))))]
    (vector-assoc! C1 (+ k 1) w)))

;; a copy of M that keeps only its first c words
(defn- with-count [M :vector-i64 c :i64] :vector-i64
  (let [n (vector-at M 0) C (vector-alloc (+ n 1))
        C1 (loop [i 0 V C] (if (> i n) V (recur (inc i) (vector-assoc! V i (vector-at M i)))))]
    (vector-assoc! C1 0 c)))

;; the number of words in which A and B differ (same word count assumed)
(defn- diff-words [A :vector-i64 B :vector-i64] :i64
  (loop [i 1 d 0] (if (> i (vector-at A 0)) d (recur (inc i) (if (= (vector-at A i) (vector-at B i)) d (inc d))))))

;; 1 when an instruction of the module has opcode op
(defn- has-op? [M :vector-i64 op :i64] :i64
  (loop [k 5]
    (if (>= k (spv-count M)) 0
      (let [w (spv-word M k)]
        (cond (= (bit-and w 65535) op) 1
              (= (u64-shift-right w 16) 0) 0
              :else (recur (+ k (u64-shift-right w 16))))))))

;; the value word of the OpConstant whose result id is id, or -1
(defn- const-of [M :vector-i64 id :i64] :i64
  (loop [k 5]
    (if (>= k (spv-count M)) -1
      (let [w (spv-word M k) wc (u64-shift-right w 16)]
        (cond (= wc 0) -1
              (and (= (bit-and w 65535) 43) (= (spv-word M (+ k 2)) id)) (spv-word M (+ k 3))
              :else (recur (+ k wc)))))))

(defn- same-words? [A :vector-i64 B :vector-i64] :bool
  (and (= (vector-at A 0) (vector-at B 0))
       (loop [i 1] (cond (> i (vector-at A 0)) true (not= (vector-at A i) (vector-at B i)) false :else (recur (inc i))))))

;; ---------------------------------------------------------------------
;; The module.

(defn- module-shape [] :i64
  (let [M (kir1-ewise 1 256)]
    (+ (expect "add wg256 checks" (spc-check M) 0)
       (expect "word count" (spv-count M) 251)
       (expect "magic" (spv-word M 0) 119734787)
       (expect "version 1.3" (spv-word M 1) 66304)
       (expect "bound" (spv-word M 3) 38)
       (expect "first instruction is Capability Shader" (spv-word M 6) 1)
       (expect "LocalSize x" (spv-word M 19) 256)
       (expect "the operator instruction is OpFAdd" (bit-and (spv-word M 231) 65535) 129)
       (expect "OpFDiv for div" (bit-and (spv-word (kir1-ewise 4 64) 231) 65535) 136)
       (expect "same input, same words" (if (same-words? M (kir1-ewise 1 256)) 1 0) 1)
       (expect "different operator, different words" (if (same-words? M (kir1-ewise 3 256)) 1 0) 0))))

;; every operator at two workgroup sizes, written into the scope
(defn- written [] :i64
  (loop [o 1 bad 0]
    (if (> o 4) bad
      (let [a (kir1-ewise o 64) b (kir1-ewise o 256)
            pa (string-concat "kir1-ewise-" (string-concat (kir1-operator-name o) "-wg64.spv"))
            pb (string-concat "kir1-ewise-" (string-concat (kir1-operator-name o) "-wg256.spv"))]
        (recur (inc o)
               (+ bad (+ (expect pa (spc-check a) 0) (+ (expect pb (spc-check b) 0)
                      (+ (expect (string-concat "write " pa) (spv-write a pa) 1004)
                         (expect (string-concat "write " pb) (spv-write b pb) 1004))))))))))

(defn- invalid-parameters [] :i64
  (+ (expect "operator 5" (kir1-ewise-error 5 256) 1)
     (expect "workgroup 3" (kir1-ewise-error 1 3) 2)
     (expect "workgroup 2048" (kir1-ewise-error 1 2048) 2)
     (expect "invalid gives an empty module" (spv-count (kir1-ewise 5 256)) 0)))

;; ---------------------------------------------------------------------
;; The checker refuses each problem by name. Word offsets are those of the
;; add/wg256 module (gpu_kernel_kir1.kotoba).

(defn- refusals [] :i64
  (let [M (kir1-ewise 1 256)]
    (+ (expect "short" (spc-check (with-count M 3)) 1)
       (expect "magic" (spc-check (with-word M 0 119734788)) 2)
       (expect "version 2.0" (spc-check (with-word M 1 131072)) 3)
       (expect "schema" (spc-check (with-word M 4 1)) 4)
       (expect "word count 0" (spc-check (with-word M 5 17)) 6)
       (expect "type after functions' rank" (spc-check (with-word M 170 131089)) 7)
       (expect "no capability" (spc-check (with-word M 5 131082)) 9)
       (expect "id at the bound" (spc-check (with-word M 3 37)) 11)
       (expect "id defined twice" (spc-check (with-word M 134 12)) 12)
       (expect "function without end" (spc-check (with-count M 250)) 13)
       (expect "label inside an open block" (spc-check (with-word M 245 131320)) (if (= CONTROL 1) 14 15))
       (expect "merge not before its branch" (spc-check (with-word M 205 262209)) 16)
       (expect "entry point names a type" (spc-check (with-word M 12 2)) 17)
       (expect "GLCompute without Shader" (spc-check (with-word M 6 2)) 18))))


;; ---------------------------------------------------------------------
;; Reductions (step 2).

(defn- reductions [] :i64
  (loop [r 1 bad 0]
    (if (> r 3) bad
      (let [a (kir1-reduce r 64) b (kir1-reduce r 256)
            words (if (= r 1) 435 437)
            pa (string-concat "kir1-reduce-" (string-concat (kir1-reducer-name r) "-wg64.spv"))
            pb (string-concat "kir1-reduce-" (string-concat (kir1-reducer-name r) "-wg256.spv"))]
        (recur (inc r)
               (+ bad (+ (expect pa (spc-check a) 0) (+ (expect pb (spc-check b) 0)
                      (+ (expect (string-concat "words " pb) (spv-count b) words)
                         (+ (expect (string-concat "write " pa) (spv-write a pa) (* 4 words))
                            (expect (string-concat "write " pb) (spv-write b pb) (* 4 words))))))))))))

(defn- reduction-shape [] :i64
  (let [M (kir1-reduce 2 256)]
    (+ (expect "reduce bound" (spv-word M 3) 72)
       (expect "max identity is -FLT_MAX bits (word 221)" (spv-word M 221) 4286578687)
       (expect "reducer 4" (kir1-reduce-error 4 256) 1)
       (expect "reduce workgroup 3" (kir1-reduce-error 1 3) 2)
       (expect "reduce invalid gives an empty module" (spv-count (kir1-reduce 0 64)) 0)
       (expect "same reduce twice" (if (same-words? M (kir1-reduce 2 256)) 1 0) 1))))

;; what is written reads back word for word; glslang's modules pass the checker
(defn- read-back [] :i64
  (let [M (kir1-ewise 2 256)
        w (spv-write M "round-trip.spv")
        R (spv-read "round-trip.spv")
        g1 (spv-read "ref-ewise-add.spv")
        g2 (spv-read "ref-reduce-sum.spv")]
    (+ (expect "round trip bytes" w 1004)
       (expect "round trip words" (if (same-words? M R) 1 0) 1)
       (expect "glslang ewise-add is read" (if (> (spv-count g1) 5) 1 0) 1)
       (expect "glslang ewise-add passes the checker" (spc-check g1) 0)
       (expect "glslang reduce-sum is read" (if (> (spv-count g2) 5) 1 0) 1)
       (expect "glslang reduce-sum passes the checker" (spc-check g2) 0))))

;; ---------------------------------------------------------------------
;; The ADR 0358 workgroup-sweep kernel and the subgroup reductions (step 2).

(defn- sweeps [] :i64
  (loop [wg 32 bad 0]
    (if (> wg 1024) bad
      (let [M (kir1-sweep wg) p (string-concat "kir1-sweep-wg" (string-concat (string-from-i64 wg) ".spv"))]
        (recur (* wg 2)
               (+ bad (+ (expect p (spc-check M) 0)
                         (expect (string-concat "write " p) (spv-write M p) 856))))))))

(defn- sweep-shape [] :i64
  (let [a (kir1-sweep 32) b (kir1-sweep 1024)]
    (+ (expect "sweep bound" (spv-word a 3) 38)
       (expect "sweep sizes differ in one word" (diff-words a b) 1)
       (expect "that word is LocalSize x (word 25)" (spv-word b 25) 1024)
       (expect "the FMA constant 1.0000001 is f32 0x3f800001 (id 20)" (const-of a 20) 1065353217)
       (expect "the loop body calls GLSL.std.450 (OpExtInst)" (has-op? a 12) 1)
       (expect "the loop counts to 256 (id 18)" (const-of a 18) 256)
       (expect "sweep workgroup 3" (kir1-sweep-error 3) 2)
       (expect "sweep invalid gives an empty module" (spv-count (kir1-sweep 0)) 0))))

(defn- subgroups [] :i64
  (loop [r 1 bad 0]
    (if (> r 3) bad
      (let [M (kir1-subgroup-reduce r 256)
            p (string-concat "kir1-subgroup-" (string-concat (kir1-reducer-name r) "-wg256.spv"))]
        (recur (inc r)
               (+ bad (+ (expect p (spc-check M) 0)
                         (expect (string-concat "write " p) (spv-write M p) (if (= r 1) 1896 1904)))))))))

(defn- subgroup-shape [] :i64
  (let [s (kir1-subgroup-reduce 1 256) x (kir1-subgroup-reduce 2 256) n (kir1-subgroup-reduce 3 256)]
    (+ (expect "subgroup bound" (spv-word s 3) 78)
       (expect "Capability GroupNonUniform (word 8)" (spv-word s 8) 61)
       (expect "Capability GroupNonUniformArithmetic (word 10)" (spv-word s 10) 63)
       (expect "sum uses OpGroupNonUniformFAdd" (has-op? s 350) 1)
       (expect "max uses OpGroupNonUniformFMax" (has-op? x 358) 1)
       (expect "min uses OpGroupNonUniformFMin" (has-op? n 355) 1)
       (expect "sum does not use FMax" (has-op? s 358) 0)
       (expect "subgroup reducer 4" (spv-count (kir1-subgroup-reduce 4 256)) 0)
       (expect "same subgroup module twice" (if (same-words? x (kir1-subgroup-reduce 2 256)) 1 0) 1))))

(defn- step2-refs [] :i64
  (let [g1 (spv-read "ref-sweep-wg256.spv") g2 (spv-read "ref-subgroup-reduce-sum.spv")]
    (+ (expect "glslang sweep is read" (if (> (spv-count g1) 5) 1 0) 1)
       (expect "glslang sweep passes the checker" (spc-check g1) 0)
       (expect "glslang subgroup sum is read" (if (> (spv-count g2) 5) 1 0) 1)
       (expect "glslang subgroup sum passes the checker" (spc-check g2) 0))))

(defn main [] :i64
  (let [failed (+ (module-shape) (written) (invalid-parameters) (refusals) (reductions) (reduction-shape) (read-back)
                  (sweeps) (sweep-shape) (subgroups) (subgroup-shape) (step2-refs))
        x (say (string-concat "CASES " (string-from-i64 CASES)))
        y (say (string-concat "FAILED " (string-from-i64 failed)))]
    failed))
