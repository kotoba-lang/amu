// Oracle input only (ADR 0372): glslangValidator compiles this on a developer
// host, and tools/spirv_check.kotoba must accept the module glslang writes.
// The same kernel as gpu_kernel_kir1.kotoba's sum/wg256, written by hand.
#version 450
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer X { float x[]; };
layout(std430, set = 0, binding = 1) buffer P { float parts[]; };
layout(std430, set = 0, binding = 2) readonly buffer N { uint n; };
shared float scratch[256];
void main() {
  uint i = gl_GlobalInvocationID.x;
  uint l = gl_LocalInvocationID.x;
  scratch[l] = 0.0;
  if (i < n) scratch[l] = x[i];
  barrier();
  for (uint s = 128u; s > 0u; s >>= 1) {
    if (l < s) scratch[l] = scratch[l] + scratch[l + s];
    barrier();
  }
  if (l == 0u) parts[gl_WorkGroupID.x] = scratch[0];
}
