// Oracle input only (ADR 0372): glslangValidator compiles this on a developer
// host, and tools/spirv_check.kotoba must accept the module glslang writes.
// The same kernel as gpu_kernel_kir1.kotoba's add/wg256, written by hand.
#version 450
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer X { float x[]; };
layout(std430, set = 0, binding = 1) readonly buffer Y { float y[]; };
layout(std430, set = 0, binding = 2) writeonly buffer Z { float z[]; };
layout(std430, set = 0, binding = 3) readonly buffer N { uint n; };
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < n) z[i] = x[i] + y[i];
}
