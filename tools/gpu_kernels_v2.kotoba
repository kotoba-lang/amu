(ns gpu-kernels-v2 (:export [kir2-ewise kir2-attn-copy-dense kir2-nex-op kir2-nex-op-name kir2-dot-rows kir2-kdot-f32-r1]))

;; Kernels written with KIR v2 (tools/gpu_kernel_kir2.kotoba, ADR 0372 step 3).
;; Each is the Kotoba form of a GLSL kernel of kotoba-lang/inference; the
;; comment names the source and its bindings. f32 constants are bit patterns.

;; ---------------------------------------------------------------------
;; z[i] = x[i] <op> y[i] for i = GlobalInvocationId.x < n: KIR v1's
;; elementwise kernel again (gpu_kernel_kir1.kotoba), as the proof of the
;; lowering. Bindings 0 x (ro f32[]), 1 y (ro f32[]), 2 z (f32[]), 3 n (u32).
;; operator: 1 add, 2 sub, 3 mul, 4 div. As in KIR v1, another operator or a
;; workgroup size that is not a power of two in 1..1024 gives an empty module.
(defn kir2-ewise [o :i64 wg :i64] :vector-i64
  (if (or (< o 1) (> o 4) (< wg 1) (> wg 1024) (not= (bit-and wg (- wg 1)) 0)) (spv-new 0)
    (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B)
          X (kb-buffer B 0 tf 4 true) Y (kb-buffer B 1 tf 4 true) Z (kb-buffer B 2 tf 4 false) N (kb-meta B 3 1 0)
          i (kb-builtin-at B 28 0)
          n (kb-meta-at B N tu 0)
          g (kb-if B (kb-ult B i n))
          x (kb-load B tf (kb-at B X tf i)) y (kb-load B tf (kb-at B Y tf i))
          r (kb-op2 B (case o 1 129 2 131 3 133 136) tf x y)
          s (kb-store B (kb-at B Z tf i) r)
          e (kb-end-if B)]
      (kb-module B wg 1 1))))

;; ---------------------------------------------------------------------
;; attn_copy_dense (kotoba-lang/inference verify/native/gpu/attn_copy_dense.comp
;; at 808e5f0; tools/gpu_kernel_refs/attn-copy-dense.comp is that file): the
;; KV-cache writes and the decode attention of a layer in one dispatch,
;; statement for statement. Bindings: 0 Meta {n rows aux aux2 : u32, eps scale
;; p0 p1 : f32} (ro), 1 A (dqr, ro), 2 B (kc), 3 C (vc), 4 O (dattn), 5 DV
;; (ro), 6 DK (dkr, ro), 7 I (ids/position, u32). LocalSize 256; dispatch
;; (heads, rows, 1).

;; for (st = 128; st > 0; st >>= 1) { if (t < st) red[t] = red[t] op
;; red[t + st]; barrier(); } -- the tree order is the arithmetic; max? picks
;; GLSL.std.450 FMax, else FAdd
(defn- k2-tree [B :vector-i64 red :i64 t :i64 st-var :i64 max? :bool] :i64
  (let [tu (kb-tu32 B) tf (kb-tf32 B)
        a (kb-store B st-var (kb-u32 B 128))
        l (kb-loop B)
        w (kb-while B (kb-ugt B (kb-load B tu st-var) (kb-u32 B 0)))
        st (kb-load B tu st-var)
        g (kb-if B (kb-ult B t st))
        x (kb-load B tf (kb-shared-at B red tf t))
        y (kb-load B tf (kb-shared-at B red tf (kb-iadd B t st)))
        s (kb-store B (kb-shared-at B red tf t) (if max? (kb-fmax B x y) (kb-fadd B x y)))
        e (kb-end-if B)
        b (kb-barrier B)
        c (kb-continue B)
        n (kb-store B st-var (kb-shr B (kb-load B tu st-var) (kb-u32 B 1)))]
    (kb-end-loop B)))

;; wg_sum(t, v): red[t] = v; barrier(); the sum tree; r = red[0]; barrier()
(defn- k2-wg-sum [B :vector-i64 red :i64 t :i64 st-var :i64 v :i64] :i64
  (let [tf (kb-tf32 B) a (kb-store B (kb-shared-at B red tf t) v) b (kb-barrier B)
        c (k2-tree B red t st-var false)
        r (kb-load B tf (kb-shared-at B red tf (kb-u32 B 0))) d (kb-barrier B)]
    r))

;; the cache index (x * aux2 + hkv) * d + i
(defn- k2-kv-index [B :vector-i64 x :i64 aux2 :i64 hkv :i64 d :i64 i :i64] :i64
  (kb-iadd B (kb-imul B (kb-iadd B (kb-imul B x aux2) hkv) d) i))

(defn kir2-attn-copy-dense [] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B)
        P (kb-meta B 0 8 240)
        A (kb-buffer B 1 tf 4 true) KC (kb-buffer B 2 tf 4 false) VC (kb-buffer B 3 tf 4 false)
        O (kb-buffer B 4 tf 4 false) DV (kb-buffer B 5 tf 4 true) DK (kb-buffer B 6 tf 4 true)
        I (kb-buffer B 7 tu 4 false)
        red (kb-shared B tf 256)
        vi (kb-var B tu) vst (kb-var B tu) vsc (kb-var B tf) vdt (kb-var B tf) vkv (kb-var B tf)
        vacc (kb-var B tf) vtt (kb-var B tu) vvv (kb-var B tf)
        u0 (kb-u32 B 0) u1 (kb-u32 B 1) u256 (kb-u32 B 256) f0 (kb-f32 B 0)
        ;; h = WorkGroupID.x, row = WorkGroupID.y, t = LocalInvocationID.x, d = P.n
        h (kb-builtin-at B 26 0) row (kb-builtin-at B 26 1) t (kb-builtin-at B 27 0)
        d (kb-meta-at B P tu 0)
        ;; T = ((P.p1 != 0.0) ? dyn_pos() + 1 : P.aux) + row, dyn_pos() = ids[0]
        ;; (both arms are safe to evaluate: OpSelect)
        T (kb-iadd B (kb-op3 B 169 tu (kb-fne B (kb-meta-at B P tf 7) f0)
                             (kb-iadd B (kb-load B tu (kb-at B I tu u0)) u1) (kb-meta-at B P tu 2))
                   row)
        aux2 (kb-meta-at B P tu 3)
        ;; group = P.rows / P.aux2; hkv = h / group; qoff = row * P.rows * d
        group (kb-udiv B (kb-meta-at B P tu 1) aux2)
        hkv (kb-udiv B h group)
        qoff (kb-imul B (kb-imul B row (kb-meta-at B P tu 1)) d)
        ;; phase 1: if (h % group == 0) { coff = dyn_pos() * P.aux2 * d + hkv * d;
        ;; for (i = t; i < d; i += 256) { b[coff + i] = dk[hkv * d + i]; c[coff + i] = dv[hkv * d + i]; } }
        p0 (kb-if B (kb-ieq B (kb-umod B h group) u0))
        coff (kb-iadd B (kb-imul B (kb-imul B (kb-load B tu (kb-at B I tu u0)) aux2) d) (kb-imul B hkv d))
        p1 (kb-store B vi t)
        p2 (kb-loop B)
        p3 (kb-while B (kb-ult B (kb-load B tu vi) d))
        i1 (kb-load B tu vi)
        p4 (kb-store B (kb-at B KC tf (kb-iadd B coff i1)) (kb-load B tf (kb-at B DK tf (kb-iadd B (kb-imul B hkv d) i1))))
        p5 (kb-store B (kb-at B VC tf (kb-iadd B coff i1)) (kb-load B tf (kb-at B DV tf (kb-iadd B (kb-imul B hkv d) i1))))
        p6 (kb-continue B)
        p7 (kb-store B vi (kb-iadd B (kb-load B tu vi) u256))
        p8 (kb-end-loop B)
        p9 (kb-end-if B)
        ;; phase 2: pos = dyn_pos(); sc = -1e30; if (t < T) { dt = 0;
        ;; for (i = 0; i < d; i++) { kv = (t == pos) ? dk[hkv * d + i] : b[(t * aux2 + hkv) * d + i];
        ;; dt += a[qoff + h * d + i] * kv; } sc = dt * P.scale; }
        pos (kb-load B tu (kb-at B I tu u0))
        s0 (kb-store B vsc (kb-f32 B 0xF149F2CA))
        s1 (kb-if B (kb-ult B t T))
        s2 (kb-store B vdt f0)
        s3 (kb-store B vi u0)
        s4 (kb-loop B)
        s5 (kb-while B (kb-ult B (kb-load B tu vi) d))
        i2 (kb-load B tu vi)
        s6 (kb-if B (kb-ieq B t pos))
        s7 (kb-store B vkv (kb-load B tf (kb-at B DK tf (kb-iadd B (kb-imul B hkv d) i2))))
        s8 (kb-else B)
        s9 (kb-store B vkv (kb-load B tf (kb-at B KC tf (k2-kv-index B t aux2 hkv d i2))))
        s10 (kb-end-if B)
        av (kb-load B tf (kb-at B A tf (kb-iadd B (kb-iadd B qoff (kb-imul B h d)) i2)))
        s11 (kb-store B vdt (kb-fadd B (kb-load B tf vdt) (kb-fmul B av (kb-load B tf vkv))))
        s12 (kb-continue B)
        s13 (kb-store B vi (kb-iadd B (kb-load B tu vi) u1))
        s14 (kb-end-loop B)
        s15 (kb-store B vsc (kb-fmul B (kb-load B tf vdt) (kb-meta-at B P tf 5)))
        s16 (kb-end-if B)
        sc (kb-load B tf vsc)
        ;; red[t] = sc; barrier(); the max tree; m = red[0]; barrier()
        m0 (kb-store B (kb-shared-at B red tf t) sc) m1 (kb-barrier B)
        m2 (k2-tree B red t vst true)
        m (kb-load B tf (kb-shared-at B red tf u0)) m3 (kb-barrier B)
        ;; e = (t < T) ? exp(sc - m) : 0.0 (OpSelect); p = e / wg_sum(t, e);
        ;; red[t] = p; barrier()
        e (kb-op3 B 169 tf (kb-ult B t T) (kb-fexp B (kb-fsub B sc m)) f0)
        denom (k2-wg-sum B red t vst e)
        q0 (kb-store B (kb-shared-at B red tf t) (kb-fdiv B e denom)) q1 (kb-barrier B)
        ;; for (i = t; i < d; i += 256) { acc = 0; for (tt = 0; tt < T; tt++) {
        ;; vv = (tt == pos) ? dv[hkv * d + i] : c[(tt * aux2 + hkv) * d + i];
        ;; acc += red[tt] * vv; } o[qoff + h * d + i] = acc; }
        q2 (kb-store B vi t)
        q3 (kb-loop B)
        q4 (kb-while B (kb-ult B (kb-load B tu vi) d))
        i3 (kb-load B tu vi)
        q5 (kb-store B vacc f0)
        q6 (kb-store B vtt u0)
        q7 (kb-loop B)
        q8 (kb-while B (kb-ult B (kb-load B tu vtt) T))
        tt (kb-load B tu vtt)
        q9 (kb-if B (kb-ieq B tt pos))
        q10 (kb-store B vvv (kb-load B tf (kb-at B DV tf (kb-iadd B (kb-imul B hkv d) i3))))
        q11 (kb-else B)
        q12 (kb-store B vvv (kb-load B tf (kb-at B VC tf (k2-kv-index B tt aux2 hkv d i3))))
        q13 (kb-end-if B)
        q14 (kb-store B vacc (kb-fadd B (kb-load B tf vacc) (kb-fmul B (kb-load B tf (kb-shared-at B red tf tt)) (kb-load B tf vvv))))
        q15 (kb-continue B)
        q16 (kb-store B vtt (kb-iadd B (kb-load B tu vtt) u1))
        q17 (kb-end-loop B)
        q18 (kb-store B (kb-at B O tf (kb-iadd B (kb-iadd B qoff (kb-imul B h d)) i3)) (kb-load B tf vacc))
        q19 (kb-continue B)
        q20 (kb-store B vi (kb-iadd B (kb-load B tu vi) u256))
        q21 (kb-end-loop B)]
    (kb-module B 256 1 1)))

;; ---------------------------------------------------------------------
;; The nex_ops decode set (kotoba-lang/inference verify/native/gpu/nex_ops.comp
;; at 971376a; tools/gpu_kernel_refs/nex-ops.comp is that file), one module per
;; op as glslang's -DOP=<op> gives, the decode (not BATCH or BPREFILL)
;; variants. Seven storage bindings in every module: 0 Meta {n rows aux aux2 :
;; u32, eps scale p0 p1 : f32} (ro), 1 A (ro), 2 B, 3 C (ro), 4 O, 5 S, 6 I
;; (u32). LocalSize 256.
;;
;; ops: 1 rmsnorm 2 l2norm 3 gated_rmsnorm 4 silu_mul 5 conv1d_step
;; 6 gate_decay 7 gate_decay2 8 copy_at 9 weighted_sum 10 add 11 add_bias
;; 12 f32_matvec 13 add_rmsnorm 14 pos_incr 15 rope_neox 16 attn_decode
;; 17 softmax_topk 18 argmax_partial 19 argmax_final

(def NEX-OPS 19)

(defn kir2-nex-op-name [op :i64] :string
  (case op 1 "rmsnorm" 2 "l2norm" 3 "gated_rmsnorm" 4 "silu_mul" 5 "conv1d_step" 6 "gate_decay"
        7 "gate_decay2" 8 "copy_at" 9 "weighted_sum" 10 "add" 11 "add_bias" 12 "f32_matvec"
        13 "add_rmsnorm" 14 "pos_incr" 15 "rope_neox" 16 "attn_decode" 17 "softmax_topk"
        18 "argmax_partial" 19 "argmax_final" ""))

;; f32 bit patterns
(def F-ONE 0x3F800000)
(def F-TWENTY 0x41A00000)
(def F-MINUS-ONE 0xBF800000)
(def F-MINUS-TWO 0xC0000000)
(def F-MINUS-1E30 0xF149F2CA)

;; the seven bindings, as a vector of their variables (index = binding)
(defn- k2-nex-bindings [B :vector-i64] :vector-i64
  (let [tu (kb-tu32 B) tf (kb-tf32 B)
        P (kb-meta B 0 8 240) A (kb-buffer B 1 tf 4 true) Bb (kb-buffer B 2 tf 4 false) C (kb-buffer B 3 tf 4 true)
        O (kb-buffer B 4 tf 4 false) S (kb-buffer B 5 tf 4 false) I (kb-buffer B 6 tu 4 false)]
    (-> (vector-alloc 7) (vector-assoc! 0 P) (vector-assoc! 1 A) (vector-assoc! 2 Bb) (vector-assoc! 3 C)
        (vector-assoc! 4 O) (vector-assoc! 5 S) (vector-assoc! 6 I))))
;; Meta member k (0..3 u32, 4..7 f32)
(defn- k2-pm [B :vector-i64 V :vector-i64 k :i64] :i64
  (kb-meta-at B (vector-at V 0) (if (< k 4) (kb-tu32 B) (kb-tf32 B)) k))
;; element i of binding b (6 is u32, the others f32), and a store to it
(defn- k2-ld [B :vector-i64 V :vector-i64 b :i64 i :i64] :i64
  (let [t (if (= b 6) (kb-tu32 B) (kb-tf32 B))] (kb-load B t (kb-at B (vector-at V b) t i))))
(defn- k2-st [B :vector-i64 V :vector-i64 b :i64 i :i64 v :i64] :i64
  (let [t (if (= b 6) (kb-tu32 B) (kb-tf32 B))] (kb-store B (kb-at B (vector-at V b) t i) v)))
;; for (i = start; i < bound; i += step): k2-for opens the loop and answers i
;; as loaded in the body; k2-end-for closes it
(defn- k2-for [B :vector-i64 vi :i64 start :i64 bound :i64] :i64
  (let [tu (kb-tu32 B) a (kb-store B vi start) l (kb-loop B) w (kb-while B (kb-ult B (kb-load B tu vi) bound))]
    (kb-load B tu vi)))
(defn- k2-end-for [B :vector-i64 vi :i64 step :i64] :i64
  (let [tu (kb-tu32 B) c (kb-continue B) s (kb-store B vi (kb-iadd B (kb-load B tu vi) step))] (kb-end-loop B)))
;; v += x for a Function variable of f32
(defn- k2-acc [B :vector-i64 v :i64 x :i64] :i64 (kb-store B v (kb-fadd B (kb-load B (kb-tf32 B) v) x)))
;; silu(x) = x / (1 + exp(-x)); sigmoid(x) = 1 / (1 + exp(-x))
(defn- k2-silu [B :vector-i64 x :i64] :i64
  (kb-fdiv B x (kb-fadd B (kb-f32 B F-ONE) (kb-fexp B (kb-fneg B x)))))
(defn- k2-sigmoid [B :vector-i64 x :i64] :i64
  (kb-fdiv B (kb-f32 B F-ONE) (kb-fadd B (kb-f32 B F-ONE) (kb-fexp B (kb-fneg B x)))))
;; softplus(x) = x > 20 ? x : log(1 + exp(x)), the arms in an if into v
(defn- k2-softplus [B :vector-i64 v :i64 x :i64] :i64
  (let [g (kb-if B (kb-fgt B x (kb-f32 B F-TWENTY)))
        a (kb-store B v x)
        e (kb-else B)
        b (kb-store B v (kb-flog B (kb-fadd B (kb-f32 B F-ONE) (kb-fexp B x))))
        z (kb-end-if B)]
    (kb-load B (kb-tf32 B) v)))
;; if (c) return;
(defn- k2-return-if [B :vector-i64 c :i64] :i64
  (let [g (kb-if B c) r (kb-return B)] (kb-end-if B)))

;; rmsnorm, gated_rmsnorm, l2norm and add_rmsnorm share their shape: the
;; sum of squares over the row by the strided loop, wg_sum, the scale, a
;; second strided loop. kind: 1 rmsnorm 2 l2norm 3 gated 4 add_rmsnorm
(defn- k2-nex-norm [kind :i64] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B) V (k2-nex-bindings B)
        red (kb-shared B tf 256)
        vi (kb-var B tu) vst (kb-var B tu) vss (kb-var B tf)
        u0 (kb-u32 B 0) u256 (kb-u32 B 256) f0 (kb-f32 B 0)
        r (kb-builtin-at B 26 0) t (kb-builtin-at B 27 0) n (k2-pm B V 0)
        ;; rmsnorm: stride = (P.aux == 0) ? n : P.aux, ibase = r * stride, obase = r * n
        ;; l2norm: base = r * n, ibase = P.aux2 + r * n; the others: base = r * n
        aux (if (= kind 1) (k2-pm B V 2) 0)
        stride (if (= kind 1) (kb-select B tu (kb-ieq B aux u0) n aux) 0)
        ibase (case kind 1 (kb-imul B r stride) 2 (kb-iadd B (k2-pm B V 3) (kb-imul B r n)) (kb-imul B r n))
        obase (if (= kind 1) (kb-imul B r n) ibase)
        base (if (= kind 2) (kb-imul B r n) obase)
        s0 (kb-store B vss f0)
        i1 (k2-for B vi t n)
        ;; x = a[ibase + i] (add_rmsnorm: v = a + b; o[base + i] = v)
        x (if (= kind 4)
            (let [v (kb-fadd B (k2-ld B V 1 (kb-iadd B base i1)) (k2-ld B V 2 (kb-iadd B base i1)))
                  w (k2-st B V 4 (kb-iadd B base i1) v)]
              v)
            (k2-ld B V 1 (kb-iadd B ibase i1)))
        s1 (k2-acc B vss (kb-fmul B x x))
        e1 (k2-end-for B vi u256)
        tot (k2-wg-sum B red t vst (kb-load B tf vss))
        ;; l2norm: inversesqrt(tot + eps) * ((scale == 0) ? 1 : scale); else
        ;; inversesqrt(tot / float(n) + eps)
        inv (if (= kind 2)
              (let [sc (k2-pm B V 5)]
                (kb-fmul B (kb-finvsqrt B (kb-fadd B tot (k2-pm B V 4)))
                         (kb-select B tf (kb-feq B sc f0) (kb-f32 B F-ONE) sc)))
              (kb-finvsqrt B (kb-fadd B (kb-fdiv B tot (kb-u2f B n)) (k2-pm B V 4))))
        i2 (k2-for B vi t n)
        s2 (case kind
             ;; o[obase + i] = a[ibase + i] * inv * b[i]
             1 (k2-st B V 4 (kb-iadd B obase i2) (kb-fmul B (kb-fmul B (k2-ld B V 1 (kb-iadd B ibase i2)) inv) (k2-ld B V 2 i2)))
             ;; o[base + i] = a[ibase + i] * inv
             2 (k2-st B V 4 (kb-iadd B base i2) (kb-fmul B (k2-ld B V 1 (kb-iadd B ibase i2)) inv))
             ;; o[base + i] = a[base + i] * inv * b[i] * silu(c[base + i])
             3 (k2-st B V 4 (kb-iadd B base i2)
                      (kb-fmul B (kb-fmul B (kb-fmul B (k2-ld B V 1 (kb-iadd B base i2)) inv) (k2-ld B V 2 i2))
                               (k2-silu B (k2-ld B V 3 (kb-iadd B base i2)))))
             ;; s[base + i] = o[base + i] * inv * c[i]
             (k2-st B V 5 (kb-iadd B base i2) (kb-fmul B (kb-fmul B (k2-ld B V 4 (kb-iadd B base i2)) inv) (k2-ld B V 3 i2))))
        e2 (k2-end-for B vi u256)]
    (kb-module B 256 1 1)))

;; the one-invocation-per-element ops: i = GlobalInvocationID.x, and
;; if (i >= bound) return; first. op: 4 silu_mul 5 conv1d_step 6 gate_decay
;; 7 gate_decay2 8 copy_at 10 add 11 add_bias
(defn- k2-nex-ewise [op :i64] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B) V (k2-nex-bindings B)
        vsp (kb-var B tf)
        u1 (kb-u32 B 1) u2 (kb-u32 B 2) u3 (kb-u32 B 3) u4 (kb-u32 B 4) f0 (kb-f32 B 0)
        i (kb-builtin-at B 28 0)
        ;; gate_decay(2) loop over P.rows, the others over P.n
        g (k2-return-if B (kb-uge B i (k2-pm B V (if (or (= op 6) (= op 7)) 1 0))))
        n (k2-pm B V 0)
        w (case op
            ;; o[i] = silu(a[i]) * b[i]
            4 (k2-st B V 4 i (kb-fmul B (k2-silu B (k2-ld B V 1 i)) (k2-ld B V 2 i)))
            ;; x0 = s[ch], x1 = s[n + ch], x2 = s[2n + ch], x3 = a[ch];
            ;; y = b[4ch] x0 + b[4ch+1] x1 + b[4ch+2] x2 + b[4ch+3] x3; o[ch] = silu(y);
            ;; s[ch] = x1; s[n + ch] = x2; s[2n + ch] = x3
            5 (let [x0 (k2-ld B V 5 i) x1 (k2-ld B V 5 (kb-iadd B n i)) x2 (k2-ld B V 5 (kb-iadd B (kb-imul B u2 n) i))
                    x3 (k2-ld B V 1 i) c4 (kb-imul B i u4)
                    y (kb-fadd B (kb-fadd B (kb-fadd B (kb-fmul B (k2-ld B V 2 c4) x0)
                                                       (kb-fmul B (k2-ld B V 2 (kb-iadd B c4 u1)) x1))
                                           (kb-fmul B (k2-ld B V 2 (kb-iadd B c4 u2)) x2))
                               (kb-fmul B (k2-ld B V 2 (kb-iadd B c4 u3)) x3))
                    a (k2-st B V 4 i (k2-silu B y))
                    b (k2-st B V 5 i x1)
                    c (k2-st B V 5 (kb-iadd B n i) x2)]
                (k2-st B V 5 (kb-iadd B (kb-imul B u2 n) i) x3))
            ;; o[h] = softplus(a[h] + b[h]) * c[h]; o[aux + h] = sigmoid(a[aux2 + h])
            ;; (gate_decay2: sigmoid(s[h]))
            6 (let [a (k2-st B V 4 i (kb-fmul B (k2-softplus B vsp (kb-fadd B (k2-ld B V 1 i) (k2-ld B V 2 i))) (k2-ld B V 3 i)))]
                (k2-st B V 4 (kb-iadd B (k2-pm B V 2) i) (k2-sigmoid B (k2-ld B V 1 (kb-iadd B (k2-pm B V 3) i)))))
            7 (let [a (k2-st B V 4 i (kb-fmul B (k2-softplus B vsp (kb-fadd B (k2-ld B V 1 i) (k2-ld B V 2 i))) (k2-ld B V 3 i)))]
                (k2-st B V 4 (kb-iadd B (k2-pm B V 2) i) (k2-sigmoid B (k2-ld B V 5 i))))
            ;; off = (P.p1 != 0) ? dyn_pos() * aux2 : aux2; o[off + i] = a[i]
            8 (let [aux2 (k2-pm B V 3)
                    off (kb-select B tu (kb-fne B (k2-pm B V 7) f0) (kb-imul B (k2-ld B V 6 (kb-u32 B 0)) aux2) aux2)]
                (k2-st B V 4 (kb-iadd B off i) (k2-ld B V 1 i)))
            ;; o[i] = a[i] + b[i]
            10 (k2-st B V 4 i (kb-fadd B (k2-ld B V 1 i) (k2-ld B V 2 i)))
            ;; o[i] = a[i] + b[i - (i / aux) * aux]
            (let [aux (k2-pm B V 2)]
              (k2-st B V 4 i (kb-fadd B (k2-ld B V 1 i) (k2-ld B V 2 (kb-isub B i (kb-imul B (kb-udiv B i aux) aux)))))))]
    (kb-module B 256 1 1)))

;; weighted_sum: i = GlobalInvocationID.x, y = WorkGroupID.y; if (i >= n)
;; return; acc = sum over e < aux of b[y aux + e] * a[(y aux + e) n + i];
;; o[y n + i] = acc + c[y n + i] * sigmoid(s[y])
(defn- k2-nex-weighted-sum [] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B) V (k2-nex-bindings B)
        vacc (kb-var B tf) ve (kb-var B tu)
        u0 (kb-u32 B 0) u1 (kb-u32 B 1) f0 (kb-f32 B 0)
        i (kb-builtin-at B 28 0) y (kb-builtin-at B 26 1)
        g (k2-return-if B (kb-uge B i (k2-pm B V 0)))
        a0 (kb-store B vacc f0)
        e (k2-for B ve u0 (k2-pm B V 2))
        ye (kb-iadd B (kb-imul B y (k2-pm B V 2)) e)
        a1 (k2-acc B vacc (kb-fmul B (k2-ld B V 2 ye) (k2-ld B V 1 (kb-iadd B (kb-imul B ye (k2-pm B V 0)) i))))
        e1 (k2-end-for B ve u1)
        yn (kb-iadd B (kb-imul B y (k2-pm B V 0)) i)
        w (k2-st B V 4 yn (kb-fadd B (kb-load B tf vacc) (kb-fmul B (k2-ld B V 3 yn) (k2-sigmoid B (k2-ld B V 5 y)))))]
    (kb-module B 256 1 1)))

;; f32_matvec: r = WorkGroupID.x, y = WorkGroupID.y; acc = sum over the
;; strided i of a[r n + i] * b[y n + i]; tot = wg_sum; if (t == 0)
;; o[y rows + r] = tot
(defn- k2-nex-matvec [] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B) V (k2-nex-bindings B)
        red (kb-shared B tf 256)
        vi (kb-var B tu) vst (kb-var B tu) vacc (kb-var B tf)
        u0 (kb-u32 B 0) u256 (kb-u32 B 256) f0 (kb-f32 B 0)
        r (kb-builtin-at B 26 0) y (kb-builtin-at B 26 1) t (kb-builtin-at B 27 0)
        n (k2-pm B V 0) base (kb-imul B r n)
        a0 (kb-store B vacc f0)
        i (k2-for B vi t n)
        a1 (k2-acc B vacc (kb-fmul B (k2-ld B V 1 (kb-iadd B base i)) (k2-ld B V 2 (kb-iadd B (kb-imul B y n) i))))
        e1 (k2-end-for B vi u256)
        tot (k2-wg-sum B red t vst (kb-load B tf vacc))
        g (kb-if B (kb-ieq B t u0))
        w (k2-st B V 4 (kb-iadd B (kb-imul B y (k2-pm B V 1)) r) tot)
        z (kb-end-if B)]
    (kb-module B 256 1 1)))

;; pos_incr: if (GlobalInvocationID.x == 0) ids[0] += 1
(defn- k2-nex-pos-incr [] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) V (k2-nex-bindings B)
        u0 (kb-u32 B 0)
        g (kb-if B (kb-ieq B (kb-builtin-at B 28 0) u0))
        w (k2-st B V 6 u0 (kb-iadd B (k2-ld B V 6 u0) (kb-u32 B 1)))
        z (kb-end-if B)]
    (kb-module B 256 1 1)))

;; rope_neox (decode, no BIAS): h = WorkGroupID.x, nrot = P.aux, hlf = nrot / 2,
;; base = h n, tokrow = (P.rows > 0) ? h / P.rows : 0; for the strided i: the
;; tail (i >= nrot) is copied; else p0 != 0 pairs (2p, 2p + 1) and p0 == 0
;; pairs (p, p + hlf), theta = float(pos + tokrow) * pow(P.scale, -2 pair /
;; nrot), divided by b[pair] when P.eps != 0, and the pair rotated
(defn- k2-nex-rope [] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B) tb (kb-tbool B) V (k2-nex-bindings B)
        vi (kb-var B tu) vtok (kb-var B tu) vth (kb-var B tf)
        u0 (kb-u32 B 0) u1 (kb-u32 B 1) u2 (kb-u32 B 2) u256 (kb-u32 B 256) f0 (kb-f32 B 0)
        h (kb-builtin-at B 26 0) t (kb-builtin-at B 27 0) n (k2-pm B V 0) nrot (k2-pm B V 2)
        hlf (kb-udiv B nrot u2) base (kb-imul B h n)
        ;; tokrow in an if: the other arm of the select would divide by zero
        r0 (kb-store B vtok u0)
        r1 (kb-if B (kb-ugt B (k2-pm B V 1) u0))
        r2 (kb-store B vtok (kb-udiv B h (k2-pm B V 1)))
        r3 (kb-end-if B)
        tokrow (kb-load B tu vtok)
        i (k2-for B vi t n)
        ;; if (i >= nrot) { o[base + i] = a[base + i]; continue; }
        c0 (kb-if B (kb-uge B i nrot))
        c1 (k2-st B V 4 (kb-iadd B base i) (k2-ld B V 1 (kb-iadd B base i)))
        c2 (kb-next B)
        c3 (kb-end-if B)
        norm (kb-fne B (k2-pm B V 6) f0)
        pair (kb-select B tu norm (kb-shr B i u1) (kb-select B tu (kb-uge B i hlf) (kb-isub B i hlf) i))
        pos (kb-select B tu (kb-fne B (k2-pm B V 7) f0) (k2-ld B V 6 u0) (k2-pm B V 3))
        d0 (kb-store B vth (kb-fmul B (kb-u2f B (kb-iadd B pos tokrow))
                                    (kb-fpow B (k2-pm B V 5) (kb-fdiv B (kb-fmul B (kb-f32 B F-MINUS-TWO) (kb-u2f B pair)) (kb-u2f B nrot)))))
        d1 (kb-if B (kb-fne B (k2-pm B V 4) f0))
        d2 (kb-store B vth (kb-fdiv B (kb-load B tf vth) (k2-ld B V 2 pair)))
        d3 (kb-end-if B)
        theta (kb-load B tf vth)
        cs (kb-fcos B theta) sn (kb-fsin B theta)
        ;; x0 = a[base + (norm ? 2 pair : pair)], x1 = a[base + (norm ? 2 pair + 1 : pair + hlf)]
        x0 (k2-ld B V 1 (kb-iadd B base (kb-select B tu norm (kb-imul B u2 pair) pair)))
        x1 (k2-ld B V 1 (kb-iadd B base (kb-select B tu norm (kb-iadd B (kb-imul B u2 pair) u1) (kb-iadd B pair hlf))))
        second (kb-select B tb norm (kb-ieq B (kb-band B i u1) u1) (kb-uge B i hlf))
        w (k2-st B V 4 (kb-iadd B base i)
                 (kb-select B tf second (kb-fadd B (kb-fmul B x0 sn) (kb-fmul B x1 cs)) (kb-fsub B (kb-fmul B x0 cs) (kb-fmul B x1 sn))))
        e (k2-end-for B vi u256)]
    (kb-module B 256 1 1)))

;; attn_decode (decode): attn_copy_dense's phase 2 over the cache in b and c
;; (no current-row substitution), and the output gate: o = (P.p0 != 0) ? acc
;; : acc * sigmoid(s[gi]), gi = (P.eps < 0) ? row rows 2 d + (2h + 1) d + i
;; : qoff + h d + i. The gate's load is in an if (s is a stub when p0 != 0).
(defn- k2-nex-attn [] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B) V (k2-nex-bindings B)
        red (kb-shared B tf 256)
        vi (kb-var B tu) vst (kb-var B tu) vsc (kb-var B tf) vdt (kb-var B tf) vacc (kb-var B tf) vtt (kb-var B tu)
        vout (kb-var B tf)
        u0 (kb-u32 B 0) u1 (kb-u32 B 1) u2 (kb-u32 B 2) u256 (kb-u32 B 256) f0 (kb-f32 B 0)
        h (kb-builtin-at B 26 0) row (kb-builtin-at B 26 1) t (kb-builtin-at B 27 0)
        d (k2-pm B V 0)
        T (kb-iadd B (kb-select B tu (kb-fne B (k2-pm B V 7) f0) (kb-iadd B (k2-ld B V 6 u0) u1) (k2-pm B V 2)) row)
        aux2 (k2-pm B V 3)
        hkv (kb-udiv B h (kb-udiv B (k2-pm B V 1) aux2))
        qoff (kb-imul B (kb-imul B row (k2-pm B V 1)) d)
        s0 (kb-store B vsc (kb-f32 B F-MINUS-1E30))
        s1 (kb-if B (kb-ult B t T))
        s2 (kb-store B vdt f0)
        i2 (k2-for B vi u0 d)
        s3 (k2-acc B vdt (kb-fmul B (k2-ld B V 1 (kb-iadd B (kb-iadd B qoff (kb-imul B h d)) i2))
                                    (k2-ld B V 2 (k2-kv-index B t aux2 hkv d i2))))
        s4 (k2-end-for B vi u1)
        s5 (kb-store B vsc (kb-fmul B (kb-load B tf vdt) (k2-pm B V 5)))
        s6 (kb-end-if B)
        sc (kb-load B tf vsc)
        m0 (kb-store B (kb-shared-at B red tf t) sc) m1 (kb-barrier B)
        m2 (k2-tree B red t vst true)
        m (kb-load B tf (kb-shared-at B red tf u0)) m3 (kb-barrier B)
        e (kb-select B tf (kb-ult B t T) (kb-fexp B (kb-fsub B sc m)) f0)
        denom (k2-wg-sum B red t vst e)
        q0 (kb-store B (kb-shared-at B red tf t) (kb-fdiv B e denom)) q1 (kb-barrier B)
        i3 (k2-for B vi t d)
        q2 (kb-store B vacc f0)
        tt (k2-for B vtt u0 T)
        q3 (k2-acc B vacc (kb-fmul B (kb-load B tf (kb-shared-at B red tf tt)) (k2-ld B V 3 (k2-kv-index B tt aux2 hkv d i3))))
        q4 (k2-end-for B vtt u1)
        acc (kb-load B tf vacc)
        gi (kb-select B tu (kb-flt B (k2-pm B V 4) f0)
                      (kb-iadd B (kb-iadd B (kb-imul B (kb-imul B (kb-imul B row (k2-pm B V 1)) u2) d)
                                            (kb-imul B (kb-iadd B (kb-imul B h u2) u1) d))
                               i3)
                      (kb-iadd B (kb-iadd B qoff (kb-imul B h d)) i3))
        g0 (kb-if B (kb-fne B (k2-pm B V 6) f0))
        g1 (kb-store B vout acc)
        g2 (kb-else B)
        g3 (kb-store B vout (kb-fmul B acc (k2-sigmoid B (k2-ld B V 5 gi))))
        g4 (kb-end-if B)
        q5 (k2-st B V 4 (kb-iadd B (kb-iadd B qoff (kb-imul B h d)) i3) (kb-load B tf vout))
        q6 (k2-end-for B vi u256)]
    (kb-module B 256 1 1)))

;; the (value, index) tree: for (st = 128; st > 0; st >>= 1) { if (t < st) {
;; ov = red[t + st]; oi = redi[t + st]; if (ov > red[t] || (ov == red[t] &&
;; oi < redi[t])) { red[t] = ov; redi[t] = oi; } } barrier(); }. Both sides
;; of || and && are safe to evaluate, so neither short-circuits.
(defn- k2-argmax-tree [B :vector-i64 red :i64 redi :i64 t :i64 st-var :i64] :i64
  (let [tu (kb-tu32 B) tf (kb-tf32 B)
        a (kb-store B st-var (kb-u32 B 128))
        l (kb-loop B)
        w (kb-while B (kb-ugt B (kb-load B tu st-var) (kb-u32 B 0)))
        st (kb-load B tu st-var)
        g (kb-if B (kb-ult B t st))
        ts (kb-iadd B t st)
        ov (kb-load B tf (kb-shared-at B red tf ts)) oi (kb-load B tu (kb-shared-at B redi tu ts))
        rt (kb-load B tf (kb-shared-at B red tf t))
        h (kb-if B (kb-lor B (kb-fgt B ov rt) (kb-land B (kb-feq B ov rt) (kb-ult B oi (kb-load B tu (kb-shared-at B redi tu t))))))
        s1 (kb-store B (kb-shared-at B red tf t) ov)
        s2 (kb-store B (kb-shared-at B redi tu t) oi)
        e1 (kb-end-if B)
        e2 (kb-end-if B)
        b (kb-barrier B)
        c (kb-continue B)
        n (kb-store B st-var (kb-shr B (kb-load B tu st-var) (kb-u32 B 1)))]
    (kb-end-loop B)))
;; if (v > bv || (v == bv && ix < bi)) { bv = v; bi = ix; }
(defn- k2-best [B :vector-i64 vbv :i64 vbi :i64 v :i64 ix :i64] :i64
  (let [bv (kb-load B (kb-tf32 B) vbv) bi (kb-load B (kb-tu32 B) vbi)
        g (kb-if B (kb-lor B (kb-fgt B v bv) (kb-land B (kb-feq B v bv) (kb-ult B ix bi))))
        a (kb-store B vbv v) b (kb-store B vbi ix)]
    (kb-end-if B)))

;; softmax_topk: row = WorkGroupID.x, n = P.n (<= 256), k = P.aux; the softmax
;; of the row, then k rounds of the (p, index) tree, each writing ids and o
;; and retiring its pick (p = -1); then o[row k + t] = o / wsum * P.scale
(defn- k2-nex-topk [] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B) V (k2-nex-bindings B)
        red (kb-shared B tf 256) redi (kb-shared B tu 256)
        vst (kb-var B tu) vx (kb-var B tf) vp (kb-var B tf) vws (kb-var B tf) vr (kb-var B tu)
        u0 (kb-u32 B 0) u1 (kb-u32 B 1) f0 (kb-f32 B 0)
        t (kb-builtin-at B 27 0) n (k2-pm B V 0) k (k2-pm B V 2) row (kb-builtin-at B 26 0)
        ;; x = (t < n) ? a[row n + t] : -1e30, the load in an if
        x0 (kb-store B vx (kb-f32 B F-MINUS-1E30))
        x1 (kb-if B (kb-ult B t n))
        x2 (kb-store B vx (k2-ld B V 1 (kb-iadd B (kb-imul B row n) t)))
        x3 (kb-end-if B)
        x (kb-load B tf vx)
        m0 (kb-store B (kb-shared-at B red tf t) x) m1 (kb-barrier B)
        m2 (k2-tree B red t vst true)
        m (kb-load B tf (kb-shared-at B red tf u0)) m3 (kb-barrier B)
        e (kb-select B tf (kb-ult B t n) (kb-fexp B (kb-fsub B x m)) f0)
        denom (k2-wg-sum B red t vst e)
        p0 (kb-store B vp (kb-fdiv B e denom))
        w0 (kb-store B vws f0)
        rd (k2-for B vr u0 k)
        r0 (kb-store B (kb-shared-at B red tf t) (kb-load B tf vp))
        r1 (kb-store B (kb-shared-at B redi tu t) t)
        r2 (kb-barrier B)
        r3 (k2-argmax-tree B red redi t vst)
        best (kb-load B tu (kb-shared-at B redi tu u0)) bp (kb-load B tf (kb-shared-at B red tf u0))
        r4 (kb-barrier B)
        r5 (kb-if B (kb-ieq B t u0))
        r6 (k2-st B V 6 (kb-iadd B (kb-imul B row k) rd) best)
        r7 (k2-st B V 4 (kb-iadd B (kb-imul B row k) rd) bp)
        r8 (kb-end-if B)
        r9 (kb-if B (kb-ieq B t best))
        r10 (kb-store B vp (kb-f32 B F-MINUS-ONE))
        r11 (kb-end-if B)
        r12 (k2-acc B vws bp)
        r13 (kb-barrier B)
        r14 (k2-end-for B vr u1)
        z0 (kb-memory-barrier-buffer B) z1 (kb-barrier B)
        z2 (kb-if B (kb-ult B t k))
        oi (kb-iadd B (kb-imul B row k) t)
        z3 (k2-st B V 4 oi (kb-fmul B (kb-fdiv B (k2-ld B V 4 oi) (kb-load B tf vws)) (k2-pm B V 5)))
        z4 (kb-end-if B)]
    (kb-module B 256 1 1)))

;; argmax_partial (decode): workgroup w scans a[w 4096 .. min(w 4096 + 4096,
;; n)), the (value, index) tree, and invocation 0 writes s[w] and ids[w].
;; argmax_final (decode): the same over the P.aux partials in s and ids; ids
;; [aux] and o[0] get the pick, and with P.p1 != 0 the token buffer b[pos + 1]
;; too (pos = the bits of c[0]) once pos + 1 >= P.aux2.
(defn- k2-nex-argmax [final? :bool] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B) V (k2-nex-bindings B)
        red (kb-shared B tf 256) redi (kb-shared B tu 256)
        vi (kb-var B tu) vst (kb-var B tu) vbv (kb-var B tf) vbi (kb-var B tu)
        u0 (kb-u32 B 0) u1 (kb-u32 B 1) u256 (kb-u32 B 256) u4096 (kb-u32 B 4096) f0 (kb-f32 B 0)
        t (kb-builtin-at B 27 0) w (kb-builtin-at B 26 0)
        start (kb-imul B w u4096)
        b0 (kb-store B vbv (kb-f32 B F-MINUS-1E30)) b1 (kb-store B vbi u0)
        i (if final? (k2-for B vi t (k2-pm B V 2))
            (k2-for B vi (kb-iadd B start t) (kb-umin B (kb-iadd B start u4096) (k2-pm B V 0))))
        c (if final? (k2-best B vbv vbi (k2-ld B V 5 i) (k2-ld B V 6 i)) (k2-best B vbv vbi (k2-ld B V 1 i) i))
        e (k2-end-for B vi u256)
        r0 (kb-store B (kb-shared-at B red tf t) (kb-load B tf vbv))
        r1 (kb-store B (kb-shared-at B redi tu t) (kb-load B tu vbi))
        r2 (kb-barrier B)
        r3 (k2-argmax-tree B red redi t vst)
        g (kb-if B (kb-ieq B t u0))
        z (if final?
            (let [parts (k2-pm B V 2)
                  a1 (k2-st B V 6 parts (kb-load B tu (kb-shared-at B redi tu u0)))
                  a2 (k2-st B V 4 u0 (kb-load B tf (kb-shared-at B red tf u0)))
                  h (kb-if B (kb-fne B (k2-pm B V 7) f0))
                  pos (kb-bitcast B tu (k2-ld B V 3 u0))
                  j (kb-if B (kb-uge B (kb-iadd B pos u1) (k2-pm B V 3)))
                  a3 (k2-st B V 2 (kb-iadd B pos u1) (kb-bitcast B tf (kb-load B tu (kb-shared-at B redi tu u0))))
                  j2 (kb-end-if B)]
              (kb-end-if B))
            (let [a1 (k2-st B V 5 w (kb-load B tf (kb-shared-at B red tf u0)))]
              (k2-st B V 6 w (kb-load B tu (kb-shared-at B redi tu u0)))))
        z2 (kb-end-if B)]
    (kb-module B 256 1 1)))

;; the module of op (an empty one for another op)
(defn kir2-nex-op [op :i64] :vector-i64
  (cond (= op 1) (k2-nex-norm 1)
        (= op 2) (k2-nex-norm 2)
        (= op 3) (k2-nex-norm 3)
        (= op 13) (k2-nex-norm 4)
        (= op 9) (k2-nex-weighted-sum)
        (= op 12) (k2-nex-matvec)
        (= op 14) (k2-nex-pos-incr)
        (= op 15) (k2-nex-rope)
        (= op 16) (k2-nex-attn)
        (= op 17) (k2-nex-topk)
        (= op 18) (k2-nex-argmax false)
        (= op 19) (k2-nex-argmax true)
        (or (and (>= op 4) (<= op 8)) (= op 10) (= op 11)) (k2-nex-ewise op)
        :else (spv-new 0)))

;; ---------------------------------------------------------------------
;; dot_rows (kotoba-lang/inference verify/native/gpu/dot_rows.comp at
;; 0f5824c): o[row] = sum over k of w[row cols + k] x[k], one workgroup per
;; row. Bindings: 0 Meta {rows cols : u32} (ro), 1 W (ro), 2 X (ro), 3 O.
(defn kir2-dot-rows [] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B)
        P (kb-meta B 0 2 0) W (kb-buffer B 1 tf 4 true) X (kb-buffer B 2 tf 4 true) O (kb-buffer B 3 tf 4 false)
        part (kb-shared B tf 256)
        vk (kb-var B tu) vst (kb-var B tu) vacc (kb-var B tf)
        u0 (kb-u32 B 0) u256 (kb-u32 B 256) f0 (kb-f32 B 0)
        row (kb-builtin-at B 26 0) t (kb-builtin-at B 27 0)
        g (k2-return-if B (kb-uge B row (kb-meta-at B P tu 0)))
        cols (kb-meta-at B P tu 1)
        a0 (kb-store B vacc f0)
        k (k2-for B vk t cols)
        a1 (k2-acc B vacc (kb-fmul B (kb-load B tf (kb-at B W tf (kb-iadd B (kb-imul B row cols) k))) (kb-load B tf (kb-at B X tf k))))
        e1 (k2-end-for B vk u256)
        s0 (kb-store B (kb-shared-at B part tf t) (kb-load B tf vacc))
        b0 (kb-barrier B)
        tr (k2-tree B part t vst false)
        h (kb-if B (kb-ieq B t u0))
        w (kb-store B (kb-at B O tf row) (kb-load B tf (kb-shared-at B part tf u0)))
        z (kb-end-if B)]
    (kb-module B 256 1 1)))

;; ---------------------------------------------------------------------
;; kdot_f32_r1 (kotoba-lang/inference
;; resources/kotodama/inference/kernels/native/kdot_f32_r1.comp at c7ea9a9;
;; tools/gpu_kernel_refs/kdot-f32-r1.comp is that file): the ggml quantized
;; dot with f32 activations, one row per workgroup, every tensor type in one
;; module as in the GLSL (a runtime branch on Meta.tensor_type: 12 Q4_K, 13
;; Q5_K, 14 Q6_K, 23 IQ4_XS, 8 Q8_0, 2 Q4_0, 1 F16, 30 BF16, 142 PQ2_0, 143
;; PTQ1_0, 3 Q4_1, 6 Q5_0, 7 Q5_1). Bindings: 0 Meta {rows cols tensor_type
;; positions input_per_expert pad0 pad1 pad2 : u32} (ro), 1 W (u32, ro), 2 X
;; (ro), 3 O, 4 E (expert ids, u32, ro). LocalSize 64; dispatch (rows,
;; positions, 1). Each GLSL helper is a function here that writes its code
;; inline and answers the value.

(defn- ku [B :vector-i64 n :i64] :i64 (kb-u32 B n))
(defn- kd-tiv4 [B :vector-i64] :i64 (kb-tvec B (kb-ti32 B) 4))
(defn- kd-tuv4 [B :vector-i64] :i64 (kb-tvec B (kb-tu32 B) 4))
(defn- kd-tv4 [B :vector-i64] :i64 (kb-tvec B (kb-tf32 B) 4))
;; weights[k]
(defn- kd-w [B :vector-i64 W :i64 k :i64] :i64 (kb-load B (kb-tu32 B) (kb-at B W (kb-tu32 B) k)))
;; weight_byte(o) = (weights[o >> 2] >> ((o & 3) * 8)) & 255
(defn- kd-byte [B :vector-i64 W :i64 o :i64] :i64
  (kb-band B (kb-shr B (kd-w B W (kb-shr B o (ku B 2))) (kb-imul B (kb-band B o (ku B 3)) (ku B 8))) (ku B 255)))
;; weight_half(o): unpackHalf2x16(weights[o >> 2]), .y when (o & 2) != 0
(defn- kd-half [B :vector-i64 W :i64 o :i64] :i64
  (let [tf (kb-tf32 B) pr (kb-unpack-half2 B (kd-w B W (kb-shr B o (ku B 2))))]
    (kb-select B tf (kb-ine B (kb-band B o (ku B 2)) (ku B 0)) (kb-extract B tf pr 1) (kb-extract B tf pr 0))))
;; weight_u32_at(o): the u32 at byte o; the second word is read only when o
;; is not word-aligned (an if: at the buffer's end it is past it)
(defn- kd-u32-at [B :vector-i64 W :i64 o :i64] :i64
  (let [tu (kb-tu32 B) v (kb-var B tu)
        w0 (kd-w B W (kb-shr B o (ku B 2))) sh (kb-imul B (kb-band B o (ku B 3)) (ku B 8))
        a (kb-store B v w0)
        g (kb-if B (kb-ine B sh (ku B 0)))
        b (kb-store B v (kb-bor B (kb-shr B w0 sh) (kb-shl B (kd-w B W (kb-iadd B (kb-shr B o (ku B 2)) (ku B 1))) (kb-isub B (ku B 32) sh))))
        e (kb-end-if B)]
    (kb-load B tu v)))
;; int(x), the bits of a u32 as an int
(defn- kd-int [B :vector-i64 x :i64] :i64 (kb-bitcast B (kb-ti32 B) x))
;; a - b for ints, and for ivec4s
(defn- kd-isub [B :vector-i64 a :i64 b :i64] :i64 (kb-op2 B 130 (kb-ti32 B) a b))
(defn- kd-isub4 [B :vector-i64 a :i64 b :i64] :i64 (kb-op2 B 130 (kd-tiv4 B) a b))
;; int((w >> s) & m)
(defn- kd-field [B :vector-i64 w :i64 s :i64 m :i64] :i64 (kd-int B (kb-band B (kb-shr B w s) (ku B m))))
;; ivec4 of the four nibbles of w at shift, 8 + shift, 16 + shift, 24 + shift
(defn- kd-nibbles [B :vector-i64 w :i64 shift :i64] :i64
  (kb-construct4 B (kd-tiv4 B) (kd-field B w shift 15) (kd-field B w (kb-iadd B (ku B 8) shift) 15)
                 (kd-field B w (kb-iadd B (ku B 16) shift) 15) (kd-field B w (kb-iadd B (ku B 24) shift) 15)))
;; ivec4(n) and uvec4(n)
(defn- kd-isplat [B :vector-i64 n :i64] :i64 (let [c (kb-i32 B n)] (kb-construct4 B (kd-tiv4 B) c c c c)))
(defn- kd-usplat [B :vector-i64 x :i64] :i64 (kb-construct4 B (kd-tuv4 B) x x x x))
;; y.x + y.y + y.z + y.w
(defn- kd-sum4 [B :vector-i64 y :i64] :i64
  (let [tf (kb-tf32 B)]
    (kb-fadd B (kb-fadd B (kb-fadd B (kb-extract B tf y 0) (kb-extract B tf y 1)) (kb-extract B tf y 2)) (kb-extract B tf y 3))))
;; dot(vec4(q), y) for an ivec4 q
(defn- kd-dotq [B :vector-i64 q :i64 y :i64] :i64 (kb-fdot B (kb-s2f B (kd-tv4 B) q) y))

;; q4_scale(base, j) and q4_min(base, j): j < 4 picks the first form (both
;; read inside the block, so OpSelect)
(defn- kd-q4-scale [B :vector-i64 W :i64 base :i64 j :i64] :i64
  (let [lo (kb-band B (kd-byte B W (kb-iadd B (kb-iadd B base (ku B 4)) j)) (ku B 63))
        hi (kb-bor B (kb-band B (kd-byte B W (kb-iadd B (kb-iadd B base (ku B 8)) j)) (ku B 15))
                   (kb-shl B (kb-shr B (kd-byte B W (kb-iadd B base j)) (ku B 6)) (ku B 4)))]
    (kd-int B (kb-select B (kb-tu32 B) (kb-ult B j (ku B 4)) lo hi))))
(defn- kd-q4-min [B :vector-i64 W :i64 base :i64 j :i64] :i64
  (let [lo (kb-band B (kd-byte B W (kb-iadd B (kb-iadd B base (ku B 8)) j)) (ku B 63))
        hi (kb-bor B (kb-shr B (kd-byte B W (kb-iadd B (kb-iadd B base (ku B 8)) j)) (ku B 4))
                   (kb-shl B (kb-shr B (kd-byte B W (kb-iadd B (kb-iadd B base (ku B 4)) j)) (ku B 6)) (ku B 4)))]
    (kd-int B (kb-select B (kb-tu32 B) (kb-ult B j (ku B 4)) lo hi))))
;; q4_word_values: group = index / 64, within = index & 63; w = weights[(base
;; + 16 + group 32 + (within & 31)) >> 2]; the nibbles at (within >= 32) ? 4 : 0
(defn- kd-q4-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [tu (kb-tu32 B) group (kb-udiv B index (ku B 64)) within (kb-band B index (ku B 63))
        w (kd-w B W (kb-shr B (kb-iadd B (kb-iadd B (kb-iadd B base (ku B 16)) (kb-imul B group (ku B 32))) (kb-band B within (ku B 31))) (ku B 2)))]
    (kd-nibbles B w (kb-select B tu (kb-uge B within (ku B 32)) (ku B 4) (ku B 0)))))
;; q6_word_values
(defn- kd-q6-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [tu (kb-tu32 B)
        group (kb-udiv B index (ku B 128)) within (kb-band B index (ku B 127)) lane (kb-band B within (ku B 31))
        qlb (kb-iadd B base (kb-imul B group (ku B 64)))
        qh (kd-u32-at B W (kb-iadd B (kb-iadd B (kb-iadd B base (ku B 128)) (kb-imul B group (ku B 32))) lane))
        quarter (kb-udiv B within (ku B 32))
        ql (kd-u32-at B W (kb-iadd B (kb-iadd B qlb (kb-select B tu (kb-ieq B (kb-band B quarter (ku B 1)) (ku B 1)) (ku B 32) (ku B 0))) lane))
        qls (kb-select B tu (kb-uge B quarter (ku B 2)) (ku B 4) (ku B 0))
        qhs (kb-imul B quarter (ku B 2))
        ;; int(((ql >> (k + ql_shift)) & 15) | (((qh >> (k + qh_shift)) & 3) << 4)) - 32
        c0 (kd-isub B (kd-int B (kb-bor B (kb-band B (kb-shr B ql qls) (ku B 15)) (kb-shl B (kb-band B (kb-shr B qh qhs) (ku B 3)) (ku B 4)))) (kb-i32 B 32))
        c1 (kd-isub B (kd-int B (kb-bor B (kb-band B (kb-shr B ql (kb-iadd B (ku B 8) qls)) (ku B 15)) (kb-shl B (kb-band B (kb-shr B qh (kb-iadd B (ku B 8) qhs)) (ku B 3)) (ku B 4)))) (kb-i32 B 32))
        c2 (kd-isub B (kd-int B (kb-bor B (kb-band B (kb-shr B ql (kb-iadd B (ku B 16) qls)) (ku B 15)) (kb-shl B (kb-band B (kb-shr B qh (kb-iadd B (ku B 16) qhs)) (ku B 3)) (ku B 4)))) (kb-i32 B 32))
        c3 (kd-isub B (kd-int B (kb-bor B (kb-band B (kb-shr B ql (kb-iadd B (ku B 24) qls)) (ku B 15)) (kb-shl B (kb-band B (kb-shr B qh (kb-iadd B (ku B 24) qhs)) (ku B 3)) (ku B 4)))) (kb-i32 B 32))]
    (kb-construct4 B (kd-tiv4 B) c0 c1 c2 c3)))
;; kvalue(i): the IQ4_XS codebook entry, from four packed words by comparison
(defn- kd-kvalue [B :vector-i64 i :i64] :i64
  (let [tu (kb-tu32 B)
        w (kb-select B tu (kb-ult B i (ku B 4)) (ku B 0xBFAD9881)
                     (kb-select B tu (kb-ult B i (ku B 8)) (ku B 0xF6EADDCF)
                                (kb-select B tu (kb-ult B i (ku B 12)) (ku B 0x26190D01) (ku B 0x71594535))))]
    (kb-sbfe B (kd-int B w) (kd-int B (kb-imul B (kb-band B i (ku B 3)) (ku B 8))) (kb-i32 B 8))))
;; q5_word_values
(defn- kd-q5-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [tu (kb-tu32 B)
        group (kb-udiv B index (ku B 64)) within (kb-band B index (ku B 63)) lane (kb-band B within (ku B 31))
        hi (kb-uge B within (ku B 32))
        qs (kd-w B W (kb-shr B (kb-iadd B (kb-iadd B (kb-iadd B base (ku B 48)) (kb-imul B group (ku B 32))) lane) (ku B 2)))
        qh (kd-w B W (kb-shr B (kb-iadd B (kb-iadd B base (ku B 16)) lane) (ku B 2)))
        shift (kb-select B tu hi (ku B 4) (ku B 0))
        bit (kb-iadd B (kb-imul B (ku B 2) group) (kb-select B tu hi (ku B 1) (ku B 0)))
        ;; int(((qs >> (k + shift)) & 15) | (((qh >> (k + bit)) & 1) << 4))
        c0 (kd-int B (kb-bor B (kb-band B (kb-shr B qs shift) (ku B 15)) (kb-shl B (kb-band B (kb-shr B qh bit) (ku B 1)) (ku B 4))))
        c1 (kd-int B (kb-bor B (kb-band B (kb-shr B qs (kb-iadd B (ku B 8) shift)) (ku B 15)) (kb-shl B (kb-band B (kb-shr B qh (kb-iadd B (ku B 8) bit)) (ku B 1)) (ku B 4))))
        c2 (kd-int B (kb-bor B (kb-band B (kb-shr B qs (kb-iadd B (ku B 16) shift)) (ku B 15)) (kb-shl B (kb-band B (kb-shr B qh (kb-iadd B (ku B 16) bit)) (ku B 1)) (ku B 4))))
        c3 (kd-int B (kb-bor B (kb-band B (kb-shr B qs (kb-iadd B (ku B 24) shift)) (ku B 15)) (kb-shl B (kb-band B (kb-shr B qh (kb-iadd B (ku B 24) bit)) (ku B 1)) (ku B 4))))]
    (kb-construct4 B (kd-tiv4 B) c0 c1 c2 c3)))
;; iq4xs_word_values and iq4xs_scale
(defn- kd-iq4xs-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [tu (kb-tu32 B)
        ib (kb-udiv B index (ku B 32)) within (kb-band B index (ku B 31)) hi (kb-uge B within (ku B 16))
        w (kd-w B W (kb-shr B (kb-iadd B (kb-iadd B (kb-iadd B base (ku B 8)) (kb-imul B ib (ku B 16)))
                                        (kb-select B tu hi (kb-isub B within (ku B 16)) within))
                         (ku B 2)))
        shift (kb-select B tu hi (ku B 4) (ku B 0))]
    (kb-construct4 B (kd-tiv4 B)
                   (kd-kvalue B (kb-band B (kb-shr B w shift) (ku B 15)))
                   (kd-kvalue B (kb-band B (kb-shr B w (kb-iadd B (ku B 8) shift)) (ku B 15)))
                   (kd-kvalue B (kb-band B (kb-shr B w (kb-iadd B (ku B 16) shift)) (ku B 15)))
                   (kd-kvalue B (kb-band B (kb-shr B w (kb-iadd B (ku B 24) shift)) (ku B 15))))))
(defn- kd-iq4xs-scale [B :vector-i64 W :i64 base :i64 ib :i64] :i64
  (let [sh (kb-shr B (kd-w B W (kb-shr B base (ku B 2))) (ku B 16))
        sl (kd-byte B W (kb-iadd B (kb-iadd B base (ku B 4)) (kb-udiv B ib (ku B 2))))]
    (kd-int B (kb-bor B (kb-band B (kb-shr B sl (kb-imul B (ku B 4) (kb-band B ib (ku B 1)))) (ku B 15))
                     (kb-shl B (kb-band B (kb-shr B sh (kb-imul B (ku B 2) ib)) (ku B 3)) (ku B 4))))))
;; q8_0_word_values: the four int8 of weight_u32_at(base + (index / 32) 34 + 2 + (index & 31))
(defn- kd-q8-0-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [w (kd-int B (kd-u32-at B W (kb-iadd B (kb-iadd B (kb-iadd B base (kb-imul B (kb-udiv B index (ku B 32)) (ku B 34))) (ku B 2)) (kb-band B index (ku B 31)))))
        e8 (kb-i32 B 8)]
    (kb-construct4 B (kd-tiv4 B) (kb-sbfe B w (kb-i32 B 0) e8) (kb-sbfe B w e8 e8) (kb-sbfe B w (kb-i32 B 16) e8) (kb-sbfe B w (kb-i32 B 24) e8))))
;; q4_0_word_values: the nibbles of weight_u32_at(base + (index / 32) 18 + 2 + (within & 15)), less 8
(defn- kd-q4-0-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [tu (kb-tu32 B) within (kb-band B index (ku B 31))
        shift (kb-select B tu (kb-uge B within (ku B 16)) (ku B 4) (ku B 0))
        w (kd-u32-at B W (kb-iadd B (kb-iadd B (kb-iadd B base (kb-imul B (kb-udiv B index (ku B 32)) (ku B 18))) (ku B 2)) (kb-band B within (ku B 15))))]
    (kd-isub4 B (kd-nibbles B w shift) (kd-isplat B 8))))
;; f16_values: vec4(unpackHalf2x16(weights[w]), unpackHalf2x16(weights[w + 1])), w = (base + index 2) >> 2
(defn- kd-f16-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [w (kb-shr B (kb-iadd B base (kb-imul B index (ku B 2))) (ku B 2))]
    (kb-construct2 B (kd-tv4 B) (kb-unpack-half2 B (kd-w B W w)) (kb-unpack-half2 B (kd-w B W (kb-iadd B w (ku B 1)))))))
;; pq2_0_word_values: four 2-bit codes less 1 of weight_u32_at(base + 2 + e / 4) from s = (e & 3) 2
(defn- kd-pq2-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [e (kb-band B index (ku B 127))
        w (kd-u32-at B W (kb-iadd B (kb-iadd B base (ku B 2)) (kb-udiv B e (ku B 4))))
        s (kb-imul B (kb-band B e (ku B 3)) (ku B 2))
        i1 (kb-i32 B 1)]
    (kb-construct4 B (kd-tiv4 B) (kd-isub B (kd-field B w s 3) i1) (kd-isub B (kd-field B w (kb-iadd B s (ku B 2)) 3) i1)
                   (kd-isub B (kd-field B w (kb-iadd B s (ku B 4)) 3) i1) (kd-isub B (kd-field B w (kb-iadd B s (ku B 6)) 3) i1))))
;; ptq1_pow3(n) = 3^n for n <= 4, and ptq1_decode_byte(b, p) = int((((b p) & 255) 3) >> 8) - 1
(defn- kd-pow3 [B :vector-i64 n :i64] :i64
  (let [tu (kb-tu32 B)]
    (kb-select B tu (kb-ieq B n (ku B 0)) (ku B 1)
               (kb-select B tu (kb-ieq B n (ku B 1)) (ku B 3)
                          (kb-select B tu (kb-ieq B n (ku B 2)) (ku B 9)
                                     (kb-select B tu (kb-ieq B n (ku B 3)) (ku B 27) (ku B 81)))))))
(defn- kd-trit [B :vector-i64 b :i64 p :i64] :i64
  (kd-isub B (kd-int B (kb-shr B (kb-imul B (kb-band B (kb-imul B b p) (ku B 255)) (ku B 3)) (ku B 8))) (kb-i32 B 1)))
;; ptq1_0_word_values: e < 120 decodes four radix bytes at one depth as a
;; vector, else the two tail bytes; the arms read different words (an if
;; into v)
(defn- kd-ptq1-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [tu (kb-tu32 B) tuv (kd-tuv4 B) tiv (kd-tiv4 B) v (kb-var B tiv)
        e (kb-band B index (ku B 127))
        g (kb-if B (kb-ult B e (ku B 120)))
        lo (kb-ult B e (ku B 80))
        q (kb-select B tu lo e (kb-isub B e (ku B 80)))
        off (kb-select B tu lo (kb-iadd B base (kb-band B e (ku B 15))) (kb-iadd B (kb-iadd B base (ku B 16)) (kb-band B q (ku B 7))))
        n (kb-select B tu lo (kb-shr B e (ku B 4)) (kb-shr B q (ku B 3)))
        w (kd-w B W (kb-shr B off (ku B 2)))
        b0 (kb-construct4 B tuv (kb-band B w (ku B 255)) (kb-band B (kb-shr B w (ku B 8)) (ku B 255))
                          (kb-band B (kb-shr B w (ku B 16)) (ku B 255)) (kb-shr B w (ku B 24)))
        b1 (kb-op2 B 199 tuv (kb-op2 B 132 tuv b0 (kd-usplat B (kd-pow3 B n))) (kd-usplat B (ku B 255)))
        a (kb-store B v (kb-op2 B 130 tiv (kb-bitcast B tiv (kb-op2 B 194 tuv (kb-op2 B 132 tuv b1 (kd-usplat B (ku B 3))) (kd-usplat B (ku B 8))))
                                (kd-isplat B 1)))
        x (kb-else B)
        wt (kd-w B W (kb-shr B (kb-iadd B base (ku B 24)) (ku B 2)))
        nt (kb-shr B (kb-isub B e (ku B 120)) (ku B 1))
        t0 (kb-band B wt (ku B 255)) t1 (kb-band B (kb-shr B wt (ku B 8)) (ku B 255))
        p0 (kd-pow3 B nt) p1 (kd-pow3 B (kb-iadd B nt (ku B 1)))
        b (kb-store B v (kb-construct4 B tiv (kd-trit B t0 p0) (kd-trit B t1 p0) (kd-trit B t0 p1) (kd-trit B t1 p1)))
        z (kb-end-if B)]
    (kb-load B tiv v)))
;; bf16_values: the four bf16 of weights[w], weights[w + 1] as floats
(defn- kd-bf16-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [tf (kb-tf32 B) w (kb-shr B (kb-iadd B base (kb-imul B index (ku B 2))) (ku B 2))
        a (kd-w B W w) b (kd-w B W (kb-iadd B w (ku B 1)))
        lo16 (ku B 0xffff) hi16 (ku B 0xffff0000)]
    (kb-construct4 B (kd-tv4 B) (kb-bitcast B tf (kb-shl B (kb-band B a lo16) (ku B 16))) (kb-bitcast B tf (kb-band B a hi16))
                   (kb-bitcast B tf (kb-shl B (kb-band B b lo16) (ku B 16))) (kb-bitcast B tf (kb-band B b hi16)))))
;; q4_1_word_values: the nibbles of weight_u32_at(base + (index / 32) 20 + 4 + (within & 15))
(defn- kd-q4-1-values [B :vector-i64 W :i64 base :i64 index :i64] :i64
  (let [tu (kb-tu32 B) within (kb-band B index (ku B 31))
        shift (kb-select B tu (kb-uge B within (ku B 16)) (ku B 4) (ku B 0))
        w (kd-u32-at B W (kb-iadd B (kb-iadd B (kb-iadd B base (kb-imul B (kb-udiv B index (ku B 32)) (ku B 20))) (ku B 4)) (kb-band B within (ku B 15))))]
    (kd-nibbles B w shift)))
;; q5x_word_values(base, index, bb, qh_off): Q5_0 (22, 2) and Q5_1 (24, 4)
(defn- kd-q5x-values [B :vector-i64 W :i64 base :i64 index :i64 bb :i64 qh-off :i64] :i64
  (let [tu (kb-tu32 B) within (kb-band B index (ku B 31))
        shift (kb-select B tu (kb-uge B within (ku B 16)) (ku B 4) (ku B 0))
        blk (kb-iadd B base (kb-imul B (kb-udiv B index (ku B 32)) (ku B bb)))
        w (kd-u32-at B W (kb-iadd B (kb-iadd B (kb-iadd B blk (ku B qh-off)) (ku B 4)) (kb-band B within (ku B 15))))
        hb (kb-band B (kb-shr B (kd-u32-at B W (kb-iadd B blk (ku B qh-off))) within) (ku B 15))
        ;; int(((w >> (k + shift)) & 15) | (((hb >> k') & 1) << 4))
        c0 (kd-int B (kb-bor B (kb-band B (kb-shr B w shift) (ku B 15)) (kb-shl B (kb-band B hb (ku B 1)) (ku B 4))))
        c1 (kd-int B (kb-bor B (kb-band B (kb-shr B w (kb-iadd B (ku B 8) shift)) (ku B 15)) (kb-shl B (kb-band B (kb-shr B hb (ku B 1)) (ku B 1)) (ku B 4))))
        c2 (kd-int B (kb-bor B (kb-band B (kb-shr B w (kb-iadd B (ku B 16) shift)) (ku B 15)) (kb-shl B (kb-band B (kb-shr B hb (ku B 2)) (ku B 1)) (ku B 4))))
        c3 (kd-int B (kb-bor B (kb-band B (kb-shr B w (kb-iadd B (ku B 24) shift)) (ku B 15)) (kb-shl B (kb-band B (kb-shr B hb (ku B 3)) (ku B 1)) (ku B 4))))]
    (kb-construct4 B (kd-tiv4 B) c0 c1 c2 c3)))
;; block_bytes_of(t): bytes per 256 values
(defn- kd-block-bytes [B :vector-i64 t :i64] :i64
  (let [tu (kb-tu32 B)]
    (loop [k 12 r (ku B 0)]
      (if (< k 0) r
        (let [tt (vector-at [12 13 14 23 8 2 1 30 142 143 3 6 7] k)
              bb (vector-at [144 176 210 136 272 144 512 512 68 56 160 176 192] k)]
          (recur (dec k) (kb-select B tu (kb-ieq B t (ku B tt)) (ku B bb) r)))))))
;; is_block32(t)
(defn- kd-block32? [B :vector-i64 t :i64] :i64
  (loop [k 6 r (kb-bool B false)]
    (if (< k 0) r
      (recur (dec k) (kb-lor B (kb-ieq B t (ku B (vector-at [8 2 1 30 3 6 7] k))) r)))))

;; acc += v
(defn- kd-acc [B :vector-i64 vacc :i64 v :i64] :i64 (k2-acc B vacc v))
;; the dot of one block: the branch on tt in the GLSL's order
(defn- kd-block [B :vector-i64 W :i64 tt :i64 wb :i64 index :i64 y :i64 vacc :i64 vmin :i64 vq :i64] :i64
  (let [tu (kb-tu32 B) tf (kb-tf32 B) tiv (kd-tiv4 B)
        ;; 12 Q4_K, 13 Q5_K
        g1 (kb-if B (kb-lor B (kb-ieq B tt (ku B 12)) (kb-ieq B tt (ku B 13))))
        j (kb-udiv B index (ku B 32))
        sc (kb-s2f B tf (kd-q4-scale B W wb j))
        q1 (kb-if B (kb-ieq B tt (ku B 12)))
        q2 (kb-store B vq (kd-q4-values B W wb index))
        q3 (kb-else B)
        q4 (kb-store B vq (kd-q5-values B W wb index))
        q5 (kb-end-if B)
        a1 (kd-acc B vacc (kb-fmul B (kb-fmul B (kd-half B W wb) sc) (kd-dotq B (kb-load B tiv vq) y)))
        a2 (kb-store B vmin (kb-fadd B (kb-load B tf vmin)
                                     (kb-fmul B (kb-fmul B (kd-half B W (kb-iadd B wb (ku B 2))) (kb-s2f B tf (kd-q4-min B W wb j))) (kd-sum4 B y))))
        e1 (kb-else B)
        ;; 23 IQ4_XS
        g2 (kb-if B (kb-ieq B tt (ku B 23)))
        ib (kb-udiv B index (ku B 32))
        ls (kb-s2f B tf (kd-isub B (kd-iq4xs-scale B W wb ib) (kb-i32 B 32)))
        a3 (kd-acc B vacc (kb-fmul B (kb-fmul B (kd-half B W wb) ls) (kd-dotq B (kd-iq4xs-values B W wb index) y)))
        e2 (kb-else B)
        ;; 8 Q8_0
        g3 (kb-if B (kb-ieq B tt (ku B 8)))
        a4 (kd-acc B vacc (kb-fmul B (kd-half B W (kb-iadd B wb (kb-imul B (kb-udiv B index (ku B 32)) (ku B 34)))) (kd-dotq B (kd-q8-0-values B W wb index) y)))
        e3 (kb-else B)
        ;; 2 Q4_0
        g4 (kb-if B (kb-ieq B tt (ku B 2)))
        a5 (kd-acc B vacc (kb-fmul B (kd-half B W (kb-iadd B wb (kb-imul B (kb-udiv B index (ku B 32)) (ku B 18)))) (kd-dotq B (kd-q4-0-values B W wb index) y)))
        e4 (kb-else B)
        ;; 1 F16
        g5 (kb-if B (kb-ieq B tt (ku B 1)))
        a6 (kd-acc B vacc (kb-fdot B (kd-f16-values B W wb index) y))
        e5 (kb-else B)
        ;; 30 BF16
        g6 (kb-if B (kb-ieq B tt (ku B 30)))
        a7 (kd-acc B vacc (kb-fdot B (kd-bf16-values B W wb index) y))
        e6 (kb-else B)
        ;; 142 PQ2_0, 143 PTQ1_0
        g7 (kb-if B (kb-lor B (kb-ieq B tt (ku B 142)) (kb-ieq B tt (ku B 143))))
        pq (kb-ieq B tt (ku B 142))
        qb (kb-iadd B wb (kb-imul B (kb-udiv B index (ku B 128)) (kb-select B tu pq (ku B 34) (ku B 28))))
        r1 (kb-if B pq)
        r2 (kb-store B vq (kd-pq2-values B W qb index))
        r3 (kb-else B)
        r4 (kb-store B vq (kd-ptq1-values B W qb index))
        r5 (kb-end-if B)
        a8 (kd-acc B vacc (kb-fmul B (kd-half B W (kb-iadd B qb (kb-select B tu pq (ku B 0) (ku B 26)))) (kd-dotq B (kb-load B tiv vq) y)))
        e7 (kb-else B)
        ;; 3 Q4_1
        g8 (kb-if B (kb-ieq B tt (ku B 3)))
        b3 (kb-iadd B wb (kb-imul B (kb-udiv B index (ku B 32)) (ku B 20)))
        a9 (kd-acc B vacc (kb-fmul B (kd-half B W b3) (kd-dotq B (kd-q4-1-values B W wb index) y)))
        m3 (kb-store B vmin (kb-fsub B (kb-load B tf vmin) (kb-fmul B (kd-half B W (kb-iadd B b3 (ku B 2))) (kd-sum4 B y))))
        e8 (kb-else B)
        ;; 6 Q5_0
        g9 (kb-if B (kb-ieq B tt (ku B 6)))
        a10 (kd-acc B vacc (kb-fmul B (kd-half B W (kb-iadd B wb (kb-imul B (kb-udiv B index (ku B 32)) (ku B 22))))
                                     (kd-dotq B (kd-isub4 B (kd-q5x-values B W wb index 22 2) (kd-isplat B 16)) y)))
        e9 (kb-else B)
        ;; 7 Q5_1
        g10 (kb-if B (kb-ieq B tt (ku B 7)))
        b7 (kb-iadd B wb (kb-imul B (kb-udiv B index (ku B 32)) (ku B 24)))
        a11 (kd-acc B vacc (kb-fmul B (kd-half B W b7) (kd-dotq B (kd-q5x-values B W wb index 24 4) y)))
        m7 (kb-store B vmin (kb-fsub B (kb-load B tf vmin) (kb-fmul B (kd-half B W (kb-iadd B b7 (ku B 2))) (kd-sum4 B y))))
        e10 (kb-else B)
        ;; else Q6_K: scale = the signed byte at wb + 192 + index / 16
        sb (kd-byte B W (kb-iadd B (kb-iadd B wb (ku B 192)) (kb-udiv B index (ku B 16))))
        sbi (kb-select B (kb-ti32 B) (kb-uge B sb (ku B 128)) (kd-isub B (kd-int B sb) (kb-i32 B 256)) (kd-int B sb))
        a12 (kd-acc B vacc (kb-fmul B (kb-fmul B (kd-half B W (kb-iadd B wb (ku B 208))) (kb-s2f B tf sbi)) (kd-dotq B (kd-q6-values B W wb index) y)))
        z10 (kb-end-if B) z9 (kb-end-if B) z8 (kb-end-if B) z7 (kb-end-if B) z6 (kb-end-if B)
        z5 (kb-end-if B) z4 (kb-end-if B) z3 (kb-end-if B) z2 (kb-end-if B)]
    (kb-end-if B)))

(defn kir2-kdot-f32-r1 [] :vector-i64
  (let [B (kb-new) f (kb-main B) tu (kb-tu32 B) tf (kb-tf32 B)
        P (kb-meta B 0 8 0) W (kb-buffer B 1 tu 4 true) X (kb-buffer B 2 tf 4 true) O (kb-buffer B 3 tf 4 false)
        E (kb-buffer B 4 tu 4 true)
        part (kb-shared B tf 64)
        vacc (kb-var B tf) vmin (kb-var B tf) vblk (kb-var B tu) vst (kb-var B tu) vin (kb-var B tu) vq (kb-var B (kd-tiv4 B))
        u0 (kb-u32 B 0) u1 (kb-u32 B 1) f0 (kb-f32 B 0)
        row (kb-builtin-at B 26 0) position (kb-builtin-at B 26 1) t (kb-builtin-at B 27 0)
        expert (kb-load B tu (kb-at B E tu position))
        ;; in_row = ((input_per_expert == 1) ? ((pad0 > 1) ? position / pad0 : position) : 0) + pad1
        ;; (the division in an if: pad0 may be 0)
        i0 (kb-store B vin u0)
        i1 (kb-if B (kb-ieq B (kb-meta-at B P tu 4) u1))
        i2 (kb-store B vin position)
        i3 (kb-if B (kb-ugt B (kb-meta-at B P tu 5) u1))
        i4 (kb-store B vin (kb-udiv B position (kb-meta-at B P tu 5)))
        i5 (kb-end-if B)
        i6 (kb-end-if B)
        in-row (kb-iadd B (kb-load B tu vin) (kb-meta-at B P tu 6))
        rows (kb-meta-at B P tu 0) cols (kb-meta-at B P tu 1) tt (kb-meta-at B P tu 2) positions (kb-meta-at B P tu 3)
        b32 (kd-block32? B tt)
        blocks (kb-select B tu b32 (kb-udiv B (kb-iadd B cols (ku B 255)) (ku B 256)) (kb-udiv B cols (ku B 256)))
        bbytes (kd-block-bytes B tt)
        row-bytes (kb-select B tu b32 (kb-imul B (kb-udiv B (kb-iadd B cols (ku B 31)) (ku B 32)) (kb-udiv B bbytes (ku B 8)))
                             (kb-imul B blocks bbytes))
        index (kb-imul B t (ku B 4))
        a0 (kb-store B vacc f0) m0 (kb-store B vmin f0)
        live (kb-land B (kb-ult B row rows) (kb-ult B position positions))
        g (kb-if B live)
        rowbase (kb-imul B (kb-iadd B (kb-imul B expert rows) row) row-bytes)
        blk (k2-for B vblk u0 blocks)
        ;; if (block 256 + index >= cols) continue;
        c0 (kb-if B (kb-uge B (kb-iadd B (kb-imul B blk (ku B 256)) index) cols))
        c1 (kb-next B)
        c2 (kb-end-if B)
        xb (kb-iadd B (kb-iadd B (kb-imul B in-row cols) (kb-imul B blk (ku B 256))) index)
        y (kb-construct4 B (kd-tv4 B) (kb-load B tf (kb-at B X tf xb)) (kb-load B tf (kb-at B X tf (kb-iadd B xb u1)))
                         (kb-load B tf (kb-at B X tf (kb-iadd B xb (ku B 2)))) (kb-load B tf (kb-at B X tf (kb-iadd B xb (ku B 3)))))
        wb (kb-iadd B rowbase (kb-imul B blk bbytes))
        d (kd-block B W tt wb index y vacc vmin vq)
        e (k2-end-for B vblk u1)
        z (kb-end-if B)
        ;; partial[t] = acc - mins; the tree from stride 32
        p0 (kb-store B (kb-shared-at B part tf t) (kb-fsub B (kb-load B tf vacc) (kb-load B tf vmin)))
        p1 (kb-barrier B)
        p2 (kb-store B vst (ku B 32))
        l (kb-loop B)
        w (kb-while B (kb-ugt B (kb-load B tu vst) u0))
        st (kb-load B tu vst)
        h (kb-if B (kb-ult B t st))
        hs (kb-store B (kb-shared-at B part tf t) (kb-fadd B (kb-load B tf (kb-shared-at B part tf t)) (kb-load B tf (kb-shared-at B part tf (kb-iadd B t st)))))
        he (kb-end-if B)
        hb (kb-barrier B)
        hc (kb-continue B)
        hn (kb-store B vst (kb-shr B (kb-load B tu vst) u1))
        le (kb-end-loop B)
        o0 (kb-if B (kb-land B (kb-ieq B t u0) (kb-land B (kb-ult B row rows) (kb-ult B position positions))))
        o1 (kb-store B (kb-at B O tf (kb-iadd B (kb-imul B position rows) row)) (kb-load B tf (kb-shared-at B part tf u0)))
        o2 (kb-end-if B)]
    (kb-module B 64 1 1)))
