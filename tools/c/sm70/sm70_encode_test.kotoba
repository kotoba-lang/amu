(ns sm70-encode-test (:export [main]))

;; Cases for tools/c/sm70/sm70_encode.kotoba (JUN-713). No GPU:
;; scripts/seed/check-sm70-encode.py builds the unit (this ns line, the
;; encoder without its ns line, then the rest of this file), runs it with
;; bin/amu on the host and compares every printed word bit for bit with its
;; own encoding of the same case, derived from Mesa NAK's sm70_encode.rs.
;;
;; Output, one line per case:
;;   I <name> <lo> <hi>   an encoded instruction, 16 hex digits per half
;;   R <name> <code>      a refused emit: the refusal code, nothing emitted
;;   X <name>             a program that does not hold what the case expects
;; main answers the number of lines printed.

(defn- say [s :string] :i64
  (let [x (typed-cap-call :io/write :string :string (string-concat s "\n"))] 1))

(defn- hexd [d :i64] :string
  (cond (= d 0) "0" (= d 1) "1" (= d 2) "2" (= d 3) "3" (= d 4) "4" (= d 5) "5" (= d 6) "6" (= d 7) "7"
        (= d 8) "8" (= d 9) "9" (= d 10) "a" (= d 11) "b" (= d 12) "c" (= d 13) "d" (= d 14) "e" :else "f"))

(defn- hex16 [w :i64] :string
  (loop [k 15 s ""]
    (if (< k 0) s (recur (dec k) (string-concat s (hexd (bit-and (u64-shift-right w (* 4 k)) 15)))))))

;; print instruction k of M as case name
(defn- show [M :vector-i64 k :i64 name :string] :i64
  (say (string-concat "I " (string-concat name (string-concat " " (string-concat (hex16 (sm70-lo M k))
    (string-concat " " (hex16 (sm70-hi M k)))))))))

;; a program that should hold n instructions: one prints its last; a refused
;; emit prints its code, and must have left the program at n
(defn- one-n [M :vector-i64 n :i64 name :string] :i64
  (cond (not (= (sm70-count M) n)) (say (string-concat "X " name))
        (= (sm70-error M) 0) (show M (- n 1) name)
        :else (say (string-concat "R " (string-concat name (string-concat " " (string-from-i64 (sm70-error M))))))))

(defn- one [M :vector-i64 name :string] :i64
  (if (= (sm70-error M) 0) (one-n M 1 name) (one-n M 0 name)))

(defn- P [] :vector-i64 (sm70-new 1))

;; guard PT, and the control bits NAK leaves when it has no dependencies to
;; track: stall 0, no yield, no barriers (7/7), no wait, no reuse
(def G (sm70-guard 7 0))
(def C0 (sm70-ctl 0 0 7 7 0 0))
;; stall 5, yield, write barrier 0 (a load), wait on barrier 0
(def C1 (sm70-ctl 5 1 0 7 0 0))
(def C2 (sm70-ctl 15 0 7 3 33 9))

(defn- singles [] :i64
  (let [a (one (sm70-nop (P) G C0) "nop")
        b (one (sm70-exit (P) G (sm70-ctl 5 1 7 7 0 0)) "exit")
        c (one (sm70-exit (P) (sm70-guard 0 1) C0) "exit.np0")
        d (one (sm70-bra (P) G C0 7 0 -1) "bra.self")
        e (one (sm70-bra (P) G C0 7 0 0) "bra.next")
        f (one (sm70-bra (P) G C0 2 1 37) "bra.np2.fwd")
        h (one (sm70-bra (P) (sm70-guard 3 0) C0 7 0 -1000000) "bra.gp3.back")
        h2 (one (sm70-bra (P) G C0 7 0 300000000) "bra.far.fwd")
        h3 (one (sm70-bra (P) G C0 7 0 35184372088831) "bra.max")
        h4 (one (sm70-bra (P) G C0 7 0 -35184372088832) "bra.min")
        i (one (sm70-mov (P) G C0 4 9) "mov.r")
        j (one (sm70-mov-imm (P) G C0 1 0x3f800000) "mov.imm")
        k (one (sm70-mov-imm (P) G C0 254 -1) "mov.imm.neg")
        l (one (sm70-s2r (P) G C1 0 SM70-SR-TID-X) "s2r.tid.x")
        m (one (sm70-s2r (P) G C1 3 SM70-SR-CTAID-Y) "s2r.ctaid.y")
        n (one (sm70-s2r (P) G C0 200 SM70-SR-LANEID) "s2r.laneid")
        o (one (sm70-s2r (P) G (sm70-ctl 1 1 0 7 0 0) 0 SM70-SR-TID-X) "s2r.tid.x.listing")]
    (+ a b c d e f h h2 h3 h4 i j k l m n o)))

(defn- arith [] :i64
  (let [a (one (sm70-iadd3 (P) G C0 1 2 3 4) "iadd3")
        b (one (sm70-iadd3 (P) G C2 1 2 255 255) "iadd3.rz")
        c (one (sm70-iadd3-imm (P) G C0 5 6 0x400 255) "iadd3.imm")
        d (one (sm70-iadd3-imm (P) G C0 5 6 -16 7) "iadd3.imm.neg")
        e (one (sm70-imad (P) G C0 8 9 10 11 1) "imad.s32")
        f (one (sm70-imad (P) G C0 8 9 10 11 0) "imad.u32")
        h (one (sm70-imad-imm (P) G C0 2 0 4 255 0) "imad.imm.u32")
        i (one (sm70-imad-imm (P) (sm70-guard 1 0) C0 2 0 -4 3 1) "imad.imm.s32.p1")
        j (one (sm70-fadd (P) G C0 4 5 6 0 0 0) "fadd")
        k (one (sm70-fadd (P) G C0 4 5 6 3 1 1) "fadd.rz.ftz.sat")
        l (one (sm70-fadd-imm (P) G C0 4 5 0x3f800000 0 0 0) "fadd.imm")
        m (one (sm70-fmul (P) G C0 7 8 9 0 0 0) "fmul")
        n (one (sm70-fmul (P) G C0 7 8 9 2 0 1) "fmul.rp.sat")
        o (one (sm70-fmul-imm (P) G C0 7 8 0x40000000 1 1 0) "fmul.imm.rm.ftz")
        p (one (sm70-ffma (P) G C0 12 13 14 15 0 0 0) "ffma")
        q (one (sm70-ffma (P) G C2 12 13 14 15 1 0 0) "ffma.rm.ctl")
        r (one (sm70-ffma-imm (P) G C0 12 13 0xbf000000 15 0 1 0) "ffma.imm.ftz")]
    (+ a b c d e f h i j k l m n o p q r)))

;; the operations the lowering adds (JUN-723): a constant-bank MOV, IMAD.WIDE
;; with an immediate, and ISETP between registers
(defn- wide [] :i64
  (let [a (one (sm70-mov-cb (P) G C0 6 0 0x160) "mov.cb")
        b (one (sm70-mov-cb (P) G (sm70-ctl 5 0 7 7 0 0) 1 0 0x28) "mov.cb.listing")
        c (one (sm70-mov-cb (P) (sm70-guard 2 1) C0 7 3 0xfffc) "mov.cb.bank3.max")
        d (one (sm70-imad-wide-imm (P) G C0 6 0 4 6 0) "imad.wide.u32")
        e (one (sm70-imad-wide-imm (P) G C2 2 9 -8 250 1) "imad.wide.s32.neg")
        f (one (sm70-isetp (P) G C0 0 0 4 1 0) "isetp.lt.u32")
        h (one (sm70-isetp (P) G C0 6 9 255 6 1) "isetp.ge.s32.p6")
        i (one (sm70-isetp (P) (sm70-guard 1 0) C2 3 2 7 2 0) "isetp.eq.u32.gp1")]
    (+ a b c d e f h i)))

(defn- memory [] :i64
  (let [a (one (sm70-ldg (P) G C1 4 2 0 4 3 1 1) "ldg.e.32.strong.gpu")
        b (one (sm70-ldg (P) G C1 4 2 16 5 1 1 1) "ldg.e.64.weak.off")
        c (one (sm70-ldg (P) G C1 8 2 -4 6 0 4 1) "ldg.e.128.constant.neg")
        d (one (sm70-ldg (P) G C1 4 255 256 4 4 0 0) "ldg.rz.32.sys.ef")
        e (one (sm70-ldg (P) G C1 4 2 8388607 1 2 5 1) "ldg.s8.cta.na.max")
        f (one (sm70-stg (P) G C0 2 0 6 4 3 1 1) "stg.e.32.strong.gpu")
        h (one (sm70-stg (P) G C0 2 -8388608 6 5 1 2 1) "stg.e.64.weak.min")
        i (one (sm70-stg (P) (sm70-guard 0 1) C0 10 12 6 3 4 3 0) "stg.s16.sys.np0")]
    (+ a b c d e f h i)))

;; the operations of the dot_rows lowering (JUN-725): shared memory, the
;; workgroup barrier, convergence barriers and a 32-bit right shift
(defn- shared [] :i64
  (let [a (one (sm70-lds (P) G C1 4 2 0 4) "lds.32")
        b (one (sm70-lds (P) (sm70-guard 1 0) C1 9 255 0x3fc 4) "lds.rz.off.p1")
        c (one (sm70-lds (P) G C2 4 2 -8388608 5) "lds.64.min")
        d (one (sm70-sts (P) G C0 2 0 6 4) "sts.32")
        e (one (sm70-sts (P) (sm70-guard 0 1) C2 255 8388607 6 0) "sts.u8.max.np0")
        f (one (sm70-bar (P) G (sm70-ctl 5 1 7 7 0 0)) "bar.sync")
        h (one (sm70-bssy (P) G C0 0 12) "bssy.b0.fwd")
        i (one (sm70-bssy (P) G C2 15 -3) "bssy.b15.back")
        j (one (sm70-bssy (P) G C0 1 134217727) "bssy.max")
        k (one (sm70-bsync (P) G (sm70-ctl 1 1 7 7 0 0)  0) "bsync.b0")
        l (one (sm70-bsync (P) (sm70-guard 2 0) C0 9) "bsync.b9.p2")
        m (one (sm70-shr-imm (P) G C0 5 6 1 0) "shr.u32.1")
        n (one (sm70-shr-imm (P) G C2 5 6 31 1) "shr.s32.31")
        o (one (sm70-shr-imm (P) (sm70-guard 3 1) C0 254 255 0 0) "shr.rz.0.np3")]
    (+ a b c d e f h i j k l m n o)))

;; every refusal leaves the program empty and names its code
(defn- refusals [] :i64
  (let [a (one (sm70-iadd3 (P) G C0 256 2 3 4) "refuse.reg.256")
        b (one (sm70-mov (P) G C0 1 -1) "refuse.reg.neg")
        c (one (sm70-bra (P) G C0 8 0 0) "refuse.pred.8")
        d (one (sm70-bra (P) G C0 7 2 0) "refuse.pred.not")
        e (one (sm70-nop (P) (sm70-guard 8 0) C0) "refuse.guard")
        f (one (sm70-nop (P) G (sm70-ctl 16 0 7 7 0 0)) "refuse.ctl.delay")
        h (one (sm70-nop (P) G (sm70-ctl 0 0 7 7 64 0)) "refuse.ctl.wait")
        i (one (sm70-mov-imm (P) G C0 1 4294967296) "refuse.imm.wide")
        j (one (sm70-mov-imm (P) G C0 1 -2147483649) "refuse.imm.low")
        k (one (sm70-ldg (P) G C0 4 2 8388608 4 3 1 1) "refuse.off.high")
        l (one (sm70-stg (P) G C0 2 -8388609 6 4 3 1 1) "refuse.off.low")
        m (one (sm70-bra (P) G C0 7 0 35184372088832) "refuse.bra.far")
        n (one (sm70-ldg (P) G C0 4 2 0 7 3 1 1) "refuse.enum.mtype")
        o (one (sm70-ldg (P) G C0 4 2 0 4 5 1 1) "refuse.enum.order")
        p (one (sm70-stg (P) G C0 2 0 6 4 3 6 1) "refuse.enum.evict")
        q (one (sm70-fadd (P) G C0 4 5 6 4 0 0) "refuse.enum.rnd")
        r (one (sm70-imad (P) G C0 8 9 10 11 2) "refuse.enum.signed")
        s (one (sm70-s2r (P) G C0 0 256) "refuse.enum.sr")
        t (one-n (sm70-nop (sm70-nop (P) G C0) G C0) 1 "refuse.cap")
        u (one (sm70-mov-cb (P) G C0 1 0 0x162) "refuse.cb.align")
        v (one (sm70-mov-cb (P) G C0 1 32 0) "refuse.cb.bank")
        w (one (sm70-mov-cb (P) G C0 1 0 65536) "refuse.cb.off")
        x (one (sm70-imad-wide-imm (P) G C0 7 0 4 6 0) "refuse.wide.odd")
        y (one (sm70-imad-wide-imm (P) G C0 254 0 4 6 0) "refuse.wide.rz")
        z (one (sm70-isetp (P) G C0 0 0 4 7 0) "refuse.enum.cmp")
        a2 (one (sm70-lds (P) G C0 4 2 8388608 4) "refuse.lds.off")
        b2 (one (sm70-sts (P) G C0 2 0 6 7) "refuse.sts.mtype")
        c2 (one (sm70-bssy (P) G C0 16 0) "refuse.bssy.bar")
        d2 (one (sm70-bssy (P) G C0 0 134217728) "refuse.bssy.far")
        e2 (one (sm70-bsync (P) G C0 -1) "refuse.bsync.bar")
        f2 (one (sm70-shr-imm (P) G C0 5 6 32 0) "refuse.shr.imm")
        g2 (one (sm70-shr-imm (P) G C0 5 6 1 2) "refuse.shr.signed")]
    (+ a b c d e f h i j k l m n o p q r s t u v w x y z a2 b2 c2 d2 e2 f2 g2)))

;; the decode kernels' operations (JUN-739)
(defn- decode-ops [] :i64
  (let [a (one (sm70-fadd-neg (P) G C0 4 5 6 0 1) "fadd.neg.b")
        b (one (sm70-fadd-neg (P) G C2 4 5 255 1 1) "fadd.neg.ab.rz")
        c (one (sm70-iadd3-neg (P) G C0 1 2 3 255 0 1 0) "iadd3.neg.b")
        d (one (sm70-iadd3-neg (P) G C0 1 255 3 4 1 0 1) "iadd3.neg.ac")
        e (one (sm70-fsetp (P) G C0 0 4 5 1 0) "fsetp.lt")
        f (one (sm70-fsetp (P) (sm70-guard 2 1) C2 6 4 5 13 1) "fsetp.neu.ftz.np2")
        h (one (sm70-fsetp-imm (P) G C0 3 9 0 13 0) "fsetp.imm.neu.zero")
        i (one (sm70-fsetp-imm (P) G C0 1 9 0x41a00000 4 0) "fsetp.imm.gt")
        j (one (sm70-fmnmx (P) G C0 4 5 6 0 0) "fmnmx.max")
        k (one (sm70-fmnmx (P) G C2 4 5 6 1 1) "fmnmx.min.ftz")
        l (one (sm70-imnmx (P) G C0 4 5 6 1 0) "imnmx.min.u32")
        m (one (sm70-imnmx (P) G C0 4 5 6 0 1) "imnmx.max.s32")
        n (one (sm70-sel (P) G C0 7 8 9 2 0) "sel.p2")
        o (one (sm70-sel (P) G C2 7 8 255 5 1) "sel.np5.rz")
        q (one (sm70-sel-imm (P) G C0 7 8 0x3f800000 0 0) "sel.imm")
        r (one (sm70-mufu (P) G C1 10 11 0) "mufu.cos")
        s (one (sm70-mufu (P) G C1 10 11 1) "mufu.sin")
        u (one (sm70-mufu (P) G C1 10 11 2) "mufu.ex2")
        v (one (sm70-mufu (P) G C1 10 11 3) "mufu.lg2")
        w (one (sm70-mufu (P) G C1 10 11 4) "mufu.rcp")
        x (one (sm70-mufu (P) G C2 10 11 5) "mufu.rsq")
        y (one (sm70-mufu (P) G C0 10 11 8) "mufu.sqrt")
        z (one (sm70-i2f (P) G C1 12 13 0 0) "i2f.u32")
        a2 (one (sm70-i2f (P) G C2 12 13 1 3) "i2f.s32.rz")
        b2 (one (sm70-f2i (P) G C1 12 13 0 3 0) "f2i.u32.trunc")
        c2 (one (sm70-f2i (P) G C1 12 13 1 0 1) "f2i.s32.rn.ftz")
        d2 (one (sm70-lop3 (P) G C0 4 5 6 7 0x80) "lop3.and3")
        e2 (one (sm70-lop3 (P) G C0 4 5 6 255 0xfc) "lop3.or.rz")
        f2 (one (sm70-lop3-imm (P) G C2 4 5 0xff 255 0xc0) "lop3.imm.and")
        g2 (one (sm70-shf (P) G C0 4 5 6 255 2 1 0 0) "shf.l.w.s32")
        h2 (one (sm70-shf (P) G C0 4 255 6 5 3 1 1 1) "shf.r.w.u32.hi")
        i2 (one (sm70-shf-imm (P) G C0 4 5 3 255 2 1 0 0) "shf.l.imm")
        j2 (one (sm70-shf-imm (P) G C2 4 255 24 5 2 1 1 1) "shf.r.s32.hi.imm")
        k2 (one (sm70-imad-wide (P) G C0 6 2 3 255 0) "imad.wide.u32.rz")
        l2 (one (sm70-imad-wide (P) G C0 6 2 3 8 1) "imad.wide.s32.pair")
        m2 (one (sm70-sgxt-imm (P) G C0 4 5 8 1) "sgxt.s8")
        n2 (one (sm70-sgxt-imm (P) G C0 4 5 4 0) "sgxt.u4")]
    (+ a b c d e f h i j k l m n o q r s u v w x y z a2 b2 c2 d2 e2 f2 g2 h2 i2 j2 k2 l2 m2 n2)))

(defn- decode-refusals [] :i64
  (let [a (one (sm70-fadd-neg (P) G C0 4 5 6 2 0) "refuse.fadd.neg")
        b (one (sm70-iadd3-neg (P) G C0 1 2 3 4 1 1 0) "refuse.iadd3.neg2")
        c (one (sm70-fsetp (P) G C0 0 4 5 15 0) "refuse.fsetp.cmp")
        d (one (sm70-fsetp (P) G C0 8 4 5 1 0) "refuse.fsetp.pd")
        e (one (sm70-mufu (P) G C0 4 5 9) "refuse.mufu.tanh")
        f (one (sm70-mufu (P) G C0 4 5 6) "refuse.mufu.rcp64h")
        h (one (sm70-i2f (P) G C0 4 5 0 4) "refuse.i2f.rnd")
        i (one (sm70-lop3 (P) G C0 4 5 6 7 256) "refuse.lop3.lut")
        j (one (sm70-shf-imm (P) G C0 4 5 64 255 3 1 1 1) "refuse.shf.imm")
        k (one (sm70-shf (P) G C0 4 5 6 7 4 1 0 0) "refuse.shf.type")
        l (one (sm70-imad-wide (P) G C0 6 2 3 7 0) "refuse.wide.reg.odd")
        m (one (sm70-sel (P) G C0 7 8 9 8 0) "refuse.sel.pred")
        n (one (sm70-sgxt-imm (P) G C0 4 5 33 1) "refuse.sgxt.bits")
        o (one (sm70-plop3 (P) G C0 8 0 0 1 0 7 0 0x80) "refuse.plop3.pred")
        q (one (sm70-plop3 (P) G C0 0 0 0 1 0 7 0 256) "refuse.plop3.lut")]
    (+ a b c d e f h i j k l m n o q)))

;; PLOP3 (part 2 of JUN-739)
(defn- plop3-ops [] :i64
  (let [a (one (sm70-plop3 (P) G C0 2 0 0 1 0 7 0 0xc0) "plop3.and")
        b (one (sm70-plop3 (P) G C2 3 0 0 1 0 7 0 0xfc) "plop3.or")
        c (one (sm70-plop3 (P) (sm70-guard 4 0) C0 5 0 0 1 1 2 0 0xe4) "plop3.select")
        d (one (sm70-plop3 (P) G C0 6 7 1 4 0 7 0 0xf0) "plop3.not.a")]
    (+ a b c d)))

;; a kernel-shaped sequence (y[i] = R1 * x[i] + y[i], i = ctaid.x * 128 +
;; tid.x, x at R2, y at R4) with the control bits a scheduler would give it.
;; It is not a correct kernel: the address arithmetic is 32-bit (IMAD.WIDE
;; and constant-bank operands are not in this starter set) and the inputs
;; are never loaded. It checks that consecutive emits land in order.
(defn- saxpy [] :i64
  (let [M (-> (sm70-new 12)
              (sm70-s2r G C1 0 SM70-SR-TID-X)
              (sm70-s2r G (sm70-ctl 1 1 1 7 0 0) 6 SM70-SR-CTAID-X)
              (sm70-imad-imm G (sm70-ctl 4 1 7 7 3 0) 0 6 128 0 0)
              (sm70-imad-imm G C0 8 0 4 2 0)
              (sm70-imad-imm G C0 10 0 4 4 0)
              (sm70-ldg G (sm70-ctl 1 1 2 7 0 0) 12 8 0 4 3 1 1)
              (sm70-ldg G (sm70-ctl 1 1 3 7 0 0) 13 10 0 4 3 1 1)
              (sm70-ffma G (sm70-ctl 4 1 7 7 12 0) 13 12 1 13 0 0 0)
              (sm70-stg G (sm70-ctl 1 1 7 7 0 0) 10 0 13 4 3 1 1)
              (sm70-exit G (sm70-ctl 5 1 7 7 0 0))
              (sm70-bra G C0 7 0 -1)
              (sm70-nop G C0))]
    (if (= (sm70-error M) 0)
      (loop [k 0 t 0]
        (if (>= k (sm70-count M)) t
          (recur (inc k) (+ t (show M k (string-concat "saxpy." (string-from-i64 k)))))))
      (say "X saxpy"))))

(defn main [] :i64 (+ (singles) (arith) (wide) (memory) (shared) (refusals) (decode-ops) (decode-refusals) (plop3-ops) (saxpy)))
