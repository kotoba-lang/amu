(ns sm70-lower (:export [sm70-lower sm70-lower-error-op]))

;; KIR v2 to SM 7.0 / 7.2 (route C, JUN-723). A KIR v2 kernel
;; (tools/gpu_kernels_v2.kotoba, ADR 0372) is a SPIR-V module; this pass
;; reads the module's words and writes the machine IR of sm70_sched.kotoba,
;; which sm70-schedule and sm70-emit-mir turn into instruction words.
;;
;; The subset is that of kir2-ewise and kir2-dot-rows: storage buffers of
;; 32-bit scalars or runtime arrays of them, Workgroup arrays of 32-bit
;; scalars, Function variables of 32-bit scalars, the x component of
;; GlobalInvocationId / WorkgroupId / LocalInvocationId, OpLoad / OpStore
;; through OpAccessChain, f32 add and mul, u32 add and mul, a logical right
;; shift by a constant, the integer compares, ifs without an else body (the
;; then-block is predicated, so it holds no loop, branch or barrier), loops
;; (OpLoopMerge with the condition in its own block), the workgroup
;; OpControlBarrier, and OpReturn. Anything else is refused with a code;
;; nothing is guessed.
;;
;; Control flow: every label records the instruction it starts at; an
;; OpBranch or a loop's OpBranchConditional becomes a BRA (guarded by the
;; condition, inverted when the true edge falls through) unless its target
;; is the next block; the targets are resolved after the body. A loop is
;; wrapped in BSSY / BSYNC on its own convergence barrier (B0 up): BSSY
;; before the header, whose label is then moved past it so that the back
;; edge does not repeat it, and BSYNC at the merge label, where the exit
;; branch lands. The threads of a warp may leave a loop at different
;; iterations; they reconverge there before what follows, a barrier
;; included. OpControlBarrier (Workgroup execution scope) is BAR.SYNC 0 and
;; a NOP, as NAK emits it.
;;
;; Function variables live in one register each: a store is a MOV into it,
;; a load a MOV out of it. Constant operands are materialized with a MOV
;; immediate where they are used, except 0, which is RZ. Workgroup arrays
;; are laid out from shared byte 0 in declaration order (dot_rows: 1024
;; bytes); the launcher reserves that much shared memory.
;;
;; The launch interface is an assumption of this pass, to be fixed by the
;; launcher (JUN-714): the 64-bit device address of descriptor binding b is
;; at c[0][base + 8 b] (low word first), base = 0x160 as the CUDA ABI puts
;; kernel parameters on Volta. Every load and store builds its address from
;; there: MOV the pair from the constant bank, IMAD.WIDE.U32 by the element
;; stride for an element index, and the struct member offset in the LDG/STG
;; immediate.
;;
;; Registers are given out in order as virtual registers (from 256, pairs
;; even) and predicates as virtual predicates (from 8); sm70-regalloc
;; (sm70_regalloc.kotoba) maps them to R0..R254 and P0..P6 at the end and
;; refuses a module that needs more.
;;
;; A unit that uses this file prepends its own ns line and drops this one,
;; after sm70_encode.kotoba and sm70_sched.kotoba.

;; refusals (the IR's error)
(def SL-E-HEADER 101)  ;; not a SPIR-V module this pass reads
(def SL-E-OP 102)      ;; an instruction outside the subset (sm70-lower-error-op names it)
(def SL-E-SHAPE 103)   ;; a supported instruction in an unsupported form
(def SL-E-REGS 104)    ;; out of registers or predicates
;; the virtual registers (sm70_regalloc.kotoba maps them): GPRs from 256,
;; predicates from 8
(def SL-VMAX 16000)
(def SL-IFMAX 16)
(def SL-PMAX 4000)

;; SPIR-V numbers used here
(def SP-ENTRY 15)
(def SP-EXECMODE 16)
(def SP-DECORATE 71)
(def SP-MEMBERDEC 72)
(def SP-TYPEBOOL 20)
(def SP-TYPEINT 21)
(def SP-TYPEFLOAT 22)
(def SP-TYPEVEC 23)
(def SP-TYPEARRAY 28)
(def SP-TYPERTA 29)
(def SP-TYPESTRUCT 30)
(def SP-TYPEPTR 32)
(def SP-CONST 43)
(def SP-FUNCTION 54)
(def SP-FUNCEND 56)
(def SP-VARIABLE 59)
(def SP-LOAD 61)
(def SP-STORE 62)
(def SP-ACCESS 65)
(def SP-INBOUNDS 66)
(def SP-EXTRACT 81)
(def SP-EXTIMPORT 11)
(def SP-EXTINST 12)
(def SP-FTOU 109)
(def SP-FTOS 110)
(def SP-STOF 111)
(def SP-UTOF 112)
(def SP-BITCAST 124)
(def SP-FNEG 127)
(def SP-ISUB 130)
(def SP-FSUB 131)
(def SP-UDIV 134)
(def SP-FDIV 136)
(def SP-SELECT 169)
(def SP-SHLL 196)
(def SP-BOR 197)
(def SP-BXOR 198)
(def SP-BAND 199)
(def SP-LOR 166)
(def SP-CTRUE 41)
(def SP-CFALSE 42)
(def SP-CONSTRUCT 80)
(def SP-DOT 148)
(def SP-SBFE 202)
(def SP-LAND 167)
(def SP-LNOT 168)
(def SP-IADD 128)
(def SP-FADD 129)
(def SP-IMUL 132)
(def SP-FMUL 133)
(def SP-SHRL 194)
(def SP-BARRIER 224)
(def SP-LOOPMERGE 246)
(def SP-SELMERGE 247)
(def SP-LABEL 248)
(def SP-BRANCH 249)
(def SP-BRCOND 250)
(def SP-RETURN 253)

;; ---------------------------------------------------------------------
;; The id table: id i has six slots at T[6 i]: kind, a, b, c, d, e.
;; kinds: 1 int (a width, b signed), 2 float (a width), 3 bool, 4 pointer (a
;; storage class, b pointee), 5 struct (a members, b the first member type),
;; 6 runtime array (a element), 7 vector, 8 constant (a type, b value), 9
;; variable (a pointer type, b storage class), 10 a loaded built-in vector
;; (a the built-in), 11 a GPR value (a register), 12 a predicate value (a
;; predicate), 13 an access chain (a variable, b byte offset, c the index id
;; or -1, d the element stride), 14 a label (a the instruction it starts
;; at), 15 a loop's merge label not reached yet (a its convergence barrier),
;; 16 an array type (a element, b length id), 17 a shared access chain (a
;; byte offset, b the index id or -1). A Function variable keeps its
;; register in c, a Workgroup variable its shared byte offset.
;; Decorations per id: binding at D[i], built-in at D[n + i], array stride at
;; D[2n + i], descriptor set at D[3n + i] (-1 none). Struct member m of
;; struct s: offset at O[2 (8 s' + m)], type at O[... + 1], kept for the first
;; 8 members of up to the id bound.

(defn- tg [T :vector-i64 i :i64 f :i64] :i64 (vector-at T (+ (* 6 i) f)))
(defn- ts [T :vector-i64 i :i64 f :i64 v :i64] :i64 (let [z (vector-assoc! T (+ (* 6 i) f) v)] v))
(defn- tset [T :vector-i64 i :i64 kind :i64 a :i64 b :i64 c :i64 d :i64] :i64
  (let [x0 (ts T i 0 kind) x1 (ts T i 1 a) x2 (ts T i 2 b) x3 (ts T i 3 c) x4 (ts T i 4 d)] i))

(defn- w [W :vector-i64 k :i64] :i64 (spv-word W k))

;; L: the pass's state. 0 next GPR, 1 next predicate, 2 the guard, 3 the
;; merge label of an OpSelectionMerge whose branch is next (0 none), 6 the if
;; depth, 7 LocalSize x, 8 the constant-bank base, 9 the refused
;; opcode, 10 the id bound, 11 the byte offset of the last address, 12 the
;; last label, 13 the next convergence barrier, 14 the next shared byte,
;; 15 the id of the GLSL.std.450 import, 16 and 17 LocalSize y and z; from 20, 4 slots per open if (the
;; innermost last): its merge label, its else label (-1 none), its condition
;; predicate, 1 when branched (0 predicated)
(defn- lg [L :vector-i64 k :i64] :i64 (vector-at L k))
(defn- ls [L :vector-i64 k :i64 v :i64] :i64 (let [z (vector-assoc! L k v)] v))

(defn- fail [Q :vector-i64 code :i64] :i64 (let [z (if (= (vector-at Q 1) 0) (vector-assoc! Q 1 code) Q)] -1))

(defn- gpr [Q :vector-i64 L :vector-i64] :i64
  (let [r (lg L 0)] (if (> r SL-VMAX) (fail Q SL-E-REGS) (let [z (ls L 0 (inc r))] r))))
(defn- gpr-pair [Q :vector-i64 L :vector-i64] :i64
  (let [r0 (lg L 0) r (if (= (bit-and r0 1) 0) r0 (inc r0))]
    (if (> r SL-VMAX) (fail Q SL-E-REGS) (let [z (ls L 0 (+ r 2))] r))))
(defn- pred [Q :vector-i64 L :vector-i64] :i64
  (let [p (lg L 1)] (if (> p SL-PMAX) (fail Q SL-E-REGS) (let [z (ls L 1 (inc p))] p))))

(defn- add [Q :vector-i64 L :vector-i64 op :i64 d :i64 a :i64 b :i64 c :i64 x :i64 y :i64] :i64
  (mi-add Q op (lg L 2) d a b c x y))

;; ---------------------------------------------------------------------
;; Pass 1: the module-level instructions.

;; a 32-bit int or float type (only those are in the subset)
(defn- scalar32? [T :vector-i64 t :i64] :bool
  (and (or (= (tg T t 0) 1) (= (tg T t 0) 2)) (= (tg T t 1) 32)))

;; the shared byte offset of a new Workgroup variable of pointer type pt
;; (-1: not an array of 32-bit scalars; access refuses it)
(defn- shared-alloc [T :vector-i64 L :vector-i64 pt :i64] :i64
  (let [at (tg T pt 2) len (tg T at 2) n (tg T len 2) off (lg L 14)]
    (if (and (= (tg T at 0) 16) (scalar32? T (tg T at 1)) (= (tg T len 0) 8) (> n 0) (<= (+ off (* 4 n)) 49152))
      (let [z (ls L 14 (+ off (* 4 n)))] off)
      -1)))

(defn- dget [D :vector-i64 n :i64 slot :i64 i :i64] :i64 (vector-at D (+ (* slot n) i)))
(defn- dset [D :vector-i64 n :i64 slot :i64 i :i64 v :i64] :i64 (let [z (vector-assoc! D (+ (* slot n) i) v)] v))
(defn- oat [s :i64 m :i64] :i64 (* 2 (+ (* 8 s) m)))

(defn- scan-one [W :vector-i64 T :vector-i64 D :vector-i64 O :vector-i64 L :vector-i64 at :i64 op :i64 wc :i64] :i64
  (let [n (lg L 10)]
    (cond (= op SP-EXECMODE)
          (if (= (w W (+ at 2)) 17) (let [y (ls L 16 (w W (+ at 4))) z (ls L 17 (w W (+ at 5)))] (ls L 7 (w W (+ at 3)))) 0)
          ;; the one extended set KIR v2 imports is GLSL.std.450
          (= op SP-EXTIMPORT) (ls L 15 (w W (+ at 1)))
          (= op SP-DECORATE)
          (let [i (w W (+ at 1)) dec (w W (+ at 2)) v (if (> wc 3) (w W (+ at 3)) 0)]
            (cond (= dec 33) (dset D n 0 i v) (= dec 11) (dset D n 1 i v)
                  (= dec 6) (dset D n 2 i v) (= dec 34) (dset D n 3 i v) :else 0))
          (= op SP-MEMBERDEC)
          (let [s (w W (+ at 1)) m (w W (+ at 2))]
            (if (and (= (w W (+ at 3)) 35) (< m 8)) (let [z (vector-assoc! O (oat s m) (w W (+ at 4)))] 0) 0))
          (= op SP-TYPEBOOL) (tset T (w W (+ at 1)) 3 0 0 0 0)
          (= op SP-TYPEINT) (tset T (w W (+ at 1)) 1 (w W (+ at 2)) (w W (+ at 3)) 0 0)
          (= op SP-TYPEFLOAT) (tset T (w W (+ at 1)) 2 (w W (+ at 2)) 0 0 0)
          (= op SP-TYPEVEC) (tset T (w W (+ at 1)) 7 (w W (+ at 2)) (w W (+ at 3)) 0 0)
          (= op SP-TYPERTA) (tset T (w W (+ at 1)) 6 (w W (+ at 2)) 0 0 0)
          (= op SP-TYPEARRAY) (tset T (w W (+ at 1)) 16 (w W (+ at 2)) (w W (+ at 3)) 0 0)
          (= op SP-TYPESTRUCT)
          (let [s (w W (+ at 1)) nm (- wc 2)]
            (loop [m 0]
              (if (or (>= m nm) (>= m 8)) (tset T s 5 nm (w W (+ at 2)) 0 0)
                (let [z (vector-assoc! O (+ (oat s m) 1) (w W (+ at 2 m)))] (recur (inc m))))))
          (= op SP-TYPEPTR) (tset T (w W (+ at 1)) 4 (w W (+ at 2)) (w W (+ at 3)) 0 0)
          (= op SP-CONST) (tset T (w W (+ at 2)) 8 (w W (+ at 1)) (w W (+ at 3)) 0 0)
          ;; true and false: PT, false as PT inverted (a predicate value's b slot)
          (= op SP-CTRUE) (tset T (w W (+ at 2)) 12 7 0 0 0)
          (= op SP-CFALSE) (tset T (w W (+ at 2)) 12 7 1 0 0)
          (= op SP-VARIABLE)
          (let [id (w W (+ at 2)) pt (w W (+ at 1)) sc (w W (+ at 3))]
            (if (= sc 4) (tset T id 9 pt sc (shared-alloc T L pt) 0) (tset T id 9 pt sc 0 0)))
          :else 0)))

;; ---------------------------------------------------------------------
;; Pass 2: the function body.

;; the register of value id v (a GPR value), or -1
(defn- vreg [T :vector-i64 v :i64] :i64 (if (= (tg T v 0) 11) (tg T v 1) -1))


;; OpAccessChain into a Workgroup array: one index, a constant (bounded by
;; the length) or a value (not bounded: as in the GLSL, the kernel keeps it
;; in range)
(defn- shared-access [W :vector-i64 T :vector-i64 Q :vector-i64 at :i64 wc :i64 id :i64 base :i64] :i64
  (let [off (tg T base 3) ix (if (= wc 5) (w W (+ at 4)) 0)
        len (tg T (tg T (tg T (tg T base 1) 2) 2) 2)]
    (cond (or (< off 0) (not= wc 5)) (fail Q SL-E-SHAPE)
          (= (tg T ix 0) 8) (if (< (tg T ix 2) len) (tset T id 17 (+ off (* 4 (tg T ix 2))) -1 0 0) (fail Q SL-E-SHAPE))
          (>= (vreg T ix) 0) (tset T id 17 off ix 0 0)
          :else (fail Q SL-E-SHAPE))))

;; the address register of a shared access chain p (RZ for a constant index),
;; the byte offset left in L[11] for the LDS/STS immediate
(defn- shared-address [T :vector-i64 Q :vector-i64 L :vector-i64 p :i64] :i64
  (let [ix (tg T p 2) o (ls L 11 (tg T p 1))]
    (if (< ix 0) 255
      (let [r (gpr Q L) a (add Q L MI-IMADI r (vreg T ix) 0 255 4 0)] r))))

;; the register of operand v: a GPR value, RZ for the constant 0, else a
;; 32-bit constant moved into a new register here (-1: none of these)
(defn- opnd [T :vector-i64 Q :vector-i64 L :vector-i64 v :i64] :i64
  (cond (= (tg T v 0) 11) (tg T v 1)
        (not (and (= (tg T v 0) 8) (scalar32? T (tg T v 1)))) -1
        (= (tg T v 2) 0) 255
        :else (let [r (gpr Q L) a (add Q L MI-MOVI r 0 0 0 (tg T v 2) 0)] r)))

;; the id of the label that starts the block after the instruction at at
;; (-1: something else follows)
(defn- next-label [W :vector-i64 at :i64 wc :i64] :i64
  (let [n (+ at wc)]
    (if (and (< (+ n 1) (spv-count W)) (= (bit-and (w W n) 65535) SP-LABEL)) (w W (+ n 1)) -1)))

;; a branch to label lab, guarded by g; the target is resolved after the body
(defn- branch [Q :vector-i64 g :i64 lab :i64] :i64 (mi-add Q MI-BRA g 0 0 0 0 0 lab))

;; OpAccessChain into a storage buffer: base variable, a member index
;; (constant), then an element index when the member is a runtime array
(defn- access [W :vector-i64 T :vector-i64 D :vector-i64 O :vector-i64 Q :vector-i64 L :vector-i64 at :i64 wc :i64] :i64
  (let [n (lg L 10) id (w W (+ at 2)) base (w W (+ at 3)) ni (- wc 4)
        pt (if (= (tg T base 0) 9) (tg T base 1) 0) st (if (= (tg T pt 0) 4) (tg T pt 2) 0)
        m-id (if (> ni 0) (w W (+ at 4)) 0)
        mv (tg T m-id 2)
        m (if (and (= (tg T m-id 0) 8) (>= mv 0) (< mv 8)) mv 0)
        mt (vector-at O (+ (oat st m) 1))
        off (vector-at O (oat st m))
        stride (dget D n 2 mt)]
    (cond (and (= (tg T base 0) 9) (= (tg T base 2) 4)) (shared-access W T Q at wc id base)
          (not (and (= (tg T base 0) 9) (= (tg T base 2) 12) (= (tg T st 0) 5))) (fail Q SL-E-SHAPE)
          (not (and (> ni 0) (= (tg T m-id 0) 8) (= m mv) (< m (tg T st 1)))) (fail Q SL-E-SHAPE)
          (or (< (dget D n 0 base) 0) (> (dget D n 3 base) 0)) (fail Q SL-E-SHAPE)
          (= (tg T mt 0) 6)
          (let [ix (if (= ni 2) (w W (+ at 5)) -1)]
            (cond (not (and (= ni 2) (= stride 4) (scalar32? T (tg T mt 1)))) (fail Q SL-E-SHAPE)
                  (= (tg T ix 0) 8) (tset T id 13 base (+ off (* 4 (tg T ix 2))) -1 4)
                  (>= (vreg T ix) 0) (tset T id 13 base off ix 4)
                  :else (fail Q SL-E-SHAPE)))
          (and (= ni 1) (scalar32? T mt)) (tset T id 13 base off -1 0)
          :else (fail Q SL-E-SHAPE))))

;; the address of an access chain: a register pair, the byte offset left in
;; L[11] for the LDG/STG immediate
(defn- address [T :vector-i64 D :vector-i64 Q :vector-i64 L :vector-i64 p :i64] :i64
  (let [n (lg L 10) var (tg T p 1) cb (+ (lg L 8) (* 8 (dget D n 0 var))) r (gpr-pair Q L)
        a (add Q L MI-MOVCB r 0 0 0 cb 0)
        b (add Q L MI-MOVCB (+ r 1) 0 0 0 (+ cb 4) 0)
        ix (tg T p 3)
        c (if (>= ix 0) (add Q L MI-IMADW r (vreg T ix) 0 r (tg T p 4) 0) 0)
        o (ls L 11 (tg T p 2))]
    r))

;; component k (0 x, 1 y, 2 z) of a built-in into a GPR: 26 WorkgroupId =
;; ctaid, 27 LocalInvocationId = tid, 28 GlobalInvocationId = ctaid.x *
;; LocalSize.x + tid.x (its y and z only where LocalSize has 1 there: ctaid)
(defn- builtin-x [Q :vector-i64 L :vector-i64 bi :i64 k :i64] :i64
  (cond (= bi 26) (let [r (gpr Q L) a (add Q L MI-S2R r 0 0 0 (+ 0x25 k) 0)] r)
        (= bi 27) (let [r (gpr Q L) a (add Q L MI-S2R r 0 0 0 (+ 0x21 k) 0)] r)
        (and (= bi 28) (> k 0) (= (lg L (+ 15 k)) 1)) (let [r (gpr Q L) a (add Q L MI-S2R r 0 0 0 (+ 0x25 k) 0)] r)
        (and (= bi 28) (= k 0)) (let [c (gpr Q L) t (gpr Q L) r (gpr Q L)
                        a (add Q L MI-S2R c 0 0 0 0x25 0)
                        b (add Q L MI-S2R t 0 0 0 0x21 0)
                        e (add Q L MI-IMADI r c 0 t (lg L 7) 0)]
                    r)
        :else (fail Q SL-E-SHAPE)))

;; the integer compare of a SPIR-V opcode as (sm70-isetp cmp) + 8 * signed,
;; -1 when op is not one
(defn- int-cmp [op :i64] :i64
  (case op 170 2 171 5 172 4 173 12 174 6 175 14 176 1 177 9 178 3 179 11 -1))

;; the float compare of a SPIR-V opcode as an sm70-fsetp compare, -1 when op
;; is not one: OpFOrd* (180 ==, 182 !=, 184 <, 186 >, 188 <=, 190 >=) and
;; OpFUnord* (181, 183, 185, 187, 189, 191)
(defn- float-cmp [op :i64] :i64
  (case op 180 2 181 10 182 5 183 13 184 1 185 9 186 4 187 12 188 3 189 11 190 6 191 14 -1))

;; MUFU functions (sm70-mufu)
(def SL-COS 0)
(def SL-SIN 1)
(def SL-EX2 2)
(def SL-LG2 3)
(def SL-RCP 4)
(def SL-RSQ 5)
;; f32 bit patterns: log2(e), 1 / (2 pi), 2^32 - 2048 (see udiv)
(def SL-LOG2E 0x3fb8aa3b)
(def SL-INV2PI 0x3e22f983)
(def SL-RCP-SCALE 0x4f7ffff8)

;; d = a shifted by b: a constant 0..31 by an immediate, else by a register
;; (SHF wraps the count to 0..31; SPIR-V leaves larger ones undefined)
(defn- shift [W :vector-i64 T :vector-i64 Q :vector-i64 L :vector-i64 at :i64 right :bool] :i64
  (let [id (w W (+ at 2)) a (opnd T Q L (w W (+ at 3))) bid (w W (+ at 4))]
    (cond (< a 0) (fail Q SL-E-SHAPE)
          (= (tg T bid 0) 8)
          (if (> (tg T bid 2) 31) (fail Q SL-E-SHAPE)
            (let [r (gpr Q L) e (add Q L (if right MI-SHR MI-SHLI) r a 0 0 (tg T bid 2) 0)] (tset T id 11 r 0 0 0)))
          :else
          (let [b (opnd T Q L bid)]
            (if (< b 0) (fail Q SL-E-SHAPE)
              (let [r (gpr Q L) e (add Q L (if right MI-SHRR MI-SHLR) r a b 0 0 0)] (tset T id 11 r 0 0 0)))))))

;; the log2 of a power of two, else -1
(defn- log2-exact [v :i64] :i64
  (if (or (<= v 0) (not= (bit-and v (- v 1)) 0)) -1
    (loop [k 0] (if (= (i64-shift-left 1 k) v) k (recur (inc k))))))

;; n / d, unsigned. A constant power of two is a shift. Else nir_lower_idiv's
;; sequence, which NAK compiles udiv with: rcp = f2u(rcp(u2f(d)) * S); rcp
;; += umul_high(rcp, rcp * -d); q = umul_high(n, rcp); r = n - q d; then
;; twice: if (r >= d) { q += 1; r -= d }. nir's S is 2^32 - 512, about one
;; unit in the last place below 2^32: the result is exact only while
;; MUFU.RCP overshoots 1 / d by less than that. Here S = 2^32 - 2048 keeps the
;; quotient exact for a reciprocal up to 3 units off either way
;; (scripts/seed/check-sm70-lower.py jitters MUFU results by 2).
(defn- udiv [W :vector-i64 T :vector-i64 Q :vector-i64 L :vector-i64 at :i64] :i64
  (let [id (w W (+ at 2)) nid (w W (+ at 3)) did (w W (+ at 4))
        k (if (= (tg T did 0) 8) (log2-exact (tg T did 2)) -1)
        n (opnd T Q L nid)]
    (cond (< n 0) (fail Q SL-E-SHAPE)
          (= k 0) (tset T id 11 n 0 0 0)
          (> k 0) (let [r (gpr Q L) e (add Q L MI-SHR r n 0 0 k 0)] (tset T id 11 r 0 0 0))
          :else
          (let [d (opnd T Q L did)]
            (if (< d 0) (fail Q SL-E-SHAPE)
              (let [f (gpr Q L) a1 (add Q L MI-I2F f d 0 0 0 0)
                    rc (gpr Q L) a2 (add Q L MI-MUFU rc f 0 0 SL-RCP 0)
                    sc (gpr Q L) a3 (add Q L MI-FMULI sc rc 0 0 SL-RCP-SCALE 0)
                    r0 (gpr Q L) a4 (add Q L MI-F2I r0 sc 0 0 0 0)
                    nd (gpr Q L) a5 (add Q L MI-IADD3 nd 255 d 255 0 2)
                    m (gpr Q L) a6 (add Q L MI-IMAD m r0 nd 255 0 0)
                    h (gpr-pair Q L) a7 (add Q L MI-IMADWR h r0 m 255 0 0)
                    r1 (gpr Q L) a8 (add Q L MI-IADD3 r1 r0 (+ h 1) 255 0 0)
                    qp (gpr-pair Q L) a9 (add Q L MI-IMADWR qp n r1 255 0 0)
                    qd (gpr Q L) b1 (add Q L MI-IMAD qd (+ qp 1) d 255 0 0)
                    rm (gpr Q L) b2 (add Q L MI-IADD3 rm n qd 255 0 2)
                    one (gpr Q L) b3 (add Q L MI-MOVI one 0 0 0 1 0)
                    p1 (pred Q L) b4 (add Q L MI-ISETP p1 rm d 0 6 0)
                    q1 (gpr Q L) b5 (add Q L MI-IADD3 q1 (+ qp 1) one 255 0 0)
                    q2 (gpr Q L) b6 (add Q L MI-SEL q2 q1 (+ qp 1) 0 p1 0)
                    rd (gpr Q L) b7 (add Q L MI-IADD3 rd rm d 255 0 2)
                    r2 (gpr Q L) b8 (add Q L MI-SEL r2 rd rm 0 p1 0)
                    p2 (pred Q L) b9 (add Q L MI-ISETP p2 r2 d 0 6 0)
                    q3 (gpr Q L) c1 (add Q L MI-IADD3 q3 q2 one 255 0 0)
                    q4 (gpr Q L) c2 (add Q L MI-SEL q4 q3 q2 0 p2 0)]
                (tset T id 11 q4 0 0 0)))))))

;; OpExtInst of GLSL.std.450 (the id saved in L[15]): Exp, InverseSqrt, Pow,
;; Sin, Cos, FMin, FMax, UMin, UMax, SMin, SMax. As NAK: exp(x) = EX2(x
;; log2 e); pow(x, y) = EX2(LG2(x) y); sin and cos take turns, x / (2 pi).
;; Another instruction is refused as SL-E-OP with 100000 + its number.
(defn- mufu1 [Q :vector-i64 L :vector-i64 func :i64 a :i64] :i64
  (let [r (gpr Q L) e (add Q L MI-MUFU r a 0 0 func 0)] r))
(defn- fmuli [Q :vector-i64 L :vector-i64 a :i64 imm :i64] :i64
  (let [r (gpr Q L) e (add Q L MI-FMULI r a 0 0 imm 0)] r))

(defn- ext-inst [W :vector-i64 T :vector-i64 Q :vector-i64 L :vector-i64 at :i64 wc :i64] :i64
  (let [id (w W (+ at 2)) set (w W (+ at 3)) func (w W (+ at 4))
        a (if (> wc 5) (opnd T Q L (w W (+ at 5))) -1)
        b (if (> wc 6) (opnd T Q L (w W (+ at 6))) 0)]
    (if (or (not= set (lg L 15)) (< a 0) (< b 0)) (fail Q SL-E-SHAPE)
      (let [r (cond (= func 62)
                    ;; unpackHalf2x16: F2F.F32.F16 of each half, a vec2
                    (let [x (gpr Q L) e (add Q L MI-F2F x a 0 0 0 0) y (gpr Q L) f (add Q L MI-F2F y a 0 0 1 0)
                          v (tset T id 18 x y 0 0) c (ts T id 5 2)]
                      -2)
                    (= func 27) (mufu1 Q L SL-EX2 (fmuli Q L a SL-LOG2E))
                    (= func 32) (mufu1 Q L SL-RSQ a)
                    (= func 13) (mufu1 Q L SL-SIN (fmuli Q L a SL-INV2PI))
                    (= func 14) (mufu1 Q L SL-COS (fmuli Q L a SL-INV2PI))
                    (= func 26) (let [l (mufu1 Q L SL-LG2 a) m (gpr Q L) e (add Q L MI-FMUL m l b 0 0 0)] (mufu1 Q L SL-EX2 m))
                    (or (= func 37) (= func 40)) (let [m (gpr Q L) e (add Q L MI-FMNMX m a b 0 (if (= func 37) 1 0) 0)] m)
                    (or (= func 38) (= func 39) (= func 41) (= func 42))
                    (let [m (gpr Q L) e (add Q L MI-IMNMX m a b 0 (if (< func 40) 1 0) (if (or (= func 39) (= func 42)) 1 0))] m)
                    :else (let [z (ls L 9 (+ 100000 func))] (fail Q SL-E-OP)))]
        (cond (= r -2) id (< r 0) -1 :else (tset T id 11 r 0 0 0))))))

;; slot k of the innermost open if
(defn- if-slot [L :vector-i64 k :i64] :i64 (lg L (+ 20 (* 4 (dec (lg L 6))) k)))

;; does the if whose branch is at at hold a loop, a barrier or another if
;; before its merge label m?
(defn- if-complex? [W :vector-i64 at :i64 m :i64] :bool
  (loop [k at]
    (if (>= k (spv-count W)) false
      (let [h (w W k) op (bit-and h 65535) wc (u64-shift-right h 16)]
        (cond (= wc 0) false
              (and (= op SP-LABEL) (= (w W (+ k 1)) m)) false
              (or (= op SP-LOOPMERGE) (= op SP-BARRIER) (= op SP-SELMERGE)) true
              :else (recur (+ k wc)))))))

;; an if: OpSelectionMerge m, then OpBranchConditional c tl fl. A leaf if
;; (no loop, barrier or if inside) is predicated: its then block runs under
;; c, an else block under !c. Any other if is branched: BSSY Bk, m (its
;; threads reconverge at BSYNC Bk on the merge label, as for a loop); @!c
;; BRA to the else block or the merge; the then block ends with BRA m when
;; there is an else block.
(defn- open-if [W :vector-i64 T :vector-i64 Q :vector-i64 L :vector-i64 at :i64 wc :i64 c :i64 tl :i64 fl :i64] :i64
  (let [m (lg L 3) d (lg L 6) el (if (= fl m) -1 fl) cp (tg T c 1)
        branched (if-complex? W at m) b (lg L 13)
        z (ls L 3 0)]
    (cond (or (>= d SL-IFMAX) (not= tl (next-label W at wc)) (and branched (> b 15))) (fail Q SL-E-SHAPE)
          :else
          (let [s0 (ls L (+ 20 (* 4 d)) m) s1 (ls L (+ 21 (* 4 d)) el) s2 (ls L (+ 22 (* 4 d)) cp)
                s3 (ls L (+ 23 (* 4 d)) (if branched 1 0)) s4 (ls L 6 (inc d))]
            (if branched
              (let [x (ls L 13 (inc b)) e (mi-add Q MI-BSSY (mi-g 7 0) b 0 0 0 0 m) y (tset T m 15 b 0 0 0)]
                (branch Q (mi-g cp 1) (if (>= el 0) el m)))
              (ls L 2 (mi-g cp 0)))))))

;; a vector type of 2 to 4 32-bit scalars
(defn- vec-type? [T :vector-i64 t :i64] :bool
  (and (>= t 0) (< (* 6 t) (vector-count T)) (= (tg T t 0) 7) (>= (tg T t 2) 2) (<= (tg T t 2) 4) (scalar32? T (tg T t 1))))

;; a vector value (kind 18: the component registers in a..d, the count in
;; slot 5) copied from nc registers from r up (a vector variable's load)
(defn- vec-copy [T :vector-i64 Q :vector-i64 L :vector-i64 id :i64 r :i64 nc :i64] :i64
  (let [x (tset T id 18 0 0 0 0) c (ts T id 5 nc)]
    (loop [k 0] (if (>= k nc) id (let [d (gpr Q L) e (add Q L MI-MOV d (+ r k) 0 0 0 0) y (ts T id (+ 1 k) d)] (recur (inc k)))))))

;; component k of operand v of a vector op (-1: not a vector of that size)
(defn- vcomp [T :vector-i64 v :i64 nc :i64 k :i64] :i64
  (if (and (= (tg T v 0) 18) (= (tg T v 5) nc)) (tg T v (+ 1 k)) -1))

;; ConvertSToF / ConvertUToF / ISub / IAdd / IMul / FAdd / FMul / FSub, the
;; shifts (by a register) and the bitwise ops of vectors
(defn- vec-map [W :vector-i64 T :vector-i64 Q :vector-i64 L :vector-i64 at :i64 op :i64 wc :i64] :i64
  (let [id (w W (+ at 2)) nc (tg T (w W (+ at 1)) 2) one (or (= op SP-STOF) (= op SP-UTOF))
        x (tset T id 18 0 0 0 0) c (ts T id 5 nc)]
    (loop [k 0]
      (if (>= k nc) id
        (let [a (vcomp T (w W (+ at 3)) nc k) b (if one 0 (vcomp T (w W (+ at 4)) nc k))]
          (if (or (< a 0) (< b 0)) (fail Q SL-E-SHAPE)
            (let [r (gpr Q L)
                  e (cond (= op SP-STOF) (add Q L MI-I2F r a 0 0 1 0)
                          (= op SP-UTOF) (add Q L MI-I2F r a 0 0 0 0)
                          (= op SP-ISUB) (add Q L MI-IADD3 r a b 255 0 2)
                          (= op SP-IADD) (add Q L MI-IADD3 r a b 255 0 0)
                          (= op SP-FSUB) (add Q L MI-FADDN r a b 0 0 2)
                          (= op SP-FADD) (add Q L MI-FADD r a b 0 0 0)
                          (= op SP-IMUL) (add Q L MI-IMAD r a b 255 0 0)
                          (= op SP-SHRL) (add Q L MI-SHRR r a b 0 0 0)
                          (= op SP-SHLL) (add Q L MI-SHLR r a b 0 0 0)
                          (= op SP-BAND) (add Q L MI-LOP3 r a b 255 0xc0 0)
                          (= op SP-BOR) (add Q L MI-LOP3 r a b 255 0xfc 0)
                          (= op SP-BXOR) (add Q L MI-LOP3 r a b 255 0x3c 0)
                          :else (add Q L MI-FMUL r a b 0 0 0))
                  y (ts T id (+ 1 k) r)]
              (recur (inc k)))))))))

(defn- binop [W :vector-i64 T :vector-i64 Q :vector-i64 L :vector-i64 at :i64 mop :i64] :i64
  (let [id (w W (+ at 2)) a (opnd T Q L (w W (+ at 3))) b (opnd T Q L (w W (+ at 4)))]
    (if (or (< a 0) (< b 0)) (fail Q SL-E-SHAPE)
      (let [r (gpr Q L)
            e (cond (= mop MI-IADD3) (add Q L MI-IADD3 r a b 255 0 0)
                    (= mop MI-IMAD) (add Q L MI-IMAD r a b 255 0 0)
                    ;; a - b: IADD3 a, -b, RZ; a - b in f32: FADD a, -b
                    (= mop SP-ISUB) (add Q L MI-IADD3 r a b 255 0 2)
                    (= mop MI-FADDN) (add Q L MI-FADDN r a b 0 0 2)
                    ;; LOP3 tables: a 0xf0, b 0xcc
                    (= mop SP-BAND) (add Q L MI-LOP3 r a b 255 0xc0 0)
                    (= mop SP-BOR) (add Q L MI-LOP3 r a b 255 0xfc 0)
                    (= mop SP-BXOR) (add Q L MI-LOP3 r a b 255 0x3c 0)
                    :else (add Q L mop r a b 0 0 0))]
        (tset T id 11 r 0 0 0)))))

(defn- body-one [W :vector-i64 T :vector-i64 D :vector-i64 O :vector-i64 Q :vector-i64 L :vector-i64 at :i64 op :i64 wc :i64] :i64
  (let [n (lg L 10) cmp (int-cmp op) fcmp (float-cmp op)]
    (cond (= op SP-LABEL)
          (let [lab (w W (+ at 1))
                merge-bar (if (= (tg T lab 0) 15) (tg T lab 1) -1)
                p (tset T lab 14 (mi-count Q) 0 0 0)
                q (ls L 12 lab)
                ;; a loop's or a branched if's merge: its threads reconverge
                ;; here, and its convergence barrier is free again (they nest)
                y (if (>= merge-bar 0) (let [b (ls L 13 (dec (lg L 13)))] (add Q L MI-BSYNC merge-bar 0 0 0 0 0)) 0)]
            (cond (and (> (lg L 6) 0) (= lab (if-slot L 0))) (let [a (ls L 6 (dec (lg L 6)))] (ls L 2 (mi-g 7 0)))
                  ;; a predicated else block runs where the condition is false
                  (and (> (lg L 6) 0) (= lab (if-slot L 1)) (= (if-slot L 3) 0)) (ls L 2 (mi-g (if-slot L 2) 1))
                  :else 0))
          (= op SP-VARIABLE)
          (let [pt (w W (+ at 1)) id (w W (+ at 2))]
            (cond (not= (w W (+ at 3)) 7) (fail Q SL-E-SHAPE)
                  (scalar32? T (tg T pt 2)) (tset T id 9 pt 7 (gpr Q L) 0)
                  ;; a vector of 32-bit scalars: one register a component (d: the count)
                  (vec-type? T (tg T pt 2))
                  (let [nc (tg T (tg T pt 2) 2) r (gpr Q L) z (loop [k 1] (if (>= k nc) 0 (let [x (gpr Q L)] (recur (inc k)))))]
                    (tset T id 9 pt 7 r nc))
                  :else (fail Q SL-E-SHAPE)))
          (= op SP-LOAD)
          (let [t (w W (+ at 1)) id (w W (+ at 2)) p (w W (+ at 3))]
            (cond (and (= (tg T p 0) 9) (= (tg T p 2) 1) (>= (dget D n 1 p) 0)) (tset T id 10 (dget D n 1 p) 0 0 0)
                  (and (= (tg T p 0) 9) (= (tg T p 2) 7) (> (tg T p 4) 0))
                  (vec-copy T Q L id (tg T p 3) (tg T p 4))
                  (and (= (tg T p 0) 9) (= (tg T p 2) 7))
                  (let [r (gpr Q L) e (add Q L MI-MOV r (tg T p 3) 0 0 0 0)] (tset T id 11 r 0 0 0))
                  (and (= (tg T p 0) 17) (scalar32? T t))
                  (let [a (shared-address T Q L p) r (gpr Q L) e (add Q L MI-LDS r a 0 0 (lg L 11) 0)] (tset T id 11 r 0 0 0))
                  (and (= (tg T p 0) 13) (scalar32? T t))
                  (let [a (address T D Q L p) r (gpr Q L) e (add Q L MI-LDG r a 0 0 (lg L 11) 0)] (tset T id 11 r 0 0 0))
                  :else (fail Q SL-E-SHAPE)))
          (= op SP-STORE)
          (let [p (w W (+ at 1)) vid (w W (+ at 2)) v (vreg T vid)]
            (cond (and (= (tg T p 0) 9) (= (tg T p 2) 7) (> (tg T p 4) 0))
                  (if (or (not= (tg T vid 0) 18) (not= (tg T vid 5) (tg T p 4))) (fail Q SL-E-SHAPE)
                    (loop [k 0] (if (>= k (tg T p 4)) 0 (let [e (add Q L MI-MOV (+ (tg T p 3) k) (tg T vid (+ 1 k)) 0 0 0 0)] (recur (inc k))))))
                  (and (= (tg T p 0) 9) (= (tg T p 2) 7))
                  (cond (>= v 0) (add Q L MI-MOV (tg T p 3) v 0 0 0 0)
                        (and (= (tg T vid 0) 8) (scalar32? T (tg T vid 1))) (add Q L MI-MOVI (tg T p 3) 0 0 0 (tg T vid 2) 0)
                        :else (fail Q SL-E-SHAPE))
                  (= (tg T p 0) 17)
                  (let [x (opnd T Q L vid)]
                    (if (< x 0) (fail Q SL-E-SHAPE)
                      (let [a (shared-address T Q L p)] (add Q L MI-STS 0 a x 0 (lg L 11) 0))))
                  (or (not= (tg T p 0) 13) (< v 0)) (fail Q SL-E-SHAPE)
                  :else (let [a (address T D Q L p)] (add Q L MI-STG 0 a v 0 (lg L 11) 0))))
          (and (= op SP-EXTRACT) (= (tg T (w W (+ at 3)) 0) 18))
          (let [id (w W (+ at 2)) c (w W (+ at 3)) k (w W (+ at 4))]
            (if (or (not= wc 5) (>= k (tg T c 5))) (fail Q SL-E-SHAPE) (tset T id 11 (tg T c (+ 1 k)) 0 0 0)))
          ;; OpCompositeConstruct of a vector: its operands' components in
          ;; order, scalars or vectors
          (= op SP-CONSTRUCT)
          (let [id (w W (+ at 2)) x (tset T id 18 0 0 0 0)
                nc (loop [j 3 k 0]
                     (cond (>= j wc) k
                           (< k 0) k
                           :else
                           (let [v (w W (+ at j))]
                             (if (= (tg T v 0) 18)
                               (if (> (+ k (tg T v 5)) 4) -1
                                 (recur (inc j) (loop [c 0] (if (>= c (tg T v 5)) (+ k c) (let [y (ts T id (+ 1 k c) (tg T v (+ 1 c)))] (recur (inc c)))))))
                               (let [r (opnd T Q L v)]
                                 (if (or (< r 0) (>= k 4)) -1 (let [y (ts T id (+ 1 k) r)] (recur (inc j) (inc k)))))))))]
            (if (< nc 2) (fail Q SL-E-SHAPE) (ts T id 5 nc)))
          ;; the vector ops, a component at a time
          (and (or (= op SP-STOF) (= op SP-UTOF) (= op SP-ISUB) (= op SP-IADD) (= op SP-FADD) (= op SP-FMUL) (= op SP-FSUB)
                   (= op SP-IMUL) (= op SP-SHRL) (= op SP-SHLL) (= op SP-BAND) (= op SP-BOR) (= op SP-BXOR))
               (vec-type? T (w W (+ at 1))))
          (vec-map W T Q L at op wc)
          ;; OpDot of two f32 vectors: FMUL then FFMA, in component order
          (= op SP-DOT)
          (let [id (w W (+ at 2)) a (w W (+ at 3)) b (w W (+ at 4)) nc (tg T a 5)]
            (if (or (not= (tg T a 0) 18) (not= (tg T b 0) 18) (not= (tg T b 5) nc)) (fail Q SL-E-SHAPE)
              (let [r0 (gpr Q L) e (add Q L MI-FMUL r0 (tg T a 1) (tg T b 1) 0 0 0)
                    r (loop [k 1 acc r0]
                        (if (>= k nc) acc
                          (let [x (gpr Q L) f (add Q L MI-FFMA x (tg T a (+ 1 k)) (tg T b (+ 1 k)) acc 0 0)] (recur (inc k) x))))]
                (tset T id 11 r 0 0 0))))
          ;; bitfieldExtract(int base, offset, count), the count a constant:
          ;; NAK's SHF.R by the offset (an immediate or a register), then SGXT
          (= op SP-SBFE)
          (let [id (w W (+ at 2)) a (opnd T Q L (w W (+ at 3))) o (w W (+ at 4)) c (w W (+ at 5))
                ko (= (tg T o 0) 8) ro (if ko 0 (opnd T Q L o))]
            (if (or (< a 0) (< ro 0) (and ko (> (tg T o 2) 31)) (not= (tg T c 0) 8) (> (tg T c 2) 32)) (fail Q SL-E-SHAPE)
              (let [s (cond (and ko (= (tg T o 2) 0)) a
                            ko (let [r (gpr Q L) e (add Q L MI-SHR r a 0 0 (tg T o 2) 0)] r)
                            :else (let [r (gpr Q L) e (add Q L MI-SHRR r a ro 0 0 0)] r))
                    r (gpr Q L) e (add Q L MI-SGXT r s 0 0 (tg T c 2) 1)]
                (tset T id 11 r 0 0 0))))
          (= op SP-EXTRACT)
          (let [id (w W (+ at 2)) c (w W (+ at 3))]
            (if (or (not= (tg T c 0) 10) (not= wc 5) (> (w W (+ at 4)) 2)) (fail Q SL-E-SHAPE)
              (tset T id 11 (builtin-x Q L (tg T c 1) (w W (+ at 4))) 0 0 0)))
          (or (= op SP-ACCESS) (= op SP-INBOUNDS)) (access W T D O Q L at wc)
          (= op SP-FADD) (binop W T Q L at MI-FADD)
          (= op SP-FMUL) (binop W T Q L at MI-FMUL)
          (= op SP-IADD) (binop W T Q L at MI-IADD3)
          (= op SP-IMUL) (binop W T Q L at MI-IMAD)
          (>= cmp 0)
          (let [id (w W (+ at 2)) a (opnd T Q L (w W (+ at 3))) b (opnd T Q L (w W (+ at 4)))]
            (if (or (< a 0) (< b 0)) (fail Q SL-E-SHAPE)
              (let [p (pred Q L) e (add Q L MI-ISETP p a b 0 (bit-and cmp 7) (u64-shift-right cmp 3))]
                (tset T id 12 p 0 0 0))))
          (= op SP-SELMERGE)
          (if (not= (lg L 3) 0) (fail Q SL-E-SHAPE) (ls L 3 (w W (+ at 1))))
          ;; after OpSelectionMerge: an if; else a loop's condition: a
          ;; branch, inverted when the true edge falls through
          (= op SP-BRCOND)
          (let [c (w W (+ at 1)) tl (w W (+ at 2)) fl (w W (+ at 3)) nl (next-label W at wc)]
            (cond (or (not= (tg T c 0) 12) (not= (tg T c 2) 0) (not= (lg L 2) (mi-g 7 0))) (fail Q SL-E-SHAPE)
                  (not= (lg L 3) 0) (open-if W T Q L at wc c tl fl)
                  (= nl tl) (branch Q (mi-g (tg T c 1) 1) fl)
                  (= nl fl) (branch Q (mi-g (tg T c 1) 0) tl)
                  :else (let [a (branch Q (mi-g (tg T c 1) 0) tl)] (branch Q (mi-g 7 0) fl))))
          ;; an OpBranch: to the merge of the open if (nothing, or past a
          ;; branched if's else block), to the next block (nothing), else a
          ;; BRA under the current guard (a continue inside a predicated if)
          (= op SP-BRANCH)
          (let [tl (w W (+ at 1)) open (> (lg L 6) 0)]
            (cond (and open (= tl (if-slot L 0)) (= (if-slot L 3) 0)) 0
                  (and open (= tl (if-slot L 0)) (>= (if-slot L 1) 0) (not= (next-label W at wc) tl)) (branch Q (mi-g 7 0) tl)
                  (= tl (next-label W at wc)) 0
                  :else (branch Q (lg L 2) tl)))
          ;; LogicalOr / LogicalAnd / LogicalNot of predicates: PLOP3 (a 0xf0, b 0xcc)
          (or (= op SP-LOR) (= op SP-LAND) (= op SP-LNOT))
          (let [id (w W (+ at 2)) a (w W (+ at 3)) b (if (= op SP-LNOT) a (w W (+ at 4)))]
            (if (or (not= (tg T a 0) 12) (not= (tg T b 0) 12)) (fail Q SL-E-SHAPE)
              (let [p (pred Q L)
                    e (add Q L MI-PLOP3 p (tg T a 1) (tg T b 1) 7 (cond (= op SP-LOR) 0xfc (= op SP-LAND) 0xc0 :else 0x0f)
                           (bit-or (tg T a 2) (i64-shift-left (tg T b 2) 1)))]
                (tset T id 12 p 0 0 0))))
          ;; a loop: BSSY on the next convergence barrier before the header,
          ;; the header label moved past it, BSYNC at the merge label
          (= op SP-LOOPMERGE)
          (let [mg (w W (+ at 1)) b (lg L 13) hd (lg L 12)]
            (if (or (not= (lg L 2) (mi-g 7 0)) (> b 15) (not= (tg T hd 1) (mi-count Q)))
              (fail Q SL-E-SHAPE)
              (let [z (ls L 13 (inc b)) e (mi-add Q MI-BSSY (mi-g 7 0) b 0 0 0 0 mg)
                    h (tset T hd 14 (mi-count Q) 0 0 0)]
                (tset T mg 15 b 0 0 0))))
          ;; OpControlBarrier with Workgroup execution and memory scope:
          ;; BAR.SYNC 0 and NAK's NOP after it
          (= op SP-BARRIER)
          (let [ex (w W (+ at 1)) ms (w W (+ at 2))]
            (if (or (not= (tg T ex 0) 8) (not= (tg T ex 2) 2) (not= (tg T ms 0) 8) (not= (tg T ms 2) 2)
                    (not= (lg L 2) (mi-g 7 0)))
              (fail Q SL-E-SHAPE)
              (let [a (add Q L MI-BAR 0 0 0 0 0 0)] (add Q L MI-NOP 0 0 0 0 0 0))))
          (= op SP-SHRL) (shift W T Q L at true)
          (= op SP-EXTINST) (ext-inst W T Q L at wc)
          (= op SP-FNEG)
          (let [id (w W (+ at 2)) a (opnd T Q L (w W (+ at 3)))]
            (if (< a 0) (fail Q SL-E-SHAPE)
              (let [r (gpr Q L) e (add Q L MI-FADDN r 255 a 0 0 3)] (tset T id 11 r 0 0 0))))
          (= op SP-FSUB) (binop W T Q L at MI-FADDN)
          (= op SP-ISUB) (binop W T Q L at SP-ISUB)
          (= op SP-FDIV)
          (let [id (w W (+ at 2)) a (opnd T Q L (w W (+ at 3))) b (opnd T Q L (w W (+ at 4)))]
            (if (or (< a 0) (< b 0)) (fail Q SL-E-SHAPE)
              (let [r (gpr Q L) c (add Q L MI-MUFU r b 0 0 SL-RCP 0) q (gpr Q L) e (add Q L MI-FMUL q a r 0 0 0)]
                (tset T id 11 q 0 0 0))))
          (= op SP-UDIV) (udiv W T Q L at)
          (or (= op SP-UTOF) (= op SP-STOF) (= op SP-FTOU) (= op SP-FTOS))
          (let [id (w W (+ at 2)) a (opnd T Q L (w W (+ at 3)))]
            (if (< a 0) (fail Q SL-E-SHAPE)
              (let [r (gpr Q L)
                    e (cond (= op SP-UTOF) (add Q L MI-I2F r a 0 0 0 0) (= op SP-STOF) (add Q L MI-I2F r a 0 0 1 0)
                            (= op SP-FTOU) (add Q L MI-F2I r a 0 0 0 0) :else (add Q L MI-F2I r a 0 0 1 0))]
                (tset T id 11 r 0 0 0))))
          ;; a bit cast keeps the register, or stays a constant
          (and (= op SP-BITCAST) (= (tg T (w W (+ at 3)) 0) 18))
          (let [id (w W (+ at 2)) v (w W (+ at 3)) x (tset T id 18 (tg T v 1) (tg T v 2) (tg T v 3) (tg T v 4))] (ts T id 5 (tg T v 5)))
          (and (= op SP-BITCAST) (= (tg T (w W (+ at 3)) 0) 8))
          (tset T (w W (+ at 2)) 8 (w W (+ at 1)) (tg T (w W (+ at 3)) 2) 0 0)
          (= op SP-BITCAST)
          (let [id (w W (+ at 2)) a (opnd T Q L (w W (+ at 3)))]
            (if (< a 0) (fail Q SL-E-SHAPE) (tset T id 11 a 0 0 0)))
          ;; OpSelect on a predicate: of 32-bit values SEL, of booleans PLOP3
          ;; (c ? a : b, c 0xf0, a 0xcc, b 0xaa: 0xca)
          (and (= op SP-SELECT) (= (tg T (w W (+ at 4)) 0) 12))
          (let [id (w W (+ at 2)) c (w W (+ at 3)) a (w W (+ at 4)) b (w W (+ at 5))]
            (if (or (not= (tg T c 0) 12) (not= (tg T b 0) 12)) (fail Q SL-E-SHAPE)
              (let [p (pred Q L) e (add Q L MI-PLOP3 p (tg T c 1) (tg T a 1) (tg T b 1) 0xca 0)] (tset T id 12 p 0 0 0))))
          (= op SP-SELECT)
          (let [id (w W (+ at 2)) c (w W (+ at 3)) a (opnd T Q L (w W (+ at 4))) b (opnd T Q L (w W (+ at 5)))]
            (if (or (not= (tg T c 0) 12) (< a 0) (< b 0)) (fail Q SL-E-SHAPE)
              (let [r (gpr Q L) e (add Q L MI-SEL r a b 0 (tg T c 1) (tg T c 2))] (tset T id 11 r 0 0 0))))
          (>= fcmp 0)
          (let [id (w W (+ at 2)) a (opnd T Q L (w W (+ at 3))) b (opnd T Q L (w W (+ at 4)))]
            (if (or (< a 0) (< b 0)) (fail Q SL-E-SHAPE)
              (let [p (pred Q L) e (add Q L MI-FSETP p a b 0 fcmp 0)] (tset T id 12 p 0 0 0))))
          (= op SP-BAND) (binop W T Q L at SP-BAND)
          (= op SP-BOR) (binop W T Q L at SP-BOR)
          (= op SP-BXOR) (binop W T Q L at SP-BXOR)
          (= op SP-SHLL) (shift W T Q L at false)
          (= op SP-RETURN) (add Q L MI-EXIT 0 0 0 0 0 0)
          :else (let [z (ls L 9 op)] (fail Q SL-E-OP)))))

;; ---------------------------------------------------------------------

;; the opcode of the last SL-E-OP refusal (sm70-lower keeps it in Q's slot)
(defn sm70-lower-error-op [Q :vector-i64] :i64 (vector-at Q (- (vector-count Q) 1)))

;; the machine IR of module W (a spv vector), with the constant-bank base of
;; the binding addresses; capacity cap instructions
(defn sm70-lower [W :vector-i64 cbase :i64 cap :i64] :vector-i64
  (let [Q (mi-new (+ cap 1))
        nw (spv-count W)
        n (if (>= nw 5) (w W 3) 0)]
    (if (or (< nw 5) (not= (w W 0) 0x07230203) (> n 65536)) (let [z (fail Q SL-E-HEADER)] Q)
      (let [T (vector-alloc (* 6 n))
            D (loop [i 0 V (vector-alloc (* 4 n))] (if (>= i (* 4 n)) V (recur (inc i) (vector-assoc! V i -1))))
            O (vector-alloc (* 16 n))
            L (vector-alloc (+ 20 (* 4 SL-IFMAX)))
            l0 (ls L 2 (mi-g 7 0)) l1 (ls L 7 1) l2 (ls L 8 cbase) l3 (ls L 10 n)
            l4 (ls L 0 256) l5 (ls L 1 8)
            ;; walk the instructions; the function body starts after OpFunction
            e (loop [at 5 in-fn false]
                (if (or (>= at nw) (not= (mi-error Q) 0)) 0
                  (let [h (w W at) op (bit-and h 65535) wc (u64-shift-right h 16)]
                    (if (= wc 0) (fail Q SL-E-HEADER)
                      (cond (= op SP-FUNCTION) (recur (+ at wc) true)
                            (= op SP-FUNCEND) 0
                            in-fn (let [z (body-one W T D O Q L at op wc)] (recur (+ at wc) true))
                            :else (let [z (scan-one W T D O L at op wc)] (recur (+ at wc) false)))))))
            ;; the trailing self-branch, as every SM70 program ends
            t (if (= (mi-error Q) 0) (mi-add Q MI-BRA (mi-g 7 0) 0 0 0 0 -1 0) 0)
            ;; resolve the branch and BSSY targets: x = target - (k + 1)
            r (loop [k 0]
                (if (or (>= k (mi-count Q)) (not= (mi-error Q) 0)) 0
                  (let [op (mi-op Q k) at (+ 2 (* MI-W k)) lab (vector-at Q (+ at 7))
                        z (if (and (or (= op MI-BRA) (= op MI-BSSY)) (> lab 0))
                            (if (= (tg T lab 0) 14) (let [v (vector-assoc! Q (+ at 6) (- (tg T lab 1) (+ k 1)))] 0) (fail Q SL-E-SHAPE))
                            0)]
                    (recur (inc k)))))
            k (vector-assoc! Q (- (vector-count Q) 1) (lg L 9))]
        (sm70-regalloc Q)))))
