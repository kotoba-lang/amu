(ns sm70-lower-test (:export [main]))

;; The lowering and the scheduler (JUN-723), on the host. The unit is this ns
;; line, then tools/spirv_encode.kotoba, sm70_encode.kotoba, sm70_sched.kotoba
;; and sm70_lower.kotoba without their ns lines, then the rest of this file
;; (scripts/seed/check-sm70-lower.py). Arguments: the number of modules, then
;; per module its name and its words as one argument, decimal and separated
;; by commas (bin/amu passes about 60 arguments at most), as
;; sm70_lower_modules.kotoba prints them. Output per program:
;;   K <name> <count> <error> <opcode>   count words follow; error 0 = lowered
;;   I <name>.<k> <lo> <hi>              instruction k, 16 hex digits per half
;; then the same for "war" and "loopwar", hand-written IRs that only the
;; scheduler sees.
;; main answers the number of lines printed.

(defn- say [s :string] :i64
  (let [x (typed-cap-call :io/write :string :string (string-concat s "\n"))] 1))

(defn- hexd [d :i64] :string
  (cond (= d 0) "0" (= d 1) "1" (= d 2) "2" (= d 3) "3" (= d 4) "4" (= d 5) "5" (= d 6) "6" (= d 7) "7"
        (= d 8) "8" (= d 9) "9" (= d 10) "a" (= d 11) "b" (= d 12) "c" (= d 13) "d" (= d 14) "e" :else "f"))

(defn- hex16 [w :i64] :string
  (loop [k 15 s ""]
    (if (< k 0) s (recur (dec k) (string-concat s (hexd (bit-and (u64-shift-right w (* 4 k)) 15)))))))

(defn- arg [k :i64] :string (typed-cap-call :cli/args :string :string (string-from-i64 k)))

;; a decimal argument (digits only; anything else counts as 0)
(defn- num [s :string] :i64
  (loop [i 0 v 0]
    (if (>= i (string-length s)) v
      (let [c (string-code-point-at s i)]
        (recur (inc i) (if (and (>= c 48) (<= c 57)) (+ (* 10 v) (- c 48)) v))))))

;; the words of a comma-separated decimal list, as a spv vector
(defn- words [s :string] :vector-i64
  (let [n (string-length s)
        nw (loop [i 0 c 1] (if (>= i n) c (recur (inc i) (if (= (string-code-point-at s i) 44) (inc c) c))))]
    (loop [i 0 k 0 v 0 W (vector-assoc! (spv-new nw) 0 nw)]
      (cond (>= i n) (vector-assoc! W (+ k 1) v)
            (= (string-code-point-at s i) 44) (recur (inc i) (inc k) 0 (vector-assoc! W (+ k 1) v))
            :else (recur (inc i) k (+ (* 10 v) (- (string-code-point-at s i) 48)) W)))))

(defn- show [name :string M :vector-i64 err :i64 op :i64] :i64
  (let [h (say (string-concat "K " (string-concat name (string-concat " " (string-concat (string-from-i64 (sm70-count M))
            (string-concat " " (string-concat (string-from-i64 err) (string-concat " " (string-from-i64 op)))))))))]
    (loop [k 0 t h]
      (if (>= k (sm70-count M)) t
        (recur (inc k) (+ t (say (string-concat "I " (string-concat name (string-concat "." (string-concat (string-from-i64 k)
          (string-concat " " (string-concat (hex16 (sm70-lo M k)) (string-concat " " (hex16 (sm70-hi M k))))))))))))))))

;; lower, schedule and encode one module; the error is the IR's, else the encoder's
(defn- one [name :string W :vector-i64] :i64
  (let [Q (sm70-schedule (sm70-lower W 0x160 256))
        M (sm70-emit-mir Q)
        err (if (not= (mi-error Q) 0) (mi-error Q) (sm70-error M))]
    (show name M err (sm70-lower-error-op Q))))

;; LDG R2 <- [R0:R1]; R0 = 5 (rewrites the LDG's address while it may still
;; be read); R3 = R2 + R2 (reads the load); R4 = R3 + R3 (a fixed-latency
;; read); [R0:R1 + 4] <- R4; EXIT
(defn- war [] :i64
  (let [Q (mi-new 8) G (sm70-guard 7 0)
        a (mi-add Q MI-LDG G 2 0 0 0 0 0)
        b (mi-add Q MI-MOVI G 0 0 0 0 5 0)
        c (mi-add Q MI-FADD G 3 2 2 0 0 0)
        d (mi-add Q MI-FADD G 4 3 3 0 0 0)
        e (mi-add Q MI-STG G 0 0 4 0 4 0)
        f (mi-add Q MI-EXIT G 0 0 0 0 0 0)
        M (sm70-emit-mir (sm70-schedule Q))]
    (show "war" M (if (not= (mi-error Q) 0) (mi-error Q) (sm70-error M)) 0)))

;; R1 = 7 (a branch target); [RZ + 0] <- R1 in shared memory; branch back
;; to the first instruction (which rewrites the STS's source while it may
;; still be read); EXIT
(defn- loopwar [] :i64
  (let [Q (mi-new 4) G (sm70-guard 7 0)
        a (mi-add Q MI-MOVI G 1 0 0 0 7 0)
        b (mi-add Q MI-STS G 0 255 1 0 0 0)
        c (mi-add Q MI-BRA G 0 0 0 0 -3 0)
        d (mi-add Q MI-EXIT G 0 0 0 0 0 0)
        M (sm70-emit-mir (sm70-schedule Q))]
    (show "loopwar" M (if (not= (mi-error Q) 0) (mi-error Q) (sm70-error M)) 0)))

(defn main [] :i64
  (let [nm (num (arg 0))
        t (loop [m 0 t 0]
            (if (>= m nm) t (recur (inc m) (+ t (one (arg (+ 1 (* 2 m))) (words (arg (+ 2 (* 2 m)))))))))]
    (+ t (war) (loopwar))))
