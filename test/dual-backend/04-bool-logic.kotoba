;; Boolean connectives, both directions of each.
(ns dual.bool-logic)

(defn and-tt [] (if (and true true) 1 0))
(defn and-tf [] (if (and true false) 1 0))
(defn or-ft [] (if (or false true) 1 0))
(defn or-ff [] (if (or false false) 1 0))
(defn not-t [] (if (not true) 1 0))
(defn not-f [] (if (not false) 1 0))
(defn main [] 0)
