;; Bounded vectors. Only `count`/`nth` results cross the boundary as i64; the
;; vector itself does not, so no probe returns one.
(ns dual.vector)

(defn v-count [] (count [1 2 3]))
(defn v-nth-0 [] (nth [10 20 30] 0))
(defn v-nth-2 [] (nth [10 20 30] 2))
(defn v-empty-count [] (count []))
(defn main [] 0)
