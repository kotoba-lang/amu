;; Comparison operators, each with the BOUNDARY case beside the two obvious
;; ones. `lt-equal-boundary`, `le-boundary`, `gt-equal-boundary` and
;; `ge-boundary` all sit exactly on the line: a `<` lowered as `<=` (or the
;; reverse) passes every probe here except those four.
(ns dual.compare)

(defn eq-true [] (if (= 3 3) 1 0))
(defn eq-false [] (if (= 3 4) 1 0))
(defn eq-negative [] (if (= -3 -3) 1 0))
(defn eq-zero-boundary [] (if (= 0 0) 1 0))
(defn lt-true [] (if (< 3 4) 1 0))
(defn lt-false [] (if (< 4 3) 1 0))
(defn lt-equal-boundary [] (if (< 3 3) 1 0))
(defn le-boundary [] (if (<= 3 3) 1 0))
(defn gt-true [] (if (> 4 3) 1 0))
(defn gt-equal-boundary [] (if (> 3 3) 1 0))
(defn ge-boundary [] (if (>= 3 3) 1 0))
(defn lt-negative [] (if (< -4 -3) 1 0))
(defn main [] 0)
