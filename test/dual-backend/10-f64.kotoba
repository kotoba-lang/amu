;; Floating point. Only exactly-representable values are used, so a probe that
;; moves is a lowering difference and not a rounding-mode question the corpus
;; cannot adjudicate.
(ns dual.f64)

(defn f-add [] (if (= 3.5 (+ 1.5 2.0)) 1 0))
(defn f-mul [] (if (= 3.0 (* 1.5 2.0)) 1 0))
(defn f-lt [] (if (< 1.5 2.0) 1 0))
(defn f-eq-self [] (if (= 1.5 1.5) 1 0))
(defn main [] 0)
