;; min/max with both argument orders and the equal case. A `min` lowered as
;; `max` passes neither `min-a` nor `min-b`; a `min` that mishandles ties
;; passes both and fails `min-equal`.
(ns dual.minmax)

(defn min-a [] (min 3 7))
(defn min-b [] (min 7 3))
(defn min-equal [] (min 5 5))
(defn max-a [] (max 3 7))
(defn max-b [] (max 7 3))
(defn min-negative [] (min -3 -7))
(defn main [] 0)
