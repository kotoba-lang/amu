(ns iq3-s-dequant (:export [weight-bits]))

;; IQ3_S, dequantised in Kotoba. 64 of the Qwen3.5 model's 866 tensors.
;;
;; The block is 110 bytes and its layout is ggml's `block_iq3_s`:
;;
;;   [0..1]      d       fp16 super-block scale
;;   [2..65]     qs      64 grid codes, EIGHT bits each
;;   [66..73]    qh      eight bytes carrying each code's NINTH bit
;;   [74..105]   signs   32 sign bytes, eight element signs each
;;   [106..109]  scales  four bytes, two four-bit scales each
;;
;; ⚠ THE GRID INDEX IS NINE BITS, which is why `qh` exists and why the grid
;; is 512 entries rather than 256. The ninth bit is lifted out of `qh` by a
;; shift that depends on which of the four code pairs is being read.
;;
;; ⚠ SHIFT COUNTS IN THIS DIALECT ARE LITERALS, so the C's
;; `ninth << (8 - 2*l)` is written as a MULTIPLY by 2^(8-2l) -- which is
;; 256, 64, 16, 4 as l runs 0..3, i.e. `256 / 4^l`. `pow4` is the recursion
;; that produces the denominator. Same shape for `ninth << (7 - 2*l)`, whose
;; multiplier is `128 / 4^l`.
;;
;; The tables are the program's own bytes, copied from
;; `kotoba.kir.iq-codebook` (llama.cpp @3173a564, MIT, via aiueos's
;; `qwen35_quant_tables.inc`) and compared against it, digest and all, by
;; `the-pool-carries-the-vendored-codebook-byte-for-byte`.

(defn- pow4 [times :i64]
  (if (< times 1) 1 (* 4 (pow4 (- times 1)))))

(defn- half-bits [half :i64]
  (let [sign (i64-shift-left (bit-and half 32768) 16)
        rest (i64-shift-left (bit-and half 32767) 13)
        pattern (if (= 31744 (bit-and half 31744))
                  (bit-or sign (bit-or rest 2139095040))
                  (bit-or sign
                          (bit-and 4294967295
                                   (f32-to-bits
                                    (f32-mul (f32-from-bits rest)
                                             (f32-from-bits 2004877312))))))]
    (if (< pattern 2147483648) pattern (- pattern 4294967296))))

(defn weight-bits [base :i64 length :i64 element :i64]
  (let [b (slice-of-u8 base length)
        d (f32-from-bits
           (half-bits (bit-or (slice-get b 0) (i64-shift-left (slice-get b 1) 8))))
        pair (quot element 64)
        rem1 (- element (* pair 64))
        half (quot rem1 32)
        rem2 (- rem1 (* half 32))
        l (quot rem2 8)
        k (- rem2 (* l 8))
        low (< k 4)
        j (if low k (- k 4))
        scale (slice-get b (+ 106 pair))
        nibble (if (= 0 half) (bit-and scale 15) (u64-shift-right scale 4))
        db (f32-mul d (i64-to-f32-rounded (+ 1 (* 2 nibble))))
        ninth (slice-get b (+ 66 (+ (* 2 pair) half)))
        code (+ 2 (+ (* 16 pair) (* 8 half)))
        p4 (pow4 l)
        lifted (if low
                 (bit-and (* ninth (quot 256 p4)) 256)
                 (bit-and (* ninth (quot 128 p4)) 256))
        index (bit-or (slice-get b (+ code (+ (* 2 l) (if low 0 1)))) lifted)
        entry (slice-get (slice-of-u8 (bytes-literal "") 2048)
                         (+ (* 4 index) j))
        value (f32-mul db (i64-to-f32-rounded entry))
        sign (slice-get b (+ 74 (+ (* 8 pair) (+ (* 4 half) l))))
        mask (slice-get (slice-of-u8 (bytes-literal "0102040810204080") 8)
                        (if low j (+ j 4)))]
    (f32-to-bits (if (< 0 (bit-and sign mask)) (f32-neg value) value))))
