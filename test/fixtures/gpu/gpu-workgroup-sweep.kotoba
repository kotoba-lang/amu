;; Workgroup-size sweep on wire 42 (:gpu/compute): 2^20 threads x 256 FMAs per
;; thread, one dispatch per workgroup size, each timed twice (first submit is
;; the driver's warmup, the answer is the second). The six SPIR-V files differ
;; ONLY in LocalSize (32/64/128/256/512/1024), generated by gen-wg-shaders.py.
;; Answer: "ns32|ns64|ns128|ns256|ns512|ns1024" (submit -> fence, host clock).
(ns gpu.wgsweep (:export [main]))
(defn gpu [r :string] :string (typed-cap-call :gpu/compute :string :string r))
(defn timed [p :string g :string o :string] :string
  (do (gpu "BEGIN")
      (gpu (string-concat "DISPATCH " (string-concat p (string-concat " " (string-concat g (string-concat " 1 1 " o))))))
      (gpu "SUBMIT")))
(defn size-run [spv :string g :string o :string] :string
  (let [p (gpu (string-concat "PIPELINE " (string-concat spv " 1")))
        warm (timed p g o)]
    (timed p g o)))
(defn main [] :string
  (let [o (gpu "ALLOC 4194304")
        t32 (size-run "wg32.spv" "32768" o)
        t64 (size-run "wg64.spv" "16384" o)
        t128 (size-run "wg128.spv" "8192" o)
        t256 (size-run "wg256.spv" "4096" o)
        t512 (size-run "wg512.spv" "2048" o)
        t1024 (size-run "wg1024.spv" "1024" o)]
    (string-concat t32 (string-concat "|" (string-concat t64 (string-concat "|" (string-concat t128
      (string-concat "|" (string-concat t256 (string-concat "|" (string-concat t512 (string-concat "|" t1024))))))))))))
