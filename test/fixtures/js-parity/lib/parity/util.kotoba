(ns parity.util
  ;; A library module for the `--source-path` parity golden
  ;; (test/nbb/js_parity.cljk). One typed string helper and one i64 helper,
  ;; both exported, so the linked unit carries an import stub, an export
  ;; wrapper and a cross-module call in each value profile.
  (:export [greet twice]))

(defn greet [name :string] :string
  (string-concat "hello, " name))

(defn twice [n :i64] :i64
  (* n 2))
