(ns iq3-xxs-dequant (:export [weight-bits]))

;; IQ3_XXS, dequantised in Kotoba. 82 of the Qwen3.5 model's 866 tensors are
;; this type -- more than any other single format it could not decode.
;;
;; The block is 98 bytes and its layout is ggml's `block_iq3_xxs`:
;;
;;   [0..1]    d     fp16 super-block scale
;;   [2..65]   qs    64 grid codes, one byte each
;;   [66..97]  aux   eight 32-bit words, little endian; the top nibble of
;;                   each is a four-bit scale and the 28 bits below it are
;;                   FOUR SEVEN-BIT sign selectors
;;
;; ⚠ THREE TABLES, AND THEY BELONG TO THE FORMAT rather than to the block.
;; They are carried here as the program's own bytes, in a pool the layout
;; pass places beside the code. The hex is COPIED FROM
;; `kotoba.kir.iq-codebook`, which vendored it from llama.cpp @3173a564 (MIT)
;; through aiueos's `qwen35_quant_tables.inc` -- and osaho ADR 0264 pinned
;; each image with an FNV-1a/32 positional digest precisely so that a second
;; transcription like this one "can be compared with this one BY A TEST
;; rather than only by an execution". That comparison is
;; `the-pool-carries-the-vendored-codebook-byte-for-byte`.
;;
;; ⚠ EVERY SHIFT COUNT IN THIS DIALECT IS A LITERAL in [0,63], a frontend
;; admission rule rather than a machine limit. The C's `aux32 >> 7*l` is
;; therefore `shr7n`, recursion by a fixed step of seven.

(defn- shr7n [value :i64 times :i64]
  (if (< times 1) value (shr7n (u64-shift-right value 7) (- times 1))))

(defn- half-bits [half :i64]
  ;; fp16 -> the binary32 bit pattern by the x86 equation, sign-extended from
  ;; bit 31 to agree with `f32-to-bits`. Same arm as the IQ4_XS fixture's.
  (let [sign (i64-shift-left (bit-and half 32768) 16)
        rest (i64-shift-left (bit-and half 32767) 13)
        pattern (if (= 31744 (bit-and half 31744))
                  (bit-or sign (bit-or rest 2139095040))
                  (bit-or sign
                          (bit-and 4294967295
                                   (f32-to-bits
                                    (f32-mul (f32-from-bits rest)
                                             (f32-from-bits 2004877312))))))]
    (if (< pattern 2147483648) pattern (- pattern 4294967296))))

(defn weight-bits [base :i64 length :i64 element :i64]
  (let [b (slice-of-u8 base length)
        d-half (bit-or (slice-get b 0) (i64-shift-left (slice-get b 1) 8))
        ib32 (quot element 32)
        rem (- element (* ib32 32))
        l (quot rem 8)
        k (- rem (* l 8))
        low (< k 4)
        j (if low k (- k 4))
        aux (+ 66 (* 4 ib32))
        aux32 (bit-or (slice-get b aux)
                      (bit-or (i64-shift-left (slice-get b (+ aux 1)) 8)
                              (bit-or (i64-shift-left (slice-get b (+ aux 2)) 16)
                                      (i64-shift-left (slice-get b (+ aux 3)) 24))))
        ;; `db = d * (0.5 + (aux32 >> 28)) * 0.5`, and the NARROWING ORDER is
        ;; part of the answer: the C rounds to f32 after each multiply, so
        ;; this does the same rather than computing in one wider expression.
        scale (u64-shift-right aux32 28)
        half-one (f32-from-bits 1056964608)
        db (f32-mul (f32-mul (f32-from-bits (half-bits d-half))
                             (f32-add half-one (i64-to-f32-rounded scale)))
                    half-one)
        selector (bit-and (shr7n aux32 l) 127)
        sign (slice-get (slice-of-u8 (bytes-literal "008182038405068788090a8b0c8d8e0f901112931495961718999a1b9c1d1e9fa02122a324a5a62728a9aa2bac2d2eaf30b1b233b43536b7b8393abb3cbdbe3fc04142c344c5c64748c9ca4bcc4d4ecf50d1d253d45556d7d8595adb5cddde5f60e1e263e46566e7e8696aeb6cedee6ff07172f374f5f67778f9fa7bfc7d7eff") 128) selector)
        code (slice-get b (+ 2 (+ (* 8 ib32) (+ (* 2 l) (if low 0 1)))))
        entry (slice-get (slice-of-u8 (bytes-literal "") 1024)
                         (+ (* 4 code) j))
        value (f32-mul db (i64-to-f32-rounded entry))
        mask (slice-get (slice-of-u8 (bytes-literal "0102040810204080") 8)
                        (if low j (+ j 4)))]
    (f32-to-bits (if (< 0 (bit-and sign mask)) (f32-neg value) value))))
