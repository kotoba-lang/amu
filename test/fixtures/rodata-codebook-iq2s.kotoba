(ns iq2-s-dequant (:export [weight-bits]))

;; IQ2_S, dequantised in Kotoba. 62 of the Qwen3.5 model's 866 tensors, and
;; the FOURTH of the four formats kotoba-native's `elf64` docstring named as
;; staying in the C -- "those types stay in the C" is now false for all of
;; them.
;;
;; The block is 82 bytes and its layout is ggml's `block_iq2_s`:
;;
;;   [0..1]    d       fp16 super-block scale
;;   [2..33]   qs      32 grid codes, EIGHT bits each
;;   [34..65]  signs   32 sign bytes, eight element signs each
;;   [66..73]  qh      eight bytes carrying each code's ninth and TENTH bits
;;   [74..81]  scales  eight bytes, two four-bit scales each
;;
;; ⚠ THE GRID INDEX IS TEN BITS, so the grid is 1024 entries of EIGHT bytes
;; -- 8192, the largest of the six vendored tables and four times IQ3_S's.
;; Two bits come out of `qh` by a shift that depends on which quarter of the
;; group is being read, and the mask is 0x300 rather than 0x100.
;;
;; ⚠ SHIFT COUNTS IN THIS DIALECT ARE LITERALS, so `high << (8 - 2*l)` is a
;; multiply by 2^(8-2l), which is `256 / 4^l` as l runs 0..3. Same shape as
;; IQ3_S's, one mask wider.
;;
;; Eight elements per grid entry rather than four, so one entry serves a whole
;; sign byte.
;;
;; The tables are the program's own bytes, copied from
;; `kotoba.kir.iq-codebook` (llama.cpp @3173a564, MIT, via aiueos's
;; `qwen35_quant_tables.inc`) and compared against it, digest and all, by
;; `the-pool-carries-the-vendored-codebook-byte-for-byte`.

(defn- pow4 [times :i64]
  (if (< times 1) 1 (* 4 (pow4 (- times 1)))))

(defn- half-bits [half :i64]
  (let [sign (i64-shift-left (bit-and half 32768) 16)
        rest (i64-shift-left (bit-and half 32767) 13)
        pattern (if (= 31744 (bit-and half 31744))
                  (bit-or sign (bit-or rest 2139095040))
                  (bit-or sign
                          (bit-and 4294967295
                                   (f32-to-bits
                                    (f32-mul (f32-from-bits rest)
                                             (f32-from-bits 2004877312))))))]
    (if (< pattern 2147483648) pattern (- pattern 4294967296))))

(defn weight-bits [base :i64 length :i64 element :i64]
  (let [b (slice-of-u8 base length)
        d (f32-from-bits
           (half-bits (bit-or (slice-get b 0) (i64-shift-left (slice-get b 1) 8))))
        ib32 (quot element 32)
        rem (- element (* ib32 32))
        l (quot rem 8)
        j (- rem (* l 8))
        scale (slice-get b (+ 74 ib32))
        nibble (if (< l 2) (bit-and scale 15) (u64-shift-right scale 4))
        ;; `dl = d * (0.5 + nibble) * 0.25`, narrowed after each multiply the
        ;; way the C narrows -- the ORDER is part of the answer.
        dl (f32-mul (f32-mul d (f32-add (f32-from-bits 1056964608)
                                        (i64-to-f32-rounded nibble)))
                    (f32-from-bits 1048576000))
        high (slice-get b (+ 66 ib32))
        index (bit-or (slice-get b (+ 2 (+ (* 4 ib32) l)))
                      (bit-and (* high (quot 256 (pow4 l))) 768))
        entry (slice-get (slice-of-u8 (bytes-literal "") 8192)
                         (+ (* 8 index) j))
        value (f32-mul dl (i64-to-f32-rounded entry))
        sign (slice-get b (+ 34 (+ (* 4 ib32) l)))
        mask (slice-get (slice-of-u8 (bytes-literal "0102040810204080") 8) j)]
    (f32-to-bits (if (< 0 (bit-and sign mask)) (f32-neg value) value))))
