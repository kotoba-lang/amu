  (let [kotoba_some_tmp_0 (option-some-of [:option :i64] 2)]
    (if (option-some?-of [:option :i64] kotoba_some_tmp_0)
      (option-some-of [:option :i64]
        (+ 40 (option-value-of [:option :i64] kotoba_some_tmp_0 0)))
