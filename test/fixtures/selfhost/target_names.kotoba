(ns selfhost.target-names
  {:kotoba/export [main test-target-aliases test-target-profile-spellings]}
  (:require [kotoba.compiler.target-names :as target-names]))

(defn test-target-aliases [] :i64
  (if (and
       (= (target-names/parse "wasm32") :wasm32-kotoba-v1)
       (= (target-names/parse "x86_64") :x86_64-kotoba-v1)
       (= (target-names/parse "aarch64") :aarch64-kotoba-v1)
       (= (target-names/parse "component") :wasm-component-kotoba-v1)
       (= (target-names/parse "wasm-component") :wasm-component-kotoba-v1)
       (= (target-names/parse "js") :js-kotoba-v1)
       (= (target-names/parse "javascript") :js-kotoba-v1)
       (= (target-names/parse "web") :js-kotoba-v1)
       (= (target-names/parse "js-browser") :js-browser-kotoba-v1)
       (= (target-names/parse "cljs") :cljs-kotoba-v1)
       (= (target-names/parse "cljs-browser") :cljs-browser-kotoba-v1)
       (= (target-names/parse "cljs-node") :cljs-node-kotoba-v1)
       (= (target-names/parse "evm") :evm256-kotoba-v1)
       (= (target-names/parse "evm256") :evm256-kotoba-v1)
       (= (target-names/parse "kototama") :kototama-core-v1)
       (= (target-names/parse "kototama-core-v1") :kototama-core-v1)
       (= (target-names/parse "wasm32-browser") :wasm32-browser-kotoba-v1)
       (= (target-names/parse "wasm32-wasi") :wasm32-wasi-kotoba-v1)
       (= (target-names/parse "x86_64-linux") :x86_64-linux-kotoba-v1)
       (= (target-names/parse "x86_64-macos") :x86_64-macos-kotoba-v1)
       (= (target-names/parse "x86_64-windows") :x86_64-windows-kotoba-v1)
       (= (target-names/parse "aarch64-linux") :aarch64-linux-kotoba-v1)
       (= (target-names/parse "x86_64-linux-static") :x86_64-linux-static-kotoba-v1)
       (= (target-names/parse "aarch64-linux-static") :aarch64-linux-static-kotoba-v1)
       (= (target-names/parse "aarch64-macos") :aarch64-macos-kotoba-v1)
       (= (target-names/parse "aarch64-windows") :aarch64-windows-kotoba-v1)
       (= (target-names/parse "aarch64-android") :aarch64-android-kotoba-v1)
       (= (target-names/parse "aarch64-ios") :aarch64-ios-kotoba-v1)
       (= (target-names/parse "future-target") :unsupported-target))
    1
    0))

(defn test-target-profile-spellings [] :i64
  (if (and
       (= (target-names/parse "wasm32-kotoba-v1") :wasm32-kotoba-v1)
       (= (target-names/parse "x86_64-kotoba-v1") :x86_64-kotoba-v1)
       (= (target-names/parse "aarch64-kotoba-v1") :aarch64-kotoba-v1)
       (= (target-names/parse "wasm-component-kotoba-v1") :wasm-component-kotoba-v1)
       (= (target-names/parse "js-kotoba-v1") :js-kotoba-v1)
       (= (target-names/parse "js-browser-kotoba-v1") :js-browser-kotoba-v1)
       (= (target-names/parse "cljs-kotoba-v1") :cljs-kotoba-v1)
       (= (target-names/parse "cljs-browser-kotoba-v1") :cljs-browser-kotoba-v1)
       (= (target-names/parse "cljs-node-kotoba-v1") :cljs-node-kotoba-v1)
       (= (target-names/parse "evm256-kotoba-v1") :evm256-kotoba-v1)
       (= (target-names/parse "wasm32-browser-kotoba-v1") :wasm32-browser-kotoba-v1)
       (= (target-names/parse "wasm32-wasi-kotoba-v1") :wasm32-wasi-kotoba-v1)
       (= (target-names/parse "x86_64-linux-kotoba-v1") :x86_64-linux-kotoba-v1)
       (= (target-names/parse "x86_64-macos-kotoba-v1") :x86_64-macos-kotoba-v1)
       (= (target-names/parse "x86_64-windows-kotoba-v1") :x86_64-windows-kotoba-v1)
       (= (target-names/parse "aarch64-linux-kotoba-v1") :aarch64-linux-kotoba-v1)
       (= (target-names/parse "x86_64-linux-static-kotoba-v1") :x86_64-linux-static-kotoba-v1)
       (= (target-names/parse "aarch64-linux-static-kotoba-v1") :aarch64-linux-static-kotoba-v1)
       (= (target-names/parse "aarch64-macos-kotoba-v1") :aarch64-macos-kotoba-v1)
       (= (target-names/parse "aarch64-windows-kotoba-v1") :aarch64-windows-kotoba-v1)
       (= (target-names/parse "aarch64-android-kotoba-v1") :aarch64-android-kotoba-v1)
       (= (target-names/parse "aarch64-ios-kotoba-v1") :aarch64-ios-kotoba-v1)
       (= (target-names/parse "x86_64-aiueos-kernel-v1") :x86_64-aiueos-kernel-v1)
       (= (target-names/parse "x86_64-aiueos-user-v1") :x86_64-aiueos-user-v1)
       (= (target-names/parse "x86_64-aiueos-uefi-v1") :x86_64-aiueos-uefi-v1)
       (= (target-names/parse "aarch64-aiueos-kernel-v1") :aarch64-aiueos-kernel-v1))
    1
    0))

(defn main [] :i64
  (if (and (= (test-target-aliases) 1)
           (= (test-target-profile-spellings) 1))
    0
    1))
