(ns native.document-runtime-test
  (:export [main refuse-infinity refuse-nan refuse-uppercase refuse-odd-hex
            refuse-bool refuse-truncated refuse-trailing refuse-integer-overflow
            refuse-container refuse-depth refuse-nodes refuse-duplicate-set
            refuse-unsorted-set refuse-duplicate-map refuse-unsorted-map
            refuse-utf8 refuse-print-limit refuse-zero-duplicate]))

;; Expected bytes are the existing document conformance anchors, not output
;; generated by the implementation under test. No document-sha256 is admitted.
(defn- anchor [value :document hex :string] :bool
  (and (string=? (document-print value) hex)
       (document-equal? value (document-read hex))
       (string=? (document-print (document-read hex)) hex)))
(defn- anchors [] :bool
  (and
    (anchor (document-null) "6e")
    (anchor (document-bool true) "6274")
    (anchor (document-i64 -42) "692d34323b")
    (anchor (document-string "猫a") "73343ae78cab61")
    (anchor (document-keyword :k/v) "6b343a3a6b2f76")
    (anchor (document-f64 1.5) "66343630393433343231383631333730323635363b")
    (anchor (document-symbol (symbol "a/b")) "79333a612f62")
    (anchor (document-vector (document-i64 1) (document-string "x")) "76323a69313b73313a78")
    (anchor (document-list (document-i64 1)) "6c313a69313b")
    (anchor (document-set (document-i64 2) (document-i64 1)) "65323a69313b69323b")
    (anchor (document-map :zeta (document-i64 1) :a (document-vector (document-bool true)) :bb (document-null))
            "6d333a4b323a3a6176313a62744b333a3a62626e4b353a3a7a65746169313b")
    (anchor (document-map (document-string "b") (document-i64 1) (document-string "aaaaaaaaaa") (document-i64 2))
            "6d323a447331303a6161616161616161616169323b4473313a6269313b")
    (anchor (document-map :x (document-vector (document-map :y (document-set (document-i64 1))) (document-string "") (document-list)))
            "6d313a4b323a3a7876333a6d313a4b323a3a7965313a69313b73303a6c303a")))
(defn- float-roundtrip [bits :i64] :bool
  (let [value (document-f64 (f64-from-bits bits))
        recovered (document-f64-value value)]
    (and (= (document-kind value) :f64)
         (option-some?-of [:option :f64] recovered)
         (= (f64-to-bits (option-value-of [:option :f64] recovered 0.0)) bits))))
(defn- floats [] :bool
  (and (float-roundtrip 0) (float-roundtrip -9223372036854775808)
       (float-roundtrip 1) (float-roundtrip -9223372036854775807)
       (float-roundtrip 4609434218613702656) (float-roundtrip 9218868437227405311)
       (not (option-some?-of [:option :f64] (document-f64-value (document-i64 1))))
       (not (option-some?-of [:option :f64] (document-f64-value (document-null))))))
(defn- zero-identity [] :bool
  (let [positive (document-f64 (f64-from-bits 0))
        negative (document-f64 (f64-from-bits -9223372036854775808))
        map (document-map positive (document-i64 7))
        lookup (document-get map negative)]
    (and (document-equal? positive negative)
         (string=? (document-print negative) "66303b")
         (document-set-contains? (document-set positive) negative)
         (option-some?-of [:option :document] lookup)
         (document-equal? (option-value-of [:option :document] lookup (document-null)) (document-i64 7)))))
(defn- escapes [] :bool
  (let [value (document-string "\"\\\n猫😀")]
    (and (document-equal? value (document-read (document-print value)))
         (string=? (option-value-of [:option :string]
                      (document-string-value (document-read (document-print value))) "")
                   "\"\\\n猫😀"))))
(defn- integer-edges [] :bool
  (and (anchor (document-i64 -9223372036854775808) "692d393232333337323033363835343737353830383b")
       (anchor (document-i64 9223372036854775807) "69393232333337323033363835343737353830373b")))
(defn main [] :i64
  (+ (if (anchors) 1 0) (if (floats) 2 0) (if (zero-identity) 4 0)
     (if (escapes) 8 0) (if (integer-edges) 16 0)))

;; Every refusal entry must trap. A normal return is a failed refusal test.
(defn refuse-infinity [] :i64 (string-length (document-print (document-f64 (f64-from-bits 9218868437227405312)))))
(defn refuse-nan [] :i64 (string-length (document-print (document-f64 (f64-from-bits 9221120237041090560)))))
(defn refuse-uppercase [] :i64 (string-length (document-print (document-read "6E"))))
(defn refuse-odd-hex [] :i64 (string-length (document-print (document-read "6"))))
(defn refuse-bool [] :i64 (string-length (document-print (document-read "6278"))))
(defn refuse-truncated [] :i64 (string-length (document-print (document-read "73323a61"))))
(defn refuse-trailing [] :i64 (string-length (document-print (document-read "6e6e"))))
(defn refuse-integer-overflow [] :i64 (string-length (document-print (document-read "69393232333337323033363835343737353830383b"))))
(defn refuse-container [] :i64 (string-length (document-print (document-read "7633333a"))))
(defn refuse-depth [] :i64 (string-length (document-print (document-read "76313a76313a76313a76313a76313a76313a76313a76313a76313a6e"))))
(defn refuse-duplicate-set [] :i64 (string-length (document-print (document-read "65323a69313b69313b"))))
(defn refuse-unsorted-set [] :i64 (string-length (document-print (document-read "65323a69323b69313b"))))
(defn refuse-duplicate-map [] :i64 (string-length (document-print (document-read "6d323a4b323a3a616e4b323a3a616e"))))
(defn refuse-unsorted-map [] :i64 (string-length (document-print (document-read "6d323a4b323a3a626e4b323a3a616e"))))
(defn refuse-utf8 [] :i64 (string-length (document-print (document-read "73313aff"))))
(defn- repeat-text [text :string count :i64] :string
  (loop [index 0 result ""]
    (if (>= index count) result (recur (+ index 1) (string-concat result text)))))
(defn refuse-nodes [] :i64
  (let [four "76343a6e6e6e6e"
        middle (string-concat "7633323a" (repeat-text four 32))
        root (string-concat "7633323a" (repeat-text middle 32))]
    (string-length (document-print (document-read root)))))
(defn refuse-print-limit [] :i64
  (string-length (document-print (document-string (repeat-text "x" 32768)))))
(defn refuse-zero-duplicate [] :i64
  (document-count (document-set (document-f64 (f64-from-bits 0))
                                (document-f64 (f64-from-bits -9223372036854775808)))))
