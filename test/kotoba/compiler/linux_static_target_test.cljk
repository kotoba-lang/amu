(ns kotoba.compiler.linux-static-target-test
  "The loader-less Linux static ELF targets (superproject adr-2609251400 C2):
  registered on every table a target name has to reach, packaged, and
  decided by the profile this compiler ships.

  Execution is not asserted here (the suite runs on macOS as well as Linux).
  It was measured when the target landed: on Linux aarch64 natively and on
  x86-64 under qemu-x86_64 user mode, recursive-list 500500, recursive-tree 10
  and string-index-of 189600 on both ISAs, equal to the kexe loader's answers;
  the cell, byte and fuel budgets trapped by name with exit 123 / 124 / 122,
  and an unadmitted slot with 125. The ADR's :adr/gaps line records it."
  (:require [kotoba.test :refer [deftest is testing]]
            [kotoba.compiler.limits :as limits]
            [kotoba.compiler.target-names :as target-names]
            [kotoba.compiler.nbb.cli :as native-cli]
            [kotoba.kir.target :as target-profile]
            [kotoba.native.linux-static :as linux-static]
            [kotoba.compiler.linux-static-handlers :as static-handlers]
            #?(:cljs ["node:crypto" :as crypto])
            #?(:cljs ["node:fs" :as fs])))

(def names {"x86_64-linux-static" :x86_64-linux-static-kotoba-v1
            "aarch64-linux-static" :aarch64-linux-static-kotoba-v1})

(deftest every-table-knows-the-two-names
  (doseq [[spelling target] names]
    (testing spelling
      (is (= target (target-names/parse spelling)) "the vocabulary")
      (is (= target (get native-cli/targets spelling)) "the nbb native route")
      (is (contains? native-cli/unmetered-default-targets target)
          "the native profile's default: fuel off")
      (is (= :static (:linkage (target-profile/profile target))))
      (is (= :native (:execution (target-profile/profile target))))
      (is (contains? linux-static/targets target) "the packager serves it")
      #?(:cljs (is (.includes (fs/readFileSync "bin/amu" "utf8") (str "\"" spelling "\""))
                   "bin/amu routes it to the nbb native driver")))))

(deftest the-profile-this-compiler-ships-is-one-the-packager-accepts
  (let [static (get-in limits/table [:profile/native :static-elf])
        admitted (get-in static [:admitted-slots :value])
        codes (get-in static [:exit-codes :value])]
    (is (seq admitted))
    (is (every? linux-static/implemented-slots admitted)
        "every slot the profile admits has code; the packager refuses otherwise")
    (is (= (count codes) (count (distinct (vals codes)))) "one exit status per outcome")
    (doseq [trap [(get-in limits/table [:profile/native :fuel :trap])
                  (get-in limits/table [:profile/native :cells :trap])
                  (get-in limits/table [:profile/native :bytes :trap])
                  (:unimplemented-slot-trap static)
                  :ok :trap/signal]]
      (is (integer? (get codes trap)) (str trap " has an exit status")))))

;; superproject adr-2609251400 C3. The handler decision code a static image
;; with effects carries is this compiler's compilation of two sources in THIS
;; tree, held as sealed artifacts in `kotoba.compiler.linux-static-handlers`
;; (scripts/gen-linux-static-handlers.cljk writes it; --check recompiles and
;; compares, and refuses unless the C1 module's bytes equal the ones
;; tools/kexe_loader.c embeds). What this suite can say cheaply is that the
;; generated namespace was made from the sources as they are now: an edit to
;; either .kotoba that was not regenerated turns this red.
#?(:cljs
   (deftest the-handler-decisions-were-generated-from-these-sources
     (doseq [[k path] [[:decisions "tools/kexe_loader_decisions.kotoba"]
                       [:handlers "tools/linux_static_handlers.kotoba"]]]
       (let [digest (-> (.createHash crypto "sha256") (.update (fs/readFileSync path)) (.digest "hex"))]
         (is (= digest (get static-handlers/source-sha256 k))
             (str path " changed since scripts/gen-linux-static-handlers.cljk last ran"))))
     (doseq [isa [:aarch64 :x86_64] k [:decisions :handlers]]
       (is (string? (get-in static-handlers/artifact-texts [isa k])) (str isa " " k)))))

(deftest the-profile-hands-the-packager-a-handler-for-every-capability-it-names
  (let [handled (get-in limits/table [:profile/native :static-elf :capability-handlers :value])]
    (is (= #{7 33 34 35 37 38 39 41} (set (keys handled))))
    (is (contains? (set (get-in limits/table [:profile/native :static-elf :admitted-slots :value]))
                   :typed-cap-call))
    (is (= #{20 23} (set (keys (get-in limits/table [:profile/native :static-elf :refused-capabilities :value])))))))
