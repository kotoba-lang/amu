(ns kotoba.compiler.accelerator-variants-test
  (:require [clojure.string :as str]
            [clojure.test :refer [deftest is testing]]
            [kotoba.compiler.accelerator :as accelerator]
            [kotoba.compiler.accelerator-targets :as targets]
            [kotoba.compiler.accelerator-variants :as variants]))

(deftest selection-is-total-deterministic-and-unmeasured
  (testing "NVIDIA reduction kernels at or above one full warp take the shuffle variant"
    (doseq [wg [32 64 128 256 512 1024]
            operator [:sum :max :min]]
      (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                    :reduce operator {:workgroup-size wg})]
        (is (= :warp-shuffle-reduce (:variant (variants/select-variant :nvidia kir :cuda {:compute-capability 7.0}))))
        (is (false? (:measured? (variants/select-variant :nvidia kir :cuda {:compute-capability 7.0})))))))
  (testing "everything else answers :baseline, never a refusal"
    (let [reduce-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          ewise-kir (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
          subwarp-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 16})]
      (doseq [vendor [:apple :intel :arm :nvidia :amd :unknown :qualcomm]]
        (is (= :baseline (:variant (variants/select-variant vendor reduce-kir)))))
      (is (= :baseline (:variant (variants/select-variant :nvidia ewise-kir))))
      (is (= :baseline (:variant (variants/select-variant :nvidia subwarp-kir))))
      (is (= :baseline (:variant (variants/select-variant :nvidia {}))))
      (is (= :baseline (:variant (variants/select-variant :nvidia nil))))))
  (testing "same pair in, same map out"
    (let [kir (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 256})]
      (is (= (variants/select-variant :nvidia kir) (variants/select-variant :nvidia kir)))))
  (testing "every answer names an emittable variant with a basis, and none claims measurement"
    (doseq [vendor [:nvidia :apple :intel :arm :amd :unknown]
            op [:ewise :reduce]
            operator [:add :sum]]
      (let [kir (accelerator/kernel "k_f32" op operator {:workgroup-size 256})
            answer (variants/select-variant vendor kir)]
        (is (contains? accelerator/kernel-variants (:variant answer)))
        (is (string? (:basis answer)))
        (is (false? (:measured? answer)))
        (is (contains? variants/variant-bases (:variant answer)))))))

(deftest selected-variants-lower-and-verify
  (testing "the selected NVIDIA variant is exactly what the emitter admits"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          selected (:variant (variants/select-variant :nvidia kir :cuda {:compute-capability 7.0}))
          compiled (accelerator/compile-kernel kir :cuda-v1 selected)]
      (is (= :warp-shuffle-reduce selected))
      (is (= :warp-shuffle-reduce (:variant compiled)))
      (is (re-find #"__shfl_down_sync" (:code compiled)))
      (is (= compiled (accelerator/verify-artifact! compiled)))))
  (testing "a baseline answer lowers to the baseline emission"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          apple (:variant (variants/select-variant :apple kir))]
      (is (= (accelerator/lower kir :cuda-v1)
             (accelerator/lower kir :cuda-v1 apple))))))

(deftest subgroup-reduce-rows-select-under-their-gates
  ;; JUN-59 (Intel, ADR-0356), JUN-60 (ARM, ADR-0357), JUN-58 (Apple,
  ;; ADR-0360) and JUN-57 (NVIDIA on the Vulkan route, ADR-0361) selection
  ;; rows:
  ;; :subgroup-reduce is answered for a reduce over :sum/:max/:min with
  ;; W >= 32, on the Vulkan route under either of its two names, on a device
  ;; descriptor that reports the fold's subgroup ops and a subgroup size
  ;; that divides W (ADR-0356 rule 6 / ADR-0357's capability precondition).
  (doseq [vendor [:intel :arm :apple :nvidia]
          wg [32 64 128 256 512 1024]
          operator [:sum :max :min]
          target [:vulkan :glsl-v1]
          s [4 8 16 32]]
    (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                  :reduce operator {:workgroup-size wg})
          device {:subgroup-size s :subgroup-ops #{:basic :shuffle-relative}}
          answer (variants/select-variant vendor kir target device)]
      (is (= :subgroup-reduce (:variant answer)))
      (is (false? (:measured? answer)))
      (is (string? (:basis answer)))))
  (testing "the reported subgroup width is taken as the device gives it"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 1024})]
      (is (= :subgroup-reduce
             (:variant (variants/select-variant
                        :arm kir :vulkan
                        {:subgroup-size 4 :subgroup-ops #{:basic :shuffle-relative}}))))
      (is (= :subgroup-reduce
             (:variant (variants/select-variant
                        :intel kir :glsl-v1
                        {:subgroup-size 32
                         :subgroup-ops #{:basic :shuffle-relative :arithmetic}}))))))
  (testing "same arguments in, same map out"
    (let [kir (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 128})
          device {:subgroup-size 16 :subgroup-ops #{:basic :shuffle-relative}}]
      (is (= (variants/select-variant :intel kir :vulkan device)
             (variants/select-variant :intel kir :vulkan device))))))

(deftest subgroup-reduce-selection-fails-closed-off-its-gates
  ;; Every missing or malformed fact answers :baseline -- an absence of
  ;; evidence is not a refusal, and the portable variant is the answer.
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        ewise (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
        sub-min (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 16})
        malformed (assoc kir :kernel/dtype :f64)
        capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
    (testing "a device that confirms no subgroup capability"
      (doseq [device [nil
                      {}
                      {:subgroup-size 32}
                      {:subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 32 :subgroup-ops #{:basic}}
                      {:subgroup-size 32 :subgroup-ops #{:shuffle-relative}}
                      {:subgroup-size 32 :subgroup-ops :all}
                      ;; On this JS/SCI host 32.0 IS 32 (one IEEE double),
                      ;; so the malformed-number case must use a value that
                      ;; is a number but not an integer.
                      {:subgroup-size 32.5 :subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 0 :subgroup-ops #{:basic :shuffle-relative}}
                      ;; rule 6: a subgroup size that does not divide W --
                      ;; which includes one larger than W -- answers
                      ;; :baseline.
                      {:subgroup-size 24 :subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 512 :subgroup-ops #{:basic :shuffle-relative}}]]
        (doseq [vendor [:intel :arm :apple] target [:vulkan :glsl-v1]]
          (is (= :baseline
                 (:variant (variants/select-variant vendor kir target device)))
              (str "device " (pr-str device) " must fail closed")))))
    (testing "a target outside the rows' routes (ADR-0363 moved the WGSL route in for Intel/ARM; the ADR-0360 amendment moved the MSL route in for Apple)"
      (doseq [target [:cuda :cuda-v1 nil]]
        (is (= :baseline (:variant (variants/select-variant :intel kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :arm kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :apple kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :nvidia kir target capable)))))
      ;; The MSL route carries the Apple row only (the ADR-0360 amendment).
      (doseq [target [:msl-v1 :metal]]
        (is (= :baseline (:variant (variants/select-variant :intel kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :arm kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :nvidia kir target capable)))))
      ;; The WGSL route carries the Intel and ARM rows only (ADR-0363);
      ;; the NVIDIA row keeps its ADR's Vulkan-route scope.
      (doseq [target [:webgpu :wgsl-v1]]
        (is (= :baseline (:variant (variants/select-variant :apple kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :nvidia kir target capable))))))
    (testing "a vendor outside the four designed rows"
      (doseq [vendor [:amd :unknown :qualcomm]]
        (is (= :baseline (:variant (variants/select-variant vendor kir :vulkan capable))))))
    (testing "an NVIDIA descriptor whose reported compute capability contradicts the sm_70+ floor (ADR-0361)"
      (doseq [device [(assoc capable :compute-capability 6.0)
                      (assoc capable :compute-capability 6.5)
                      (assoc capable :compute-capability "7.0")
                      (assoc capable :compute-capability :seven)]
              target [:vulkan :glsl-v1]]
        (is (= :baseline (:variant (variants/select-variant :nvidia kir target device)))
            (str "compute capability " (pr-str (:compute-capability device)) " must fail closed")))
      (testing "and an absent capability is not a refusal: the reported subgroup facts are the evidence"
        (doseq [target [:vulkan :glsl-v1]]
          (is (= :subgroup-reduce (:variant (variants/select-variant :nvidia kir target capable)))))))
    (testing "a shape outside the emission's row"
      (is (= :baseline (:variant (variants/select-variant :intel ewise :vulkan capable))))
      (is (= :baseline (:variant (variants/select-variant :arm sub-min :vulkan capable))))
      (is (= :baseline (:variant (variants/select-variant :intel malformed :vulkan capable))))
      (is (= :baseline (:variant (variants/select-variant :intel {} :vulkan capable))))
      (is (= :baseline (:variant (variants/select-variant :intel nil :vulkan capable)))))))

(deftest the-selected-subgroup-reduce-variant-lowers-seals-and-verifies
  ;; Rule 3 end to end: what the table selects is exactly what the emitter
  ;; admits, and the sealed artifact re-lowers byte-identically.
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 128})
        device {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
        selected (:variant (variants/select-variant :arm kir :vulkan device))
        compiled (accelerator/compile-kernel kir :glsl-v1 selected)]
    (is (= :subgroup-reduce selected))
    (is (= :subgroup-reduce (:variant compiled)))
    (is (str/includes? (:code compiled) "gl_SubgroupSize"))
    (is (nil? (re-find #"\bd\s*=\s*\d+u" (:code compiled)))
        "a baked fold width leaked into the selected emission")
    (is (= compiled (accelerator/verify-artifact! compiled)))))

(deftest each-route-selects-under-either-of-its-names
  ;; ADR-0359 decision 3: :vulkan and :glsl-v1 name one route, :cuda /
  ;; :cuda-v1 are the CUDA route's two spellings the same way, :metal /
  ;; :msl-v1 the MSL route's, and (ADR-0363) :webgpu / :wgsl-v1 the WGSL
  ;; route's. A caller holding
  ;; target-for's api answer and a caller holding lower's emitter target
  ;; select the same variant.
  (let [reduce-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
    (doseq [target [:cuda :cuda-v1]]
      (is (= :warp-shuffle-reduce
             (:variant (variants/select-variant :nvidia reduce-kir target
                                                {:compute-capability 7.0})))))
    (doseq [vendor [:intel :arm :apple :nvidia] target [:vulkan :glsl-v1]]
      (is (= :subgroup-reduce
             (:variant (variants/select-variant vendor reduce-kir target capable)))))
    (doseq [vendor [:intel :arm] target [:webgpu :wgsl-v1]]
      (is (= :subgroup-reduce
             (:variant (variants/select-variant vendor reduce-kir target capable)))))
    (doseq [target [:metal :msl-v1]]
      (is (= :subgroup-reduce
             (:variant (variants/select-variant :apple reduce-kir target capable)))))))

(deftest the-apple-row-rides-the-vulkan-and-msl-routes
  ;; ADR-0360 (JUN-58) as amended 2026-10-23 (JUN-58's own decision): the
  ;; Apple row is the shared subgroup-size-parametric emission on the
  ;; Vulkan route (MoltenVK is Apple's only EXECUTION route here) AND on
  ;; the MSL route -- :metal (api) / :msl-v1 (emitter target), one route
  ;; under two names, the ADR-0359 decision-3 idiom. Rule 3 holds on both
  ;; (the MSL arm of the emission landed 2026-10-23 and lower admits
  ;; (:msl-v1, :subgroup-reduce)), and rule 6 is the same descriptor gate
  ;; on both routes -- the keys are the contract, whatever fills them. The
  ;; WGSL route does NOT carry Apple (ADR-0363's scope is Intel/ARM).
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
    (doseq [target [:vulkan :glsl-v1 :metal :msl-v1]]
      (let [answer (variants/select-variant :apple kir target capable)]
        (is (= :subgroup-reduce (:variant answer)))
        (is (false? (:measured? answer)))
        (is (str/includes? (:basis answer) "ADR-0360"))))
    (doseq [target [:webgpu :wgsl-v1 :cuda :cuda-v1]]
      (is (= :baseline (:variant (variants/select-variant :apple kir target capable)))))
    (testing "the same rule-6 gate fails closed on the MSL route"
      (doseq [device [nil
                      {}
                      {:subgroup-size 32}
                      {:subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 32 :subgroup-ops #{:basic}}
                      {:subgroup-size 32 :subgroup-ops #{:shuffle-relative}}
                      {:subgroup-size 24 :subgroup-ops #{:basic :shuffle-relative}}]
              target [:metal :msl-v1]]
        (is (= :baseline (:variant (variants/select-variant :apple kir target device)))
            (str "device " (pr-str device) " must fail closed on the MSL route"))))
    (testing "rule 3 end to end: the selected variant lowers, seals and verifies on :msl-v1"
      (let [selected (:variant (variants/select-variant :apple kir :msl-v1 capable))
            compiled (accelerator/compile-kernel kir :msl-v1 selected)]
        (is (= :subgroup-reduce selected))
        (is (= :subgroup-reduce (:variant compiled)))
        (is (str/includes? (:code compiled) "uint sgsize [[threads_per_simdgroup]]"))
        (is (str/includes? (:code compiled) "uint fold = min(sgsize, width);"))
        (is (str/includes? (:code compiled) "simd_shuffle_down"))
        (is (nil? (re-find #"\bfold = \d+u" (:code compiled)))
            "a baked fold width leaked into the MSL emission")
        ;; Metal refuses a kernel named main (Apple metal 32023.883): the
        ;; MSL arm's entry is the kernel's :kernel/name (the MSL-arm
        ;; amendment of ADR-0356).
        (is (str/includes? (:code compiled) "kernel void reduce_sum_f32"))
        (is (not (str/includes? (:code compiled) "kernel void main")))
        (is (= compiled (accelerator/verify-artifact! compiled)))))))

(deftest the-nvidia-row-rides-the-vulkan-route-only
  ;; ADR-0361 (JUN-57): NVIDIA's row on the Vulkan route is the shared
  ;; subgroup-size-parametric emission (the warp's 32 is queried at runtime
  ;; like every other width, never baked), and it carries the CUDA row's
  ;; sm_70+ floor fail-closed on a REPORTED compute capability. The CUDA
  ;; route keeps :warp-shuffle-reduce -- its own decided row; since
  ;; 2026-10-23 the CUDA emitter ADMITS :subgroup-reduce too (the CUDA arm
  ;; of the emission landed), so the reason the CUDA route keeps
  ;; :warp-shuffle-reduce is the row's own scope, not rule 3: extending
  ;; NVIDIA's CUDA-route row is a separate per-vendor decision, undecided
  ;; -- and every target outside the Vulkan route answers :baseline.
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
        answer (variants/select-variant :nvidia kir :vulkan capable)]
    (is (= :subgroup-reduce (:variant answer)))
    (is (false? (:measured? answer)))
    (is (str/includes? (:basis answer) "ADR-0361"))
    (testing "a reported capability at or above the floor still selects"
      (doseq [target [:vulkan :glsl-v1]]
        (is (= :subgroup-reduce
               (:variant (variants/select-variant
                          :nvidia kir target
                          (assoc capable :compute-capability 7.0)))))))
    (testing "the CUDA route keeps its own row on the same kernel"
      (doseq [target [:cuda :cuda-v1]]
        (is (= :warp-shuffle-reduce
               (:variant (variants/select-variant
                          :nvidia kir target
                          {:compute-capability 7.0}))))))
    (doseq [target [:msl-v1 :metal :webgpu :wgsl-v1]]
      (is (= :baseline (:variant (variants/select-variant :nvidia kir target capable)))))))

(deftest the-wgsl-route-carries-the-intel-and-arm-rows
  ;; ADR-0363 (JUN-59, JUN-60): the WGSL route -- :webgpu (api) and
  ;; :wgsl-v1 (emitter target), one route under two names exactly like
  ;; :vulkan/:glsl-v1 (ADR-0359 decision 3) -- selects :subgroup-reduce for
  ;; Intel and ARM under the same rules 3 + 6 gate the Vulkan route uses.
  ;; The NVIDIA row stays Vulkan-route-only (its ADR's scope; the Apple row
  ;; now rides the MSL route too -- the ADR-0360 amendment, tested in
  ;; the-apple-row-rides-the-vulkan-and-msl-routes -- and stays off the
  ;; WGSL route). Everything here is
  ;; UNCOMPILED (no WGSL validator on this host) and UNMEASURED -- no
  ;; WebGPU execution path exists and :measured? is false on every answer.
  (doseq [vendor [:intel :arm]
          wg [32 64 128 256 512 1024]
          operator [:sum :max :min]
          target [:webgpu :wgsl-v1]
          s [8 16 32]]
    (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                  :reduce operator {:workgroup-size wg})
          device {:subgroup-size s :subgroup-ops #{:basic :shuffle-relative}}
          answer (variants/select-variant vendor kir target device)]
      (is (= :subgroup-reduce (:variant answer)))
      (is (false? (:measured? answer)))
      (is (string? (:basis answer)))))
  (testing "the same rule-6 gate fails closed on this route too"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          ewise (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
          malformed (assoc kir :kernel/dtype :f64)
          capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
      (doseq [device [nil
                      {}
                      {:subgroup-size 32 :subgroup-ops #{:basic}}
                      {:subgroup-size 32 :subgroup-ops #{:shuffle-relative}}
                      {:subgroup-size 24 :subgroup-ops #{:basic :shuffle-relative}}]
              target [:webgpu :wgsl-v1]]
        (doseq [vendor [:intel :arm]]
          (is (= :baseline (:variant (variants/select-variant vendor kir target device)))
              (str "device " (pr-str device) " must fail closed on the WGSL route"))))
      (doseq [target [:webgpu :wgsl-v1]]
        (is (= :baseline (:variant (variants/select-variant :intel ewise target capable))))
        (is (= :baseline (:variant (variants/select-variant :arm malformed target capable)))))))
  (testing "the MSL route answers :baseline for every vendor but Apple (row scope, not rule 3: the MSL emitter has admitted :subgroup-reduce since 2026-10-23, and the ADR-0360 amendment put Apple's row on this route)"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
      (doseq [vendor [:intel :arm :nvidia] target [:msl-v1 :metal]]
        (is (= :baseline (:variant (variants/select-variant vendor kir target capable)))))))
  (testing "rule 3 end to end: the selected variant lowers, seals and verifies on :wgsl-v1"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 128})
          device {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
          selected (:variant (variants/select-variant :arm kir :wgsl-v1 device))
          compiled (accelerator/compile-kernel kir :wgsl-v1 selected)]
      (is (= :subgroup-reduce selected))
      (is (= :subgroup-reduce (:variant compiled)))
      (is (str/includes? (:code compiled) "enable subgroups;"))
      (is (not (str/includes? (:code compiled) "enable subgroup_id;"))
          "subgroup_id is a LANGUAGE extension; enable-ing it is a shader-creation error (WGSL spec pin, 2026-10-23)")
      (is (str/includes? (:code compiled) "for(var d:u32=fold/2u;"))
      (is (nil? (re-find #"d:u32=\d+u" (:code compiled)))
          "a baked fold width leaked into the WGSL emission")
      (is (= compiled (accelerator/verify-artifact! compiled)))))
  (testing "same arguments in, same map out"
    (let [kir (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 128})
          device {:subgroup-size 16 :subgroup-ops #{:basic :shuffle-relative}}]
      (is (= (variants/select-variant :intel kir :wgsl-v1 device)
             (variants/select-variant :intel kir :wgsl-v1 device))))))

(deftest rule-6-reads-the-facts-the-subgroup-answer-parses
  ;; ADR-0362 decision 4, end to end at the seam it names: the consumer
  ;; parser's answer is exactly the descriptor rule 6 consumes, and every
  ;; absent or malformed answer fails closed to :baseline. The parser's
  ;; producer (slice 2, the ADR 0371 provider's SUBGROUP reply) does not
  ;; exist yet -- the strings here are parser inputs, not wire readings, and
  ;; nothing here is a measurement.
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})]
    (is (= :subgroup-reduce
           (:variant (variants/select-variant
                      :apple kir :vulkan
                      (targets/device-from-subgroup "32|basic shuffle-relative")))))
    (is (= :subgroup-reduce
           (:variant (variants/select-variant
                      :apple kir :msl-v1
                      (targets/device-from-subgroup "32|basic shuffle-relative"))))
        "the descriptor keys are the route-agnostic contract: the same parsed facts select on the MSL route")
    (is (= :subgroup-reduce
           (:variant (variants/select-variant
                      :intel kir :glsl-v1
                      (targets/device-from-subgroup "8|basic shuffle-relative shuffle"))))
        "a parsed fact set larger than the fold's two ops still selects")
    (is (= :baseline
           (:variant (variants/select-variant
                      :apple kir :vulkan
                      (targets/device-from-subgroup "32|basic"))))
        "a fact missing :shuffle-relative fails closed")
    (is (= :baseline
           (:variant (variants/select-variant
                      :apple kir :vulkan
                      (targets/device-from-subgroup "24|basic shuffle-relative"))))
        "a subgroup size that does not divide the workgroup fails closed")
    (is (= :baseline
           (:variant (variants/select-variant
                      :apple kir :vulkan
                      (targets/device-from-subgroup "no|such answer"))))
        "a malformed answer is an absent fact, and an absent fact is :baseline")))
