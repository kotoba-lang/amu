(ns kotoba.compiler.accelerator-variants-test
  (:require [clojure.string :as str]
            [clojure.test :refer [deftest is testing]]
            [kotoba.compiler.accelerator :as accelerator]
            [kotoba.compiler.accelerator-targets :as targets]
            [kotoba.compiler.accelerator-variants :as variants]))

(deftest selection-is-total-deterministic-and-unmeasured
  (testing "NVIDIA reduction kernels at or above one full warp take the shuffle variant"
    (doseq [wg [32 64 128 256 512 1024]
            operator [:sum :max :min]]
      (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                    :reduce operator {:workgroup-size wg})]
        (is (= :warp-shuffle-reduce (:variant (variants/select-variant :nvidia kir :cuda {:compute-capability 7.0}))))
        (is (false? (:measured? (variants/select-variant :nvidia kir :cuda {:compute-capability 7.0})))))))
  (testing "everything else answers :baseline, never a refusal"
    (let [reduce-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          ewise-kir (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
          subwarp-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 16})]
      (doseq [vendor [:apple :intel :arm :nvidia :amd :unknown :qualcomm]]
        (is (= :baseline (:variant (variants/select-variant vendor reduce-kir)))))
      (is (= :baseline (:variant (variants/select-variant :nvidia ewise-kir))))
      (is (= :baseline (:variant (variants/select-variant :nvidia subwarp-kir))))
      (is (= :baseline (:variant (variants/select-variant :nvidia {}))))
      (is (= :baseline (:variant (variants/select-variant :nvidia nil))))))
  (testing "same pair in, same map out"
    (let [kir (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 256})]
      (is (= (variants/select-variant :nvidia kir) (variants/select-variant :nvidia kir)))))
  (testing "every answer names an emittable variant with a basis, and none claims measurement"
    (doseq [vendor [:nvidia :apple :intel :arm :amd :unknown]
            op [:ewise :reduce]
            operator [:add :sum]]
      (let [kir (accelerator/kernel "k_f32" op operator {:workgroup-size 256})
            answer (variants/select-variant vendor kir)]
        (is (contains? accelerator/kernel-variants (:variant answer)))
        (is (string? (:basis answer)))
        (is (false? (:measured? answer)))
        (is (contains? variants/variant-bases (:variant answer)))))))

(deftest selected-variants-lower-and-verify
  (testing "the selected NVIDIA variant is exactly what the emitter admits"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          selected (:variant (variants/select-variant :nvidia kir :cuda {:compute-capability 7.0}))
          compiled (accelerator/compile-kernel kir :cuda-v1 selected)]
      (is (= :warp-shuffle-reduce selected))
      (is (= :warp-shuffle-reduce (:variant compiled)))
      (is (re-find #"__shfl_down_sync" (:code compiled)))
      (is (= compiled (accelerator/verify-artifact! compiled)))))
  (testing "a baseline answer lowers to the baseline emission"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          apple (:variant (variants/select-variant :apple kir))]
      (is (= (accelerator/lower kir :cuda-v1)
             (accelerator/lower kir :cuda-v1 apple))))))

(deftest subgroup-reduce-rows-select-under-their-gates
  ;; JUN-59 (Intel, ADR-0356), JUN-60 (ARM, ADR-0357), JUN-58 (Apple,
  ;; ADR-0360), JUN-57 (NVIDIA on the Vulkan route, ADR-0361) and JUN-84
  ;; (AMD, ADR-0364) selection
  ;; rows:
  ;; :subgroup-reduce is answered for a reduce over :sum/:max/:min with
  ;; W >= 32, on the Vulkan route under either of its two names, on a device
  ;; descriptor that reports the fold's subgroup ops and a subgroup size
  ;; that divides W (ADR-0356 rule 6 / ADR-0357's capability precondition).
  (doseq [vendor [:intel :arm :apple :nvidia :amd]
          wg [32 64 128 256 512 1024]
          operator [:sum :max :min]
          target [:vulkan :glsl-v1]
          s [4 8 16 32]]
    (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                  :reduce operator {:workgroup-size wg})
          device {:subgroup-size s :subgroup-ops #{:basic :shuffle-relative}}
          answer (variants/select-variant vendor kir target device)]
      (is (= :subgroup-reduce (:variant answer)))
      (is (false? (:measured? answer)))
      (is (string? (:basis answer)))))
  (testing "the reported subgroup width is taken as the device gives it"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 1024})]
      (is (= :subgroup-reduce
             (:variant (variants/select-variant
                        :arm kir :vulkan
                        {:subgroup-size 4 :subgroup-ops #{:basic :shuffle-relative}}))))
      (is (= :subgroup-reduce
             (:variant (variants/select-variant
                        :intel kir :glsl-v1
                        {:subgroup-size 32
                         :subgroup-ops #{:basic :shuffle-relative :arithmetic}}))))))
  (testing "same arguments in, same map out"
    (let [kir (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 128})
          device {:subgroup-size 16 :subgroup-ops #{:basic :shuffle-relative}}]
      (is (= (variants/select-variant :intel kir :vulkan device)
             (variants/select-variant :intel kir :vulkan device))))))

(deftest subgroup-reduce-selection-fails-closed-off-its-gates
  ;; Every missing or malformed fact answers :baseline -- an absence of
  ;; evidence is not a refusal, and the portable variant is the answer.
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        ewise (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
        sub-min (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 16})
        malformed (assoc kir :kernel/dtype :f64)
        capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
    (testing "a device that confirms no subgroup capability"
      (doseq [device [nil
                      {}
                      {:subgroup-size 32}
                      {:subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 32 :subgroup-ops #{:basic}}
                      {:subgroup-size 32 :subgroup-ops #{:shuffle-relative}}
                      {:subgroup-size 32 :subgroup-ops :all}
                      ;; On this JS/SCI host 32.0 IS 32 (one IEEE double),
                      ;; so the malformed-number case must use a value that
                      ;; is a number but not an integer.
                      {:subgroup-size 32.5 :subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 0 :subgroup-ops #{:basic :shuffle-relative}}
                      ;; rule 6: a subgroup size that does not divide W --
                      ;; which includes one larger than W -- answers
                      ;; :baseline.
                      {:subgroup-size 24 :subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 512 :subgroup-ops #{:basic :shuffle-relative}}]]
        (doseq [vendor [:intel :arm :apple :amd] target [:vulkan :glsl-v1]]
          (is (= :baseline
                 (:variant (variants/select-variant vendor kir target device)))
              (str "device " (pr-str device) " must fail closed")))))
    (testing "a target outside the rows' routes (ADR-0363 moved the WGSL route in for Intel/ARM and ADR-0364 for AMD; the ADR-0360 amendment moved the MSL route in for Apple; the ADR-0361 amendment moved the CUDA route in for NVIDIA -- its second rung)"
      (doseq [target [:cuda :cuda-v1 nil]]
        (is (= :baseline (:variant (variants/select-variant :intel kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :arm kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :apple kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :amd kir target capable)))))
      (is (= :baseline (:variant (variants/select-variant :nvidia kir nil capable)))
          "an absent target names no route, for NVIDIA too")
      ;; The MSL route carries the Apple row only (the ADR-0360 amendment).
      (doseq [target [:msl-v1 :metal]]
        (is (= :baseline (:variant (variants/select-variant :intel kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :arm kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :nvidia kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :amd kir target capable)))))
      ;; The WGSL route carries the Intel, ARM and AMD rows (ADR-0363,
      ;; extended to :amd by ADR-0364); the Apple and NVIDIA rows keep
      ;; their ADRs' routes.
      (doseq [target [:webgpu :wgsl-v1]]
        (is (= :baseline (:variant (variants/select-variant :apple kir target capable))))
        (is (= :baseline (:variant (variants/select-variant :nvidia kir target capable))))))
    (testing "a vendor outside the designed rows"
      (doseq [vendor [:unknown :qualcomm]]
        (is (= :baseline (:variant (variants/select-variant vendor kir :vulkan capable))))))
    (testing "an NVIDIA descriptor whose reported compute capability contradicts the sm_70+ floor (ADR-0361)"
      (doseq [device [(assoc capable :compute-capability 6.0)
                      (assoc capable :compute-capability 6.5)
                      (assoc capable :compute-capability "7.0")
                      (assoc capable :compute-capability :seven)]
              target [:vulkan :glsl-v1]]
        (is (= :baseline (:variant (variants/select-variant :nvidia kir target device)))
            (str "compute capability " (pr-str (:compute-capability device)) " must fail closed")))
      (testing "and an absent capability is not a refusal: the reported subgroup facts are the evidence"
        (doseq [target [:vulkan :glsl-v1]]
          (is (= :subgroup-reduce (:variant (variants/select-variant :nvidia kir target capable)))))))
    (testing "a shape outside the emission's row"
      (is (= :baseline (:variant (variants/select-variant :intel ewise :vulkan capable))))
      (is (= :baseline (:variant (variants/select-variant :arm sub-min :vulkan capable))))
      (is (= :baseline (:variant (variants/select-variant :intel malformed :vulkan capable))))
      (is (= :baseline (:variant (variants/select-variant :intel {} :vulkan capable))))
      (is (= :baseline (:variant (variants/select-variant :intel nil :vulkan capable)))))))

(deftest the-selected-subgroup-reduce-variant-lowers-seals-and-verifies
  ;; Rule 3 end to end: what the table selects is exactly what the emitter
  ;; admits, and the sealed artifact re-lowers byte-identically.
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 128})
        device {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
        selected (:variant (variants/select-variant :arm kir :vulkan device))
        compiled (accelerator/compile-kernel kir :glsl-v1 selected)]
    (is (= :subgroup-reduce selected))
    (is (= :subgroup-reduce (:variant compiled)))
    (is (str/includes? (:code compiled) "gl_SubgroupSize"))
    (is (nil? (re-find #"\bd\s*=\s*\d+u" (:code compiled)))
        "a baked fold width leaked into the selected emission")
    (is (= compiled (accelerator/verify-artifact! compiled)))))

(deftest each-route-selects-under-either-of-its-names
  ;; ADR-0359 decision 3: :vulkan and :glsl-v1 name one route, :cuda /
  ;; :cuda-v1 are the CUDA route's two spellings the same way, :metal /
  ;; :msl-v1 the MSL route's, and (ADR-0363) :webgpu / :wgsl-v1 the WGSL
  ;; route's. A caller holding
  ;; target-for's api answer and a caller holding lower's emitter target
  ;; select the same variant.
  (let [reduce-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
    (doseq [target [:cuda :cuda-v1]]
      (is (= :warp-shuffle-reduce
             (:variant (variants/select-variant :nvidia reduce-kir target
                                                {:compute-capability 7.0})))))
    ;; ADR-0361's amendment: the CUDA route's second rung selects under
    ;; both CUDA spellings too (the warp row above keeps precedence on the
    ;; same kernel when its gate holds).
    (doseq [target [:cuda :cuda-v1]]
      (is (= :subgroup-reduce
             (:variant (variants/select-variant :nvidia reduce-kir target capable)))))
    (doseq [vendor [:intel :arm :apple :nvidia :amd] target [:vulkan :glsl-v1]]
      (is (= :subgroup-reduce
             (:variant (variants/select-variant vendor reduce-kir target capable)))))
    (doseq [vendor [:intel :arm :amd] target [:webgpu :wgsl-v1]]
      (is (= :subgroup-reduce
             (:variant (variants/select-variant vendor reduce-kir target capable)))))
    (doseq [target [:metal :msl-v1]]
      (is (= :subgroup-reduce
             (:variant (variants/select-variant :apple reduce-kir target capable)))))))

(deftest the-apple-row-rides-the-vulkan-and-msl-routes
  ;; ADR-0360 (JUN-58) as amended 2026-10-23 (JUN-58's own decision): the
  ;; Apple row is the shared subgroup-size-parametric emission on the
  ;; Vulkan route (MoltenVK is Apple's only EXECUTION route here) AND on
  ;; the MSL route -- :metal (api) / :msl-v1 (emitter target), one route
  ;; under two names, the ADR-0359 decision-3 idiom. Rule 3 holds on both
  ;; (the MSL arm of the emission landed 2026-10-23 and lower admits
  ;; (:msl-v1, :subgroup-reduce)), and rule 6 is the same descriptor gate
  ;; on both routes -- the keys are the contract, whatever fills them. The
  ;; WGSL route does NOT carry Apple (ADR-0363's scope is Intel/ARM).
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
    (doseq [target [:vulkan :glsl-v1 :metal :msl-v1]]
      (let [answer (variants/select-variant :apple kir target capable)]
        (is (= :subgroup-reduce (:variant answer)))
        (is (false? (:measured? answer)))
        (is (str/includes? (:basis answer) "ADR-0360"))))
    (doseq [target [:webgpu :wgsl-v1 :cuda :cuda-v1]]
      (is (= :baseline (:variant (variants/select-variant :apple kir target capable)))))
    (testing "the same rule-6 gate fails closed on the MSL route"
      (doseq [device [nil
                      {}
                      {:subgroup-size 32}
                      {:subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 32 :subgroup-ops #{:basic}}
                      {:subgroup-size 32 :subgroup-ops #{:shuffle-relative}}
                      {:subgroup-size 24 :subgroup-ops #{:basic :shuffle-relative}}]
              target [:metal :msl-v1]]
        (is (= :baseline (:variant (variants/select-variant :apple kir target device)))
            (str "device " (pr-str device) " must fail closed on the MSL route"))))
    (testing "rule 3 end to end: the selected variant lowers, seals and verifies on :msl-v1"
      (let [selected (:variant (variants/select-variant :apple kir :msl-v1 capable))
            compiled (accelerator/compile-kernel kir :msl-v1 selected)]
        (is (= :subgroup-reduce selected))
        (is (= :subgroup-reduce (:variant compiled)))
        (is (str/includes? (:code compiled) "uint sgsize [[threads_per_simdgroup]]"))
        (is (str/includes? (:code compiled) "uint fold = min(sgsize, width);"))
        (is (str/includes? (:code compiled) "simd_shuffle_down"))
        (is (nil? (re-find #"\bfold = \d+u" (:code compiled)))
            "a baked fold width leaked into the MSL emission")
        ;; Metal refuses a kernel named main (Apple metal 32023.883): the
        ;; MSL arm's entry is the kernel's :kernel/name (the MSL-arm
        ;; amendment of ADR-0356).
        (is (str/includes? (:code compiled) "kernel void reduce_sum_f32"))
        (is (not (str/includes? (:code compiled) "kernel void main")))
        (is (= compiled (accelerator/verify-artifact! compiled)))))))

(deftest the-apple-row-is-narrowed-on-the-measured-device
  ;; ADR-0360's SECOND decision (2026-10-23, JUN-58): what the Apple row
  ;; selects given the measured cell. The cell REFUTED the row's basis on
  ;; one named device (Apple M1 Max: the variant slower than :baseline --
  ;; the MSL arm natively, ADR-0360's measurement amendment, the
  ;; contract-satisfying channel of question (1)'s decision; the GLSL arm
  ;; via wire-42/MoltenVK, PR #1347/#1348, as LABELED BOOTSTRAP
  ;; corroboration), and evidence about a named device acts on that device
  ;; only (the uB5G idiom of kotoba.compiler.accelerator-targets). So the
  ;; row is NARROWED: a descriptor naming the measured device answers
  ;; :baseline for the reduce shape on both Apple routes, with the
  ;; refutation in :basis; every other Apple device keeps the designed row
  ;; (UNMEASURED).
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
    (testing "the measured device answers :baseline on both Apple routes, at every W"
      (doseq [device [(assoc capable :vendor "Apple M1 Max")
                      (assoc capable :name "Apple M1 Max")
                      (assoc capable :device "Apple M1 Max")
                      ;; case-insensitive, per name part (uB5G idiom)
                      (assoc capable :name "apple M1 MAX")
                      ;; the INFO-derived descriptor shape
                      (assoc capable :vendor "Apple M1 Max"
                             :max-workgroup-x 1024 :unified-memory? true)]
              target [:vulkan :glsl-v1 :metal :msl-v1]
              operator [:sum :max :min]
              wg [32 64 128 256 512]]
        (let [k (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                    :reduce operator {:workgroup-size wg})
              answer (variants/select-variant :apple k target device)]
          (is (= :baseline (:variant answer))
              (str "device " (pr-str device) " W=" wg " " target " must answer :baseline"))
          ;; The flip (ADR-0360 question (1)'s decision) is per CELL: the
          ;; MSL route at the verdict-chosen widths only. Every other cell
          ;; of this narrowing keeps the lock -- MSL W = 32 is the low
          ;; band's DECIDED cell (measured, but no cross-regime verdict
          ;; chose the answer) and the GLSL arm is LABELED BOOTSTRAP at
          ;; every width (the per-cell record is pinned in
          ;; the-measured-cells-flip-the-honesty-lock).
          (is (= (and (contains? #{:metal :msl-v1} target)
                      (contains? #{64 128 256 512 1024} wg))
                 (:measured? answer))
              (str "device " (pr-str device) " W=" wg " " target " measured?"))
          (is (str/includes? (:basis answer) "APPLE ROW NARROWED"))
          (is (str/includes? (:basis answer) "m1 max"))
          (is (str/includes? (:basis answer) "ADR-0360"))
          ;; 2026-10-23 prose slices: the basis text cites the second-shape
          ;; records (n = 2^20, the padded tail gone) -- the demotion
          ;; basis is not a padded-tail artifact -- and names the flip
          ;; contract's WIDENING DECISION: both measured shapes are
          ;; contract cells now (shape 2's flip-set band, all 15 cells
          ;; slower), shapes beyond these two stay UNMEASURED.
          (is (str/includes? (:basis answer)
                             "docs/evidence/gpu-subgroup-reduce-m1max-shape2-20261023")
              "the narrowing note must cite the shape-2 evidence")
          (is (str/includes? (:basis answer) "The flip contract WIDENED")
              "the narrowing note must name the widening decision"))))
    (testing "every other Apple device keeps the designed row, UNMEASURED"
      (doseq [device [(assoc capable :vendor "Apple M3")
                      (assoc capable :name "Apple M2 Pro")
                      (assoc capable :device "iPad Pro (M4)")
                      ;; an UNNAMED descriptor: no name, no evidence
                      (assoc capable :vendor-id 4203)
                      capable]
              target [:vulkan :glsl-v1 :metal :msl-v1]]
        (let [answer (variants/select-variant :apple kir target device)]
          (is (= :subgroup-reduce (:variant answer))
              (str "device " (pr-str device) " must keep the designed row"))
          (is (false? (:measured? answer)))
          (is (not (str/includes? (:basis answer) "APPLE ROW NARROWED"))
              "an unrefuted answer carries no narrowing note"))))
    (testing "the narrowing is Apple's alone: a non-Apple vendor is untouched"
      (doseq [vendor [:intel :arm :nvidia :amd]]
        (is (= :subgroup-reduce
               (:variant (variants/select-variant
                          vendor kir :vulkan
                          (assoc capable :name "M1 Max")))))))
    (testing "a refuted device WITHOUT rule-6 facts is the ordinary fail-closed answer"
      ;; The narrowing note is the ROW's demotion only: when the gate
      ;; never held, :baseline is the fail-closed answer and its basis
      ;; says so -- it must not claim the row was narrowed.
      (doseq [device [{:vendor "Apple M1 Max"}
                      {:vendor "Apple M1 Max" :subgroup-size 32}
                      {:name "Apple M1 Max"
                       :subgroup-size 24 :subgroup-ops #{:basic :shuffle-relative}}]
              target [:vulkan :msl-v1]]
        (let [answer (variants/select-variant :apple kir target device)]
          (is (= :baseline (:variant answer)))
          (is (not (str/includes? (:basis answer) "APPLE ROW NARROWED"))))))
    (testing "same arguments in, same map out"
      (let [device (assoc capable :vendor "Apple M1 Max")]
        (is (= (variants/select-variant :apple kir :msl-v1 device)
               (variants/select-variant :apple kir :msl-v1 device)))))))

(deftest the-msl-ladder-selects-simdgroup-reduce-first
  ;; ADR-0373 rule 3 step 2 (2026-10-23, JUN-58): the selection predicate
  ;; lands as the MSL ladder (the ADR-0361 CUDA-ladder idiom). Outside the
  ;; carved-out measured class, an Apple MSL descriptor reporting the
  ;; fold's rule-6 fact (:simd-reduce) and a reported SIMD-group width
  ;; dividing W answers :simdgroup-reduce -- the vendor-native FIRST rung;
  ;; a descriptor reporting the shuffle fold's facts but not :simd-reduce
  ;; falls to :subgroup-reduce (the second rung, byte-for-byte the old
  ;; answer); everything else answers :baseline. The measured-cell
  ;; carve-out outranks rung 1 EVERYWHERE BUT THIS VARIANT'S OWN FLIP
  ;; CELLS (the flip slices, 2026-10-23/24): at W = 32, W = 64, W = 128,
  ;; W = 256,
  ;; W = 512 and
  ;; W = 1024 on the measured class
  ;; (name fragment "m1 max", reported subgroup size 32) the native-Metal
  ;; measurement of this variant ran there and measured it FASTER than
  ;; :baseline (apple-simdgroup-flip-note), so each cell answers
  ;; :simdgroup-reduce, MEASURED. Every other :simdgroup-reduce answer is
  ;; UNMEASURED (:measured? false).
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        both {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative :simd-reduce}}
        native {:subgroup-size 32 :subgroup-ops #{:simd-reduce}}
        shuffle-only {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
    (testing "rung 1: the fold's own fact answers first; :basic/:shuffle-relative are the shuffle fold's facts and are NOT required"
      (doseq [device [both native
                      ;; a fact set larger than the fold's needs still
                      ;; selects (the rung-2 idiom, one rule for the gate)
                      {:subgroup-size 32 :subgroup-ops #{:simd-reduce :arithmetic}}]
              target [:metal :msl-v1]]
        (let [answer (variants/select-variant :apple kir target device)]
          (is (= :simdgroup-reduce (:variant answer))
              (str "device " (pr-str device) " " target " must take rung 1"))
          (is (false? (:measured? answer)))
          (is (nil? (:measured-cell answer)))
          (is (string? (:basis answer)))
          (is (contains? variants/variant-bases :simdgroup-reduce)))))
    (testing "rung 1 covers the whole reduce row: every W of the shape, every operator"
      (doseq [wg [32 64 128 256 512 1024]
              operator [:sum :max :min]]
        (let [k (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                    :reduce operator {:workgroup-size wg})]
          (is (= :simdgroup-reduce (:variant (variants/select-variant :apple k :msl-v1 native))))
          (is (false? (:measured? (variants/select-variant :apple k :msl-v1 native)))))))
    (testing "rung 2 is byte-for-byte the old answer: the shuffle facts without :simd-reduce"
      (doseq [target [:metal :msl-v1]]
        (is (= :subgroup-reduce
               (:variant (variants/select-variant :apple kir target shuffle-only))))))
    (testing "the ladder is the MSL route's and Apple's alone"
      ;; rung 1 does not leak onto the Vulkan route: :simd-reduce alone is
      ;; no shuffle fold there and fails closed to :baseline; with the
      ;; shuffle facts present the second rung answers, unchanged.
      (doseq [target [:vulkan :glsl-v1]]
        (is (= :baseline (:variant (variants/select-variant :apple kir target native))))
        (is (= :subgroup-reduce (:variant (variants/select-variant :apple kir target both)))))
      ;; other vendors stay off the MSL ladder even carrying the fact
      ;; (row scope, one vendor per decision) -- byte-for-byte their old
      ;; :baseline answers.
      (doseq [vendor [:intel :arm :nvidia :amd] device [both native]]
        (is (= :baseline (:variant (variants/select-variant vendor kir :msl-v1 device))))))
    (testing "rung 1 fails closed like every row"
      (doseq [device [{:subgroup-size 24 :subgroup-ops #{:simd-reduce}}
                      {:subgroup-size 512 :subgroup-ops #{:simd-reduce}}
                      {:subgroup-size 32.5 :subgroup-ops #{:simd-reduce}}
                      {:subgroup-size 0 :subgroup-ops #{:simd-reduce}}
                      {:subgroup-size 32}
                      {:subgroup-ops #{:simd-reduce}}
                      {:subgroup-size 32 :subgroup-ops :all}]]
        (is (not= :simdgroup-reduce
                  (:variant (variants/select-variant :apple kir :msl-v1 device)))
            (str "device " (pr-str device) " must fail rung 1 closed")))
      (doseq [bad [(accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
                   (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 16})
                   (assoc kir :kernel/dtype :f64)
                   {} nil]]
        (is (not= :simdgroup-reduce
                  (:variant (variants/select-variant :apple bad :msl-v1 native)))
            (str "kernel " (pr-str bad) " must fail rung 1 closed"))))
    (testing "the measured-cell carve-out outranks rung 1 wherever the flip's keys do not hold"
      ;; After the W = 32 flip the six flip cells are every width the row
      ;; admits (a power of two in [32, 1024]), so the carve-out's live
      ;; cells on the class are the flip keys' own refusals: a "m1 max"
      ;; descriptor whose reported SIMD-group width is not the measured 32
      ;; (the keys are name AND width; an S = 8/16 report is not the
      ;; measured class's cell). Rung 1's gate still holds there (the
      ;; reported width divides W) and the carve-out outranks it.
      (doseq [device [(assoc native :device "Apple M1 Max"
                             :subgroup-size 8)
                      (assoc both :name "Apple M1 Max"
                             :subgroup-size 16)]
              target [:metal :msl-v1]
              wg [32 256]]
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size wg})
                      target device)]
          (is (= :baseline (:variant answer))
              (str "device " (pr-str device) " W=" wg " must keep the class's answer"))
          (is (str/includes? (:basis answer) "THE MEASURED-CELL CARVE-OUT"))
          (is (str/includes? (:basis answer) "CLOSED to design rows"))))
      (testing "W = 32, W = 64, W = 128, W = 256, W = 512 and W = 1024 are this variant's OWN flip cells: the carve-out lifts exactly there, MEASURED"
        ;; the flip slices (the W = 512, W = 1024, W = 128, W = 64 and
        ;; W = 32
        ;; cells flipped in
        ;; their own later slices): the native-Metal measurement of
        ;; THIS variant ran at W = 32, W = 64, W = 128, W = 256, W = 512
        ;; and W = 1024 on
        ;; the
        ;; measured class and measured
        ;; it FASTER than :baseline (apple-simdgroup-flip-note), so each
        ;; cell answers the row with the row's OWN record.
        (doseq [device [(assoc native :device "Apple M1 Max")
                        (assoc both :name "Apple M1 Max")]
                target [:metal :msl-v1]
                wg [32 64 128 256 512 1024]]
          (let [answer (variants/select-variant
                        :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                  {:workgroup-size wg})
                        target device)]
            (is (= :simdgroup-reduce (:variant answer))
                (str "device " (pr-str device) " " target " W=" wg " must answer the flip"))
            (is (true? (:measured? answer)))
            (is (= {:device "m1 max"
                    :subgroup-size 32
                    :channel :native-metal
                    :route :msl-v1
                    :workgroup-size wg
                    :operators #{:sum :max :min}
                    ;; the measured shapes per cell: the ground shape at
                    ;; every flipped W, and -- at W = 256, W = 1024,
                    ;; W = 128, W = 64 and W = 32 -- also shape 2 (n =
                    ;; 2^20, the shape-2 flips of those cells,
                    ;; 2026-10-24). Shape 2 at W = 512 is
                    ;; measured-but-REFUSED (rule 2 REGIME-SCOPED) for
                    ;; this variant and the record names the shapes so no
                    ;; claim extends past them.
                    :shapes ({256 [1000003 1048576]
                              512 [1000003]
                              1024 [1000003 1048576]
                              128 [1000003 1048576]
                              64 [1000003 1048576]
                              32 [1000003 1048576]}
                             wg)
                    ;; each flip cell's record names ITS OWN runs.
                    :evidence ({256 ["docs/evidence/gpu-simdgroup-reduce-m1max-20261023"
                                     "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w256"
                                     "docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w256"]
                                512 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w512"
                                     "docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w512"]
                                1024 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w1024"
                                      "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w1024"]
                                128 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w128"
                                     "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w128"]
                                64 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w64"
                                    "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w64"]
                                32 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w32"
                                    "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w32"]}
                               wg)}
                   (:measured-cell answer))
                (str "device " (pr-str device) " " target " W=" wg " record"))
            (is (str/includes? (:basis answer) "THIS VARIANT'S OWN FLIP CELLS"))
            (is (str/includes? (:basis answer) "REGIME-INVARIANT FASTER"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-20261023"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w256"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w1024"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w128"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w64"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w32"))
            (is (str/includes? (:basis answer) "0.639/0.656/0.659"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w1024"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w128"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w64"))
            (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w32")))))
      (testing "the carve-out note is the row's demotion only, and the flag scope is named"
        ;; simd-only facts where the flip's keys do not hold (the class
        ;; name, S = 8 -- not the measured reported width -- at W = 32):
        ;; the
        ;; shuffle row's gate never
        ;; held, so no narrowing note -- and the answer is the carve-out's
        ;; decision, not a measurement's.
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size 32})
                      :msl-v1 (assoc native :device "Apple M1 Max"
                                     :subgroup-size 8))]
          (is (false? (:measured? answer)))
          (is (nil? (:measured-cell answer)))
          (is (not (str/includes? (:basis answer) "APPLE ROW NARROWED"))))
        ;; both fact sets where the flip's keys do not hold (the class
        ;; name, S = 16, W = 32): the shuffle row's narrowing rides (the
        ;; name is the refutation's key) and the carve-out note rides
        ;; along -- its flag-scope clause ("marks the :subgroup-reduce
        ;; refutation ONLY") names history, not a live cell: since the
        ;; W = 64 flip no cell carries both the note and a :measured? true
        ;; flag.
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size 32})
                      :msl-v1 (assoc both :name "Apple M1 Max"
                                     :subgroup-size 16))]
          (is (false? (:measured? answer)))
          (is (nil? (:measured-cell answer)))
          (is (str/includes? (:basis answer) "APPLE ROW NARROWED"))
          (is (str/includes? (:basis answer) "marks the :subgroup-reduce refutation ONLY")))
        ;; shuffle facts ONLY at W = 32 (no :simd-reduce): rung 1 never
        ;; held, so the shuffle row's narrowing and its DECIDED cell ride
        ;; byte-for-byte unchanged -- W = 32 is decided for the SHUFFLE
        ;; fold, not verdict-chosen, so the answer keeps the lock
        ;; (:measured? false, no record).
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size 32})
                      :msl-v1 (assoc shuffle-only :name "Apple M1 Max"))]
          (is (false? (:measured? answer)))
          (is (nil? (:measured-cell answer)))
          (is (str/includes? (:basis answer) "APPLE ROW NARROWED"))
          (is (str/includes? (:basis answer) "W = 32, THE DECIDED CELL")))
        ;; the same descriptor WITH the fold's fact at W = 32 flips now
        ;; (the W = 32 flip slice, 2026-10-24): the class's last
        ;; :baseline cell of the W band is gone -- the cell answers the
        ;; row, MEASURED.
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size 32})
                      :msl-v1 (assoc both :name "Apple M1 Max"))]
          (is (= :simdgroup-reduce (:variant answer)))
          (is (true? (:measured? answer)))
          (is (str/includes? (:basis answer) "THIS VARIANT'S OWN FLIP CELLS")))))
    (testing "rule 3 end to end: the selected variant lowers, seals and verifies on :msl-v1"
      (let [selected (:variant (variants/select-variant :apple kir :msl-v1 native))
            compiled (accelerator/compile-kernel kir :msl-v1 selected)]
        (is (= :simdgroup-reduce selected))
        (is (= :simdgroup-reduce (:variant compiled)))
        (is (str/includes? (:code compiled) "v = simd_sum(v);"))
        (is (nil? (re-find #"simd_shuffle_down" (:code compiled))))
        (is (= compiled (accelerator/verify-artifact! compiled)))))
    (testing "same arguments in, same map out"
      (is (= (variants/select-variant :apple kir :msl-v1 native)
             (variants/select-variant :apple kir :msl-v1 native))))))

(deftest the-measured-cells-flip-the-honesty-lock
  ;; ADR-0360 question (1) DECIDED (2026-10-23, JUN-58) and its flip
  ;; implemented here: for the MSL arm a native Metal harness that
  ;; dispatches the emitters' own bytes under the sweep protocol SATISFIES
  ;; the measurement contract (wire-42 executes SPIR-V through Vulkan and
  ;; can never run MSL -- the route clause was a deadlock for this arm, not
  ;; an honesty lock), and the flip is keyed per ANSWER CELL: the tested
  ;; device class (name fragment "m1 max" AND reported subgroup size 32),
  ;; the channel's route (MSL), and the widths whose measurement CHOSE the
  ;; answer (64/128/256/512/1024 -- W = 32 ran under the same channel but
  ;; its answer is DECIDED, not verdict-chosen). Everything else keeps
  ;; :measured? false. The flag says a
  ;; measurement CHOSE this answer (the variant measured SLOWER there) --
  ;; never that :baseline is optimal.
  (let [capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
        m1 (assoc capable :name "Apple M1 Max")]
    (testing "the flipped cells carry the tested-device-class record"
      (doseq [target [:metal :msl-v1]
              wg [64 128 256 512 1024]
              operator [:sum :max :min]]
        (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                      :reduce operator {:workgroup-size wg})
              answer (variants/select-variant :apple kir target m1)]
          (is (= :baseline (:variant answer)))
          (is (true? (:measured? answer))
              (str "W=" wg " " target " " operator " must be flipped"))
          (is (= {:device "m1 max"
                  :subgroup-size 32
                  :channel :native-metal
                  :route :msl-v1
                  :workgroup-size wg
                  :operators #{:sum :max :min}
                  ;; the widening decision (2026-10-23): the record names
                  ;; BOTH measured shapes -- n = 1,000,003 and n = 2^20 --
                  ;; and no claim extends past these two.
                  :shapes [1000003 1048576]
                  :evidence ["docs/evidence/gpu-subgroup-reduce-m1max-20261023"
                             "docs/evidence/gpu-subgroup-reduce-m1max-wsweep-20261023"
                             "docs/evidence/gpu-subgroup-reduce-m1max-wsweep-low-20261023"
                             "docs/evidence/gpu-subgroup-reduce-m1max-shape2-20261023"
                             "docs/evidence/gpu-subgroup-reduce-m1max-shape2-band-20261023"]}
                 (:measured-cell answer))
              (str "W=" wg " " target " " operator " record")))))
    (testing "the W = 32 cell keeps the lock by decision (the low band's one mixed cell)"
      ;; The low-band measurement (2026-10-23) measured W = 32 and the
      ;; variant is not slower there -- :sum 0.918 in every fresh process
      ;; -- but every run sat in the slow clock regime (per-run median
      ;; gpu-ns 109k -> 36k mid-session). The later shape-2 and op-order
      ;; cells measured the scoping itself (2026-10-23): the sign follows
      ;; the clock level for all three operators -- op-order within-pair
      ;; medians slow vs fast: :sum 0.919 vs 1.018, :max 0.917 vs 1.029,
      ;; :min 0.920 vs 1.018. A regime-scoped sign is not a selection
      ;; basis, so the answer stays :baseline for ALL THREE OPERATORS (no
      ;; operator split), it is a DECISION on measured ground (the basis
      ;; says so), and it keeps the lock: no regime-robust verdict chose
      ;; it.
      (doseq [operator [:sum :max :min]]
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                                :reduce operator
                                                {:workgroup-size 32})
                      :msl-v1 m1)]
          (is (= :baseline (:variant answer))
              (str "W=32 " operator " must stay :baseline (no operator split)"))
          (is (false? (:measured? answer))
              (str "W=32 " operator " must keep the lock"))
          (is (nil? (:measured-cell answer))
              (str "W=32 " operator " carries no measured-cell record"))
          (is (str/includes? (:basis answer) "W = 32, THE DECIDED CELL"))
          (is (str/includes? (:basis answer) "DECISION on measured ground"))
          (is (str/includes? (:basis answer) "slow clock regime"))
          ;; 2026-10-23 prose slice: the decision note's basis names the
          ;; measured :sum fast-regime samples (the op-order cell) and the
          ;; second-shape corroboration explicitly.
          (is (str/includes? (:basis answer)
                             "docs/evidence/gpu-subgroup-reduce-m1max-shape2-20261023")
              (str "W=32 " operator " basis must cite the shape-2 cell"))
          (is (str/includes? (:basis answer)
                             "docs/evidence/gpu-subgroup-reduce-m1max-oporder-20261023")
              (str "W=32 " operator " basis must cite the op-order cell")))))
    (testing "the GLSL arm keeps the lock at every width: LABELED BOOTSTRAP is not a verdict"
      ;; PR #1347/#1348 measured the same sign, but their own record
      ;; (docs/evidence/gpu/loadsweep-20261019/README.md) labels the runs
      ;; LABELED BOOTSTRAP -- an unbalanced replay order biases the ratio
      ;; beyond drift -- and publishes no verdict. Nothing flips off them.
      (doseq [target [:vulkan :glsl-v1]
              wg [32 64 128 256 512 1024]]
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size wg})
                      target m1)]
          (is (= :baseline (:variant answer)))
          (is (false? (:measured? answer))
              (str "W=" wg " " target " must keep the lock"))
          (is (nil? (:measured-cell answer))))))
    (testing "the tested device class is the name AND the reported subgroup size"
      ;; The name matches but the reported subgroup size is not the tested
      ;; one: the narrowing still acts (the name is the refutation's key)
      ;; but the flip does not (32 is what the harness measured).
      (doseq [s [8 16]]
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size 256})
                      :msl-v1 (assoc capable :name "Apple M1 Max"
                                     :subgroup-size s))]
          (is (= :baseline (:variant answer)))
          (is (str/includes? (:basis answer) "APPLE ROW NARROWED"))
          (is (false? (:measured? answer)))
          (is (nil? (:measured-cell answer))))))
    (testing "an unnamed descriptor is never the tested device class"
      (let [answer (variants/select-variant
                    :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                              {:workgroup-size 256})
                    :msl-v1 capable)]
        (is (= :subgroup-reduce (:variant answer)))
        (is (false? (:measured? answer)))
        (is (nil? (:measured-cell answer)))))
    (testing "other vendors keep the lock at the same cells (the flip is Apple's alone)"
      (doseq [vendor [:intel :arm :nvidia :amd]]
        (let [answer (variants/select-variant
                      vendor (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size 256})
                      :vulkan (assoc capable :name "Apple M1 Max"))]
          (is (= :subgroup-reduce (:variant answer)))
          (is (false? (:measured? answer)))
          (is (nil? (:measured-cell answer))))))
    (testing "the warp row keeps the lock too (NVIDIA has no hardware here)"
      (let [answer (variants/select-variant
                    :nvidia (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size 256})
                    :cuda {:compute-capability 7.0})]
        (is (= :warp-shuffle-reduce (:variant answer)))
        (is (false? (:measured? answer)))
        (is (nil? (:measured-cell answer)))))
    (testing "same arguments in, same map out (the record included)"
      (let [kir (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 512})]
        (is (= (variants/select-variant :apple kir :msl-v1 m1)
               (variants/select-variant :apple kir :msl-v1 m1)))))))

(deftest the-simdgroup-rows-own-flip-cell-flips-the-honesty-lock
  ;; JUN-58, the flip slices (2026-10-23/24; the W = 512, W = 1024,
  ;; W = 128, W = 64 and W = 32
  ;; cells flipped in their own later slices): ADR-0373's rule-3 step 3,
  ;; the flip contract applied
  ;; to :simdgroup-reduce's OWN measured cells. The measurements that ran
  ;; (docs/evidence/gpu-simdgroup-reduce-m1max-20261023,
  ;; docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w512,
  ;; .../w1024, .../w128, .../w64 and .../w32)
  ;; compared :baseline vs THIS variant at SIX cells -- W = 256 (the
  ;; honesty-lock flip anchor) and W = 512, W = 1024, W = 128, W = 64 and
  ;; W = 32 (the
  ;; W-sweep
  ;; series' second through sixth
  ;; cells), all n = 1000003 (the flip contract's ground
  ;; shape) -- on the tested device class (name fragment "m1 max",
  ;; reported subgroup size 32) through the conforming native-Metal
  ;; channel, and measured this variant FASTER (paired median ratios
  ;; 0.790/0.800/0.799 at W = 256, 0.815/0.823/0.824 at W = 512,
  ;; 0.840/0.847/0.850 at W = 1024, 0.775/0.789/0.789 at W = 128,
  ;; 0.719/0.728/0.729 at W = 64 and 0.657/0.658/0.650 at W = 32 for
  ;; :sum/:max/:min, claim-protocol rule 2
  ;; REGIME-INVARIANT FASTER, 18/18 per-run ratios below 1.0 at each
  ;; cell). So the
  ;; flip keys hold exactly there and the cells answer :simdgroup-reduce,
  ;; MEASURED -- the only answers of this variant that carry :measured?
  ;; true. The six are every width the row admits (a power of two in
  ;; [32, 1024]), so the class's W band is flipped end to end and NO
  ;; admitted W keeps the carve-out at the measured reported width. At
  ;; W = 32 the contrast with :subgroup-reduce reaches its WEAKER form
  ;; (that cell measures MIXED for the shuffle ladder -- its min
  ;; operator's per-run ratios straddle 1.0 -- and only THIS fold is
  ;; one-sided there); the W = 32 flip rests on this fold's own 18/18.
  ;; SHAPE-2 FLIP (2026-10-24): the shape-2 series' anchor re-ran
  ;; W = 256 at n = 2^20 and measured this variant faster again
  ;; (0.794/0.811/0.812, rule 2 REGIME-INVARIANT FASTER, 18/18), the
  ;; series' third cell re-ran W = 1024 at n = 2^20 and measured it
  ;; faster again (0.836/0.843/0.841, rule 2 REGIME-INVARIANT FASTER,
  ;; 18/18), the series' fourth cell re-ran W = 128 at n = 2^20 and
  ;; measured it faster again (0.769/0.780/0.780, rule 2
  ;; REGIME-INVARIANT FASTER, 18/18, cross-operator level identity
  ;; HOLDS -- the series' first identity-HOLDS cell) and the series'
  ;; fifth cell re-ran W = 64 at n = 2^20 and measured it faster again
  ;; (0.721/0.732/0.729, rule 2 REGIME-INVARIANT FASTER, 18/18,
  ;; identity HOLDS -- the series' second identity-HOLDS cell) and the
  ;; series' sixth and last cell re-ran W = 32 at n = 2^20 and measured
  ;; it faster again (0.639/0.656/0.659, rule 2 REGIME-INVARIANT
  ;; FASTER, 18/18, identity REFUTED 8/15 -- min splits what max and
  ;; sum pool), so the W = 256, W = 1024, W = 128, W = 64 and W = 32
  ;; records name BOTH measured shapes (the shape-2 series complete).
  ;; WHAT THE FLIP DOES NOT LICENSE: shape 2 (n = 2^20) at W = 512 is
  ;; measured-but-REFUSED (its record's :shapes names the ONE measured
  ;; shape); the GLSL arm, every
  ;; other Apple device, every other vendor and cross-day replication
  ;; beyond its TWO measured cells (the W = 256 anchor and the W = 512
  ;; cell, both later-day runs on 2026-10-24) stay UNMEASURED.
  (let [native {:subgroup-size 32 :subgroup-ops #{:simd-reduce}}
        both {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative :simd-reduce}}
        m1 (assoc native :device "Apple M1 Max")]
    (testing "the flip cells answer the row, MEASURED, with the row's OWN record"
      (doseq [target [:metal :msl-v1]
              operator [:sum :max :min]
              device [m1 (assoc both :name "Apple M1 Max")]
              wg [32 64 128 256 512 1024]]
        (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                      :reduce operator {:workgroup-size wg})
              answer (variants/select-variant :apple kir target device)]
          (is (= :simdgroup-reduce (:variant answer))
              (str operator " " target " W=" wg " must answer the flip"))
          (is (true? (:measured? answer))
              (str operator " " target " W=" wg " must carry the flipped flag"))
          (is (= {:device "m1 max"
                  :subgroup-size 32
                  :channel :native-metal
                  :route :msl-v1
                  :workgroup-size wg
                  :operators #{:sum :max :min}
                  ;; the measured shapes per cell: the ground shape at
                  ;; every flipped W, and -- at W = 256, W = 1024,
                  ;; W = 128, W = 64 and W = 32 -- also shape 2 (the
                  ;; shape-2 flips of those cells).
                  :shapes ({256 [1000003 1048576]
                            512 [1000003]
                            1024 [1000003 1048576]
                            128 [1000003 1048576]
                            64 [1000003 1048576]
                            32 [1000003 1048576]}
                           wg)
                  ;; each flip cell's record names ITS OWN runs (the
                  ;; W = 512 cell's evidence is the
                  ;; W-sweep second cell; W = 1024, W = 128,
                  ;; W = 64 and W = 32 name their W-sweep cell AND their
                  ;; shape-2 record).
                  :evidence ({256 ["docs/evidence/gpu-simdgroup-reduce-m1max-20261023"
                                   "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w256"
                                   "docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w256"]
                              512 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w512"
                                   "docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w512"]
                              1024 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w1024"
                                    "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w1024"]
                              128 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w128"
                                   "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w128"]
                              64 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w64"
                                  "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w64"]
                              32 ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w32"
                                  "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w32"]}
                             wg)}
                 (:measured-cell answer))
              (str operator " " target " W=" wg " record"))
          (is (str/includes? (:basis answer) "THIS VARIANT'S OWN FLIP CELLS"))
          (is (str/includes? (:basis answer) "0.790/0.800/0.799"))
          (is (str/includes? (:basis answer) "0.815/0.823/0.824"))
          (is (str/includes? (:basis answer) "0.840/0.847/0.850"))
          (is (str/includes? (:basis answer) "0.775/0.789/0.789"))
          (is (str/includes? (:basis answer) "0.719/0.728/0.729"))
          (is (str/includes? (:basis answer) "0.657/0.658/0.650"))
          (is (str/includes? (:basis answer) "0.836/0.843/0.841"))
          (is (str/includes? (:basis answer) "0.769/0.780/0.780"))
          (is (str/includes? (:basis answer) "0.721/0.732/0.729"))
          (is (str/includes? (:basis answer) "0.639/0.656/0.659"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-20261023"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w1024"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w128"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w64"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w32"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w512"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w512"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w1024"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w128"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w64"))
          (is (str/includes? (:basis answer) "docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w32")))))
    (testing "the record's :shapes names each cell's OWN measured shapes"
      ;; W = 256, W = 1024, W = 128, W = 64 and W = 32 name BOTH
      ;; measured shapes (shape 2 flipped at those cells, 2026-10-24);
      ;; the one refused width names the ground shape ONLY -- shape 2 is
      ;; measured-but-REFUSED at W = 512, and no claim extends past the
      ;; named shapes.
      (doseq [wg [256 1024 128 64 32]]
        (is (= [1000003 1048576]
               (:shapes (:measured-cell (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size wg}) :msl-v1 m1))))
            (str "W=" wg " names BOTH measured shapes")))
      (is (= [1000003] (:shapes (:measured-cell (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 512}) :msl-v1 m1))))
          "W=512 names the ONE measured shape -- no second shape is licensed there"))
    (testing "the anchor and W = 512 cells name their cross-day replication records; no other cell does"
      ;; The record's later-day replications (2026-10-24,
      ;; docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w256
      ;; and .../w512) re-ran TWO cells -- the honesty-lock flip anchor
      ;; (W = 256) and the W = 512 cell (the first non-anchor cross-day
      ;; row) -- and corroborate their verdicts. They flipped nothing
      ;; (both cells were already flipped 2026-10-23), and every
      ;; remaining cell's cross-day replication stays UNMEASURED (each
      ;; runnable on a day later than its own 2026-10-24 session).
      (is (= ["docs/evidence/gpu-simdgroup-reduce-m1max-20261023"
              "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w256"
              "docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w256"]
             (:evidence (:measured-cell (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256}) :msl-v1 m1))))
          "W=256 names the cross-day replication record third")
      (is (= ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w512"
              "docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w512"]
             (:evidence (:measured-cell (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 512}) :msl-v1 m1))))
          "W=512 names its cross-day replication record second")
      (doseq [wg [32 64 128 1024]]
        (is (not (some #(str/includes? % "crossday")
                       (:evidence (:measured-cell (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size wg}) :msl-v1 m1)))))
            (str "W=" wg " names no cross-day record -- its replication stays UNMEASURED")))
      (is (str/includes? (:basis (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256}) :msl-v1 m1))
                         "CROSS-DAY REPLICATION OF THE ANCHOR CELL")
          "the flip note carries the anchor cross-day paragraph")
      (is (str/includes? (:basis (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256}) :msl-v1 m1))
                         "CROSS-DAY REPLICATION OF THE W = 512 CELL")
          "the flip note carries the W = 512 cross-day paragraph")
      (is (str/includes? (:basis (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256}) :msl-v1 m1))
                         "first non-anchor cross-day row")
          "the W = 512 paragraph names what the row is")
      (is (str/includes? (:basis (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256}) :msl-v1 m1))
                         "every OTHER cell stayed UNMEASURED at that slice")
          "the anchor paragraph's claim is scoped to its own slice")
      (is (str/includes? (:basis (variants/select-variant :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256}) :msl-v1 m1))
                         "cross-day replication of every remaining")
          "the cross-day claim stays scoped to its TWO measured cells"))
    (testing "the flip is SIX cells wide: every width the row admits answers the row on the class"
      ;; the class's last :baseline cell (W = 32) flipped with this
      ;; slice: no admitted width (power of two in [32, 1024]) keeps the
      ;; carve-out at the measured reported width. The carve-out's
      ;; remaining live cells are the flip keys' own refusals (a
      ;; mismatched reported SIMD-group width) -- pinned in the next
      ;; block.
      (doseq [wg [32 64 128 256 512 1024]]
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size wg})
                      :msl-v1 m1)]
          (is (= :simdgroup-reduce (:variant answer))
              (str "W=" wg " must answer the flip"))
          (is (true? (:measured? answer))
              (str "W=" wg " must carry the flipped flag"))
          (is (some? (:measured-cell answer))
              (str "W=" wg " carries its record")))))
    (testing "the flip keys are the tested device class AND the reported subgroup size"
      ;; name matches but the reported subgroup size is not the tested
      ;; one: no flip (32 is what the harness measured) -- the class
      ;; keeps :baseline and the lock.
      (doseq [s [8 16]]
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size 256})
                      :msl-v1 (assoc native :name "Apple M1 Max"
                                     :subgroup-size s))]
          (is (= :baseline (:variant answer)))
          (is (false? (:measured? answer)))
          (is (nil? (:measured-cell answer))))))
    (testing "without the fold's rule-6 fact the shuffle row's answer is byte-for-byte unchanged"
      ;; no :simd-reduce fact: rung 1 never held; at W = 256 the narrowed
      ;; class keeps :baseline and the :subgroup-reduce record (its
      ;; :evidence names the :subgroup-reduce runs only).
      (let [answer (variants/select-variant
                    :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                              {:workgroup-size 256})
                    :msl-v1 (assoc both :name "Apple M1 Max"
                                   :subgroup-ops #{:basic :shuffle-relative}))]
        (is (= :baseline (:variant answer)))
        (is (true? (:measured? answer)))
        (is (= "docs/evidence/gpu-subgroup-reduce-m1max-shape2-band-20261023"
               (last (:evidence (:measured-cell answer)))))))
    (testing "an unnamed descriptor is never the tested class: rung 1 answers, UNMEASURED"
      (let [answer (variants/select-variant
                    :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                              {:workgroup-size 256})
                    :msl-v1 native)]
        (is (= :simdgroup-reduce (:variant answer)))
        (is (false? (:measured? answer)))
        (is (nil? (:measured-cell answer)))))
    (testing "the GLSL arm never flips: its runs are LABELED BOOTSTRAP, not a verdict"
      (doseq [target [:vulkan :glsl-v1]]
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size 256})
                      target m1)]
          (is (= :baseline (:variant answer)))
          (is (false? (:measured? answer)))
          (is (nil? (:measured-cell answer))))))
    (testing "same arguments in, same map out (the flip record included)"
      (is (= (variants/select-variant :apple (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 256}) :msl-v1 m1)
             (variants/select-variant :apple (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 256}) :msl-v1 m1))))))

(deftest the-shape2-w512-scoped-cell-is-refused-as-a-selection-basis
  ;; The shape-2 series' second cell (W = 512, n = 2^20,
  ;; docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w512) ran
  ;; the byte-identical protocol and measured pooled medians
  ;; 0.812/0.821/0.822 for :sum/:max/:min -- but claim-protocol rule 2
  ;; classifies the CELL REGIME-SCOPED (:sum and :max are regime-invariant
  ;; faster, 6/6 each, but :min straddles 1.0 INSIDE one regime -- run 3
  ;; at 1.054, run 5 at 0.821; 1 of 18 pooled per-run ratios above 1.0).
  ;; Rule 2's second sentence denies a regime-scoped sign any selection
  ;; role whatever its shape, so THE CONTRACT'S ANSWER FOR A
  ;; MEASURED-BUT-SCOPED CELL is the flip's REFUSAL: the cell is measured
  ;; (its runs are recorded in docs/evidence) but it extends NO
  ;; :measured-cell record and moves NO :measured? flag. The W = 512
  ;; record stays :shapes [1000003] with the W-sweep w512 runs as its
  ;; evidence, and the W = 512 answer stands on the shape-1 cell's
  ;; REGIME-INVARIANT basis. The contrast is the W = 256 cell's shape-2
  ;; record (rule 2 REGIME-INVARIANT FASTER at that shape): a shape
  ;; enters a flip cell's record only on the cell's own rule-2 verdict
  ;; at that shape.
  (let [m1 {:subgroup-size 32
            :subgroup-ops #{:simd-reduce}
            :device "Apple M1 Max"}]
    (testing "the W = 512 record extends nothing: :shapes and :evidence name the shape-1 basis only"
      (let [answer (variants/select-variant
                    :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                              {:workgroup-size 512})
                    :msl-v1 m1)]
        (is (= :simdgroup-reduce (:variant answer))
            "the refusal removes nothing: the shape-1 flip still answers")
        (is (true? (:measured? answer))
            "the refusal moves no flag: W = 512 stands on the shape-1 cell")
        (is (= [1000003] (:shapes (:measured-cell answer)))
            "the scoped shape-2 cell must not extend :shapes")
        (is (= ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w512"
                "docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w512"]
               (:evidence (:measured-cell answer)))
            "the record names its shape-1 basis runs -- the W-sweep cell and its cross-day replication")
        (is (not (str/includes? (str/join (:evidence (:measured-cell answer)))
                                "shape2-20261024/w512"))
            "the record must not name the refused shape-2 runs")
        (is (str/includes? (:basis answer) "MEASURED BUT REFUSED AS A SELECTION BASIS")
            "the refusal is named in the answer's basis")))
    (testing "the W = 256, W = 1024, W = 128, W = 64 and W = 32 cells are the contrast: their shape-2 verdicts were regime-invariant and extended the records"
      (let [answer (variants/select-variant
                    :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                              {:workgroup-size 256})
                    :msl-v1 m1)]
        (is (= [1000003 1048576] (:shapes (:measured-cell answer))))
        (is (= ["docs/evidence/gpu-simdgroup-reduce-m1max-20261023"
                "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w256"
                "docs/evidence/gpu-simdgroup-reduce-m1max-crossday-20261024/w256"]
               (:evidence (:measured-cell answer)))))
      (let [answer (variants/select-variant
                    :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                              {:workgroup-size 1024})
                    :msl-v1 m1)]
        (is (= [1000003 1048576] (:shapes (:measured-cell answer))))
        (is (= ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w1024"
                "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w1024"]
               (:evidence (:measured-cell answer)))))
      (let [answer (variants/select-variant
                    :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                              {:workgroup-size 128})
                    :msl-v1 m1)]
        (is (= [1000003 1048576] (:shapes (:measured-cell answer))))
        (is (= ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w128"
                "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w128"]
               (:evidence (:measured-cell answer)))))
      (let [answer (variants/select-variant
                    :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                              {:workgroup-size 64})
                    :msl-v1 m1)]
        (is (= [1000003 1048576] (:shapes (:measured-cell answer))))
        (is (= ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w64"
                "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w64"]
               (:evidence (:measured-cell answer)))))
      (let [answer (variants/select-variant
                    :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                              {:workgroup-size 32})
                    :msl-v1 m1)]
        (is (= [1000003 1048576] (:shapes (:measured-cell answer))))
        (is (= ["docs/evidence/gpu-simdgroup-reduce-m1max-wsweep-20261023/w32"
                "docs/evidence/gpu-simdgroup-reduce-m1max-shape2-20261024/w32"]
               (:evidence (:measured-cell answer))))))
    (testing "every flip cell's basis names the contract's scoped-cell answer"
      (doseq [wg [32 64 128 256 512 1024]]
        (let [answer (variants/select-variant
                      :apple (accelerator/kernel "reduce_sum_f32" :reduce :sum
                                                {:workgroup-size wg})
                      :msl-v1 m1)]
          (is (str/includes? (:basis answer) "MEASURED BUT REFUSED AS A SELECTION BASIS")
              (str "W=" wg " basis names the refusal")))))))

(deftest the-measure-harness-argv-gates-carry-no-exact-match-class
  ;; The measurement instrument (scripts/gpu-subgroup-reduce-metal-measure.m)
  ;; carried TWO positional gates of the exact-match class (`if (argc == N)`).
  ;; The first (argc == 4, the shape) went dead the moment the op-order
  ;; variable made the driver pass five arguments: every driver run silently
  ;; measured the default shape until a run-log header exposed it (the
  ;; 2026-10-23 misshape defect, preserved under misshape-defect-20261023/
  ;; inside docs/evidence/gpu-subgroup-reduce-m1max-shape2-band-20261023/).
  ;; The second (argc == 5, the op-order) was the residual: harmless with
  ;; today's single caller, dead the same way the moment a later positional
  ;; lands behind it. This pin removes the CLASS from the harness -- every
  ;; positional gate is a >= test -- and fails if an exact-match gate ever
  ;; returns. Comment text is not code: the match is the `if (argc ==` gate
  ;; form (the harness comments deliberately spell `NOT argc == N`). The
  ;; gate list grows with the positionals: [variant-prefix] (argv[5], the
  ;; ADR-0373 :simdgroup-reduce measurement's arm label) landed behind
  ;; op-order and carries the same >= gate class (rule 3 step 3).
  (let [harness (slurp "scripts/gpu-subgroup-reduce-metal-measure.m")]
    (is (nil? (re-find #"if\s*\(\s*argc\s*==" harness))
        "the measure harness must carry no exact-match argc gate (the misshape class)")
    (doseq [gate ["if (argc >= 3)" "if (argc >= 4)" "if (argc >= 5)" "if (argc >= 6)"]]
      (is (str/includes? harness gate)
          (str "the measure harness must keep its positional gate " gate)))))

(deftest the-nvidia-row-rides-the-vulkan-and-cuda-routes
  ;; ADR-0361 (JUN-57) as amended 2026-10-23 (JUN-57's own decision): the
  ;; NVIDIA row is the shared subgroup-size-parametric emission on the
  ;; Vulkan route (the warp's 32 is queried at runtime like every other
  ;; width, never baked), carrying the CUDA row's sm_70+ floor fail-closed
  ;; on a REPORTED compute capability -- and, since the same-day
  ;; amendment, on the CUDA route as the SECOND rung of that route's
  ;; ladder: :warp-shuffle-reduce (the CUDA-native row) is checked first
  ;; and keeps precedence whenever its gate holds; the parametric fold
  ;; answers only where the warp row's gate does not reach -- a descriptor
  ;; reporting the rule-6 subgroup facts and NO compute capability. The
  ;; two rungs spell the same fold (runtime warpSize vs the baked 32), so
  ;; the ladder changes no reduction semantics. The MSL and WGSL routes do
  ;; not carry NVIDIA. Everything is UNMEASURED (:measured? false).
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
        answer (variants/select-variant :nvidia kir :vulkan capable)]
    (is (= :subgroup-reduce (:variant answer)))
    (is (false? (:measured? answer)))
    (is (str/includes? (:basis answer) "ADR-0361"))
    (testing "a reported capability at or above the floor still selects"
      (doseq [target [:vulkan :glsl-v1]]
        (is (= :subgroup-reduce
               (:variant (variants/select-variant
                          :nvidia kir target
                          (assoc capable :compute-capability 7.0)))))))
    (testing "the CUDA route's ladder: rung 1 keeps precedence, rung 2 is the amendment"
      ;; rung 1, unchanged: a CONFIRMED capability answers the warp row.
      (doseq [target [:cuda :cuda-v1]]
        (is (= :warp-shuffle-reduce
               (:variant (variants/select-variant
                          :nvidia kir target
                          {:compute-capability 7.0})))))
      ;; rung 1 keeps precedence where BOTH gates hold on the same kernel.
      (doseq [target [:cuda :cuda-v1]]
        (is (= :warp-shuffle-reduce
               (:variant (variants/select-variant
                          :nvidia kir target
                          (assoc capable :compute-capability 7.0))))))
      ;; rung 2, the extension: rule-6 facts reported, NO compute
      ;; capability -- the parametric fold, not :baseline.
      (doseq [target [:cuda :cuda-v1]]
        (let [second-rung (variants/select-variant :nvidia kir target capable)]
          (is (= :subgroup-reduce (:variant second-rung)))
          (is (false? (:measured? second-rung)))
          (is (str/includes? (:basis second-rung) "ADR-0361")))))
    (testing "the same rule-6 gate fails closed on the CUDA route"
      (doseq [device [nil
                      {}
                      {:subgroup-size 32}
                      {:subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 32 :subgroup-ops #{:basic}}
                      {:subgroup-size 32 :subgroup-ops #{:shuffle-relative}}
                      {:subgroup-size 24 :subgroup-ops #{:basic :shuffle-relative}}
                      ;; a REPORTED capability binds the sm_70+ floor on
                      ;; both rungs: below the floor or malformed fails
                      ;; closed to :baseline.
                      (assoc capable :compute-capability 6.0)
                      (assoc capable :compute-capability "7.0")]
              target [:cuda :cuda-v1]]
        (is (= :baseline (:variant (variants/select-variant :nvidia kir target device)))
            (str "device " (pr-str device) " must fail closed on the CUDA route"))))
    (doseq [target [:msl-v1 :metal :webgpu :wgsl-v1]]
      (is (= :baseline (:variant (variants/select-variant :nvidia kir target capable)))))
    (testing "rule 3 end to end: the second rung lowers, seals and verifies on :cuda-v1"
      (let [selected (:variant (variants/select-variant :nvidia kir :cuda-v1 capable))
            compiled (accelerator/compile-kernel kir :cuda-v1 selected)]
        (is (= :subgroup-reduce selected))
        (is (= :subgroup-reduce (:variant compiled)))
        (is (str/includes? (:code compiled) "unsigned int sgsize = warpSize;"))
        (is (str/includes? (:code compiled) "__activemask()"))
        (is (str/includes? (:code compiled) "__shfl_down_sync(mask, v, d, fold)"))
        (is (nil? (re-find #"\bd = \d+u" (:code compiled)))
            "a baked fold width leaked into the CUDA emission")
        (is (str/includes? (:code compiled) "extern \"C\" __global__ void reduce_sum_f32("))
        (is (= compiled (accelerator/verify-artifact! compiled)))))))

(deftest the-wgsl-route-carries-the-intel-and-arm-rows
  ;; ADR-0363 (JUN-59, JUN-60): the WGSL route -- :webgpu (api) and
  ;; :wgsl-v1 (emitter target), one route under two names exactly like
  ;; :vulkan/:glsl-v1 (ADR-0359 decision 3) -- selects :subgroup-reduce for
  ;; Intel and ARM under the same rules 3 + 6 gate the Vulkan route uses.
  ;; The NVIDIA row stays Vulkan-route-only (its ADR's scope; the Apple row
  ;; now rides the MSL route too -- the ADR-0360 amendment, tested in
  ;; the-apple-row-rides-the-vulkan-and-msl-routes -- and stays off the
  ;; WGSL route). ADR-0364 (2026-10-23) adds the AMD row to this route
  ;; too; that row is pinned in the-amd-row-rides-the-vulkan-and-wgsl-routes.
  ;; Everything here is
  ;; UNCOMPILED (no WGSL validator on this host) and UNMEASURED -- no
  ;; WebGPU execution path exists and :measured? is false on every answer.
  (doseq [vendor [:intel :arm]
          wg [32 64 128 256 512 1024]
          operator [:sum :max :min]
          target [:webgpu :wgsl-v1]
          s [8 16 32]]
    (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                  :reduce operator {:workgroup-size wg})
          device {:subgroup-size s :subgroup-ops #{:basic :shuffle-relative}}
          answer (variants/select-variant vendor kir target device)]
      (is (= :subgroup-reduce (:variant answer)))
      (is (false? (:measured? answer)))
      (is (string? (:basis answer)))))
  (testing "the same rule-6 gate fails closed on this route too"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          ewise (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
          malformed (assoc kir :kernel/dtype :f64)
          capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
      (doseq [device [nil
                      {}
                      {:subgroup-size 32 :subgroup-ops #{:basic}}
                      {:subgroup-size 32 :subgroup-ops #{:shuffle-relative}}
                      {:subgroup-size 24 :subgroup-ops #{:basic :shuffle-relative}}]
              target [:webgpu :wgsl-v1]]
        (doseq [vendor [:intel :arm]]
          (is (= :baseline (:variant (variants/select-variant vendor kir target device)))
              (str "device " (pr-str device) " must fail closed on the WGSL route"))))
      (doseq [target [:webgpu :wgsl-v1]]
        (is (= :baseline (:variant (variants/select-variant :intel ewise target capable))))
        (is (= :baseline (:variant (variants/select-variant :arm malformed target capable)))))))
  (testing "the MSL route answers :baseline for every vendor but Apple (row scope, not rule 3: the MSL emitter has admitted :subgroup-reduce since 2026-10-23, and the ADR-0360 amendment put Apple's row on this route)"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
      (doseq [vendor [:intel :arm :nvidia :amd] target [:msl-v1 :metal]]
        (is (= :baseline (:variant (variants/select-variant vendor kir target capable)))))))
  (testing "rule 3 end to end: the selected variant lowers, seals and verifies on :wgsl-v1"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 128})
          device {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
          selected (:variant (variants/select-variant :arm kir :wgsl-v1 device))
          compiled (accelerator/compile-kernel kir :wgsl-v1 selected)]
      (is (= :subgroup-reduce selected))
      (is (= :subgroup-reduce (:variant compiled)))
      (is (str/includes? (:code compiled) "enable subgroups;"))
      (is (not (str/includes? (:code compiled) "enable subgroup_id;"))
          "subgroup_id is a LANGUAGE extension; enable-ing it is a shader-creation error (WGSL spec pin, 2026-10-23)")
      (is (str/includes? (:code compiled) "for(var d:u32=fold/2u;"))
      (is (nil? (re-find #"d:u32=\d+u" (:code compiled)))
          "a baked fold width leaked into the WGSL emission")
      (is (= compiled (accelerator/verify-artifact! compiled)))))
  (testing "same arguments in, same map out"
    (let [kir (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 128})
          device {:subgroup-size 16 :subgroup-ops #{:basic :shuffle-relative}}]
      (is (= (variants/select-variant :intel kir :wgsl-v1 device)
             (variants/select-variant :intel kir :wgsl-v1 device))))))

(deftest rule-6-reads-the-facts-the-subgroup-answer-parses
  ;; ADR-0362 decision 4, end to end at the seam it names: the consumer
  ;; parser's answer is exactly the descriptor rule 6 consumes, and every
  ;; absent or malformed answer fails closed to :baseline. The parser's
  ;; producer (slice 2, the ADR 0371 provider's SUBGROUP reply) does not
  ;; exist yet -- the strings here are parser inputs, not wire readings, and
  ;; nothing here is a measurement.
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})]
    (is (= :subgroup-reduce
           (:variant (variants/select-variant
                      :apple kir :vulkan
                      (targets/device-from-subgroup "32|basic shuffle-relative")))))
    (is (= :subgroup-reduce
           (:variant (variants/select-variant
                      :apple kir :msl-v1
                      (targets/device-from-subgroup "32|basic shuffle-relative"))))
        "the descriptor keys are the route-agnostic contract: the same parsed facts select on the MSL route")
    (is (= :subgroup-reduce
           (:variant (variants/select-variant
                      :nvidia kir :cuda-v1
                      (targets/device-from-subgroup "32|basic shuffle-relative"))))
        "and the same parsed facts select NVIDIA's CUDA-route second rung (no compute capability in a SUBGROUP answer -- the warp row's gate does not reach)")
    (is (= :subgroup-reduce
           (:variant (variants/select-variant
                      :intel kir :glsl-v1
                      (targets/device-from-subgroup "8|basic shuffle-relative shuffle"))))
        "a parsed fact set larger than the fold's two ops still selects")
    (is (= :baseline
           (:variant (variants/select-variant
                      :apple kir :vulkan
                      (targets/device-from-subgroup "32|basic"))))
        "a fact missing :shuffle-relative fails closed")
    (is (= :baseline
           (:variant (variants/select-variant
                      :apple kir :vulkan
                      (targets/device-from-subgroup "24|basic shuffle-relative"))))
        "a subgroup size that does not divide the workgroup fails closed")
    (is (= :baseline
           (:variant (variants/select-variant
                      :apple kir :vulkan
                      (targets/device-from-subgroup "no|such answer"))))
        "a malformed answer is an absent fact, and an absent fact is :baseline")
    (is (nil? (targets/device-from-subgroup "32|basic shuffle-relative simd-reduce"))
        "the wire-42 SUBGROUP vocabulary is ADR-0362's eight VkSubgroupFeatureFlagBits tokens and does NOT carry :simd-reduce (ADR-0373's named producer gap: a Metal-native probe or provider extension must report the key; an unknown token fails the whole answer)")))

(deftest the-amd-row-rides-the-vulkan-and-wgsl-routes
  ;; ADR-0364 (JUN-84 / AWAI-40, 2026-10-23): the AMD row is the shared
  ;; subgroup-size-parametric :subgroup-reduce on the Vulkan route (RADV;
  ;; the one route that has ever executed anything in this repository) AND
  ;; on the WGSL route -- :webgpu (api) / :wgsl-v1 (emitter target) --
  ;; because :wgsl-v1 is :amd's vendor-default emission target (the exact
  ;; ADR-0363 rationale for Intel/ARM). The RDNA wave32/wave64 duality is
  ;; answered by the fold's RUNTIME width query (AWAI-40 scope item 1):
  ;; selection dispatches on no wave and rule 6's S | W gate admits both
  ;; waves for every KIR-admitted workgroup. AMD has no
  ;; compute-capability contract (no sm_70+ analogue); the MSL and CUDA
  ;; routes are other vendors' native routes and answer :baseline.
  ;; Everything here is UNMEASURED -- no AMD hardware has run this
  ;; variant and every answer keeps :measured? false.
  (doseq [target [:vulkan :glsl-v1 :webgpu :wgsl-v1]
          wg [128 256 512 1024]
          operator [:sum :max :min]
          s [32 64]]
    (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32")
                                  :reduce operator {:workgroup-size wg})
          device {:subgroup-size s :subgroup-ops #{:basic :shuffle-relative}}
          answer (variants/select-variant :amd kir target device)]
      (is (= :subgroup-reduce (:variant answer)))
      (is (false? (:measured? answer)))
      (is (str/includes? (:basis answer) "ADR-0364"))))
  (testing "both waves select: s=32 (wave32) and s=64 (wave64) pass the same gate"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 1024})]
      (doseq [s [32 64]
              target [:vulkan :glsl-v1 :webgpu :wgsl-v1]]
        (is (= :subgroup-reduce
               (:variant (variants/select-variant
                          :amd kir target
                          {:subgroup-size s :subgroup-ops #{:basic :shuffle-relative}})))))))
  (testing "rule 3 end to end on the Vulkan route: the selected variant lowers, seals and verifies on :glsl-v1"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 1024})
          device {:subgroup-size 64 :subgroup-ops #{:basic :shuffle-relative}}
          selected (:variant (variants/select-variant :amd kir :glsl-v1 device))
          compiled (accelerator/compile-kernel kir :glsl-v1 selected)]
      (is (= :subgroup-reduce selected))
      (is (= :subgroup-reduce (:variant compiled)))
      (is (str/includes? (:code compiled) "gl_SubgroupSize")
          "the fold width is a runtime query on the GLSL arm")
      (is (nil? (re-find #"\bd\s*=\s*\d+u" (:code compiled)))
          "a baked fold width leaked into the GLSL emission")
      (is (= compiled (accelerator/verify-artifact! compiled)))))
  (testing "rule 3 end to end on the WGSL route: the selected variant lowers, seals and verifies on :wgsl-v1"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 1024})
          device {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
          selected (:variant (variants/select-variant :amd kir :wgsl-v1 device))
          compiled (accelerator/compile-kernel kir :wgsl-v1 selected)]
      (is (= :subgroup-reduce selected))
      (is (= :subgroup-reduce (:variant compiled)))
      (is (str/includes? (:code compiled) "enable subgroups;"))
      (is (not (str/includes? (:code compiled) "enable subgroup_id;"))
          "subgroup_id is a LANGUAGE extension; enable-ing it is a shader-creation error (WGSL spec pin, 2026-10-23)")
      (is (str/includes? (:code compiled) "for(var d:u32=fold/2u;"))
      (is (nil? (re-find #"d:u32=\d+u" (:code compiled)))
          "a baked fold width leaked into the WGSL emission")
      (is (= compiled (accelerator/verify-artifact! compiled)))))
  (testing "the same rule-6 gate fails closed on both of the row's routes"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          ewise (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
          malformed (assoc kir :kernel/dtype :f64)
          capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
      (doseq [device [nil
                      {}
                      {:subgroup-size 32}
                      {:subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 32 :subgroup-ops #{:basic}}
                      {:subgroup-size 32 :subgroup-ops #{:shuffle-relative}}
                      {:subgroup-size 24 :subgroup-ops #{:basic :shuffle-relative}}
                      {:subgroup-size 512 :subgroup-ops #{:basic :shuffle-relative}}]
              target [:vulkan :glsl-v1 :webgpu :wgsl-v1]]
        (is (= :baseline (:variant (variants/select-variant :amd kir target device)))
            (str "device " (pr-str device) " must fail closed on the AMD row's routes")))
      (doseq [target [:vulkan :glsl-v1 :webgpu :wgsl-v1]]
        (is (= :baseline (:variant (variants/select-variant :amd ewise target capable))))
        (is (= :baseline (:variant (variants/select-variant :amd malformed target capable)))))))
  (testing "the other vendors' native routes answer :baseline for :amd (row scope, not rule 3)"
    (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
          capable {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}]
      (doseq [target [:metal :msl-v1 :cuda :cuda-v1 nil]]
        (is (= :baseline (:variant (variants/select-variant :amd kir target capable)))))))
  (testing "same arguments in, same map out"
    (let [kir (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 256})
          device {:subgroup-size 64 :subgroup-ops #{:basic :shuffle-relative}}]
      (is (= (variants/select-variant :amd kir :vulkan device)
             (variants/select-variant :amd kir :vulkan device))))))
