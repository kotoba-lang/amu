(ns kotoba.compiler.test-profile-test
  (:require [kotoba.test :refer [deftest is]]
            [kotoba.compiler.test-profile :as profile]))

(def source
  "(ns test.portable
     (:capabilities #{:http/post})
     (:export [test-handler test-pure test-ability]))
   (defn test-handler [cap-id value]
     (if (= cap-id 4) (+ value 1) 0))
   (defn test-pure [] (= (+ 20 22) 42))
   (defn test-ability [] (= (cap-call :http/post 41) 42))")

;; The two tests are predicates, written as predicates. They were briefly
;; `(if (= …) 1 0)` so that a runner checking `=== 1n` would keep passing --
;; which made the canonical example of what a Kotoba test looks like use the
;; exact profile-4 idiom ADR 0191 calls the non-Clojure one. The runner states
;; the rule instead (a test returns a boolean; 1/1n stays accepted for the
;; deprecation window), so the fixture can read like Clojure again.

(deftest one-kotoba-test-source-runs-on-every-target
  (let [report (profile/run-source source)]
    (is (:ok report) (pr-str (:failed report)))
    (is (= ['test-pure 'test-ability] (:tests report)))
    (is (= #{:jvm-kir :js :wasm} (set (keys (:results report)))))
    (is (re-matches #"[0-9a-f]{64}" (:test-kir-sha256 report))
        "a 64-character hex digest, which is what a sha2-256 is and what a CID is not")
    (is (nil? (:test-definition-cid report))
        "the old name claimed an identity this report does not compute")))

;; A test that needs more than the emitter's default budget (512): a 900-step
;; loop. The restricted-ESM probe meters it (measured 2026-09-15: it passes
;; at 1000 and fails at 900 -- the js probe charges per step; the wasm probe
;; charges per call and lets a loop run for free, so only js starves). With
;; `:fuel 1000` it passes everywhere. The second source pins the other half
;; of the change -- every test gets its OWN instance: two tests that each
;; cost between 900 and 1000 both pass at 1000, which a shared instance
;; could not do. Measured the same day on cloud-itonami-commands, where two
;; tests passed and sixteen reported `unreachable` on one shared instance.
(def hungry-source
  "(ns test.hungry (:export [test-loop]))
   (defn test-loop [] (= 900 (loop [i 0] (if (>= i 900) i (recur (+ i 1))))))")

(def two-hungry-source
  "(ns test.two (:export [test-first test-second]))
   (defn test-first [] (= 900 (loop [i 0] (if (>= i 900) i (recur (+ i 1))))))
   (defn test-second [] (= 900 (loop [i 0] (if (>= i 900) i (recur (+ i 1))))))")

(deftest fuel-is-a-per-test-budget-the-caller-names
  (let [starved (profile/run-source hungry-source)
        fed (profile/run-source hungry-source {:fuel 1000})]
    (is (not (:ok starved)) "the default budget is not enough for 900 metered steps")
    (is (= [:js] (mapv :target (:failed starved)))
        (str "the js probe starves; the interpreter and wasm do not meter a loop: " (pr-str (:failed starved))))
    (is (:ok fed) (pr-str (:failed fed))))
  (let [report (profile/run-source two-hungry-source {:fuel 1000})]
    (is (:ok report)
        (str "two tests that each cost 900..1000 both pass at 1000 because each runs on a fresh instance: "
             (pr-str (:failed report))))))
