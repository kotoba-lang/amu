(ns kotoba.compiler.runner-bookkeeping-test
  "Recorded-measurement vectors for the runner bookkeeping slice (JUN-29).
  Every constant below is a measured value from the 2026-10-19 x86-64
  G1->G2 chain or a FIPS 180-4 published vector -- reproduced by this
  code under kbb/sci, cross-checked against Python hashlib. Two traps are
  pinned here as data so they cannot silently return:

  * entries sort BY PATH (`8935d969...`); the same entries sorted by
    sha256 answer the different recorded value `ed7839d5...`.
  * the 896-bit FIPS message is GENERATED (112-char sliding window), not
    handwritten -- a handwritten 119-char version hashed to `a0d60fd1...`
    and did not match."
  (:require [clojure.test :refer [deftest is]]
            [kotoba.compiler.runner-bookkeeping :as bookkeeping]
            [kotoba.compiler.runner-slice :as runner-slice]))

;; ── FIPS 180-4 §B.1 published digest vectors ───────────────────────────────

(def fips-empty "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
(def fips-abc "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
(def fips-2-block "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
(def fips-896 "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")

(def fips-2-block-message
  "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")

(defn sliding-window-message
  "GENERATED, never handwritten: the 14 windows [i,i+8) of the 26-letter
  alphabet, concatenated = 112 ASCII bytes = the FIPS 896-bit message."
  []
  (let [alphabet "abcdefghijklmnopqrstuvwxyz"]
    (apply str (map (fn [i] (subs alphabet i (+ i 8))) (range 14)))))

(defn- code-unit
  "Code unit of S at I as an int. NOT `(int (nth s i))` -- on cljs that
  answers 0 for every character (measured trap)."
  [s i]
  #?(:clj (int (.charAt ^String s i))
     :cljs (.charCodeAt s i)))

(defn- ascii-bytes [s] (mapv #(code-unit s %) (range (count s))))

(deftest fips-180-4-digest-vectors
  (is (= fips-empty (bookkeeping/artifact-digest [])))
  (is (= fips-abc (bookkeeping/artifact-digest (ascii-bytes "abc"))))
  (is (= fips-2-block (bookkeeping/artifact-digest
                       (ascii-bytes fips-2-block-message))))
  (is (= 112 (count (sliding-window-message)))
      "896-bit message is 112 bytes; the handwritten 119-char version does not hash to fips-896")
  (is (= fips-896 (bookkeeping/artifact-digest
                   (ascii-bytes (sliding-window-message))))))

(deftest strings-and-non-bytes-are-refused
  (is (thrown-with-msg? clojure.lang.ExceptionInfo #"strings are not bytes"
                        (bookkeeping/artifact-digest "abc")))
  (doseq [bad [[0 256] [1 -1] [1.5] [nil] [{:a 1}] "日本語" nil 42]]
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"strings are not bytes|not an unsigned byte|not a byte vector"
                          (bookkeeping/artifact-digest bad))
        (str "refused: " (pr-str bad)))))

;; ── the measured 21-entry source graph (recorded constants) ────────────────

(def measured-entries
  "path -> sha256 of the pinned seed source graph, 2026-10-19. The checkout
  has since moved on 4 files; these are the MEASURED digests and the tests
  must not hash live files (recorded-pin discipline)."
  [["00-ns.kotoba" "8d0c0a62a8feda3007d9f7f2140173bb3f724b17e8cee1bdeca2b0a805cb3475"]
   ["01-mem.kotoba" "79bb1d1154857efc70bee464161abfce37ec6b90e55af7bbef386ab96ca131c9"]
   ["02-io.kotoba" "268ae7a0d450deb0b7981b85f7e6895b08b4af828f1f57cb96cf2eb29777c4ea"]
   ["10-lex.kotoba" "a8b8128b9e00564f3d86a81b9c69e692efa0114a3cd0083e401cda8577086d6b"]
   ["11-read.kotoba" "89fd65139a4502f96c87807db80d4cbaa15913ea75788eb3b647dcc9556e0392"]
   ["12-kirread.kotoba" "18f0236ceaccb41a8a92fd19a871355cb6f255819e492bed850c66ee82ee540f"]
   ["20-names.kotoba" "fbd708ae321b3520d4d592955ab2ad1bf0378e962eab69964ddc8dd9f6a68e3f"]
   ["21-check.kotoba" "4228b2afeb923ea0cf5dd6e07205b03716ff830cbea340b1b231eef38dd9ba2f"]
   ["30-lower.kotoba" "0dc46637dff1c4a645d8bfa73cf18469913b32ca90ce236c1a76ce89a8fff20e"]
   ["40-a64enc.kotoba" "3e6be7a2320c27a95ffc8e3b831edd6d1e4f18b19ebdd38a4c22579e5e5efbed"]
   ["41-a64gen.kotoba" "fc655f9159089c7c51821dff267ae65ac85dcb535d4d3ee379788ba8e45e6a52"]
   ["42-layout.kotoba" "16bb4a9d691138e0e6e033eb171f9ec98566b9f150f3d71b230f19044fe151e5"]
   ["50-out.kotoba" "1cf17b348bda09d73d721856705a52db05131b88f80d017e1fe9b9a92c066955"]
   ["60-proj.kotoba" "ca87b9414c6d5c97916a132f569904b23125602b6353a9cc0492bad52dd4ac56"]
   ["70-x86_64-linux.kotoba" "de16ea538b00c1a439002768c785df82722c4230646cd53b7793d358b0da8182"]
   ["71-x86_64-runtime.kotoba" "15f2c4f8b8f0a2a46ccd8fbb4c7f621e17a385b680e0d6878d258a9c9e6cc14c"]
   ["72-x86-cross-entry.kotoba" "d8a824c24df132a51a5199895522647e1cad76fbeb6bfad41167e51255bce76b"]
   ["90-drv.kotoba" "469b09fff5a509a8d6f4a725d2ac8d6d9f419abc735aba8114eeefce3f5663aa"]
   ["X86_64-LINUX-MANIFEST" "f666cad43c59b77d6c4e6581abd9add1573592415c62a56f618573d7dd961d1f"]
   ["adopted-20261012.bin" "6b158aa8654706743462b8a730f189072ba05f364b00af28a3f6d23045add2eb"]
   ["adopted-loader-20261012.c" "f44b50995a0e45db4be35244da34dd61538a484c7d5ea2f15f7f5a73d9daa8c3"]])

(defn entry-maps
  "PUBLIC: `kotoba.compiler.runner-seed-test` reproduces the same measured
  chain through the full runner sequence and must not copy these digests."
  []
  (mapv (fn [[path sha256]] {:path path :sha256 sha256}) measured-entries))

(def source-graph-sha
  "8935d969ae4665c63baaf4f3dd42c0f192d388d397ced7b5c335561a2f1f5700")

(def sha-sort-trap-sha
  "ed7839d5380385af71d536cd0c9b1ae060b6a414a4b2893bb6ddad31d563fc8f")

(deftest source-graph-manifest-reproduces-the-measured-pin
  (is (= 21 (count (entry-maps))))
  (is (= source-graph-sha (bookkeeping/source-graph-digest (entry-maps))))
  (is (= source-graph-sha
         (bookkeeping/source-graph-digest (shuffle (entry-maps))))
      "entry order is not part of the contract (canonical sort is by path)")
  ;; the recorded trap: the same entries sorted by sha256 instead of path
  (let [trap (apply str (map (fn [{:keys [path sha256]}]
                               (str sha256 "  " path "\n"))
                             (sort-by :sha256 (entry-maps))))]
    (is (= sha-sort-trap-sha (bookkeeping/artifact-digest (ascii-bytes trap))))
    (is (not= source-graph-sha sha-sort-trap-sha)
        "sort key is load-bearing: sha order answers a different digest")))

;; ── the measured run, through pre-entry! / post-run! ───────────────────────

(def runner-sha "05798f17613db2936cf8fe29c16590c8c2b7513fc80e5b2334e89d16b482f7aa")
(def compiler-sha "32fe88f0dc850728c44a4b4320b6c180292a38e98672c80759859a59469e3f34")
(def container-sha "5f9b446c4445c12038ed8aa1eb4ad3984a671fba52e5f78e2de736f08822ce67")
(def output-sha "101995a7fbf9e6a93400d7a178ed7c66e1c8dec6be515702d734c829c565d2e2")
(def receipt-sha "b16d1d533ae420ca648cd0c695311b8de04f046eb113c08eaf6399d11b863965")
(def admission-sha "73c7761f9a191d721e6e4a8d5b0323253d5a35d54d4fee8e8fec65dea75ae95c")
(def contract-sha "35397c0b1b6a2f6d46d55f7f660730bd9ed5e9e2fb67d19c2424370c1fce680b")
(def run-started-at 1792403476)
(def run-finished-at 1792403796)

(defn- measured-digest-slots []
  {:runner {:sha256 runner-sha}
   :compiler {:sha256 compiler-sha}
   :source-graph {:entries (entry-maps)}
   :container {:sha256 container-sha}})

(deftest measured-admission-reproduces
  (let [admitted (bookkeeping/pre-entry!
                  (assoc (measured-digest-slots)
                         :pinned-source-graph-sha256 source-graph-sha
                         :expected-container-sha256 container-sha))]
    (is (:admitted? admitted))
    (is (= admission-sha (:admission-sha256 admitted)))
    (is (= {:runner-sha256 runner-sha
            :compiler-sha256 compiler-sha
            :source-graph-sha256 source-graph-sha
            :container-sha256 container-sha}
           (:digests admitted)))))

(deftest measured-receipt-reproduces
  (let [admitted (bookkeeping/pre-entry!
                  (assoc (measured-digest-slots)
                         :pinned-source-graph-sha256 source-graph-sha
                         :expected-container-sha256 container-sha))
        sealed (bookkeeping/post-run!
                {:digests (:digests admitted)
                 :output {:sha256 output-sha}
                 :status :ok
                 :started-at run-started-at
                 :finished-at run-finished-at})
        receipt (:receipt sealed)]
    (is (:verified? sealed))
    (is (= runner-slice/receipt-format (:format receipt)))
    (is (= receipt-sha (:receipt-sha256 receipt)))
    (is (= contract-sha (:call-site-contract-sha256 receipt)))
    (is (= :ok (:status receipt)))
    (is (= run-started-at (:started-at receipt)))
    (is (= run-finished-at (:finished-at receipt)))))

(deftest slots-accept-bytes-or-digest-but-never-both
  (let [base (assoc (measured-digest-slots)
                    :pinned-source-graph-sha256 source-graph-sha
                    :expected-container-sha256 container-sha)]
    ;; bytes and digest at once: refused (which side is trusted?)
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"exactly one"
                          (bookkeeping/pre-entry!
                           (assoc base :runner {:bytes [1 2 3] :sha256 runner-sha}))))
    ;; neither: refused
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"exactly one"
                          (bookkeeping/pre-entry! (assoc base :compiler {}))))
    ;; digest that is not a raw-byte SHA-256: refused
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"not a raw-byte SHA-256"
                          (bookkeeping/pre-entry!
                           (assoc base :container {:sha256 "ABC"}))))
    ;; entries resolve through the manifest path to the recorded digest
    (let [admitted (bookkeeping/pre-entry!
                    (assoc base :source-graph {:entries (entry-maps)}))]
      (is (= source-graph-sha (get-in admitted [:digests :source-graph-sha256]))))
    ;; entries AND digest at once: refused, same rule
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"exactly one"
                          (bookkeeping/pre-entry!
                           (assoc base :source-graph {:sha256 source-graph-sha
                                                      :entries (entry-maps)}))))
    ;; post-run! output slot obeys the same exclusivity
    (is (thrown-with-msg? clojure.lang.ExceptionInfo #"exactly one"
                          (bookkeeping/post-run!
                           {:digests {:runner-sha256 runner-sha
                                      :compiler-sha256 compiler-sha
                                      :source-graph-sha256 source-graph-sha
                                      :container-sha256 container-sha}
                            :output {:bytes [0 1] :sha256 output-sha}
                            :status :ok :started-at 1 :finished-at 2})))))
