(ns kotoba.compiler.accelerator-test
  (:require [clojure.string :as str]
            [clojure.test :refer [deftest is testing]]
            [kotoba.compiler.accelerator :as accelerator]
            [kotoba.compiler.accelerator-subgroup-reduce :as sg]
            [kotoba.artifact.core :as artifact]))

(deftest typed-kir-lowers-deterministically-to-wgsl-and-cuda
  (let [kir (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
        wgsl (accelerator/compile-kernel kir :wgsl-v1)
        cuda (accelerator/compile-kernel kir :cuda-v1)
        msl (accelerator/compile-kernel kir :msl-v1)]
    (is (= :kotoba.gpu-artifact/v1 (:format wgsl)))
    (is (= (:kir-sha256 wgsl) (:kir-sha256 cuda)))
    (is (= (:kir-sha256 wgsl) (:kir-sha256 msl)))
    (is (not= (:code-sha256 wgsl) (:code-sha256 cuda)))
    (is (re-find #"@compute @workgroup_size\(256\)" (:code wgsl)))
    (is (re-find #"extern \"C\" __global__" (:code cuda)))
    (is (re-find #"#include <metal_stdlib>" (:code msl)))
    (is (= wgsl (accelerator/verify-artifact! wgsl)))
    (is (= cuda (accelerator/verify-artifact! cuda)))
    (is (= msl (accelerator/verify-artifact! msl)))
    (is (= wgsl (accelerator/compile-kernel kir :wgsl-v1)))))

(deftest reduction-lowering-is-bounded-and-target-specific
  (doseq [operator [:sum :max :min]]
    (let [kir (accelerator/kernel (str "reduce_" (name operator) "_f32") :reduce operator
                                  {:workgroup-size 128})
          wgsl (accelerator/compile-kernel kir :wgsl-v1)
          cuda (accelerator/compile-kernel kir :cuda-v1)
          msl (accelerator/compile-kernel kir :msl-v1)]
      (is (re-find #"workgroupBarrier" (:code wgsl)))
      (is (re-find #"extern __shared__ float" (:code cuda)))
      (is (re-find #"threadgroup float" (:code msl)))
      (is (= 128 (get-in cuda [:limits :workgroup-size]))))))

(deftest invalid-or-tampered-kernels-fail-closed
  (let [valid (accelerator/kernel "safe" :ewise :mul {})]
    (doseq [bad [(assoc valid :kernel/dtype :f64)
                 (assoc valid :kernel/workgroup-size 300)
                 (assoc valid :kernel/effects #{:gpu/storage-read :network})
                 (assoc valid :kernel/name "../../kernel")]]
      (is (thrown-with-msg? Exception #"invalid accelerator KIR" (accelerator/compile-kernel bad :cuda-v1))))
    (is (thrown-with-msg? Exception #"unsupported accelerator target"
                          (accelerator/compile-kernel valid :ptx-unknown)))
    (let [compiled (accelerator/compile-kernel valid :cuda-v1)]
      (is (thrown-with-msg? Exception #"invalid accelerator artifact envelope"
                            (accelerator/verify-artifact! (assoc compiled :code "evil"))))
      (let [resealed (artifact/seal (assoc compiled :code "evil"))]
        (is (thrown-with-msg? Exception #"regeneration mismatch"
                              (accelerator/verify-artifact! resealed)))))))

(deftest warp-shuffle-reduce-variant-lowers-deterministically
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        base (accelerator/lower kir :cuda-v1)
        base-explicit (accelerator/lower kir :cuda-v1 :baseline)
        shuffle (accelerator/lower kir :cuda-v1 :warp-shuffle-reduce)]
    (testing "the baseline emission is byte-identical with or without the variant arity"
      (is (= base base-explicit)))
    (testing "the variant is a different emission of the same reduction"
      (is (not= base shuffle))
      (is (re-find #"__device__ float combine\(float a,float b\)" shuffle))
      (is (re-find #"__shfl_down_sync\(0xffffffffu,v,d,32\)" shuffle))
      (is (re-find #"unsigned int warps=blockDim\.x/32" shuffle))
      (is (re-find #"__shfl_down_sync\(0xffffffffu,a,d,warps\)" shuffle))
      (is (not (re-find #"__shfl_down_sync" base))))
    (testing "emission is deterministic across calls"
      (is (= shuffle (accelerator/lower kir :cuda-v1 :warp-shuffle-reduce))))
    (testing "every reduction operator gets a shuffle lowering"
      (doseq [operator [:sum :max :min]]
        (let [k (accelerator/kernel (str "reduce_" (name operator) "_f32") :reduce operator
                                    {:workgroup-size 64})]
          (is (re-find #"__shfl_down_sync"
                       (accelerator/lower k :cuda-v1 :warp-shuffle-reduce))))))))

(deftest kernel-variants-refuse-where-not-applicable
  (let [reduce-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        ewise-kir (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
        subwarp-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 16})]
    (is (thrown-with-msg? Exception #"kernel variant not applicable"
                          (accelerator/lower ewise-kir :cuda-v1 :warp-shuffle-reduce)))
    (is (thrown-with-msg? Exception #"kernel variant not applicable"
                          (accelerator/lower subwarp-kir :cuda-v1 :warp-shuffle-reduce)))
    (is (thrown-with-msg? Exception #"kernel variant not applicable"
                          (accelerator/lower reduce-kir :wgsl-v1 :warp-shuffle-reduce)))
    (is (thrown-with-msg? Exception #"kernel variant not applicable"
                          (accelerator/lower reduce-kir :msl-v1 :warp-shuffle-reduce)))
    (is (thrown-with-msg? Exception #"unsupported kernel variant"
                          (accelerator/lower reduce-kir :cuda-v1 :turbo)))
    (is (thrown-with-msg? Exception #"unsupported kernel variant"
                          (accelerator/compile-kernel reduce-kir :cuda-v1 :turbo)))))

(deftest variant-artifacts-seal-and-verify
  (let [kir (accelerator/kernel "reduce_max_f32" :reduce :max {:workgroup-size 128})
        compiled (accelerator/compile-kernel kir :cuda-v1 :warp-shuffle-reduce)]
    (is (= :warp-shuffle-reduce (:variant compiled)))
    (is (= compiled (accelerator/verify-artifact! compiled)))
    (is (= compiled (accelerator/compile-kernel kir :cuda-v1 :warp-shuffle-reduce)))
    (testing "a pre-variant sealed artifact (no :variant) verifies as :baseline"
      (let [legacy (artifact/seal (dissoc (accelerator/compile-kernel kir :cuda-v1) :variant))]
        (is (not (contains? legacy :variant)))
        (is (= legacy (accelerator/verify-artifact! legacy)))))
    (testing "swapping the variant label on baseline code fails closed"
      (let [tampered (artifact/seal (assoc (accelerator/compile-kernel kir :cuda-v1)
                                           :variant :warp-shuffle-reduce))]
        (is (thrown-with-msg? Exception #"regeneration mismatch"
                              (accelerator/verify-artifact! tampered)))))
    (testing "an unknown variant label fails closed"
      (let [tampered (artifact/seal (assoc compiled :variant :turbo))]
        (is (thrown-with-msg? Exception #"unsupported kernel variant"
                              (accelerator/verify-artifact! tampered)))))))

(deftest glsl-v1-baseline-lowers-deterministically
  ;; ADR-0359 decision 1: :glsl-v1 is a fourth emission target. This is the
  ;; SOURCE text contract only -- the GLSL -> SPIR-V compilation is a
  ;; separate sealed build step (decision 2, accepted design, not yet
  ;; implemented). UNMEASURED as an optimization claim: nothing here is a
  ;; tuning result.
  (is (contains? accelerator/targets :glsl-v1))
  (let [ewise (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
        ew (accelerator/compile-kernel ewise :glsl-v1)
        reduce-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 128})
        rd (accelerator/compile-kernel reduce-kir :glsl-v1)]
    (testing "the seal regime covers the GLSL arm like any other emission"
      (is (= ew (accelerator/verify-artifact! ew)))
      (is (= rd (accelerator/verify-artifact! rd)))
      (is (= ew (accelerator/compile-kernel ewise :glsl-v1))))
    (testing "the KIR hash is target-independent"
      (is (= (:kir-sha256 ew) (:kir-sha256 (accelerator/compile-kernel ewise :wgsl-v1)))))
    (testing "GLSL 450 compute, entry main; the kernel name does not appear"
      (is (str/starts-with? (:code ew) "#version 450\n"))
      (is (str/includes? (:code ew) "layout(local_size_x = 256) in;"))
      (is (str/includes? (:code ew) "void main()"))
      (is (nil? (re-find #"ewise_add_f32" (:code ew)))))
    (testing "wire-42 ABI: storage buffers only -- n rides a readonly SSBO"
      (is (str/includes? (:code ew)
                         "layout(set = 0, binding = 2, std430) writeonly buffer Z { float z[]; };"))
      (is (str/includes? (:code ew)
                         "layout(set = 0, binding = 3, std430) readonly buffer N { uint n; };"))
      (is (str/includes? (:code rd)
                         "layout(set = 0, binding = 1, std430) writeonly buffer Parts { float parts[]; };"))
      (is (str/includes? (:code rd)
                         "layout(set = 0, binding = 2, std430) readonly buffer N { uint n; };"))
      (is (nil? (re-find #"uniform" (:code ew)))))
    (testing "the tree reduce carries its barrier cascade and per-workgroup partial"
      (is (str/includes? (:code rd) "barrier();"))
      (is (str/includes? (:code rd) "parts[gl_WorkGroupID.x] = scratch[0]")))
    (testing "emission is deterministic across calls"
      (is (= (:code rd) (accelerator/lower reduce-kir :glsl-v1))))))

(deftest glsl-v1-subgroup-reduce-routes-to-the-arm-emitter
  ;; ADR-0359 decision 1: `lower` admits :glsl-v1 for :subgroup-reduce,
  ;; routed to the existing emit-glsl -- so the seal regime covers that
  ;; emission like any other. Before this admission NO :subgroup-reduce
  ;; artifact could verify at all: the verifier's vocabulary named the
  ;; variant and `lower` refused it ("unsupported kernel variant").
  (let [kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        routed (accelerator/lower kir :glsl-v1 :subgroup-reduce)
        compiled (accelerator/compile-kernel kir :glsl-v1 :subgroup-reduce)]
    (testing "the routed bytes ARE the arm emitter's bytes"
      (is (= (sg/emit-glsl kir) routed)))
    (testing "a :subgroup-reduce artifact seals and verifies"
      (is (= :subgroup-reduce (:variant compiled)))
      (is (= compiled (accelerator/verify-artifact! compiled)))
      (is (= compiled (accelerator/compile-kernel kir :glsl-v1 :subgroup-reduce))))
    (testing "relabeling baseline GLSL bytes as the variant fails closed"
      (let [tampered (artifact/seal (assoc (accelerator/compile-kernel kir :glsl-v1)
                                           :variant :subgroup-reduce))]
        (is (thrown-with-msg? Exception #"regeneration mismatch"
                              (accelerator/verify-artifact! tampered)))))))

(deftest glsl-variants-refuse-where-not-applicable
  (let [reduce-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 256})
        ewise-kir (accelerator/kernel "ewise_add_f32" :ewise :add {:workgroup-size 256})
        subwarp-kir (accelerator/kernel "reduce_sum_f32" :reduce :sum {:workgroup-size 16})]
    (testing "the GLSL arm admits no CUDA variant"
      (is (thrown-with-msg? Exception #"kernel variant not applicable"
                            (accelerator/lower reduce-kir :glsl-v1 :warp-shuffle-reduce))))
    (testing "the CUDA arm admits no Vulkan variant -- never silently baseline"
      (is (thrown-with-msg? Exception #"kernel variant not applicable"
                            (accelerator/lower reduce-kir :cuda-v1 :subgroup-reduce))))
    (testing "the WGSL and MSL arms admit it either"
      (is (thrown-with-msg? Exception #"kernel variant not applicable"
                            (accelerator/lower reduce-kir :wgsl-v1 :subgroup-reduce)))
      (is (thrown-with-msg? Exception #"kernel variant not applicable"
                            (accelerator/lower reduce-kir :msl-v1 :subgroup-reduce))))
    (testing "the variant's own applicability row refuses ewise and sub-warp"
      (is (thrown-with-msg? Exception #"kernel variant not applicable"
                            (accelerator/lower ewise-kir :glsl-v1 :subgroup-reduce)))
      (is (thrown-with-msg? Exception #"kernel variant not applicable"
                            (accelerator/lower subwarp-kir :glsl-v1 :subgroup-reduce))))))

(deftest glsl-variants-share-one-operator-meaning
  ;; One GLSL arm, one meaning per operator: the baseline tree and the
  ;; subgroup fold carry the same combine and the same identity, including
  ;; the INFINITE extrema neutrals (a finite bound is corrupted by a
  ;; legitimate +-Inf input in the padded lanes).
  (doseq [[operator combine identity-text]
          [[:sum "a+b" "0.0"]
           [:max "max(a,b)" "uintBitsToFloat(0xFF800000u)"]
           [:min "min(a,b)" "uintBitsToFloat(0x7F800000u)"]]]
    (let [kir (accelerator/kernel (str "reduce_" (name operator)) :reduce operator
                                  {:workgroup-size 128})
          baseline (accelerator/lower kir :glsl-v1 :baseline)
          variant (accelerator/lower kir :glsl-v1 :subgroup-reduce)]
      (is (str/includes? baseline (str "float combine(float a, float b) { return " combine "; }")))
      (is (str/includes? variant (str "float combine(float a, float b) { return " combine "; }")))
      (is (str/includes? baseline (str "scratch[lid] = i < n ? x[i] : " identity-text ";")))
      (is (str/includes? variant (str "float v = i < n ? x[i] : " identity-text ";"))))))
