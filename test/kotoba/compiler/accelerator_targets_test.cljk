(ns kotoba.compiler.accelerator-targets-test
  (:require [clojure.test :refer [deftest is testing]]
            [kotoba.compiler.accelerator :as accelerator]
            [kotoba.compiler.accelerator-targets :as targets]))

(deftest vendor-classification-is-deterministic
  (testing "pci vendor ids win over names"
    (is (= :nvidia (targets/classify-vendor {:vendor-id 4318})))
    (is (= :apple (targets/classify-vendor {:vendor-id 4203})))
    (is (= :intel (targets/classify-vendor {:vendor-id 32902})))
    (is (= :arm (targets/classify-vendor {:vendor-id 5045})))
    (is (= :amd (targets/classify-vendor {:vendor-id 4098}))))
  (testing "name matching is case-insensitive"
    (is (= :nvidia (targets/classify-vendor {:vendor "NVIDIA GeForce RTX 4090"})))
    (is (= :nvidia (targets/classify-vendor {:vendor "nvidia geforce rtx 4090"})))
    (is (= :apple (targets/classify-vendor {:vendor "Apple M2 Pro"})))
    (is (= :intel (targets/classify-vendor {:vendor "Intel(R) Iris(R) Xe Graphics"})))
    (is (= :arm (targets/classify-vendor {:vendor "Mali-G78 MP24"})))
    (is (= :amd (targets/classify-vendor {:vendor "AMD Radeon Pro 5500M"}))))
  (testing "unknown devices classify as :unknown, not as a refusal"
    (is (= :unknown (targets/classify-vendor {:vendor "Software Rasterizer"})))
    (is (= :unknown (targets/classify-vendor {:vendor-id 1})))
    (is (= :unknown (targets/classify-vendor {})))))

(deftest target-dispatch-matches-api-and-vendor
  (testing "an api that names its shading language decides outright"
    (is (= :cuda-v1 (targets/target-for :cuda :nvidia)))
    (is (= :msl-v1 (targets/target-for :metal :apple)))
    (is (= :wgsl-v1 (targets/target-for :vulkan :intel)))
    (is (= :wgsl-v1 (targets/target-for :webgpu :arm))))
  (testing "a missing or unknown api falls back to the vendor default"
    (is (= :cuda-v1 (targets/target-for nil :nvidia)))
    (is (= :msl-v1 (targets/target-for nil :apple)))
    (is (= :wgsl-v1 (targets/target-for nil :intel)))
    (is (= :wgsl-v1 (targets/target-for nil :arm)))
    (is (= :wgsl-v1 (targets/target-for :dxil :unknown))))
  (testing "every answer is one of ADR-0002's admitted targets"
    (doseq [api [:cuda :metal :vulkan :webgpu :dxil nil]
            vendor targets/vendors]
      (is (contains? accelerator/targets (targets/target-for api vendor))))))

(deftest workgroup-defaults-are-bounded-powers-of-two
  (doseq [vendor targets/vendors]
    (let [size (targets/workgroup-default vendor)
          width (:execution-width (get targets/workgroup-defaults vendor))]
      (is (pos? size))
      (is (zero? (bit-and size (dec size)))
          (str vendor " workgroup " size " is not a power of two"))
      (is (<= 32 size 1024))
      (is (zero? (mod size width))
          (str vendor " workgroup " size " is not a multiple of width " width))))
  (testing "a vendor outside the table takes the :unknown row"
    (is (= (:size (:unknown targets/workgroup-defaults))
           (targets/workgroup-default :qualcomm)))))

(deftest recommend-is-total-deterministic-and-provisional
  (let [nvidia (targets/recommend {:vendor-id 4318 :api :cuda})
        apple (targets/recommend {:vendor "Apple M3"})
        unknown (targets/recommend {})]
    (is (= :nvidia (:vendor nvidia)))
    (is (= :cuda-v1 (:target nvidia)))
    (is (= 256 (:workgroup-size nvidia)))
    (is (= :msl-v1 (:target apple)))
    (is (= :unknown (:vendor unknown)))
    (is (= :wgsl-v1 (:target unknown)))
    (testing "the answer-level :measured? stays false while any fact is provisional"
      (doseq [decision [nvidia apple unknown]]
        (is (false? (:measured? decision)))
        (is (string? (:size-basis decision)))
        (is (string? (:execution-width-basis decision)))))
    (testing "same descriptor in, same map out"
      (is (= nvidia (targets/recommend {:vendor-id 4318 :api :cuda}))))))

(deftest measurement-is-per-fact-and-cited
  (testing "the apple execution width is the one measured fact in the table"
    (is (true? (get-in targets/workgroup-defaults [:apple :execution-width-measured?])))
    (is (= 32 (get-in targets/workgroup-defaults [:apple :execution-width])))
    (is (re-find #"gpu-subgroup-measured-row-m1max-20261019"
                 (get-in targets/workgroup-defaults [:apple :execution-width-basis]))))
  (testing "no workgroup size is measured for any vendor -- no tuning result exists"
    (doseq [vendor targets/vendors]
      (is (false? (get-in targets/workgroup-defaults [vendor :size-measured?]))
          (str vendor " workgroup size must stay provisional"))))
  (testing "every other execution width stays unmeasured"
    (doseq [vendor (disj targets/vendors :apple)]
      (is (false? (get-in targets/workgroup-defaults [vendor :execution-width-measured?]))
          (str vendor " execution width must stay unmeasured"))))
  (testing "recommend propagates the per-fact flags"
    (let [apple (targets/recommend {:vendor "Apple M1 Max"})
          nvidia (targets/recommend {:vendor-id 4318})]
      (is (true? (:execution-width-measured? apple)))
      (is (false? (:size-measured? apple)))
      (is (false? (:measured? apple))
          "answer-level :measured? needs every fact measured")
      (is (false? (:execution-width-measured? nvidia)))
      (is (false? (:size-measured? nvidia)))
      (is (false? (:measured? nvidia))))))
