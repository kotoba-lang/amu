(ns kotoba.compiler.accelerator-targets-test
  (:require [clojure.string :as str]
            [clojure.test :refer [deftest is testing]]
            [kotoba.compiler.accelerator :as accelerator]
            [kotoba.compiler.accelerator-targets :as targets]
            [kotoba.kir :as ir]
            [kotoba.sema :as sema]))

(deftest vendor-classification-is-deterministic
  (testing "pci vendor ids win over names"
    (is (= :nvidia (targets/classify-vendor {:vendor-id 4318})))
    (is (= :apple (targets/classify-vendor {:vendor-id 4203})))
    (is (= :intel (targets/classify-vendor {:vendor-id 32902})))
    (is (= :arm (targets/classify-vendor {:vendor-id 5045})))
    (is (= :amd (targets/classify-vendor {:vendor-id 4098}))))
  (testing "name matching is case-insensitive"
    (is (= :nvidia (targets/classify-vendor {:vendor "NVIDIA GeForce RTX 4090"})))
    (is (= :nvidia (targets/classify-vendor {:vendor "nvidia geforce rtx 4090"})))
    (is (= :apple (targets/classify-vendor {:vendor "Apple M2 Pro"})))
    (is (= :intel (targets/classify-vendor {:vendor "Intel(R) Iris(R) Xe Graphics"})))
    (is (= :arm (targets/classify-vendor {:vendor "Mali-G78 MP24"})))
    (is (= :amd (targets/classify-vendor {:vendor "AMD Radeon Pro 5500M"}))))
  (testing "unknown devices classify as :unknown, not as a refusal"
    (is (= :unknown (targets/classify-vendor {:vendor "Software Rasterizer"})))
    (is (= :unknown (targets/classify-vendor {:vendor-id 1})))
    (is (= :unknown (targets/classify-vendor {})))))

(deftest target-dispatch-matches-api-and-vendor
  (testing "an api decides its route outright"
    (is (= :cuda-v1 (targets/target-for :cuda :nvidia)))
    (is (= :msl-v1 (targets/target-for :metal :apple)))
    (is (= :glsl-v1 (targets/target-for :vulkan :intel)) ":vulkan answers the GLSL it compiles (ADR-0359 decision 3)")
    (is (= :wgsl-v1 (targets/target-for :webgpu :arm)) ":webgpu keeps its language"))
  (testing "a missing or unknown api falls back to the vendor default"
    (is (= :cuda-v1 (targets/target-for nil :nvidia)))
    (is (= :msl-v1 (targets/target-for nil :apple)))
    (is (= :wgsl-v1 (targets/target-for nil :intel)))
    (is (= :wgsl-v1 (targets/target-for nil :arm)))
    (is (= :wgsl-v1 (targets/target-for :dxil :unknown))))
  (testing "every answer is one of ADR-0002's admitted targets"
    (doseq [api [:cuda :metal :vulkan :webgpu :dxil nil]
            vendor targets/vendors]
      (is (contains? accelerator/targets (targets/target-for api vendor))))))

(deftest workgroup-defaults-are-bounded-powers-of-two
  (doseq [vendor targets/vendors]
    (let [size (targets/workgroup-default vendor)
          width (:execution-width (get targets/workgroup-defaults vendor))]
      (is (pos? size))
      (is (zero? (bit-and size (dec size)))
          (str vendor " workgroup " size " is not a power of two"))
      (is (<= 32 size 1024))
      (is (zero? (mod size width))
          (str vendor " workgroup " size " is not a multiple of width " width))))
  (testing "a vendor outside the table takes the :unknown row"
    (is (= (:size (:unknown targets/workgroup-defaults))
           (targets/workgroup-default :qualcomm)))))

(deftest recommend-is-total-deterministic-and-provisional
  (let [nvidia (targets/recommend {:vendor-id 4318 :api :cuda})
        apple (targets/recommend {:vendor-id 4203})
        unknown (targets/recommend {})]
    (is (= :nvidia (:vendor nvidia)))
    (is (= :cuda-v1 (:target nvidia)))
    (is (= 256 (:workgroup-size nvidia)))
    (is (= :msl-v1 (:target apple)))
    (is (= :unknown (:vendor unknown)))
    (is (= :wgsl-v1 (:target unknown)))
    (testing "a measured row answers :measured? true, a provisional row false"
      (is (true? (:measured? nvidia)))
      (is (true? (:measured? apple)))
      (is (false? (:measured? unknown))))
    (testing "every answer carries its basis"
      (doseq [decision [nvidia apple unknown]]
        (is (string? (:basis decision)))))
    (testing "the measured flag is scoped to the measured device (uB5G, ADR-0358)"
      (is (false? (:measured? (targets/recommend {:vendor "Apple M3"})))
          "a device named through :vendor that hardware never measured keeps the row flag out")
      (is (false? (:measured? (targets/recommend {:vendor "Apple M3" :name "Apple M3"})))
          "a named device that is not the measured one keeps the row flag out")
      (is (false? (:measured? (targets/recommend {:vendor "GeForce RTX 4090" :api :cuda})))
          "an unmeasured NVIDIA device named by name keeps the Xavier row flag out")
      (is (true? (:measured? (targets/recommend {:vendor "Apple M1 Max" :name "M1 Max"}))))
      (is (true? (:measured? (targets/recommend {:vendor "NVIDIA Tegra Xavier" :api :cuda})))
          "the measured NVIDIA device spelled by name keeps its own row flag")
      (is (true? (:measured? (targets/recommend {:vendor "Intel(R) Graphics (BMG G31)" :api :vulkan}))))
      (is (true? (:measured? (targets/recommend {:vendor "AMD Radeon 680M"}))))
      (is (false? (:measured? (targets/recommend {:vendor-id 4318 :api :cuda :max-workgroup-x 512})))
          "an INFO-derived limit probe never transfers the row flag"))
    (testing "same descriptor in, same map out"
      (is (= nvidia (targets/recommend {:vendor-id 4318 :api :cuda}))))))

(deftest device-class-maps-the-loader-vocabulary
  (testing "the five DEVCLASS words of tools/kexe_gpu_vulkan.c map losslessly"
    (is (= :discrete-gpu (targets/device-class "discrete")))
    (is (= :integrated-gpu (targets/device-class "integrated")))
    (is (= :virtual-gpu (targets/device-class "virtual")))
    (is (= :cpu (targets/device-class "cpu")))
    (is (= :other (targets/device-class "other"))))
  (testing "every answer is a member of device-classes"
    (doseq [token ["discrete" "integrated" "virtual" "cpu" "other"]]
      (is (contains? targets/device-classes (targets/device-class token)))))
  (testing "a token the loader cannot emit answers :unknown, never a wrong class"
    (doseq [token [nil "" "Discrete" "discrete-gpu" " integrated" "gpu" 42 :discrete]]
      (is (= :unknown (targets/device-class token))
          (str token " must not become a specific class"))))
  (testing "same token in, same class out"
    (is (= (targets/device-class "integrated") (targets/device-class "integrated")))))

(deftest info-answers-parse-into-measured-device-facts
  (testing "the recorded 2026-10-18 M1 Max INFO answer (wire 42) parses"
    (let [d (targets/device-from-info "Apple M1 Max|1.3.357|1024|1")]
      (is (= "Apple M1 Max" (:vendor d)))
      (is (= :vulkan (:api d)))
      (is (= "1.3.357" (:api-version d)))
      (is (= 1024 (:max-workgroup-x d)))
      (is (true? (:unified-memory? d)))
      (is (true? (:measured? d)))))
  (testing "measured facts do not make the workgroup row measured"
    (let [decision (targets/recommend (targets/device-from-info "Apple M1 Max|1.3.357|1024|1"))]
      (is (= :apple (:vendor decision)))
      (is (= :msl-v1 (targets/target-for nil :apple)) "vendor default stays msl-v1")
      (is (= :glsl-v1 (:target decision)) "the wire is Vulkan, so :vulkan decides :glsl-v1 (ADR-0359 decision 3)")
      (is (false? (:measured? decision)))))
  (testing "malformed answers parse to nil, never a throw or a wrong decision"
    (is (nil? (targets/device-from-info nil)))
    (is (nil? (targets/device-from-info "")))
    (is (nil? (targets/device-from-info "dev|1.3.357")))
    (is (nil? (targets/device-from-info "dev|1.3.357|1024|1|extra")))
    (is (nil? (targets/device-from-info "|1.3.357|1024|1")))
    (is (nil? (targets/device-from-info "dev|vulkan|1024|1")))
    (is (nil? (targets/device-from-info "dev|1.3.357|0|1")))
    (is (nil? (targets/device-from-info "dev|1.3.357|1024|2")))
    (is (nil? (targets/device-from-info "dev|1.3.357|1024|x")))))

(deftest subgroup-answers-parse-into-rule-6-facts
  ;; ADR-0362 decision 4 (the consumer half): the parsed answer IS the
  ;; descriptor rule 6 (ADR-0356) reads -- :subgroup-size a positive int,
  ;; :subgroup-ops a keyword set. The producer (the ADR 0371 provider's
  ;; SUBGROUP reply) does not exist yet, so these are parser contracts over
  ;; answer strings: no wire, no GPU, no measurement.
  (testing "the answer is exactly two fields, <size>|<ops> (decision 2)"
    (is (= {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
           (targets/device-from-subgroup "32|basic shuffle-relative")))
    (is (= {:subgroup-size 8 :subgroup-ops #{}}
           (targets/device-from-subgroup "8|"))
        "an empty <ops> is a fact (no subgroup operations in compute), not a refusal"))
  (testing "the eight Vulkan 1.1 core tokens map 1:1, the hyphen preserved"
    (is (= #{:basic :vote :arithmetic :ballot :shuffle :shuffle-relative :clustered :quad}
           (:subgroup-ops (targets/device-from-subgroup
                           "8|basic vote arithmetic ballot shuffle shuffle-relative clustered quad"))))
    (is (= {:subgroup-size 16 :subgroup-ops #{:shuffle}}
           (targets/device-from-subgroup "16|shuffle"))))
  (testing "tokens are the wire's tokens: runs of non-space bytes, one or more spaces separate"
    (is (= #{:basic :shuffle-relative}
           (:subgroup-ops (targets/device-from-subgroup "64|  basic   shuffle-relative  "))))
    (is (= #{:basic}
           (:subgroup-ops (targets/device-from-subgroup "32|basic basic")))
        "the answer names a set: a duplicate token is the same fact"))
  (testing "all-or-nothing: a malformed answer is an absent fact (nil), never a partial one"
    (doseq [answer [nil
                    42
                    :subgroup
                    ""
                    "32"
                    "32|basic|extra"
                    "32||basic"
                    "32|basic|"
                    "|basic"
                    "|"
                    "0|basic"
                    "-1|basic"
                    "+3|basic"
                    "12.5|basic"
                    "x|basic"
                    " 32|basic"
                    "32x|basic"
                    "99999999999999999999|basic"
                    "32|Basic"
                    "32|basic vote2"
                    "32|shuffle_"
                    "32|basic\tvote"]]
      (is (nil? (targets/device-from-subgroup answer))
          (str (pr-str answer) " must parse to no fact at all"))))
  (testing "same answer in, same fact out"
    (is (= (targets/device-from-subgroup "32|basic shuffle-relative")
           (targets/device-from-subgroup "32|basic shuffle-relative")))))

(deftest subgroup-answers-are-produced-from-the-device-record
  ;; ADR-0362 decisions 2+3 (the producer half's PURE mapping): one device
  ;; record -- the VkPhysicalDeviceSubgroupProperties fields the ADR 0371
  ;; provider will read -- answers the "<size>|<ops>" payload, or nil for
  ;; the named refusal gpu/no-compute-subgroups. Pure contracts over struct
  ;; field values: no wire, no GPU, no provider, NO MEASUREMENT.
  (testing "a payload answers exactly when the record reports compute-stage subgroups"
    (is (= "32|basic"
           (targets/subgroup-answer {:subgroup-size 32 :supported-stages 0x20 :supported-ops 0x1})))
    (is (= "32|basic"
           (targets/subgroup-answer {:subgroup-size 32 :supported-stages 0x23 :supported-ops 0x1}))
        "other stage bits set alongside COMPUTE (0x20) change nothing")
    (is (nil? (targets/subgroup-answer {:subgroup-size 32 :supported-stages 0x1f :supported-ops 0x1}))
        "no COMPUTE in supported-stages -> nil, the named refusal gpu/no-compute-subgroups")
    (is (nil? (targets/subgroup-answer {:subgroup-size 32 :supported-stages 0x0 :supported-ops 0xff})))
    (is (nil? (targets/subgroup-answer {:subgroup-size 0 :supported-stages 0x20 :supported-ops 0x1})))
    (is (nil? (targets/subgroup-answer {:subgroup-size -8 :supported-stages 0x20 :supported-ops 0x1})))
    (is (nil? (targets/subgroup-answer {:subgroup-size 32.5 :supported-stages 0x20 :supported-ops 0x1})))
    (is (nil? (targets/subgroup-answer {:subgroup-size 32 :supported-stages 0x20 :supported-ops -1})))
    (is (nil? (targets/subgroup-answer {:subgroup-size 32 :supported-stages -32 :supported-ops 0x1})))
    (is (nil? (targets/subgroup-answer {:subgroup-size 32 :supported-stages 0x20})))
    (is (nil? (targets/subgroup-answer {})))
    (is (nil? (targets/subgroup-answer "32|basic")))
    (is (nil? (targets/subgroup-answer nil))))
  (testing "the eight core bits answer their tokens in the vocabulary order"
    (is (= "8|basic vote arithmetic ballot shuffle shuffle-relative clustered quad"
           (targets/subgroup-answer {:subgroup-size 8 :supported-stages 0x20 :supported-ops 0xff})))
    ;; single-bit pins: the raw values are the VkSubgroupFeatureFlagBits
    ;; registry values (verified 2026-10-23) -- a changed bit answers a
    ;; different token and fails here.
    (doseq [[bits token] [[0x1 "basic"] [0x2 "vote"] [0x4 "arithmetic"] [0x8 "ballot"]
                          [0x10 "shuffle"] [0x20 "shuffle-relative"] [0x40 "clustered"] [0x80 "quad"]]]
      (is (= (str "8|" token)
             (targets/subgroup-answer {:subgroup-size 8 :supported-stages 0x20 :supported-ops bits}))
          (str "VkSubgroupFeatureFlagBits bit " bits " is " token))))
  (testing "bits outside the core eight are masked off in v1 (decision 2)"
    (is (= "8|" (targets/subgroup-answer {:subgroup-size 8 :supported-stages 0x20 :supported-ops 0x100}))
        "partitioned (0x100) answers no token")
    (is (= "8|" (targets/subgroup-answer {:subgroup-size 8 :supported-stages 0x20 :supported-ops 0x200}))
        "rotate (0x200) answers no token")
    (is (= "8|" (targets/subgroup-answer {:subgroup-size 8 :supported-stages 0x20 :supported-ops 0x400}))
        "rotate-clustered (0x400) answers no token")
    (is (= "8|basic"
           (targets/subgroup-answer {:subgroup-size 8 :supported-stages 0x20 :supported-ops 0x701}))))
  (testing "an empty <ops> is the legal zero-ops fact, not a refusal (decision 2)"
    (is (= "32|" (targets/subgroup-answer {:subgroup-size 32 :supported-stages 0x20 :supported-ops 0}))))
  (testing "the producer's bytes are the consumer's facts (decisions 2/4 seam, round-trip)"
    (is (= {:subgroup-size 32 :subgroup-ops #{:basic :shuffle-relative}}
           (targets/device-from-subgroup
            (targets/subgroup-answer {:subgroup-size 32 :supported-stages 0x20 :supported-ops 0x21}))))
    (is (= {:subgroup-size 8 :subgroup-ops #{}}
           (targets/device-from-subgroup
            (targets/subgroup-answer {:subgroup-size 8 :supported-stages 0x20 :supported-ops 0x700})))
        "a record with only masked-off bits still answers the zero-ops fact"))
  (testing "same record in, same bytes out (ADR-0356 rule 5)"
    (let [record {:subgroup-size 64 :supported-stages 0x20 :supported-ops 0x21}]
      (is (= (targets/subgroup-answer record) (targets/subgroup-answer record))))))

(deftest the-row-split-is-four-measured-two-provisional
  ;; The honesty split the ns docstring states (corrected 2026-10-24,
  ;; docs/evidence/gpu/workgroup-prose-rootcause-20261024.txt): four rows
  ;; measured by ADR-0358 (2026-10-19), two provisional. A measured row
  ;; names its one measured device; a provisional row names none.
  (is (= #{:nvidia :apple :intel :amd}
         (set (for [[v row] targets/workgroup-defaults :when (:measured? row)] v)))
      "exactly the four ADR-0358 rows are measured")
  (is (= #{:arm :unknown}
         (set (for [[v row] targets/workgroup-defaults :when (not (:measured? row))] v)))
      "exactly :arm and :unknown stay provisional")
  (testing "a measured row names its one measured device; a provisional row names none"
    (doseq [[v row] targets/workgroup-defaults]
      (if (:measured? row)
        (is (and (string? (:measured-device row)) (pos? (count (:measured-device row))))
            (str v " is measured but names no measured device"))
        (is (nil? (:measured-device row))
            (str v " is provisional but carries a measured-device"))))))

;; The W3 arm extractor: the balanced-paren form beginning at `start` in
;; `text`, string literals aware. The `:kotoba` readings of this namespace are
;; what the W3 route compiles; the kbb gate executes the host readings, so the
;; W3 arm's behavior is tested by extracting the arm's OWN text from the
;; namespace source and running it on the kotoba language runtime.
(defn- extract-balanced [text start]
  (when-let [i (str/index-of text start)]
    (let [n (count text)]
      (loop [j i depth 0 in-str? false esc? false]
        (when (< j n)
          (let [c (str (nth text j))
                close? (and (not in-str?) (not esc?) (= c ")"))
                d (cond
                    esc? depth
                    in-str? depth
                    (= c "(") (inc depth)
                    (= c ")") (dec depth)
                    :else depth)]
            (if (and close? (zero? d))
              (subs text i (inc j))
              (recur (inc j) d
                     (cond
                       esc? in-str?
                       (and in-str? (= c "\\")) true
                       (= c "\"") (not in-str?)
                       :else in-str?)
                     (and in-str? (not esc?) (= c "\\"))))))))))

(deftest w3-name-lowering-lowers-a-z-and-nothing-else
  ;; The `:kotoba` reading of `string-ascii-lower` is the W3 route's device
  ;; name fold: classify-vendor's name matching and the uB5G measured-device
  ;; scoping key both run it. Tested through kotoba.sema/analyze +
  ;; kotoba.kir/execute over the arm's extracted text (no
  ;; kotoba.compiler.core, whose kotoba.form require is the suite's named
  ;; red-at-base). The replaced arm appended `string-from-i64` DECIMAL text
  ;; per code point -- measured on the runtime before the fix: "A" -> "97",
  ;; "AB" -> "9798", "Hi" -> "104105", "42" -> "5250", and "NVIDIA" trapped
  ;; host/stack-exhausted -- so this test pins both the fold's contract and
  ;; the arm's delegation to the primitive.
  (let [src (slurp "src/kotoba/compiler/accelerator_targets.cljk")
        arm (extract-balanced src "(defn- string-ascii-lower")
        probe (str "(ns accelerator.targets.w3.arm.probe (:export [main lower]))\n"
                   "(defn main [] :i64 0)\n"
                   arm "\n"
                   "(defn lower [s :string] :string (string-ascii-lower s))")
        hir (sema/analyze probe)
        fold (fn [s] (ir/execute hir 'lower [s]))]
    (is (string? arm) "the W3 arm is extractable from the namespace source")
    (is (str/includes? arm "string-fold-ascii")
        "the arm lowers through the language primitive")
    (is (not (str/includes? arm "lower-walk"))
        "the decimal-appending walk is gone from the arm text")
    (is (not (str/includes? arm "string-from-i64"))
        "the arm never renders an i64 to build string text")
    (testing "A-Z lowered, nothing else (the string-fold-ascii contract)"
      (is (= "nvidia geforce rtx 4090" (fold "NVIDIA GeForce RTX 4090")))
      (is (= "apple m1 max" (fold "Apple M1 Max")))
      (is (= "mali-g78 mp24" (fold "Mali-G78 MP24")))
      (is (= "rtx 4090" (fold "RTX 4090")) "digits are untouched")
      (is (= "cafÉ" (fold "CAFÉ")) "a non-ASCII letter is untouched")
      (is (= "" (fold ""))))
    (testing "the folded name carries the fragments the call sites search for"
      (is (str/includes? (fold "NVIDIA GeForce RTX 4090") "geforce"))
      (is (str/includes? (fold "Apple M1 Max") "m1 max"))
      (is (str/includes? (fold "Intel(R) Iris(R) Xe Graphics") "iris")))))
