(ns kotoba.compiler.accelerator-pipeline-test
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            [kotoba.compiler.accelerator :as accelerator]
            [kotoba.compiler.accelerator-targets :as targets]
            [kotoba.compiler.accelerator-pipeline :as pipeline]))

(def spec {:kernel/name "ewise_add_f32" :kernel/op :ewise :kernel/operator :add})

(deftest every-vendor-dispatches-and-emits
  (testing "the five major vendors each reach a sealed artifact through dispatch"
    (doseq [[device expected-target expected-measured]
            [[{:vendor-id 4318} :cuda-v1 true]
             [{:vendor-id 4203} :msl-v1 true]
             [{:vendor-id 32902} :wgsl-v1 true]
             [{:vendor-id 5045} :wgsl-v1 false]
             [{:vendor-id 4098} :wgsl-v1 true]]]
      (let [{:keys [artifact dispatch]} (pipeline/compile-spec spec device)]
        (is (= expected-target (:target dispatch)))
        (is (= artifact (accelerator/verify-artifact! artifact)))
        (is (= expected-target (:target artifact)))
        (is (= expected-measured (:measured? dispatch)))))))

(deftest api-overrides-vendor
  (testing "an api that names its shading language decides outright"
    (is (= :msl-v1 (:target (:dispatch (pipeline/compile-spec spec {:vendor-id 4318 :api :metal})))))
    (is (= :cuda-v1 (:target (:dispatch (pipeline/compile-spec spec {:vendor-id 4098 :api :cuda}))))))
  (testing ":vulkan answers :glsl-v1 end to end (ADR-0359 decision 3)"
    (let [{:keys [artifact dispatch]} (pipeline/compile-spec spec {:vendor-id 32902 :api :vulkan})]
      (is (= :glsl-v1 (:target dispatch)))
      (is (= :glsl-v1 (:target artifact)))
      (is (= artifact (accelerator/verify-artifact! artifact))))))

(deftest unknown-device-is-total
  (testing "an unknown device takes the portable fallback, never a throw"
    (let [{:keys [dispatch]} (pipeline/compile-spec spec {})]
      (is (= :unknown (:vendor dispatch)))
      (is (= :wgsl-v1 (:target dispatch)))
      (is (= 256 (:workgroup-size dispatch))))))

(deftest workgroup-provenance-is-recorded
  (testing "the provisional dispatch default is labelled, a SPEC size wins"
    (is (= [:dispatch 256] ((juxt :workgroup-source :workgroup-size)
                            (:dispatch (pipeline/compile-spec spec {:vendor-id 4318})))))
    (is (= [:spec 64] ((juxt :workgroup-source :workgroup-size)
                       (:dispatch (pipeline/compile-spec
                                    (assoc spec :kernel/workgroup-size 64)
                                    {:vendor-id 4318})))))
    (is (= [:spec 64] ((juxt :workgroup-source :workgroup-size)
                       (:dispatch (pipeline/compile-spec
                                    (assoc spec :kernel/workgroup-size #?(:cljs (js/BigInt "64") :clj 64))
                                    {:vendor-id 4318})))))
    (is (= 64 (get-in (:artifact (pipeline/compile-spec
                                   (assoc spec :kernel/workgroup-size 64)
                                   {:vendor-id 4318}))
                      [:limits :workgroup-size])))
    (testing "a non-integer explicit size is an input error, not a silent default"
      (is (thrown? js/Error (pipeline/compile-spec
                              (assoc spec :kernel/workgroup-size "64")
                              {:vendor-id 4318}))))))

(deftest same-input-same-artifact
  (testing "dispatch adds no nondeterminism to the artifact regime"
    (is (= (:artifact (pipeline/compile-spec spec {:vendor-id 4203}))
           (:artifact (pipeline/compile-spec spec {:vendor-id 4203}))))))

(deftest reader-integer-ids-classify
  (testing "the kotoba reader's BigInt integer tokens still match the id table"
    (let [id #?(:cljs (js/BigInt "4203") :clj 4203)]
      (is (= :apple (targets/classify-vendor {:vendor-id id})))
      (is (= :msl-v1 (:target (:dispatch (pipeline/compile-spec spec {:vendor-id id}))))))))

(deftest invalid-spec-refuses
  (testing "an operator outside the op's set refuses before any emission"
    (is (thrown? js/Error (pipeline/compile-spec
                            (assoc spec :kernel/operator :sum)
                            {:vendor-id 4318})))))

;; JUN-56's dispatch seam: the variant rows reach the sealed artifact.
(def reduce-spec
  {:kernel/name "reduce_sum_f32" :kernel/op :reduce :kernel/operator :sum
   :kernel/workgroup-size 128})

(deftest variant-selection-reaches-the-artifact
  (testing "rule-6 subgroup facts select :subgroup-reduce and the artifact carries it"
    (let [device {:vendor-id 32902 :subgroup-size 16
                  :subgroup-ops #{:basic :shuffle-relative}}
          {:keys [artifact dispatch]} (pipeline/compile-spec reduce-spec device)]
      (is (= :subgroup-reduce (:variant dispatch)))
      (is (= :subgroup-reduce (:variant artifact)))
      (is (false? (:variant-measured? dispatch)))
      (is (str/includes? (:code artifact) "subgroupShuffleDown"))
      (is (= artifact (accelerator/verify-artifact! artifact)))))
  (testing "an absent rule-6 fact fails closed to :baseline, never a guess"
    (let [{:keys [artifact dispatch]} (pipeline/compile-spec reduce-spec {:vendor-id 32902})]
      (is (= :baseline (:variant dispatch)))
      (is (= :baseline (:variant artifact)))
      (is (not (str/includes? (:code artifact) "subgroupShuffleDown")))))
  (testing "a malformed subgroup fact fails closed too (all-or-nothing)"
    (let [{:keys [artifact dispatch]}
          (pipeline/compile-spec reduce-spec
                                 {:vendor-id 32902 :subgroup-size 16
                                  :subgroup-ops #{:basic}})]
      (is (= :baseline (:variant dispatch)))
      (is (not (str/includes? (:code artifact) "subgroupShuffleDown"))))))

(deftest cuda-ladder-reaches-the-artifact
  (testing "a confirmed sm_70+ takes the warp row (the ladder's first rung)"
    (let [{:keys [artifact dispatch]}
          (pipeline/compile-spec reduce-spec {:vendor-id 4318 :compute-capability 7.5})]
      (is (= :warp-shuffle-reduce (:variant dispatch)))
      (is (= :warp-shuffle-reduce (:variant artifact)))
      (is (false? (:variant-measured? dispatch)))
      (is (str/includes? (:code artifact) "__shfl_down_sync(0xffffffffu"))))
  (testing "a confirmed capability below 7.0 fails closed to :baseline"
    (let [{:keys [artifact dispatch]}
          (pipeline/compile-spec reduce-spec
                                 {:vendor-id 4318 :compute-capability 6.0
                                  :subgroup-size 32
                                  :subgroup-ops #{:basic :shuffle-relative}})]
      (is (= :baseline (:variant dispatch)))
      (is (not (str/includes? (:code artifact) "warpSize")))))
  (testing "no capability but rule-6 facts: the parametric fold's second rung"
    (let [{:keys [artifact dispatch]}
          (pipeline/compile-spec reduce-spec
                                 {:vendor-id 4318 :subgroup-size 32
                                  :subgroup-ops #{:basic :shuffle-relative}})]
      (is (= :subgroup-reduce (:variant dispatch)))
      (is (str/includes? (:code artifact) "warpSize")))))

(deftest variant-selection-is-deterministic-and-ewise-stays-baseline
  (let [device {:vendor-id 32902 :subgroup-size 16
                :subgroup-ops #{:basic :shuffle-relative}}]
    (testing "same SPEC and DEVICE in, byte-identical artifact out"
      (is (= (:artifact (pipeline/compile-spec reduce-spec device))
             (:artifact (pipeline/compile-spec reduce-spec device)))))
    (testing "the rows are :reduce rows: an ewise kernel keeps :baseline"
      (is (= :baseline (:variant (:dispatch (pipeline/compile-spec spec device))))))))

(deftest the-flip-reaches-the-dispatch-report
  ;; ADR-0360 question (1)'s 2026-10-23 decision (JUN-58), end to end: the
  ;; measured cells' :measured? true rides into the dispatch report as
  ;; :variant-measured?, and the workgroup row's :measured? stays its own
  ;; axis (they are evidence about different things).
  (let [m1-spec {:kernel/name "reduce_sum_f32" :kernel/op :reduce
                 :kernel/operator :sum :kernel/workgroup-size 256}
        device {:vendor "Apple M1 Max" :subgroup-size 32
                :subgroup-ops #{:basic :shuffle-relative}}
        {:keys [artifact dispatch]} (pipeline/compile-spec m1-spec device)]
    (is (= :baseline (:variant dispatch)))
    (is (= :baseline (:variant artifact)))
    (is (true? (:variant-measured? dispatch)))
    (is (= artifact (accelerator/verify-artifact! artifact)))
    (testing "the decided W = 32 cell keeps the lock (the low band's one mixed cell)"
      ;; W = 64/128 join the flipped widths with the low-band measurement;
      ;; W = 32 is the one cell whose measurement chose nothing (its signs
      ;; are scoped to the slow clock regime) -- its :baseline is a
      ;; decision and keeps the lock, end to end through the report.
      (let [decided (assoc m1-spec :kernel/workgroup-size 32)]
        (is (false? (:variant-measured?
                     (:dispatch (pipeline/compile-spec decided device)))))))))
