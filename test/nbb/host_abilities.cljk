(ns test.nbb.host-abilities
  "The nbb handlers of the compiler's abilities (superproject adr-2609242330
  S5) and the pure path module that replaced node:path.

  Two kinds of check. The path functions are compared with node:path itself
  over fixed cases and a seeded random corpus -- they must answer the same
  string, since compiler output locations and diagnostics are spelled with
  them. The handlers are checked against the catalog's wire shapes, and
  hash/sha256 against the pure org-nist-sha2 library: the ability exists for
  speed, so its value must be the pure library's value."
  (:require ["node:fs" :as fs]
            ["node:os" :as os]
            ["node:path" :as node-path]
            [kotoba.compiler.json-text :as json-text]
            [kotoba.compiler.posix-path :as posix-path]
            [kotoba.compiler.project :as project]
            [kotoba.compiler.project-files :as project-files]
            [kotoba.kir :as ir]
            [kotoba.sema :as sema]
            [kotoba.compiler.text-bytes :as text-bytes]
            [kotoba.lang.json :as json]
            [kotoba.compiler.nbb.host.cli :as cli]
            [kotoba.compiler.nbb.host.clock :as clock]
            [kotoba.compiler.nbb.host.env :as env]
            [kotoba.compiler.nbb.host.fs :as host-fs]
            [kotoba.compiler.nbb.host.hash :as hash]
            [kotoba.compiler.nbb.host.entropy :as entropy]
            [kotoba.compiler.nbb.host.process :as process]
            [kotoba.compiler.nbb.host.sys :as sys]
            [kotoba.compiler.nbb.fs-tree :as fs-tree]
            [kotoba.compiler.process-wire :as process-wire]
            [kotoba.compiler.host-integer :as host-integer]
            [kotoba.compiler.base64-text :as base64-text]
            [kotoba.bytes :as pure-bytes]
            [sha2.core :as sha2]))

(def failures (volatile! []))
(def checks (volatile! 0))

(defn check! [ok? label & detail]
  (vswap! checks inc)
  (when-not ok? (vswap! failures conj (into [label] detail))))

;; ---- posix-path against node:path ----

(def fixed
  ["" "/" "//" "///" "." ".." "./" "../" "a" "a/" "/a" "/a/" "a/b" "/a/b/"
   "a//b" "a/./b" "a/../b" "../a" "../../a/b" "/.." "/../a" "a/.." "a/../.."
   "./a/./b/." "examples/foo.kotoba" "/tmp/out.kexe" "out.wasm.provenance.edn"
   "..a" "a.." ".a/..b/..." "/é/ü/" "日本/語" "a/b/c/../../d" "//a" "a/b//"])

(defn- lcg [seed] (mod (+ (* seed 48271) 11) 2147483647))

(def alphabet ["/" "/" "." "." ".." "a" "b" "é" "日"])

(defn- random-paths [n]
  (loop [i 0 seed 12345 out []]
    (if (= i n)
      out
      (let [seed (lcg seed)
            len (mod seed 9)
            [seed parts] (loop [k 0 seed seed parts []]
                           (if (= k len)
                             [seed parts]
                             (let [seed (lcg seed)]
                               (recur (inc k) seed (conj parts (nth alphabet (mod seed (count alphabet))))))))]
        (recur (inc i) seed (conj out (apply str parts)))))))

(let [corpus (into fixed (random-paths 4000))]
  (doseq [p corpus]
    (check! (= (.basename node-path p) (posix-path/basename p)) :basename p)
    (check! (= (.dirname node-path p) (posix-path/dirname p)) :dirname p)
    (check! (= (.normalize node-path p) (posix-path/normalize p)) :normalize p))
  (doseq [[a b] (map vector corpus (rest corpus))]
    (check! (= (.join node-path a b) (posix-path/join a b)) :join a b)))

;; The same module's KOTOBA reading, run: linked, analyzed, lowered to KIR and
;; executed by the reference interpreter, against node:path. This is the
;; reading the leaves' `:kotoba` branches select (byte offsets,
;; string-find-byte), which the nbb comparison above never executes.
(let [file (.join node-path (.cwd js/process) "src" "kotoba" "compiler" "posix_path.cljk")
      graph (project-files/load-closed-graph file [(.join node-path (.cwd js/process) "src")])
      linked (project/link-source (:sources graph) (:root graph))
      kir (ir/lower (sema/analyze (:source linked) {:admit-linked-synthetics? true}) {})
      run (fn [f args] (try (ir/execute kir f args {:fuel 10000000})
                            (catch :default e (str "TRAP " (ex-message e)))))
      corpus (into fixed (take 150 (random-paths 4000)))]
  (doseq [p corpus]
    (check! (= (.basename node-path p) (run 'basename [p])) :kotoba-basename p)
    (check! (= (.dirname node-path p) (run 'dirname [p])) :kotoba-dirname p)
    (check! (= (.normalize node-path p) (run 'normalize [p])) :kotoba-normalize p))
  (doseq [[a b] (map vector corpus (rest corpus))]
    (check! (= (.join node-path a b) (run 'join [a b])) :kotoba-join a b)))

;; ---- leaves: the nbb reading against the pure library / builtin meaning ----

(def text-pool ["a" "\"" "\\" "\n" "\t" "\u0001" "\u001f" "\u007f" "é" "日" "😀" "/"
                "\u2028" " " "kotoba"])

(defn- random-text [seed n]
  (loop [i 0 seed seed out ""]
    (if (= i n)
      [seed out]
      (let [seed (lcg seed)]
        (recur (inc i) seed (str out (nth text-pool (mod seed (count text-pool)))))))))

(loop [k 0 seed 99]
  (when (< k 3000)
    (let [[seed a] (random-text seed (mod seed 48))
          [seed b] (random-text (lcg seed) 6)
          key-shape ["kotoba.compile-cache/v4" a (odd? seed) (:text {}) b nil]
          response {:format "kotoba.compiler-worker/v1" :type "result" :id (when (odd? k) b)
                    :status (mod seed 80) :stdout a :stderr b :timing nil}
          timing {:format "kotoba.compiler-timing/v1"
                  :totalMilliseconds (/ seed 1000.0)
                  :phases [{:phase "frontend" :milliseconds (/ (lcg seed) 7.0)}
                           {:phase a :milliseconds 0.1}]}]
      (check! (= (json/encode key-shape) (json-text/encode-array key-shape)) :json-leaf key-shape)
      ;; Maps are NOT a json-text shape: the pure library sorts keys. Pinned
      ;; so the day they agree is noticed rather than assumed.
      (check! (or (<= (count response) 1)
                  (not= (json/encode response) (.stringify js/JSON (clj->js response))))
              :json-map-order-differs response)
      (check! (= (count (js/Array.from (js/Buffer.from a "utf8"))) (text-bytes/utf8-length a))
              :utf8-length a)
      (check! (= a (text-bytes/utf8-text (js/Buffer.from a "utf8"))) :utf8-text a)
      (recur (inc k) seed))))

(check! (try (text-bytes/utf8-text (js/Buffer.from #js [0xC0 0x80])) false
             (catch :default _ true))
        :utf8-text-refuses-overlong)
(check! (= [1 2 255] (vec (js/Array.from (text-bytes/bytes-from-ints [1 2 255])))) :bytes-from-ints)
(check! (= 3 (text-bytes/bytes-length (text-bytes/bytes-from-ints [1 2 255]))) :bytes-length)

;; ---- handler shapes ----

(aset js/process.env "KOTOBA_HOST_ABILITY_PROBE" "value=1")
(js-delete js/process.env "KOTOBA_HOST_ABILITY_UNSET")
(check! (= "value=1" (env/read "KOTOBA_HOST_ABILITY_PROBE")) :env-set)
(check! (= "" (env/read "KOTOBA_HOST_ABILITY_UNSET")) :env-unset)

(let [argv (vec *command-line-args*)]
  (check! (= (str (count argv)) (cli/args "")) :args-count)
  (check! (= "" (cli/args (str (count argv)))) :args-past-end)
  (check! (try (cli/args "-1") false (catch :default _ true)) :args-malformed))

(let [a (js/BigInt (clock/now "monotonic"))
      b (js/BigInt (clock/now "monotonic"))
      wall (js/Number (clock/now "wall"))]
  (check! (<= a b) :monotonic)
  (check! (< (js/Math.abs (- wall (js/Date.now))) 600000) :wall)
  (check! (try (clock/now "utc") false (catch :default _ true)) :clock-unknown-form))

;; hash/sha256: the handler's value is the pure library's value, for a text
;; request (UTF-8) and a byte request.
(let [bytes-of (fn [b] (vec (js/Array.from b)))
      hex (fn [bs] (apply str (map #(.padStart (.toString % 16) 2 "0") bs)))]
  (doseq [text ["" "abc" "kotoba.compile-cache/v4" "日本語 ü" (apply str (repeat 3000 "x"))]]
    (let [pure (hex (sha2/sha256 (bytes-of (js/Buffer.from text "utf8"))))]
      (check! (= pure (hash/sha256 text)) :sha256-text text)
      (check! (= pure (hash/sha256 (js/Buffer.from text "utf8"))) :sha256-bytes text))))

;; fs/app-data and fs/browse against a private directory.
(let [dir (.mkdtempSync fs (.join node-path (.tmpdir os) "amu-host-fs-"))
      f (.join node-path dir "a.txt")
      g (.join node-path dir "b.txt")
      sub (.join node-path dir "sub")]
  (try
    (check! (= "0" (host-fs/app-data (str f "EXISTS_SEP"))) :exists-absent)
    (check! (= "héllo" (host-fs/app-data (str f "WRITE_SEPhéllo"))) :write-answers-content)
    (check! (= "héllo" (host-fs/app-data f)) :read)
    (check! (= "1" (host-fs/app-data (str f "EXISTS_SEP"))) :exists)
    (check! (re-matches #"[0-7]+ 6 [0-9]+ 0" (host-fs/app-data (str f "STAT_SEP"))) :stat)
    (check! (= "" (host-fs/app-data (str g "STAT_SEP"))) :stat-absent)
    (check! (re-matches #"[0-9]+" (host-fs/app-data (str f "MTIME_SEP"))) :mtime)
    (check! (= "1" (host-fs/app-data (str sub "MKDIR_SEP"))) :mkdir)
    (check! (= "0" (host-fs/app-data (str sub "MKDIR_SEP"))) :mkdir-again)
    (check! (= "a.txt\t0\nsub\t1" (host-fs/browse dir)) :browse)
    (check! (= "1" (host-fs/app-data (str f "RENAME_SEP" g))) :rename)
    (check! (= "1" (host-fs/app-data (str g "UNLINK_SEP"))) :unlink)
    (check! (= "1" (host-fs/app-data (str sub "RMDIR_SEP"))) :rmdir)
    (check! (= "" (host-fs/browse dir)) :browse-empty)
    (finally (.rmSync fs dir #js {:recursive true :force true}))))

;; ---- the forms added in S5's second half (2026-09-25) ----
;; Each against a private directory; every answer is the catalog's shape, and
;; every refusal is pinned by the literal of its reason.
(let [dir (.mkdtempSync fs (.join node-path (.tmpdir os) "amu-host-fs2-"))
      f (str dir "/f.txt")
      bin (str dir "/b.bin")
      link (str dir "/link")
      missing (str dir "/missing")
      reason (fn [thunk] (try (thunk) :no-error (catch :default e (or (:reason (ex-data e)) (ex-message e)))))
      uid (.getuid js/process)]
  (try
    ;; WRITE creates 0644 & ~umask, O_NOFOLLOW; APPEND needs the file.
    (check! (= "ab" (host-fs/app-data (str f "WRITE_SEPab"))) :write)
    (check! (= "cd" (host-fs/app-data (str f "APPEND_SEPcd"))) :append-answers-content)
    (check! (= "abcd" (host-fs/app-data f)) :append-appended)
    (check! (not= :no-error (reason #(host-fs/app-data (str missing "APPEND_SEPx")))) :append-needs-the-file)
    ;; A content form is taken by its EARLIEST token.
    (check! (= "xAPPEND_SEPy" (host-fs/app-data (str f "WRITE_SEPxAPPEND_SEPy"))) :write-content-holds-a-token)
    (check! (= "xAPPEND_SEPy" (host-fs/app-data f)) :write-content-verbatim)
    ;; RANGE: exactly the window, inside a regular file; outside is refused.
    (host-fs/app-data (str f "WRITE_SEPhello"))
    (check! (= "ell" (host-fs/app-data (str f "RANGE_SEP1:3"))) :range)
    (check! (= "" (host-fs/app-data (str f "RANGE_SEP5:0"))) :range-empty-at-end)
    (check! (= :fs/range-outside (reason #(host-fs/app-data (str f "RANGE_SEP3:3")))) :range-past-end)
    (check! (= "fs/app-data RANGE spec must be <offset>:<length>"
               (reason #(host-fs/app-data (str f "RANGE_SEP1-3"))))
            :range-malformed)
    ;; CHMOD: permission bits only; 1..6 octal digits.
    (check! (= "1" (host-fs/app-data (str f "CHMOD_SEP600"))) :chmod)
    (check! (= "384 5 " (subs (host-fs/app-data (str f "STAT_SEP")) 0 6)) :chmod-600)
    (check! (= "1" (host-fs/app-data (str f "CHMOD_SEP4755"))) :chmod-setuid)
    (check! (= 493 (bit-and (.-mode (.statSync fs f)) 4095)) :chmod-drops-setuid)
    (check! (= "fs/app-data CHMOD takes 1..6 octal digits"
               (reason #(host-fs/app-data (str f "CHMOD_SEP8")))) :chmod-8)
    (check! (= "fs/app-data CHMOD takes 1..6 octal digits"
               (reason #(host-fs/app-data (str f "CHMOD_SEP1234567")))) :chmod-7-digits)
    (check! (= "0" (host-fs/app-data (str missing "CHMOD_SEP600"))) :chmod-absent)
    ;; FSYNC of a file and of a directory; 0 when it cannot be opened.
    (check! (= "1" (host-fs/app-data (str f "FSYNC_SEP"))) :fsync-file)
    (check! (= "1" (host-fs/app-data (str dir "FSYNC_SEP"))) :fsync-dir)
    (check! (= "0" (host-fs/app-data (str missing "FSYNC_SEP"))) :fsync-absent)
    ;; MKTEMP: a new 0700 directory <dir>/<prefix>XXXXXX; "" when <dir> fails.
    (let [a (host-fs/app-data (str dir "MKTEMP_SEP.p-"))
          b (host-fs/app-data (str dir "MKTEMP_SEP.p-"))]
      (check! (and (.startsWith a (str dir "/.p-")) (= (+ (count dir) 10) (count a))) :mktemp-name a)
      (check! (not= a b) :mktemp-fresh)
      (check! (= 448 (bit-and (.-mode (.statSync fs a)) 511)) :mktemp-0700))
    (check! (= "" (host-fs/app-data (str missing "MKTEMP_SEP.p-"))) :mktemp-absent-dir)
    (check! (= "fs/app-data MKTEMP prefix must not hold / or NUL"
               (reason #(host-fs/app-data (str dir "MKTEMP_SEPa/b")))) :mktemp-slash)
    ;; NOFOLLOW: the final component itself; OWNER: its uid and ours.
    (.symlinkSync fs f link)
    (check! (re-matches #"[0-9]+ [0-9]+ [0-9]+ 2" (host-fs/app-data (str link "NOFOLLOW_SEP"))) :nofollow-symlink)
    (check! (re-matches #"[0-9]+ 5 [0-9]+ 0" (host-fs/app-data (str f "NOFOLLOW_SEP"))) :nofollow-file)
    (check! (re-matches #"[0-9]+ [0-9]+ [0-9]+ 1" (host-fs/app-data (str dir "NOFOLLOW_SEP"))) :nofollow-dir)
    (check! (= "" (host-fs/app-data (str missing "NOFOLLOW_SEP"))) :nofollow-absent)
    (check! (= (str uid " " uid) (host-fs/app-data (str f "OWNER_SEP"))) :owner-self)
    (check! (= (str "0 " uid) (host-fs/app-data "/OWNER_SEP")) :owner-root)
    (check! (= "" (host-fs/app-data (str missing "OWNER_SEP"))) :owner-absent)
    ;; WRITE does not follow a final symlink; RANGE does not either.
    (check! (not= :no-error (reason #(host-fs/app-data (str link "WRITE_SEPz")))) :write-nofollow)
    (check! (not= :no-error (reason #(host-fs/app-data (str link "RANGE_SEP0:1")))) :range-nofollow)
    ;; The bytes payload.
    (let [payload (js/Buffer.from #js [0 255 1 128 10])]
      (host-fs/app-data-bytes (str bin "WRITE_SEP") payload)
      (check! (.equals payload (host-fs/app-data-bytes bin)) :bytes-read)
      (check! (.equals (.subarray payload 1 4) (host-fs/app-data-bytes (str bin "RANGE_SEP1:3"))) :bytes-range)
      (check! (= :fs/invalid-utf8 (reason #(host-fs/app-data bin))) :text-read-refuses-bytes))
    ;; fs-tree over the handler.
    (fs-tree/make-directories! (str dir "/t/u/v"))
    (check! (fs-tree/directory? (str dir "/t/u/v")) :make-directories)
    (fs-tree/make-directories! (str dir "/t/u/v"))
    (check! (fs-tree/directory? (str dir "/t/u/v")) :make-directories-again)
    (.writeFileSync fs (str dir "/t/u/x") "x")
    (.symlinkSync fs f (str dir "/t/u/out"))
    (check! (= ["out" "v" "x"] (fs-tree/entries (str dir "/t/u"))) :entries)
    (check! (= 2 (fs-tree/kind (str dir "/t/u/out"))) :kind-symlink)
    (fs-tree/remove-tree! (str dir "/t"))
    (check! (not (fs-tree/exists? (str dir "/t"))) :remove-tree)
    (check! (= "hello" (.readFileSync fs f "utf8")) :remove-tree-never-follows)
    (finally (.rmSync fs dir #js {:recursive true :force true}))))

;; ---- entropy/draw ----
(let [draws (repeatedly 200 #(entropy/draw "16"))]
  (check! (every? #(re-matches #"[0-9a-f]{32}" %) draws) :draw-shape)
  (check! (= 200 (count (set draws))) :draw-distinct)
  (check! (= 512 (count (entropy/draw "256"))) :draw-256)
  (doseq [bad ["0" "257" "" "-1" "01" "1.5" "abc"]]
    (check! (try (entropy/draw bad) false
                 (catch :default e (= "entropy/draw request must be a decimal count 1..256" (ex-message e))))
            :draw-refused bad)))

;; ---- process/spawn and its wire ----
(let [node-run (fn [& args] (process/spawn (process-wire/request "node" (vec args))))
      reason (fn [thunk] (try (thunk) :no-error (catch :default e (or (:reason (ex-data e)) (ex-message e)))))]
  (check! (= "0\nhi" (node-run "-e" "process.stdout.write('hi')")) :spawn-stdout)
  (check! (= "7\n" (node-run "-e" "process.exit(7)")) :spawn-exit)
  (check! (= "-1\n" (node-run "-e" "process.kill(process.pid,'SIGKILL')")) :spawn-signal)
  (check! (= "0\n" (node-run "-e" "process.stdin.on('data',()=>process.stdout.write('x'));process.stdin.on('end',()=>{})")) :spawn-stdin-eof)
  (aset js/process.env "KOTOBA_SPAWN_PROBE_SECRET" "leak")
  (check! (= "0\nundefined|string"
             (node-run "-e" "process.stdout.write(String(process.env.KOTOBA_SPAWN_PROBE_SECRET)+'|'+typeof process.env.PATH)"))
          :spawn-env-allow-list)
  (check! (= (str "0\n" (.-execPath js/process)) (node-run "-e" "process.stdout.write(process.execPath)")) :spawn-node-is-exec-path)
  (check! (= "0\na|b c|" (node-run "-e" "process.stdout.write(process.argv.slice(1).join('|'))" "a" "b c" ""))
          :spawn-argv-verbatim)
  (check! (re-matches #"0\n[0-9a-f]{40}\n" (process/spawn (process-wire/request "git" ["-C" "." "rev-parse" "HEAD"]))) :spawn-git)
  (check! (= :spawn/program-not-granted (reason #(process/spawn "sh"))) :spawn-not-granted)
  (check! (= :spawn/program-not-granted (reason #(process/spawn "/bin/echo"))) :spawn-absolute-not-granted)
  (check! (= "process/spawn request names no program" (reason #(process/spawn "ARG_SEPx"))) :spawn-empty-program)
  (check! (= "process/spawn request must not hold NUL" (reason #(process/spawn "node\u0000"))) :spawn-nul)
  (check! (= :spawn/output-budget
             (reason #(node-run "-e" "process.stdout.write('x'.repeat(64*1024*1024+1))")))
          :spawn-output-budget)
  (check! (= "process/spawn argument holds the ARG_SEP token"
             (reason #(process-wire/request "node" ["xARG_SEPy"])))
          :wire-refuses-separator)
  (check! (= [7 "a\nb"] [(process-wire/answer-exit "7\na\nb") (process-wire/answer-out "7\na\nb")]) :wire-answer)
  (check! (= -1 (process-wire/answer-exit "-1\n")) :wire-signal))

;; ---- host facts and leaves ----
(check! (= (.cwd js/process) (sys/cwd "")) :cwd)
(check! (= 5 (host-integer/narrow (js/BigInt 5))) :narrow)
(check! (= (js/BigInt "9007199254740993") (host-integer/exact "9007199254740993")) :exact)
(check! (= [true false] [(host-integer/safe-integer? 9007199254740991) (host-integer/safe-integer? 9007199254740992)]) :safe-integer)
(check! (= [12 nil 1000] [(host-integer/decimal-count "12") (host-integer/decimal-count "x") (host-integer/decimal-count "1e3")]) :decimal-count)
(check! (= [5 (js/BigInt "9007199254740991")]
           [(host-integer/narrow-below-max-safe (js/BigInt 5))
            (host-integer/narrow-below-max-safe (js/BigInt "9007199254740991"))])
        :narrow-below-max-safe)
(let [rng (let [state (volatile! 2609251)] (fn [n] (vswap! state #(mod (+ (* % 1103515245) 12345) 2147483648)) (mod @state n)))]
  (doseq [n (concat (range 0 70) [1000 4097 65536])]
    (let [b (js/Buffer.from (clj->js (vec (repeatedly n #(rng 256)))))
          text (base64-text/encode b)]
      (check! (= text (pure-bytes/base64-encode b)) :base64-encode-pure n)
      (check! (.equals b (base64-text/decode text)) :base64-round-trip n)
      (check! (= (vec (js/Array.from b)) (pure-bytes/base64-decode text)) :base64-decode-pure n))))
(let [b (text-bytes/concat-bytes (text-bytes/utf8-bytes "ab\r") (js/Buffer.from #js [10 0xC3 0x28]))]
  (check! (= 6 (text-bytes/bytes-length b)) :concat)
  (check! (= 3 (text-bytes/index-of-byte b 10)) :index-of-byte)
  (check! (= -1 (text-bytes/index-of-byte b 9)) :index-of-byte-absent)
  (check! (= 13 (text-bytes/byte-at b 2)) :byte-at)
  (check! (= "ab" (text-bytes/utf8-text-lossy (text-bytes/slice-bytes b 0 2))) :slice)
  (check! (= "�(" (text-bytes/utf8-text-lossy (text-bytes/slice-bytes b 4 6))) :lossy)
  (check! (= 0 (text-bytes/bytes-length (text-bytes/empty-bytes))) :empty))
(doseq [line ["{\"id\":7,\"op\":\"run\",\"args\":[\"compile\",\"x.kotoba\"]}"
              "{\"id\":\"a\",\"op\":\"shutdown\"}" "{\"id\":null,\"args\":[]}"
              "{\"n\":{\"deep\":[1,2,{\"k\":\"v\\u00e9\"}]}}"]]
  (check! (= (json-text/decode-object line)
             (let [walk (fn walk [v] (cond (map? v) (into {} (map (fn [[k x]] [(keyword k) (walk x)])) v)
                                           (vector? v) (mapv walk v) :else v))]
               (walk (json/decode line))))
          :decode-object-pure line))

(println (str "host-abilities: " @checks " checks, " (count @failures) " failed"))
(when (seq @failures)
  (doseq [f (take 20 @failures)] (println "FAIL" (pr-str f)))
  (.exit js/process 1))
(when (zero? @checks)
  (println "host-abilities: no checks ran")
  (.exit js/process 2))
