(ns fixture.general-document-map (:export [main value]))

(defn value [] :document
  (document-map
   :ready (document-bool true)
   (document-vector (document-i64 1)) (document-string "value")))

(defn main [] :i64
  (if (document-equal? (value) (document-edn-read "{:ready true [1] \"value\"}"))
    42
    1))
