(defn add [a b] (+ a b))
(defn sum ([] 0) ([acc value] (+ acc value)))

(defn main []
  (let [offset 2
        add-offset (fn [x] (+ x offset))
        direct (add-offset 1)
        mapped (map add-offset [1])
        wide (map (fn [a b c d e] (+ a (+ b (+ c (+ d e)))))
                  [1] [2] [3] [4] [5])
        keep? (fn [x] (> x 2))
        filtered (filter keep? mapped)]
    (+ (vector-at wide 0)
       (+ direct
       (+ (reduce sum filtered)
          (+ (reduce sum [])
             (apply (fn-ref add) (list 19 20))))))))
