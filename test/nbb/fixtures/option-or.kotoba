(ns fixture.option-or (:export [main name]))

(defn maybe-name [present :bool] [:option :string]
  (if present
    (option-some-of [:option :string] "kotoba")
    (option-none-of [:option :string])))

(defn name [] :string
  (option-or (maybe-name false) "guest"))

(defn main [] :i64
  (if (string=? (name) "guest") 42 1))
