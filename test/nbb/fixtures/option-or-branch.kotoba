(ns fixture.option-or-branch (:export [main]))

(defn maybe [value :i64] [:option :i64]
  (option-some-of [:option :i64] value))

(defn main [] :i64
  (match-option (maybe 7) [:option :i64]
    (none 1)
    (some payload
      (let [nested (if (> payload 0)
                     (option-some-of [:option :i64] payload)
                     (option-none-of [:option :i64]))]
        (option-or nested 1)))))
