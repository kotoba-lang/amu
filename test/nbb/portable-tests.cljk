(ns test.nbb.portable-tests
  "Every `*-portable-test` namespace, on the Node route.

  A `.cljc` source reached only by `.clj` tests is verified on one host, and
  this repository has been paying for that: on 2026-09-09 nine cross-host
  defects were found and fixed across this workspace, every one invisible on
  the JVM. The `.cljc` test files below already existed; four of them had no
  registered Node runner, so their `:cljs` branches were compiled by nobody.

  Adding a `*_portable_test.cljc` means adding a line here AND a line in
  `test/kotoba/compiler/test_runner.cljk`. `expected-namespaces` makes the first
  omission loud: a namespace that is present on disk and absent from the vector
  fails this run rather than silently not running.

  Detector: `scripts/verify-portable-source-tested-on-one-host.cljs` in the
  superproject, which is what named the two namespaces this file was written
  for (`kotoba.compiler.provenance`, `kotoba.compiler.uefi-operations`)."
  (:require [cljs.test :as t]
            ["node:fs" :as fs]
            ["node:path" :as path]
            [kotoba.compiler.backend-cljs-portable-test]
            [kotoba.compiler.definition-identity-portable-test]
            [kotoba.compiler.fuel-estimate-portable-test]
            [kotoba.compiler.portable-surface-test]
            [kotoba.compiler.provenance-portable-test]
            [kotoba.compiler.surface-convergence-portable-test]
            [kotoba.compiler.uefi-operations-portable-test]))

(def namespaces
  '[kotoba.compiler.backend-cljs-portable-test
    kotoba.compiler.definition-identity-portable-test
    kotoba.compiler.fuel-estimate-portable-test
    kotoba.compiler.portable-surface-test
    kotoba.compiler.provenance-portable-test
    kotoba.compiler.surface-convergence-portable-test
    kotoba.compiler.uefi-operations-portable-test])

(def ^:private on-disk
  "The `*_portable_test.cljk` files under test/kotoba/compiler, so a new one
  cannot be added without either registering it here or turning this red.
  `portable_surface_test.cljk` does not carry the suffix, so it is named.
  The spelling is `.cljk` since the 2026-09-11 rename (root ADR-2609111500);
  with `.cljc` still here this scan found 0 files on disk against 7
  registered and refused to report a pass -- exit 2, the right answer for
  a scan that could not see its input, and the reason this line moved."
  (let [dir (path/join "test" "kotoba" "compiler")]
    (->> (.readdirSync fs dir)
         (filter #(and (.endsWith % ".cljk")
                       (or (.endsWith % "_portable_test.cljk")
                           (= % "portable_surface_test.cljk"))))
         sort
         vec)))

(defmethod t/report [:cljs.test/default :end-run-tests] [m]
  (let [failed (+ (:fail m) (:error m))]
    (println (str "SCANNED\t" (count namespaces) "\tportable namespace(s); "
                  (:test m) " tests, " (:pass m) " passing assertions, "
                  failed " failed"))
    ;; Evidence floor: a run that loaded nothing must not answer like a run
    ;; that passed. Both numbers, because a namespace can load and contain no
    ;; deftest.
    (when (or (zero? (:test m)) (zero? (:pass m)))
      (println "Refusing to report a pass: no test or no assertion ran.")
      (.exit js/process 2))
    (when (not= (count on-disk) (count namespaces))
      (println (str "Refusing to report a pass: " (count on-disk)
                    " portable test file(s) on disk, " (count namespaces)
                    " registered here -- " (pr-str on-disk)))
      (.exit js/process 2))
    (when (pos? failed) (.exit js/process 1))))

(apply t/run-tests namespaces)
